  "domain": "math",
  "title": "Powerful values of quadratic polynomials",
  "summary": "Fixed and coefficient-uniform bounds for powerful values of quadratic polynomials, with cubic consequences and mixed-full applications in the stated orientations and shifts.",
  "status": "admitted",
  "grade": "conditional-lean",
  "grade_note": "Seven formal interfaces with three named literature inputs. Standard-axiom replay, exact statement comparison and negative control complete; written refinements are identified separately.",
  "paper": {
    "tex": "papers/powerful-polynomial-values/main.tex",
    "pdf": "papers/powerful-polynomial-values/main.pdf",
    "citation": "citations/powerful-polynomial-values.bib"
  },
  "claims": [
    {
      "label": "A1",
      "paper_ref": "Paper 1, Theorem 1.1 (A1)",
      "statement": "For each fixed Q(t)=A t^2+B t+C with integral coefficients, A>0 and nonsquare discriminant, the number of 1<=n<=N with Q(n)>0 powerful is O_Q,eps(N^(293/1220+eps)).",
      "declarations": [
        "JocelynWorkspace.Formalization.PowerfulCounting.ConsecutiveCounting.A1"
      ],
      "assumes": [
        "stewart",
        "ccdn",
        "gelfond"
      ],
      "headline": true
    },
    {
      "label": "A2",
      "paper_ref": "Paper 1, Theorem 1.3 (A2)",
      "statement": "Uniform powerful n^2+a^2 for 1<=|a|<=N^kappa, 0<=kappa<=289/1050, with the three-piece Theta.",
      "declarations": [
        "JocelynWorkspace.Formalization.PowerfulCounting.ConsecutiveCounting.A2"
      ],
      "assumes": [
        "stewart",
        "ccdn",
        "gelfond"
      ],
      "headline": true
    },
    {
      "label": "A3",
      "paper_ref": "Paper 1, Theorem 1.2 (A3)",
      "statement": "There are absolute K,B>0 such that positive powerful values of Q(n)=a n^2+b n+c, with integral coefficients, a>=1, nonsquare discriminant and |a|,|b|,|c|<=L, are counted by K L^B N^(389/1600) for L,N>=2. Summing over 1<=a<=M and |b|,|c|<=M, with M=floor(N^(1/(1600(B+3)))), gives O(N^(390/1600)).",
      "declarations": [
        "JocelynWorkspace.Formalization.PowerfulCounting.ConsecutiveCounting.A3"
      ],
      "assumes": [
        "stewart",
        "ccdn",
        "gelfond"
      ],
      "headline": true
    },
    {
      "label": "A4",
      "paper_ref": "Paper 1, Corollary 1.4: general bound (A4)",
      "statement": "For natural A>=1 and real T>=2, powerful 1+A t^3 with 1<=t<=T have bound C_eps A^B T^(3/5+eps), with B>=0 independent of eps and A. For A=a^3, a>=1 natural, a separate uniform polynomial-coefficient bound has exponent 389/1600.",
      "declarations": [
        "JocelynWorkspace.Formalization.PowerfulCounting.ConsecutiveCounting.A4"
      ],
      "assumes": [
        "stewart",
        "ccdn",
        "gelfond"
      ],
      "headline": false,
      "role": "supporting verified application; no independent novelty credit",
      "paper_scope_note": "The general bound is Corollary 1.4. Its stronger cube-coefficient bound is a written consequence of A1, not an additional replayed statement; the retained formal A4(ii) is weaker."
    },
    {
      "label": "A11",
      "paper_ref": "Paper 1, Theorem 1.5: h=1 (A11)",
      "statement": "Uniform bound Cs A^C1 T^(389/1600) for powerful A t^2+1, natural A>=1 and 1<=t<=T, with Cs,C1>0. For s in {6,8}, 2<=r<s, counts 1<=n<=X with n s-full and n+1 r-full by O(X^(1/s-delta_s(C1)+eps)); delta_s is the positive saving defined in the formal statement.",
      "declarations": [
        "JocelynWorkspace.Formalization.PowerfulCounting.ConsecutiveCounting.A11"
      ],
      "assumes": [
        "stewart",
        "ccdn",
        "gelfond"
      ],
      "headline": false,
      "role": "supporting shift-one specialization of A12; no independent novelty credit"
    },
    {
      "label": "A12",
      "paper_ref": "Paper 1, Theorem 1.5 (A12)",
      "statement": "For each fixed natural h>=1, uniform bound Kh A^Ch T^(389/1600) for powerful A t^2+h, natural A>=1 and 1<=t<=T, with Kh,Ch>=1. For s in {6,8}, 2<=r<s, counts 1<=n<=X with n s-full and n+h r-full by O_h(X^(1/s-delta_s(Ch)+eps)).",
      "declarations": [
        "JocelynWorkspace.Formalization.PowerfulCounting.ConsecutiveCounting.A12"
      ],
      "assumes": [
        "stewart",
        "ccdn",
        "gelfond"
      ],
      "headline": true
    },
    {
      "label": "A13",
      "paper_ref": "Paper 1, Theorem 1.6 (A13)",
      "statement": "Positive witness functions KH,BH bound positive powerful A t^2-H by KH(H) A^BH(H) T^(389/1600), for natural A,H>=1 with A*H nonsquare and 1<=t<=T. For s in {6,8}, 2<=r<s, counts 2<=n<=X with n s-full and n-1 r-full by O(X^(1/s-delta_s(BH(1))+eps)), with delta_s(BH(1))>0.",
      "declarations": [
        "JocelynWorkspace.Formalization.PowerfulCounting.ConsecutiveCounting.A13"
      ],
      "assumes": [
        "stewart",
        "ccdn",
        "gelfond"
      ],
      "headline": true
    }
  ],
  "hypotheses": [
    {
      "id": "stewart",
      "name": "Stewart's Thue bound",
      "source": "C. L. Stewart, JAMS4 (1991),793–835, Theorem1 p795 and consequence p796",
      "lean_form": "StewartHyp: content-one squarefree homogeneous binary forms of degree q>=3; ordered primitive integer pairs, signed nonzero m, bound2800*q^(1+omega(|m|))",
      "relation": "consequence",
      "compared_against": "Original author-hosted journal PDF, printed pp793–797",
      "source_url": "https://uwaterloo.ca/pure-mathematics/sites/default/files/uploads/documents/s0894-0347-1991-1119199-x_0.pdf",
      "source_sha256": "8824ab3dbe963c8d070aad1f1d593ce6217fed686665ca99d422c192f0e9eba7",
      "comparison": "The p796 consequence uses g=|m| and counts coprime integer pairs of both signs. Content1 and squarefree homogeneous form give the nonzero discriminant condition in characteristic0. Reducible squarefree forms are included; omega counts distinct prime factors.",
      "reviewer": "AI"
    },
    {
      "id": "ccdn",
      "name": "Uniform affine-curve count",
      "source": "Castryck–Cluckers–Dittmann–Nguyen, arXiv1904.13109v1, Theorem3",
      "lean_form": "CCDNThm3 in all natural ambient dimensions N>=2, positive degree d, integral affine curve represented by prime ideal and linear filtered Hilbert dimension",
      "relation": "instance",
      "compared_against": "Primary arXiv v1 theorem HTML",
      "source_url": "https://arxiv.org/html/1904.13109v1",
      "comparison": "Quantifier order c=c(N), all degrees, B>=1, c*d^3*B^(1/d)*(log B+d); no extra smoothness or geometric irreducibility assumption.",
      "reviewer": "AI",
      "source_sha256": "0ba5979ceec573318f7b4d43b8e6d70b23ae6224487b8657756500c98f5b3540",
      "source_location": "Thmmaintheorem3, Theorem3 Affine curves"
    },
    {
      "id": "gelfond",
      "name": "Gelfond factor-height inequality",
      "source": "Bombieri–Gubler, Heights in Diophantine Geometry, Cambridge2006, Lemma1.6.11, printed p27",
      "lean_form": "GelfondHyp for every natural number n of variables; factor coefficients bounded by exp(c_n*totalDegree(F))*height(F)",
      "relation": "consequence",
      "compared_against": "Publisher preview printed pp22,24,27",
      "source_url": "https://api.pageplace.de/preview/DT0400.9780511138096_A23689664/preview-9780511138096_A23689664.pdf",
      "source_sha256": "91d2c7d2c97a02319d33d355185c7fe1d899813c2bea93835d8bc14ea94d238a",
      "comparison": "Apply product-height lower bound to G and its nonzero integral cofactor, whose coefficient norm is at least1. Sum of partial degrees <=n totalDegree(F); c_n=n log2 works. n=0 is the integer case.",
      "reviewer": "AI"
    }
