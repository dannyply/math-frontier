n N) ℚ), I.IsPrime → ringKrullDim (MvPolynomial (Fin N) ℚ ⧸ I) = 1 → (∃ e : ℤ, ∃ s₀ : ℕ, ∀ s : ℕ, s₀ ≤ s → (Module.finrank ℚ (Submodule.map (Ideal.Quotient.mkₐ ℚ I).toLinearMap (MvPolynomial.restrictTotalDegree (Fin N) ℚ s)) : ℤ) = (d : ℤ) * (s : ℤ) + e) → ∀ B : ℝ, 1 ≤ B → ((({P : Fin N → ℤ | (∀ f ∈ I, MvPolynomial.eval (fun i => (P i : ℚ)) f = 0) ∧ ∀ i, |(P i : ℝ)| ≤ B} : Set (Fin N → ℤ)).ncard : ℕ) : ℝ) ≤ c * (d : ℝ) ^ 3 * B ^ ((1 : ℝ) / (d : ℝ)) * (Real.log B + (d : ℝ)); ∀ c : ℝ, CCDNAt 8 c → ∀ δ : ℝ, 0 < δ → δ < (1 / 2000 : ℝ) → ∃ q : ℕ, ∃ K X₀ : ℝ, 6 ≤ q ∧ 5 / δ ≤ (q : ℝ) ∧ 0 < K ∧ 8 ≤ X₀ ∧ ∀ ε : ℝ, 0 < ε → ∃ C X₁ : ℝ, 0 < C ∧ X₀ ≤ X₁ ∧ ∀ x : ℝ, X₁ ≤ x → ∀ s : ℝ, (2 / 5 : ℝ) ≤ s → s ≤ (35 / 81 : ℝ) → ∀ D E : ℝ, 0 < D → 0 < E → D * E = x ^ s → let B : ℕ := degreeB q s; let M : ℕ := ⌈x ^ (mStar s + δ)⌉₊; let U : ℝ := x / D ^ 3; let V : ℝ := x / E ^ 3; let R_D : ℝ := D * E + (D ^ 2 + E ^ 2) / (M : ℝ); let R_U : ℝ := U * V + (U ^ 2 + V ^ 2) / (M : ℝ); 1 ≤ B ∧ B ≤ q ∧ 1 ≤ M ∧ (M : ℝ) ≤ x ∧ ∀ h : ℤ, (h = 1 ∨ h = -1) → ∃ F : ℕ → MvPolynomial (Fin 4) ℤ, ∃ 𝓖 : ℕ → Finset (MvPolynomial (Fin 4) ℤ), (∀ j ∈ cells D E M, F j ≠ 0 ∧ Bihom (F j) q B ∧ (F j).totalDegree ≤ q + B ∧ (∀ m : Fin 4 →₀ ℕ, |(((F j).coeff m : ℤ) : ℝ)| ≤ x ^ K) ∧ (∀ z ∈ originalCell x D E M j h, MvPolynomial.eval ![(z.1.1 : ℤ), (z.1.2 : ℤ), (z.2.1 : ℤ), (z.2.2 : ℤ)] (F j) = 0) ∧ (𝓖 j).card ≤ q + B ∧ (∀ G ∈ 𝓖 j, Primitive G ∧ HighFactor (F j) G ∧ ∀ m : Fin 4 →₀ ℕ, |((G.coeff m : ℤ) : ℝ)| ≤ x ^ K) ∧ (∀ z : Point, z ∈ HighUnion x D E M j h (F j) ↔ z ∈ originalCell x D E M j h ∧ ∃ G ∈ 𝓖 j, MvPolynomial.eval ![(z.1.1 : ℤ), (z.1.2 : ℤ), (z.2.1 : ℤ), (z.2.2 : ℤ)] G = 0) ∧ (HighUnion x D E M j h (F j)).Finite ∧ ∀ G ∈ 𝓖 j, (HighCell x D E M j h G).Finite) ∧ (∑ j ∈ cells D E M, ∑ G ∈ 𝓖 j, ((HighCell x D E M j h G).ncard : ℝ)) ≤ C * x ^ ε * ((M : ℝ) + (M : ℝ) ^ ((3 : ℝ) / 4) * R_D ^ ((3 : ℝ) / 16) * R_U ^ ((1 : ℝ) / 16)) )

