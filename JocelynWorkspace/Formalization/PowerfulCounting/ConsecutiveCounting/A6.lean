private def bW {R:Type*} [CommRing R] (p₀ p₁ p₂ p₃ p₄:R):
    MvPolynomial (Fin 2) R:=
  monomial (bIndex 4 0) p₀+monomial (bIndex 3 1) p₁+
    monomial (bIndex 2 2) p₂+monomial (bIndex 1 3) p₃+
    monomial (bIndex 0 4) p₄
private theorem bX {R:Type*} [CommRing R]
 (p₀ p₁ p₂ p₃ p₄:R):
