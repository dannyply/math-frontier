    exact ⟨P7N.primitive_of_irreducibles q
      hqp.irreducible hqE.2.2.1,hqE⟩
  · intro G hG
    obtain ⟨q,hqs,hqp,bK,hqF,hqG,hass⟩:=
      P7C.match_geometric_factor_to_prime_family_with_integral_divisor
        F G s bI hassF hG.2.1 hG.1 hG.2.2.1
    have hqE:=cl F G q hG hqF hqp.ne_zero hqG hass
    have hqS:q ∈ S:=by
      apply aF
      refine ⟨?_,hqE⟩
      exact Multiset.mem_toFinset.mpr (Multiset.mem_filter.mpr ⟨hqs,bK⟩)
    exact ⟨q,hqS,fun x=>
      (P7C.eval_zero_iff_of_associated_maps q G hass x).symm⟩
end P7A

end

namespace P7I
private def pPart (a b d e:I):I:=
  b ^ 7 * e ^ 4 + 7 * a * b ^ 6 * d * e ^ 3 +
    21 * a ^ 2 * b ^ 5 * d ^ 2 * e ^ 2
private def qPart (a b d e:I):I:=
  35 * a ^ 3 * b ^ 4 * e ^ 4 +
    35 * a ^ 4 * b ^ 3 * d * e ^ 3 +
    21 * a ^ 5 * b ^ 2 * d ^ 2 * e ^ 2 +
    7 * a ^ 6 * b * d ^ 3 * e + a ^ 7 * d ^ 4
private def pNF (a b c R S d e:I):I:=
  c * pPart a b d e + d ^ 3 * (R * e + S * d)
private def qNF (a b c R S d e:I):I:=
  e ^ 3 * (R * e + S * d) - c * qPart a b d e
private def co (a b c R S:I):I:=
  b * S - a * R + 15 * c * a ^ 4 * b ^ 4
private theorem cq (a b c R S:I):
 pNF a b c R S b (-a) = b ^ 3 * co a b c R S ∧
 qNF a b c R S b (-a) = -a ^ 3 * co a b c R S:=by
  constructor <;> dsimp [pNF,qNF,pPart,qPart,co] <;> ring
private theorem cv
 {R:Type*} [CommRing R]
 (p₀ p₁ p₂ p₃ p₄ a b d e:R):
 a * d + b * e ∣
 b ^ 4 * (p₀ * d ^ 4 + p₁ * d ^ 3 * e + p₂ * d ^ 2 * e ^ 2 +
 p₃ * d * e ^ 3 + p₄ * e ^ 4) -
 d ^ 4 * (p₀ * b ^ 4 - p₁ * a * b ^ 3 + p₂ * a ^ 2 * b ^ 2 -
 p₃ * a ^ 3 * b + p₄ * a ^ 4):=by
  refine ⟨p₁ * b ^ 3 * d ^ 3 +
    p₂ * b ^ 2 * d ^ 2 * (b * e - a * d) +
    p₃ * b * d * ((b * e) ^ 2 - a * d * b * e + (a * d) ^ 2) +
    p₄ * ((b * e) ^ 3 - a * d * (b * e) ^ 2 +
      (a * d) ^ 2 * b * e - (a * d) ^ 3),?_⟩
  ring
private noncomputable abbrev m40:Fin 2 →₀ U:= ao 0 4
private noncomputable abbrev m31:Fin 2 →₀ U:= ao 0 3 + ao 1 1
private noncomputable abbrev m22:Fin 2 →₀ U:= ao 0 2 + ao 1 2
private noncomputable abbrev m13:Fin 2 →₀ U:= ao 0 1 + ao 1 3
private noncomputable abbrev m04:Fin 2 →₀ U:= ao 1 4
private theorem cz (t:Fin 2 →₀ U)
 (ht:Finsupp.degree t = 4):
 t = m40 ∨ t = m31 ∨ t = m22 ∨ t = m13 ∨ t = m04:=by
  have hs:t 0 + t 1 = 4:=by
    simpa [Finsupp.degree_eq_sum,Fin.sum_univ_two] using ht
  have hcase:t 0 = 0 ∨ t 0 = 1 ∨ t 0 = 2 ∨ t 0 = 3 ∨ t 0 = 4:=by omega
  rcases hcase with h0 | h1 | h2 | h3 | h4
  · right;right;right;right
    ext i;fin_cases i <;> simp [m04,aP] <;> omega
  · right;right;right;left
    ext i;fin_cases i <;> simp [m13,aP,aw] <;> omega
  · right;right;left
    ext i;fin_cases i <;> simp [m22,aP,aw] <;> omega
  · right;left
    ext i;fin_cases i <;> simp [m31,aP,aw] <;> omega
  · left
    ext i;fin_cases i <;> simp [m40,aP] <;> omega
private theorem cA (P:ab)
 (hP:P.IsHomogeneous 4):
 P = aA m40 (P.coeff m40) +
 aA m31 (P.coeff m31) +
 aA m22 (P.coeff m22) +
 aA m13 (P.coeff m13) +
 aA m04 (P.coeff m04):=by
  classical
  ext t
  simp only [ba,av]
  have hd01:m40 ≠ m31:=by
    intro h
    have h0:= congrArg (fun z:Fin 2 →₀ U => z 0) h
    norm_num [m40,m31,m22,m13,m04,aw] at h0
  have hd02:m40 ≠ m22:=by
    intro h
    have h0:= congrArg (fun z:Fin 2 →₀ U => z 0) h
    norm_num [m40,m31,m22,m13,m04,aw] at h0
  have hd03:m40 ≠ m13:=by
    intro h
    have h0:= congrArg (fun z:Fin 2 →₀ U => z 0) h
    norm_num [m40,m31,m22,m13,m04,aw] at h0
  have hd04:m40 ≠ m04:=by
    intro h
    have h0:= congrArg (fun z:Fin 2 →₀ U => z 0) h
    norm_num [m40,m31,m22,m13,m04,aw] at h0
  have hd12:m31 ≠ m22:=by
    intro h
    have h0:= congrArg (fun z:Fin 2 →₀ U => z 0) h
    norm_num [m40,m31,m22,m13,m04,aw] at h0
  have hd13:m31 ≠ m13:=by
    intro h
    have h0:= congrArg (fun z:Fin 2 →₀ U => z 0) h
    norm_num [m40,m31,m22,m13,m04,aw] at h0
  have hd14:m31 ≠ m04:=by
    intro h
    have h0:= congrArg (fun z:Fin 2 →₀ U => z 0) h
    norm_num [m40,m31,m22,m13,m04,aw] at h0
  have hd23:m22 ≠ m13:=by
    intro h
    have h0:= congrArg (fun z:Fin 2 →₀ U => z 0) h
    norm_num [m40,m31,m22,m13,m04,aw] at h0
  have hd24:m22 ≠ m04:=by
    intro h
    have h0:= congrArg (fun z:Fin 2 →₀ U => z 0) h
    norm_num [m40,m31,m22,m13,m04,aw] at h0
  have hd34:m13 ≠ m04:=by
    intro h
    have h0:= congrArg (fun z:Fin 2 →₀ U => z 0) h
    norm_num [m40,m31,m22,m13,m04,aw] at h0
  by_cases h0:m40 = t
  · subst t
    simp [Ne.symm hd01,Ne.symm hd02,Ne.symm hd03,Ne.symm hd04]
  by_cases h1:m31 = t
  · subst t
    simp [hd01,Ne.symm hd12,Ne.symm hd13,Ne.symm hd14]
  by_cases h2:m22 = t
  · subst t
    simp [hd02,hd12,Ne.symm hd23,Ne.symm hd24]
  by_cases h3:m13 = t
  · subst t
    simp [hd03,hd13,hd23,Ne.symm hd34]
  by_cases h4:m04 = t
  · subst t
    simp [hd04,hd14,hd24,hd34]
  have hz:P.coeff t = 0:=by
    by_contra hc
    have hdeg:Finsupp.degree t = 4:=by
      by_contra hneq
      exact hc (hP.coeff_eq_zero hneq)
    rcases cz t hdeg with hh | hh | hh | hh | hh
    · exact h0 hh.symm
    · exact h1 hh.symm
    · exact h2 hh.symm
    · exact h3 hh.symm
    · exact h4 hh.symm
  simp [h0,h1,h2,h3,h4,hz]
private theorem cB (r:I) (i j:U):
 aA
 (ao (0:Fin 2) i + ao (1:Fin 2) j) r =
 ai r * (aj (0:Fin 2)) ^ i *
 (aj (1:Fin 2)) ^ j:=by
  calc
    _ = aA (ao (0:Fin 2) i) r *
        aA (ao (1:Fin 2) j) (1:I):=by
      rw [aL]
      simp
    _ = _:=by
      rw [← ap,
        ← ap]
      simp [mul_assoc]
private theorem cC (P:ab)
 (hP:P.IsHomogeneous 4):
 P = ai (P.coeff m40) * aj (0:Fin 2) ^ 4 +
 ai (P.coeff m31) * aj (0:Fin 2) ^ 3 * aj 1 +
 ai (P.coeff m22) * aj (0:Fin 2) ^ 2 * aj 1 ^ 2 +
 ai (P.coeff m13) * aj (0:Fin 2) * aj 1 ^ 3 +
 ai (P.coeff m04) * aj (1:Fin 2) ^ 4:=by
  conv_lhs => rw [cA P hP]
  rw [show m31 = ao (0:Fin 2) 3 + ao 1 1 from rfl,
    show m22 = ao (0:Fin 2) 2 + ao 1 2 from rfl,
    show m13 = ao (0:Fin 2) 1 + ao 1 3 from rfl]
  rw [cB,cB,cB]
  rw [← ap,
    ← ap]
  ring
private theorem cD (P:ab)
 (hP:P.IsHomogeneous 4) (d e:I):
 al ![d,e] P =
 P.coeff m40 * d ^ 4 + P.coeff m31 * d ^ 3 * e +
 P.coeff m22 * d ^ 2 * e ^ 2 + P.coeff m13 * d * e ^ 3 +
 P.coeff m04 * e ^ 4:=by
  conv_lhs => rw [cC P hP]
  simp
private theorem cE
 (r0 r1 r2 r3 r4 r5 r6 r7:I)
 (h:∀ t:I,
 r0 + r1 * t + r2 * t ^ 2 + r3 * t ^ 3 + r4 * t ^ 4 +
 r5 * t ^ 5 + r6 * t ^ 6 + r7 * t ^ 7 = 0):
 r0 = 0 ∧ r1 = 0 ∧ r2 = 0 ∧ r3 = 0 ∧ r4 = 0 ∧
 r5 = 0 ∧ r6 = 0 ∧ r7 = 0:=by
  have h0:= h 0
  have h1:= h 1
  have hm1:= h (-1)
  have h2:= h 2
  have hm2:= h (-2)
  have h3:= h 3
  have hm3:= h (-3)
  have h4:= h 4
  norm_num at h0 h1 hm1 h2 hm2 h3 hm3 h4
  refine ⟨?_,?_,?_,?_,?_,?_,?_,?_⟩ <;>
    linarith only [h0,h1,hm1,h2,hm2,h3,hm3,h4]
private theorem cF
 (p40 p31 p22 p13 p04 q40 q31 q22 q13 q04 a b c:I)
 (ht:∀ t:I,
 t ^ 3 * (p40 + p31 * t + p22 * t ^ 2 + p13 * t ^ 3 + p04 * t ^ 4) -
 (q40 + q31 * t + q22 * t ^ 2 + q13 * t ^ 3 + q04 * t ^ 4) =
 c * (a + b * t) ^ 7):
 q40 = -c * a ^ 7 ∧ q31 = -(7 * c * a ^ 6 * b) ∧
 q22 = -(21 * c * a ^ 5 * b ^ 2) ∧
 q13 = p40 - 35 * c * a ^ 4 * b ^ 3 ∧
 q04 = p31 - 35 * c * a ^ 3 * b ^ 4 ∧
 p22 = 21 * c * a ^ 2 * b ^ 5 ∧ p13 = 7 * c * a * b ^ 6 ∧ p04 = c * b ^ 7:=by
  have hv:∀ t:I,
      (-q40 - c * a ^ 7) +
      (-q31 - 7 * c * a ^ 6 * b) * t +
      (-q22 - 21 * c * a ^ 5 * b ^ 2) * t ^ 2 +
      (p40 - q13 - 35 * c * a ^ 4 * b ^ 3) * t ^ 3 +
      (p31 - q04 - 35 * c * a ^ 3 * b ^ 4) * t ^ 4 +
      (p22 - 21 * c * a ^ 2 * b ^ 5) * t ^ 5 +
      (p13 - 7 * c * a * b ^ 6) * t ^ 6 +
      (p04 - c * b ^ 7) * t ^ 7 = 0:=by
    intro t
    calc
      _ = t ^ 3 * (p40 + p31 * t + p22 * t ^ 2 + p13 * t ^ 3 + p04 * t ^ 4) -
          (q40 + q31 * t + q22 * t ^ 2 + q13 * t ^ 3 + q04 * t ^ 4) -
          c * (a + b * t) ^ 7:=by ring
      _ = 0:=by rw [ht t];ring
  obtain ⟨h0,h1,h2,h3,h4,h5,h6,h7⟩:= cE
    (-q40 - c * a ^ 7)
    (-q31 - 7 * c * a ^ 6 * b)
    (-q22 - 21 * c * a ^ 5 * b ^ 2)
    (p40 - q13 - 35 * c * a ^ 4 * b ^ 3)
    (p31 - q04 - 35 * c * a ^ 3 * b ^ 4)
    (p22 - 21 * c * a ^ 2 * b ^ 5)
    (p13 - 7 * c * a * b ^ 6) (p04 - c * b ^ 7) hv
  refine ⟨?_,?_,?_,?_,?_,?_,?_,?_⟩ <;> nlinarith only [h0,h1,h2,h3,h4,h5,h6,h7]
private theorem cH
 (P Q:ab) (a b c:I)
 (hP:P.IsHomogeneous 4) (hQ:Q.IsHomogeneous 4)
 (hpure:aj (1:Fin 2) ^ 3 * P -
 aj (0:Fin 2) ^ 3 * Q =
 ai c * (ai a * aj 0 +
 ai b * aj 1) ^ 7):
 Q.coeff m40 = -c * a ^ 7 ∧
 Q.coeff m31 = -(7 * c * a ^ 6 * b) ∧
 Q.coeff m22 = -(21 * c * a ^ 5 * b ^ 2) ∧
 Q.coeff m13 = P.coeff m40 - 35 * c * a ^ 4 * b ^ 3 ∧
 Q.coeff m04 = P.coeff m31 - 35 * c * a ^ 3 * b ^ 4 ∧
 P.coeff m22 = 21 * c * a ^ 2 * b ^ 5 ∧
 P.coeff m13 = 7 * c * a * b ^ 6 ∧ P.coeff m04 = c * b ^ 7:=by
  apply cF
  intro t
  have hh:= congrArg (al ![(1:I),t]) hpure
  simp only [MvPolynomial.eval_sub,MvPolynomial.eval_mul,MvPolynomial.eval_pow,
    MvPolynomial.eval_add,MvPolynomial.eval_C,MvPolynomial.eval_X] at hh
  simp [cD P hP 1 t,cD Q hQ 1 t] at hh
  nlinarith [hh]
private theorem cJ
 (P Q:ab) (a b c:I)
 (hP:P.IsHomogeneous 4) (hQ:Q.IsHomogeneous 4)
 (hpure:aj (1:Fin 2) ^ 3 * P -
 aj (0:Fin 2) ^ 3 * Q =
 ai c * (ai a * aj 0 +
 ai b * aj 1) ^ 7):
 ∀ d e:I,
 al ![d,e] P = pNF a b c (P.coeff m31) (P.coeff m40) d e ∧
 al ![d,e] Q = qNF a b c (P.coeff m31) (P.coeff m40) d e:=by
  obtain ⟨h0,h1,h2,h3,h4,h5,h6,h7⟩:=
    cH P Q a b c hP hQ hpure
  intro d e
  constructor
  · rw [cD P hP d e,h5,h6,h7]
    dsimp [pNF,pPart]
    ring
  · rw [cD Q hQ d e,h0,h1,h2,h3,h4]
    dsimp [qNF,qPart]
    ring
