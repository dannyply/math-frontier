private theorem cf {R:Type*} [CommRing R]
 (u v:R) (P Q:MvPolynomial (Fin 2) R):
 cd u v (bO P Q) = P*C u-Q*C v:=by
  have hX2:cd u v (X (2:Fin 4))=C u:=by simp [cd]
  have hX3:cd u v (X (3:Fin 4))=C v:=by simp [cd]
  simp only [bO,map_sub,map_mul,ce,hX2,hX3]
private theorem cg {R:Type*} [CommRing R] (u v r:R):
