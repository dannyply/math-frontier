  have hfin : S.Finite := Set.Finite.of_finite_image
    (hTfin.subset (by rintro _ ⟨q,hq,rfl⟩; exact hmap q hq))
    natToInteger_injective.injOn
  have hcard : S.ncard≤T.ncard :=
    Set.ncard_le_ncard_of_injOn natToInteger hmap
