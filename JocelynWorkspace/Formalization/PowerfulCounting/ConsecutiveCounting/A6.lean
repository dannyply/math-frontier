        dsimp [d]
        nlinarith only [hr2]
      _ = (1 - m) * t ^ 2 / 3 := by
        rw [hdm, htd]
        field_simp [hd.ne']

  refine ⟨htlo, hthi, hmlo, hmhi, ?_⟩
  intro z
  have hcoef : 1 - 3 * s = -a := by dsimp [a]; ring
  change (s + (1 - 3 * s) * z + z ^ 2 / 3) - m * (1 + z ^ 2 / 3) =
    (1 - m) * (z - t) ^ 2 / 3
  calc
    _ = (s - m) + (1 - 3 * s) * z + (1 - m) * z ^ 2 / 3 := by ring
    _ = (1 - m) * t ^ 2 / 3 - a * z + (1 - m) * z ^ 2 / 3 := by
      rw [hconstant, hcoef]
      ring
    _ = (1 - m) * (z - t) ^ 2 / 3 := by
      rw [← hlinear]
      ring

private lemma mu_bounds (s δ : ℝ)
    (hs : (2 / 5 : ℝ) ≤ s) (hs' : s ≤ (35 / 81 : ℝ))
    (hδ : 0 < δ) (hδ' : δ < (1 / 2000 : ℝ)) :
    (1 / 3 : ℝ) ≤ mStar s + δ ∧ mStar s + δ ≤ (1 / 2 : ℝ) := by
  obtain ⟨htlo, hthi, hmlo, hmhi, hsq⟩ := optimizer_certificate s hs hs'
  constructor <;> linarith

private lemma floor_threshold_bound (q : ℕ) (hq6 : 6 ≤ q) (s : ℝ)
    (hs : (2 / 5 : ℝ) ≤ s) (hs' : s ≤ (35 / 81 : ℝ)) :
    let B : ℕ := degreeB q s
    1 ≤ B ∧ B ≤ q ∧ gate q B s ≤ mStar s + 7 / (3 * (q : ℝ)) := by
  let Q : ℝ := (q : ℝ)
  let t : ℝ := aspect s
  let m : ℝ := mStar s
  let B : ℕ := degreeB q s
  let z : ℝ := (B : ℝ) / Q
  let ρ : ℝ := R q B / Q
  have hq : 1 ≤ q := by omega
  have hQ1 : (1 : ℝ) ≤ Q := by
    change (1 : ℝ) ≤ (q : ℝ)
    exact_mod_cast hq
  have hQ6 : (6 : ℝ) ≤ Q := by
    change (6 : ℝ) ≤ (q : ℝ)
    exact_mod_cast hq6
  have hQ : 0 < Q := by linarith
  obtain ⟨htlo, hthi, hmlo, hmhi, hsquare⟩ := optimizer_certificate s hs hs'
  have htq0 : 0 ≤ t * Q := mul_nonneg (by linarith) hQ.le
  have hfloor := Nat.floor_le htq0
  change (B : ℝ) ≤ t * Q at hfloor
  have hfloorLt := Nat.lt_floor_add_one (t * Q)
  change t * Q < (B : ℝ) + 1 at hfloorLt
  have hBpos : 1 ≤ B := by
    by_contra hn
    have hBzero : B = 0 := by omega
    rw [hBzero, Nat.cast_zero] at hfloorLt
    have hmul := mul_le_mul_of_nonneg_right htlo hQ.le
    nlinarith only [hfloorLt, hmul, hQ6]
  have hBle : B ≤ q := by
    have hreal : (B : ℝ) ≤ Q := by
      calc
        (B : ℝ) ≤ t * Q := hfloor
        _ ≤ 1 * Q := mul_le_mul_of_nonneg_right hthi hQ.le
        _ = Q := one_mul _
    change (B : ℝ) ≤ (q : ℝ) at hreal
    exact_mod_cast hreal
  have hzle : z ≤ t := (div_le_iff₀ hQ).mpr hfloor
  have he0 : 0 ≤ t - z := sub_nonneg.mpr hzle
  have hzQ : z * Q = (B : ℝ) := by dsimp [z]; field_simp [hQ.ne']
  have heU : t - z ≤ 1 / Q := by
    apply (le_div_iff₀ hQ).mpr
    nlinarith only [hfloorLt, hzQ]
  have hInv : 1 / Q ≤ 1 := by
    apply (div_le_iff₀ hQ).mpr
    simpa only [one_mul] using hQ1
  have he1 : t - z ≤ 1 := heU.trans hInv
  have heSq : (t - z) ^ 2 ≤ 1 / Q := by
    have hp := mul_nonneg he0 (sub_nonneg.mpr he1)
    nlinarith only [hp, heU]
  have hzSq : (z - t) ^ 2 ≤ 1 / Q := by
    rw [show (z - t) ^ 2 = (t - z) ^ 2 by ring]
    exact heSq
  obtain ⟨hρ0, hρU⟩ :=
    FormalAB.Se7122579.A5AffineFiniteGate.AspectInternal.rho_error q B hq
  change 0 ≤ ρ at hρ0
  change ρ - z ^ 2 / 3 ≤ 1 / (3 * Q) at hρU
  let K : ℝ := (z - t) ^ 2 / 3 + (ρ - z ^ 2 / 3)
  let Uerr : ℝ := 2 / (3 * Q)
  have hSq3 : (z - t) ^ 2 / 3 ≤ 1 / (3 * Q) := by
    apply (div_le_iff₀ (by norm_num : (0 : ℝ) < 3)).mpr
    have hid : (1 / (3 * Q)) * 3 = 1 / Q := by field_simp [hQ.ne']
    rw [hid]
    exact hzSq
  have hK : K ≤ Uerr := by
    calc
      K = (z - t) ^ 2 / 3 + (ρ - z ^ 2 / 3) := rfl
      _ ≤ 1 / (3 * Q) + 1 / (3 * Q) := add_le_add hSq3 hρU
      _ = Uerr := by dsimp [Uerr]; ring
  have hUerr : 0 ≤ Uerr := by dsimp [Uerr]; positivity
  have hc0 : 0 ≤ 1 - m := by linarith
  have hc1 : 1 - m ≤ 1 := by linarith
  have hcK : (1 - m) * K ≤ Uerr := by
    calc
      (1 - m) * K ≤ (1 - m) * Uerr := mul_le_mul_of_nonneg_left hK hc0
      _ ≤ 1 * Uerr := mul_le_mul_of_nonneg_right hc1 hUerr
      _ = Uerr := one_mul _
  have hden : 0 < 1 + ρ := by linarith
  have hR : 0 ≤ R q B := by
    dsimp [R, FormalAB.S9652ac8c.A5AffineFiniteGate.affineR]
    positivity
  have hdenO : 0 < Q + R q B := add_pos_of_pos_of_nonneg hQ hR
  have hthreshold : gate q B s = (s + (1 - 3 * s) * z + ρ) / (1 + ρ) := by
    unfold gate
    apply (div_eq_div_iff hdenO.ne' hden.ne').mpr
    dsimp [z, ρ]
    field_simp [hQ.ne']
    ; ring
  have hres :
      (s + (1 - 3 * s) * z + ρ) - m * (1 + ρ) = (1 - m) * K := by
    calc
      _ = ((s + (1 - 3 * s) * z + z ^ 2 / 3) - m * (1 + z ^ 2 / 3)) +
          (1 - m) * (ρ - z ^ 2 / 3) := by ring
      _ = (1 - m) * (z - t) ^ 2 / 3 + (1 - m) * (ρ - z ^ 2 / 3) := by
        rw [hsquare z]
      _ = (1 - m) * K := by dsimp [K]; ring
  have hthresholdU : gate q B s ≤ m + Uerr := by
    rw [hthreshold]
    apply (div_le_iff₀ hden).mpr
    have hextra : 0 ≤ Uerr * ρ := mul_nonneg hUerr hρ0
    rw [← hres] at hcK
    nlinarith only [hcK, hextra]
  have h27 : 2 / (3 * Q) ≤ 7 / (3 * Q) := by
    apply (div_le_div_iff₀ (by positivity : 0 < 3 * Q)
      (by positivity : 0 < 3 * Q)).mpr
    nlinarith only [hQ]
  refine ⟨hBpos, hBle, ?_⟩
  change gate q B s ≤ m + 7 / (3 * Q)
  dsimp [Uerr] at hthresholdU
  linarith only [hthresholdU, h27]

private lemma margin_formula (A B : ℕ) (hA : 1 ≤ A) (hB : B ≤ A)
    (s μ : ℝ) :
    margin A B s μ =
      (H A B : ℝ) * ((A : ℝ) + R A B) * (μ - gate A B s) / 2 := by
  have hd := FormalAB.S9652ac8c.A5AffineFiniteGate.MarginInternal.degree_sum_formula A B
  change 2 * (iSum A B : ℝ) = (H A B : ℝ) * (A : ℝ) ∧
    2 * (jSum A B : ℝ) = (H A B : ℝ) * (B : ℝ) at hd
  have hsigma := FormalAB.S9652ac8c.A5AffineFiniteGate.MarginInternal.affineSigma_formula A B hB μ
  change 2 * weight A B μ =
    (H A B : ℝ) * (μ * (A : ℝ) + (B : ℝ) + (μ - 1) * R A B) at hsigma
  have hi : (iSum A B : ℝ) = (H A B : ℝ) * (A : ℝ) / 2 := by linarith [hd.1]
  have hj : (jSum A B : ℝ) = (H A B : ℝ) * (B : ℝ) / 2 := by linarith [hd.2]
  have hw : weight A B μ =
      (H A B : ℝ) * (μ * (A : ℝ) + (B : ℝ) + (μ - 1) * R A B) / 2 := by
    linarith
  have hAr : (1 : ℝ) ≤ (A : ℝ) := by exact_mod_cast hA
  have hR : 0 ≤ R A B := by
    dsimp [R, FormalAB.S9652ac8c.A5AffineFiniteGate.affineR]
    positivity
  have hden : (A : ℝ) + R A B ≠ 0 := by positivity
  unfold margin gate
  rw [hi, hj, hw]
  field_simp [hden]
  ; ring

private lemma finite_margin_lower (q : ℕ) (hq6 : 6 ≤ q)
    (δ : ℝ) (hδ : 0 < δ) (hqδ : 5 / δ ≤ (q : ℝ))
    (s : ℝ) (hs : (2 / 5 : ℝ) ≤ s) (hs' : s ≤ (35 / 81 : ℝ)) :
    let B : ℕ := degreeB q s
    1 ≤ B ∧ B ≤ q ∧ δ / 4 ≤ margin q B s (mStar s + δ) := by
  let B : ℕ := degreeB q s
  obtain ⟨hBpos, hBle, hgate⟩ := floor_threshold_bound q hq6 s hs hs'
  have hq : 1 ≤ q := by omega
  have hqR : (1 : ℝ) ≤ (q : ℝ) := by exact_mod_cast hq
  have hq0 : (0 : ℝ) < (q : ℝ) := by linarith
  have hδQ : 5 ≤ (q : ℝ) * δ := (div_le_iff₀ hδ).mp hqδ
  have herror : 7 / (3 * (q : ℝ)) ≤ δ / 2 := by
    apply (div_le_iff₀ (by positivity : 0 < 3 * (q : ℝ))).mpr
    nlinarith only [hδQ]
  have hdiff : δ / 2 ≤ mStar s + δ - gate q B s := by linarith
  have hR : 0 ≤ R q B := by
    dsimp [R, FormalAB.S9652ac8c.A5AffineFiniteGate.affineR]
    positivity
  have hH : (1 : ℝ) ≤ (H q B : ℝ) := by
    have hn : (1 : ℕ) ≤ (q + 1) * (B + 1) :=
      Nat.succ_le_of_lt (Nat.mul_pos (Nat.succ_pos q) (Nat.succ_pos B))
    exact_mod_cast hn
  let p : ℝ := (H q B : ℝ) * ((q : ℝ) + R q B)
  have hp : 1 ≤ p := by
    have hqR' : 1 ≤ (q : ℝ) + R q B := by linarith
    have hH0 : 0 ≤ (H q B : ℝ) := by linarith
    dsimp [p]
    simpa only [one_mul] using
      (mul_le_mul hH hqR' (by norm_num : (0 : ℝ) ≤ 1) hH0)
  have hmul := mul_le_mul_of_nonneg_left hdiff (show 0 ≤ p by linarith)
  have hbase := mul_le_mul_of_nonneg_right hp (show 0 ≤ δ / 4 by linarith)
  refine ⟨hBpos, hBle, ?_⟩
  rw [margin_formula q B hq hBle]
  change δ / 4 ≤ p * (mStar s + δ - gate q B s) / 2
  nlinarith only [hmul, hbase]

private lemma cofactor_window (x D a b : ℝ)
    (_hx : 0 < x) (hD : 0 < D) (ha : 0 ≤ a) (hb : 0 ≤ b)
    (haD : D / 2 < a) (haD' : a ≤ D)
    (hn : x / 4 < a ^ 3 * b) (hn' : a ^ 3 * b ≤ 2 * x) :
    (2 * x / D ^ 3) / 8 ≤ b ∧ b ≤ 8 * (2 * x / D ^ 3) := by
  have hD3 : 0 < D ^ 3 := by positivity
  have hpow : a ^ 3 ≤ D ^ 3 := pow_le_pow_left₀ ha haD' 3
  have hpow' : (D / 2) ^ 3 ≤ a ^ 3 :=
    pow_le_pow_left₀ (by positivity) haD.le 3
  have hl := mul_le_mul_of_nonneg_right hpow hb
  have hu := mul_le_mul_of_nonneg_right hpow' hb
  constructor
  · apply (div_le_iff₀ (by norm_num : (0 : ℝ) < 8)).mpr
    apply (div_le_iff₀ hD3).mpr
    nlinarith
  · rw [← mul_div_assoc]
    apply (le_div_iff₀ hD3).mpr
    nlinarith

private lemma cell_cofactor_windows (x D E : ℝ) (M j : ℕ) (h : ℤ)
    (hx : 8 ≤ x) (hD : 0 < D) (hE : 0 < E)
    (hh : h = 1 ∨ h = -1) (z : Point)
    (hz : z ∈ originalCell x D E M j h) :
    (2 * x / D ^ 3) / 8 ≤ (z.2.1 : ℝ) ∧
      (z.2.1 : ℝ) ≤ 8 * (2 * x / D ^ 3) ∧
      (2 * x / E ^ 3) / 8 ≤ (z.2.2 : ℝ) ∧
      (z.2.2 : ℝ) ≤ 8 * (2 * x / E ^ 3) := by
  rcases hz with ⟨hd, he, hu, hv, hshift, hn, hn', hdD, hdD', heE, heE', -, -⟩
  have hx0 : 0 < x := by linarith
  have hnR : x / 2 < (z.1.1 : ℝ) ^ 3 * (z.2.1 : ℝ) := by exact_mod_cast hn
  have hnR' : (z.1.1 : ℝ) ^ 3 * (z.2.1 : ℝ) ≤ x := by exact_mod_cast hn'
  have hshiftR :
      (z.1.2 : ℝ) ^ 3 * (z.2.2 : ℝ) =
        (z.1.1 : ℝ) ^ 3 * (z.2.1 : ℝ) + (h : ℝ) := by exact_mod_cast hshift
  have hhr : -(1 : ℝ) ≤ (h : ℝ) ∧ (h : ℝ) ≤ 1 := by
    rcases hh with rfl | rfl <;> norm_num
  have huWin := cofactor_window x D (z.1.1 : ℝ) (z.2.1 : ℝ)
    hx0 hD (Nat.cast_nonneg _) (Nat.cast_nonneg _) hdD hdD'
    (by linarith) (by linarith)
  have hvWin := cofactor_window x E (z.1.2 : ℝ) (z.2.2 : ℝ)
    hx0 hE (Nat.cast_nonneg _) (Nat.cast_nonneg _) heE heE'
    (by linarith) (by linarith)
  exact ⟨huWin.1, huWin.2, hvWin.1, hvWin.2⟩

private lemma cell_coordinate_bounds (x D E : ℝ) (M j : ℕ) (h : ℤ)
    (hx : 8 ≤ x) (hh : h = 1 ∨ h = -1) (z : Point)
    (hz : z ∈ originalCell x D E M j h) :
    (z.1.1 : ℝ) ≤ 2 * x ∧ (z.1.2 : ℝ) ≤ 2 * x ∧
      (z.2.1 : ℝ) ≤ 2 * x ∧ (z.2.2 : ℝ) ≤ 2 * x := by
  rcases hz with ⟨hd, he, hu, hv, hshift, -, hn, -⟩
  have hd1 : (1 : ℝ) ≤ (z.1.1 : ℝ) := by exact_mod_cast hd
  have he1 : (1 : ℝ) ≤ (z.1.2 : ℝ) := by exact_mod_cast he
  have hu1 : (1 : ℝ) ≤ (z.2.1 : ℝ) := by exact_mod_cast hu
  have hv1 : (1 : ℝ) ≤ (z.2.2 : ℝ) := by exact_mod_cast hv
  have hnR : (z.1.1 : ℝ) ^ 3 * (z.2.1 : ℝ) ≤ x := by exact_mod_cast hn
  have hshiftR :
      (z.1.2 : ℝ) ^ 3 * (z.2.2 : ℝ) =
        (z.1.1 : ℝ) ^ 3 * (z.2.1 : ℝ) + (h : ℝ) := by exact_mod_cast hshift
  have hhr : (h : ℝ) ≤ 1 := by rcases hh with rfl | rfl <;> norm_num
  have hprodE : (z.1.2 : ℝ) ^ 3 * (z.2.2 : ℝ) ≤ 2 * x := by linarith
  have hd3 : (z.1.1 : ℝ) ≤ (z.1.1 : ℝ) ^ 3 := by
    have hp := pow_le_pow_right₀ hd1 (show (1 : ℕ) ≤ 3 by omega)
    simpa using hp
  have he3 : (z.1.2 : ℝ) ≤ (z.1.2 : ℝ) ^ 3 := by
    have hp := pow_le_pow_right₀ he1 (show (1 : ℕ) ≤ 3 by omega)
    simpa using hp
  have hd31 : (1 : ℝ) ≤ (z.1.1 : ℝ) ^ 3 := one_le_pow₀ hd1
  have he31 : (1 : ℝ) ≤ (z.1.2 : ℝ) ^ 3 := one_le_pow₀ he1
  have hdprod : (z.1.1 : ℝ) ^ 3 ≤ (z.1.1 : ℝ) ^ 3 * (z.2.1 : ℝ) := by
    simpa using mul_le_mul_of_nonneg_left hu1 (pow_nonneg (Nat.cast_nonneg _) 3)
  have heprod : (z.1.2 : ℝ) ^ 3 ≤ (z.1.2 : ℝ) ^ 3 * (z.2.2 : ℝ) := by
    simpa using mul_le_mul_of_nonneg_left hv1 (pow_nonneg (Nat.cast_nonneg _) 3)
  have huprod : (z.2.1 : ℝ) ≤ (z.1.1 : ℝ) ^ 3 * (z.2.1 : ℝ) := by
    simpa using mul_le_mul_of_nonneg_right hd31 (Nat.cast_nonneg z.2.1 : (0 : ℝ) ≤ z.2.1)
  have hvprod : (z.2.2 : ℝ) ≤ (z.1.2 : ℝ) ^ 3 * (z.2.2 : ℝ) := by
    simpa using mul_le_mul_of_nonneg_right he31 (Nat.cast_nonneg z.2.2 : (0 : ℝ) ≤ z.2.2)
  exact ⟨by linarith, he3.trans (heprod.trans hprodE), by linarith, hvprod.trans hprodE⟩

private lemma cell_width (x D E μ : ℝ) (j : ℕ)
    (hx : 8 ≤ x) (hD : 0 < D) (hE : 0 < E)
    (hμ : 0 ≤ μ) (h : ℤ) (z : Point)
    (hj : j ∈ cells D E ⌈x ^ μ⌉₊)
    (hz : z ∈ originalCell x D E ⌈x ^ μ⌉₊ j h) :
    (1 / 2 : ℝ) ≤ rho D E ⌈x ^ μ⌉₊ j / (D / E) ∧
      rho D E ⌈x ^ μ⌉₊ j / (D / E) ≤ 2 ∧
      |((z.1.1 : ℝ) / (z.1.2 : ℝ)) / (D / E) -
          rho D E ⌈x ^ μ⌉₊ j / (D / E)| ≤ 2 * (x / 4) ^ (-μ) := by
  let M : ℕ := ⌈x ^ μ⌉₊
  let r : ℝ := rho D E M j
  let t : ℝ := (z.1.1 : ℝ) / (z.1.2 : ℝ)
  have hx0 : 0 < x := by linarith
  have hp : 0 < x ^ μ := Real.rpow_pos_of_pos hx0 _
  have hceil : x ^ μ ≤ (M : ℝ) := Nat.le_ceil _
  have hM : 0 < (M : ℝ) := hp.trans_le hceil
  have hQ : 0 < D / E := div_pos hD hE
  have hc := (Finset.mem_filter.mp hj).2
  change D / (2 * E) ≤ r ∧ r ≤ 2 * D / E at hc
  rcases hz with ⟨-, -, -, -, -, -, -, -, -, -, -, htlo, hthi⟩
  have ht : r < t ∧ t ≤ r * (1 + 1 / (M : ℝ)) := ⟨htlo, hthi⟩
  have hrlo : (D / E) / 2 ≤ r := by
    convert hc.1 using 1 ; field_simp [hE.ne']
  have hrhi : r ≤ 2 * (D / E) := by
    convert hc.2 using 1 ; field_simp [hE.ne']
  have hdiff : t - r ≤ 2 * (D / E) / (M : ℝ) := by
    have hw : t - r ≤ r / (M : ℝ) := by
      have hid : r * (1 + 1 / (M : ℝ)) = r + r / (M : ℝ) := by ring
      rw [hid] at ht
      linarith
    exact hw.trans (div_le_div_of_nonneg_right hrhi hM.le)
  have habs : |t / (D / E) - r / (D / E)| ≤ 2 / (M : ℝ) := by
    rw [abs_of_nonneg (sub_nonneg.mpr (div_le_div_of_nonneg_right ht.1.le hQ.le))]
    calc
      t / (D / E) - r / (D / E) = (t - r) / (D / E) := by ring
      _ ≤ (2 * (D / E) / (M : ℝ)) / (D / E) :=
        div_le_div_of_nonneg_right hdiff hQ.le
      _ = 2 / (M : ℝ) := by field_simp [hD.ne', hE.ne', hM.ne']
  have hinv : 1 / (M : ℝ) ≤ x ^ (-μ) := by
    apply (div_le_iff₀ hM).mpr
    have hmul : x ^ μ * x ^ (-μ) = 1 := by rw [← Real.rpow_add hx0]; simp
    have hp' := mul_le_mul_of_nonneg_right hceil (Real.rpow_nonneg hx0.le (-μ))
    nlinarith
  have hanti : x ^ (-μ) ≤ (x / 4) ^ (-μ) :=
    Real.rpow_le_rpow_of_nonpos (by linarith) (by linarith) (by linarith)
  refine ⟨?_, ?_, ?_⟩
  · exact (le_div_iff₀ hQ).mpr (by linarith [hrlo])
  · exact (div_le_iff₀ hQ).mpr hrhi
  · change |t / (D / E) - r / (D / E)| ≤ 2 * (x / 4) ^ (-μ)
    calc
      _ ≤ 2 / (M : ℝ) := habs
      _ = 2 * (1 / (M : ℝ)) := by ring
      _ ≤ 2 * x ^ (-μ) := mul_le_mul_of_nonneg_left hinv (by norm_num)
      _ ≤ 2 * (x / 4) ^ (-μ) := mul_le_mul_of_nonneg_left hanti (by norm_num)

private lemma cell_entry_height (A B : ℕ) (hB : B ≤ A)
    (x D E : ℝ) (M j : ℕ) (h : ℤ) (hx : 8 ≤ x)
    (hh : h = 1 ∨ h = -1) (z : Point)
    (hz : z ∈ originalCell x D E M j h) (c : Cols A B) :
    |(entry A B z c : ℝ)| ≤ (2 : ℝ) ^ (2 * A) * x ^ (2 * A) := by
  have hp := cell_coordinate_bounds x D E M j h hx hh z hz
  have heq :
      |(entry A B z c : ℝ)| =
        (z.1.1 : ℝ) ^ (c.1 : ℕ) * (z.1.2 : ℝ) ^ (A - (c.1 : ℕ)) *
        (z.2.2 : ℝ) ^ (c.2 : ℕ) * (z.2.1 : ℝ) ^ (B - (c.2 : ℕ)) := by
    simp only [entry, FormalAB.Sb751f117.A5CentralOriginalAuxiliary.entry,
      Int.cast_mul, Int.cast_pow, Int.cast_natCast]
    exact abs_of_nonneg (by positivity)
  rw [heq]
  calc
    _ ≤ (2 * x) ^ (c.1 : ℕ) * (2 * x) ^ (A - (c.1 : ℕ)) *
        (2 * x) ^ (c.2 : ℕ) * (2 * x) ^ (B - (c.2 : ℕ)) := by
      gcongr <;> first | exact hp.1 | exact hp.2.1 | exact hp.2.2.1 | exact hp.2.2.2
    _ = (2 * x) ^ (A + B) := by
      rw [← pow_add, mul_assoc, ← pow_add, ← pow_add]
      congr 1
      have hi := c.1.isLt
      have hj := c.2.isLt
      omega
    _ ≤ (2 * x) ^ (2 * A) :=
      pow_le_pow_right₀ (by linarith) (by omega)
    _ = _ := by rw [mul_pow]

private lemma scaled_cost_le (A B : ℕ) (_hA : 1 ≤ A) (_hB : B ≤ A)
    (x s μ D E : ℝ) (hx : 0 < x) (hD : 0 < D) (hE : 0 < E)
    (hDE : D * E = x ^ s) (hμ : μ ≤ 1) :
    ((D / 2) * (E / 2)) ^ iSum A B *
        ((2 * x / D ^ 3) * (2 * x / E ^ 3)) ^ jSum A B *
        (x / 4) ^ (-weight A B μ) ≤
      (4 : ℝ) ^ jSum A B * (4 : ℝ) ^ weight A B 1 *
        x ^ (-margin A B s μ) := by
  let U : ℝ := x / D ^ 3
  let V : ℝ := x / E ^ 3
  have hU : 0 < U := by dsimp [U]; positivity
  have hV : 0 < V := by dsimp [V]; positivity
  have hUV : U * V = x ^ (2 - 3 * s) := by
    calc
      U * V = x ^ 2 / (D * E) ^ 3 := by
        dsimp [U, V]
        field_simp

      _ = x ^ (2 : ℝ) / (x ^ s) ^ 3 := by
        rw [hDE]
        norm_num [Real.rpow_natCast]
      _ = x ^ (2 - 3 * s) := by
        rw [← Real.rpow_natCast (x ^ s) 3, ← Real.rpow_mul hx.le,
          ← Real.rpow_sub hx]
        congr 1
        ring
  have hi : (D * E) ^ iSum A B = x ^ (s * (iSum A B : ℝ)) := by
    rw [hDE, Real.rpow_mul hx.le, Real.rpow_natCast]
  have hj : (U * V) ^ jSum A B = x ^ ((2 - 3 * s) * (jSum A B : ℝ)) := by
    rw [hUV, Real.rpow_mul hx.le, Real.rpow_natCast]
  have hprofile :
      (D * E) ^ iSum A B * (U * V) ^ jSum A B *
        x ^ (-weight A B μ) = x ^ (-margin A B s μ) := by
    rw [hi, hj, ← Real.rpow_add hx, ← Real.rpow_add hx]
    congr 1
    unfold margin
    ring
  have hscale :
      (x / 4) ^ (-weight A B μ) =
        (4 : ℝ) ^ weight A B μ * x ^ (-weight A B μ) := by
    rw [Real.div_rpow hx.le (by norm_num)]
    apply (div_eq_iff (Real.rpow_pos_of_pos (by norm_num : (0 : ℝ) < 4) _).ne').mpr
    have ht : (4 : ℝ) ^ weight A B μ * (4 : ℝ) ^ (-weight A B μ) = 1 := by
      rw [← Real.rpow_add (by norm_num : (0 : ℝ) < 4)]
      simp
    calc
      x ^ (-weight A B μ) =
          x ^ (-weight A B μ) *
            ((4 : ℝ) ^ weight A B μ * (4 : ℝ) ^ (-weight A B μ)) := by rw [ht]; ring
      _ = _ := by ring
  have hUVg :
      (2 * x / D ^ 3) * (2 * x / E ^ 3) = 4 * (U * V) := by
    dsimp [U, V]
    ring
  have hDg : ((D / 2) * (E / 2)) ^ iSum A B ≤ (D * E) ^ iSum A B := by
    apply pow_le_pow_left₀ (by positivity)
    have hp := mul_pos hD hE
    nlinarith
  have hrest :
      0 ≤ ((2 * x / D ^ 3) * (2 * x / E ^ 3)) ^ jSum A B *
        (x / 4) ^ (-weight A B μ) := by positivity
  calc
    _ ≤ (D * E) ^ iSum A B *
        ((2 * x / D ^ 3) * (2 * x / E ^ 3)) ^ jSum A B *
        (x / 4) ^ (-weight A B μ) := by
      simpa only [mul_assoc] using mul_le_mul_of_nonneg_right hDg hrest
    _ = (4 : ℝ) ^ jSum A B * (4 : ℝ) ^ weight A B μ *
        ((D * E) ^ iSum A B * (U * V) ^ jSum A B *
          x ^ (-weight A B μ)) := by
      rw [hUVg, mul_pow, hscale]
      ring
    _ = (4 : ℝ) ^ jSum A B * (4 : ℝ) ^ weight A B μ *
        x ^ (-margin A B s μ) := by rw [hprofile]
    _ ≤ _ := by
      have hw :
          weight A B μ ≤ weight A B 1 :=
        FormalAB.Sb751f117.A5CentralOriginalAuxiliary.weight_le_one A B μ hμ
      have hp := Real.rpow_le_rpow_of_exponent_le
        (by norm_num : (1 : ℝ) ≤ 4) hw
      exact mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left hp (by positivity)) (by positivity)

private lemma cell_minor_decay (A B : ℕ) (hA : 1 ≤ A) (hB : B ≤ A) :
    ∃ C X : ℝ, 0 < C ∧ 8 ≤ X ∧
      ∀ x s δ D E : ℝ, X ≤ x →
        (2 / 5 : ℝ) ≤ s → s ≤ (35 / 81 : ℝ) →
        0 < δ → δ < (1 / 2000 : ℝ) →
        0 < D → 0 < E → D * E = x ^ s →
        ∀ j : ℕ, j ∈ cells D E ⌈x ^ (mStar s + δ)⌉₊ →
          ∀ h : ℤ, (h = 1 ∨ h = -1) →
            ∀ z : Cols A B → Point,
              (∀ i, z i ∈ originalCell x D E ⌈x ^ (mStar s + δ)⌉₊ j h) →
              |((Matrix.det (fun i c : Cols A B => entry A B (z i) c) : ℤ) : ℝ)| ≤
                C * x ^ (-margin A B s (mStar s + δ)) := by
  obtain ⟨C, X, hC, hX, hgate⟩ :=
    A6Threshold8CubicDenominator.cubic_gate A B hB 2 (by norm_num)
  let C' : ℝ := C * (4 : ℝ) ^ jSum A B * (4 : ℝ) ^ weight A B 1
  have hC' : 0 < C' := by dsimp [C']; positivity
  refine ⟨C', 4 * X, hC', by linarith, ?_⟩
  intro x s δ D E hx hs hs' hδ hδ' hD hE hDE j hj h hh z hz
  have hx8 : 8 ≤ x := by linarith
  have hx0 : 0 < x := by linarith
  let μ : ℝ := mStar s + δ
  let M : ℕ := ⌈x ^ μ⌉₊
  let S₀ : ℝ := rho D E M j / (D / E)
  have hμ := mu_bounds s δ hs hs' hδ hδ'
  have hw₀ := cell_width x D E μ j hx8 hD hE (by linarith) h
    (z (0, 0)) hj (hz (0, 0))
  have hdres : (D / 2) ^ 3 * (2 * x / D ^ 3) = x / 4 := by
    field_simp [hD.ne']
    ; ring
  have heres : (E / 2) ^ 3 * (2 * x / E ^ 3) = x / 4 := by
    field_simp [hE.ne']
    ; ring
  have hrows : ∀ r : Cols A B,
      0 < (z r).1.1 ∧ 0 < (z r).1.2 ∧ 0 < (z r).2.1 ∧ 0 < (z r).2.2 ∧
      D / 2 ≤ ((z r).1.1 : ℝ) ∧ ((z r).1.1 : ℝ) ≤ 2 * (D / 2) ∧
      E / 2 ≤ ((z r).1.2 : ℝ) ∧ ((z r).1.2 : ℝ) ≤ 2 * (E / 2) ∧
      (2 * x / D ^ 3) / 8 ≤ ((z r).2.1 : ℝ) ∧
      ((z r).2.1 : ℝ) ≤ 8 * (2 * x / D ^ 3) ∧
      (2 * x / E ^ 3) / 8 ≤ ((z r).2.2 : ℝ) ∧
      ((z r).2.2 : ℝ) ≤ 8 * (2 * x / E ^ 3) ∧
      |((((z r).1.1 : ℝ) / ((z r).1.2 : ℝ)) / ((D / 2) / (E / 2))) - S₀| ≤
        2 * (x / 4) ^ (-μ) ∧
      ((z r).1.2 : ℤ) ^ 3 * ((z r).2.2 : ℤ) -
        ((z r).1.1 : ℤ) ^ 3 * ((z r).2.1 : ℤ) = h := by
    intro r
    have hc := cell_cofactor_windows x D E M j h hx8 hD hE hh (z r) (hz r)
    have hw := cell_width x D E μ j hx8 hD hE (by linarith) h (z r) hj (hz r)
    rcases hz r with ⟨hd, he, hu, hv, hshift, -, -, hdD, hdD', heE, heE', -, -⟩
    refine ⟨by omega, by omega, by omega, by omega,
      hdD.le, by linarith, heE.le, by linarith,
      hc.1, hc.2.1, hc.2.2.1, hc.2.2.2, ?_, ?_⟩
    · have hratio : (D / 2) / (E / 2) = D / E := by field_simp [hE.ne']
      rw [hratio]
      exact hw.2.2
    · push_cast at hshift
      linarith
  have hg := hgate (x / 4) μ (D / 2) (E / 2)
    (2 * x / D ^ 3) (2 * x / E ^ 3) S₀
    (by linarith) hμ.1 hμ.2 (by positivity) (by positivity)
    (by positivity) (by positivity) hdres heres hw₀.1 hw₀.2.1
    h hh (fun r => (z r).1.1) (fun r => (z r).1.2)
      (fun r => (z r).2.1) (fun r => (z r).2.2) hrows
  change |((Matrix.det (fun i c : Cols A B => entry A B (z i) c) : ℤ) : ℝ)| ≤
    C * ((D / 2) * (E / 2)) ^ iSum A B *
      ((2 * x / D ^ 3) * (2 * x / E ^ 3)) ^ jSum A B *
      (x / 4) ^ (-weight A B μ) at hg
  have hc := scaled_cost_le A B hA hB x s μ D E hx0 hD hE hDE (by linarith)
  have hc' := mul_le_mul_of_nonneg_left hc hC.le
  calc
    _ ≤ C * ((D / 2) * (E / 2)) ^ iSum A B *
        ((2 * x / D ^ 3) * (2 * x / E ^ 3)) ^ jSum A B *
        (x / 4) ^ (-weight A B μ) := hg
    _ ≤ C * ((4 : ℝ) ^ jSum A B * (4 : ℝ) ^ weight A B 1 *
        x ^ (-margin A B s μ)) := by simpa only [mul_assoc] using hc'
    _ = C' * x ^ (-margin A B s (mStar s + δ)) := by dsimp [C', μ]; ring

private theorem all_cell_minors_zero (δ : ℝ) (hδ : 0 < δ)
    (hδ' : δ < (1 / 2000 : ℝ)) :
    ∃ q : ℕ, ∃ X₀ : ℝ, 6 ≤ q ∧ 5 / δ ≤ (q : ℝ) ∧ 8 ≤ X₀ ∧
      ∀ x : ℝ, X₀ ≤ x →
        ∀ s : ℝ, (2 / 5 : ℝ) ≤ s → s ≤ (35 / 81 : ℝ) →
          let B : ℕ := degreeB q s
          1 ≤ B ∧ B ≤ q ∧
            ∀ D E : ℝ, 0 < D → 0 < E → D * E = x ^ s →
              ∀ j : ℕ, j ∈ cells D E ⌈x ^ (mStar s + δ)⌉₊ →
                ∀ h : ℤ, (h = 1 ∨ h = -1) →
                  ∀ z : Cols q B → Point,
                    (∀ i, z i ∈ originalCell x D E ⌈x ^ (mStar s + δ)⌉₊ j h) →
                    Matrix.det (fun i c : Cols q B => entry q B (z i) c) = 0 := by
  classical
  obtain ⟨q, hqgt⟩ := exists_nat_gt (max (6 : ℝ) (5 / δ))
  have hq6R : (6 : ℝ) < (q : ℝ) :=
    lt_of_le_of_lt (le_max_left (6 : ℝ) (5 / δ)) hqgt
  have hq6 : 6 ≤ q := by exact_mod_cast hq6R.le
  have hq : 1 ≤ q := by omega
  have hqδ : 5 / δ ≤ (q : ℝ) := (le_max_right (6 : ℝ) (5 / δ)).trans hqgt.le
  have hEach : ∀ b : Fin (q + 1), ∃ C X : ℝ, 0 < C ∧ 8 ≤ X ∧
      ∀ x s δ' D E : ℝ, X ≤ x →
        (2 / 5 : ℝ) ≤ s → s ≤ (35 / 81 : ℝ) →
        0 < δ' → δ' < (1 / 2000 : ℝ) →
        0 < D → 0 < E → D * E = x ^ s →
        ∀ j : ℕ, j ∈ cells D E ⌈x ^ (mStar s + δ')⌉₊ →
          ∀ h : ℤ, (h = 1 ∨ h = -1) →
            ∀ z : Cols q b.val → Point,
              (∀ i, z i ∈ originalCell x D E ⌈x ^ (mStar s + δ')⌉₊ j h) →
              |((Matrix.det (fun i c : Cols q b.val => entry q b.val (z i) c) : ℤ) : ℝ)| ≤
                C * x ^ (-margin q b.val s (mStar s + δ')) := by
    intro b
    exact cell_minor_decay q b.val hq (Nat.le_of_lt_succ b.isLt)
  choose C X hC hX hDecay using hEach
  let G : ℝ := 1 + ∑ b : Fin (q + 1), C b
  let W : ℝ := 8 + ∑ b : Fin (q + 1), X b
  have hG : 0 < G := by
    dsimp [G]
    have hn : 0 ≤ ∑ b : Fin (q + 1), C b :=
      Finset.sum_nonneg (by intro b hb; exact (hC b).le)
    linarith
  have hW : 8 ≤ W := by
    dsimp [W]
    have hn : 0 ≤ ∑ b : Fin (q + 1), X b :=
      Finset.sum_nonneg (by intro b hb; linarith [hX b])
    linarith
  have hCG : ∀ b : Fin (q + 1), C b ≤ G := by
    intro b
    have hb : C b ≤ ∑ t : Fin (q + 1), C t :=
      Finset.single_le_sum (by intro t ht; exact (hC t).le) (Finset.mem_univ b)
    dsimp [G]
    linarith
  have hXW : ∀ b : Fin (q + 1), X b ≤ W := by
    intro b
    have hb : X b ≤ ∑ t : Fin (q + 1), X t :=
      Finset.single_le_sum (by intro t ht; linarith [hX t]) (Finset.mem_univ b)
    dsimp [W]
    linarith
  let τ : ℝ := δ / 4
  have hτ : 0 < τ := by dsimp [τ]; linarith
  let X₀ : ℝ := max W ((2 * G) ^ (1 / τ))
  have hX₀ : 8 ≤ X₀ := hW.trans (le_max_left _ _)
  refine ⟨q, X₀, hq6, hqδ, hX₀, ?_⟩
  intro x hx s hs hs'
  let B : ℕ := degreeB q s
  have hm := finite_margin_lower q hq6 δ hδ hqδ s hs hs'
  change 1 ≤ B ∧ B ≤ q ∧ δ / 4 ≤ margin q B s (mStar s + δ) at hm
  refine ⟨hm.1, hm.2.1, ?_⟩
  intro D E hD hE hDE j hj h hh z hz
  have hxW : W ≤ x := (le_max_left _ _).trans hx
  have hx8 : 8 ≤ x := hX₀.trans hx
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  let b : Fin (q + 1) := ⟨B, Nat.lt_succ_of_le hm.2.1⟩
  have hd := hDecay b x s δ D E ((hXW b).trans hxW)
    hs hs' hδ hδ' hD hE hDE j hj h hh z hz
  have hmargin : τ ≤ margin q B s (mStar s + δ) := hm.2.2
  have hexp : x ^ (-margin q B s (mStar s + δ)) ≤ x ^ (-τ) :=
    Real.rpow_le_rpow_of_exponent_le hx1 (by linarith)
  have hpow : 2 * G ≤ x ^ τ := by
    have hbase : 0 < 2 * G := by positivity
    have hxx : (2 * G) ^ (1 / τ) ≤ x := (le_max_right _ _).trans hx
    have hmono := Real.rpow_le_rpow (Real.rpow_nonneg hbase.le _) hxx hτ.le
    have hid : ((2 * G) ^ (1 / τ)) ^ τ = 2 * G := by
      rw [← Real.rpow_mul hbase.le]
      have heq : (1 / τ) * τ = 1 := by field_simp [hτ.ne']
      rw [heq, Real.rpow_one]
    rwa [hid] at hmono
  have hunit : x ^ τ * x ^ (-τ) = 1 := by rw [← Real.rpow_add hx0]; simp
  have hprice : G * x ^ (-τ) ≤ (1 / 2 : ℝ) := by
    have hp := mul_le_mul_of_nonneg_right hpow (Real.rpow_nonneg hx0.le (-τ))
    nlinarith
  have hsmall :
      |((Matrix.det (fun i c : Cols q B => entry q B (z i) c) : ℤ) : ℝ)| < 1 := by
    calc
      _ ≤ C b * x ^ (-margin q B s (mStar s + δ)) := hd
      _ ≤ G * x ^ (-margin q B s (mStar s + δ)) :=
        mul_le_mul_of_nonneg_right (hCG b) (Real.rpow_nonneg hx0.le _)
      _ ≤ G * x ^ (-τ) := mul_le_mul_of_nonneg_left hexp hG.le
      _ ≤ 1 / 2 := hprice
      _ < 1 := by norm_num
  have hint :
      |Matrix.det (fun i c : Cols q B => entry q B (z i) c)| < (1 : ℤ) := by
    exact_mod_cast hsmall
  have hzero : Matrix.det (fun i c : Cols q B => entry q B (z i) c) = 0 := by
    have hp := abs_lt.mp hint
    omega
  exact hzero

abbrev heightPower := FormalAB.Sb751f117.A5CentralOriginalAuxiliary.heightPower
abbrev heightThreshold := FormalAB.Sb751f117.A5CentralOriginalAuxiliary.heightThreshold

def Statement : Prop :=
  ∀ δ : ℝ, 0 < δ → δ < (1 / 2000 : ℝ) → ∃ q : ℕ, ∃ K X₀ : ℝ, 6 ≤ q ∧ 5 / δ ≤ (q : ℝ) ∧ 0 < K ∧ 8 ≤ X₀ ∧ ∀ x : ℝ, X₀ ≤ x → ∀ s : ℝ, (2 / 5 : ℝ) ≤ s → s ≤ (35 / 81 : ℝ) → ∀ D E : ℝ, 0 < D → 0 < E → D * E = x ^ s → let B : ℕ := degreeB q s; let M : ℕ := ⌈x ^ (mStar s + δ)⌉₊; 1 ≤ B ∧ B ≤ q ∧ ∀ j : ℕ, j ∈ cells D E M → ∀ h : ℤ, (h = 1 ∨ h = -1) → ∃ F : MvPolynomial (Fin 4) ℤ, F ≠ 0 ∧ (∀ m ∈ F.support, m 0 + m 1 = q ∧ m 2 + m 3 = B) ∧ F.totalDegree ≤ q + B ∧ (∀ m : Fin 4 →₀ ℕ, |((F.coeff m : ℤ) : ℝ)| ≤ x ^ K) ∧ ∀ z ∈ originalCell x D E M j h, MvPolynomial.eval ![(z.1.1 : ℤ), (z.1.2 : ℤ), (z.2.1 : ℤ), (z.2.2 : ℤ)] F = 0

theorem main : Statement := by
  intro δ hδ hδ'
  obtain ⟨q, X, hq, hqδ, hX, hminor⟩ := all_cell_minors_zero δ hδ hδ'
  let K : ℝ := (heightPower q : ℝ)
  let X₀ : ℝ := max X (heightThreshold q)
  have hX₀ : (8 : ℝ) ≤ X₀ := hX.trans (le_max_left _ _)
  have hK : 0 < K := by
    dsimp [K, heightPower, FormalAB.Sb751f117.A5CentralOriginalAuxiliary.heightPower]
    positivity
  refine ⟨q, K, X₀, hq, hqδ, hK, hX₀, ?_⟩
  intro x hx s hs hs' D E hD hE hDE
  let B : ℕ := degreeB q s
  let M : ℕ := ⌈x ^ (mStar s + δ)⌉₊
  have hxX : X ≤ x := (le_max_left _ _).trans hx
  have hx8 : (8 : ℝ) ≤ x := hX₀.trans hx
  have hh := hminor x hxX s hs hs'
  change 1 ≤ B ∧ B ≤ q ∧ _ at hh
  refine ⟨hh.1, hh.2.1, ?_⟩
  intro j hj h hsign
  have hrows : ∀ z ∈ originalCell x D E M j h, ∀ c : Cols q B,
      |(entry q B z c : ℝ)| ≤ (2 : ℝ) ^ (2 * q) * x ^ (2 * q) := by
    intro z hz c
    exact cell_entry_height q B hh.2.1 x D E M j h hx8 hsign z hz c
  have hmin :
      ∀ z : Cols q B → Point,
        (∀ i, z i ∈ originalCell x D E M j h) →
        Matrix.det (fun i c : Cols q B => entry q B (z i) c) = 0 :=
    hh.2.2 D E hD hE hDE j hj h hsign
  have hhgt : heightThreshold q ≤ x := (le_max_right _ _).trans hx
  exact FormalAB.Sb751f117.A5CentralOriginalAuxiliary.all_point_polynomial
    q B hh.2.1 x (by linarith) hhgt (originalCell x D E M j h) hrows hmin

end A6Threshold8ActualAuxiliary

