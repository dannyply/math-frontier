private theorem ef
 (a b:I) (hab:bt a b = 1):
 1 ≤ |(a:O)| ∨ 1 ≤ |(b:O)|:=by
  have hab0:a ≠ 0 ∨ b ≠ 0:=by
    by_cases ha:a = 0
    · right
