  classical
  let f : Polynomial ℤ := C01.PcCurves.dehom R
  have hf : f ≠ 0 := fun h => hR0 (C01.PcCurves.eq_zero_of_dehom hR h)
  have hsplit := dehom_splits_of_not_three n hnodd R hR hR0 hthree
  obtain ⟨c, hc, roots, hcard, hfac, hroots⟩ :=
    integer_linear_factorization f hf hsplit
  let s : Multiset (Option ℚ) :=
    roots.map some + Multiset.replicate (n - f.natDegree) none
  have hle : f.natDegree ≤ n := C01.PcCurves.dehom_natDegree_le hR
  have hs : s.card = n := by
    simp only [s, Multiset.card_add, Multiset.card_map, Multiset.card_replicate,
      hcard]
    omega
  have hdehomprod : (s.map labelPoly).prod = (roots.map rationalLinear).prod := by
    simp [s, Multiset.map_add, Multiset.prod_add, Multiset.map_map,
      Function.comp_def, labelPoly]
  let B : MvPolynomial (Fin 2) ℤ := MvPolynomial.C c * (s.map labelLine).prod
  have hB : B.IsHomogeneous n := by
    simpa only [B, hs, zero_add] using
      (MvPolynomial.isHomogeneous_C (Fin 2) c).mul (label_product_homogeneous s)
  have hdehom : C01.PcCurves.dehom B = f := by
    rw [show C01.PcCurves.dehom B =
      C01.PcCurves.dehom (MvPolynomial.C c) *
        C01.PcCurves.dehom ((s.map labelLine).prod) from
      C01.PcCurves.dehom_mul _ _]
    rw [label_product_dehom, hdehomprod]
    have hconst : C01.PcCurves.dehom (MvPolynomial.C c : MvPolynomial (Fin 2) ℤ) =
        Polynomial.C c := by simp [C01.PcCurves.dehom]
    rw [hconst]
    exact hfac.symm
  have hsub : C01.PcCurves.dehom (R - B) = 0 := by
    rw [C01.PcCurves.dehom_sub, hdehom]
    exact sub_self f
  have heq : R = B := sub_eq_zero.mp
    (C01.PcCurves.eq_zero_of_dehom (hR.sub hB) hsub)
  exact ⟨c, hc, s, hs, heq⟩

theorem factored_label_projective_zero (n : ℕ)
    (R : MvPolynomial (Fin 2) ℤ) (hR : R.IsHomogeneous n)
    (c : ℤ) (s : Multiset (Option ℚ))
    (hfac : R = MvPolynomial.C c * (s.map labelLine).prod)
    (z : Option ℚ) (hz : z ∈ s) :
    MvPolynomial.eval (projectivePoint (labelToComplex z)).rep
      (R.map (Int.castRingHom ℂ)) = 0 := by
  apply eval_projectivePoint_rep_zero _ n (hR.map (Int.castRingHom ℂ))
  rw [hfac, map_mul, MvPolynomial.eval_mul,
    label_product_root s z hz, mul_zero]

def PureComplexPower (n : ℕ) (R : MvPolynomial (Fin 2) ℤ) : Prop :=
  ∃ γ α β : ℂ, γ ≠ 0 ∧ (α ≠ 0 ∨ β ≠ 0) ∧
    ∀ r s : ℂ, MvPolynomial.eval ![r,s]
      (R.map (Int.castRingHom ℂ)) = γ * (α*r + β*s)^n

def TwoIndependentLines (n : ℕ) (R : MvPolynomial (Fin 2) ℤ) : Prop :=
  ∃ c a b a' b' : ℤ, ∃ j : ℕ,
    c ≠ 0 ∧ a*b' - a'*b ≠ 0 ∧ 1 ≤ j ∧ j < n ∧
      R = MvPolynomial.C c *
          (MvPolynomial.C a * MvPolynomial.X 0 +
            MvPolynomial.C b * MvPolynomial.X 1)^j *
          (MvPolynomial.C a' * MvPolynomial.X 0 +
            MvPolynomial.C b' * MvPolynomial.X 1)^(n-j)

theorem pure_of_label_power (n : ℕ) (R : MvPolynomial (Fin 2) ℤ)
    (c : ℤ) (hc : c ≠ 0) (a : Option ℚ)
    (hfac : R = MvPolynomial.C c * labelLine a ^ n) : PureComplexPower n R := by
  refine ⟨(c : ℂ), (lineCoeffA a : ℂ), (lineCoeffB a : ℂ), ?_, ?_, ?_⟩
  · exact_mod_cast hc
  · rcases label_coeff_nonzero a with ha | hb
    · left; exact_mod_cast ha
    · right; exact_mod_cast hb
  · intro r s
    rw [hfac]
    simp [labelLine]

theorem odd_binary_classification (n : ℕ) (hn : 3 ≤ n) (hnodd : Odd n)
    (R : MvPolynomial (Fin 2) ℤ)
    (hR : R.IsHomogeneous n) (hR0 : R ≠ 0) (hnpure : ¬ PureComplexPower n R) :
    HasThreeProjectiveZeros R ∨ TwoIndependentLines n R := by
  classical
  by_cases hthree : HasThreeProjectiveZeros R
  · exact Or.inl hthree
  · right
    obtain ⟨c, hc, labels, hcard, hfac⟩ :=
      binary_integer_linear_factorization n hnodd R hR hR0 hthree
    obtain ⟨a, ha⟩ := multiset_has_member labels (by omega)
    by_cases hone : ∀ z ∈ labels, z = a
    · have hp : R = MvPolynomial.C c * labelLine a ^ n := by
        rw [hfac, label_product_eq_pow labels a hone, hcard]
      exact False.elim (hnpure (pure_of_label_power n R c hc a hp))
    · push Not at hone
      obtain ⟨b, hb, hba⟩ := hone
      have hab : a ≠ b := Ne.symm hba
      have hproj : Function.Injective (fun z : Option ℚ =>
          projectivePoint (labelToComplex z)) :=
        projectivePoint_injective.comp labelToComplex_injective
      have hzero : ∀ z ∈ labels,
          MvPolynomial.eval (projectivePoint (labelToComplex z)).rep
            (R.map (Int.castRingHom ℂ)) = 0 :=
        factored_label_projective_zero n R hR c labels hfac
      have hcover : ∀ z ∈ labels, z = a ∨ z = b := by
        intro z hz
        by_cases hza : z = a
        · exact Or.inl hza
        by_cases hzb : z = b
        · exact Or.inr hzb
        exfalso
        apply hthree
        refine ⟨projectivePoint (labelToComplex a),
          projectivePoint (labelToComplex b),
          projectivePoint (labelToComplex z), ?_, ?_, ?_,
          hzero a ha, hzero b hb, hzero z hz⟩
        · exact fun he => hab (hproj he)
        · exact fun he => hza (hproj he).symm
        · exact fun he => hzb (hproj he).symm
      obtain ⟨j, hj, hj4, hprod⟩ :=
        twoSupportProduct (M := MvPolynomial (Fin 2) ℤ)
          n labels a b hcard ha hb hab hcover
      refine ⟨c, lineCoeffA a, lineCoeffB a,
        lineCoeffA b, lineCoeffB b, j, hc,
        label_coeff_independent a b hab, hj, hj4, ?_⟩
      rw [hfac, hprod labelLine]
      simp only [labelLine, mul_assoc]

end
end A6A8OddClassification

theorem JocelynClaims.claim_aa1f5246aab8ed8718414aed16da9eb6c1d38a5a42d844f86abff3c9151b4ea1 :
(let PureComplexPower : ℕ → MvPolynomial (Fin 2) ℤ → Prop := fun n R => ∃ γ α β : ℂ, γ ≠ 0 ∧ (α ≠ 0 ∨ β ≠ 0) ∧ ∀ r s : ℂ, MvPolynomial.eval ![r,s] (MvPolynomial.map (Int.castRingHom ℂ) R) = γ * (α*r+β*s)^n; ∀ n : ℕ, 3 ≤ n → Odd n → ∀ R : MvPolynomial (Fin 2) ℤ, R.IsHomogeneous n → R ≠ 0 → ¬PureComplexPower n R → (∃ p₁ p₂ p₃ : Projectivization ℂ (Fin 2 → ℂ), p₁ ≠ p₂ ∧ p₁ ≠ p₃ ∧ p₂ ≠ p₃ ∧ MvPolynomial.eval p₁.rep (MvPolynomial.map (Int.castRingHom ℂ) R) = 0 ∧ MvPolynomial.eval p₂.rep (MvPolynomial.map (Int.castRingHom ℂ) R) = 0 ∧ MvPolynomial.eval p₃.rep (MvPolynomial.map (Int.castRingHom ℂ) R) = 0) ∨ (∃ c a b a' b' : ℤ, ∃ j : ℕ, c ≠ 0 ∧ a*b'-a'*b ≠ 0 ∧ 1 ≤ j ∧ j < n ∧ R = MvPolynomial.C c * (MvPolynomial.C a * MvPolynomial.X (0 : Fin 2) + MvPolynomial.C b * MvPolynomial.X (1 : Fin 2))^j * (MvPolynomial.C a' * MvPolynomial.X (0 : Fin 2) + MvPolynomial.C b' * MvPolynomial.X (1 : Fin 2))^(n-j))) := by
  dsimp only
  intro n hn hnodd R hR hR0 hnonpure
  exact A6A8OddClassification.odd_binary_classification n hn hnodd R hR hR0 hnonpure

