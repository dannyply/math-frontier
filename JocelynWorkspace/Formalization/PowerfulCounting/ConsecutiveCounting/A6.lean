  have hxy : IsRelPrime (X (0 : Fin 2) : MvPolynomial (Fin 2) ℚ) (X (1 : Fin 2)) :=
    X_prime.irreducible.isRelPrime_iff_not_dvd.mpr (by
      rw [X_dvd_X]
      exact Fin.zero_ne_one)
  exact (hxy.pow : IsRelPrime ((X (0 : Fin 2) : MvPolynomial (Fin 2) ℚ) ^ 2) (X (1 : Fin 2) ^ 2)) hq0 hq1

end Cubic

namespace StewartCount
open MvPolynomial
open scoped BigOperators

def H_Stewart : Prop :=
  ∀ q : ℕ, 3 ≤ q → ∀ a : Fin (q + 1) → ℤ,
    Finset.univ.gcd a = 1 →
    Squarefree (∑ i : Fin (q + 1), MvPolynomial.C (a i : ℚ) *
        MvPolynomial.X (0 : Fin 2) ^ (i : ℕ) * MvPolynomial.X (1 : Fin 2) ^ (q - (i : ℕ))) →
    ∀ m : ℤ, m ≠ 0 →
      {rs : ℤ × ℤ | Int.gcd rs.1 rs.2 = 1 ∧
          ∑ i : Fin (q + 1), a i * rs.1 ^ (i : ℕ) * rs.2 ^ (q - (i : ℕ)) = m}.encard ≤
        ((2800 * q ^ (1 + m.natAbs.primeFactors.card) : ℕ) : ℕ∞)

theorem primitive_diagonal_count (hS : H_Stewart) (A B m : ℤ)
    (hA : A ≠ 0) (hB : B ≠ 0) (hcop : Int.gcd A B = 1) (hm : m ≠ 0) :
    {rs : ℤ × ℤ | Int.gcd rs.1 rs.2 = 1 ∧ A * rs.1 ^ 3 - B * rs.2 ^ 3 = m}.encard ≤
      ((2800 * 3 ^ (1 + m.natAbs.primeFactors.card) : ℕ) : ℕ∞) := by
  let a : Fin 4 → ℤ := ![-B, 0, 0, A]
  have hcontent : Finset.univ.gcd a = 1 := by
    rw [show (Finset.univ : Finset (Fin 4)) = {0, 1, 2, 3} by decide]
    simp [a, Finset.gcd_insert, Finset.gcd_singleton]
    rw [← Int.coe_gcd]
    norm_cast
    have hnorm : (normalize A).natAbs = A.natAbs :=
      Int.associated_iff_natAbs.mp (normalize_associated A)
    simpa only [Int.gcd_def, Int.natAbs_neg, hnorm,
      Nat.gcd_comm B.natAbs A.natAbs] using hcop
  have hpoly : (∑ i : Fin 4, C (a i : ℚ) * X (0 : Fin 2) ^ (i : ℕ) *
      X (1 : Fin 2) ^ (3 - (i : ℕ))) =
      C (A : ℚ) * X (0 : Fin 2) ^ 3 - C (B : ℚ) * X (1 : Fin 2) ^ 3 := by
    simp [a, Fin.sum_univ_succ]
    ring
  have hsf : Squarefree (∑ i : Fin 4, C (a i : ℚ) * X (0 : Fin 2) ^ (i : ℕ) *
      X (1 : Fin 2) ^ (3 - (i : ℕ))) := by
    rw [hpoly]
    exact Cubic.squarefree_diagonal_cubic (A : ℚ) (B : ℚ)
      (by exact_mod_cast hA) (by exact_mod_cast hB)
  have hbound := hS 3 (by norm_num) a hcontent hsf m hm
  have heval (r s : ℤ) :
      (∑ i : Fin 4, a i * r ^ (i : ℕ) * s ^ (3 - (i : ℕ))) =
      A * r ^ 3 - B * s ^ 3 := by
    simp [a, Fin.sum_univ_succ]
    ring
  simpa only [heval] using hbound

end StewartCount

open StewartCount

theorem unit_thue_fiber (hS : H_Stewart) (u v : ℕ) (hu : 0 < u) (hv : 0 < v)
    (F : Finset (ℕ × ℕ)) (hF : ∀ de ∈ F, de.2 ^ 3 * v = de.1 ^ 3 * u + 1) :
    F.card ≤ 8400 := by
  classical
  rcases F.eq_empty_or_nonempty with hFE | ⟨de0, hde0⟩
  · simp [hFE]
  have heq0 : ((de0.2 : ℤ) ^ 3 * (v : ℤ)) = (de0.1 : ℤ) ^ 3 * (u : ℤ) + 1 := by
    exact_mod_cast hF de0 hde0
  have hcopZ : IsCoprime (v : ℤ) (u : ℤ) :=
    ⟨(de0.2 : ℤ) ^ 3, -((de0.1 : ℤ) ^ 3), by linear_combination heq0⟩
  have hgcd : Int.gcd (v : ℤ) (u : ℤ) = 1 := Int.isCoprime_iff_gcd_eq_one.mp hcopZ
  have hv0 : (v : ℤ) ≠ 0 := by exact_mod_cast hv.ne'
  have hu0 : (u : ℤ) ≠ 0 := by exact_mod_cast hu.ne'
  have hbound := primitive_diagonal_count hS (v : ℤ) (u : ℤ) 1 hv0 hu0 hgcd one_ne_zero
  let μ : ℕ × ℕ → ℤ × ℤ := fun de => ((de.2 : ℤ), (de.1 : ℤ))
  have hmaps : Set.MapsTo μ (F : Set (ℕ × ℕ))
      {rs : ℤ × ℤ | Int.gcd rs.1 rs.2 = 1 ∧ (v : ℤ) * rs.1 ^ 3 - (u : ℤ) * rs.2 ^ 3 = 1} := by
    intro de hde
    have hZ : ((de.2 : ℤ) ^ 3 * (v : ℤ)) = (de.1 : ℤ) ^ 3 * (u : ℤ) + 1 := by
      exact_mod_cast hF de (Finset.mem_coe.mp hde)
    have hc : IsCoprime (de.2 : ℤ) (de.1 : ℤ) :=
      ⟨(de.2 : ℤ) ^ 2 * (v : ℤ), -((de.1 : ℤ) ^ 2 * (u : ℤ)), by linear_combination hZ⟩
    refine ⟨Int.isCoprime_iff_gcd_eq_one.mp hc, ?_⟩
    show (v : ℤ) * (de.2 : ℤ) ^ 3 - (u : ℤ) * (de.1 : ℤ) ^ 3 = 1
    linear_combination hZ
  have hinj : Set.InjOn μ (F : Set (ℕ × ℕ)) := by
    intro de _ de' _ h
    have h1 : (de.2 : ℤ) = (de'.2 : ℤ) := congrArg Prod.fst h
    have h2 : (de.1 : ℤ) = (de'.1 : ℤ) := congrArg Prod.snd h
    exact Prod.ext (by exact_mod_cast h2) (by exact_mod_cast h1)
  have hcard : F.card ≤ 2800 * 3 ^ (1 + (1 : ℤ).natAbs.primeFactors.card) := by
    apply ENat.natCast_le_natCast.mp
    rw [← Set.encard_coe_eq_coe_finsetCard]
    exact (Set.encard_le_encard_of_injOn hmaps hinj).trans hbound
  have h8400 : 2800 * 3 ^ (1 + (1 : ℤ).natAbs.primeFactors.card) = 8400 := by
    simp
  omega

def box (y D E : ℝ) : Set ((ℕ × ℕ) × (ℕ × ℕ)) :=
  {z | 1 ≤ z.1.1 ∧ 1 ≤ z.1.2 ∧ 1 ≤ z.2.1 ∧ 1 ≤ z.2.2 ∧ z.1.2 ^ 3 * z.2.2 = z.1.1 ^ 3 * z.2.1 + 1 ∧
    y / 2 < (z.1.1 : ℝ) ^ 3 * (z.2.1 : ℝ) ∧ (z.1.1 : ℝ) ^ 3 * (z.2.1 : ℝ) ≤ y ∧
    D / 2 < (z.1.1 : ℝ) ∧ (z.1.1 : ℝ) ≤ D ∧ E / 2 < (z.1.2 : ℝ) ∧ (z.1.2 : ℝ) ≤ E}

lemma box_bounds {y D E : ℝ} (hD : 0 < D) (hE : 0 < E) {z : (ℕ × ℕ) × (ℕ × ℕ)}
    (hz : z ∈ box y D E) :
    1 ≤ z.1.1 ∧ z.1.1 ≤ ⌊D⌋₊ ∧ 1 ≤ z.1.2 ∧ z.1.2 ≤ ⌊E⌋₊ ∧
    1 ≤ z.2.1 ∧ z.2.1 ≤ ⌊8 * y / D ^ 3⌋₊ ∧ 1 ≤ z.2.2 ∧ z.2.2 ≤ ⌊8 * (y + 1) / E ^ 3⌋₊ ∧
    z.1.2 ^ 3 * z.2.2 = z.1.1 ^ 3 * z.2.1 + 1 := by
  obtain ⟨h1, h2, h3, h4, heq, _hlo, hhi, hDlo, hDhi, hElo, hEhi⟩ := hz
  have hD3 : 0 < D ^ 3 := pow_pos hD 3
  have hE3 : 0 < E ^ 3 := pow_pos hE 3
  refine ⟨h1, Nat.le_floor hDhi, h2, Nat.le_floor hEhi, h3, ?_, h4, ?_, heq⟩
  · apply Nat.le_floor
    rw [le_div_iff₀ hD3]
    have hd0 : (0 : ℝ) ≤ (z.1.1 : ℝ) := Nat.cast_nonneg _
    have hd : D ≤ 2 * (z.1.1 : ℝ) := by linarith
    have hd3 : D ^ 3 ≤ (2 * (z.1.1 : ℝ)) ^ 3 := by
      have := mul_le_mul hd (mul_le_mul hd hd hD.le (by linarith)) (by positivity) (by linarith)
      nlinarith [this]
    have hu0 : (0 : ℝ) ≤ (z.2.1 : ℝ) := Nat.cast_nonneg _
    calc (z.2.1 : ℝ) * D ^ 3 ≤ (z.2.1 : ℝ) * (2 * (z.1.1 : ℝ)) ^ 3 :=
          mul_le_mul_of_nonneg_left hd3 hu0
      _ = 8 * ((z.1.1 : ℝ) ^ 3 * (z.2.1 : ℝ)) := by ring
      _ ≤ 8 * y := by linarith
  · apply Nat.le_floor
    rw [le_div_iff₀ hE3]
    have he0 : (0 : ℝ) ≤ (z.1.2 : ℝ) := Nat.cast_nonneg _
    have he : E ≤ 2 * (z.1.2 : ℝ) := by linarith
    have he3 : E ^ 3 ≤ (2 * (z.1.2 : ℝ)) ^ 3 := by
      have := mul_le_mul he (mul_le_mul he he hE.le (by linarith)) (by positivity) (by linarith)
      nlinarith [this]
    have hv0 : (0 : ℝ) ≤ (z.2.2 : ℝ) := Nat.cast_nonneg _
    have heqR : (z.1.2 : ℝ) ^ 3 * (z.2.2 : ℝ) = (z.1.1 : ℝ) ^ 3 * (z.2.1 : ℝ) + 1 := by
      exact_mod_cast heq
    calc (z.2.2 : ℝ) * E ^ 3 ≤ (z.2.2 : ℝ) * (2 * (z.1.2 : ℝ)) ^ 3 :=
          mul_le_mul_of_nonneg_left he3 hv0
      _ = 8 * ((z.1.2 : ℝ) ^ 3 * (z.2.2 : ℝ)) := by ring
      _ ≤ 8 * (y + 1) := by rw [heqR]; linarith

theorem box_count (hS : H_Stewart) (y D E : ℝ) (hy : 0 ≤ y) (hD : 0 < D) (hE : 0 < E) :
    (box y D E).Finite ∧
      ((box y D E).ncard : ℝ) ≤ 8400 * ((8 * y / D ^ 3) * (8 * (y + 1) / E ^ 3)) := by
  classical
  obtain ⟨Un, hUn⟩ : ∃ n : ℕ, n = ⌊8 * y / D ^ 3⌋₊ := ⟨_, rfl⟩
  obtain ⟨Vn, hVn⟩ : ∃ n : ℕ, n = ⌊8 * (y + 1) / E ^ 3⌋₊ := ⟨_, rfl⟩
  let T : Finset (ℕ × ℕ) := Finset.Icc 1 Un ×ˢ Finset.Icc 1 Vn
  let G : Finset ((ℕ × ℕ) × (ℕ × ℕ)) := (Finset.Icc 1 ⌊D⌋₊ ×ˢ Finset.Icc 1 ⌊E⌋₊) ×ˢ T
  have hsub : box y D E ⊆ (G : Set ((ℕ × ℕ) × (ℕ × ℕ))) := by
    intro z hz
    obtain ⟨h1, h1', h2, h2', h3, h3', h4, h4', -⟩ := box_bounds hD hE hz
    rw [← hUn] at h3'
    rw [← hVn] at h4'
    rw [Finset.mem_coe]
    exact Finset.mem_product.mpr ⟨Finset.mem_product.mpr ⟨Finset.mem_Icc.mpr ⟨h1, h1'⟩,
      Finset.mem_Icc.mpr ⟨h2, h2'⟩⟩, Finset.mem_product.mpr ⟨Finset.mem_Icc.mpr ⟨h3, h3'⟩,
      Finset.mem_Icc.mpr ⟨h4, h4'⟩⟩⟩
  have hfin : (box y D E).Finite := G.finite_toSet.subset hsub
  refine ⟨hfin, ?_⟩
  have hncard : (box y D E).ncard = hfin.toFinset.card := Set.ncard_eq_toFinset_card _ hfin
  have hmapsT : ∀ z ∈ hfin.toFinset, (fun z : (ℕ × ℕ) × (ℕ × ℕ) => z.2) z ∈ T := by
    intro z hz
    have hz' : z ∈ box y D E := hfin.mem_toFinset.mp hz
    obtain ⟨-, -, -, -, h3, h3', h4, h4', -⟩ := box_bounds hD hE hz'
    rw [← hUn] at h3'
    rw [← hVn] at h4'
    exact Finset.mem_product.mpr ⟨Finset.mem_Icc.mpr ⟨h3, h3'⟩, Finset.mem_Icc.mpr ⟨h4, h4'⟩⟩
  have hfib : ∀ uv ∈ T, (hfin.toFinset.filter
      (fun z : (ℕ × ℕ) × (ℕ × ℕ) => (fun z : (ℕ × ℕ) × (ℕ × ℕ) => z.2) z = uv)).card ≤ 8400 := by
    intro uv huv
    obtain ⟨hu1, hv1⟩ := Finset.mem_product.mp huv
    have hu : 0 < uv.1 := (Finset.mem_Icc.mp hu1).1
    have hv : 0 < uv.2 := (Finset.mem_Icc.mp hv1).1
    have hinj : Set.InjOn (fun z : (ℕ × ℕ) × (ℕ × ℕ) => z.1)
        ((hfin.toFinset.filter (fun z : (ℕ × ℕ) × (ℕ × ℕ) =>
          (fun z : (ℕ × ℕ) × (ℕ × ℕ) => z.2) z = uv) : Finset _) : Set _) := by
      intro z hz z' hz' h
      have e1 : z.2 = uv := (Finset.mem_filter.mp (Finset.mem_coe.mp hz)).2
      have e2 : z'.2 = uv := (Finset.mem_filter.mp (Finset.mem_coe.mp hz')).2
      exact Prod.ext h (e1.trans e2.symm)
    have himg := unit_thue_fiber hS uv.1 uv.2 hu hv
      ((hfin.toFinset.filter (fun z : (ℕ × ℕ) × (ℕ × ℕ) =>
        (fun z : (ℕ × ℕ) × (ℕ × ℕ) => z.2) z = uv)).image (fun z => z.1)) (by
      intro de hde
      obtain ⟨z, hz, rfl⟩ := Finset.mem_image.mp hde
      obtain ⟨hzS, hz2⟩ := Finset.mem_filter.mp hz
      have hz' : z ∈ box y D E := hfin.mem_toFinset.mp hzS
      obtain ⟨-, -, -, -, -, -, -, -, heq⟩ := box_bounds hD hE hz'
      have hz2' : z.2 = uv := hz2
      rw [← hz2']
      exact heq)
    rw [Finset.card_image_of_injOn hinj] at himg
    exact himg
  have hcardS : hfin.toFinset.card ≤ 8400 * T.card :=
    Finset.card_le_mul_card_image_of_maps_to hmapsT 8400 hfib
  have hT : T.card = Un * Vn := by
    simp [T, Finset.card_product, Nat.card_Icc]
  have hUle : (Un : ℝ) ≤ 8 * y / D ^ 3 := by
    rw [hUn]; exact Nat.floor_le (div_nonneg (by linarith) (pow_pos hD 3).le)
  have hVle : (Vn : ℝ) ≤ 8 * (y + 1) / E ^ 3 := by
    rw [hVn]; exact Nat.floor_le (div_nonneg (by linarith) (pow_pos hE 3).le)
  have hnat : hfin.toFinset.card ≤ 8400 * (Un * Vn) := by rw [← hT]; exact hcardS
  rw [hncard]
  calc (hfin.toFinset.card : ℝ) ≤ 8400 * ((Un : ℝ) * (Vn : ℝ)) := by exact_mod_cast hnat
    _ ≤ 8400 * ((8 * y / D ^ 3) * (8 * (y + 1) / E ^ 3)) := by
        apply mul_le_mul_of_nonneg_left _ (by norm_num)
        exact mul_le_mul hUle hVle (Nat.cast_nonneg _)
          (div_nonneg (by linarith) (pow_pos hD 3).le)

theorem thue_box_rpow (hS : H_Stewart) (y s D E δ : ℝ) (hy : 1 ≤ y) (hs : 34 / 63 ≤ s)
    (hδ : 0 < δ) (hD : 0 < D) (hE : 0 < E) (hDE : D * E = y ^ s) :
    (box y D E).Finite ∧ ((box y D E).ncard : ℝ) ≤ 1075200 * y ^ (8 / 21 + δ) := by
  have hy0 : 0 < y := by linarith
  obtain ⟨hfin, hcard⟩ := box_count hS y D E hy0.le hD hE
  refine ⟨hfin, hcard.trans ?_⟩
  have hD3 : 0 < D ^ 3 := pow_pos hD 3
  have hE3 : 0 < E ^ 3 := pow_pos hE 3
  have hprod : (8 * y / D ^ 3) * (8 * (y + 1) / E ^ 3) = 64 * (y * (y + 1)) / (D * E) ^ 3 := by
    rw [mul_pow]
    field_simp
    ring
  have hcube : (D * E) ^ 3 = y ^ (s * 3) := by
    rw [hDE, ← Real.rpow_natCast, ← Real.rpow_mul hy0.le]
    norm_num
  have hys : 0 < y ^ (s * 3) := Real.rpow_pos_of_pos hy0 _
  have hsq : y * (y + 1) ≤ 2 * y ^ (2 : ℝ) := by
    rw [Real.rpow_two]
    nlinarith
  have hexp : y ^ (2 : ℝ) / y ^ (s * 3) = y ^ (2 - s * 3) := (Real.rpow_sub hy0 2 (s * 3)).symm
  have hle_exp : y ^ (2 - s * 3) ≤ y ^ (8 / 21 + δ) :=
    Real.rpow_le_rpow_of_exponent_le hy (by linarith)
  have hstep : 64 * (y * (y + 1)) / y ^ (s * 3) ≤ 64 * (2 * y ^ (2 : ℝ)) / y ^ (s * 3) := by
    rw [div_le_div_iff_of_pos_right hys]
    linarith
  calc 8400 * ((8 * y / D ^ 3) * (8 * (y + 1) / E ^ 3))
      = 8400 * (64 * (y * (y + 1)) / y ^ (s * 3)) := by rw [hprod, hcube]
    _ ≤ 8400 * (64 * (2 * y ^ (2 : ℝ)) / y ^ (s * 3)) :=
        mul_le_mul_of_nonneg_left hstep (by norm_num)
    _ = 1075200 * (y ^ (2 : ℝ) / y ^ (s * 3)) := by ring
    _ = 1075200 * y ^ (2 - s * 3) := by rw [hexp]
    _ ≤ 1075200 * y ^ (8 / 21 + δ) := mul_le_mul_of_nonneg_left hle_exp (by norm_num)

end A6K4ThueV1

namespace A6K4aJoinV1

lemma rpow_logdiv {y D : ℝ} (hy : 1 < y) (hD : 0 < D) :
    y ^ (Real.log D / Real.log y) = D := by
  have hL : 0 < Real.log y := Real.log_pos hy
  have hLne : Real.log y ≠ 0 := hL.ne'
  rw [Real.rpow_def_of_pos (by linarith)]
  have h : Real.log y * (Real.log D / Real.log y) = Real.log D := by
    field_simp
  rw [h, Real.exp_log hD]

lemma rpow_sq' {y : ℝ} (hy : 0 < y) (e : ℝ) : (y ^ e) ^ 2 = y ^ (e * 2) := by
  rw [← Real.rpow_natCast, ← Real.rpow_mul hy.le] ; norm_num

lemma rpow_cube' {y : ℝ} (hy : 0 < y) (e : ℝ) : (y ^ e) ^ 3 = y ^ (e * 3) := by
  rw [← Real.rpow_natCast, ← Real.rpow_mul hy.le] ; norm_num

lemma w847R_bracket (y dl el m D E M : ℝ) (hy : 1 < y)
    (hD : D = y ^ dl) (hE : E = y ^ el) (hM : M = y ^ m) :
    M + M ^ ((3 : ℝ) / 4) * (D * E + (D ^ 2 + E ^ 2) / M) ^ ((3 : ℝ) / 16) *
        (y / D ^ 3 * (y / E ^ 3) + ((y / D ^ 3) ^ 2 + (y / E ^ 3) ^ 2) / M) ^ ((1 : ℝ) / 16) +
      M * (y ^ ((1 : ℝ) / 3) / (M ^ ((2 : ℝ) / 3) * (D * E) ^ ((1 : ℝ) / 5))) +
      M * y ^ ((2 : ℝ) / 45) ≤
    12 * y ^ (max (max m ((2 + 12 * m + 3 * max (|el - dl| - m) 0 + max (3 * |el - dl| - m) 0) / 16))
      (max ((1 + m) / 3 - (dl + el) / 5) (m + 2 / 45))) := by
  have hy0 : 0 < y := by linarith
  have hy1 : 1 ≤ y := hy.le
  have hD0 : 0 < D := by rw [hD]; exact Real.rpow_pos_of_pos hy0 _
  have hE0 : 0 < E := by rw [hE]; exact Real.rpow_pos_of_pos hy0 _
  have hM0 : 0 < M := by rw [hM]; exact Real.rpow_pos_of_pos hy0 _
  obtain ⟨a, ha⟩ : ∃ a : ℝ, a = |el - dl| := ⟨_, rfl⟩
  obtain ⟨s, hs⟩ : ∃ s : ℝ, s = dl + el := ⟨_, rfl⟩
  rw [← ha, ← hs]
  obtain ⟨α, hα⟩ : ∃ α : ℝ, α = max (a - m) 0 := ⟨_, rfl⟩
  obtain ⟨β, hβ⟩ : ∃ β : ℝ, β = max (3 * a - m) 0 := ⟨_, rfl⟩
  rw [← hα, ← hβ]
  obtain ⟨F, hF⟩ : ∃ F : ℝ, F = max (max m ((2 + 12 * m + 3 * α + β) / 16))
      (max ((1 + m) / 3 - s / 5) (m + 2 / 45)) := ⟨_, rfl⟩
  rw [← hF]
  have hα0 : 0 ≤ α := by rw [hα]; exact le_max_right _ _
  have hβ0 : 0 ≤ β := by rw [hβ]; exact le_max_right _ _
  have hαa : a - m ≤ α := by rw [hα]; exact le_max_left _ _
  have hβa : 3 * a - m ≤ β := by rw [hβ]; exact le_max_left _ _
  have hab1 : el - dl ≤ a := by rw [ha]; exact le_abs_self _
  have hab2 : -(el - dl) ≤ a := by rw [ha]; exact neg_le_abs _
  have e1 : m ≤ F := by rw [hF]; exact le_trans (le_max_left _ _) (le_max_left _ _)
  have e2 : (2 + 12 * m + 3 * α + β) / 16 ≤ F := by
    rw [hF]; exact le_trans (le_max_right _ _) (le_max_left _ _)
  have e3 : (1 + m) / 3 - s / 5 ≤ F := by
    rw [hF]; exact le_trans (le_max_left _ _) (le_max_right _ _)
  have e4 : m + 2 / 45 ≤ F := by
    rw [hF]; exact le_trans (le_max_right _ _) (le_max_right _ _)
  have hDE : D * E = y ^ s := by rw [hD, hE, ← Real.rpow_add hy0, hs]
  have hD2 : D ^ 2 / M = y ^ (dl * 2 - m) := by
    rw [hD, hM, rpow_sq' hy0, ← Real.rpow_sub hy0]
  have hE2 : E ^ 2 / M = y ^ (el * 2 - m) := by
    rw [hE, hM, rpow_sq' hy0, ← Real.rpow_sub hy0]
  have hU : y / D ^ 3 = y ^ (1 - dl * 3) := by
    rw [hD, rpow_cube' hy0, Real.rpow_sub hy0, Real.rpow_one]
  have hV : y / E ^ 3 = y ^ (1 - el * 3) := by
