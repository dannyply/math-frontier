private theorem dL
 (P Q:ab) (a b c:I)
 (hP:P.IsHomogeneous 4) (hQ:Q.IsHomogeneous 4)
 (hab:bt a b = 1)
 (hcop:IsRelPrime (ah P)
 (ah Q))
 (hpure:aj (1:Fin 2) ^ 3 * P -
 aj (0:Fin 2) ^ 3 * Q =
 ai c * (ai a * aj 0 +
 ai b * aj 1) ^ 7):
 co a b c (P.coeff m31) (P.coeff m40) ≠ 0:=by
  intro hzero
  have habZ:a ≠ 0 ∨ b ≠ 0:=by
    by_cases ha:a = 0
    · right
      intro hb
      rw [ha,hb] at hab
      norm_num at hab
    · exact Or.inl ha
  have habQ:(a:ℚ) ≠ 0 ∨ (b:ℚ) ≠ 0:=by
    rcases habZ with ha | hb
    · left;exact_mod_cast ha
    · right;exact_mod_cast hb
  have hv:= cJ P Q a b c hP hQ hpure b (-a)
  have he:= cq a b c (P.coeff m31) (P.coeff m40)
  have hp0:al ![b,-a] P = 0:=by
    rw [hv.1,he.1,hzero,mul_zero]
  have hq0:al ![b,-a] Q = 0:=by
    rw [hv.2,he.2,hzero,mul_zero]
  have root (F:ab) (hF:F.IsHomogeneous 4)
      (hF0:al ![b,-a] F = 0):
      ((F.coeff m40:I):ℚ) * (b:ℚ) ^ 4 -
          ((F.coeff m31:I):ℚ) * (a:ℚ) * (b:ℚ) ^ 3 +
          ((F.coeff m22:I):ℚ) * (a:ℚ) ^ 2 * (b:ℚ) ^ 2 -
          ((F.coeff m13:I):ℚ) * (a:ℚ) ^ 3 * (b:ℚ) +
          ((F.coeff m04:I):ℚ) * (a:ℚ) ^ 4 = 0:=by
    have hh:F.coeff m40 * b ^ 4 - F.coeff m31 * a * b ^ 3 +
        F.coeff m22 * a ^ 2 * b ^ 2 - F.coeff m13 * a ^ 3 * b +
        F.coeff m04 * a ^ 4 = 0:=by
      rw [cD F hF b (-a)] at hF0
      linear_combination hF0
    exact_mod_cast hh
  let L:ac:=
    ai (a:ℚ) * aj 0 +
      ai (b:ℚ) * aj 1
  have hcast (z:I):(an ℚ) z = (z:ℚ):=by
    solve | simp
  have divisor (F:ab) (hF:F.IsHomogeneous 4)
      (hF0:al ![b,-a] F = 0):
      L ∣ ah F:=by
    have hd:= dK (a:ℚ) (b:ℚ)
      ((F.coeff m40:I):ℚ) ((F.coeff m31:I):ℚ) ((F.coeff m22:I):ℚ)
      ((F.coeff m13:I):ℚ) ((F.coeff m04:I):ℚ) habQ (root F hF hF0)
    rw [cC F hF]
    simpa only [L,map_add,map_mul,map_pow,MvPolynomial.map_C,
      MvPolynomial.map_X,hcast] using hd
  have hunit:IsUnit L:= hcop (divisor P hP hp0) (divisor Q hQ hq0)
  have h01:(ao (1:Fin 2) (1:U):Fin 2 →₀ U) ≠
      ao (0:Fin 2) 1:=by
    intro hi
    have heq:= congrArg (fun m:Fin 2 →₀ U => m 0) hi
    norm_num [aP] at heq
  rcases habQ with ha | hb
  · have hn:= (MvPolynomial.isUnit_iff.mp hunit).2
      (ao (0:Fin 2) 1) (by simp)
    have hc:aZ (ao (0:Fin 2) 1) L = (a:ℚ):=by
      simp only [L,ba,bA,
        MvPolynomial.coeff_X]
      simp [h01]
    rw [hc] at hn
    exact ha hn.eq_zero
  · have hn:= (MvPolynomial.isUnit_iff.mp hunit).2
      (ao (1:Fin 2) 1) (by simp)
    have hc:aZ (ao (1:Fin 2) 1) L = (b:ℚ):=by
      simp only [L,ba,bA,
        MvPolynomial.coeff_X]
      simp [Ne.symm h01]
    rw [hc] at hn
    exact hb hn.eq_zero
end P7I
