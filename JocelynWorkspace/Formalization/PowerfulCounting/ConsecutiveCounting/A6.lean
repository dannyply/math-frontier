  · rintro ⟨rfl,rfl,rfl,rfl⟩
    rfl
private theorem bU {R:Type*} [CommRing R]
 (r:R) (i j:U):
 monomial (bIndex i j) r = C r*(X (0:Fin 2))^i*(X 1)^j:=by
  calc
    _ = monomial (ao (0:Fin 2) i) r *
        monomial (ao (1:Fin 2) j) (1:R):=by
      rw [aL]
      simp [bIndex]
    _ = _:=by
      rw [←ap,←ap]
      simp [mul_assoc]
private theorem bV {R:Type*} [CommRing R]
 (r:R) (i j k l:U):
