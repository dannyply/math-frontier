noncomputable section
namespace A6P3Tuple
abbrev Point := Fin 4 → ℕ
private def coord (d0 e0 : ℤ) (z : Point) : ℤ :=
  e0 * (z 0 : ℤ) - d0 * (z 1 : ℤ)

private theorem coordinates (a b m d0 e0 d e : ℤ)
    (hbez : a * d0 + b * e0 = 1) (hl : m = a*d+b*e) :
    d = m*d0+b*(e0*d-d0*e) ∧
    e = m*e0-a*(e0*d-d0*e) := by
  constructor
  · calc
      d = d*(a*d0+b*e0) := by rw [hbez]; ring
      _ = m*d0+b*(e0*d-d0*e) := by rw [hl]; ring
  · calc
      e = e*(a*d0+b*e0) := by rw [hbez]; ring
      _ = m*e0-a*(e0*d-d0*e) := by rw [hl]; ring

private def levelSet (a b m q : ℤ) : Set Point :=
  {z | m = a*(z 0 : ℤ)+b*(z 1 : ℤ) ∧
    m^5*(z 2 : ℤ) = q*(z 1 : ℤ)^3-a^3*
      ((a*(z 0 : ℤ))^2+5*(a*(z 0 : ℤ))*(b*(z 1 : ℤ))+10*(b*(z 1 : ℤ))^2) ∧
    m^5*(z 3 : ℤ) = q*(z 0 : ℤ)^3+b^3*
      ((b*(z 1 : ℤ))^2+5*(b*(z 1 : ℤ))*(a*(z 0 : ℤ))+10*(a*(z 0 : ℤ))^2)}

private theorem coord_injOn (a b m q d0 e0 : ℤ)
    (hm : m ≠ 0) (hbez : a*d0+b*e0=1) :
    Set.InjOn (coord d0 e0) (levelSet a b m q) := by
  intro z hz w hw heq
  have hcz := coordinates a b m d0 e0 (z 0) (z 1) hbez hz.1
  have hcw := coordinates a b m d0 e0 (w 0) (w 1) hbez hw.1
  have hd : (z 0 : ℤ) = (w 0 : ℤ) := by
    calc
      (z 0 : ℤ) = m*d0+b*coord d0 e0 z := hcz.1
      _ = m*d0+b*coord d0 e0 w := by rw [heq]
      _ = (w 0 : ℤ) := hcw.1.symm
  have he : (z 1 : ℤ) = (w 1 : ℤ) := by
    calc
      (z 1 : ℤ) = m*e0-a*coord d0 e0 z := hcz.2
      _ = m*e0-a*coord d0 e0 w := by rw [heq]
      _ = (w 1 : ℤ) := hcw.2.symm
  have hu : (z 2 : ℤ) = (w 2 : ℤ) := by
    apply mul_left_cancel₀ (pow_ne_zero 5 hm)
    rw [hz.2.1, hw.2.1, hd, he]
  have hv : (z 3 : ℤ) = (w 3 : ℤ) := by
    apply mul_left_cancel₀ (pow_ne_zero 5 hm)
    rw [hz.2.2, hw.2.2, hd, he]
  funext i
  fin_cases i
  · exact_mod_cast hd
  · exact_mod_cast he
  · exact_mod_cast hu
  · exact_mod_cast hv

private theorem card_coord_image (a b m q d0 e0 : ℤ)
    (hm : m ≠ 0) (hbez : a*d0+b*e0=1)
    (T : Finset Point) (hT : ∀ z ∈ T, z ∈ levelSet a b m q) :
    (T.image (coord d0 e0)).card = T.card := by
  apply Finset.card_image_iff.mpr
  intro z hz w hw hh
  exact coord_injOn a b m q d0 e0 hm hbez (hT z hz) (hT w hw) hh

end A6P3Tuple
end

