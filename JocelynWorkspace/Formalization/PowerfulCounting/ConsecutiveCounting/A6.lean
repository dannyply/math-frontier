private theorem actual_menu_union_bound
    (x D E : ℝ) (M j : ℕ) (U : Set Point) (menu : Finset Four)
    (hiff : ∀z : Point, z∈U ↔ z∈sourceCell x D E M j ∧
      ∃G∈menu, MvPolynomial.eval
        ![(z.1.1:ℤ),(z.1.2:ℤ),(z.2.1:ℤ),(z.2.2:ℤ)] G=0)
    (hfin : ∀G∈menu,(componentCell x D E M j G).Finite) :
    U.Finite ∧ (U.ncard:ℝ)≤
      ∑G∈menu,((componentCell x D E M j G).ncard:ℝ) := by
  have heq : U=⋃G∈menu,componentCell x D E M j G := by
    ext z
    rw [hiff z]
    simp only [Set.mem_iUnion]
    constructor
    · rintro ⟨hz,G,hG,hzero⟩
      exact ⟨G,hG,hz,hzero⟩
    · rintro ⟨G,hG,hz,hzero⟩
      exact ⟨hz,G,hG,hzero⟩
  have hh := finite_incidence_union_bound menu (componentCell x D E M j) hfin
  rw [←heq] at hh
  exact ⟨hh.1,by exact_mod_cast hh.2⟩
end A6WholeF8ActualJoins

