open MvPolynomial
abbrev Four := MvPolynomial (Fin 4) ℤ
abbrev Point := (ℕ×ℕ)×(ℕ×ℕ)
noncomputable def embed : Binary→Four :=
  rename (fun i : Fin 2 => if i=0 then (0:Fin 4) else 1)
def Graph (G : Four) (P Q : Binary) : Prop :=
  G=embed P*X 2-embed Q*X 3
def Bihom (G : Four) (a b : ℕ) : Prop :=
  ∀ t∈G.support, t 0+t 1=a ∧ t 2+t 3=b
def PurePower (G : Four) (n : ℕ) : Prop :=
  ∃ P Q : Binary, ∃ a b c : ℤ,
    Graph G P Q ∧ Int.gcd a b=1 ∧ c≠0 ∧
      X (1:Fin 2)^3*P-X (0:Fin 2)^3*Q=
        C c*(C a*X 0+C b*X 1)^n
def PureFactor (F G : Four) (a n : ℕ) : Prop :=
  G∣F ∧ G≠0 ∧ Irreducible (map (Int.castRingHom ℂ) G) ∧
    Bihom G a 1 ∧ PurePower G n
def sourceCell (x D E : ℝ) (M j : ℕ) : Set Point := {z |
  1≤z.1.1 ∧ 1≤z.1.2 ∧ 1≤z.2.1 ∧ 1≤z.2.2 ∧
  ((z.1.2^3*z.2.2:ℕ):ℤ)=((z.1.1^3*z.2.1:ℕ):ℤ)+1 ∧
  x/2<((z.1.1^3*z.2.1:ℕ):ℝ) ∧ ((z.1.1^3*z.2.1:ℕ):ℝ)≤x ∧
  D/2<(z.1.1:ℝ) ∧ (z.1.1:ℝ)≤D ∧
  E/2<(z.1.2:ℝ) ∧ (z.1.2:ℝ)≤E ∧
  A6WholeF8GridJoins.rho D E M j<(z.1.1:ℝ)/(z.1.2:ℝ) ∧
  (z.1.1:ℝ)/(z.1.2:ℝ)≤
    A6WholeF8GridJoins.rho D E M j*(1+1/(M:ℝ))}
def pureUnion (x D E : ℝ) (M j : ℕ) (F : Four) (a n : ℕ) : Set Point :=
  {z | z∈sourceCell x D E M j ∧
    ∃ G : Four, PureFactor F G a n ∧
      eval ![(z.1.1:ℤ),(z.1.2:ℤ),(z.2.1:ℤ),(z.2.2:ℤ)] G=0}

private theorem rational_pure_graph_to_integer_family
    (G : Four) (P Q : Binary) (n : ℕ) (hG : Graph G P Q)
    (κ a b : ℚ) (hκ : κ≠0) (hab : a≠0 ∨ b≠0)
    (hpure : ∀ r s : ℚ,
      s^3*eval ![r,s] (map (Int.castRingHom ℚ) P)-
      r^3*eval ![r,s] (map (Int.castRingHom ℚ) Q)=κ*(a*r+b*s)^n) :
    PurePower G n := by
  let R : Binary := X (1:Fin 2)^3*P-X (0:Fin 2)^3*Q
  have heval : ∀ r s : ℚ,
      eval ![r,s] (map (Int.castRingHom ℚ) R)=κ*(a*r+b*s)^n := by
    intro r s
    simpa [R,map_sub,map_mul,map_pow,map_X] using hpure r s
  obtain ⟨A,B,c,hAB,hc,hR⟩ :=
    rational_pure_to_integral_primitive R n κ a b hκ hab heval
  exact ⟨P,Q,A,B,c,hG,hAB,hc,hR⟩

private theorem rational_pure_point_in_same_F_union
    (x D E : ℝ) (M j a n : ℕ) (F G : Four) (P Q : Binary)
    (hGF : G∣F) (hG0 : G≠0)
    (hGeom : Irreducible (map (Int.castRingHom ℂ) G))
    (hBi : Bihom G a 1) (hGraph : Graph G P Q)
    (κ A B : ℚ) (hκ : κ≠0) (hAB : A≠0 ∨ B≠0)
    (hpure : ∀ r s : ℚ,
      s^3*eval ![r,s] (map (Int.castRingHom ℚ) P)-
      r^3*eval ![r,s] (map (Int.castRingHom ℚ) Q)=κ*(A*r+B*s)^n)
    (z : Point) (hz : z∈sourceCell x D E M j)
    (hzero : eval ![(z.1.1:ℤ),(z.1.2:ℤ),(z.2.1:ℤ),(z.2.2:ℤ)] G=0) :
    z∈pureUnion x D E M j F a n := by
  refine ⟨hz,G,?_,hzero⟩
  exact ⟨hGF,hG0,hGeom,hBi,
    rational_pure_graph_to_integer_family G P Q n hGraph κ A B hκ hAB hpure⟩

def Q3 (t : ℚ) : ℚ := (3*t^5-10*t^3+15*t+8)/16
def exceptional : Set Point := {z |
  (∃ t : ℚ, (z.1.1:ℚ)^3*(z.2.1:ℚ) = -Q3 t) ∨
  (∃ t : ℚ, (z.1.2:ℚ)^3*(z.2.2:ℚ) = Q3 t)}
def InRawSpectrum (n : ℕ) : Prop :=
  (∃ t : ℚ, (n:ℚ) = -Q3 t) ∨
  (∃ t : ℚ, (n:ℚ)+1 = Q3 t)
private theorem exceptional_iff_raw_spectrum (z : Point)
    (hunit : z.1.2^3*z.2.2=z.1.1^3*z.2.1+1) :
    z∈exceptional ↔ InRawSpectrum (z.1.1^3*z.2.1) := by
  have hq : (z.1.2:ℚ)^3*(z.2.2:ℚ)=
      (z.1.1:ℚ)^3*(z.2.1:ℚ)+1 := by exact_mod_cast hunit
  simp only [exceptional,Set.mem_ofPred_eq,InRawSpectrum,
    Nat.cast_mul,Nat.cast_pow]
  rw [hq]

