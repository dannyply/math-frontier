abbrev Point := (ℕ × ℕ) × (ℕ × ℕ)

def tail (k : ℕ) (x : ℝ) : Set Point :=
  {q | 1 ≤ q.1.1 ∧ 1 ≤ q.1.2 ∧ 1 ≤ q.2.1 ∧ 1 ≤ q.2.2 ∧ ((q.1.1 ^ k * q.2.1 : ℕ) : ℝ) ≤ x ∧
    q.1.2 ^ k * q.2.2 = q.1.1 ^ k * q.2.1 + 1 ∧ x ^ ((1 : ℝ) / (k : ℝ)) < ((q.1.1 * q.1.2 : ℕ) : ℝ)}

def box (k : ℕ) (x D E : ℝ) : Set Point :=
  {z | 1 ≤ z.1.1 ∧ 1 ≤ z.1.2 ∧ 1 ≤ z.2.1 ∧ 1 ≤ z.2.2 ∧ z.1.2 ^ k * z.2.2 = z.1.1 ^ k * z.2.1 + 1 ∧
    x / 2 < (z.1.1 : ℝ) ^ k * (z.2.1 : ℝ) ∧ (z.1.1 : ℝ) ^ k * (z.2.1 : ℝ) ≤ x ∧
    D / 2 < (z.1.1 : ℝ) ∧ (z.1.1 : ℝ) ≤ D ∧ E / 2 < (z.1.2 : ℝ) ∧ (z.1.2 : ℝ) ≤ E}

theorem pos_factor {k d u N : ℕ} (hk : 1 ≤ k) (hd : 1 ≤ d) (hu : 1 ≤ u)
    (hN : d ^ k * u ≤ N) : d ≤ N ∧ u ≤ N := by
  have hd₂ : d ≤ d ^ k := by
    calc d = d ^ 1 := (pow_one d).symm
      _ ≤ d ^ k := Nat.pow_le_pow_right (by omega) hk
  have hsq : 0 < d ^ k := pow_pos (by omega) k
  have hdN : d ^ k ≤ d ^ k * u := Nat.le_mul_of_pos_right _ (by omega)
  have huN : u ≤ d ^ k * u := Nat.le_mul_of_pos_left _ hsq
  exact ⟨hd₂.trans (hdN.trans hN), huN.trans hN⟩

theorem tail_finite (k : ℕ) (hk : 1 ≤ k) (x : ℝ) : (tail k x).Finite := by
  let M := ⌊x⌋₊ + 1
  let B : Finset Point :=
    ((Finset.Icc 1 M) ×ˢ (Finset.Icc 1 M)) ×ˢ ((Finset.Icc 1 M) ×ˢ (Finset.Icc 1 M))
  apply B.finite_toSet.subset
  rintro ⟨⟨d, e⟩, ⟨u, v⟩⟩ h
  rcases h with ⟨hd, he, hu, hv, hx, heq, hde⟩
  dsimp only at hd he hu hv hx heq hde
  have hn : d ^ k * u ≤ ⌊x⌋₊ := Nat.le_floor hx
  have hn' : e ^ k * v ≤ ⌊x⌋₊ + 1 := by omega
  rcases pos_factor hk hd hu hn with ⟨hdN, huN⟩
  rcases pos_factor hk he hv hn' with ⟨heN, hvN⟩
  change ((d, e), (u, v)) ∈ B
  simp only [B, M, Finset.mem_product, Finset.mem_Icc]
  omega

theorem shell_index (x : ℝ) (n : ℕ) (hn : 1 ≤ n) (hnx : (n : ℝ) ≤ x) :
