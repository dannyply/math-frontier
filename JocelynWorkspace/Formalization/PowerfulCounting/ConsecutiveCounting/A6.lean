open Polynomial
private theorem eA
 (r s lo hi t L iU:O)
 (ht:t ∈ Set.Icc lo hi)
 (hlo:L ≤ r + s * lo ∧ r + s * lo ≤ iU)
 (hhi:L ≤ r + s * hi ∧ r + s * hi ≤ iU):
 L ≤ r + s * t ∧ r + s * t ≤ iU:=by
  by_cases hs:0 ≤ s
  · have h₁:= am ht.1 hs
    have h₂:= am ht.2 hs
    constructor <;> linarith
  · have h₁:= mul_le_mul_of_nonpos_left ht.1 (le_of_not_ge hs)
    have h₂:= mul_le_mul_of_nonpos_left ht.2 (le_of_not_ge hs)
    constructor <;> linarith
private theorem eB
 (a b h d₀ e₀ r J:I) (D E lo hi:O)
 (hD:0 < D) (hE:0 < E)
 (hell:a * d₀ + b * e₀ ≠ 0)
 (hrich:64 * |((a * d₀ + b * e₀:I):O)| ≤
 max (|(a:O)| * D) (|(b:O)| * E))
 (hdlo:
 D / 2 ≤ (((d₀ + b * h * r:I):O) + (b:O) * ((h * J:I):O) * lo) ∧
 (((d₀ + b * h * r:I):O) + (b:O) * ((h * J:I):O) * lo) ≤ D)
 (hdhi:
 D / 2 ≤ (((d₀ + b * h * r:I):O) + (b:O) * ((h * J:I):O) * hi) ∧
 (((d₀ + b * h * r:I):O) + (b:O) * ((h * J:I):O) * hi) ≤ D)
 (helo:
 E / 2 ≤ (((e₀ - a * h * r:I):O) - (a:O) * ((h * J:I):O) * lo) ∧
 (((e₀ - a * h * r:I):O) - (a:O) * ((h * J:I):O) * lo) ≤ E)
 (hehi:
 E / 2 ≤ (((e₀ - a * h * r:I):O) - (a:O) * ((h * J:I):O) * hi) ∧
 (((e₀ - a * h * r:I):O) - (a:O) * ((h * J:I):O) * hi) ≤ E):
 ∀ t ∈ Set.Icc lo hi,
 let d:= (((d₀ + b * h * r:I):O) + (b:O) * ((h * J:I):O) * t)
 let z:= (a:O) * d / ((a * d₀ + b * e₀:I):O)
 au (|(a:O) * (b:O)| * (D * E)) /
 (8 * |((a * d₀ + b * e₀:I):O)|) ≤ |z| ∧
 |z| ≤ 8 * au (|(a:O) * (b:O)| * (D * E)) /
 |((a * d₀ + b * e₀:I):O)| ∧
 8 ≤ |z|:=by
  intro t ht
  dsimp only
  let d:O:= (((d₀ + b * h * r:I):O) + (b:O) * ((h * J:I):O) * t)
  let e:O:= (((e₀ - a * h * r:I):O) - (a:O) * ((h * J:I):O) * t)
  have hd:= eA (((d₀ + b * h * r:I):O))
    ((b:O) * ((h * J:I):O)) lo hi t (D / 2) D ht hdlo hdhi
  have he:= eA (((e₀ - a * h * r:I):O))
    (-((a:O) * ((h * J:I):O))) lo hi t (E / 2) E ht
    (by simpa only [neg_mul,sub_eq_add_neg] using helo)
    (by simpa only [neg_mul,sub_eq_add_neg] using hehi)
  have he':E / 2 ≤ e ∧ e ≤ E:=by
    simpa only [e,neg_mul,sub_eq_add_neg] using he
  have hlev:(a:O) * d + (b:O) * e =
      ((a * d₀ + b * e₀:I):O):=by
    dsimp [d,e]
    push_cast
    ring
  have hellR:((a * d₀ + b * e₀:I):O) ≠ 0:=by exact_mod_cast hell
  have bG:8 * |((a * d₀ + b * e₀:I):O)| ≤
      max (|(a:O)| * D) (|(b:O)| * E):=by
    have hnon:= abs_nonneg (((a * d₀ + b * e₀:I):O))
    linarith
  have hc:= ee (a:O) (b:O) d e D E hD hE
    hd.1 hd.2 he'.1 he'.2 (by rw [hlev];exact hellR) (by rw [hlev];exact bG)
  have hx:= ei (a:O) (b:O) d e D E hD hE
    hd.1 hd.2 he'.1 he'.2 (by rw [hlev];exact hellR) (by rw [hlev];exact hrich)
  rw [hlev] at hc hx
  exact ⟨hc.2.2.2.1,hc.2.2.2.2.1,hx.1⟩
private theorem eC
 (P:af) (N:O → O)
 (hN:(fun t => P.eval t) = N):
 (∀ t,P.derivative.eval t = deriv N t) ∧
 (∀ t,P.derivative.derivative.eval t = deriv (deriv N) t):=by
  have bG:(fun t => P.derivative.eval t) = deriv N:=by
    funext t
    have ht:= (P.hasDerivAt t).deriv
    change deriv (fun x => P.eval x) t = P.derivative.eval t at ht
    rw [hN] at ht
    exact ht.symm
  refine ⟨fun t => congrFun bG t,?_⟩
  intro t
  have ht:= (P.derivative.hasDerivAt t).deriv
  change deriv (fun x => P.derivative.eval x) t = P.derivative.derivative.eval t at ht
  rw [bG] at ht
  exact ht.symm
end P7I
namespace P7I
private theorem eD
 (a b c R S d₀ e₀ u₀ v₀:I)
 (hab:bt a b = 1) (hc:c ≠ 0)
 (hK:co a b c R S ≠ 0)
 (hF₀:e₀ ^ 3 * v₀ = d₀ ^ 3 * u₀ + 1)
 (hG₀:pNF a b c R S d₀ e₀ * u₀ - qNF a b c R S d₀ e₀ * v₀ = 0)
 (Pts:Finset eb)
 (hF:∀ z ∈ Pts,z.1.2 ^ 3 * z.2.2 = z.1.1 ^ 3 * z.2.1 + 1)
 (hG:∀ z ∈ Pts,
 pNF a b c R S z.1.1 z.1.2 * z.2.1 -
 qNF a b c R S z.1.1 z.1.2 * z.2.2 = 0)
 (bG:∀ z ∈ Pts,a * z.1.1 + b * z.1.2 = a * d₀ + b * e₀)
 :
 a * d₀ + b * e₀ ≠ 0 ∧
 ∃ h q j₀ k:I,∃ Y:Finset I,
 0 < h ∧ q ≠ 0 ∧
 k = q - 15 * h * a ^ 4 * b ^ 4 ∧
 h * co a b c R S = c * q ∧
 R * e₀ + S * d₀ = c * j₀ ∧
 h * (b * S - a * R) = c * k ∧
 Y.card = Pts.card ∧
 ∀ y ∈ Y,∃ z ∈ Pts,
 z.1.1 = d₀ + b * h * y ∧ z.1.2 = e₀ - a * h * y ∧
 (cV a b h d₀ e₀ j₀ k).eval y =
 (a * d₀ + b * e₀) ^ 7 * z.2.2 ∧
 (cW a b h d₀ e₀ j₀ k).eval y =
 (a * d₀ + b * e₀) ^ 7 * z.2.1:=by
  classical
  let ell:I:= a * d₀ + b * e₀
  obtain ⟨hell,h,q,j₀,k,𝓢,hh,hq,hk,bI,hW,h𝓢c,h𝓢g,bK⟩:=
    dM a b c R S d₀ e₀ u₀ v₀ hab hc hK hF₀ hG₀
  have hkeq:k + 15 * h * a ^ 4 * b ^ 4 = q:=by
    linear_combination hk
  have hqk:k + 15 * h * a ^ 4 * b ^ 4 ≠ 0:=by rwa [hkeq]
  have hdata (z:{z:eb // z ∈ Pts}):
      ∃ y:I,
        z.1.1.1 = d₀ + b * h * y ∧ z.1.1.2 = e₀ - a * h * y ∧
        (cV a b h d₀ e₀ j₀ k).eval y = ell ^ 7 * z.1.2.2 ∧
        (cW a b h d₀ e₀ j₀ k).eval y = ell ^ 7 * z.1.2.1:=by
    obtain ⟨y,s,hs,w,hd,he,hpv,hqv,hw⟩:=
      bK z.1.1.1 z.1.1.2 z.1.2.1 z.1.2.2
        (hF z.1 z.2) (hG z.1 z.2) (bG z.1 z.2)
    exact ⟨y,hd,he,hpv,hqv⟩
  let param:{z:eb // z ∈ Pts} → I:= fun z => (hdata z).choose
  have hparam (z:{z:eb // z ∈ Pts}):
      z.1.1.1 = d₀ + b * h * param z ∧ z.1.1.2 = e₀ - a * h * param z ∧
      (cV a b h d₀ e₀ j₀ k).eval (param z) = ell ^ 7 * z.1.2.2 ∧
      (cW a b h d₀ e₀ j₀ k).eval (param z) = ell ^ 7 * z.1.2.1:=
    (hdata z).choose_spec
  have hinj:aH param:=by
    intro z w hy
    have hd:z.1.1.1 = w.1.1.1:=by
      rw [(hparam z).1,(hparam w).1,hy]
    have he:z.1.1.2 = w.1.1.2:=by
      rw [(hparam z).2.1,(hparam w).2.1,hy]
    have hu:z.1.2.1 = w.1.2.1:=by
      apply aC (pow_ne_zero 7 hell)
      calc
        ell ^ 7 * z.1.2.1 = (cW a b h d₀ e₀ j₀ k).eval (param z):=
          (hparam z).2.2.2.symm
        _ = (cW a b h d₀ e₀ j₀ k).eval (param w):=by rw [hy]
        _ = ell ^ 7 * w.1.2.1:= (hparam w).2.2.2
    have hv:z.1.2.2 = w.1.2.2:=by
      apply aC (pow_ne_zero 7 hell)
      calc
        ell ^ 7 * z.1.2.2 = (cV a b h d₀ e₀ j₀ k).eval (param z):=
          (hparam z).2.2.1.symm
        _ = (cV a b h d₀ e₀ j₀ k).eval (param w):=by rw [hy]
        _ = ell ^ 7 * w.1.2.2:= (hparam w).2.2.1
    apply Subtype.ext
    exact Prod.ext (Prod.ext hd he) (Prod.ext hu hv)
  let emb:{z:eb // z ∈ Pts} ↪ I:= ⟨param,hinj⟩
  let Y:Finset I:= Pts.attach.map emb
  have hcard:Y.card = Pts.card:=by
    simp only [Y,Finset.card_map,Finset.card_attach]
  obtain ⟨hW₀,hW₁⟩:= ey
    a b c R S h d₀ e₀ j₀ k hW
  refine ⟨hell,h,q,j₀,k,Y,hh,hq,hk,bI,hW₀,hW₁,hcard,?_⟩
  intro y hy
  obtain ⟨z,hz,rfl⟩:= Finset.mem_map.mp hy
  exact ⟨z.1,z.2,(hparam z).1,(hparam z).2.1,
    (hparam z).2.2.1,(hparam z).2.2.2⟩
end P7I
open Classical Polynomial
open scoped BigOperators
noncomputable section
namespace A6PositiveBand
set_option maxHeartbeats 1200000
set_option linter.all false
open FormalAB.S5a5b0bd5
private theorem finite_integer_diameter_card (S : Finset ℤ) (L : ℝ)
    (hL : 0 ≤ L)
    (hdiam : ∀ a ∈ S, ∀ b ∈ S, |(a : ℝ) - (b : ℝ)| ≤ L) :
    (S.card : ℝ) ≤ 1 + L := by
  classical
  rcases S.eq_empty_or_nonempty with hS | hS
  · rw [hS, Finset.card_empty, Nat.cast_zero]; linarith
  · have hlo : S.min' hS ∈ S := S.min'_mem hS
    have hhi : S.max' hS ∈ S := S.max'_mem hS
    have horder : S.min' hS ≤ S.max' hS := S.min'_le _ hhi
    have hsub : S ⊆ Finset.Icc (S.min' hS) (S.max' hS) := by
      intro y hy
      rw [Finset.mem_Icc]
      exact ⟨S.min'_le y hy, S.le_max' y hy⟩
    have hc : S.card ≤ (S.max' hS + 1 - S.min' hS).toNat := by
      have hh := Finset.card_le_card hsub
      simpa only [Int.card_Icc] using hh
    have hnonneg : (0 : ℤ) ≤ S.max' hS + 1 - S.min' hS := by omega
    have hcast : (((S.max' hS + 1 - S.min' hS).toNat : ℕ) : ℝ) =
        (S.max' hS : ℝ) + 1 - (S.min' hS : ℝ) := by
      have hh := Int.toNat_of_nonneg hnonneg
      exact_mod_cast hh
    have hcR : (S.card : ℝ) ≤ (S.max' hS : ℝ) + 1 - (S.min' hS : ℝ) := by
      have hh : (S.card : ℝ) ≤ (((S.max' hS + 1 - S.min' hS).toNat : ℕ) : ℝ) := by
        exact_mod_cast hc
      rwa [hcast] at hh
    have hd := (le_abs_self ((S.max' hS : ℝ) - (S.min' hS : ℝ))).trans
      (hdiam _ hhi _ hlo)
    linarith
private theorem strict_interval (Q : Polynomial ℝ) (R : Finset ℝ) (u v : ℝ)
    (huv : u < v) (hroots : ∀ z, Q.eval z = 0 → z ∈ R)
    (hrank : (R.filter (fun r => r ≤ u)).card =
      (R.filter (fun r => r ≤ v)).card)
    (hu : 0 < Q.eval u) :
    ∀ z ∈ Set.Icc u v, 0 < Q.eval z := by
  have hv := positive_on_equal_root_rank Q R u v huv hroots hrank hu
  exact positive_on_equal_rank_interval Q R u v huv hroots hrank hu hv
private theorem band_pair_length
    (P : Polynomial ℝ) (R : Finset ℝ) (a b X L T u v : ℝ)
    (hX : 0 < X) (hL : 0 < L) (hT : 0 < T) (hsq : T^2 = X*L)
    (huv : u < v) (hau : a ≤ u) (hvb : v ≤ b)
    (hu : X/2 < P.eval u) (huX : P.eval u ≤ X)
    (hv : X/2 < P.eval v) (hvX : P.eval v ≤ X)
    (hrank : (R.filter (fun r => r ≤ u)).card =
      (R.filter (fun r => r ≤ v)).card)
    (hroots : ∀ Q ∈ [P - C (X/2), C X - P,
      P.derivative - C T, P.derivative + C T], ∀ z, Q.eval z = 0 → z ∈ R)
    (hgood : u ∉ R)
    (halt : ∀ t ∈ Set.Icc a b, X/2 < P.eval t → P.eval t ≤ X →
      T ≤ |P.derivative.eval t| ∨ L ≤ |P.derivative.derivative.eval t|) :
    (v-u)*L ≤ 2*T := by
  have hroots₁ := hroots (P-C (X/2)) (by simp)
  have hroots₂ := hroots (C X-P) (by simp)
  have hroots₃ := hroots (P.derivative-C T) (by simp)
  have hroots₄ := hroots (P.derivative+C T) (by simp)
  have hvals : ∀ z, u ≤ z → z ≤ v → 0 ≤ P.eval z ∧ P.eval z ≤ X := by
    intro z huz hzv
    have h1 := nonneg_on_equal_rank_interval (P-C (X/2)) R u v huv hroots₁ hrank
      (by simp only [eval_sub,eval_C]; linarith)
      (by simp only [eval_sub,eval_C]; linarith) z ⟨huz,hzv⟩
    have h2 := nonneg_on_equal_rank_interval (C X-P) R u v huv hroots₂ hrank
      (by simpa only [eval_sub,eval_C] using sub_nonneg.mpr huX)
      (by simpa only [eval_sub,eval_C] using sub_nonneg.mpr hvX) z ⟨huz,hzv⟩
    simp only [eval_sub,eval_C] at h1 h2
    constructor <;> linarith
  have hband : ∀ z ∈ Set.Icc u v, X/2 < P.eval z ∧ P.eval z ≤ X := by
    intro z hz
    have h1 := positive_on_equal_rank_interval (P-C (X/2)) R u v huv hroots₁ hrank
      (by simp only [eval_sub,eval_C]; linarith)
      (by simp only [eval_sub,eval_C]; linarith) z hz
    simp only [eval_sub,eval_C] at h1
    exact ⟨by linarith, (hvals z hz.1 hz.2).2⟩
  have htL : X*L = T*T := by nlinarith [hsq]
  by_cases hh : T < P.derivative.eval u
  · have hi := strict_interval (P.derivative-C T) R u v huv hroots₃ hrank
      (by simp only [eval_sub,eval_C]; linarith)
    have hd : ∀ z, u < z → z < v → T ≤ |P.derivative.eval z| := by
      intro z hz1 hz2
      have hh := hi z ⟨hz1.le,hz2.le⟩
      simp only [eval_sub,eval_C] at hh
      exact (by linarith : T ≤ P.derivative.eval z).trans (le_abs_self _)
    have hb := A5AcceptedIntervalProof.derivative_length_bound P u v X T huv hvals hd
    have hm := mul_le_mul_of_nonneg_right hb hL.le
    have hlength : (v-u)*L ≤ T := by nlinarith
    linarith
  · by_cases hh' : P.derivative.eval u < -T
    · have hnegroots : ∀ z, (-(P.derivative+C T)).eval z = 0 → z ∈ R := by
        intro z hz
        apply hroots₄ z
        simpa only [eval_neg,neg_eq_zero] using hz
      have hi := strict_interval (-(P.derivative+C T)) R u v huv hnegroots hrank
        (by simp only [eval_neg,eval_add,eval_C]; linarith)
      have hd : ∀ z, u < z → z < v → T ≤ |P.derivative.eval z| := by
        intro z hz1 hz2
        have hh := hi z ⟨hz1.le,hz2.le⟩
        simp only [eval_neg,eval_add,eval_C] at hh
        exact (by linarith : T ≤ -P.derivative.eval z).trans (neg_le_abs _)
      have hb := A5AcceptedIntervalProof.derivative_length_bound P u v X T huv hvals hd
      have hm := mul_le_mul_of_nonneg_right hb hL.le
      have hlength : (v-u)*L ≤ T := by nlinarith
      linarith
    · have hne₃ : P.derivative.eval u ≠ T := by
        intro he
        apply hgood
        apply hroots₃ u
        simp [he]
      have hne₄ : P.derivative.eval u ≠ -T := by
        intro he
        apply hgood
        apply hroots₄ u
        simp [he]
      have hlo : -T < P.derivative.eval u := lt_of_le_of_ne (by linarith) (Ne.symm hne₄)
      have hhi : P.derivative.eval u < T := lt_of_le_of_ne (by linarith) hne₃
      have hnegroots : ∀ z, (-(P.derivative-C T)).eval z = 0 → z ∈ R := by
        intro z hz
        apply hroots₃ z
        simpa only [eval_neg,neg_eq_zero] using hz
      have hi₁ := strict_interval (-(P.derivative-C T)) R u v huv hnegroots hrank
        (by simp only [eval_neg,eval_sub,eval_C]; linarith)
      have hi₂ := strict_interval (P.derivative+C T) R u v huv hroots₄ hrank
        (by simp only [eval_add,eval_C]; linarith)
      have hpvals : ∀ z, u ≤ z → z ≤ v →
          0 ≤ (P.derivative+C T).eval z ∧ (P.derivative+C T).eval z ≤ 2*T := by
        intro z hz1 hz2
        have h1 := hi₁ z ⟨hz1,hz2⟩
        have h2 := hi₂ z ⟨hz1,hz2⟩
        simp only [eval_neg,eval_sub,eval_add,eval_C] at *
        constructor <;> linarith
      have hpder : ∀ z, u < z → z < v →
          L ≤ |(P.derivative+C T).derivative.eval z| := by
        intro z hz1 hz2
        have h1 := hi₁ z ⟨hz1.le,hz2.le⟩
        have h2 := hi₂ z ⟨hz1.le,hz2.le⟩
        simp only [eval_neg,eval_sub,eval_add,eval_C] at h1 h2
        have hab : |P.derivative.eval z| < T := abs_lt.mpr ⟨by linarith,by linarith⟩
        have hb := hband z ⟨hz1.le,hz2.le⟩
        have hc := halt z ⟨hau.trans hz1.le,hz2.le.trans hvb⟩ hb.1 hb.2
        have hc' : L ≤ |P.derivative.derivative.eval z| := hc.resolve_left (not_le.mpr hab)
        simpa only [derivative_add,derivative_C,add_zero] using hc'
      exact A5AcceptedIntervalProof.derivative_length_bound
        (P.derivative+C T) u v (2*T) L huv hpvals hpder
theorem positive_septic_band_count : (∀ P : Polynomial ℝ, P.natDegree = 7 → ∀ a b X L : ℝ, 0 < X → 0 < L → (∀ t ∈ Set.Icc a b, X/2 < P.eval t → P.eval t ≤ X → Real.sqrt (X*L) ≤ |P.derivative.eval t| ∨ L ≤ |P.derivative.derivative.eval t|) → let S : Set ℤ := {n | a ≤ (n : ℝ) ∧ (n : ℝ) ≤ b ∧ X/2 < P.eval (n : ℝ) ∧ P.eval (n : ℝ) ≤ X}; S.Finite ∧ (S.ncard : ℝ) ≤ 100*(1+Real.sqrt (X/L))) := by
  classical
  intro P hP a b X L hX hL halt
  let T : ℝ := Real.sqrt (X*L)
  have hT : 0 < T := Real.sqrt_pos.mpr (mul_pos hX hL)
  have hsq : T^2 = X*L := Real.sq_sqrt (mul_pos hX hL).le
  let q₁ := P-C (X/2)
  let q₂ := C X-P
  let q₃ := P.derivative-C T
  let q₄ := P.derivative+C T
  have hdeg₁ : q₁.natDegree = 7 := by simp [q₁,hP]
  have hdeg₂ : q₂.natDegree = 7 := by
    have he : q₂ = -(P-C X) := by dsimp [q₂]; ring
    rw [he, natDegree_neg,natDegree_sub_C,hP]
  have hdeg₃ : q₃.natDegree = 6 := by simp [q₃,natDegree_derivative,hP]
  have hdeg₄ : q₄.natDegree = 6 := by simp [q₄,natDegree_derivative,hP]
  have hn₁ : q₁ ≠ 0 := by intro he; simp [he] at hdeg₁
  have hn₂ : q₂ ≠ 0 := by intro he; simp [he] at hdeg₂
  have hn₃ : q₃ ≠ 0 := by intro he; simp [he] at hdeg₃
  have hn₄ : q₄ ≠ 0 := by intro he; simp [he] at hdeg₄
  let R : Finset ℝ := q₁.roots.toFinset ∪
    (q₂.roots.toFinset ∪ (q₃.roots.toFinset ∪ q₄.roots.toFinset))
  have hRcard : R.card ≤ 26 := by
    have h1 := root_finset_card_le_natDegree q₁
    have h2 := root_finset_card_le_natDegree q₂
    have h3 := root_finset_card_le_natDegree q₃
    have h4 := root_finset_card_le_natDegree q₄
    have h12 := Finset.card_union_le q₁.roots.toFinset
      (q₂.roots.toFinset ∪ (q₃.roots.toFinset ∪ q₄.roots.toFinset))
    have h23 := Finset.card_union_le q₂.roots.toFinset
      (q₃.roots.toFinset ∪ q₄.roots.toFinset)
    have h34 := Finset.card_union_le q₃.roots.toFinset q₄.roots.toFinset
    dsimp [R]
    omega
  have hroots : ∀ Q ∈ [P-C (X/2),C X-P,P.derivative-C T,P.derivative+C T],
      ∀ z, Q.eval z = 0 → z ∈ R := by
    intro Q hQ z hz
    simp only [List.mem_cons,List.not_mem_nil,or_false] at hQ
    rcases hQ with rfl | rfl | rfl | rfl
    · have hm := polynomial_root_mem_finset q₁ hn₁ z hz
      simp only [R,Finset.mem_union]
      exact Or.inl hm
    · have hm := polynomial_root_mem_finset q₂ hn₂ z hz
      simp only [R,Finset.mem_union]
      exact Or.inr (Or.inl hm)
    · have hm := polynomial_root_mem_finset q₃ hn₃ z hz
      simp only [R,Finset.mem_union]
      exact Or.inr (Or.inr (Or.inl hm))
    · have hm := polynomial_root_mem_finset q₄ hn₄ z hz
      simp only [R,Finset.mem_union]
      exact Or.inr (Or.inr (Or.inr hm))
  let F : Finset ℤ := (Finset.Icc ⌈a⌉ ⌊b⌋).filter
    (fun n => X/2 < P.eval (n:ℝ) ∧ P.eval (n:ℝ) ≤ X)
  have hF : ∀ n : ℤ, n ∈ F ↔
      a ≤ (n:ℝ) ∧ (n:ℝ) ≤ b ∧ X/2 < P.eval (n:ℝ) ∧ P.eval (n:ℝ) ≤ X := by
    intro n
    simp only [F,Finset.mem_filter,Finset.mem_Icc,Int.ceil_le,Int.le_floor]
    tauto
  have hset : ({n : ℤ | a ≤ (n:ℝ) ∧ (n:ℝ) ≤ b ∧
      X/2 < P.eval (n:ℝ) ∧ P.eval (n:ℝ) ≤ X} : Set ℤ) = (F : Set ℤ) := by
    ext n
    exact (hF n).symm
  rw [hset]
  dsimp only
  rw [Set.ncard_coe_finset]
  refine ⟨F.finite_toSet, ?_⟩
  let G : Finset ℤ := F.filter (fun (n:ℤ) => (n:ℝ) ∉ R)
  let B : Finset ℤ := F.filter (fun (n:ℤ) => (n:ℝ) ∈ R)
  have hB : B.card ≤ R.card := by
    apply Finset.card_le_card_of_injOn (fun n : ℤ => (n:ℝ))
    · intro n hn
      exact (Finset.mem_filter.mp hn).2
    · intro n hn m hm he
      change (n:ℝ) = (m:ℝ) at he
      exact_mod_cast he
  have hFG : F.card ≤ G.card + B.card := by
    have hh : F = G ∪ B := by
      ext n
      simp only [G,B,Finset.mem_union,Finset.mem_filter]
      tauto
    rw [hh]
    exact Finset.card_union_le _ _
  let color : ℤ → Fin (R.card+1) := fun n =>
    ⟨(R.filter (fun r => r ≤ (n:ℝ))).card,
      by have hh := Finset.card_filter_le R (fun r => r ≤ (n:ℝ)); omega⟩
  have hdiam : ∀ i : Fin (R.card+1), ∀ u ∈ G.filter (fun n => color n=i),
      ∀ v ∈ G.filter (fun n => color n=i), |(u:ℝ)-(v:ℝ)| ≤ 2*T/L := by
    intro i u hu v hv
    have huG := (Finset.mem_filter.mp hu).1
    have hvG := (Finset.mem_filter.mp hv).1
    have hcu := (Finset.mem_filter.mp hu).2
    have hcv := (Finset.mem_filter.mp hv).2
    have huF := (Finset.mem_filter.mp huG).1
    have hvF := (Finset.mem_filter.mp hvG).1
    have huR := (Finset.mem_filter.mp huG).2
    have hvR := (Finset.mem_filter.mp hvG).2
    have huP := (hF u).mp huF
    have hvP := (hF v).mp hvF
    have hrank : (R.filter (fun r => r ≤ (u:ℝ))).card =
        (R.filter (fun r => r ≤ (v:ℝ))).card := by
      have hh := congrArg Fin.val (hcu.trans hcv.symm)
      exact hh
    by_cases huv : u ≤ v
    · rw [abs_of_nonpos (sub_nonpos.mpr (by exact_mod_cast huv))]
      by_cases he : u = v
      · subst v
        simp only [sub_self,neg_zero]
        positivity
      · have huvR : (u:ℝ) < (v:ℝ) := by exact_mod_cast lt_of_le_of_ne huv he
        have hb := band_pair_length P R a b X L T u v hX hL hT hsq huvR
          huP.1 hvP.2.1 huP.2.2.1 huP.2.2.2 hvP.2.2.1 hvP.2.2.2
          hrank hroots huR halt
        apply (le_div_iff₀ hL).mpr
        nlinarith
    · rw [abs_of_nonneg (sub_nonneg.mpr (by exact_mod_cast (le_of_not_ge huv)))]
      have hvuR : (v:ℝ) < (u:ℝ) := by exact_mod_cast lt_of_not_ge huv
      have hb := band_pair_length P R a b X L T v u hX hL hT hsq hvuR
        hvP.1 huP.2.1 hvP.2.2.1 hvP.2.2.2 huP.2.2.1 huP.2.2.2
        hrank.symm hroots hvR halt
      apply (le_div_iff₀ hL).mpr
      nlinarith
  have hGC : (G.card:ℝ) ≤ (R.card+1:ℕ)*(1+2*T/L) := by
    have hc : ∀ i : Fin (R.card+1),
        ((G.filter (fun n => color n=i)).card:ℝ) ≤ 1+2*T/L := by
      intro i
      exact finite_integer_diameter_card _ _ (by positivity) (hdiam i)
    have hu : G ⊆ Finset.univ.biUnion
        (fun i : Fin (R.card+1) => G.filter (fun n => color n=i)) := by
      intro n hn
      exact Finset.mem_biUnion.mpr ⟨color n,Finset.mem_univ _,
        Finset.mem_filter.mpr ⟨hn,rfl⟩⟩
    have hn := (Finset.card_le_card hu).trans Finset.card_biUnion_le
    have hr : (G.card:ℝ) ≤ ∑ i : Fin (R.card+1),
        ((G.filter (fun n => color n=i)).card:ℝ) := by
      exact_mod_cast hn
    calc
      (G.card:ℝ) ≤ ∑ i : Fin (R.card+1),
          ((G.filter (fun n => color n=i)).card:ℝ) := hr
      _ ≤ ∑ i : Fin (R.card+1), (1+2*T/L) := Finset.sum_le_sum (fun i hi => hc i)
      _ = (R.card+1:ℕ)*(1+2*T/L) := by simp; ring
  have hd : T/L = Real.sqrt (X/L) := by
    have hs : (T/L)^2 = X/L := by
      field_simp
      nlinarith [hsq]
    have hn : 0 ≤ T/L := by positivity
    rw [←hs,Real.sqrt_sq_eq_abs,abs_of_nonneg hn]
  have hRr : (R.card:ℝ) ≤ 26 := by exact_mod_cast hRcard
  have hBr : (B.card:ℝ) ≤ (R.card:ℝ) := by exact_mod_cast hB
  have hFGr : (F.card:ℝ) ≤ (G.card:ℝ)+(B.card:ℝ) := by exact_mod_cast hFG
  have hGCr : (G.card:ℝ) ≤ ((R.card:ℝ)+1)*(1+2*(T/L)) := by
    simpa only [Nat.cast_add,Nat.cast_one,mul_div_assoc] using hGC
  have hD : 0 ≤ T/L := by positivity
  have hmul := mul_le_mul_of_nonneg_right hRr (by positivity : 0 ≤ 1+2*(T/L))
  rw [←hd]
  nlinarith
end A6PositiveBand
end
noncomputable section
namespace P7I
set_option maxHeartbeats 1200000
set_option linter.all false
open Polynomial
private theorem Fvalue_hasDerivAt (κ lam z : ℝ) :
    HasDerivAt (Fvalue κ lam) (Ffirst κ lam z) z := by
  have hz := hasDerivAt_id z
  have hd := (((((hz.pow 3).const_mul (-10+κ)).add
    ((hz.pow 4).const_mul (15-3*κ+lam))).add
    ((hz.pow 5).const_mul (-6+3*κ-3*lam))).add
    ((hz.pow 6).const_mul (-κ+3*lam))).sub
    ((hz.pow 7).const_mul lam)
  convert hd using 1 <;> (try funext t) <;>
    (try dsimp [Fvalue,Ffirst,Hvalue,Hfirst,Gvalue,Gfirst]) <;> first | rfl | ring
private theorem Ffirst_hasDerivAt (κ lam z : ℝ) :
    HasDerivAt (Ffirst κ lam) (Fsecond κ lam z) z := by
  have hz := hasDerivAt_id z
  have hd := (((((hz.pow 2).const_mul (3*(-10+κ))).add
    ((hz.pow 3).const_mul (4*(15-3*κ+lam)))).add
    ((hz.pow 4).const_mul (5*(-6+3*κ-3*lam)))).add
    ((hz.pow 5).const_mul (6*(-κ+3*lam)))).sub
    ((hz.pow 6).const_mul (7*lam))
  convert hd using 1 <;> (try funext t) <;>
    (try dsimp [Ffirst,Fsecond,Hfirst,Hsecond,Gvalue,Gfirst,Gsecond]) <;> first | rfl | ring
private theorem hermite_reduced_forcing (κ lam z : ℝ) :
    z^2*(z-1)^2*Fsecond κ lam z -
      6*z*(z-1)*(2*z-1)*Ffirst κ lam z +
      6*(7*z^2-7*z+2)*Fvalue κ lam z =
    -6*z^5*(2*z^2-7*z+7) := by
  dsimp [Fvalue,Ffirst,Fsecond,Hvalue,Hfirst,Hsecond,Gvalue,Gfirst,Gsecond]
  ring
private theorem actual_line_ode
    (a b c R S d₀ e₀ h ell : ℝ)
    (ha : a ≠ 0) (hb : b ≠ 0) (hc : c ≠ 0) (hl : ell ≠ 0)
    (he : ell = a*d₀+b*e₀) :
    let d : ℝ → ℝ := fun y => d₀+b*h*y
    let e : ℝ → ℝ := fun y => e₀-a*h*y
    let N : ℝ → ℝ := fun y => d y ^3 * scalarQ a b c R S (d y) (e y)/(c*ell^7)
    let z : ℝ → ℝ := fun y => a*d y/ell
    let γ : ℝ := a*b*h/ell
    ∀ y, (z y)^2*(z y-1)^2*deriv (deriv N) y -
      6*γ*(z y)*(z y-1)*(2*z y-1)*deriv N y +
      6*γ^2*(7*(z y)^2-7*z y+2)*N y =
        -6*γ^2*(z y)^5*(2*(z y)^2-7*z y+7) := by
  dsimp only
  let d : ℝ → ℝ := fun y => d₀+b*h*y
  let e : ℝ → ℝ := fun y => e₀-a*h*y
  let N : ℝ → ℝ := fun y => d y ^3 * scalarQ a b c R S (d y) (e y)/(c*ell^7)
  let z : ℝ → ℝ := fun y => a*d y/ell
  let γ : ℝ := a*b*h/ell
  let κ := R/(c*a^3*b^4)-25
  let lam := (b*S-a*R+15*c*a^4*b^4)/(c*(a*b)^4)
  have hline : ∀ y, a*d y+b*e y = ell := by
    intro y
    dsimp [d,e]
    rw [he]
    ring
  have hN : N = fun y => Fvalue κ lam (z y) := by
    funext y
    have ht := actual_hermite_quotient_identity a b c R S (d y) (e y)
      ha hb hc (by rw [hline]; exact hl)
    rw [hline] at ht
    exact ht.symm
  have hz : ∀ y, HasDerivAt z γ y := by
    intro y
    have ht := (((hasDerivAt_const y d₀).add
      ((hasDerivAt_id y).const_mul (b*h))).const_mul a).div_const ell
    convert ht using 1 <;> (try funext t) <;> (try dsimp [z,d,γ]) <;> first | rfl | ring
  have hN' : deriv N = fun y => Ffirst κ lam (z y)*γ := by
    funext y
    rw [hN]
    exact ((Fvalue_hasDerivAt κ lam (z y)).comp y (hz y)).deriv
  have hN'' : deriv (deriv N) = fun y => Fsecond κ lam (z y)*γ^2 := by
    funext y
    rw [hN']
    have ht := (((Ffirst_hasDerivAt κ lam (z y)).comp y (hz y)).mul_const γ).deriv
    calc
      deriv (fun t => Ffirst κ lam (z t)*γ) y = (Fsecond κ lam (z y)*γ)*γ := ht
      _ = Fsecond κ lam (z y)*γ^2 := by ring
  intro y
  change (z y)^2*(z y-1)^2*deriv (deriv N) y -
      6*γ*(z y)*(z y-1)*(2*z y-1)*deriv N y +
      6*γ^2*(7*(z y)^2-7*z y+2)*N y =
        -6*γ^2*(z y)^5*(2*(z y)^2-7*z y+7)
  rw [hN'',hN',hN]
  linear_combination γ^2 * hermite_reduced_forcing κ lam (z y)
private theorem ode_low_velocity_curvature
    (γ z N₀ N₁ N₂ x L₂ : ℝ)
    (hγ : γ ≠ 0) (hz8 : 8 ≤ |z|)
    (hx : 0 < x) (hL : 0 < L₂)
    (hN : 0 ≤ N₀) (hNX : N₀ ≤ x)
    (hvel : |N₁| ≤ Real.sqrt (x*L₂))
    (hscaleX : 1024*x ≤ |z| ^5)
    (hscaleL : 1024*L₂ ≤ γ^2*|z| ^3)
    (hode : z^2*(z-1)^2*N₂ - 6*γ*z*(z-1)*(2*z-1)*N₁ +
      6*γ^2*(7*z^2-7*z+2)*N₀ = -6*γ^2*z^5*(2*z^2-7*z+7)) :
    L₂ ≤ |N₂| := by
  let w := |z|
  let g := |γ|
  have hw : 8 ≤ w := hz8
  have hw0 : 0 < w := by linarith
  have hg0 : 0 < g := abs_pos.mpr hγ
  have hw2 : w^2 = z^2 := sq_abs z
  have hg2 : g^2 = γ^2 := sq_abs γ
  have hzw : -w ≤ z ∧ z ≤ w := abs_le.mp (le_refl |z|)
  have hzm : |z-1| ≤ 2*w := abs_le.mpr ⟨by linarith,by linarith⟩
  have h2z : |2*z-1| ≤ 3*w := abs_le.mpr ⟨by linarith,by linarith⟩
  have hquad : z^2 ≤ 2*z^2-7*z+7 := by
    by_cases hz : 0 ≤ z
    · have hz8' : 8 ≤ z := by rwa [abs_of_nonneg hz] at hz8
      nlinarith [mul_nonneg (by linarith : 0 ≤ z-8) hz]
    · nlinarith [sq_nonneg z]
  have hquad0 : 0 ≤ 2*z^2-7*z+7 := (sq_nonneg z).trans hquad
  have hquad2 : |7*z^2-7*z+2| ≤ 10*w^2 := by
    have hr0 : 0 ≤ 7*z^2-7*z+2 := by nlinarith [sq_nonneg (z-1/2)]
    rw [abs_of_nonneg hr0]
    nlinarith [mul_nonneg (by linarith : 0 ≤ w-8) hw0.le]
  have hforce : 6*γ^2*w^7 ≤ |-6*γ^2*z^5*(2*z^2-7*z+7)| := by
    calc
      6*γ^2*w^7 = 6*γ^2*w^5*w^2 := by ring
      _ ≤ 6*γ^2*w^5*(2*z^2-7*z+7) := by
        apply mul_le_mul_of_nonneg_left
        · simpa only [hw2] using hquad
        · positivity
      _ = |-6*γ^2*z^5*(2*z^2-7*z+7)| := by
        rw [abs_mul,abs_mul,abs_mul,abs_pow,abs_pow,abs_of_nonneg hquad0]
        norm_num [g,w,sq_abs]
  have hcoefA : |z^2*(z-1)^2| ≤ 4*w^4 := by
    have hh := pow_le_pow_left₀ (abs_nonneg (z-1)) hzm 2
    rw [sq_abs] at hh
    have ht := mul_le_mul_of_nonneg_left hh (sq_nonneg z)
    rw [abs_mul,abs_pow,abs_pow]
    nlinarith [sq_abs z,sq_abs (z-1)]
  have hcoefB : |6*γ*z*(z-1)*(2*z-1)| ≤ 36*g*w^3 := by
    calc
      |6*γ*z*(z-1)*(2*z-1)| = 6*g*w*|z-1| * |2*z-1| := by
        simp only [abs_mul,abs_of_nonneg (by norm_num : (0:ℝ)≤6)]
        rfl
      _ ≤ 6*g*w*(2*w)*(3*w) := by gcongr
      _ = 36*g*w^3 := by ring
  have hcoefC : |6*γ^2*(7*z^2-7*z+2)| ≤ 60*γ^2*w^2 := by
    calc
      |6*γ^2*(7*z^2-7*z+2)| = 6*γ^2*|7*z^2-7*z+2| := by
        rw [abs_mul,abs_mul,abs_pow]
        norm_num [sq_abs]
      _ ≤ 6*γ^2*(10*w^2) := mul_le_mul_of_nonneg_left hquad2 (by positivity)
      _ = 60*γ^2*w^2 := by ring
  have hmain : 6*γ^2*w^7 ≤
