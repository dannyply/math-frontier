private lemma radical_bounds (s : ℝ)
    (hsl : (21/50 : ℝ) ≤ s) (hsu : s ≤ (35/81 : ℝ)) :
    (1/3 : ℝ) ≤ (1+s-Real.sqrt (28*s^2-20*s+4))/2 ∧
    (1+s-Real.sqrt (28*s^2-20*s+4))/2 ≤ (343/1000 : ℝ) := by
  let Q : ℝ := 28*s^2-20*s+4
  let r : ℝ := Real.sqrt Q
  have hQ : 0 ≤ Q := by
    dsimp [Q]
    nlinarith [sq_nonneg (s-5/14)]
  have hr : 0 ≤ r := Real.sqrt_nonneg _
  have hr2 : r^2 = Q := Real.sq_sqrt hQ
  have hgap : 0 ≤ (s-1/3)*(35/81-s) := mul_nonneg (by linarith) (by linarith)
  have hcomp : Q ≤ (s+1/3)^2 := by dsimp [Q]; nlinarith
  have hrle : r ≤ s+1/3 := by
    by_contra hh
    have hp : 0 < (r-(s+1/3))*(r+(s+1/3)) := mul_pos (by linarith) (by linarith)
    nlinarith
  have hcomp2 : (s+157/500)^2 ≤ Q := by
    dsimp [Q]
    nlinarith [sq_nonneg (s-21/50)]
  have hrge : s+157/500 ≤ r := by
    by_contra hh
    have hp : 0 < ((s+157/500)-r)*((s+157/500)+r) :=
      mul_pos (by linarith) (by linarith)
    nlinarith
  change (1/3 : ℝ) ≤ (1+s-r)/2 ∧ (1+s-r)/2 ≤ (343/1000 : ℝ)
  constructor <;> linarith

end A6ActualCeilCompact

