private theorem finite_integer_diameter_card (S : Finset ℤ) (L : ℝ)
    (hL : 0 ≤ L)
    (hdiam : ∀ a ∈ S, ∀ b ∈ S, |(a : ℝ) - (b : ℝ)| ≤ L) :
    (S.card : ℝ) ≤ 1 + L := by
  classical
  rcases S.eq_empty_or_nonempty with hS | hS
  · rw [hS, Finset.card_empty, Nat.cast_zero]
    linarith
  · have hlo : S.min' hS ∈ S := S.min'_mem hS
    have hhi : S.max' hS ∈ S := S.max'_mem hS
    have horder : S.min' hS ≤ S.max' hS := S.min'_le _ hhi
    have hsub : S ⊆ Finset.Icc (S.min' hS) (S.max' hS) := by
      intro y hy
      rw [Finset.mem_Icc]
      exact ⟨S.min'_le y hy, S.le_max' y hy⟩
    have hc : S.card ≤ (S.max' hS + 1 - S.min' hS).toNat := by
      have hh := Finset.card_le_card hsub
      simpa only [Int.card_Icc] using hh
    have hnonneg : (0 : ℤ) ≤ S.max' hS + 1 - S.min' hS := by omega
    have hcast :
        (((S.max' hS + 1 - S.min' hS).toNat : ℕ) : ℝ) =
          (S.max' hS : ℝ) + 1 - (S.min' hS : ℝ) := by
      have hh := Int.toNat_of_nonneg hnonneg
      exact_mod_cast hh
    have hcR : (S.card : ℝ) ≤ (S.max' hS : ℝ) + 1 - (S.min' hS : ℝ) := by
      have hh : (S.card : ℝ) ≤ (((S.max' hS + 1 - S.min' hS).toNat : ℕ) : ℝ) := by
        exact_mod_cast hc
      rwa [hcast] at hh
    have hd := (le_abs_self ((S.max' hS : ℝ) - (S.min' hS : ℝ))).trans
      (hdiam _ hhi _ hlo)
    linarith
private theorem dX
 (S:Finset I) (r J:I) (hJ:0 < J) (L:O) (hL:0 ≤ L)
 (hres:∀ y ∈ S,∃ z:I,y = r + J * z)
 (hdiam:∀ a ∈ S,∀ b ∈ S,|(a:O) - (b:O)| ≤ L):
 (S.card:O) ≤ 1 + L / (J:O):=by
  classical
  let param:{y:I // y ∈ S} → I:= fun y => (hres y.1 y.2).choose
  have hparam (y:{y:I // y ∈ S}):y.1 = r + J * param y:=
    (hres y.1 y.2).choose_spec
  have hinj:aH param:=by
    intro y z hyz
    apply Subtype.ext
    rw [hparam y,hparam z,hyz]
  let emb:{y:I // y ∈ S} ↪ I:= ⟨param,hinj⟩
  let V:Finset I:= S.attach.map emb
  have hc:V.card = S.card:=by
    simp only [V,Finset.card_map,Finset.card_attach]
  have hJR:0 < (J:O):=by exact_mod_cast hJ
  have hd:∀ a ∈ V,∀ b ∈ V,|(a:O) - (b:O)| ≤ L / (J:O):=by
    intro a ha b hb
    obtain ⟨y,hy,rfl⟩:= Finset.mem_map.mp ha
    obtain ⟨z,hz,rfl⟩:= Finset.mem_map.mp hb
    change |(param y:O) - (param z:O)| ≤ L / (J:O)
    have heq:
        (y.1:O) - (z.1:O) =
          (J:O) * ((param y:O) - (param z:O)):=by
      have hyR:(y.1:O) = (r:O) + (J:O) * (param y:O):=by
        exact_mod_cast hparam y
      have hzR:(z.1:O) = (r:O) + (J:O) * (param z:O):=by
        exact_mod_cast hparam z
      rw [hyR,hzR]
      ring
    have hh:= hdiam y.1 y.2 z.1 z.2
    rw [heq,abs_mul,abs_of_pos hJR] at hh
    apply (le_div_iff₀ hJR).mpr
    nlinarith only [hh]
  have bG:= finite_integer_diameter_card V (L / (J:O)) (by positivity) hd
  rwa [hc] at bG
end P7I
