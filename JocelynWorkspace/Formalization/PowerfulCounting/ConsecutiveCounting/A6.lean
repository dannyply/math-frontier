theorem whole_full12_count :
(let StewartHyp : Prop := ∀ q : ℕ, 3 ≤ q → ∀ a : Fin (q + 1) → ℤ, Finset.univ.gcd a = 1 → Squarefree (∑ i : Fin (q + 1), MvPolynomial.C (a i : ℚ) * MvPolynomial.X (0 : Fin 2) ^ (i : ℕ) * MvPolynomial.X (1 : Fin 2) ^ (q - (i : ℕ))) → ∀ m : ℤ, m ≠ 0 → {rs : ℤ × ℤ | Int.gcd rs.1 rs.2 = 1 ∧ ∑ i : Fin (q + 1), a i * rs.1 ^ (i : ℕ) * rs.2 ^ (q - (i : ℕ)) = m}.encard ≤ ((2800 * q ^ (1 + m.natAbs.primeFactors.card) : ℕ) : ℕ∞); StewartHyp → ∀ k : ℕ, 3 ≤ k → ∀ K : ℝ, 0 ≤ K → ∀ ε : ℝ, 0 < ε → ∃ C : ℝ, 0 < C ∧ ∀ x : ℝ, 2 ≤ x → ∀ G : MvPolynomial (Fin 4) ℤ, (∀ m ∈ G.support, m 0 + m 1 = 1 ∧ m 2 + m 3 = 2) → Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G) → (∀ m : Fin 4 →₀ ℕ, |((G.coeff m : ℤ) : ℝ)| ≤ x ^ K) → ∀ h : ℤ, (h = 1 ∨ h = -1) → let S : Set ((ℕ × ℕ) × (ℕ × ℕ)) := {q | 1 ≤ q.1.1 ∧ 1 ≤ q.1.2 ∧ 1 ≤ q.2.1 ∧ 1 ≤ q.2.2 ∧ ((q.1.2 ^ k * q.2.2 : ℕ) : ℤ) = ((q.1.1 ^ k * q.2.1 : ℕ) : ℤ) + h ∧ ((q.1.1 ^ k * q.2.1 : ℕ) : ℝ) ≤ x ∧ MvPolynomial.eval₂ (Int.castRingHom ℚ) (fun i : Fin 4 => if i = 0 then (q.1.1 : ℚ) else if i = 1 then (q.1.2 : ℚ) else if i = 2 then (q.2.1 : ℚ) else (q.2.2 : ℚ)) G = 0}; S.Finite ∧ (S.ncard : ℝ) ≤ C * x ^ ε) := by
