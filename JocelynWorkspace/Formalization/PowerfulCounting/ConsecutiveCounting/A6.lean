  have hradlo : (4 / 9 : ℝ) ≤ A6Threshold8ActualAuxiliary.discriminant s := by
    have hp : 0 ≤ (s - 2 / 5) * (28 * s - 44 / 5) :=
      mul_nonneg (by linarith) (by linarith)
    dsimp [A6Threshold8ActualAuxiliary.discriminant]
    nlinarith only [hp]
  have hsqrt : (2 / 3 : ℝ) ≤
      Real.sqrt (A6Threshold8ActualAuxiliary.discriminant s) := by
    have hn := Real.sqrt_nonneg (A6Threshold8ActualAuxiliary.discriminant s)
    have hsq := Real.sq_sqrt (show 0 ≤ A6Threshold8ActualAuxiliary.discriminant s by
      linarith only [hradlo])
    nlinarith only [hn, hsq, hradlo]
