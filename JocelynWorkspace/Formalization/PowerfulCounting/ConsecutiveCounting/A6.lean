            ((hS0g _ hm.1).2 q hq).1,
          dC _ G z.1.1 (L z) (hL1 z) (hLJ1 z)
            ((hS0g _ hm.1).2 q hq).2⟩
    · intro r hr
      obtain ⟨s0,hs0,hrs0⟩:= hS0v r (fun q hq =>
        hr q (Finset.mem_insert_of_mem hq))
      obtain ⟨a,ha,hra⟩:= hAv r
