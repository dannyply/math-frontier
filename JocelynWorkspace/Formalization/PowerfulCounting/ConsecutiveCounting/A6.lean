  have hMD : (M : ℝ) ≤ D * E := by
    rw [hDE]
    exact hMpow.trans (Real.rpow_le_rpow_of_exponent_le hx1 hs)
  have hUV : V * U = x ^ (2 - 3 * s) := by
    calc
