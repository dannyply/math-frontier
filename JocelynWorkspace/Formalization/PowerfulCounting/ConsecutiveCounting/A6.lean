    · exact (hinfo q hq).2.2.2.2
  obtain ⟨hfin,hcard⟩ := finite_original_parameter_cover S T hinj hmap
  have hcardN : S.ncard≤5600*(2*k+1)*M.natAbs.divisors.card^(2*k+2) :=
