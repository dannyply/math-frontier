private theorem actual_cell_count_from_same_F (hEab : W847cHypEab) (h0180 : W847cHypLow)
    (h4928 : W847cHypFull12) (h47e : W847cHypAlpha3) (hE0 : W847cHypE0) (h2628 : W847cHypP3)
    (hSt : StewartHyp) (N : ℕ) (hN : 1≤N) (K : ℝ) (hK : 0≤K) :
    ∃ Xfac : ℝ, 2≤Xfac ∧
      ∀ eps : ℝ, 0<eps →
        ∃ C : ℝ, 0<C ∧
          ∀ x D E : ℝ, Xfac≤x → 0<D → 0<E → x^((21:ℝ)/50)≤D*E →
            ∀ M : ℕ, 1≤M → x^((1:ℝ)/3)≤(M:ℝ) →
              ∀j∈A6WholeF8GridJoins.cells D E M, ∀q B : ℕ, q+B≤N →
              ∀ F : Four, F≠0 → Bihom F q B →
                (∀t : Fin 4→₀ℕ, |((F.coeff t:ℤ):ℝ)|≤x^K) →
                (∀z∈sourceCell x D E M j,
                  eval ![(z.1.1:ℤ),(z.1.2:ℤ),(z.2.1:ℤ),(z.2.2:ℤ)] F=0) →
                (HighUnion x D E M j F).Finite →
                (pureUnion x D E M j F 4 7).Finite →
                (sourceCell x D E M j \ exceptional).Finite ∧
                ((sourceCell x D E M j \ exceptional).ncard:ℝ) ≤
                  (N:ℝ)*(C*x^eps*p3Price x D E M+(HighUnion x D E M j F).ncard+
                    (pureUnion x D E M j F 4 7).ncard) := by
  classical
  obtain ⟨C₀,hC₀,hcover⟩ := actual_whole_factor_cover_dispatch N
  refine ⟨max 2 C₀,le_max_left _ _,?_⟩
  intro eps heps
  obtain ⟨C,hC,hcount⟩ := actual_all_factor_counts hEab h0180 h4928 h47e hE0 h2628 hSt N hN (K+1) (by linarith) eps heps
  refine ⟨C,hC,?_⟩
  intro x D E hx hD hE hDE M hM hMthree j hj q B hqB F hF hBi hheight hvanish hHigh hSeven
  have hx2 : 2≤x := (le_max_left _ _).trans hx
  have hxC : C₀≤x := (le_max_right _ _).trans hx
  have hx1 : 1≤x := by linarith
  have hH : 1≤x^K := Real.one_le_rpow hx1 hK
  obtain ⟨k,Gs,dg,hk,hdiv,hirr,hbih,hdeg,hzero,hfactorHeight⟩ :=
    hcover (x^K) F q B hH hF hqB hBi hheight
  let T : Fin k→Set Point := fun i=>factorCellOutside x D E M j (Gs i)
  let Budget : ℝ := C*x^eps*p3Price x D E M+(HighUnion x D E M j F).ncard+
    (pureUnion x D E M j F 4 7).ncard
  have hcounts : ∀i : Fin k, (T i).Finite ∧ ((T i).ncard:ℝ)≤Budget := by
    intro i
    exact hcount x D E hx2 hD hE hDE M hM hMthree j hj F (Gs i) (dg i).1 (dg i).2
      (hdeg i).1 (hdeg i).2.1 (hdiv i) (hirr i) (hbih i)
      (fun t => (hfactorHeight i t).trans (actual_factor_height_absorb x K C₀ hx1 hxC))
      hHigh hSeven
  have hsub : sourceCell x D E M j \ exceptional ⊆ ⋃i∈(Finset.univ : Finset (Fin k)),T i := by
    intro z hz
    obtain ⟨i,hi⟩ := hzero
      ![(z.1.1:ℤ),(z.1.2:ℤ),(z.2.1:ℤ),(z.2.2:ℤ)] (hvanish z hz.1)
    exact Set.mem_iUnion.mpr ⟨i,Set.mem_iUnion.mpr
      ⟨Finset.mem_univ i,⟨⟨hz.1,hi⟩,hz.2⟩⟩⟩
  have hUnion := finite_incidence_union_bound (Finset.univ : Finset (Fin k)) T
    (fun i _ => (hcounts i).1)
  have hS := finite_subset_ncard_real
    (sourceCell x D E M j \ exceptional)
    (⋃i∈(Finset.univ : Finset (Fin k)),T i) hsub hUnion.1
  have hUnR : ((⋃i∈(Finset.univ : Finset (Fin k)),T i).ncard:ℝ) ≤
      ∑i : Fin k, ((T i).ncard:ℝ) := by exact_mod_cast hUnion.2
  have hSum : (∑i : Fin k,((T i).ncard:ℝ))≤(k:ℝ)*Budget := by
    calc
      (∑i : Fin k,((T i).ncard:ℝ))≤∑i : Fin k,Budget :=
        Finset.sum_le_sum (fun i _ => (hcounts i).2)
      _=(k:ℝ)*Budget := by simp [nsmul_eq_mul]
  have hBudget : 0≤Budget := by dsimp [Budget,p3Price]; positivity
  have hkR : (k:ℝ)≤(N:ℝ) := by exact_mod_cast hk
  exact ⟨hS.1,hS.2.trans (hUnR.trans
    (hSum.trans (mul_le_mul_of_nonneg_right hkR hBudget)))⟩

