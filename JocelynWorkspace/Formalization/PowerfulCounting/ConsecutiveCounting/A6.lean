      _ ≤ (4 : ℝ)^N.primeFactors.card := by gcongr <;> norm_num
      _ = ((2 : ℝ)^N.primeFactors.card)^2 := by
        rw [show (4 : ℝ)=2^2 by norm_num,←pow_mul,←pow_mul,Nat.mul_comm]
      _ ≤ (N.divisors.card : ℝ)^2 := by gcongr
  calc
    _ ≤ ∑ _n ∈ N.divisors, (N.divisors.card : ℝ)^2 :=
      Finset.sum_le_sum hterm
    _ = (N.divisors.card : ℝ)*(N.divisors.card : ℝ)^2 := by simp
