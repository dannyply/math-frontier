      hM.2.2.2.1 hM.2.2.2.2.1 B hB hBq F hF
  have hUnion : ∀j∈A6WholeF8GridJoins.cells D E (nominalMR x delta),
      ((pureUnion x D E (nominalMR x delta) j (F j) 4 7).ncard:ℝ) ≤
        ∑G∈L j, ((componentCell x D E (nominalMR x delta) j G).ncard:ℝ) := by
    intro j hj
