  convert hd using 1 <;> (try funext t) <;>
    (try dsimp [Ffirst,Fsecond,Hfirst,Hsecond,Gvalue,Gfirst,Gsecond]) <;> first | rfl | ring

private theorem hermite_reduced_forcing (κ lam z : ℝ) :
    z^2*(z-1)^2*Fsecond κ lam z -
      6*z*(z-1)*(2*z-1)*Ffirst κ lam z +
      6*(7*z^2-7*z+2)*Fvalue κ lam z =
    -6*z^5*(2*z^2-7*z+7) := by
  dsimp [Fvalue,Ffirst,Fsecond,Hvalue,Hfirst,Hsecond,Gvalue,Gfirst,Gsecond]
  ring

private theorem actual_line_ode
    (a b c R S d₀ e₀ h ell : ℝ)
    (ha : a ≠ 0) (hb : b ≠ 0) (hc : c ≠ 0) (hl : ell ≠ 0)
    (he : ell = a*d₀+b*e₀) :
    let d : ℝ → ℝ := fun y => d₀+b*h*y
    let e : ℝ → ℝ := fun y => e₀-a*h*y
    let N : ℝ → ℝ := fun y => d y ^3 * scalarQ a b c R S (d y) (e y)/(c*ell^7)
    let z : ℝ → ℝ := fun y => a*d y/ell
    let γ : ℝ := a*b*h/ell
    ∀ y, (z y)^2*(z y-1)^2*deriv (deriv N) y -
      6*γ*(z y)*(z y-1)*(2*z y-1)*deriv N y +
      6*γ^2*(7*(z y)^2-7*z y+2)*N y =
        -6*γ^2*(z y)^5*(2*(z y)^2-7*z y+7) := by
  dsimp only
  let d : ℝ → ℝ := fun y => d₀+b*h*y
  let e : ℝ → ℝ := fun y => e₀-a*h*y
  let N : ℝ → ℝ := fun y => d y ^3 * scalarQ a b c R S (d y) (e y)/(c*ell^7)
  let z : ℝ → ℝ := fun y => a*d y/ell
  let γ : ℝ := a*b*h/ell
  let κ := R/(c*a^3*b^4)-25
  let lam := (b*S-a*R+15*c*a^4*b^4)/(c*(a*b)^4)
  have hline : ∀ y, a*d y+b*e y = ell := by
    intro y
    dsimp [d,e]
    rw [he]
    ring
  have hN : N = fun y => Fvalue κ lam (z y) := by
    funext y
    have ht := actual_hermite_quotient_identity a b c R S (d y) (e y)
      ha hb hc (by rw [hline]; exact hl)
    rw [hline] at ht
    exact ht.symm
  have hz : ∀ y, HasDerivAt z γ y := by
    intro y
    have ht := (((hasDerivAt_const y d₀).add
      ((hasDerivAt_id y).const_mul (b*h))).const_mul a).div_const ell
    convert ht using 1 <;> (try funext t) <;> (try dsimp [z,d,γ]) <;> first | rfl | ring
  have hN' : deriv N = fun y => Ffirst κ lam (z y)*γ := by
    funext y
    rw [hN]
    exact ((Fvalue_hasDerivAt κ lam (z y)).comp y (hz y)).deriv
  have hN'' : deriv (deriv N) = fun y => Fsecond κ lam (z y)*γ^2 := by
    funext y
    rw [hN']
    have ht := (((Ffirst_hasDerivAt κ lam (z y)).comp y (hz y)).mul_const γ).deriv
    calc
      deriv (fun t => Ffirst κ lam (z t)*γ) y = (Fsecond κ lam (z y)*γ)*γ := ht
      _ = Fsecond κ lam (z y)*γ^2 := by ring
  intro y
  change (z y)^2*(z y-1)^2*deriv (deriv N) y -
      6*γ*(z y)*(z y-1)*(2*z y-1)*deriv N y +
      6*γ^2*(7*(z y)^2-7*z y+2)*N y =
        -6*γ^2*(z y)^5*(2*(z y)^2-7*z y+7)
  rw [hN'',hN',hN]
  linear_combination γ^2 * hermite_reduced_forcing κ lam (z y)

private theorem ode_low_velocity_curvature
    (γ z N₀ N₁ N₂ x L₂ : ℝ)
    (hγ : γ ≠ 0) (hz8 : 8 ≤ |z|)
    (hx : 0 < x) (hL : 0 < L₂)
    (hN : 0 ≤ N₀) (hNX : N₀ ≤ x)
    (hvel : |N₁| ≤ Real.sqrt (x*L₂))
    (hscaleX : 1024*x ≤ |z|^5)
    (hscaleL : 1024*L₂ ≤ γ^2*|z|^3)
    (hode : z^2*(z-1)^2*N₂ - 6*γ*z*(z-1)*(2*z-1)*N₁ +
      6*γ^2*(7*z^2-7*z+2)*N₀ = -6*γ^2*z^5*(2*z^2-7*z+7)) :
    L₂ ≤ |N₂| := by
  let w := |z|
  let g := |γ|
  have hw : 8 ≤ w := hz8
  have hw0 : 0 < w := by linarith
  have hg0 : 0 < g := abs_pos.mpr hγ
  have hw2 : w^2 = z^2 := sq_abs z
  have hg2 : g^2 = γ^2 := sq_abs γ
  have hzw : -w ≤ z ∧ z ≤ w := abs_le.mp (le_refl |z|)
  have hzm : |z-1| ≤ 2*w := abs_le.mpr ⟨by linarith,by linarith⟩
  have h2z : |2*z-1| ≤ 3*w := abs_le.mpr ⟨by linarith,by linarith⟩
  have hquad : z^2 ≤ 2*z^2-7*z+7 := by
    by_cases hz : 0 ≤ z
    · have hz8' : 8 ≤ z := by rwa [abs_of_nonneg hz] at hz8
      nlinarith [mul_nonneg (by linarith : 0 ≤ z-8) hz]
    · nlinarith [sq_nonneg z]
  have hquad0 : 0 ≤ 2*z^2-7*z+7 := (sq_nonneg z).trans hquad
  have hquad2 : |7*z^2-7*z+2| ≤ 10*w^2 := by
    have hr0 : 0 ≤ 7*z^2-7*z+2 := by nlinarith [sq_nonneg (z-1/2)]
    rw [abs_of_nonneg hr0]
    nlinarith [mul_nonneg (by linarith : 0 ≤ w-8) hw0.le]
  have hforce : 6*γ^2*w^7 ≤ |-6*γ^2*z^5*(2*z^2-7*z+7)| := by
    calc
      6*γ^2*w^7 = 6*γ^2*w^5*w^2 := by ring
      _ ≤ 6*γ^2*w^5*(2*z^2-7*z+7) := by
        apply mul_le_mul_of_nonneg_left
        · simpa only [hw2] using hquad
        · positivity
      _ = |-6*γ^2*z^5*(2*z^2-7*z+7)| := by
        rw [abs_mul,abs_mul,abs_mul,abs_pow,abs_pow,abs_of_nonneg hquad0]
        norm_num [g,w,sq_abs]
  have hcoefA : |z^2*(z-1)^2| ≤ 4*w^4 := by
    have hh := pow_le_pow_left₀ (abs_nonneg (z-1)) hzm 2
    rw [sq_abs] at hh
    have ht := mul_le_mul_of_nonneg_left hh (sq_nonneg z)
    rw [abs_mul,abs_pow,abs_pow]
    nlinarith [sq_abs z,sq_abs (z-1)]
  have hcoefB : |6*γ*z*(z-1)*(2*z-1)| ≤ 36*g*w^3 := by
    calc
      |6*γ*z*(z-1)*(2*z-1)| = 6*g*w*|z-1| * |2*z-1| := by
        simp only [abs_mul,abs_of_nonneg (by norm_num : (0:ℝ)≤6)]
        rfl
      _ ≤ 6*g*w*(2*w)*(3*w) := by gcongr
      _ = 36*g*w^3 := by ring
  have hcoefC : |6*γ^2*(7*z^2-7*z+2)| ≤ 60*γ^2*w^2 := by
    calc
      |6*γ^2*(7*z^2-7*z+2)| = 6*γ^2*|7*z^2-7*z+2| := by
        rw [abs_mul,abs_mul,abs_pow]
        norm_num [sq_abs]
      _ ≤ 6*γ^2*(10*w^2) := mul_le_mul_of_nonneg_left hquad2 (by positivity)
      _ = 60*γ^2*w^2 := by ring
  have hmain : 6*γ^2*w^7 ≤
      4*w^4*|N₂| + 36*g*w^3*|N₁| + 60*γ^2*w^2*x := by
    calc
      6*γ^2*w^7 ≤ |-6*γ^2*z^5*(2*z^2-7*z+7)| := hforce
      _ = |z^2*(z-1)^2*N₂ - 6*γ*z*(z-1)*(2*z-1)*N₁ +
          6*γ^2*(7*z^2-7*z+2)*N₀| := congrArg abs hode.symm
      _ ≤ |z^2*(z-1)^2*N₂| + |6*γ*z*(z-1)*(2*z-1)*N₁| +
          |6*γ^2*(7*z^2-7*z+2)*N₀| := by
        have ha := abs_le.mp (le_refl |z^2*(z-1)^2*N₂|)
        have hb := abs_le.mp (le_refl |6*γ*z*(z-1)*(2*z-1)*N₁|)
        have hc := abs_le.mp (le_refl |6*γ^2*(7*z^2-7*z+2)*N₀|)
        apply abs_le.mpr
        constructor <;> linarith
      _ ≤ 4*w^4*|N₂|+36*g*w^3*|N₁|+60*γ^2*w^2*x := by
        have h1 : |z^2*(z-1)^2*N₂| ≤ 4*w^4*|N₂| := by
          rw [abs_mul]
          exact mul_le_mul_of_nonneg_right hcoefA (abs_nonneg N₂)
        have h2 : |6*γ*z*(z-1)*(2*z-1)*N₁| ≤ 36*g*w^3*|N₁| := by
          rw [abs_mul]
          exact mul_le_mul_of_nonneg_right hcoefB (abs_nonneg N₁)
        have h3 : |6*γ^2*(7*z^2-7*z+2)*N₀| ≤ 60*γ^2*w^2*x := by
          rw [abs_mul,abs_of_nonneg hN]
          exact mul_le_mul hcoefC hNX hN (by positivity)
        linarith
  have hv2 : N₁^2 ≤ x*L₂ := by
    have hh := pow_le_pow_left₀ (abs_nonneg N₁) hvel 2
    rwa [sq_abs,Real.sq_sqrt (mul_pos hx hL).le] at hh
  have hprod := mul_le_mul hscaleX hscaleL (by positivity : 0 ≤ 1024*L₂)
    (by positivity : 0 ≤ w^5)
  have hvel2 : (1024*|N₁|)^2 ≤ (g*w^4)^2 := by
    change 1024*x*(1024*L₂) ≤ w^5*(γ^2*w^3) at hprod
    rw [←hg2] at hprod
    nlinarith [sq_abs N₁]
  have hvel' : 1024*|N₁| ≤ g*w^4 := by
    have hn : 0 ≤ g*w^4 := by positivity
    nlinarith [sq_nonneg (1024*|N₁|-g*w^4)]
  by_contra hbad
  have hb : |N₂| ≤ L₂ := (lt_of_not_ge hbad).le
  have hmain' := mul_le_mul_of_nonneg_left hmain (by norm_num : (0:ℝ)≤1024)
  have h1 := mul_le_mul_of_nonneg_left hscaleL (by positivity : 0 ≤ 4*w^4)
  have h2 := mul_le_mul_of_nonneg_left hvel' (by positivity : 0 ≤ 36*g*w^3)
  have h3 := mul_le_mul_of_nonneg_left hscaleX (by positivity : 0 ≤ 60*γ^2*w^2)
  have h4 := mul_le_mul_of_nonneg_left hb (by positivity : 0 ≤ 4096*w^4)
  have hp : 0 < γ^2*w^7 := mul_pos (sq_pos_of_ne_zero hγ) (pow_pos hw0 _)
  change 4*w^4*(1024*L₂) ≤ 4*w^4*(γ^2*w^3) at h1
  change 60*γ^2*w^2*(1024*x) ≤ 60*γ^2*w^2*w^5 at h3
  rw [←hg2] at hmain' h1 h3 hp
  nlinarith

theorem actual_septic_curvature :
  ∀ A : ℝ, 1 ≤ A →
    ∃ C c₀ : ℝ, 0 < C ∧ 0 < c₀ ∧
      ∀ x Z : ℝ, 1 ≤ x → 0 < Z →
        ∀ a b c R S d₀ e₀ h : ℤ,
          a ≠ 0 → b ≠ 0 → c ≠ 0 → 0 < h →
          let ell : ℤ := a * d₀ + b * e₀
          ell ≠ 0 →
          let K : ℝ := |((a * b : ℤ) : ℝ)|
          let L : ℝ := |(ell : ℝ)|
          C * x * L ^ 5 ≤ (K * Z) ^ ((5 : ℝ) / 2) →
          let d : ℝ → ℝ := fun y => (d₀ : ℝ) + (b : ℝ) * (h : ℝ) * y
          let e : ℝ → ℝ := fun y => (e₀ : ℝ) - (a : ℝ) * (h : ℝ) * y
          let Q : ℝ → ℝ → ℝ := fun D E =>
            E ^ 3 * ((R : ℝ) * E + (S : ℝ) * D) -
              (c : ℝ) * (
                35 * (a : ℝ) ^ 3 * (b : ℝ) ^ 4 * E ^ 4 +
                35 * (a : ℝ) ^ 4 * (b : ℝ) ^ 3 * D * E ^ 3 +
                21 * (a : ℝ) ^ 5 * (b : ℝ) ^ 2 * D ^ 2 * E ^ 2 +
                7 * (a : ℝ) ^ 6 * (b : ℝ) * D ^ 3 * E +
                (a : ℝ) ^ 7 * D ^ 4)
          let N : ℝ → ℝ := fun y =>
            (d y) ^ 3 * Q (d y) (e y) / ((c : ℝ) * (ell : ℝ) ^ 7)
          let L₂ : ℝ :=
            c₀ * K ^ ((7 : ℝ) / 2) * Z ^ ((3 : ℝ) / 2) *
              (h : ℝ) ^ 2 / L ^ 5
          ∀ y : ℝ,
            Real.sqrt (K * Z) / (A * L) ≤ |(a : ℝ) * d y / (ell : ℝ)| →
            |(a : ℝ) * d y / (ell : ℝ)| ≤ A * Real.sqrt (K * Z) / L →
            x / 2 < N y → N y ≤ x →
            |deriv N y| ≤ Real.sqrt (x * L₂) →
            L₂ ≤ |deriv (deriv N) y|
 := by
  intro A hA
  have hA0 : 0 < A := by linarith
  have hAne : A ≠ 0 := ne_of_gt hA0
  refine ⟨65536*A^5,1/(65536*A^3),by positivity,by positivity,?_⟩
  intro x Z hx hZ a b c R S d₀ e₀ h ha hb hc hh ell hell K L hreg d e Q N L₂
    y hlow hupp hNy hNX hvel
  have hx0 : 0 < x := by linarith
  have haR : (a:ℝ) ≠ 0 := Int.cast_ne_zero.mpr ha
  have hbR : (b:ℝ) ≠ 0 := Int.cast_ne_zero.mpr hb
  have hcR : (c:ℝ) ≠ 0 := Int.cast_ne_zero.mpr hc
  have hellR : (ell:ℝ) ≠ 0 := Int.cast_ne_zero.mpr hell
  have hhR : (0:ℝ) < (h:ℝ) := by exact_mod_cast hh
  have hK : 0 < K := abs_pos.mpr (Int.cast_ne_zero.mpr (mul_ne_zero ha hb))
  have hL : 0 < L := abs_pos.mpr hellR
  have hLne : L ≠ 0 := ne_of_gt hL
  let T : ℝ := Real.sqrt (K*Z)
  let H : ℝ := T/L
  let z : ℝ := (a:ℝ)*d y/(ell:ℝ)
  let γ : ℝ := (a:ℝ)*(b:ℝ)*(h:ℝ)/(ell:ℝ)
  have hT : 0 < T := Real.sqrt_pos.mpr (mul_pos hK hZ)
  have hH : 0 < H := div_pos hT hL
  have hγ : γ ≠ 0 := div_ne_zero (mul_ne_zero (mul_ne_zero haR hbR)
    (ne_of_gt hhR)) hellR
  have hT5 : T^5 = (K*Z)^((5:ℝ)/2) := by
    dsimp [T]
    rw [Real.sqrt_eq_rpow,←Real.rpow_natCast,←Real.rpow_mul (mul_pos hK hZ).le]
    congr 1
    norm_num
  have hT3 : T^3 = K^((3:ℝ)/2)*Z^((3:ℝ)/2) := by
    dsimp [T]
    rw [Real.sqrt_eq_rpow,←Real.rpow_natCast,←Real.rpow_mul (mul_pos hK hZ).le]
    have he : (1/2:ℝ)*(3:ℕ) = (3:ℝ)/2 := by norm_num
    rw [he,Real.mul_rpow hK.le hZ.le]
  have hKpow : K^((7:ℝ)/2) = K^2*K^((3:ℝ)/2) := by
    have he : (7:ℝ)/2 = (2:ℝ)+(3:ℝ)/2 := by norm_num
    rw [he,Real.rpow_add hK]
    norm_num
  have hK2 : K^2 = ((a:ℝ)*(b:ℝ))^2 := by
    dsimp [K]
    rw [sq_abs]
    push_cast
    rfl
  have hL2 : L^2 = (ell:ℝ)^2 := sq_abs (ell:ℝ)
  have hγL : γ^2*L^2 = K^2*(h:ℝ)^2 := by
    rw [hK2,hL2]
    dsimp [γ]
    field_simp [hellR] <;> ring
  have hphysical :
      K^((7:ℝ)/2)*Z^((3:ℝ)/2)*(h:ℝ)^2/L^5 = γ^2*H^3 := by
    calc
      K^((7:ℝ)/2)*Z^((3:ℝ)/2)*(h:ℝ)^2/L^5 =
          (K^2*(h:ℝ)^2)*T^3/L^5 := by rw [hKpow,hT3]; ring
      _ = (γ^2*L^2)*T^3/L^5 := by rw [hγL]
      _ = γ^2*H^3 := by dsimp [H]; field_simp [hLne] <;> ring
  have hL₂eq : L₂ = (1/(65536*A^3))*(γ^2*H^3) := by
    calc
      L₂ = (1/(65536*A^3))*
        (K^((7:ℝ)/2)*Z^((3:ℝ)/2)*(h:ℝ)^2/L^5) := by dsimp [L₂]; ring
      _ = (1/(65536*A^3))*(γ^2*H^3) := by rw [hphysical]
  have hL₂ : 0 < L₂ := by rw [hL₂eq]; positivity
  have hrelL : 65536*A^3*L₂ = γ^2*H^3 := by
    rw [hL₂eq]
    field_simp [hAne]
  have hreg' : 65536*A^5*x ≤ H^5 := by
    dsimp [H]
    rw [div_pow]
    apply (le_div_iff₀ (pow_pos hL _)).mpr
    rw [hT5]
    nlinarith [hreg]
  have hHupper : H ≤ A*|z| := by
    have hh := (div_le_iff₀ (mul_pos hA0 hL)).mp hlow
    dsimp [H]
    apply (div_le_iff₀ hL).mpr
    dsimp [T,z] at *
    nlinarith
  have hXlarge : 65536*x ≤ |z|^5 := by
    have hmul : A^5*(65536*x) ≤ A^5*|z|^5 := by
      calc
        A^5*(65536*x) = 65536*A^5*x := by ring
        _ ≤ H^5 := hreg'
        _ ≤ (A*|z|)^5 := pow_le_pow_left₀ hH.le hHupper 5
        _ = A^5*|z|^5 := by ring
    by_contra hn
    exact (not_lt.mpr hmul)
      (mul_lt_mul_of_pos_left (lt_of_not_ge hn) (pow_pos hA0 5))
  have hLlarge : 65536*L₂ ≤ γ^2*|z|^3 := by
    have hmul : A^3*(65536*L₂) ≤ A^3*(γ^2*|z|^3) := by
      calc
        A^3*(65536*L₂) = γ^2*H^3 := by nlinarith [hrelL]
        _ ≤ γ^2*(A*|z|)^3 :=
          mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hH.le hHupper 3) (sq_nonneg γ)
        _ = A^3*(γ^2*|z|^3) := by ring
    by_contra hn
    exact (not_lt.mpr hmul)
      (mul_lt_mul_of_pos_left (lt_of_not_ge hn) (pow_pos hA0 3))
  have hz8 : 8 ≤ |z| := by
    by_contra hz
    have hz' : |z| ≤ 8 := (lt_of_not_ge hz).le
    have hp := pow_le_pow_left₀ (abs_nonneg z) hz' 5
    norm_num at hp
    nlinarith [hXlarge]
  have hscaleX : 1024*x ≤ |z|^5 := by linarith
  have hscaleL : 1024*L₂ ≤ γ^2*|z|^3 := by linarith
  have hellEq : (ell:ℝ) = (a:ℝ)*(d₀:ℝ)+(b:ℝ)*(e₀:ℝ) := by
    dsimp [ell]
    push_cast
    rfl
  have hode : z^2*(z-1)^2*deriv (deriv N) y -
      6*γ*z*(z-1)*(2*z-1)*deriv N y +
      6*γ^2*(7*z^2-7*z+2)*N y =
        -6*γ^2*z^5*(2*z^2-7*z+7) := by
    exact actual_line_ode (a:ℝ) (b:ℝ) (c:ℝ) (R:ℝ) (S:ℝ)
      (d₀:ℝ) (e₀:ℝ) (h:ℝ) (ell:ℝ) haR hbR hcR hellR hellEq y
  exact ode_low_velocity_curvature γ z (N y) (deriv N y) (deriv (deriv N) y)
    x L₂ hγ hz8 hx0 hL₂ (by linarith) hNX hvel hscaleX hscaleL hode

