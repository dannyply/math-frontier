  let r : ℝ := rho D E M j
  change D/(2*E) ≤ r ∧ r ≤ 2*D/E at hc
  have hr0 : 0 ≤ r := le_trans (by positivity) hc.1
  rcases hz with ⟨hp,ht0,ht1⟩
  rcases hp with ⟨hd,he,hu,hv,-,-,-,hdD,hdDu,heE,heEu⟩
  have he0 : (0 : ℝ) < (z.1.2 : ℝ) := by exact_mod_cast (show 0 < z.1.2 by omega)
  change r < (z.1.1 : ℝ)/(z.1.2 : ℝ) at ht0
  change (z.1.1 : ℝ)/(z.1.2 : ℝ) ≤ r*(1+1/(M : ℝ)) at ht1
  have hdif0 : 0 ≤ (z.1.1 : ℝ)-r*(z.1.2 : ℝ) := by
    have hh := (lt_div_iff₀ he0).mp ht0
    linarith
  have hrE : r*E ≤ 2*D := (le_div_iff₀ hE).mp hc.2
  have hre : r*(z.1.2 : ℝ) ≤ 4*D := by
    have hh := mul_le_mul_of_nonneg_left heEu hr0
    nlinarith
  have hdif : (z.1.1 : ℝ)-r*(z.1.2 : ℝ) ≤ 4*D/(M : ℝ) := by
    have hh := (div_le_iff₀ he0).mp ht1
    have hid :
        r*(1+1/(M : ℝ))*(z.1.2 : ℝ) =
          r*(z.1.2 : ℝ)+(r*(z.1.2 : ℝ))/(M : ℝ) := by ring
    rw [hid] at hh
    have hh' := div_le_div_of_nonneg_right hre hM0.le
    linarith
  have hα : 0 ≤ (M : ℝ)/(8*D) := by positivity
  have hw0 : 0 ≤ ((M : ℝ)/(8*D))*((z.1.1 : ℝ)-r*(z.1.2 : ℝ)) :=
    mul_nonneg hα hdif0
  have hw1 : ((M : ℝ)/(8*D))*((z.1.1 : ℝ)-r*(z.1.2 : ℝ)) ≤ (1/2 : ℝ) := by
    have hh := mul_le_mul_of_nonneg_left hdif hα
    have heq : ((M : ℝ)/(8*D))*(4*D/(M : ℝ))=(1/2 : ℝ) := by
      field_simp [hD.ne',hM0.ne'] ; ring
    rwa [heq] at hh
  have heq0 : 0 ≤ (z.1.2 : ℝ)/(4*E) := by positivity
  have heq1 : (z.1.2 : ℝ)/(4*E) ≤ (1/2 : ℝ) := by
    apply (div_le_iff₀ (by positivity : 0 < 4*E)).mpr
    linarith
  change (((M : ℝ)/(8*D))*(((z.1.1 : ℤ) : ℝ)-
      r*((z.1.2 : ℤ) : ℝ)))^2+(((z.1.2 : ℤ) : ℝ)/(4*E))^2 ≤ 1
  simp only [Int.cast_natCast]
  nlinarith

theorem matrix_left_inverse_mulVec_k
    (P A : Matrix (Fin 2) (Fin 2) ℤ) (hPA : P*A=1) (w : Fin 2 → ℤ) :
    P.mulVec (A.mulVec w)=w := by
  calc
    P.mulVec (A.mulVec w)=(P*A).mulVec w := by
      first
      | rw [Matrix.mulVec_mulVec]
    _ = w := by rw [hPA,Matrix.one_mulVec]

