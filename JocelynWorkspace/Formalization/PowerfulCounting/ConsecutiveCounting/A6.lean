namespace A6PureSepticInternal
set_option maxHeartbeats 1200000
set_option linter.all false
open Polynomial

private noncomputable def scalarP (a b c R S d e : ℝ) : ℝ :=
  c * (b ^ 7 * e ^ 4 + 7 * a * b ^ 6 * d * e ^ 3 +
    21 * a ^ 2 * b ^ 5 * d ^ 2 * e ^ 2) + d ^ 3 * (R * e + S * d)

private noncomputable def scalarQ (a b c R S d e : ℝ) : ℝ :=
  e ^ 3 * (R * e + S * d) -
    c * (35 * a ^ 3 * b ^ 4 * e ^ 4 + 35 * a ^ 4 * b ^ 3 * d * e ^ 3 +
      21 * a ^ 5 * b ^ 2 * d ^ 2 * e ^ 2 +
      7 * a ^ 6 * b * d ^ 3 * e + a ^ 7 * d ^ 4)

private noncomputable def Hvalue (z : ℝ) : ℝ := -10 * z ^ 3 + 15 * z ^ 4 - 6 * z ^ 5
private noncomputable def Hfirst (z : ℝ) : ℝ := -30 * z ^ 2 + 60 * z ^ 3 - 30 * z ^ 4
private noncomputable def Hsecond (z : ℝ) : ℝ := -60 * z + 180 * z ^ 2 - 120 * z ^ 3

private noncomputable def Gvalue (z : ℝ) : ℝ := z ^ 3 * (1 - z) ^ 3
private noncomputable def Gfirst (z : ℝ) : ℝ :=
  3 * z ^ 2 * (1 - z) ^ 3 - 3 * z ^ 3 * (1 - z) ^ 2
private noncomputable def Gsecond (z : ℝ) : ℝ :=
  6 * z * (1 - z) ^ 3 - 18 * z ^ 2 * (1 - z) ^ 2 + 6 * z ^ 3 * (1 - z)

private noncomputable def Fvalue (κ lam z : ℝ) : ℝ :=
  Hvalue z + (κ + lam * z) * Gvalue z
private noncomputable def Ffirst (κ lam z : ℝ) : ℝ :=
  Hfirst z + lam * Gvalue z + (κ + lam * z) * Gfirst z
private noncomputable def Fsecond (κ lam z : ℝ) : ℝ :=
  Hsecond z + 2 * lam * Gfirst z + (κ + lam * z) * Gsecond z

private theorem scalar_pure_identity (a b c R S d e : ℝ) :
    e ^ 3 * scalarP a b c R S d e - d ^ 3 * scalarQ a b c R S d e =
      c * (a * d + b * e) ^ 7 := by
  dsimp [scalarP, scalarQ]
  ring

private theorem actual_hermite_quotient_identity
    (a b c R S d e : ℝ)
    (ha : a ≠ 0) (hb : b ≠ 0) (hc : c ≠ 0)
    (hL : a * d + b * e ≠ 0) :
    Fvalue (R / (c * a ^ 3 * b ^ 4) - 25)
      ((b * S - a * R + 15 * c * a ^ 4 * b ^ 4) / (c * (a * b) ^ 4))
      (a * d / (a * d + b * e)) =
      d ^ 3 * scalarQ a b c R S d e / (c * (a * d + b * e) ^ 7) := by
  dsimp [Fvalue, Hvalue, Gvalue, scalarQ]
  field_simp [ha, hb, hc, hL]
  ring

private theorem actual_original_height_identity
    (a b c R S d e u v : ℝ)
    (ha : a ≠ 0) (hb : b ≠ 0) (hc : c ≠ 0)
    (hL : a * d + b * e ≠ 0)
    (hF : e ^ 3 * v = d ^ 3 * u + 1)
    (hG : scalarP a b c R S d e * u - scalarQ a b c R S d e * v = 0) :
    Fvalue (R / (c * a ^ 3 * b ^ 4) - 25)
      ((b * S - a * R + 15 * c * a ^ 4 * b ^ 4) / (c * (a * b) ^ 4))
      (a * d / (a * d + b * e)) = d ^ 3 * u := by
  have hpure := scalar_pure_identity a b c R S d e
  have hq : scalarQ a b c R S d e = c * (a * d + b * e) ^ 7 * u := by
    linear_combination u * hpure - scalarQ a b c R S d e * hF - e ^ 3 * hG
  rw [actual_hermite_quotient_identity a b c R S d e ha hb hc hL, hq]
  apply (div_eq_iff (mul_ne_zero hc (pow_ne_zero 7 hL))).mpr
  ring

private theorem hermite_exact_forcing_identity (κ lam z : ℝ) :
    Fsecond κ lam z * Gvalue z ^ 2 -
      2 * Gfirst z * Gvalue z * Ffirst κ lam z +
      (2 * Gfirst z ^ 2 - Gsecond z * Gvalue z) * Fvalue κ lam z =
      -6 * z ^ 9 * (z - 1) ^ 4 * (2 * z ^ 2 - 7 * z + 7) := by
  dsimp [Fvalue, Ffirst, Fsecond, Hvalue, Hfirst, Hsecond,
    Gvalue, Gfirst, Gsecond]
  ring

private theorem hermite_g_identity (z : ℝ) (hz : z ≠ 0) (hz1 : z ≠ 1) :
    Gfirst z / Gvalue z = 3 / z + 3 / (z - 1) := by
  dsimp [Gfirst, Gvalue]
  field_simp [hz, sub_ne_zero.mpr hz1, sub_ne_zero.mpr (Ne.symm hz1)]
  ring

private theorem hermite_second_coefficient_identity
    (z : ℝ) (hz : z ≠ 0) (hz1 : z ≠ 1) :
    (2 * Gfirst z ^ 2 - Gsecond z * Gvalue z) / Gvalue z ^ 2 =
      12 / z ^ 2 + 18 / (z * (z - 1)) + 12 / (z - 1) ^ 2 := by
  dsimp [Gvalue, Gfirst, Gsecond]
  field_simp [hz, sub_ne_zero.mpr hz1, sub_ne_zero.mpr (Ne.symm hz1)]
  ring

private theorem Fvalue_hasDerivAt (κ lam z : ℝ) :
    HasDerivAt (Fvalue κ lam) (Ffirst κ lam z) z := by
  have hz := hasDerivAt_id z
  have hd := (((((hz.pow 3).const_mul (-10+κ)).add
    ((hz.pow 4).const_mul (15-3*κ+lam))).add
    ((hz.pow 5).const_mul (-6+3*κ-3*lam))).add
    ((hz.pow 6).const_mul (-κ+3*lam))).sub
    ((hz.pow 7).const_mul lam)
  convert hd using 1 <;> (try funext t) <;>
    (try dsimp [Fvalue,Ffirst,Hvalue,Hfirst,Gvalue,Gfirst]) <;> first | rfl | ring

private theorem Ffirst_hasDerivAt (κ lam z : ℝ) :
    HasDerivAt (Ffirst κ lam) (Fsecond κ lam z) z := by
  have hz := hasDerivAt_id z
  have hd := (((((hz.pow 2).const_mul (3*(-10+κ))).add
    ((hz.pow 3).const_mul (4*(15-3*κ+lam)))).add
    ((hz.pow 4).const_mul (5*(-6+3*κ-3*lam)))).add
    ((hz.pow 5).const_mul (6*(-κ+3*lam)))).sub
    ((hz.pow 6).const_mul (7*lam))
  convert hd using 1 <;> (try funext t) <;>
    (try dsimp [Ffirst,Fsecond,Hfirst,Hsecond,Gvalue,Gfirst,Gsecond]) <;> first | rfl | ring

private theorem hermite_reduced_forcing (κ lam z : ℝ) :
    z^2*(z-1)^2*Fsecond κ lam z -
      6*z*(z-1)*(2*z-1)*Ffirst κ lam z +
      6*(7*z^2-7*z+2)*Fvalue κ lam z =
    -6*z^5*(2*z^2-7*z+7) := by
  dsimp [Fvalue,Ffirst,Fsecond,Hvalue,Hfirst,Hsecond,Gvalue,Gfirst,Gsecond]
  ring

private theorem actual_line_ode
    (a b c R S d₀ e₀ h ell : ℝ)
    (ha : a ≠ 0) (hb : b ≠ 0) (hc : c ≠ 0) (hl : ell ≠ 0)
    (he : ell = a*d₀+b*e₀) :
    let d : ℝ → ℝ := fun y => d₀+b*h*y
    let e : ℝ → ℝ := fun y => e₀-a*h*y
    let N : ℝ → ℝ := fun y => d y ^3 * scalarQ a b c R S (d y) (e y)/(c*ell^7)
    let z : ℝ → ℝ := fun y => a*d y/ell
    let γ : ℝ := a*b*h/ell
    ∀ y, (z y)^2*(z y-1)^2*deriv (deriv N) y -
      6*γ*(z y)*(z y-1)*(2*z y-1)*deriv N y +
      6*γ^2*(7*(z y)^2-7*z y+2)*N y =
        -6*γ^2*(z y)^5*(2*(z y)^2-7*z y+7) := by
  dsimp only
  let d : ℝ → ℝ := fun y => d₀+b*h*y
  let e : ℝ → ℝ := fun y => e₀-a*h*y
  let N : ℝ → ℝ := fun y => d y ^3 * scalarQ a b c R S (d y) (e y)/(c*ell^7)
  let z : ℝ → ℝ := fun y => a*d y/ell
  let γ : ℝ := a*b*h/ell
  let κ := R/(c*a^3*b^4)-25
  let lam := (b*S-a*R+15*c*a^4*b^4)/(c*(a*b)^4)
  have hline : ∀ y, a*d y+b*e y = ell := by
    intro y
    dsimp [d,e]
    rw [he]
    ring
  have hN : N = fun y => Fvalue κ lam (z y) := by
    funext y
    have ht := actual_hermite_quotient_identity a b c R S (d y) (e y)
      ha hb hc (by rw [hline]; exact hl)
    rw [hline] at ht
    exact ht.symm
  have hz : ∀ y, HasDerivAt z γ y := by
    intro y
    have ht := (((hasDerivAt_const y d₀).add
      ((hasDerivAt_id y).const_mul (b*h))).const_mul a).div_const ell
    convert ht using 1 <;> (try funext t) <;> (try dsimp [z,d,γ]) <;> first | rfl | ring
  have hN' : deriv N = fun y => Ffirst κ lam (z y)*γ := by
    funext y
    rw [hN]
    exact ((Fvalue_hasDerivAt κ lam (z y)).comp y (hz y)).deriv
  have hN'' : deriv (deriv N) = fun y => Fsecond κ lam (z y)*γ^2 := by
    funext y
    rw [hN']
    have ht := (((Ffirst_hasDerivAt κ lam (z y)).comp y (hz y)).mul_const γ).deriv
    calc
      deriv (fun t => Ffirst κ lam (z t)*γ) y = (Fsecond κ lam (z y)*γ)*γ := ht
      _ = Fsecond κ lam (z y)*γ^2 := by ring
  intro y
  change (z y)^2*(z y-1)^2*deriv (deriv N) y -
      6*γ*(z y)*(z y-1)*(2*z y-1)*deriv N y +
      6*γ^2*(7*(z y)^2-7*z y+2)*N y =
        -6*γ^2*(z y)^5*(2*(z y)^2-7*z y+7)
  rw [hN'',hN',hN]
  linear_combination γ^2 * hermite_reduced_forcing κ lam (z y)

private theorem hermite_first_order (κ lam z : ℝ) :
    lam*z^4*(z-1)^4 =
      -z*(z-1)*Ffirst κ lam z +
      3*(2*z-1)*Fvalue κ lam z +
      3*z^4*(2*z^2-6*z+5) := by
  dsimp [Fvalue,Ffirst,Hvalue,Hfirst,Gvalue,Gfirst]
  ring

private theorem actual_line_first_order
    (a b c R S d₀ e₀ h ell : ℝ)
    (ha : a ≠ 0) (hb : b ≠ 0) (hc : c ≠ 0) (hl : ell ≠ 0)
    (he : ell = a*d₀+b*e₀) :
    let d : ℝ → ℝ := fun y => d₀+b*h*y
    let e : ℝ → ℝ := fun y => e₀-a*h*y
    let N : ℝ → ℝ := fun y => d y ^3 * scalarQ a b c R S (d y) (e y)/(c*ell^7)
    let z : ℝ → ℝ := fun y => a*d y/ell
    let γ : ℝ := a*b*h/ell
    let lam : ℝ := (b*S-a*R+15*c*a^4*b^4)/(c*(a*b)^4)
    ∀ y, γ*lam*(z y)^4*(z y-1)^4 =
      -(z y)*(z y-1)*deriv N y +
      3*γ*(2*z y-1)*N y +
      3*γ*(z y)^4*(2*(z y)^2-6*z y+5) := by
  dsimp only
  let d : ℝ → ℝ := fun y => d₀+b*h*y
  let e : ℝ → ℝ := fun y => e₀-a*h*y
  let N : ℝ → ℝ := fun y => d y ^3 * scalarQ a b c R S (d y) (e y)/(c*ell^7)
  let z : ℝ → ℝ := fun y => a*d y/ell
  let γ : ℝ := a*b*h/ell
  let κ := R/(c*a^3*b^4)-25
  let lam := (b*S-a*R+15*c*a^4*b^4)/(c*(a*b)^4)
  have hline : ∀ y, a*d y+b*e y = ell := by
    intro y
    dsimp [d,e]
    rw [he]
    ring
  have hN : N = fun y => Fvalue κ lam (z y) := by
    funext y
    have ht := actual_hermite_quotient_identity a b c R S (d y) (e y)
      ha hb hc (by rw [hline]; exact hl)
    rw [hline] at ht
    exact ht.symm
  have hz : ∀ y, HasDerivAt z γ y := by
    intro y
    have ht := (((hasDerivAt_const y d₀).add
      ((hasDerivAt_id y).const_mul (b*h))).const_mul a).div_const ell
    convert ht using 1 <;> (try funext t) <;>
      (try dsimp [z,d,γ]) <;> first | rfl | ring
  have hN' : deriv N = fun y => Ffirst κ lam (z y)*γ := by
    funext y
    rw [hN]
    exact ((Fvalue_hasDerivAt κ lam (z y)).comp y (hz y)).deriv
  intro y
  change γ*lam*(z y)^4*(z y-1)^4 =
      -(z y)*(z y-1)*deriv N y +
      3*γ*(2*z y-1)*N y +
      3*γ*(z y)^4*(2*(z y)^2-6*z y+5)
  rw [hN',hN]
  linear_combination γ * hermite_first_order κ lam (z y)

private theorem first_order_derivative_bound
    (γ lam z N₀ N₁ x : ℝ)
    (hγ : γ ≠ 0) (hz8 : 8 ≤ |z|) (hx : 0 < x)
    (hN : 0 ≤ N₀) (hNX : N₀ ≤ x)
    (hscale1 : 65536 ≤ |lam| * |z|^2)
    (hscale2 : 65536*x ≤ |lam| * |z|^7)
    (hode : γ*lam*z^4*(z-1)^4 =
      -z*(z-1)*N₁ +3*γ*(2*z-1)*N₀ +3*γ*z^4*(2*z^2-6*z+5)) :
    |γ| * |lam| * |z|^6/64 ≤ |N₁| := by
  let w := |z|
  let g := |γ|
  let l := |lam|
  have hw : 8 ≤ w := hz8
  have hw0 : 0 < w := by linarith
  have hg0 : 0 < g := abs_pos.mpr hγ
  have hl0 : 0 < l := by
    by_contra hn
    have he : l = 0 := le_antisymm (not_lt.mp hn) (abs_nonneg lam)
    change 65536 ≤ l*w^2 at hscale1
    rw [he,zero_mul] at hscale1
    norm_num at hscale1
  have hw2 : w^2 = z^2 := sq_abs z
  have hzw : -w ≤ z ∧ z ≤ w := abs_le.mp (le_refl |z|)
  have hzm : |z-1| ≤ 2*w := abs_le.mpr ⟨by linarith,by linarith⟩
  have h2z : |2*z-1| ≤ 3*w := abs_le.mpr ⟨by linarith,by linarith⟩
  have hzmlow : w/2 ≤ |z-1| := by
    by_cases hz : 0 ≤ z
    · have he : w = z := abs_of_nonneg hz
      rw [abs_of_nonneg (by linarith : 0 ≤ z-1)]
      linarith
    · have he : w = -z := abs_of_neg (lt_of_not_ge hz)
      rw [abs_of_neg (by linarith : z-1 < 0)]
      linarith
  have hquad : |2*z^2-6*z+5| ≤ 4*w^2 := by
    have hq0 : 0 ≤ 2*z^2-6*z+5 := by nlinarith [sq_nonneg (z-3/2)]
    rw [abs_of_nonneg hq0]
    nlinarith [mul_nonneg (by linarith : 0 ≤ w-8) hw0.le]
  have hforce : g*l*w^8 ≤ 16*|γ*lam*z^4*(z-1)^4| := by
    have hp := pow_le_pow_left₀ (by positivity : 0 ≤ w/2) hzmlow 4
    have ht := mul_le_mul_of_nonneg_left hp (by positivity : 0 ≤ g*l*w^4)
    rw [abs_mul,abs_mul,abs_mul,abs_pow,abs_pow]
    change g*l*w^8 ≤ 16*(g*l*w^4*|z-1|^4)
    nlinarith
  have hcoefA : |-(z*(z-1))| ≤ 2*w^2 := by
    calc
      |-(z*(z-1))| = w*|z-1| := by rw [abs_neg,abs_mul]
      _ ≤ w*(2*w) := mul_le_mul_of_nonneg_left hzm hw0.le
      _ = 2*w^2 := by ring
  have hcoefB : |3*γ*(2*z-1)| ≤ 9*g*w := by
    calc
      |3*γ*(2*z-1)| = 3*g*|2*z-1| := by
        simp only [abs_mul,abs_of_nonneg (by norm_num : (0:ℝ)≤3)]
        rfl
      _ ≤ 3*g*(3*w) := mul_le_mul_of_nonneg_left h2z (by positivity)
      _ = 9*g*w := by ring
  have hcoefC : |3*γ*z^4*(2*z^2-6*z+5)| ≤ 12*g*w^6 := by
    calc
      |3*γ*z^4*(2*z^2-6*z+5)| = 3*g*w^4*|2*z^2-6*z+5| := by
        simp only [abs_mul,abs_pow,abs_of_nonneg (by norm_num : (0:ℝ)≤3)]
        rfl
      _ ≤ 3*g*w^4*(4*w^2) := mul_le_mul_of_nonneg_left hquad (by positivity)
      _ = 12*g*w^6 := by ring
  have hmain : g*l*w^8 ≤ 16*(2*w^2*|N₁|+9*g*w*x+12*g*w^6) := by
    calc
      g*l*w^8 ≤ 16*|γ*lam*z^4*(z-1)^4| := hforce
      _ = 16*|-z*(z-1)*N₁+3*γ*(2*z-1)*N₀+
          3*γ*z^4*(2*z^2-6*z+5)| := by rw [hode]
      _ ≤ 16*(|-z*(z-1)*N₁|+|3*γ*(2*z-1)*N₀|+
          |3*γ*z^4*(2*z^2-6*z+5)|) := by
        apply mul_le_mul_of_nonneg_left _ (by norm_num)
        have ha := abs_le.mp (le_refl |-z*(z-1)*N₁|)
        have hb := abs_le.mp (le_refl |3*γ*(2*z-1)*N₀|)
        have hc := abs_le.mp (le_refl |3*γ*z^4*(2*z^2-6*z+5)|)
        apply abs_le.mpr
        constructor <;> linarith
      _ ≤ 16*(2*w^2*|N₁|+9*g*w*x+12*g*w^6) := by
        have ha : |-z*(z-1)*N₁| ≤ 2*w^2*|N₁| := by
          have hh := mul_le_mul_of_nonneg_right hcoefA (abs_nonneg N₁)
          simpa only [abs_mul,abs_neg] using hh
        have hb : |3*γ*(2*z-1)*N₀| ≤ 9*g*w*x := by
          rw [abs_mul,abs_of_nonneg hN]
          exact mul_le_mul hcoefB hNX hN (by positivity)
        linarith
  by_contra hb
  have hb' : 64*|N₁| ≤ g*l*w^6 := by
    change ¬ g*l*w^6/64 ≤ |N₁| at hb
    linarith
  have hmain' := mul_le_mul_of_nonneg_left hmain (by norm_num : (0:ℝ)≤65536)
  have h1 := mul_le_mul_of_nonneg_left hscale1 (by positivity : 0 ≤ 192*g*w^6)
  have h2 := mul_le_mul_of_nonneg_left hscale2 (by positivity : 0 ≤ 144*g*w)
  have h3 := mul_le_mul_of_nonneg_left hb' (by positivity : 0 ≤ 32768*w^2)
  have hpos : 0 < g*l*w^8 := by positivity
  change 192*g*w^6*65536 ≤ 192*g*w^6*(l*w^2) at h1
  change 144*g*w*(65536*x) ≤ 144*g*w*(l*w^7) at h2
  nlinarith

theorem actual_septic_regimeI :
  ∀ A : ℝ, 1 ≤ A →
    ∃ C c₀ : ℝ, 0 < C ∧ 0 < c₀ ∧
      ∀ x Z : ℝ, 1 ≤ x → 0 < Z →
        ∀ a b c R S d₀ e₀ h : ℤ,
          a ≠ 0 → b ≠ 0 → c ≠ 0 → 0 < h →
          let ell : ℤ := a * d₀ + b * e₀
          ell ≠ 0 →
          let K : ℝ := |((a * b : ℤ) : ℝ)|
          let L : ℝ := |(ell : ℝ)|
          let K₀ : ℤ := b*S-a*R+15*c*a^4*b^4
          let lam : ℝ := (K₀ : ℝ)/((c : ℝ)*K^4)
          C * L^2 ≤ |lam| * K*Z →
          C * x * L^7 ≤ |lam| * (K*Z)^((7 : ℝ)/2) →
          let d : ℝ → ℝ := fun y => (d₀ : ℝ) + (b : ℝ) * (h : ℝ) * y
          let e : ℝ → ℝ := fun y => (e₀ : ℝ) - (a : ℝ) * (h : ℝ) * y
          let Q : ℝ → ℝ → ℝ := fun D E =>
            E ^ 3 * ((R : ℝ) * E + (S : ℝ) * D) -
              (c : ℝ) * (
                35 * (a : ℝ) ^ 3 * (b : ℝ) ^ 4 * E ^ 4 +
                35 * (a : ℝ) ^ 4 * (b : ℝ) ^ 3 * D * E ^ 3 +
                21 * (a : ℝ) ^ 5 * (b : ℝ) ^ 2 * D ^ 2 * E ^ 2 +
                7 * (a : ℝ) ^ 6 * (b : ℝ) * D ^ 3 * E +
                (a : ℝ) ^ 7 * D ^ 4)
          let N : ℝ → ℝ := fun y =>
            (d y) ^ 3 * Q (d y) (e y) / ((c : ℝ) * (ell : ℝ) ^ 7)
          ∀ y : ℝ,
            8 ≤ |(a : ℝ)*d y/(ell : ℝ)| →
            Real.sqrt (K*Z)/(A*L) ≤ |(a : ℝ)*d y/(ell : ℝ)| →
            |(a : ℝ)*d y/(ell : ℝ)| ≤ A*Real.sqrt (K*Z)/L →
            x/2 < N y → N y ≤ x →
            c₀*|(K₀ : ℝ)/(c : ℝ)| * (h : ℝ)*Z^3/L^7 ≤ |deriv N y|
 := by
  intro A hA
  have hA0 : 0 < A := by linarith
  have hAne : A ≠ 0 := ne_of_gt hA0
  refine ⟨65536*(A^2+A^7),1/(64*A^6),by positivity,by positivity,?_⟩
  intro x Z hx hZ a b c R S d₀ e₀ h ha hb hc hh ell hell K L K₀ lam hreg₁ hreg₂
    d e Q N y hz8 hlow hupp hNy hNX
  have hx0 : 0 < x := by linarith
  have haR : (a:ℝ) ≠ 0 := Int.cast_ne_zero.mpr ha
  have hbR : (b:ℝ) ≠ 0 := Int.cast_ne_zero.mpr hb
  have hcR : (c:ℝ) ≠ 0 := Int.cast_ne_zero.mpr hc
  have hellR : (ell:ℝ) ≠ 0 := Int.cast_ne_zero.mpr hell
  have hhR : (0:ℝ) < (h:ℝ) := by exact_mod_cast hh
  have hK : 0 < K := abs_pos.mpr (Int.cast_ne_zero.mpr (mul_ne_zero ha hb))
  have hL : 0 < L := abs_pos.mpr hellR
  have hKne : K ≠ 0 := ne_of_gt hK
  have hLne : L ≠ 0 := ne_of_gt hL
  let T : ℝ := Real.sqrt (K*Z)
  let H : ℝ := T/L
  let z : ℝ := (a:ℝ)*d y/(ell:ℝ)
  let γ : ℝ := (a:ℝ)*(b:ℝ)*(h:ℝ)/(ell:ℝ)
  have hT : 0 < T := Real.sqrt_pos.mpr (mul_pos hK hZ)
  have hH : 0 < H := div_pos hT hL
