def discriminant (s : ℝ) : ℝ := 28 * s ^ 2 - 20 * s + 4
def mStar (s : ℝ) : ℝ := (1 + s - Real.sqrt (discriminant s)) / 2
def aspect (s : ℝ) : ℝ :=
  3 * (3 * s - 1) / (1 - s + Real.sqrt (discriminant s))
def degreeB (q : ℕ) (s : ℝ) : ℕ := ⌊aspect s * (q : ℝ)⌋₊
def gate (A B : ℕ) (s : ℝ) : ℝ :=
  (s * (A : ℝ) + (1 - 3 * s) * (B : ℝ) + R A B) /
    ((A : ℝ) + R A B)
def margin (A B : ℕ) (s μ : ℝ) : ℝ :=
  weight A B μ - s * (iSum A B : ℝ) - (2 - 3 * s) * (jSum A B : ℝ)

