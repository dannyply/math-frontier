private def posSol (a b m Z : ℕ) : Finset (ℕ × ℕ) :=
  ((range (Z + 1)) ×ˢ (range (Z + 1))).filter
    (fun xy => 0 < xy.1 ∧ 0 < xy.2 ∧ Nat.gcd xy.1 xy.2 = 1 ∧
      a * xy.2 ^ 2 + b * xy.1 ^ 2 = m)

private lemma mem_posSol {a b m Z : ℕ} {xy : ℕ × ℕ} :
    xy ∈ posSol a b m Z ↔
      xy.1 ≤ Z ∧ xy.2 ≤ Z ∧ 0 < xy.1 ∧ 0 < xy.2 ∧
      Nat.gcd xy.1 xy.2 = 1 ∧ a * xy.2 ^ 2 + b * xy.1 ^ 2 = m := by
  simp only [posSol, Finset.mem_filter, Finset.mem_product, Finset.mem_range,
    Nat.lt_succ_iff, and_assoc]

private theorem positive_same_class_unique
    (a b m x0 y0 x y : ℕ)
    (ha : 0 < a) (hb : 0 < b) (hm : 0 < m)
    (hx0 : 0 < x0) (hy0 : 0 < y0) (hx : 0 < x) (hy : 0 < y)
    (h0 : a * y0 ^ 2 + b * x0 ^ 2 = m)
    (h1 : a * y ^ 2 + b * x ^ 2 = m)
    (hP : (m : ℤ) ∣ (a : ℤ) * y * y0 + (b : ℤ) * x * x0)
    (hR : (m : ℤ) ∣ (x : ℤ) * y0 - (y : ℤ) * x0) :
    x = x0 ∧ y = y0 := by
  have hmZ : (0 : ℤ) < m := by exact_mod_cast hm
  have h0Z : (a : ℤ) * (y0 : ℤ) ^ 2 + (b : ℤ) * (x0 : ℤ) ^ 2 = m := by
    exact_mod_cast h0
  have h1Z : (a : ℤ) * (y : ℤ) ^ 2 + (b : ℤ) * (x : ℤ) ^ 2 = m := by
    exact_mod_cast h1
  have h0' : (a : ℤ) * (y0 : ℤ) ^ 2 - (-(b : ℤ)) * (x0 : ℤ) ^ 2 = m := by
    simpa only [neg_mul, sub_neg_eq_add] using h0Z
  have h1' : (a : ℤ) * (y : ℤ) ^ 2 - (-(b : ℤ)) * (x : ℤ) ^ 2 = m := by
    simpa only [neg_mul, sub_neg_eq_add] using h1Z
  have hP' : (m : ℤ) ∣ (a : ℤ) * y * y0 - (-(b : ℤ)) * x * x0 := by
    simpa only [neg_mul, sub_neg_eq_add] using hP
  let T : ℤ := ((a : ℤ) * y * y0 + (b : ℤ) * x * x0) / m
  let U : ℤ := ((x : ℤ) * y0 - (y : ℤ) * x0) / m
  have hclass := FormalAB.Sab87e3d4.A2InheritedPell.class_pell2
    (m : ℤ) hmZ.ne' (a : ℤ) (-(b : ℤ)) x0 y0 x y h0' h1' hP' hR
  have hid : T ^ 2 + (a : ℤ) * b * U ^ 2 = 1 := by
    dsimp only [T, U]
    simpa only [mul_neg, neg_mul, sub_neg_eq_add] using hclass
  have hnumpos : (0 : ℤ) < (a : ℤ) * y * y0 + (b : ℤ) * x * x0 := by
    positivity
  have hTpos : 0 < T := by
    obtain ⟨t, ht⟩ := hP
    have htpos : (0 : ℤ) < t := by
      by_contra hnt
      have htle : t ≤ 0 := by omega
      have hprod : (m : ℤ) * t ≤ 0 :=
        mul_nonpos_of_nonneg_of_nonpos hmZ.le htle
      rw [← ht] at hprod
      exact (not_le_of_gt hnumpos) hprod
    dsimp only [T]
    rw [ht, Int.mul_ediv_cancel_left _ hmZ.ne']
    exact htpos
  have hTone : 1 ≤ T := by omega
  have hTsq : 1 ≤ T ^ 2 := by nlinarith
  have hU : U = 0 := by
    by_contra hUn
    have hterm : (0 : ℤ) < (a : ℤ) * b * U ^ 2 :=
      mul_pos (by positivity) (sq_pos_of_ne_zero hUn)
    nlinarith
  have hT : T = 1 := by
    have ht2 : T ^ 2 = 1 := by simpa only [hU, zero_pow (by decide : (2 : ℕ) ≠ 0),
      mul_zero, add_zero] using hid
    nlinarith
  have hdot : (a : ℤ) * y * y0 + (b : ℤ) * x * x0 = m := by
    have he := Int.mul_ediv_cancel' hP
    change (m : ℤ) * T = _ at he
    rw [hT, mul_one] at he
    exact he.symm
  have hwedge : (x : ℤ) * y0 - (y : ℤ) * x0 = 0 := by
    have he := Int.mul_ediv_cancel' hR
    change (m : ℤ) * U = _ at he
    rw [hU, mul_zero] at he
    exact he.symm
  have hdot0 : (a : ℤ) * y0 * y0 - (-(b : ℤ)) * x0 * x0 = m := by
    nlinarith [h0Z]
  have hPeq : (a : ℤ) * y * y0 - (-(b : ℤ)) * x * x0 =
      (a : ℤ) * y0 * y0 - (-(b : ℤ)) * x0 * x0 := by
    calc
      _ = (m : ℤ) := by simpa only [neg_mul, sub_neg_eq_add] using hdot
      _ = _ := hdot0.symm
  have hReq : (x : ℤ) * y0 - (y : ℤ) * x0 =
      (x0 : ℤ) * y0 - (y0 : ℤ) * x0 := by
    rw [hwedge]
    ring
  obtain ⟨heX, heY⟩ := FormalAB.Sab87e3d4.A2InheritedPell.class_inj
    (m : ℤ) hmZ.ne' (a : ℤ) (-(b : ℤ)) x0 y0 x y x0 y0 h0' hPeq hReq
  constructor
  · exact_mod_cast heX
  · exact_mod_cast heY

private theorem pos_base_count (a b m : ℕ)
    (ha : 0 < a) (hb : 0 < b) (hm : 0 < m)
    (hcop : Nat.Coprime (a * b) m) (Z : ℕ) :
    (posSol a b m Z).card ≤ 2 * m.divisors.card := by
  classical
  have : NeZero m := ⟨hm.ne'⟩
  let S := posSol a b m Z
  have hca : Nat.Coprime a m :=
    Nat.Coprime.coprime_dvd_left (dvd_mul_right a b) hcop
  have hcb : Nat.Coprime b m :=
    Nat.Coprime.coprime_dvd_left (dvd_mul_left b a) hcop
  have hucop : ∀ xy ∈ S, Nat.Coprime xy.1 m := by
    intro xy hxy
    obtain ⟨_, _, _, _, hg, heq⟩ := mem_posSol.mp hxy
    apply Nat.coprime_of_dvd
    intro p hp hpx hpm
    have hpa : ¬ p ∣ a := by
      intro hpa
      have hp1 : p ∣ Nat.gcd a m := Nat.dvd_gcd hpa hpm
      rw [hca] at hp1
      exact hp.one_lt.ne' (Nat.dvd_one.mp hp1)
    have hs : p ∣ a * xy.2 ^ 2 + b * xy.1 ^ 2 := by rw [heq]; exact hpm
    have hbx : p ∣ b * xy.1 ^ 2 :=
      dvd_mul_of_dvd_right (dvd_pow hpx two_ne_zero) b
    have hay : p ∣ a * xy.2 ^ 2 := (Nat.dvd_add_left hbx).mp hs
    rcases hp.dvd_mul.mp hay with hpa' | hpy2
    · exact hpa hpa'
    · have hpy : p ∣ xy.2 := hp.dvd_of_dvd_pow hpy2
      have hp1 : p ∣ Nat.gcd xy.1 xy.2 := Nat.dvd_gcd hpx hpy
      rw [hg] at hp1
      exact hp.one_lt.ne' (Nat.dvd_one.mp hp1)
  let lab : ℕ × ℕ → ZMod m := fun xy =>
    (xy.2 : ZMod m) * (xy.1 : ZMod m)⁻¹
  let bb : ℕ := (-(b : ZMod m)).val
  have hbb : (bb : ZMod m) = -(b : ZMod m) := by
    dsimp only [bb]
    exact ZMod.natCast_zmod_val _
  have hbbcop : Nat.Coprime bb m := by
    have hbunit : IsUnit (b : ZMod m) := (ZMod.isUnit_iff_coprime b m).mpr hcb
    obtain ⟨u, hu⟩ := hbunit.neg
    have hh := ZMod.val_coe_unit_coprime u
    rw [hu] at hh
    exact hh
  have hcop' : Nat.Coprime (a * bb) m := by
    exact (Nat.Coprime.mul_right hca.symm hbbcop.symm).symm
  let R := Finset.univ.filter (fun r : ZMod m => (a : ZMod m) * r ^ 2 = bb)
  have hinv : ∀ xy ∈ S, (xy.1 : ZMod m) * (xy.1 : ZMod m)⁻¹ = 1 :=
    fun xy hxy => ZMod.coe_mul_inv_eq_one _ (hucop xy hxy)
  have hlab : ∀ xy ∈ S, (xy.2 : ZMod m) = lab xy * xy.1 := by
    intro xy hxy
    dsimp only [lab]
    rw [mul_assoc, mul_comm ((xy.1 : ZMod m)⁻¹), hinv xy hxy, mul_one]
  have heqmod : ∀ xy ∈ S,
      (a : ZMod m) * (xy.2 : ZMod m) ^ 2 +
        (b : ZMod m) * (xy.1 : ZMod m) ^ 2 = 0 := by
    intro xy hxy
    obtain ⟨_, _, _, _, _, heq⟩ := mem_posSol.mp hxy
    have heqZ : (a : ℤ) * (xy.2 : ℤ) ^ 2 + (b : ℤ) * (xy.1 : ℤ) ^ 2 = m := by
      exact_mod_cast heq
    have hz : ((m : ℤ) : ZMod m) = 0 :=
      (ZMod.intCast_zmod_eq_zero_iff_dvd (m : ℤ) m).mpr dvd_rfl
    have hh : (((a : ℤ) * (xy.2 : ℤ) ^ 2 +
        (b : ℤ) * (xy.1 : ℤ) ^ 2 : ℤ) : ZMod m) = 0 := by
      rw [heqZ]
      exact hz
    push_cast at hh
    exact hh
  have hlabR : ∀ xy ∈ S, lab xy ∈ R := by
    intro xy hxy
    apply Finset.mem_filter.mpr
    refine ⟨Finset.mem_univ _, ?_⟩
    have he := heqmod xy hxy
    rw [hlab xy hxy] at he
    have he2 : ((a : ZMod m) * lab xy ^ 2 + b) *
        ((xy.1 : ZMod m) ^ 2) = 0 := by
      calc
        _ = (a : ZMod m) * (lab xy * xy.1) ^ 2 +
            (b : ZMod m) * (xy.1 : ZMod m) ^ 2 := by ring
        _ = 0 := he
    have he3 : ((a : ZMod m) * lab xy ^ 2 + b) *
        ((xy.1 : ZMod m) ^ 2) * ((xy.1 : ZMod m)⁻¹) ^ 2 =
        (a : ZMod m) * lab xy ^ 2 + b := by
      rw [mul_assoc, ← mul_pow, hinv xy hxy, one_pow, mul_one]
    rw [he2, zero_mul] at he3
    rw [hbb]
    linear_combination -he3
  have hcard : S.card ≤ R.card := by
    apply Finset.card_le_card_of_injOn lab hlabR
    intro xy hxy xy' hxy' heLab
    obtain ⟨_, _, hx, hy, _, heq⟩ := mem_posSol.mp hxy
    obtain ⟨_, _, hx', hy', _, heq'⟩ := mem_posSol.mp hxy'
    let r := lab xy
    have hr : (a : ZMod m) * r ^ 2 = bb := (Finset.mem_filter.mp (hlabR xy hxy)).2
    have hradd : (a : ZMod m) * r ^ 2 + b = 0 := by rw [hr, hbb]; ring
    have ev : (xy.2 : ZMod m) = r * xy.1 := hlab xy hxy
    have ev' : (xy'.2 : ZMod m) = r * xy'.1 := by
      rw [hlab xy' hxy', ← heLab]
    have hP : (m : ℤ) ∣ (a : ℤ) * xy.2 * xy'.2 + (b : ℤ) * xy.1 * xy'.1 := by
      apply (ZMod.intCast_zmod_eq_zero_iff_dvd _ m).mp
      push_cast
      rw [ev, ev']
      calc
        _ = ((a : ZMod m) * r ^ 2 + b) * xy.1 * xy'.1 := by ring
        _ = 0 := by rw [hradd]; ring
    have hR : (m : ℤ) ∣ (xy.1 : ℤ) * xy'.2 - (xy.2 : ℤ) * xy'.1 := by
      apply (ZMod.intCast_zmod_eq_zero_iff_dvd _ m).mp
      push_cast
      rw [ev, ev']
      ring
    obtain ⟨hxE, hyE⟩ := positive_same_class_unique a b m xy'.1 xy'.2 xy.1 xy.2
      ha hb hm hx' hy' hx hy heq' heq hP hR
    exact Prod.ext hxE hyE
  exact hcard.trans (FormalAB.Sab87e3d4.A2InheritedPell.card_sqrt_le m a bb hcop')

private lemma posSol_swap_card (a b m Z : ℕ) :
    (posSol a b m Z).card = (posSol b a m Z).card := by
  apply Finset.card_nbij' Prod.swap Prod.swap
  · intro xy hxy
    obtain ⟨hxZ, hyZ, hx, hy, hg, heq⟩ := mem_posSol.mp hxy
    apply mem_posSol.mpr
    refine ⟨hyZ, hxZ, hy, hx, ?_, ?_⟩
    · simpa only [Prod.fst_swap, Prod.snd_swap, Nat.gcd_comm] using hg
    · simpa only [Prod.fst_swap, Prod.snd_swap, add_comm] using heq
  · intro xy hxy
    obtain ⟨hxZ, hyZ, hx, hy, hg, heq⟩ := mem_posSol.mp hxy
    apply mem_posSol.mpr
    refine ⟨hyZ, hxZ, hy, hx, ?_, ?_⟩
    · simpa only [Prod.fst_swap, Prod.snd_swap, Nat.gcd_comm] using hg
    · simpa only [Prod.fst_swap, Prod.snd_swap, add_comm] using heq
  · intro xy _; simp
  · intro xy _; simp

private lemma divide_first_card_le
    (a b m a' b' m' p Z : ℕ) (hp : 0 < p)
    (hdiv : ∀ xy ∈ posSol a b m Z, p ∣ xy.1)
    (htransport : ∀ x y : ℕ, a * y ^ 2 + b * (p * x) ^ 2 = m →
      a' * y ^ 2 + b' * x ^ 2 = m') :
    (posSol a b m Z).card ≤ (posSol a' b' m' Z).card := by
  classical
  apply Finset.card_le_card_of_injOn (fun xy => (xy.1 / p, xy.2))
  · intro xy hxy
    obtain ⟨hxZ, hyZ, hx, hy, hg, heq⟩ := mem_posSol.mp hxy
    obtain ⟨w, hw⟩ := hdiv xy hxy
    have hwd : xy.1 / p = w := by rw [hw]; exact Nat.mul_div_cancel_left _ hp
    have hwpos : 0 < w := by
      apply Nat.pos_of_ne_zero
      intro hw0
      rw [hw0, mul_zero] at hw
      omega
    have hwle : w ≤ xy.1 := by rw [hw]; exact Nat.le_mul_of_pos_left _ hp
    apply mem_posSol.mpr
    dsimp only
    rw [hwd]
    refine ⟨hwle.trans hxZ, hyZ, hwpos, hy, ?_, ?_⟩
    · exact Nat.Coprime.coprime_dvd_left ⟨p, by rw [hw]; ring⟩ hg
    · apply htransport w xy.2
      simpa only [← hw] using heq
  · intro xy hxy xy' hxy' he
    obtain ⟨hx, hy⟩ := Prod.mk.inj he
    have heX : xy.1 = xy'.1 := by
      rw [← Nat.div_mul_cancel (hdiv xy hxy),
        ← Nat.div_mul_cancel (hdiv xy' hxy'), hx]
    exact Prod.ext heX hy

private def PosCountBound (a b m : ℕ) : Prop :=
  ∀ Z : ℕ, (posSol a b m Z).card ≤ 2 * m.divisors.card

private lemma pos_reduce_a (N : ℕ)
    (IH : ∀ a b m : ℕ, m ≤ N → 0 < a → 0 < b →
      Nat.Coprime a b → 0 < m → PosCountBound a b m)
    (a b m : ℕ) (hN : m ≤ N + 1)
    (ha : 0 < a) (hb : 0 < b) (hab : Nat.Coprime a b) (hm : 0 < m)
    (p : ℕ) (hp : p.Prime) (hpa : p ∣ a) (hpm : p ∣ m) :
    PosCountBound a b m := by
  classical
  intro Z
  rcases (posSol a b m Z).eq_empty_or_nonempty with hSe | ⟨xy0, hxy0⟩
  · rw [hSe, Finset.card_empty]
    exact Nat.zero_le _
  have hpb : ¬ p ∣ b := by
    intro hpb
    have hd := Nat.dvd_gcd hpa hpb
    rw [hab] at hd
    exact hp.one_lt.ne' (Nat.dvd_one.mp hd)
  have hpx : ∀ xy ∈ posSol a b m Z, p ∣ xy.1 := by
    intro xy hxy
    obtain ⟨_, _, _, _, _, heq⟩ := mem_posSol.mp hxy
    have hs : p ∣ a * xy.2 ^ 2 + b * xy.1 ^ 2 := by rw [heq]; exact hpm
    have hay : p ∣ a * xy.2 ^ 2 := dvd_mul_of_dvd_left hpa _
    have hbx : p ∣ b * xy.1 ^ 2 := (Nat.dvd_add_right hay).mp hs
    rcases hp.dvd_mul.mp hbx with hpb' | hpx2
    · exact False.elim (hpb hpb')
    · exact hp.dvd_of_dvd_pow hpx2
  obtain ⟨a1, ha1⟩ := hpa
  have ha1pos : 0 < a1 := by
    apply Nat.pos_of_ne_zero
    intro h0
    rw [h0, mul_zero] at ha1
    omega
  have hp0 : 0 < p := hp.pos
  have hp2 : 2 ≤ p := hp.two_le
  obtain ⟨x1, hx1⟩ := hpx xy0 hxy0
  obtain ⟨_, _, hx0, hy0, _, heq0⟩ := mem_posSol.mp hxy0
  by_cases hpa1 : p ∣ a1
  · obtain ⟨a2, ha2⟩ := hpa1
    have ha2pos : 0 < a2 := by
      apply Nat.pos_of_ne_zero
      intro h0
      rw [h0, mul_zero] at ha2
      omega
    let m1 : ℕ := a2 * xy0.2 ^ 2 + b * x1 ^ 2
    have hm1pos : 0 < m1 := by dsimp only [m1]; positivity
    have hmf : m = p ^ 2 * m1 := by
      rw [← heq0, hx1, ha1, ha2]
      dsimp only [m1]
      ring
    have hm1N : m1 ≤ N := by
      have h4 : 4 * m1 ≤ p ^ 2 * m1 := by
        apply Nat.mul_le_mul_right
        nlinarith
      rw [← hmf] at h4
      omega
    have hcop' : Nat.Coprime a2 b :=
      Nat.Coprime.coprime_dvd_left ⟨p * p, by rw [ha1, ha2]; ring⟩ hab
    have hIH := IH a2 b m1 hm1N ha2pos hb hcop' hm1pos Z
    have hcard := divide_first_card_le a b m a2 b m1 p Z hp0 hpx (by
      intro x y heq
      have he : p ^ 2 * (a2 * y ^ 2 + b * x ^ 2) = p ^ 2 * m1 := by
        rw [← hmf, ← heq, ha1, ha2]
        ring
      exact mul_left_cancel₀ (pow_ne_zero 2 hp0.ne') he)
    have hdivM : m1 ∣ m := ⟨p ^ 2, by rw [hmf]; ring⟩
    have htau : m1.divisors.card ≤ m.divisors.card :=
      Finset.card_le_card (Nat.divisors_subset_of_dvd hm.ne' hdivM)
    exact hcard.trans (hIH.trans (Nat.mul_le_mul_left 2 htau))
  · let m1 : ℕ := a1 * xy0.2 ^ 2 + (b * p) * x1 ^ 2
    have hm1pos : 0 < m1 := by dsimp only [m1]; positivity
    have hmf : m = p * m1 := by
      rw [← heq0, hx1, ha1]
      dsimp only [m1]
      ring
    have hm1N : m1 ≤ N := by
      have h2 : 2 * m1 ≤ p * m1 := Nat.mul_le_mul_right _ hp2
      rw [← hmf] at h2
      omega
    have hcop' : Nat.Coprime a1 (b * p) := by
      apply Nat.Coprime.mul_right
      · exact Nat.Coprime.coprime_dvd_left ⟨p, by rw [ha1]; ring⟩ hab
      · exact Nat.Coprime.symm ((Nat.Prime.coprime_iff_not_dvd hp).mpr hpa1)
    have hIH := IH a1 (b * p) m1 hm1N ha1pos (by positivity) hcop' hm1pos Z
    have hcard := divide_first_card_le a b m a1 (b * p) m1 p Z hp0 hpx (by
      intro x y heq
      have he : p * (a1 * y ^ 2 + (b * p) * x ^ 2) = p * m1 := by
        rw [← hmf, ← heq, ha1]
        ring
      exact mul_left_cancel₀ hp0.ne' he)
    have hdivM : m1 ∣ m := ⟨p, by rw [hmf]; ring⟩
    have htau : m1.divisors.card ≤ m.divisors.card :=
      Finset.card_le_card (Nat.divisors_subset_of_dvd hm.ne' hdivM)
    exact hcard.trans (hIH.trans (Nat.mul_le_mul_left 2 htau))

private theorem pos_count_induction (N : ℕ) :
    ∀ a b m : ℕ, m ≤ N → 0 < a → 0 < b →
      Nat.Coprime a b → 0 < m → PosCountBound a b m := by
  induction N with
  | zero =>
      intro a b m hmN _ _ _ hm
      omega
  | succ N IH =>
      intro a b m hmN ha hb hab hm
      by_cases hcop : Nat.Coprime (a * b) m
      · exact pos_base_count a b m ha hb hm hcop
      · obtain ⟨p, hp, hpab, hpm⟩ := Nat.Prime.not_coprime_iff_dvd.mp hcop
        rcases hp.dvd_mul.mp hpab with hpa | hpb
        · exact pos_reduce_a N IH a b m hmN ha hb hab hm p hp hpa hpm
        · intro Z
          have hs := pos_reduce_a N IH b a m hmN hb ha hab.symm hm p hp hpb hpm Z
          rw [posSol_swap_card]
          exact hs

private theorem positive_primitive_count (a b m : ℕ)
    (ha : 0 < a) (hb : 0 < b) (hab : Nat.Coprime a b) (hm : 0 < m) :
    ∀ Z : ℕ, (posSol a b m Z).card ≤ 2 * m.divisors.card :=
  pos_count_induction m a b m le_rfl ha hb hab hm

private def signedNat (n : ℕ) (s : Bool) : ℤ :=
  if s then (n : ℤ) else -(n : ℤ)

private lemma signed_natAbs (X : ℤ) :
    signedNat X.natAbs (decide (0 ≤ X)) = X := by
  by_cases hx : 0 ≤ X
  · simp [signedNat, hx,  abs_of_nonneg hx]
  · have hx' : X ≤ 0 := by omega
    simp [signedNat, hx,  abs_of_nonpos hx']

private lemma natAbs_square (X : ℤ) : (X.natAbs : ℤ) ^ 2 = X ^ 2 := by
  rw [Int.natCast_natAbs, sq_abs]

private lemma norm_natAbs (D M : ℕ) (X Y : ℤ)
    (hnorm : X ^ 2 + (D : ℤ) * Y ^ 2 = M) :
    X.natAbs ^ 2 + D * Y.natAbs ^ 2 = M := by
  have he : (X.natAbs : ℤ) ^ 2 + (D : ℤ) * (Y.natAbs : ℤ) ^ 2 = M := by
    rw [natAbs_square, natAbs_square]
    exact hnorm
  exact_mod_cast he

private lemma norm_coordinate_bounds (D M : ℕ) (hD : 0 < D)
    (X Y : ℤ) (hnorm : X ^ 2 + (D : ℤ) * Y ^ 2 = M) :
    X.natAbs ≤ M ∧ Y.natAbs ≤ M := by
  have hn := norm_natAbs D M X Y hnorm
  have hXsq : X.natAbs ^ 2 ≤ M := by omega
  have hYsq : Y.natAbs ^ 2 ≤ M := by
    have hle : Y.natAbs ^ 2 ≤ D * Y.natAbs ^ 2 :=
      Nat.le_mul_of_pos_left _ hD
    omega
  have hsquare : ∀ n : ℕ, n ≤ n ^ 2 := by
    intro n
    by_cases hn : n = 0
    · simp [hn]
    · simpa only [pow_two] using Nat.le_mul_of_pos_left n (Nat.pos_of_ne_zero hn)
  exact ⟨(hsquare _).trans hXsq, (hsquare _).trans hYsq⟩

private noncomputable def normFinset (D M : ℕ) : Finset (ℤ × ℤ) :=
  ((Finset.Icc (-(M : ℤ)) M) ×ˢ (Finset.Icc (-(M : ℤ)) M)).filter
    (fun z => z.1 ^ 2 + (D : ℤ) * z.2 ^ 2 = M)

private lemma mem_normFinset (D M : ℕ) (hD : 0 < D) (z : ℤ × ℤ) :
    z ∈ normFinset D M ↔ z.1 ^ 2 + (D : ℤ) * z.2 ^ 2 = M := by
  constructor
  · intro hz
    exact (Finset.mem_filter.mp hz).2
  · intro hz
    obtain ⟨hX, hY⟩ := norm_coordinate_bounds D M hD z.1 z.2 hz
    have hX' : |z.1| ≤ (M : ℤ) := by
      rw [← Int.natCast_natAbs]
      exact_mod_cast hX
    have hY' : |z.2| ≤ (M : ℤ) := by
      rw [← Int.natCast_natAbs]
      exact_mod_cast hY
    exact Finset.mem_filter.mpr ⟨Finset.mem_product.mpr
      ⟨Finset.mem_Icc.mpr (abs_le.mp hX'), Finset.mem_Icc.mpr (abs_le.mp hY')⟩, hz⟩

private lemma axis_first_card (D M : ℕ) (hD : 0 < D)
    (S : Finset (ℤ × ℤ))
    (hS : ∀ z ∈ S, z.1 ^ 2 + (D : ℤ) * z.2 ^ 2 = M) :
    (S.filter (fun z => z.1 = 0)).card ≤ 2 := by
  classical
  let F := S.filter (fun z => z.1 = 0)
  rcases F.eq_empty_or_nonempty with hF | ⟨z0, hz0⟩
  · simpa only [F, hF, Finset.card_empty] using (Nat.zero_le 2)
  have hz0S := (Finset.mem_filter.mp hz0).1
  have hz0x := (Finset.mem_filter.mp hz0).2
  have hn0 : (D : ℤ) * z0.2 ^ 2 = M := by
    simpa only [hz0x, zero_pow (by decide : (2 : ℕ) ≠ 0), zero_add] using hS z0 hz0S
  have hsub : F ⊆ {(0, z0.2), (0, -z0.2)} := by
    intro z hz
    have hzS := (Finset.mem_filter.mp hz).1
    have hzx := (Finset.mem_filter.mp hz).2
    have hn : (D : ℤ) * z.2 ^ 2 = M := by
      simpa only [hzx, zero_pow (by decide : (2 : ℕ) ≠ 0), zero_add] using hS z hzS
    have hs : z.2 ^ 2 = z0.2 ^ 2 :=
      mul_left_cancel₀ (by exact_mod_cast hD.ne') (hn.trans hn0.symm)
    have hp : (z.2 - z0.2) * (z.2 + z0.2) = 0 := by nlinarith [hs]
    rcases mul_eq_zero.mp hp with hh | hh
    · apply Finset.mem_insert.mpr
      exact Or.inl (Prod.ext hzx (by omega))
    · apply Finset.mem_insert.mpr
      right
      apply Finset.mem_singleton.mpr
      exact Prod.ext hzx (by omega)
  calc
    F.card ≤ ({(0, z0.2), (0, -z0.2)} : Finset (ℤ × ℤ)).card :=
      Finset.card_le_card hsub
    _ ≤ 2 := by
      simpa only [Finset.card_singleton] using
        (Finset.card_insert_le (0, z0.2) ({(0, -z0.2)} : Finset (ℤ × ℤ)))

private lemma axis_second_card (D M : ℕ) (S : Finset (ℤ × ℤ))
    (hS : ∀ z ∈ S, z.1 ^ 2 + (D : ℤ) * z.2 ^ 2 = M) :
    (S.filter (fun z => z.2 = 0)).card ≤ 2 := by
  classical
  let F := S.filter (fun z => z.2 = 0)
  rcases F.eq_empty_or_nonempty with hF | ⟨z0, hz0⟩
  · simpa only [F, hF, Finset.card_empty] using (Nat.zero_le 2)
  have hz0S := (Finset.mem_filter.mp hz0).1
  have hz0y := (Finset.mem_filter.mp hz0).2
  have hn0 : z0.1 ^ 2 = (M : ℤ) := by
    simpa only [hz0y, zero_pow (by decide : (2 : ℕ) ≠ 0), mul_zero, add_zero] using hS z0 hz0S
  have hsub : F ⊆ {(z0.1, 0), (-z0.1, 0)} := by
    intro z hz
    have hzS := (Finset.mem_filter.mp hz).1
    have hzy := (Finset.mem_filter.mp hz).2
    have hn : z.1 ^ 2 = (M : ℤ) := by
      simpa only [hzy, zero_pow (by decide : (2 : ℕ) ≠ 0), mul_zero, add_zero] using hS z hzS
    have hs : z.1 ^ 2 = z0.1 ^ 2 := hn.trans hn0.symm
    have hp : (z.1 - z0.1) * (z.1 + z0.1) = 0 := by nlinarith [hs]
    rcases mul_eq_zero.mp hp with hh | hh
    · apply Finset.mem_insert.mpr
      exact Or.inl (Prod.ext (by omega) hzy)
    · apply Finset.mem_insert.mpr
      right
      apply Finset.mem_singleton.mpr
      exact Prod.ext (by omega) hzy
  calc
    F.card ≤ ({(z0.1, 0), (-z0.1, 0)} : Finset (ℤ × ℤ)).card :=
      Finset.card_le_card hsub
    _ ≤ 2 := by
      simpa only [Finset.card_singleton] using
        (Finset.card_insert_le (z0.1, 0) ({(-z0.1, 0)} : Finset (ℤ × ℤ)))

private theorem all_signed_definite_count (D M : ℕ) (hD : 0 < D) (hM : 0 < M) :
    let S : Set (ℤ × ℤ) := {z | z.1 ^ 2 + (D : ℤ) * z.2 ^ 2 = M}
    S.Finite ∧ S.ncard ≤ 12 * M.divisors.card ^ 2 := by
  classical
  let S := normFinset D M
  have hS : ∀ z ∈ S, z.1 ^ 2 + (D : ℤ) * z.2 ^ 2 = M :=
    fun z hz => (mem_normFinset D M hD z).mp hz
  have hSet : ({z : ℤ × ℤ | z.1 ^ 2 + (D : ℤ) * z.2 ^ 2 = M} : Set (ℤ × ℤ)) =
      (S : Set (ℤ × ℤ)) := by
    ext z
    exact (mem_normFinset D M hD z).symm
  change ({z : ℤ × ℤ | z.1 ^ 2 + (D : ℤ) * z.2 ^ 2 = M} : Set (ℤ × ℤ)).Finite ∧ _
  rw [hSet]
  refine ⟨S.finite_toSet, ?_⟩
  rw [Set.ncard_coe_finset]
  let B := S.filter (fun z => z.1 ≠ 0 ∧ z.2 ≠ 0)
  let J := M.divisors.filter (fun g => g ≠ 0 ∧ g ^ 2 ∣ M)
  let F : ℕ → Finset (ℤ × ℤ) := fun g =>
    (((Finset.univ : Finset (Bool × Bool)) ×ˢ posSol D 1 (M / g ^ 2) M).image
      (fun w => (signedNat (g * w.2.1) w.1.1, signedNat (g * w.2.2) w.1.2)))
  let T := J.biUnion F
  have hFcard : ∀ g ∈ J, (F g).card ≤ 8 * M.divisors.card := by
    intro g hg
    have hg' := (Finset.mem_filter.mp hg).2
    have hgpos : 0 < g := Nat.pos_of_ne_zero hg'.1
    have hg2pos : 0 < g ^ 2 := pow_pos hgpos 2
    have hmpos : 0 < M / g ^ 2 :=
      Nat.div_pos (Nat.le_of_dvd hM hg'.2) hg2pos
    have hmd : M / g ^ 2 ∣ M := ⟨g ^ 2,
      (Nat.mul_div_cancel' hg'.2).symm.trans (Nat.mul_comm _ _)⟩
    have htau : (M / g ^ 2).divisors.card ≤ M.divisors.card :=
      Finset.card_le_card (Nat.divisors_subset_of_dvd hM.ne' hmd)
    have hp := positive_primitive_count D 1 (M / g ^ 2) hD (by norm_num)
      (by simp) hmpos M
    calc
      (F g).card ≤ ((Finset.univ : Finset (Bool × Bool)) ×ˢ
          posSol D 1 (M / g ^ 2) M).card := Finset.card_image_le
      _ = 4 * (posSol D 1 (M / g ^ 2) M).card := by simp
      _ ≤ 4 * (2 * (M / g ^ 2).divisors.card) := Nat.mul_le_mul_left 4 hp
      _ ≤ 8 * M.divisors.card := by nlinarith
  have hTcard : T.card ≤ 8 * M.divisors.card ^ 2 := by
    calc
      T.card ≤ ∑ g ∈ J, (F g).card := Finset.card_biUnion_le
      _ ≤ ∑ _g ∈ J, 8 * M.divisors.card :=
        Finset.sum_le_sum hFcard
      _ = J.card * (8 * M.divisors.card) := by simp
      _ ≤ M.divisors.card * (8 * M.divisors.card) :=
        Nat.mul_le_mul_right _ (Finset.card_filter_le _ _)
      _ = _ := by ring
  have hBsub : B ⊆ T := by
    intro z hz
    have hzS := (Finset.mem_filter.mp hz).1
    obtain ⟨hXne, hYne⟩ := (Finset.mem_filter.mp hz).2
    have hnorm := hS z hzS
    obtain ⟨hXbound, hYbound⟩ := norm_coordinate_bounds D M hD z.1 z.2 hnorm
    let g := Nat.gcd z.1.natAbs z.2.natAbs
    let nx := z.1.natAbs / g
    let ny := z.2.natAbs / g
    have hxnat : g * nx = z.1.natAbs := by
      dsimp only [g, nx]
      rw [Nat.mul_comm]
      exact Nat.div_mul_cancel (Nat.gcd_dvd_left _ _)
    have hynat : g * ny = z.2.natAbs := by
      dsimp only [g, ny]
      rw [Nat.mul_comm]
      exact Nat.div_mul_cancel (Nat.gcd_dvd_right _ _)
    have hg : g ≠ 0 := by
      intro hg0
      have hx0 : z.1.natAbs = 0 := by rw [hg0, zero_mul] at hxnat; omega
      exact hXne (Int.natAbs_eq_zero.mp hx0)
    have hgpos : 0 < g := Nat.pos_of_ne_zero hg
    have hnx : 0 < nx := by
      apply Nat.pos_of_ne_zero
      intro hnx0
      have hx0 : z.1.natAbs = 0 := by rw [hnx0, mul_zero] at hxnat; omega
      exact hXne (Int.natAbs_eq_zero.mp hx0)
    have hny : 0 < ny := by
      apply Nat.pos_of_ne_zero
      intro hny0
      have hy0 : z.2.natAbs = 0 := by rw [hny0, mul_zero] at hynat; omega
      exact hYne (Int.natAbs_eq_zero.mp hy0)
    have hprim : Nat.Coprime nx ny :=
      Nat.coprime_div_gcd_div_gcd (m := z.1.natAbs) (n := z.2.natAbs) hgpos
    have hscale : M = g ^ 2 * (nx ^ 2 + D * ny ^ 2) := by
      calc
        M = z.1.natAbs ^ 2 + D * z.2.natAbs ^ 2 := (norm_natAbs D M z.1 z.2 hnorm).symm
        _ = (g * nx) ^ 2 + D * (g * ny) ^ 2 := by rw [hxnat, hynat]
        _ = _ := by ring
    have hg2 : g ^ 2 ∣ M := ⟨nx ^ 2 + D * ny ^ 2, hscale⟩
    have hgd : g ∣ M := (show g ∣ g ^ 2 from ⟨g, by ring⟩).trans hg2
    have hgj : g ∈ J := Finset.mem_filter.mpr
      ⟨Nat.mem_divisors.mpr ⟨hgd, hM.ne'⟩, hg, hg2⟩
    have hquot : M / g ^ 2 = nx ^ 2 + D * ny ^ 2 := by
      rw [hscale]
      exact Nat.mul_div_cancel_left _ (pow_pos hgpos 2)
    have hxy : (nx, ny) ∈ posSol D 1 (M / g ^ 2) M := by
      apply mem_posSol.mpr
      refine ⟨(Nat.div_le_self _ _).trans hXbound,
        (Nat.div_le_self _ _).trans hYbound, hnx, hny, hprim.gcd_eq_one, ?_⟩
      simpa only [Nat.one_mul, add_comm] using hquot.symm
    apply Finset.mem_biUnion.mpr
    refine ⟨g, hgj, ?_⟩
    apply Finset.mem_image.mpr
    refine ⟨((decide (0 ≤ z.1), decide (0 ≤ z.2)), (nx, ny)),
      Finset.mem_product.mpr ⟨Finset.mem_univ _, hxy⟩, ?_⟩
    apply Prod.ext
    · dsimp only
      rw [hxnat]
      exact signed_natAbs z.1
    · dsimp only
      rw [hynat]
      exact signed_natAbs z.2
  have hBcard : B.card ≤ 8 * M.divisors.card ^ 2 :=
    (Finset.card_le_card hBsub).trans hTcard
  have hFirst := axis_first_card D M hD S hS
  have hSecond := axis_second_card D M S hS
  have hsub : S ⊆ B ∪ ((S.filter (fun z => z.1 = 0)) ∪
      (S.filter (fun z => z.2 = 0))) := by
    intro z hz
    by_cases hx : z.1 = 0
    · exact Finset.mem_union.mpr (Or.inr (Finset.mem_union.mpr
        (Or.inl (Finset.mem_filter.mpr ⟨hz, hx⟩))))
    · by_cases hy : z.2 = 0
      · exact Finset.mem_union.mpr (Or.inr (Finset.mem_union.mpr
          (Or.inr (Finset.mem_filter.mpr ⟨hz, hy⟩))))
      · exact Finset.mem_union.mpr (Or.inl (Finset.mem_filter.mpr ⟨hz, hx, hy⟩))
  have hcard : S.card ≤ B.card +
      ((S.filter (fun z => z.1 = 0)).card + (S.filter (fun z => z.2 = 0)).card) := by
    calc
      S.card ≤ (B ∪ ((S.filter (fun z => z.1 = 0)) ∪
          (S.filter (fun z => z.2 = 0)))).card := Finset.card_le_card hsub
      _ ≤ B.card + ((S.filter (fun z => z.1 = 0)) ∪
          (S.filter (fun z => z.2 = 0))).card := Finset.card_union_le _ _
      _ ≤ _ := Nat.add_le_add_left (Finset.card_union_le _ _) _
  have htaupos : 0 < M.divisors.card :=
    Finset.card_pos.mpr ⟨M, Nat.mem_divisors.mpr ⟨dvd_rfl, hM.ne'⟩⟩
  nlinarith

private lemma natAbs_real (z : ℤ) : (z.natAbs : ℝ) = |(z : ℝ)| := by
  rw [← Int.cast_natCast, Int.natCast_natAbs, Int.cast_abs]

private theorem definite_norm_subpower (A L : ℝ) (hA : 1 ≤ A) (hL : 0 ≤ L)
    (epsilon : ℝ) (hepsilon : 0 < epsilon) :
    ∃ C : ℝ, 0 < C ∧ ∀ x : ℝ, 2 ≤ x →
      ∀ D M : ℕ, 0 < D → 0 < M → (M : ℝ) ≤ A*x^L →
      let S : Set (ℤ × ℤ) := {z | z.1^2+(D:ℤ)*z.2^2=M}
      S.Finite ∧ (S.ncard : ℝ) ≤ C*x^epsilon := by
  let delta : ℝ := epsilon/(2*L+1)
  have hden : 0 < 2*L+1 := by linarith
  have hd : 0 < delta := div_pos hepsilon hden
  have hdeq : delta*(2*L+1)=epsilon := div_mul_cancel₀ _ (ne_of_gt hden)
  have hexp : L*(2*delta) ≤ epsilon := by nlinarith
  obtain ⟨Cd,hCd,hdb⟩ :=
    JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C01.PcLowdegRed.divisor_bound delta hd
  let C : ℝ := 12*Cd^2*A^(2*delta)+1
  refine ⟨C, by dsimp [C]; positivity, ?_⟩
  intro x hx D M hD hM hMb
  let S : Set (ℤ × ℤ) := {z | z.1^2+(D:ℤ)*z.2^2=M}
  change S.Finite ∧ (S.ncard : ℝ) ≤ C*x^epsilon
  obtain ⟨hfin,hcard⟩ := all_signed_definite_count D M hD hM
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hA0 : 0 ≤ A := by linarith
  have hMtau : (M.divisors.card : ℝ) ≤ Cd*(M:ℝ)^delta := hdb M hM.ne'
  have hTau2 : (M.divisors.card : ℝ)^2 ≤ Cd^2*(M:ℝ)^(2*delta) := by
    calc
      (M.divisors.card : ℝ)^2 ≤ (Cd*(M:ℝ)^delta)^2 :=
        pow_le_pow_left₀ (Nat.cast_nonneg _) hMtau 2
      _ = Cd^2*(M:ℝ)^(2*delta) := by
        rw [mul_pow]
        congr 1
        rw [← Real.rpow_natCast, ← Real.rpow_mul (Nat.cast_nonneg M)]
        congr 1
        push_cast
        ring
  have hPower : (M:ℝ)^(2*delta) ≤ A^(2*delta)*x^epsilon := by
    calc
      (M:ℝ)^(2*delta) ≤ (A*x^L)^(2*delta) :=
        Real.rpow_le_rpow (Nat.cast_nonneg _) hMb (by positivity)
      _ = A^(2*delta)*x^(L*(2*delta)) := by
        rw [Real.mul_rpow hA0 (Real.rpow_nonneg hx0.le _), ← Real.rpow_mul hx0.le]
      _ ≤ A^(2*delta)*x^epsilon :=
        mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_le hx1 hexp)
          (Real.rpow_nonneg hA0 _)
  refine ⟨hfin, ?_⟩
  have hcardR : (S.ncard : ℝ) ≤ 12*(M.divisors.card : ℝ)^2 := by exact_mod_cast hcard
  calc
    (S.ncard : ℝ) ≤ 12*(M.divisors.card : ℝ)^2 := hcardR
    _ ≤ 12*(Cd^2*(M:ℝ)^(2*delta)) :=
      mul_le_mul_of_nonneg_left hTau2 (by norm_num)
    _ ≤ 12*(Cd^2*(A^(2*delta)*x^epsilon)) :=
      mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left hPower (sq_nonneg Cd)) (by norm_num)
    _ ≤ C*x^epsilon := by
      dsimp [C]
      nlinarith only [Real.rpow_nonneg hx0.le epsilon]

private theorem negative_quadratic_level_count (J : ℝ) (hJ : 0 ≤ J)
    (epsilon : ℝ) (hepsilon : 0 < epsilon) :
    ∃ C : ℝ, 0 < C ∧ ∀ x : ℝ, 2 ≤ x → ∀ A B C0 m : ℤ,
      A ≠ 0 → m ≠ 0 → B^2-4*A*C0 < 0 →
      |(A:ℝ)| ≤ x^J → |(B:ℝ)| ≤ x^J → |(C0:ℝ)| ≤ x^J → |(m:ℝ)| ≤ x^J →
      let S : Set (ℤ × ℤ) := {z |
        |(z.1:ℝ)| ≤ x^J ∧ |(z.2:ℝ)| ≤ x^J ∧
          A*z.1^2+B*z.1*z.2+C0*z.2^2=m}
      S.Finite ∧ (S.ncard:ℝ) ≤ C*x^epsilon := by
  classical
  obtain ⟨Cn,hCn,hnormcount⟩ :=
    definite_norm_subpower 4 (2*J) (by norm_num) (by positivity) epsilon hepsilon
  refine ⟨Cn,hCn,?_⟩
  intro x hx A B C0 m hA hm hDisc hAb hBb hCb hmb
  let H : ℝ := x^J
  let Delta : ℤ := B^2-4*A*C0
  let D : ℕ := (-Delta).toNat
  let N : ℤ := 4*A*m
  let M : ℕ := N.toNat
  let S : Set (ℤ × ℤ) := {z |
    |(z.1:ℝ)| ≤ H ∧ |(z.2:ℝ)| ≤ H ∧ A*z.1^2+B*z.1*z.2+C0*z.2^2=m}
  let phi : ℤ × ℤ → ℤ × ℤ := fun z => (2*A*z.1+B*z.2,z.2)
  change S.Finite ∧ (S.ncard:ℝ) ≤ Cn*x^epsilon
  have hx0 : 0 < x := by linarith
  have hH0 : 0 ≤ H := Real.rpow_nonneg hx0.le J
  have hDcast : (D:ℤ) = -Delta := Int.toNat_of_nonneg (by dsimp [Delta]; omega)
  have hD : 0 < D := by
    have ht : (0:ℤ) < (D:ℤ) := by rw [hDcast]; dsimp [Delta]; omega
    exact_mod_cast ht
  have hN : N ≠ 0 := mul_ne_zero (mul_ne_zero (by norm_num) hA) hm
  have hNorm : ∀ z ∈ S, (phi z).1^2+(D:ℤ)*(phi z).2^2=N := by
    intro z hz
    obtain ⟨_,_,hq⟩ := hz
    change (2*A*z.1+B*z.2)^2+(D:ℤ)*z.2^2=N
    rw [hDcast]
    dsimp [Delta,N]
    linear_combination 4*A*hq
  by_cases hS : S.Nonempty
  swap
  · have he : S = ∅ := Set.not_nonempty_iff_eq_empty.mp hS
    rw [he, Set.ncard_empty, Nat.cast_zero]
    exact ⟨Set.finite_empty, mul_nonneg hCn.le (Real.rpow_nonneg hx0.le _)⟩
  obtain ⟨z0,hz0⟩ := hS
  have hNnonneg : (0:ℤ) ≤ N := by
    rw [← hNorm z0 hz0]
    positivity
  have hNpos : (0:ℤ) < N := by omega
  have hMcast : (M:ℤ) = N := Int.toNat_of_nonneg hNpos.le
  have hM : 0 < M := by
    have ht : (0:ℤ) < (M:ℤ) := by rw [hMcast]; exact hNpos
    exact_mod_cast ht
  have hNbound : |(N:ℝ)| ≤ 4*H^2 := by
    dsimp [N]
    push_cast
    rw [abs_mul, abs_mul, show |(4:ℝ)|=4 by norm_num]
    have ht := mul_le_mul hAb hmb (abs_nonneg (m:ℝ)) hH0
    nlinarith only [ht]
  have hMbound : (M:ℝ) ≤ 4*x^(2*J) := by
    have hcast : (M:ℝ) = (N:ℝ) := by exact_mod_cast hMcast
    rw [hcast]
    calc
      (N:ℝ) ≤ |(N:ℝ)| := le_abs_self _
      _ ≤ 4*H^2 := hNbound
      _ = 4*x^(2*J) := by
        dsimp [H]
        rw [← Real.rpow_natCast, ← Real.rpow_mul hx0.le]
        congr 2
        push_cast
        ring
  obtain ⟨hNormfin,hNormcard⟩ := hnormcount x hx D M hD hM hMbound
  let T : Set (ℤ × ℤ) := {z | z.1^2+(D:ℤ)*z.2^2=M}
  have hinj : Function.Injective phi := by
    intro z z' hp
    have he : z.2 = z'.2 := by
      have ht := congrArg (fun w : ℤ × ℤ => w.2) hp
      change z.2 = z'.2 at ht
      exact ht
    have hd : 2*A*z.1 = 2*A*z'.1 := by
      have ht := congrArg Prod.fst hp
