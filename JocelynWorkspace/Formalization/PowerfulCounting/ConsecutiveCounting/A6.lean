private def embedBinary {R:Type*} [CommRing R]:
    MvPolynomial (Fin 2) R →+* MvPolynomial (Fin 4) R:=
  (MvPolynomial.rename (fun i:Fin 2 => if i = 0 then (0:Fin 4) else 1)).toRingHom
private def cubicGraph {R:Type*} [CommRing R]
    (P Q:MvPolynomial (Fin 2) R):MvPolynomial (Fin 4) R:=
  embedBinary P * X 2 - embedBinary Q * X 3
private theorem graph_isRelPrime
 {K:Type*} [Field K] (P Q:MvPolynomial (Fin 2) K)
 (hG:Irreducible (cubicGraph P Q)):IsRelPrime P Q:=by
  intro D hDP hDQ
  obtain ⟨iU,hU⟩:= hDP
  obtain ⟨V,hV⟩:= hDQ
  have hfac:cubicGraph P Q =
      embedBinary D * (embedBinary iU * X 2 - embedBinary V * X 3):=by
    dsimp only [cubicGraph]
    rw [hU,hV,map_mul,map_mul]
    ring
  rcases hG.isUnit_or_isUnit hfac with hD | hUV
  · let r:Fin 4 → Fin 2:= fun i => if i = 0 then 0 else 1
    have hret:(fun i:Fin 2 =>
        r (if i = 0 then (0:Fin 4) else 1)) = id:=by
      funext i
      fin_cases i <;> simp [r]
    have hD':= hD.map (MvPolynomial.rename r)
    change IsUnit (MvPolynomial.rename r
      (MvPolynomial.rename (fun i:Fin 2=>if i=0 then (0:Fin 4) else 1) D)) at hD'
    rw [MvPolynomial.rename_rename] at hD'
    change IsUnit (MvPolynomial.rename
      (fun i:Fin 2=>r (if i=0 then (0:Fin 4) else 1)) D) at hD'
    simpa [hret,MvPolynomial.rename_id] using hD'
  · let ev:MvPolynomial (Fin 4) K →+* K:=
      MvPolynomial.eval₂Hom (RingHom.id K) (fun _ => 0)
    have hz:IsUnit (0:K):=by
      simpa [ev] using hUV.map ev
    exact False.elim (hz.ne_zero rfl)
private def biIndex (i j:ℕ):Fin 2 →₀ ℕ:=
  Finsupp.single 0 i+Finsupp.single 1 j
private def quadIndex (i j k l:ℕ):Fin 4 →₀ ℕ:=
  Finsupp.single 0 i+Finsupp.single 1 j+Finsupp.single 2 k+Finsupp.single 3 l
private theorem biIndex_injective (i j i' j':ℕ):
 biIndex i j = biIndex i' j' ↔ i = i' ∧ j = j':=by
  constructor
  · intro h
    have h₀:= congrArg (fun m:Fin 2 →₀ ℕ=>m 0) h
    have h₁:= congrArg (fun m:Fin 2 →₀ ℕ=>m 1) h
    simpa [biIndex] using And.intro h₀ h₁
  · rintro ⟨rfl,rfl⟩
    rfl
private theorem quadIndex_injective (i j k l i' j' k' l':ℕ):
 quadIndex i j k l = quadIndex i' j' k' l' ↔
 i = i' ∧ j = j' ∧ k = k' ∧ l = l':=by
  constructor
  · intro h
    have h₀:= congrArg (fun m:Fin 4 →₀ ℕ=>m 0) h
    have h₁:= congrArg (fun m:Fin 4 →₀ ℕ=>m 1) h
    have h₂:= congrArg (fun m:Fin 4 →₀ ℕ=>m 2) h
    have h₃:= congrArg (fun m:Fin 4 →₀ ℕ=>m 3) h
    simpa [quadIndex] using And.intro h₀ (And.intro h₁ (And.intro h₂ h₃))
  · rintro ⟨rfl,rfl,rfl,rfl⟩
    rfl
private theorem binary_monomial {R:Type*} [CommRing R]
 (r:R) (i j:ℕ):
 monomial (biIndex i j) r = C r*(X (0:Fin 2))^i*(X 1)^j:=by
  calc
    _ = monomial (Finsupp.single (0:Fin 2) i) r *
        monomial (Finsupp.single (1:Fin 2) j) (1:R):=by
      rw [MvPolynomial.monomial_mul]
      simp [biIndex]
    _ = _:=by
      rw [←MvPolynomial.C_mul_X_pow_eq_monomial,←MvPolynomial.C_mul_X_pow_eq_monomial]
      simp [mul_assoc]
private theorem quad_monomial {R:Type*} [CommRing R]
 (r:R) (i j k l:ℕ):
 monomial (quadIndex i j k l) r =
 C r*(X (0:Fin 4))^i*(X 1)^j*(X 2)^k*(X 3)^l:=by
  calc
    _ = monomial (Finsupp.single (0:Fin 4) i) r *
        monomial (Finsupp.single (1:Fin 4) j) (1:R) *
        monomial (Finsupp.single (2:Fin 4) k) (1:R) *
        monomial (Finsupp.single (3:Fin 4) l) (1:R):=by
      rw [MvPolynomial.monomial_mul,MvPolynomial.monomial_mul,MvPolynomial.monomial_mul]
      simp [quadIndex]
    _ = _:=by
      rw [←MvPolynomial.C_mul_X_pow_eq_monomial,←MvPolynomial.C_mul_X_pow_eq_monomial,
        ←MvPolynomial.C_mul_X_pow_eq_monomial,←MvPolynomial.C_mul_X_pow_eq_monomial]
      simp [mul_assoc]

private def binaryCubic {R:Type*} [CommRing R] (p₀ p₁ p₂ p₃:R):
    MvPolynomial (Fin 2) R :=
  monomial (biIndex 3 0) p₀ + monomial (biIndex 2 1) p₁ +
    monomial (biIndex 1 2) p₂ + monomial (biIndex 0 3) p₃

private theorem cubic_homogeneous {R:Type*} [CommRing R] (p₀ p₁ p₂ p₃:R):
    (binaryCubic p₀ p₁ p₂ p₃).IsHomogeneous 3 := by
  have hx₀:(X (0:Fin 2):MvPolynomial (Fin 2) R).IsHomogeneous 1 :=
    MvPolynomial.isHomogeneous_X R _
  have hx₁:(X (1:Fin 2):MvPolynomial (Fin 2) R).IsHomogeneous 1 :=
    MvPolynomial.isHomogeneous_X R _
  have hc (r:R):(C r:MvPolynomial (Fin 2) R).IsHomogeneous 0 :=
    MvPolynomial.isHomogeneous_C (Fin 2) r
  have h₀:(C p₀*(X (0:Fin 2))^3:MvPolynomial (Fin 2) R).IsHomogeneous 3 := by
    simpa using (hc p₀).mul (hx₀.pow 3)
  have h₁:(C p₁*(X (0:Fin 2))^2*X 1:MvPolynomial (Fin 2) R).IsHomogeneous 3 := by
    simpa using ((hc p₁).mul (hx₀.pow 2)).mul hx₁
  have h₂:(C p₂*X (0:Fin 2)*(X 1)^2:MvPolynomial (Fin 2) R).IsHomogeneous 3 := by
    simpa using ((hc p₂).mul hx₀).mul (hx₁.pow 2)
  have h₃:(C p₃*(X (1:Fin 2))^3:MvPolynomial (Fin 2) R).IsHomogeneous 3 := by
    simpa using (hc p₃).mul (hx₁.pow 3)
  simpa only [binaryCubic,binary_monomial,pow_zero,pow_one,mul_one] using
    ((h₀.add h₁).add h₂).add h₃

private theorem cubic_coeff_bound (p₀ p₁ p₂ p₃:ℤ) (H:ℝ)
    (hH:0≤H) (h₀:|(p₀:ℝ)|≤H) (h₁:|(p₁:ℝ)|≤H)
    (h₂:|(p₂:ℝ)|≤H) (h₃:|(p₃:ℝ)|≤H):
    ∀t:Fin 2→₀ℕ, |(((binaryCubic p₀ p₁ p₂ p₃).coeff t:ℤ):ℝ)|≤H := by
  intro t
  by_cases h0:biIndex 3 0=t
  · subst t
    simpa [binaryCubic,MvPolynomial.coeff_monomial,biIndex_injective] using h₀
  by_cases h1:biIndex 2 1=t
  · subst t
    simpa [binaryCubic,MvPolynomial.coeff_monomial,biIndex_injective] using h₁
  by_cases h2:biIndex 1 2=t
  · subst t
    simpa [binaryCubic,MvPolynomial.coeff_monomial,biIndex_injective] using h₂
  by_cases h3:biIndex 0 3=t
  · subst t
    simpa [binaryCubic,MvPolynomial.coeff_monomial,biIndex_injective] using h₃
  simpa [binaryCubic,MvPolynomial.coeff_monomial,h0,h1,h2,h3] using hH

private theorem cubic_support_eight (m:Fin 4→₀ℕ)
    (hm:m 0+m 1=3) (hm':m 2+m 3=1):
    m=quadIndex 3 0 1 0 ∨ m=quadIndex 2 1 1 0 ∨ m=quadIndex 1 2 1 0 ∨
    m=quadIndex 0 3 1 0 ∨ m=quadIndex 3 0 0 1 ∨ m=quadIndex 2 1 0 1 ∨
    m=quadIndex 1 2 0 1 ∨ m=quadIndex 0 3 0 1 := by
  have hext (i j k l:ℕ) (h0:m 0=i) (h1:m 1=j) (h2:m 2=k) (h3:m 3=l):
      m=quadIndex i j k l := by
    ext r
    fin_cases r <;> simp [quadIndex,h0,h1,h2,h3]
  have h0:m 0=0 ∨ m 0=1 ∨ m 0=2 ∨ m 0=3 := by omega
  have h2:m 2=0 ∨ m 2=1 := by omega
  rcases h2 with h2|h2
  · rcases h0 with h0|h0|h0|h0
    · have h1:m 1=3 := by omega
      have h3:m 3=1 := by omega
      exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (hext 0 3 0 1 h0 h1 h2 h3)))))))
    · have h1:m 1=2 := by omega
      have h3:m 3=1 := by omega
      exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl (hext 1 2 0 1 h0 h1 h2 h3)))))))
    · have h1:m 1=1 := by omega
      have h3:m 3=1 := by omega
      exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl (hext 2 1 0 1 h0 h1 h2 h3))))))
    · have h1:m 1=0 := by omega
      have h3:m 3=1 := by omega
      exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl (hext 3 0 0 1 h0 h1 h2 h3)))))
  · rcases h0 with h0|h0|h0|h0
    · have h1:m 1=3 := by omega
      have h3:m 3=0 := by omega
      exact Or.inr (Or.inr (Or.inr (Or.inl (hext 0 3 1 0 h0 h1 h2 h3))))
    · have h1:m 1=2 := by omega
      have h3:m 3=0 := by omega
      exact Or.inr (Or.inr (Or.inl (hext 1 2 1 0 h0 h1 h2 h3)))
    · have h1:m 1=1 := by omega
      have h3:m 3=0 := by omega
      exact Or.inr (Or.inl (hext 2 1 1 0 h0 h1 h2 h3))
    · have h1:m 1=0 := by omega
      have h3:m 3=0 := by omega
      exact Or.inl (hext 3 0 1 0 h0 h1 h2 h3)

private theorem cubic_graph_expand (p₀ p₁ p₂ p₃ q₀ q₁ q₂ q₃:ℤ):
    cubicGraph (binaryCubic p₀ p₁ p₂ p₃) (binaryCubic (-q₀) (-q₁) (-q₂) (-q₃)) =
    monomial (quadIndex 3 0 1 0) p₀ + monomial (quadIndex 2 1 1 0) p₁ +
    monomial (quadIndex 1 2 1 0) p₂ + monomial (quadIndex 0 3 1 0) p₃ +
    monomial (quadIndex 3 0 0 1) q₀ + monomial (quadIndex 2 1 0 1) q₁ +
    monomial (quadIndex 1 2 0 1) q₂ + monomial (quadIndex 0 3 0 1) q₃ := by
  simp only [cubicGraph,embedBinary,binaryCubic,binary_monomial,quad_monomial,map_add,map_mul,map_pow,
    pow_zero,pow_one,mul_one,map_neg]
  norm_num
  ring

private def cubicP (G : MvPolynomial (Fin 4) ℤ) : MvPolynomial (Fin 2) ℤ :=
  binaryCubic (G.coeff (quadIndex 3 0 1 0)) (G.coeff (quadIndex 2 1 1 0))
    (G.coeff (quadIndex 1 2 1 0)) (G.coeff (quadIndex 0 3 1 0))

private def cubicQ (G : MvPolynomial (Fin 4) ℤ) : MvPolynomial (Fin 2) ℤ :=
  binaryCubic (-G.coeff (quadIndex 3 0 0 1)) (-G.coeff (quadIndex 2 1 0 1))
    (-G.coeff (quadIndex 1 2 0 1)) (-G.coeff (quadIndex 0 3 0 1))

private theorem canonical_cubic_data (G : MvPolynomial (Fin 4) ℤ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = 3 ∧ m 2 + m 3 = 1) :
    G = cubicGraph (cubicP G) (cubicQ G) ∧
    (cubicP G).IsHomogeneous 3 ∧ (cubicQ G).IsHomogeneous 3 ∧
    ∀ H : ℝ, 0 ≤ H →
      (∀ m : Fin 4 →₀ ℕ, |((G.coeff m : ℤ) : ℝ)| ≤ H) →
      ∀ t : Fin 2 →₀ ℕ, |(((cubicP G).coeff t : ℤ) : ℝ)| ≤ H ∧
        |(((cubicQ G).coeff t : ℤ) : ℝ)| ≤ H := by
  have heq : G = cubicGraph (cubicP G) (cubicQ G) := by
    dsimp only [cubicP, cubicQ]
    rw [cubic_graph_expand]
    ext m
    by_cases hm : m ∈ G.support
    · obtain ⟨hm₁, hm₂⟩ := hG m hm
      rcases cubic_support_eight m hm₁ hm₂ with h | h | h | h | h | h | h | h <;>
        subst m <;> simp [MvPolynomial.coeff_monomial, quadIndex_injective]
    · have hz : G.coeff m = 0 := by
        by_contra hn
        exact hm (MvPolynomial.mem_support_iff.mpr hn)
      have hterm (i j k l : ℕ) :
          (if quadIndex i j k l = m then G.coeff (quadIndex i j k l) else 0) = 0 := by
        split_ifs with h
        · simpa only [h] using hz
        · rfl
      simp only [MvPolynomial.coeff_add, MvPolynomial.coeff_monomial, hterm, hz, add_zero]
  refine ⟨heq, cubic_homogeneous _ _ _ _, cubic_homogeneous _ _ _ _, ?_⟩
  intro H hH hh t
  constructor
  · exact cubic_coeff_bound _ _ _ _ H hH (hh _) (hh _) (hh _) (hh _) t
  · apply cubic_coeff_bound _ _ _ _ H hH
    · simpa using hh (quadIndex 3 0 0 1)
    · simpa using hh (quadIndex 2 1 0 1)
    · simpa using hh (quadIndex 1 2 0 1)
    · simpa using hh (quadIndex 0 3 0 1)

private theorem canonical_cubic_complex_relPrime
    (G : MvPolynomial (Fin 4) ℤ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = 3 ∧ m 2 + m 3 = 1)
    (hirred : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G)) :
    IsRelPrime (MvPolynomial.map (Int.castRingHom ℂ) (cubicP G))
      (MvPolynomial.map (Int.castRingHom ℂ) (cubicQ G)) := by
  have heq := (canonical_cubic_data G hG).1
  apply graph_isRelPrime
  have hmap : MvPolynomial.map (Int.castRingHom ℂ)
      (cubicGraph (cubicP G) (cubicQ G)) =
      cubicGraph (MvPolynomial.map (Int.castRingHom ℂ) (cubicP G))
        (MvPolynomial.map (Int.castRingHom ℂ) (cubicQ G)) := by
    simp [cubicGraph, embedBinary, MvPolynomial.map_rename]
  rw [← hmap, ← heq]
  exact hirred

private theorem canonical_cubic_no_common
    (G : MvPolynomial (Fin 4) ℤ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = 3 ∧ m 2 + m 3 = 1)
    (hirred : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G)) :
    ∀ w : Fin 2 → ℂ, w ≠ 0 →
      eval w (MvPolynomial.map (Int.castRingHom ℂ) (cubicP G)) = 0 →
      eval w (MvPolynomial.map (Int.castRingHom ℂ) (cubicQ G)) = 0 → False := by
  obtain ⟨heq, hP, hQ, hheight⟩ := canonical_cubic_data G hG
  intro w hw hp hq
  exact C01.PcCurves.no_common_zero
    (hP.map (Int.castRingHom ℂ)) (hQ.map (Int.castRingHom ℂ))
    (canonical_cubic_complex_relPrime G hG hirred) hw hp hq

private theorem canonical_cubic_graph_eval (G : MvPolynomial (Fin 4) ℤ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = 3 ∧ m 2 + m 3 = 1)
    (d e u v : ℤ) (hz : eval ![d, e, u, v] G = 0) :
    eval ![d, e] (cubicP G) * u = eval ![d, e] (cubicQ G) * v := by
  rw [(canonical_cubic_data G hG).1] at hz
  have hemb (T : MvPolynomial (Fin 2) ℤ) :
      eval ![d, e, u, v] (embedBinary T) = eval ![d, e] T := by
    have hvars : (![d, e, u, v] ∘
        (fun i : Fin 2 => if i = 0 then (0 : Fin 4) else 1)) = ![d, e] := by
      funext i
      fin_cases i <;> rfl
    rw [show embedBinary T =
      MvPolynomial.rename (fun i : Fin 2 => if i = 0 then (0 : Fin 4) else 1) T from rfl,
      MvPolynomial.eval_rename, hvars]
  simp only [cubicGraph, map_sub, map_mul, MvPolynomial.eval_X, hemb] at hz
  change eval ![d, e] (cubicP G) * u - eval ![d, e] (cubicQ G) * v = 0 at hz
  linear_combination hz

private def sexticResidual (G : MvPolynomial (Fin 4) ℤ) : MvPolynomial (Fin 2) ℤ :=
  X 1 ^ 3 * cubicP G - X 0 ^ 3 * cubicQ G

private def canonicalResidual (G : MvPolynomial (Fin 4) ℤ) (r s : ℚ) : ℚ :=
  s ^ 3 * (∑ i : Fin 4,
    ((G.coeff (quadIndex (i : ℕ) (3 - (i : ℕ)) 1 0) : ℤ) : ℚ) *
      r ^ (i : ℕ) * s ^ (3 - (i : ℕ))) +
  r ^ 3 * (∑ i : Fin 4,
    ((G.coeff (quadIndex (i : ℕ) (3 - (i : ℕ)) 0 1) : ℤ) : ℚ) *
      r ^ (i : ℕ) * s ^ (3 - (i : ℕ)))

private lemma canonical_residual_eval (G : MvPolynomial (Fin 4) ℤ) (r s : ℚ) :
