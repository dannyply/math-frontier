    ⟨(R.filter (fun r => r ≤ (t : ℝ))).card,
      by have hh := Finset.card_filter_le R (fun r => r ≤ (t : ℝ)); omega⟩
  have hpair : ∀ s ∈ T, ∀ t ∈ T, color s = color t →
      s ≤ t → ((t-s : ℤ) : ℝ) ≤ X/B := by
    intro s hs t ht hcolor hst
    by_cases heq : s = t
    · subst t
      simp only [sub_self,Int.cast_zero]
      positivity
    have hstR : (s : ℝ) < (t : ℝ) := by
      exact_mod_cast lt_of_le_of_ne hst heq
    have hrank : (R.filter (fun r => r ≤ (s : ℝ))).card =
        (R.filter (fun r => r ≤ (t : ℝ))).card :=
      congrArg Fin.val hcolor
    have hv : ∀ z : ℝ, (s : ℝ) ≤ z → z ≤ (t : ℝ) →
        0 ≤ N.eval z ∧ N.eval z ≤ X := by
      intro z hsz hzt
      have h₁ := nonneg_on_equal_rank_interval N R s t hstR
        hroots₁ hrank (hvals s hs).1 (hvals t ht).1 z ⟨hsz,hzt⟩
      have h₂ := nonneg_on_equal_rank_interval (C X-N) R s t hstR
        hroots₂ hrank
        (by simpa only [eval_sub,eval_C] using sub_nonneg.mpr (hvals s hs).2)
        (by simpa only [eval_sub,eval_C] using sub_nonneg.mpr (hvals t ht).2)
        z ⟨hsz,hzt⟩
      exact ⟨h₁, by simpa only [eval_sub,eval_C,sub_nonneg] using h₂⟩
    have hb := derivative_length_bound N s t X B hstR hv (by
      intro z hsz hzt
      exact hder z (hsegment s hs t ht z hsz.le hzt.le)
        (hv z hsz.le hzt.le).1 (hv z hsz.le hzt.le).2)
    apply (le_div_iff₀ hB).mpr
    push_cast
    exact hb
  have hc := finite_colored_integer_diameter_count_generic
    (Fin (R.card+1)) T color (X/B) (by positivity) hpair
  have hcR : (T.card : ℝ) ≤ (R.card+1 : ℕ) *
      (2 * (Nat.ceil (X/B) : ℝ) + 1) := by
    exact_mod_cast (by simpa using hc)
  have hR : (R.card+1 : ℕ) ≤ 2*d+1 := by omega
  exact hcR.trans (mul_le_mul_of_nonneg_right (by exact_mod_cast hR) (by positivity))

