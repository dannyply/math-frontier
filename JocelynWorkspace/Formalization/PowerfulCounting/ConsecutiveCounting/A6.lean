    N.det = N.transpose.det := (Matrix.det_transpose N).symm
    _ = (∏ z : Rect A B, k z) * M.det := by
      rw [hN, Matrix.det_mul_column, Matrix.det_transpose]
    _ = _ := by rw [hk]

