    (((h₀.add h₁).add h₂).add h₃).add h₄
private theorem bY
 (p₀ p₁ p₂ p₃ p₄:I) (H:O)
 (hH:0 ≤ H) (h₀:|(p₀:O)| ≤ H) (h₁:|(p₁:O)| ≤ H)
 (h₂:|(p₂:O)| ≤ H) (h₃:|(p₃:O)| ≤ H) (h₄:|(p₄:O)| ≤ H):
 ∀t:Fin 2 →₀ U,
 |(((bW p₀ p₁ p₂ p₃ p₄).coeff t:I):O)| ≤ H:=by
  intro t
  by_cases h0:bIndex 4 0 = t
  · subst t
    simpa [bW,av,bS] using h₀
  by_cases h1:bIndex 3 1 = t
  · subst t
    simpa [bW,av,bS] using h₁
  by_cases h2:bIndex 2 2 = t
  · subst t
    simpa [bW,av,bS] using h₂
  by_cases h3:bIndex 1 3 = t
  · subst t
    simpa [bW,av,bS] using h₃
  by_cases h4:bIndex 0 4 = t
  · subst t
    simpa [bW,av,bS] using h₄
  simpa [bW,av,h0,h1,h2,h3,h4] using hH
private theorem bZ (m:Fin 4 →₀ U)
 (hm:m 0+m 1 = 4) (hm':m 2+m 3 = 1):
 m = qIndex 4 0 1 0 ∨ m = qIndex 3 1 1 0 ∨ m = qIndex 2 2 1 0 ∨
 m = qIndex 1 3 1 0 ∨ m = qIndex 0 4 1 0 ∨
 m = qIndex 4 0 0 1 ∨ m = qIndex 3 1 0 1 ∨ m = qIndex 2 2 0 1 ∨
 m = qIndex 1 3 0 1 ∨ m = qIndex 0 4 0 1:=by
  have hext (i j k l:U) (h0:m 0=i) (h1:m 1=j) (h2:m 2=k) (h3:m 3=l):
      m=qIndex i j k l:=by
    ext r
    fin_cases r <;> simp [qIndex,h0,h1,h2,h3]
  have h0:m 0=0 ∨ m 0=1 ∨ m 0=2 ∨ m 0=3 ∨ m 0=4:=by omega
  have h2:m 2=0 ∨ m 2=1:=by omega
  rcases h2 with h2|h2
  · rcases h0 with h0|h0|h0|h0|h0
    · have h1:m 1=4:=by omega
      have h3:m 3=1:=by omega
      exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (hext 0 4 0 1 h0 h1 h2 h3)))))))))
    · have h1:m 1=3:=by omega
      have h3:m 3=1:=by omega
      exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl (hext 1 3 0 1 h0 h1 h2 h3)))))))))
    · have h1:m 1=2:=by omega
      have h3:m 3=1:=by omega
