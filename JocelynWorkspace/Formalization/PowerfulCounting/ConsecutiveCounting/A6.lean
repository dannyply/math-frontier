    · simpa only [bG] using hdF
    · simpa only [bG] using hdG
  · intro r hdF hdG
    obtain ⟨b,hb,t,ht⟩:= hSv r hdF hdG
    refine ⟨step b,Finset.mem_image.mpr ⟨b,hb,rfl⟩,t,?_⟩
    simpa [step] using ht
private theorem dH (T:U) (hT:T ≠ 0)
 (F G:ae) (hF:F.natDegree ≤ 4) (hG:G.natDegree ≤ 4):
 ∃ S:Finset (I × U),S.card ≤ 8 ^ T.primeFactors.card ∧
 (∀ s ∈ S,0 < s.2 ∧
 C (T:I) ∣ F.comp (dA s) ∧
 C (T:I) ∣ G.comp (dA s)) ∧
 (∀ r:I,(T:I) ∣ F.eval r → (T:I) ∣ G.eval r →
 ∃ s ∈ S,dB s r):=by
  have hLocal (p:U) (hp:p ∈ T.primeFactors):
      ∃ A:Finset (I × U),A.card ≤ 8 ∧
        (∀ s ∈ A,0 < s.2 ∧
          C ((p:I) ^ T.factorization p) ∣ F.comp (dA s) ∧
          C ((p:I) ^ T.factorization p) ∣ G.comp (dA s)) ∧
        (∀ r:I,(p:I) ^ T.factorization p ∣ F.eval r →
          (p:I) ^ T.factorization p ∣ G.eval r →
          ∃ s ∈ A,dB s r):=by
    let:Fact p.Prime:= ⟨(Nat.mem_primeFactors.mp hp).1⟩
    exact dG p _ F G hF hG
  obtain ⟨S,hSc,hSg,hSv⟩:=
    dF T.factorization F G T.primeFactors hLocal
  refine ⟨S,hSc,?_,?_⟩
  · intro s hs
    refine ⟨(hSg s hs).1,?_,?_⟩
    · apply (ax _ _).mpr
      intro k
      apply dE T hT
      intro p hp
      exact (ax _ _).mp ((hSg s hs).2 p hp).1 k
    · apply (ax _ _).mpr
      intro k
      apply dE T hT
      intro p hp
      exact (ax _ _).mp ((hSg s hs).2 p hp).2 k
