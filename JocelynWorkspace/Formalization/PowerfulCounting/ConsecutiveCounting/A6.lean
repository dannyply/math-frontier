private theorem twoSupportProduct7 {M : Type*} [CommMonoid M] (s : Multiset (Option ℚ)) (a b : Option ℚ) (hcard : s.card = 7)
    (ha : a ∈ s) (hb : b ∈ s) (hne : a ≠ b)
