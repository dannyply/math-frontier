    simp only [V,Finset.card_map,Finset.card_attach]
  have hJR:0 < (J:O):=by exact_mod_cast hJ
  have hd:∀ a ∈ V,∀ b ∈ V,|(a:O) - (b:O)| ≤ L / (J:O):=by
    intro a ha b hb
