private theorem ca
 (p₀ p₁ p₂ p₃ p₄ q₀ q₁ q₂ q₃ q₄:I):
 bO (bW p₀ p₁ p₂ p₃ p₄)
 (bW (-q₀) (-q₁) (-q₂) (-q₃) (-q₄)) =
 monomial (qIndex 4 0 1 0) p₀+monomial (qIndex 3 1 1 0) p₁+
 monomial (qIndex 2 2 1 0) p₂+monomial (qIndex 1 3 1 0) p₃+
 monomial (qIndex 0 4 1 0) p₄+
 monomial (qIndex 4 0 0 1) q₀+monomial (qIndex 3 1 0 1) q₁+
 monomial (qIndex 2 2 0 1) q₂+monomial (qIndex 1 3 0 1) q₃+
 monomial (qIndex 0 4 0 1) q₄:=by
  simp only [bO,bN,bW,bU,bV,
    map_add,map_mul,map_pow,
    pow_zero,pow_one,mul_one,map_neg]
  norm_num
  ring
private theorem cb
 (G:aa)
 (hG:∀m ∈ G.support,m 0+m 1 = 4 ∧ m 2+m 3 = 1):
 ∃P Q:ab,
 G = bO P Q ∧ P.IsHomogeneous 4 ∧ Q.IsHomogeneous 4 ∧
 ∀H:O,0 ≤ H → (∀m:Fin 4 →₀ U,|((G.coeff m:I):O)| ≤ H) →
 (∀t:Fin 2 →₀ U,|((P.coeff t:I):O)| ≤ H ∧ |((Q.coeff t:I):O)| ≤ H):=by
  let P:= bW
    (G.coeff (qIndex 4 0 1 0)) (G.coeff (qIndex 3 1 1 0))
    (G.coeff (qIndex 2 2 1 0)) (G.coeff (qIndex 1 3 1 0)) (G.coeff (qIndex 0 4 1 0))
  let Q:= bW
    (-G.coeff (qIndex 4 0 0 1)) (-G.coeff (qIndex 3 1 0 1))
    (-G.coeff (qIndex 2 2 0 1)) (-G.coeff (qIndex 1 3 0 1)) (-G.coeff (qIndex 0 4 0 1))
  have heq:G = bO P Q:=by
    dsimp only [P,Q]
    rw [ca]
    ext m
    by_cases hm:m ∈ G.support
    · obtain ⟨hm₁,hm₂⟩:= hG m hm
      rcases bZ m hm₁ hm₂ with h|h|h|h|h|h|h|h|h|h <;>
        subst m <;> simp [av,bT]
    · have hz:G.coeff m = 0:=by
        by_contra hn
        exact hm (MvPolynomial.mem_support_iff.mpr hn)
      have hterm (i j k l:U):
          (if qIndex i j k l = m then G.coeff (qIndex i j k l) else 0) = 0:=by
        split_ifs with h
        · simpa only [h] using hz
        · rfl
      simp only [ba,av,hterm,hz,add_zero]
  refine ⟨P,Q,heq,bX _ _ _ _ _,
    bX _ _ _ _ _,?_⟩
  intro H hH bG t
  constructor
  · exact bY _ _ _ _ _ H hH
      (bG _) (bG _) (bG _) (bG _) (bG _) t
  · apply bY _ _ _ _ _ H hH
      (by simpa using bG _) (by simpa using bG _)
      (by simpa using bG _) (by simpa using bG _)
      (by simpa using bG _) t
private def cd {R:Type*} [CommRing R] (u v:R):
    MvPolynomial (Fin 4) R →+* MvPolynomial (Fin 2) R:=
  MvPolynomial.eval₂Hom ai ![X 0,X 1,C u,C v]
private theorem ce {R:Type*} [CommRing R]
 (u v:R) (P:MvPolynomial (Fin 2) R):
 cd u v (bN P) = P:=by
  have hvars:(fun i:Fin 2=>
      (![X 0,X 1,C u,C v]:Fin 4 → MvPolynomial (Fin 2) R)
        (if i = 0 then (0:Fin 4) else 1)) = X:=by
    funext i
    fin_cases i <;> simp
  change bx ai ![X 0,X 1,C u,C v]
    (aJ (fun i:Fin 2=>if i=0 then (0:Fin 4) else 1) P)=P
  rw [MvPolynomial.eval₂_rename]
  change bx ai
    (fun i:Fin 2=>(![X 0,X 1,C u,C v]:Fin 4→MvPolynomial (Fin 2) R)
      (if i=0 then (0:Fin 4) else 1)) P=P
  rw [hvars]
  simp
private theorem cf {R:Type*} [CommRing R]
 (u v:R) (P Q:MvPolynomial (Fin 2) R):
 cd u v (bO P Q) = P*C u-Q*C v:=by
  have hX2:cd u v (X (2:Fin 4))=C u:=by simp [cd]
  have hX3:cd u v (X (3:Fin 4))=C v:=by simp [cd]
  simp only [bO,map_sub,map_mul,ce,hX2,hX3]
private theorem cg {R:Type*} [CommRing R] (u v r:R):
 cd u v (C r)=C r:=by simp [cd]
private theorem ch
 (P Q P' Q':ab) (n:I)
 (hn:bO P Q = C n*bO P' Q'):
 P = C n*P' ∧ Q = C n*Q':=by
  have hleft:= congrArg (cd (1:I) 0) hn
  have bG:= congrArg (cd (0:I) 1) hn
  have hP:P = C n*P':=by
    simpa [map_mul,cf,cg] using hleft
  have hQ:Q = C n*Q':=by
    have bI:-Q = -(C n*Q'):=by
      simpa [map_mul,cf,cg] using bG
    exact neg_injective bI
  exact ⟨hP,hQ⟩
private theorem ci
 (P Q P' Q':ab) (a b c n:I)
 (hab:bt a b = 1) (hc:c ≠ 0) (hn:n ≠ 0)
 (bG:bO P Q = C n*bO P' Q')
 (hpure:X (1:Fin 2)^3*P-X (0:Fin 2)^3*Q =
 C c*(C a*X 0+C b*X 1)^7):
 ∃c':I,c' ≠ 0 ∧ c = n*c' ∧
 X (1:Fin 2)^3*P'-X (0:Fin 2)^3*Q' =
 C c'*(C a*X 0+C b*X 1)^7:=by
  obtain ⟨hP,hQ⟩:= ch P Q P' Q' n bG
  have heva:= congrArg (al ![(1:I),0]) hpure
  have hevb:= congrArg (al ![(0:I),1]) hpure
  simp at heva hevb
  have hna:n∣c*a^7:=by
    have hd:n∣-al ![(1:I),0] Q:=by
      rw [hQ]
      refine ⟨-al ![(1:I),0] Q',?_⟩
      simp
    rwa [heva] at hd
  have hnb:n∣c*b^7:=by
    have hd:n∣al ![(0:I),1] P:=by
      rw [hP]
      refine ⟨al ![(0:I),1] P',?_⟩
      simp
    rwa [hevb] at hd
  have bI:IsCoprime a b:=by
    refine ⟨Int.gcdA a b,Int.gcdB a b,?_⟩
    have hg:=bg a b
    rw [hab] at hg
    norm_num at hg
    nlinarith only [hg]
  have hpow:IsCoprime (a^7) (b^7):= bI.pow
  obtain ⟨A,B,hbez⟩:= hpow
  obtain ⟨u,hu⟩:= hna
  obtain ⟨v,hv⟩:= hnb
  have bK:n∣c:=by
    refine ⟨A*u+B*v,?_⟩
    linear_combination -c*hbez+A*hu+B*hv
  obtain ⟨c',hcc⟩:= bK
  have hc':c' ≠ 0:=by
    intro hz
    rw [hz,mul_zero] at hcc
    exact hc hcc
  have hnC:(C n:ab) ≠ 0:=by
    intro hz
    have hh:=congrArg (al (fun _:Fin 2=>(0:I))) hz
    exact hn (by simpa using hh)
  refine ⟨c',hc',hcc,?_⟩
  apply aC hnC
  rw [hP,hQ,hcc] at hpure
  simp only [map_mul] at hpure
  linear_combination hpure
private def Bihom41 (G:aa):Prop:=
  ∀m ∈ G.support,m 0+m 1 = 4 ∧ m 2+m 3 = 1
private def IsPure7 (G:aa):Prop:=
  ∃P Q:ab,∃a b c:I,
    G = bO P Q ∧ bt a b = 1 ∧ c ≠ 0 ∧
    X (1:Fin 2)^3*P-X (0:Fin 2)^3*Q =
      C c*(C a*X 0+C b*X 1)^7
private def cj (F G:aa):Prop:=
  G∣F ∧ G ≠ 0 ∧ Irreducible (ag G) ∧
    Bihom41 G ∧ IsPure7 G
private theorem ck
 (G q:aa) (hG:G ≠ 0) (hq:q ≠ 0)
 (hqG:q∣G)
 (hass:Associated (ag q)
 (ag G)):
 ∃n:I,n ≠ 0 ∧ G = C n*q:=by
  have bG:=P7C.support_eq_of_associated_maps q G hass
  have bI:q.totalDegree = G.totalDegree:=by
    simp only [MvPolynomial.totalDegree,bG]
  obtain ⟨R,hR⟩:=hqG
  have hR0:R ≠ 0:=by
    intro hz
    rw [hz,mul_zero] at hR
    exact hG hR
  have hdR:R.totalDegree = 0:=by
    have heq:=ay hq hR0
    rw [←hR] at heq
    omega
  have hc:R = C (R.coeff 0):= bw hdR
  have hn:R.coeff 0 ≠ 0:=by
    intro hz
    rw [hz,map_zero] at hc
    exact hR0 hc
  refine ⟨R.coeff 0,hn,?_⟩
  calc
    G=q*R:=hR
    _=q*C (R.coeff 0):=congrArg (fun T=>q*T) hc
    _=C (R.coeff 0)*q:=mul_comm _ _
private theorem cl
 (F G q:aa)
 (hG:cj F G) (hqF:q∣F) (hq:q ≠ 0)
 (hqG:q∣G)
 (hass:Associated (ag q)
 (ag G)):
 cj F q:=by
  obtain ⟨hGF,hG0,hGeom,hGBi,P,Q,a,b,c,bI,hab,hc,hpure⟩:=hG
  have hqBi:Bihom41 q:=by
    intro m hm
    apply hGBi
    rwa [←P7C.support_eq_of_associated_maps q G hass]
  obtain ⟨P',Q',bK,hP',hQ',bJ⟩:=
    cb q hqBi
  obtain ⟨n,hn,hnG⟩:=
    ck G q hG0 hq hqG hass
  have bG:bO P Q = C n*bO P' Q':=by
    rw [←bI,←bK]
    exact hnG
  obtain ⟨c',hc',hcc,bM⟩:=
    ci P Q P' Q' a b c n hab hc hn bG hpure
  exact ⟨hqF,hq,hass.irreducible_iff.mpr hGeom,hqBi,
    P',Q',a,b,c',bK,hab,hc',bM⟩
private theorem cm
 (F:aa) (hF:F ≠ 0)
 (D:U) (bG:F.totalDegree ≤ D):
 ∃S:Finset (aa),
 S.card ≤ D ∧
 (∀q ∈ S,P7N.PrimitiveIntegral q ∧ cj F q) ∧
 ∀G,cj F G → ∃q ∈ S,
 ∀x:Fin 4 → I,al x G = 0 ↔ al x q = 0:=by
  obtain ⟨s,bI,hassF,hsum⟩:=
    P7C.exists_prime_factors_degree F hF
  classical
  let S₀:Finset (aa):=
    (s.filter (fun p=>0 < p.totalDegree)).toFinset
  let S:Finset (aa):=S₀.filter (cj F)
  refine ⟨S,?_,?_,?_⟩
  · have hcard:S₀.card ≤ D:=by
      have h₁:=Multiset.toFinset_card_le (s.filter (fun p=>0 < p.totalDegree))
      have h₂:=P7D.card_positive_degree_le_sum s
      dsimp [S₀]
      omega
    exact (bq (Finset.filter_subset _ _)).trans hcard
  · intro q hq
    have hqE:cj F q:=(aq hq).2
    have hqS₀:q ∈ S₀:=(aq hq).1
    have hqs:q ∈ s:=
      (Multiset.mem_filter.mp (Multiset.mem_toFinset.mp hqS₀)).1
    have hqp:Prime q:=bI q hqs
    exact ⟨P7N.primitive_of_irreducibles q
      hqp.irreducible hqE.2.2.1,hqE⟩
  · intro G hG
    obtain ⟨q,hqs,hqp,bK,hqF,hqG,hass⟩:=
      P7C.match_geometric_factor_to_prime_family_with_integral_divisor
        F G s bI hassF hG.2.1 hG.1 hG.2.2.1
    have hqE:=cl F G q hG hqF hqp.ne_zero hqG hass
    have hqS:q ∈ S:=by
      apply aF
      refine ⟨?_,hqE⟩
      exact Multiset.mem_toFinset.mpr (Multiset.mem_filter.mpr ⟨hqs,bK⟩)
    exact ⟨q,hqS,fun x=>
      (P7C.eval_zero_iff_of_associated_maps q G hass x).symm⟩
private theorem cn
 (P Q:ab) (d e u v:I):
 al ![d,e,u,v] (bO P Q)=
 al ![d,e] P*u-al ![d,e] Q*v:=by
  have hvars:(fun i:Fin 2=>
      (![d,e,u,v]:Fin 4→I) (if i=0 then (0:Fin 4) else 1))=![d,e]:=by
    funext i
    fin_cases i <;> rfl
  have hemb (R:ab):
      al ![d,e,u,v] (bN R)=
        al ![d,e] R:=by
    change bx (RingHom.id I) ![d,e,u,v]
      (aJ (fun i:Fin 2=>if i=0 then (0:Fin 4) else 1) R)=_
    rw [MvPolynomial.eval₂_rename]
    change bx (RingHom.id I)
      (fun i:Fin 2=>(![d,e,u,v]:Fin 4→I)
        (if i=0 then (0:Fin 4) else 1)) R=_
    rw [hvars]
    rfl
  simp [bO,hemb]
