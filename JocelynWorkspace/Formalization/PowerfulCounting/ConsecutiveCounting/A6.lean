  by_cases h5 : f0.natDegree = n
  · have hfodd : Odd f.natDegree := by
      rw [hdeg, h5]
      exact hnodd
    exact odd_two_root_splits f hf hfodd htwo
  · have hle : f0.natDegree ≤ n := C01.PcCurves.dehom_natDegree_le hR
    have hlt : f0.natDegree < n := by omega
    have hc5 : f0.coeff n = R.coeff (C01.PcCurves.ex n 0) := by
      simpa only [f0, Nat.sub_self, if_pos (le_refl n)] using
