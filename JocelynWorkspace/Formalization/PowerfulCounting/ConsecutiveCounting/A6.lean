private theorem beta_one_cofactor_unique
    (k h A B u v u' v' : ℤ) (hk : k≠0)
    (hu : k*u=h*A) (hv : k*v=h*B)
    (hu' : k*u'=h*A) (hv' : k*v'=h*B) :
    u=u' ∧ v=v' := by
  exact ⟨mul_left_cancel₀ hk (hu.trans hu'.symm),
    mul_left_cancel₀ hk (hv.trans hv'.symm)⟩

private theorem beta_one_divisor_index
    (R k : ℤ) (hR : R≠0) (hd : k∣R) :
    k.natAbs∈R.natAbs.divisors := by
  exact Nat.mem_divisors.mpr
    ⟨Int.natAbs_dvd_natAbs.mpr hd,Int.natAbs_ne_zero.mpr hR⟩

private theorem positive_linear_pair_unique
    (p r : ℤ) (hpr : (p,r)≠(0,0))
    (d e d' e' : ℕ) (hd : 1≤d) (he : 1≤e) (hd' : 1≤d') (he' : 1≤e')
    (hc : Int.gcd (d:ℤ) (e:ℤ)=1) (hc' : Int.gcd (d':ℤ) (e':ℤ)=1)
    (hl : p*(d:ℤ)+r*(e:ℤ)=0)
    (hl' : p*(d':ℤ)+r*(e':ℤ)=0) :
    d=d' ∧ e=e' := by
  have hpr' : ¬(-r=0 ∧ p=0) := by
    rintro ⟨hr,hp⟩
    apply hpr
    have hr0 : r=0 := neg_eq_zero.mp hr
    exact Prod.ext hp hr0
  have hlin : (d:ℤ)*p=(e:ℤ)*(-r) := by linear_combination hl
  have hlin' : (d':ℤ)*p=(e':ℤ)*(-r) := by linear_combination hl'
  have hpar :=
    FormalAB.Sdd81c7c9.A1QuadraticComponents.same_line_parallel
      (-r) p (d:ℤ) (e:ℤ) (d':ℤ) (e':ℤ) hpr' hlin hlin'
  obtain ⟨k,hk,hdk,hek⟩ :=
    JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C03.PcLemP.prim_parallel
      (d:ℤ) (e:ℤ) (d':ℤ) (e':ℤ) hc hc' hpar
  rcases hk with rfl | rfl
  · constructor
    · have hz : (d':ℤ)=(d:ℤ) := by simpa using hdk
      exact_mod_cast hz.symm
    · have hz : (e':ℤ)=(e:ℤ) := by simpa using hek
      exact_mod_cast hz.symm
  · have hdZ : (1:ℤ)≤(d:ℤ) := by exact_mod_cast hd
    have hdZ' : (1:ℤ)≤(d':ℤ) := by exact_mod_cast hd'
    norm_num at hdk
    omega

private theorem univariate_finite_zero_count (P : Polynomial ℚ) (hP : P≠0)
    (A : Finset ℚ) :
    (A.filter (fun x => P.eval x=0)).card≤P.natDegree := by
  classical
  have hsub : A.filter (fun x => P.eval x=0)⊆P.roots.toFinset := by
    intro x hx
    exact Multiset.mem_toFinset.mpr
      ((Polynomial.mem_roots hP).2 (Finset.mem_filter.mp hx).2)
  exact (Finset.card_le_card hsub).trans
    ((Multiset.toFinset_card_le P.roots).trans (Polynomial.card_roots' P))

private def binaryRow (n : ℕ) (c : Fin (n+1) → ℚ) (k y : ℚ) : Polynomial ℚ :=
  (∑ i : Fin (n+1), Polynomial.C (c i*y^(n-i.val))*Polynomial.X^i.val)-
    Polynomial.C k

private theorem binaryRow_degree (n : ℕ) (c : Fin (n+1) → ℚ) (k y : ℚ) :
    (binaryRow n c k y).natDegree≤n := by
  apply (Polynomial.natDegree_sub_le _ _).trans
  apply max_le
  · apply Polynomial.natDegree_sum_le_of_forall_le
    intro i hi
    calc
      (Polynomial.C (c i*y^(n-i.val))*Polynomial.X^i.val).natDegree≤
          (Polynomial.C (c i*y^(n-i.val))).natDegree+
            (Polynomial.X^i.val).natDegree := Polynomial.natDegree_mul_le
      _ ≤ n := by
        simp only [Polynomial.natDegree_C,Polynomial.natDegree_X_pow,zero_add]
        exact Nat.lt_succ_iff.mp i.isLt
  · simp

private theorem binaryRow_eval (n : ℕ) (c : Fin (n+1) → ℚ) (k x y : ℚ) :
    (binaryRow n c k y).eval x=
      (∑ i : Fin (n+1),c i*x^i.val*y^(n-i.val))-k := by
  simp only [binaryRow,Polynomial.eval_sub,Polynomial.eval_finsetSum,
    Polynomial.eval_mul,Polynomial.eval_C,Polynomial.eval_pow,Polynomial.eval_X]
  congr 1
  apply Finset.sum_congr rfl
  intro i hi
  ring

private theorem binaryRow_eval_zero (n : ℕ) (c : Fin (n+1) → ℚ) (k y : ℚ) :
    (binaryRow n c k y).eval 0=c 0*y^n-k := by
  rw [binaryRow_eval]
  congr 1
  calc
    (∑ i : Fin (n+1),c i*(0:ℚ)^i.val*y^(n-i.val))=
        c 0*(0:ℚ)^((0:Fin (n+1)).val)*y^(n-(0:Fin (n+1)).val) := by
      apply Finset.sum_eq_single (0:Fin (n+1))
      · intro i hi hne
        have hval : i.val≠0 := by
          intro hh
          exact hne (Fin.ext hh)
        simp [hval]
      · simp
    _ = c 0*y^n := by simp

private theorem homogeneous_binary_level_grid_count
    (n : ℕ) (hn : 1≤n) (c : Fin (n+1) → ℚ)
    (k : ℚ) (hk : k≠0) (A B : Finset ℚ) :
    ((A.product B).filter (fun z =>
      (∑ i : Fin (n+1),c i*z.1^i.val*z.2^(n-i.val))=k)).card≤
        n*(A.card+B.card) := by
  classical
  let Q : Polynomial ℚ := Polynomial.C (c 0)*Polynomial.X^n-Polynomial.C k
  have hQ : Q≠0 := by
    intro hz
    have hh := congrArg (fun P : Polynomial ℚ => P.coeff 0) hz
    have hn0 : n≠0 := by omega
    have hc : Q.coeff 0=-k := by
      simp [Q,Ne.symm hn0]
    rw [hc,Polynomial.coeff_zero] at hh
    exact hk (neg_eq_zero.mp hh)
  have hQdeg : Q.natDegree≤n := by
    apply (Polynomial.natDegree_sub_le _ _).trans
    apply max_le
    · calc
        (Polynomial.C (c 0)*Polynomial.X^n).natDegree≤
            (Polynomial.C (c 0)).natDegree+(Polynomial.X^n).natDegree :=
          Polynomial.natDegree_mul_le
        _ ≤ n := by simp
    · simp
  let Bad : Finset ℚ := B.filter (fun y => Q.eval y=0)
  have hbad : Bad.card≤n :=
    (univariate_finite_zero_count Q hQ B).trans hQdeg
  let F : ℚ → Finset (ℚ×ℚ) := fun y =>
    (A.filter (fun x => (binaryRow n c k y).eval x=0)).image (fun x => (x,y))
  have hsub :
      (A.product B).filter (fun z =>
        (∑ i : Fin (n+1),c i*z.1^i.val*z.2^(n-i.val))=k)⊆B.biUnion F := by
    intro z hz
    obtain ⟨hzprod,hzlevel⟩ := Finset.mem_filter.mp hz
    obtain ⟨hx,hy⟩ := Finset.mem_product.mp hzprod
    apply Finset.mem_biUnion.mpr
    refine ⟨z.2,hy,Finset.mem_image.mpr ⟨z.1,?_,by simp⟩⟩
    apply Finset.mem_filter.mpr
    refine ⟨hx,?_⟩
    rw [binaryRow_eval,hzlevel,sub_self]
  have hF : ∀ y∈B, (F y).card≤n+(if Q.eval y=0 then A.card else 0) := by
    intro y hy
    have himg : (F y).card≤
        (A.filter (fun x => (binaryRow n c k y).eval x=0)).card :=
      Finset.card_image_le
    by_cases hqy : Q.eval y=0
    · rw [if_pos hqy]
      exact himg.trans ((Finset.card_filter_le _ _).trans (by omega))
    · rw [if_neg hqy,add_zero]
      have hrow : binaryRow n c k y≠0 := by
        intro hr
        have he : (binaryRow n c k y).eval 0=0 := by rw [hr]; simp
        rw [binaryRow_eval_zero] at he
        apply hqy
        simpa only [Q,Polynomial.eval_sub,Polynomial.eval_mul,Polynomial.eval_C,
          Polynomial.eval_pow,Polynomial.eval_X] using he
      exact himg.trans
        ((univariate_finite_zero_count (binaryRow n c k y) hrow A).trans
          (binaryRow_degree n c k y))
  have hsum :
      (Finset.sum B (fun y => n+(if Q.eval y=0 then A.card else 0)))=
        B.card*n+Bad.card*A.card := by
    rw [Finset.sum_add_distrib]
    simp only [Finset.sum_const,nsmul_eq_mul]
    congr 1
    dsimp only [Bad]
    rw [← Finset.sum_filter]
    simp
  calc
    _ ≤ (B.biUnion F).card := Finset.card_le_card hsub
    _ ≤ ∑ y∈B,(F y).card := Finset.card_biUnion_le
    _ ≤ Finset.sum B (fun y => n+(if Q.eval y=0 then A.card else 0)) :=
      Finset.sum_le_sum hF
    _ = B.card*n+Bad.card*A.card := hsum
    _ ≤ B.card*n+n*A.card := Nat.add_le_add_left
      (Nat.mul_le_mul_right A.card hbad) _
    _ = n*(A.card+B.card) := by ring

private def binaryExponent (n : ℕ) (i : Fin (n+1)) : Fin 2 →₀ ℕ :=
  Finsupp.single 0 i.val+Finsupp.single 1 (n-i.val)

private theorem binaryExponent_injective (n : ℕ) :
    Function.Injective (binaryExponent n) := by
  intro i j hij
  apply Fin.ext
  have hh := congrArg (fun m : Fin 2 →₀ ℕ => m 0) hij
  simpa [binaryExponent] using hh

private theorem homogeneous_binary_support
    (n : ℕ) (F : MvPolynomial (Fin 2) ℤ) (hF : F.IsHomogeneous n) :
    ∀ m∈F.support, m 0+m 1=n := by
  intro m hm
  have hh := hF (MvPolynomial.mem_support_iff.mp hm)
  change m.sum (fun (_ : Fin 2) (k : ℕ) => k • (1:ℕ))=n at hh
  rw [Finsupp.sum_fintype m _ (by intro i; simp)] at hh
  simpa [Fin.sum_univ_two,nsmul_eq_mul] using hh

private theorem homogeneous_binary_expansion
    (n : ℕ) (F : MvPolynomial (Fin 2) ℤ)
    (hF : ∀ m∈F.support, m 0+m 1=n) :
    F=∑ i : Fin (n+1),
      MvPolynomial.monomial (binaryExponent n i) (F.coeff (binaryExponent n i)) := by
  classical
  ext m
  rw [MvPolynomial.coeff_sum]
  by_cases hm : m 0+m 1=n
  · let i : Fin (n+1) := ⟨m 0,by omega⟩
    have hmi : binaryExponent n i=m := by
      ext j
      fin_cases j <;> simp [binaryExponent,i] ; omega
    rw [← hmi]
    simp [MvPolynomial.coeff_monomial,(binaryExponent_injective n).eq_iff]
  · have hcoeff : F.coeff m=0 := by
      by_contra hh
      exact hm (hF m (MvPolynomial.mem_support_iff.mpr hh))
    rw [hcoeff]
    symm
    apply Finset.sum_eq_zero
    intro i hi
    rw [MvPolynomial.coeff_monomial]
    apply if_neg
    intro he
    apply hm
    have h0 := congrArg (fun t : Fin 2 →₀ ℕ => t 0) he
    have h1 := congrArg (fun t : Fin 2 →₀ ℕ => t 1) he
    simp [binaryExponent] at h0 h1
    have hiN := i.isLt
    omega

private theorem homogeneous_binary_eval
    (n : ℕ) (F : MvPolynomial (Fin 2) ℤ) (hF : F.IsHomogeneous n)
    (x y : ℤ) :
    MvPolynomial.eval ![x,y] F=
      ∑ i : Fin (n+1),F.coeff (binaryExponent n i)*x^i.val*y^(n-i.val) := by
  classical
  conv_lhs =>
    rw [homogeneous_binary_expansion n F (homogeneous_binary_support n F hF)]
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro i hi
  rw [MvPolynomial.eval_monomial]
  rw [Finsupp.prod_fintype _ _ (by intro j; simp)]
  simp [binaryExponent,Fin.prod_univ_two]
  ; ring

private def binaryLinear (P : Matrix (Fin 2) (Fin 2) ℤ) (i : Fin 2) :
    MvPolynomial (Fin 2) ℤ :=
  MvPolynomial.C (P i 0)*MvPolynomial.X 0+
    MvPolynomial.C (P i 1)*MvPolynomial.X 1

private def binaryChange (P : Matrix (Fin 2) (Fin 2) ℤ)
    (F : MvPolynomial (Fin 2) ℤ) : MvPolynomial (Fin 2) ℤ :=
  MvPolynomial.eval₂ MvPolynomial.C (binaryLinear P) F

private theorem binaryChange_expansion
    (P : Matrix (Fin 2) (Fin 2) ℤ) (F : MvPolynomial (Fin 2) ℤ) :
    binaryChange P F=∑ m∈F.support,
      MvPolynomial.C (F.coeff m)*(binaryLinear P 0)^m 0*(binaryLinear P 1)^m 1 := by
  classical
  unfold binaryChange
  rw [MvPolynomial.eval₂_eq']
  apply Finset.sum_congr rfl
  intro m hm
  rw [Fin.prod_univ_two]
  ring

private theorem binaryChange_homogeneous
    (n : ℕ) (P : Matrix (Fin 2) (Fin 2) ℤ)
    (F : MvPolynomial (Fin 2) ℤ) (hF : F.IsHomogeneous n) :
    (binaryChange P F).IsHomogeneous n := by
  have hlin (i : Fin 2) : (binaryLinear P i).IsHomogeneous 1 := by
    have h0 := (MvPolynomial.isHomogeneous_C (Fin 2) (P i 0)).mul
      (MvPolynomial.isHomogeneous_X ℤ (0:Fin 2))
    have h1 := (MvPolynomial.isHomogeneous_C (Fin 2) (P i 1)).mul
      (MvPolynomial.isHomogeneous_X ℤ (1:Fin 2))
    simpa only [binaryLinear,Nat.zero_add] using h0.add h1
  rw [binaryChange_expansion]
  apply MvPolynomial.IsHomogeneous.sum
  intro m hm
  have hd := homogeneous_binary_support n F hF m hm
  have hp := ((MvPolynomial.isHomogeneous_C (Fin 2) (F.coeff m)).mul
    ((hlin 0).pow (m 0))).mul ((hlin 1).pow (m 1))
  simpa only [Nat.one_mul,Nat.zero_add,hd] using hp

private theorem binaryChange_eval
    (P : Matrix (Fin 2) (Fin 2) ℤ) (F : MvPolynomial (Fin 2) ℤ)
    (w : Fin 2 → ℤ) :
    MvPolynomial.eval w (binaryChange P F)=MvPolynomial.eval (P.mulVec w) F := by
  classical
  rw [binaryChange_expansion,map_sum]
  conv_rhs => rw [MvPolynomial.eval_eq']
  apply Finset.sum_congr rfl
  intro m hm
  rw [Fin.prod_univ_two]
  simp only [map_mul,map_pow,MvPolynomial.eval_C,binaryLinear,map_add,
    MvPolynomial.eval_X,Matrix.mulVec, dotProduct,Fin.sum_univ_two]
  ring

private theorem matrix_left_inverse_mulVec
    (P A : Matrix (Fin 2) (Fin 2) ℤ) (hPA : P*A=1) (w : Fin 2 → ℤ) :
    P.mulVec (A.mulVec w)=w := by
  calc
    P.mulVec (A.mulVec w)=(P*A).mulVec w := by
      first
      | rw [Matrix.mulVec_mulVec]
    _ = w := by rw [hPA,Matrix.one_mulVec]

private def integerRationalGrid (N : ℕ) : Finset ℚ :=
  (Finset.Icc (-(N:ℤ)) (N:ℤ)).image (Int.castRingHom ℚ)

private theorem integerRationalGrid_card (N : ℕ) :
    (integerRationalGrid N).card≤2*N+1 := by
  apply Finset.card_image_le.trans
  rw [Int.card_Icc]
  omega

private theorem integerRationalGrid_mem (N : ℕ) (z : ℤ)
    (hz : |z|≤(N:ℤ)) : (z:ℚ)∈integerRationalGrid N := by
  apply Finset.mem_image.mpr
  refine ⟨z,?_,rfl⟩
  exact Finset.mem_Icc.mpr (abs_le.mp hz)

private theorem resultant_divisor_subpower
    (a K : ℕ) (ha : 1≤a) (hK : 1≤K) :
    ∀ ε : ℝ, 0<ε →
      ∃ C : ℝ, 1≤C ∧
        ∀ x : ℝ, 2≤x → ∀ R : ℤ, R≠0 →
          |(R:ℝ)|≤((2*a).factorial:ℝ)^2*(x^K)^(4*a) →
          (R.natAbs.divisors.card:ℝ)≤C*x^ε := by
  intro ε hε
  let n : ℕ := 4*a*K
  have hn : 0<n := by dsimp [n]; positivity
  have hnR : (0:ℝ)<n := by exact_mod_cast hn
  let η : ℝ := ε/(n:ℝ)
  have hη : 0<η := div_pos hε hnR
  obtain ⟨C,hC,hdiv⟩ :=
    JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C01.PcLowdegRed.divisor_bound
      η hη
  let B : ℝ := ((2*a).factorial:ℝ)^2
  have hB : 0≤B := by dsimp [B]; positivity
  refine ⟨max 1 (C*B^η),le_max_left _ _,?_⟩
  intro x hx R hR hbound
  have hx0 : 0<x := by linarith
  have habs : (R.natAbs:ℝ)=|(R:ℝ)| := by
    rw [← Int.cast_natCast,Int.natCast_natAbs,Int.cast_abs]
  have hpower : (x^K)^(4*a)=x^n := by
    rw [← pow_mul]
    congr 1
    dsimp [n]
    ring
  have hcap : (R.natAbs:ℝ)≤B*x^n := by
    rw [habs]
    simpa only [B,hpower] using hbound
  have hηeq : (n:ℝ)*η=ε := by
    dsimp only [η]
    field_simp [hnR.ne']
  have hrpow : (B*x^n)^η=B^η*x^ε := by
    rw [Real.mul_rpow hB (pow_nonneg hx0.le n)]
    congr 1
    calc
      (x^n)^η=(x^(n:ℝ))^η := by rw [Real.rpow_natCast]
      _ = x^((n:ℝ)*η) := (Real.rpow_mul hx0.le _ _).symm
      _ = x^ε := by rw [hηeq]
  calc
    (R.natAbs.divisors.card:ℝ)≤C*(R.natAbs:ℝ)^η :=
      hdiv R.natAbs (Int.natAbs_ne_zero.mpr hR)
    _ ≤ C*(B*x^n)^η :=
      mul_le_mul_of_nonneg_left
        (Real.rpow_le_rpow (Nat.cast_nonneg _) hcap hη.le) (by linarith)
    _ = (C*B^η)*x^ε := by rw [hrpow]; ring
    _ ≤ max 1 (C*B^η)*x^ε :=
      mul_le_mul_of_nonneg_right (le_max_right _ _) (Real.rpow_nonneg hx0.le _)

private def complexFirstSubstitution
    (P : Matrix (Fin 2) (Fin 2) ℤ) (i : Fin 4) : MvPolynomial (Fin 4) ℂ :=
  if i=0 then MvPolynomial.C (P 0 0:ℂ)*MvPolynomial.X 0+
    MvPolynomial.C (P 0 1:ℂ)*MvPolynomial.X 1
  else if i=1 then MvPolynomial.C (P 1 0:ℂ)*MvPolynomial.X 0+
    MvPolynomial.C (P 1 1:ℂ)*MvPolynomial.X 1
  else MvPolynomial.X i

private def complexFirstHom (P : Matrix (Fin 2) (Fin 2) ℤ) :
    MvPolynomial (Fin 4) ℂ →+* MvPolynomial (Fin 4) ℂ :=
  MvPolynomial.eval₂Hom MvPolynomial.C (complexFirstSubstitution P)

private theorem complexFirst_comp
    (P Q : Matrix (Fin 2) (Fin 2) ℤ) (F : MvPolynomial (Fin 4) ℂ) :
    complexFirstHom Q (complexFirstHom P F)=complexFirstHom (P*Q) F := by
  have he : (complexFirstHom Q).comp (complexFirstHom P)=complexFirstHom (P*Q) := by
    apply MvPolynomial.ringHom_ext
    · intro c
      simp [complexFirstHom]
    · intro i
      fin_cases i <;>
        simp [complexFirstHom,complexFirstSubstitution,Matrix.mul_apply,
          Fin.sum_univ_two,map_add,map_mul] <;> ring
  exact DFunLike.congr_fun he F

private theorem complexFirst_identity (F : MvPolynomial (Fin 4) ℂ) :
    complexFirstHom 1 F=F := by
  have he : complexFirstHom (1 : Matrix (Fin 2) (Fin 2) ℤ)=RingHom.id _ := by
    apply MvPolynomial.ringHom_ext
    · intro c
      simp [complexFirstHom]
    · intro i
