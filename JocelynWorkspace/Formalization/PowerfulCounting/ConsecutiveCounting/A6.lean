private theorem finite_primitive_high_cover
    (F : MvPolynomial (Fin 4) ℤ) (hF : F ≠ 0)
    (D : ℕ) (hdeg : F.totalDegree ≤ D) :
    ∃ S : Finset (MvPolynomial (Fin 4) ℤ),
      S.card ≤ D ∧
      (∀ q ∈ S, Primitive q ∧ HighFactor F q) ∧
      ∀ G, HighFactor F G →
        ∃ q ∈ S, ∀ x : Fin 4 → ℤ,
          (MvPolynomial.eval x G = 0 ↔ MvPolynomial.eval x q = 0) := by
  obtain ⟨s, hsprime, hassF, hsum⟩ :=
    FactorAlgebra.A5CoverageTrial.exists_prime_factors_degree F hF
  classical
  let S₀ : Finset (MvPolynomial (Fin 4) ℤ) :=
    (s.filter (fun p => 0 < p.totalDegree)).toFinset
  let S : Finset (MvPolynomial (Fin 4) ℤ) :=
    S₀.filter (HighFactor F)
  refine ⟨S, ?_, ?_, ?_⟩
  · have hcard0 : S₀.card ≤ D := by
      have h1 := Multiset.toFinset_card_le
        (s.filter (fun p => 0 < p.totalDegree))
      have h2 := FactorAlgebra.A5FactorDegreeTrial.card_positive_degree_le_sum s
      dsimp [S₀]
      omega
    exact (Finset.card_le_card (Finset.filter_subset _ _)).trans hcard0
  · intro q hq
    have hqE : HighFactor F q := (Finset.mem_filter.mp hq).2
    have hqS₀ : q ∈ S₀ := (Finset.mem_filter.mp hq).1
    have hqs : q ∈ s := by
      exact (Multiset.mem_filter.mp ((Multiset.mem_toFinset).mp hqS₀)).1
    have hqp : Prime q := hsprime q hqs
    have hqGeom : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) q) := hqE.2.2.1
    exact ⟨FactorAlgebra.A5PrimitiveNormalizationTrial.primitive_of_irreducibles
      q hqp.irreducible hqGeom, hqE⟩
  · intro G hG
    rcases hG with ⟨hGF, hG0, hGeom, α, β, hα, hβ, hhigh, hBi⟩
    obtain ⟨q, hqs, hqp, hqdeg, hqF, hass⟩ :=
      FactorAlgebra.A5CoverageTrial.match_geometric_factor_to_prime_family
        F G s hsprime hassF hG0 hGF hGeom
    have hqBi : Bihom q α β := by
      intro m hm
      apply hBi
      have hsupp := FactorAlgebra.A5CoverageTrial.support_eq_of_associated_maps q G hass
      rw [← hsupp]
      exact hm
    have hqE : HighFactor F q :=
      ⟨hqF, hqp.ne_zero, hass.irreducible_iff.mpr hGeom,
        ⟨α, β, hα, hβ, hhigh, hqBi⟩⟩
    have hqS : q ∈ S := by
      apply Finset.mem_filter.mpr
      constructor
      · change q ∈ (s.filter (fun p => 0 < p.totalDegree)).toFinset
        exact (Multiset.mem_toFinset).mpr
          (Multiset.mem_filter.mpr ⟨hqs, hqdeg⟩)
      · exact hqE
    refine ⟨q, hqS, ?_⟩
    intro x
    exact (FactorAlgebra.A5CoverageTrial.eval_zero_iff_of_associated_maps q G hass x).symm

private lemma original_cell_finite (x D E : ℝ) (M j : ℕ) (h : ℤ)
    (hx : 8 ≤ x) (hh : h = 1 ∨ h = -1) :
    (cubicCell x D E M j h).Finite := by
  let n : ℕ := ⌊2*x⌋₊
  apply (Set.finite_Iic (((n,n),(n,n)) : Point)).subset
  intro z hz
  have hb := A6Threshold8ActualAuxiliary.cell_coordinate_bounds x D E M j h hx hh z hz
  exact ⟨⟨Nat.le_floor hb.1, Nat.le_floor hb.2.1⟩,
    Nat.le_floor hb.2.2.1, Nat.le_floor hb.2.2.2⟩

private lemma occupied_scale_bounds (x D E : ℝ) (M j : ℕ) (h : ℤ)
    (hx : 8 ≤ x) (hh : h = 1 ∨ h = -1)
    (z : Point) (hz : z ∈ cubicCell x D E M j h) :
    1 ≤ D ∧ 1 ≤ E ∧ D ≤ 2*x ∧ E ≤ 2*x := by
  rcases hz with ⟨hdn,hen,hun,hvn,hshift,hnlo,hnhi,hdlo,hdhi,helo,hehi,htlo,hthi⟩
  have hd1 : (1 : ℝ) ≤ z.1.1 := by exact_mod_cast hdn
  have he1 : (1 : ℝ) ≤ z.1.2 := by exact_mod_cast hen
  have hu1 : (1 : ℝ) ≤ z.2.1 := by exact_mod_cast hun
  have hv1 : (1 : ℝ) ≤ z.2.2 := by exact_mod_cast hvn
  have hn : (z.1.1 : ℝ)^3*(z.2.1 : ℝ) ≤ x := by exact_mod_cast hnhi
  have hsh : (z.1.2 : ℝ)^3*(z.2.2 : ℝ) =
      (z.1.1 : ℝ)^3*(z.2.1 : ℝ)+(h : ℝ) := by exact_mod_cast hshift
  have hhr : (h : ℝ) ≤ 1 := by rcases hh with rfl | rfl <;> norm_num
  have hd3 : (z.1.1 : ℝ)^3 ≤ x :=
    (le_mul_of_one_le_right (by positivity) hu1).trans hn
  have hdle : (z.1.1 : ℝ) ≤ x := by
    have hs : (1 : ℝ) ≤ (z.1.1 : ℝ)^2 := one_le_pow₀ hd1
    have hp := mul_le_mul_of_nonneg_left hs (show (0 : ℝ) ≤ z.1.1 by positivity)
    nlinarith only [hp,hd3]
  have he3 : (z.1.2 : ℝ)^3 ≤ x+1 := by
    have hp := le_mul_of_one_le_right (show (0 : ℝ) ≤ (z.1.2 : ℝ)^3 by positivity) hv1
    linarith only [hp,hsh,hn,hhr]
  have hele : (z.1.2 : ℝ) ≤ x := by
    by_cases heq : z.1.2 = 1
    · simp only [heq,Nat.cast_one]
      linarith only [hx]
    · have he2n : 2 ≤ z.1.2 := by omega
      have he2 : (2 : ℝ) ≤ z.1.2 := by exact_mod_cast he2n
      have hesq : (4 : ℝ) ≤ (z.1.2 : ℝ)^2 := by
        nlinarith only [sq_nonneg ((z.1.2 : ℝ)-2),he2]
      have hp := mul_nonneg (show (0 : ℝ) ≤ z.1.2 by positivity)
        (show 0 ≤ (z.1.2 : ℝ)^2-2 by linarith only [hesq])
      nlinarith only [hp,he3,hx]
  exact ⟨hd1.trans hdhi,he1.trans hehi,by linarith only [hdlo,hdle],
    by linarith only [helo,hele]⟩

private lemma weighted_degree_cap (G : Poly) (hG : G ≠ 0)
    (a b N : ℕ) (hb : Bihom G a b) (hdeg : G.totalDegree ≤ N) :
    a+3*b ≤ 3*N := by
  have hs : G.support.Nonempty := by
    by_contra hh
    have he : G.support = ∅ := Finset.not_nonempty_iff_eq_empty.mp hh
    apply hG
    exact MvPolynomial.support_eq_empty.mp he
  obtain ⟨m,hm⟩ := hs
  have hd := MvPolynomial.le_totalDegree hm
  change m.degree ≤ G.totalDegree at hd
  rw [Finsupp.degree_eq_sum,Fin.sum_univ_four] at hd
  obtain ⟨ha,hb⟩ := hb m hm
  omega

private lemma high_numeric_price (c η x Δ L T : ℝ) (N : ℕ)
    (hη : 0 < η) (hx : 1 < x) (hL : 0 < L) (hT : 0 < T)
    (hδR : 8 ≤ Δ) (hδcap : Δ ≤ 3*(N : ℝ))
    (hLcap : L ≤ x^2) (hTcap : T ≤ x^2) :
    let H : ℝ := max 1 (L^3*T)
    2*|c| *Δ^3*H^(1/Δ)*(Real.log H+Δ) ≤
      (2*|c| *(3*(N : ℝ))^3*(8/η+3*(N : ℝ)))*x^η*
        (1+(L^3*T)^((1 : ℝ)/8)) := by
  let H : ℝ := max 1 (L^3*T)
  have hH : 1 ≤ H := le_max_left _ _
  have hH0 : 0 < H := lt_of_lt_of_le zero_lt_one hH
  have hx0 : 0 < x := by linarith only [hx]
  have hx1 : 1 ≤ x := hx.le
  have hN : 0 ≤ 3*(N : ℝ) := by positivity
  have hδ0 : 0 ≤ Δ := by linarith only [hδR]
  have hBase : 0 ≤ L^3*T := by positivity
  have hHcap : H ≤ x^8 := by
    apply max_le
    · exact one_le_pow₀ hx1
    · calc
        L^3*T ≤ (x^2)^3*x^2 := by
          exact mul_le_mul (pow_le_pow_left₀ hL.le hLcap 3) hTcap hT.le (by positivity)
        _ = x^8 := by ring
  have hlog : Real.log H ≤ 8*Real.log x := by
    have ht := Real.log_le_log hH0 hHcap
    simpa only [Real.log_pow, Nat.cast_ofNat] using ht
  have hprice : Real.log H+Δ ≤ (8/η+3*(N : ℝ))*x^η := by
    have ht := Real.log_le_rpow_div hx0.le hη
    have hp := Real.one_le_rpow hx1 hη.le
    have hconst := mul_le_mul_of_nonneg_left hp hN
    calc
      Real.log H+Δ ≤ 8*Real.log x+3*(N : ℝ) := add_le_add hlog hδcap
      _ ≤ 8*(x^η/η)+3*(N : ℝ) := add_le_add
        (mul_le_mul_of_nonneg_left ht (by norm_num : (0 : ℝ) ≤ 8))
        (le_refl (3*(N : ℝ)))
      _ ≤ 8*(x^η/η)+(3*(N : ℝ))*x^η := by linarith only [hconst]
      _ = _ := by ring
  have hexp : (1 : ℝ)/Δ ≤ (1 : ℝ)/8 := by
    apply (div_le_div_iff₀ (by linarith only [hδR]) (by norm_num)).mpr
    linarith only [hδR]
  have hpower : H^(1/Δ) ≤ 1+(L^3*T)^((1 : ℝ)/8) := by
    have ht := Real.rpow_le_rpow_of_exponent_le hH hexp
    apply ht.trans
    by_cases hb : 1 ≤ L^3*T
    · dsimp [H]
      rw [max_eq_right hb]
      linarith
    · dsimp [H]
      rw [max_eq_left (le_of_not_ge hb), Real.one_rpow]
      linarith only [Real.rpow_nonneg hBase ((1 : ℝ)/8)]
  have hdPow : Δ^3 ≤ (3*(N : ℝ))^3 := pow_le_pow_left₀ hδ0 hδcap 3
  have hlog0 : 0 ≤ Real.log H+Δ := add_nonneg (Real.log_nonneg hH) hδ0
  calc
    2*|c| *Δ^3*H^(1/Δ)*(Real.log H+Δ) ≤
        2*|c| *(3*(N : ℝ))^3*(1+(L^3*T)^((1 : ℝ)/8))*
          ((8/η+3*(N : ℝ))*x^η) := by
      apply mul_le_mul _ hprice hlog0
        (by positivity : 0 ≤ 2*|c| *(3*(N : ℝ))^3*(1+(L^3*T)^((1 : ℝ)/8)))
      exact mul_le_mul
        (mul_le_mul_of_nonneg_left hdPow (by positivity))
        hpower (Real.rpow_nonneg hH0.le _) (by positivity)
    _ = _ := by ring

private theorem highCell_price
    (c η x D E : ℝ) (N M j : ℕ) (h : ℤ)
    (hCC : FormalAB.S1a1f3383.ConsecutiveCountingTargetsAB.CCDNAt 8 c)
    (hη : 0 < η) (hx : 1 < x)
    (hh : h = 1 ∨ h = -1)
    (F G : Poly) (hF : F ≠ 0) (hFD : F.totalDegree ≤ N)
    (hG : HighFactor F G)
    (p : EllipseData ((M : ℝ)/(4*D)) (cubicRho D E M j) (2*E))
    (q : EllipseData ((M : ℝ)/(2048*(x/E^3))) ((cubicRho D E M j)^3) (32*(x/D^3)))
    (hcover : ∀ z ∈ cubicCell x D E M j h,
      |((p.A.mulVec ![(z.1.1 : ℤ),(z.1.2 : ℤ)]) 0 : ℝ)| ≤
        sideLength ((M : ℝ)/(4*D)) (cubicRho D E M j) (2*E) p.P 0 ∧
      |((p.A.mulVec ![(z.1.1 : ℤ),(z.1.2 : ℤ)]) 1 : ℝ)| ≤
        sideLength ((M : ℝ)/(4*D)) (cubicRho D E M j) (2*E) p.P 1 ∧
      |((q.A.mulVec ![(z.2.2 : ℤ),(z.2.1 : ℤ)]) 0 : ℝ)| ≤
        sideLength ((M : ℝ)/(2048*(x/E^3))) ((cubicRho D E M j)^3) (32*(x/D^3)) q.P 0 ∧
      |((q.A.mulVec ![(z.2.2 : ℤ),(z.2.1 : ℤ)]) 1 : ℝ)| ≤
        sideLength ((M : ℝ)/(2048*(x/E^3))) ((cubicRho D E M j)^3) (32*(x/D^3)) q.P 1)
    (hLcap : sideLength ((M : ℝ)/(4*D)) (cubicRho D E M j) (2*E) p.P 0 ≤ x^2)
    (hTcap : sideLength ((M : ℝ)/(2048*(x/E^3))) ((cubicRho D E M j)^3)
        (32*(x/D^3)) q.P 0 ≤ x^2) :
    let L := sideLength ((M : ℝ)/(4*D)) (cubicRho D E M j) (2*E) p.P 0
    let T := sideLength ((M : ℝ)/(2048*(x/E^3))) ((cubicRho D E M j)^3)
      (32*(x/D^3)) q.P 0
    (HighCell x D E M j h G).Finite ∧
      ((HighCell x D E M j h G).ncard : ℝ) ≤
        (2*|c| *(3*(N : ℝ))^3*(8/η+3*(N : ℝ)))*x^η*
          (1+(L^3*T)^((1 : ℝ)/8)) := by
  classical
  rcases hG with ⟨hGF,hG0,hGeom,a,b,ha,hb,hδ,hBi⟩
  let L := sideLength ((M : ℝ)/(4*D)) (cubicRho D E M j) (2*E) p.P 0
  let T := sideLength ((M : ℝ)/(2048*(x/E^3))) ((cubicRho D E M j)^3)
    (32*(x/D^3)) q.P 0
  let H : ℝ := max 1 (L^3*T)
  let Δ : ℝ := (a+3*b : ℕ)
  have hL : 0 < L := p.hpos.trans_le p.horder
  have hT : 0 < T := q.hpos.trans_le q.horder
  have hH : 1 ≤ H := le_max_left _ _
  have hH0 : 0 < H := lt_of_lt_of_le zero_lt_one hH
  have hx0 : 0 < x := by linarith only [hx]
  have hx1 : 1 ≤ x := hx.le
  have hdeg : G.totalDegree ≤ N :=
    (MvPolynomial.totalDegree_le_of_dvd_of_isDomain hGF hF).trans hFD
  have hδN := weighted_degree_cap G hG0 a b N hBi hdeg
  have hδR : 8 ≤ Δ := by dsimp [Δ]; exact_mod_cast hδ
  have hδcap : Δ ≤ 3*(N : ℝ) := by dsimp [Δ]; exact_mod_cast hδN
  have hN : 0 ≤ 3*(N : ℝ) := by positivity
  have hδ0 : 0 ≤ Δ := by linarith only [hδR]
  have hTr := cubic_original_positive_transport c hCC a b hδ G hG0 hBi hGeom
    p.A q.A p.hdetA q.hdetA L
      (sideLength ((M : ℝ)/(4*D)) (cubicRho D E M j) (2*E) p.P 1)
      T (sideLength ((M : ℝ)/(2048*(x/E^3))) ((cubicRho D E M j)^3)
        (32*(x/D^3)) q.P 1) p.horder p.hpos q.horder q.hpos h hh
  let S0 : Set Point :=
      {z : Point | 1 ≤ z.1.1 ∧ 1 ≤ z.1.2 ∧ 1 ≤ z.2.1 ∧ 1 ≤ z.2.2 ∧
        ((z.1.2^3*z.2.2 : ℕ) : ℤ) = ((z.1.1^3*z.2.1 : ℕ) : ℤ)+h ∧
        |((p.A.mulVec ![(z.1.1 : ℤ),(z.1.2 : ℤ)]) 0 : ℝ)| ≤ L ∧
        |((p.A.mulVec ![(z.1.1 : ℤ),(z.1.2 : ℤ)]) 1 : ℝ)| ≤
          sideLength ((M : ℝ)/(4*D)) (cubicRho D E M j) (2*E) p.P 1 ∧
        |((q.A.mulVec ![(z.2.2 : ℤ),(z.2.1 : ℤ)]) 0 : ℝ)| ≤ T ∧
        |((q.A.mulVec ![(z.2.2 : ℤ),(z.2.1 : ℤ)]) 1 : ℝ)| ≤
          sideLength ((M : ℝ)/(2048*(x/E^3))) ((cubicRho D E M j)^3)
            (32*(x/D^3)) q.P 1 ∧
        MvPolynomial.eval ![(z.1.1 : ℤ),(z.1.2 : ℤ),(z.2.1 : ℤ),(z.2.2 : ℤ)] G = 0}
  have hsub : HighCell x D E M j h G ⊆ S0 := by
    rintro z ⟨hz,hzero⟩
    have hc := hcover z hz
    exact ⟨hz.1,hz.2.1,hz.2.2.1,hz.2.2.2.1,hz.2.2.2.2.1,
      hc.1,hc.2.1,hc.2.2.1,hc.2.2.2,hzero⟩
  have hcard : ((HighCell x D E M j h G).ncard : ℝ) ≤
      2*|c| *Δ^3*H^(1/Δ)*(Real.log H+Δ) := by
    have hn := Set.ncard_le_ncard hsub hTr.1
    have hnr : ((HighCell x D E M j h G).ncard : ℝ) ≤ (S0.ncard : ℝ) := by exact_mod_cast hn
    exact hnr.trans hTr.2
  refine ⟨hTr.1.subset hsub,hcard.trans ?_⟩
  exact high_numeric_price c η x Δ L T N hη hx hL hT hδR hδcap hLcap hTcap

end A6Threshold8HighActualInternal

namespace A6Threshold8HighActualInternal

private lemma powers (x : ℝ) (hx : 0 ≤ x) (n : ℕ) (a : ℝ) :
    (x^n)^a = x^((n : ℝ)*a) := by
  rw [←Real.rpow_natCast,←Real.rpow_mul hx]

private lemma mixed_unit_bound (p q : ℝ) (hp : 0 ≤ p) (hq : 0 ≤ q) :
    (p^3*q)^((1 : ℝ)/8) ≤ 1+p^2+q^2 := by
  let w : ℝ := 1+p^2+q^2
  have hw1 : 1 ≤ w := by dsimp [w]; nlinarith only [sq_nonneg p,sq_nonneg q]
  have hw0 : 0 < w := by linarith only [hw1]
  have hpw : p^2 ≤ w := by dsimp [w]; nlinarith only [sq_nonneg q]
  have hqw : q^2 ≤ w := by dsimp [w]; nlinarith only [sq_nonneg p]
  have hpPow : (p^3)^((1 : ℝ)/8) = (p^2)^((3 : ℝ)/16) := by
    rw [powers p hp 3,powers p hp 2]
    norm_num
  have hqPow : q^((1 : ℝ)/8) = (q^2)^((1 : ℝ)/16) := by
    rw [powers q hq 2]
    norm_num
  calc
    (p^3*q)^((1 : ℝ)/8) =
        (p^2)^((3 : ℝ)/16)*(q^2)^((1 : ℝ)/16) := by
      rw [Real.mul_rpow (by positivity) hq,hpPow,hqPow]
    _ ≤ w^((3 : ℝ)/16)*w^((1 : ℝ)/16) :=
      mul_le_mul
        (Real.rpow_le_rpow (sq_nonneg p) hpw (by norm_num))
        (Real.rpow_le_rpow (sq_nonneg q) hqw (by norm_num))
        (Real.rpow_nonneg (sq_nonneg q) _) (Real.rpow_nonneg hw0.le _)
    _ = w^((1 : ℝ)/4) := by
      rw [←Real.rpow_add hw0]
      norm_num
    _ ≤ w^(1 : ℝ) := Real.rpow_le_rpow_of_exponent_le hw1 (by norm_num)
    _ = 1+p^2+q^2 := by rw [Real.rpow_one]

private lemma scaled_mixed_bound (l t r v : ℝ)
    (hl : 0 ≤ l) (ht : 0 ≤ t) (hr : 0 < r) (hv : 0 < v) :
    (l^3*t)^((1 : ℝ)/8) ≤
      (r^3*v)^((1 : ℝ)/8)*(1+(l/r)^2+(t/v)^2) := by
  have hid : l^3*t=(r^3*v)*((l/r)^3*(t/v)) := by
    field_simp [hr.ne',hv.ne']

  calc
    (l^3*t)^((1 : ℝ)/8) =
        (r^3*v)^((1 : ℝ)/8)*((l/r)^3*(t/v))^((1 : ℝ)/8) := by
      rw [hid,Real.mul_rpow (by positivity) (by positivity)]
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (mixed_unit_bound (l/r) (t/v) (div_nonneg hl hr.le) (div_nonneg ht hv.le))
      (Real.rpow_nonneg (by positivity) _)

private theorem mixed_raw_sum (J : Finset ℕ) (m R S A : ℝ) (L T : ℕ → ℝ)
    (hm : 0 < m) (hR : 0 < R) (hS : 0 < S) (hA : 1 ≤ A)
    (hcard : (J.card : ℝ) ≤ 4*m)
    (hL : ∀ j ∈ J, 0 ≤ L j) (hT : ∀ j ∈ J, 0 ≤ T j)
    (hLm : (∑ j ∈ J, (L j)^2) ≤ A*R)
    (hTm : (∑ j ∈ J, (T j)^2) ≤ A*S) :
    (∑ j ∈ J, (1+((L j)^3*T j)^((1 : ℝ)/8))) ≤
      10*A*(m+m^((3 : ℝ)/4)*R^((3 : ℝ)/16)*S^((1 : ℝ)/16)) := by
  let r : ℝ := (R/m)^((1 : ℝ)/2)
  let v : ℝ := (S/m)^((1 : ℝ)/2)
  have hr : 0 < r := Real.rpow_pos_of_pos (by positivity) _
  have hv : 0 < v := Real.rpow_pos_of_pos (by positivity) _
  have hr2 : r^2 = R/m := by
    dsimp [r]
    rw [←Real.rpow_natCast,←Real.rpow_mul (by positivity : 0 ≤ R/m)]
    norm_num
  have hv2 : v^2 = S/m := by
    dsimp [v]
    rw [←Real.rpow_natCast,←Real.rpow_mul (by positivity : 0 ≤ S/m)]
    norm_num
  have hLratio : (∑ j ∈ J, (L j/r)^2) ≤ A*m := by
    calc
      (∑ j ∈ J, (L j/r)^2) = (∑ j ∈ J, (L j)^2)/r^2 := by
        simp only [div_pow,Finset.sum_div]
      _ ≤ (A*R)/r^2 := div_le_div_of_nonneg_right hLm (sq_nonneg r)
      _ = A*m := by rw [hr2]; field_simp [hR.ne',hm.ne']
  have hTratio : (∑ j ∈ J, (T j/v)^2) ≤ A*m := by
    calc
      (∑ j ∈ J, (T j/v)^2) = (∑ j ∈ J, (T j)^2)/v^2 := by
        simp only [div_pow,Finset.sum_div]
      _ ≤ (A*S)/v^2 := div_le_div_of_nonneg_right hTm (sq_nonneg v)
      _ = A*m := by rw [hv2]; field_simp [hS.ne',hm.ne']
  have hcardA : (J.card : ℝ) ≤ 4*A*m := by
    have ht := mul_le_mul_of_nonneg_right hA (show 0 ≤ 4*m by positivity)
    nlinarith only [hcard,ht]
  have hnorm : (∑ j ∈ J, (1+(L j/r)^2+(T j/v)^2)) ≤ 6*A*m := by
    simp only [Finset.sum_add_distrib,Finset.sum_const,nsmul_eq_mul,mul_one]
    linarith only [hcardA,hLratio,hTratio]
  have hfactor :
      (r^3*v)^((1 : ℝ)/8)*m =
        m^((3 : ℝ)/4)*R^((3 : ℝ)/16)*S^((1 : ℝ)/16) := by
    rw [Real.mul_rpow (by positivity : 0 ≤ r^3) hv.le,powers r hr.le 3]
    dsimp only [r,v]
    rw [←Real.rpow_mul (by positivity : 0 ≤ R/m),
      ←Real.rpow_mul (by positivity : 0 ≤ S/m)]
    norm_num
    rw [Real.div_rpow hR.le hm.le,Real.div_rpow hS.le hm.le]
    have he : m^((3 : ℝ)/16)*m^((1 : ℝ)/16)=m^((1 : ℝ)/4) := by
      rw [←Real.rpow_add hm]
      norm_num
    have he' : m/m^((1 : ℝ)/4)=m^((3 : ℝ)/4) := by
      calc
        m/m^((1 : ℝ)/4) = m^(1 : ℝ)/m^((1 : ℝ)/4) := by rw [Real.rpow_one]
        _ = m^((1 : ℝ)-(1 : ℝ)/4) := (Real.rpow_sub hm _ _).symm
        _ = m^((3 : ℝ)/4) := by norm_num
    calc
      R^((3 : ℝ)/16)/m^((3 : ℝ)/16)*
          (S^((1 : ℝ)/16)/m^((1 : ℝ)/16))*m =
        (m/(m^((3 : ℝ)/16)*m^((1 : ℝ)/16)))*
          R^((3 : ℝ)/16)*S^((1 : ℝ)/16) := by ring
      _ = _ := by rw [he,he']
  have hmix : (∑ j ∈ J, ((L j)^3*T j)^((1 : ℝ)/8)) ≤
      6*A*(m^((3 : ℝ)/4)*R^((3 : ℝ)/16)*S^((1 : ℝ)/16)) := by
    calc
      (∑ j ∈ J, ((L j)^3*T j)^((1 : ℝ)/8)) ≤
          ∑ j ∈ J, (r^3*v)^((1 : ℝ)/8)*(1+(L j/r)^2+(T j/v)^2) :=
        Finset.sum_le_sum (fun j hj => scaled_mixed_bound (L j) (T j) r v
          (hL j hj) (hT j hj) hr hv)
      _ = (r^3*v)^((1 : ℝ)/8)*
