      |((A 1 0*z.1.1+A 1 1*z.1.2:ℤ):ℝ)|≤L₂ ∧
      |((B 0 1*z.2.1+B 0 0*z.2.2:ℤ):ℝ)|≤T₁ ∧
      |((B 1 1*z.2.1+B 1 0*z.2.2:ℤ):ℝ)|≤T₂ ∧
      eval ![z.1.1,z.1.2,z.2.1,z.2.2] unitSurface=h ∧
      eval ![z.1.1,z.1.2,z.2.1,z.2.2] G=0}
  have hmap : ∀ q∈S, natToInteger q∈T := by
    rintro ⟨⟨d,e⟩,⟨u,v⟩⟩ hq
    rcases hq with ⟨hd,he,hu,hv,hshift,hb1,hb2,hb3,hb4,hzero⟩
    have hcop := both_coprime d e u v h hsign hshift
    refine ⟨?_,?_,?_,?_,?_,?_,?_,hzero⟩
    · simpa [natToInteger] using hcop.1.gcd_eq_one
    · simpa [natToInteger] using hcop.2.gcd_eq_one
    · simpa [natToInteger,Matrix.mulVec,dotProduct,Fin.sum_univ_two] using hb1
    · simpa [natToInteger,Matrix.mulVec,dotProduct,Fin.sum_univ_two] using hb2
    · simpa [natToInteger,Matrix.mulVec,dotProduct,Fin.sum_univ_two,add_comm] using hb3
    · simpa [natToInteger,Matrix.mulVec,dotProduct,Fin.sum_univ_two,add_comm] using hb4
    · change eval ![(d:ℤ),(e:ℤ),(u:ℤ),(v:ℤ)] unitSurface=h
