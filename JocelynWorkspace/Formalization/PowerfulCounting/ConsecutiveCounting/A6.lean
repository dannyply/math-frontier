      (M : ℝ) ≤ D * E ∧ (M : ℝ) ≤ V * U := by
  let μ : ℝ := mStar s + δ
  let M : ℕ := ⌈x ^ μ⌉₊
  let U : ℝ := x / D ^ 3
  let V : ℝ := x / E ^ 3
