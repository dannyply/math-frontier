  refine ⟨((2 * D^3 : ℕ) : ℝ), ?_, ?_⟩
  · have hDpos : 0 < D := by omega
    have hp : 0 < D^3 := pow_pos hDpos 3
    exact_mod_cast (show 1 ≤ 2 * D^3 by omega)
