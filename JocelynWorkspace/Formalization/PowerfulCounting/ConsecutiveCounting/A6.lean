namespace A6WholeF8ActualJoins
open MvPolynomial
abbrev Binary := MvPolynomial (Fin 2) ℤ

private theorem rational_primitive_direction (a b : ℚ) (hab : a≠0 ∨ b≠0) :
    ∃ A B r s : ℤ, ∃ μ : ℚ,
      μ≠0 ∧ Int.gcd A B=1 ∧ A*r+B*s=1 ∧
      a=μ*(A:ℚ) ∧ b=μ*(B:ℚ) := by
  by_cases hb : b=0
  · subst b
    have ha : a≠0 := hab.resolve_right (by simp)
    exact ⟨1,0,1,0,a,ha,by norm_num,by norm_num,by simp,by simp⟩
  · let q : ℚ := a/b
    let A : ℤ := q.num
    let B : ℤ := q.den
    have hg : Int.gcd A B=1 := by
      simpa [A,B,Int.gcd] using q.reduced
    have hBez : A*Int.gcdA A B+B*Int.gcdB A B=1 := by
      rw [←Int.gcd_eq_gcd_ab,hg]
      norm_num
    have hden : (q.den:ℚ)≠0 := by exact_mod_cast q.den_nz
    let μ : ℚ := b/(q.den:ℚ)
    have hμ : μ≠0 := div_ne_zero hb hden
    have hrep : (a/b)*(q.den:ℚ)=(q.num:ℚ) := Rat.mul_den_eq_num q
    have hcross : a*(q.den:ℚ)=b*(q.num:ℚ) := by
      calc
        a*(q.den:ℚ)=((a/b)*(q.den:ℚ))*b := by field_simp [hb]
        _=(q.num:ℚ)*b := by rw [hrep]
        _=b*(q.num:ℚ) := mul_comm _ _
    have ha : a=μ*(A:ℚ) := by
      dsimp only [μ,A]
      rw [div_mul_eq_mul_div]
      exact (eq_div_iff hden).mpr hcross
    have hb' : b=μ*(B:ℚ) := by
      dsimp only [μ,B]
      push_cast
      field_simp [hden]
    exact ⟨A,B,Int.gcdA A B,Int.gcdB A B,μ,hμ,hg,hBez,ha,hb'⟩

private theorem eval_int_map {K : Type*} [Field K] [CharZero K]
    (R : Binary) (w : Fin 2→ℤ) :
    eval (fun i=>(w i:K)) (map (Int.castRingHom K) R) =
      ((eval w R:ℤ):K) := by
  simpa [Function.comp_def] using
    (MvPolynomial.map_eval (Int.castRingHom K) w R).symm

private theorem binary_eval_ext (P Q : MvPolynomial (Fin 2) ℚ)
    (h : ∀ r s : ℚ, eval ![r,s] P=eval ![r,s] Q) : P=Q := by
  apply MvPolynomial.funext
  intro w
  have hw : (![w 0,w 1] : Fin 2→ℚ)=w := by
    funext i
    fin_cases i <;> rfl
  simpa [hw] using h (w 0) (w 1)

private theorem rational_pure_to_integral_primitive
    (R : Binary) (n : ℕ) (κ a b : ℚ)
    (hκ : κ≠0) (hab : a≠0 ∨ b≠0)
    (hR : ∀ r s : ℚ,
      eval ![r,s] (map (Int.castRingHom ℚ) R)=κ*(a*r+b*s)^n) :
    ∃ A B c : ℤ, Int.gcd A B=1 ∧ c≠0 ∧
      R=C c*(C A*X 0+C B*X 1)^n := by
  obtain ⟨A,B,r,s,μ,hμ,hAB,hBez,ha,hb⟩ :=
    rational_primitive_direction a b hab
  let c : ℤ := eval ![r,s] R
  have hBezQ : (A:ℚ)*(r:ℚ)+(B:ℚ)*(s:ℚ)=1 := by exact_mod_cast hBez
  have hmapc :
      eval ![(r:ℚ),(s:ℚ)] (map (Int.castRingHom ℚ) R)=(c:ℚ) := by
    have hw :
        (fun i : Fin 2 => ((![r,s] i:ℤ):ℚ))=![(r:ℚ),(s:ℚ)] := by
      funext i
      fin_cases i <;> rfl
    simpa only [hw,c] using eval_int_map (K:=ℚ) R ![r,s]
  have hscalar : (c:ℚ)=κ*μ^n := by
    have h := hR (r:ℚ) (s:ℚ)
    rw [hmapc,ha,hb] at h
    have hlin : μ*(A:ℚ)*(r:ℚ)+μ*(B:ℚ)*(s:ℚ)=μ := by
      calc
        _=μ*((A:ℚ)*(r:ℚ)+(B:ℚ)*(s:ℚ)) := by ring
        _=μ := by rw [hBezQ,mul_one]
    rwa [hlin] at h
  have hc : c≠0 := by
    intro hc
    have hn : κ*μ^n≠0 := mul_ne_zero hκ (pow_ne_zero _ hμ)
    exact hn (by simpa only [hc,Int.cast_zero] using hscalar.symm)
  have hQ :
      map (Int.castRingHom ℚ) R =
        C (c:ℚ)*(C (A:ℚ)*X 0+C (B:ℚ)*X 1)^n := by
    apply binary_eval_ext
    intro t u
    rw [hR,ha,hb]
    simp only [map_mul,map_pow,map_add,eval_C,eval_X,
      Matrix.cons_val_zero,Matrix.cons_val_one]
    rw [hscalar]
    have hlin : μ*(A:ℚ)*t+μ*(B:ℚ)*u=
        μ*((A:ℚ)*t+(B:ℚ)*u) := by ring
    rw [hlin,mul_pow]
    ring
  refine ⟨A,B,c,hAB,hc,?_⟩
  apply MvPolynomial.map_injective (Int.castRingHom ℚ) Int.cast_injective
  simpa [map_mul,map_pow,map_add,map_C,map_X] using hQ

private theorem zero_residual_no_graph_point {K : Type*} [Field K]
    (P Q : MvPolynomial (Fin 2) K) (m n : ℕ)
    (hP : P.IsHomogeneous m) (hQ : Q.IsHomogeneous n)
    (hcop : IsRelPrime P Q)
    (d e u v : K) (hw : (![d,e] : Fin 2→K)≠0)
    (hunit : e^3*v-d^3*u=1)
    (hgraph : eval ![d,e] P*u-eval ![d,e] Q*v=0)
    (hres : e^3*eval ![d,e] P-d^3*eval ![d,e] Q=0) : False := by
  have hp : eval ![d,e] P=0 := by
    linear_combination v*hres-d^3*hgraph-(eval ![d,e] P)*hunit
  have hq : eval ![d,e] Q=0 := by
    linear_combination u*hres-e^3*hgraph-(eval ![d,e] Q)*hunit
  exact JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C01.PcCurves.no_common_zero
    hP hQ hcop hw hp hq

private theorem integer_zero_residual_no_original_point
    (P Q : Binary) (m n : ℕ)
    (hP : P.IsHomogeneous m) (hQ : Q.IsHomogeneous n)
    (hcop : IsRelPrime (map (Int.castRingHom ℂ) P) (map (Int.castRingHom ℂ) Q))
    (hR : X (1:Fin 2)^3*P-X (0:Fin 2)^3*Q=0)
    (d e u v : ℕ) (hd : 0<d) (_he : 0<e)
    (hunit : e^3*v=d^3*u+1)
    (hgraph : eval ![(d:ℤ),(e:ℤ)] P*(u:ℤ)-
      eval ![(d:ℤ),(e:ℤ)] Q*(v:ℤ)=0) : False := by
  let PC := map (Int.castRingHom ℂ) P
  let QC := map (Int.castRingHom ℂ) Q
  have hPC : PC.IsHomogeneous m := hP.map _
  have hQC : QC.IsHomogeneous n := hQ.map _
  have hdC : (d:ℂ)≠0 := by exact_mod_cast (Nat.ne_of_gt hd)
  have hw : (![(d:ℂ),(e:ℂ)] : Fin 2→ℂ)≠0 := by
    intro h
    have hh := congrFun h (0:Fin 2)
    exact hdC (by simpa using hh)
  have huC : (e:ℂ)^3*(v:ℂ)-(d:ℂ)^3*(u:ℂ)=1 := by
    have h : (e:ℤ)^3*(v:ℤ)=(d:ℤ)^3*(u:ℤ)+1 := by exact_mod_cast hunit
    exact_mod_cast (show (e:ℤ)^3*(v:ℤ)-(d:ℤ)^3*(u:ℤ)=1 by omega)
  have hvec :
      (fun i : Fin 2 => (( ![(d:ℤ),(e:ℤ)] i : ℤ):ℂ))=
        ![(d:ℂ),(e:ℂ)] := by
    funext i
    fin_cases i <;> simp
  have hcastP :
      eval ![(d:ℂ),(e:ℂ)] PC=((eval ![(d:ℤ),(e:ℤ)] P:ℤ):ℂ) := by
    have hh := eval_int_map (K:=ℂ) P ![(d:ℤ),(e:ℤ)]
    rw [hvec] at hh
    simpa only [PC] using hh
  have hcastQ :
      eval ![(d:ℂ),(e:ℂ)] QC=((eval ![(d:ℤ),(e:ℤ)] Q:ℤ):ℂ) := by
    have hh := eval_int_map (K:=ℂ) Q ![(d:ℤ),(e:ℤ)]
    rw [hvec] at hh
    simpa only [QC] using hh
  have hgC :
      eval ![(d:ℂ),(e:ℂ)] PC*(u:ℂ)-
        eval ![(d:ℂ),(e:ℂ)] QC*(v:ℂ)=0 := by
    rw [hcastP,hcastQ]
    exact_mod_cast hgraph
  have hRC :
      (X (1:Fin 2)^3*PC-X (0:Fin 2)^3*QC : MvPolynomial (Fin 2) ℂ)=0 := by
    have h := congrArg (map (Int.castRingHom ℂ)) hR
    simpa [PC,QC,map_sub,map_mul,map_pow,map_X] using h
  have hrC :
      (e:ℂ)^3*eval ![(d:ℂ),(e:ℂ)] PC-
        (d:ℂ)^3*eval ![(d:ℂ),(e:ℂ)] QC=0 := by
    have h := congrArg (eval ![(d:ℂ),(e:ℂ)]) hRC
    simpa using h
  exact zero_residual_no_graph_point PC QC m n hPC hQC hcop
    (d:ℂ) (e:ℂ) (u:ℂ) (v:ℂ) hw huC hgC hrC

