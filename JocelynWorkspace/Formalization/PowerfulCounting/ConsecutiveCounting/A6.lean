    · have h1:m 1=1:=by omega
      have h3:m 3=1:=by omega
      exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl (hext 3 1 0 1 h0 h1 h2 h3)))))))
    · have h1:m 1=0:=by omega
      have h3:m 3=1:=by omega
      exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl (hext 4 0 0 1 h0 h1 h2 h3))))))
  · rcases h0 with h0|h0|h0|h0|h0
    · have h1:m 1=4:=by omega
      have h3:m 3=0:=by omega
      exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl (hext 0 4 1 0 h0 h1 h2 h3)))))
    · have h1:m 1=3:=by omega
      have h3:m 3=0:=by omega
      exact Or.inr (Or.inr (Or.inr (Or.inl (hext 1 3 1 0 h0 h1 h2 h3))))
    · have h1:m 1=2:=by omega
      have h3:m 3=0:=by omega
      exact Or.inr (Or.inr (Or.inl (hext 2 2 1 0 h0 h1 h2 h3)))
    · have h1:m 1=1:=by omega
      have h3:m 3=0:=by omega
      exact Or.inr (Or.inl (hext 3 1 1 0 h0 h1 h2 h3))
    · have h1:m 1=0:=by omega
      have h3:m 3=0:=by omega
