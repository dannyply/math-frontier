  let E₀ := G.coeff (ConsecutiveCountingA5ActualFull12Graph.ix 1 0 2 0)
  let E₁ := G.coeff (ConsecutiveCountingA5ActualFull12Graph.ix 1 0 1 1)
  let E₂ := G.coeff (ConsecutiveCountingA5ActualFull12Graph.ix 1 0 0 2)
