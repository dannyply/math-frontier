    have hT := JocelynClaims.claim_3fa2d2f96e9de72be9377526617a680d7d57bf1237521751f2cc9328cc11e338
      D hD f hf.1 hf.2.1 (hf.2.2.trans hsumD)
    change T.Finite ∧ T.ncard ≤ 2 * D^3 at hT
    let S : Set ((ℕ × ℕ) × (ℕ × ℕ)) := {z |
      1 ≤ z.1.1 ∧ 1 ≤ z.1.2 ∧ 1 ≤ z.2.1 ∧ 1 ≤ z.2.2 ∧
      ((z.1.2 ^ 3 * z.2.2 : ℕ) : ℤ) =
        ((z.1.1 ^ 3 * z.2.1 : ℕ) : ℤ) + h ∧
      MvPolynomial.eval ![(z.1.1 : ℤ),(z.1.2 : ℤ),(z.2.1 : ℤ),(z.2.2 : ℤ)] G = 0}
    change S.Finite ∧ (S.ncard : ℝ) ≤ ((2 * D^3 : ℕ) : ℝ)
    let π : ((ℕ × ℕ) × (ℕ × ℕ)) → (Fin 2 → ℚ) :=
      fun z => ![(z.1.1 : ℚ) / (z.1.2 : ℚ),(z.2.2 : ℚ) / (z.2.1 : ℚ)]
    let F := MvPolynomial.map (Int.castRingHom ℚ) G
    have hFbhom : A5NongeometricDehomCore.Bihom F α β := by
      intro m hm
      apply hGhom m
      apply MvPolynomial.mem_support_iff.mpr
      intro hz
      apply MvPolynomial.mem_support_iff.mp hm
      change (Int.castRingHom ℚ) (MvPolynomial.coeff m G) = 0
      rw [hz,map_zero]
    have hmap : ∀ z ∈ S, π z ∈ T := by
      rintro ⟨⟨d,e⟩,⟨u,v⟩⟩ hz
      rcases hz with ⟨hd,he,hu,hv,hshift,hzero⟩
      have heNat : e ≠ 0 := by
        have he' : 1 ≤ e := he
        omega
      have huNat : u ≠ 0 := by
        have hu' : 1 ≤ u := hu
        omega
      have he0 : (e : ℚ) ≠ 0 := by exact_mod_cast heNat
      have hu0 : (u : ℚ) ≠ 0 := by exact_mod_cast huNat
      have hcastvec :
          (fun i : Fin 4 => ((![((d : ℤ)),((e : ℤ)),((u : ℤ)),((v : ℤ))] i : ℤ) : ℚ)) =
            ![(d : ℚ),(e : ℚ),(u : ℚ),(v : ℚ)] := by
        funext i
        fin_cases i <;> simp
      have hzeroQ : MvPolynomial.eval ![(d : ℚ),(e : ℚ),(u : ℚ),(v : ℚ)] F = 0 := by
        have hc := A5NongeometricOriginalPopulation.eval_int_cast G ![(d : ℤ),(e : ℤ),(u : ℤ),(v : ℤ)]
        rw [hcastvec] at hc
        rw [hc]
        simpa only [hzero,Int.cast_zero]
      have hs := A5NongeometricOriginalPopulation.eval_dehom_scaled F α β hFbhom
        ![(d : ℚ),(e : ℚ),(u : ℚ),(v : ℚ)] he0 hu0
      have hdehom : A5NongeometricDehom.dehom F = f := by
        exact (A5NongeometricDehom.int_dehom_eq G).symm
      rw [hdehom] at hs
      have hprod :
          (e : ℚ)^α * (u : ℚ)^β *
            MvPolynomial.eval (π ((d,e),(u,v))) f = 0 := by
        simpa [π] using hs.symm.trans hzeroQ
      have hcoef : (e : ℚ)^α * (u : ℚ)^β ≠ 0 :=
        mul_ne_zero (pow_ne_zero _ he0) (pow_ne_zero _ hu0)
      exact (mul_eq_zero.mp hprod).resolve_left hcoef
    have hinj : Set.InjOn π S := by
      rintro ⟨⟨d,e⟩,⟨u,v⟩⟩ hz ⟨⟨d',e'⟩,⟨u',v'⟩⟩ hz' hπ
      rcases hz with ⟨hd,he,hu,hv,hshift,hzero⟩
      rcases hz' with ⟨hd',he',hu',hv',hshift',hzero'⟩
      have hr1 : (d : ℚ)/(e : ℚ) = (d' : ℚ)/(e' : ℚ) := by
        simpa [π] using congrFun hπ (0 : Fin 2)
      have hr2 : (v : ℚ)/(u : ℚ) = (v' : ℚ)/(u' : ℚ) := by
        simpa [π] using congrFun hπ (1 : Fin 2)
      obtain ⟨hdd,hee,huu,hvv⟩ :=
        A6ResidualCubicRatios.original_ratio_injective
          h hsign d e u v d' e' u' v' hd he hu hv hd' he' hu' hv'
          hshift hshift' hr1 hr2
      subst d'; subst e'; subst u'; subst v'
      rfl
    have hfin : S.Finite := Set.Finite.of_injOn hmap hinj hT.1
    have hcard : S.ncard ≤ 2 * D^3 :=
      (Set.ncard_le_ncard_of_injOn π hmap hinj hT.1).trans hT.2
    exact ⟨hfin, by exact_mod_cast hcard⟩

end A6ResidualCubicNongeometric

namespace A6CentralResidual
open MvPolynomial
abbrev Point := Fin 4 → ℕ
abbrev Four := MvPolynomial (Fin 4) ℤ
def Good (z : Point) : Prop :=
  (∀ i, 0 < z i) ∧ (z 1)^3*z 3 = (z 0)^3*z 2+1
def Points (x D E : ℝ) (G : Four) : Set Point := {z |
  (∀ i, 0 < z i) ∧ (z 1)^3*z 3=(z 0)^3*z 2+1 ∧
  (z 0 : ℝ)^3*(z 2 : ℝ) ≤ x ∧
  D/2 < (z 0 : ℝ) ∧ (z 0 : ℝ) ≤ D ∧
  E/2 < (z 1 : ℝ) ∧ (z 1 : ℝ) ≤ E ∧
  eval (fun i => (z i : ℤ)) G=0}
def StewartHyp : Prop := ∀ q : ℕ, 3 ≤ q →
  ∀ a : Fin (q+1) → ℤ, Finset.univ.gcd a=1 →
  Squarefree (∑ i : Fin (q+1), C (a i : ℚ)*X (0:Fin 2)^(i:ℕ)*X (1:Fin 2)^(q-(i:ℕ))) →
  ∀ m : ℤ, m≠0 →
  {rs : ℤ×ℤ | Int.gcd rs.1 rs.2=1 ∧
    ∑ i : Fin (q+1), a i*rs.1^(i:ℕ)*rs.2^(q-(i:ℕ))=m}.encard ≤
      ((2800*q^(1+m.natAbs.primeFactors.card):ℕ):ℕ∞)

theorem good_coprime {z : Point} (hz : Good z) :
    (z 0).Coprime (z 1) ∧ (z 2).Coprime (z 3) := by
  apply A6ResidualCubicRatios.both_coprime (z 0) (z 1) (z 2) (z 3) 1 (Or.inl rfl)
  exact_mod_cast hz.2

theorem primitive_line_unique (p q : ℤ) (hpq : (p,q)≠(0,0))
    {a b c d : ℕ} (ha : 0<a) (hb : 0<b) (hc : 0<c) (hd : 0<d)
    (hab : a.Coprime b) (hcd : c.Coprime d)
    (h1 : p*(a:ℤ)+q*(b:ℤ)=0) (h2 : p*(c:ℤ)+q*(d:ℤ)=0) :
    a=c ∧ b=d := by
  have hp : p≠0 := by
    intro hp
    have hq : q=0 := by
      have hb' : (b:ℤ)≠0 := by exact_mod_cast (Nat.ne_of_gt hb)
      have hqb : q*(b:ℤ)=0 := by simpa [hp] using h1
      exact (mul_eq_zero.mp hqb).resolve_right hb'
    exact hpq (by simp [hp,hq])
  have hprod : p*((a:ℤ)*(d:ℤ)-(c:ℤ)*(b:ℤ))=0 := by
    linear_combination (d:ℤ)*h1-(b:ℤ)*h2
  have hcross : (a:ℚ)*(d:ℚ)=(c:ℚ)*(b:ℚ) := by
    exact_mod_cast (sub_eq_zero.mp ((mul_eq_zero.mp hprod).resolve_left hp))
  have hb0 : (b:ℚ)≠0 := by positivity
  have hd0 : (d:ℚ)≠0 := by positivity
  exact A6ResidualCubicRatios.coprime_rat_div_unique a b c d
    (by omega) (by omega) (by omega) hab hcd ((div_eq_div_iff hb0 hd0).mpr hcross)

theorem fibre_quotient_unique {d e u v u' v' : ℕ} (he : 0<e)
    (h1 : e^3*v=d^3*u+1) (h2 : e^3*v'=d^3*u'+1)
    (hq : u/e^3=u'/e^3) : u=u' ∧ v=v' := by
  let w : ℤ := (u:ℤ)*(v':ℤ)-(u':ℤ)*(v:ℤ)
  have he3 : (0:ℤ)<(e:ℤ)^3 := by positivity
  have h1z : (e:ℤ)^3*(v:ℤ)=(d:ℤ)^3*(u:ℤ)+1 := by exact_mod_cast h1
  have h2z : (e:ℤ)^3*(v':ℤ)=(d:ℤ)^3*(u':ℤ)+1 := by exact_mod_cast h2
  have hw : (u:ℤ)-(u':ℤ)=(e:ℤ)^3*w := by
    dsimp [w]
    linear_combination (u':ℤ)*h1z-(u:ℤ)*h2z
  have hm : u%e^3<e^3 := Nat.mod_lt _ (pow_pos he _)
  have hm' : u'%e^3<e^3 := Nat.mod_lt _ (pow_pos he _)
  have hdec := Nat.mod_add_div u (e^3)
  have hdec' := Nat.mod_add_div u' (e^3)
  have hdif : (u:ℤ)-(u':ℤ)=((u%e^3:ℕ):ℤ)-((u'%e^3:ℕ):ℤ) := by
    have hd1 := congrArg (fun k : ℕ => (k:ℤ)) hdec
    have hd2 := congrArg (fun k : ℕ => (k:ℤ)) hdec'
    norm_num only [Nat.cast_add,Nat.cast_mul,Nat.cast_pow] at hd1 hd2
    rw [hq] at hd1
    linear_combination hd2-hd1
  have hmz : ((u%e^3:ℕ):ℤ)<(e:ℤ)^3 := by exact_mod_cast hm
  have hmz' : ((u'%e^3:ℕ):ℤ)<(e:ℤ)^3 := by exact_mod_cast hm'
  have hr0 : (0:ℤ)≤(u%e^3:ℕ) := by positivity
  have hr0' : (0:ℤ)≤(u'%e^3:ℕ) := by positivity
  have hw0 : w=0 := by
    by_contra h
    rcases (by omega : w≤-1 ∨ 1≤w) with h | h
    · have hb := mul_le_mul_of_nonneg_left h (le_of_lt he3)
      nlinarith
    · have hb := mul_le_mul_of_nonneg_left h (le_of_lt he3)
      nlinarith
  have huu : u=u' := by
    have hh : (u:ℤ)-(u':ℤ)=0 := by simpa only [hw0,mul_zero] using hw
    exact_mod_cast (sub_eq_zero.mp hh)
  have hvv : v=v' := by
    rw [huu] at h1
    exact Nat.eq_of_mul_eq_mul_left (pow_pos he _) (h1.trans h2.symm)
  exact ⟨huu,hvv⟩

theorem central_size (x D E : ℝ) (hx : 2≤x)
    (hDE : x^((21:ℝ)/50)≤D*E) :
    x≤(D*E)^3 := by
  have hx0 : 0<x := by linarith
  have hlow : 0≤x^((21:ℝ)/50) := Real.rpow_nonneg (le_of_lt hx0) _
  have hpow : (x^((21:ℝ)/50))^3≤(D*E)^3 :=
    pow_le_pow_left₀ hlow hDE 3
  have hxpow : x≤x^((63:ℝ)/50) := by
    calc
      x=x^(1:ℝ) := (Real.rpow_one _).symm
      _≤x^((63:ℝ)/50) := Real.rpow_le_rpow_of_exponent_le (by linarith) (by norm_num)
  have heq : (x^((21:ℝ)/50))^3=x^((63:ℝ)/50) := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul (le_of_lt hx0)]
    norm_num
  linarith

theorem divisor_line_count (x D E : ℝ) (hx : 2≤x)
    (hDE : x^((21:ℝ)/50)≤D*E) (p q : ℤ) (hpq : (p,q)≠(0,0)) :
    (Points x D E (C p*X 0+C q*X 1)).Finite ∧
    ((Points x D E (C p*X 0+C q*X 1)).ncard:ℝ)≤65 := by
  classical
  let S := Points x D E (C p*X 0+C q*X 1)
  by_cases hempty : S=∅
  · change S.Finite ∧ (S.ncard:ℝ)≤_
    rw [hempty]
    simp
  obtain ⟨z0,hz0⟩ := Set.nonempty_iff_ne_empty.mpr hempty
  have hfix : ∀ z∈S, z 0=z0 0 ∧ z 1=z0 1 := by
    intro z hz
    have hzG : Good z := ⟨hz.1,hz.2.1⟩
    have hz0G : Good z0 := ⟨hz0.1,hz0.2.1⟩
    have hline : p*(z 0:ℤ)+q*(z 1:ℤ)=0 := by simpa [S,Points] using hz.2.2.2.2.2.2.2
    have hline0 : p*(z0 0:ℤ)+q*(z0 1:ℤ)=0 := by simpa [S,Points] using hz0.2.2.2.2.2.2.2
    exact primitive_line_unique p q hpq (hz.1 0) (hz.1 1) (hz0.1 0) (hz0.1 1)
      (good_coprime hzG).1 (good_coprime hz0G).1 hline hline0
  let f : Point→ℕ := fun z=>z 2/(z 1)^3
  have hmap : ∀ z∈S, f z∈(Finset.range 65:Finset ℕ) := by
    intro z hz
    have hd : (0:ℝ)<(z 0:ℝ) := by exact_mod_cast hz.1 0
    have he : (0:ℝ)<(z 1:ℝ) := by exact_mod_cast hz.1 1
    have hD : D<2*(z 0:ℝ) := by linarith [hz.2.2.2.1]
    have hE : E<2*(z 1:ℝ) := by linarith [hz.2.2.2.2.2.1]
    have hDP : 0<D := by linarith [hz.2.2.2.2.1]
    have hEP : 0<E := by linarith [hz.2.2.2.2.2.2.1]
    have hbox : D*E<4*(z 0:ℝ)*(z 1:ℝ) := by nlinarith
    have hp3 : (D*E)^3<(4*(z 0:ℝ)*(z 1:ℝ))^3 :=
      pow_lt_pow_left₀ hbox (by positivity) (by norm_num : (3:ℕ)≠0)
    have hxsize := central_size x D E hx hDE
    have hu : (z 2:ℝ)<64*(z 1:ℝ)^3 := by
      by_contra hn
      have hule : 64*(z 1:ℝ)^3≤(z 2:ℝ) := le_of_not_gt hn
      have hm := mul_le_mul_of_nonneg_left hule (le_of_lt (pow_pos hd 3))
      have hh := hz.2.2.1
      nlinarith
    have huN : z 2<64*(z 1)^3 := by exact_mod_cast hu
    have hqmul := Nat.div_mul_le_self (z 2) ((z 1)^3)
    have he3N : 0<(z 1)^3 := pow_pos (hz.1 1) _
    apply Finset.mem_range.mpr
    dsimp [f]
    by_contra hn
    have hq65 : 65≤z 2/(z 1)^3 := by omega
    have hmul := Nat.mul_le_mul_right ((z 1)^3) hq65
    nlinarith
  have hinj : Set.InjOn f S := by
    intro z hz w hw hfw
    have hzz := hfix z hz
    have hww := hfix w hw
    have hd : z 0=w 0 := hzz.1.trans hww.1.symm
    have he : z 1=w 1 := hzz.2.trans hww.2.symm
    have huq : z 2/(z 1)^3=w 2/(z 1)^3 := by simpa [f,←he] using hfw
    have hwshift : (z 1)^3*w 3=(z 0)^3*w 2+1 := by simpa [hd,he] using hw.2.1
    obtain ⟨hu,hv⟩ := fibre_quotient_unique (hz.1 1) hz.2.1 hwshift huq
    funext i
    fin_cases i <;> assumption
  have hfinite : S.Finite := Set.Finite.of_injOn hmap hinj (Finset.finite_toSet _)
  have hc : S.ncard≤65 := by
    have hh := Set.ncard_le_ncard_of_injOn f hmap hinj (Finset.finite_toSet (Finset.range 65))
    simpa using hh
  exact ⟨hfinite, by exact_mod_cast hc⟩

theorem binary_cubic_squarefree (u v : ℕ) (hu : 0<u) (hv : 0<v) :
    Squarefree (C (v:ℚ)*X (1:Fin 2)^3-C (u:ℚ)*X (0:Fin 2)^3) := by
  classical
  let F : MvPolynomial (Fin 2) ℚ :=
    C (v:ℚ)*X (1:Fin 2)^3-C (u:ℚ)*X (0:Fin 2)^3
  have hF : F≠0 := by
    intro h
    have he := congrArg (eval ![(0:ℚ),1]) h
    have hv0 : (v:ℚ)≠0 := by positivity
    simpa [F,hv0] using he
  intro g hgg
  by_contra hg
  have hg0 : g≠0 := by
    intro h
    rcases hgg with ⟨r,hr⟩
    exact hF (by simpa [F,h] using hr)
  obtain ⟨p,hp,hpg⟩ := WfDvdMonoid.exists_irreducible_factor hg hg0
  have hpp : p*p∣F := dvd_trans (mul_dvd_mul hpg hpg) hgg
  have hder : ∀ i : Fin 2, p∣pderiv i F := by
    intro i
    rcases hpp with ⟨r,hr⟩
    refine ⟨pderiv i p*r+pderiv i p*r+p*pderiv i r,?_⟩
    rw [hr,pderiv_mul,pderiv_mul]
    ring
  have hC3 : (C (3:ℚ):MvPolynomial (Fin 2) ℚ)=3 := map_natCast C 3
  have h0 : p∣C (-(3:ℚ)*(u:ℚ))*X (0:Fin 2)^2 := by
    have heq : pderiv (0:Fin 2) F=C (-(3:ℚ)*(u:ℚ))*X (0:Fin 2)^2 := by
      norm_num [F,pderiv_mul,pderiv_pow,hC3] <;> ring
    rw [←heq]
    exact hder 0
  have h1 : p∣C ((3:ℚ)*(v:ℚ))*X (1:Fin 2)^2 := by
    have heq : pderiv (1:Fin 2) F=C ((3:ℚ)*(v:ℚ))*X (1:Fin 2)^2 := by
      norm_num [F,pderiv_mul,pderiv_pow,hC3] <;> ring
    rw [←heq]
    exact hder 1
  have hnc : ∀ c : ℚ, c≠0 → ¬p∣C c := by
    intro c hc hpc
    have huC : IsUnit (C c : MvPolynomial (Fin 2) ℚ) :=
      (isUnit_iff_ne_zero.mpr hc).map C
    exact hp.not_isUnit (isUnit_of_dvd_unit hpc huC)
  have hx0sq : p∣X (0:Fin 2)^2 :=
    (hp.prime.dvd_mul.mp h0).resolve_left (hnc _ (by positivity))
  have hx1sq : p∣X (1:Fin 2)^2 :=
    (hp.prime.dvd_mul.mp h1).resolve_left (hnc _ (by positivity))
  have hx0 : p∣X (0:Fin 2) := hp.prime.dvd_of_dvd_pow hx0sq
  have hx1 : p∣X (1:Fin 2) := hp.prime.dvd_of_dvd_pow hx1sq
  have hirr : Irreducible (X (0:Fin 2) : MvPolynomial (Fin 2) ℚ) := by
    apply irreducible_of_totalDegree_eq_one (by simp)
    intro c hc
    apply isUnit_of_dvd_one
    simpa [coeff_X] using hc (Finsupp.single (0:Fin 2) 1)
  have hass := A5NongeometricOwned.associated_of_irreducibles_dvd hp hirr hx0
  have hXX : X (0:Fin 2)∣(X (1:Fin 2):MvPolynomial (Fin 2) ℚ) :=
    dvd_trans hass.symm.dvd hx1
  rcases hXX with ⟨r,hr⟩
  have he := congrArg (eval ![(0:ℚ),1]) hr
  simpa using he

theorem stewart_cubic_count (hSt : StewartHyp) (u v : ℕ)
    (hu : 0<u) (hv : 0<v) (hcop : u.Coprime v) :
    let T : Set (ℤ×ℤ) := {rs | Int.gcd rs.1 rs.2=1 ∧
      (v:ℤ)*rs.2^3-(u:ℤ)*rs.1^3=1}
    T.Finite ∧ T.ncard≤8400 := by
  classical
  let a : Fin 4→ℤ := ![(v:ℤ),0,0,-(u:ℤ)]
  have hcontent : Finset.univ.gcd a=1 := by
    rw [← Finset.normalize_gcd,normalize_eq_one]
    apply isUnit_of_dvd_one
    have hvd : Finset.univ.gcd a∣(v:ℤ) := by
      rcases Finset.gcd_dvd (f := a) (Finset.mem_univ (0:Fin 4)) with ⟨c,hc⟩
      refine ⟨c,?_⟩
      first | simpa [a,mul_comm] using hc | simpa [a,mul_comm] using hc.symm
    have hud : Finset.univ.gcd a∣(u:ℤ) := by
      have hneg : Finset.univ.gcd a∣-(u:ℤ) := by
        rcases Finset.gcd_dvd (f := a) (Finset.mem_univ (3:Fin 4)) with ⟨c,hc⟩
        refine ⟨c,?_⟩
        first | simpa [a,mul_comm] using hc | simpa [a,mul_comm] using hc.symm
      simpa using dvd_neg.mpr hneg
    have hcomb : (u:ℤ)*Nat.gcdA u v+(v:ℤ)*Nat.gcdB u v=1 := by
      rw [←Nat.gcd_eq_gcd_ab,hcop.gcd_eq_one]
      norm_num
    rw [←hcomb]
    exact dvd_add (dvd_mul_of_dvd_left hud _) (dvd_mul_of_dvd_left hvd _)
  have hsq : Squarefree (∑ i : Fin (3+1),
      C (a i:ℚ)*X (0:Fin 2)^(i:ℕ)*X (1:Fin 2)^(3-(i:ℕ))) := by
    convert binary_cubic_squarefree u v hu hv using 1 <;>
      simp [a,Fin.sum_univ_four] <;> ring
  have hb := hSt 3 (by norm_num) a hcontent hsq 1 (by norm_num)
  let T : Set (ℤ×ℤ) := {rs | Int.gcd rs.1 rs.2=1 ∧
    (v:ℤ)*rs.2^3-(u:ℤ)*rs.1^3=1}
  have hT : T.encard≤(8400:ℕ) := by
    simpa [a,Fin.sum_univ_four,T,sub_eq_add_neg] using hb
  have hfin : T.Finite := Set.finite_of_encard_le_coe hT
  have hc : T.ncard≤8400 := by
    rw [Set.Finite.encard_eq_coe_toFinset_card hfin] at hT
    have hcard : hfin.toFinset.card≤8400 := by exact_mod_cast hT
    have heq : (↑hfin.toFinset : Set (ℤ×ℤ))=T := by
      ext rs
      simp
    calc
      T.ncard=(↑hfin.toFinset : Set (ℤ×ℤ)).ncard := congrArg Set.ncard heq.symm
      _=hfin.toFinset.card := Set.ncard_coe_finset _
      _≤8400 := hcard
  exact ⟨hfin,hc⟩

theorem cofactor_line_count (hSt : StewartHyp) (x D E : ℝ)
    (p q : ℤ) (hpq : (p,q)≠(0,0)) :
    (Points x D E (C p*X 2+C q*X 3)).Finite ∧
    ((Points x D E (C p*X 2+C q*X 3)).ncard:ℝ)≤8400 := by
  classical
  let S := Points x D E (C p*X 2+C q*X 3)
  by_cases hempty : S=∅
  · change S.Finite ∧ (S.ncard:ℝ)≤_
    rw [hempty]
    simp
