  refine ⟨hfin,?_⟩
  have hcardR : (S.ncard:ℝ)≤(T.ncard:ℝ) := by exact_mod_cast hcard
  have hδ0 : (0:ℝ)≤((α+3*β:ℕ):ℝ) := Nat.cast_nonneg _
  have hH : 1 ≤ max 1 (L₁^3*T₁) := le_max_left _ _
  have hlog : 0≤Real.log (max 1 (L₁^3*T₁)) := Real.log_nonneg hH
  have hpow : 0≤(max 1 (L₁^3*T₁))^(1/((α+3*β:ℕ):ℝ)) :=
    Real.rpow_nonneg (by linarith) _
  have hfac : 0≤2*((α+3*β:ℕ):ℝ)^3*
      (max 1 (L₁^3*T₁))^(1/((α+3*β:ℕ):ℝ))*
      (Real.log (max 1 (L₁^3*T₁))+((α+3*β:ℕ):ℝ)) := by
    positivity
  calc
    (S.ncard:ℝ)≤(T.ncard:ℝ) := hcardR
    _ ≤ 2*c*((α+3*β:ℕ):ℝ)^3*
        (max 1 (L₁^3*T₁))^(1/((α+3*β:ℕ):ℝ))*
        (Real.log (max 1 (L₁^3*T₁))+((α+3*β:ℕ):ℝ)) := hTbound
    _ ≤ 2 * |c| *((α+3*β:ℕ):ℝ)^3*
        (max 1 (L₁^3*T₁))^(1/((α+3*β:ℕ):ℝ))*
        (Real.log (max 1 (L₁^3*T₁))+((α+3*β:ℕ):ℝ)) := by
      apply mul_le_mul_of_nonneg_right _ (add_nonneg hlog hδ0)
      apply mul_le_mul_of_nonneg_right _ hpow
      apply mul_le_mul_of_nonneg_right _ (pow_nonneg hδ0 3)
      exact mul_le_mul_of_nonneg_left (le_abs_self c) (by norm_num)

