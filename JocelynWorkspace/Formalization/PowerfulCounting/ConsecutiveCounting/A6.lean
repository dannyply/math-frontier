            ∀ M j : ℕ, (factorCellOutside x D E M j G).Finite ∧
              ((factorCellOutside x D E M j G).ncard:ℝ)≤C := by
  obtain ⟨C,hC,hcount⟩ :=
    hEab
      hSt N hN
  refine ⟨C,hC,?_⟩
  intro x D E hx hD hE hDE a b hab habN G hBi hirr hcase M j
  have hT : (residualPopulation x D E G).Finite ∧
      ((residualPopulation x D E G).ncard:ℝ)≤C :=
    hcount x D E hx hD hE hDE a b hab habN G hBi hirr hcase
  have hmap : ∀ z∈factorCellOutside x D E M j G,
      toVector z∈residualPopulation x D E G := by
    intro z hz
