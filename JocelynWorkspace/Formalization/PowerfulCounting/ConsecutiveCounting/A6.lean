    rw [div_le_iff₀ hn0]
    nlinarith

theorem dyadic_index (d : ℕ) (hd : 1 ≤ d) :
    (2 : ℝ) ^ (Nat.clog 2 d) / 2 < (d : ℝ) ∧ (d : ℝ) ≤ (2 : ℝ) ^ (Nat.clog 2 d) := by
  have hup : d ≤ 2 ^ Nat.clog 2 d := Nat.le_pow_clog (by norm_num) d
  refine ⟨?_, by exact_mod_cast hup⟩
  rcases Nat.lt_or_ge 1 d with h | h
  · have hlt := Nat.pow_pred_clog_lt_self (by norm_num : 1 < 2) h
    have hc : Nat.clog 2 d ≠ 0 := by
      intro h0
      rw [h0] at hup
      simp at hup
      omega
    obtain ⟨p, hp⟩ : ∃ p, Nat.clog 2 d = p + 1 := ⟨Nat.clog 2 d - 1, by omega⟩
    rw [hp] at hlt
    simp only [Nat.pred_succ, Nat.pred_eq_sub_one, Nat.add_sub_cancel] at hlt
    have hltR : (2 : ℝ) ^ p < (d : ℝ) := by exact_mod_cast hlt
    rw [hp, pow_succ]
    have h2 : (2 : ℝ) ^ p * 2 / 2 = 2 ^ p := by ring
    rw [h2]
    exact hltR
  · have hd1 : d = 1 := by omega
    subst hd1
    simp [Nat.clog_one_right]
    norm_num

theorem clog_le_of_le_pow' {d m : ℕ} (h : d ≤ 2 ^ m) : Nat.clog 2 d ≤ m := by
