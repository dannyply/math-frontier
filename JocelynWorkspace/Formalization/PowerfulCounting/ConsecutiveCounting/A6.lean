    binarySupportProduct (M := M) a b hne s hcover
  refine ⟨j, ?_, ?_, ?_⟩
  · exact haj ha
  · have hlt := hbj hb
    omega
  · intro f
    simpa only [hcard] using hprod f

private theorem rational_nonpure_classification
