namespace JocelynClaims

theorem claim_1faecb89cbcf2c0602d72af0a30e0c957db438c8b241af5a41ae6d27192eeaa1 :
∀ a b m q d0 e0 : ℤ, Int.gcd a b = 1 → m ≠ 0 → q ≠ 0 →
  a * d0 + b * e0 = 1 →
  let μ : ℕ := m.natAbs
  let g : ℕ := Nat.gcd μ (a * b).natAbs
  let Q : ℕ := μ ^ 5 / g ^ 4
  ∃ R : Finset ℤ, 0 < Q ∧ R.card ≤ 6 ^ 6 * 3 ^ μ.primeFactors.card ∧
    ∀ h : ℤ,
      (m ^ 5 ∣ q * (m * e0 - a * h) ^ 3 -
        a ^ 3 * ((a * (m * d0 + b * h)) ^ 2 +
          5 * (a * (m * d0 + b * h)) * (b * (m * e0 - a * h)) +
          10 * (b * (m * e0 - a * h)) ^ 2)) →
      (m ^ 5 ∣ q * (m * d0 + b * h) ^ 3 +
        b ^ 3 * ((b * (m * e0 - a * h)) ^ 2 +
          5 * (b * (m * e0 - a * h)) * (a * (m * d0 + b * h)) +
          10 * (a * (m * d0 + b * h)) ^ 2)) →
      ∃ r ∈ R, (Q : ℤ) ∣ h - r := by
  intro a b m q d0 e0 hab hm _hq hbez
  simpa only [A6Local.NE, A6Local.ND, A6Local.D, A6Local.E, A6Local.R3] using
    A6P3CRT.global_cover a b m q d0 e0 hab hm hbez

end JocelynClaims

