private theorem dR (z:I) (hz:z ≠ 0):(1:O) ≤ |(z:O)|:=by
  have h:(1:I) ≤ |z|:=by
    rcases le_total 0 z with h | h
    · rw [abs_of_nonneg h]
      omega
    · rw [abs_of_nonpos h]
      omega
  exact_mod_cast h
private theorem dS (T z:I) (hT:0 < T)
 (hz:z ≠ 0) (hd:T ∣ z):(T:O) ≤ |(z:O)|:=by
  obtain ⟨r,hr⟩:= hd
  have hr0:r ≠ 0:=by
    intro hzero
    rw [hzero,mul_zero] at hr
    exact hz hr
  have hr1:= dR r hr0
  have hTR:0 < (T:O):=by exact_mod_cast hT
  have heq:|(z:O)| = (T:O) * |(r:O)|:=by
    have hh:(z:O) = (T:O) * (r:O):=by exact_mod_cast hr
    rw [hh,abs_mul,abs_of_pos hTR]
  rw [heq]
  nlinarith
private theorem dT
 (ell q h J:I) (hell:ell ≠ 0) (hq:q ≠ 0)
 (hh:0 < h) (hJ:0 < J)
 (hstep:((ell.natAbs ^ 7:U):I) ∣ q * h ^ 3 * J ^ 4):
 |(ell:O)| ^ 7 ≤ |(q:O)| * (h:O) ^ 3 * (J:O) ^ 4:=by
  have hT:(0:I) < ((ell.natAbs ^ 7:U):I):=by
    exact_mod_cast pow_pos (Int.natAbs_pos.mpr hell) 7
  have hz:q * h ^ 3 * J ^ 4 ≠ 0:=
    mul_ne_zero (mul_ne_zero hq (pow_ne_zero 3 (ne_of_gt hh)))
      (pow_ne_zero 4 (ne_of_gt hJ))
  have hb:= dS _ _ hT hz hstep
  have hhR:0 < (h:O):=by exact_mod_cast hh
  have hJR:0 < (J:O):=by exact_mod_cast hJ
  have hAbs:(ell.natAbs:O) = |(ell:O)|:=by
    have ht:= congrArg (fun z:I => (z:O)) (aM ell)
    simpa only [bo,Int.cast_abs] using ht
  simpa only [bo,bp,aD,Int.cast_pow,
    abs_mul,abs_pow,abs_of_pos hhR,abs_of_pos hJR,hAbs] using hb
private theorem dU
 (D E M rho d₁ e₁ d₂ e₂:O)
 (hD:0 < D) (hE:0 < E) (hM:0 < M) (hrho:0 < rho)
 (hrho':rho ≤ 2 * D / E)
 (he₁:0 < e₁) (he₂:0 < e₂) (he₁':e₁ ≤ E) (he₂':e₂ ≤ E)
 (h₁:rho < d₁ / e₁) (h₁':d₁ / e₁ ≤ rho * (1 + 1 / M))
 (h₂:rho < d₂ / e₂) (h₂':d₂ / e₂ ≤ rho * (1 + 1 / M)):
 |d₁ * e₂ - d₂ * e₁| ≤ 2 * D * E / M:=by
  have bG:rho * (1 + 1 / M) = rho + rho / M:=by ring
  rw [bG] at h₁' h₂'
  have hdiff:|d₁ / e₁ - d₂ / e₂| ≤ rho / M:=by
    apply abs_le.mpr
    constructor <;> linarith
  have hdet:d₁ * e₂ - d₂ * e₁ =
      (d₁ / e₁ - d₂ / e₂) * (e₁ * e₂):=by
    field_simp [ne_of_gt he₁,ne_of_gt he₂]
  have bI:e₁ * e₂ ≤ E ^ 2:=by
    calc
      e₁ * e₂ ≤ E * E:= mul_le_mul he₁' he₂' he₂.le hE.le
      _ = E ^ 2:=by ring
  have hrM:0 ≤ rho / M:= (div_pos hrho hM).le
  calc
    |d₁ * e₂ - d₂ * e₁| = |d₁ / e₁ - d₂ / e₂| * (e₁ * e₂):=by
      rw [hdet,abs_mul,abs_of_pos (mul_pos he₁ he₂)]
    _ ≤ (rho / M) * (e₁ * e₂):=
      ak hdiff (mul_pos he₁ he₂).le
    _ ≤ (rho / M) * E ^ 2:= am bI hrM
    _ ≤ ((2 * D / E) / M) * E ^ 2:=
      ak (aK hrho' hM.le) (sq_nonneg E)
    _ = 2 * D * E / M:=by field_simp [ne_of_gt hE,ne_of_gt hM]
private theorem dV
 (a b d₀ e₀ h y₁ y₂ D E M rho:O)
 (hD:0 < D) (hE:0 < E) (hM:0 < M) (hrho:0 < rho)
 (hrho':rho ≤ 2 * D / E) (hh:0 < h)
 (hell:a * d₀ + b * e₀ ≠ 0)
 (he₁:0 < e₀ - a * h * y₁) (he₂:0 < e₀ - a * h * y₂)
 (he₁':e₀ - a * h * y₁ ≤ E) (he₂':e₀ - a * h * y₂ ≤ E)
 (h₁:rho < (d₀ + b * h * y₁) / (e₀ - a * h * y₁))
 (h₁':(d₀ + b * h * y₁) / (e₀ - a * h * y₁) ≤ rho * (1 + 1 / M))
 (h₂:rho < (d₀ + b * h * y₂) / (e₀ - a * h * y₂))
 (h₂':(d₀ + b * h * y₂) / (e₀ - a * h * y₂) ≤ rho * (1 + 1 / M)):
 |y₁ - y₂| ≤ 2 * D * E / (M * |a * d₀ + b * e₀| * h):=by
  have hc:= dU D E M rho
    (d₀ + b * h * y₁) (e₀ - a * h * y₁)
    (d₀ + b * h * y₂) (e₀ - a * h * y₂)
    hD hE hM hrho hrho' he₁ he₂ he₁' he₂' h₁ h₁' h₂ h₂'
  have hdet:
      (d₀ + b * h * y₁) * (e₀ - a * h * y₂) -
        (d₀ + b * h * y₂) * (e₀ - a * h * y₁) =
      (a * d₀ + b * e₀) * h * (y₁ - y₂):=by ring
  rw [hdet,abs_mul,abs_mul,abs_of_pos hh] at hc
  have hL:0 < |a * d₀ + b * e₀|:= abs_pos.mpr hell
  apply (le_div_iff₀ (mul_pos (mul_pos hM hL) hh)).mpr
  have hcm:= (le_div_iff₀ hM).mp hc
  nlinarith only [hcm]
private theorem dW
 (Z M L h J B Q:O)
 (hZ:0 < Z) (hM:0 < M) (hL:0 < L)
 (hh:0 < h) (hJ:0 < J) (hB:0 < B) (_hQ:0 < Q)
 (hstep:L ^ 7 ≤ Q * h ^ 3 * J ^ 4)
 (bG:Q * Z ^ 4 ≤ h * L ^ 11 * (B * M) ^ 4):
 Z / (M * L * h * J) ≤ B:=by
  have hmul:L ^ 7 * Z ^ 4 ≤ L ^ 7 * (B * M * L * h * J) ^ 4:=by
    calc
      L ^ 7 * Z ^ 4 ≤ (Q * h ^ 3 * J ^ 4) * Z ^ 4:=
        ak hstep (pow_nonneg hZ.le 4)
      _ = (Q * Z ^ 4) * (h ^ 3 * J ^ 4):=by ring
      _ ≤ (h * L ^ 11 * (B * M) ^ 4) * (h ^ 3 * J ^ 4):=
        ak bG (mul_nonneg (pow_nonneg hh.le 3) (pow_nonneg hJ.le 4))
      _ = L ^ 7 * (B * M * L * h * J) ^ 4:=by ring
  have hpow:Z ^ 4 ≤ (B * M * L * h * J) ^ 4:=by
    by_contra hn
    have hp:= mul_pos (pow_pos hL 7) (sub_pos.mpr (lt_of_not_ge hn))
    nlinarith only [hmul,hp]
  have hroot:Z ≤ B * M * L * h * J:=by
    by_contra hn
    have hlt:B * M * L * h * J < Z:= lt_of_not_ge hn
    have hW:0 < B * M * L * h * J:=by positivity
    have h₁:0 < Z - B * M * L * h * J:= sub_pos.mpr hlt
    have h₂:0 < Z + B * M * L * h * J:=by positivity
    have h₃:0 < Z ^ 2 + (B * M * L * h * J) ^ 2:=by positivity
    have hp:= mul_pos (mul_pos h₁ h₂) h₃
    nlinarith only [hpow,hp]
  apply (div_le_iff₀ (mul_pos (mul_pos (mul_pos hM hL) hh) hJ)).mpr
  nlinarith only [hroot]
end P7I
