  · exact three_root_divisor_cover7 hSt R hRh hR0 hthree B hB
  · obtain ⟨T,hT,hcard⟩ := two_linear_divisor_cover7 R htwo B hB
    refine ⟨T,hT,?_⟩
    have h1 : 1 ≤ B.natAbs.divisors.card :=
      Nat.one_le_iff_ne_zero.mpr (by
        intro hz
        have hm := Nat.one_mem_divisors.mpr (Int.natAbs_ne_zero.mpr hB)
        have hc : B.natAbs.divisors = ∅ := Finset.card_eq_zero.mp hz
        simp [hc] at hm)
    have hp : B.natAbs.divisors.card ^ 2 ≤ B.natAbs.divisors.card ^ 8 :=
      Nat.pow_le_pow_right h1 (by omega)
    exact hcard.trans (by nlinarith)

private theorem both_coprime3 (d e u v : ℕ) (h : ℤ)
    (hsign : h = 1 ∨ h = -1)
    (hshift : ((e ^ 3 * v : ℕ) : ℤ) = ((d ^ 3 * u : ℕ) : ℤ) + h) :
    d.Coprime e ∧ u.Coprime v := by
  have hn := (unit_coprime (e ^ 3 * v) (d ^ 3 * u) h hsign hshift).symm
  have hdvd : d ∣ d ^ 3 * u := ⟨d ^ 2 * u, by ring⟩
  have hevd : e ∣ e ^ 3 * v := ⟨e ^ 2 * v, by ring⟩
  have huvd : u ∣ d ^ 3 * u := ⟨d ^ 3, by ring⟩
  have hvvd : v ∣ e ^ 3 * v := ⟨e ^ 3, by ring⟩
  exact ⟨hn.of_dvd hdvd hevd, hn.of_dvd huvd hvvd⟩

private def septic (P Q : MvPolynomial (Fin 2) ℤ) :
    MvPolynomial (Fin 2) ℤ :=
  X 1 ^ 3 * Q - X 0 ^ 3 * P

private theorem septic_homogeneous
    (P Q : MvPolynomial (Fin 2) ℤ)
    (hP : P.IsHomogeneous 4) (hQ : Q.IsHomogeneous 4) :
