    exact hcop (by rw [hz,map_zero];exact dvd_zero _) dvd_rfl
  · intro hz
    apply notunit P bG
    exact hcop dvd_rfl (by rw [hz,map_zero];exact dvd_zero _)
private def bIndex (i j:U):Fin 2 →₀ U:=
  ao 0 i+ao 1 j
private def qIndex (i j k l:U):Fin 4 →₀ U:=
  ao 0 i+ao 1 j+ao 2 k+ao 3 l
private theorem bS (i j i' j':U):
 bIndex i j = bIndex i' j' ↔ i = i' ∧ j = j':=by
  constructor
  · intro h
    have h₀:= congrArg (fun m:Fin 2 →₀ U=>m 0) h
    have h₁:= congrArg (fun m:Fin 2 →₀ U=>m 1) h
    simpa [bIndex] using And.intro h₀ h₁
  · rintro ⟨rfl,rfl⟩
    rfl
private theorem bT (i j k l i' j' k' l':U):
 qIndex i j k l = qIndex i' j' k' l' ↔
 i = i' ∧ j = j' ∧ k = k' ∧ l = l':=by
  constructor
  · intro h
    have h₀:= congrArg (fun m:Fin 4 →₀ U=>m 0) h
    have h₁:= congrArg (fun m:Fin 4 →₀ U=>m 1) h
    have h₂:= congrArg (fun m:Fin 4 →₀ U=>m 2) h
    have h₃:= congrArg (fun m:Fin 4 →₀ U=>m 3) h
