    change 0 ≤ p.eval (param y : ℝ) ∧ p.eval (param y : ℝ) ≤ X
    rw [hpev,←hparamR y]
    exact hvals y.1 y.2
  have hseg : ∀ s ∈ V, ∀ t ∈ V, ∀ z : ℝ,
      (s : ℝ) ≤ z → z ≤ (t : ℝ) →
      G ((r : ℝ)+(J : ℝ)*z) := by
    intro s hs t ht z hsz hzt
    obtain ⟨u,hu,rfl⟩ := Finset.mem_map.mp hs
    obtain ⟨v,hv,rfl⟩ := Finset.mem_map.mp ht
    change (param u : ℝ) ≤ z at hsz
