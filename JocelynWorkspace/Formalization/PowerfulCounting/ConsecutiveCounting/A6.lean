  fun D E M => {j | D / (2 * E) ≤ rho D E M j ∧ rho D E M j ≤ 2 * D / E};
let relativeCell : ℝ → ℝ → ℕ → ℕ → Set ℝ :=
  fun D E M j =>
    Set.Ioc (rho D E M j) (rho D E M j * (1 + 1 / (M : ℝ)));
