noncomputable section
namespace P7Q
open Polynomial
private theorem de (p:U) (F:ae):
 ar (an (ZMod p)) F = 0 ↔
 Polynomial.C (p:I) ∣ F:=by
  rw [Polynomial.ext_iff,ax]
  simp [aB]
private theorem df (p:U) (k:U) (F:ae):
 C ((p:I) ^ k) ∣ F ∨
 ∃ v < k,∃ H:ae,
 F = C ((p:I) ^ v) * H ∧
 ar (an (ZMod p)) H ≠ 0:=by
  induction k generalizing F with
  | zero => left;simp
  | succ k ih =>
    by_cases h:C (p:I) ∣ F
    · obtain ⟨G,hG⟩:= h
      rcases ih G with hD | ⟨v,hv,H,hH,hn⟩
      · left
        obtain ⟨A,hA⟩:= hD
        refine ⟨A,?_⟩
        rw [hG,hA,pow_succ',bm,mul_assoc]
      · right
        refine ⟨v + 1,by omega,H,?_,hn⟩
        rw [hG,hH,pow_succ',bm,mul_assoc]
    · right
      refine ⟨0,by omega,F,by simp,?_⟩
      intro hz
      exact h ((de p F).mp hz)
private theorem dg (F:ae) (c:I) (j:U):
 (F.comp (C c * X)).coeff j = c ^ j * F.coeff j:=by
  induction F using Polynomial.induction_on' with
  | add F G hF hG =>
    simp only [Polynomial.add_comp,aV,hF,hG]
    ring
  | monomial n a =>
    simp only [← Polynomial.C_mul_X_pow_eq_monomial,aS,
      aX,Polynomial.pow_comp,Polynomial.X_comp]
    simp only [mul_pow,← Polynomial.C_pow,
      aI,Polynomial.coeff_X_pow]
    split_ifs <;> simp_all ; ring
private theorem dh (F:ae) (r p:I) (j:U):
 (F.comp (C r + C p * X)).coeff j =
 p ^ j * ((taylor r) F).coeff j:=by
  have h:C r + C p * X = (X + C r).comp (C p * X):=by
    simp
    ring
  rw [h,← bi,← Polynomial.taylor_apply]
  exact dg ((taylor r) F) p j
private theorem di (p:I) (hp:p ≠ 0) (v:U) (b:I):
 p ^ (v + 1) ∣ p ^ v * b ↔ p ∣ b:=by
  constructor
  · rintro ⟨c,hc⟩
    refine ⟨c,?_⟩
    apply aC (pow_ne_zero v hp)
    calc
      p ^ v * b = p ^ (v + 1) * c:= hc
      _ = p ^ v * (p * c):=by rw [pow_succ];ring
  · rintro ⟨c,rfl⟩
    refine ⟨c,?_⟩
    rw [pow_succ]
    ring
private theorem dj (p:U) [Fact p.Prime]
 (F:ae) (r:I)
 (hF:ar (an (ZMod p)) F ≠ 0):
 ¬ (p:I) ∣ ((taylor r) F).coeff
 (rootMultiplicity (r:ZMod p)
 (ar (an (ZMod p)) F)):=by
  let B:= ar (an (ZMod p)) F
  let m:= rootMultiplicity (r:ZMod p) B
  have ht:(taylor (r:ZMod p)) B ≠ 0:=by
    intro hz
    exact hF ((Polynomial.taylor_eq_zero (r:ZMod p) B).mp hz)
  have hc:= (Polynomial.coeff_natTrailingDegree_ne_zero).mpr ht
  have hm:m = ((taylor (r:ZMod p)) B).natTrailingDegree:=by
    dsimp [m]
    rw [Polynomial.taylor_apply,Polynomial.rootMultiplicity_eq_natTrailingDegree]
  rw [← hm] at hc
  have hc':(ar (an (ZMod p)) ((taylor r) F)).coeff m ≠ 0:=by
    rw [Polynomial.map_taylor]
    exact hc
  rw [Polynomial.coeff_map] at hc'
  exact fun h => hc' ((aB _ p).mpr h)
private theorem dk (p:U) [Fact p.Prime]
 (F H:ae) (r:I) (v:U)
 (hF:ar (an (ZMod p)) F ≠ 0)
 (hroot:(ar (an (ZMod p)) F).IsRoot (r:ZMod p))
 (hH:ar (an (ZMod p)) H ≠ 0)
 (heq:F.comp (C r + C (p:I) * X) = C ((p:I) ^ v) * H):
 1 ≤ v ∧
 v ≤ rootMultiplicity (r:ZMod p)
 (ar (an (ZMod p)) F) ∧
 (ar (an (ZMod p)) H).natDegree ≤
 rootMultiplicity (r:ZMod p)
 (ar (an (ZMod p)) F):=by
  let B:= ar (an (ZMod p)) F
  let m:= rootMultiplicity (r:ZMod p) B
  have hp:(p:I) ≠ 0:=by
    exact_mod_cast (Fact.out:p.Prime).ne_zero
  have hc (j:U):
      (p:I) ^ v * H.coeff j =
        (p:I) ^ j * ((taylor r) F).coeff j:=by
    calc
      (p:I) ^ v * H.coeff j =
          (F.comp (C r + C (p:I) * X)).coeff j:=by
        rw [heq,aI]
      _ = (p:I) ^ j * ((taylor r) F).coeff j:= dh F r p j
  have hm:v ≤ m:=by
    by_contra hn
    have hvm:m + 1 ≤ v:=by omega
    have hd:(p:I) ^ (m + 1) ∣ (p:I) ^ v * H.coeff m:=
      aT (pow_dvd_pow (p:I) hvm) _
    rw [hc m] at hd
    exact dj p F r hF ((di (p:I) hp m _).mp hd)
  have hdeg:(ar (an (ZMod p)) H).natDegree ≤ m:=by
    apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
    intro j hj
    rw [Polynomial.coeff_map]
    apply (aB _ p).mpr
    apply (di (p:I) hp v _).mp
    rw [hc j]
    exact aT (pow_dvd_pow (p:I) (by omega)) _
  have hz:ar (an (ZMod p))
      (F.comp (C r + C (p:I) * X)) = 0:=by
    rw [Polynomial.map_comp]
    have hp0:(an (ZMod p)) (p:I) = 0:=by simp
    simp only [Polynomial.map_add,Polynomial.map_mul,Polynomial.map_C,
      Polynomial.map_X,hp0,Polynomial.C_0,zero_mul,add_zero,
      Polynomial.comp_C]
    change C (B.eval (r:ZMod p)) = 0
    rw [hroot]
    simp
  have hv:1 ≤ v:=by
    by_contra hv
    have hv0:v = 0:=by omega
    have he:F.comp (C r + C (p:I) * X) = H:=by simpa [hv0] using heq
    apply hH
    rw [← he]
    exact hz
  exact ⟨hv,hm,hdeg⟩
private theorem dl (p:U) [Fact p.Prime]
 (B:Polynomial (ZMod p)):
 ∑ r ∈ B.roots.toFinset,rootMultiplicity r B ≤ B.natDegree:=by
  calc
    ∑ r ∈ B.roots.toFinset,rootMultiplicity r B =
        ∑ r ∈ B.roots.toFinset,Multiset.count r B.roots:=by
      simp only [Polynomial.count_roots]
    _ = B.roots.card:= Multiset.toFinset_sum_count_eq B.roots
    _ ≤ B.natDegree:= Polynomial.card_roots' B
private theorem dm (p:U) (F:ae) (r:I):
 (ar (an (ZMod p)) F).eval (r:ZMod p) =
 ((F.eval r:I):ZMod p):=by
  have h:= Polynomial.eval₂_at_apply (p:= F) (an (ZMod p)) r
  rw [← Polynomial.eval_map] at h
  solve | simp
private theorem dn (r J s K:I):
 (C r + C J * X).comp (C s + C K * X) =
 C (r + J * s) + C (J * K) * X:=by
  simp only [Polynomial.add_comp,aS,
    aX,Polynomial.X_comp,Polynomial.C_add,bm]
  ring
private theorem dp (n:I) (F A:ae)
 (h:C n ∣ F):C n ∣ F.comp A:=by
  obtain ⟨G,hG⟩:= h
  refine ⟨G.comp A,?_⟩
  rw [hG,aS,aX]
private theorem dq {R:Type*} [CommRing R] [IsDomain R]
 (p:R) (hp:p ≠ 0) (v k:U) (hv:v ≤ k) (b:R):
 p ^ k ∣ p ^ v * b ↔ p ^ (k - v) ∣ b:=by
  have hk:v + (k - v) = k:= Nat.add_sub_of_le hv
  have hpow:p ^ k = p ^ v * p ^ (k - v):=by rw [← pow_add,hk]
  constructor
  · rintro ⟨c,hc⟩
    refine ⟨c,?_⟩
    apply aC (pow_ne_zero v hp)
    calc
      p ^ v * b = p ^ k * c:= hc
      _ = p ^ v * (p ^ (k - v) * c):=by rw [hpow,mul_assoc]
  · rintro ⟨c,rfl⟩
    refine ⟨c,?_⟩
    rw [← mul_assoc,← pow_add,hk]
private def dr (p:U) (s:I × U):ae:=
  C s.1 + C ((p:I) ^ s.2) * X
private def ds (p:U) (r:I) (s:I × U):I × U:=
  (r + (p:I) * s.1,s.2 + 1)
private theorem dt (p:U) (r:I) (s:I × U):
 (C r + C (p:I) * X).comp (dr p s) =
 dr p (ds p r s):=by
  rw [dr,dn]
  simp only [dr,ds,pow_succ']
private theorem du (p k v:U) (hv:v ≤ k)
 (F H:ae) (r:I) (s:I × U)
 (heq:F.comp (C r + C (p:I) * X) = C ((p:I) ^ v) * H)
 (h:C ((p:I) ^ (k - v)) ∣ H.comp (dr p s)):
 C ((p:I) ^ k) ∣ F.comp (dr p (ds p r s)):=by
  obtain ⟨A,hA⟩:= h
  refine ⟨A,?_⟩
  rw [← dt,← bi,heq,aS,
    aX,hA,← mul_assoc,← bm,
    ← pow_add,Nat.add_sub_of_le hv]
set_option maxHeartbeats 1200000
set_option maxRecDepth 2000
private theorem dv (p:U) [Fact p.Prime]:
 ∀ k:U,0 < k → ∀ F:ae,
 ar (an (ZMod p)) F ≠ 0 →
 ∃ S:Finset (I × U),
 S.card ≤ (ar (an (ZMod p)) F).natDegree ∧
 (∀ s ∈ S,s.2 ≤ k ∧
 C ((p:I) ^ k) ∣ F.comp (dr p s)) ∧
 (∀ r:I,(p:I) ^ k ∣ F.eval r →
 ∃ s ∈ S,∃ t:I,r = s.1 + (p:I) ^ s.2 * t):=by
  classical
  intro k
  induction k using Nat.strong_induction_on with
  | h k ih =>
    intro hk F hF
    let B:= ar (an (ZMod p)) F
    let roots:= B.roots.toFinset
    have hp:(p:I) ≠ 0:=by
      exact_mod_cast (Fact.out:p.Prime).ne_zero
    have branch (a:{a:ZMod p // a ∈ roots}):
        ∃ S:Finset (I × U),
          S.card ≤ rootMultiplicity a.1 B ∧
          (∀ s ∈ S,s.2 ≤ k ∧ C ((p:I) ^ k) ∣ F.comp (dr p s)) ∧
          (∀ r:I,(r:ZMod p) = a.1 → (p:I) ^ k ∣ F.eval r →
            ∃ s ∈ S,∃ t:I,r = s.1 + (p:I) ^ s.2 * t):=by
      let r0:I:= a.1.val
      have har:(r0:ZMod p) = a.1:=by
        solve | simp [r0]
      have hamem:a.1 ∈ B.roots:= Multiset.mem_toFinset.mp a.2
      have ha:B.IsRoot a.1:= (Polynomial.mem_roots hF).mp hamem
      have hm:0 < rootMultiplicity a.1 B:= (Polynomial.rootMultiplicity_pos hF).mpr ha
      have residue (r:I) (hr:(r:ZMod p) = a.1):
          ∃ z:I,r = r0 + (p:I) * z:=by
        have hd:(p:I) ∣ r - r0:=by
          apply (aB _ p).mp
          push_cast
          rw [hr,har,sub_self]
        obtain ⟨z,hz⟩:= hd
        exact ⟨z,by linarith⟩
      rcases df p k (F.comp (C r0 + C (p:I) * X)) with
        hD | ⟨v,hv,H,heq,hH⟩
      · refine ⟨{(r0,1)},?_,?_,?_⟩
        · simp only [Finset.card_singleton]
          omega
        · intro s hs
          have hs':s = (r0,1):= Finset.mem_singleton.mp hs
          subst s
          refine ⟨hk,?_⟩
          simpa only [dr,Prod.fst,Prod.snd,pow_one] using hD
        · intro r hr hd
          obtain ⟨z,hz⟩:= residue r hr
          exact ⟨(r0,1),bu _,z,by simpa only [pow_one] using hz⟩
      · have hred:= dk p F H r0 v hF
          (by simpa only [har] using ha) hH heq
        obtain ⟨S,hSc,hSg,hSv⟩:= ih (k - v) (by omega) (by omega) H hH
        refine ⟨S.image (ds p r0),?_,?_,?_⟩
        · exact (Finset.card_image_le).trans (hSc.trans (by simpa only [har] using hred.2.2))
        · intro s hs
          obtain ⟨b,hb,rfl⟩:= br hs
          obtain ⟨hbexp,hbdiv⟩:= hSg b hb
          refine ⟨by dsimp [ds];omega,?_⟩
          exact du p k v (by omega) F H r0 b heq hbdiv
        · intro r hr hd
          obtain ⟨z,hz⟩:= residue r hr
          have heval:= congrArg (fun Q:ae => Q.eval z) heq
          simp only [Polynomial.eval_comp,aY,aW,
            aR,bh] at heval
          rw [← hz] at heval
          have hdH:(p:I) ^ (k - v) ∣ H.eval z:=by
            apply (dq (p:I) hp v k (by omega) (H.eval z)).mp
            rw [← heval]
            exact hd
          obtain ⟨b,hb,t,ht⟩:= hSv z hdH
          refine ⟨ds p r0 b,Finset.mem_image.mpr ⟨b,hb,rfl⟩,t,?_⟩
          dsimp [ds]
          rw [hz,ht,pow_succ']
          ring
    choose R hRc hRg hRv using branch
    let S:= roots.attach.biUnion R
    refine ⟨S,?_,?_,?_⟩
    · calc
        S.card ≤ ∑ a ∈ roots.attach,(R a).card:= bb
        _ ≤ ∑ a ∈ roots.attach,rootMultiplicity a.1 B:=
          aQ (fun a _ => hRc a)
        _ = ∑ a ∈ roots,rootMultiplicity a B:= Finset.sum_attach roots (fun a:ZMod p => rootMultiplicity a B)
        _ ≤ B.natDegree:= dl p B
    · intro s hs
      obtain ⟨a,ha,hs⟩:= Finset.mem_biUnion.mp hs
      exact hRg a s hs
    · intro r hd
      have hpd:(p:I) ∣ (p:I) ^ k:=by
        have hpow:= pow_dvd_pow (p:I) (show 1 ≤ k by omega)
        simpa only [pow_one] using hpow
      have hpr:(p:I) ∣ F.eval r:= hpd.trans hd
      have hroot:B.IsRoot (r:ZMod p):=by
        change (ar (an (ZMod p)) F).eval (r:ZMod p) = 0
        rw [dm]
        exact (aB _ p).mpr hpr
      have ha:(r:ZMod p) ∈ roots:=
        Multiset.mem_toFinset.mpr ((Polynomial.mem_roots hF).mpr hroot)
      let a:{a:ZMod p // a ∈ roots}:= ⟨r,ha⟩
      obtain ⟨s,hs,t,ht⟩:= hRv a r rfl hd
      exact ⟨s,bc ⟨a,Finset.mem_attach _ _,hs⟩,t,ht⟩
private theorem dw (p k v:U) (hv:v ≤ k)
 (F H A:ae)
 (heq:F = C ((p:I) ^ v) * H)
 (h:C ((p:I) ^ (k - v)) ∣ H.comp A):
 C ((p:I) ^ k) ∣ F.comp A:=by
  obtain ⟨G,hG⟩:= h
  refine ⟨G,?_⟩
  rw [heq,aS,aX,hG,
    ← mul_assoc,← bm,← pow_add,Nat.add_sub_of_le hv]
private theorem dx (p:U) [Fact p.Prime] (k:U)
 (F:ae) (hdeg:F.natDegree ≤ 4):
 ∃ S:Finset (I × U),S.card ≤ 4 ∧
 (∀ s ∈ S,s.2 ≤ k ∧ C ((p:I) ^ k) ∣ F.comp (dr p s)) ∧
 (∀ r:I,(p:I) ^ k ∣ F.eval r →
 ∃ s ∈ S,∃ t:I,r = s.1 + (p:I) ^ s.2 * t):=by
  classical
  have hp:(p:I) ≠ 0:=by
    exact_mod_cast (Fact.out:p.Prime).ne_zero
  rcases df p k F with hD | ⟨v,hv,H,heq,hH⟩
  · refine ⟨{(0,0)},by simp,?_,?_⟩
    · intro s hs
      have hs':s = (0,0):= Finset.mem_singleton.mp hs
      subst s
      refine ⟨Nat.zero_le _,?_⟩
      simpa [dr] using hD
    · intro r _
      exact ⟨(0,0),bu _,r,by simp⟩
  · obtain ⟨S,hSc,hSg,hSv⟩:= dv p (k - v) (by omega) H hH
    have hdegH:H.natDegree = F.natDegree:=by
      rw [heq,Polynomial.natDegree_C_mul (pow_ne_zero v hp)]
    refine ⟨S,hSc.trans ((Polynomial.natDegree_map_le.trans hdegH.le).trans hdeg),?_,?_⟩
    · intro s hs
      obtain ⟨hj,hd⟩:= hSg s hs
      exact ⟨by omega,dw p k v (by omega) F H (dr p s) heq hd⟩
    · intro r hd
      have heval:= congrArg (fun Q:ae => Q.eval r) heq
      simp only [aR,aW] at heval
      have hdH:(p:I) ^ (k - v) ∣ H.eval r:=by
        apply (dq (p:I) hp v k (by omega) (H.eval r)).mp
        rw [← heval]
        exact hd
      exact hSv r hdH
private theorem dy (p:U) (n:I) (F:ae)
 (a b:I × U) (hab:a.2 ≤ b.2)
 (r ta tb:I)
 (ha:r = a.1 + (p:I) ^ a.2 * ta)
 (hb:r = b.1 + (p:I) ^ b.2 * tb)
 (hcert:C n ∣ F.comp (dr p a)):
 C n ∣ F.comp (dr p b):=by
  let q:I:= ta - (p:I) ^ (b.2 - a.2) * tb
  let J:I:= (p:I) ^ (b.2 - a.2)
  have hp:(p:I) ^ a.2 * J = (p:I) ^ b.2:=by
    dsimp [J]
    rw [← pow_add,Nat.add_sub_of_le hab]
  have hc:b.1 = a.1 + (p:I) ^ a.2 * q:=by
    dsimp [q]
    rw [mul_sub,← mul_assoc,hp]
    linarith
  have bG:dr p b =
      (dr p a).comp (C q + C J * X):=by
    unfold dr
    rw [dn,hc,hp]
  rw [bG,← bi]
  exact dp n (F.comp (dr p a)) (C q + C J * X) hcert
private theorem dz (p:U) [Fact p.Prime] (k:U)
 (F G:ae) (hF:F.natDegree ≤ 4) (hG:G.natDegree ≤ 4):
 ∃ S:Finset (I × U),S.card ≤ 8 ∧
 (∀ s ∈ S,s.2 ≤ k ∧
 C ((p:I) ^ k) ∣ F.comp (dr p s) ∧
 C ((p:I) ^ k) ∣ G.comp (dr p s)) ∧
 (∀ r:I,(p:I) ^ k ∣ F.eval r → (p:I) ^ k ∣ G.eval r →
 ∃ s ∈ S,∃ t:I,r = s.1 + (p:I) ^ s.2 * t):=by
  classical
  obtain ⟨A,hAc,hAg,hAv⟩:= dx p k F hF
  obtain ⟨B,hBc,hBg,hBv⟩:= dx p k G hG
  let S:= (A ∪ B).filter (fun s =>
    C ((p:I) ^ k) ∣ F.comp (dr p s) ∧
    C ((p:I) ^ k) ∣ G.comp (dr p s))
  refine ⟨S,?_,?_,?_⟩
  · calc
      S.card ≤ (A ∪ B).card:= Finset.card_filter_le _ _
      _ ≤ A.card + B.card:=by apply Finset.card_union_le
      _ ≤ 8:=by omega
  · intro s hs
    obtain ⟨hsu,hsF,hsG⟩:= aq hs
    have hj:s.2 ≤ k:=by
      rcases Finset.mem_union.mp hsu with hsa | hsb
      · exact (hAg s hsa).1
      · exact (hBg s hsb).1
    exact ⟨hj,hsF,hsG⟩
  · intro r hrF hrG
    obtain ⟨a,ha,ta,hta⟩:= hAv r hrF
    obtain ⟨b,hb,tb,htb⟩:= hBv r hrG
    rcases le_total a.2 b.2 with hab | hba
    · refine ⟨b,?_,tb,htb⟩
      apply aF
      exact ⟨Finset.mem_union_right _ hb,
        dy p _ F a b hab r ta tb hta htb (hAg a ha).2,
        (hBg b hb).2⟩
    · refine ⟨a,?_,ta,hta⟩
      apply aF
      exact ⟨Finset.mem_union_left _ ha,(hAg a ha).2,
        dy p _ G b a hba r tb ta htb hta (hBg b hb).2⟩
private def dA (s:I × U):ae:=
  C s.1 + C (s.2:I) * X
private def dB (s:I × U) (r:I):Prop:=
  ∃ t:I,r = s.1 + (s.2:I) * t
private theorem dC (n:I) (F:ae)
 (a b:I × U)
 (hc:dB a b.1)
 (hJ:(a.2:I) ∣ (b.2:I))
 (h:C n ∣ F.comp (dA a)):
 C n ∣ F.comp (dA b):=by
  obtain ⟨u,hu⟩:= hc
  obtain ⟨q,hq⟩:= hJ
  have bG:dA b =
      (dA a).comp (C u + C q * X):=by
    unfold dA
    rw [dn,hu,hq]
  rw [bG,← bi]
  exact dp n (F.comp (dA a)) (C u + C q * X) h
private theorem dD (a b:I × U)
 (ha:0 < a.2) (hb:0 < b.2)
 (h:∃ r:I,dB a r ∧ dB b r):
 ∃ s:I × U,0 < s.2 ∧
 dB a s.1 ∧ dB b s.1 ∧
 (a.2:I) ∣ (s.2:I) ∧ (b.2:I) ∣ (s.2:I) ∧
 (∀ r:I,dB a r → dB b r → dB s r):=by
  obtain ⟨r0,ha0,hb0⟩:= h
  refine ⟨(r0,a.2.lcm b.2),Nat.lcm_pos ha hb,ha0,hb0,
    bn (Nat.dvd_lcm_left _ _),
    bn (Nat.dvd_lcm_right _ _),?_⟩
  intro r har hbr
  obtain ⟨ta,hta⟩:= har
  obtain ⟨tb,htb⟩:= hbr
  obtain ⟨ua,hua⟩:= ha0
  obtain ⟨ub,hub⟩:= hb0
  have hdA:(a.2:I) ∣ r - r0:= ⟨ta - ua,by rw [hta,hua];ring⟩
  have hdB:(b.2:I) ∣ r - r0:= ⟨tb - ub,by rw [htb,hub];ring⟩
  have hdN:a.2.lcm b.2 ∣ (r - r0).natAbs:=
    Nat.lcm_dvd (Int.natCast_dvd.mp hdA) (Int.natCast_dvd.mp hdB)
  obtain ⟨t,ht⟩:= Int.natCast_dvd.mpr hdN
  exact ⟨t,by dsimp;linarith⟩
private theorem dE (T:U) (hT:T ≠ 0) (z:I)
