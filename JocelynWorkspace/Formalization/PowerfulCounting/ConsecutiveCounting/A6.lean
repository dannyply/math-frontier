  have hq : (z.1.2:ℚ)^3*(z.2.2:ℚ)=
      (z.1.1:ℚ)^3*(z.2.1:ℚ)+1 := by exact_mod_cast hunit
  simp only [exceptional,Set.mem_ofPred_eq,InRawSpectrum,
    Nat.cast_mul,Nat.cast_pow]
  rw [hq]

