private theorem actual_residual_factor_cell_count (hEab : W847cHypEab)
    (hSt : StewartHyp) (N : ℕ) (hN : 1≤N) :
    ∃ C : ℝ, 0<C ∧
      ∀ x D E : ℝ, 2≤x → 0<D → 0<E →
        x^((21:ℝ)/50)≤D*E →
        ∀ a b : ℕ, 1≤a+b → a+b≤N →
