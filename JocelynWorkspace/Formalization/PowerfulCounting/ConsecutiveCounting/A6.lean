private lemma cofactor_side_nominal (M : ℕ) (U V r : ℝ)
    (hU : U ≠ 0) (P : Matrix (Fin 2) (Fin 2) ℤ) :
    sideLength ((M : ℝ)/(2048*V)) r (32*U) P 0 =
      16*A6CubicMoments.length ((M : ℝ)/(128*V)) r (2*U) (col P 0) := by
  have ha : (M : ℝ)/(2048*V)=((M : ℝ)/(128*V))/16 := by ring
  have hc : 32*U=16*(2*U) := by ring
  change 2/Real.sqrt (nsq ((M : ℝ)/(2048*V)) r (32*U) (col P 0)) =
    16*(2/Real.sqrt (nsq ((M : ℝ)/(128*V)) r (2*U) (col P 0)))
  rw [ha,hc]
  exact cofactor_length_fixed16 ((M : ℝ)/(128*V)) r (2*U)
