private theorem actual_quartic_factor_cell_count (hE0 : W847cHypE0)
    (hSt : StewartHyp) (K : ℝ) (hK : 0≤K) (eps : ℝ) (heps : 0<eps) :
    ∃ C : ℝ, 0≤C ∧
      ∀ x : ℝ, 2≤x →
        ∀ G : Four, Bihom G 4 1 →
          Irreducible (map (Int.castRingHom ℂ) G) →
          (∀ m : Fin 4→₀ℕ, |((G.coeff m:ℤ):ℝ)|≤x^K) →
          ∃ P Q : Binary, Graph G P Q ∧
            (¬RationalPure P Q 7 →
              ∀ D E : ℝ, ∀ M j : ℕ,
                (factorCellOutside x D E M j G).Finite ∧
                ((factorCellOutside x D E M j G).ncard:ℝ)≤C*x^eps) := by
  classical
  obtain ⟨C,hC,hcount⟩ :=
    hE0
      hSt K hK eps heps
  refine ⟨C,hC,?_⟩
  intro x hx G hBi hGeom hheight
  obtain ⟨P,Q,hGraph₀,hP,hQ,hPQheight⟩ := P7A.cb G hBi
  have hGraph : Graph G P Q := by
    simpa [Graph,embed,P7A.bO,P7A.bN] using hGraph₀
  have hGeomGraph : Irreducible (map (Int.castRingHom ℂ) (P7A.bO P Q)) := by
    rw [←hGraph₀]
    exact hGeom
  have hcopQ := P7A.bQ P Q hGeomGraph
  have hPNQ := P7A.bR P Q hP hQ hcopQ
  have hmapGraph :
      map (Int.castRingHom ℂ) (P7A.bO P Q)=
        P7A.bO (map (Int.castRingHom ℂ) P) (map (Int.castRingHom ℂ) Q) := by
    simp [P7A.bO,P7A.bN,MvPolynomial.map_rename]
  have hcopC := P7A.bP (map (Int.castRingHom ℂ) P) (map (Int.castRingHom ℂ) Q)
    (hmapGraph ▸ hGeomGraph)
  refine ⟨P,Q,hGraph,?_⟩
  intro hnotPure D E M j
  have hT : (e0Population Q P x).Finite ∧
      ((e0Population Q P x).ncard:ℝ)≤C*x^eps :=
    hcount x hx Q P hPNQ.2 hPNQ.1 hQ hP hcopC.symm
      (fun t => ⟨(hPQheight (x^K) (by positivity) hheight t).2,
        (hPQheight (x^K) (by positivity) hheight t).1⟩)
      (e0_nonpure_swapped P Q hnotPure) 1 (Or.inl rfl)
  have hmap : ∀z∈factorCellOutside x D E M j G, z∈e0Population Q P x := by
    intro z hz
    exact quartic_cell_subset_e0_swapped x D E M j G P Q hGraph hz.1
  have hinj : Set.InjOn (fun z : Point=>z) (factorCellOutside x D E M j G) := by
    intro z hz w hw h
    exact h
  have hfin := Set.Finite.of_injOn hmap hinj hT.1
  have hn := Set.ncard_le_ncard_of_injOn (fun z : Point=>z) hmap hinj hT.1
  exact ⟨hfin,(by exact_mod_cast hn :
    ((factorCellOutside x D E M j G).ncard:ℝ)≤
      ((e0Population Q P x).ncard:ℝ)).trans hT.2⟩

