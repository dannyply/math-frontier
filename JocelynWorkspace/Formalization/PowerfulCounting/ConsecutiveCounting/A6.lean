def CCDNAt (N : ℕ) (c : ℝ) : Prop :=
  ∀d : ℕ, 1≤d → ∀I : Ideal (MvPolynomial (Fin N) ℚ), I.IsPrime →
    ringKrullDim (MvPolynomial (Fin N) ℚ ⧸ I)=1 →
    (∃e : ℤ, ∃s₀ : ℕ, ∀s : ℕ, s₀≤ s →
      (Module.finrank ℚ (Submodule.map (Ideal.Quotient.mkₐ ℚ I).toLinearMap
        (MvPolynomial.restrictTotalDegree (Fin N) ℚ s)):ℤ)=(d:ℤ)*(s:ℤ)+e) →
    ∀B : ℝ, 1≤B →
      ((({P : Fin N→ℤ | (∀f∈I,eval (fun i=>(P i:ℚ)) f=0) ∧
          ∀i, |(P i:ℝ)|≤B}:Set (Fin N→ℤ)).ncard:ℕ):ℝ) ≤
        c*(d:ℝ)^3*B^((1:ℝ)/(d:ℝ))*(Real.log B+(d:ℝ))
def CCDNThm3 : Prop := ∀N : ℕ, 2≤N → ∃c : ℝ, CCDNAt N c

noncomputable def fullBudget (x D E : ℝ) (M : ℕ) : ℝ :=
  let U := x/D^3
  let V := x/E^3
  let RD := D*E+(D^2+E^2)/(M:ℝ)
  let RU := U*V+(U^2+V^2)/(M:ℝ)
  let Z := x^((1:ℝ)/3)/((M:ℝ)^((2:ℝ)/3)*(D*E)^((1:ℝ)/5))
  (M:ℝ)+(M:ℝ)^((3:ℝ)/4)*RD^((3:ℝ)/16)*RU^((1:ℝ)/16)+
    (M:ℝ)*Z+(M:ℝ)*x^((2:ℝ)/45)

private theorem whole_central_full8_main (h801 : W847cHyp801)
    (hF9 : W847cHypF9) (hEab : W847cHypEab) (h0180 : W847cHypLow)
    (h4928 : W847cHypFull12) (h47e : W847cHypAlpha3) (hE0 : W847cHypE0) (h2628 : W847cHypP3) :
    StewartHyp → CCDNThm3 →
      ∀delta : ℝ, 0<delta → delta<(1/2000:ℝ) →
        ∀eps : ℝ, 0<eps →
          ∃C X₀ : ℝ, 0<C ∧ 2≤X₀ ∧
            ∀x : ℝ, X₀≤x →
              ∀s : ℝ, (35/81:ℝ)≤ s → s≤(34/63:ℝ) →
                ∀D E : ℝ, 0<D → 0<E → D*E=x^s →
                  (originalBox x D E \ exceptional).Finite ∧
                    ((originalBox x D E \ exceptional).ncard:ℝ) ≤
                      C*x^eps*fullBudget x D E (nominalMR x delta) := by
  classical
  intro hSt hCCDN
  obtain ⟨c₈,hc₈⟩ := hCCDN 8 (by norm_num)
  intro delta hdelta hdeltaUp
  obtain ⟨q,K,Xbase,hq,hqdelta,hK,hXbase,hHigh⟩ :=
    h801
      c₈ hc₈ delta hdelta hdeltaUp
  let N : ℕ := 2*q
  have hN : 1≤N := by dsimp [N]; omega
  obtain ⟨Xfac,hXfac,hCell⟩ := actual_cell_count_from_same_F hEab h0180 h4928 h47e hE0 h2628 hSt N hN K hK.le
  obtain ⟨Xseven,hXseven,hSeven⟩ :=
    actual_pure7_nominal_family_count hF9 q (by omega) K hK
   
  intro eps heps
  obtain ⟨Ch,Xh,hCh,hXh,hHigh⟩ := hHigh eps heps
  obtain ⟨Csmall,hCsmall,hCell⟩ := hCell eps heps
  obtain ⟨Ct,Xt,hCt,hXt,hSeven⟩ := hSeven eps heps
  let C : ℝ := (N:ℝ)*(Ch+4*Csmall+Ct)
  let X₀ : ℝ := max Xfac (max Xh (max Xt ((2:ℝ)^2000)))
  have hNr : (0:ℝ)<N := by exact_mod_cast (show 0<N by omega)
  have hC : 0<C := by dsimp [C]; positivity
  have hX₀ : 2≤X₀ := hXfac.trans (le_max_left _ _)
  refine ⟨C,X₀,hC,hX₀,?_⟩
  intro x hx s hslo hsup D E hD hE hDE
  have hxfac : Xfac≤x := (le_max_left _ _).trans hx
  have hxrest : max Xh (max Xt ((2:ℝ)^2000))≤x := (le_max_right _ _).trans hx
  have hxh : Xh≤x := (le_max_left _ _).trans hxrest
  have hxt : Xt≤x := (le_max_left _ _).trans ((le_max_right _ _).trans hxrest)
  have hxpow : (2:ℝ)^2000≤x := (le_max_right _ _).trans ((le_max_right _ _).trans hxrest)
  have hx2 : 2≤x := hXfac.trans hxfac
  have hx1 : (1:ℝ)≤x := le_trans (by norm_num) hx2
  have hDElo : x^((21:ℝ)/50)≤D*E := by
    rw [hDE]
    exact Real.rpow_le_rpow_of_exponent_le hx1 (le_trans (by norm_num) hslo)
  let M := nominalMR x delta
  let B := 2 * q / 3
  obtain ⟨hB,hBq,hM,hMx,hproduce⟩ :=
    hHigh x hxh s hslo hsup D E hD hE hDE
  have hBq' : B≤q := hBq
  obtain ⟨F,menu,hFdata,hHighIncidence⟩ := hproduce 1 (Or.inl rfl)
  have hAux : AuxiliaryFamily x D E K M q B F := by
    intro j hj
    rcases hFdata j hj with
      ⟨hF,hBi,hDeg,hCoeff,hZero,hMenuCard,hMenuData,hIff,hFin,hComps⟩
    exact ⟨hF,hBi,hDeg,hCoeff,hZero⟩
  have hCompact :=
    mfactsR delta hdelta hdeltaUp x hxpow
  have hSevenActual :=
    hSeven delta hdelta hdeltaUp x hxt s hslo hsup D E hD hE hDE B hB hBq F hAux
  have hHighUnions : ∀j∈A6WholeF8GridJoins.cells D E M,
      (HighUnion x D E M j (F j)).Finite ∧
        ((HighUnion x D E M j (F j)).ncard:ℝ) ≤
          ∑G∈menu j,((componentCell x D E M j G).ncard:ℝ) := by
    intro j hj
    rcases hFdata j hj with
      ⟨hF,hBi,hDeg,hCoeff,hZero,hMenuCard,hMenuData,hIff,hFin,hComps⟩
    exact actual_menu_union_bound x D E M j (HighUnion x D E M j (F j)) (menu j) hIff hComps
  let U : ℝ := x/D^3
  let V : ℝ := x/E^3
  let RD : ℝ := D*E+(D^2+E^2)/(M:ℝ)
  let RU : ℝ := U*V+(U^2+V^2)/(M:ℝ)
  let H : ℝ := (M:ℝ)^((3:ℝ)/4)*RD^((3:ℝ)/16)*RU^((1:ℝ)/16)
  let Z : ℝ := x^((1:ℝ)/3)/((M:ℝ)^((2:ℝ)/3)*(D*E)^((1:ℝ)/5))
  let W : ℝ := x^((2:ℝ)/45)
  have hHighSum :
      (∑j∈A6WholeF8GridJoins.cells D E M,((HighUnion x D E M j (F j)).ncard:ℝ)) ≤
        Ch*x^eps*((M:ℝ)+H) :=
    (Finset.sum_le_sum (fun j hj => (hHighUnions j hj).2)).trans hHighIncidence
  have hCells : ∀j∈A6WholeF8GridJoins.cells D E M,
      (sourceCell x D E M j \ exceptional).Finite ∧
        ((sourceCell x D E M j \ exceptional).ncard:ℝ) ≤
          (N:ℝ)*(Csmall*x^eps*p3Price x D E M+(HighUnion x D E M j (F j)).ncard+
            (pureUnion x D E M j (F j) 4 7).ncard) := by
    intro j hj
    rcases hAux j hj with ⟨hF,hBi,hDeg,hCoeff,hZero⟩
    exact hCell x D E hxfac hD hE hDElo M hM hCompact.2.1 j hj q B (by dsimp [N]; omega)
      (F j) hF hBi hCoeff hZero (hHighUnions j hj).1
      (hSevenActual.1 j hj)
  have hUnion := finite_incidence_union_bound (A6WholeF8GridJoins.cells D E M)
    (fun j=>sourceCell x D E M j \ exceptional) (fun j hj => (hCells j hj).1)
  rw [←outside_box_eq_cell_union x D E M hD hE hM] at hUnion
  have hOrig :
      ((originalBox x D E \ exceptional).ncard:ℝ) ≤
        ∑j∈A6WholeF8GridJoins.cells D E M,((sourceCell x D E M j \ exceptional).ncard:ℝ) := by
    exact_mod_cast hUnion.2
  have hSumCells :
      (∑j∈A6WholeF8GridJoins.cells D E M,((sourceCell x D E M j \ exceptional).ncard:ℝ)) ≤
        (N:ℝ)*(((A6WholeF8GridJoins.cells D E M).card:ℝ)*(Csmall*x^eps*p3Price x D E M)+
          (∑j∈A6WholeF8GridJoins.cells D E M,((HighUnion x D E M j (F j)).ncard:ℝ))+
          (∑j∈A6WholeF8GridJoins.cells D E M,((pureUnion x D E M j (F j) 4 7).ncard:ℝ))) := by
    calc
      _≤∑j∈A6WholeF8GridJoins.cells D E M,
          (N:ℝ)*(Csmall*x^eps*p3Price x D E M+(HighUnion x D E M j (F j)).ncard+
            (pureUnion x D E M j (F j) 4 7).ncard) :=
        Finset.sum_le_sum (fun j hj => (hCells j hj).2)
      _=_ := by
        rw [←Finset.mul_sum]
        congr 1
        simp only [Finset.sum_add_distrib,Finset.sum_const,nsmul_eq_mul]
  have hCheap :
      ((A6WholeF8GridJoins.cells D E M).card:ℝ)*(Csmall*x^eps*p3Price x D E M) ≤
        (4*(M:ℝ))*(Csmall*x^eps*p3Price x D E M) :=
    mul_le_mul_of_nonneg_right
      (A6WholeF8GridJoins.cells_card_le_four D E M hM) (by dsimp [p3Price]; positivity)
  let Inner : ℝ := Ch*((M:ℝ)+H)+(4*Csmall)*(M:ℝ)*(1+Z)+Ct*(M:ℝ)*(1+W)
  have hInside :
      ((A6WholeF8GridJoins.cells D E M).card:ℝ)*(Csmall*x^eps*p3Price x D E M)+
        (∑j∈A6WholeF8GridJoins.cells D E M,((HighUnion x D E M j (F j)).ncard:ℝ))+
        (∑j∈A6WholeF8GridJoins.cells D E M,((pureUnion x D E M j (F j) 4 7).ncard:ℝ)) ≤
        x^eps*Inner := by
    calc
      _≤(4*(M:ℝ))*(Csmall*x^eps*p3Price x D E M)+Ch*x^eps*((M:ℝ)+H)+
          Ct*x^eps*(M:ℝ)*(1+W) :=
        add_le_add (add_le_add hCheap hHighSum) hSevenActual.2
      _=_ := by dsimp [Inner,p3Price,Z]; ring
  have hH : 0≤H := by dsimp [H,RD,RU,U,V]; positivity
  have hZ : 0≤Z := by dsimp [Z]; positivity
  have hW : 0≤W := by dsimp [W]; positivity
  have hAbsorb :
      Inner≤(Ch+4*Csmall+Ct)*fullBudget x D E M := by
    have hh := four_term_absorption (M:ℝ) H Z W Ch (4*Csmall) Ct 0
      (by positivity) hH hZ hW hCh.le (by positivity) hCt.le (by norm_num)
    simpa only [Inner,fullBudget,U,V,RD,RU,H,Z,W,add_zero,zero_mul] using hh
  refine ⟨hUnion.1,?_⟩
  calc
    _≤(N:ℝ)*(((A6WholeF8GridJoins.cells D E M).card:ℝ)*(Csmall*x^eps*p3Price x D E M)+
        (∑j∈A6WholeF8GridJoins.cells D E M,((HighUnion x D E M j (F j)).ncard:ℝ))+
        (∑j∈A6WholeF8GridJoins.cells D E M,((pureUnion x D E M j (F j) 4 7).ncard:ℝ))) :=
      hOrig.trans hSumCells
    _≤(N:ℝ)*(x^eps*Inner) := mul_le_mul_of_nonneg_left hInside hNr.le
    _≤(N:ℝ)*(x^eps*((Ch+4*Csmall+Ct)*fullBudget x D E M)) :=
      mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hAbsorb (by positivity)) hNr.le
    _=C*x^eps*fullBudget x D E M := by dsimp [C]; ring

