private def realNormSq (α r c p q : ℝ) : ℝ :=
  (α * (p - r * q)) ^ 2 + (q / c) ^ 2

private lemma norm_from_halves (p q : ℝ)
    (hp : |p| ≤ (1 / 2 : ℝ)) (hq : |q| ≤ (1 / 2 : ℝ)) :
    p ^ 2 + q ^ 2 ≤ 1 := by
  have hp2 := pow_le_pow_left₀ (abs_nonneg p) hp 2
  have hq2 := pow_le_pow_left₀ (abs_nonneg q) hq 2
  rw [sq_abs] at hp2 hq2
  nlinarith only [hp2, hq2]

private lemma tuple_ellipse_containment (x D E : ℝ) (M j : ℕ) (h : ℤ)
    (hx : 8 ≤ x) (hD : 0 < D) (hE : 0 < E)
    (hM : 1 ≤ M) (hMx : (M : ℝ) ≤ x)
    (hj : j ∈ cubicCells D E M) (hh : h = 1 ∨ h = -1)
    (z : OriginalPoint) (hz : z ∈ cubicCell x D E M j h) :
    let U : ℝ := x / D ^ 3
    let V : ℝ := x / E ^ 3
    nsq ((M : ℝ) / (4 * D)) (cubicRho D E M j) (2 * E)
      ((z.1.1 : ℤ), (z.1.2 : ℤ)) ≤ 1 ∧
    nsq ((M : ℝ) / (2048 * V)) ((cubicRho D E M j) ^ 3) (32 * U)
      ((z.2.2 : ℤ), (z.2.1 : ℤ)) ≤ 1 := by
  classical
  let U : ℝ := x / D ^ 3
  let V : ℝ := x / E ^ 3
  let r : ℝ := cubicRho D E M j
  let d : ℝ := (z.1.1 : ℝ)
  let e : ℝ := (z.1.2 : ℝ)
  let u : ℝ := (z.2.1 : ℝ)
  let v : ℝ := (z.2.2 : ℝ)
  let t : ℝ := d / e
  have hw := A6Threshold8ActualAuxiliary.cell_cofactor_windows
    x D E M j h hx hD hE hh z hz
  rcases hz with ⟨hdn, hen, hun, hvn, hshift, hnlo, hnhi, hdlo, hdhi,
    helo, hehi, htlo, hthi⟩
  have hx0 : 0 < x := by linarith only [hx]
  have hM1 : (1 : ℝ) ≤ M := by exact_mod_cast hM
  have hM0 : (0 : ℝ) < M := by linarith only [hM1]
  have hd1 : 1 ≤ d := by dsimp [d]; exact_mod_cast hdn
  have he1 : 1 ≤ e := by dsimp [e]; exact_mod_cast hen
  have hu1 : 1 ≤ u := by dsimp [u]; exact_mod_cast hun
  have hv1 : 1 ≤ v := by dsimp [v]; exact_mod_cast hvn
  have he0 : 0 < e := by linarith only [he1]
  have hu0 : 0 ≤ u := by linarith only [hu1]
  have hU : 0 < U := by dsimp [U]; positivity
  have hV : 0 < V := by dsimp [V]; positivity
  have huCap : u ≤ 16 * U := by
    have hb := hw.2.1
    change u ≤ 8 * (2 * x / D ^ 3) at hb
    convert hb using 1 ; dsimp [U] ; ring
  have heCap : e ≤ E := hehi
  have heLow : E / 2 < e := helo
  change r < t at htlo
  change t ≤ r * (1 + 1 / (M : ℝ)) at hthi
  have hrange := (Finset.mem_filter.mp hj).2
  change D / (2 * E) ≤ r ∧ r ≤ 2 * D / E at hrange
  have hr0 : 0 < r := (by positivity : 0 < D / (2 * E)).trans_le hrange.1
  have ht0 : 0 < t := hr0.trans htlo
  have hshiftR : e ^ 3 * v = d ^ 3 * u + (h : ℝ) := by
    dsimp [d, e, u, v]
    exact_mod_cast hshift
  have hhabs : |(h : ℝ)| = 1 := by
    rcases hh with rfl | rfl <;> norm_num

  have hde0 : 0 ≤ d - r * e := by
    have hp := (lt_div_iff₀ he0).mp htlo
    linarith only [hp]
  have hre : r * e ≤ 2 * D := by
    have hp := mul_le_mul_of_nonneg_left heCap hr0.le
    have hrE : r * E ≤ 2 * D := (le_div_iff₀ hE).mp hrange.2
    exact hp.trans hrE
  have hde : |d - r * e| ≤ 2 * D / (M : ℝ) := by
    rw [abs_of_nonneg hde0]
    apply (le_div_iff₀ hM0).mpr
    have hp : d ≤ r * (1 + 1 / (M : ℝ)) * e :=
      (div_le_iff₀ he0).mp hthi
    have hm := mul_le_mul_of_nonneg_right hp hM0.le
    have hid : (r * (1 + 1 / (M : ℝ)) * e) * (M : ℝ) =
        r * e * (M : ℝ) + r * e := by
      field_simp [hM0.ne']

    rw [hid] at hm
    nlinarith only [hm, hre]
  have hfirstX :
      |((M : ℝ) / (4 * D)) * (d - r * e)| ≤ (1 / 2 : ℝ) := by
    rw [abs_mul, abs_of_pos (by positivity : 0 < (M : ℝ) / (4 * D))]
    calc
      (M : ℝ) / (4 * D) * |d - r * e| ≤
          (M : ℝ) / (4 * D) * (2 * D / (M : ℝ)) :=
        mul_le_mul_of_nonneg_left hde (by positivity)
      _ = (1 / 2 : ℝ) := by
        field_simp [hM0.ne', hD.ne']
        ; ring
  have hfirstY : |e / (2 * E)| ≤ (1 / 2 : ℝ) := by
    rw [abs_of_nonneg (by positivity : 0 ≤ e / (2 * E))]
    apply (div_le_iff₀ (by positivity : 0 < 2 * E)).mpr
    nlinarith only [heCap]
  have hfirst := norm_from_halves _ _ hfirstX hfirstY

  let q : ℝ := 1 / (M : ℝ)
  have hq0 : 0 ≤ q := by dsimp [q]; positivity
  have hq1 : q ≤ 1 := by
    dsimp [q]
    apply (div_le_iff₀ hM0).mpr
    simpa only [one_mul] using hM1
  have hq2 : q ^ 2 ≤ q := by nlinarith only [mul_nonneg hq0 (sub_nonneg.mpr hq1)]
  have hq3 : q ^ 3 ≤ q ^ 2 := by
    have hp := mul_le_mul_of_nonneg_left hq1 (sq_nonneg q)
    nlinarith only [hp]
  have hbin : (1 + q) ^ 3 - 1 ≤ 7 * q := by
    nlinarith only [hq0, hq2, hq3]
  have hdiff30 : 0 ≤ t ^ 3 - r ^ 3 := by
    have hp := pow_le_pow_left₀ hr0.le htlo.le 3
    linarith only [hp]
  have hdiff3 : t ^ 3 - r ^ 3 ≤ 7 * r ^ 3 / (M : ℝ) := by
    have hp := pow_le_pow_left₀ ht0.le hthi 3
    change t ^ 3 ≤ (r * (1 + q)) ^ 3 at hp
    rw [mul_pow] at hp
    calc
      t ^ 3 - r ^ 3 ≤ r ^ 3 * ((1 + q) ^ 3 - 1) := by nlinarith only [hp]
      _ ≤ r ^ 3 * (7 * q) :=
        mul_le_mul_of_nonneg_left hbin (pow_nonneg hr0.le 3)
      _ = 7 * r ^ 3 / (M : ℝ) := by dsimp [q]; ring
  have hr3 : r ^ 3 ≤ 8 * V / U := by
    calc
      r ^ 3 ≤ (2 * D / E) ^ 3 := pow_le_pow_left₀ hr0.le hrange.2 3
      _ = 8 * V / U := by
        dsimp [U, V]
        field_simp [hD.ne', hE.ne', hx0.ne']
        ; ring
  have hsurface : |v - t ^ 3 * u| ≤ 8 * V / (M : ℝ) := by
    have hid : v - t ^ 3 * u = (h : ℝ) / e ^ 3 := by
      dsimp [t]
      field_simp [he0.ne']
      ; nlinarith only [hshiftR]
    have hE3 : E ^ 3 ≤ 8 * e ^ 3 := by
      have hp := pow_le_pow_left₀ hE.le (show E ≤ 2 * e by linarith only [heLow]) 3
      nlinarith only [hp]
    rw [hid, abs_div, hhabs, abs_of_pos (pow_pos he0 3)]
    calc
      1 / e ^ 3 ≤ 8 / E ^ 3 := by
        apply (div_le_div_iff₀ (pow_pos he0 3) (pow_pos hE 3)).mpr
        simpa only [one_mul] using hE3
      _ = 8 * V / x := by
        dsimp [V]
        field_simp [hx0.ne', hE.ne']

      _ ≤ 8 * V / (M : ℝ) :=
        div_le_div_of_nonneg_left (by positivity) hM0 hMx
  have hcenter : (t ^ 3 - r ^ 3) * u ≤ 896 * V / (M : ℝ) := by
    calc
      (t ^ 3 - r ^ 3) * u ≤ (7 * r ^ 3 / (M : ℝ)) * u :=
        mul_le_mul_of_nonneg_right hdiff3 hu0
      _ ≤ (7 * (8 * V / U) / (M : ℝ)) * (16 * U) :=
        mul_le_mul
          (div_le_div_of_nonneg_right
            (mul_le_mul_of_nonneg_left hr3 (by norm_num : (0 : ℝ) ≤ 7)) hM0.le)
          huCap hu0 (by positivity)
      _ = 896 * V / (M : ℝ) := by
        field_simp [hU.ne', hM0.ne']
        ; ring
  have hcofactor : |v - r ^ 3 * u| ≤ 904 * V / (M : ℝ) := by
    calc
      |v - r ^ 3 * u| = |(v - t ^ 3 * u) + (t ^ 3 - r ^ 3) * u| := by congr 1 ; ring
      _ ≤ |v - t ^ 3 * u| + |(t ^ 3 - r ^ 3) * u| := abs_add_le _ _
      _ = |v - t ^ 3 * u| + (t ^ 3 - r ^ 3) * u := by
        rw [abs_of_nonneg (mul_nonneg hdiff30 hu0)]
      _ ≤ 8 * V / (M : ℝ) + 896 * V / (M : ℝ) :=
        add_le_add hsurface hcenter
      _ = 904 * V / (M : ℝ) := by ring
  have hsecondX :
      |((M : ℝ) / (2048 * V)) * (v - r ^ 3 * u)| ≤ (1 / 2 : ℝ) := by
    rw [abs_mul, abs_of_pos (by positivity : 0 < (M : ℝ) / (2048 * V))]
    calc
      (M : ℝ) / (2048 * V) * |v - r ^ 3 * u| ≤
          (M : ℝ) / (2048 * V) * (904 * V / (M : ℝ)) :=
        mul_le_mul_of_nonneg_left hcofactor (by positivity)
      _ = (904 / 2048 : ℝ) := by
        field_simp [hV.ne', hM0.ne']

      _ ≤ (1 / 2 : ℝ) := by norm_num
  have hsecondY : |u / (32 * U)| ≤ (1 / 2 : ℝ) := by
    rw [abs_of_nonneg (by positivity : 0 ≤ u / (32 * U))]
    apply (div_le_iff₀ (by positivity : 0 < 32 * U)).mpr
    nlinarith only [huCap]
  have hsecond := norm_from_halves _ _ hsecondX hsecondY
  constructor
  · simpa only [nsq, Int.cast_natCast] using hfirst
  · simpa only [nsq, Int.cast_natCast] using hsecond

private lemma cofactor_norm_fixed16 (α r c : ℝ) (hc : c ≠ 0) (b : ℤ × ℤ) :
    nsq (α / 16) r (16 * c) b = nsq α r c b / 256 := by
  unfold nsq
  field_simp [hc]
  ; ring

private lemma cofactor_length_fixed16 (α r c : ℝ) (hc : c ≠ 0) (b : ℤ × ℤ) :
    2 / Real.sqrt (nsq (α / 16) r (16 * c) b) =
      16 * (2 / Real.sqrt (nsq α r c b)) := by
  have hN : 0 ≤ nsq α r c b := by unfold nsq; positivity
  have hN' : 0 ≤ nsq (α / 16) r (16 * c) b := by unfold nsq; positivity
  have hs : Real.sqrt (nsq (α / 16) r (16 * c) b) =
      Real.sqrt (nsq α r c b) / 16 := by
    have h1 := Real.sqrt_nonneg (nsq (α / 16) r (16 * c) b)
    have h2 := Real.sqrt_nonneg (nsq α r c b)
    have h3 := Real.sq_sqrt hN'
    have h4 := Real.sq_sqrt hN
    rw [cofactor_norm_fixed16 α r c hc b] at h3
    rw [cofactor_norm_fixed16 α r c hc b] at h1 ⊢
    nlinarith only [h1, h2, h3, h4]
  rw [hs]
  by_cases hzero : Real.sqrt (nsq α r c b) = 0
  · simp [hzero]
  · field_simp [hzero]


private theorem original_two_frames (x D E : ℝ) (M j : ℕ) (h : ℤ)
    (hx : 8 ≤ x) (hD : 0 < D) (hE : 0 < E)
    (hM : 1 ≤ M) (hMx : (M : ℝ) ≤ x)
    (hj : j ∈ cubicCells D E M) (hh : h = 1 ∨ h = -1) :
    let U : ℝ := x / D ^ 3
    let V : ℝ := x / E ^ 3
    ∃ p : EllipseData ((M : ℝ) / (4 * D)) (cubicRho D E M j) (2 * E),
    ∃ q : EllipseData ((M : ℝ) / (2048 * V)) ((cubicRho D E M j) ^ 3) (32 * U),
    ∀ z ∈ cubicCell x D E M j h,
      |((p.A.mulVec ![(z.1.1 : ℤ), (z.1.2 : ℤ)]) 0 : ℝ)| ≤
        sideLength ((M : ℝ) / (4 * D)) (cubicRho D E M j) (2 * E) p.P 0 ∧
      |((p.A.mulVec ![(z.1.1 : ℤ), (z.1.2 : ℤ)]) 1 : ℝ)| ≤
        sideLength ((M : ℝ) / (4 * D)) (cubicRho D E M j) (2 * E) p.P 1 ∧
      |((q.A.mulVec ![(z.2.2 : ℤ), (z.2.1 : ℤ)]) 0 : ℝ)| ≤
        sideLength ((M : ℝ) / (2048 * V)) ((cubicRho D E M j) ^ 3) (32 * U) q.P 0 ∧
      |((q.A.mulVec ![(z.2.2 : ℤ), (z.2.1 : ℤ)]) 1 : ℝ)| ≤
        sideLength ((M : ℝ) / (2048 * V)) ((cubicRho D E M j) ^ 3) (32 * U) q.P 1 := by
  let U : ℝ := x / D ^ 3
  let V : ℝ := x / E ^ 3
  have hM0 : (0 : ℝ) < M := by exact_mod_cast (show 0 < M by omega)
  have hx0 : 0 < x := by linarith only [hx]
  have hU : 0 < U := by dsimp [U]; positivity
  have hV : 0 < V := by dsimp [V]; positivity
  obtain ⟨p⟩ := ellipse_basis ((M : ℝ) / (4 * D)) (cubicRho D E M j) (2 * E)
    (by positivity) (by positivity)
  obtain ⟨q⟩ := ellipse_basis ((M : ℝ) / (2048 * V)) ((cubicRho D E M j) ^ 3) (32 * U)
    (by positivity) (by positivity)
  refine ⟨p, q, ?_⟩
  intro z hz
  have hn := tuple_ellipse_containment x D E M j h hx hD hE hM hMx hj hh z hz
  have hp := p.hcover ((z.1.1 : ℤ), (z.1.2 : ℤ)) hn.1
  have hq := q.hcover ((z.2.2 : ℤ), (z.2.1 : ℤ)) hn.2
  exact ⟨hp.1, hp.2, hq.1, hq.2⟩

