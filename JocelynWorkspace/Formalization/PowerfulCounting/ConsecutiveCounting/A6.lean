private theorem eval_embed_integer (P : Binary) (w : Fin 4→ℤ) :
    eval w (embed P)=eval ![w 0,w 1] P := by
  change eval w (rename (fun i : Fin 2 => if i=0 then (0:Fin 4) else 1) P)=_
  rw [MvPolynomial.eval_rename]
  have hw : (w ∘ (fun i : Fin 2 => if i=0 then (0:Fin 4) else 1))=
      ![w 0,w 1] := by
    funext i
    fin_cases i <;> simp []
  rw [hw]

private theorem graph_zero_e0_swapped (G : Four) (P Q : Binary)
    (hGraph : Graph G P Q) (z : Point)
    (hzero : eval ![(z.1.1:ℤ),(z.1.2:ℤ),(z.2.1:ℤ),(z.2.2:ℤ)] G=0) :
    (z.2.1:ℤ)*eval ![(z.1.1:ℤ),(z.1.2:ℤ)] P =
      (z.2.2:ℤ)*eval ![(z.1.1:ℤ),(z.1.2:ℤ)] Q := by
  change G=embed P*X 2-embed Q*X 3 at hGraph
  rw [hGraph] at hzero
  simp only [map_sub,map_mul,eval_X,eval_embed_integer] at hzero
  change eval ![(z.1.1:ℤ),(z.1.2:ℤ)] P*(z.2.1:ℤ)-
    eval ![(z.1.1:ℤ),(z.1.2:ℤ)] Q*(z.2.2:ℤ)=0 at hzero
  nlinarith

def RationalPure (P Q : Binary) (n : ℕ) : Prop :=
  ∃ κ a b : ℚ, κ≠0 ∧ (a≠0 ∨ b≠0) ∧ ∀ r s : ℚ,
    s^3*eval ![r,s] (map (Int.castRingHom ℚ) P)-
      r^3*eval ![r,s] (map (Int.castRingHom ℚ) Q)=κ*(a*r+b*s)^n
def E0Pure (P Q : Binary) : Prop :=
  ∃ κ a b : ℚ, κ≠0 ∧ (a≠0 ∨ b≠0) ∧ ∀ r s : ℚ,
    s^3*eval ![r,s] (map (Int.castRingHom ℚ) Q)-
      r^3*eval ![r,s] (map (Int.castRingHom ℚ) P)=κ*(a*r+b*s)^7
private theorem e0_nonpure_swapped (P Q : Binary)
    (h : ¬RationalPure P Q 7) : ¬E0Pure Q P := h

def e0Population (P Q : Binary) (x : ℝ) : Set Point := {z |
  1≤z.1.1 ∧ 1≤z.1.2 ∧ 1≤z.2.1 ∧ 1≤z.2.2 ∧
