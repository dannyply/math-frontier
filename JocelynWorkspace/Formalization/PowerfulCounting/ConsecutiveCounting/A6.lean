private lemma cubic_surface_identity
    (D E U V d e u v h : ℝ)
    (_hD : D ≠ 0) (hE : E ≠ 0) (hU : U ≠ 0) (hV : V ≠ 0)
    (he : e ≠ 0) (hu : u ≠ 0)
    (hbalance : D ^ 3 * U = E ^ 3 * V)
    (hsurface : e ^ 3 * v - d ^ 3 * u = h) :
    (v / u) / (V / U) - ((d / e) / (D / E)) ^ 3 =
      h * U / (u * e ^ 3 * V) := by
  have hscale : (D / E) ^ 3 = V / U := by
    rw [div_pow]
    apply (div_eq_div_iff (pow_ne_zero 3 hE) hU).mpr
    nlinarith only [hbalance]
  have hnormal : v / u - (d / e) ^ 3 = h / (e ^ 3 * u) := by
    apply (eq_div_iff (mul_ne_zero (pow_ne_zero 3 he) hu)).mpr
    field_simp [he, hu]
    ; nlinarith only [hsurface]
  calc
    (v / u) / (V / U) - ((d / e) / (D / E)) ^ 3 =
        (v / u - (d / e) ^ 3) / (V / U) := by
      rw [div_pow, hscale]
      ring
    _ = (h / (e ^ 3 * u)) / (V / U) := by rw [hnormal]
    _ = h * U / (u * e ^ 3 * V) := by
      field_simp [he, hu, hU, hV]


