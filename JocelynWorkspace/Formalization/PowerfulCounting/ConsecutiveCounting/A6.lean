private noncomputable def dY (b h d₀ y:I):O:=
  (d₀:O) + (b:O) * (h:O) * (y:O)
private noncomputable def dZ (a h e₀ y:I):O:=
  (e₀:O) - (a:O) * (h:O) * (y:O)
end P7I
end
noncomputable section
open Polynomial
namespace P7I
private abbrev eb:= (I × I) × (I × I)
end P7I
end
namespace P7I
private theorem ec (dM:DMType)
 (a b c R S d₀ e₀ u₀ v₀:I)
 (hab:bt a b = 1) (hc:c ≠ 0)
 (hK:co a b c R S ≠ 0)
 (hF₀:e₀ ^ 3 * v₀ = d₀ ^ 3 * u₀ + 1)
 (hG₀:pNF a b c R S d₀ e₀ * u₀ - qNF a b c R S d₀ e₀ * v₀ = 0)
 (D E M rho:O) (hD:0 < D) (hE:0 < E) (hM:0 < M)
 (hrho:0 < rho) (hrho':rho ≤ 2 * D / E)
 (Pts:Finset eb)
 (hF:∀ z ∈ Pts,z.1.2 ^ 3 * z.2.2 = z.1.1 ^ 3 * z.2.1 + 1)
 (hG:∀ z ∈ Pts,
 pNF a b c R S z.1.1 z.1.2 * z.2.1 -
 qNF a b c R S z.1.1 z.1.2 * z.2.2 = 0)
 (bG:∀ z ∈ Pts,a * z.1.1 + b * z.1.2 = a * d₀ + b * e₀)
 (hcell:∀ z ∈ Pts,
 0 < (z.1.2:O) ∧ (z.1.2:O) ≤ E ∧
 rho < (z.1.1:O) / (z.1.2:O) ∧
 (z.1.1:O) / (z.1.2:O) ≤ rho * (1 + 1 / M)):
 a * d₀ + b * e₀ ≠ 0 ∧
 ∃ h q:I,0 < h ∧ q ≠ 0 ∧
 h * co a b c R S = c * q ∧
 (Pts.card:O) ≤ 1 +
 2 * D * E / (M * |((a * d₀ + b * e₀:I):O)| * (h:O)):=by
  classical
  let ell:I:= a * d₀ + b * e₀
  obtain ⟨hell,h,q,j₀,k,𝓢,hh,hq,hk,bM,h𝓢c,h𝓢g,bL⟩:=
    dQ dM a b c R S d₀ e₀ u₀ v₀ hab hc hK hF₀ hG₀
  have hkeq:k + 15 * h * a ^ 4 * b ^ 4 = q:=by
    linear_combination hk
  have hqk:k + 15 * h * a ^ 4 * b ^ 4 ≠ 0:=by rwa [hkeq]
  have hdata (z:{z:eb // z ∈ Pts}):
      ∃ y:I,
        z.1.1.1 = d₀ + b * h * y ∧ z.1.1.2 = e₀ - a * h * y ∧
        (cV a b h d₀ e₀ j₀ k).eval y = ell ^ 7 * z.1.2.2 ∧
        (cW a b h d₀ e₀ j₀ k).eval y = ell ^ 7 * z.1.2.1:=by
    obtain ⟨y,s,hs,w,hd,he,hpv,hqv,hw⟩:=
      bL z.1.1.1 z.1.1.2 z.1.2.1 z.1.2.2
        (hF z.1 z.2) (hG z.1 z.2) (bG z.1 z.2)
    exact ⟨y,hd,he,hpv,hqv⟩
  let param:{z:eb // z ∈ Pts} → I:= fun z => (hdata z).choose
  have hparam (z:{z:eb // z ∈ Pts}):
      z.1.1.1 = d₀ + b * h * param z ∧ z.1.1.2 = e₀ - a * h * param z ∧
      (cV a b h d₀ e₀ j₀ k).eval (param z) = ell ^ 7 * z.1.2.2 ∧
      (cW a b h d₀ e₀ j₀ k).eval (param z) = ell ^ 7 * z.1.2.1:=
    (hdata z).choose_spec
  have hinj:aH param:=by
    intro z w hy
    have hd:z.1.1.1 = w.1.1.1:=by
      rw [(hparam z).1,(hparam w).1,hy]
    have he:z.1.1.2 = w.1.1.2:=by
      rw [(hparam z).2.1,(hparam w).2.1,hy]
    have hu:z.1.2.1 = w.1.2.1:=by
      apply aC (pow_ne_zero 7 hell)
      calc
        ell ^ 7 * z.1.2.1 = (cW a b h d₀ e₀ j₀ k).eval (param z):=
          (hparam z).2.2.2.symm
        _ = (cW a b h d₀ e₀ j₀ k).eval (param w):=by rw [hy]
        _ = ell ^ 7 * w.1.2.1:= (hparam w).2.2.2
    have hv:z.1.2.2 = w.1.2.2:=by
      apply aC (pow_ne_zero 7 hell)
      calc
        ell ^ 7 * z.1.2.2 = (cV a b h d₀ e₀ j₀ k).eval (param z):=
          (hparam z).2.2.1.symm
        _ = (cV a b h d₀ e₀ j₀ k).eval (param w):=by rw [hy]
        _ = ell ^ 7 * w.1.2.2:= (hparam w).2.2.1
    apply Subtype.ext
    exact Prod.ext (Prod.ext hd he) (Prod.ext hu hv)
  let emb:{z:eb // z ∈ Pts} ↪ I:= ⟨param,hinj⟩
  let Y:Finset I:= Pts.attach.map emb
  have hcard:Y.card = Pts.card:=by
    simp only [Y,Finset.card_map,Finset.card_attach]
  have bI:∀ y ∈ Y,
      0 < dZ a h e₀ y ∧ dZ a h e₀ y ≤ E ∧
      rho < dY b h d₀ y / dZ a h e₀ y ∧
      dY b h d₀ y / dZ a h e₀ y ≤ rho * (1 + 1 / M):=by
    intro y hy
    obtain ⟨z,hz,rfl⟩:= Finset.mem_map.mp hy
    change 0 < dZ a h e₀ (param z) ∧ dZ a h e₀ (param z) ≤ E ∧
      rho < dY b h d₀ (param z) / dZ a h e₀ (param z) ∧
      dY b h d₀ (param z) / dZ a h e₀ (param z) ≤ rho * (1 + 1 / M)
    have hd:(z.1.1.1:O) = dY b h d₀ (param z):=by
      dsimp [dY]
      exact_mod_cast (hparam z).1
    have he:(z.1.1.2:O) = dZ a h e₀ (param z):=by
      dsimp [dZ]
      exact_mod_cast (hparam z).2.1
    rw [← hd,← he]
    exact hcell z.1 z.2
  have hhR:0 < (h:O):=by exact_mod_cast hh
  have hellR:((a * d₀ + b * e₀:I):O) ≠ 0:=by exact_mod_cast hell
  have bK:(a:O) * (d₀:O) + (b:O) * (e₀:O) ≠ 0:=by
    simpa only [bs,aD] using hellR
  have hL:0 < |((a * d₀ + b * e₀:I):O)|:= abs_pos.2 hellR
  have hdiam:∀ y₁ ∈ Y,∀ y₂ ∈ Y,
      |(y₁:O) - (y₂:O)| ≤
        2 * D * E / (M * |((a * d₀ + b * e₀:I):O)| * (h:O)):=by
    intro y₁ hy₁ y₂ hy₂
    obtain ⟨he₁,he₁',hs₁,hs₁'⟩:= bI y₁ hy₁
    obtain ⟨he₂,he₂',hs₂,hs₂'⟩:= bI y₂ hy₂
    have hd:= dV
      (a:O) (b:O) (d₀:O) (e₀:O) (h:O)
      (y₁:O) (y₂:O) D E M rho hD hE hM hrho hrho' hhR bK
      he₁ he₂ he₁' he₂' hs₁ hs₁' hs₂ hs₂'
    simpa only [bs,aD] using hd
  have bJ:= finite_integer_diameter_card Y
    (2 * D * E / (M * |((a * d₀ + b * e₀:I):O)| * (h:O)))
    (by positivity) hdiam
  refine ⟨hell,h,q,hh,hq,bM,?_⟩
  rwa [hcard] at bJ
end P7I
namespace P7I
private theorem ed
 (X Y iU V L:O)
 (hX:0 ≤ X) (hY:0 ≤ Y) (hL:0 < L)
 (hUX:X / 2 ≤ iU) (hUX':iU ≤ X)
 (hVY:Y / 2 ≤ V) (hVY':V ≤ Y)
 (hUV:iU ≤ L + V) (hVU:V ≤ L + iU)
 (hrich:8 * L ≤ max X Y):
 0 < au (X * Y) ∧
 au (X * Y) / 8 ≤ iU ∧ iU ≤ 8 * au (X * Y) ∧
 au (X * Y) / 8 ≤ V ∧ V ≤ 8 * au (X * Y):=by
  let T:O:= max X Y
  change 8 * L ≤ T at hrich
  have hT:0 < T:=by linarith
  have hXT:X ≤ T:= le_max_left _ _
  have hYT:Y ≤ T:= le_max_right _ _
  have hXq:T / 4 ≤ X:=by
    rcases le_total X Y with hXY | hYX
    · have hTY:T = Y:= max_eq_right hXY
      rw [hTY] at hrich ⊢
      linarith
    · have hTX:T = X:= max_eq_left hYX
      rw [hTX]
      linarith
  have hYq:T / 4 ≤ Y:=by
    rcases le_total X Y with hXY | hYX
    · have hTY:T = Y:= max_eq_right hXY
      rw [hTY]
      linarith
    · have hTX:T = X:= max_eq_left hYX
      rw [hTX] at hrich ⊢
      linarith
  have hXpos:0 < X:=by linarith
  have hYpos:0 < Y:=by linarith
  let W:O:= au (X * Y)
  have hW:0 < W:= Real.sqrt_pos.2 (mul_pos hXpos hYpos)
  have hWsq:W ^ 2 = X * Y:= Real.sq_sqrt (mul_nonneg hX hY)
  have hXYhi:X * Y ≤ T ^ 2:=by
    have hh:= mul_le_mul hXT hYT hY (le_of_lt hT)
    nlinarith
  have hXYlo:T ^ 2 ≤ 16 * (X * Y):=by
    have hh:= mul_le_mul hXq hYq (by linarith:0 ≤ T / 4) hX
    nlinarith
  have hWT:W ≤ T:=by
    by_contra hf
    have hp:= mul_pos (by linarith:0 < W - T) (by linarith:0 < W + T)
    nlinarith
  have hTW:T ≤ 4 * W:=by
    by_contra hf
    have hp:= mul_pos (by linarith:0 < T - 4 * W)
      (by linarith:0 < T + 4 * W)
    nlinarith
  exact ⟨hW,by linarith,by linarith,by linarith,by linarith⟩
private theorem ee
 (a b d e D E:O)
 (hD:0 < D) (hE:0 < E)
 (hd:D / 2 ≤ d) (hd':d ≤ D)
 (he:E / 2 ≤ e) (he':e ≤ E)
 (hell:a * d + b * e ≠ 0)
 (hrich:8 * |a * d + b * e| ≤ max (|a| * D) (|b| * E)):
 a ≠ 0 ∧ b ≠ 0 ∧
 0 < au (|a * b| * (D * E)) ∧
 au (|a * b| * (D * E)) / (8 * |a * d + b * e|) ≤
 |a * d / (a * d + b * e)| ∧
 |a * d / (a * d + b * e)| ≤
 8 * au (|a * b| * (D * E)) / |a * d + b * e| ∧
 au (|a * b| * (D * E)) / (8 * |a * d + b * e|) ≤
 |1 - a * d / (a * d + b * e)| ∧
 |1 - a * d / (a * d + b * e)| ≤
 8 * au (|a * b| * (D * E)) / |a * d + b * e|:=by
  have hd0:0 < d:=by linarith
  have he0:0 < e:=by linarith
  have hX:0 ≤ |a| * D:= mul_nonneg (abs_nonneg a) hD.le
  have hY:0 ≤ |b| * E:= mul_nonneg (abs_nonneg b) hE.le
  have hUlo:|a| * D / 2 ≤ |a| * d:=by
    have hh:= am hd (abs_nonneg a)
    nlinarith
  have hUhi:|a| * d ≤ |a| * D:=
    am hd' (abs_nonneg a)
  have hVlo:|b| * E / 2 ≤ |b| * e:=by
    have hh:= am he (abs_nonneg b)
    nlinarith
  have hVhi:|b| * e ≤ |b| * E:=
    am he' (abs_nonneg b)
  have hUV:|a| * d ≤ |a * d + b * e| + |b| * e:=by
    have hh:= abs_add_le (a * d + b * e) (-(b * e))
    have heq:a * d + b * e + -(b * e) = a * d:=by ring
    rw [heq] at hh
    simpa only [abs_neg,abs_mul,abs_of_pos hd0,abs_of_pos he0] using hh
  have hVU:|b| * e ≤ |a * d + b * e| + |a| * d:=by
    have hh:= abs_add_le (a * d + b * e) (-(a * d))
    have heq:a * d + b * e + -(a * d) = b * e:=by ring
    rw [heq] at hh
    simpa only [abs_neg,abs_mul,abs_of_pos hd0,abs_of_pos he0] using hh
  have bG:(|a| * D) * (|b| * E) = |a * b| * (D * E):=by
    rw [abs_mul]
    ring
  obtain ⟨hW,hU,hU',hV,hV'⟩:= ed
    (|a| * D) (|b| * E) (|a| * d) (|b| * e) |a * d + b * e|
    hX hY (abs_pos.2 hell) hUlo hUhi hVlo hVhi hUV hVU hrich
  rw [bG] at hW hU hU' hV hV'
  have ha:a ≠ 0:=by
    intro ha
    simp only [ha,zero_mul,abs_zero,Real.sqrt_zero] at hW
    exact (lt_irrefl 0) hW
  have hb:b ≠ 0:=by
    intro hb
    simp only [hb,mul_zero,abs_zero,zero_mul,Real.sqrt_zero] at hW
    exact (lt_irrefl 0) hW
  have hL:0 < |a * d + b * e|:= abs_pos.2 hell
  have hz:|a * d / (a * d + b * e)| =
      |a| * d / |a * d + b * e|:=by
    rw [abs_div,abs_mul,abs_of_pos hd0]
  have h1z:|1 - a * d / (a * d + b * e)| =
      |b| * e / |a * d + b * e|:=by
    have hrat:1 - a * d / (a * d + b * e) = b * e / (a * d + b * e):=by
      field_simp [hell] ; ring
    rw [hrat,abs_div,abs_mul,abs_of_pos he0]
  refine ⟨ha,hb,hW,?_,?_,?_,?_⟩
  · rw [hz]
    have hh:= aK hU hL.le
    simpa only [div_div] using hh
  · rw [hz]
    exact aK hU' hL.le
  · rw [h1z]
    have hh:= aK hV hL.le
    simpa only [div_div] using hh
  · rw [h1z]
    exact aK hV' hL.le
end P7I
namespace P7I
private theorem ef
 (a b:I) (hab:bt a b = 1):
 1 ≤ |(a:O)| ∨ 1 ≤ |(b:O)|:=by
  have hab0:a ≠ 0 ∨ b ≠ 0:=by
    by_cases ha:a = 0
    · right
      intro hb
      rw [ha,hb] at hab
      norm_num at hab
    · exact Or.inl ha
  have one (z:I) (hz:z ≠ 0):(1:O) ≤ |(z:O)|:=by
    have hn0:z.natAbs ≠ 0:= aU hz
    have hn:1 ≤ z.natAbs:=by omega
    have hi:(1:I) ≤ (z.natAbs:I):=by exact_mod_cast hn
    rw [aM] at hi
    exact_mod_cast hi
  rcases hab0 with ha | hb
  · exact Or.inl (one a ha)
  · exact Or.inr (one b hb)
end P7I
namespace P7I
private theorem eg
 (x D E d e u v:O) (hx:1 ≤ x)
 (hD:0 < D) (hE:0 < E)
 (hd:D / 2 < d) (he:E / 2 < e)
 (hu:1 ≤ u) (hv:1 ≤ v)
 (hunit:e ^ 3 * v = d ^ 3 * u + 1)
 (bG:d ^ 3 * u ≤ x):
 D < 2 * x ^ ((1:O) / 3) ∧ E < 4 * x ^ ((1:O) / 3):=by
  have hx0:0 < x:=by linarith
  have hd0:0 < d:=by linarith
  have he0:0 < e:=by linarith
  let X:O:= x ^ ((1:O) / 3)
  have hX:0 < X:= bk hx0 _
  have hX3:X ^ 3 = x:=by
    dsimp [X]
    rw [← Real.rpow_natCast,← bv hx0.le]
    norm_num
  have hd3:d ^ 3 ≤ x:=by
    have hm:= mul_nonneg (pow_nonneg hd0.le 3) (sub_nonneg.mpr hu)
    nlinarith
  have he3:e ^ 3 ≤ x + 1:=by
    have hm:= mul_nonneg (pow_nonneg he0.le 3) (sub_nonneg.mpr hv)
    nlinarith
  have hdX:d ≤ X:=by
    by_contra hf
    have hp:= mul_pos (by linarith:0 < d - X)
      (by positivity:0 < d ^ 2 + d * X + X ^ 2)
    nlinarith
  have heX:e ≤ 2 * X:=by
    have he3':e ^ 3 ≤ (2 * X) ^ 3:=by nlinarith
    by_contra hf
    have hp:= mul_pos (by linarith:0 < e - 2 * X)
      (by positivity:0 < e ^ 2 + e * (2 * X) + (2 * X) ^ 2)
    nlinarith
  constructor <;> dsimp [X] at * <;> linarith
private theorem eh
 (x D E d e u v cM M:O) (hx:1 ≤ x)
 (hD:0 < D) (hE:0 < E) (hcM:0 < cM)
 (hd:D / 2 < d) (he:E / 2 < e)
 (hu:1 ≤ u) (hv:1 ≤ v)
 (hunit:e ^ 3 * v = d ^ 3 * u + 1)
 (bG:d ^ 3 * u ≤ x)
 (bI:cM * x ^ ((1:O) / 3) ≤ M):
 D ≤ (4 / cM) * M ∧ E ≤ (4 / cM) * M:=by
  obtain ⟨hDb,hEb⟩:= eg x D E d e u v hx hD hE
    hd he hu hv hunit bG
  have hX:0 < x ^ ((1:O) / 3):=
    bk (by linarith) _
  have hs:= am bI (by positivity:0 ≤ 4 / cM)
  have heq:(4 / cM) * (cM * x ^ ((1:O) / 3)) =
      4 * x ^ ((1:O) / 3):=by
    field_simp [ne_of_gt hcM]
  rw [heq] at hs
  exact ⟨by linarith,by linarith⟩
private theorem ei
 (a b d e D E:O)
 (hD:0 < D) (hE:0 < E)
 (hd:D / 2 ≤ d) (_hd':d ≤ D)
 (he:E / 2 ≤ e) (_he':e ≤ E)
 (hell:a * d + b * e ≠ 0)
 (hrich:64 * |a * d + b * e| ≤ max (|a| * D) (|b| * E)):
 8 ≤ |a * d / (a * d + b * e)| ∧
 8 ≤ |1 - a * d / (a * d + b * e)|:=by
  have hd0:0 < d:=by linarith
  have he0:0 < e:=by linarith
  have hL:0 < |a * d + b * e|:= abs_pos.2 hell
  have hUlo:|a| * D / 2 ≤ |a| * d:=by
    have hh:= am hd (abs_nonneg a)
    nlinarith
  have hVlo:|b| * E / 2 ≤ |b| * e:=by
    have hh:= am he (abs_nonneg b)
    nlinarith
  have hUV:|a| * d ≤ |a * d + b * e| + |b| * e:=by
    have hh:= abs_add_le (a * d + b * e) (-(b * e))
    have heq:a * d + b * e + -(b * e) = a * d:=by ring
    rw [heq] at hh
    simpa only [abs_neg,abs_mul,abs_of_pos hd0,abs_of_pos he0] using hh
  have hVU:|b| * e ≤ |a * d + b * e| + |a| * d:=by
    have hh:= abs_add_le (a * d + b * e) (-(a * d))
    have heq:a * d + b * e + -(a * d) = b * e:=by ring
    rw [heq] at hh
    simpa only [abs_neg,abs_mul,abs_of_pos hd0,abs_of_pos he0] using hh
  have hUL:8 * |a * d + b * e| ≤ |a| * d ∧
      8 * |a * d + b * e| ≤ |b| * e:=by
    rcases le_total (|a| * D) (|b| * E) with hXY | hYX
    · rw [max_eq_right hXY] at hrich
      constructor <;> linarith
    · rw [max_eq_left hYX] at hrich
      constructor <;> linarith
  have hz:|a * d / (a * d + b * e)| =
      |a| * d / |a * d + b * e|:=by
    rw [abs_div,abs_mul,abs_of_pos hd0]
  have h1z:|1 - a * d / (a * d + b * e)| =
      |b| * e / |a * d + b * e|:=by
    have hrat:1 - a * d / (a * d + b * e) = b * e / (a * d + b * e):=by
      field_simp [hell] ; ring
    rw [hrat,abs_div,abs_mul,abs_of_pos he0]
  rw [hz,h1z]
  exact ⟨(le_div_iff₀ hL).2 hUL.1,(le_div_iff₀ hL).2 hUL.2⟩
end P7I
namespace P7I
private theorem ej
 (a b:I) (hab:bt a b = 1)
 (D E M L h B cBox:O)
 (hD:0 < D) (hE:0 < E) (hM:0 < M) (hL:0 < L)
 (hh:1 ≤ h) (hB:0 < B) (hcBox:0 < cBox)
 (hboxD:D ≤ cBox * M) (hboxE:E ≤ cBox * M)
 (bG:64 * cBox ≤ B)
 (bI:B * M * L * h < D * E):
 64 * L < max (|(a:O)| * D) (|(b:O)| * E):=by
  let T:O:= max (|(a:O)| * D) (|(b:O)| * E)
  have hXT:|(a:O)| * D ≤ T:= le_max_left _ _
  have hYT:|(b:O)| * E ≤ T:= le_max_right _ _
  have hT0:0 ≤ T:=
    (mul_nonneg (abs_nonneg (a:O)) hD.le).trans hXT
  have hDE:D * E ≤ cBox * M * T:=by
    rcases ef a b hab with ha | hb
    · have hDT:D ≤ T:=by
        have hh:= ak ha hD.le
        nlinarith
      have hh:= mul_le_mul hDT hboxE hE.le hT0
      nlinarith
    · have hET:E ≤ T:=by
        have hh:= ak hb hE.le
        nlinarith
      have hh:= mul_le_mul hboxD hET hE.le (by positivity:0 ≤ cBox * M)
      nlinarith
  have hlow:64 * cBox * M * L ≤ B * M * L * h:=by
    have h₁:= ak bG (by positivity:0 ≤ M * L)
    have h₂:= am hh (by positivity:0 ≤ B * M * L)
    nlinarith
  have bJ:64 * cBox * M * L < cBox * M * T:=
    lt_of_le_of_lt hlow (lt_of_lt_of_le bI hDE)
  have hpos:0 < cBox * M:= mul_pos hcBox hM
  have bM:64 * L < T:=by
    by_contra hf
    have hh:= am (le_of_not_gt hf) hpos.le
    nlinarith
  exact bM
end P7I
namespace P7I
private theorem ek (dM:DMType)
 (a b c R S d₀ e₀ u₀ v₀:I)
 (hab:bt a b = 1) (hc:c ≠ 0)
