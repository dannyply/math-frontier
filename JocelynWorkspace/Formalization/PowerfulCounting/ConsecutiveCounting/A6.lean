private theorem intToComplex_totalDegree
    (p : MvPolynomial (Fin 4) ℤ) :
    (MvPolynomial.map (Int.castRingHom ℂ) p).totalDegree = p.totalDegree := by
  have hs : (MvPolynomial.map (Int.castRingHom ℂ) p).support = p.support :=
    MvPolynomial.support_map_of_injective p (by exact_mod_cast (Int.cast_injective : Function.Injective (fun z : ℤ => (z : ℂ))))
  simp only [MvPolynomial.totalDegree, hs]

private theorem intToComplex_nonunit_of_pos_degree
    (p : MvPolynomial (Fin 4) ℤ)
    (hp : 0 < p.totalDegree) :
    ¬IsUnit (MvPolynomial.map (Int.castRingHom ℂ) p) := by
  intro hu
  have hd := (MvPolynomial.isUnit_iff_totalDegree_of_isReduced.mp hu).2
  rw [intToComplex_totalDegree] at hd
  omega

private theorem positive_degree_of_complex_irreducible
    (p : MvPolynomial (Fin 4) ℤ)
    (hp : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) p)) :
    0 < p.totalDegree := by
  by_contra hpos
  have hd : p.totalDegree = 0 := by omega
  have hdc : (MvPolynomial.map (Int.castRingHom ℂ) p).totalDegree = 0 := by
    rw [intToComplex_totalDegree]
    exact hd
  have hC := (MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp hdc
  have hc0 : MvPolynomial.coeff 0
      (MvPolynomial.map (Int.castRingHom ℂ) p) ≠ 0 := by
    intro hz
    have hp0 : MvPolynomial.map (Int.castRingHom ℂ) p = 0 := by
      simpa [hz] using hC
    exact hp.ne_zero hp0
  have hu0 : IsUnit (MvPolynomial.coeff 0
      (MvPolynomial.map (Int.castRingHom ℂ) p)) :=
    (isUnit_iff_ne_zero).mpr hc0
  have hu : IsUnit (MvPolynomial.map (Int.castRingHom ℂ) p) :=
    (MvPolynomial.isUnit_iff_totalDegree_of_isReduced).mpr ⟨hu0, hdc⟩
  exact hp.not_isUnit hu

