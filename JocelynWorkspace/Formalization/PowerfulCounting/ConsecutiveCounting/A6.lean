      a ^ xDegreeSum A B * b ^ yDegreeSum A B := by
    have hp := prod_scaled_powers (Finset.univ : Finset (Rect A B))
      (fun _ => (1 : ℝ)) (fun z => (z.1 : ℕ)) (fun z => (z.2 : ℕ)) a b
