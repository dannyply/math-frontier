      2 * y ^ (max (1 - 2 * (dl + el)) (1 - (dl + el) - 2 * |el - dl|)) := by
  have hy0 : 0 < y := by linarith
  have hy1 : 1 ≤ y := hy.le
  obtain ⟨c, hc⟩ : ∃ c : ℝ, c = max (1 - 2 * (dl + el)) (1 - (dl + el) - 2 * |el - dl|) :=
    ⟨_, rfl⟩
  rw [← hc]
  have hc1 : 1 - 2 * (dl + el) ≤ c := by rw [hc]; exact le_max_left _ _
  have hc2 : 1 - (dl + el) - 2 * |el - dl| ≤ c := by rw [hc]; exact le_max_right _ _
  have hDE : D * E = y ^ (dl + el) := by rw [hD, hE, ← Real.rpow_add hy0]
  have h1 : y / (D * E) ^ 2 = y ^ (1 - (dl + el) * 2) := by
    rw [hDE, rpow_sq' hy0, Real.rpow_sub hy0, Real.rpow_one]
  have hU : y / D ^ 3 = y ^ (1 - dl * 3) := by
    rw [hD, rpow_cube' hy0, Real.rpow_sub hy0, Real.rpow_one]
  have hV : y / E ^ 3 = y ^ (1 - el * 3) := by
    rw [hE, rpow_cube' hy0, Real.rpow_sub hy0, Real.rpow_one]
