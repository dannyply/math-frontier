private theorem finite_incidence_union_bound {ι α : Type*}
    (I : Finset ι) (A : ι→Set α) (hfin : ∀i∈I, (A i).Finite) :
    (⋃i∈I,A i).Finite ∧
      (⋃i∈I,A i).ncard≤∑i∈I,(A i).ncard := by
  classical
  let T : ι→Finset α := fun i => if hi : i∈I then (hfin i hi).toFinset else ∅
  have hT : ∀i∈I, (↑(T i):Set α)=A i := by
    intro i hi
    simp [T,hi]
  let U : Finset α := I.biUnion T
  have hU : (↑U:Set α)=⋃i∈I,A i := by
    ext z
    simp only [U,Finset.mem_coe,Finset.mem_biUnion,Set.mem_iUnion]
    constructor
    · rintro ⟨i,hi,hz⟩
      refine ⟨i,hi,?_⟩
      exact (Set.ext_iff.mp (hT i hi) z).mp hz
    · rintro ⟨i,hi,hz⟩
      refine ⟨i,hi,?_⟩
      exact (Set.ext_iff.mp (hT i hi) z).mpr hz
  have hf : (⋃i∈I,A i).Finite := by
    rw [←hU]
    exact Finset.finite_toSet U
  refine ⟨hf,?_⟩
  calc
    (⋃i∈I,A i).ncard=U.card := by rw [←hU,Set.ncard_coe_finset]
    _≤∑i∈I,(T i).card := Finset.card_biUnion_le
    _=∑i∈I,(A i).ncard := by
      apply Finset.sum_congr rfl
      intro i hi
      rw [←hT i hi,Set.ncard_coe_finset]

end A6WholeF8ActualJoins

