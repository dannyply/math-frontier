private def PrimitiveIntegral (G : MvPolynomial (Fin 4) ℤ) : Prop :=
  ∀ z : ℤ,
    (∀ m : Fin 4 →₀ ℕ, z ∣ MvPolynomial.coeff m G) →
      IsUnit z

private theorem primitive_of_irreducibles
    (p : MvPolynomial (Fin 4) ℤ)
    (hp : Irreducible p)
    (hpC : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) p)) :
    PrimitiveIntegral p := by
  intro z hz
  have hd : MvPolynomial.C z ∣ p :=
    (MvPolynomial.C_dvd_iff_dvd_coeff z p).mpr hz
  have hz0 : z ≠ 0 := by
    intro hz0
    subst z
    obtain ⟨q, hq⟩ := hd
    have hp0 : p = 0 := by simpa using hq
    exact hp.ne_zero hp0
  rcases (hp.dvd_iff).mp hd with hu | ha
  · let ev : MvPolynomial (Fin 4) ℤ →+* ℤ :=
      MvPolynomial.eval₂Hom (RingHom.id ℤ) (fun _ => 0)
    have he : IsUnit (ev (MvPolynomial.C z)) := hu.map ev
    simpa [ev] using he
  · have hpz : p ∣ MvPolynomial.C z := ha.dvd
    obtain ⟨b, hbz, hpb⟩ := (MvPolynomial.dvd_C_iff_exists hz0).mp hpz
    have hb0 : b ≠ 0 := by
      intro hb0
      have hp0 : p = 0 := by simpa [hb0] using hpb
      exact hp.ne_zero hp0
    have hbC : (b : ℂ) ≠ 0 := by exact_mod_cast hb0
    have huC : IsUnit (MvPolynomial.C (b : ℂ) : MvPolynomial (Fin 4) ℂ) :=
      ((isUnit_iff_ne_zero).mpr hbC).map (MvPolynomial.C : ℂ →+* MvPolynomial (Fin 4) ℂ)
    have hmap : MvPolynomial.map (Int.castRingHom ℂ) p =
        MvPolynomial.C (b : ℂ) := by solve | simp [hpb]
    exact False.elim (hpC.not_isUnit (hmap.symm ▸ huC))

end A5PrimitiveNormalizationTrial

