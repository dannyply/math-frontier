private theorem four_term_absorption
    (M H Z W A B C D : ℝ)
    (hM : 0≤M) (hH : 0≤H) (hZ : 0≤Z) (hW : 0≤W)
    (hA : 0≤A) (hB : 0≤B) (hC : 0≤C) (hD : 0≤D) :
    A*(M+H)+B*M*(1+Z)+C*M*(1+W)+D*M ≤
      (A+B+C+D)*(M+H+M*Z+M*W) := by
  have hAHZ := mul_nonneg hA (mul_nonneg hM hZ)
  have hAHW := mul_nonneg hA (mul_nonneg hM hW)
  have hBH := mul_nonneg hB hH
  have hBHW := mul_nonneg hB (mul_nonneg hM hW)
  have hCH := mul_nonneg hC hH
  have hCHZ := mul_nonneg hC (mul_nonneg hM hZ)
  have hDH := mul_nonneg hD hH
  have hDHZ := mul_nonneg hD (mul_nonneg hM hZ)
  have hDHW := mul_nonneg hD (mul_nonneg hM hW)
  nlinarith

