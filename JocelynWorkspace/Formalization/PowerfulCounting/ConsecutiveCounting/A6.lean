  have hx₀:(X (0:Fin 2):MvPolynomial (Fin 2) R).IsHomogeneous 1:=
    MvPolynomial.isHomogeneous_X R _
  have hx₁:(X (1:Fin 2):MvPolynomial (Fin 2) R).IsHomogeneous 1:=
    MvPolynomial.isHomogeneous_X R _
