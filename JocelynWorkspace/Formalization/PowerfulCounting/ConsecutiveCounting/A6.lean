private lemma rho_lower (D E : ℝ) (M : ℕ)
    (hD : 0 < D) (hE : 0 < E) (hM : 1 ≤ M) (j : ℕ) :
    D / (2 * E) ≤ rho D E M j := by
  have hM0 : (0 : ℝ) < M := by exact_mod_cast (show 0 < M by omega)
  have hbase : (1 : ℝ) ≤ 1 + 1 / (M : ℝ) := by
    have hi : 0 ≤ 1 / (M : ℝ) := by positivity
    linarith only [hi]
  have hp : (1 : ℝ) ≤ (1 + 1 / (M : ℝ)) ^ j := one_le_pow₀ hbase
  change D / (2 * E) ≤ D / (2 * E) * (1 + 1 / (M : ℝ)) ^ j
  nlinarith only [mul_le_mul_of_nonneg_left hp (show 0 ≤ D / (2 * E) by positivity)]

private lemma rho_step (D E : ℝ) (M j : ℕ) :
    rho D E M (j + 1) = rho D E M j * (1 + 1 / (M : ℝ)) := by
  change D / (2 * E) * (1 + 1 / (M : ℝ)) ^ (j + 1) =
    (D / (2 * E) * (1 + 1 / (M : ℝ)) ^ j) * (1 + 1 / (M : ℝ))
  rw [pow_succ, mul_assoc]

private lemma linear_grid (D E : ℝ) (M : ℕ)
    (hD : 0 < D) (hE : 0 < E) (hM : 1 ≤ M) :
    (∀ i j : ℕ, i ≤ j →
      ((j : ℝ) - i) * (D / (8 * E * (M : ℝ))) ≤
        rho D E M j - rho D E M i) ∧
    (∀ j ∈ cells D E M, D / (8 * E) ≤ rho D E M j ∧
      rho D E M j ≤ 8 * D / E) := by
  classical
  have hM0 : (0 : ℝ) < M := by exact_mod_cast (show 0 < M by omega)
  refine ⟨Source.spacing_of_step _ _ ?_, ?_⟩
  · intro j
    rw [rho_step]
    have hlo := rho_lower D E M hD hE hM j
    have hm := mul_le_mul_of_nonneg_right hlo
      (show 0 ≤ 1 / (M : ℝ) by positivity)
    have heq : D / (2 * E) * (1 / (M : ℝ)) =
        D / (2 * E * (M : ℝ)) := by
      field_simp [hE.ne', hM0.ne']

    have hrat : D / (8 * E * (M : ℝ)) ≤ D / (2 * E * (M : ℝ)) := by
      apply (div_le_div_iff₀ (by positivity : 0 < 8 * E * (M : ℝ))
        (by positivity : 0 < 2 * E * (M : ℝ))).mpr
      nlinarith only [mul_pos hD (mul_pos hE hM0)]
    rw [heq] at hm
    nlinarith only [hm, hrat]
  · intro j hj
    have hc := (Finset.mem_filter.mp hj).2
    have heq1 : D / (8 * E) = (D / E) / 8 := by field_simp [hE.ne']
    have heq2 : D / (2 * E) = (D / E) / 2 := by field_simp [hE.ne']
    have heq3 : 2 * D / E = 2 * (D / E) := by ring
    have heq4 : 8 * D / E = 8 * (D / E) := by ring
    change D / (2 * E) ≤ rho D E M j ∧ rho D E M j ≤ 2 * D / E at hc
    rw [heq1, heq4]
    rw [heq2, heq3] at hc
    have hpos : 0 < D / E := div_pos hD hE
    constructor <;> linarith only [hc.1, hc.2, hpos]

private lemma cubic_grid (D E U V : ℝ) (M : ℕ)
    (hD : 0 < D) (hE : 0 < E) (hU : 0 < U) (hV : 0 < V)
    (hM : 1 ≤ M) (hscale : (D / (2 * E)) ^ 3 = V / (8 * U)) :
    (∀ i j : ℕ, i ≤ j →
      ((j : ℝ) - i) * (V / (8 * U * (M : ℝ))) ≤
        (rho D E M j) ^ 3 - (rho D E M i) ^ 3) ∧
    (∀ j ∈ cells D E M, V / (8 * U) ≤ (rho D E M j) ^ 3 ∧
      (rho D E M j) ^ 3 ≤ 8 * V / U) := by
  classical
  have hM0 : (0 : ℝ) < M := by exact_mod_cast (show 0 < M by omega)
  have hden0 : 0 < 1 / (M : ℝ) := by positivity
  have hbinomial : 1 / (M : ℝ) ≤ (1 + 1 / (M : ℝ)) ^ 3 - 1 := by
    nlinarith only [hden0.le, sq_nonneg (1 / (M : ℝ)),
      pow_nonneg hden0.le 3]
  have hlow : ∀ j, V / (8 * U) ≤ (rho D E M j) ^ 3 := by
    intro j
    rw [← hscale]
    exact pow_le_pow_left₀ (by positivity)
      (rho_lower D E M hD hE hM j) 3
  refine ⟨Source.spacing_of_step _ _ ?_, ?_⟩
  · intro j
    have hr0 : 0 ≤ (rho D E M j) ^ 3 :=
      (show 0 < V / (8 * U) by positivity).le.trans (hlow j)
    have h1 := mul_le_mul_of_nonneg_left hbinomial hr0
    have h2 := mul_le_mul_of_nonneg_right (hlow j) hden0.le
    have hidentity :
        (rho D E M (j + 1)) ^ 3 - (rho D E M j) ^ 3 =
          (rho D E M j) ^ 3 * ((1 + 1 / (M : ℝ)) ^ 3 - 1) := by
      rw [rho_step, mul_pow]
      ring
    rw [hidentity]
    have heq : V / (8 * U * (M : ℝ)) =
        (V / (8 * U)) * (1 / (M : ℝ)) := by
      field_simp [hU.ne', hM0.ne']

    rw [heq]
    exact h2.trans h1
  · intro j hj
    refine ⟨hlow j, ?_⟩
    have hc := (Finset.mem_filter.mp hj).2
    change D / (2 * E) ≤ rho D E M j ∧ rho D E M j ≤ 2 * D / E at hc
    have hr0 : 0 ≤ rho D E M j :=
      (show 0 < D / (2 * E) by positivity).le.trans hc.1
    have hpow := pow_le_pow_left₀ hr0 hc.2 3
    have heq : (2 * D / E) ^ 3 = 64 * (D / (2 * E)) ^ 3 := by
      field_simp [hE.ne']
      ; ring
    have heq' : (2 * D / E) ^ 3 = 8 * V / U := by
      rw [heq, hscale]
      field_simp [hU.ne']
      ; ring
    rwa [heq'] at hpow

theorem main :
( let rho : ℝ → ℝ → ℕ → ℕ → ℝ := fun D E M j => D / (2 * E) * (1 + 1 / (M : ℝ)) ^ j; let cells : ℝ → ℝ → ℕ → Finset ℕ := fun D E M => (by classical exact (Finset.range (3 * M + 1)).filter (fun j => D / (2 * E) ≤ rho D E M j ∧ rho D E M j ≤ 2 * D / E)); let mStar : ℝ → ℝ := fun s => (1 + s - Real.sqrt (28 * s ^ 2 - 20 * s + 4)) / 2; let nsq : ℝ → ℝ → ℝ → (ℤ × ℤ) → ℝ := fun α r c b => (α * ((b.1 : ℝ) - r * (b.2 : ℝ))) ^ 2 + ((b.2 : ℝ) / c) ^ 2; let length : ℝ → ℝ → ℝ → (ℤ × ℤ) → ℝ := fun α r c b => 2 / Real.sqrt (nsq α r c b); ∀ δ : ℝ, 0 < δ → δ < (1 / 2000 : ℝ) → ∀ η : ℝ, 0 < η → ∃ C X₀ : ℝ, 0 < C ∧ 8 ≤ X₀ ∧ ∀ x : ℝ, X₀ ≤ x → ∀ s : ℝ, (2 / 5 : ℝ) ≤ s → s ≤ (35 / 81 : ℝ) → ∀ D E : ℝ, 1 ≤ D → 1 ≤ E → D ≤ 2 * x → E ≤ 2 * x → D * E = x ^ s → let M : ℕ := ⌈x ^ (mStar s + δ)⌉₊; let U : ℝ := x / D ^ 3; let V : ℝ := x / E ^ 3; ∀ b c : ℕ → ℤ × ℤ, (∀ j ∈ cells D E M, b j ≠ 0) → (∀ j ∈ cells D E M, c j ≠ 0) → (∑ j ∈ cells D E M, (length ((M : ℝ) / (4 * D)) (rho D E M j) (2 * E) (b j)) ^ 2) ≤ C * x ^ η * (D * E + (D ^ 2 + E ^ 2) / (M : ℝ)) ∧ (∑ j ∈ cells D E M, (length ((M : ℝ) / (128 * V)) ((rho D E M j) ^ 3) (2 * U) (c j)) ^ 2) ≤ C * x ^ η * (U * V + (U ^ 2 + V ^ 2) / (M : ℝ)) )
 := by
  classical
  dsimp only
  intro δ hδ hδ' η hη
  obtain ⟨C4, hC4, h4⟩ := raw_grid_moment 4 η (by norm_num) hη
  obtain ⟨C128, hC128, h128⟩ := raw_grid_moment 128 η (by norm_num) hη
  let C : ℝ := max C4 C128
  let X₀ : ℝ := (2 : ℝ) ^ (100 : ℕ)
  have hC : 0 < C := hC4.trans_le (le_max_left _ _)
  have hX₀ : 8 ≤ X₀ := by dsimp [X₀]; norm_num
  refine ⟨C, X₀, hC, hX₀, ?_⟩
  intro x hx s hs hs' D E hD1 hE1 hDx hEx hDE b c hb hc
  let M : ℕ := ⌈x ^ (mStar s + δ)⌉₊
  let U : ℝ := x / D ^ 3
  let V : ℝ := x / E ^ 3
  have hx8 : 8 ≤ x := hX₀.trans hx
  have hx0 : 0 < x := by linarith
  have hD : 0 < D := by linarith
  have hE : 0 < E := by linarith
  have hU : 0 < U := by dsimp [U]; positivity
  have hV : 0 < V := by dsimp [V]; positivity
  obtain ⟨hM, hMpow, hMD, hMV⟩ :=
    mesh_area_bounds δ x s D E hδ hδ' hx hs hs' hD hE hDE
  change 1 ≤ M at hM
  change (M : ℝ) ≤ D * E at hMD
  change (M : ℝ) ≤ V * U at hMV
  have hUcap : U ≤ x := by
    have hp : (1 : ℝ) ≤ D ^ 3 := one_le_pow₀ hD1
    dsimp [U]
    apply (div_le_iff₀ (pow_pos hD 3)).mpr
    simpa only [mul_one] using mul_le_mul_of_nonneg_left hp hx0.le
  have hVcap : V ≤ x := by
    have hp : (1 : ℝ) ≤ E ^ 3 := one_le_pow₀ hE1
    dsimp [V]
    apply (div_le_iff₀ (pow_pos hE 3)).mpr
    simpa only [mul_one] using mul_le_mul_of_nonneg_left hp hx0.le
  have hscale : (D / (2 * E)) ^ 3 = V / (8 * U) := by
    dsimp [U, V]
    field_simp [hD.ne', hE.ne', hx0.ne']
    ; ring
  obtain ⟨hlsp, hlbound⟩ := linear_grid D E M hD hE hM
  obtain ⟨hcsp, hcbound⟩ := cubic_grid D E U V M hD hE hU hV hM hscale
  have hcard := cell_card D E M
  have hfirst := h4 x D E hx8 hD hE hDx hEx M hM hMD
    (cells D E M) (rho D E M) hcard hlsp hlbound b hb
  have hsecond := h128 x V U hx8 hV hU (by linarith) (by linarith) M hM hMV
    (cells D E M) (fun j => (rho D E M j) ^ 3) hcard hcsp hcbound c hc
  change
    (∑ j ∈ cells D E M,
      (length ((M : ℝ) / (4 * D)) (rho D E M j) (2 * E) (b j)) ^ 2) ≤
        C * x ^ η * (D * E + (D ^ 2 + E ^ 2) / (M : ℝ)) ∧
    (∑ j ∈ cells D E M,
      (length ((M : ℝ) / (128 * V)) ((rho D E M j) ^ 3) (2 * U) (c j)) ^ 2) ≤
        C * x ^ η * (U * V + (U ^ 2 + V ^ 2) / (M : ℝ))
  constructor
  · exact hfirst.trans
      (mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_right (le_max_left C4 C128) (by positivity))
        (by positivity))
  · have hcomm : V * U + (V ^ 2 + U ^ 2) / (M : ℝ) =
        U * V + (U ^ 2 + V ^ 2) / (M : ℝ) := by ring
    rw [hcomm] at hsecond
    exact hsecond.trans
      (mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_right (le_max_right C4 C128) (by positivity))
        (by positivity))

