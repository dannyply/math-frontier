    rw [hU, hE, ← Real.rpow_add hy0]
  have h3 : D * (y / E ^ 3) = y ^ (dl + (1 - el * 3)) := by
    rw [hV, hD, ← Real.rpow_add hy0]
  have hmin : min (E * (y / D ^ 3)) (D * (y / E ^ 3)) ≤ y ^ c := by
    rcases abs_cases (el - dl) with ⟨habs, _⟩ | ⟨habs, _⟩
    · rw [habs] at hc2
      calc min (E * (y / D ^ 3)) (D * (y / E ^ 3)) ≤ D * (y / E ^ 3) := min_le_right _ _
        _ = y ^ (dl + (1 - el * 3)) := h3
