private theorem dM
 (a b c R S d₀ e₀ u₀ v₀:I)
 (hab:bt a b = 1) (hc:c ≠ 0)
 (hK:co a b c R S ≠ 0)
 (hF₀:e₀ ^ 3 * v₀ = d₀ ^ 3 * u₀ + 1)
 (hG₀:pNF a b c R S d₀ e₀ * u₀ -
 qNF a b c R S d₀ e₀ * v₀ = 0):
 let ell:I:= a * d₀ + b * e₀
 let T:U:= ell.natAbs ^ 7
 ell ≠ 0 ∧ ∃ h q j₀ k:I,∃ 𝓢:Finset (I × U),
 0 < h ∧ q ≠ 0 ∧ k = q - 15 * h * a ^ 4 * b ^ 4 ∧
 h * co a b c R S = c * q ∧
 (∀ y:I,R * (e₀ - a * h * y) + S * (d₀ + b * h * y) =
 c * (j₀ + k * y)) ∧
 𝓢.card ≤ 8 ^ T.primeFactors.card ∧
 (∀ s ∈ 𝓢,0 < s.2 ∧
 (T:I) ∣ q * h ^ 3 * (s.2:I) ^ 4) ∧
 ∀ d e u v:I,
 e ^ 3 * v = d ^ 3 * u + 1 →
 pNF a b c R S d e * u - qNF a b c R S d e * v = 0 →
 a * d + b * e = ell →
 ∃ y:I,∃ s ∈ 𝓢,∃ z:I,
 d = d₀ + b * h * y ∧ e = e₀ - a * h * y ∧
 (cV a b h d₀ e₀ j₀ k).eval y = ell ^ 7 * v ∧
 (cW a b h d₀ e₀ j₀ k).eval y = ell ^ 7 * u ∧
 y = s.1 + (s.2:I) * z:=by
  intro ell T
  let A:I:= Int.gcdA a b
  let B:I:= Int.gcdB a b
  have hbez:A * a + B * b = 1:=by
    have hb:= bg a b
    rw [hab] at hb
    norm_num at hb
    dsimp [A,B]
    nlinarith only [hb]
  have bG:= cp a b c R S d₀ e₀
  change e₀ ^ 3 * pNF a b c R S d₀ e₀ -
      d₀ ^ 3 * qNF a b c R S d₀ e₀ = c * ell ^ 7 at bG
  obtain ⟨hp₀,hq₀⟩:= cr
    d₀ e₀ u₀ v₀ (pNF a b c R S d₀ e₀) (qNF a b c R S d₀ e₀)
    c ell hF₀ hG₀ bG
  have hpdiv:ell ∣ pNF a b c R S d₀ e₀:=by
    refine ⟨c * ell ^ 6 * v₀,?_⟩
    rw [hp₀]
    ring
  have hqdiv:ell ∣ qNF a b c R S d₀ e₀:=by
    refine ⟨c * ell ^ 6 * u₀,?_⟩
    rw [hq₀]
    ring
  have bI:= cy a b c R S d₀ e₀
    A B (-d₀ ^ 2 * u₀) (e₀ ^ 2 * v₀) hbez
    (cs d₀ e₀ u₀ v₀ hF₀) hpdiv hqdiv
  have hell:ell ≠ 0:=by
    intro hz
    change ell ∣ co a b c R S at bI
    rw [hz,zero_dvd_iff] at bI
    exact hK bI
  have hcP:c ∣ pNF a b c R S d₀ e₀:= ⟨ell ^ 7 * v₀,by rw [hp₀];ring⟩
  have hcQ:c ∣ qNF a b c R S d₀ e₀:= ⟨ell ^ 7 * u₀,by rw [hq₀];ring⟩
  have bK:= cu
    a b c R S d₀ e₀ u₀ v₀ hF₀ hcP hcQ
  obtain ⟨h,q,j₀,hh,hq,dN,dO,hW⟩:=
    cL a b c R S d₀ e₀ 0 hc hK
      (by simpa only [mul_zero,sub_zero,add_zero] using bK)
  let k:I:= q - 15 * h * a ^ 4 * b ^ 4
  have hk:k + 15 * h * a ^ 4 * b ^ 4 = q:=by dsimp [k];ring
  have hT:T ≠ 0:= pow_ne_zero 7 (aU hell)
  obtain ⟨𝓢,h𝓢c,h𝓢g,h𝓢v⟩:=
    dI T hT a b h d₀ e₀ j₀ k A B hbez
  have hTell:(T:I) ∣ ell ^ 7:=by
    have hTabs:(T:I) = |ell| ^ 7:=by
      simp only [T,bp,aM]
    rw [hTabs]
    rcases le_total 0 ell with hs | hs
    · rw [abs_of_nonneg hs]
    · rw [abs_of_nonpos hs]
      exact ⟨-1,by ring⟩
  have bJ:∀ y:I,
      R * (e₀ - a * h * y) + S * (d₀ + b * h * y) = c * (j₀ + k * y):=by
    intro y
    simpa only [zero_add,mul_assoc,k] using hW y
  refine ⟨hell,h,q,j₀,k,𝓢,hh,hq,rfl,dN,bJ,h𝓢c,?_,?_⟩
  · intro s hs
    exact ⟨(h𝓢g s hs).1,by simpa only [hk] using (h𝓢g s hs).2.1⟩
  · intro d e u v hF hG dP
    let t:I:= B * (d - d₀) - A * (e - e₀)
    have bM:d = d₀ + b * t:=by
      dsimp [t]
      change a * d + b * e = a * d₀ + b * e₀ at dP
      linear_combination -(d - d₀) * hbez + A * dP
    have bL:e = e₀ - a * t:=by
      dsimp [t]
      change a * d + b * e = a * d₀ + b * e₀ at dP
      linear_combination -(e - e₀) * hbez + B * dP
    have hpure:= cp a b c R S d e
    rw [dP] at hpure
    obtain ⟨hp,hqv⟩:= cr d e u v
      (pNF a b c R S d e) (qNF a b c R S d e) c ell hF hG hpure
    have hcP':c ∣ pNF a b c R S d e:= ⟨ell ^ 7 * v,by rw [hp];ring⟩
    have hcQ':c ∣ qNF a b c R S d e:= ⟨ell ^ 7 * u,by rw [hqv];ring⟩
    have hct:= cu a b c R S d e u v hF hcP' hcQ'
    rw [bM,bL] at hct
    obtain ⟨y,hy⟩:= (dO t).mp hct
    have ht:t = h * y:=by simpa only [zero_add] using hy
    have hd:d = d₀ + b * h * y:=by rw [bM,ht];ring
    have he:e = e₀ - a * h * y:=by rw [bL,ht];ring
    have hWy:R * (e₀ - a * h * y) + S * (d₀ + b * h * y) =
        c * (j₀ + k * y):=by
      simpa only [zero_add,mul_assoc,k] using hW y
    obtain ⟨hPv,hQv⟩:= dJ
      a b c R S h d₀ e₀ j₀ k y u v ell hc hWy
      (by rw [← hd,← he];exact hF)
      (by rw [← hd,← he];exact hG)
      (by rw [← hd,← he];exact dP)
    have hdp:(T:I) ∣ (cV a b h d₀ e₀ j₀ k).eval y:=by
      rw [hPv]
      exact aT hTell v
    have hdq:(T:I) ∣ (cW a b h d₀ e₀ j₀ k).eval y:=by
      rw [hQv]
      exact aT hTell u
    obtain ⟨s,hs,z,hz⟩:= h𝓢v y hdp hdq
    exact ⟨y,s,hs,z,hd,he,hPv,hQv,hz⟩
private theorem dQ
 (a b c R S d₀ e₀ u₀ v₀:I)
 (hab:bt a b = 1) (hc:c ≠ 0)
 (hK:co a b c R S ≠ 0)
 (hF₀:e₀ ^ 3 * v₀ = d₀ ^ 3 * u₀ + 1)
 (hG₀:pNF a b c R S d₀ e₀ * u₀ -
 qNF a b c R S d₀ e₀ * v₀ = 0):
 let ell:I:= a * d₀ + b * e₀
 let T:U:= ell.natAbs ^ 7
 ell ≠ 0 ∧ ∃ h q j₀ k:I,∃ 𝓢:Finset (I × U),
 0 < h ∧ q ≠ 0 ∧ k = q - 15 * h * a ^ 4 * b ^ 4 ∧
 h * co a b c R S = c * q ∧
 𝓢.card ≤ 8 ^ T.primeFactors.card ∧
 (∀ s ∈ 𝓢,0 < s.2 ∧
 (T:I) ∣ q * h ^ 3 * (s.2:I) ^ 4) ∧
 ∀ d e u v:I,
 e ^ 3 * v = d ^ 3 * u + 1 →
 pNF a b c R S d e * u - qNF a b c R S d e * v = 0 →
 a * d + b * e = ell →
 ∃ y:I,∃ s ∈ 𝓢,∃ z:I,
 d = d₀ + b * h * y ∧ e = e₀ - a * h * y ∧
 (cV a b h d₀ e₀ j₀ k).eval y = ell ^ 7 * v ∧
 (cW a b h d₀ e₀ j₀ k).eval y = ell ^ 7 * u ∧
 y = s.1 + (s.2:I) * z:=by
  obtain ⟨hell,h,q,j₀,k,𝓢,hh,hq,hk,bG,hW,hcard,hstep,bI⟩:=
