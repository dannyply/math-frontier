open JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C03.PcLemPB3

private def cubicOriginalPositiveTransportStatement : Prop :=
  ∀ c : ℝ,
    (∀ δ : ℕ, 1 ≤ δ →
      ∀ I : Ideal (MvPolynomial (Fin 8) ℚ), I.IsPrime →
        ringKrullDim (MvPolynomial (Fin 8) ℚ ⧸ I) = 1 →
        (∃ e : ℤ, ∃ s₀ : ℕ, ∀ s : ℕ, s₀ ≤ s →
          (Module.finrank ℚ
            (Submodule.map (Ideal.Quotient.mkₐ ℚ I).toLinearMap
              (MvPolynomial.restrictTotalDegree (Fin 8) ℚ s)) : ℤ) =
                (δ : ℤ) * (s : ℤ) + e) →
        ∀ H : ℝ, 1 ≤ H →
          (({P : Fin 8 → ℤ |
            (∀ f ∈ I, MvPolynomial.eval (fun i => (P i : ℚ)) f = 0) ∧
            ∀ i, |(P i : ℝ)| ≤ H} : Set (Fin 8 → ℤ)).ncard : ℝ) ≤
              c * (δ : ℝ) ^ 3 * H ^ (1 / (δ : ℝ)) *
                (Real.log H + (δ : ℝ))) →
    ∀ α β : ℕ, 8 ≤ α + 3 * β →
      ∀ G : MvPolynomial (Fin 4) ℤ,
        G ≠ 0 →
        (∀ m ∈ G.support, m 0 + m 1 = α ∧ m 2 + m 3 = β) →
        Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G) →
        ∀ A B : Matrix (Fin 2) (Fin 2) ℤ,
          (A.det = 1 ∨ A.det = -1) →
          (B.det = 1 ∨ B.det = -1) →
          ∀ L₁ L₂ T₁ T₂ : ℝ,
            L₂ ≤ L₁ → 0 < L₂ → T₂ ≤ T₁ → 0 < T₂ →
            ∀ h : ℤ, (h = 1 ∨ h = -1) →
              let δ : ℝ := (α + 3 * β : ℕ)
              let H : ℝ := max 1 (L₁ ^ 3 * T₁)
              let S : Set ((ℕ × ℕ) × (ℕ × ℕ)) :=
                {q | 1 ≤ q.1.1 ∧ 1 ≤ q.1.2 ∧ 1 ≤ q.2.1 ∧ 1 ≤ q.2.2 ∧
                  ((q.1.2 ^ 3 * q.2.2 : ℕ) : ℤ) =
                    ((q.1.1 ^ 3 * q.2.1 : ℕ) : ℤ) + h ∧
                  |((A.mulVec ![(q.1.1 : ℤ), (q.1.2 : ℤ)]) 0 : ℝ)| ≤ L₁ ∧
                  |((A.mulVec ![(q.1.1 : ℤ), (q.1.2 : ℤ)]) 1 : ℝ)| ≤ L₂ ∧
                  |((B.mulVec ![(q.2.2 : ℤ), (q.2.1 : ℤ)]) 0 : ℝ)| ≤ T₁ ∧
                  |((B.mulVec ![(q.2.2 : ℤ), (q.2.1 : ℤ)]) 1 : ℝ)| ≤ T₂ ∧
                  MvPolynomial.eval
                    ![(q.1.1 : ℤ), (q.1.2 : ℤ), (q.2.1 : ℤ), (q.2.2 : ℤ)] G = 0}
              S.Finite ∧
                (S.ncard : ℝ) ≤ 2 * |c| * δ ^ 3 * H ^ (1 / δ) *
                  (Real.log H + δ)

private theorem cubic_integer_unimodular_core (c : ℝ)
    (hC : FormalAB.S1a1f3383.ConsecutiveCountingTargetsAB.CCDNAt 8 c)
    (f : MvPolynomial (Fin 4) ℤ)
    (hf : ∀ m ∈ f.support, m 0 + m 1 = 3 ∧ m 2 + m 3 = 1)
    (a00 a01 a10 a11 b00 b01 b10 b11 : ℤ)
    (hA : a00*a11-a01*a10=1 ∨ a00*a11-a01*a10=-1)
    (hB : b00*b11-b01*b10=1 ∨ b00*b11-b01*b10=-1)
    (h : ℤ) (hh : h≠0) (α β : ℕ) (G : MvPolynomial (Fin 4) ℤ)
    (hαβ : ¬(α=0 ∧ β=0)) (hG0 : G≠0)
    (hGhom : ∀ m ∈ G.support, m 0+m 1=α ∧ m 2+m 3=β)
    (hGirr : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G))
    (L₁ L₂ T₁ T₂ : ℝ)
    (hL : L₂≤L₁) (hL2 : 0<L₂) (hT : T₂≤T₁) (hT2 : 0<T₂) :
    let S : Set ((ℤ×ℤ)×(ℤ×ℤ)) :=
      {x | Int.gcd x.1.1 x.1.2=1 ∧ Int.gcd x.2.1 x.2.2=1 ∧
        |((a00*x.1.1+a01*x.1.2:ℤ):ℝ)|≤L₁ ∧
        |((a10*x.1.1+a11*x.1.2:ℤ):ℝ)|≤L₂ ∧
        |((b00*x.2.1+b01*x.2.2:ℤ):ℝ)|≤T₁ ∧
        |((b10*x.2.1+b11*x.2.2:ℤ):ℝ)|≤T₂ ∧
        eval ![x.1.1,x.1.2,x.2.1,x.2.2] f=h ∧
        eval ![x.1.1,x.1.2,x.2.1,x.2.2] G=0}
    let δ : ℝ := (α+3*β:ℕ)
    let H : ℝ := max 1 (L₁^3*T₁)
    S.Finite ∧ (S.ncard:ℝ)≤2*c*δ^3*H^(1/δ)*(Real.log H+δ) := by
  dsimp only
  classical
  have hε : (a00 * a11 - a01 * a10) * (a00 * a11 - a01 * a10) = 1 := by
    rcases hA with hA | hA <;> rw [hA] <;> norm_num
  have hη : (b00 * b11 - b01 * b10) * (b00 * b11 - b01 * b10) = 1 := by
    rcases hB with hB | hB <;> rw [hB] <;> norm_num
  obtain ⟨p00, hp00⟩ : ∃ p : ℤ, p = (a00 * a11 - a01 * a10) * a11 := ⟨_, rfl⟩
  obtain ⟨p01, hp01⟩ : ∃ p : ℤ, p = -((a00 * a11 - a01 * a10) * a01) := ⟨_, rfl⟩
  obtain ⟨p10, hp10⟩ : ∃ p : ℤ, p = -((a00 * a11 - a01 * a10) * a10) := ⟨_, rfl⟩
  obtain ⟨p11, hp11⟩ : ∃ p : ℤ, p = (a00 * a11 - a01 * a10) * a00 := ⟨_, rfl⟩
  obtain ⟨q00, hq00⟩ : ∃ p : ℤ, p = (b00 * b11 - b01 * b10) * b11 := ⟨_, rfl⟩
  obtain ⟨q01, hq01⟩ : ∃ p : ℤ, p = -((b00 * b11 - b01 * b10) * b01) := ⟨_, rfl⟩
  obtain ⟨q10, hq10⟩ : ∃ p : ℤ, p = -((b00 * b11 - b01 * b10) * b10) := ⟨_, rfl⟩
  obtain ⟨q11, hq11⟩ : ∃ p : ℤ, p = (b00 * b11 - b01 * b10) * b00 := ⟨_, rfl⟩
  have r1 : p00 * a00 + p01 * a10 = 1 := by rw [hp00, hp01]; linear_combination hε
  have r2 : p00 * a01 + p01 * a11 = 0 := by rw [hp00, hp01]; ring
  have r3 : p10 * a00 + p11 * a10 = 0 := by rw [hp10, hp11]; ring
  have r4 : p10 * a01 + p11 * a11 = 1 := by rw [hp10, hp11]; linear_combination hε
  have s1 : a00 * p00 + a01 * p10 = 1 := by rw [hp00, hp10]; linear_combination hε
  have s2 : a00 * p01 + a01 * p11 = 0 := by rw [hp01, hp11]; ring
  have s3 : a10 * p00 + a11 * p10 = 0 := by rw [hp00, hp10]; ring
  have s4 : a10 * p01 + a11 * p11 = 1 := by rw [hp01, hp11]; linear_combination hε
  have t1 : q00 * b00 + q01 * b10 = 1 := by rw [hq00, hq01]; linear_combination hη
  have t2 : q00 * b01 + q01 * b11 = 0 := by rw [hq00, hq01]; ring
  have t3 : q10 * b00 + q11 * b10 = 0 := by rw [hq10, hq11]; ring
  have t4 : q10 * b01 + q11 * b11 = 1 := by rw [hq10, hq11]; linear_combination hη
  have u1 : b00 * q00 + b01 * q10 = 1 := by rw [hq00, hq10]; linear_combination hη
  have u2 : b00 * q01 + b01 * q11 = 0 := by rw [hq01, hq11]; ring
  have u3 : b10 * q00 + b11 * q10 = 0 := by rw [hq00, hq10]; ring
  have u4 : b10 * q01 + b11 * q11 = 1 := by rw [hq01, hq11]; linear_combination hη
  obtain ⟨F, hFdef⟩ : ∃ F : MvPolynomial (Fin 4) ℤ, F = linSub p00 p01 p10 p11 q00 q01 q10 q11 f :=
    ⟨_, rfl⟩
  obtain ⟨G', hG'def⟩ : ∃ G' : MvPolynomial (Fin 4) ℤ, G' = linSub p00 p01 p10 p11 q00 q01 q10 q11 G :=
    ⟨_, rfl⟩
  have hFhom : ∀ m ∈ F.support, m 0 + m 1 = 3 ∧ m 2 + m 3 = 1 := by
    rw [hFdef]
    exact (bideg_iff _ 3 1).mpr (isWH_linSub _ _ _ _ _ _ _ _ f (3, 1) ((bideg_iff f 3 1).mp hf))
  have hG'hom : ∀ m ∈ G'.support, m 0 + m 1 = α ∧ m 2 + m 3 = β := by
    rw [hG'def]
    exact (bideg_iff _ α β).mpr (isWH_linSub _ _ _ _ _ _ _ _ G (α, β) ((bideg_iff G α β).mp hGhom))
  have hinvZ : ∀ y : MvPolynomial (Fin 4) ℤ,
      linSub a00 a01 a10 a11 b00 b01 b10 b11 (linSub p00 p01 p10 p11 q00 q01 q10 q11 y) = y :=
    fun y => linSub_linSub _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ r1 r2 r3 r4 t1 t2 t3 t4 y
  have hG'0 : G' ≠ 0 := by
    intro h0
    apply hG0
    rw [← hinvZ G, ← hG'def, h0, map_zero]
  have hG'irr : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G') := by
    rw [hG'def, map_linSub]
    refine irreducible_of_inv
      (linSub ((Int.castRingHom ℂ) p00) ((Int.castRingHom ℂ) p01) ((Int.castRingHom ℂ) p10)
        ((Int.castRingHom ℂ) p11) ((Int.castRingHom ℂ) q00) ((Int.castRingHom ℂ) q01)
        ((Int.castRingHom ℂ) q10) ((Int.castRingHom ℂ) q11))
      (linSub ((Int.castRingHom ℂ) a00) ((Int.castRingHom ℂ) a01) ((Int.castRingHom ℂ) a10)
        ((Int.castRingHom ℂ) a11) ((Int.castRingHom ℂ) b00) ((Int.castRingHom ℂ) b01)
        ((Int.castRingHom ℂ) b10) ((Int.castRingHom ℂ) b11)) ?_ ?_ _ hGirr
    · intro y
      apply linSub_linSub
      · rw [← map_mul, ← map_mul, ← map_add, s1, map_one]
      · rw [← map_mul, ← map_mul, ← map_add, s2, map_zero]
      · rw [← map_mul, ← map_mul, ← map_add, s3, map_zero]
      · rw [← map_mul, ← map_mul, ← map_add, s4, map_one]
      · rw [← map_mul, ← map_mul, ← map_add, u1, map_one]
      · rw [← map_mul, ← map_mul, ← map_add, u2, map_zero]
      · rw [← map_mul, ← map_mul, ← map_add, u3, map_zero]
      · rw [← map_mul, ← map_mul, ← map_add, u4, map_one]
    · intro y
      apply linSub_linSub
      · rw [← map_mul, ← map_mul, ← map_add, r1, map_one]
      · rw [← map_mul, ← map_mul, ← map_add, r2, map_zero]
      · rw [← map_mul, ← map_mul, ← map_add, r3, map_zero]
      · rw [← map_mul, ← map_mul, ← map_add, r4, map_one]
      · rw [← map_mul, ← map_mul, ← map_add, t1, map_one]
      · rw [← map_mul, ← map_mul, ← map_add, t2, map_zero]
      · rw [← map_mul, ← map_mul, ← map_add, t3, map_zero]
      · rw [← map_mul, ← map_mul, ← map_add, t4, map_one]
  have key := FormalAB.S1a1f3383.ConsecutiveCountingTargetsAB.lemP_bidegree
    3 (by norm_num) c hC F hFhom h hh α β G' hαβ hG'0 hG'hom hG'irr L₁ L₂ T₁ T₂ hL hL2 hT hT2
  set S' := ({x : (ℤ × ℤ) × (ℤ × ℤ) |
          Int.gcd x.1.1 x.1.2 = 1 ∧ Int.gcd x.2.1 x.2.2 = 1 ∧
          |(x.1.1 : ℝ)| ≤ L₁ ∧ |(x.1.2 : ℝ)| ≤ L₂ ∧
          |(x.2.1 : ℝ)| ≤ T₁ ∧ |(x.2.2 : ℝ)| ≤ T₂ ∧
          MvPolynomial.eval ![x.1.1, x.1.2, x.2.1, x.2.2] F = h ∧
          MvPolynomial.eval ![x.1.1, x.1.2, x.2.1, x.2.2] G' = 0} :
            Set ((ℤ × ℤ) × (ℤ × ℤ))) with hS'def
  let T : (ℤ × ℤ) × (ℤ × ℤ) → (ℤ × ℤ) × (ℤ × ℤ) := fun x =>
    ((a00 * x.1.1 + a01 * x.1.2, a10 * x.1.1 + a11 * x.1.2),
      (b00 * x.2.1 + b01 * x.2.2, b10 * x.2.1 + b11 * x.2.2))
  have hback : ∀ x : (ℤ × ℤ) × (ℤ × ℤ),
      (![(T x).1.1 * p00 + (T x).1.2 * p01, (T x).1.1 * p10 + (T x).1.2 * p11,
        (T x).2.1 * q00 + (T x).2.2 * q01, (T x).2.1 * q10 + (T x).2.2 * q11] : Fin 4 → ℤ) =
        ![x.1.1, x.1.2, x.2.1, x.2.2] := by
    intro x
    have e0 : (T x).1.1 * p00 + (T x).1.2 * p01 = x.1.1 := by
      show (a00 * x.1.1 + a01 * x.1.2) * p00 + (a10 * x.1.1 + a11 * x.1.2) * p01 = x.1.1
      linear_combination x.1.1 * r1 + x.1.2 * r2
    have e1 : (T x).1.1 * p10 + (T x).1.2 * p11 = x.1.2 := by
      show (a00 * x.1.1 + a01 * x.1.2) * p10 + (a10 * x.1.1 + a11 * x.1.2) * p11 = x.1.2
      linear_combination x.1.1 * r3 + x.1.2 * r4
    have e2 : (T x).2.1 * q00 + (T x).2.2 * q01 = x.2.1 := by
      show (b00 * x.2.1 + b01 * x.2.2) * q00 + (b10 * x.2.1 + b11 * x.2.2) * q01 = x.2.1
      linear_combination x.2.1 * t1 + x.2.2 * t2
    have e3 : (T x).2.1 * q10 + (T x).2.2 * q11 = x.2.2 := by
      show (b00 * x.2.1 + b01 * x.2.2) * q10 + (b10 * x.2.1 + b11 * x.2.2) * q11 = x.2.2
      linear_combination x.2.1 * t3 + x.2.2 * t4
    rw [e0, e1, e2, e3]
  have hmaps : ∀ x ∈ ({x : (ℤ × ℤ) × (ℤ × ℤ) |
          Int.gcd x.1.1 x.1.2 = 1 ∧ Int.gcd x.2.1 x.2.2 = 1 ∧
          |((a00 * x.1.1 + a01 * x.1.2 : ℤ) : ℝ)| ≤ L₁ ∧ |((a10 * x.1.1 + a11 * x.1.2 : ℤ) : ℝ)| ≤ L₂ ∧
          |((b00 * x.2.1 + b01 * x.2.2 : ℤ) : ℝ)| ≤ T₁ ∧ |((b10 * x.2.1 + b11 * x.2.2 : ℤ) : ℝ)| ≤ T₂ ∧
          MvPolynomial.eval ![x.1.1, x.1.2, x.2.1, x.2.2] f = h ∧
          MvPolynomial.eval ![x.1.1, x.1.2, x.2.1, x.2.2] G = 0} :
            Set ((ℤ × ℤ) × (ℤ × ℤ))), T x ∈ S' := by
    intro x hx
    obtain ⟨hx1, hx2, hb1, hb2, hb3, hb4, hfx, hGx⟩ := hx
    rw [hS'def, Set.mem_ofPred_eq]
    refine ⟨gcd_lin a00 a01 a10 a11 x.1.1 x.1.2 hε hx1, gcd_lin b00 b01 b10 b11 x.2.1 x.2.2 hη hx2,
      hb1, hb2, hb3, hb4, ?_, ?_⟩
    · show eval ![(T x).1.1, (T x).1.2, (T x).2.1, (T x).2.2] F = h
      rw [hFdef, eval_linSub, hback x]
      exact hfx
    · show eval ![(T x).1.1, (T x).1.2, (T x).2.1, (T x).2.2] G' = 0
      rw [hG'def, eval_linSub, hback x]
      exact hGx
  have hinj : Set.InjOn T ({x : (ℤ × ℤ) × (ℤ × ℤ) |
          Int.gcd x.1.1 x.1.2 = 1 ∧ Int.gcd x.2.1 x.2.2 = 1 ∧
          |((a00 * x.1.1 + a01 * x.1.2 : ℤ) : ℝ)| ≤ L₁ ∧ |((a10 * x.1.1 + a11 * x.1.2 : ℤ) : ℝ)| ≤ L₂ ∧
          |((b00 * x.2.1 + b01 * x.2.2 : ℤ) : ℝ)| ≤ T₁ ∧ |((b10 * x.2.1 + b11 * x.2.2 : ℤ) : ℝ)| ≤ T₂ ∧
          MvPolynomial.eval ![x.1.1, x.1.2, x.2.1, x.2.2] f = h ∧
          MvPolynomial.eval ![x.1.1, x.1.2, x.2.1, x.2.2] G = 0} :
            Set ((ℤ × ℤ) × (ℤ × ℤ))) := by
    intro x _ y _ hxy
    have hb := hback x
    rw [hxy, hback y] at hb
    have h0 := congrFun hb 0
    have h1 := congrFun hb 1
    have h2 := congrFun hb 2
    have h3 := congrFun hb 3
    simp at h0 h1 h2 h3
    obtain ⟨⟨x0, x1⟩, ⟨x2, x3⟩⟩ := x
    obtain ⟨⟨y0, y1⟩, ⟨y2, y3⟩⟩ := y
    simp only at h0 h1 h2 h3
    rw [h0, h1, h2, h3]
  have hS'fin : S'.Finite := by
    have kbox : ∀ (z : ℤ) (L : ℝ), |(z : ℝ)| ≤ L → z ∈ Set.Icc (-⌈L⌉) ⌈L⌉ := by
      intro z L hz
      rw [abs_le] at hz
      have hc := Int.le_ceil L
      constructor
      · have : (-(⌈L⌉ : ℝ)) ≤ (z : ℝ) := by linarith [hz.1]
        exact_mod_cast this
      · have : (z : ℝ) ≤ (⌈L⌉ : ℝ) := by linarith [hz.2]
        exact_mod_cast this
    apply Set.Finite.subset (((Set.finite_Icc (-⌈L₁⌉) ⌈L₁⌉).prod (Set.finite_Icc (-⌈L₂⌉) ⌈L₂⌉)).prod
      ((Set.finite_Icc (-⌈T₁⌉) ⌈T₁⌉).prod (Set.finite_Icc (-⌈T₂⌉) ⌈T₂⌉)))
    intro y hy
    rw [hS'def, Set.mem_ofPred_eq] at hy
    obtain ⟨-, -, h1, h2, h3, h4, -⟩ := hy
    exact Set.mem_prod.mpr ⟨Set.mem_prod.mpr ⟨kbox _ _ h1, kbox _ _ h2⟩,
      Set.mem_prod.mpr ⟨kbox _ _ h3, kbox _ _ h4⟩⟩
  have hcount := Set.ncard_le_ncard_of_injOn T hmaps hinj hS'fin
  refine ⟨Set.Finite.of_finite_image (hS'fin.subset ?_) hinj, ?_⟩
  · rintro _ ⟨x,hx,rfl⟩
    exact hmaps x hx
  · calc _ ≤ ((S'.ncard : ℕ) : ℝ) := by exact_mod_cast hcount
         _ ≤ _ := key

private theorem unit_coprime (a b : ℕ) (h : ℤ)
    (hsign : h = 1 ∨ h = -1) (heq : (a : ℤ) = (b : ℤ) + h) :
    a.Coprime b := by
  apply Nat.coprime_of_dvd'
  intro p hp hpa hpb
  have haZ : (p : ℤ) ∣ (a : ℤ) := by exact_mod_cast hpa
  have hbZ : (p : ℤ) ∣ (b : ℤ) := by exact_mod_cast hpb
  have hph : (p : ℤ) ∣ h := by
    have hh : h = (a : ℤ) - (b : ℤ) := by omega
    rw [hh]
    exact dvd_sub haZ hbZ
  rcases hsign with rfl | rfl
  · exact_mod_cast hph
  · have hp1 : (p : ℤ) ∣ (1 : ℤ) := by
      simpa using (dvd_neg.mpr hph : (p : ℤ) ∣ -(-1 : ℤ))
    exact_mod_cast hp1

private theorem both_coprime (d e u v : ℕ) (h : ℤ)
    (hsign : h = 1 ∨ h = -1)
    (hshift : ((e ^ 3 * v : ℕ) : ℤ) = ((d ^ 3 * u : ℕ) : ℤ) + h) :
    d.Coprime e ∧ u.Coprime v := by
  have hn := (unit_coprime (e ^ 3 * v) (d ^ 3 * u) h hsign hshift).symm
  have hdvd : d ∣ d ^ 3 * u := ⟨d ^ 2 * u, by ring⟩
  have hevd : e ∣ e ^ 3 * v := ⟨e ^ 2 * v, by ring⟩
  have huvd : u ∣ d ^ 3 * u := ⟨d ^ 3, by ring⟩
  have hvvd : v ∣ e ^ 3 * v := ⟨e ^ 3, by ring⟩
  exact ⟨hn.of_dvd hdvd hevd, hn.of_dvd huvd hvvd⟩

private noncomputable def unitSurface : MvPolynomial (Fin 4) ℤ :=
  X 1^3*X 3-X 0^3*X 2

private lemma unitSurface_eval (d e u v : ℤ) :
    eval ![d,e,u,v] unitSurface=e^3*v-d^3*u := by
  simp [unitSurface]

private lemma unitSurface_hom :
    ∀ m∈unitSurface.support, m 0+m 1=3 ∧ m 2+m 3=1 := by
  rw [bideg_iff]
  have h1 : IsWeightedHomogeneous PcLemP.wt
      (X 1^3*X 3 : MvPolynomial (Fin 4) ℤ) (3,1) := by
    have ht := ((isWeightedHomogeneous_X ℤ PcLemP.wt (1:Fin 4)).pow 3).mul
      (isWeightedHomogeneous_X ℤ PcLemP.wt (3:Fin 4))
    convert ht using 1
    ext <;> simp [PcLemP.wt]
  have h2 : IsWeightedHomogeneous PcLemP.wt
      (X 0^3*X 2 : MvPolynomial (Fin 4) ℤ) (3,1) := by
    have ht := ((isWeightedHomogeneous_X ℤ PcLemP.wt (0:Fin 4)).pow 3).mul
      (isWeightedHomogeneous_X ℤ PcLemP.wt (2:Fin 4))
    convert ht using 1
    ext <;> simp [PcLemP.wt]
  have ht := Submodule.sub_mem _
    ((mem_weightedHomogeneousSubmodule ℤ PcLemP.wt (3,1) _).mpr h1)
    ((mem_weightedHomogeneousSubmodule ℤ PcLemP.wt (3,1) _).mpr h2)
  exact (mem_weightedHomogeneousSubmodule ℤ PcLemP.wt (3,1) _).mp ht

private def natToInteger (q : (ℕ×ℕ)×(ℕ×ℕ)) : (ℤ×ℤ)×(ℤ×ℤ) :=
  (((q.1.1:ℤ),(q.1.2:ℤ)),((q.2.1:ℤ),(q.2.2:ℤ)))

private lemma natToInteger_injective : Function.Injective natToInteger := by
  intro q r h
  apply Prod.ext
  · apply Prod.ext
    · have hz : (q.1.1:ℤ)=(r.1.1:ℤ) :=
        congrArg (fun z : (ℤ×ℤ)×(ℤ×ℤ) => z.1.1) h
      exact_mod_cast hz
    · have hz : (q.1.2:ℤ)=(r.1.2:ℤ) :=
        congrArg (fun z : (ℤ×ℤ)×(ℤ×ℤ) => z.1.2) h
      exact_mod_cast hz
  · apply Prod.ext
    · have hz : (q.2.1:ℤ)=(r.2.1:ℤ) :=
        congrArg (fun z : (ℤ×ℤ)×(ℤ×ℤ) => z.2.1) h
      exact_mod_cast hz
    · have hz : (q.2.2:ℤ)=(r.2.2:ℤ) :=
        congrArg (fun z : (ℤ×ℤ)×(ℤ×ℤ) => z.2.2) h
      exact_mod_cast hz

private theorem cubic_original_positive_transport :
    cubicOriginalPositiveTransportStatement := by
  classical
  intro c hCC α β hδ G hG0 hGhom hGirr A B hA hB
    L₁ L₂ T₁ T₂ hL hL2 hT hT2 h hsign
  dsimp only
  let S : Set ((ℕ×ℕ)×(ℕ×ℕ)) :=
