 (hell:a * d₀ + b * e₀ ≠ 0)
 (hq:k + 15 * h * a ^ 4 * b ^ 4 ≠ 0):
 (er a b h d₀ e₀ j₀ k).natDegree = 7:=by
  let F:= eq a b h d₀ e₀ j₀ k
  have hFdeg:F.natDegree = 7:=
    es a b h d₀ e₀ j₀ k ha hb hh hq
  have hF0:F ≠ 0:=by
    intro hz
    have hzdeg:F.natDegree = 0:=by rw [hz];rfl
    omega
  have hFc:F.coeff 7 ≠ 0:=by
    rw [← hFdeg]
    change F.leadingCoeff ≠ 0
    exact Polynomial.leadingCoeff_ne_zero.mpr hF0
  have hmapc:(ar (an O) F).coeff 7 ≠ 0:=by
    rw [Polynomial.coeff_map]
    change ((F.coeff 7:I):O) ≠ 0
    exact_mod_cast hFc
  have bG:(ar (an O) F).natDegree = 7:=
    ep _ 7
      (Polynomial.natDegree_map_le.trans hFdeg.le) hmapc
  have hellR:((a * d₀ + b * e₀:I):O) ≠ 0:=by exact_mod_cast hell
  have hc:1 / (((a * d₀ + b * e₀:I):O) ^ 7) ≠ 0:=
    div_ne_zero (by norm_num) (pow_ne_zero 7 hellR)
  dsimp only [er]
  rw [Polynomial.natDegree_C_mul hc]
  exact bG
private theorem eu
 (a b h d₀ e₀ j₀ k:I) (y:O):
 (er a b h d₀ e₀ j₀ k).eval y =
 ((d₀:O) + (b:O) * (h:O) * y) ^ 3 *
 (ar (an O) (cW a b h d₀ e₀ j₀ k)).eval y /
 (((a * d₀ + b * e₀:I):O) ^ 7):=by
  have hcast (z:I):(an O) z = (z:O):=by
    solve | simp
  simp only [er,eq,cN,
    Polynomial.map_mul,Polynomial.map_add,Polynomial.map_C,Polynomial.map_X,
    aR,aY,aW,bh,hcast]
  push_cast
  ring
private theorem ew
 (a b c R S h d₀ e₀ j₀ k:I)
 (hW₀:R * e₀ + S * d₀ = c * j₀)
 (hW₁:h * (b * S - a * R) = c * k) (y:O):
 (c:O) *
 (ar (an O) (cW a b h d₀ e₀ j₀ k)).eval y =
 scalarQ (a:O) (b:O) (c:O) (R:O) (S:O)
 ((d₀:O) + (b:O) * (h:O) * y)
 ((e₀:O) - (a:O) * (h:O) * y):=by
  have hW₀R:(R:O) * (e₀:O) + (S:O) * (d₀:O) =
      (c:O) * (j₀:O):=by exact_mod_cast hW₀
  have hW₁R:(h:O) * ((b:O) * (S:O) - (a:O) * (R:O)) =
      (c:O) * (k:O):=by exact_mod_cast hW₁
  have hW:(R:O) * ((e₀:O) - (a:O) * (h:O) * y) +
      (S:O) * ((d₀:O) + (b:O) * (h:O) * y) =
        (c:O) * ((j₀:O) + (k:O) * y):=by
    linear_combination hW₀R + y * hW₁R
  have hcast (z:I):(an O) z = (z:O):=by
    solve | simp
  simp only [cW,cN,Polynomial.map_mul,Polynomial.map_sub,
    Polynomial.map_add,Polynomial.map_C,Polynomial.map_X,aR,
    Polynomial.eval_sub,aY,aW,bh,hcast]
  dsimp only [scalarQ]
  push_cast
  linear_combination -((e₀:O) - (a:O) * (h:O) * y) ^ 3 * hW
private theorem ex
 (a b c R S h d₀ e₀ j₀ k:I)
 (hc:c ≠ 0) (hell:a * d₀ + b * e₀ ≠ 0)
 (hW₀:R * e₀ + S * d₀ = c * j₀)
 (hW₁:h * (b * S - a * R) = c * k):
 (fun y:O => (er a b h d₀ e₀ j₀ k).eval y) =
 (fun y:O =>
 ((d₀:O) + (b:O) * (h:O) * y) ^ 3 *
 scalarQ (a:O) (b:O) (c:O) (R:O) (S:O)
 ((d₀:O) + (b:O) * (h:O) * y)
 ((e₀:O) - (a:O) * (h:O) * y) /
 ((c:O) * (((a * d₀ + b * e₀:I):O) ^ 7))):=by
  funext y
  rw [eu]
  rw [← ew a b c R S h d₀ e₀ j₀ k hW₀ hW₁ y]
  have hcR:(c:O) ≠ 0:=by exact_mod_cast hc
  have hellR:((a * d₀ + b * e₀:I):O) ≠ 0:=by exact_mod_cast hell
  field_simp [hcR,hellR]
private theorem ey
 (a b c R S h d₀ e₀ j₀ k:I)
 (bG:∀ y:I,R * (e₀ - a * h * y) + S * (d₀ + b * h * y) =
 c * (j₀ + k * y)):
 R * e₀ + S * d₀ = c * j₀ ∧ h * (b * S - a * R) = c * k:=by
  have h₀:= bG 0
  have h₁:= bG 1
  constructor
  · simpa only [mul_zero,sub_zero,add_zero] using h₀
  · linear_combination h₁ - h₀
private theorem ez
 (a b h d₀ e₀ j₀ k y u:I)
 (hell:a * d₀ + b * e₀ ≠ 0)
 (bG:(cW a b h d₀ e₀ j₀ k).eval y =
 (a * d₀ + b * e₀) ^ 7 * u):
 (er a b h d₀ e₀ j₀ k).eval (y:O) =
 (((d₀ + b * h * y:I):O) ^ 3) * (u:O):=by
  have hmap:
      (ar (an O) (cW a b h d₀ e₀ j₀ k)).eval (y:O) =
        (((cW a b h d₀ e₀ j₀ k).eval y:I):O):=by
    have ht:= Polynomial.eval₂_at_apply (p:= cW a b h d₀ e₀ j₀ k)
      (an O) y
    rw [← Polynomial.eval_map] at ht
    solve | simp
  have bI:
      (ar (an O) (cW a b h d₀ e₀ j₀ k)).eval (y:O) =
        (((a * d₀ + b * e₀:I):O) ^ 7) * (u:O):=by
    rw [hmap,bG]
    push_cast
    rfl
  rw [eu,bI]
  have hellR:((a * d₀ + b * e₀:I):O) ≠ 0:=by exact_mod_cast hell
  apply (div_eq_iff (pow_ne_zero 7 hellR)).2
  push_cast
  ring
end P7I
