noncomputable def rho (D E : ℝ) (M j : ℕ) : ℝ :=
  D/(2*E)*(1+1/(M:ℝ))^j
def indices (D E : ℝ) (M : ℕ) : Set ℕ :=
  {j | D/(2*E)≤rho D E M j ∧ rho D E M j≤2*D/E}
noncomputable def cells (D E : ℝ) (M : ℕ) : Finset ℕ := by
  classical
  exact (Finset.range (3*M+1)).filter
    (fun j=>D/(2*E)≤rho D E M j ∧ rho D E M j≤2*D/E)

private theorem bernoulli (t : ℝ) (ht : 0≤t) (j : ℕ) :
    1+(j:ℝ)*t≤(1+t)^j := by
  induction j with
  | zero => simp
  | succ j ih =>
    have hj : (0:ℝ)≤j := by positivity
    calc
      1+((j+1:ℕ):ℝ)*t≤(1+(j:ℝ)*t)*(1+t) := by
        push_cast
        nlinarith [mul_nonneg hj (sq_nonneg t)]
      _≤(1+t)^j*(1+t) :=
        mul_le_mul_of_nonneg_right ih (by linarith)
      _=(1+t)^(j+1) := (pow_succ _ _).symm

private theorem index_le (D E : ℝ) (M j : ℕ)
    (hD : 0<D) (hE : 0<E) (hM : 1≤M)
    (hj : j∈indices D E M) : j≤3*M := by
  have hM0 : (0:ℝ)<M := by exact_mod_cast (show 0<M by omega)
  have hMne : (M:ℝ)≠0 := ne_of_gt hM0
  let a : ℝ := D/(2*E)
  have ha : 0<a := by dsimp [a]; positivity
  have hfour : 2*D/E=4*a := by
    dsimp [a]
    field_simp [ne_of_gt hE] ; ring
  have htop : a*(1+1/(M:ℝ))^j≤4*a := by
    have h := hj.2
    change a*(1+1/(M:ℝ))^j≤2*D/E at h
    rwa [hfour] at h
  have hpow : (1+1/(M:ℝ))^j≤4 := by
    by_contra hn
    have hp := mul_pos ha (sub_pos.mpr (lt_of_not_ge hn))
    nlinarith
  have hb := (bernoulli (1/(M:ℝ)) (by positivity) j).trans hpow
  have hm := mul_le_mul_of_nonneg_right hb (le_of_lt hM0)
  have heq :
      (1+(j:ℝ)*(1/(M:ℝ)))*(M:ℝ)=(M:ℝ)+(j:ℝ) := by
    field_simp [hMne]
  have hbound : (j:ℝ)≤3*(M:ℝ) := by nlinarith
  exact_mod_cast hbound

private theorem mem_cells_iff (D E : ℝ) (M j : ℕ)
    (hD : 0<D) (hE : 0<E) (hM : 1≤M) :
    j∈cells D E M ↔ j∈indices D E M := by
  classical
  simp only [cells,Finset.mem_filter,Finset.mem_range,Nat.lt_succ_iff]
  constructor
  · intro h
    exact h.2
  · intro h
    exact ⟨index_le D E M j hD hE hM h,h⟩

private theorem dyadic_ratio_strict (D E : ℝ) (d e : ℕ)
    (hD : 0<D) (hE : 0<E) (hd : 0<d) (he : 0<e)
    (hDlo : D/2<(d:ℝ)) (hDup : (d:ℝ)≤D)
    (hElo : E/2<(e:ℝ)) (hEup : (e:ℝ)≤E) :
    D/(2*E)<(d:ℝ)/(e:ℝ) ∧ (d:ℝ)/(e:ℝ)<2*D/E := by
  have hd0 : (0:ℝ)<d := by exact_mod_cast hd
  have he0 : (0:ℝ)<e := by exact_mod_cast he
  constructor
  · apply (div_lt_div_iff₀ (by positivity : 0<2*E) he0).mpr
    have h1 := mul_nonneg (le_of_lt hD) (sub_nonneg.mpr hEup)
    have h2 := mul_pos hE (show 0<2*(d:ℝ)-D by linarith)
    nlinarith
  · apply (div_lt_div_iff₀ he0 hE).mpr
    have h1 := mul_nonneg (sub_nonneg.mpr hDup) (le_of_lt hE)
    have h2 := mul_pos hD (show 0<2*(e:ℝ)-E by linarith)
    nlinarith

