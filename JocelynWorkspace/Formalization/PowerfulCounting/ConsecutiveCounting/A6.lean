    dsimp [μ, mStar, A6Threshold8ActualAuxiliary.mStar]
    linarith only [hs', hsqrt, hδ']
  have hpone : 1 ≤ x ^ μ := by
    have ht := Real.rpow_le_rpow_of_exponent_le hx1 (show (0 : ℝ) ≤ μ by linarith)
