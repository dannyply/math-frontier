private def complexFirstEquiv
    (P Q : Matrix (Fin 2) (Fin 2) ℤ) (hPQ : P*Q=1) (hQP : Q*P=1) :
    MvPolynomial (Fin 4) ℂ ≃+* MvPolynomial (Fin 4) ℂ where
  toFun := complexFirstHom P
  invFun := complexFirstHom Q
  left_inv F := by rw [complexFirst_comp,hPQ,complexFirst_identity]
  right_inv F := by rw [complexFirst_comp,hQP,complexFirst_identity]
  map_mul' := (complexFirstHom P).map_mul
  map_add' := (complexFirstHom P).map_add

