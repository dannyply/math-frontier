private theorem both_coprime3 (d e u v : ℕ) (h : ℤ)
    (hsign : h = 1 ∨ h = -1)
    (hshift : ((e ^ 3 * v : ℕ) : ℤ) = ((d ^ 3 * u : ℕ) : ℤ) + h) :
    d.Coprime e ∧ u.Coprime v := by
  have hn := (unit_coprime (e ^ 3 * v) (d ^ 3 * u) h hsign hshift).symm
  have hdvd : d ∣ d ^ 3 * u := ⟨d ^ 2 * u, by ring⟩
  have hevd : e ∣ e ^ 3 * v := ⟨e ^ 2 * v, by ring⟩
  have huvd : u ∣ d ^ 3 * u := ⟨d ^ 3, by ring⟩
  have hvvd : v ∣ e ^ 3 * v := ⟨e ^ 3, by ring⟩
  exact ⟨hn.of_dvd hdvd hevd, hn.of_dvd huvd hvvd⟩

private theorem graph_shift_transfer
    (C E d e u v h : ℤ)
    (hgraph : C * u = E * v)
    (hshift : e ^ 3 * v - d ^ 3 * u = h) :
    let R := e ^ 3 * C - d ^ 3 * E
    R * u = h * E ∧ R * v = h * C := by
  dsimp
  constructor
  · linear_combination e ^ 3 * hgraph + E * hshift
  · linear_combination d ^ 3 * hgraph + C * hshift

private theorem graph_value_divides_resultant
    (C E d e u v h B : ℤ)
    (hsign : h = 1 ∨ h = -1)
    (hgraph : C * u = E * v)
    (hshift : e ^ 3 * v - d ^ 3 * u = h)
    (hres : (Int.gcd E C : ℤ) ∣ B)
    (hB : B ≠ 0) :
    let R := e ^ 3 * C - d ^ 3 * E
    R ≠ 0 ∧ R ∣ B := by
  dsimp
  let R : ℤ := e ^ 3 * C - d ^ 3 * E
  have htrans : R * u = h * E ∧ R * v = h * C :=
    graph_shift_transfer C E d e u v h hgraph hshift
  have hRC : R ∣ C := by
    rcases hsign with rfl | rfl
    · refine ⟨v, ?_⟩
      simpa only [one_mul] using htrans.2.symm
    · refine ⟨-v, ?_⟩
      nlinarith [htrans.2]
  have hRE : R ∣ E := by
    rcases hsign with rfl | rfl
    · refine ⟨u, ?_⟩
      simpa only [one_mul] using htrans.1.symm
    · refine ⟨-u, ?_⟩
      nlinarith [htrans.1]
  have hRgcd : R ∣ (Int.gcd E C : ℤ) := by
    first | exact Int.dvd_gcd hRE hRC | exact Int.dvd_coe_gcd hRE hRC
  have hRB : R ∣ B := hRgcd.trans hres
  have hR0 : R ≠ 0 := by
    intro hz
    rw [hz, zero_dvd_iff] at hRB
    exact hB hRB
  exact ⟨hR0, hRB⟩

private theorem second_pair_unique
    (C E d e u v u' v' h : ℤ)
    (hR0 : e ^ 3 * C - d ^ 3 * E ≠ 0)
    (hg : C * u = E * v)
    (hs : e ^ 3 * v - d ^ 3 * u = h)
    (hg' : C * u' = E * v')
    (hs' : e ^ 3 * v' - d ^ 3 * u' = h) :
    u = u' ∧ v = v' := by
  have h1 := graph_shift_transfer C E d e u v h hg hs
  have h2 := graph_shift_transfer C E d e u' v' h hg' hs'
  constructor
  · exact mul_left_cancel₀ hR0 (h1.1.trans h2.1.symm)
  · exact mul_left_cancel₀ hR0 (h1.2.trans h2.2.symm)

private theorem divisor_fee (K : ℝ) (hK : 0 ≤ K)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ C : ℝ, 0 < C ∧ ∀ x : ℝ, 2 ≤ x →
      ∀ B : ℤ, B ≠ 0 →
        |(B : ℝ)| ≤ 1625702400 * x ^ (16 * K) →
        (39200 : ℝ) * (B.natAbs.divisors.card : ℝ) ^ 8 ≤ C * x ^ ε := by
  let δ : ℝ := ε / (128 * K + 1)
  have hden : 0 < 128 * K + 1 := by nlinarith
  have hδ : 0 < δ := div_pos hε hden
  have hδeq : δ * (128 * K + 1) = ε :=
    div_mul_cancel₀ ε (ne_of_gt hden)
  have hexp : (16 * K) * (8 * δ) ≤ ε := by nlinarith
  obtain ⟨Cd, hCd, hdb⟩ := C01.PcLowdegRed.divisor_bound δ hδ
  let C : ℝ := 39200 * Cd ^ 8 * (1625702400 : ℝ) ^ (8 * δ) + 1
  refine ⟨C, by dsimp [C]; positivity, ?_⟩
  intro x hx B hB hBb
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hcast : (B.natAbs : ℝ) = |(B : ℝ)| := by
    rw [← Int.cast_natCast, Int.natCast_natAbs, Int.cast_abs]
  have hD : (B.natAbs.divisors.card : ℝ) ≤ Cd * |(B : ℝ)| ^ δ := by
    have ht := hdb B.natAbs (Int.natAbs_ne_zero.mpr hB)
    rwa [hcast] at ht
  have hD8 : (B.natAbs.divisors.card : ℝ) ^ 8 ≤
      Cd ^ 8 * |(B : ℝ)| ^ (8 * δ) := by
    calc
      (B.natAbs.divisors.card : ℝ) ^ 8 ≤
          (Cd * |(B : ℝ)| ^ δ) ^ 8 :=
        pow_le_pow_left₀ (Nat.cast_nonneg _) hD _
      _ = Cd ^ 8 * |(B : ℝ)| ^ (8 * δ) := by
        rw [mul_pow]
        congr 1
        rw [← Real.rpow_natCast, ← Real.rpow_mul (abs_nonneg _)]
        congr 1
        push_cast
        ring
  have hMeta : |(B : ℝ)| ^ (8 * δ) ≤
      (1625702400 : ℝ) ^ (8 * δ) * x ^ ε := by
    calc
      |(B : ℝ)| ^ (8 * δ) ≤ (1625702400 * x ^ (16 * K)) ^ (8 * δ) :=
        Real.rpow_le_rpow (abs_nonneg _) hBb (by positivity)
      _ = (1625702400 : ℝ) ^ (8 * δ) * (x ^ (16 * K)) ^ (8 * δ) :=
        Real.mul_rpow (by norm_num) (Real.rpow_nonneg hx0.le _)
      _ = (1625702400 : ℝ) ^ (8 * δ) * x ^ ((16 * K) * (8 * δ)) := by
        rw [← Real.rpow_mul hx0.le]
      _ ≤ (1625702400 : ℝ) ^ (8 * δ) * x ^ ε :=
        mul_le_mul_of_nonneg_left
          (Real.rpow_le_rpow_of_exponent_le hx1 hexp)
          (Real.rpow_nonneg (by norm_num) _)
  calc
    (39200 : ℝ) * (B.natAbs.divisors.card : ℝ) ^ 8 ≤
        39200 * (Cd ^ 8 * |(B : ℝ)| ^ (8 * δ)) :=
      mul_le_mul_of_nonneg_left hD8 (by norm_num)
    _ ≤ 39200 * (Cd ^ 8 * ((1625702400 : ℝ) ^ (8 * δ) * x ^ ε)) :=
      mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left hMeta
          (pow_nonneg (by linarith : 0 ≤ Cd) _)) (by norm_num)
    _ = (39200 * Cd ^ 8 * (1625702400 : ℝ) ^ (8 * δ)) * x ^ ε := by ring
    _ ≤ C * x ^ ε := by
      apply mul_le_mul_of_nonneg_right _ (Real.rpow_nonneg hx0.le _)
      dsimp [C]
      linarith

private theorem shift_int
    (d e u v : ℕ) (h : ℤ)
    (hs : ((e ^ 3 * v : ℕ) : ℤ) = ((d ^ 3 * u : ℕ) : ℤ) + h) :
    (e : ℤ) ^ 3 * (v : ℤ) - (d : ℤ) ^ 3 * (u : ℤ) = h := by
  push_cast at hs
  linear_combination hs

private lemma three_root_divisor_cover (hSt : StewartHyp)
    (n : ℕ) (hn7 : n ≤ 7)
    (R : MvPolynomial (Fin 2) ℤ) (hRh : R.IsHomogeneous n)
    (hR0 : R ≠ 0) (hroots : ThreeProjectiveZeros R)
    (M : ℤ) (hM : M ≠ 0) :
    ∃ T : Finset (ℤ×ℤ),
      (∀ rs : ℤ×ℤ, Int.gcd rs.1 rs.2=1 →
        eval ![rs.1,rs.2] R ∣ M → rs ∈ T) ∧
      T.card ≤ 39200*M.natAbs.divisors.card^8 := by
  classical
  obtain ⟨q,a,hq3,hqn,hcontent,hsqf,hkernel⟩ :=
    C01.PcKer.p_kernel n R hRh hR0 hroots
  have hq7 : q ≤ 7 := hqn.trans hn7
  let F : ℤ×ℤ → ℤ := fun rs =>
    ∑ i : Fin (q+1), a i*rs.1^(i:ℕ)*rs.2^(q-(i:ℕ))
  obtain ⟨T,hTmem,hTcard⟩ := C01.PcLowdegRed.count_T F q (by omega)
    (hSt q hq3 a hcontent hsqf) M hM
  refine ⟨T,?_,?_⟩
  · intro rs hp hdvd
    exact hTmem rs hp ((hkernel rs.1 rs.2).trans hdvd)
  · have hn0 : M.natAbs ≠ 0 := Int.natAbs_ne_zero.mpr hM
    have hω : 2^M.natAbs.primeFactors.card ≤ M.natAbs.divisors.card :=
      C01.PcLowdegRed.two_pow_card_primeFactors_le _ hn0
    have hqpow : q^(1+M.natAbs.primeFactors.card) ≤
        7*M.natAbs.divisors.card^7 := by
      calc
        q^(1+M.natAbs.primeFactors.card) ≤ 7^(1+M.natAbs.primeFactors.card) :=
          Nat.pow_le_pow_left hq7 _
        _ = 7*7^M.natAbs.primeFactors.card := by rw [pow_add,pow_one]
        _ ≤ 7*(2^7)^M.natAbs.primeFactors.card :=
          Nat.mul_le_mul le_rfl (Nat.pow_le_pow_left (by norm_num : 7≤2^7) _)
        _ = 7*(2^M.natAbs.primeFactors.card)^7 := by
          rw [←pow_mul,←pow_mul,Nat.mul_comm 7 M.natAbs.primeFactors.card]
        _ ≤ 7*M.natAbs.divisors.card^7 :=
          Nat.mul_le_mul le_rfl (Nat.pow_le_pow_left hω _)
    calc
      T.card ≤ M.natAbs.divisors.card*
          (2*(2800*q^(1+M.natAbs.primeFactors.card))) := hTcard
      _ ≤ M.natAbs.divisors.card*(2*(2800*(7*M.natAbs.divisors.card^7))) :=
        Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ hqpow))
      _ = 39200*M.natAbs.divisors.card^8 := by ring

private def Q3 (t : ℚ) : ℚ := (3*t^5-10*t^3+15*t+8)/16

private theorem pure_fifth_scalar
    (kappa a b d e u v : ℚ)
    (hk : kappa ≠ 0) (hab : a ≠ 0 ∨ b ≠ 0)
    (hd : d ≠ 0) (he : e ≠ 0)
    (hshift : e^3*v-d^3*u=1)
    (hgraph :
      u*(kappa*b^3*(10*a^2*d^2+5*a*b*d*e+b^2*e^2)) =
      v*(-kappa*a^3*(a^2*d^2+5*a*b*d*e+10*b^2*e^2))) :
    a*d+b*e ≠ 0 ∧
      d^3*u = -Q3 ((a*d-b*e)/(a*d+b*e)) := by
  let A : ℚ := a*d
  let B : ℚ := b*e
  let L : ℚ := A+B
  let F : ℚ := A^2+5*A*B+10*B^2
  let p : ℚ := -kappa*a^3*(a^2*d^2+5*a*b*d*e+10*b^2*e^2)
  let q : ℚ := kappa*b^3*(10*a^2*d^2+5*a*b*d*e+b^2*e^2)
  have hgraph' : q*u=p*v := by
    dsimp [p,q]
    linear_combination hgraph
  have hR : e^3*q-d^3*p=kappa*L^5 := by
    dsimp [p,q,L,A,B]
    ring
  have htrans : (e^3*q-d^3*p)*u=p := by
    linear_combination e^3*hgraph'+p*hshift
  have hcore : kappa*L^5*(d^3*u) = -kappa*A^3*F := by
    calc
      kappa*L^5*(d^3*u) = d^3*((e^3*q-d^3*p)*u) := by rw [hR]; ring
      _ = d^3*p := by rw [htrans]
      _ = -kappa*A^3*F := by dsimp [p,A,B,F]; ring
  have hL : L ≠ 0 := by
    intro hz
    have hA : A ≠ 0 := by
      intro ha
      have hb : B=0 := by dsimp [L] at hz; linear_combination hz-ha
      have ha0 : a=0 := (mul_eq_zero.mp (show a*d=0 from ha)).resolve_right hd
      have hb0 : b=0 := (mul_eq_zero.mp (show b*e=0 from hb)).resolve_right he
      exact hab.elim (fun hn => hn ha0) (fun hn => hn hb0)
    have hBA : B = -A := by dsimp [L] at hz; linear_combination hz
    have hF : F=6*A^2 := by dsimp [F]; rw [hBA]; ring
    have hnonzero : -kappa*A^3*(6*A^2) ≠ 0 :=
      mul_ne_zero (mul_ne_zero (neg_ne_zero.mpr hk) (pow_ne_zero 3 hA))
        (mul_ne_zero (by norm_num) (pow_ne_zero 2 hA))
    have hzero : 0 = -kappa*A^3*(6*A^2) := by simpa [hz,hF] using hcore
    exact hnonzero hzero.symm
  have hquot : Q3 ((A-B)/L) = A^3*F/L^5 := by
    dsimp [Q3]
    field_simp [hL]
    dsimp [L,F]
    ring
  have hcancel : L^5*(d^3*u) = -A^3*F := by
    apply mul_left_cancel₀ hk
    linear_combination hcore
  refine ⟨hL,?_⟩
  change d^3*u = -Q3 ((A-B)/L)
  rw [hquot,←neg_div]
  apply (eq_div_iff (pow_ne_zero 5 hL)).mpr
  linear_combination hcancel

namespace Graph2

def binaryQuadratic (A B C : ℤ) : MvPolynomial (Fin 4) ℤ :=
  MvPolynomial.C A * MvPolynomial.X 0 ^ 2 +
    MvPolynomial.C B * MvPolynomial.X 0 * MvPolynomial.X 1 +
    MvPolynomial.C C * MvPolynomial.X 1 ^ 2

def complexQuadratic (A B C : ℤ) (r s : ℂ) : ℂ :=
  (A : ℂ) * r ^ 2 + (B : ℂ) * r * s + (C : ℂ) * s ^ 2

def rationalQuadratic (A B C : ℤ) (r s : ℚ) : ℚ :=
  (A : ℚ) * r ^ 2 + (B : ℚ) * r * s + (C : ℚ) * s ^ 2

abbrev ix (a b c d : ℕ) : Fin 4 →₀ ℕ :=
  Finsupp.single 2 a + Finsupp.single 3 b +
    Finsupp.single 0 c + Finsupp.single 1 d

lemma ix_injective (a b c d a' b' c' d' : ℕ) :
    ix a b c d = ix a' b' c' d' ↔ a=a' ∧ b=b' ∧ c=c' ∧ d=d' := by
  constructor
  · intro h
    exact ⟨by simpa [ix] using congrArg (fun m : Fin 4 →₀ ℕ => m 2) h,
      by simpa [ix] using congrArg (fun m : Fin 4 →₀ ℕ => m 3) h,
      by simpa [ix] using congrArg (fun m : Fin 4 →₀ ℕ => m 0) h,
      by simpa [ix] using congrArg (fun m : Fin 4 →₀ ℕ => m 1) h⟩
  · rintro ⟨rfl,rfl,rfl,rfl⟩
    rfl

lemma support_six (G : MvPolynomial (Fin 4) ℤ)
    (h : ∀ m ∈ G.support, m 2 + m 3 = 1 ∧ m 0 + m 1 = 2) :
    G.support ⊆ {ix 1 0 2 0, ix 1 0 1 1, ix 1 0 0 2,
      ix 0 1 2 0, ix 0 1 1 1, ix 0 1 0 2} := by
  intro m hm
  obtain ⟨h1,h2⟩ := h m hm
  have hc :
      (m 2 = 1 ∧ m 3 = 0 ∧ m 0 = 2 ∧ m 1 = 0) ∨
      (m 2 = 1 ∧ m 3 = 0 ∧ m 0 = 1 ∧ m 1 = 1) ∨
      (m 2 = 1 ∧ m 3 = 0 ∧ m 0 = 0 ∧ m 1 = 2) ∨
      (m 2 = 0 ∧ m 3 = 1 ∧ m 0 = 2 ∧ m 1 = 0) ∨
      (m 2 = 0 ∧ m 3 = 1 ∧ m 0 = 1 ∧ m 1 = 1) ∨
      (m 2 = 0 ∧ m 3 = 1 ∧ m 0 = 0 ∧ m 1 = 2) := by omega
  rcases hc with hc | hc | hc | hc | hc | hc
  · have he : m = ix 1 0 2 0 := by
      ext i
      fin_cases i <;> simp [ix] <;> omega
    rw [he]
    simp
  · have he : m = ix 1 0 1 1 := by
      ext i
      fin_cases i <;> simp [ix] <;> omega
    rw [he]
    simp
  · have he : m = ix 1 0 0 2 := by
      ext i
      fin_cases i <;> simp [ix] <;> omega
    rw [he]
    simp
  · have he : m = ix 0 1 2 0 := by
      ext i
      fin_cases i <;> simp [ix] <;> omega
    rw [he]
    simp
  · have he : m = ix 0 1 1 1 := by
      ext i
      fin_cases i <;> simp [ix] <;> omega
    rw [he]
    simp
  · have he : m = ix 0 1 0 2 := by
      ext i
      fin_cases i <;> simp [ix] <;> omega
    rw [he]
    simp

lemma six_coefficient_identity (G : MvPolynomial (Fin 4) ℤ)
    (h : ∀ m ∈ G.support, m 2 + m 3 = 1 ∧ m 0 + m 1 = 2) :
    G = X 2 * binaryQuadratic
      (G.coeff (ix 1 0 2 0)) (G.coeff (ix 1 0 1 1)) (G.coeff (ix 1 0 0 2)) -
      X 3 * binaryQuadratic
      (-G.coeff (ix 0 1 2 0)) (-G.coeff (ix 0 1 1 1)) (-G.coeff (ix 0 1 0 2)) := by
  have hs := support_six G h
  have hsum : G = ∑ m ∈ ({ix 1 0 2 0, ix 1 0 1 1, ix 1 0 0 2,
      ix 0 1 2 0, ix 0 1 1 1, ix 0 1 0 2} : Finset (Fin 4 →₀ ℕ)),
      monomial m (G.coeff m) := by
    nth_rw 1 [G.as_sum]
    apply Finset.sum_subset hs
    intro m hm hn
    have hz : G.coeff m = 0 := by
      simpa only [MvPolynomial.mem_support_iff, not_ne_iff] using hn
    simp [hz]
  nth_rw 1 [hsum]
  simp only [Finset.sum_insert, Finset.sum_singleton, Finset.mem_insert,
    Finset.mem_singleton, ix_injective, and_false,  and_true, 
    Nat.reduceEqDiff, or_false,  not_false_eq_true]
  simp only [binaryQuadratic, mul_add, map_neg, mul_neg, neg_mul, neg_add_rev,
    sub_eq_add_neg,  neg_neg, MvPolynomial.X, show ∀ a : ℤ,
      (MvPolynomial.C a : MvPolynomial (Fin 4) ℤ) = monomial 0 a from fun _ => rfl,
    pow_two, MvPolynomial.monomial_mul, zero_add,  one_mul, mul_one]
  simp only [ix, Finsupp.single_zero, zero_add, add_zero,
    ← Finsupp.single_add, show (1:ℕ)+1=2 from rfl, add_assoc]
  abel

lemma eval_zero_nonunit (P : MvPolynomial (Fin 4) ℂ)
    (h : MvPolynomial.eval (fun _ => (0:ℂ)) P = 0) : ¬ IsUnit P := by
  intro hp
  have he := hp.map (MvPolynomial.eval (fun _ => (0:ℂ)))
  rw [h] at he
  exact not_isUnit_zero he

lemma graph_no_common
    (G : MvPolynomial (Fin 4) ℤ)
    (D₀ D₁ D₂ E₀ E₁ E₂ : ℤ)
    (hG : G = X 2 * binaryQuadratic E₀ E₁ E₂ -
      X 3 * binaryQuadratic D₀ D₁ D₂)
    (hi : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G)) :
    ∀ r s : ℂ, r ≠ 0 ∨ s ≠ 0 →
      complexQuadratic D₀ D₁ D₂ r s ≠ 0 ∨
      complexQuadratic E₀ E₁ E₂ r s ≠ 0 := by
  intro r s hrs
  by_contra hc
  push Not at hc
  obtain ⟨hd,he⟩ := hc
  have hmap : MvPolynomial.map (Int.castRingHom ℂ) G =
      X 2 * (C (E₀:ℂ)*X 0^2 + C (E₁:ℂ)*X 0*X 1 + C (E₂:ℂ)*X 1^2) -
      X 3 * (C (D₀:ℂ)*X 0^2 + C (D₁:ℂ)*X 0*X 1 + C (D₂:ℂ)*X 1^2) := by
    rw [hG]
    simp [binaryQuadratic]
  by_cases hr : r = 0
  · have hs : s ≠ 0 := hrs.resolve_left (by simp [hr])
    have hd2 : (D₂:ℂ) = 0 := by
      have hz : (D₂:ℂ) * s^2 = 0 := by simpa [complexQuadratic,hr] using hd
      exact (mul_eq_zero.mp hz).resolve_right (pow_ne_zero 2 hs)
    have he2 : (E₂:ℂ) = 0 := by
      have hz : (E₂:ℂ) * s^2 = 0 := by simpa [complexQuadratic,hr] using he
      exact (mul_eq_zero.mp hz).resolve_right (pow_ne_zero 2 hs)
    let L : MvPolynomial (Fin 4) ℂ := X 0
    let H : MvPolynomial (Fin 4) ℂ :=
      X 2 * (C (E₀:ℂ)*X 0 + C (E₁:ℂ)*X 1) -
      X 3 * (C (D₀:ℂ)*X 0 + C (D₁:ℂ)*X 1)
    have hf : MvPolynomial.map (Int.castRingHom ℂ) G = L*H := by
      rw [hmap, hd2, he2]
      simp only [map_zero, zero_mul, add_zero]
      dsimp [L,H]
      ring
    rcases hi.isUnit_or_isUnit hf with hu | hu
    · exact eval_zero_nonunit L (by simp [L]) hu
    · exact eval_zero_nonunit H (by simp [H]) hu
  · let t : ℂ := s/r
    have hdrel : (D₀:ℂ)+(D₁:ℂ)*t+(D₂:ℂ)*t^2 = 0 := by
      calc
        _ = complexQuadratic D₀ D₁ D₂ r s / r^2 := by
          dsimp [t,complexQuadratic]
          field_simp

        _ = 0 := by rw [hd]; simp
    have herel : (E₀:ℂ)+(E₁:ℂ)*t+(E₂:ℂ)*t^2 = 0 := by
      calc
        _ = complexQuadratic E₀ E₁ E₂ r s / r^2 := by
          dsimp [t,complexQuadratic]
          field_simp

        _ = 0 := by rw [he]; simp
    have hd0 : (D₀:ℂ) = -((D₁:ℂ)*t+(D₂:ℂ)*t^2) := by
      linear_combination hdrel
    have he0 : (E₀:ℂ) = -((E₁:ℂ)*t+(E₂:ℂ)*t^2) := by
      linear_combination herel
    have hdC := congrArg (C : ℂ → MvPolynomial (Fin 4) ℂ) hd0
    have heC := congrArg (C : ℂ → MvPolynomial (Fin 4) ℂ) he0
    simp only [map_neg, map_add, map_mul, map_pow] at hdC heC
    let L : MvPolynomial (Fin 4) ℂ := X 1 - C t*X 0
    let H : MvPolynomial (Fin 4) ℂ :=
      X 2 * (C (E₂:ℂ)*X 1 + (C (E₁:ℂ)+C (E₂:ℂ)*C t)*X 0) -
      X 3 * (C (D₂:ℂ)*X 1 + (C (D₁:ℂ)+C (D₂:ℂ)*C t)*X 0)
    have hf : MvPolynomial.map (Int.castRingHom ℂ) G = L*H := by
      rw [hmap, hdC, heC]
      dsimp [L,H]
      ring
    rcases hi.isUnit_or_isUnit hf with hu | hu
    · exact eval_zero_nonunit L (by simp [L]) hu
    · exact eval_zero_nonunit H (by simp [H]) hu

end Graph2

namespace Graph1

def binaryLinear (A B : ℤ) : MvPolynomial (Fin 4) ℤ :=
  C A*X 0+C B*X 1

abbrev ix := Graph2.ix

lemma support_four (G : MvPolynomial (Fin 4) ℤ)
    (h : ∀ m∈G.support,m 0+m 1=1 ∧ m 2+m 3=1) :
    G.support ⊆ {ix 1 0 1 0,ix 1 0 0 1,ix 0 1 1 0,ix 0 1 0 1} := by
  intro m hm
  obtain ⟨h1,h2⟩ := h m hm
  have hc :
      (m 2=1 ∧ m 3=0 ∧ m 0=1 ∧ m 1=0) ∨
      (m 2=1 ∧ m 3=0 ∧ m 0=0 ∧ m 1=1) ∨
      (m 2=0 ∧ m 3=1 ∧ m 0=1 ∧ m 1=0) ∨
      (m 2=0 ∧ m 3=1 ∧ m 0=0 ∧ m 1=1) := by omega
  rcases hc with hc|hc|hc|hc
  · have he : m=ix 1 0 1 0 := by
      ext i
      fin_cases i <;> simp [ix,Graph2.ix] <;> omega
    rw [he]; simp
  · have he : m=ix 1 0 0 1 := by
      ext i
      fin_cases i <;> simp [ix,Graph2.ix] <;> omega
    rw [he]; simp
  · have he : m=ix 0 1 1 0 := by
      ext i
      fin_cases i <;> simp [ix,Graph2.ix] <;> omega
    rw [he]; simp
  · have he : m=ix 0 1 0 1 := by
      ext i
      fin_cases i <;> simp [ix,Graph2.ix] <;> omega
    rw [he]; simp

lemma four_coefficient_identity (G : MvPolynomial (Fin 4) ℤ)
    (h : ∀ m∈G.support,m 0+m 1=1 ∧ m 2+m 3=1) :
    G=X 2*binaryLinear (G.coeff (ix 1 0 1 0)) (G.coeff (ix 1 0 0 1))-
      X 3*binaryLinear (-G.coeff (ix 0 1 1 0)) (-G.coeff (ix 0 1 0 1)) := by
  have hs := support_four G h
  have hsum : G=∑m∈({ix 1 0 1 0,ix 1 0 0 1,ix 0 1 1 0,ix 0 1 0 1} :
      Finset (Fin 4 →₀ ℕ)),monomial m (G.coeff m) := by
    nth_rw 1 [G.as_sum]
    apply Finset.sum_subset hs
    intro m hm hn
    have hz : G.coeff m=0 := by
      simpa only [MvPolynomial.mem_support_iff,not_ne_iff] using hn
    simp [hz]
  nth_rw 1 [hsum]
  simp only [Finset.sum_insert,Finset.sum_singleton,Finset.mem_insert,
    Finset.mem_singleton,Graph2.ix_injective,and_false,and_true,
    Nat.reduceEqDiff,or_false,not_false_eq_true]
  simp only [binaryLinear,mul_add,map_neg,mul_neg,neg_mul,neg_add_rev,
    sub_eq_add_neg,neg_neg,MvPolynomial.X,
    show ∀a:ℤ,(C a:MvPolynomial (Fin 4) ℤ)=monomial 0 a from fun _=>rfl,
    MvPolynomial.monomial_mul,zero_add,one_mul,mul_one]
  simp only [ix,Graph2.ix,Finsupp.single_zero,zero_add,add_zero,add_assoc]
  abel

lemma graph_no_common (G : MvPolynomial (Fin 4) ℤ) (P0 P1 Q0 Q1 : ℤ)
    (hG : G=X 2*binaryLinear Q0 Q1-X 3*binaryLinear P0 P1)
    (hi : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G)) :
    ∀ r s : ℂ,r≠0 ∨ s≠0 →
      (P0:ℂ)*r+(P1:ℂ)*s≠0 ∨ (Q0:ℂ)*r+(Q1:ℂ)*s≠0 := by
  intro r s hrs
  by_contra hc
  push Not at hc
  obtain ⟨hp,hq⟩ := hc
  have hmap : MvPolynomial.map (Int.castRingHom ℂ) G =
      X 2*(C (Q0:ℂ)*X 0+C (Q1:ℂ)*X 1)-
        X 3*(C (P0:ℂ)*X 0+C (P1:ℂ)*X 1) := by
    rw [hG]
    simp [binaryLinear]
  by_cases hr : r=0
  · have hs : s≠0 := hrs.resolve_left (by simp [hr])
    have hp1 : (P1:ℂ)=0 := by
      have ht : (P1:ℂ)*s=0 := by simpa [hr] using hp
      exact (mul_eq_zero.mp ht).resolve_right hs
    have hq1 : (Q1:ℂ)=0 := by
      have ht : (Q1:ℂ)*s=0 := by simpa [hr] using hq
      exact (mul_eq_zero.mp ht).resolve_right hs
    let L : MvPolynomial (Fin 4) ℂ := X 0
    let H : MvPolynomial (Fin 4) ℂ := X 2*C (Q0:ℂ)-X 3*C (P0:ℂ)
    have hf : MvPolynomial.map (Int.castRingHom ℂ) G=L*H := by
      rw [hmap,hp1,hq1]
      dsimp [L,H]
      simp only [map_zero,zero_mul,add_zero]
      ring
    rcases hi.isUnit_or_isUnit hf with hu|hu
    · exact Graph2.eval_zero_nonunit L (by simp [L]) hu
    · exact Graph2.eval_zero_nonunit H (by simp [H]) hu
  · let t : ℂ := s/r
    have hp0 : (P0:ℂ)=-(P1:ℂ)*t := by
      have ht : ((P0:ℂ)+(P1:ℂ)*t)*r=0 := by
        dsimp [t]
        field_simp
        linear_combination hp
      have hz := (mul_eq_zero.mp ht).resolve_right hr
      linear_combination hz
    have hq0 : (Q0:ℂ)=-(Q1:ℂ)*t := by
      have ht : ((Q0:ℂ)+(Q1:ℂ)*t)*r=0 := by
        dsimp [t]
        field_simp
        linear_combination hq
      have hz := (mul_eq_zero.mp ht).resolve_right hr
      linear_combination hz
    have hpC := congrArg (C : ℂ → MvPolynomial (Fin 4) ℂ) hp0
    have hqC := congrArg (C : ℂ → MvPolynomial (Fin 4) ℂ) hq0
    simp only [map_neg,map_mul] at hpC hqC
    let L : MvPolynomial (Fin 4) ℂ := X 1-C t*X 0
    let H : MvPolynomial (Fin 4) ℂ := X 2*C (Q1:ℂ)-X 3*C (P1:ℂ)
    have hf : MvPolynomial.map (Int.castRingHom ℂ) G=L*H := by
      rw [hmap,hpC,hqC]
      dsimp [L,H]
      ring
    rcases hi.isUnit_or_isUnit hf with hu|hu
    · exact Graph2.eval_zero_nonunit L (by simp [L]) hu
    · exact Graph2.eval_zero_nonunit H (by simp [H]) hu

end Graph1

private def linearBinary (a b : ℤ) : MvPolynomial (Fin 2) ℤ :=
  C a*X 0+C b*X 1

private lemma linear_homogeneous (a b : ℤ) :
    (linearBinary a b).IsHomogeneous 1 := by
  exact ((isHomogeneous_C (Fin 2) a).mul
    (isHomogeneous_X ℤ (0:Fin 2))).add
      ((isHomogeneous_C (Fin 2) b).mul (isHomogeneous_X ℤ (1:Fin 2)))

private lemma linear_int_eval (a b r s : ℤ) :
    eval ![r,s] (linearBinary a b)=a*r+b*s := by
  simp [linearBinary]

private lemma linear_complex_eval (a b : ℤ) (w : Fin 2 → ℂ) :
    eval w (MvPolynomial.map (Int.castRingHom ℂ) (linearBinary a b))=
      (a:ℂ)*w 0+(b:ℂ)*w 1 := by
  simp [linearBinary]

private lemma linear_coeff_bound (a b : ℤ) (H : ℝ) (hH : 1≤H)
    (ha : |(a:ℝ)|≤H) (hb : |(b:ℝ)|≤H) :
    ∀m : Fin 2 →₀ ℕ,|(((linearBinary a b).coeff m:ℤ):ℝ)|≤H := by
  let i0 : Fin 2 →₀ ℕ := Finsupp.single 0 1
  let i1 : Fin 2 →₀ ℕ := Finsupp.single 1 1
  have h01 : i0≠i1 := by
    intro hh
    have ht := congrArg (fun m : Fin 2 →₀ ℕ => m 0) hh
    norm_num [i0,i1] at ht
  have hmono : linearBinary a b=monomial i0 a+monomial i1 b := by
    simp only [linearBinary,MvPolynomial.X,
      show ∀z:ℤ,(C z:MvPolynomial (Fin 2) ℤ)=monomial 0 z from fun _=>rfl,
      MvPolynomial.monomial_mul,zero_add,mul_one]
    rfl
  intro m
  by_cases hm0 : m=i0
  · subst m
    simpa [hmono,coeff_monomial,h01,Ne.symm h01] using ha
  · by_cases hm1 : m=i1
    · subst m
      simpa [hmono,coeff_monomial,h01,Ne.symm h01] using hb
    · simp only [hmono,coeff_add,coeff_monomial,
        if_neg (Ne.symm hm0),if_neg (Ne.symm hm1),add_zero,Int.cast_zero,abs_zero]
      linarith

private lemma nonzero_pair {w : Fin 2 → ℂ} (hw : w≠0) : w 0≠0 ∨ w 1≠0 := by
  by_contra hn
  push Not at hn
  apply hw
  funext i
  fin_cases i
  · exact hn.1
  · exact hn.2

private def GraphData (G : MvPolynomial (Fin 4) ℤ) (alpha : ℕ) (H : ℝ) : Prop :=
  ∃ P Q : MvPolynomial (Fin 2) ℤ,
    P.IsHomogeneous alpha ∧ Q.IsHomogeneous alpha ∧
    (∀m : Fin 2 →₀ ℕ,|((P.coeff m:ℤ):ℝ)|≤H ∧ |((Q.coeff m:ℤ):ℝ)|≤H) ∧
    (∀w : Fin 2 → ℂ,w≠0 →
      eval w (MvPolynomial.map (Int.castRingHom ℂ) P)=0 →
      eval w (MvPolynomial.map (Int.castRingHom ℂ) Q)=0 → False) ∧
    (∀d e u v : ℤ,eval ![d,e,u,v] G=0 →
      eval ![d,e] Q*u=eval ![d,e] P*v)

private theorem graph_data_two (G : MvPolynomial (Fin 4) ℤ)
    (hbi : ∀m∈G.support,m 0+m 1=2 ∧ m 2+m 3=1)
    (hi : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G))
    (H : ℝ) (hH : 1≤H)
    (hheight : ∀m : Fin 4 →₀ ℕ,|((G.coeff m:ℤ):ℝ)|≤H) : GraphData G 2 H := by
  let P0 := -G.coeff (Graph2.ix 0 1 2 0)
  let P1 := -G.coeff (Graph2.ix 0 1 1 1)
  let P2 := -G.coeff (Graph2.ix 0 1 0 2)
  let Q0 := G.coeff (Graph2.ix 1 0 2 0)
  let Q1 := G.coeff (Graph2.ix 1 0 1 1)
  let Q2 := G.coeff (Graph2.ix 1 0 0 2)
  have hG : G=X 2*Graph2.binaryQuadratic Q0 Q1 Q2-
      X 3*Graph2.binaryQuadratic P0 P1 P2 :=
    Graph2.six_coefficient_identity G (fun m hm=>(hbi m hm).symm)
  have hno := Graph2.graph_no_common G P0 P1 P2 Q0 Q1 Q2 hG hi
  refine ⟨quadraticForm P0 P1 P2,quadraticForm Q0 Q1 Q2,
    quadratic_homogeneous _ _ _,quadratic_homogeneous _ _ _,?_,?_,?_⟩
  · intro m
    constructor
    · exact quadratic_coeff_bound P0 P1 P2 H hH
        (by simpa [P0] using hheight (Graph2.ix 0 1 2 0))
        (by simpa [P1] using hheight (Graph2.ix 0 1 1 1))
        (by simpa [P2] using hheight (Graph2.ix 0 1 0 2)) m
    · exact quadratic_coeff_bound Q0 Q1 Q2 H hH (hheight _) (hheight _) (hheight _) m
  · intro w hw hp hq
    rw [quadratic_complex_eval] at hp hq
    exact (hno (w 0) (w 1) (nonzero_pair hw)).elim (fun hn=>hn hp) (fun hn=>hn hq)
  · intro d e u v hz
    rw [hG] at hz
    have hz' : u*(Q0*d^2+Q1*d*e+Q2*e^2)-
        v*(P0*d^2+P1*d*e+P2*e^2)=0 := by
      simpa [Graph2.binaryQuadratic] using hz
    rw [quadratic_int_eval,quadratic_int_eval]
    linear_combination hz'

private theorem graph_data_one (G : MvPolynomial (Fin 4) ℤ)
    (hbi : ∀m∈G.support,m 0+m 1=1 ∧ m 2+m 3=1)
    (hi : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G))
    (H : ℝ) (hH : 1≤H)
    (hheight : ∀m : Fin 4 →₀ ℕ,|((G.coeff m:ℤ):ℝ)|≤H) : GraphData G 1 H := by
  let P0 := -G.coeff (Graph1.ix 0 1 1 0)
  let P1 := -G.coeff (Graph1.ix 0 1 0 1)
  let Q0 := G.coeff (Graph1.ix 1 0 1 0)
  let Q1 := G.coeff (Graph1.ix 1 0 0 1)
  have hG : G=X 2*Graph1.binaryLinear Q0 Q1-X 3*Graph1.binaryLinear P0 P1 :=
    Graph1.four_coefficient_identity G hbi
  have hno := Graph1.graph_no_common G P0 P1 Q0 Q1 hG hi
  refine ⟨linearBinary P0 P1,linearBinary Q0 Q1,
    linear_homogeneous _ _,linear_homogeneous _ _,?_,?_,?_⟩
  · intro m
    constructor
    · exact linear_coeff_bound P0 P1 H hH
        (by simpa [P0] using hheight (Graph1.ix 0 1 1 0))
        (by simpa [P1] using hheight (Graph1.ix 0 1 0 1)) m
    · exact linear_coeff_bound Q0 Q1 H hH (hheight _) (hheight _) m
  · intro w hw hp hq
    rw [linear_complex_eval] at hp hq
    exact (hno (w 0) (w 1) (nonzero_pair hw)).elim (fun hn=>hn hp) (fun hn=>hn hq)
  · intro d e u v hz
    rw [hG] at hz
    have hz' : u*(Q0*d+Q1*e)-v*(P0*d+P1*e)=0 := by
      simpa [Graph1.binaryLinear] using hz
    rw [linear_int_eval,linear_int_eval]
    linear_combination hz'

private theorem canonical_graph_data (G : MvPolynomial (Fin 4) ℤ) (alpha : ℕ)
    (halpha : alpha=1 ∨ alpha=2)
    (hbi : ∀m∈G.support,m 0+m 1=alpha ∧ m 2+m 3=1)
    (hi : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G))
    (H : ℝ) (hH : 1≤H)
    (hheight : ∀m : Fin 4 →₀ ℕ,|((G.coeff m:ℤ):ℝ)|≤H) :
    GraphData G alpha H := by
  rcases halpha with rfl|rfl
  · exact graph_data_one G hbi hi H hH hheight
  · exact graph_data_two G hbi hi H hH hheight

private def RationalPurePower (n : ℕ) (R : MvPolynomial (Fin 2) ℤ) : Prop :=
  ∃ kappa a b : ℚ,kappa≠0 ∧ (a≠0 ∨ b≠0) ∧ ∀r s:ℚ,
    eval ![r,s] (MvPolynomial.map (Int.castRingHom ℚ) R)=kappa*(a*r+b*s)^n

private def IntegralTwoLines (n : ℕ) (R : MvPolynomial (Fin 2) ℤ) : Prop :=
  ∃c a b a' b':ℤ,∃j:ℕ,c≠0 ∧ a*b'-a'*b≠0 ∧ 1≤j ∧ j<n ∧
    R=C c*(C a*X 0+C b*X 1)^j*(C a'*X 0+C b'*X 1)^(n-j)

private theorem dehom_splits_of_not_three_odd (n : ℕ) (hnodd : Odd n) (R : MvPolynomial (Fin 2) ℤ)
    (hR : R.IsHomogeneous n) (hR0 : R ≠ 0)
    (hthree : ¬ HasThreeProjectiveZeros R) :
    ((C01.PcCurves.dehom R).map (Int.castRingHom ℚ)).Splits := by
  classical
  let f0 : Polynomial ℤ := C01.PcCurves.dehom R
  let f : Polynomial ℚ := f0.map (Int.castRingHom ℚ)
  let RC : MvPolynomial (Fin 2) ℂ := R.map (Int.castRingHom ℂ)
  have hRC : RC.IsHomogeneous n := hR.map (Int.castRingHom ℂ)
  have hf0 : f0 ≠ 0 := fun h => hR0 (C01.PcCurves.eq_zero_of_dehom hR h)
  have hinj : Function.Injective (Int.castRingHom ℚ) := RingHom.injective_int _
  have hf : f ≠ 0 := (Polynomial.map_ne_zero_iff hinj).mpr hf0
  have hdeg : f.natDegree = f0.natDegree :=
    Polynomial.natDegree_map_eq_of_injective hinj f0
  have hcomp : (algebraMap ℚ ℂ).comp (Int.castRingHom ℚ) =
      Int.castRingHom ℂ := by
    ext n ; simp
  have hvec : ∀ z : ℂ, Polynomial.eval₂ (algebraMap ℚ ℂ) z f = 0 →
      MvPolynomial.eval (pointVector (some z)) RC = 0 := by
    intro z hz
    have hz' : Polynomial.eval₂ (Int.castRingHom ℂ) z f0 = 0 := by
      simpa only [f, Polynomial.eval₂_map, hcomp] using hz
    change MvPolynomial.eval ![z, 1] RC = 0
    rw [← C01.PcCurves.dehom_eval hRC, C01.PcRes.dehom_map hR,
      Polynomial.eval_map]
    exact hz'
  have hrep : ∀ z : ℂ, Polynomial.eval₂ (algebraMap ℚ ℂ) z f = 0 →
      MvPolynomial.eval (projectivePoint (some z)).rep RC = 0 := by
    intro z hz
    exact eval_projectivePoint_rep_zero RC n hRC (some z) (hvec z hz)
  have htwo : AtMostTwoRoots f := by
    intro z₁ z₂ z₃ hz₁ hz₂ hz₃
    by_contra hn
    have h12 : z₁ ≠ z₂ := by intro h; exact hn (Or.inl h)
    have h13 : z₁ ≠ z₃ := by intro h; exact hn (Or.inr (Or.inl h))
    have h23 : z₂ ≠ z₃ := by intro h; exact hn (Or.inr (Or.inr h))
    apply hthree
    refine ⟨projectivePoint (some z₁), projectivePoint (some z₂),
      projectivePoint (some z₃), ?_, ?_, ?_, hrep z₁ hz₁, hrep z₂ hz₂, hrep z₃ hz₃⟩
    · intro h
      exact h12 (Option.some.inj (projectivePoint_injective h))
    · intro h
      exact h13 (Option.some.inj (projectivePoint_injective h))
    · intro h
      exact h23 (Option.some.inj (projectivePoint_injective h))
  by_cases h7 : f0.natDegree = n
  · have hodd : Odd f.natDegree := by
      rw [hdeg, h7]
      exact hnodd
    exact odd_two_root_splits f hf hodd htwo
  · have hle : f0.natDegree ≤ n := C01.PcCurves.dehom_natDegree_le hR
    have hlt : f0.natDegree < n := by omega
    have hc7 : f0.coeff n = R.coeff (C01.PcCurves.ex n 0) := by
      simpa only [f0, Nat.sub_self, if_pos (le_refl n)] using
        (C01.PcCurves.dehom_coeff hR n)
    have hc0 : R.coeff (C01.PcCurves.ex n 0) = 0 := by
      rw [← hc7]
      exact Polynomial.coeff_eq_zero_of_natDegree_lt hlt
    have hinf : MvPolynomial.eval (pointVector none) RC = 0 := by
      change MvPolynomial.eval ![1, 0] RC = 0
      rw [C01.PcCurves.eval_one_zero hRC, MvPolynomial.coeff_map]
      simp only [hc0, map_zero]
    have hinfrep : MvPolynomial.eval (projectivePoint none).rep RC = 0 :=
      eval_projectivePoint_rep_zero RC n hRC none hinf
    have hone : ∀ z w : ℂ,
        Polynomial.eval₂ (algebraMap ℚ ℂ) z f = 0 →
        Polynomial.eval₂ (algebraMap ℚ ℂ) w f = 0 → z = w := by
      intro z w hz hw
      by_contra hzw
      apply hthree
      refine ⟨projectivePoint none, projectivePoint (some z),
        projectivePoint (some w), ?_, ?_, ?_, hinfrep, hrep z hz, hrep w hw⟩
      · intro h
        have h' := projectivePoint_injective h
        simp at h'
      · intro h
        have h' := projectivePoint_injective h
        simp at h'
      · intro h
        exact hzw (Option.some.inj (projectivePoint_injective h))
    exact one_root_splits f hf hone

private theorem binary_integer_linear_factorization
    (n : ℕ) (R : MvPolynomial (Fin 2) ℤ) (hR : R.IsHomogeneous n) (hR0 : R ≠ 0)
    (hsplit : ((C01.PcCurves.dehom R).map (Int.castRingHom ℚ)).Splits) :
    ∃ c : ℤ, c ≠ 0 ∧ ∃ s : Multiset (Option ℚ),
      s.card = n ∧ R = MvPolynomial.C c * (s.map labelLine).prod := by
  classical
  let f : Polynomial ℤ := C01.PcCurves.dehom R
  have hf : f ≠ 0 := fun h => hR0 (C01.PcCurves.eq_zero_of_dehom hR h)
  obtain ⟨c, hc, roots, hcard, hfac, hroots⟩ :=
    integer_linear_factorization f hf hsplit
  let s : Multiset (Option ℚ) :=
    roots.map some + Multiset.replicate (n - f.natDegree) none
  have hle : f.natDegree ≤ n := C01.PcCurves.dehom_natDegree_le hR
  have hs : s.card = n := by
    simp only [s, Multiset.card_add, Multiset.card_map, Multiset.card_replicate,
      hcard]
    omega
  have hdehomprod : (s.map labelPoly).prod = (roots.map rationalLinear).prod := by
    simp [s, Multiset.map_add, Multiset.prod_add, Multiset.map_map,
      Function.comp_def, labelPoly]
  let B : MvPolynomial (Fin 2) ℤ := MvPolynomial.C c * (s.map labelLine).prod
  have hB : B.IsHomogeneous n := by
    simpa only [B, hs, zero_add] using
      (MvPolynomial.isHomogeneous_C (Fin 2) c).mul (label_product_homogeneous s)
  have hdehom : C01.PcCurves.dehom B = f := by
    rw [show C01.PcCurves.dehom B =
      C01.PcCurves.dehom (MvPolynomial.C c) *
        C01.PcCurves.dehom ((s.map labelLine).prod) from
      C01.PcCurves.dehom_mul _ _]
    rw [label_product_dehom, hdehomprod]
    have hconst : C01.PcCurves.dehom (MvPolynomial.C c : MvPolynomial (Fin 2) ℤ) =
        Polynomial.C c := by simp [C01.PcCurves.dehom]
    rw [hconst]
    exact hfac.symm
  have hsub : C01.PcCurves.dehom (R - B) = 0 := by
    rw [C01.PcCurves.dehom_sub, hdehom]
    exact sub_self f
  have heq : R = B := sub_eq_zero.mp
    (C01.PcCurves.eq_zero_of_dehom (hR.sub hB) hsub)
  exact ⟨c, hc, s, hs, heq⟩

private theorem factored_label_projective_zero
    (n : ℕ) (R : MvPolynomial (Fin 2) ℤ) (hR : R.IsHomogeneous n)
    (c : ℤ) (s : Multiset (Option ℚ))
    (hfac : R = MvPolynomial.C c * (s.map labelLine).prod)
    (z : Option ℚ) (hz : z ∈ s) :
    MvPolynomial.eval (projectivePoint (labelToComplex z)).rep
      (R.map (Int.castRingHom ℂ)) = 0 := by
  apply eval_projectivePoint_rep_zero _ n (hR.map (Int.castRingHom ℂ))
  rw [hfac, map_mul, MvPolynomial.eval_mul,
    label_product_root s z hz, mul_zero]

private theorem twoSupportProduct {M : Type*} [CommMonoid M] (n : ℕ) (s : Multiset (Option ℚ)) (a b : Option ℚ) (hcard : s.card = n)
    (ha : a ∈ s) (hb : b ∈ s) (hne : a ≠ b)
    (hcover : ∀ x ∈ s, x = a ∨ x = b) :
    ∃ j : ℕ, 1 ≤ j ∧ j < n ∧
      ∀ f : Option ℚ → M, (s.map f).prod = f a ^ j * f b ^ (n - j) := by
  obtain ⟨j, hj, haj, hbj, hprod⟩ :=
    binarySupportProduct (M := M) a b hne s hcover
  refine ⟨j, ?_, ?_, ?_⟩
  · exact haj ha
  · have hlt := hbj hb
    omega
  · intro f
    simpa only [hcard] using hprod f

private theorem split_binary_classification
    (n : ℕ) (hn : 1 ≤ n) (R : MvPolynomial (Fin 2) ℤ)
    (hR : R.IsHomogeneous n) (hR0 : R ≠ 0)
    (hthree : ¬ HasThreeProjectiveZeros R)
    (hsplit : ((C01.PcCurves.dehom R).map (Int.castRingHom ℚ)).Splits) :
    RationalPurePower n R ∨ IntegralTwoLines n R := by
  classical
  obtain ⟨c, hc, labels, hcard, hfac⟩ :=
    binary_integer_linear_factorization n R hR hR0 hsplit
  obtain ⟨a, ha⟩ := FormalAB.S84900580.A5PrivateOddRoot.multiset_has_member labels (by omega)
  by_cases hone : ∀ z ∈ labels, z = a
  · have hp : R = MvPolynomial.C c * FormalAB.S84900580.A5PrivateOddRoot.labelLine a ^ n := by
      rw [hfac, FormalAB.S84900580.A5PrivateOddRoot.label_product_eq_pow labels a hone, hcard]
    left
    refine ⟨(c : ℚ), (FormalAB.S84900580.A5PrivateOddRoot.lineCoeffA a : ℚ),
      (FormalAB.S84900580.A5PrivateOddRoot.lineCoeffB a : ℚ), ?_, ?_, ?_⟩
    · exact_mod_cast hc
    · rcases FormalAB.S84900580.A5PrivateOddRoot.label_coeff_nonzero a with ha' | hb'
      · left; exact_mod_cast ha'
      · right; exact_mod_cast hb'
    · intro r s
      rw [hp]
      simp [FormalAB.S84900580.A5PrivateOddRoot.labelLine]
  · push Not at hone
    obtain ⟨b, hb, hba⟩ := hone
    have hab : a ≠ b := Ne.symm hba
    have hproj : Function.Injective (fun z : Option ℚ =>
        FormalAB.S84900580.A5PrivateOddRoot.projectivePoint (FormalAB.S84900580.A5PrivateOddRoot.labelToComplex z)) :=
      FormalAB.S84900580.A5PrivateOddRoot.projectivePoint_injective.comp
        FormalAB.S84900580.A5PrivateOddRoot.labelToComplex_injective
    have hzero : ∀ z ∈ labels,
        MvPolynomial.eval
          (FormalAB.S84900580.A5PrivateOddRoot.projectivePoint
            (FormalAB.S84900580.A5PrivateOddRoot.labelToComplex z)).rep
          (R.map (Int.castRingHom ℂ)) = 0 :=
      factored_label_projective_zero n R hR c labels hfac
    have hcover : ∀ z ∈ labels, z = a ∨ z = b := by
      intro z hz
      by_cases hza : z = a
      · exact Or.inl hza
      by_cases hzb : z = b
      · exact Or.inr hzb
      exfalso
      apply hthree
      refine ⟨FormalAB.S84900580.A5PrivateOddRoot.projectivePoint (FormalAB.S84900580.A5PrivateOddRoot.labelToComplex a),
        FormalAB.S84900580.A5PrivateOddRoot.projectivePoint (FormalAB.S84900580.A5PrivateOddRoot.labelToComplex b),
        FormalAB.S84900580.A5PrivateOddRoot.projectivePoint (FormalAB.S84900580.A5PrivateOddRoot.labelToComplex z),
        ?_, ?_, ?_, hzero a ha, hzero b hb, hzero z hz⟩
      · exact fun he => hab (hproj he)
      · exact fun he => hza (hproj he).symm
      · exact fun he => hzb (hproj he).symm
    obtain ⟨j, hj, hj6, hprod⟩ :=
      twoSupportProduct (M := MvPolynomial (Fin 2) ℤ)
        n labels a b hcard ha hb hab hcover
    right
    refine ⟨c, FormalAB.S84900580.A5PrivateOddRoot.lineCoeffA a, FormalAB.S84900580.A5PrivateOddRoot.lineCoeffB a,
      FormalAB.S84900580.A5PrivateOddRoot.lineCoeffA b, FormalAB.S84900580.A5PrivateOddRoot.lineCoeffB b,
      j, hc, FormalAB.S84900580.A5PrivateOddRoot.label_coeff_independent a b hab,
      hj, hj6, ?_⟩
    rw [hfac, hprod FormalAB.S84900580.A5PrivateOddRoot.labelLine]
    simp only [FormalAB.S84900580.A5PrivateOddRoot.labelLine, mul_assoc]

private theorem odd_binary_classification (n : ℕ) (hn : 1≤n) (hnodd : Odd n)
    (R : MvPolynomial (Fin 2) ℤ) (hR : R.IsHomogeneous n) (hR0 : R≠0) :
    ThreeProjectiveZeros R ∨ RationalPurePower n R ∨ IntegralTwoLines n R := by
  classical
  by_cases ht : HasThreeProjectiveZeros R
  · exact Or.inl ht
  · exact Or.inr (split_binary_classification n hn R hR hR0 ht
      (dehom_splits_of_not_three_odd n hnodd R hR hR0 ht))
private lemma two_linear_divisor_cover (n : ℕ) (R : MvPolynomial (Fin 2) ℤ)
    (hR : IntegralTwoLines n R) (M : ℤ) (hM : M ≠ 0) :
    ∃ T : Finset (ℤ×ℤ),
      (∀ rs : ℤ×ℤ, Int.gcd rs.1 rs.2=1 →
        eval ![rs.1,rs.2] R ∣ M → rs ∈ T) ∧
      T.card ≤ 4*M.natAbs.divisors.card^2 := by
  classical
  obtain ⟨c,a,b,a',b',j,hc,hdet,hj,hjn,hfac⟩ := hR
  let φ : ℤ×ℤ → ℤ×ℤ := fun rs => (a*rs.1+b*rs.2,a'*rs.1+b'*rs.2)
  let S : Set (ℤ×ℤ) :=
    {rs | Int.gcd rs.1 rs.2=1 ∧ eval ![rs.1,rs.2] R ∣ M}
  let U := (signedDivisors M) ×ˢ (signedDivisors M)
  have hφ := linear_pair_injective a b a' b' hdet
  have hmap : ∀ rs ∈ S, φ rs ∈ (↑U : Set (ℤ×ℤ)) := by
    intro rs hrs
    have heval : eval ![rs.1,rs.2] R =
        c*(a*rs.1+b*rs.2)^j*(a'*rs.1+b'*rs.2)^(n-j) := by
      rw [hfac]
      simp []
    have h1 : a*rs.1+b*rs.2 ∣ eval ![rs.1,rs.2] R := by
      rw [heval]
      exact dvd_mul_of_dvd_left
        (dvd_mul_of_dvd_right (dvd_pow_self _ (by omega : j ≠ 0)) c) _
    have h2 : a'*rs.1+b'*rs.2 ∣ eval ![rs.1,rs.2] R := by
      rw [heval]
      exact dvd_mul_of_dvd_right
        (dvd_pow_self _ (by omega : n-j ≠ 0)) _
    exact Finset.mem_product.mpr
      ⟨mem_signedDivisors M _ hM (h1.trans hrs.2),
       mem_signedDivisors M _ hM (h2.trans hrs.2)⟩
  have himg : (φ '' S).Finite :=
    (Finset.finite_toSet U).subset (by rintro _ ⟨rs,hrs,rfl⟩; exact hmap rs hrs)
  have hfin : S.Finite := Set.Finite.of_finite_image himg hφ.injOn
  refine ⟨hfin.toFinset,?_,?_⟩
  · intro rs hp hdvd
    exact hfin.mem_toFinset.mpr ⟨hp,hdvd⟩
  · have hs : S.ncard ≤ U.card := by
      calc
        S.ncard ≤ (↑U : Set (ℤ×ℤ)).ncard :=
          Set.ncard_le_ncard_of_injOn φ hmap hφ.injOn (Finset.finite_toSet U)
        _ = U.card := Set.ncard_coe_finset U
    rw [← Set.ncard_eq_toFinset_card S hfin]
    calc
      S.ncard ≤ U.card := hs
      _ = (signedDivisors M).card*(signedDivisors M).card := Finset.card_product _ _
      _ ≤ (2*M.natAbs.divisors.card)*(2*M.natAbs.divisors.card) :=
        Nat.mul_le_mul (signedDivisors_card M) (signedDivisors_card M)
      _ = 4*M.natAbs.divisors.card^2 := by ring

private theorem nonlinear_factor_two_roots (f p : Polynomial ℚ)
    (hf : f ≠ 0) (htwo : AtMostTwoRoots f)
    (hp : Irreducible p) (hpf : p ∣ f) (hne : p.natDegree ≠ 1) :
    p.natDegree = 2 ∧ ∀ z : ℂ,
      Polynomial.eval₂ (algebraMap ℚ ℂ) z f = 0 →
        Polynomial.eval₂ (algebraMap ℚ ℂ) z p = 0 := by
  classical
  have hpos : 0 < p.natDegree :=
    Polynomial.natDegree_pos_iff_degree_pos.mpr
      (Polynomial.degree_pos_of_irreducible hp)
  have hge : 2 ≤ p.natDegree := by omega
  let pc : Polynomial ℂ := p.map (algebraMap ℚ ℂ)
  have hpc : pc ≠ 0 := by
    exact (Polynomial.map_ne_zero_iff (RingHom.injective _)).mpr hp.ne_zero
  have hsep : pc.Separable := hp.separable.map
  let S : Finset ℂ := pc.roots.toFinset
  have hcard : S.card = p.natDegree := by
    calc
      S.card = pc.roots.card :=
        Multiset.toFinset_card_of_nodup (Polynomial.nodup_roots hsep)
      _ = pc.natDegree := (IsAlgClosed.splits pc).natDegree_eq_card_roots.symm
      _ = p.natDegree := Polynomial.natDegree_map _
  obtain ⟨z₁, hz₁, z₂, hz₂, h12⟩ := Finset.one_lt_card.mp
    (show 1 < S.card from by omega)
  have hroot : ∀ z ∈ S,
      Polynomial.eval₂ (algebraMap ℚ ℂ) z p = 0 := by
    intro z hz
    have hz' : z ∈ pc.roots := by simpa only [S, Multiset.mem_toFinset] using hz
    have hr := (Polynomial.mem_roots hpc).mp hz'
    simpa only [Polynomial.IsRoot.def, pc, Polynomial.eval_map] using hr
  have hpfroot : ∀ z : ℂ,
      Polynomial.eval₂ (algebraMap ℚ ℂ) z p = 0 →
      Polynomial.eval₂ (algebraMap ℚ ℂ) z f = 0 := by
    intro z hz
    obtain ⟨g, rfl⟩ := hpf
    rw [Polynomial.eval₂_mul, hz, zero_mul]
  have h₁ := hroot z₁ hz₁
  have h₂ := hroot z₂ hz₂
  have hf₁ := hpfroot z₁ h₁
  have hf₂ := hpfroot z₂ h₂
  have hsub : S ⊆ {z₁, z₂} := by
    intro z hz
    rcases htwo z₁ z₂ z hf₁ hf₂ (hpfroot z (hroot z hz)) with h | h | h
    · exact (h12 h).elim
    · simp [← h]
    · simp [← h]
  have hle : S.card ≤ 2 := by
    calc
      S.card ≤ ({z₁, z₂} : Finset ℂ).card := Finset.card_le_card hsub
      _ = 2 := by simp [h12]
  have hdeg : p.natDegree = 2 := by omega
  have hsupport : ∀ z : ℂ,
      Polynomial.eval₂ (algebraMap ℚ ℂ) z f = 0 →
      Polynomial.eval₂ (algebraMap ℚ ℂ) z p = 0 := by
    intro z hz
    rcases htwo z₁ z₂ z hf₁ hf₂ hz with h | h | h
    · exact (h12 h).elim
    · simpa only [← h] using h₁
    · simpa only [← h] using h₂
  exact ⟨hdeg,hsupport⟩
private theorem primitive_rational_polynomial_exists (g : Polynomial ℚ) (hg : g≠0) :
    ∃q : Polynomial ℤ,q.IsPrimitive ∧ q.natDegree=g.natDegree ∧
      ∃k:ℚ,k≠0 ∧ q.map (Int.castRingHom ℚ)=Polynomial.C k*g := by
  obtain ⟨b, hbM, hb⟩ := IsLocalization.integerNormalization_spec
    (nonZeroDivisors ℤ) g
  let f := IsLocalization.integerNormalization (nonZeroDivisors ℤ) g
  have hbne : b ≠ 0 := nonZeroDivisors.ne_zero hbM
  have hb0 : (b : ℚ) ≠ 0 := by exact_mod_cast hbne
  have hb' : f.map (Int.castRingHom ℚ) = Polynomial.C (b : ℚ) * g := by
    rw [← algebraMap_int_eq, hb, ← Int.cast_smul_eq_zsmul ℚ, Polynomial.smul_eq_C_mul]
  have hCb : (Polynomial.C (b : ℚ)) ≠ 0 := by simpa using hb0
  have hf : f ≠ 0 := by
    intro h
    rw [h, Polynomial.map_zero] at hb'
    exact (mul_ne_zero hCb hg) hb'.symm
  have hp : f.primPart.IsPrimitive := Polynomial.isPrimitive_primPart f
  have hc : f.content ≠ 0 := by rwa [Ne, Polynomial.content_eq_zero_iff]
  have hcQ : (f.content : ℚ) ≠ 0 := by exact_mod_cast hc
  have hCc : (Polynomial.C (f.content : ℚ) : Polynomial ℚ) ≠ 0 := by
    simpa using hcQ
  have he : Polynomial.C (f.content : ℚ) *
      f.primPart.map (Int.castRingHom ℚ) = Polynomial.C (b : ℚ) * g := by
    rw [← hb']
    conv_rhs => rw [Polynomial.eq_C_content_mul_primPart f]
    rw [Polynomial.map_mul, Polynomial.map_C]
    simp
  have hscalar : (f.content : ℚ) * ((b : ℚ) / (f.content : ℚ)) = (b : ℚ) := by
    field_simp
  have hmap : f.primPart.map (Int.castRingHom ℚ) =
      Polynomial.C ((b : ℚ) / (f.content : ℚ)) * g := by
    apply mul_left_cancel₀ hCc
    rw [he, ← mul_assoc, ← map_mul, hscalar]
  have hk : ((b : ℚ) / (f.content : ℚ)) ≠ 0 := div_ne_zero hb0 hcQ
  have hCk : (Polynomial.C ((b : ℚ) / (f.content : ℚ)) : Polynomial ℚ) ≠ 0 := by
    simpa using hk
  have hd : f.primPart.natDegree = g.natDegree := by
    calc
      f.primPart.natDegree =
          (f.primPart.map (Int.castRingHom ℚ)).natDegree :=
        (Polynomial.natDegree_map_eq_of_injective (RingHom.injective_int _) _).symm
      _ = g.natDegree := by
        rw [hmap, Polynomial.natDegree_mul hCk hg, Polynomial.natDegree_C]
        simp only [zero_add]
  exact ⟨f.primPart, hp, hd, (b : ℚ) / (f.content : ℚ), hk, hmap⟩

private theorem quartic_nonsplit_square (fZ : Polynomial ℤ) (hfZ : fZ≠0)
    (hdegZ : fZ.natDegree=4)
    (htwo : AtMostTwoRoots (fZ.map (Int.castRingHom ℚ)))
    (hnsplit : ¬(fZ.map (Int.castRingHom ℚ)).Splits) :
    ∃q : Polynomial ℤ,q.IsPrimitive ∧ q.natDegree=2 ∧
      ∃c:ℤ,c≠0 ∧ fZ=Polynomial.C c*q^2 := by
  classical
  let f := fZ.map (Int.castRingHom ℚ)
  have hf : f≠0 := (Polynomial.map_ne_zero_iff (RingHom.injective_int (Int.castRingHom ℚ))).mpr hfZ
  have hdeg : f.natDegree=4 := by
    rw [Polynomial.natDegree_map_eq_of_injective (RingHom.injective_int (Int.castRingHom ℚ))]
    exact hdegZ
  by_cases hlinear : ∀p:Polynomial ℚ,Irreducible p → p∣f → p.natDegree=1
  · exact (hnsplit (splits_of_linear_factors f hf hlinear)).elim
  push Not at hlinear
  obtain ⟨p,hp,hpf,hpd⟩ := hlinear
  obtain ⟨hp2,hsupport⟩ := nonlinear_factor_two_roots f p hf htwo hp hpf hpd
  obtain ⟨g,hfg⟩ := hpf
  have hg : g≠0 := by intro hz; rw [hz,mul_zero] at hfg; exact hf hfg
  have hg2 : g.natDegree=2 := by
    have hsum : f.natDegree=p.natDegree+g.natDegree := by
      rw [hfg,Polynomial.natDegree_mul hp.ne_zero hg]
    omega
  have hgpos : g.degree≠0 :=
    ne_of_gt (Polynomial.natDegree_pos_iff_degree_pos.mp (by omega : 0<g.natDegree))
  obtain ⟨z,hgz⟩ := IsAlgClosed.exists_eval₂_eq_zero (algebraMap ℚ ℂ) g hgpos
  have hfz : Polynomial.eval₂ (algebraMap ℚ ℂ) z f=0 := by
    rw [hfg,Polynomial.eval₂_mul,hgz,mul_zero]
  obtain ⟨r,hgr⟩ := common_root_dvd p g hp z (hsupport z hfz) hgz
  have hr : r≠0 := by intro hz; rw [hz,mul_zero] at hgr; exact hg hgr
  have hr0 : r.natDegree=0 := by
    have hsum : g.natDegree=p.natDegree+r.natDegree := by
      rw [hgr,Polynomial.natDegree_mul hp.ne_zero hr]
    omega
  let cQ : ℚ := r.coeff 0
  have hrC : r=Polynomial.C cQ := Polynomial.eq_C_of_natDegree_eq_zero hr0
  have hfac : f=Polynomial.C cQ*p^2 := by rw [hfg,hgr,hrC]; ring
  obtain ⟨q,hqprim,hqdegree,k,hk,hqmap⟩ := primitive_rational_polynomial_exists p hp.ne_zero
  have hq2 : q.natDegree=2 := hqdegree.trans hp2
  have hqpow : (q^2).IsPrimitive := by
    simpa only [pow_two] using Polynomial.IsPrimitive.mul hqprim hqprim
  have hdiv : q^2∣fZ := by
    rw [Polynomial.IsPrimitive.Int.dvd_iff_map_cast_dvd_map_cast (q^2) fZ hqpow]
    refine ⟨Polynomial.C (cQ/k^2),?_⟩
    rw [Polynomial.map_pow,hqmap]
    have hsc : k^2*(cQ/k^2)=cQ := by field_simp
    have hC : (Polynomial.C k:Polynomial ℚ)^2*Polynomial.C (cQ/k^2)=Polynomial.C cQ := by
      rw [←map_pow,←map_mul,hsc]
    change f=(Polynomial.C k*p)^2*Polynomial.C (cQ/k^2)
    rw [hfac]
    calc
      Polynomial.C cQ*p^2 =
          ((Polynomial.C k)^2*Polynomial.C (cQ/k^2))*p^2 := by rw [hC]
      _ = _ := by ring
  obtain ⟨s,hfs⟩ := hdiv
  have hs : s≠0 := by intro hz; rw [hz,mul_zero] at hfs; exact hfZ hfs
  have hqpowdeg : (q^2).natDegree=4 := by
    rw [pow_two,Polynomial.natDegree_mul hqprim.ne_zero hqprim.ne_zero,hq2]
  have hs0 : s.natDegree=0 := by
    have hsum : fZ.natDegree=(q^2).natDegree+s.natDegree := by
      rw [hfs,Polynomial.natDegree_mul (pow_ne_zero 2 hqprim.ne_zero) hs]
    omega
  have hsC : s=Polynomial.C (s.coeff 0) := Polynomial.eq_C_of_natDegree_eq_zero hs0
  have hcs : s.coeff 0≠0 := by
    intro hz
    apply hs
    rw [hsC,hz,Polynomial.C_0]
  refine ⟨q,hqprim,hq2,s.coeff 0,hcs,?_⟩
  calc
    fZ=q^2*s := hfs
    _ = q^2*Polynomial.C (s.coeff 0) := congrArg (fun z=>q^2*z) hsC
    _ = Polynomial.C (s.coeff 0)*q^2 := mul_comm _ _

private theorem pure_fifth_quadratic_coefficients
    (p0 p1 p2 q0 q1 q2 kappa a b : ℚ)
    (hpure : ∀r s:ℚ,
      s^3*(q0*r^2+q1*r*s+q2*s^2)-
        r^3*(p0*r^2+p1*r*s+p2*s^2)=kappa*(a*r+b*s)^5) :
    p0 = -kappa*a^5 ∧ p1 = -5*kappa*a^4*b ∧ p2 = -10*kappa*a^3*b^2 ∧
    q0 = 10*kappa*a^2*b^3 ∧ q1 = 5*kappa*a*b^4 ∧ q2 = kappa*b^5 := by
  have h0 := hpure 0 1
  have hinf := hpure 1 0
  have h1 := hpure 1 1
  have hm1 := hpure (-1) 1
  have h2 := hpure 2 1
  have hm2 := hpure (-2) 1
  have hP0 : p0 = -kappa*a^5 := by linear_combination -hinf
  have hQ2 : q2 = kappa*b^5 := by simpa using h0
  have hP1 : p1 = -5*kappa*a^4*b := by
    linear_combination (-1/24:ℚ)*h2+(-1/24:ℚ)*hm2+
      (1/6:ℚ)*h1+(1/6:ℚ)*hm1-(1/4:ℚ)*hQ2
  have hQ0 : q0 = 10*kappa*a^2*b^3 := by
    linear_combination (1/2:ℚ)*h1+(1/2:ℚ)*hm1+hP1-hQ2
  have hP2 : p2 = -10*kappa*a^3*b^2 := by
    linear_combination (-1/12:ℚ)*h2+(1/12:ℚ)*hm2+
      (1/6:ℚ)*h1-(1/6:ℚ)*hm1-5*hP0
  have hQ1 : q1 = 5*kappa*a*b^4 := by
    linear_combination (1/2:ℚ)*h1-(1/2:ℚ)*hm1+hP2+hP0
  exact ⟨hP0,hP1,hP2,hQ0,hQ1,hQ2⟩

private theorem pure_fifth_actual_point
    (p0 p1 p2 q0 q1 q2 kappa a b d e u v : ℚ)
    (hk : kappa≠0) (hab : a≠0 ∨ b≠0) (hd : d≠0) (he : e≠0)
    (hpure : ∀r s:ℚ,
      s^3*(q0*r^2+q1*r*s+q2*s^2)-
        r^3*(p0*r^2+p1*r*s+p2*s^2)=kappa*(a*r+b*s)^5)
    (hshift : e^3*v-d^3*u=1)
    (hgraph : u*(q0*d^2+q1*d*e+q2*e^2)=v*(p0*d^2+p1*d*e+p2*e^2)) :
    ∃t:ℚ,d^3*u = -Q3 t := by
