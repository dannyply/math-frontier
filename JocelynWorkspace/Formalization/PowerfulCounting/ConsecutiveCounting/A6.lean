    x / 2 < ((z.1.1 ^ k * z.2.1 : ℕ) : ℝ) ∧ ((z.1.1 ^ k * z.2.1 : ℕ) : ℝ) ≤ x ∧
    D / 2 < (z.1.1 : ℝ) ∧ (z.1.1 : ℝ) ≤ D ∧ E / 2 < (z.1.2 : ℝ) ∧ (z.1.2 : ℝ) ≤ E}

def cellK (k : ℕ) (x D E : ℝ) (M j : ℕ) (h : ℤ) : Set Point :=
