private def integerSupNorm {σ : Type*} (G : MvPolynomial σ ℤ) : ℕ :=
  G.support.sup (fun m => (G.coeff m).natAbs)

private def ActualHB2 : Prop :=
  ∀ a b : ℕ, 1≤a → 1≤b →
    ∀ η : ℝ, 0<η → ∃ C : ℝ,
      ∀ G : MvPolynomial (Fin 4) ℤ,
        (∀ m∈G.support, m 0+m 1=a ∧ m 2+m 3=b) →
        Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G) →
        ∀ B : ℝ, 1≤B →
          let T : Set (Fin 4 → ℤ) :=
            {w | Int.gcd (w 0) (w 1)=1 ∧ Int.gcd (w 2) (w 3)=1 ∧
              MvPolynomial.eval w G=0 ∧ |(w 0:ℝ)|≤B ∧ |(w 1:ℝ)|≤B};
          T.Finite ∧ (T.ncard:ℝ)≤C*B^(2/(b:ℝ)+η)*(integerSupNorm G:ℝ)^η

private theorem integerSupNorm_le
    (G : MvPolynomial (Fin 4) ℤ) (H : ℝ) (hH : 0≤H)
    (hcoeff : ∀ m : Fin 4 →₀ ℕ, |((G.coeff m:ℤ):ℝ)|≤H) :
    (integerSupNorm G:ℝ)≤H := by
  have hn : integerSupNorm G≤⌊H⌋₊ := by
    apply Finset.sup_le
    intro m hm
    apply Nat.le_floor
    have habs : ((G.coeff m).natAbs:ℝ)=|((G.coeff m:ℤ):ℝ)| := by
      rw [← Int.cast_natCast,Int.natCast_natAbs,Int.cast_abs]
    rw [habs]
    exact hcoeff m
  exact (show (integerSupNorm G:ℝ)≤(⌊H⌋₊:ℝ) by exact_mod_cast hn).trans
    (Nat.floor_le hH)

private def firstPairLift (Q : Matrix (Fin 2) (Fin 2) ℤ) (q : Point) : Fin 4 → ℤ :=
  ![(Q.mulVec ![(q.1.1:ℤ),(q.1.2:ℤ)]) 0,
    (Q.mulVec ![(q.1.1:ℤ),(q.1.2:ℤ)]) 1,(q.2.1:ℤ),(q.2.2:ℤ)]

private theorem firstPairLift_injective
    (P Q : Matrix (Fin 2) (Fin 2) ℤ) (hPQ : P*Q=1) :
    Function.Injective (firstPairLift Q) := by
  intro q q' heq
  have hl : Q.mulVec ![(q.1.1:ℤ),(q.1.2:ℤ)]=
      Q.mulVec ![(q'.1.1:ℤ),(q'.1.2:ℤ)] := by
    funext i
    fin_cases i
    · exact congrFun heq 0
    · exact congrFun heq 1
  have hdv : ![(q.1.1:ℤ),(q.1.2:ℤ)]=![(q'.1.1:ℤ),(q'.1.2:ℤ)] := by
    calc
      _ = P.mulVec (Q.mulVec ![(q.1.1:ℤ),(q.1.2:ℤ)]) :=
        (matrix_left_inverse_mulVec P Q hPQ _).symm
      _ = P.mulVec (Q.mulVec ![(q'.1.1:ℤ),(q'.1.2:ℤ)]) := congrArg P.mulVec hl
      _ = _ := matrix_left_inverse_mulVec P Q hPQ _
  have hdZ : (q.1.1:ℤ)=(q'.1.1:ℤ) := congrFun hdv 0
  have heZ : (q.1.2:ℤ)=(q'.1.2:ℤ) := congrFun hdv 1
  have huZ : (q.2.1:ℤ)=(q'.2.1:ℤ) := congrFun heq 2
  have hvZ : (q.2.2:ℤ)=(q'.2.2:ℤ) := congrFun heq 3
  have hdN : q.1.1=q'.1.1 := by exact_mod_cast hdZ
  have heN : q.1.2=q'.1.2 := by exact_mod_cast heZ
  have huN : q.2.1=q'.2.1 := by exact_mod_cast huZ
  have hvN : q.2.2=q'.2.2 := by exact_mod_cast hvZ
  exact Prod.ext (Prod.ext hdN heN) (Prod.ext huN hvN)

private def firstBasisRadius (D E r : ℝ) (M : ℕ) : ℝ :=
  2+2*(|r|+1)*max 1 (((M:ℝ)/(8*D))*(4*E))

private def ActualFactorClass (G : MvPolynomial (Fin 4) ℤ) (a b : ℕ) : Prop :=
  (b=0 ∧ 2≤a ∧ ∀ w : Fin 4 → ℤ, MvPolynomial.eval w G=0 →
      w 0=0 ∧ w 1=0) ∨
  (a=0 ∧ 2≤b ∧ ∀ w : Fin 4 → ℤ, MvPolynomial.eval w G=0 →
      w 2=0 ∧ w 3=0) ∨
  ((a,b)=(1,0) ∧ ∃ p r : ℤ, (p,r)≠(0,0) ∧
      G=MvPolynomial.C p*MvPolynomial.X 0+MvPolynomial.C r*MvPolynomial.X 1) ∨
  ((a,b)=(0,1) ∧ ∃ p r : ℤ, (p,r)≠(0,0) ∧
      G=MvPolynomial.C p*MvPolynomial.X 2+MvPolynomial.C r*MvPolynomial.X 3) ∨
  (1≤a ∧ 1≤b ∧ min a b=1 ∧
      Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G)) ∨
  (2≤a ∧ 2≤b ∧ Irreducible (MvPolynomial.map (Int.castRingHom ℚ) G))

private theorem actual_finite_cover_ncard
    {k : ℕ} (S : Set Point) (T : Fin k → Set Point)
    (hS : S.Finite) (hT : ∀ i, (T i).Finite)
    (hcover : ∀ q∈S, ∃ i, q∈T i) :
    (S.ncard:ℝ)≤∑ i : Fin k, ((T i).ncard:ℝ) := by
  classical
  let F : Fin k → Finset Point := fun i => (hT i).toFinset
  have hsub : hS.toFinset⊆Finset.univ.biUnion F := by
    intro q hq
    obtain ⟨i,hi⟩ := hcover q (hS.mem_toFinset.mp hq)
    exact Finset.mem_biUnion.mpr ⟨i,Finset.mem_univ i,(hT i).mem_toFinset.mpr hi⟩
  have hcard : hS.toFinset.card≤∑ i : Fin k, (F i).card :=
    (Finset.card_le_card hsub).trans Finset.card_biUnion_le
  have hh : S.ncard≤∑ i : Fin k, (T i).ncard := by
    have heach : ∀ i : Fin k, (F i).card=(T i).ncard :=
      fun i => (Set.ncard_eq_toFinset_card (T i) (hT i)).symm
    simpa only [← Set.ncard_eq_toFinset_card S hS,heach] using hcard
  exact_mod_cast hh

private theorem finite_sum_square_le (I : Finset ℕ) (f : ℕ → ℝ) :
    (∑ j∈I, f j)^2≤(I.card:ℝ)*(∑ j∈I, (f j)^2) := by
  have hnn : 0≤∑ i∈I, ∑ j∈I, (f i-f j)^2 :=
    Finset.sum_nonneg (fun i hi =>
      Finset.sum_nonneg (fun j hj => sq_nonneg (f i-f j)))
  have hid :
      (∑ i∈I, ∑ j∈I, (f i-f j)^2)=
        2*((I.card:ℝ)*(∑ j∈I, (f j)^2)-(∑ j∈I, f j)^2) := by
    simp_rw [sub_sq,Finset.sum_add_distrib,Finset.sum_sub_distrib,
      ← Finset.mul_sum,← Finset.sum_mul,Finset.sum_const,nsmul_eq_mul]
    simp only [← Finset.mul_sum]
    ring
  rw [hid] at hnn
  linarith

private theorem actual_common_first_moment :
    ∃ C : ℝ, 0<C ∧
      ∀ D E : ℝ, 0<D → 0<E → ∀ M : ℕ, 1≤M →
        ∀ ed : (j : ℕ) →
          FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.EllipseData
            ((M:ℝ)/(8*D)) (rho D E M j) (4*E),
        ∑ j∈cells D E M,
          (FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.sideLength
            ((M:ℝ)/(8*D)) (rho D E M j) (4*E) (ed j).P 0)^2≤
          C*(D*E*(1+Real.log (M:ℝ))+(D^2+E^2)/(M:ℝ)) := by
  classical
  obtain ⟨C,hC,hmoment⟩ :=
    FormalAB.S75c3b853.ConsecutiveCountingA5SecondMoments.actual_second_moment
  refine ⟨4*C,by positivity,?_⟩
  intro D E hD hE M hM ed
  let bs : ℕ → ℤ×ℤ := fun j =>
    FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.col (ed j).P 0
  have hlo : (2*D)/(2*(2*E))=D/(2*E) := by field_simp
  have hhi : 2*(2*D)/(2*E)=2*D/E := by field_simp
  have hrho : ∀ j : ℕ,
      FormalAB.S75c3b853.ConsecutiveCountingA5SecondMoments.rho
        (2*D) (2*E) M j=rho D E M j := by
    intro j
    simp only [FormalAB.S75c3b853.ConsecutiveCountingA5SecondMoments.rho,
      rho,FormalAB.Sb751f117.A5CentralOriginalAuxiliary.rho,hlo]
  have hcells :
      FormalAB.S75c3b853.ConsecutiveCountingA5SecondMoments.cells
        (2*D) (2*E) M=cells D E M := by
    ext j
    simp only [FormalAB.S75c3b853.ConsecutiveCountingA5SecondMoments.cells,
      cells,FormalAB.Sb751f117.A5CentralOriginalAuxiliary.cells,
      Finset.mem_filter,hlo,hhi,hrho]
  have hcomp :
      ((2*D)/(2*E))^2/32≤D^2/E^2 ∧
        D^2/E^2≤32*((2*D)/(2*E))^2 := by
    have hh : ((2*D)/(2*E))^2=D^2/E^2 := by field_simp
    rw [hh]
    have hh0 : 0≤D^2/E^2 := div_nonneg (sq_nonneg D) (sq_nonneg E)
    constructor <;> nlinarith
  have hb : ∀ j∈FormalAB.S75c3b853.ConsecutiveCountingA5SecondMoments.cells
      (2*D) (2*E) M, bs j≠0 := fun j hj => (ed j).hcol
  have hc : ∀ j∈FormalAB.S75c3b853.ConsecutiveCountingA5SecondMoments.cells
      (2*D) (2*E) M, (fun _ : ℕ => ((1:ℤ),(0:ℤ))) j≠0 := by
    intro j hj
    simp
  have hh := (hmoment (2*D) (2*E) (E^2) (D^2)
    (by positivity) (by positivity) (sq_pos_of_pos hE) (sq_pos_of_pos hD)
    M hM hcomp bs (fun _ => ((1:ℤ),(0:ℤ))) hb hc).1
  have hlength : ∀ j,
      FormalAB.S75c3b853.ConsecutiveCountingA5SecondMoments.L
        (2*D) (2*E) M bs j=
      FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.sideLength
        ((M:ℝ)/(8*D)) (rho D E M j) (4*E) (ed j).P 0 := by
    intro j
    dsimp only [FormalAB.S75c3b853.ConsecutiveCountingA5SecondMoments.L,
      FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.sideLength,
      FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.nsq,bs]
    rw [hrho]
    congr 2 ; field_simp [hD.ne',hE.ne'] ; ring
  simp_rw [hcells,hlength] at hh
  have heq :
      C*((2*D)*(2*E)*(1+Real.log (M:ℝ))+((2*D)^2+(2*E)^2)/(M:ℝ))=
        (4*C)*(D*E*(1+Real.log (M:ℝ))+(D^2+E^2)/(M:ℝ)) := by ring
  exact hh.trans_eq heq

private theorem actual_common_first_sum :
    ∃ C : ℝ, 0<C ∧
      ∀ D E : ℝ, 0<D → 0<E → ∀ M : ℕ, 1≤M →
        ∀ ed : (j : ℕ) →
          FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.EllipseData
            ((M:ℝ)/(8*D)) (rho D E M j) (4*E),
        ∑ j∈cells D E M,
          FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.sideLength
            ((M:ℝ)/(8*D)) (rho D E M j) (4*E) (ed j).P 0≤
          C*(Real.sqrt (D*E*(M:ℝ))*Real.sqrt (1+Real.log (M:ℝ))+D+E) := by
  classical
  obtain ⟨C,hC,hmoment⟩ := actual_common_first_moment
  refine ⟨4*Real.sqrt C,by positivity,?_⟩
  intro D E hD hE M hM ed
  let I : Finset ℕ := cells D E M
  let f : ℕ → ℝ := fun j =>
    FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.sideLength
      ((M:ℝ)/(8*D)) (rho D E M j) (4*E) (ed j).P 0
  let S : ℝ := ∑ j∈I, f j
  let Q : ℝ := ∑ j∈I, (f j)^2
  have hS : 0≤S :=
    Finset.sum_nonneg (fun j _ => ((ed j).hpos.trans_le (ed j).horder).le)
  have hQ : 0≤Q := Finset.sum_nonneg (fun j _ => sq_nonneg (f j))
  have hMr : (1:ℝ)≤M := by exact_mod_cast hM
  have hM0 : (0:ℝ)<M := by linarith
  have hlog : 0≤Real.log (M:ℝ) := Real.log_nonneg hMr
  have hcard : (I.card:ℝ)≤4*(M:ℝ) := by
    exact FormalAB.S75c3b853.ConsecutiveCountingA5SecondMoments.cells_card_bound D E M hM
  have hsq : S^2≤16*C*(D*E*(M:ℝ)*(1+Real.log (M:ℝ))+D^2+E^2) := by
    calc
      S^2≤(I.card:ℝ)*Q := finite_sum_square_le I f
      _ ≤ (4*(M:ℝ))*Q := mul_le_mul_of_nonneg_right hcard hQ
      _ ≤ (4*(M:ℝ))*
          (C*(D*E*(1+Real.log (M:ℝ))+(D^2+E^2)/(M:ℝ))) :=
        mul_le_mul_of_nonneg_left (hmoment D E hD hE M hM ed) (by positivity)
      _ = 4*C*(D*E*(M:ℝ)*(1+Real.log (M:ℝ))+D^2+E^2) := by
        field_simp [hM0.ne']; ring
      _ ≤ 16*C*(D*E*(M:ℝ)*(1+Real.log (M:ℝ))+D^2+E^2) := by
        apply mul_le_mul_of_nonneg_right
        · nlinarith
        · positivity
  let A : ℝ := Real.sqrt (D*E*(M:ℝ))*Real.sqrt (1+Real.log (M:ℝ))
  have hA : 0≤A := by dsimp only [A]; positivity
  have hA2 : A^2=D*E*(M:ℝ)*(1+Real.log (M:ℝ)) := by
    dsimp only [A]
    rw [mul_pow,Real.sq_sqrt (by positivity),Real.sq_sqrt (by positivity)]
  have hcsq : (Real.sqrt C)^2=C := Real.sq_sqrt hC.le
  have hsum : D*E*(M:ℝ)*(1+Real.log (M:ℝ))+D^2+E^2≤(A+D+E)^2 := by
    rw [← hA2]
    nlinarith
  have htarget : S^2≤(4*Real.sqrt C*(A+D+E))^2 := by
    have hh := mul_le_mul_of_nonneg_left hsum (by positivity : 0≤16*C)
    have heq : (4*Real.sqrt C*(A+D+E))^2=16*C*(A+D+E)^2 := by
      calc
        _ = 16*(Real.sqrt C)^2*(A+D+E)^2 := by ring
        _ = _ := by rw [hcsq]
    rw [heq]
    exact hsq.trans hh
  have htarget0 : 0≤4*Real.sqrt C*(A+D+E) := by positivity
  change S≤4*Real.sqrt C*(A+D+E)
  nlinarith

private theorem actual_log_sqrt_subpower (γ : ℝ) (hγ : 0<γ) :
    ∃ C : ℝ, 0<C ∧
      ∀ x : ℝ, 2≤x → ∀ M : ℕ, 1≤M → (M:ℝ)≤2*x →
        Real.sqrt (1+Real.log (M:ℝ))≤C*x^γ := by
  let K : ℝ := 1+Real.log 2+1/(2*γ)
  have hlog2 : 0≤Real.log 2 := Real.log_nonneg (by norm_num)
  have hK : 0<K := by dsimp only [K]; positivity
  refine ⟨Real.sqrt K,Real.sqrt_pos.mpr hK,?_⟩
  intro x hx M hM hMup
  have hx0 : 0<x := by linarith
  have hx1 : 1≤x := by linarith
  have hMr : (1:ℝ)≤M := by exact_mod_cast hM
  have hM0 : (0:ℝ)<M := by linarith
  have hlogM : 0≤Real.log (M:ℝ) := Real.log_nonneg hMr
  have hlogcap : Real.log (M:ℝ)≤Real.log 2+Real.log x := by
    calc
      Real.log (M:ℝ)≤Real.log (2*x) := Real.log_le_log hM0 hMup
      _ = Real.log 2+Real.log x := Real.log_mul (by norm_num) hx0.ne'
  let Y : ℝ := x^(2*γ)
  have hY : 1≤Y := Real.one_le_rpow hx1 (by positivity)
  have hlogx : Real.log x≤(Y-1)/(2*γ) := by
    have hh := Real.log_le_sub_one_of_pos (Real.rpow_pos_of_pos hx0 (2*γ))
    rw [Real.log_rpow hx0] at hh
    apply (le_div_iff₀ (by positivity : 0<2*γ)).mpr
    dsimp only [Y]
    nlinarith
  have hbase : 1+Real.log 2≤(1+Real.log 2)*Y := by nlinarith
  have htail : (Y-1)/(2*γ)≤Y/(2*γ) :=
    div_le_div_of_nonneg_right (by linarith) (by positivity)
  have hcap : 1+Real.log (M:ℝ)≤K*Y := by
    calc
      1+Real.log (M:ℝ)≤(1+Real.log 2)+(Y-1)/(2*γ) := by linarith
      _ ≤ (1+Real.log 2)*Y+Y/(2*γ) := add_le_add hbase htail
      _ = K*Y := by dsimp only [K]; field_simp
  have hpow : (x^γ)^2=Y := by
    dsimp only [Y]
    rw [← Real.rpow_natCast (x^γ) 2,← Real.rpow_mul hx0.le]
    congr 1
    ring
  have hsq :
      (Real.sqrt (1+Real.log (M:ℝ)))^2≤(Real.sqrt K*x^γ)^2 := by
    rw [Real.sq_sqrt (by linarith),mul_pow,Real.sq_sqrt hK.le,hpow]
    exact hcap
  have hl0 : 0≤Real.sqrt (1+Real.log (M:ℝ)) := Real.sqrt_nonneg _
  have hr0 : 0≤Real.sqrt K*x^γ := by positivity
  nlinarith

private theorem actual_common_first_sum_subpower (ε : ℝ) (hε : 0<ε) :
    ∃ C : ℝ, 0<C ∧
      ∀ (x D E : ℝ), 2≤x → 0<D → 0<E →
        ∀ M : ℕ, 1≤M → (M:ℝ)≤2*x →
          ∀ ed : (j : ℕ) →
            FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.EllipseData
              ((M:ℝ)/(8*D)) (rho D E M j) (4*E),
          ∑ j∈cells D E M,
            FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.sideLength
              ((M:ℝ)/(8*D)) (rho D E M j) (4*E) (ed j).P 0≤
            C*x^ε*(Real.sqrt (D*E*(M:ℝ))+D+E) := by
  obtain ⟨Cm,hCm,hmoment⟩ := actual_common_first_sum
  obtain ⟨Cl,hCl,hlog⟩ := actual_log_sqrt_subpower ε hε
  let R : ℝ := max 1 Cl
  have hR1 : 1≤R := le_max_left _ _
  have hR : 0<R := by linarith
  refine ⟨Cm*R,mul_pos hCm hR,?_⟩
  intro x D E hx hD hE M hM hMup ed
  have hx0 : 0<x := by linarith
  have hxpow : 1≤x^ε := Real.one_le_rpow (by linarith) hε.le
  have hprod : 1≤R*x^ε := by
    nlinarith [mul_nonneg (by linarith : 0≤R-1) (by linarith : 0≤x^ε-1)]
  let A : ℝ := Real.sqrt (D*E*(M:ℝ))
  have hA : 0≤A := Real.sqrt_nonneg _
  have hlogcap : Real.sqrt (1+Real.log (M:ℝ))≤R*x^ε :=
    (hlog x hx M hM hMup).trans
      (mul_le_mul_of_nonneg_right (le_max_right _ _) (Real.rpow_nonneg hx0.le ε))
  have hscaled :
      A*Real.sqrt (1+Real.log (M:ℝ))+D+E≤
        R*x^ε*(A+D+E) := by
    have hmain := mul_le_mul_of_nonneg_left hlogcap hA
    have hD' : D≤R*x^ε*D := by nlinarith
    have hE' : E≤R*x^ε*E := by nlinarith
    nlinarith
  calc
    _ ≤ Cm*(A*Real.sqrt (1+Real.log (M:ℝ))+D+E) := hmoment D E hD hE M hM ed
    _ ≤ Cm*(R*x^ε*(A+D+E)) := mul_le_mul_of_nonneg_left hscaled hCm.le
    _ = (Cm*R)*x^ε*(A+D+E) := by ring

end OSKPrivate

