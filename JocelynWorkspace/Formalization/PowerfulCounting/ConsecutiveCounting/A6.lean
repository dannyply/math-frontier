private theorem ck
 (G q:aa) (hG:G ≠ 0) (hq:q ≠ 0)
 (hqG:q∣G)
 (hass:Associated (ag q)
 (ag G)):
 ∃n:I,n ≠ 0 ∧ G = C n*q:=by
  have bG:=P7C.support_eq_of_associated_maps q G hass
