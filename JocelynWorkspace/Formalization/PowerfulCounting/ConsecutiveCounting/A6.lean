theorem finite_height_count
    (N : Polynomial ℝ) (d : ℕ) (hdeg : N.natDegree ≤ d)
    (X B : ℝ) (hX : 0 ≤ X) (hB : 0 < B)
    (G : ℝ → Prop) (T : Finset ℤ)
    (hvals : ∀ t ∈ T, 0 ≤ N.eval (t : ℝ) ∧ N.eval (t : ℝ) ≤ X)
    (hsegment : ∀ s ∈ T, ∀ t ∈ T, ∀ z : ℝ,
      (s : ℝ) ≤ z → z ≤ (t : ℝ) → G z)
    (hder : ∀ z : ℝ, G z → 0 ≤ N.eval z → N.eval z ≤ X →
      B ≤ |N.derivative.eval z|) :
    (T.card : ℝ) ≤ ((2*d+1 : ℕ) : ℝ) *
      (2 * (Nat.ceil (X/B) : ℝ) + 1) := by
  classical
  by_cases he : T = ∅
  · rw [he,Finset.card_empty,Nat.cast_zero]
    positivity
  obtain ⟨t₀,ht₀⟩ := Finset.nonempty_iff_ne_empty.mpr he
  have hsample : B ≤ |N.derivative.eval (t₀ : ℝ)| :=
    hder _ (hsegment t₀ ht₀ t₀ ht₀ _ le_rfl le_rfl)
      (hvals t₀ ht₀).1 (hvals t₀ ht₀).2
  have hn : N ≠ 0 := by
    intro hz
    simp [hz] at hsample
    linarith
  have hxn : C X - N ≠ 0 := by
    intro hz
    have hconst : N = C X := by
      exact sub_eq_zero.mp hz |>.symm
    simp [hconst] at hsample
    linarith
  let R : Finset ℝ := N.roots.toFinset ∪ (C X-N).roots.toFinset
  have hRcard : R.card ≤ 2*d := by
    have h₁ := root_finset_card_le_natDegree N
    have h₂ := root_finset_card_le_natDegree (C X-N)
    have hdeg₂ : (C X-N).natDegree ≤ d := by
      calc
        (C X-N).natDegree ≤ max (C X).natDegree N.natDegree := natDegree_sub_le _ _
        _ ≤ d := max_le (by simp) hdeg
    exact (Finset.card_union_le _ _).trans (by omega)
  have hroots₁ : ∀ z : ℝ, N.eval z = 0 → z ∈ R := by
    intro z hz
    exact Finset.mem_union.mpr (Or.inl (polynomial_root_mem_finset N hn z hz))
  have hroots₂ : ∀ z : ℝ, (C X-N).eval z = 0 → z ∈ R := by
    intro z hz
    exact Finset.mem_union.mpr (Or.inr (polynomial_root_mem_finset _ hxn z hz))
