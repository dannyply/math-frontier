open Classical
noncomputable section
namespace A6P3Analysis
set_option maxHeartbeats 1200000
set_option linter.all false

def ratioR (t : ℝ) : ℝ := 3*(t-1)*(1+5*t+10*t^2)/t^3

theorem near_opposite (t : ℝ) (ht : t < 0)
    (hsmall : (t+1)^2 < (-t)/16384) :
    -(3/2 : ℝ) < t ∧ t < -(1/2 : ℝ) ∧ (t+1)^2 ≤ (1/1000 : ℝ) := by
  have hlo : -2 < t := by
    by_contra hh
    have hle : t ≤ -2 := le_of_not_gt hh
    have hp : 0 ≤ (t+2)*(t+1/2) :=
      mul_nonneg_of_nonpos_of_nonpos (by linarith) (by linarith)
    nlinarith
  have hhi : t < -(1/2 : ℝ) := by
    by_contra hh
    have hp : 0 ≤ (t+2)*(t+1/2) :=
      mul_nonneg (by linarith) (by linarith)
    nlinarith
  have hsq : (t+1)^2 ≤ (1/1000 : ℝ) := by nlinarith
  have hlo' : -(3/2 : ℝ) < t := by
    by_contra hh
    have hle : t ≤ -(3/2 : ℝ) := le_of_not_gt hh
    nlinarith [sq_nonneg (t+3/2)]
  exact ⟨hlo',hhi,hsq⟩

theorem ratioR_near (t : ℝ)
    (hlo : -(3/2 : ℝ) ≤ t) (hhi : t ≤ -(1/2 : ℝ))
    (hsq : (t+1)^2 ≤ (1/1000 : ℝ)) :
    |ratioR t - 36| ≤ 1 := by
  have ht : t ≠ 0 := by linarith
  have he : ratioR t - 36 = -3*(t+1)^2*(2*t+1)/t^3 := by
    dsimp [ratioR]
    field_simp
    <;> ring
  have htabs : (1/2 : ℝ) ≤ |t| := by
    rw [abs_of_nonpos (by linarith : t ≤ 0)]
    linarith
  have hden : (1/8 : ℝ) ≤ |t^3| := by
    rw [abs_pow]
    calc
      (1/8 : ℝ) = (1/2 : ℝ)^3 := by norm_num
      _ ≤ |t| ^3 := by gcongr
  have hlin : |2*t+1| ≤ 2 := abs_le.mpr ⟨by linarith,by linarith⟩
  have hnum : |-3*(t+1)^2*(2*t+1)| ≤ (6/1000 : ℝ) := by
    calc
      |-3*(t+1)^2*(2*t+1)| = 3*(t+1)^2*|2*t+1| := by
        rw [abs_mul,abs_mul,abs_of_nonneg (sq_nonneg (t+1))]
        norm_num
      _ ≤ 3*(1/1000)*2 := by gcongr
      _ = (6/1000 : ℝ) := by norm_num
  rw [he,abs_div]
  apply (div_le_iff₀ (abs_pos.mpr (pow_ne_zero 3 ht))).mpr
  nlinarith

theorem normalized_derivative_margin (t θ J : ℝ)
    (hnear : |ratioR t - 36| ≤ 1) (hθ : |θ| ≤ (1/100 : ℝ))
    (heq : J = ratioR t*(1+θ)-30) : 3 ≤ J := by
  have hR : |ratioR t| ≤ 37 := by
    have hh := abs_le.mp hnear
    apply abs_le.mpr
    constructor <;> linarith
  have hprod : |ratioR t*θ| ≤ (37/100 : ℝ) := by
    rw [abs_mul]
    calc
      |ratioR t| *|θ| ≤ 37*(1/100) := by gcongr
      _ = (37/100 : ℝ) := by norm_num
  have hlow := (abs_le.mp hnear).1
  have hprodlo := (abs_le.mp hprod).1
  rw [heq]
  nlinarith

def H3 (A B : ℝ) : ℝ := A^5+5*A^4*B+10*A^3*B^2

theorem cancellation_at_real_height
    (A B m q k Pi W x n : ℝ)
    (hW : 0 < W) (hPi : W/4 < Pi) (hPiW : Pi ≤ W)
    (hk : k < 0) (hm : m ≠ 0) (hAB : A*B = k*Pi) (hlevel : A+B=m)
    (hqlow : 1 ≤ |q|) (hn0 : 0 ≤ n) (hnx : n ≤ x)
    (hnormal : q*Pi^3 = H3 A B + m^5*n)
    (hsmall₁ : |m| ^5*x < W^3/65536)
    (hsmall₂ : m^2 < |k| *W/65536) :
    W ≤ (2^40 : ℝ)*|k| ^5 ∧
    W^2*|k| ^3/(16*|m| ^5) ≤
      |Pi^2/m^5*(3*q*(B-A)-30*k^3)| := by
  have hPi0 : 0 < Pi := by linarith
  have hk0 : k ≠ 0 := ne_of_lt hk
  have hK : 0 < |k| := abs_pos.mpr hk0
  have hmu : 0 < |m| := abs_pos.mpr hm
  have hABneg : A*B < 0 := by rw [hAB]; exact mul_neg_of_neg_of_pos hk hPi0
  have ha : A ≠ 0 := by intro hz; simp [hz] at hABneg
  have hb : B ≠ 0 := by intro hz; simp [hz] at hABneg
  let t : ℝ := B/A
  have htAB : t*A^2 = A*B := by dsimp [t]; field_simp [ha] <;> ring
  have htneg : t < 0 := by
    have ha2 : 0 < A^2 := sq_pos_of_ne_zero ha
    nlinarith
  have hratio : (t+1)^2*A^2 = m^2 := by
    dsimp [t]
    rw [←hlevel]
    field_simp [ha]
    <;> ring
  have hABabs : -(A*B) = |k| *Pi := by rw [hAB,abs_of_neg hk] <;> ring
  have hmAB : m^2 < -(A*B)/16384 := by
    have hh : |k| *W < 4*(|k| *Pi) := by nlinarith [mul_pos hK (by linarith : 0 < 4*Pi-W)]
    nlinarith
  have ht_small : (t+1)^2 < (-t)/16384 := by
    by_contra hh
    have hp : 0 ≤ ((t+1)^2-(-t)/16384)*A^2 :=
      mul_nonneg (by linarith) (sq_nonneg A)
    nlinarith only [hp,hratio,htAB,hmAB]
  obtain ⟨htlo,hthi,htsq⟩ := near_opposite t htneg ht_small
  have hR := ratioR_near t htlo.le hthi.le htsq
  have hPi3 : W^3 < 64*Pi^3 := by
    have hh : (W/4)^3 < Pi^3 := by gcongr
    nlinarith
  have hF : |m^5*n| ≤ |m| ^5*x := by
    rw [abs_mul,abs_pow,abs_of_nonneg hn0]
    exact mul_le_mul_of_nonneg_left hnx (pow_nonneg (abs_nonneg m) 5)
  have hqPi : Pi^3 ≤ |q*Pi^3| := by
    rw [abs_mul,abs_of_pos (pow_pos hPi0 3)]
    nlinarith [mul_le_mul_of_nonneg_right hqlow (pow_nonneg hPi0.le 3)]
  have htri : Pi^3 ≤ |H3 A B|+|m^5*n| := by
    calc
      Pi^3 ≤ |q*Pi^3| := hqPi
      _ = |H3 A B+m^5*n| := by rw [hnormal]
      _ ≤ _ := abs_add_le _ _
  have hPi3pos : 0 < Pi^3 := pow_pos hPi0 3
  have hHlo : Pi^3/2 ≤ |H3 A B| := by
    nlinarith only [hF,hsmall₁,hPi3,htri,hPi3pos]
  have hHpos : 0 < |H3 A B| := lt_of_lt_of_le (by positivity) hHlo
  have hHne : H3 A B ≠ 0 := abs_pos.mp hHpos
  have hθ : |m^5*n/H3 A B| ≤ (1/100 : ℝ) := by
    rw [abs_div]
    apply (div_le_iff₀ hHpos).mpr
    nlinarith
  have hRexact : ratioR t = 3*(B-A)*H3 A B/(k^3*Pi^3) := by
    rw [←mul_pow,←hAB]
    dsimp [ratioR,t,H3]
    field_simp [ha,hb]
    <;> ring
  have hJexact :
      (3*q*(B-A)-30*k^3)/k^3 =
        ratioR t*(1+m^5*n/H3 A B)-30 := by
    rw [hRexact]
    field_simp [hk0,ne_of_gt hPi0,hHne]
    <;> linear_combination 3*(B-A)*hnormal
  have hJnorm : 3 ≤ (3*q*(B-A)-30*k^3)/k^3 :=
    normalized_derivative_margin t (m^5*n/H3 A B) _ hR hθ hJexact
  have hJabs : 3*|k| ^3 ≤ |3*q*(B-A)-30*k^3| := by
    have hh := hJnorm.trans (le_abs_self _)
    rw [abs_div,abs_pow] at hh
    exact (le_div_iff₀ (pow_pos hK 3)).mp hh
  have hA2 : A^2 ≤ 2*|k| *W := by
    have hh : |k| *Pi ≤ |k| *W := mul_le_mul_of_nonneg_left hPiW hK.le
    nlinarith [htAB,hABabs,mul_nonneg (sq_nonneg A) (by linarith : 0 ≤ -t-1/2)]
  have htbound : |t| ≤ 2 := by
    rw [abs_of_neg htneg]
    linarith
  have hHshape : H3 A B = A^5*(1+5*t+10*t^2) := by
    dsimp [H3,t]
    field_simp [ha]
    <;> ring
  have hpoly : |1+5*t+10*t^2| ≤ 243 := by
    calc
      |1+5*t+10*t^2| ≤ |1+5*t|+|10*t^2| := abs_add_le _ _
      _ ≤ (|1|+|5*t|)+|10*t^2| :=
        by linarith [abs_add_le (1 : ℝ) (5*t)]
      _ = 1+5*|t|+10*|t| ^2 := by rw [abs_mul,abs_mul,abs_pow]; norm_num
      _ ≤ 1+5*2+10*2^2 := by gcongr
      _ ≤ (243 : ℝ) := by norm_num
  have hHup : |H3 A B| ≤ 243*|A| ^5 := by
    rw [hHshape,abs_mul,abs_pow]
    nlinarith [mul_le_mul_of_nonneg_left hpoly (pow_nonneg (abs_nonneg A) 5)]
  have hA10 : |A| ^10 ≤ 32*|k| ^5*W^5 := by
    calc
      |A| ^10 = (A^2)^5 := by rw [←sq_abs] <;> ring
      _ ≤ (2*|k| *W)^5 := by gcongr
      _ = _ := by ring
  have hH2 : (H3 A B)^2 ≤ 59049*|A| ^10 := by
    have hh := pow_le_pow_left₀ (abs_nonneg (H3 A B)) hHup 2
    nlinarith [sq_abs (H3 A B)]
  have hlow : W^3 ≤ 128*|H3 A B| := by nlinarith
  have hlow2 : W^6 ≤ 16384*(H3 A B)^2 := by
    have hh := pow_le_pow_left₀ (pow_nonneg hW.le 3) hlow 2
    nlinarith [sq_abs (H3 A B)]
  have hWpow : W*W^5 ≤ (2^40 : ℝ)*|k| ^5*W^5 := by
    have hnon : 0 ≤ |k| ^5*W^5 := by positivity
    nlinarith [hA10,hH2,hlow2]
  have hforce : W ≤ (2^40 : ℝ)*|k| ^5 := by
    exact le_of_mul_le_mul_right hWpow (pow_pos hW 5)
  refine ⟨hforce,?_⟩
  have hJabs' : |k| ^3 ≤ |3*q*(B-A)-30*k^3| := by
    nlinarith [pow_nonneg hK.le 3]
  have hPi2 : (W/4)^2 ≤ Pi^2 := by gcongr
  calc
    W^2*|k| ^3/(16*|m| ^5) = (W/4)^2/|m| ^5*|k| ^3 := by field_simp <;> ring
    _ ≤ Pi^2/|m| ^5*|3*q*(B-A)-30*k^3| := by gcongr
    _ = |Pi^2/m^5*(3*q*(B-A)-30*k^3)| := by
      simp only [abs_mul,abs_div,abs_pow,abs_of_pos hPi0]

open Polynomial
def dLine (m d₀ b : ℝ) : Polynomial ℝ := C (m*d₀)+C b*Polynomial.X
def eLine (m e₀ a : ℝ) : Polynomial ℝ := C (m*e₀)-C a*Polynomial.X
def H3poly (A B : Polynomial ℝ) : Polynomial ℝ :=
  A^5+C 5*A^4*B+C 10*A^3*B^2
def heightPoly (a b m q d₀ e₀ : ℝ) : Polynomial ℝ :=
  (C q*(dLine m d₀ b*eLine m e₀ a)^3-
    H3poly (C a*dLine m d₀ b) (C b*eLine m e₀ a))*C ((m^5)⁻¹)

theorem heightPoly_eval (a b m q d₀ e₀ z : ℝ) :
    (heightPoly a b m q d₀ e₀).eval z =
      (q*((m*d₀+b*z)*(m*e₀-a*z))^3-
        H3 (a*(m*d₀+b*z)) (b*(m*e₀-a*z)))/m^5 := by
  simp [heightPoly,H3poly,dLine,eLine,H3,div_eq_mul_inv]
  <;> ring

theorem heightPoly_derivative (a b m q d₀ e₀ z : ℝ) :
    (heightPoly a b m q d₀ e₀).derivative.eval z =
      ((m*d₀+b*z)*(m*e₀-a*z))^2/m^5*
        (3*q*(b*(m*e₀-a*z)-a*(m*d₀+b*z))-30*(a*b)^3) := by
  simp [heightPoly,H3poly,dLine,eLine,derivative_mul,derivative_pow,
    derivative_sub,derivative_add,div_eq_mul_inv]
  <;> ring

theorem degree_add_bound (F G : Polynomial ℝ) (k : ℕ)
    (hF : F.natDegree ≤ k) (hG : G.natDegree ≤ k) : (F+G).natDegree ≤ k :=
  (natDegree_add_le _ _).trans (max_le hF hG)
theorem degree_sub_bound (F G : Polynomial ℝ) (k : ℕ)
    (hF : F.natDegree ≤ k) (hG : G.natDegree ≤ k) : (F-G).natDegree ≤ k :=
  (natDegree_sub_le _ _).trans (max_le hF hG)
theorem degree_mul_bound (F G : Polynomial ℝ) (k l : ℕ)
    (hF : F.natDegree ≤ k) (hG : G.natDegree ≤ l) : (F*G).natDegree ≤ k+l :=
  natDegree_mul_le.trans (Nat.add_le_add hF hG)
theorem degree_pow_bound (F : Polynomial ℝ) (k n : ℕ)
    (hF : F.natDegree ≤ k) : (F^n).natDegree ≤ k*n := by
  induction n with
  | zero => simp
  | succ n ih =>
    calc
      (F^(n+1)).natDegree ≤ (F^n).natDegree+F.natDegree := by
        rw [pow_succ]
        exact natDegree_mul_le
      _ ≤ k*n+k := Nat.add_le_add ih hF
      _ = k*(n+1) := by ring

theorem H3poly_degree (A B : Polynomial ℝ)
    (hA : A.natDegree ≤ 1) (hB : B.natDegree ≤ 1) :
    (H3poly A B).natDegree ≤ 5 := by
  have h₁ : (A^5).natDegree ≤ 5 := by simpa using degree_pow_bound A 1 5 hA
  have h₂ : (C 5*A^4).natDegree ≤ 4 :=
    degree_mul_bound _ _ 0 4 (by simp) (by simpa using degree_pow_bound A 1 4 hA)
  have h₂' : (C 5*A^4*B).natDegree ≤ 5 := degree_mul_bound _ _ 4 1 h₂ hB
  have h₃ : (C 10*A^3).natDegree ≤ 3 :=
    degree_mul_bound _ _ 0 3 (by simp) (by simpa using degree_pow_bound A 1 3 hA)
  have h₃' : (C 10*A^3*B^2).natDegree ≤ 5 :=
    degree_mul_bound _ _ 3 2 h₃ (by simpa using degree_pow_bound B 1 2 hB)
  exact degree_add_bound _ _ 5 (degree_add_bound _ _ 5 h₁ h₂') h₃'

theorem heightPoly_degree (a b m q d₀ e₀ : ℝ) :
    (heightPoly a b m q d₀ e₀).natDegree ≤ 6 := by
  have hd : (dLine m d₀ b).natDegree ≤ 1 := by
    apply degree_add_bound _ _ 1 (by simp only [natDegree_C]; omega)
    exact (degree_mul_bound _ _ 0 1 (by simp) (by simp))
  have he : (eLine m e₀ a).natDegree ≤ 1 := by
    apply degree_sub_bound _ _ 1 (by simp only [natDegree_C]; omega)
    exact (degree_mul_bound _ _ 0 1 (by simp) (by simp))
  have hPi : (dLine m d₀ b*eLine m e₀ a).natDegree ≤ 2 :=
    degree_mul_bound _ _ 1 1 hd he
  have hmain : (C q*(dLine m d₀ b*eLine m e₀ a)^3).natDegree ≤ 6 :=
    degree_mul_bound _ _ 0 6 (by simp) (by simpa using degree_pow_bound _ 2 3 hPi)
  have hA : (C a*dLine m d₀ b).natDegree ≤ 1 :=
    degree_mul_bound _ _ 0 1 (by simp) hd
  have hB : (C b*eLine m e₀ a).natDegree ≤ 1 :=
    degree_mul_bound _ _ 0 1 (by simp) he
  have hH : (H3poly (C a*dLine m d₀ b) (C b*eLine m e₀ a)).natDegree ≤ 6 :=
    (H3poly_degree _ _ hA hB).trans (by omega)
  exact degree_mul_bound _ _ 6 0 (degree_sub_bound _ _ 6 hmain hH) (by simp)

def lineD (m d₀ b : ℤ) (z : ℝ) : ℝ := (m : ℝ)*(d₀ : ℝ)+(b : ℝ)*z
def lineE (m e₀ a : ℤ) (z : ℝ) : ℝ := (m : ℝ)*(e₀ : ℝ)-(a : ℝ)*z
def lineHeight (a b m q d₀ e₀ : ℤ) : Polynomial ℝ :=
  heightPoly (a : ℝ) (b : ℝ) (m : ℝ) (q : ℝ) (d₀ : ℝ) (e₀ : ℝ)
def lineBox (D E : ℝ) (a b m d₀ e₀ : ℤ) (z : ℝ) : Prop :=
  (D/2 < lineD m d₀ b z ∧ lineD m d₀ b z ≤ D) ∧
  (E/2 < lineE m e₀ a z ∧ lineE m e₀ a z ≤ E)

theorem integer_abs_ge_one_pure (z : ℤ) (hz : z ≠ 0) : 1 ≤ |(z : ℝ)| := by
  have hh : (1 : ℤ) ≤ |z| := by
    rcases le_total 0 z with hp | hn
    · rw [abs_of_nonneg hp]; omega
    · rw [abs_of_nonpos hn]; omega
  exact_mod_cast hh

theorem line_level (a b m d₀ e₀ : ℤ) (hbez : a*d₀+b*e₀=1) (z : ℝ) :
    (a : ℝ)*lineD m d₀ b z+(b : ℝ)*lineE m e₀ a z=(m : ℝ) := by
  have hh : (a : ℝ)*(d₀ : ℝ)+(b : ℝ)*(e₀ : ℝ)=1 := by exact_mod_cast hbez
  dsimp [lineD,lineE]
  linear_combination (m : ℝ)*hh

theorem line_normal (a b m q d₀ e₀ : ℤ) (hm : m ≠ 0) (z : ℝ) :
    (q : ℝ)*(lineD m d₀ b z*lineE m e₀ a z)^3 =
      H3 ((a : ℝ)*lineD m d₀ b z) ((b : ℝ)*lineE m e₀ a z)+
        (m : ℝ)^5*(lineHeight a b m q d₀ e₀).eval z := by
  have hmR : (m : ℝ) ≠ 0 := by exact_mod_cast hm
  rw [lineHeight,heightPoly_eval]
  dsimp [lineD,lineE]
  field_simp [hmR]
  <;> ring

theorem box_product_pure (D E d e : ℝ) (hD : 0 < D) (hE : 0 < E)
    (hd : D/2 < d ∧ d ≤ D) (he : E/2 < e ∧ e ≤ E) :
    D*E/4 < d*e ∧ d*e ≤ D*E := by
  have hdp : 0 < d := by linarith
  have hep : 0 < e := by linarith
  constructor
  · nlinarith [mul_pos (sub_pos.mpr hd.1) (half_pos hE),
      mul_pos hdp (sub_pos.mpr he.1)]
  · exact (mul_le_mul_of_nonneg_right hd.2 hep.le).trans
      (mul_le_mul_of_nonneg_left he.2 hD.le)

theorem line_real_cancellation
    (a b m q d₀ e₀ : ℤ) (hm : m ≠ 0) (hq : q ≠ 0)
    (hbez : a*d₀+b*e₀=1) (D E x : ℝ) (hD : 0 < D) (hE : 0 < E)
    (hk : ((a*b : ℤ) : ℝ) < 0)
    (hsmall₁ : |(m : ℝ)| ^5*x < (D*E)^3/65536)
    (hsmall₂ : (m : ℝ)^2 < |((a*b : ℤ) : ℝ)| *(D*E)/65536)
    (z : ℝ) (hbox : lineBox D E a b m d₀ e₀ z)
    (hn0 : 0 ≤ (lineHeight a b m q d₀ e₀).eval z)
    (hnx : (lineHeight a b m q d₀ e₀).eval z ≤ x) :
    D*E ≤ (2^40 : ℝ)*|((a*b : ℤ) : ℝ)| ^5 ∧
    (D*E)^2*|((a*b : ℤ) : ℝ)| ^3/(16*|(m : ℝ)| ^5) ≤
      |(lineHeight a b m q d₀ e₀).derivative.eval z| := by
  have hW : 0 < D*E := mul_pos hD hE
  have hb := box_product_pure D E _ _ hD hE hbox.1 hbox.2
  have hmR : (m : ℝ) ≠ 0 := by exact_mod_cast hm
  have hAB : ((a : ℝ)*lineD m d₀ b z)*((b : ℝ)*lineE m e₀ a z) =
      ((a*b : ℤ) : ℝ)*(lineD m d₀ b z*lineE m e₀ a z) := by push_cast; ring
  have hh := cancellation_at_real_height
    ((a : ℝ)*lineD m d₀ b z) ((b : ℝ)*lineE m e₀ a z)
    (m : ℝ) (q : ℝ) ((a*b : ℤ) : ℝ)
    (lineD m d₀ b z*lineE m e₀ a z) (D*E) x
    ((lineHeight a b m q d₀ e₀).eval z)
    hW hb.1 hb.2 hk hmR hAB (line_level a b m d₀ e₀ hbez z)
    (integer_abs_ge_one_pure q hq) hn0 hnx
    (line_normal a b m q d₀ e₀ hm z) hsmall₁ hsmall₂
  refine ⟨hh.1,?_⟩
  rw [lineHeight,heightPoly_derivative]
  simpa only [lineD,lineE,Int.cast_mul] using hh.2

theorem coordinate_large_height
    (A B m q Pi W x n : ℝ)
    (hW : 0 < W) (hPi : W/4 < Pi) (hx : 1 ≤ x)
    (hn0 : 0 ≤ n) (hnx : n ≤ x) (hq : 1 ≤ |q|)
    (hlevel : A+B=m) (hzero : A=0 ∨ B=0)
    (hnormal : q*Pi^3=H3 A B+m^5*n) :
    W^3 ≤ 65536*|m| ^5*x := by
  have hPi0 : 0 < Pi := by linarith
  have hH : |H3 A B| ≤ |m| ^5 := by
    rcases hzero with hA | hB
    · simp [H3,hA]
    · have hA : A=m := by simpa [hB] using hlevel
      simp [H3,hB,hA,abs_pow]
  have hF : |m^5*n| ≤ |m| ^5*x := by
    rw [abs_mul,abs_pow,abs_of_nonneg hn0]
    exact mul_le_mul_of_nonneg_left hnx (by positivity)
  have hqPi : Pi^3 ≤ |q*Pi^3| := by
    rw [abs_mul,abs_of_pos (pow_pos hPi0 3)]
    nlinarith [mul_le_mul_of_nonneg_right hq (pow_nonneg hPi0.le 3)]
  have htri : Pi^3 ≤ |m| ^5+|m| ^5*x := by
    calc
      Pi^3 ≤ |q*Pi^3| := hqPi
      _ = |H3 A B+m^5*n| := by rw [hnormal]
      _ ≤ |H3 A B|+|m^5*n| := abs_add_le _ _
      _ ≤ _ := by linarith
  have hPi3 : W^3 < 64*Pi^3 := by
    have hh : (W/4)^3 < Pi^3 := by gcongr
    nlinarith only [hh]
  have hmu : |m| ^5 ≤ |m| ^5*x :=
    (by simpa using mul_le_mul_of_nonneg_left hx (show 0 ≤ |m| ^5 by positivity))
  nlinarith only [htri,hPi3,hmu,show 0 ≤ |m|^5*x by positivity]

end A6P3Analysis

end
end

section
open Classical
noncomputable section
namespace A6P3Analysis
set_option maxHeartbeats 1600000
set_option linter.all false
def price (x M W : ℝ) : ℝ :=
  x^((1 : ℝ)/3)/(M^((2 : ℝ)/3)*W^((1 : ℝ)/5))

theorem root_pow (x : ℝ) (hx : 0 < x) (n : ℕ) (hn : n ≠ 0) :
    (x^((1 : ℝ)/(n : ℝ)))^n = x := by
  rw [←Real.rpow_natCast,←Real.rpow_mul hx.le]
  have hnR : (n : ℝ) ≠ 0 := by exact_mod_cast hn
  rw [div_mul_cancel₀ _ hnR,Real.rpow_one]

theorem price_scale (x M W : ℝ) (hx : 0 < x) (hM : 0 < M) (hW : 0 < W) :
    price x M W^15*M^10*W^3=x^5 := by
  have hx15 : (x^((1 : ℝ)/3))^15=x^5 := by
    rw [←Real.rpow_natCast,←Real.rpow_mul hx.le]
    norm_num
  have hm15 : (M^((2 : ℝ)/3))^15=M^10 := by
    rw [←Real.rpow_natCast,←Real.rpow_mul hM.le]
    norm_num
  have hw15 : (W^((1 : ℝ)/5))^15=W^3 := by
    rw [←Real.rpow_natCast,←Real.rpow_mul hW.le]
    norm_num
  dsimp [price]
  rw [div_pow,mul_pow,hx15,hm15,hw15]
  field_simp
  <;> ring

theorem cubic_scale (x M k : ℝ) (hx : 0 < x) (hM : 0 < M) (hk : 0 < k) :
    (x^((1 : ℝ)/3)/(M^((2 : ℝ)/3)*k))^3*(M^2*k^3)=x := by
  have hx3 : (x^((1 : ℝ)/3))^3=x := by simpa using root_pow x hx 3 (by decide)
  have hm3 : (M^((2 : ℝ)/3))^3=M^2 := by
    rw [←Real.rpow_natCast,←Real.rpow_mul hM.le]
    norm_num
  rw [div_pow,mul_pow,hx3,hm3]
  field_simp
  <;> ring

theorem fifth_root_coefficient (W k : ℝ) (hW : 0 < W) (hk : 0 < k)
    (hforce : W ≤ (2^40 : ℝ)*k^5) :
    W^((1 : ℝ)/5) ≤ 256*k := by
  apply le_of_pow_le_pow_left₀ (by decide : (5 : ℕ) ≠ 0) (by positivity)
  have hroot : (W^((1 : ℝ)/5))^5=W := by simpa using root_pow W hW 5 (by decide)
  rw [hroot]
  norm_num
  nlinarith only [hforce]

theorem min_cube (A B : ℝ) (hA : 0 ≤ A) (hB : 0 ≤ B) :
    min A B^3 ≤ A^2*B := by
  by_cases hh : A ≤ B
  · rw [min_eq_left hh]
    nlinarith [mul_nonneg (sq_nonneg A) (sub_nonneg.mpr hh)]
  · rw [min_eq_right (le_of_not_ge hh)]
    have hsq : B^2 ≤ A^2 := by nlinarith
    nlinarith [mul_nonneg hB (sub_nonneg.mpr hsq)]

theorem cancellation_scalar
    (C x M W mu g k : ℝ)
    (hC : 0 < C) (hx : 0 < x) (hM : 0 < M) (hW : 0 < W)
    (hmu : 0 < mu) (hg : 0 < g) (hgmu : g ≤ mu) (hk : 0 < k)
    (hforce : W ≤ (2^40 : ℝ)*k^5) :
    min (2*C*W*g^4/(M*mu^6)) (16*x*g^4/(W^2*k^3)) ≤
      2048*(C+1)*price x M W := by
  let A := 2*C*W*g^4/(M*mu^6)
  let B := 16*x*g^4/(W^2*k^3)
  let Y := x^((1 : ℝ)/3)/(M^((2 : ℝ)/3)*k)
  have hA : 0 ≤ A := by dsimp [A]; positivity
  have hB : 0 ≤ B := by dsimp [B]; positivity
  have hY : 0 ≤ Y := by dsimp [Y]; positivity
  have hscale : Y^3*(M^2*k^3)=x := cubic_scale x M k hx hM hk
  have hg12 : g^12 ≤ mu^12 := by gcongr
  have hproduct : A^2*B ≤ 64*C^2*Y^3 := by
    suffices hh : A^2*B*(M^2*k^3) ≤ 64*C^2*Y^3*(M^2*k^3) from
      le_of_mul_le_mul_right hh (by positivity)
    calc
      A^2*B*(M^2*k^3)=64*C^2*x*(g^12/mu^12) := by
        dsimp [A,B]
        field_simp
        <;> ring
      _ ≤ 64*C^2*x*1 := by
        apply mul_le_mul_of_nonneg_left _ (by positivity)
        exact (div_le_one (by positivity : 0 < mu^12)).mpr hg12
      _ = 64*C^2*Y^3*(M^2*k^3) := by rw [←hscale]; ring
  have hc : 64*C^2 ≤ (8*(C+1))^3 := by
    nlinarith [pow_nonneg hC.le 3,sq_nonneg C]
  have hmin : min A B ≤ 8*(C+1)*Y := by
    apply le_of_pow_le_pow_left₀ (by decide : (3 : ℕ) ≠ 0) (by positivity)
    have hh := min_cube A B hA hB
    have hm := mul_le_mul_of_nonneg_right hc (pow_nonneg hY 3)
    nlinarith only [hh,hproduct,hm]
  have hroot := fifth_root_coefficient W k hW hk hforce
  have hYZ : Y ≤ 256*price x M W := by
    have hz : 0 ≤ price x M W := by dsimp [price]; positivity
    calc
      Y = price x M W*(W^((1 : ℝ)/5)/k) := by
        dsimp [Y,price]
        field_simp
      _ ≤ price x M W*256 := by
        apply mul_le_mul_of_nonneg_left _ hz
        exact (div_le_iff₀ hk).mpr (by nlinarith only [hroot])
      _ = _ := by ring
  calc
    min A B ≤ 8*(C+1)*Y := hmin
    _ ≤ 8*(C+1)*(256*price x M W) :=
      mul_le_mul_of_nonneg_left hYZ (by positivity)
    _ = _ := by ring
theorem large_height_scalar
    (cM x M W mu : ℝ)
    (hcM : 0 < cM) (hcM1 : cM ≤ 1) (hx : 0 < x)
    (hM : 0 < M) (hW : 0 < W) (hmu : 0 < mu)
    (hfloor : cM*x^((1 : ℝ)/5) ≤ M)
    (hlarge : W^3 ≤ 65536*mu^5*x) :
    W/(M*mu^2) ≤ (1024/cM)*price x M W := by
  let T := W/(M*mu^2)
  let Z := price x M W
  let K := 1024/cM
  have hT : 0 ≤ T := by dsimp [T]; positivity
  have hZ : 0 ≤ Z := by dsimp [Z,price]; positivity
  have hscale : Z^15*M^10*W^3=x^5 := price_scale x M W hx hM hW
  have hfloor5 : cM^5*x ≤ M^5 := by
    have hh := pow_le_pow_left₀ (by positivity : 0 ≤ cM*x^((1 : ℝ)/5)) hfloor 5
    have hx5 : (x^((1 : ℝ)/5))^5=x := by simpa using root_pow x hx 5 (by decide)
    rw [mul_pow,hx5] at hh
    exact hh
  have hlarge6 : W^18 ≤ (65536 : ℝ)^6*mu^30*x^6 := by
    have hh := pow_le_pow_left₀ (pow_nonneg hW.le 3) hlarge 6
    nlinarith only [hh]
  have hTeq : T^15*M^15*mu^30*W^3=W^18 := by
    dsimp [T]
    field_simp
    <;> ring
  have hTlarge : T^15*M^15*W^3 ≤ (2^96 : ℝ)*x^6 := by
    suffices hh : (T^15*M^15*W^3)*mu^30 ≤ ((2^96 : ℝ)*x^6)*mu^30 from
      le_of_mul_le_mul_right hh (pow_pos hmu 30)
    nlinarith only [hTeq,hlarge6]
  have hTfloor :
      T^15*M^10*W^3*cM^5*x ≤ T^15*M^15*W^3 := by
    have hh := mul_le_mul_of_nonneg_left hfloor5
      (show 0 ≤ T^15*M^10*W^3 by positivity)
    nlinarith only [hh]
  have hTpow : cM^5*T^15 ≤ (2^96 : ℝ)*Z^15 := by
    have hh : (cM^5*T^15)*(x*M^10*W^3) ≤
        ((2^96 : ℝ)*Z^15)*(x*M^10*W^3) := by
      calc
        (cM^5*T^15)*(x*M^10*W^3) =
            T^15*M^10*W^3*cM^5*x := by ring
        _ ≤ T^15*M^15*W^3 := hTfloor
        _ ≤ (2^96 : ℝ)*x^6 := hTlarge
        _ = ((2^96 : ℝ)*Z^15)*(x*M^10*W^3) := by
          linear_combination -(2^96 : ℝ)*x*hscale
    exact le_of_mul_le_mul_right hh (by positivity)
  have hc10 : cM^10 ≤ 1 := by
    calc
      cM^10 ≤ (1 : ℝ)^10 := by gcongr
      _ = 1 := by norm_num
  have hK : (2^96 : ℝ) ≤ cM^5*K^15 := by
    have he : cM^5*K^15=(1024 : ℝ)^15/cM^10 := by
      dsimp [K]
      field_simp
    rw [he]
    apply (le_div_iff₀ (pow_pos hcM 10)).mpr
    nlinarith only [hc10]
  have hh := mul_le_mul_of_nonneg_right hK (pow_nonneg hZ 15)
  have hpow : T^15 ≤ (K*Z)^15 := by
    have hh' : T^15*cM^5 ≤ (K*Z)^15*cM^5 := by nlinarith only [hTpow,hh]
    exact le_of_mul_le_mul_right hh' (pow_pos hcM 5)
  exact le_of_pow_le_pow_left₀ (by decide : (15 : ℕ) ≠ 0) (by positivity) hpow

theorem cell_coarse_scalar
    (C W M mu g : ℝ) (hC : 0 < C) (hW : 0 < W)
    (hM : 0 < M) (hmu : 0 < mu) (hg : 0 ≤ g) (hgmu : g ≤ mu) :
    2*C*W*g^4/(M*mu^6) ≤ 2*C*W/(M*mu^2) := by
  apply (div_le_div_iff₀ (by positivity : 0 < M*mu^6)
    (by positivity : 0 < M*mu^2)).mpr
  have hh := mul_le_mul_of_nonneg_left
    (show g^4 ≤ mu^4 by gcongr)
    (show 0 ≤ 2*C*W*M*mu^2 by positivity)
  nlinarith only [hh]

theorem bounded_affine_scalar
    (C cM W M mu k : ℝ)
    (hC : 0 < C) (hcM : 0 < cM) (hW : 0 < W) (hM : 0 < M)
    (hmu : 0 < mu) (hk : 1 ≤ k) (hfloor : cM ≤ M)
    (hlarge : k*W ≤ 65536*mu^2) :
    2*C*W/(M*mu^2) ≤ 131072*C/cM := by
  have hWmu : W ≤ 65536*mu^2 := by
    nlinarith [mul_nonneg (sub_nonneg.mpr hk) hW.le]
  apply (div_le_div_iff₀ (by positivity : 0 < M*mu^2) hcM).mpr
  have h₁ := mul_le_mul_of_nonneg_left hWmu (show 0 ≤ 2*C*cM by positivity)
  have h₂ := mul_nonneg (sub_nonneg.mpr hfloor)
    (show 0 ≤ 131072*C*mu^2 by positivity)
  nlinarith only [h₁,h₂]

end A6P3Analysis

end
end

section
noncomputable section
namespace A6CubicNormalForm
open MvPolynomial
set_option maxHeartbeats 1800000
set_option maxRecDepth 3000

def form (A:Fin 4→ℤ) : MvPolynomial (Fin 2) ℚ :=
 ∑ i:Fin 4, C (A i:ℚ)*X 0^(i:ℕ)*X 1^(3-(i:ℕ))
def ev (A:Fin 4→ℤ) (d e:ℤ) : ℤ :=
 ∑ i:Fin 4,A i*d^(i:ℕ)*e^(3-(i:ℕ))
def R3 (A B:ℤ) : ℤ := A^2+5*A*B+10*B^2
def L (a b:ℤ) : MvPolynomial (Fin 2) ℚ :=
 C (a:ℚ)*X 0+C (b:ℚ)*X 1
def K0 (P:Fin 4→ℤ) (a b c:ℤ) : ℤ := P 0+10*c*a^3*b^3

theorem ev_explicit (A:Fin 4→ℤ) (d e:ℤ) :
 ev A d e=A 0*e^3+A 1*d*e^2+A 2*d^2*e+A 3*d^3 := by
 simp [ev,Fin.sum_univ_succ] ; ring
theorem form_explicit (A:Fin 4→ℤ) :
 form A=C (A 0:ℚ)*X 1^3+C (A 1:ℚ)*X 0*X 1^2+
 C (A 2:ℚ)*X 0^2*X 1+C (A 3:ℚ)*X 0^3 := by
 simp [form,Fin.sum_univ_succ] ; ring
theorem form_eval (A:Fin 4→ℤ) (d e:ℤ) :
 eval ![(d:ℚ),(e:ℚ)] (form A)=(ev A d e:ℚ) := by
 simp [form,ev,Fin.sum_univ_succ]
theorem pure_eval (P Q:Fin 4→ℤ) (a b c:ℤ)
 (hpure:X 1^3*form Q-X 0^3*form P=C (c:ℚ)*(L a b)^6)
 (d e:ℤ) :
 e^3*ev Q d e-d^3*ev P d e=c*(a*d+b*e)^6 := by
 have hh:=congrArg (eval ![(d:ℚ),(e:ℚ)]) hpure
 simp only [eval_sub,eval_mul,eval_pow,eval_X,eval_C,L,eval_add,
  Matrix.cons_val_zero,Matrix.cons_val_one,form_eval] at hh
 exact_mod_cast hh

theorem seven_coefficients
 (p0 p1 p2 p3 q0 q1 q2 q3 a b c:ℤ)
 (h:∀t:ℤ,q0+q1*t+q2*t^2+q3*t^3-
 t^3*(p0+p1*t+p2*t^2+p3*t^3)=c*(a*t+b)^6) :
 q0=c*b^6 ∧ q1=6*c*a*b^5 ∧ q2=15*c*a^2*b^4 ∧
 q3-p0=20*c*a^3*b^3 ∧ p1= -15*c*a^4*b^2 ∧
 p2= -6*c*a^5*b ∧ p3= -c*a^6 := by
 have h0:=h 0
 have h1:=h 1
 have hm1:=h (-1)
 have h2:=h 2
 have hm2:=h (-2)
 have h3:=h 3
 have hm3:=h (-3)
 norm_num at h0 h1 hm1 h2 hm2 h3 hm3
 refine ⟨by nlinarith only [h0],?_,?_,?_,?_,?_,?_⟩
 · have hh:60*(q1-6*c*a*b^5)=0:=by
    linear_combination 45*h1-45*hm1-9*h2+9*hm2+h3-hm3
   nlinarith only [hh]
 · have hh:360*(q2-15*c*a^2*b^4)=0:=by
    linear_combination -490*h0+270*h1+270*hm1-27*h2-27*hm2+2*h3+2*hm3
   nlinarith only [hh]
 · have hh:48*(q3-p0-20*c*a^3*b^3)=0:=by
    linear_combination -13*h1+13*hm1+8*h2-8*hm2-h3+hm3
   nlinarith only [hh]
 · have hh:144*(p1+15*c*a^4*b^2)=0:=by
    linear_combination -56*h0+39*h1+39*hm1-12*h2-12*hm2+h3+hm3
   nlinarith only [hh]
 · have hh:240*(p2+6*c*a^5*b)=0:=by
    linear_combination -5*h1+5*hm1+4*h2-4*hm2-h3+hm3
   nlinarith only [hh]
 · have hh:720*(p3+c*a^6)=0:=by
    linear_combination 20*h0-15*h1-15*hm1+6*h2+6*hm2-h3-hm3
   nlinarith only [hh]

theorem coefficients (P Q:Fin 4→ℤ) (a b c:ℤ)
 (hpure:X 1^3*form Q-X 0^3*form P=C (c:ℚ)*(L a b)^6) :
 Q 0=c*b^6 ∧ Q 1=6*c*a*b^5 ∧ Q 2=15*c*a^2*b^4 ∧
 Q 3-P 0=20*c*a^3*b^3 ∧ P 1= -15*c*a^4*b^2 ∧
 P 2= -6*c*a^5*b ∧ P 3= -c*a^6 := by
 apply seven_coefficients
 intro t
 have hh:=pure_eval P Q a b c hpure t 1
 simpa [ev_explicit] using hh

theorem mean_identity (P Q:Fin 4→ℤ) (a b c:ℤ)
 (hpure:X 1^3*form Q-X 0^3*form P=C (c:ℚ)*(L a b)^6) :
 2*K0 P a b c=P 0+Q 3 := by
 have hh:=(coefficients P Q a b c hpure).2.2.2.1
 unfold K0
 linarith
theorem K0_mean_div (P Q:Fin 4→ℤ) (a b c:ℤ)
 (hpure:X 1^3*form Q-X 0^3*form P=C (c:ℚ)*(L a b)^6) :
 K0 P a b c=(P 0+Q 3)/2 := by
 rw [←mean_identity P Q a b c hpure]
 omega
theorem canonical_forms (P Q:Fin 4→ℤ) (a b c:ℤ)
 (hpure:X 1^3*form Q-X 0^3*form P=C (c:ℚ)*(L a b)^6) :
 form P=C (K0 P a b c:ℚ)*X 1^3-C (c:ℚ)*L a b*C (a^3:ℚ)*
  ((C (a:ℚ)*X 0)^2+5*(C (a:ℚ)*X 0)*(C (b:ℚ)*X 1)+10*(C (b:ℚ)*X 1)^2) ∧
 form Q=C (K0 P a b c:ℚ)*X 0^3+C (c:ℚ)*L a b*C (b^3:ℚ)*
  ((C (b:ℚ)*X 1)^2+5*(C (b:ℚ)*X 1)*(C (a:ℚ)*X 0)+10*(C (a:ℚ)*X 0)^2) := by
 obtain ⟨hq0,hq1,hq2,hqmid,hp1,hp2,hp3⟩:=coefficients P Q a b c hpure
 have hq3:Q 3=P 0+20*c*a^3*b^3:=by linarith
 constructor
 · rw [form_explicit,hp1,hp2,hp3]
   dsimp [K0,L]
   push_cast
   simp only [_root_.map_add,_root_.map_mul,_root_.map_pow,_root_.map_neg]
   norm_num
   simp only [_root_.map_ofNat]
   ring
 · rw [form_explicit,hq0,hq1,hq2,hq3]
   dsimp [K0,L]
   push_cast
   simp only [_root_.map_add,_root_.map_mul,_root_.map_pow]
   norm_num
   simp only [_root_.map_ofNat]
   ring
theorem canonical_evaluations (P Q:Fin 4→ℤ) (a b c:ℤ)
 (hpure:X 1^3*form Q-X 0^3*form P=C (c:ℚ)*(L a b)^6)
 (d e:ℤ) :
 ev P d e=K0 P a b c*e^3-c*(a*d+b*e)*a^3*R3 (a*d) (b*e) ∧
 ev Q d e=K0 P a b c*d^3+c*(a*d+b*e)*b^3*R3 (b*e) (a*d) := by
 obtain ⟨hq0,hq1,hq2,hqmid,hp1,hp2,hp3⟩:=coefficients P Q a b c hpure
 have hq3:Q 3=P 0+20*c*a^3*b^3:=by linarith
 constructor
 · rw [ev_explicit,hp1,hp2,hp3]
   dsimp [K0,R3]
   ring
 · rw [ev_explicit,hq0,hq1,hq2,hq3]
   dsimp [K0,R3]
   ring

theorem K0_nonzero (P Q:Fin 4→ℤ) (a b c:ℤ)
 (hcop:∀R:MvPolynomial (Fin 2) ℚ,R∣form P→R∣form Q→IsUnit R)
 (hpure:X 1^3*form Q-X 0^3*form P=C (c:ℚ)*(L a b)^6) :
 K0 P a b c≠0 := by
 intro hK
 obtain ⟨hP,hQ⟩:=canonical_forms P Q a b c hpure
 have hdP:L a b∣form P:=by
  refine ⟨-C (c:ℚ)*C (a^3:ℚ)*
   ((C (a:ℚ)*X 0)^2+5*(C (a:ℚ)*X 0)*(C (b:ℚ)*X 1)+10*(C (b:ℚ)*X 1)^2),?_⟩
  rw [hP,hK]
  simp only [Int.cast_zero,map_zero,zero_mul,zero_sub]
  ring
 have hdQ:L a b∣form Q:=by
  refine ⟨C (c:ℚ)*C (b^3:ℚ)*
   ((C (b:ℚ)*X 1)^2+5*(C (b:ℚ)*X 1)*(C (a:ℚ)*X 0)+10*(C (a:ℚ)*X 0)^2),?_⟩
  rw [hQ,hK]
  simp only [Int.cast_zero,map_zero,zero_mul,zero_add]
  ring
 have hu:=hcop (L a b) hdP hdQ
 have he:=hu.map (eval (fun _ : Fin 2 => (0:ℚ)))
 simp [L] at he

theorem K0_height (P Q:Fin 4→ℤ) (a b c:ℤ) (H:ℝ)
 (hpure:X 1^3*form Q-X 0^3*form P=C (c:ℚ)*(L a b)^6)
 (hP:∀i:Fin 4,|(P i:ℝ)|≤H) (hQ:∀i:Fin 4,|(Q i:ℝ)|≤H) :
 |(K0 P a b c:ℝ)|≤H := by
 have hm:(2:ℝ)*(K0 P a b c:ℝ)=(P 0:ℝ)+(Q 3:ℝ):=by
  exact_mod_cast mean_identity P Q a b c hpure
 have hh:=abs_add_le (P 0:ℝ) (Q 3:ℝ)
 rw [←hm,abs_mul] at hh
 norm_num at hh
 linarith [hP 0,hQ 3]

theorem original_multipliers (d e u v pval qval a b c:ℤ)
 (hF:e^3*v-d^3*u=1) (hparallel:u*qval=v*pval)
 (hpure:e^3*qval-d^3*pval=c*(a*d+b*e)^6) :
 pval=c*(a*d+b*e)^6*u ∧ qval=c*(a*d+b*e)^6*v := by
 have hF1:e^3*v=d^3*u+1:=by linarith
 constructor
 · linear_combination u*hpure-e^3*hparallel-pval*hF1
 · linear_combination v*hpure-d^3*hparallel-qval*hF1
theorem signed_level (d e u v pval qval a b c K:ℤ)
 (hc:c≠0) (hK:K≠0)
 (hF:e^3*v-d^3*u=1)
 (hparallel:u*qval=v*pval)
 (hpure:e^3*qval-d^3*pval=c*(a*d+b*e)^6)
 (hPn:pval=K*e^3-c*(a*d+b*e)*a^3*R3 (a*d) (b*e))
 (hQn:qval=K*d^3+c*(a*d+b*e)*b^3*R3 (b*e) (a*d)) :
 let m:ℤ:=a*d+b*e
 m≠0 ∧ ∃q:ℤ,q≠0 ∧ K=c*m*q ∧
 m^5*u=q*e^3-a^3*R3 (a*d) (b*e) ∧
 m^5*v=q*d^3+b^3*R3 (b*e) (a*d) := by
 intro m
 have hF1:e^3*v=d^3*u+1:=by linarith
 have hPs:pval=c*m^6*u:=by
  dsimp [m]
  linear_combination u*hpure-e^3*hparallel-pval*hF1
 have hQs:qval=c*m^6*v:=by
  dsimp [m]
  linear_combination v*hpure-d^3*hparallel-qval*hF1
 change pval=K*e^3-c*m*a^3*R3 (a*d) (b*e) at hPn
 change qval=K*d^3+c*m*b^3*R3 (b*e) (a*d) at hQn
 have hm:m≠0:=by
  intro hz
  have hpzero:pval=0:=by simpa [hz] using hPs
  have hqzero:qval=0:=by simpa [hz] using hQs
  have hezero:K*e^3=0:=by simpa [hz,hpzero] using hPn.symm
  have hdzero:K*d^3=0:=by simpa [hz,hqzero] using hQn.symm
  apply hK
  calc
   K=K*(e^3*v-d^3*u):=by rw [hF];ring
   _=(K*e^3)*v-(K*d^3)*u:=by ring
   _=0:=by rw [hezero,hdzero];ring
 have hdvd_e:c*m∣K*e^3:=by
  refine ⟨m^5*u+a^3*R3 (a*d) (b*e),?_⟩
  linear_combination hPs-hPn
 have hdvd_d:c*m∣K*d^3:=by
  refine ⟨m^5*v-b^3*R3 (b*e) (a*d),?_⟩
  linear_combination hQs-hQn
 have hdvd:c*m∣K:=by
  obtain ⟨A,hA⟩:=hdvd_d
  obtain ⟨B,hB⟩:=hdvd_e
  refine ⟨-u*A+v*B,?_⟩
  calc
   K=K*(e^3*v-d^3*u):=by rw [hF];ring
   _=(-u)*(K*d^3)+v*(K*e^3):=by ring
   _=c*m*(-u*A+v*B):=by rw [hA,hB];ring
 obtain ⟨q,hq⟩:=hdvd
 have hq0:q≠0:=by intro hz;apply hK;simpa [hz] using hq
 refine ⟨hm,q,hq0,hq,?_,?_⟩
 · apply mul_left_cancel₀ (mul_ne_zero hc hm)
   calc
    c*m*(m^5*u)=c*m^6*u:=by ring
    _=pval:=hPs.symm
    _=c*m*(q*e^3-a^3*R3 (a*d) (b*e)):=by rw [hPn,hq];ring
 · apply mul_left_cancel₀ (mul_ne_zero hc hm)
   calc
    c*m*(m^5*v)=c*m^6*v:=by ring
    _=qval:=hQs.symm
    _=c*m*(q*d^3+b^3*R3 (b*e) (a*d)):=by rw [hQn,hq];ring

theorem normal_form_and_signed_levels (P Q:Fin 4→ℤ) (a b c:ℤ)
 (hcop:∀R:MvPolynomial (Fin 2) ℚ,R∣form P→R∣form Q→IsUnit R)
 (hc:c≠0)
 (hpure:X 1^3*form Q-X 0^3*form P=C (c:ℚ)*(L a b)^6) :
 ∃K:ℤ,K≠0 ∧ K=K0 P a b c ∧ 2*K=P 0+Q 3 ∧
 (∀H:ℝ,(∀i:Fin 4,|(P i:ℝ)|≤H) →
   (∀i:Fin 4,|(Q i:ℝ)|≤H) → |(K:ℝ)|≤H) ∧
 ∀d e u v:ℤ,e^3*v-d^3*u=1 → u*ev Q d e=v*ev P d e →
 let m:ℤ:=a*d+b*e
 m≠0 ∧ ∃q:ℤ,q≠0 ∧ K=c*m*q ∧
 m^5*u=q*e^3-a^3*R3 (a*d) (b*e) ∧
 m^5*v=q*d^3+b^3*R3 (b*e) (a*d) := by
 have hK:=K0_nonzero P Q a b c hcop hpure
 refine ⟨K0 P a b c,hK,rfl,mean_identity P Q a b c hpure,?_,?_⟩
 · intro H hP hQ
   exact K0_height P Q a b c H hpure hP hQ
 · intro d e u v hF hparallel
   obtain ⟨hPn,hQn⟩:=canonical_evaluations P Q a b c hpure d e
   exact signed_level d e u v (ev P d e) (ev Q d e) a b c (K0 P a b c)
    hc hK hF hparallel (pure_eval P Q a b c hpure d e) hPn hQn

theorem fixed_level_q (c m K q:ℤ) (hc:c≠0) (hm:m≠0)
 (hq:K=c*m*q) : K/(c*m)=q := by
 have hdvd:c*m∣K:=⟨q,hq⟩
 have hdiv:K/(c*m)*(c*m)=K:=Int.ediv_mul_cancel hdvd
 apply mul_right_cancel₀ (mul_ne_zero hc hm)
 calc
  K/(c*m)*(c*m)=K:=hdiv
  _=c*m*q:=hq
  _=q*(c*m):=by ring
end A6CubicNormalForm

end
end

section

noncomputable section
namespace A6PureSepticQuarticProgressions
open Polynomial
private theorem mod_zero_iff (p : ℕ) (F : Polynomial ℤ) :
    Polynomial.map (Int.castRingHom (ZMod p)) F = 0 ↔
      Polynomial.C (p : ℤ) ∣ F := by
  rw [Polynomial.ext_iff, Polynomial.C_dvd_iff_dvd_coeff]
  simp [ZMod.intCast_zmod_eq_zero_iff_dvd]
private theorem extract_content (p : ℕ) (k : ℕ) (F : Polynomial ℤ) :
    C ((p : ℤ) ^ k) ∣ F ∨
    ∃ v < k, ∃ H : Polynomial ℤ,
      F = C ((p : ℤ) ^ v) * H ∧
      Polynomial.map (Int.castRingHom (ZMod p)) H ≠ 0 := by
  induction k generalizing F with
  | zero => left; simp
  | succ k ih =>
    by_cases h : C (p : ℤ) ∣ F
    · obtain ⟨G, hG⟩ := h
      rcases ih G with hD | ⟨v, hv, H, hH, hn⟩
      · left
        obtain ⟨A, hA⟩ := hD
        refine ⟨A, ?_⟩
        rw [hG, hA, pow_succ', Polynomial.C_mul, mul_assoc]
      · right
        refine ⟨v + 1, by omega, H, ?_, hn⟩
        rw [hG, hH, pow_succ', Polynomial.C_mul, mul_assoc]
    · right
      refine ⟨0, by omega, F, by simp, ?_⟩
      intro hz
      exact h ((mod_zero_iff p F).mp hz)
private theorem coeff_scale (F : Polynomial ℤ) (c : ℤ) (j : ℕ) :
    (F.comp (C c * X)).coeff j = c ^ j * F.coeff j := by
  induction F using Polynomial.induction_on' with
  | add F G hF hG =>
    simp only [Polynomial.add_comp, Polynomial.coeff_add, hF, hG]
    ring
  | monomial n a =>
    simp only [← Polynomial.C_mul_X_pow_eq_monomial, Polynomial.mul_comp,
      Polynomial.C_comp, Polynomial.pow_comp, Polynomial.X_comp]
    simp only [mul_pow, ← Polynomial.C_pow, 
      Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
    split_ifs <;> simp_all ; ring
private theorem coeff_affine (F : Polynomial ℤ) (r p : ℤ) (j : ℕ) :
    (F.comp (C r + C p * X)).coeff j =
      p ^ j * ((taylor r) F).coeff j := by
  have h : C r + C p * X = (X + C r).comp (C p * X) := by
    simp
    ring
  rw [h, ← Polynomial.comp_assoc, ← Polynomial.taylor_apply]
  exact coeff_scale ((taylor r) F) p j
private theorem power_cancel (p : ℤ) (hp : p ≠ 0) (v : ℕ) (b : ℤ) :
    p ^ (v + 1) ∣ p ^ v * b ↔ p ∣ b := by
  constructor
  · rintro ⟨c, hc⟩
    refine ⟨c, ?_⟩
    apply mul_left_cancel₀ (pow_ne_zero v hp)
    calc
      p ^ v * b = p ^ (v + 1) * c := hc
      _ = p ^ v * (p * c) := by rw [pow_succ]; ring
  · rintro ⟨c, rfl⟩
    refine ⟨c, ?_⟩
    rw [pow_succ]
    ring
private theorem root_taylor_unit (p : ℕ) [Fact p.Prime]
    (F : Polynomial ℤ) (r : ℤ)
    (hF : Polynomial.map (Int.castRingHom (ZMod p)) F ≠ 0) :
    ¬ (p : ℤ) ∣ ((taylor r) F).coeff
      (rootMultiplicity (r : ZMod p)
        (Polynomial.map (Int.castRingHom (ZMod p)) F)) := by
  let B := Polynomial.map (Int.castRingHom (ZMod p)) F
  let m := rootMultiplicity (r : ZMod p) B
  have ht : (taylor (r : ZMod p)) B ≠ 0 := by
    intro hz
    exact hF ((Polynomial.taylor_eq_zero (r : ZMod p) B).mp hz)
  have hc := (Polynomial.coeff_natTrailingDegree_ne_zero).mpr ht
  have hm : m = ((taylor (r : ZMod p)) B).natTrailingDegree := by
    dsimp [m]
    rw [Polynomial.taylor_apply, Polynomial.rootMultiplicity_eq_natTrailingDegree]
  rw [← hm] at hc
  have hc' : (Polynomial.map (Int.castRingHom (ZMod p)) ((taylor r) F)).coeff m ≠ 0 := by
    rw [Polynomial.map_taylor]
    exact hc
  rw [Polynomial.coeff_map] at hc'
  exact fun h => hc' ((ZMod.intCast_zmod_eq_zero_iff_dvd _ p).mpr h)
private theorem root_degree_reduction (p : ℕ) [Fact p.Prime]
    (F H : Polynomial ℤ) (r : ℤ) (v : ℕ)
    (hF : Polynomial.map (Int.castRingHom (ZMod p)) F ≠ 0)
    (hroot : (Polynomial.map (Int.castRingHom (ZMod p)) F).IsRoot (r : ZMod p))
    (hH : Polynomial.map (Int.castRingHom (ZMod p)) H ≠ 0)
    (heq : F.comp (C r + C (p : ℤ) * X) = C ((p : ℤ) ^ v) * H) :
    1 ≤ v ∧
    v ≤ rootMultiplicity (r : ZMod p)
      (Polynomial.map (Int.castRingHom (ZMod p)) F) ∧
    (Polynomial.map (Int.castRingHom (ZMod p)) H).natDegree ≤
      rootMultiplicity (r : ZMod p)
        (Polynomial.map (Int.castRingHom (ZMod p)) F) := by
  let B := Polynomial.map (Int.castRingHom (ZMod p)) F
  let m := rootMultiplicity (r : ZMod p) B
  have hp : (p : ℤ) ≠ 0 := by
    exact_mod_cast (Fact.out : p.Prime).ne_zero
  have hc (j : ℕ) :
      (p : ℤ) ^ v * H.coeff j =
        (p : ℤ) ^ j * ((taylor r) F).coeff j := by
    calc
      (p : ℤ) ^ v * H.coeff j =
          (F.comp (C r + C (p : ℤ) * X)).coeff j := by
        rw [heq, Polynomial.coeff_C_mul]
      _ = (p : ℤ) ^ j * ((taylor r) F).coeff j := coeff_affine F r p j
  have hm : v ≤ m := by
    by_contra hn
    have hvm : m + 1 ≤ v := by omega
    have hd : (p : ℤ) ^ (m + 1) ∣ (p : ℤ) ^ v * H.coeff m :=
      dvd_mul_of_dvd_left (pow_dvd_pow (p : ℤ) hvm) _
    rw [hc m] at hd
    exact root_taylor_unit p F r hF ((power_cancel (p : ℤ) hp m _).mp hd)
  have hdeg : (Polynomial.map (Int.castRingHom (ZMod p)) H).natDegree ≤ m := by
    apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
    intro j hj
    rw [Polynomial.coeff_map]
    apply (ZMod.intCast_zmod_eq_zero_iff_dvd _ p).mpr
    apply (power_cancel (p : ℤ) hp v _).mp
    rw [hc j]
    exact dvd_mul_of_dvd_left (pow_dvd_pow (p : ℤ) (by omega)) _
  have hz : Polynomial.map (Int.castRingHom (ZMod p))
      (F.comp (C r + C (p : ℤ) * X)) = 0 := by
    rw [Polynomial.map_comp]
    have hp0 : (Int.castRingHom (ZMod p)) (p : ℤ) = 0 := by simp
    simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C,
      Polynomial.map_X, hp0, Polynomial.C_0, zero_mul, add_zero,
      Polynomial.comp_C]
    change C (B.eval (r : ZMod p)) = 0
    rw [hroot]
    simp
  have hv : 1 ≤ v := by
    by_contra hv
    have hv0 : v = 0 := by omega
    have he : F.comp (C r + C (p : ℤ) * X) = H := by simpa [hv0] using heq
    apply hH
    rw [← he]
    exact hz
  exact ⟨hv, hm, hdeg⟩
private theorem root_multiplicity_budget (p : ℕ) [Fact p.Prime]
    (B : Polynomial (ZMod p)) :
    ∑ r ∈ B.roots.toFinset, rootMultiplicity r B ≤ B.natDegree := by
  calc
    ∑ r ∈ B.roots.toFinset, rootMultiplicity r B =
        ∑ r ∈ B.roots.toFinset, Multiset.count r B.roots := by
      simp only [Polynomial.count_roots]
    _ = B.roots.card := Multiset.toFinset_sum_count_eq B.roots
    _ ≤ B.natDegree := Polynomial.card_roots' B
private theorem eval_reduce (p : ℕ) (F : Polynomial ℤ) (r : ℤ) :
    (Polynomial.map (Int.castRingHom (ZMod p)) F).eval (r : ZMod p) =
      ((F.eval r : ℤ) : ZMod p) := by
  have h := Polynomial.eval₂_at_apply (p := F) (Int.castRingHom (ZMod p)) r
  rw [← Polynomial.eval_map] at h
  simp
private theorem compose_affine (r J s K : ℤ) :
    (C r + C J * X).comp (C s + C K * X) =
      C (r + J * s) + C (J * K) * X := by
  simp only [Polynomial.add_comp, Polynomial.mul_comp,
    Polynomial.C_comp, Polynomial.X_comp, Polynomial.C_add, Polynomial.C_mul]
  ring
private theorem constant_div_comp (n : ℤ) (F A : Polynomial ℤ)
    (h : C n ∣ F) : C n ∣ F.comp A := by
  obtain ⟨G, hG⟩ := h
  refine ⟨G.comp A, ?_⟩
  rw [hG, Polynomial.mul_comp, Polynomial.C_comp]
private theorem cancel_pow_div {R : Type*} [CommRing R] [IsDomain R]
    (p : R) (hp : p ≠ 0) (v k : ℕ) (hv : v ≤ k) (b : R) :
    p ^ k ∣ p ^ v * b ↔ p ^ (k - v) ∣ b := by
  have hk : v + (k - v) = k := Nat.add_sub_of_le hv
  have hpow : p ^ k = p ^ v * p ^ (k - v) := by rw [← pow_add, hk]
  constructor
  · rintro ⟨c, hc⟩
    refine ⟨c, ?_⟩
    apply mul_left_cancel₀ (pow_ne_zero v hp)
    calc
      p ^ v * b = p ^ k * c := hc
      _ = p ^ v * (p ^ (k - v) * c) := by rw [hpow, mul_assoc]
  · rintro ⟨c, rfl⟩
    refine ⟨c, ?_⟩
    rw [← mul_assoc, ← pow_add, hk]
private def classAffine (p : ℕ) (s : ℤ × ℕ) : Polynomial ℤ :=
  C s.1 + C ((p : ℤ) ^ s.2) * X
private def liftClass (p : ℕ) (r : ℤ) (s : ℤ × ℕ) : ℤ × ℕ :=
  (r + (p : ℤ) * s.1, s.2 + 1)
private theorem lift_comp (p : ℕ) (r : ℤ) (s : ℤ × ℕ) :
    (C r + C (p : ℤ) * X).comp (classAffine p s) =
      classAffine p (liftClass p r s) := by
  rw [classAffine, compose_affine]
  simp only [classAffine, liftClass,   pow_succ']
private theorem lift_certificate (p k v : ℕ) (hv : v ≤ k)
    (F H : Polynomial ℤ) (r : ℤ) (s : ℤ × ℕ)
    (heq : F.comp (C r + C (p : ℤ) * X) = C ((p : ℤ) ^ v) * H)
    (h : C ((p : ℤ) ^ (k - v)) ∣ H.comp (classAffine p s)) :
    C ((p : ℤ) ^ k) ∣ F.comp (classAffine p (liftClass p r s)) := by
  obtain ⟨A, hA⟩ := h
  refine ⟨A, ?_⟩
  rw [← lift_comp, ← Polynomial.comp_assoc, heq, Polynomial.mul_comp,
    Polynomial.C_comp, hA, ← mul_assoc, ← Polynomial.C_mul,
    ← pow_add, Nat.add_sub_of_le hv]
set_option maxHeartbeats 1200000
set_option maxRecDepth 2000
private theorem primitive_cover (p : ℕ) [Fact p.Prime] :
    ∀ k : ℕ, 0 < k → ∀ F : Polynomial ℤ,
      Polynomial.map (Int.castRingHom (ZMod p)) F ≠ 0 →
      ∃ S : Finset (ℤ × ℕ),
        S.card ≤ (Polynomial.map (Int.castRingHom (ZMod p)) F).natDegree ∧
        (∀ s ∈ S, s.2 ≤ k ∧
          C ((p : ℤ) ^ k) ∣ F.comp (classAffine p s)) ∧
        (∀ r : ℤ, (p : ℤ) ^ k ∣ F.eval r →
          ∃ s ∈ S, ∃ t : ℤ, r = s.1 + (p : ℤ) ^ s.2 * t) := by
  classical
  intro k
  induction k using Nat.strong_induction_on with
  | h k ih =>
    intro hk F hF
    let B := Polynomial.map (Int.castRingHom (ZMod p)) F
    let roots := B.roots.toFinset
    have hp : (p : ℤ) ≠ 0 := by
      exact_mod_cast (Fact.out : p.Prime).ne_zero
    have branch (a : {a : ZMod p // a ∈ roots}) :
        ∃ S : Finset (ℤ × ℕ),
          S.card ≤ rootMultiplicity a.1 B ∧
          (∀ s ∈ S, s.2 ≤ k ∧ C ((p : ℤ) ^ k) ∣ F.comp (classAffine p s)) ∧
          (∀ r : ℤ, (r : ZMod p) = a.1 → (p : ℤ) ^ k ∣ F.eval r →
            ∃ s ∈ S, ∃ t : ℤ, r = s.1 + (p : ℤ) ^ s.2 * t) := by
      let r0 : ℤ := a.1.val
      have har : (r0 : ZMod p) = a.1 := by
        simp [r0]
      have hamem : a.1 ∈ B.roots := Multiset.mem_toFinset.mp a.2
      have ha : B.IsRoot a.1 := (Polynomial.mem_roots hF).mp hamem
      have hm : 0 < rootMultiplicity a.1 B := (Polynomial.rootMultiplicity_pos hF).mpr ha
      have residue (r : ℤ) (hr : (r : ZMod p) = a.1) :
          ∃ z : ℤ, r = r0 + (p : ℤ) * z := by
        have hd : (p : ℤ) ∣ r - r0 := by
          apply (ZMod.intCast_zmod_eq_zero_iff_dvd _ p).mp
          push_cast
          rw [hr, har, sub_self]
        obtain ⟨z, hz⟩ := hd
        exact ⟨z, by linarith⟩
      rcases extract_content p k (F.comp (C r0 + C (p : ℤ) * X)) with
        hD | ⟨v, hv, H, heq, hH⟩
      · refine ⟨{(r0, 1)}, ?_, ?_, ?_⟩
        · simp only [Finset.card_singleton]
          omega
        · intro s hs
          have hs' : s = (r0, 1) := Finset.mem_singleton.mp hs
          subst s
          refine ⟨hk, ?_⟩
          simpa only [classAffine, Prod.fst, Prod.snd, pow_one] using hD
        · intro r hr hd
          obtain ⟨z, hz⟩ := residue r hr
          exact ⟨(r0, 1), Finset.mem_singleton_self _, z, by simpa only [pow_one] using hz⟩
      · have hred := root_degree_reduction p F H r0 v hF
          (by simpa only [har] using ha) hH heq
        obtain ⟨S, hSc, hSg, hSv⟩ := ih (k - v) (by omega) (by omega) H hH
        refine ⟨S.image (liftClass p r0), ?_, ?_, ?_⟩
        · exact (Finset.card_image_le).trans (hSc.trans (by simpa only [har] using hred.2.2))
        · intro s hs
          obtain ⟨b, hb, rfl⟩ := Finset.mem_image.mp hs
          obtain ⟨hbexp, hbdiv⟩ := hSg b hb
          refine ⟨by dsimp [liftClass]; omega, ?_⟩
          exact lift_certificate p k v (by omega) F H r0 b heq hbdiv
        · intro r hr hd
          obtain ⟨z, hz⟩ := residue r hr
          have heval := congrArg (fun Q : Polynomial ℤ => Q.eval z) heq
          simp only [Polynomial.eval_comp, Polynomial.eval_add, Polynomial.eval_C,
            Polynomial.eval_mul, Polynomial.eval_X] at heval
          rw [← hz] at heval
          have hdH : (p : ℤ) ^ (k - v) ∣ H.eval z := by
            apply (cancel_pow_div (p : ℤ) hp v k (by omega) (H.eval z)).mp
            rw [← heval]
            exact hd
          obtain ⟨b, hb, t, ht⟩ := hSv z hdH
          refine ⟨liftClass p r0 b, Finset.mem_image.mpr ⟨b, hb, rfl⟩, t, ?_⟩
          dsimp [liftClass]
          rw [hz, ht, pow_succ']
          ring
    choose R hRc hRg hRv using branch
    let S := roots.attach.biUnion R
    refine ⟨S, ?_, ?_, ?_⟩
    · calc
        S.card ≤ ∑ a ∈ roots.attach, (R a).card := Finset.card_biUnion_le
        _ ≤ ∑ a ∈ roots.attach, rootMultiplicity a.1 B :=
          Finset.sum_le_sum (fun a _ => hRc a)
        _ = ∑ a ∈ roots, rootMultiplicity a B := Finset.sum_attach roots (fun a : ZMod p => rootMultiplicity a B)
        _ ≤ B.natDegree := root_multiplicity_budget p B
    · intro s hs
      obtain ⟨a, ha, hs⟩ := Finset.mem_biUnion.mp hs
      exact hRg a s hs
    · intro r hd
      have hpd : (p : ℤ) ∣ (p : ℤ) ^ k := by
        have hpow := pow_dvd_pow (p : ℤ) (show 1 ≤ k by omega)
        simpa only [pow_one] using hpow
      have hpr : (p : ℤ) ∣ F.eval r := hpd.trans hd
      have hroot : B.IsRoot (r : ZMod p) := by
        change (Polynomial.map (Int.castRingHom (ZMod p)) F).eval (r : ZMod p) = 0
        rw [eval_reduce]
        exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ p).mpr hpr
      have ha : (r : ZMod p) ∈ roots :=
        Multiset.mem_toFinset.mpr ((Polynomial.mem_roots hF).mpr hroot)
      let a : {a : ZMod p // a ∈ roots} := ⟨r, ha⟩
      obtain ⟨s, hs, t, ht⟩ := hRv a r rfl hd
      exact ⟨s, Finset.mem_biUnion.mpr ⟨a, Finset.mem_attach _ _, hs⟩, t, ht⟩

private theorem certified_primitive_depth
    (p n d γ : ℕ) [Fact p.Prime] (F : Polynomial ℤ) (s : ℤ × ℕ)
    (hd : F.natDegree ≤ d)
    (hF : Polynomial.map (Int.castRingHom (ZMod p)) F ≠ 0)
    (hn : d * (γ - 1) < n)
    (hcert : C ((p : ℤ) ^ n) ∣ F.comp (classAffine p s)) :
    γ ≤ s.2 := by
  by_contra hlt
  have hs : s.2 ≤ γ - 1 := by omega
  let j := rootMultiplicity (s.1 : ZMod p)
    (Polynomial.map (Int.castRingHom (ZMod p)) F)
  have hj : j ≤ d := by
    calc
      j = Multiset.count (s.1 : ZMod p)
          (Polynomial.map (Int.castRingHom (ZMod p)) F).roots := by
        simp only [j, Polynomial.count_roots]
      _ ≤ (Polynomial.map (Int.castRingHom (ZMod p)) F).roots.card :=
        Multiset.count_le_card _ _
      _ ≤ (Polynomial.map (Int.castRingHom (ZMod p)) F).natDegree :=
        Polynomial.card_roots' _
      _ ≤ d := Polynomial.natDegree_map_le.trans hd
  have hbound : s.2 * j < n := by
    calc
      s.2 * j ≤ (γ - 1) * d := Nat.mul_le_mul hs hj
      _ < n := by simpa only [Nat.mul_comm] using hn
  have hcoeff : (p : ℤ) ^ n ∣ (F.comp (classAffine p s)).coeff j :=
    ((Polynomial.C_dvd_iff_dvd_coeff _ _).mp hcert) j
  change (p : ℤ) ^ n ∣
    (F.comp (C s.1 + C ((p : ℤ) ^ s.2) * X)).coeff j at hcoeff
  rw [coeff_affine, ← pow_mul] at hcoeff
  have hpow : (p : ℤ) ^ (s.2 * j + 1) ∣
      (p : ℤ) ^ n := pow_dvd_pow _ (by omega)
  have hp0 : (p : ℤ) ≠ 0 := by exact_mod_cast (Fact.out : p.Prime).ne_zero
  exact root_taylor_unit p F s.1 hF
    ((power_cancel (p : ℤ) hp0 (s.2 * j) _).mp (hpow.trans hcoeff))

private theorem primitive_fixed_cover
    (p d γ n : ℕ) [Fact p.Prime] (F : Polynomial ℤ)
    (hd : F.natDegree ≤ d)
    (hF : Polynomial.map (Int.castRingHom (ZMod p)) F ≠ 0)
    (_hγ : 0 < γ) (hn : d * (γ - 1) < n) :
    ∃ T : Finset ℤ, T.card ≤ d ∧
      ∀ z : ℤ, (p : ℤ) ^ n ∣ F.eval z →
        ∃ a ∈ T, (p : ℤ) ^ γ ∣ z - a := by
  classical
  obtain ⟨S, hSc, hSg, hSv⟩ := primitive_cover p n (by omega) F hF
  have hmapdeg : (Polynomial.map (Int.castRingHom (ZMod p)) F).natDegree ≤ d :=
    Polynomial.natDegree_map_le.trans hd
  refine ⟨S.image Prod.fst, (Finset.card_image_le).trans (hSc.trans hmapdeg), ?_⟩
  intro z hz
  obtain ⟨s, hs, t, ht⟩ := hSv z hz
  refine ⟨s.1, Finset.mem_image.mpr ⟨s, hs, rfl⟩, ?_⟩
  rw [ht]
  simpa only [add_sub_cancel_left] using dvd_mul_of_dvd_left
    (pow_dvd_pow (p : ℤ)
      (certified_primitive_depth p n d γ F s hd hF hn (hSg s hs).2)) t

end A6PureSepticQuarticProgressions

namespace A6Local
open Polynomial
def R3 (A B : ℤ) : ℤ := A^2+5*A*B+10*B^2
def J3 (M B : ℤ) : ℤ := M^2+3*M*B+6*B^2
def D (m d0 b h : ℤ) : ℤ := m*d0+b*h
def E (m e0 a h : ℤ) : ℤ := m*e0-a*h
def NE (a b m q d0 e0 h : ℤ) : ℤ :=
 q*(E m e0 a h)^3-a^3*R3 (a*D m d0 b h) (b*E m e0 a h)
def ND (a b m q d0 e0 h : ℤ) : ℤ :=
 q*(D m d0 b h)^3+b^3*R3 (b*E m e0 a h) (a*D m d0 b h)
theorem half_identity (A B : ℤ) :
 A^3*R3 A B+B^3*R3 B A=(A+B)^5 := by unfold R3; ring
theorem translated_R (M B : ℤ) : R3 (M-B) B=J3 M B := by
 unfold R3 J3; ring
theorem level_identity (a b m d0 e0 h : ℤ) (hb:a*d0+b*e0=1) :
 a*D m d0 b h+b*E m e0 a h=m := by
 dsimp [D,E]; calc
  a*(m*d0+b*h)+b*(m*e0-a*h)=m*(a*d0+b*e0) := by ring
  _=m := by rw [hb]; ring
theorem numerator_syzygy (a b m q d0 e0 h : ℤ) (hb:a*d0+b*e0=1) :
 (E m e0 a h)^3*ND a b m q d0 e0 h-
 (D m d0 b h)^3*NE a b m q d0 e0 h=m^5 := by
 have hi:=half_identity (a*D m d0 b h) (b*E m e0 a h)
 rw [level_identity a b m d0 e0 h hb] at hi
 dsimp [ND,NE]
 nlinarith [hi]
theorem unit_equation (a b m q d0 e0 h : ℤ) (hm:m≠0) (hb:a*d0+b*e0=1)
 (he:m^5∣NE a b m q d0 e0 h) (hd:m^5∣ND a b m q d0 e0 h) :
 ∃ u v : ℤ, NE a b m q d0 e0 h=m^5*u ∧
 ND a b m q d0 e0 h=m^5*v ∧ (E m e0 a h)^3*v-(D m d0 b h)^3*u=1 := by
 obtain ⟨u,hu⟩:=he
 obtain ⟨v,hv⟩:=hd
 refine ⟨u,v,hu,hv,?_⟩
 apply mul_left_cancel₀ (pow_ne_zero 5 hm)
 calc
  m^5*((E m e0 a h)^3*v-(D m d0 b h)^3*u)=
   (E m e0 a h)^3*(m^5*v)-(D m d0 b h)^3*(m^5*u) := by ring
  _=m^5 := by rw [←hu,←hv]; exact numerator_syzygy a b m q d0 e0 h hb
  _=m^5*1 := by ring
theorem normalized_e (a b m q d0 e0 h : ℤ) (hb:a*d0+b*e0=1) :
 NE a b m q d0 e0 h =
 q*(E m e0 a h)^3-a^3*J3 m (b*E m e0 a h) := by
 have hl:=level_identity a b m d0 e0 h hb
 have hA:a*D m d0 b h=m-b*E m e0 a h := by linarith
 simp only [NE,hA,translated_R]
theorem normalized_d (a b m q d0 e0 h : ℤ) (hb:a*d0+b*e0=1) :
 ND a b m q d0 e0 h =
 q*(D m d0 b h)^3+b^3*J3 m (a*D m d0 b h) := by
 have hl:=level_identity a b m d0 e0 h hb
 have hB:b*E m e0 a h=m-a*D m d0 b h := by linarith
 simp only [ND,hB,translated_R]
theorem h_is_unit (p : ℕ) [Fact p.Prime] (a b m q d0 e0 h : ℤ)
 (hm:m≠0) (hb:a*d0+b*e0=1) (hpm:(p:ℤ)∣m)
 (he:m^5∣NE a b m q d0 e0 h) (hd:m^5∣ND a b m q d0 e0 h) :
 ¬(p:ℤ)∣h := by
 intro hh
 obtain ⟨u,v,_,_,huv⟩:=unit_equation a b m q d0 e0 h hm hb he hd
 have hm0 : (m:ZMod p)=0 := (ZMod.intCast_zmod_eq_zero_iff_dvd m p).mpr hpm
 have hh0 : (h:ZMod p)=0 := (ZMod.intCast_zmod_eq_zero_iff_dvd h p).mpr hh
 have hz:=congrArg (fun z:ℤ => (z:ZMod p)) huv
 dsimp [D,E] at hz
 push_cast at hz
 simp [hm0,hh0] at hz
theorem local_coordinate_unit (p : ℕ) [Fact p.Prime] (a b m d0 e0 h : ℤ)
 (hb:a*d0+b*e0=1) (hpm:(p:ℤ)∣m) (hph:¬(p:ℤ)∣h) :
 (¬(p:ℤ)∣a ∧ ¬(p:ℤ)∣E m e0 a h) ∨
 (¬(p:ℤ)∣b ∧ ¬(p:ℤ)∣D m d0 b h) := by
 have hm0 : (m:ZMod p)=0 := (ZMod.intCast_zmod_eq_zero_iff_dvd m p).mpr hpm
 have hh0 : (h:ZMod p)≠0 := by
  intro hz
  exact hph ((ZMod.intCast_zmod_eq_zero_iff_dvd h p).mp hz)
 by_cases ha:(p:ℤ)∣a
 · right
   have ha0 : (a:ZMod p)=0 := (ZMod.intCast_zmod_eq_zero_iff_dvd a p).mpr ha
   have hb0 : (b:ZMod p)≠0 := by
    intro hz
    have hh:=congrArg (fun z:ℤ => (z:ZMod p)) hb
    push_cast at hh
    simp [ha0,hz] at hh
   refine ⟨?_,?_⟩
   · intro hpb
     exact hb0 ((ZMod.intCast_zmod_eq_zero_iff_dvd b p).mpr hpb)
   · intro hpd
     have hz : ((D m d0 b h:ℤ):ZMod p)=0 :=
      (ZMod.intCast_zmod_eq_zero_iff_dvd (D m d0 b h) p).mpr hpd
     dsimp [D] at hz
     push_cast at hz
     simp only [hm0,zero_mul,zero_add] at hz
     exact (mul_ne_zero hb0 hh0) hz
 · left
   refine ⟨ha,?_⟩
   have ha0 : (a:ZMod p)≠0 := by
    intro hz
    exact ha ((ZMod.intCast_zmod_eq_zero_iff_dvd a p).mp hz)
   intro hpe
   have hz : ((E m e0 a h:ℤ):ZMod p)=0 :=
    (ZMod.intCast_zmod_eq_zero_iff_dvd (E m e0 a h) p).mpr hpe
   dsimp [E] at hz
   push_cast at hz
   simp only [hm0,zero_mul,zero_sub,neg_eq_zero] at hz
   exact (mul_ne_zero ha0 hh0) hz
theorem prime_power_cancel (P : ℤ) (hp : Prime P) (u : ℤ) (hu : ¬P∣u) :
 ∀ (n : ℕ) (x : ℤ), P^n∣u*x → P^n∣x := by
 intro n
 induction n with
 | zero => intro x hx; simp
 | succ n ih =>
  intro x hx
  have hpN : P∣P^(n+1) := ⟨P^n, by ring⟩
  have hpx : P∣x := (hp.dvd_mul.mp (hpN.trans hx)).resolve_left hu
  obtain ⟨y,rfl⟩:=hpx
  obtain ⟨k,hk⟩:=hx
  have hy : P^n∣u*y := by
   refine ⟨k,?_⟩
   apply mul_left_cancel₀ hp.ne_zero
   calc
    P*(u*y)=u*(P*y) := by ring
    _=P^(n+1)*k := hk
    _=P*(P^n*k) := by ring
  obtain ⟨z,hz⟩:=ih y hy
  exact ⟨z,by rw [hz]; ring⟩

def cubic (A B C D t : ℤ) : ℤ := A*t^3+B*t^2+C*t+D
theorem cubic_difference (A B C D x y : ℤ) :
 cubic A B C D x-cubic A B C D y =
 (x-y)*(A*(x^2+x*y+y^2)+B*(x+y)+C) := by
 unfold cubic; ring

theorem simple_cubic_spacing (p n : ℕ) [Fact p.Prime] (hn:0<n)
 (hpi:Prime (p:ℤ)) (A B C D x y : ℤ)
 (hA:¬(p:ℤ)∣A) (hC:(p:ℤ)∣C) (hD:(p:ℤ)∣D)
 (hx:¬(p:ℤ)∣x) (hy:¬(p:ℤ)∣y)
 (hFx:(p:ℤ)^n∣cubic A B C D x)
 (hFy:(p:ℤ)^n∣cubic A B C D y) :
 (p:ℤ)^n∣x-y := by
 let f : ℤ → ZMod p := fun z => (z:ZMod p)
 have nz (z:ℤ) (hz:¬(p:ℤ)∣z) : f z ≠ 0 := by
  intro h; exact hz ((ZMod.intCast_zmod_eq_zero_iff_dvd z p).mp h)
 have ze (z:ℤ) (hz:(p:ℤ)∣z) : f z = 0 :=
  (ZMod.intCast_zmod_eq_zero_iff_dvd z p).mpr hz
 have hpN : (p:ℤ)∣(p:ℤ)^n := by
  simpa only [pow_one] using pow_dvd_pow (p:ℤ) (show 1≤n by omega)
 have root (z:ℤ) (hz:¬(p:ℤ)∣z) (hFz:(p:ℤ)^n∣cubic A B C D z) :
   f A*f z+f B=0 := by
  have hval := ze _ (hpN.trans hFz)
  dsimp [f,cubic] at hval ⊢
  push_cast at hval
  have hc:=ze C hC
  have hd:=ze D hD
  dsimp [f] at hc hd
  rw [hc,hd] at hval
  have hfac : (z:ZMod p)^2*((A:ZMod p)*(z:ZMod p)+(B:ZMod p))=0 := by
   linear_combination hval
  exact (mul_eq_zero.mp hfac).resolve_left (pow_ne_zero 2 (nz z hz))
 have hRx:=root x hx hFx
 have hRy:=root y hy hFy
 have hxy : f x=f y := by
  apply mul_left_cancel₀ (nz A hA)
  linear_combination hRx-hRy
 let K:=A*(x^2+x*y+y^2)+B*(x+y)+C
 have hK:¬(p:ℤ)∣K := by
  intro hk
  have hK0:=ze K hk
  have hrel : f K=f A*(f x)^2 := by
   dsimp [K,f]
   push_cast
   have hc:=ze C hC
   dsimp [f] at hc hRx hxy
   rw [←hxy,hc]
   linear_combination (2*(x:ZMod p))*hRx
  rw [hrel] at hK0
  exact (mul_ne_zero (nz A hA) (pow_ne_zero 2 (nz x hx))) hK0
 have hdvd : (p:ℤ)^n∣K*(x-y) := by
  have hdiff:=dvd_sub hFx hFy
  rw [cubic_difference] at hdiff
  simpa only [K,mul_comm] using hdiff
 exact prime_power_cancel (p:ℤ) hpi K hK n (x-y) hdvd

theorem cancel_power_div (P : ℤ) (hP : P≠0) (v K : ℕ) (hv:v≤K) (z : ℤ) :
 P^K∣P^v*z ↔ P^(K-v)∣z := by
 have hk : v+(K-v)=K := Nat.add_sub_of_le hv
 have hpow : P^K=P^v*P^(K-v) := by rw [←pow_add,hk]
 constructor
 · rintro ⟨c,hc⟩
   refine ⟨c,?_⟩
   apply mul_left_cancel₀ (pow_ne_zero v hP)
   calc
    P^v*z=P^K*c := hc
    _=P^v*(P^(K-v)*c) := by rw [hpow,mul_assoc]
 · rintro ⟨c,rfl⟩
   refine ⟨c,?_⟩
   rw [←mul_assoc,←pow_add,hk]
theorem J3_scale (P M C t : ℤ) (v : ℕ) :
 J3 (P^v*M) ((P^v*C)*t)=P^(2*v)*J3 M (C*t) := by
 calc
  J3 (P^v*M) ((P^v*C)*t)=(P^v)^2*J3 M (C*t) := by unfold J3; ring
  _=P^(2*v)*J3 M (C*t) := by rw [←pow_mul,Nat.mul_comm v 2]
theorem normalize_cubic_congruence (P : ℤ) (hp:Prime P)
 (v K : ℕ) (hv:2*v≤K) (s U m c M C q t : ℤ)
 (hm:m=P^v*M) (hc:c=P^v*C) (ht:¬P∣t)
 (hcong:P^K∣q*t^3+s*U^3*J3 m (c*t)) :
 ∃ Q : ℤ, q=P^(2*v)*Q ∧
 P^(K-2*v)∣Q*t^3+s*U^3*J3 M (C*t) := by
 have hj : J3 m (c*t)=P^(2*v)*J3 M (C*t) := by rw [hm,hc,J3_scale]
 have hJ : P^(2*v)∣s*U^3*J3 m (c*t) := by
  refine ⟨s*U^3*J3 M (C*t),?_⟩
  rw [hj]; ring
 have hqt : P^(2*v)∣q*t^3 := by
  simpa only [add_sub_cancel_right] using
   dvd_sub ((pow_dvd_pow P hv).trans hcong) hJ
 have ht3:¬P∣t^3 := fun h => ht (hp.dvd_of_dvd_pow h)
 have hq:P^(2*v)∣q :=
  prime_power_cancel P hp (t^3) ht3 (2*v) q (by simpa only [mul_comm] using hqt)
 obtain ⟨Q,hQ⟩:=hq
 refine ⟨Q,hQ,?_⟩
 apply (cancel_power_div P hp.ne_zero (2*v) K hv _).mp
 convert hcong using 1
 rw [hQ,hj]
 ring

theorem refine_residue_cover (p γ μ : ℕ) (hp:0<p) (S:Finset ℤ) :
 ∃ T:Finset ℤ, T.card≤S.card*p^(μ-γ) ∧
 ∀ x:ℤ, (∃ r∈S,(p:ℤ)^γ∣x-r) → ∃ r∈T,(p:ℤ)^μ∣x-r := by
 classical
 by_cases hle:μ≤γ
 · refine ⟨S,by simp [Nat.sub_eq_zero_of_le hle],?_⟩
   intro x hx
   obtain ⟨r,hr,hdiv⟩:=hx
   exact ⟨r,hr,(pow_dvd_pow (p:ℤ) hle).trans hdiv⟩
 · have hgm:γ≤μ := by omega
   let k:=μ-γ
   let B:ℤ:=(p:ℤ)^k
   have hB:0<B := pow_pos (by exact_mod_cast hp) _
   let T:=S.biUnion (fun r => (Finset.range (p^k)).image
     (fun j:ℕ => r+(p:ℤ)^γ*j))
   refine ⟨T,?_,?_⟩
   · calc
      T.card ≤ ∑ r∈S,((Finset.range (p^k)).image
        (fun j:ℕ => r+(p:ℤ)^γ*j)).card := Finset.card_biUnion_le
      _ ≤ ∑ _r∈S,p^k := Finset.sum_le_sum (fun r hr => by
        exact Finset.card_image_le.trans (by rw [Finset.card_range]))
      _ = S.card*p^(μ-γ) := by simp [k]
   · intro x hx
     obtain ⟨r,hr,z,hz⟩:=hx
     let j:ℕ:=(z%B).toNat
     have hj0:0≤z%B := Int.emod_nonneg z (ne_of_gt hB)
     have hjcast:(j:ℤ)=z%B := Int.toNat_of_nonneg hj0
     have hBcast:((p^k:ℕ):ℤ)=B := by simp [B]
     have hjlt:j<p^k := by
      have hlt:=Int.emod_lt_of_pos z hB
      omega
     refine ⟨r+(p:ℤ)^γ*j,?_,?_⟩
     · apply Finset.mem_biUnion.mpr
       exact ⟨r,hr,Finset.mem_image.mpr ⟨j,Finset.mem_range.mpr hjlt,rfl⟩⟩
     · refine ⟨z/B,?_⟩
       have hzj:z-(j:ℤ)=B*(z/B) := by
        rw [hjcast]
        linarith [Int.emod_add_mul_ediv z B]
       calc
        x-(r+(p:ℤ)^γ*j)=(p:ℤ)^γ*(z-(j:ℤ)) := by rw [sub_eq_iff_eq_add.mp hz]; ring
        _=(p:ℤ)^γ*(B*(z/B)) := by rw [hzj]
        _=(p:ℤ)^μ*(z/B) := by
         dsimp [B,k]
         rw [←mul_assoc,←pow_add,Nat.add_sub_of_le hgm]

def cubicPoly (A B C0 D0 : ℤ) : Polynomial ℤ :=
 Polynomial.C A*X^3+Polynomial.C B*X^2+Polynomial.C C0*X+Polynomial.C D0
theorem cubicPoly_eval (A B C0 D0 t : ℤ) :
 (cubicPoly A B C0 D0).eval t=cubic A B C0 D0 t := by
 simp [cubicPoly,cubic]
theorem cubicPoly_coeff_two (A B C0 D0 : ℤ) :
 (cubicPoly A B C0 D0).coeff 2=B := by
 simp only [cubicPoly,Polynomial.coeff_add,Polynomial.coeff_C_mul,
  Polynomial.coeff_X_pow,Polynomial.coeff_X,Polynomial.coeff_C]
 norm_num
theorem cubicPoly_coeff_zero (A B C0 D0 : ℤ) :
 (cubicPoly A B C0 D0).coeff 0=D0 := by
 simp only [cubicPoly,Polynomial.coeff_add,Polynomial.coeff_C_mul,
  Polynomial.coeff_X_pow,Polynomial.coeff_X,Polynomial.coeff_C]
 norm_num
theorem cubicPoly_degree (A B C0 D0 : ℤ) :
 (cubicPoly A B C0 D0).natDegree≤3 := by
 apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
 intro j hj
 have h0:j≠0:=by omega
 have h1:j≠1:=by omega
 have h2:j≠2:=by omega
 have h3:j≠3:=by omega
 simp only [cubicPoly,Polynomial.coeff_add,Polynomial.coeff_C_mul,
  Polynomial.coeff_X_pow,Polynomial.coeff_X,Polynomial.coeff_C]
 simp [h0,h2,h3,Ne.symm h1,]
theorem primitive_of_unit_coeff (p:ℕ) (F:Polynomial ℤ) (j:ℕ)
 (hj:¬(p:ℤ)∣F.coeff j) :
 Polynomial.map (Int.castRingHom (ZMod p)) F≠0 := by
 intro hz
 have hcoeff:=congrArg (fun H:Polynomial (ZMod p) => H.coeff j) hz
 simp only [Polynomial.coeff_map,Polynomial.coeff_zero] at hcoeff
 exact hj ((ZMod.intCast_zmod_eq_zero_iff_dvd (F.coeff j) p).mp hcoeff)
theorem bounded_content_cubic_cover (p N γ c0 : ℕ) [Fact p.Prime]
 (A B C0 D0 : ℤ) (hB:¬(p:ℤ)^(c0+1)∣B)
 (hγ:0<γ) (hprec:3*(γ-1)<N-c0) :
 ∃ T:Finset ℤ, T.card≤3 ∧
 ∀ t:ℤ, (p:ℤ)^N∣cubic A B C0 D0 t →
 ∃ r∈T,(p:ℤ)^γ∣t-r := by
 let F:=cubicPoly A B C0 D0
 have hdeg:F.natDegree≤3:=cubicPoly_degree A B C0 D0
 have hp0:(p:ℤ)≠0:=by exact_mod_cast (Fact.out:p.Prime).ne_zero
 rcases A6PureSepticQuarticProgressions.extract_content p (c0+1) F with
  hdiv | ⟨v,hv,H,heq,hH⟩
 · have hc:=((Polynomial.C_dvd_iff_dvd_coeff _ _).mp hdiv) 2
   exact (hB (by simpa only [F,cubicPoly_coeff_two] using hc)).elim
 · have hv0:v≤c0:=by omega
   have hvN:v≤N:=by omega
   have hdegH:H.natDegree≤3 := by
    apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
    intro j hj
    have hfj:F.coeff j=0:=(Polynomial.natDegree_le_iff_coeff_eq_zero.mp hdeg) j hj
    have hcoeff:=congrArg (fun G:Polynomial ℤ => G.coeff j) heq
    rw [hfj,Polynomial.coeff_C_mul] at hcoeff
    exact (mul_eq_zero.mp hcoeff.symm).resolve_left (pow_ne_zero v hp0)
   obtain ⟨T,hT,hcover⟩:=
    A6PureSepticQuarticProgressions.primitive_fixed_cover p 3 γ (N-v) H hdegH hH hγ (by omega)
   refine ⟨T,hT,?_⟩
   intro t ht
   apply hcover t
   apply (cancel_power_div (p:ℤ) hp0 v N hvN _).mp
   have heval:=congrArg (fun G:Polynomial ℤ => G.eval t) heq
   simp only [Polynomial.eval_mul,Polynomial.eval_C] at heval
   rw [←heval]
   simpa only [F,cubicPoly_eval] using ht

theorem cubic_scale (P A B C0 D0 t : ℤ) (v:ℕ) :
 cubic (P^v*A) (P^v*B) (P^v*C0) (P^v*D0) t =
 P^v*cubic A B C0 D0 t := by unfold cubic; ring
theorem simple_content_cubic_cover (p N μ c0 : ℕ) [Fact p.Prime]
 (hN:c0<N) (A B C0 D0 : ℤ)
 (hB:(p:ℤ)^c0∣B) (hBx:¬(p:ℤ)^(c0+1)∣B)
 (hC:(p:ℤ)^(c0+1)∣C0) (hD:(p:ℤ)^(c0+1)∣D0) :
 ∃ T:Finset ℤ, T.card≤p^(μ-(N-c0)) ∧
 ∀ t:ℤ, ¬(p:ℤ)∣t → (p:ℤ)^N∣cubic A B C0 D0 t →
 ∃ r∈T,(p:ℤ)^μ∣t-r := by
 classical
 have hp : p.Prime:=Fact.out
 have hpi:Prime (p:ℤ):=Int.prime_iff_natAbs_prime.mpr (by simpa using hp)
 have hpc:(p:ℤ)^c0∣(p:ℤ)^(c0+1):=pow_dvd_pow _ (by omega)
 have hCv:(p:ℤ)^c0∣C0:=hpc.trans hC
 have hDv:(p:ℤ)^c0∣D0:=hpc.trans hD
 by_cases hex:∃t:ℤ,¬(p:ℤ)∣t ∧ (p:ℤ)^N∣cubic A B C0 D0 t
 · obtain ⟨t0,ht0,hFt0⟩:=hex
   have hrest:(p:ℤ)^c0∣B*t0^2+C0*t0+D0:=
    dvd_add (dvd_add (dvd_mul_of_dvd_left hB _) (dvd_mul_of_dvd_left hCv _)) hDv
   have hAt:(p:ℤ)^c0∣A*t0^3:=by
    have hh:=dvd_sub ((pow_dvd_pow (p:ℤ) (show c0≤N by omega)).trans hFt0) hrest
    have he:cubic A B C0 D0 t0-(B*t0^2+C0*t0+D0)=A*t0^3:=by unfold cubic;ring
    rwa [he] at hh
   have hA:(p:ℤ)^c0∣A:=prime_power_cancel (p:ℤ) hpi (t0^3)
    (fun h => ht0 (hpi.dvd_of_dvd_pow h)) c0 A (by simpa only [mul_comm] using hAt)
   obtain ⟨A1,hA1⟩:=hA
   obtain ⟨B1,hB1⟩:=hB
   obtain ⟨C1,hC1⟩:=hCv
   obtain ⟨D1,hD1⟩:=hDv
   have hBu:¬(p:ℤ)∣B1:=by
    rintro ⟨z,hz⟩
    apply hBx
    refine ⟨z,?_⟩
    rw [hB1,hz,pow_succ]
    ring
   have hCp:(p:ℤ)∣C1:=by
    have hh:=(cancel_power_div (p:ℤ) hpi.ne_zero c0 (c0+1) (by omega) C1).mp
      (by simpa only [←hC1] using hC)
    simpa using hh
   have hDp:(p:ℤ)∣D1:=by
    have hh:=(cancel_power_div (p:ℤ) hpi.ne_zero c0 (c0+1) (by omega) D1).mp
      (by simpa only [←hD1] using hD)
    simpa using hh
   have normalize (t:ℤ) (ht:(p:ℤ)^N∣cubic A B C0 D0 t) :
      (p:ℤ)^(N-c0)∣cubic A1 B1 C1 D1 t:=by
    apply (cancel_power_div (p:ℤ) hpi.ne_zero c0 N (by omega) _).mp
    simpa only [hA1,hB1,hC1,hD1,cubic_scale] using ht
   have hAunit:¬(p:ℤ)∣A1:=by
    intro hAp
    have hpN1:(p:ℤ)∣(p:ℤ)^(N-c0):=by
     simpa only [pow_one] using pow_dvd_pow (p:ℤ) (show 1≤N-c0 by omega)
    have hF1:(p:ℤ)∣cubic A1 B1 C1 D1 t0:=hpN1.trans (normalize t0 hFt0)
    have hother:(p:ℤ)∣A1*t0^3+C1*t0+D1:=
     dvd_add (dvd_add (dvd_mul_of_dvd_left hAp _) (dvd_mul_of_dvd_left hCp _)) hDp
    have hBt:(p:ℤ)∣B1*t0^2:=by
     have hh:=dvd_sub hF1 hother
     have he:cubic A1 B1 C1 D1 t0-(A1*t0^3+C1*t0+D1)=B1*t0^2:=by unfold cubic;ring
     rwa [he] at hh
    apply hBu
    have hh:=prime_power_cancel (p:ℤ) hpi (t0^2)
     (fun h => ht0 (hpi.dvd_of_dvd_pow h)) 1 B1
      (by simpa only [pow_one,mul_comm] using hBt)
    simpa only [pow_one] using hh
   obtain ⟨T,hT,hcover⟩:=refine_residue_cover p (N-c0) μ hp.pos {t0}
   refine ⟨T,by simpa using hT,?_⟩
   intro t ht hFt
   apply hcover t
   refine ⟨t0,Finset.mem_singleton_self _,?_⟩
   exact simple_cubic_spacing p (N-c0) (by omega) hpi A1 B1 C1 D1 t t0
    hAunit hCp hDp ht ht0 (normalize t hFt) (normalize t0 hFt0)
 · refine ⟨∅,by simp,?_⟩
   intro t ht hFt
   exact (hex ⟨t,ht,hFt⟩).elim

theorem prime_not_dvd_mul (P:ℤ) (hp:Prime P) (x y:ℤ)
 (hx:¬P∣x) (hy:¬P∣y) : ¬P∣x*y := by
 intro h
 exact (hp.dvd_mul.mp h).elim hx hy
theorem normalized_cubic_value (Q s U M c t:ℤ) :
 cubic Q (6*s*U^3*c^2) (3*s*U^3*M*c) (s*U^3*M^2) t =
 Q*t^3+s*U^3*J3 M (c*t) := by unfold cubic J3; ring

theorem normalized_local_cover (p α β c6:ℕ) [Fact p.Prime]
 (hα:0<α) (hβ:β≤α) (s U M c Q:ℤ)
 (hs:¬(p:ℤ)∣s) (hU:¬(p:ℤ)∣U)
 (hM:(p:ℤ)^(α-β)∣M) (hMx:¬(p:ℤ)^(α-β+1)∣M)
 (hc:β<α → ¬(p:ℤ)∣c)
 (h6:(p:ℤ)^c6∣6) (h6x:¬(p:ℤ)^(c6+1)∣6) :
 ∃ T:Finset ℤ, T.card≤3*p^(6*c6) ∧
 ∀ t:ℤ, ¬(p:ℤ)∣t →
 (p:ℤ)^(5*α-2*β)∣Q*t^3+s*U^3*J3 M (c*t) →
 ∃ r∈T,(p:ℤ)^(5*α-4*β)∣t-r := by
 classical
 have hp:p.Prime:=Fact.out
 have hpi:Prime (p:ℤ):=Int.prime_iff_natAbs_prime.mpr (by simpa using hp)
 have hU3:¬(p:ℤ)∣U^3:=fun h => hU (hpi.dvd_of_dvd_pow h)
 have hsU:¬(p:ℤ)∣s*U^3:=prime_not_dvd_mul _ hpi _ _ hs hU3
 let B:=6*s*U^3*c^2
 let C0:=3*s*U^3*M*c
 let D0:=s*U^3*M^2
 let N:=5*α-2*β
 let μ:=5*α-4*β
 have hvalue (t:ℤ) : cubic Q B C0 D0 t=Q*t^3+s*U^3*J3 M (c*t):=
  normalized_cubic_value Q s U M c t
 by_cases hba:β=α
 · have hMu:¬(p:ℤ)∣M:=by simpa [hba] using hMx
   have hDu:¬(p:ℤ)∣D0:=
    prime_not_dvd_mul _ hpi _ _ hsU (fun h => hMu (hpi.dvd_of_dvd_pow h))
   let F:=cubicPoly Q B C0 D0
   have hF:Polynomial.map (Int.castRingHom (ZMod p)) F≠0:=
    primitive_of_unit_coeff p F 0 (by simpa only [F,cubicPoly_coeff_zero] using hDu)
   obtain ⟨T,hT,hcover⟩:=
    A6PureSepticQuarticProgressions.primitive_fixed_cover p 3 μ N F
      (cubicPoly_degree _ _ _ _) hF (by dsimp [μ];omega) (by dsimp [μ,N];omega)
   refine ⟨T,?_,?_⟩
   · have hpow:0<p^(6*c6):=pow_pos hp.pos _
     nlinarith
   · intro t ht hcong
     apply hcover t
     simpa only [F,cubicPoly_eval,hvalue] using hcong
 · have hbl:β<α:=by omega
   have hcu:¬(p:ℤ)∣c:=hc hbl
   have hcu2:¬(p:ℤ)∣c^2:=fun h => hcu (hpi.dvd_of_dvd_pow h)
   have hunit:¬(p:ℤ)∣s*U^3*c^2:=prime_not_dvd_mul _ hpi _ _ hsU hcu2
   have hBx:¬(p:ℤ)^(c6+1)∣B:=by
    intro hh
    apply h6x
    apply prime_power_cancel (p:ℤ) hpi (s*U^3*c^2) hunit (c6+1) 6
    have he:(s*U^3*c^2)*6=B:=by dsimp [B];ring
    rwa [he]
   have hB:(p:ℤ)^c6∣B:=by
    have hh:=dvd_mul_of_dvd_left h6 (s*U^3*c^2)
    have he:(6:ℤ)*(s*U^3*c^2)=B:=by dsimp [B];ring
    rwa [he] at hh
   by_cases hΔ: c6<α-β
   · have hMd:(p:ℤ)^(c6+1)∣M:=
      (pow_dvd_pow _ (by omega)).trans hM
     have hC:(p:ℤ)^(c6+1)∣C0:=by
      have hh:=dvd_mul_of_dvd_left hMd (3*s*U^3*c)
      have he:M*(3*s*U^3*c)=C0:=by dsimp [C0];ring
      rwa [he] at hh
     have hD:(p:ℤ)^(c6+1)∣D0:=by
      have hh:=dvd_mul_of_dvd_left hMd (s*U^3*M)
      have he:M*(s*U^3*M)=D0:=by dsimp [D0];ring
      rwa [he] at hh
     obtain ⟨T,hT,hcover⟩:=
      simple_content_cubic_cover p N μ c6 (by dsimp [N];omega) Q B C0 D0 hB hBx hC hD
     refine ⟨T,?_,?_⟩
     · have hexp:μ-(N-c6)≤6*c6:=by dsimp [μ,N];omega
       have hpow:=Nat.pow_le_pow_right hp.pos hexp
       exact hT.trans (hpow.trans (by omega))
     · intro t ht hcong
       exact hcover t ht (by simpa only [hvalue] using hcong)
   · have hΔle:α-β≤c6:=by omega
     let γ:=β-c6
     have hsmall:∃S:Finset ℤ,S.card≤3 ∧
       ∀t:ℤ,(p:ℤ)^N∣cubic Q B C0 D0 t → ∃r∈S,(p:ℤ)^γ∣t-r:=by
      by_cases hγ:0<γ
      · exact bounded_content_cubic_cover p N γ c6 Q B C0 D0 hBx hγ
          (by dsimp [N,γ];omega)
      · have hγ0:γ=0:=by omega
        refine ⟨{0},by simp,?_⟩
        intro t ht
        exact ⟨0,Finset.mem_singleton_self _,by simp [hγ0]⟩
     obtain ⟨S,hS,hcover⟩:=hsmall
     obtain ⟨T,hT,hrefine⟩:=refine_residue_cover p γ μ hp.pos S
     refine ⟨T,?_,?_⟩
     · have hexp:μ-γ≤6*c6:=by dsimp [μ,γ];omega
       calc
        T.card≤S.card*p^(μ-γ):=hT
        _≤3*p^(μ-γ):=Nat.mul_le_mul_right _ hS
        _≤3*p^(6*c6):=Nat.mul_le_mul_left _ (Nat.pow_le_pow_right hp.pos hexp)
     · intro t ht hcong
       exact hrefine t (hcover t (by simpa only [hvalue] using hcong))

theorem unit_roots_original_cubic_cover (p α β c6:ℕ) [Fact p.Prime]
 (hα:0<α) (hβ:β≤α) (s U m c q:ℤ)
 (hs:¬(p:ℤ)∣s) (hU:¬(p:ℤ)∣U)
 (hm:(p:ℤ)^α∣m) (hmx:¬(p:ℤ)^(α+1)∣m)
 (hc:(p:ℤ)^β∣c) (hcx:β<α → ¬(p:ℤ)^(β+1)∣c)
 (h6:(p:ℤ)^c6∣6) (h6x:¬(p:ℤ)^(c6+1)∣6) :
 ∃ T:Finset ℤ, T.card≤3*p^(6*c6) ∧
 ∀t:ℤ, ¬(p:ℤ)∣t →
 (p:ℤ)^(5*α)∣q*t^3+s*U^3*J3 m (c*t) →
 ∃r∈T,(p:ℤ)^(5*α-4*β)∣t-r := by
 classical
 have hp:p.Prime:=Fact.out
 have hpi:Prime (p:ℤ):=Int.prime_iff_natAbs_prime.mpr (by simpa using hp)
 obtain ⟨M,hM⟩:=(pow_dvd_pow (p:ℤ) hβ).trans hm
 obtain ⟨C1,hC1⟩:=hc
 have hMv:(p:ℤ)^(α-β)∣M:=
  (cancel_power_div _ hpi.ne_zero β α hβ M).mp (by simpa only [←hM] using hm)
 have hMx:¬(p:ℤ)^(α-β+1)∣M:=by
  rintro ⟨z,hz⟩
  apply hmx
  refine ⟨z,?_⟩
  rw [hM,hz,←mul_assoc,←pow_add]
  congr 1
  congr 1
  omega
 have hCu:β<α → ¬(p:ℤ)∣C1:=by
  intro hbl
  rintro ⟨z,hz⟩
  apply hcx hbl
  refine ⟨z,?_⟩
  rw [hC1,hz,pow_succ]
  ring
 by_cases hq:(p:ℤ)^(2*β)∣q
 · obtain ⟨Q,hQ⟩:=hq
   obtain ⟨T,hT,hcover⟩:=normalized_local_cover p α β c6 hα hβ s U M C1 Q
    hs hU hMv hMx hCu h6 h6x
   refine ⟨T,hT,?_⟩
   intro t ht hcong
   apply hcover t ht
   apply (cancel_power_div (p:ℤ) hpi.ne_zero (2*β) (5*α) (by omega) _).mp
   have he:q*t^3+s*U^3*J3 m (c*t)=
    (p:ℤ)^(2*β)*(Q*t^3+s*U^3*J3 M (C1*t)):=by
    rw [hQ,hM,hC1,J3_scale]
    ring
   rwa [←he]
 · refine ⟨∅,by simp,?_⟩
   intro t ht hcong
   obtain ⟨Q,hQ,_⟩:=normalize_cubic_congruence (p:ℤ) hpi β (5*α) (by omega)
    s U m c M C1 q t hM hC1 ht hcong
   exact (hq ⟨Q,hQ⟩).elim

theorem affine_pullback_cover (P:ℤ) (hp:Prime P) (n:ℕ)
 (c u:ℤ) (hu:¬P∣u) (H:ℤ→Prop) (S:Finset ℤ)
 (hcover:∀h:ℤ,H h → ∃r∈S,P^n∣(c+u*h)-r) :
 ∃T:Finset ℤ,T.card≤S.card ∧
 ∀h:ℤ,H h → ∃r∈T,P^n∣h-r := by
 classical
 let U:=S.filter (fun r => ∃h:ℤ,H h ∧ P^n∣(c+u*h)-r)
 have hex (r:{r:ℤ // r∈U}) : ∃h:ℤ,H h ∧ P^n∣(c+u*h)-r.1 :=
  (Finset.mem_filter.mp r.2).2
 choose f hf using hex
 let T:=U.attach.image f
 refine ⟨T,?_,?_⟩
 · exact Finset.card_image_le.trans (by
    rw [Finset.card_attach]
    exact Finset.card_filter_le _ _)
 · intro h hh
   obtain ⟨r,hr,hdiv⟩:=hcover h hh
   have hrU:r∈U:=Finset.mem_filter.mpr ⟨hr,⟨h,hh,hdiv⟩⟩
   let rU:{r:ℤ // r∈U}:=⟨r,hrU⟩
   refine ⟨f rU,Finset.mem_image.mpr ⟨rU,Finset.mem_attach _ _,rfl⟩,?_⟩
   apply prime_power_cancel P hp u hu n (h-f rU)
   have hd:=dvd_sub hdiv (hf rU).2
   have he:(c+u*h-r)-(c+u*f rU-r)=u*(h-f rU):=by ring
   rwa [he] at hd

theorem affine_value_unit (P:ℤ) (hp:Prime P) (c u h:ℤ)
 (hc:P∣c) (hu:¬P∣u) (hh:¬P∣h) : ¬P∣c+u*h := by
 intro hval
 have hd:P∣u*h:=by simpa using dvd_sub hval hc
 exact prime_not_dvd_mul P hp u h hu hh hd
theorem prime_not_dvd_one_int (p:ℕ) (hp:p.Prime) : ¬(p:ℤ)∣(1:ℤ) := by
 intro h
 have hn:p∣1:=Int.natCast_dvd_natCast.mp h
 have hle:=Nat.le_of_dvd (by decide:0<(1:ℕ)) hn
 have htwo:=hp.two_le
 omega
theorem original_local_cover (p α β c6:ℕ) [Fact p.Prime]
 (a b m q d0 e0:ℤ) (hα:0<α) (hβ:β≤α) (hm:m≠0)
 (hmv:(p:ℤ)^α∣m) (hmx:¬(p:ℤ)^(α+1)∣m)
 (_hab:Int.gcd a b=1) (hbez:a*d0+b*e0=1)
 (habv:(p:ℤ)^β∣a*b) (habx:β<α → ¬(p:ℤ)^(β+1)∣a*b)
 (h6:(p:ℤ)^c6∣6) (h6x:¬(p:ℤ)^(c6+1)∣6) :
 ∃R:Finset ℤ,R.card≤3*p^(6*c6) ∧
 ∀h:ℤ,m^5∣NE a b m q d0 e0 h → m^5∣ND a b m q d0 e0 h →
 ∃r∈R,(p:ℤ)^(5*α-4*β)∣h-r := by
 classical
 have hp:p.Prime:=Fact.out
 have hpi:Prime (p:ℤ):=Int.prime_iff_natAbs_prime.mpr (by simpa using hp)
 have hpα:(p:ℤ)∣(p:ℤ)^α:=by
  simpa only [pow_one] using pow_dvd_pow (p:ℤ) (show 1≤α by omega)
 have hpm:(p:ℤ)∣m:=hpα.trans hmv
 have hm5:(p:ℤ)^(5*α)∣m^5:=by
  obtain ⟨M,hM⟩:=hmv
  refine ⟨M^5,?_⟩
  rw [hM,mul_pow,←pow_mul,Nat.mul_comm α 5]
 let H:ℤ→Prop:=fun h => m^5∣NE a b m q d0 e0 h ∧ m^5∣ND a b m q d0 e0 h
 by_cases ha:(p:ℤ)∣a
 · have hb:¬(p:ℤ)∣b:=by
    intro hb
    apply prime_not_dvd_one_int p hp
    rw [←hbez]
    exact dvd_add (dvd_mul_of_dvd_left ha _) (dvd_mul_of_dvd_left hb _)
   have hav:(p:ℤ)^β∣a:=prime_power_cancel _ hpi b hb β a
     (by simpa only [mul_comm] using habv)
   have hax:β<α → ¬(p:ℤ)^(β+1)∣a:=by
    intro hbl hd
    exact habx hbl (dvd_mul_of_dvd_left hd b)
   obtain ⟨T,hT,hcover⟩:=unit_roots_original_cubic_cover p α β c6 hα hβ 1 b m a q
    (prime_not_dvd_one_int p hp) hb hmv hmx hav hax h6 h6x
   have hTcover:∀h:ℤ,H h → ∃r∈T,(p:ℤ)^(5*α-4*β)∣(m*d0+b*h)-r:=by
    intro h hh
    change ∃r∈T,(p:ℤ)^(5*α-4*β)∣D m d0 b h-r
    apply hcover (D m d0 b h)
    · exact affine_value_unit _ hpi (m*d0) b h
       (dvd_mul_of_dvd_left hpm _) hb (h_is_unit p a b m q d0 e0 h hm hbez hpm hh.1 hh.2)
    · have hn:=hm5.trans hh.2
      rw [normalized_d a b m q d0 e0 h hbez] at hn
      simpa [sub_eq_add_neg] using hn
   obtain ⟨R,hR,hRcover⟩:=affine_pullback_cover (p:ℤ) hpi (5*α-4*β)
    (m*d0) b hb H T hTcover
   refine ⟨R,hR.trans hT,?_⟩
   intro h he hd
   exact hRcover h ⟨he,hd⟩
 · have hbv:(p:ℤ)^β∣b:=prime_power_cancel _ hpi a ha β b habv
   have hbx:β<α → ¬(p:ℤ)^(β+1)∣b:=by
    intro hbl hd
    apply habx hbl
    simpa only [mul_comm] using dvd_mul_of_dvd_left hd a
   have hs:¬(p:ℤ)∣(-1:ℤ):=by simpa using prime_not_dvd_one_int p hp
   have hna:¬(p:ℤ)∣-a:=by simpa using ha
   obtain ⟨T,hT,hcover⟩:=unit_roots_original_cubic_cover p α β c6 hα hβ (-1) a m b q
    hs ha hmv hmx hbv hbx h6 h6x
   have hTcover:∀h:ℤ,H h → ∃r∈T,(p:ℤ)^(5*α-4*β)∣(m*e0+(-a)*h)-r:=by
    intro h hh
    have ht:m*e0+(-a)*h=E m e0 a h:=by dsimp [E];ring
    rw [ht]
    apply hcover (E m e0 a h)
    · rw [←ht]
      exact affine_value_unit _ hpi (m*e0) (-a) h
       (dvd_mul_of_dvd_left hpm _) hna (h_is_unit p a b m q d0 e0 h hm hbez hpm hh.1 hh.2)
    · have hn:=hm5.trans hh.1
      rw [normalized_e a b m q d0 e0 h hbez] at hn
      simpa [sub_eq_add_neg] using hn
   obtain ⟨R,hR,hRcover⟩:=affine_pullback_cover (p:ℤ) hpi (5*α-4*β)
    (m*e0) (-a) hna H T hTcover
   refine ⟨R,hR.trans hT,?_⟩
   intro h he hd
   exact hRcover h ⟨he,hd⟩

theorem original_local_cover_padic (p α β:ℕ) [Fact p.Prime]
 (a b m q d0 e0:ℤ) (hα:0<α) (hβ:β≤α) (hm:m≠0)
 (hmv:(p:ℤ)^α∣m) (hmx:¬(p:ℤ)^(α+1)∣m)
 (hab:Int.gcd a b=1) (hbez:a*d0+b*e0=1)
 (habv:(p:ℤ)^β∣a*b) (habx:β<α → ¬(p:ℤ)^(β+1)∣a*b) :
 ∃R:Finset ℤ,R.card≤3*p^(6*padicValNat p 6) ∧
 ∀h:ℤ,m^5∣NE a b m q d0 e0 h → m^5∣ND a b m q d0 e0 h →
 ∃r∈R,(p:ℤ)^(5*α-4*β)∣h-r := by
 have h6:(p:ℤ)^(padicValNat p 6)∣(6:ℤ):=by
  exact_mod_cast (pow_padicValNat_dvd (p:=p) (n:=6))
 have h6x:¬(p:ℤ)^(padicValNat p 6+1)∣(6:ℤ):=by
  intro h
  have hn:p^(padicValNat p 6+1)∣(6:ℕ):=by exact_mod_cast h
  exact pow_succ_padicValNat_not_dvd (p:=p) (n:=6) (by decide) hn
 exact original_local_cover p α β (padicValNat p 6) a b m q d0 e0
  hα hβ hm hmv hmx hab hbez habv habx h6 h6x
end A6Local

namespace A6P3CRT

private def crtRep (A B : ℕ) (hcop : A.Coprime B) (r s : ℤ) : ℤ :=
  (((ZMod.chineseRemainder hcop).symm ((r : ZMod A), (s : ZMod B))).val : ℤ)

private theorem crtRep_congr
    (A B : ℕ) (hA : 0 < A) (hB : 0 < B) (hcop : A.Coprime B)
    (r s : ℤ) :
    (A : ℤ) ∣ crtRep A B hcop r s - r ∧
    (B : ℤ) ∣ crtRep A B hcop r s - s := by
  let : NeZero (A * B) := ⟨mul_ne_zero (Nat.ne_of_gt hA) (Nat.ne_of_gt hB)⟩
  let z := (ZMod.chineseRemainder hcop).symm ((r : ZMod A), (s : ZMod B))
  have hz : (z.val : ZMod (A * B)) = z := ZMod.natCast_zmod_val z
  have hp : ((z.val : ZMod A), (z.val : ZMod B)) =
      ((r : ZMod A), (s : ZMod B)) := by
    calc
      _ = (ZMod.chineseRemainder hcop) (z.val : ZMod (A * B)) :=
        (map_natCast (ZMod.chineseRemainder hcop) z.val).symm
      _ = _ := by rw [hz]; exact (ZMod.chineseRemainder hcop).apply_symm_apply _
  constructor
  · apply (ZMod.intCast_zmod_eq_zero_iff_dvd _ A).mp
    push_cast
    have ht := congrArg Prod.fst hp
    simpa [crtRep, z] using sub_eq_zero.mpr ht
  · apply (ZMod.intCast_zmod_eq_zero_iff_dvd _ B).mp
    push_cast
    have ht := congrArg Prod.snd hp
    simpa [crtRep, z] using sub_eq_zero.mpr ht

private theorem combine_cover
    (A B : ℕ) (hA : 0 < A) (hB : 0 < B) (hcop : A.Coprime B)
    (R S : Finset ℤ) (Pred : ℤ → Prop)
    (hR : ∀ x, Pred x → ∃ r ∈ R, (A : ℤ) ∣ x - r)
    (hS : ∀ x, Pred x → ∃ s ∈ S, (B : ℤ) ∣ x - s) :
    ∃ T : Finset ℤ, T.card ≤ R.card * S.card ∧
      ∀ x, Pred x → ∃ t ∈ T, ((A * B : ℕ) : ℤ) ∣ x - t := by
  classical
  let T := (R ×ˢ S).image (fun rs => crtRep A B hcop rs.1 rs.2)
  refine ⟨T, ?_, ?_⟩
  · exact (Finset.card_image_le).trans (by rw [Finset.card_product])
  · intro x hx
    obtain ⟨r, hr, hxr⟩ := hR x hx
    obtain ⟨s, hs, hxs⟩ := hS x hx
    let t := crtRep A B hcop r s
    refine ⟨t, Finset.mem_image.mpr ⟨(r,s), Finset.mem_product.mpr ⟨hr,hs⟩, rfl⟩, ?_⟩
    have ht := crtRep_congr A B hA hB hcop r s
    have hAt : (A : ℤ) ∣ x - t := by
      simpa only [sub_sub_sub_cancel_right] using dvd_sub hxr ht.1
    have hBt : (B : ℤ) ∣ x - t := by
      simpa only [sub_sub_sub_cancel_right] using dvd_sub hxs ht.2
    have hco : (A : ℤ).natAbs.Coprime (B : ℤ).natAbs := by simpa using hcop
    have hmod : Int.ModEq ((A : ℤ) * (B : ℤ)) t x :=
      (Int.modEq_and_modEq_iff_modEq_mul hco).mp
        ⟨Int.modEq_iff_dvd.mpr hAt, Int.modEq_iff_dvd.mpr hBt⟩
    simpa only [Nat.cast_mul] using Int.modEq_iff_dvd.mp hmod

private theorem finite_cover {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (Q L : ι → ℕ) (Pred : ℤ → Prop)
    (hpos : ∀ i ∈ s, 0 < Q i)
    (hpair : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → (Q i).Coprime (Q j))
    (hloc : ∀ i ∈ s, ∃ R : Finset ℤ, R.card ≤ L i ∧
      ∀ z, Pred z → ∃ a ∈ R, (Q i : ℤ) ∣ z - a) :
    ∃ T : Finset ℤ, T.card ≤ ∏ i ∈ s, L i ∧
      ∀ z, Pred z → ∃ a ∈ T, ((∏ i ∈ s, Q i : ℕ) : ℤ) ∣ z - a := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    refine ⟨{0}, by simp, ?_⟩
    intro z hz
    refine ⟨0, Finset.mem_singleton_self _, ?_⟩
    simp
  | @insert i s hi ih =>
    obtain ⟨R, hRc, hRv⟩ := hloc i (Finset.mem_insert_self _ _)
    have hposS : ∀ j ∈ s, 0 < Q j :=
      fun j hj => hpos j (Finset.mem_insert_of_mem hj)
    have hpairS : ∀ j ∈ s, ∀ k ∈ s, j ≠ k → (Q j).Coprime (Q k) :=
      fun j hj k hk hne => hpair j (Finset.mem_insert_of_mem hj)
        k (Finset.mem_insert_of_mem hk) hne
    have hlocS : ∀ j ∈ s, ∃ R : Finset ℤ, R.card ≤ L j ∧
        ∀ z, Pred z → ∃ a ∈ R, (Q j : ℤ) ∣ z - a :=
      fun j hj => hloc j (Finset.mem_insert_of_mem hj)
    obtain ⟨S, hSc, hSv⟩ := ih hposS hpairS hlocS
    have hcop : (Q i).Coprime (∏ j ∈ s, Q j) := by
      apply Nat.Coprime.prod_right
      intro j hj
      exact hpair i (Finset.mem_insert_self _ _)
        j (Finset.mem_insert_of_mem hj) (by intro hij; subst j; exact hi hj)
    have hprodpos : 0 < ∏ j ∈ s, Q j := Finset.prod_pos hposS
    obtain ⟨T, hTc, hTv⟩ := combine_cover (Q i) (∏ j ∈ s, Q j)
      (hpos i (Finset.mem_insert_self _ _)) hprodpos hcop R S Pred hRv hSv
    refine ⟨T, ?_, ?_⟩
    · rw [Finset.prod_insert hi]
      exact hTc.trans (Nat.mul_le_mul hRc hSc)
    · simpa only [Finset.prod_insert hi] using hTv

private theorem exceptional_product_budget
    (S : Finset ℕ) (hprime : ∀ p ∈ S, p.Prime) :
    (∏ p ∈ S, 3 * p ^ (6 * padicValNat p 6)) ≤
      6 ^ 6 * 3 ^ S.card := by
  classical
  let f : ℕ → ℕ := fun p => p ^ (6 : ℕ).factorization p
  have heq : (∏ p ∈ S, f p) =
      ∏ p ∈ S ∩ (6 : ℕ).primeFactors, f p := by
    symm
    apply Finset.prod_subset Finset.inter_subset_left
    intro p hp hpnot
    have hnotdvd : ¬ p ∣ 6 := by
      intro hd
      exact hpnot (Finset.mem_inter.mpr
        ⟨hp, Nat.mem_primeFactors.mpr ⟨hprime p hp, hd, by norm_num⟩⟩)
    simp [f, Nat.factorization_eq_zero_of_not_dvd hnotdvd]
  have hd : (∏ p ∈ S, f p) ∣ 6 := by
    rw [heq]
    have h := Finset.prod_dvd_prod_of_subset
      (S ∩ (6 : ℕ).primeFactors) (6 : ℕ).primeFactors f
      Finset.inter_subset_right
    have hfull : (∏ p ∈ (6 : ℕ).primeFactors, f p) = 6 := by
      exact (Nat.prod_primeFactors_pow_factorization (by norm_num : (6 : ℕ) ≠ 0)).symm
    rwa [hfull] at h
  have hb : (∏ p ∈ S, f p) ≤ 6 := Nat.le_of_dvd (by norm_num) hd
  have hpowers : (∏ p ∈ S, p ^ (6 * padicValNat p 6)) =
      (∏ p ∈ S, f p) ^ 6 := by
    rw [← Finset.prod_pow]
    apply Finset.prod_congr rfl
    intro p hp
    simp only [f, Nat.factorization_def 6 (hprime p hp), ← pow_mul, Nat.mul_comm]
  calc
    (∏ p ∈ S, 3 * p ^ (6 * padicValNat p 6)) =
        3 ^ S.card * (∏ p ∈ S, p ^ (6 * padicValNat p 6)) := by
      rw [Finset.prod_mul_distrib]
      simp
    _ = 3 ^ S.card * (∏ p ∈ S, f p) ^ 6 := by rw [hpowers]
    _ ≤ 3 ^ S.card * 6 ^ 6 := Nat.mul_le_mul_left _ (Nat.pow_le_pow_left hb 6)
    _ = 6 ^ 6 * 3 ^ S.card := Nat.mul_comm _ _

private theorem modulus_product
    (μ z : ℕ) (hμ : μ ≠ 0) :
    let g := Nat.gcd μ z
    let Q := μ ^ 5 / g ^ 4
    0 < Q ∧
      (∏ p ∈ μ.primeFactors,
        p ^ (5 * μ.factorization p - 4 * g.factorization p)) = Q := by
  dsimp only
  let g := Nat.gcd μ z
  let Q := μ ^ 5 / g ^ 4
  have hμpos : 0 < μ := Nat.pos_of_ne_zero hμ
  have hgpos : 0 < g := Nat.gcd_pos_of_pos_left z hμpos
  have hg0 : g ≠ 0 := Nat.ne_of_gt hgpos
  have hg : g ∣ μ := Nat.gcd_dvd_left μ z
  have hg4 : g ^ 4 ∣ μ ^ 5 :=
    (pow_dvd_pow_of_dvd hg 4).trans (pow_dvd_pow μ (by omega))
  have hQpos : 0 < Q :=
    Nat.div_pos (Nat.le_of_dvd (pow_pos hμpos 5) hg4) (pow_pos hgpos 4)
  have hQ0 : Q ≠ 0 := Nat.ne_of_gt hQpos
  have hQdiv : Q ∣ μ ^ 5 :=
    ⟨g ^ 4, (Nat.div_mul_cancel hg4).symm⟩
  have hf (p : ℕ) : Q.factorization p =
      5 * μ.factorization p - 4 * g.factorization p := by
    dsimp [Q]
    simp only [Nat.factorization_div hg4, Nat.factorization_pow,
      Finsupp.tsub_apply, Finsupp.smul_apply, smul_eq_mul]
  have hsubset : Q.primeFactors ⊆ μ.primeFactors := by
    intro p hp
    obtain ⟨hpprime, hpd, _⟩ := Nat.mem_primeFactors.mp hp
    exact Nat.mem_primeFactors.mpr
      ⟨hpprime, hpprime.dvd_of_dvd_pow (hpd.trans hQdiv), hμ⟩
  refine ⟨hQpos, ?_⟩
  calc
    (∏ p ∈ μ.primeFactors,
        p ^ (5 * μ.factorization p - 4 * g.factorization p)) =
        ∏ p ∈ μ.primeFactors, p ^ Q.factorization p := by
      apply Finset.prod_congr rfl
      intro p hp
      rw [hf]
    _ = ∏ p ∈ Q.primeFactors, p ^ Q.factorization p := by
      symm
      apply Finset.prod_subset hsubset
      intro p hp hpnot
      have hnot : ¬ p ∣ Q := by
        intro hd
        exact hpnot (Nat.mem_primeFactors.mpr
          ⟨(Nat.mem_primeFactors.mp hp).1, hd, hQ0⟩)
      simp [Nat.factorization_eq_zero_of_not_dvd hnot]
    _ = Q := (Nat.prod_primeFactors_pow_factorization hQ0).symm

private theorem global_cover
    (a b m q d0 e0 : ℤ) (hab : Int.gcd a b = 1)
    (hm : m ≠ 0) (hbez : a * d0 + b * e0 = 1) :
    let μ : ℕ := m.natAbs
    let g : ℕ := Nat.gcd μ (a * b).natAbs
    let Q : ℕ := μ ^ 5 / g ^ 4
    ∃ R : Finset ℤ, 0 < Q ∧ R.card ≤ 6 ^ 6 * 3 ^ μ.primeFactors.card ∧
      ∀ h : ℤ,
        m ^ 5 ∣ A6Local.NE a b m q d0 e0 h →
        m ^ 5 ∣ A6Local.ND a b m q d0 e0 h →
        ∃ r ∈ R, (Q : ℤ) ∣ h - r := by
  classical
  dsimp only
  let μ : ℕ := m.natAbs
  let g : ℕ := Nat.gcd μ (a * b).natAbs
  let Q : ℕ := μ ^ 5 / g ^ 4
  let mods : ℕ → ℕ :=
    fun p => p ^ (5 * μ.factorization p - 4 * g.factorization p)
  let costs : ℕ → ℕ := fun p => 3 * p ^ (6 * padicValNat p 6)
  let Pred : ℤ → Prop := fun h =>
    m ^ 5 ∣ A6Local.NE a b m q d0 e0 h ∧
    m ^ 5 ∣ A6Local.ND a b m q d0 e0 h
  have hμ0 : μ ≠ 0 := by simpa [μ] using hm
  have hgpos : 0 < g := Nat.gcd_pos_of_pos_left _ (Nat.pos_of_ne_zero hμ0)
  have hg0 : g ≠ 0 := Nat.ne_of_gt hgpos
  have hgdiv : g ∣ μ := Nat.gcd_dvd_left _ _
  have hgab : g ∣ (a * b).natAbs := Nat.gcd_dvd_right _ _
  have hprime (p : ℕ) (hp : p ∈ μ.primeFactors) : p.Prime :=
    (Nat.mem_primeFactors.mp hp).1
  have hpos : ∀ p ∈ μ.primeFactors, 0 < mods p := by
    intro p hp
    exact pow_pos (hprime p hp).pos _
  have hpair : ∀ p ∈ μ.primeFactors, ∀ r ∈ μ.primeFactors,
      p ≠ r → (mods p).Coprime (mods r) := by
    intro p hp r hr hpr
    exact ((Nat.coprime_primes (hprime p hp) (hprime r hr)).mpr hpr).pow _ _
  have hloc : ∀ p ∈ μ.primeFactors, ∃ R : Finset ℤ,
      R.card ≤ costs p ∧ ∀ h, Pred h →
        ∃ r ∈ R, (mods p : ℤ) ∣ h - r := by
    intro p hp
    let : Fact p.Prime := ⟨hprime p hp⟩
    let α := μ.factorization p
    let β := g.factorization p
    have hαdef : α = padicValNat p μ := Nat.factorization_def μ (hprime p hp)
    have hβdef : β = padicValNat p g := Nat.factorization_def g (hprime p hp)
    have hαμ : p ^ α ∣ μ := by rw [hαdef]; exact pow_padicValNat_dvd
    have hα : 0 < α := by
      have hpμ : p ^ 1 ∣ μ := by
        simpa only [pow_one] using (Nat.mem_primeFactors.mp hp).2.1
      have hh := (padicValNat_dvd_iff_le hμ0).mp hpμ
      rw [← hαdef] at hh
      omega
    have hβ : β ≤ α := (Nat.factorization_le_iff_dvd hg0 hμ0).mpr hgdiv p
    have hmv : (p : ℤ) ^ α ∣ m := by
      have hh := Int.natCast_dvd.mpr hαμ
      simpa only [Nat.cast_pow] using hh
    have hmx : ¬ (p : ℤ) ^ (α + 1) ∣ m := by
      intro hd
      have hh : p ^ (α + 1) ∣ μ := Int.natCast_dvd.mp (by
        simpa only [Nat.cast_pow] using hd)
      rw [hαdef] at hh
      exact pow_succ_padicValNat_not_dvd hμ0 hh
    have hβg : p ^ β ∣ g := by rw [hβdef]; exact pow_padicValNat_dvd
    have habv : (p : ℤ) ^ β ∣ a * b := by
      have hh := Int.natCast_dvd.mpr (hβg.trans hgab)
      simpa only [Nat.cast_pow] using hh
    have habx : β < α → ¬ (p : ℤ) ^ (β + 1) ∣ a * b := by
      intro hlt hd
      have hdab : p ^ (β + 1) ∣ (a * b).natAbs :=
        Int.natCast_dvd.mp (by simpa only [Nat.cast_pow] using hd)
      have hdμ : p ^ (β + 1) ∣ μ :=
        (pow_dvd_pow p (by omega)).trans hαμ
      have hdg : p ^ (β + 1) ∣ g := Nat.dvd_gcd hdμ hdab
      rw [hβdef] at hdg
      exact pow_succ_padicValNat_not_dvd hg0 hdg
    obtain ⟨R, hRc, hRv⟩ :=
      A6Local.original_local_cover_padic p α β a b m q d0 e0
        hα hβ hm hmv hmx hab hbez habv habx
    refine ⟨R, hRc, ?_⟩
    intro h hh
    have hv := hRv h hh.1 hh.2
    simpa only [mods, α, β, Nat.cast_pow] using hv
  obtain ⟨R, hRc, hRv⟩ :=
    finite_cover μ.primeFactors mods costs Pred hpos hpair hloc
  have hbudget := exceptional_product_budget μ.primeFactors hprime
  obtain ⟨hQpos, hprod⟩ := modulus_product μ (a * b).natAbs hμ0
  refine ⟨R, hQpos, hRc.trans hbudget, ?_⟩
  intro h he hd
  have hh := hRv h ⟨he, hd⟩
  have heq : (∏ p ∈ μ.primeFactors, mods p) = Q := hprod
  simpa only [heq] using hh

end A6P3CRT
