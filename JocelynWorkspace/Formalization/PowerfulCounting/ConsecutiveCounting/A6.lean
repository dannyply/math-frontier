      nlinarith [mul_nonneg hJR.le (sub_nonneg.mpr hzt)]
  have hd : ∀ z : ℝ, G ((r : ℝ)+(J : ℝ)*z) →
      0 ≤ p.eval z → p.eval z ≤ X → B*(J : ℝ) ≤ |p.derivative.eval z| := by
    intro z hz hz0 hzX
    rw [hpev] at hz0 hzX
    have hh := hder _ hz hz0 hzX
    rw [hpder,abs_mul,abs_of_pos hJR]
    nlinarith [mul_le_mul_of_nonneg_left hh hJR.le]
  have hcount := finite_height_count p d hpdeg X (B*(J : ℝ))
    hX (mul_pos hB hJR) (fun z => G ((r : ℝ)+(J : ℝ)*z)) V hv hseg hd
  rw [hc] at hcount
  have hceil := Nat.ceil_lt_add_one (show 0 ≤ X/(B*(J : ℝ)) by positivity)
  calc
    (Y.card : ℝ) ≤ ((2*d+1 : ℕ) : ℝ)*
        (2*(Nat.ceil (X/(B*(J : ℝ))) : ℝ)+1) := hcount
    _ ≤ ((2*d+1 : ℕ) : ℝ)*(3*(1+X/(B*(J : ℝ)))) := by
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      nlinarith [show 0 ≤ X/(B*(J : ℝ)) by positivity]
    _ = _ := by ring

theorem fixed_progression_diameter_count
    (L : ℝ) (hL : 0 ≤ L) (r J : ℤ) (hJ : 0 < J) (Y : Finset ℤ)
    (hres : ∀ y ∈ Y, ∃ z : ℤ, y = r+J*z)
    (hdiam : ∀ s ∈ Y, ∀ t ∈ Y, |(s : ℝ)-(t : ℝ)| ≤ L) :
    (Y.card : ℝ) ≤ 9*(1+L/(J : ℝ)) := by
  classical
  by_cases he : Y = ∅
  · rw [he,Finset.card_empty,Nat.cast_zero]
    have hJR : 0 < (J : ℝ) := by exact_mod_cast hJ
    positivity
  have hnon := Finset.nonempty_iff_ne_empty.mpr he
  let y₀ : ℤ := Y.min' hnon
  have hy₀ : y₀ ∈ Y := Y.min'_mem hnon
  let p : Polynomial ℝ := Polynomial.X-C (y₀ : ℝ)
  have hdeg : p.natDegree ≤ 1 := by simp only [p,natDegree_sub_C,natDegree_X]; omega
  have hvals : ∀ y ∈ Y, 0 ≤ p.eval (y : ℝ) ∧ p.eval (y : ℝ) ≤ L := by
    intro y hy
    have hmin : y₀ ≤ y := Y.min'_le y hy
    have hminR : (y₀ : ℝ) ≤ (y : ℝ) := by exact_mod_cast hmin
    have hh := hdiam y hy y₀ hy₀
    simp only [p,eval_sub,eval_X,eval_C]
    exact ⟨by linarith,(le_abs_self _).trans hh⟩
  have hh := fixed_progression_height_count p 1 hdeg L 1 hL (by norm_num)
    r J hJ (fun _ => True) Y hres hvals (by simp)
    (by intro z hz hz0 hzL; simp [p])
  norm_num at hh ⊢
  exact hh

theorem finite_residue_cover_count
    (Y R : Finset ℤ) (J : ℤ) (A : ℝ) (hA : 0 ≤ A)
    (hcover : ∀ y ∈ Y, ∃ r ∈ R, ∃ z : ℤ, y=r+J*z)
    (hcount : ∀ r ∈ R,
      (((Y.filter (fun y => ∃ z : ℤ, y=r+J*z)).card : ℕ) : ℝ) ≤ A) :
    (Y.card : ℝ) ≤ (R.card : ℝ)*A := by
  classical
  let F : ℤ → Finset ℤ := fun r => Y.filter (fun y => ∃ z : ℤ, y=r+J*z)
  have hsub : Y ⊆ R.biUnion F := by
    intro y hy
    obtain ⟨r,hr,z,hz⟩ := hcover y hy
    exact Finset.mem_biUnion.mpr ⟨r,hr,Finset.mem_filter.mpr ⟨hy,z,hz⟩⟩
  have hh : Y.card ≤ ∑ r ∈ R, (F r).card :=
    (Finset.card_le_card hsub).trans Finset.card_biUnion_le
  have hhR : (Y.card : ℝ) ≤ ∑ r ∈ R, ((F r).card : ℝ) := by exact_mod_cast hh
  calc
    (Y.card : ℝ) ≤ ∑ r ∈ R, ((F r).card : ℝ) := hhR
    _ ≤ ∑ _r ∈ R, A := Finset.sum_le_sum hcount
    _ = (R.card : ℝ)*A := by simp

theorem integer_abs_ge_one (z : ℤ) (hz : z ≠ 0) : 1 ≤ |(z : ℝ)| := by
  have hh : (1 : ℤ) ≤ |z| := by
    rcases le_total 0 z with hp | hn
    · rw [abs_of_nonneg hp]; omega
    · rw [abs_of_nonpos hn]; omega
  exact_mod_cast hh

theorem modulus_real_data (a b m : ℤ) (hm : m ≠ 0) :
    let mu : ℕ := m.natAbs
    let g : ℕ := Nat.gcd mu (a*b).natAbs
    let Q : ℕ := mu^5/g^4
    0 < Q ∧ 0 < (g : ℝ) ∧ (g : ℝ) ≤ |(m : ℝ)| ∧
      (Q : ℝ)*(g : ℝ)^4=|(m : ℝ)| ^5 := by
  dsimp only
  let mu : ℕ := m.natAbs
  let g : ℕ := Nat.gcd mu (a*b).natAbs
  let Q : ℕ := mu^5/g^4
  have hmu0 : mu ≠ 0 := Int.natAbs_ne_zero.mpr hm
  have hmup : 0 < mu := Nat.pos_of_ne_zero hmu0
  have hgp : 0 < g := Nat.gcd_pos_of_pos_left _ hmup
  have hgdiv : g ∣ mu := Nat.gcd_dvd_left _ _
  have hg4 : g^4 ∣ mu^5 :=
    (pow_dvd_pow_of_dvd hgdiv 4).trans (pow_dvd_pow mu (by omega))
  have hQp : 0 < Q :=
    Nat.div_pos (Nat.le_of_dvd (pow_pos hmup 5) hg4) (pow_pos hgp 4)
  have hqeq : Q*g^4=mu^5 := Nat.div_mul_cancel hg4
  have hmuR : (mu : ℝ)=|(m : ℝ)| := by
    dsimp [mu]
    simpa only [Int.cast_natCast,Int.cast_abs] using
      congrArg (fun z : ℤ => (z : ℝ)) (Int.natCast_natAbs m)
  refine ⟨hQp,by exact_mod_cast hgp,?_,?_⟩
  · rw [←hmuR]
    exact_mod_cast Nat.le_of_dvd hmup hgdiv
  · rw [←hmuR]
    exact_mod_cast hqeq

theorem affine_box_segment (r s lo hi u v z : ℝ)
    (huz : u ≤ z) (hzv : z ≤ v)
    (hu : lo < r+s*u ∧ r+s*u ≤ hi)
    (hv : lo < r+s*v ∧ r+s*v ≤ hi) :
    lo < r+s*z ∧ r+s*z ≤ hi := by
  by_cases hs : 0 ≤ s
  · have h₁ := mul_nonneg hs (sub_nonneg.mpr huz)
    have h₂ := mul_nonneg hs (sub_nonneg.mpr hzv)
    constructor <;> nlinarith
  · have h₁ := mul_nonneg (neg_nonneg.mpr (le_of_not_ge hs)) (sub_nonneg.mpr huz)
    have h₂ := mul_nonneg (neg_nonneg.mpr (le_of_not_ge hs)) (sub_nonneg.mpr hzv)
    constructor <;> nlinarith

theorem box_product (D E d e : ℝ) (hD : 0 < D) (hE : 0 < E)
    (hd : D/2 < d ∧ d ≤ D) (he : E/2 < e ∧ e ≤ E) :
    D*E/4 < d*e ∧ d*e ≤ D*E := by
  have hdp : 0 < d := by linarith
  have hep : 0 < e := by linarith
  constructor
  · nlinarith [mul_pos (sub_pos.mpr hd.1) (half_pos hE),
      mul_pos hdp (sub_pos.mpr he.1)]
  · exact (mul_le_mul_of_nonneg_right hd.2 hep.le).trans
      (mul_le_mul_of_nonneg_left he.2 hD.le)

theorem absolute_cell_diameter
    (dx dy ex ey m D E M C s₀ u v : ℝ)
    (hcross : dy*ex-dx*ey=m*(v-u))
    (hex : 0 < ex) (hey : 0 < ey) (hexE : ex ≤ E) (heyE : ey ≤ E)
    (hm : m ≠ 0) (hD : 0 < D) (hE : 0 < E) (hM : 0 < M) (hC : 0 < C)
    (hcellx : |dx/ex-s₀| ≤ C*D/(E*M))
    (hcelly : |dy/ey-s₀| ≤ C*D/(E*M)) :
    |u-v| ≤ 2*C*D*E/(M*|m|) := by
  have hw : |dy/ey-dx/ex| ≤ 2*C*D/(E*M) := by
    calc
      |dy/ey-dx/ex| = |(dy/ey-s₀)+(s₀-dx/ex)| := by congr 1; ring
      _ ≤ |dy/ey-s₀|+|s₀-dx/ex| := abs_add_le _ _
      _ = |dy/ey-s₀|+|dx/ex-s₀| := by rw [abs_sub_comm s₀]
      _ ≤ C*D/(E*M)+C*D/(E*M) := add_le_add hcelly hcellx
      _ = _ := by ring
  have heq : (2*C*D/(E*M))*E^2/(|m| *1)=2*C*D*E/(M*|m|) := by
    field_simp
    <;> ring
  by_cases huv : u ≤ v
  · have hh := FormalAB.S5a5b0bd5.ConsecutiveCountingA5OriginalAffineInterval.cell_diameter_from_cross dx dy ex ey m 1 E
      (2*C*D/(E*M)) u v (by simpa only [mul_one] using hcross) hex hey hexE heyE hm (by norm_num) huv
      (by positivity) hw
    rw [heq] at hh
    rw [abs_of_nonpos (sub_nonpos.mpr huv)]
    linarith
  · have hvu : v ≤ u := le_of_not_ge huv
    have hcross' : dx*ey-dy*ex=m*(u-v) := by nlinarith only [hcross]
    have hw' : |dx/ex-dy/ey| ≤ 2*C*D/(E*M) := by rwa [abs_sub_comm] at hw
    have hh := FormalAB.S5a5b0bd5.ConsecutiveCountingA5OriginalAffineInterval.cell_diameter_from_cross dy dx ey ex m 1 E
      (2*C*D/(E*M)) v u (by simpa only [mul_one] using hcross') hey hex heyE hexE hm (by norm_num) hvu
      (by positivity) hw'
    rw [heq] at hh
    rw [abs_of_nonneg (sub_nonneg.mpr hvu)]
    exact hh

theorem compile_target : True := by trivial
end A6P3Analysis

