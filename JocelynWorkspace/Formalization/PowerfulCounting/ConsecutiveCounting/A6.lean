theorem cubic_gate :
    ∀ A B : ℕ, B ≤ A → ∀ L : ℝ, 1 ≤ L →
      ∃ C X₀ : ℝ, 0 < C ∧ 2 ≤ X₀ ∧
        ∀ x μ D E U V S₀ : ℝ,
          X₀ ≤ x → (1 / 3 : ℝ) ≤ μ → μ ≤ (1 / 2 : ℝ) →
          0 < D → 0 < E → 0 < U → 0 < V →
          D ^ 3 * U = x → E ^ 3 * V = x →
          (1 / 2 : ℝ) ≤ S₀ → S₀ ≤ 2 →
          ∀ h : ℤ, (h = 1 ∨ h = -1) →
            ∀ d e u v : Cols A B → ℕ,
              (∀ r, 0 < d r ∧ 0 < e r ∧ 0 < u r ∧ 0 < v r ∧
                D ≤ (d r : ℝ) ∧ (d r : ℝ) ≤ 2 * D ∧
                E ≤ (e r : ℝ) ∧ (e r : ℝ) ≤ 2 * E ∧
                U / 8 ≤ (u r : ℝ) ∧ (u r : ℝ) ≤ 8 * U ∧
                V / 8 ≤ (v r : ℝ) ∧ (v r : ℝ) ≤ 8 * V ∧
                |(((d r : ℝ) / (e r : ℝ)) / (D / E)) - S₀| ≤ L * x ^ (-μ) ∧
                (e r : ℤ) ^ 3 * (v r : ℤ) - (d r : ℤ) ^ 3 * (u r : ℤ) = h) →
              |((clearedMatrix A B d e u v).det : ℝ)| ≤
                C * (D * E) ^ xDegreeSum A B * (U * V) ^ yDegreeSum A B *
                  x ^ (-affineSigma A B μ) := by
  classical
  intro A B hBA L hL
  let rowCost : ℝ :=
    ((2 : ℝ) ^ A * (8 : ℝ) ^ B) ^ (Fintype.card (Rect A B))
  let basisCost : ℝ := cubicBasisConstant A B L
  have hrowCost : 0 < rowCost := by dsimp [rowCost]; positivity
  have hbasisCost : 0 < basisCost := cubicBasisConstant_pos A B L hL
  refine ⟨rowCost * basisCost, cubicThreshold L,
    mul_pos hrowCost hbasisCost, ?_, ?_⟩
  · unfold cubicThreshold
    nlinarith [sq_nonneg (8 + L ^ 3)]
  intro x μ D E U V c hx hμlo hμhi hD hE hU hV hbalD hbalE
    hc0 hc1 h hh d e u v hpts
  have hx2 : 2 ≤ x := by
    unfold cubicThreshold at hx
    nlinarith [sq_nonneg (8 + L ^ 3)]
  have hx0 : 0 < x := by linarith
  let S : Cols A B → ℝ := fun r => ((d r : ℝ) / (e r : ℝ)) / (D / E)
  let W : Cols A B → ℝ := fun r => ((v r : ℝ) / (u r : ℝ)) / (V / U)
  have he : ∀ r, 0 < e r := fun r => (hpts r).2.1
  have hu : ∀ r, 0 < u r := fun r => (hpts r).2.2.1
  have hecap : ∀ r, (e r : ℝ) ≤ 2 * E := by
    intro r
    rcases hpts r with ⟨hd, her, hur, hv, hdlo, hdhi, helo, hehi,
      hulo, huhi, hvlo, hvhi, hcell, hsurf⟩
    exact hehi
  have hucap : ∀ r, (u r : ℝ) ≤ 8 * U := by
    intro r
    rcases hpts r with ⟨hd, her, hur, hv, hdlo, hdhi, helo, hehi,
      hulo, huhi, hvlo, hvhi, hcell, hsurf⟩
    exact huhi
  have hS : ∀ r, |S r - c| ≤ L * x ^ (-μ) := by
    intro r
    rcases hpts r with ⟨hd, her, hur, hv, hdlo, hdhi, helo, hehi,
      hulo, huhi, hvlo, hvhi, hcell, hsurf⟩
    exact hcell
  have hhR : |(h : ℝ)| = 1 := by
    rcases hh with rfl | rfl <;> norm_num
  have hW : ∀ r, |W r - (S r) ^ 3| ≤ 8 * x ^ (-1 : ℝ) := by
    intro r
    rcases hpts r with ⟨hd, her, hur, hv, hdlo, hdhi, helo, hehi,
      hulo, huhi, hvlo, hvhi, hcell, hsurf⟩
    have heR : 0 < (e r : ℝ) := by exact_mod_cast her
    have huR : 0 < (u r : ℝ) := by exact_mod_cast hur
    have hsurface :
        (e r : ℝ) ^ 3 * (v r : ℝ) - (d r : ℝ) ^ 3 * (u r : ℝ) = (h : ℝ) := by
      exact_mod_cast hsurf
    have herror := cubic_surface_error
      x D E U V (d r : ℝ) (e r : ℝ) (u r : ℝ) (v r : ℝ) (h : ℝ)
      hx0 hD hE hU hV heR huR hbalD hbalE helo hulo hhR hsurface
    simpa only [S, W, Real.rpow_neg_one, div_eq_mul_inv] using herror
  have hnormal := normalized_cubic_det_bound
    A B hBA L hL x μ c S W hx hμlo hμhi hc0 hc1 hS hW
  have hcleared := original_cleared_det_bound
    A B D E U V hD hE hU hV d e u v he hu hecap hucap
  change |((clearedMatrix A B d e u v).det : ℝ)| ≤
    rowCost * (D * E) ^ xDegreeSum A B * (U * V) ^ yDegreeSum A B *
      |(monomialEvaluationMatrix A B S W).det| at hcleared
  change |(monomialEvaluationMatrix A B S W).det| ≤
    basisCost * x ^ (-affineSigma A B μ) at hnormal
  have hpref :
      0 ≤ rowCost * (D * E) ^ xDegreeSum A B * (U * V) ^ yDegreeSum A B := by
    positivity
  calc
    |((clearedMatrix A B d e u v).det : ℝ)| ≤
        rowCost * (D * E) ^ xDegreeSum A B * (U * V) ^ yDegreeSum A B *
          |(monomialEvaluationMatrix A B S W).det| := hcleared
    _ ≤ rowCost * (D * E) ^ xDegreeSum A B * (U * V) ^ yDegreeSum A B *
        (basisCost * x ^ (-affineSigma A B μ)) :=
      mul_le_mul_of_nonneg_left hnormal hpref
    _ = (rowCost * basisCost) * (D * E) ^ xDegreeSum A B *
        (U * V) ^ yDegreeSum A B * x ^ (-affineSigma A B μ) := by ring

end A6Threshold8CubicDenominator

