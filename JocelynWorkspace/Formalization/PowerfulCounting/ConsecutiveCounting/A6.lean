        mul_le_mul_of_nonneg_right hfac.2 (by positivity)
      _ = 8 * (a * η) := by rfl
  have hquad := normalized_affine_det_small_parameters
    A B (2 * L) t (a * η) c S' W'
    (by linarith) ht ht1 (mul_pos ha0 hη) hη't ht3'
    hc0 hc1 hS' hW'
  have hprofile : t ^ tangentialSum A B * η ^ normalSum A B =
      x ^ (-affineSigma A B μ) := by
    exact rpow_affine_profile A B hBA x μ hx0
  have hquad' :
      |(monomialEvaluationMatrix A B S' W').det| ≤
        (affineBasisConstant A B (2 * L) * a ^ normalSum A B) *
          x ^ (-affineSigma A B μ) := by
    change |(monomialEvaluationMatrix A B S' W').det| ≤
      affineBasisConstant A B (2 * L) *
        t ^ tangentialSum A B * (a * η) ^ normalSum A B at hquad
    calc
      _ ≤ affineBasisConstant A B (2 * L) *
          t ^ tangentialSum A B * (a * η) ^ normalSum A B := hquad
      _ = (affineBasisConstant A B (2 * L) * a ^ normalSum A B) *
          (t ^ tangentialSum A B * η ^ normalSum A B) := by
        rw [mul_pow]
        ring
      _ = _ := by rw [hprofile]
  have hSi : (fun r : Rect A B => (1 / 2 : ℝ) * S' r - (-c / 2)) = S := by
    funext r
    dsimp [S']
    ring
  have hWi :
      (fun r : Rect A B => (3 * c / 4) * W' r - (-(c ^ 3 / 4))) = W := by
    funext r
    dsimp [W']
    field_simp [hc.ne']
    ; ring
  have hdet := monomial_det_affine A B S' W'
    (1 / 2) (3 * c / 4) (-c / 2) (-(c ^ 3 / 4))
  rw [hSi, hWi] at hdet
  have hk0 : 0 ≤ (1 / 2 : ℝ) ^ xDegreeSum A B *
      (3 * c / 4) ^ yDegreeSum A B := by positivity
  have hk : (1 / 2 : ℝ) ^ xDegreeSum A B *
      (3 * c / 4) ^ yDegreeSum A B ≤ (3 / 2 : ℝ) ^ yDegreeSum A B := by
    have hi : (1 / 2 : ℝ) ^ xDegreeSum A B ≤ 1 :=
      pow_le_one₀ (by norm_num) (by norm_num)
    have hj : (3 * c / 4) ^ yDegreeSum A B ≤
        (3 / 2 : ℝ) ^ yDegreeSum A B :=
      pow_le_pow_left₀ (by positivity) (by linarith) _
    calc
      _ ≤ 1 * (3 / 2 : ℝ) ^ yDegreeSum A B :=
        mul_le_mul hi hj (by positivity) (by norm_num)
      _ = _ := by ring
  have hrest : 0 ≤ (affineBasisConstant A B (2 * L) * a ^ normalSum A B) *
      x ^ (-affineSigma A B μ) := by
    have hb := affineBasisConstant_pos A B (2 * L) (by linarith)
    positivity
  calc
    |(monomialEvaluationMatrix A B S W).det| =
        ((1 / 2 : ℝ) ^ xDegreeSum A B * (3 * c / 4) ^ yDegreeSum A B) *
          |(monomialEvaluationMatrix A B S' W').det| := by
      rw [hdet, abs_mul, abs_of_nonneg hk0]
    _ ≤ ((1 / 2 : ℝ) ^ xDegreeSum A B * (3 * c / 4) ^ yDegreeSum A B) *
        ((affineBasisConstant A B (2 * L) * a ^ normalSum A B) *
          x ^ (-affineSigma A B μ)) :=
      mul_le_mul_of_nonneg_left hquad' hk0
    _ ≤ (3 / 2 : ℝ) ^ yDegreeSum A B *
        ((affineBasisConstant A B (2 * L) * a ^ normalSum A B) *
          x ^ (-affineSigma A B μ)) :=
      mul_le_mul_of_nonneg_right hk hrest
    _ = cubicBasisConstant A B L * x ^ (-affineSigma A B μ) := by
      dsimp [cubicBasisConstant, a]
      ring

theorem cubic_gate :
    ∀ A B : ℕ, B ≤ A → ∀ L : ℝ, 1 ≤ L →
      ∃ C X₀ : ℝ, 0 < C ∧ 2 ≤ X₀ ∧
        ∀ x μ D E U V S₀ : ℝ,
          X₀ ≤ x → (1 / 3 : ℝ) ≤ μ → μ ≤ (1 / 2 : ℝ) →
          0 < D → 0 < E → 0 < U → 0 < V →
          D ^ 3 * U = x → E ^ 3 * V = x →
          (1 / 2 : ℝ) ≤ S₀ → S₀ ≤ 2 →
          ∀ h : ℤ, (h = 1 ∨ h = -1) →
            ∀ d e u v : Cols A B → ℕ,
              (∀ r, 0 < d r ∧ 0 < e r ∧ 0 < u r ∧ 0 < v r ∧
                D ≤ (d r : ℝ) ∧ (d r : ℝ) ≤ 2 * D ∧
                E ≤ (e r : ℝ) ∧ (e r : ℝ) ≤ 2 * E ∧
                U / 8 ≤ (u r : ℝ) ∧ (u r : ℝ) ≤ 8 * U ∧
                V / 8 ≤ (v r : ℝ) ∧ (v r : ℝ) ≤ 8 * V ∧
                |(((d r : ℝ) / (e r : ℝ)) / (D / E)) - S₀| ≤ L * x ^ (-μ) ∧
                (e r : ℤ) ^ 3 * (v r : ℤ) - (d r : ℤ) ^ 3 * (u r : ℤ) = h) →
              |((clearedMatrix A B d e u v).det : ℝ)| ≤
                C * (D * E) ^ xDegreeSum A B * (U * V) ^ yDegreeSum A B *
                  x ^ (-affineSigma A B μ) := by
  classical
  intro A B hBA L hL
  let rowCost : ℝ :=
    ((2 : ℝ) ^ A * (8 : ℝ) ^ B) ^ (Fintype.card (Rect A B))
  let basisCost : ℝ := cubicBasisConstant A B L
  have hrowCost : 0 < rowCost := by dsimp [rowCost]; positivity
  have hbasisCost : 0 < basisCost := cubicBasisConstant_pos A B L hL
  refine ⟨rowCost * basisCost, cubicThreshold L,
    mul_pos hrowCost hbasisCost, ?_, ?_⟩
  · unfold cubicThreshold
    nlinarith [sq_nonneg (8 + L ^ 3)]
  intro x μ D E U V c hx hμlo hμhi hD hE hU hV hbalD hbalE
    hc0 hc1 h hh d e u v hpts
  have hx2 : 2 ≤ x := by
    unfold cubicThreshold at hx
    nlinarith [sq_nonneg (8 + L ^ 3)]
  have hx0 : 0 < x := by linarith
  let S : Cols A B → ℝ := fun r => ((d r : ℝ) / (e r : ℝ)) / (D / E)
  let W : Cols A B → ℝ := fun r => ((v r : ℝ) / (u r : ℝ)) / (V / U)
  have he : ∀ r, 0 < e r := fun r => (hpts r).2.1
  have hu : ∀ r, 0 < u r := fun r => (hpts r).2.2.1
  have hecap : ∀ r, (e r : ℝ) ≤ 2 * E := by
    intro r
    rcases hpts r with ⟨hd, her, hur, hv, hdlo, hdhi, helo, hehi,
      hulo, huhi, hvlo, hvhi, hcell, hsurf⟩
    exact hehi
  have hucap : ∀ r, (u r : ℝ) ≤ 8 * U := by
    intro r
    rcases hpts r with ⟨hd, her, hur, hv, hdlo, hdhi, helo, hehi,
      hulo, huhi, hvlo, hvhi, hcell, hsurf⟩
    exact huhi
  have hS : ∀ r, |S r - c| ≤ L * x ^ (-μ) := by
    intro r
    rcases hpts r with ⟨hd, her, hur, hv, hdlo, hdhi, helo, hehi,
      hulo, huhi, hvlo, hvhi, hcell, hsurf⟩
    exact hcell
  have hhR : |(h : ℝ)| = 1 := by
    rcases hh with rfl | rfl <;> norm_num
  have hW : ∀ r, |W r - (S r) ^ 3| ≤ 8 * x ^ (-1 : ℝ) := by
    intro r
    rcases hpts r with ⟨hd, her, hur, hv, hdlo, hdhi, helo, hehi,
      hulo, huhi, hvlo, hvhi, hcell, hsurf⟩
    have heR : 0 < (e r : ℝ) := by exact_mod_cast her
    have huR : 0 < (u r : ℝ) := by exact_mod_cast hur
    have hsurface :
        (e r : ℝ) ^ 3 * (v r : ℝ) - (d r : ℝ) ^ 3 * (u r : ℝ) = (h : ℝ) := by
      exact_mod_cast hsurf
    have herror := cubic_surface_error
      x D E U V (d r : ℝ) (e r : ℝ) (u r : ℝ) (v r : ℝ) (h : ℝ)
      hx0 hD hE hU hV heR huR hbalD hbalE helo hulo hhR hsurface
    simpa only [S, W, Real.rpow_neg_one, div_eq_mul_inv] using herror
  have hnormal := normalized_cubic_det_bound
    A B hBA L hL x μ c S W hx hμlo hμhi hc0 hc1 hS hW
  have hcleared := original_cleared_det_bound
    A B D E U V hD hE hU hV d e u v he hu hecap hucap
  change |((clearedMatrix A B d e u v).det : ℝ)| ≤
    rowCost * (D * E) ^ xDegreeSum A B * (U * V) ^ yDegreeSum A B *
      |(monomialEvaluationMatrix A B S W).det| at hcleared
  change |(monomialEvaluationMatrix A B S W).det| ≤
    basisCost * x ^ (-affineSigma A B μ) at hnormal
  have hpref :
      0 ≤ rowCost * (D * E) ^ xDegreeSum A B * (U * V) ^ yDegreeSum A B := by
    positivity
  calc
    |((clearedMatrix A B d e u v).det : ℝ)| ≤
        rowCost * (D * E) ^ xDegreeSum A B * (U * V) ^ yDegreeSum A B *
          |(monomialEvaluationMatrix A B S W).det| := hcleared
    _ ≤ rowCost * (D * E) ^ xDegreeSum A B * (U * V) ^ yDegreeSum A B *
        (basisCost * x ^ (-affineSigma A B μ)) :=
      mul_le_mul_of_nonneg_left hnormal hpref
    _ = (rowCost * basisCost) * (D * E) ^ xDegreeSum A B *
        (U * V) ^ yDegreeSum A B * x ^ (-affineSigma A B μ) := by ring

end A6Threshold8CubicDenominator

namespace A6Threshold8ActualAuxiliary

open scoped BigOperators

abbrev Point := (ℕ × ℕ) × (ℕ × ℕ)
abbrev Cols (A B : ℕ) := Fin (A + 1) × Fin (B + 1)
abbrev iSum := FormalAB.S9652ac8c.A5AffineFiniteGate.xDegreeSum
abbrev jSum := FormalAB.S9652ac8c.A5AffineFiniteGate.yDegreeSum
abbrev weight := FormalAB.S9652ac8c.A5AffineFiniteGate.affineSigma
abbrev H := FormalAB.S9652ac8c.A5AffineFiniteGate.affineH
abbrev R := FormalAB.S9652ac8c.A5AffineFiniteGate.affineR
abbrev entry := FormalAB.Sb751f117.A5CentralOriginalAuxiliary.entry

def rho (D E : ℝ) (M j : ℕ) : ℝ :=
  D / (2 * E) * (1 + 1 / (M : ℝ)) ^ j

def cells (D E : ℝ) (M : ℕ) : Finset ℕ := by
  classical
  exact (Finset.range (3 * M + 1)).filter
    (fun j => D / (2 * E) ≤ rho D E M j ∧ rho D E M j ≤ 2 * D / E)

def originalCell (x D E : ℝ) (M j : ℕ) (h : ℤ) : Set Point :=
  {z | 1 ≤ z.1.1 ∧ 1 ≤ z.1.2 ∧ 1 ≤ z.2.1 ∧ 1 ≤ z.2.2 ∧
    ((z.1.2 ^ 3 * z.2.2 : ℕ) : ℤ) =
      ((z.1.1 ^ 3 * z.2.1 : ℕ) : ℤ) + h ∧
    x / 2 < ((z.1.1 ^ 3 * z.2.1 : ℕ) : ℝ) ∧
    ((z.1.1 ^ 3 * z.2.1 : ℕ) : ℝ) ≤ x ∧
    D / 2 < (z.1.1 : ℝ) ∧ (z.1.1 : ℝ) ≤ D ∧
    E / 2 < (z.1.2 : ℝ) ∧ (z.1.2 : ℝ) ≤ E ∧
    rho D E M j < (z.1.1 : ℝ) / (z.1.2 : ℝ) ∧
    (z.1.1 : ℝ) / (z.1.2 : ℝ) ≤ rho D E M j * (1 + 1 / (M : ℝ))}

def gate (A B : ℕ) (s : ℝ) : ℝ :=
  (s * (A : ℝ) + (1 - 3 * s) * (B : ℝ) + R A B) /
    ((A : ℝ) + R A B)
def margin (A B : ℕ) (s μ : ℝ) : ℝ :=
  weight A B μ - s * (iSum A B : ℝ) - (2 - 3 * s) * (jSum A B : ℝ)

private lemma mu_bounds (δ : ℝ)
    (hδ : 0 < δ) (hδ' : δ < (1 / 2000 : ℝ)) :
    (1 / 3 : ℝ) ≤ (1 : ℝ) / 3 + δ ∧ (1 : ℝ) / 3 + δ ≤ (1 / 2 : ℝ) := by
  constructor <;> linarith

private lemma right_gate_bound (q' : ℕ) (hq' : 1 ≤ q') (s δ : ℝ)
    (hs : (35 / 81 : ℝ) ≤ s) (hδ : 0 < δ)
    (hqδ : 5 ≤ 3 * (q' : ℝ) * δ) :
    gate (3 * q') (2 * q') s ≤ (1 : ℝ) / 3 + δ / 2 := by
  have hQ1 : (1 : ℝ) ≤ (q' : ℝ) := by exact_mod_cast hq'
  have hQ0 : (0 : ℝ) ≤ (q' : ℝ) := by linarith
  have hA : ((3 * q' : ℕ) : ℝ) = 3 * (q' : ℝ) := by push_cast ; ring
  have hB : ((2 * q' : ℕ) : ℝ) = 2 * (q' : ℝ) := by push_cast ; ring
  have hRdef : R (3 * q') (2 * q') =
      (2 * (q' : ℝ)) * (2 * (q' : ℝ) + 2) / (3 * (3 * (q' : ℝ) + 1)) := by
    show ((2 * q' : ℕ) : ℝ) * (((2 * q' : ℕ) : ℝ) + 2) /
        (3 * (((3 * q' : ℕ) : ℝ) + 1)) = _
    rw [hA, hB]
  have hR0 : 0 ≤ R (3 * q') (2 * q') := by
    rw [hRdef]
    positivity
  have hRle : R (3 * q') (2 * q') ≤ 4 * (q' : ℝ) / 9 + 1 := by
    have hd : (0 : ℝ) < 3 * (3 * (q' : ℝ) + 1) := by positivity
    rw [hRdef, div_le_iff₀ hd]
    nlinarith
  have hden : 0 < ((3 * q' : ℕ) : ℝ) + R (3 * q') (2 * q') := by
    rw [hA]
    linarith
  unfold gate
  rw [div_le_iff₀ hden, hA, hB]
  nlinarith [mul_nonneg (sub_nonneg.mpr hs) hQ0, mul_nonneg hδ.le hR0]

private lemma margin_formula (A B : ℕ) (hA : 1 ≤ A) (hB : B ≤ A)
    (s μ : ℝ) :
    margin A B s μ =
      (H A B : ℝ) * ((A : ℝ) + R A B) * (μ - gate A B s) / 2 := by
  have hd := FormalAB.S9652ac8c.A5AffineFiniteGate.MarginInternal.degree_sum_formula A B
  change 2 * (iSum A B : ℝ) = (H A B : ℝ) * (A : ℝ) ∧
    2 * (jSum A B : ℝ) = (H A B : ℝ) * (B : ℝ) at hd
  have hsigma := FormalAB.S9652ac8c.A5AffineFiniteGate.MarginInternal.affineSigma_formula A B hB μ
  change 2 * weight A B μ =
    (H A B : ℝ) * (μ * (A : ℝ) + (B : ℝ) + (μ - 1) * R A B) at hsigma
  have hi : (iSum A B : ℝ) = (H A B : ℝ) * (A : ℝ) / 2 := by linarith [hd.1]
  have hj : (jSum A B : ℝ) = (H A B : ℝ) * (B : ℝ) / 2 := by linarith [hd.2]
  have hw : weight A B μ =
      (H A B : ℝ) * (μ * (A : ℝ) + (B : ℝ) + (μ - 1) * R A B) / 2 := by
    linarith
  have hAr : (1 : ℝ) ≤ (A : ℝ) := by exact_mod_cast hA
  have hR : 0 ≤ R A B := by
    dsimp [R, FormalAB.S9652ac8c.A5AffineFiniteGate.affineR]
    positivity
  have hden : (A : ℝ) + R A B ≠ 0 := by positivity
  unfold margin gate
  rw [hi, hj, hw]
  field_simp [hden]
  ; ring

private lemma finite_margin_lower (q' : ℕ) (hq' : 1 ≤ q')
    (δ : ℝ) (hδ : 0 < δ) (hqδ : 5 / δ ≤ ((3 * q' : ℕ) : ℝ))
    (s : ℝ) (hs : (35 / 81 : ℝ) ≤ s) :
    δ / 4 ≤ margin (3 * q') (2 * q') s ((1 : ℝ) / 3 + δ) := by
  have hq : 1 ≤ 3 * q' := by omega
  have hBle : 2 * q' ≤ 3 * q' := by omega
  have hqR : (1 : ℝ) ≤ ((3 * q' : ℕ) : ℝ) := by exact_mod_cast hq
  have hδQ : 5 ≤ ((3 * q' : ℕ) : ℝ) * δ := (div_le_iff₀ hδ).mp hqδ
  have hA : ((3 * q' : ℕ) : ℝ) = 3 * (q' : ℝ) := by push_cast ; ring
  have hδQ' : 5 ≤ 3 * (q' : ℝ) * δ := by
    rw [← hA]
    exact hδQ
  have hgate := right_gate_bound q' hq' s δ hs hδ hδQ'
  have hdiff : δ / 2 ≤ (1 : ℝ) / 3 + δ - gate (3 * q') (2 * q') s := by linarith
  have hR : 0 ≤ R (3 * q') (2 * q') := by
    dsimp [R, FormalAB.S9652ac8c.A5AffineFiniteGate.affineR]
    positivity
  have hH : (1 : ℝ) ≤ (H (3 * q') (2 * q') : ℝ) := by
    have hn : (1 : ℕ) ≤ (3 * q' + 1) * (2 * q' + 1) :=
      Nat.succ_le_of_lt (Nat.mul_pos (Nat.succ_pos (3 * q')) (Nat.succ_pos (2 * q')))
    exact_mod_cast hn
  let p : ℝ := (H (3 * q') (2 * q') : ℝ) * (((3 * q' : ℕ) : ℝ) + R (3 * q') (2 * q'))
  have hp : 1 ≤ p := by
    have hqR' : 1 ≤ ((3 * q' : ℕ) : ℝ) + R (3 * q') (2 * q') := by linarith
    have hH0 : 0 ≤ (H (3 * q') (2 * q') : ℝ) := by linarith
    dsimp [p]
    simpa only [one_mul] using
      (mul_le_mul hH hqR' (by norm_num : (0 : ℝ) ≤ 1) hH0)
  have hmul := mul_le_mul_of_nonneg_left hdiff (show 0 ≤ p by linarith)
  have hbase := mul_le_mul_of_nonneg_right hp (show 0 ≤ δ / 4 by linarith)
  rw [margin_formula (3 * q') (2 * q') hq hBle]
  change δ / 4 ≤ p * ((1 : ℝ) / 3 + δ - gate (3 * q') (2 * q') s) / 2
  nlinarith only [hmul, hbase]

private lemma cofactor_window (x D a b : ℝ)
    (_hx : 0 < x) (hD : 0 < D) (ha : 0 ≤ a) (hb : 0 ≤ b)
    (haD : D / 2 < a) (haD' : a ≤ D)
    (hn : x / 4 < a ^ 3 * b) (hn' : a ^ 3 * b ≤ 2 * x) :
    (2 * x / D ^ 3) / 8 ≤ b ∧ b ≤ 8 * (2 * x / D ^ 3) := by
  have hD3 : 0 < D ^ 3 := by positivity
  have hpow : a ^ 3 ≤ D ^ 3 := pow_le_pow_left₀ ha haD' 3
  have hpow' : (D / 2) ^ 3 ≤ a ^ 3 :=
    pow_le_pow_left₀ (by positivity) haD.le 3
  have hl := mul_le_mul_of_nonneg_right hpow hb
  have hu := mul_le_mul_of_nonneg_right hpow' hb
  constructor
  · apply (div_le_iff₀ (by norm_num : (0 : ℝ) < 8)).mpr
    apply (div_le_iff₀ hD3).mpr
    nlinarith
  · rw [← mul_div_assoc]
    apply (le_div_iff₀ hD3).mpr
    nlinarith

private lemma cell_cofactor_windows (x D E : ℝ) (M j : ℕ) (h : ℤ)
    (hx : 8 ≤ x) (hD : 0 < D) (hE : 0 < E)
    (hh : h = 1 ∨ h = -1) (z : Point)
    (hz : z ∈ originalCell x D E M j h) :
    (2 * x / D ^ 3) / 8 ≤ (z.2.1 : ℝ) ∧
      (z.2.1 : ℝ) ≤ 8 * (2 * x / D ^ 3) ∧
      (2 * x / E ^ 3) / 8 ≤ (z.2.2 : ℝ) ∧
      (z.2.2 : ℝ) ≤ 8 * (2 * x / E ^ 3) := by
  rcases hz with ⟨hd, he, hu, hv, hshift, hn, hn', hdD, hdD', heE, heE', -, -⟩
  have hx0 : 0 < x := by linarith
  have hnR : x / 2 < (z.1.1 : ℝ) ^ 3 * (z.2.1 : ℝ) := by exact_mod_cast hn
  have hnR' : (z.1.1 : ℝ) ^ 3 * (z.2.1 : ℝ) ≤ x := by exact_mod_cast hn'
  have hshiftR :
      (z.1.2 : ℝ) ^ 3 * (z.2.2 : ℝ) =
        (z.1.1 : ℝ) ^ 3 * (z.2.1 : ℝ) + (h : ℝ) := by exact_mod_cast hshift
  have hhr : -(1 : ℝ) ≤ (h : ℝ) ∧ (h : ℝ) ≤ 1 := by
    rcases hh with rfl | rfl <;> norm_num
  have huWin := cofactor_window x D (z.1.1 : ℝ) (z.2.1 : ℝ)
    hx0 hD (Nat.cast_nonneg _) (Nat.cast_nonneg _) hdD hdD'
    (by linarith) (by linarith)
  have hvWin := cofactor_window x E (z.1.2 : ℝ) (z.2.2 : ℝ)
    hx0 hE (Nat.cast_nonneg _) (Nat.cast_nonneg _) heE heE'
    (by linarith) (by linarith)
  exact ⟨huWin.1, huWin.2, hvWin.1, hvWin.2⟩

private lemma cell_coordinate_bounds (x D E : ℝ) (M j : ℕ) (h : ℤ)
    (hx : 8 ≤ x) (hh : h = 1 ∨ h = -1) (z : Point)
    (hz : z ∈ originalCell x D E M j h) :
    (z.1.1 : ℝ) ≤ 2 * x ∧ (z.1.2 : ℝ) ≤ 2 * x ∧
      (z.2.1 : ℝ) ≤ 2 * x ∧ (z.2.2 : ℝ) ≤ 2 * x := by
  rcases hz with ⟨hd, he, hu, hv, hshift, -, hn, -⟩
  have hd1 : (1 : ℝ) ≤ (z.1.1 : ℝ) := by exact_mod_cast hd
  have he1 : (1 : ℝ) ≤ (z.1.2 : ℝ) := by exact_mod_cast he
  have hu1 : (1 : ℝ) ≤ (z.2.1 : ℝ) := by exact_mod_cast hu
  have hv1 : (1 : ℝ) ≤ (z.2.2 : ℝ) := by exact_mod_cast hv
  have hnR : (z.1.1 : ℝ) ^ 3 * (z.2.1 : ℝ) ≤ x := by exact_mod_cast hn
  have hshiftR :
      (z.1.2 : ℝ) ^ 3 * (z.2.2 : ℝ) =
        (z.1.1 : ℝ) ^ 3 * (z.2.1 : ℝ) + (h : ℝ) := by exact_mod_cast hshift
  have hhr : (h : ℝ) ≤ 1 := by rcases hh with rfl | rfl <;> norm_num
  have hprodE : (z.1.2 : ℝ) ^ 3 * (z.2.2 : ℝ) ≤ 2 * x := by linarith
  have hd3 : (z.1.1 : ℝ) ≤ (z.1.1 : ℝ) ^ 3 := by
    have hp := pow_le_pow_right₀ hd1 (show (1 : ℕ) ≤ 3 by omega)
    simpa using hp
  have he3 : (z.1.2 : ℝ) ≤ (z.1.2 : ℝ) ^ 3 := by
    have hp := pow_le_pow_right₀ he1 (show (1 : ℕ) ≤ 3 by omega)
    simpa using hp
  have hd31 : (1 : ℝ) ≤ (z.1.1 : ℝ) ^ 3 := one_le_pow₀ hd1
  have he31 : (1 : ℝ) ≤ (z.1.2 : ℝ) ^ 3 := one_le_pow₀ he1
  have hdprod : (z.1.1 : ℝ) ^ 3 ≤ (z.1.1 : ℝ) ^ 3 * (z.2.1 : ℝ) := by
    simpa using mul_le_mul_of_nonneg_left hu1 (pow_nonneg (Nat.cast_nonneg _) 3)
  have heprod : (z.1.2 : ℝ) ^ 3 ≤ (z.1.2 : ℝ) ^ 3 * (z.2.2 : ℝ) := by
    simpa using mul_le_mul_of_nonneg_left hv1 (pow_nonneg (Nat.cast_nonneg _) 3)
  have huprod : (z.2.1 : ℝ) ≤ (z.1.1 : ℝ) ^ 3 * (z.2.1 : ℝ) := by
    simpa using mul_le_mul_of_nonneg_right hd31 (Nat.cast_nonneg z.2.1 : (0 : ℝ) ≤ z.2.1)
  have hvprod : (z.2.2 : ℝ) ≤ (z.1.2 : ℝ) ^ 3 * (z.2.2 : ℝ) := by
    simpa using mul_le_mul_of_nonneg_right he31 (Nat.cast_nonneg z.2.2 : (0 : ℝ) ≤ z.2.2)
  exact ⟨by linarith, he3.trans (heprod.trans hprodE), by linarith, hvprod.trans hprodE⟩

private lemma cell_width (x D E μ : ℝ) (j : ℕ)
    (hx : 8 ≤ x) (hD : 0 < D) (hE : 0 < E)
    (hμ : 0 ≤ μ) (h : ℤ) (z : Point)
    (hj : j ∈ cells D E ⌈x ^ μ⌉₊)
    (hz : z ∈ originalCell x D E ⌈x ^ μ⌉₊ j h) :
    (1 / 2 : ℝ) ≤ rho D E ⌈x ^ μ⌉₊ j / (D / E) ∧
      rho D E ⌈x ^ μ⌉₊ j / (D / E) ≤ 2 ∧
      |((z.1.1 : ℝ) / (z.1.2 : ℝ)) / (D / E) -
          rho D E ⌈x ^ μ⌉₊ j / (D / E)| ≤ 2 * (x / 4) ^ (-μ) := by
  let M : ℕ := ⌈x ^ μ⌉₊
  let r : ℝ := rho D E M j
  let t : ℝ := (z.1.1 : ℝ) / (z.1.2 : ℝ)
  have hx0 : 0 < x := by linarith
  have hp : 0 < x ^ μ := Real.rpow_pos_of_pos hx0 _
  have hceil : x ^ μ ≤ (M : ℝ) := Nat.le_ceil _
  have hM : 0 < (M : ℝ) := hp.trans_le hceil
  have hQ : 0 < D / E := div_pos hD hE
  have hc := (Finset.mem_filter.mp hj).2
  change D / (2 * E) ≤ r ∧ r ≤ 2 * D / E at hc
  rcases hz with ⟨-, -, -, -, -, -, -, -, -, -, -, htlo, hthi⟩
  have ht : r < t ∧ t ≤ r * (1 + 1 / (M : ℝ)) := ⟨htlo, hthi⟩
  have hrlo : (D / E) / 2 ≤ r := by
    convert hc.1 using 1 ; field_simp [hE.ne']
  have hrhi : r ≤ 2 * (D / E) := by
    convert hc.2 using 1 ; field_simp [hE.ne']
  have hdiff : t - r ≤ 2 * (D / E) / (M : ℝ) := by
    have hw : t - r ≤ r / (M : ℝ) := by
      have hid : r * (1 + 1 / (M : ℝ)) = r + r / (M : ℝ) := by ring
      rw [hid] at ht
      linarith
    exact hw.trans (div_le_div_of_nonneg_right hrhi hM.le)
  have habs : |t / (D / E) - r / (D / E)| ≤ 2 / (M : ℝ) := by
    rw [abs_of_nonneg (sub_nonneg.mpr (div_le_div_of_nonneg_right ht.1.le hQ.le))]
    calc
      t / (D / E) - r / (D / E) = (t - r) / (D / E) := by ring
      _ ≤ (2 * (D / E) / (M : ℝ)) / (D / E) :=
        div_le_div_of_nonneg_right hdiff hQ.le
      _ = 2 / (M : ℝ) := by field_simp [hD.ne', hE.ne', hM.ne']
  have hinv : 1 / (M : ℝ) ≤ x ^ (-μ) := by
    apply (div_le_iff₀ hM).mpr
    have hmul : x ^ μ * x ^ (-μ) = 1 := by rw [← Real.rpow_add hx0]; simp
    have hp' := mul_le_mul_of_nonneg_right hceil (Real.rpow_nonneg hx0.le (-μ))
    nlinarith
  have hanti : x ^ (-μ) ≤ (x / 4) ^ (-μ) :=
    Real.rpow_le_rpow_of_nonpos (by linarith) (by linarith) (by linarith)
  refine ⟨?_, ?_, ?_⟩
  · exact (le_div_iff₀ hQ).mpr (by linarith [hrlo])
  · exact (div_le_iff₀ hQ).mpr hrhi
  · change |t / (D / E) - r / (D / E)| ≤ 2 * (x / 4) ^ (-μ)
    calc
      _ ≤ 2 / (M : ℝ) := habs
      _ = 2 * (1 / (M : ℝ)) := by ring
      _ ≤ 2 * x ^ (-μ) := mul_le_mul_of_nonneg_left hinv (by norm_num)
      _ ≤ 2 * (x / 4) ^ (-μ) := mul_le_mul_of_nonneg_left hanti (by norm_num)

private lemma cell_entry_height (A B : ℕ) (hB : B ≤ A)
    (x D E : ℝ) (M j : ℕ) (h : ℤ) (hx : 8 ≤ x)
    (hh : h = 1 ∨ h = -1) (z : Point)
    (hz : z ∈ originalCell x D E M j h) (c : Cols A B) :
    |(entry A B z c : ℝ)| ≤ (2 : ℝ) ^ (2 * A) * x ^ (2 * A) := by
  have hp := cell_coordinate_bounds x D E M j h hx hh z hz
  have heq :
      |(entry A B z c : ℝ)| =
        (z.1.1 : ℝ) ^ (c.1 : ℕ) * (z.1.2 : ℝ) ^ (A - (c.1 : ℕ)) *
        (z.2.2 : ℝ) ^ (c.2 : ℕ) * (z.2.1 : ℝ) ^ (B - (c.2 : ℕ)) := by
    simp only [entry, FormalAB.Sb751f117.A5CentralOriginalAuxiliary.entry,
      Int.cast_mul, Int.cast_pow, Int.cast_natCast]
    exact abs_of_nonneg (by positivity)
  rw [heq]
  calc
    _ ≤ (2 * x) ^ (c.1 : ℕ) * (2 * x) ^ (A - (c.1 : ℕ)) *
        (2 * x) ^ (c.2 : ℕ) * (2 * x) ^ (B - (c.2 : ℕ)) := by
      gcongr <;> first | exact hp.1 | exact hp.2.1 | exact hp.2.2.1 | exact hp.2.2.2
    _ = (2 * x) ^ (A + B) := by
      rw [← pow_add, mul_assoc, ← pow_add, ← pow_add]
      congr 1
      have hi := c.1.isLt
      have hj := c.2.isLt
      omega
    _ ≤ (2 * x) ^ (2 * A) :=
      pow_le_pow_right₀ (by linarith) (by omega)
    _ = _ := by rw [mul_pow]

private lemma scaled_cost_le (A B : ℕ) (_hA : 1 ≤ A) (_hB : B ≤ A)
    (x s μ D E : ℝ) (hx : 0 < x) (hD : 0 < D) (hE : 0 < E)
    (hDE : D * E = x ^ s) (hμ : μ ≤ 1) :
    ((D / 2) * (E / 2)) ^ iSum A B *
        ((2 * x / D ^ 3) * (2 * x / E ^ 3)) ^ jSum A B *
        (x / 4) ^ (-weight A B μ) ≤
      (4 : ℝ) ^ jSum A B * (4 : ℝ) ^ weight A B 1 *
        x ^ (-margin A B s μ) := by
  let U : ℝ := x / D ^ 3
  let V : ℝ := x / E ^ 3
  have hU : 0 < U := by dsimp [U]; positivity
  have hV : 0 < V := by dsimp [V]; positivity
  have hUV : U * V = x ^ (2 - 3 * s) := by
    calc
      U * V = x ^ 2 / (D * E) ^ 3 := by
        dsimp [U, V]
        field_simp

      _ = x ^ (2 : ℝ) / (x ^ s) ^ 3 := by
        rw [hDE]
        norm_num [Real.rpow_natCast]
      _ = x ^ (2 - 3 * s) := by
        rw [← Real.rpow_natCast (x ^ s) 3, ← Real.rpow_mul hx.le,
          ← Real.rpow_sub hx]
        congr 1
        ring
  have hi : (D * E) ^ iSum A B = x ^ (s * (iSum A B : ℝ)) := by
    rw [hDE, Real.rpow_mul hx.le, Real.rpow_natCast]
  have hj : (U * V) ^ jSum A B = x ^ ((2 - 3 * s) * (jSum A B : ℝ)) := by
    rw [hUV, Real.rpow_mul hx.le, Real.rpow_natCast]
  have hprofile :
      (D * E) ^ iSum A B * (U * V) ^ jSum A B *
        x ^ (-weight A B μ) = x ^ (-margin A B s μ) := by
    rw [hi, hj, ← Real.rpow_add hx, ← Real.rpow_add hx]
    congr 1
    unfold margin
    ring
  have hscale :
      (x / 4) ^ (-weight A B μ) =
        (4 : ℝ) ^ weight A B μ * x ^ (-weight A B μ) := by
    rw [Real.div_rpow hx.le (by norm_num)]
    apply (div_eq_iff (Real.rpow_pos_of_pos (by norm_num : (0 : ℝ) < 4) _).ne').mpr
    have ht : (4 : ℝ) ^ weight A B μ * (4 : ℝ) ^ (-weight A B μ) = 1 := by
      rw [← Real.rpow_add (by norm_num : (0 : ℝ) < 4)]
      simp
    calc
      x ^ (-weight A B μ) =
          x ^ (-weight A B μ) *
            ((4 : ℝ) ^ weight A B μ * (4 : ℝ) ^ (-weight A B μ)) := by rw [ht]; ring
      _ = _ := by ring
  have hUVg :
      (2 * x / D ^ 3) * (2 * x / E ^ 3) = 4 * (U * V) := by
    dsimp [U, V]
    ring
  have hDg : ((D / 2) * (E / 2)) ^ iSum A B ≤ (D * E) ^ iSum A B := by
    apply pow_le_pow_left₀ (by positivity)
    have hp := mul_pos hD hE
    nlinarith
  have hrest :
      0 ≤ ((2 * x / D ^ 3) * (2 * x / E ^ 3)) ^ jSum A B *
        (x / 4) ^ (-weight A B μ) := by positivity
  calc
    _ ≤ (D * E) ^ iSum A B *
        ((2 * x / D ^ 3) * (2 * x / E ^ 3)) ^ jSum A B *
        (x / 4) ^ (-weight A B μ) := by
      simpa only [mul_assoc] using mul_le_mul_of_nonneg_right hDg hrest
    _ = (4 : ℝ) ^ jSum A B * (4 : ℝ) ^ weight A B μ *
        ((D * E) ^ iSum A B * (U * V) ^ jSum A B *
          x ^ (-weight A B μ)) := by
      rw [hUVg, mul_pow, hscale]
      ring
    _ = (4 : ℝ) ^ jSum A B * (4 : ℝ) ^ weight A B μ *
        x ^ (-margin A B s μ) := by rw [hprofile]
    _ ≤ _ := by
      have hw :
          weight A B μ ≤ weight A B 1 :=
        FormalAB.Sb751f117.A5CentralOriginalAuxiliary.weight_le_one A B μ hμ
      have hp := Real.rpow_le_rpow_of_exponent_le
        (by norm_num : (1 : ℝ) ≤ 4) hw
      exact mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left hp (by positivity)) (by positivity)

private lemma cell_minor_decay (A B : ℕ) (hA : 1 ≤ A) (hB : B ≤ A) :
    ∃ C X : ℝ, 0 < C ∧ 8 ≤ X ∧
      ∀ x s δ D E : ℝ, X ≤ x →
        (35 / 81 : ℝ) ≤ s → s ≤ (34 / 63 : ℝ) →
        0 < δ → δ < (1 / 2000 : ℝ) →
        0 < D → 0 < E → D * E = x ^ s →
        ∀ j : ℕ, j ∈ cells D E ⌈x ^ ((1 : ℝ) / 3 + δ)⌉₊ →
          ∀ h : ℤ, (h = 1 ∨ h = -1) →
            ∀ z : Cols A B → Point,
              (∀ i, z i ∈ originalCell x D E ⌈x ^ ((1 : ℝ) / 3 + δ)⌉₊ j h) →
              |((Matrix.det (fun i c : Cols A B => entry A B (z i) c) : ℤ) : ℝ)| ≤
                C * x ^ (-margin A B s ((1 : ℝ) / 3 + δ)) := by
  obtain ⟨C, X, hC, hX, hgate⟩ :=
    A6Threshold8CubicDenominator.cubic_gate A B hB 2 (by norm_num)
  let C' : ℝ := C * (4 : ℝ) ^ jSum A B * (4 : ℝ) ^ weight A B 1
  have hC' : 0 < C' := by dsimp [C']; positivity
  refine ⟨C', 4 * X, hC', by linarith, ?_⟩
  intro x s δ D E hx hs hs' hδ hδ' hD hE hDE j hj h hh z hz
  have hx8 : 8 ≤ x := by linarith
  have hx0 : 0 < x := by linarith
  let μ : ℝ := (1 : ℝ) / 3 + δ
  let M : ℕ := ⌈x ^ μ⌉₊
  let S₀ : ℝ := rho D E M j / (D / E)
  have hμ := mu_bounds δ hδ hδ'
  have hμ0 : 0 ≤ μ := by
    show (0 : ℝ) ≤ (1 : ℝ) / 3 + δ
    linarith
  have hμ1 : μ ≤ 1 := by
    show (1 : ℝ) / 3 + δ ≤ 1
    linarith
  have hw₀ := cell_width x D E μ j hx8 hD hE hμ0 h
    (z (0, 0)) hj (hz (0, 0))
  have hdres : (D / 2) ^ 3 * (2 * x / D ^ 3) = x / 4 := by
    field_simp [hD.ne']
    ; ring
  have heres : (E / 2) ^ 3 * (2 * x / E ^ 3) = x / 4 := by
    field_simp [hE.ne']
    ; ring
  have hrows : ∀ r : Cols A B,
      0 < (z r).1.1 ∧ 0 < (z r).1.2 ∧ 0 < (z r).2.1 ∧ 0 < (z r).2.2 ∧
      D / 2 ≤ ((z r).1.1 : ℝ) ∧ ((z r).1.1 : ℝ) ≤ 2 * (D / 2) ∧
      E / 2 ≤ ((z r).1.2 : ℝ) ∧ ((z r).1.2 : ℝ) ≤ 2 * (E / 2) ∧
      (2 * x / D ^ 3) / 8 ≤ ((z r).2.1 : ℝ) ∧
      ((z r).2.1 : ℝ) ≤ 8 * (2 * x / D ^ 3) ∧
      (2 * x / E ^ 3) / 8 ≤ ((z r).2.2 : ℝ) ∧
      ((z r).2.2 : ℝ) ≤ 8 * (2 * x / E ^ 3) ∧
      |((((z r).1.1 : ℝ) / ((z r).1.2 : ℝ)) / ((D / 2) / (E / 2))) - S₀| ≤
        2 * (x / 4) ^ (-μ) ∧
      ((z r).1.2 : ℤ) ^ 3 * ((z r).2.2 : ℤ) -
        ((z r).1.1 : ℤ) ^ 3 * ((z r).2.1 : ℤ) = h := by
    intro r
    have hc := cell_cofactor_windows x D E M j h hx8 hD hE hh (z r) (hz r)
    have hw := cell_width x D E μ j hx8 hD hE hμ0 h (z r) hj (hz r)
    rcases hz r with ⟨hd, he, hu, hv, hshift, -, -, hdD, hdD', heE, heE', -, -⟩
    refine ⟨by omega, by omega, by omega, by omega,
      hdD.le, by linarith, heE.le, by linarith,
      hc.1, hc.2.1, hc.2.2.1, hc.2.2.2, ?_, ?_⟩
    · have hratio : (D / 2) / (E / 2) = D / E := by field_simp [hE.ne']
      rw [hratio]
      exact hw.2.2
    · push_cast at hshift
      linarith
  have hg := hgate (x / 4) μ (D / 2) (E / 2)
    (2 * x / D ^ 3) (2 * x / E ^ 3) S₀
    (by linarith) hμ.1 hμ.2 (by positivity) (by positivity)
    (by positivity) (by positivity) hdres heres hw₀.1 hw₀.2.1
    h hh (fun r => (z r).1.1) (fun r => (z r).1.2)
      (fun r => (z r).2.1) (fun r => (z r).2.2) hrows
  change |((Matrix.det (fun i c : Cols A B => entry A B (z i) c) : ℤ) : ℝ)| ≤
    C * ((D / 2) * (E / 2)) ^ iSum A B *
      ((2 * x / D ^ 3) * (2 * x / E ^ 3)) ^ jSum A B *
      (x / 4) ^ (-weight A B μ) at hg
  have hc := scaled_cost_le A B hA hB x s μ D E hx0 hD hE hDE hμ1
  have hc' := mul_le_mul_of_nonneg_left hc hC.le
  calc
    _ ≤ C * ((D / 2) * (E / 2)) ^ iSum A B *
        ((2 * x / D ^ 3) * (2 * x / E ^ 3)) ^ jSum A B *
        (x / 4) ^ (-weight A B μ) := hg
    _ ≤ C * ((4 : ℝ) ^ jSum A B * (4 : ℝ) ^ weight A B 1 *
        x ^ (-margin A B s μ)) := by simpa only [mul_assoc] using hc'
    _ = C' * x ^ (-margin A B s ((1 : ℝ) / 3 + δ)) := by dsimp [C', μ]; ring

private theorem all_cell_minors_zero (δ : ℝ) (hδ : 0 < δ)
    (hδ' : δ < (1 / 2000 : ℝ)) :
    ∃ q : ℕ, ∃ X₀ : ℝ, 6 ≤ q ∧ 5 / δ ≤ (q : ℝ) ∧ 8 ≤ X₀ ∧
      ∀ x : ℝ, X₀ ≤ x →
        ∀ s : ℝ, (35 / 81 : ℝ) ≤ s → s ≤ (34 / 63 : ℝ) →
          let B : ℕ := 2 * q / 3
          1 ≤ B ∧ B ≤ q ∧
            ∀ D E : ℝ, 0 < D → 0 < E → D * E = x ^ s →
              ∀ j : ℕ, j ∈ cells D E ⌈x ^ ((1 : ℝ) / 3 + δ)⌉₊ →
                ∀ h : ℤ, (h = 1 ∨ h = -1) →
                  ∀ z : Cols q B → Point,
                    (∀ i, z i ∈ originalCell x D E ⌈x ^ ((1 : ℝ) / 3 + δ)⌉₊ j h) →
                    Matrix.det (fun i c : Cols q B => entry q B (z i) c) = 0 := by
  classical
  obtain ⟨q', hqgt⟩ := exists_nat_gt (max (6 : ℝ) (5 / δ))
  have hq6R : (6 : ℝ) < (q' : ℝ) :=
    lt_of_le_of_lt (le_max_left (6 : ℝ) (5 / δ)) hqgt
  have hq'6 : 6 ≤ q' := by exact_mod_cast hq6R.le
  have hq'1 : 1 ≤ q' := by omega
  have hq'δ : 5 / δ ≤ (q' : ℝ) := (le_max_right (6 : ℝ) (5 / δ)).trans hqgt.le
  have hqq : (q' : ℝ) ≤ ((3 * q' : ℕ) : ℝ) := by
    have hle : q' ≤ 3 * q' := by omega
    exact_mod_cast hle
  have hqδ : 5 / δ ≤ ((3 * q' : ℕ) : ℝ) := hq'δ.trans hqq
  have hq6 : 6 ≤ 3 * q' := by omega
  have hq : 1 ≤ 3 * q' := by omega
  have hBeq : 2 * (3 * q') / 3 = 2 * q' := by omega
  have hB1 : 1 ≤ 2 * (3 * q') / 3 := by omega
  have hBle : 2 * (3 * q') / 3 ≤ 3 * q' := by omega
  have hEach : ∀ b : Fin (3 * q' + 1), ∃ C X : ℝ, 0 < C ∧ 8 ≤ X ∧
      ∀ x s δ' D E : ℝ, X ≤ x →
        (35 / 81 : ℝ) ≤ s → s ≤ (34 / 63 : ℝ) →
        0 < δ' → δ' < (1 / 2000 : ℝ) →
        0 < D → 0 < E → D * E = x ^ s →
        ∀ j : ℕ, j ∈ cells D E ⌈x ^ ((1 : ℝ) / 3 + δ')⌉₊ →
          ∀ h : ℤ, (h = 1 ∨ h = -1) →
            ∀ z : Cols (3 * q') b.val → Point,
              (∀ i, z i ∈ originalCell x D E ⌈x ^ ((1 : ℝ) / 3 + δ')⌉₊ j h) →
              |((Matrix.det (fun i c : Cols (3 * q') b.val =>
                  entry (3 * q') b.val (z i) c) : ℤ) : ℝ)| ≤
                C * x ^ (-margin (3 * q') b.val s ((1 : ℝ) / 3 + δ')) := by
    intro b
    exact cell_minor_decay (3 * q') b.val hq (Nat.le_of_lt_succ b.isLt)
  choose C X hC hX hDecay using hEach
  let G : ℝ := 1 + ∑ b : Fin (3 * q' + 1), C b
  let W : ℝ := 8 + ∑ b : Fin (3 * q' + 1), X b
  have hG : 0 < G := by
    dsimp [G]
    have hn : 0 ≤ ∑ b : Fin (3 * q' + 1), C b :=
      Finset.sum_nonneg (by intro b hb; exact (hC b).le)
    linarith
  have hW : 8 ≤ W := by
    dsimp [W]
    have hn : 0 ≤ ∑ b : Fin (3 * q' + 1), X b :=
      Finset.sum_nonneg (by intro b hb; linarith [hX b])
    linarith
  have hCG : ∀ b : Fin (3 * q' + 1), C b ≤ G := by
    intro b
    have hb : C b ≤ ∑ t : Fin (3 * q' + 1), C t :=
      Finset.single_le_sum (by intro t ht; exact (hC t).le) (Finset.mem_univ b)
    dsimp [G]
    linarith
  have hXW : ∀ b : Fin (3 * q' + 1), X b ≤ W := by
    intro b
    have hb : X b ≤ ∑ t : Fin (3 * q' + 1), X t :=
      Finset.single_le_sum (by intro t ht; linarith [hX t]) (Finset.mem_univ b)
    dsimp [W]
    linarith
  let τ : ℝ := δ / 4
  have hτ : 0 < τ := by dsimp [τ]; linarith
  let X₀ : ℝ := max W ((2 * G) ^ (1 / τ))
  have hX₀ : 8 ≤ X₀ := hW.trans (le_max_left _ _)
  refine ⟨3 * q', X₀, hq6, hqδ, hX₀, ?_⟩
  intro x hx s hs hs'
  let B : ℕ := 2 * (3 * q') / 3
  have hm : δ / 4 ≤ margin (3 * q') B s ((1 : ℝ) / 3 + δ) := by
    have hBB : B = 2 * q' := hBeq
    rw [hBB]
    exact finite_margin_lower q' hq'1 δ hδ hqδ s hs
  refine ⟨hB1, hBle, ?_⟩
  intro D E hD hE hDE j hj h hh z hz
  have hxW : W ≤ x := (le_max_left _ _).trans hx
  have hx8 : 8 ≤ x := hX₀.trans hx
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  let b : Fin (3 * q' + 1) := ⟨B, Nat.lt_succ_of_le hBle⟩
  have hd := hDecay b x s δ D E ((hXW b).trans hxW)
    hs hs' hδ hδ' hD hE hDE j hj h hh z hz
  have hmargin : τ ≤ margin (3 * q') B s ((1 : ℝ) / 3 + δ) := hm
  have hexp : x ^ (-margin (3 * q') B s ((1 : ℝ) / 3 + δ)) ≤ x ^ (-τ) :=
    Real.rpow_le_rpow_of_exponent_le hx1 (by linarith)
  have hpow : 2 * G ≤ x ^ τ := by
    have hbase : 0 < 2 * G := by positivity
    have hxx : (2 * G) ^ (1 / τ) ≤ x := (le_max_right _ _).trans hx
    have hmono := Real.rpow_le_rpow (Real.rpow_nonneg hbase.le _) hxx hτ.le
    have hid : ((2 * G) ^ (1 / τ)) ^ τ = 2 * G := by
      rw [← Real.rpow_mul hbase.le]
      have heq : (1 / τ) * τ = 1 := by field_simp [hτ.ne']
      rw [heq, Real.rpow_one]
    rwa [hid] at hmono
  have hunit : x ^ τ * x ^ (-τ) = 1 := by rw [← Real.rpow_add hx0]; simp
  have hprice : G * x ^ (-τ) ≤ (1 / 2 : ℝ) := by
    have hp := mul_le_mul_of_nonneg_right hpow (Real.rpow_nonneg hx0.le (-τ))
    nlinarith
  have hsmall :
      |((Matrix.det (fun i c : Cols (3 * q') B => entry (3 * q') B (z i) c) : ℤ) : ℝ)| < 1 := by
    calc
      _ ≤ C b * x ^ (-margin (3 * q') B s ((1 : ℝ) / 3 + δ)) := hd
      _ ≤ G * x ^ (-margin (3 * q') B s ((1 : ℝ) / 3 + δ)) :=
        mul_le_mul_of_nonneg_right (hCG b) (Real.rpow_nonneg hx0.le _)
      _ ≤ G * x ^ (-τ) := mul_le_mul_of_nonneg_left hexp hG.le
      _ ≤ 1 / 2 := hprice
      _ < 1 := by norm_num
  have hint :
      |Matrix.det (fun i c : Cols (3 * q') B => entry (3 * q') B (z i) c)| < (1 : ℤ) := by
    exact_mod_cast hsmall
  have hzero : Matrix.det (fun i c : Cols (3 * q') B => entry (3 * q') B (z i) c) = 0 := by
    have hp := abs_lt.mp hint
    omega
  exact hzero

abbrev heightPower := FormalAB.Sb751f117.A5CentralOriginalAuxiliary.heightPower
abbrev heightThreshold := FormalAB.Sb751f117.A5CentralOriginalAuxiliary.heightThreshold

def Statement : Prop :=
  ∀ δ : ℝ, 0 < δ → δ < (1 / 2000 : ℝ) → ∃ q : ℕ, ∃ K X₀ : ℝ, 6 ≤ q ∧ 5 / δ ≤ (q : ℝ) ∧ 0 < K ∧ 8 ≤ X₀ ∧ ∀ x : ℝ, X₀ ≤ x → ∀ s : ℝ, (35 / 81 : ℝ) ≤ s → s ≤ (34 / 63 : ℝ) → ∀ D E : ℝ, 0 < D → 0 < E → D * E = x ^ s → let B : ℕ := 2 * q / 3; let M : ℕ := ⌈x ^ ((1 : ℝ) / 3 + δ)⌉₊; 1 ≤ B ∧ B ≤ q ∧ ∀ j : ℕ, j ∈ cells D E M → ∀ h : ℤ, (h = 1 ∨ h = -1) → ∃ F : MvPolynomial (Fin 4) ℤ, F ≠ 0 ∧ (∀ m ∈ F.support, m 0 + m 1 = q ∧ m 2 + m 3 = B) ∧ F.totalDegree ≤ q + B ∧ (∀ m : Fin 4 →₀ ℕ, |((F.coeff m : ℤ) : ℝ)| ≤ x ^ K) ∧ ∀ z ∈ originalCell x D E M j h, MvPolynomial.eval ![(z.1.1 : ℤ), (z.1.2 : ℤ), (z.2.1 : ℤ), (z.2.2 : ℤ)] F = 0

theorem main : Statement := by
  intro δ hδ hδ'
  obtain ⟨q, X, hq, hqδ, hX, hminor⟩ := all_cell_minors_zero δ hδ hδ'
  let K : ℝ := (heightPower q : ℝ)
  let X₀ : ℝ := max X (heightThreshold q)
  have hX₀ : (8 : ℝ) ≤ X₀ := hX.trans (le_max_left _ _)
  have hK : 0 < K := by
    dsimp [K, heightPower, FormalAB.Sb751f117.A5CentralOriginalAuxiliary.heightPower]
    positivity
  refine ⟨q, K, X₀, hq, hqδ, hK, hX₀, ?_⟩
  intro x hx s hs hs' D E hD hE hDE
  let B : ℕ := 2 * q / 3
  let M : ℕ := ⌈x ^ ((1 : ℝ) / 3 + δ)⌉₊
  have hxX : X ≤ x := (le_max_left _ _).trans hx
  have hx8 : (8 : ℝ) ≤ x := hX₀.trans hx
  have hh := hminor x hxX s hs hs'
  change 1 ≤ B ∧ B ≤ q ∧ _ at hh
  refine ⟨hh.1, hh.2.1, ?_⟩
  intro j hj h hsign
  have hrows : ∀ z ∈ originalCell x D E M j h, ∀ c : Cols q B,
      |(entry q B z c : ℝ)| ≤ (2 : ℝ) ^ (2 * q) * x ^ (2 * q) := by
    intro z hz c
    exact cell_entry_height q B hh.2.1 x D E M j h hx8 hsign z hz c
  have hmin :
      ∀ z : Cols q B → Point,
        (∀ i, z i ∈ originalCell x D E M j h) →
        Matrix.det (fun i c : Cols q B => entry q B (z i) c) = 0 :=
    hh.2.2 D E hD hE hDE j hj h hsign
  have hhgt : heightThreshold q ≤ x := (le_max_right _ _).trans hx
  exact FormalAB.Sb751f117.A5CentralOriginalAuxiliary.all_point_polynomial
    q B hh.2.1 x (by linarith) hhgt (originalCell x D E M j h) hrows hmin

end A6Threshold8ActualAuxiliary

