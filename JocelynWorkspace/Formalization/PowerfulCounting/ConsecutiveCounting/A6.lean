    rcases hz with ⟨hd,he,hu,hv,hshift,hnlo,hnup,hDlo,hDup,hElo,hEup,hrlo,hrup⟩
    have hcast : (fun i : Fin 4=>((toVector z i:ℕ):ℤ))=
        ![(z.1.1:ℤ),(z.1.2:ℤ),(z.2.1:ℤ),(z.2.2:ℤ)] := by
      funext i
      fin_cases i <;> rfl
    refine ⟨?_,?_,?_,hDlo,hDup,hElo,hEup,?_⟩
    · intro i
      fin_cases i
      · show 0<z.1.1
        omega
      · show 0<z.1.2
        omega
      · show 0<z.2.1
        omega
      · show 0<z.2.2
        omega
    · change z.1.2^3*z.2.2=z.1.1^3*z.2.1+1
      exact_mod_cast hshift
    · change (z.1.1:ℝ)^3*(z.2.1:ℝ)≤x
      simpa only [Nat.cast_mul,Nat.cast_pow] using hnup
    · rw [hcast]
      exact hzero
  have hinj : Set.InjOn toVector (factorCellOutside x D E M j G) :=
    toVector_injective.injOn
  have hfin := Set.Finite.of_injOn hmap hinj hT.1
  have hn := Set.ncard_le_ncard_of_injOn toVector hmap hinj hT.1
  exact ⟨hfin,(by exact_mod_cast hn : 
    ((factorCellOutside x D E M j G).ncard:ℝ)≤
      ((residualPopulation x D E G).ncard:ℝ)).trans hT.2⟩

