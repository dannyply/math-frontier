      mul_le_mul_of_nonneg_right (le_max_right _ _) (Real.rpow_nonneg (Nat.cast_nonneg N) _)

theorem fixed_progression_height_count
    (N : Polynomial ℝ) (d : ℕ) (hdeg : N.natDegree ≤ d)
    (X B : ℝ) (hX : 0 ≤ X) (hB : 0 < B)
    (r J : ℤ) (hJ : 0 < J) (G : ℝ → Prop) (Y : Finset ℤ)
    (hres : ∀ y ∈ Y, ∃ z : ℤ, y = r+J*z)
    (hvals : ∀ y ∈ Y, 0 ≤ N.eval (y : ℝ) ∧ N.eval (y : ℝ) ≤ X)
