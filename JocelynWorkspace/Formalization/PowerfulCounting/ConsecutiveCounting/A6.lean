        mul_le_mul_of_nonneg_left
          (Real.rpow_le_rpow_of_exponent_le hx1 hμhi) (by norm_num)
      _ ≤ x ^ ((1 : ℝ) / 100) * x ^ ((39 : ℝ) / 100) :=
        mul_le_mul_of_nonneg_right hsmallpow (by positivity)
