namespace P7I
private theorem compact_six_margins
 (s m:O) (hs:(21 / 50:O) ≤ s) (hs':s ≤ (35 / 81:O))
 (hm:(1 / 3:O) ≤ m) (hm':m ≤ (43 / 125:O)):
 (0:O) < 3 / 100 ∧
 (23 / 1375:O) ≤ 4 * (s - m - 3 / 100) / 11 ∧
 (13 / 525:O) ≤ (28 * (3 / 100) + 16 * m - 6) / 7 ∧
 (1109 / 5670:O) ≤ (30 * (3 / 100) - 2 * s - 8) / 7 + 4 * m ∧
 (83 / 1620:O) ≤ 5 * (3 / 100) + 4 * m - s - 1 ∧
 (4 / 21:O) ≤ (10 * m - 2) / 7:=by
  refine ⟨by norm_num,?_,?_,?_,?_,?_⟩ <;> linarith
private def pPart (a b d e:I):I:=
  b ^ 7 * e ^ 4 + 7 * a * b ^ 6 * d * e ^ 3 +
    21 * a ^ 2 * b ^ 5 * d ^ 2 * e ^ 2
private def qPart (a b d e:I):I:=
  35 * a ^ 3 * b ^ 4 * e ^ 4 +
    35 * a ^ 4 * b ^ 3 * d * e ^ 3 +
    21 * a ^ 5 * b ^ 2 * d ^ 2 * e ^ 2 +
    7 * a ^ 6 * b * d ^ 3 * e + a ^ 7 * d ^ 4
private def pNF (a b c R S d e:I):I:=
  c * pPart a b d e + d ^ 3 * (R * e + S * d)
private def qNF (a b c R S d e:I):I:=
  e ^ 3 * (R * e + S * d) - c * qPart a b d e
private def co (a b c R S:I):I:=
  b * S - a * R + 15 * c * a ^ 4 * b ^ 4
private theorem cp (a b c R S d e:I):
 e ^ 3 * pNF a b c R S d e - d ^ 3 * qNF a b c R S d e =
 c * (a * d + b * e) ^ 7:=by
  dsimp [pNF,qNF,pPart,qPart]
  ring
private theorem cq (a b c R S:I):
 pNF a b c R S b (-a) = b ^ 3 * co a b c R S ∧
 qNF a b c R S b (-a) = -a ^ 3 * co a b c R S:=by
  constructor <;> dsimp [pNF,qNF,pPart,qPart,co] <;> ring
private theorem cr
 (d e u v p q c ell:I)
 (hF:e ^ 3 * v = d ^ 3 * u + 1)
 (hG:p * u - q * v = 0)
 (hH:e ^ 3 * p - d ^ 3 * q = c * ell ^ 7):
 p = c * ell ^ 7 * v ∧ q = c * ell ^ 7 * u:=by
  constructor
  · linear_combination v * hH - p * hF - d ^ 3 * hG
  · linear_combination u * hH - q * hF - e ^ 3 * hG
private theorem cs (d e u v:I)
 (hF:e ^ 3 * v = d ^ 3 * u + 1):
 (-d ^ 2 * u) * d + (e ^ 2 * v) * e = 1:=by
  linear_combination hF
private theorem ct (d e u v c J:I)
 (hF:e ^ 3 * v = d ^ 3 * u + 1)
 (hd:c ∣ d ^ 3 * J) (he:c ∣ e ^ 3 * J):c ∣ J:=by
  rcases hd with ⟨p,hp⟩
  rcases he with ⟨q,hq⟩
  refine ⟨q * v - p * u,?_⟩
  calc
    J = (e ^ 3 * J) * v - (d ^ 3 * J) * u:=by
      linear_combination -J * hF
    _ = c * (q * v - p * u):=by rw [hp,hq];ring
private theorem cu
 (a b c R S d e u v:I)
 (hF:e ^ 3 * v = d ^ 3 * u + 1)
 (hp:c ∣ pNF a b c R S d e)
 (hq:c ∣ qNF a b c R S d e):
 c ∣ R * e + S * d:=by
  rcases hp with ⟨p,hp⟩
  rcases hq with ⟨q,hq⟩
  have hd:c ∣ d ^ 3 * (R * e + S * d):=by
    refine ⟨p - pPart a b d e,?_⟩
    dsimp [pNF] at hp
    linear_combination hp
  have he:c ∣ e ^ 3 * (R * e + S * d):=by
    refine ⟨q + qPart a b d e,?_⟩
    dsimp [qNF] at hq
    linear_combination hq
  exact ct d e u v c (R * e + S * d) hF hd he
private theorem cv
 {R:Type*} [CommRing R]
 (p₀ p₁ p₂ p₃ p₄ a b d e:R):
 a * d + b * e ∣
 b ^ 4 * (p₀ * d ^ 4 + p₁ * d ^ 3 * e + p₂ * d ^ 2 * e ^ 2 +
 p₃ * d * e ^ 3 + p₄ * e ^ 4) -
 d ^ 4 * (p₀ * b ^ 4 - p₁ * a * b ^ 3 + p₂ * a ^ 2 * b ^ 2 -
 p₃ * a ^ 3 * b + p₄ * a ^ 4):=by
  refine ⟨p₁ * b ^ 3 * d ^ 3 +
    p₂ * b ^ 2 * d ^ 2 * (b * e - a * d) +
    p₃ * b * d * ((b * e) ^ 2 - a * d * b * e + (a * d) ^ 2) +
    p₄ * ((b * e) ^ 3 - a * d * (b * e) ^ 2 +
      (a * d) ^ 2 * b * e - (a * d) ^ 3),?_⟩
  ring
private theorem cw
 (a b d e A B r s:I)
 (hab:A * a + B * b = 1) (hde:r * d + s * e = 1):
 ∃ iU V W:I,
 (a * d + b * e) * iU + (b * d) * V + (a * e) * W = 1:=by
  let α:I:= A * r
  let β:I:= A * s
  let γ:I:= B * r
  let δ:I:= B * s - A * r
  let L:I:= a * d + b * e
  let z:I:= b * e
  let x:I:= b * d
  let y:I:= a * e
  have ht:α * L + δ * z + β * y + γ * x = 1:=by
    calc
      _ = (A * a + B * b) * (r * d + s * e):=by
        dsimp [α,β,γ,δ,L,z,x,y]
        ring
      _ = 1:=by rw [hab,hde];norm_num
  refine ⟨α * (2 - α * L) + δ ^ 2 * z,
    γ ^ 2 * x + 2 * δ * γ * z + 2 * β * γ * y - δ ^ 2 * y,
    β ^ 2 * y + 2 * δ * β * z,?_⟩
  dsimp [α,β,γ,δ,L,z,x,y] at ht ⊢
  linear_combination
    ((A * r) * (a * d + b * e) +
      (B * s - A * r) * (b * e) + (A * s) * (a * e) +
      (B * r) * (b * d) + 1 - 2 * (A * r) * (a * d + b * e)) * ht
private theorem cx
 (N k x y A B C:I)
 (hbez:N * A + x * B + y * C = 1)
 (hx:N ∣ k * x ^ 4) (hy:N ∣ k * y ^ 4):N ∣ k:=by
  rcases hx with ⟨r,hr⟩
  rcases hy with ⟨s,hs⟩
  let X:I:= x * B
  let Y:I:= y * C
  let z:I:= X + Y
  let P:I:= X ^ 3 + 7 * X ^ 2 * Y + 21 * X * Y ^ 2 + 35 * Y ^ 3
  let Q:I:= 35 * X ^ 3 + 21 * X ^ 2 * Y + 7 * X * Y ^ 2 + Y ^ 3
  let T:I:= 1 + z + z ^ 2 + z ^ 3 + z ^ 4 + z ^ 5 + z ^ 6
  refine ⟨r * B ^ 4 * P + s * C ^ 4 * Q + k * A * T,?_⟩
  calc
    k = k * z ^ 7 + k * (1 - z) * T:=by dsimp [T];ring
    _ = (k * x ^ 4) * B ^ 4 * P + (k * y ^ 4) * C ^ 4 * Q +
        k * N * A * T:=by
      dsimp [P,Q,T,z,X,Y]
      linear_combination
        -k * (1 + (x * B + y * C) + (x * B + y * C) ^ 2 +
          (x * B + y * C) ^ 3 + (x * B + y * C) ^ 4 +
          (x * B + y * C) ^ 5 + (x * B + y * C) ^ 6) * hbez
    _ = N * (r * B ^ 4 * P + s * C ^ 4 * Q + k * A * T):=by
      rw [hr,hs]
      ring
private theorem cy
 (a b c R S d e A B r s:I)
 (hab:A * a + B * b = 1) (hde:r * d + s * e = 1)
 (hp:a * d + b * e ∣ pNF a b c R S d e)
 (hq:a * d + b * e ∣ qNF a b c R S d e):
 a * d + b * e ∣ co a b c R S:=by
  have hprem:a * d + b * e ∣
      b ^ 4 * pNF a b c R S d e -
        d ^ 4 * (b ^ 3 * co a b c R S):=by
    obtain ⟨t,ht⟩:= cv S R
      (21 * c * a ^ 2 * b ^ 5) (7 * c * a * b ^ 6)
      (c * b ^ 7) a b d e
    refine ⟨t,?_⟩
    dsimp [pNF,pPart,co]
    linear_combination ht
  have hqrem:a * d + b * e ∣
      a ^ 4 * qNF a b c R S d e +
        e ^ 4 * (a ^ 3 * co a b c R S):=by
    obtain ⟨t,ht⟩:= cv
      (R - 35 * c * a ^ 3 * b ^ 4)
      (S - 35 * c * a ^ 4 * b ^ 3)
      (-(21 * c * a ^ 5 * b ^ 2)) (-(7 * c * a ^ 6 * b))
      (-(c * a ^ 7)) b a e d
    refine ⟨t,?_⟩
    dsimp [qNF,qPart,co]
    linear_combination ht
  have hpx:a * d + b * e ∣ d ^ 4 * (b ^ 3 * co a b c R S):=by
    have h:= dvd_sub (bj hp (b ^ 4)) hprem
    obtain ⟨t,ht⟩:= h
    refine ⟨t,?_⟩
    linear_combination ht
  have hqy:a * d + b * e ∣ e ^ 4 * (a ^ 3 * co a b c R S):=by
    have h:= dvd_sub hqrem (bj hq (a ^ 4))
    obtain ⟨t,ht⟩:= h
    refine ⟨t,?_⟩
    linear_combination ht
  have hx:a * d + b * e ∣ co a b c R S * (b * d) ^ 4:=by
    have h:= bj hpx b
    obtain ⟨t,ht⟩:= h
    refine ⟨t,?_⟩
    linear_combination ht
  have hy:a * d + b * e ∣ co a b c R S * (a * e) ^ 4:=by
    have h:= bj hqy a
    obtain ⟨t,ht⟩:= h
    refine ⟨t,?_⟩
    linear_combination ht
  obtain ⟨iU,V,W,hbez⟩:= cw a b d e A B r s hab hde
  exact cx
    (a * d + b * e) (co a b c R S) (b * d) (a * e)
    iU V W hbez hx hy
private noncomputable abbrev m40:Fin 2 →₀ U:= ao 0 4
private noncomputable abbrev m31:Fin 2 →₀ U:= ao 0 3 + ao 1 1
private noncomputable abbrev m22:Fin 2 →₀ U:= ao 0 2 + ao 1 2
private noncomputable abbrev m13:Fin 2 →₀ U:= ao 0 1 + ao 1 3
private noncomputable abbrev m04:Fin 2 →₀ U:= ao 1 4
private theorem cz (t:Fin 2 →₀ U)
 (ht:Finsupp.degree t = 4):
 t = m40 ∨ t = m31 ∨ t = m22 ∨ t = m13 ∨ t = m04:=by
  have hs:t 0 + t 1 = 4:=by
    simpa [Finsupp.degree_eq_sum,Fin.sum_univ_two] using ht
  have hcase:t 0 = 0 ∨ t 0 = 1 ∨ t 0 = 2 ∨ t 0 = 3 ∨ t 0 = 4:=by omega
  rcases hcase with h0 | h1 | h2 | h3 | h4
  · right;right;right;right
    ext i;fin_cases i <;> simp [m04,aP] <;> omega
  · right;right;right;left
    ext i;fin_cases i <;> simp [m13,aP,aw] <;> omega
  · right;right;left
    ext i;fin_cases i <;> simp [m22,aP,aw] <;> omega
  · right;left
    ext i;fin_cases i <;> simp [m31,aP,aw] <;> omega
  · left
    ext i;fin_cases i <;> simp [m40,aP] <;> omega
private theorem cA (P:ab)
 (hP:P.IsHomogeneous 4):
 P = aA m40 (P.coeff m40) +
 aA m31 (P.coeff m31) +
 aA m22 (P.coeff m22) +
 aA m13 (P.coeff m13) +
 aA m04 (P.coeff m04):=by
  classical
  ext t
  simp only [ba,av]
  have hd01:m40 ≠ m31:=by
    intro h
    have h0:= congrArg (fun z:Fin 2 →₀ U => z 0) h
    norm_num [m40,m31,m22,m13,m04,aw] at h0
  have hd02:m40 ≠ m22:=by
    intro h
    have h0:= congrArg (fun z:Fin 2 →₀ U => z 0) h
    norm_num [m40,m31,m22,m13,m04,aw] at h0
  have hd03:m40 ≠ m13:=by
    intro h
    have h0:= congrArg (fun z:Fin 2 →₀ U => z 0) h
    norm_num [m40,m31,m22,m13,m04,aw] at h0
  have hd04:m40 ≠ m04:=by
    intro h
    have h0:= congrArg (fun z:Fin 2 →₀ U => z 0) h
    norm_num [m40,m31,m22,m13,m04,aw] at h0
  have hd12:m31 ≠ m22:=by
    intro h
    have h0:= congrArg (fun z:Fin 2 →₀ U => z 0) h
    norm_num [m40,m31,m22,m13,m04,aw] at h0
  have hd13:m31 ≠ m13:=by
    intro h
    have h0:= congrArg (fun z:Fin 2 →₀ U => z 0) h
    norm_num [m40,m31,m22,m13,m04,aw] at h0
  have hd14:m31 ≠ m04:=by
    intro h
    have h0:= congrArg (fun z:Fin 2 →₀ U => z 0) h
    norm_num [m40,m31,m22,m13,m04,aw] at h0
  have hd23:m22 ≠ m13:=by
    intro h
    have h0:= congrArg (fun z:Fin 2 →₀ U => z 0) h
    norm_num [m40,m31,m22,m13,m04,aw] at h0
  have hd24:m22 ≠ m04:=by
    intro h
    have h0:= congrArg (fun z:Fin 2 →₀ U => z 0) h
    norm_num [m40,m31,m22,m13,m04,aw] at h0
  have hd34:m13 ≠ m04:=by
    intro h
    have h0:= congrArg (fun z:Fin 2 →₀ U => z 0) h
    norm_num [m40,m31,m22,m13,m04,aw] at h0
  by_cases h0:m40 = t
  · subst t
    simp [Ne.symm hd01,Ne.symm hd02,Ne.symm hd03,Ne.symm hd04]
  by_cases h1:m31 = t
  · subst t
    simp [hd01,Ne.symm hd12,Ne.symm hd13,Ne.symm hd14]
  by_cases h2:m22 = t
  · subst t
    simp [hd02,hd12,Ne.symm hd23,Ne.symm hd24]
  by_cases h3:m13 = t
  · subst t
    simp [hd03,hd13,hd23,Ne.symm hd34]
  by_cases h4:m04 = t
  · subst t
    simp [hd04,hd14,hd24,hd34]
  have hz:P.coeff t = 0:=by
    by_contra hc
    have hdeg:Finsupp.degree t = 4:=by
      by_contra hneq
      exact hc (hP.coeff_eq_zero hneq)
    rcases cz t hdeg with hh | hh | hh | hh | hh
    · exact h0 hh.symm
    · exact h1 hh.symm
    · exact h2 hh.symm
    · exact h3 hh.symm
    · exact h4 hh.symm
  simp [h0,h1,h2,h3,h4,hz]
private theorem cB (r:I) (i j:U):
 aA
 (ao (0:Fin 2) i + ao (1:Fin 2) j) r =
 ai r * (aj (0:Fin 2)) ^ i *
 (aj (1:Fin 2)) ^ j:=by
  calc
    _ = aA (ao (0:Fin 2) i) r *
        aA (ao (1:Fin 2) j) (1:I):=by
      rw [aL]
      simp
    _ = _:=by
      rw [← ap,
        ← ap]
      simp [mul_assoc]
private theorem cC (P:ab)
 (hP:P.IsHomogeneous 4):
 P = ai (P.coeff m40) * aj (0:Fin 2) ^ 4 +
 ai (P.coeff m31) * aj (0:Fin 2) ^ 3 * aj 1 +
 ai (P.coeff m22) * aj (0:Fin 2) ^ 2 * aj 1 ^ 2 +
 ai (P.coeff m13) * aj (0:Fin 2) * aj 1 ^ 3 +
 ai (P.coeff m04) * aj (1:Fin 2) ^ 4:=by
  conv_lhs => rw [cA P hP]
  rw [show m31 = ao (0:Fin 2) 3 + ao 1 1 from rfl,
    show m22 = ao (0:Fin 2) 2 + ao 1 2 from rfl,
    show m13 = ao (0:Fin 2) 1 + ao 1 3 from rfl]
  rw [cB,cB,cB]
  rw [← ap,
    ← ap]
  ring
private theorem cD (P:ab)
 (hP:P.IsHomogeneous 4) (d e:I):
 al ![d,e] P =
 P.coeff m40 * d ^ 4 + P.coeff m31 * d ^ 3 * e +
 P.coeff m22 * d ^ 2 * e ^ 2 + P.coeff m13 * d * e ^ 3 +
 P.coeff m04 * e ^ 4:=by
  conv_lhs => rw [cC P hP]
  simp
private theorem cE
 (r0 r1 r2 r3 r4 r5 r6 r7:I)
 (h:∀ t:I,
 r0 + r1 * t + r2 * t ^ 2 + r3 * t ^ 3 + r4 * t ^ 4 +
 r5 * t ^ 5 + r6 * t ^ 6 + r7 * t ^ 7 = 0):
 r0 = 0 ∧ r1 = 0 ∧ r2 = 0 ∧ r3 = 0 ∧ r4 = 0 ∧
 r5 = 0 ∧ r6 = 0 ∧ r7 = 0:=by
  have h0:= h 0
  have h1:= h 1
  have hm1:= h (-1)
  have h2:= h 2
  have hm2:= h (-2)
  have h3:= h 3
  have hm3:= h (-3)
  have h4:= h 4
  norm_num at h0 h1 hm1 h2 hm2 h3 hm3 h4
  refine ⟨?_,?_,?_,?_,?_,?_,?_,?_⟩ <;>
    linarith only [h0,h1,hm1,h2,hm2,h3,hm3,h4]
private theorem cF
 (p40 p31 p22 p13 p04 q40 q31 q22 q13 q04 a b c:I)
 (ht:∀ t:I,
 t ^ 3 * (p40 + p31 * t + p22 * t ^ 2 + p13 * t ^ 3 + p04 * t ^ 4) -
 (q40 + q31 * t + q22 * t ^ 2 + q13 * t ^ 3 + q04 * t ^ 4) =
 c * (a + b * t) ^ 7):
 q40 = -c * a ^ 7 ∧ q31 = -(7 * c * a ^ 6 * b) ∧
 q22 = -(21 * c * a ^ 5 * b ^ 2) ∧
 q13 = p40 - 35 * c * a ^ 4 * b ^ 3 ∧
 q04 = p31 - 35 * c * a ^ 3 * b ^ 4 ∧
 p22 = 21 * c * a ^ 2 * b ^ 5 ∧ p13 = 7 * c * a * b ^ 6 ∧ p04 = c * b ^ 7:=by
  have hv:∀ t:I,
      (-q40 - c * a ^ 7) +
      (-q31 - 7 * c * a ^ 6 * b) * t +
      (-q22 - 21 * c * a ^ 5 * b ^ 2) * t ^ 2 +
      (p40 - q13 - 35 * c * a ^ 4 * b ^ 3) * t ^ 3 +
      (p31 - q04 - 35 * c * a ^ 3 * b ^ 4) * t ^ 4 +
      (p22 - 21 * c * a ^ 2 * b ^ 5) * t ^ 5 +
      (p13 - 7 * c * a * b ^ 6) * t ^ 6 +
      (p04 - c * b ^ 7) * t ^ 7 = 0:=by
    intro t
    calc
      _ = t ^ 3 * (p40 + p31 * t + p22 * t ^ 2 + p13 * t ^ 3 + p04 * t ^ 4) -
          (q40 + q31 * t + q22 * t ^ 2 + q13 * t ^ 3 + q04 * t ^ 4) -
          c * (a + b * t) ^ 7:=by ring
      _ = 0:=by rw [ht t];ring
  obtain ⟨h0,h1,h2,h3,h4,h5,h6,h7⟩:= cE
    (-q40 - c * a ^ 7)
    (-q31 - 7 * c * a ^ 6 * b)
    (-q22 - 21 * c * a ^ 5 * b ^ 2)
    (p40 - q13 - 35 * c * a ^ 4 * b ^ 3)
    (p31 - q04 - 35 * c * a ^ 3 * b ^ 4)
    (p22 - 21 * c * a ^ 2 * b ^ 5)
    (p13 - 7 * c * a * b ^ 6) (p04 - c * b ^ 7) hv
  refine ⟨?_,?_,?_,?_,?_,?_,?_,?_⟩ <;> nlinarith only [h0,h1,h2,h3,h4,h5,h6,h7]
private theorem cH
 (P Q:ab) (a b c:I)
 (hP:P.IsHomogeneous 4) (hQ:Q.IsHomogeneous 4)
 (hpure:aj (1:Fin 2) ^ 3 * P -
 aj (0:Fin 2) ^ 3 * Q =
 ai c * (ai a * aj 0 +
 ai b * aj 1) ^ 7):
 Q.coeff m40 = -c * a ^ 7 ∧
 Q.coeff m31 = -(7 * c * a ^ 6 * b) ∧
 Q.coeff m22 = -(21 * c * a ^ 5 * b ^ 2) ∧
 Q.coeff m13 = P.coeff m40 - 35 * c * a ^ 4 * b ^ 3 ∧
 Q.coeff m04 = P.coeff m31 - 35 * c * a ^ 3 * b ^ 4 ∧
 P.coeff m22 = 21 * c * a ^ 2 * b ^ 5 ∧
 P.coeff m13 = 7 * c * a * b ^ 6 ∧ P.coeff m04 = c * b ^ 7:=by
  apply cF
  intro t
  have hh:= congrArg (al ![(1:I),t]) hpure
  simp only [MvPolynomial.eval_sub,MvPolynomial.eval_mul,MvPolynomial.eval_pow,
    MvPolynomial.eval_add,MvPolynomial.eval_C,MvPolynomial.eval_X] at hh
  simp [cD P hP 1 t,cD Q hQ 1 t] at hh
  nlinarith [hh]
private theorem cJ
 (P Q:ab) (a b c:I)
 (hP:P.IsHomogeneous 4) (hQ:Q.IsHomogeneous 4)
 (hpure:aj (1:Fin 2) ^ 3 * P -
 aj (0:Fin 2) ^ 3 * Q =
 ai c * (ai a * aj 0 +
 ai b * aj 1) ^ 7):
 ∀ d e:I,
 al ![d,e] P = pNF a b c (P.coeff m31) (P.coeff m40) d e ∧
 al ![d,e] Q = qNF a b c (P.coeff m31) (P.coeff m40) d e:=by
  obtain ⟨h0,h1,h2,h3,h4,h5,h6,h7⟩:=
    cH P Q a b c hP hQ hpure
  intro d e
  constructor
  · rw [cD P hP d e,h5,h6,h7]
    dsimp [pNF,pPart]
    ring
  · rw [cD Q hQ d e,h0,h1,h2,h3,h4]
    dsimp [qNF,qPart]
    ring
open Polynomial
private theorem cK
 (c A W t₀:I) (hc:c ≠ 0) (ht₀:c ∣ W + A * t₀):
 ∃ h k:I,0 < h ∧ A * h = c * k ∧
 ∀ t:I,c ∣ W + A * t ↔ ∃ y:I,t = t₀ + h * y:=by
  let g:U:= bt c A
  have hg:g ≠ 0:=by
    intro hzero
    have hdiv:(g:I) ∣ c:= Int.gcd_dvd_left c A
    rw [hzero,Nat.cast_zero,zero_dvd_iff] at hdiv
    exact hc hdiv
  have hgZ:(g:I) ≠ 0:=by exact_mod_cast hg
  let c₁:I:= c / (g:I)
  let A₁:I:= A / (g:I)
  have hcc:(g:I) * c₁ = c:=
    Int.mul_ediv_cancel' (Int.gcd_dvd_left c A)
  have hAA:(g:I) * A₁ = A:=
    Int.mul_ediv_cancel' (Int.gcd_dvd_right c A)
  have hc₁:c₁ ≠ 0:=by
    intro hz
    rw [hz,mul_zero] at hcc
    exact hc hcc.symm
  have hbez:c₁ * Int.gcdA c A + A₁ * Int.gcdB c A = 1:=by
    apply aC hgZ
    have hb:= bg c A
    change (g:I) = c * Int.gcdA c A + A * Int.gcdB c A at hb
    linear_combination -hb + Int.gcdA c A * hcc + Int.gcdB c A * hAA
  have hkernel (δ:I):c ∣ A * δ ↔ c₁ ∣ δ:=by
    constructor
    · rintro ⟨r,hr⟩
      have hred:A₁ * δ = c₁ * r:=by
        apply aC hgZ
        linear_combination hr + δ * hAA - r * hcc
      refine ⟨Int.gcdA c A * δ + Int.gcdB c A * r,?_⟩
      linear_combination -δ * hbez + Int.gcdB c A * hred
    · rintro ⟨r,hr⟩
      refine ⟨A₁ * r,?_⟩
      rw [hr,← hAA,← hcc]
      ring
  have hbase (t:I):c ∣ W + A * t ↔ c₁ ∣ t - t₀:=by
    constructor
    · intro ht
      apply (hkernel (t - t₀)).mp
      obtain ⟨r,hr⟩:= ht
      obtain ⟨r₀,hr₀⟩:= ht₀
      refine ⟨r - r₀,?_⟩
      linear_combination hr - hr₀
    · intro ht
      obtain ⟨r,hr⟩:= (hkernel (t - t₀)).mpr ht
      obtain ⟨r₀,hr₀⟩:= ht₀
      refine ⟨r + r₀,?_⟩
      linear_combination hr + hr₀
  by_cases hpos:0 < c₁
  · refine ⟨c₁,A₁,hpos,?_,?_⟩
    · rw [← hAA,← hcc];ring
    · intro t
      rw [hbase]
      constructor
      · rintro ⟨y,hy⟩
        exact ⟨y,by linear_combination hy⟩
      · rintro ⟨y,hy⟩
        exact ⟨y,by linear_combination hy⟩
  · have hneg:c₁ < 0:=by omega
    refine ⟨-c₁,-A₁,neg_pos.mpr hneg,?_,?_⟩
    · rw [← hAA,← hcc];ring
    · intro t
      rw [hbase]
      constructor
      · rintro ⟨y,hy⟩
        exact ⟨-y,by linear_combination hy⟩
      · rintro ⟨y,hy⟩
        exact ⟨-y,by linear_combination hy⟩
private theorem cL
 (a b c R S d₀ e₀ t₀:I) (hc:c ≠ 0)
 (hK:co a b c R S ≠ 0)
 (ht₀:c ∣ R * (e₀ - a * t₀) + S * (d₀ + b * t₀)):
 ∃ h q j₀:I,0 < h ∧ q ≠ 0 ∧
 h * co a b c R S = c * q ∧
 (∀ t:I,c ∣ R * (e₀ - a * t) + S * (d₀ + b * t) ↔
 ∃ y:I,t = t₀ + h * y) ∧
 ∀ y:I,
 R * (e₀ - a * (t₀ + h * y)) +
 S * (d₀ + b * (t₀ + h * y)) =
 c * (j₀ + (q - 15 * h * a ^ 4 * b ^ 4) * y):=by
  have ht₀':c ∣ (R * e₀ + S * d₀) + (b * S - a * R) * t₀:=by
    obtain ⟨r,hr⟩:= ht₀
    refine ⟨r,?_⟩
    linear_combination hr
  obtain ⟨h,k,hh,hk,bI⟩:=
    cK c (b * S - a * R) (R * e₀ + S * d₀) t₀ hc ht₀'
  let q:I:= k + 15 * h * a ^ 4 * b ^ 4
  obtain ⟨j₀,hj₀⟩:= ht₀
  have bG:h * co a b c R S = c * q:=by
    dsimp [co,q]
    linear_combination hk
  have hq:q ≠ 0:=by
    intro hz
    have hzero:h * co a b c R S = 0:=by rw [bG,hz];ring
    exact (mul_ne_zero (ne_of_gt hh) hK) hzero
  refine ⟨h,q,j₀,hh,hq,bG,?_,?_⟩
  · intro t
    have heq:
        R * (e₀ - a * t) + S * (d₀ + b * t) =
          (R * e₀ + S * d₀) + (b * S - a * R) * t:=by ring
    rw [heq]
    exact bI t
  · intro y
    dsimp [q]
    linear_combination hj₀ + y * hk
private noncomputable def cN (r s:I):ae:= C r + C s * X
private theorem cO
 (r₀ r₁ s₀ s₁ t₀ t₁ u₀ u₁:I):
 ((cN r₀ r₁ * cN s₀ s₁) *
 cN t₀ t₁ * cN u₀ u₁).coeff 4 = r₁ * s₁ * t₁ * u₁:=by
  have heq:
      ((cN r₀ r₁ * cN s₀ s₁) *
        cN t₀ t₁ * cN u₀ u₁) =
      C (r₀ * s₀ * t₀ * u₀) +
      C (r₁ * s₀ * t₀ * u₀ + r₀ * s₁ * t₀ * u₀ +
        r₀ * s₀ * t₁ * u₀ + r₀ * s₀ * t₀ * u₁) * X +
      C (r₁ * s₁ * t₀ * u₀ + r₁ * s₀ * t₁ * u₀ +
        r₁ * s₀ * t₀ * u₁ + r₀ * s₁ * t₁ * u₀ +
        r₀ * s₁ * t₀ * u₁ + r₀ * s₀ * t₁ * u₁) * X ^ 2 +
      C (r₁ * s₁ * t₁ * u₀ + r₁ * s₁ * t₀ * u₁ +
        r₁ * s₀ * t₁ * u₁ + r₀ * s₁ * t₁ * u₁) * X ^ 3 +
      C (r₁ * s₁ * t₁ * u₁) * X ^ 4:=by
    simp only [cN,map_add,map_mul]
    ring
  rw [heq]
  simp only [aV,aI,
    Polynomial.coeff_C,Polynomial.coeff_X_pow,Polynomial.coeff_X]
  norm_num
private theorem cP {R:Type*} [Semiring R]
    (F G:Polynomial R) (n:U) (hF:F.natDegree ≤ n) (hG:G.natDegree ≤ n):
    (F + G).natDegree ≤ n:=
  (Polynomial.natDegree_add_le F G).trans (max_le hF hG)
private theorem cQ {R:Type*} [Ring R]
    (F G:Polynomial R) (n:U) (hF:F.natDegree ≤ n) (hG:G.natDegree ≤ n):
    (F - G).natDegree ≤ n:=
  (Polynomial.natDegree_sub_le F G).trans (max_le hF hG)
private theorem cR {R:Type*} [Semiring R]
    (F G:Polynomial R) (n k:U) (hF:F.natDegree ≤ n) (hG:G.natDegree ≤ k):
    (F * G).natDegree ≤ n + k:=
  Polynomial.natDegree_mul_le.trans (Nat.add_le_add hF hG)
private theorem cS {R:Type*} [Semiring R]
 (a:R) (F:Polynomial R) (n:U) (hF:F.natDegree ≤ n):
 (C a * F).natDegree ≤ n:=by
  simpa using cR (C a) F 0 n (by simp) hF
private theorem cT (r s:I):
 (cN r s).natDegree ≤ 1:=by
  apply cP _ _ 1
  · simp
  · exact cS s X 1 (by simp)
private theorem cU
    (r₀ r₁ s₀ s₁ t₀ t₁ u₀ u₁:I):
    ((cN r₀ r₁ * cN s₀ s₁) *
      cN t₀ t₁ * cN u₀ u₁).natDegree ≤ 4:=
  cR _ _ 3 1
    (cR _ _ 2 1
      (cR _ _ 1 1 (cT _ _) (cT _ _))
      (cT _ _)) (cT _ _)
private noncomputable def cV (a b h d₀ e₀ j₀ k:I):ae:=
  let D:= cN d₀ (b * h)
  let E:= cN e₀ (-a * h)
  let W:= cN j₀ k
  C (b ^ 7) * (E * E * E * E) +
    C (7 * a * b ^ 6) * (D * E * E * E) +
    C (21 * a ^ 2 * b ^ 5) * (D * D * E * E) + D * D * D * W
private noncomputable def cW (a b h d₀ e₀ j₀ k:I):ae:=
  let D:= cN d₀ (b * h)
  let E:= cN e₀ (-a * h)
  let W:= cN j₀ k
  E * E * E * W -
    (C (35 * a ^ 3 * b ^ 4) * (E * E * E * E) +
      C (35 * a ^ 4 * b ^ 3) * (D * E * E * E) +
      C (21 * a ^ 5 * b ^ 2) * (D * D * E * E) +
      C (7 * a ^ 6 * b) * (D * D * D * E) +
      C (a ^ 7) * (D * D * D * D))
private theorem cX (a b h d₀ e₀ j₀ k:I):
 (cV a b h d₀ e₀ j₀ k).natDegree ≤ 4 ∧
 (cW a b h d₀ e₀ j₀ k).natDegree ≤ 4:=by
  constructor
  · dsimp [cV]
    apply cP _ _ 4
    · apply cP _ _ 4
      · apply cP _ _ 4
        · exact cS _ _ 4 (cU _ _ _ _ _ _ _ _)
        · exact cS _ _ 4 (cU _ _ _ _ _ _ _ _)
      · exact cS _ _ 4 (cU _ _ _ _ _ _ _ _)
    · exact cU _ _ _ _ _ _ _ _
  · dsimp [cW]
    apply cQ _ _ 4
    · exact cU _ _ _ _ _ _ _ _
    · apply cP _ _ 4
      · apply cP _ _ 4
        · apply cP _ _ 4
          · apply cP _ _ 4
            · exact cS _ _ 4 (cU _ _ _ _ _ _ _ _)
            · exact cS _ _ 4 (cU _ _ _ _ _ _ _ _)
          · exact cS _ _ 4 (cU _ _ _ _ _ _ _ _)
        · exact cS _ _ 4 (cU _ _ _ _ _ _ _ _)
      · exact cS _ _ 4 (cU _ _ _ _ _ _ _ _)
private theorem cY (a b h d₀ e₀ j₀ k:I):
 (cV a b h d₀ e₀ j₀ k).coeff 4 =
 (k + 15 * h * a ^ 4 * b ^ 4) * h ^ 3 * b ^ 3 ∧
 (cW a b h d₀ e₀ j₀ k).coeff 4 =
 -(k + 15 * h * a ^ 4 * b ^ 4) * h ^ 3 * a ^ 3:=by
  constructor
  · simp only [cV,aV,aI,
      cO]
    ring
  · simp only [cW,Polynomial.coeff_sub,aV,
      aI,cO]
    ring
private theorem cZ
 (a b c R S h d₀ e₀ j₀ k y:I)
 (hW:R * (e₀ - a * h * y) + S * (d₀ + b * h * y) =
 c * (j₀ + k * y)):
 c * (cV a b h d₀ e₀ j₀ k).eval y =
 pNF a b c R S (d₀ + b * h * y) (e₀ - a * h * y) ∧
 c * (cW a b h d₀ e₀ j₀ k).eval y =
 qNF a b c R S (d₀ + b * h * y) (e₀ - a * h * y):=by
  constructor
  · simp only [cV,cN,aY,aR,
      aW,bh]
    dsimp [pNF,pPart]
    linear_combination -(d₀ + b * h * y) ^ 3 * hW
  · simp only [cW,cN,Polynomial.eval_sub,aY,
      aR,aW,bh]
    dsimp [qNF,qPart]
    linear_combination -(e₀ - a * h * y) ^ 3 * hW
private theorem da
 (a b h d₀ e₀ j₀ k r J:I):
 (cV a b h d₀ e₀ j₀ k).comp (cN r J) =
 cV a b (h * J) (d₀ + b * h * r)
 (e₀ - a * h * r) (j₀ + k * r) (k * J) ∧
 (cW a b h d₀ e₀ j₀ k).comp (cN r J) =
 cW a b (h * J) (d₀ + b * h * r)
 (e₀ - a * h * r) (j₀ + k * r) (k * J):=by
  constructor <;>
    simp only [cV,cW,cN,Polynomial.add_comp,
      Polynomial.sub_comp,aS,aX,
      Polynomial.X_comp,Polynomial.neg_comp,Polynomial.pow_comp,map_add,map_sub,map_mul,
      map_neg,map_pow] <;> ring
private theorem db
 (a b h d₀ e₀ j₀ k r J:I):
 ((cV a b h d₀ e₀ j₀ k).comp (cN r J)).coeff 4 =
 J ^ 4 * (k + 15 * h * a ^ 4 * b ^ 4) * h ^ 3 * b ^ 3 ∧
 ((cW a b h d₀ e₀ j₀ k).comp (cN r J)).coeff 4 =
 -(J ^ 4 * (k + 15 * h * a ^ 4 * b ^ 4) * h ^ 3 * a ^ 3):=by
  obtain ⟨hp,hq⟩:= da a b h d₀ e₀ j₀ k r J
  obtain ⟨htp,htq⟩:= cY a b (h * J)
    (d₀ + b * h * r) (e₀ - a * h * r) (j₀ + k * r) (k * J)
  constructor
  · rw [hp,htp]
    ring
  · rw [hq,htq]
    ring
private theorem dc
 (N z a b A B:I) (hbez:A * a + B * b = 1)
 (ha:N ∣ z * a ^ 3) (hb:N ∣ z * b ^ 3):N ∣ z:=by
  obtain ⟨r,hr⟩:= ha
  obtain ⟨s,hs⟩:= hb
  let iU:I:= A ^ 5 * a ^ 2 + 5 * A ^ 4 * B * a * b +
    10 * A ^ 3 * B ^ 2 * b ^ 2
  let V:I:= 10 * A ^ 2 * B ^ 3 * a ^ 2 + 5 * A * B ^ 4 * a * b +
    B ^ 5 * b ^ 2
  refine ⟨r * iU + s * V,?_⟩
  calc
    z = z * (A * a + B * b) ^ 5:=by rw [hbez];ring
    _ = (z * a ^ 3) * iU + (z * b ^ 3) * V:=by dsimp [iU,V];ring
    _ = N * (r * iU + s * V):=by rw [hr,hs];ring
private theorem dd
 (T a b h d₀ e₀ j₀ k r J A B:I)
 (hbez:A * a + B * b = 1)
 (hp:C T ∣ (cV a b h d₀ e₀ j₀ k).comp (cN r J))
 (hq:C T ∣ (cW a b h d₀ e₀ j₀ k).comp (cN r J)):
 T ∣ (k + 15 * h * a ^ 4 * b ^ 4) * h ^ 3 * J ^ 4:=by
  have hpc:= (ax _ _).mp hp 4
  have hqc:= (ax _ _).mp hq 4
  obtain ⟨htp,htq⟩:= db a b h d₀ e₀ j₀ k r J
  rw [htp] at hpc
  rw [htq] at hqc
  have ha:T ∣ ((k + 15 * h * a ^ 4 * b ^ 4) * h ^ 3 * J ^ 4) * a ^ 3:=by
    obtain ⟨s,hs⟩:= hqc
    refine ⟨-s,?_⟩
    linear_combination -hs
  have hb:T ∣ ((k + 15 * h * a ^ 4 * b ^ 4) * h ^ 3 * J ^ 4) * b ^ 3:=by
    obtain ⟨s,hs⟩:= hpc
    refine ⟨s,?_⟩
    linear_combination hs
  exact dc T
    ((k + 15 * h * a ^ 4 * b ^ 4) * h ^ 3 * J ^ 4) a b A B hbez ha hb
end P7I
noncomputable section
namespace P7Q
open Polynomial
private theorem de (p:U) (F:ae):
 ar (an (ZMod p)) F = 0 ↔
 Polynomial.C (p:I) ∣ F:=by
  rw [Polynomial.ext_iff,ax]
  simp [aB]
private theorem df (p:U) (k:U) (F:ae):
 C ((p:I) ^ k) ∣ F ∨
 ∃ v < k,∃ H:ae,
 F = C ((p:I) ^ v) * H ∧
 ar (an (ZMod p)) H ≠ 0:=by
  induction k generalizing F with
  | zero => left;simp
  | succ k ih =>
    by_cases h:C (p:I) ∣ F
    · obtain ⟨G,hG⟩:= h
      rcases ih G with hD | ⟨v,hv,H,hH,hn⟩
      · left
        obtain ⟨A,hA⟩:= hD
        refine ⟨A,?_⟩
        rw [hG,hA,pow_succ',bm,mul_assoc]
      · right
        refine ⟨v + 1,by omega,H,?_,hn⟩
        rw [hG,hH,pow_succ',bm,mul_assoc]
    · right
      refine ⟨0,by omega,F,by simp,?_⟩
      intro hz
      exact h ((de p F).mp hz)
private theorem dg (F:ae) (c:I) (j:U):
 (F.comp (C c * X)).coeff j = c ^ j * F.coeff j:=by
  induction F using Polynomial.induction_on' with
  | add F G hF hG =>
    simp only [Polynomial.add_comp,aV,hF,hG]
    ring
  | monomial n a =>
    simp only [← Polynomial.C_mul_X_pow_eq_monomial,aS,
      aX,Polynomial.pow_comp,Polynomial.X_comp]
    simp only [mul_pow,← Polynomial.C_pow,
      aI,Polynomial.coeff_X_pow]
    split_ifs <;> simp_all ; ring
private theorem dh (F:ae) (r p:I) (j:U):
 (F.comp (C r + C p * X)).coeff j =
 p ^ j * ((taylor r) F).coeff j:=by
  have h:C r + C p * X = (X + C r).comp (C p * X):=by
    simp
    ring
  rw [h,← bi,← Polynomial.taylor_apply]
  exact dg ((taylor r) F) p j
private theorem di (p:I) (hp:p ≠ 0) (v:U) (b:I):
 p ^ (v + 1) ∣ p ^ v * b ↔ p ∣ b:=by
  constructor
  · rintro ⟨c,hc⟩
    refine ⟨c,?_⟩
    apply aC (pow_ne_zero v hp)
    calc
      p ^ v * b = p ^ (v + 1) * c:= hc
      _ = p ^ v * (p * c):=by rw [pow_succ];ring
  · rintro ⟨c,rfl⟩
    refine ⟨c,?_⟩
    rw [pow_succ]
    ring
private theorem dj (p:U) [Fact p.Prime]
 (F:ae) (r:I)
 (hF:ar (an (ZMod p)) F ≠ 0):
 ¬ (p:I) ∣ ((taylor r) F).coeff
 (rootMultiplicity (r:ZMod p)
 (ar (an (ZMod p)) F)):=by
  let B:= ar (an (ZMod p)) F
  let m:= rootMultiplicity (r:ZMod p) B
  have ht:(taylor (r:ZMod p)) B ≠ 0:=by
    intro hz
    exact hF ((Polynomial.taylor_eq_zero (r:ZMod p) B).mp hz)
  have hc:= (Polynomial.coeff_natTrailingDegree_ne_zero).mpr ht
  have hm:m = ((taylor (r:ZMod p)) B).natTrailingDegree:=by
    dsimp [m]
    rw [Polynomial.taylor_apply,Polynomial.rootMultiplicity_eq_natTrailingDegree]
  rw [← hm] at hc
  have hc':(ar (an (ZMod p)) ((taylor r) F)).coeff m ≠ 0:=by
    rw [Polynomial.map_taylor]
    exact hc
  rw [Polynomial.coeff_map] at hc'
  exact fun h => hc' ((aB _ p).mpr h)
private theorem dk (p:U) [Fact p.Prime]
 (F H:ae) (r:I) (v:U)
 (hF:ar (an (ZMod p)) F ≠ 0)
 (hroot:(ar (an (ZMod p)) F).IsRoot (r:ZMod p))
 (hH:ar (an (ZMod p)) H ≠ 0)
 (heq:F.comp (C r + C (p:I) * X) = C ((p:I) ^ v) * H):
 1 ≤ v ∧
 v ≤ rootMultiplicity (r:ZMod p)
 (ar (an (ZMod p)) F) ∧
 (ar (an (ZMod p)) H).natDegree ≤
 rootMultiplicity (r:ZMod p)
 (ar (an (ZMod p)) F):=by
  let B:= ar (an (ZMod p)) F
  let m:= rootMultiplicity (r:ZMod p) B
  have hp:(p:I) ≠ 0:=by
    exact_mod_cast (Fact.out:p.Prime).ne_zero
  have hc (j:U):
      (p:I) ^ v * H.coeff j =
        (p:I) ^ j * ((taylor r) F).coeff j:=by
    calc
      (p:I) ^ v * H.coeff j =
          (F.comp (C r + C (p:I) * X)).coeff j:=by
        rw [heq,aI]
      _ = (p:I) ^ j * ((taylor r) F).coeff j:= dh F r p j
  have hm:v ≤ m:=by
    by_contra hn
    have hvm:m + 1 ≤ v:=by omega
    have hd:(p:I) ^ (m + 1) ∣ (p:I) ^ v * H.coeff m:=
      aT (pow_dvd_pow (p:I) hvm) _
    rw [hc m] at hd
    exact dj p F r hF ((di (p:I) hp m _).mp hd)
  have hdeg:(ar (an (ZMod p)) H).natDegree ≤ m:=by
    apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
    intro j hj
    rw [Polynomial.coeff_map]
    apply (aB _ p).mpr
    apply (di (p:I) hp v _).mp
    rw [hc j]
    exact aT (pow_dvd_pow (p:I) (by omega)) _
  have hz:ar (an (ZMod p))
      (F.comp (C r + C (p:I) * X)) = 0:=by
    rw [Polynomial.map_comp]
    have hp0:(an (ZMod p)) (p:I) = 0:=by simp
    simp only [Polynomial.map_add,Polynomial.map_mul,Polynomial.map_C,
      Polynomial.map_X,hp0,Polynomial.C_0,zero_mul,add_zero,
      Polynomial.comp_C]
    change C (B.eval (r:ZMod p)) = 0
    rw [hroot]
    simp
  have hv:1 ≤ v:=by
    by_contra hv
    have hv0:v = 0:=by omega
    have he:F.comp (C r + C (p:I) * X) = H:=by simpa [hv0] using heq
    apply hH
    rw [← he]
    exact hz
  exact ⟨hv,hm,hdeg⟩
private theorem dl (p:U) [Fact p.Prime]
 (B:Polynomial (ZMod p)):
 ∑ r ∈ B.roots.toFinset,rootMultiplicity r B ≤ B.natDegree:=by
  calc
    ∑ r ∈ B.roots.toFinset,rootMultiplicity r B =
        ∑ r ∈ B.roots.toFinset,Multiset.count r B.roots:=by
      simp only [Polynomial.count_roots]
    _ = B.roots.card:= Multiset.toFinset_sum_count_eq B.roots
    _ ≤ B.natDegree:= Polynomial.card_roots' B
private theorem dm (p:U) (F:ae) (r:I):
 (ar (an (ZMod p)) F).eval (r:ZMod p) =
 ((F.eval r:I):ZMod p):=by
  have h:= Polynomial.eval₂_at_apply (p:= F) (an (ZMod p)) r
  rw [← Polynomial.eval_map] at h
  solve | simp
private theorem dn (r J s K:I):
 (C r + C J * X).comp (C s + C K * X) =
 C (r + J * s) + C (J * K) * X:=by
  simp only [Polynomial.add_comp,aS,
    aX,Polynomial.X_comp,Polynomial.C_add,bm]
  ring
private theorem dp (n:I) (F A:ae)
 (h:C n ∣ F):C n ∣ F.comp A:=by
  obtain ⟨G,hG⟩:= h
  refine ⟨G.comp A,?_⟩
  rw [hG,aS,aX]
private theorem dq {R:Type*} [CommRing R] [IsDomain R]
 (p:R) (hp:p ≠ 0) (v k:U) (hv:v ≤ k) (b:R):
 p ^ k ∣ p ^ v * b ↔ p ^ (k - v) ∣ b:=by
  have hk:v + (k - v) = k:= Nat.add_sub_of_le hv
  have hpow:p ^ k = p ^ v * p ^ (k - v):=by rw [← pow_add,hk]
  constructor
  · rintro ⟨c,hc⟩
    refine ⟨c,?_⟩
    apply aC (pow_ne_zero v hp)
    calc
      p ^ v * b = p ^ k * c:= hc
      _ = p ^ v * (p ^ (k - v) * c):=by rw [hpow,mul_assoc]
  · rintro ⟨c,rfl⟩
    refine ⟨c,?_⟩
    rw [← mul_assoc,← pow_add,hk]
private def dr (p:U) (s:I × U):ae:=
  C s.1 + C ((p:I) ^ s.2) * X
private def ds (p:U) (r:I) (s:I × U):I × U:=
  (r + (p:I) * s.1,s.2 + 1)
private theorem dt (p:U) (r:I) (s:I × U):
 (C r + C (p:I) * X).comp (dr p s) =
 dr p (ds p r s):=by
  rw [dr,dn]
  simp only [dr,ds,pow_succ']
private theorem du (p k v:U) (hv:v ≤ k)
 (F H:ae) (r:I) (s:I × U)
 (heq:F.comp (C r + C (p:I) * X) = C ((p:I) ^ v) * H)
 (h:C ((p:I) ^ (k - v)) ∣ H.comp (dr p s)):
 C ((p:I) ^ k) ∣ F.comp (dr p (ds p r s)):=by
  obtain ⟨A,hA⟩:= h
  refine ⟨A,?_⟩
  rw [← dt,← bi,heq,aS,
    aX,hA,← mul_assoc,← bm,
    ← pow_add,Nat.add_sub_of_le hv]
