    omega
  have halt : HasThreeProjectiveZeros R ∨ TwoIndependentLines (2*k+1) R :=
    JocelynClaims.claim_aa1f5246aab8ed8718414aed16da9eb6c1d38a5a42d844f86abff3c9151b4ea1
