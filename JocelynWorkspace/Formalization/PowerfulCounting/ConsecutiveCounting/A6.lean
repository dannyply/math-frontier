def levelConst (C cM : ℝ) : ℝ :=
  (6 : ℝ)^6*39*(2+2048*C/cM+131072*C/cM+2048*(C+1))

theorem finish_fee
    (N R w t K Z L : ℝ)
    (hR0 : 0 ≤ R) (hw : 0 ≤ w) (ht0 : 0 ≤ t) (hK : 0 ≤ K) (hZ : 0 ≤ Z)
    (hR : R ≤ (6 : ℝ)^6*w)
    (hN : N ≤ R*39*(1+t))
    (ht : 1+t ≤ (1+K)*(1+Z))
    (hL : (6 : ℝ)^6*39*(1+K) ≤ L) :
    N ≤ L*w*(1+Z) := by
  calc
    N ≤ R*39*(1+t) := hN
    _ ≤ ((6 : ℝ)^6*w)*39*((1+K)*(1+Z)) := by gcongr
    _ = ((6 : ℝ)^6*39*(1+K))*w*(1+Z) := by ring
    _ ≤ L*w*(1+Z) := by gcongr

theorem analytic_line_count
    (C cM : ℝ) (hC : 0 < C) (hcM : 0 < cM) (hcM1 : cM ≤ 1)
    (x D E M s₀ : ℝ) (hx : 2 ≤ x) (hD : 0 < D) (hE : 0 < E)
    (hfloor : cM*x^((1 : ℝ)/5) ≤ M)
    (a b m q d₀ e₀ : ℤ) (hprim : Int.gcd a b=1) (hm : m ≠ 0) (hq : q ≠ 0)
    (hbez : a*d₀+b*e₀=1) (Y : Finset ℤ)
    (hbox : ∀ h ∈ Y, lineBox D E a b m d₀ e₀ (h : ℝ))
    (hcell : ∀ h ∈ Y,
      |lineD m d₀ b (h : ℝ)/lineE m e₀ a (h : ℝ)-s₀| ≤ C*D/(E*M))
    (hheight : ∀ h ∈ Y,
      0 ≤ (lineHeight a b m q d₀ e₀).eval (h : ℝ) ∧
      (lineHeight a b m q d₀ e₀).eval (h : ℝ) ≤ x)
    (hdiv : ∀ h ∈ Y,
      m^5 ∣ A6Local.NE a b m q d₀ e₀ h ∧
      m^5 ∣ A6Local.ND a b m q d₀ e₀ h) :
    (Y.card : ℝ) ≤ levelConst C cM*(3 : ℝ)^m.natAbs.primeFactors.card*
      (1+price x M (D*E)) := by
  classical
  have hx0 : 0 < x := by linarith
  have hM : 0 < M :=
    lt_of_lt_of_le (mul_pos hcM (Real.rpow_pos_of_pos hx0 _)) hfloor
  have hMfloor : cM ≤ M := by
    have hh : 1 ≤ x^((1 : ℝ)/5) := Real.one_le_rpow (by linarith) (by norm_num)
    exact (by nlinarith [mul_le_mul_of_nonneg_left hh hcM.le] :
      cM ≤ cM*x^((1 : ℝ)/5)).trans hfloor
  let W := D*E
  let mu := |(m : ℝ)|
  let gN := Nat.gcd m.natAbs (a*b).natAbs
  let QN := m.natAbs^5/gN^4
  let g : ℝ := gN
  let Z := price x M W
  let w : ℝ := (3 : ℝ)^m.natAbs.primeFactors.card
  let N := lineHeight a b m q d₀ e₀
  have hW : 0 < W := mul_pos hD hE
  have hmu : 0 < mu := abs_pos.mpr (by exact_mod_cast hm)
  have hZ : 0 ≤ Z := by dsimp [Z,price]; positivity
  have hw : 0 ≤ w := by dsimp [w]; positivity
  have hL₁ : (6 : ℝ)^6*39*(1+2048*C/cM) ≤ levelConst C cM := by
    dsimp [levelConst]
    apply mul_le_mul_of_nonneg_left _ (by norm_num : 0 ≤ (6 : ℝ)^6*39)
    linarith [show 0 ≤ 2048*C/cM by positivity,
      show 0 ≤ 131072*C/cM by positivity,show 0 ≤ 2048*(C+1) by positivity]
  have hL₂ : (6 : ℝ)^6*39*(1+131072*C/cM) ≤ levelConst C cM := by
    dsimp [levelConst]
    apply mul_le_mul_of_nonneg_left _ (by norm_num : 0 ≤ (6 : ℝ)^6*39)
    linarith [show 0 ≤ 2048*C/cM by positivity,
      show 0 ≤ 131072*C/cM by positivity,show 0 ≤ 2048*(C+1) by positivity]
  have hL₃ : (6 : ℝ)^6*39*(1+2048*(C+1)) ≤ levelConst C cM := by
    dsimp [levelConst]
    apply mul_le_mul_of_nonneg_left _ (by norm_num : 0 ≤ (6 : ℝ)^6*39)
    linarith [show 0 ≤ 2048*C/cM by positivity,
      show 0 ≤ 131072*C/cM by positivity,show 0 ≤ 2048*(C+1) by positivity]
  by_cases he : Y=∅
  · rw [he,Finset.card_empty,Nat.cast_zero]
    dsimp [levelConst]
    positivity
  obtain ⟨h₀,hh₀⟩ := Finset.nonempty_iff_ne_empty.mpr he
  obtain ⟨R,hQpos,hRc,hRv⟩ :=
    JocelynClaims.claim_1faecb89cbcf2c0602d72af0a30e0c957db438c8b241af5a41ae6d27192eeaa1
      a b m q d₀ e₀ hprim hm hq hbez
  change 0 < QN at hQpos
  have hQR : 0 < (QN : ℝ) := by exact_mod_cast hQpos
  have hQZ : 0 < (QN : ℤ) := by exact_mod_cast hQpos
  obtain ⟨_,hgp,hgmu,hQmul⟩ := modulus_real_data a b m hm
  change 0 < g at hgp
  change g ≤ mu at hgmu
  change (QN : ℝ)*g^4=mu^5 at hQmul
  have hQeq : (QN : ℝ)=mu^5/g^4 :=
    (eq_div_iff (pow_ne_zero 4 (ne_of_gt hgp))).mpr hQmul
  have hRcR : (R.card : ℝ) ≤ (6 : ℝ)^6*w := by
    dsimp [w]
    exact_mod_cast hRc
  have hcover : ∀ h ∈ Y, ∃ r ∈ R, ∃ z : ℤ, h=r+(QN : ℤ)*z := by
    intro h hh
    have h₁ := (hdiv h hh).1
    have h₂ := (hdiv h hh).2
    dsimp [A6Local.NE,A6Local.ND,A6Local.D,A6Local.E,A6Local.R3] at h₁ h₂
    obtain ⟨r,hr,z,hz⟩ := hRv h h₁ h₂
    exact ⟨r,hr,z,by linarith only [hz]⟩
  let H := 2*C*W/(M*mu)
  let A := H/(QN : ℝ)
  have hH : 0 ≤ H := by dsimp [H]; positivity
  have hA : 0 ≤ A := by dsimp [A]; positivity
  have hAeq : A=2*C*W*g^4/(M*mu^6) := by
    dsimp [A,H]
    rw [hQeq]
    field_simp
    <;> ring
  have hAc : A ≤ 2*C*W/(M*mu^2) := by
    rw [hAeq]
    exact cell_coarse_scalar C W M mu g hC hW hM hmu hgp.le hgmu
  have hAc' : A ≤ 2*C*(W/(M*mu^2)) := by convert hAc using 1 <;> ring
  have hdiam : ∀ s ∈ Y, ∀ t ∈ Y, |(s : ℝ)-(t : ℝ)| ≤ H := by
    intro s hs t ht
    have hsbox := hbox s hs
    have htbox := hbox t ht
    have hbezR : (a : ℝ)*(d₀ : ℝ)+(b : ℝ)*(e₀ : ℝ)=1 := by exact_mod_cast hbez
    have hcross :
        lineD m d₀ b (t : ℝ)*lineE m e₀ a (s : ℝ)-
          lineD m d₀ b (s : ℝ)*lineE m e₀ a (t : ℝ)=(m : ℝ)*((t : ℝ)-(s : ℝ)) := by
      dsimp [lineD,lineE]
      linear_combination (m : ℝ)*((t : ℝ)-(s : ℝ))*hbezR
    have hex : 0 < lineE m e₀ a (s : ℝ) := by linarith [hsbox.2.1]
    have hey : 0 < lineE m e₀ a (t : ℝ) := by linarith [htbox.2.1]
    have hh := absolute_cell_diameter
      (lineD m d₀ b (s : ℝ)) (lineD m d₀ b (t : ℝ))
      (lineE m e₀ a (s : ℝ)) (lineE m e₀ a (t : ℝ))
      (m : ℝ) D E M C s₀ (s : ℝ) (t : ℝ) hcross hex hey
      hsbox.2.2 htbox.2.2 (by exact_mod_cast hm) hD hE hM hC (hcell s hs) (hcell t ht)
    convert hh using 1 <;> dsimp [H,W,mu] <;> ring
  have hYcell : (Y.card : ℝ) ≤ (R.card : ℝ)*39*(1+A) := by
    have hh := finite_residue_cover_count Y R (QN : ℤ) (39*(1+A))
      (by positivity) hcover (by
        intro r hr
        let F := Y.filter (fun y => ∃ z : ℤ, y=r+(QN : ℤ)*z)
        have hf := fixed_progression_diameter_count H hH r (QN : ℤ) hQZ F
          (by intro y hy; exact (Finset.mem_filter.mp hy).2)
          (by
            intro s hs t ht
            exact hdiam s (Finset.mem_filter.mp hs).1 t (Finset.mem_filter.mp ht).1)
        change (F.card : ℝ) ≤ 39*(1+A)
        simp only [Int.cast_natCast] at hf
        dsimp [A] at *
        nlinarith only [hf,show 0 ≤ H/(QN : ℝ) by positivity])
    simpa only [mul_assoc] using hh
  by_cases hlarge : W^3 ≤ 65536*mu^5*x
  · have hAZ : A ≤ (2048*C/cM)*Z := by
      have hh := large_height_scalar cM x M W mu hcM hcM1 hx0 hM hW hmu hfloor hlarge
      calc
        A ≤ 2*C*(W/(M*mu^2)) := hAc'
        _ ≤ 2*C*((1024/cM)*Z) := mul_le_mul_of_nonneg_left hh (by positivity)
        _ = _ := by ring
    exact finish_fee _ _ w A (2048*C/cM) Z _ (by positivity) hw hA
      (by positivity) hZ hRcR hYcell (by nlinarith only [hAZ,hZ,show 0 ≤ 2048*C/cM by positivity]) hL₁
  have hbox₀ := hbox h₀ hh₀
  have hheight₀ := hheight h₀ hh₀
  have hb₀ := box_product D E _ _ hD hE hbox₀.1 hbox₀.2
  have hqlo := integer_abs_ge_one q hq
  have habne : a*b ≠ 0 := by
    intro hz
    have hz' : (a : ℝ)*lineD m d₀ b (h₀ : ℝ)=0 ∨
        (b : ℝ)*lineE m e₀ a (h₀ : ℝ)=0 := by
      rcases mul_eq_zero.mp hz with ha | hb
      · left; simp [ha]
      · right; simp [hb]
    exact hlarge (coordinate_large_height
      ((a : ℝ)*lineD m d₀ b (h₀ : ℝ)) ((b : ℝ)*lineE m e₀ a (h₀ : ℝ))
      (m : ℝ) (q : ℝ) (lineD m d₀ b (h₀ : ℝ)*lineE m e₀ a (h₀ : ℝ)) W x
      (N.eval (h₀ : ℝ)) hW hb₀.1 (by linarith) hheight₀.1 hheight₀.2 hqlo
      (line_level a b m d₀ e₀ hbez h₀) hz' (line_normal a b m q d₀ e₀ hm h₀))
  let k := |((a*b : ℤ) : ℝ)|
  have hk : 1 ≤ k := integer_abs_ge_one (a*b) habne
  have hkp : 0 < k := by linarith
  by_cases haff : k*W ≤ 65536*mu^2
  · have hAK : A ≤ 131072*C/cM :=
      hAc.trans (bounded_affine_scalar C cM W M mu k hC hcM hW hM hmu hk hMfloor haff)
    have hAKZ : 1+A ≤ (1+131072*C/cM)*(1+Z) := by
      have hh := mul_nonneg (show 0 ≤ 1+131072*C/cM by positivity) hZ
      nlinarith [hAK]
    exact finish_fee _ _ w A (131072*C/cM) Z _ (by positivity) hw hA
      (by positivity) hZ hRcR hYcell hAKZ hL₂
  have hkneg : ((a*b : ℤ) : ℝ) < 0 := by
    have hk0 : ((a*b : ℤ) : ℝ) ≠ 0 := by exact_mod_cast habne
    rcases lt_or_gt_of_ne hk0 with hn | hp
    · exact hn
    · exfalso
      apply haff
      have hlev := line_level a b m d₀ e₀ hbez (h₀ : ℝ)
      have hAB :
          ((a : ℝ)*lineD m d₀ b (h₀ : ℝ))*((b : ℝ)*lineE m e₀ a (h₀ : ℝ)) =
            ((a*b : ℤ) : ℝ)*(lineD m d₀ b (h₀ : ℝ)*lineE m e₀ a (h₀ : ℝ)) := by push_cast; ring
      have hs := sq_nonneg ((a : ℝ)*lineD m d₀ b (h₀ : ℝ)-(b : ℝ)*lineE m e₀ a (h₀ : ℝ))
      have hlev2 := congrArg (fun z : ℝ => z^2) hlev
      have hm2 : mu^2=(m : ℝ)^2 := sq_abs _
      dsimp [k]
      rw [abs_of_pos hp]
      have hPiPositive : 0 < 4*(lineD m d₀ b (h₀ : ℝ)*lineE m e₀ a (h₀ : ℝ))-W := by
        linarith [hb₀.1]
      have hmult := mul_pos hp hPiPositive
      nlinarith [hlev2,hAB,hs,hm2,hmult]
  have hsmall₁ : |(m : ℝ)|^5*x < (D*E)^3/65536 := by
    change mu^5*x < W^3/65536
    nlinarith only [hlarge]
  have hsmall₂ : (m : ℝ)^2 < |((a*b : ℤ) : ℝ)| *(D*E)/65536 := by
    have hm2 : mu^2=(m : ℝ)^2 := sq_abs _
    change (m : ℝ)^2 < k*W/65536
    nlinarith only [haff,hm2]
  have hreal (z : ℝ) (hz : lineBox D E a b m d₀ e₀ z)
      (hn0 : 0 ≤ N.eval z) (hnx : N.eval z ≤ x) :=
    line_real_cancellation a b m q d₀ e₀ hm hq hbez D E x hD hE hkneg
      hsmall₁ hsmall₂ z hz hn0 hnx
  have hforce : W ≤ (2^40 : ℝ)*k^5 := (hreal h₀ hbox₀ hheight₀.1 hheight₀.2).1
  let Btar := W^2*k^3/(16*mu^5)
  let BB := 16*x*g^4/(W^2*k^3)
  have hBtar : 0 < Btar := by dsimp [Btar]; positivity
  have hBB : 0 ≤ BB := by dsimp [BB]; positivity
  have hBcost : x/(Btar*(QN : ℝ))=BB := by
    dsimp [Btar,BB]
    rw [hQeq]
    field_simp
    <;> ring
  have hYheight : (Y.card : ℝ) ≤ (R.card : ℝ)*39*(1+BB) := by
    have hh := finite_residue_cover_count Y R (QN : ℤ) (39*(1+BB))
      (by positivity) hcover (by
        intro r hr
        let F := Y.filter (fun y => ∃ z : ℤ, y=r+(QN : ℤ)*z)
        have hf := fixed_progression_height_count N 6
          (heightPoly_degree (a : ℝ) (b : ℝ) (m : ℝ) (q : ℝ) (d₀ : ℝ) (e₀ : ℝ))
          x Btar hx0.le hBtar r (QN : ℤ) hQZ
          (lineBox D E a b m d₀ e₀) F
          (by intro y hy; exact (Finset.mem_filter.mp hy).2)
          (by intro y hy; exact hheight y (Finset.mem_filter.mp hy).1)
          (by
            intro s hs t ht z hsz hzt
            have hu := hbox s (Finset.mem_filter.mp hs).1
            have hv := hbox t (Finset.mem_filter.mp ht).1
            constructor
            · exact affine_box_segment ((m : ℝ)*(d₀ : ℝ)) (b : ℝ)
                (D/2) D s t z hsz hzt hu.1 hv.1
            · simpa only [lineE,sub_eq_add_neg,neg_mul] using
                affine_box_segment ((m : ℝ)*(e₀ : ℝ)) (-(a : ℝ))
                  (E/2) E s t z hsz hzt
                  (by simpa only [lineE,sub_eq_add_neg,neg_mul] using hu.2)
                  (by simpa only [lineE,sub_eq_add_neg,neg_mul] using hv.2))
          (by intro z hz hn0 hnx; exact (hreal z hz hn0 hnx).2)
        simp only [Int.cast_natCast] at hf
        norm_num only [Nat.reduceAdd,Nat.reduceMul,Nat.cast_ofNat] at hf
        rw [hBcost] at hf
        exact hf)
    simpa only [mul_assoc] using hh
  have hYmin : (Y.card : ℝ) ≤ (R.card : ℝ)*39*(1+min A BB) := by
    rcases le_total A BB with hh | hh
    · simpa only [min_eq_left hh] using hYcell
    · simpa only [min_eq_right hh] using hYheight
  have hmin : min A BB ≤ 2048*(C+1)*Z := by
    rw [hAeq]
    exact cancellation_scalar C x M W mu g k hC hx0 hM hW hmu hgp hgmu hkp hforce
  exact finish_fee _ _ w (min A BB) (2048*(C+1)) Z _
    (by positivity) hw (le_min hA hBB) (by positivity) hZ hRcR hYmin
    (by nlinarith only [hmin,hZ,show 0 ≤ 2048*(C+1) by positivity]) hL₃

end A6P3Analysis

noncomputable section
namespace A6P3Analysis
open Classical Polynomial
open scoped BigOperators
set_option maxHeartbeats 2600000
set_option maxRecDepth 5000
set_option linter.all false

def OriginalCell (C x D E M s₀ : ℝ) (p : Fin 4 → ℕ) : Prop :=
  0 < p 0 ∧ 0 < p 1 ∧ 0 < p 2 ∧ 0 < p 3 ∧
  (p 1 : ℤ)^3*(p 3 : ℤ)-(p 0 : ℤ)^3*(p 2 : ℤ)=1 ∧
  1 ≤ (p 0 : ℝ)^3*(p 2 : ℝ) ∧ (p 0 : ℝ)^3*(p 2 : ℝ) ≤ x ∧
  D/2 < (p 0 : ℝ) ∧ (p 0 : ℝ) ≤ D ∧
  E/2 < (p 1 : ℝ) ∧ (p 1 : ℝ) ≤ E ∧
  |(p 0 : ℝ)/(p 1 : ℝ)-s₀| ≤ C*D/(E*M)

theorem originalCell_finite
    (C x D E M s₀ : ℝ) (hx : 2 ≤ x) :
    ({p : Fin 4 → ℕ | OriginalCell C x D E M s₀ p} : Set (Fin 4 → ℕ)).Finite := by
  let B : ℕ := Nat.ceil (max D (max E (x+1)))
  have hB : max D (max E (x+1)) ≤ (B : ℝ) := Nat.le_ceil _
  apply (Set.finite_Iic (fun _ : Fin 4 => B)).subset
  intro p hp
  obtain ⟨hd,he,hu,hv,hunit,hn1,hnx,hdlo,hdhi,helo,hehi,hratio⟩ := hp
  have hdR : (1 : ℝ) ≤ (p 0 : ℝ) := by exact_mod_cast hd
  have heR : (1 : ℝ) ≤ (p 1 : ℝ) := by exact_mod_cast he
  have hdpow : (1 : ℝ) ≤ (p 0 : ℝ)^3 := one_le_pow₀ hdR
  have hepow : (1 : ℝ) ≤ (p 1 : ℝ)^3 := one_le_pow₀ heR
  have huR : (p 2 : ℝ) ≤ x := by
    have hh := mul_le_mul_of_nonneg_right hdpow (Nat.cast_nonneg (p 2) : 0 ≤ (p 2 : ℝ))
    nlinarith only [hh,hnx]
  have hunitR : (p 1 : ℝ)^3*(p 3 : ℝ)-(p 0 : ℝ)^3*(p 2 : ℝ)=1 := by
    exact_mod_cast hunit
  have hvR : (p 3 : ℝ) ≤ x+1 := by
    have hh := mul_le_mul_of_nonneg_right hepow (Nat.cast_nonneg (p 3) : 0 ≤ (p 3 : ℝ))
    nlinarith only [hh,hunitR,hnx]
  show p ≤ fun _ => B
  intro i
  fin_cases i
  · have hh : (p 0 : ℝ) ≤ (B : ℝ) := hdhi.trans ((le_max_left _ _).trans hB)
    exact_mod_cast hh
  · have hh : (p 1 : ℝ) ≤ (B : ℝ) :=
      hehi.trans ((le_max_left E (x+1)).trans ((le_max_right D _).trans hB))
    exact_mod_cast hh
  · have hh : (p 2 : ℝ) ≤ (B : ℝ) :=
      huR.trans ((by linarith : x ≤ x+1).trans
        ((le_max_right E (x+1)).trans ((le_max_right D _).trans hB)))
    exact_mod_cast hh
  · have hh : (p 3 : ℝ) ≤ (B : ℝ) :=
      hvR.trans ((le_max_right E (x+1)).trans ((le_max_right D _).trans hB))
    exact_mod_cast hh

theorem fixed_original_level_count
    (C cM : ℝ) (hC : 0 < C) (hcM : 0 < cM) (hcM1 : cM ≤ 1)
    (x D E M s₀ : ℝ) (hx : 2 ≤ x) (hD : 0 < D) (hE : 0 < E)
    (hfloor : cM*x^((1 : ℝ)/5) ≤ M)
    (a b m q d₀ e₀ : ℤ) (hprim : Int.gcd a b=1) (hm : m ≠ 0) (hq : q ≠ 0)
    (hbez : a*d₀+b*e₀=1) (T : Finset (Fin 4 → ℕ))
    (hlevel : ∀ p ∈ T, p ∈ A6P3Tuple.levelSet a b m q)
    (hcell : ∀ p ∈ T, OriginalCell C x D E M s₀ p) :
    (T.card : ℝ) ≤ levelConst C cM*(3 : ℝ)^m.natAbs.primeFactors.card*
      (1+price x M (D*E)) := by
  classical
  let f := A6P3Tuple.coord d₀ e₀
  let Y := T.image f
  have hcY : Y.card=T.card := A6P3Tuple.card_coord_image a b m q d₀ e₀ hm hbez T hlevel
  have coords (p : Fin 4 → ℕ) (hp : p ∈ T) :
      (p 0 : ℤ)=m*d₀+b*f p ∧ (p 1 : ℤ)=m*e₀-a*f p :=
    A6P3Tuple.coordinates a b m d₀ e₀ (p 0) (p 1) hbez (hlevel p hp).1
  have coordsR (p : Fin 4 → ℕ) (hp : p ∈ T) :
      lineD m d₀ b (f p : ℝ)=(p 0 : ℝ) ∧
      lineE m e₀ a (f p : ℝ)=(p 1 : ℝ) := by
    constructor
    · dsimp [lineD]
      exact_mod_cast (coords p hp).1.symm
    · dsimp [lineE]
      exact_mod_cast (coords p hp).2.symm
  have hval (p : Fin 4 → ℕ) (hp : p ∈ T) :
      (lineHeight a b m q d₀ e₀).eval (f p : ℝ)=(p 0 : ℝ)^3*(p 2 : ℝ) := by
    have hmR : (m : ℝ) ≠ 0 := by exact_mod_cast hm
    have hu := (hlevel p hp).2.1
    have huR :
        (m : ℝ)^5*(p 2 : ℝ)=(q : ℝ)*(p 1 : ℝ)^3-(a : ℝ)^3*
          (((a : ℝ)*(p 0 : ℝ))^2+5*((a : ℝ)*(p 0 : ℝ))*((b : ℝ)*(p 1 : ℝ))+
            10*((b : ℝ)*(p 1 : ℝ))^2) := by exact_mod_cast hu
    change (heightPoly (a : ℝ) (b : ℝ) (m : ℝ) (q : ℝ) (d₀ : ℝ) (e₀ : ℝ)).eval _=_
    rw [heightPoly_eval]
    change ((q : ℝ)*(lineD m d₀ b (f p : ℝ)*lineE m e₀ a (f p : ℝ))^3-
      H3 ((a : ℝ)*lineD m d₀ b (f p : ℝ)) ((b : ℝ)*lineE m e₀ a (f p : ℝ)))/
        (m : ℝ)^5=_
    rw [(coordsR p hp).1,(coordsR p hp).2]
    apply (div_eq_iff (pow_ne_zero 5 hmR)).mpr
    dsimp [H3]
    linear_combination -(p 0 : ℝ)^3*huR
  have hboxY : ∀ h ∈ Y, lineBox D E a b m d₀ e₀ (h : ℝ) := by
    intro h hh
    obtain ⟨p,hp,rfl⟩ := Finset.mem_image.mp hh
    obtain ⟨hd,he,hu,hv,hunit,hn1,hnx,hdlo,hdhi,helo,hehi,hratio⟩ := hcell p hp
    dsimp [lineBox]
    rw [(coordsR p hp).1,(coordsR p hp).2]
    exact ⟨⟨hdlo,hdhi⟩,⟨helo,hehi⟩⟩
  have hcellY : ∀ h ∈ Y,
      |lineD m d₀ b (h : ℝ)/lineE m e₀ a (h : ℝ)-s₀| ≤ C*D/(E*M) := by
    intro h hh
    obtain ⟨p,hp,rfl⟩ := Finset.mem_image.mp hh
    rw [(coordsR p hp).1,(coordsR p hp).2]
    exact (hcell p hp).2.2.2.2.2.2.2.2.2.2.2
  have hheightY : ∀ h ∈ Y,
      0 ≤ (lineHeight a b m q d₀ e₀).eval (h : ℝ) ∧
      (lineHeight a b m q d₀ e₀).eval (h : ℝ) ≤ x := by
    intro h hh
    obtain ⟨p,hp,rfl⟩ := Finset.mem_image.mp hh
    rw [hval p hp]
    obtain ⟨hd,he,hu,hv,hunit,hn1,hnx,hdlo,hdhi,helo,hehi,hratio⟩ := hcell p hp
    exact ⟨by linarith,hnx⟩
  have hdivY : ∀ h ∈ Y,
      m^5 ∣ A6Local.NE a b m q d₀ e₀ h ∧ m^5 ∣ A6Local.ND a b m q d₀ e₀ h := by
    intro h hh
    obtain ⟨p,hp,rfl⟩ := Finset.mem_image.mp hh
    have hd : A6Local.D m d₀ b (f p)=(p 0 : ℤ) := (coords p hp).1.symm
    have he : A6Local.E m e₀ a (f p)=(p 1 : ℤ) := (coords p hp).2.symm
    constructor
    · dsimp only [A6Local.NE]
      rw [hd,he]
      dsimp only [A6Local.R3]
      rw [←(hlevel p hp).2.1]
      exact dvd_mul_right _ _
    · dsimp only [A6Local.ND]
      rw [hd,he]
      dsimp only [A6Local.R3]
      rw [←(hlevel p hp).2.2]
      exact dvd_mul_right _ _
  have hh := analytic_line_count C cM hC hcM hcM1 x D E M s₀ hx hD hE hfloor
    a b m q d₀ e₀ hprim hm hq hbez Y hboxY hcellY hheightY hdivY
  rwa [hcY] at hh

end A6P3Analysis

def A6P3OriginalCountStatement : Prop :=
  let form : (Fin 4 → ℤ) → MvPolynomial (Fin 2) ℚ := fun A =>
    ∑ i : Fin 4, MvPolynomial.C (A i : ℚ) *
      MvPolynomial.X (0 : Fin 2) ^ (i : ℕ) *
      MvPolynomial.X (1 : Fin 2) ^ (3 - (i : ℕ))
  let ev : (Fin 4 → ℤ) → ℤ → ℤ → ℤ := fun A d e =>
    ∑ i : Fin 4, A i * d ^ (i : ℕ) * e ^ (3 - (i : ℕ))
  ∀ C K cM : ℝ, 0 < C → 0 < K → 0 < cM →
  ∀ ε : ℝ, 0 < ε → ∃ B : ℝ, 0 < B ∧
  ∀ x D E M s0 : ℝ, 2 ≤ x → 0 < D → 0 < E →
    cM * x ^ ((1 : ℝ) / 5) ≤ M →
  ∀ P Q : Fin 4 → ℤ,
    (∀ i, |(P i : ℝ)| ≤ x ^ K) →
    (∀ i, |(Q i : ℝ)| ≤ x ^ K) →
    (∀ R : MvPolynomial (Fin 2) ℚ,
      R ∣ form P → R ∣ form Q → IsUnit R) →
  ∀ a b c : ℤ, Int.gcd a b = 1 → c ≠ 0 →
    (MvPolynomial.X (1 : Fin 2) ^ 3 * form Q -
      MvPolynomial.X (0 : Fin 2) ^ 3 * form P =
      MvPolynomial.C (c : ℚ) *
        (MvPolynomial.C (a : ℚ) * MvPolynomial.X (0 : Fin 2) +
         MvPolynomial.C (b : ℚ) * MvPolynomial.X (1 : Fin 2)) ^ 6) →
  let S : Set (Fin 4 → ℕ) := {z |
    let d := z 0; let e := z 1; let u := z 2; let v := z 3
    0 < d ∧ 0 < e ∧ 0 < u ∧ 0 < v ∧
    (e : ℤ) ^ 3 * (v : ℤ) - (d : ℤ) ^ 3 * (u : ℤ) = 1 ∧
    1 ≤ (d : ℝ) ^ 3 * (u : ℝ) ∧ (d : ℝ) ^ 3 * (u : ℝ) ≤ x ∧
    D / 2 < (d : ℝ) ∧ (d : ℝ) ≤ D ∧
    E / 2 < (e : ℝ) ∧ (e : ℝ) ≤ E ∧
    |(d : ℝ) / (e : ℝ) - s0| ≤ C * D / (E * M) ∧
    (u : ℤ) * ev Q d e = (v : ℤ) * ev P d e}
  S.Finite ∧ (S.ncard : ℝ) ≤ B * x ^ ε *
    (1 + x ^ ((1 : ℝ) / 3) /
      (M ^ ((2 : ℝ) / 3) * (D * E) ^ ((1 : ℝ) / 5)))

noncomputable section
namespace A6P3Analysis
open Classical Polynomial
open scoped BigOperators
set_option maxHeartbeats 3200000
set_option maxRecDepth 6000
set_option linter.all false

theorem complete_original_count : A6P3OriginalCountStatement := by
  dsimp only [A6P3OriginalCountStatement]
  intro C Hexp cM hC hHexp hcM ε hε
  let c₀ := min cM 1
  have hc₀ : 0 < c₀ := lt_min hcM (by norm_num)
  have hc₀1 : c₀ ≤ 1 := min_le_right _ _
  let η := ε/Hexp
  have hη : 0 < η := div_pos hε hHexp
  obtain ⟨CB,hCB,hbudget⟩ := signed_cubic_divisor_budget η hη
  let CL := levelConst C c₀
  have hCL : 0 < CL := by dsimp [CL,levelConst]; positivity
  have hCBp : 0 < CB := by linarith
  refine ⟨CL*CB,mul_pos hCL hCBp,?_⟩
  intro x D E M s₀ hx hD hE hfloor P Q hPH hQH hcop a b c hprim hc hpure
  have hx0 : 0 < x := by linarith
  have hfloor₀ : c₀*x^((1 : ℝ)/5) ≤ M :=
    (mul_le_mul_of_nonneg_right (min_le_left _ _) (Real.rpow_nonneg hx0.le _)).trans hfloor
  let S : Set (Fin 4 → ℕ) := {z |
    let d := z 0; let e := z 1; let u := z 2; let v := z 3
    0 < d ∧ 0 < e ∧ 0 < u ∧ 0 < v ∧
    (e : ℤ)^3*(v : ℤ)-(d : ℤ)^3*(u : ℤ)=1 ∧
    1 ≤ (d : ℝ)^3*(u : ℝ) ∧ (d : ℝ)^3*(u : ℝ) ≤ x ∧
    D/2 < (d : ℝ) ∧ (d : ℝ) ≤ D ∧ E/2 < (e : ℝ) ∧ (e : ℝ) ≤ E ∧
    |(d : ℝ)/(e : ℝ)-s₀| ≤ C*D/(E*M) ∧
    (u : ℤ)*A6CubicNormalForm.ev Q d e=(v : ℤ)*A6CubicNormalForm.ev P d e}
  change S.Finite ∧ (S.ncard : ℝ) ≤ (CL*CB)*x^ε*(1+price x M (D*E))
  have hSdata (p : Fin 4 → ℕ) (hp : p ∈ S) :
      OriginalCell C x D E M s₀ p ∧
      (p 2 : ℤ)*A6CubicNormalForm.ev Q (p 0) (p 1)=
        (p 3 : ℤ)*A6CubicNormalForm.ev P (p 0) (p 1) := by
    obtain ⟨hd,he,hu,hv,hunit,hn1,hnx,hdlo,hdhi,helo,hehi,hratio,hgraph⟩ := hp
    exact ⟨⟨hd,he,hu,hv,hunit,hn1,hnx,hdlo,hdhi,helo,hehi,hratio⟩,hgraph⟩
  have hSfinite : S.Finite :=
    (originalCell_finite C x D E M s₀ hx).subset (by intro p hp; exact (hSdata p hp).1)
  refine ⟨hSfinite,?_⟩
  let T := hSfinite.toFinset
  have hT (p : Fin 4 → ℕ) : p ∈ T ↔ p ∈ S := by simp [T]
  have hST : (T : Set (Fin 4 → ℕ))=S := by ext p; exact hT p
  have hcard : S.ncard=T.card := by rw [←hST,Set.ncard_coe_finset]
  rw [hcard]
  obtain ⟨K₀,hK₀,hKK,hmean,hheight,hpoints⟩ :=
    A6CubicNormalForm.normal_form_and_signed_levels P Q a b c hcop hc hpure
  have hKheight : |(K₀ : ℝ)| ≤ x^Hexp := hheight (x^Hexp) hPH hQH
  have hKcast : (K₀.natAbs : ℝ)=|(K₀ : ℝ)| := by
    simpa only [Int.cast_natCast,Int.cast_abs] using
      congrArg (fun z : ℤ => (z : ℝ)) (Int.natCast_natAbs K₀)
  have hpow : (x^Hexp)^η=x^ε := by
    rw [←Real.rpow_mul hx0.le]
    congr 1
    dsimp [η]
    field_simp
  have hbudgetK :
      2*(∑ n ∈ K₀.natAbs.divisors, (3 : ℝ)^n.primeFactors.card) ≤ CB*x^ε := by
    calc
      _ ≤ CB*(K₀.natAbs : ℝ)^η := hbudget K₀.natAbs (Int.natAbs_ne_zero.mpr hK₀)
      _ ≤ CB*(x^Hexp)^η := by
        apply mul_le_mul_of_nonneg_left _ hCBp.le
        apply Real.rpow_le_rpow (Nat.cast_nonneg K₀.natAbs) _ hη.le
        rwa [hKcast]
      _ = CB*x^ε := by rw [hpow]
  obtain ⟨d₀,e₀,hbez'⟩ := Int.isCoprime_iff_gcd_eq_one.mpr hprim
  have hbez : a*d₀+b*e₀=1 := by nlinarith only [hbez']
  let mp : (Fin 4 → ℕ) → ℤ := fun p => a*(p 0 : ℤ)+b*(p 1 : ℤ)
  have hpure (p : Fin 4 → ℕ) (hp : p ∈ T) :
      mp p ≠ 0 ∧ ∃ q : ℤ, q ≠ 0 ∧ K₀=c*mp p*q ∧
        (mp p)^5*(p 2 : ℤ)=q*(p 1 : ℤ)^3-a^3*A6CubicNormalForm.R3
          (a*(p 0 : ℤ)) (b*(p 1 : ℤ)) ∧
        (mp p)^5*(p 3 : ℤ)=q*(p 0 : ℤ)^3+b^3*A6CubicNormalForm.R3
          (b*(p 1 : ℤ)) (a*(p 0 : ℤ)) := by
    have hd := hSdata p ((hT p).mp hp)
    exact hpoints (p 0) (p 1) (p 2) (p 3) hd.1.2.2.2.2.1 hd.2
  let label : (Fin 4 → ℕ) → Fin 2 × ℕ :=
    fun p => (if 0 ≤ mp p then 0 else 1,(mp p).natAbs)
  let signed : Fin 2 × ℕ → ℤ := fun s => if s.1=0 then (s.2 : ℤ) else -(s.2 : ℤ)
  let Labels : Finset (Fin 2 × ℕ) := Finset.univ.product K₀.natAbs.divisors
  have reconstruct (p : Fin 4 → ℕ) : signed (label p)=mp p := by
    by_cases hh : 0 ≤ mp p
    · simp [signed,label,hh,Int.natCast_natAbs,abs_of_nonneg hh]
    · have hn : mp p < 0 := lt_of_not_ge hh
      simp [signed,label,hh,Int.natCast_natAbs,abs_of_neg hn]
  have hlabels (p : Fin 4 → ℕ) (hp : p ∈ T) : label p ∈ Labels := by
    obtain ⟨hm,q,hq,hK,hu,hv⟩ := hpure p hp
    have hmd : mp p ∣ K₀ := by
      refine ⟨c*q,?_⟩
      rw [hK]
      ring
    have hn : (mp p).natAbs ∈ K₀.natAbs.divisors :=
      Nat.mem_divisors.mpr ⟨Int.natAbs_dvd_natAbs.mpr hmd,Int.natAbs_ne_zero.mpr hK₀⟩
    change label p ∈ Finset.univ.product K₀.natAbs.divisors
    exact Finset.mem_product.mpr ⟨Finset.mem_univ _,hn⟩
  let Tf : (Fin 2 × ℕ) → Finset (Fin 4 → ℕ) := fun s => T.filter (fun p => label p=s)
  let Price := 1+price x M (D*E)
  have hM : 0 < M := lt_of_lt_of_le
    (mul_pos hc₀ (Real.rpow_pos_of_pos hx0 _)) hfloor₀
  have hPrice : 0 ≤ Price := by dsimp [Price,price]; positivity
  have hfiber (s : Fin 2 × ℕ) (hs : s ∈ Labels) :
      ((Tf s).card : ℝ) ≤ CL*(3 : ℝ)^s.2.primeFactors.card*Price := by
    by_cases he : Tf s=∅
    · rw [he,Finset.card_empty,Nat.cast_zero]
      positivity
    obtain ⟨p₀,hp₀⟩ := Finset.nonempty_iff_ne_empty.mpr he
    have hp₀T : p₀ ∈ T := (Finset.mem_filter.mp hp₀).1
    have hl₀ : label p₀=s := (Finset.mem_filter.mp hp₀).2
    obtain ⟨hm₀,q₀,hq₀,hK₀eq,hu₀,hv₀⟩ := hpure p₀ hp₀T
    have habs : (mp p₀).natAbs=s.2 := congrArg Prod.snd hl₀
