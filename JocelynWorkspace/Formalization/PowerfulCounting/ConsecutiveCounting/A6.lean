theorem mfactsR : ∀ δ : ℝ, 0 < δ → δ < (1/2000 : ℝ) → ∀ x : ℝ, (2 : ℝ)^2000 ≤ x → let M : ℕ := ⌈x^((1 : ℝ)/3+δ)⌉₊; let μ : ℝ := Real.log (M : ℝ)/Real.log x; 1 ≤ M ∧ x^((1 : ℝ)/3) ≤ (M : ℝ) ∧ (M : ℝ) ≤ x ∧ (1/3 : ℝ) ≤ μ ∧ μ ≤ (43/125 : ℝ) ∧ (M : ℝ) = x^μ := by
  dsimp only
  intro δ hδ hδu x hx
  let a : ℝ := (1 : ℝ)/3+δ
  let M : ℕ := ⌈x^a⌉₊
  let μ : ℝ := Real.log (M : ℝ)/Real.log x
  change 1 ≤ M ∧ x^((1 : ℝ)/3) ≤ (M : ℝ) ∧ (M : ℝ) ≤ x ∧
    (1/3 : ℝ) ≤ μ ∧ μ ≤ (43/125 : ℝ) ∧ (M : ℝ) = x^μ
  have htwo : (2 : ℝ) ≤ (2 : ℝ)^2000 := by
    calc
      (2 : ℝ) = (2 : ℝ)^1 := by norm_num
      _ ≤ (2 : ℝ)^2000 := pow_le_pow_right₀ (by norm_num) (by norm_num)
  have hx2 : 2 ≤ x := htwo.trans hx
  have hx1 : 1 ≤ x := by linarith only [hx2]
  have hx0 : 0 < x := by linarith only [hx2]
  have hlogx : 0 < Real.log x := Real.log_pos (by linarith only [hx2])
  have ha : (1/3 : ℝ) ≤ a := by dsimp [a]; linarith
  have hau : a+(1/2000 : ℝ) ≤ (43/125 : ℝ) := by dsimp [a]; linarith
  have hypos : 0 < x^a := Real.rpow_pos_of_pos hx0 _
  have hy1 : 1 ≤ x^a := by
    calc
      1 = x^(0 : ℝ) := by simp
      _ ≤ x^a := Real.rpow_le_rpow_of_exponent_le hx1 (by linarith)
  have hceil : x^a ≤ (M : ℝ) := Nat.le_ceil _
  have hceilU : (M : ℝ) < x^a+1 := Nat.ceil_lt_add_one hypos.le
  have hM1 : (1 : ℝ) ≤ (M : ℝ) := hy1.trans hceil
  have hM0 : 0 < (M : ℝ) := by linarith
  have hMnat : 1 ≤ M := by exact_mod_cast hM1
  have hfloor : x^((1 : ℝ)/3) ≤ (M : ℝ) :=
    (Real.rpow_le_rpow_of_exponent_le hx1 ha).trans hceil
  have hroot : ((2 : ℝ)^2000)^((1 : ℝ)/2000) = 2 := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2)]
    norm_num
  have htiny : (2 : ℝ) ≤ x^((1 : ℝ)/2000) := by
    rw [← hroot]
    exact Real.rpow_le_rpow (by positivity) hx (by norm_num)
  have hMpow : (M : ℝ) ≤ x^((43 : ℝ)/125) := by
    calc
      (M : ℝ) ≤ x^a+1 := hceilU.le
      _ ≤ x^a*2 := by linarith
      _ ≤ x^a*x^((1 : ℝ)/2000) :=
        mul_le_mul_of_nonneg_left htiny hypos.le
      _ = x^(a+(1/2000 : ℝ)) := (Real.rpow_add hx0 _ _).symm
      _ ≤ x^((43 : ℝ)/125) := Real.rpow_le_rpow_of_exponent_le hx1 hau
  have hMx : (M : ℝ) ≤ x := by
    calc
      (M : ℝ) ≤ x^((43 : ℝ)/125) := hMpow
      _ ≤ x^(1 : ℝ) := Real.rpow_le_rpow_of_exponent_le hx1 (by norm_num)
      _ = x := by simp
  have hloLog : (1/3 : ℝ)*Real.log x ≤ Real.log (M : ℝ) := by
    rw [← Real.log_rpow hx0]
    exact Real.log_le_log (Real.rpow_pos_of_pos hx0 _) hfloor
  have hhiLog : Real.log (M : ℝ) ≤ (43/125 : ℝ)*Real.log x := by
    calc
      Real.log (M : ℝ) ≤ Real.log (x^((43 : ℝ)/125)) := Real.log_le_log hM0 hMpow
      _ = (43/125 : ℝ)*Real.log x := Real.log_rpow hx0 _
  have hμl : (1/3 : ℝ) ≤ μ := (le_div_iff₀ hlogx).mpr hloLog
  have hμu : μ ≤ (43/125 : ℝ) := (div_le_iff₀ hlogx).mpr hhiLog
  have heq : (M : ℝ) = x^μ := by
    rw [Real.rpow_def_of_pos hx0]
    have he : Real.log x*μ = Real.log (M : ℝ) := by
      dsimp [μ]
      field_simp [hlogx.ne']
    rw [he, Real.exp_log hM0]
  exact ⟨hMnat, hfloor, hMx, hμl, hμu, heq⟩

