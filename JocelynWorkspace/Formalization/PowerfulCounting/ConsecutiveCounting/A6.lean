  have hcopQ := P7A.bQ P Q hGeomGraph
  have hPNQ := P7A.bR P Q hP hQ hcopQ
  have hmapGraph :
      map (Int.castRingHom ℂ) (P7A.bO P Q)=
        P7A.bO (map (Int.castRingHom ℂ) P) (map (Int.castRingHom ℂ) Q) := by
    simp [P7A.bO,P7A.bN,MvPolynomial.map_rename]
  have hcopC := P7A.bP (map (Int.castRingHom ℂ) P) (map (Int.castRingHom ℂ) Q)
    (hmapGraph ▸ hGeomGraph)
  refine ⟨P,Q,hGraph,?_⟩
  intro hnotPure D E M j
  have hT : (e0Population Q P x).Finite ∧
      ((e0Population Q P x).ncard:ℝ)≤C*x^eps :=
