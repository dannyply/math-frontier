private theorem dG (p:U) [Fact p.Prime] (k:U)
 (F G:ae) (hF:F.natDegree ≤ 4) (hG:G.natDegree ≤ 4):
 ∃ A:Finset (I × U),A.card ≤ 8 ∧
 (∀ s ∈ A,0 < s.2 ∧
 C ((p:I) ^ k) ∣ F.comp (dA s) ∧
 C ((p:I) ^ k) ∣ G.comp (dA s)) ∧
 (∀ r:I,(p:I) ^ k ∣ F.eval r → (p:I) ^ k ∣ G.eval r →
 ∃ s ∈ A,dB s r):=by
