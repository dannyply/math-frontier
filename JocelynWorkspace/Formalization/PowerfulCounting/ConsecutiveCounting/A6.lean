private theorem cl
 (F G q:aa)
 (hG:cj F G) (hqF:q∣F) (hq:q ≠ 0)
 (hqG:q∣G)
 (hass:Associated (ag q)
 (ag G)):
 cj F q:=by
  obtain ⟨hGF,hG0,hGeom,hGBi,P,Q,a,b,c,bI,hab,hc,hpure⟩:=hG
  have hqBi:Bihom41 q:=by
