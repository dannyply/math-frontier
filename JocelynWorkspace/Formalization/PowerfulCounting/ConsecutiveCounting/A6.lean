 Associated s.prod F ∧
 (s.map MvPolynomial.totalDegree).sum = F.totalDegree:=by
  obtain ⟨s,bG,bI⟩:=
    UniqueFactorizationMonoid.exists_prime_factors F hF
  have hs:∀ p ∈ s,p ≠ 0:=by
    intro p hp
    exact (bG p hp).ne_zero
  obtain ⟨hs0,hdeg⟩:= totalDegree_prod_eq_sum s hs
  refine ⟨s,bG,bI,?_⟩
  rw [← hdeg]
  exact degree_eq_of_associated s.prod F hs0 hF bI
theorem card_positive_degree_le_sum
 (s:Multiset (aa)):
 (s.filter (fun p => 0 < p.totalDegree)).card ≤
 (s.map MvPolynomial.totalDegree).sum:=by
  induction s using bd with
  | empty => simp
  | @cons p t ih =>
      by_cases hp:0 < p.totalDegree
      · simp only [Multiset.filter_cons,if_pos hp,Multiset.card_add,
          Multiset.card_singleton,be,bf]
        omega
      · simp only [Multiset.filter_cons,if_neg hp,zero_add,
          be,bf]
        omega
end P7D

namespace P7N

def PrimitiveIntegral (G:aa):Prop:=
  ∀ z:I,
    (∀ m:Fin 4 →₀ U,z ∣ aZ m G) →
      IsUnit z
theorem primitive_of_irreducibles
 (p:aa)
 (hp:Irreducible p)
 (hpC:Irreducible (ag p)):
 PrimitiveIntegral p:=by
  intro z hz
  have hd:ai z ∣ p:=
    (MvPolynomial.C_dvd_iff_dvd_coeff z p).mpr hz
  have hz0:z ≠ 0:=by
    intro hz0
    subst z
    obtain ⟨q,hq⟩:= hd
    have hp0:p = 0:=by simpa using hq
    exact hp.ne_zero hp0
  rcases (hp.dvd_iff).mp hd with hu | ha
  · let ev:aa →+* I:=
      MvPolynomial.eval₂Hom (RingHom.id I) (fun _ => 0)
    have he:IsUnit (ev (ai z)):= hu.map ev
    simpa [ev] using he
  · have hpz:p ∣ ai z:= ha.dvd
    obtain ⟨b,hbz,hpb⟩:= (MvPolynomial.dvd_C_iff_exists hz0).mp hpz
    have hb0:b ≠ 0:=by
      intro hb0
      have hp0:p = 0:=by simpa [hb0] using hpb
      exact hp.ne_zero hp0
    have hbC:(b:ℂ) ≠ 0:=by exact_mod_cast hb0
    have huC:IsUnit (ai (b:ℂ):ad):=
      ((isUnit_iff_ne_zero).mpr hbC).map (ai:ℂ →+* ad)
    have hmap:ag p =
        ai (b:ℂ):=by solve | simp [hpb]
    exact False.elim (hpC.not_isUnit (hmap.symm ▸ huC))
end P7N

namespace P7C
open MvPolynomial

theorem intToComplex_totalDegree
 (p:aa):
 (ag p).totalDegree = p.totalDegree:=by
  have hs:(ag p).support = p.support:=
    aE p (by exact_mod_cast (Int.cast_injective:aH (fun z:I => (z:ℂ))))
  simp only [MvPolynomial.totalDegree,hs]
theorem intToComplex_nonunit_of_pos_degree
 (p:aa)
 (hp:0 < p.totalDegree):
 ¬IsUnit (ag p):=by
  intro hu
  have hd:= (aG hu).2
  rw [intToComplex_totalDegree] at hd
  omega
theorem positive_degree_of_complex_irreducible
 (p:aa)
 (hp:Irreducible (ag p)):
 0 < p.totalDegree:=by
  by_contra hpos
  have hd:p.totalDegree = 0:=by omega
  have hdc:(ag p).totalDegree = 0:=by
    rw [intToComplex_totalDegree]
    exact hd
  have hC:= (MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp hdc
  have hc0:aZ 0
      (ag p) ≠ 0:=by
    intro hz
    have hp0:ag p = 0:=by
      simpa [hz] using hC
    exact hp.ne_zero hp0
  have hu0:IsUnit (aZ 0
      (ag p)):=
    (isUnit_iff_ne_zero).mpr hc0
  have hu:IsUnit (ag p):=
    (MvPolynomial.isUnit_iff_totalDegree_of_isReduced).mpr ⟨hu0,hdc⟩
  exact hp.not_isUnit hu
theorem totalDegree_prod_eq_sum
 (s:Multiset (aa))
 (hs:∀ p ∈ s,p ≠ 0):
 s.prod ≠ 0 ∧
 s.prod.totalDegree = (s.map MvPolynomial.totalDegree).sum:=by
  induction s using bd with
  | empty => simp
  | @cons p t ih =>
      have hp:p ≠ 0:= hs p (by simp)
      have ht:∀ q ∈ t,q ≠ 0:=by
        intro q hq
        exact hs q (by simp [hq])
      obtain ⟨ht0,htd⟩:= ih ht
      constructor
      · simpa using mul_ne_zero hp ht0
      · simp only [Multiset.prod_cons,be,bf]
        rw [ay hp ht0,htd]
theorem degree_le_of_dvd (a b:aa)
 (ha:a ≠ 0) (hb:b ≠ 0) (hab:a ∣ b):
 a.totalDegree ≤ b.totalDegree:=by
  obtain ⟨c,rfl⟩:= hab
  have hc:c ≠ 0:=by
    intro hc
    simp [hc] at hb
  rw [ay ha hc]
  omega
theorem degree_eq_of_associated (a b:aa)
 (ha:a ≠ 0) (hb:b ≠ 0) (hab:Associated a b):
 a.totalDegree = b.totalDegree:=by
  exact le_antisymm (degree_le_of_dvd a b ha hb hab.dvd)
    (degree_le_of_dvd b a hb ha hab.symm.dvd)
theorem exists_prime_factors_degree (F:aa)
 (hF:F ≠ 0):
 ∃ s:Multiset (aa),
 (∀ p ∈ s,Prime p) ∧
 Associated s.prod F ∧
 (s.map MvPolynomial.totalDegree).sum = F.totalDegree:=by
  obtain ⟨s,bG,bI⟩:=
    UniqueFactorizationMonoid.exists_prime_factors F hF
  have hs:∀ p ∈ s,p ≠ 0:=by
    intro p hp
    exact (bG p hp).ne_zero
  obtain ⟨hs0,hdeg⟩:= totalDegree_prod_eq_sum s hs
  refine ⟨s,bG,bI,?_⟩
  rw [← hdeg]
  exact degree_eq_of_associated s.prod F hs0 hF bI
theorem positive_prime_factor_of_geometric_irreducible
 (G:aa) (hG:G ≠ 0)
 (hGeom:Irreducible (ag G)):
 ∃ p:aa,
 Prime p ∧ 0 < p.totalDegree ∧ p ∣ G ∧
 Associated (ag p)
 (ag G):=by
  obtain ⟨s,bJ,bK,hsum⟩:= exists_prime_factors_degree G hG
  have hGpos:= positive_degree_of_complex_irreducible G hGeom
  have bG:0 < (s.map MvPolynomial.totalDegree).sum:=by omega
  have bI:∀ t:Multiset (aa),
      0 < (t.map MvPolynomial.totalDegree).sum →
      ∃ p ∈ t,0 < p.totalDegree:=by
    intro t
    induction t using bd with
    | empty => simp
    | @cons a t ih =>
      intro h
      by_cases ha:0 < a.totalDegree
      · exact ⟨a,by simp,ha⟩
      · have ht:0 < (t.map MvPolynomial.totalDegree).sum:=by
          simp only [be,bf] at h
          omega
        obtain ⟨p,hp,hpdeg⟩:= ih ht
        exact ⟨p,by simp [hp],hpdeg⟩
  obtain ⟨p,hp,hpdeg⟩:= bI s bG
  have hpd:p ∣ G:= (Multiset.dvd_prod hp).trans bK.dvd
  have hmapd:ag p ∣
      ag G:=by
    obtain ⟨r,hr⟩:= hpd
    refine ⟨ag r,?_⟩
    simp [hr]
  have bK:Associated
      (ag p)
      (ag G):=by
    rcases (Irreducible.dvd_iff hGeom).mp hmapd with hu | ha
    · exact False.elim ((intToComplex_nonunit_of_pos_degree p hpdeg) hu)
    · exact ha.symm
  exact ⟨p,bJ p hp,hpdeg,hpd,bK⟩
theorem match_geometric_factor_to_prime_family_with_integral_divisor
 (F G:aa)
 (s:Multiset (aa))
 (bG:∀ q ∈ s,Prime q)
 (hassF:Associated s.prod F)
 (hG:G ≠ 0) (hGF:G ∣ F)
 (hGeom:Irreducible (ag G)):
 ∃ q ∈ s,Prime q ∧ 0 < q.totalDegree ∧ q ∣ F ∧ q ∣ G ∧
 Associated (ag q)
 (ag G):=by
  obtain ⟨p,hp,hpdeg,hpdG,hpmG⟩:=
    positive_prime_factor_of_geometric_irreducible G hG hGeom
  have hpdF:p ∣ F:= hpdG.trans hGF
  have bI:p ∣ s.prod:= hpdF.trans hassF.symm.dvd
  have bK:p ∣ s.toList.prod:=by simpa using bI
  obtain ⟨q,bL,hpdq⟩:= (Prime.dvd_prod_iff hp).mp bK
  have hqs:q ∈ s:=by simpa using bL
  have bJ:Prime q:= bG q hqs
  have hpq:Associated p q:=
    (Prime.dvd_prime_iff_associated hp bJ).mp hpdq
  have hqdeg:0 < q.totalDegree:=by
    have heq:= degree_eq_of_associated p q hp.ne_zero bJ.ne_zero hpq
    omega
  have hqF:q ∣ F:= (Multiset.dvd_prod hqs).trans hassF.dvd
  have bM:∀ {a b:aa},a ∣ b →
      ag a ∣
        ag b:=by
    intro a b hab
    obtain ⟨r,hr⟩:= hab
    refine ⟨ag r,?_⟩
    simp [hr]
  have hqmP:Associated
      (ag q)
      (ag p):=by
    exact associated_of_dvd_dvd (bM hpq.symm.dvd)
      (bM hpq.dvd)
  exact ⟨q,hqs,bJ,hqdeg,hqF,hpq.symm.dvd.trans hpdG,hqmP.trans hpmG⟩
theorem support_eq_of_associated_complex
 (P Q:ad)
 (h:Associated P Q):P.support = Q.support:=by
  obtain ⟨u,hu⟩:= h
  have hui:IsUnit (u:ad):= ⟨u,rfl⟩
  obtain ⟨c,hc,huc⟩:=
    (MvPolynomial.isUnit_iff_eq_C_of_isReduced).mp hui
  have hq:Q = ai c * P:=by
    rw [← hu,huc,mul_comm]
  apply Finset.ext
  intro m
  simp only [MvPolynomial.mem_support_iff]
  rw [hq,bA]
  simp [hc.ne_zero]
theorem support_eq_of_associated_maps
 (p q:aa)
 (h:Associated (ag p)
 (ag q)):
 p.support = q.support:=by
  have hi:aH (fun z:I => (z:ℂ)):=by
    exact_mod_cast (Int.cast_injective:aH (fun z:I => (z:ℂ)))
  calc
    p.support = (ag p).support:=
      (aE p hi).symm
    _ = (ag q).support:=
      support_eq_of_associated_complex _ _ h
    _ = q.support:= aE q hi
theorem eval_zero_iff_of_associated_maps
 (p q:aa)
 (h:Associated (ag p)
 (ag q))
 (x:Fin 4 → I):
 al x p = 0 ↔ al x q = 0:=by
  have bridge (r:aa):
      al (fun i => (x i:ℂ))
        (ag r) =
        ((al x r:I):ℂ):=by
    simpa [Function.comp_def] using
      (MvPolynomial.map_eval (an ℂ) x r).symm
  have dvd_zero (P Q:ad) (hd:P ∣ Q):
      al (fun i => (x i:ℂ)) P = 0 →
        al (fun i => (x i:ℂ)) Q = 0:=by
    obtain ⟨R,hR⟩:= hd
    intro hP
    simp [hR,hP]
  constructor
  · intro hp
    have hpc:al (fun i => (x i:ℂ))
        (ag p) = 0:=by
      rw [bridge]
      exact_mod_cast hp
    have hqc:= dvd_zero _ _ h.dvd hpc
    rw [bridge] at hqc
    exact_mod_cast hqc
  · intro hq
    have hqc:al (fun i => (x i:ℂ))
        (ag q) = 0:=by
      rw [bridge]
      exact_mod_cast hq
    have hpc:= dvd_zero _ _ h.symm.dvd hqc
    rw [bridge] at hpc
    exact_mod_cast hpc
end P7C

namespace P7A
open MvPolynomial

private def bN {R:Type*} [CommRing R]:
    MvPolynomial (Fin 2) R →+* MvPolynomial (Fin 4) R:=
  (aJ (fun i:Fin 2 => if i = 0 then (0:Fin 4) else 1)).toRingHom
private def bO {R:Type*} [CommRing R]
    (P Q:MvPolynomial (Fin 2) R):MvPolynomial (Fin 4) R:=
  bN P * X 2 - bN Q * X 3
private theorem bP
 {K:Type*} [Field K] (P Q:MvPolynomial (Fin 2) K)
 (hG:Irreducible (bO P Q)):IsRelPrime P Q:=by
  intro D hDP hDQ
  obtain ⟨iU,hU⟩:= hDP
  obtain ⟨V,hV⟩:= hDQ
  have hfac:bO P Q =
      bN D * (bN iU * X 2 - bN V * X 3):=by
    dsimp only [bO]
    rw [hU,hV,map_mul,map_mul]
    ring
  rcases hG.isUnit_or_isUnit hfac with hD | hUV
  · let r:Fin 4 → Fin 2:= fun i => if i = 0 then 0 else 1
    have hret:(fun i:Fin 2 =>
        r (if i = 0 then (0:Fin 4) else 1)) = id:=by
      funext i
      fin_cases i <;> simp [r]
    have hD':= hD.map (aJ r)
    change IsUnit (aJ r
      (aJ (fun i:Fin 2=>if i=0 then (0:Fin 4) else 1) D)) at hD'
    rw [MvPolynomial.rename_rename] at hD'
    change IsUnit (aJ
      (fun i:Fin 2=>r (if i=0 then (0:Fin 4) else 1)) D) at hD'
    simpa [hret,MvPolynomial.rename_id] using hD'
  · let ev:MvPolynomial (Fin 4) K →+* K:=
      MvPolynomial.eval₂Hom (RingHom.id K) (fun _ => 0)
    have hz:IsUnit (0:K):=by
      simpa [ev] using hUV.map ev
    exact False.elim (hz.ne_zero rfl)
private theorem bQ
 (P Q:ab)
 (hG:Irreducible (ag (bO P Q))):
 IsRelPrime (ah P)
 (ah Q):=by
  let f:ℚ →+* ℂ:= algebraMap ℚ ℂ
  have hmap (T:ab):
      aO f (ah T) =
        ag T:=by
    ext m
    simp only [MvPolynomial.coeff_map]
    solve | simp
  have bG:
      ag (bO P Q) =
        bO (ag P)
          (ag Q):=by
    simp [bO,bN,MvPolynomial.map_rename]
  have hcopC:= bP
    (ag P)
    (ag Q) (bG ▸ hG)
  intro D hDP hDQ
  obtain ⟨iU,hU⟩:= hDP
  obtain ⟨V,hV⟩:= hDQ
  have hDP':aO f D ∣ ag P:=by
    refine ⟨aO f iU,?_⟩
    rw [←hmap P,hU,map_mul]
  have hDQ':aO f D ∣ ag Q:=by
    refine ⟨aO f V,?_⟩
    rw [←hmap Q,hV,map_mul]
  have bI:IsUnit (aO f D):= hcopC hDP' hDQ'
  have hi:aH f:= RingHom.injective f
  have hs:(aO f D).support = D.support:=
    aE D hi
  have bK:(aO f D).totalDegree = D.totalDegree:=by
    simp only [MvPolynomial.totalDegree,hs]
  have hDdeg:D.totalDegree = 0:=by
    rw [←bK]
    exact (aG bI).2
  have hD0:D ≠ 0:=by
    intro hz
    rw [hz,map_zero] at bI
    exact bI.ne_zero rfl
  have hDC:D = ai (D.coeff 0):=
    bw hDdeg
  have bJ:D.coeff 0 ≠ 0:=by
    intro hz
    rw [hz,map_zero] at hDC
    exact hD0 hDC
  rw [hDC]
  exact ((isUnit_iff_ne_zero).mpr bJ).map
    (ai:ℚ →+* ac)
private theorem bR
 (P Q:ab)
 (hP:P.IsHomogeneous 4) (hQ:Q.IsHomogeneous 4)
 (hcop:IsRelPrime (ah P)
 (ah Q)):
 P ≠ 0 ∧ Q ≠ 0:=by
  have bG:P.coeff 0 = 0:= hP.coeff_eq_zero (by simp)
  have bI:Q.coeff 0 = 0:= hQ.coeff_eq_zero (by simp)
  have notunit (T:ab) (ht:T.coeff 0 = 0):
      ¬IsUnit (ah T):=by
    intro hu
    have hu0:= (aG hu).1
    have hz:(ah T).coeff 0 = 0:=by
      rw [MvPolynomial.coeff_map,ht,map_zero]
    rw [hz] at hu0
    exact hu0.ne_zero rfl
  constructor
  · intro hz
    apply notunit Q bI
    exact hcop (by rw [hz,map_zero];exact dvd_zero _) dvd_rfl
  · intro hz
    apply notunit P bG
    exact hcop dvd_rfl (by rw [hz,map_zero];exact dvd_zero _)
private def bIndex (i j:U):Fin 2 →₀ U:=
  ao 0 i+ao 1 j
private def qIndex (i j k l:U):Fin 4 →₀ U:=
  ao 0 i+ao 1 j+ao 2 k+ao 3 l
private theorem bS (i j i' j':U):
 bIndex i j = bIndex i' j' ↔ i = i' ∧ j = j':=by
  constructor
  · intro h
    have h₀:= congrArg (fun m:Fin 2 →₀ U=>m 0) h
    have h₁:= congrArg (fun m:Fin 2 →₀ U=>m 1) h
    simpa [bIndex] using And.intro h₀ h₁
  · rintro ⟨rfl,rfl⟩
    rfl
private theorem bT (i j k l i' j' k' l':U):
 qIndex i j k l = qIndex i' j' k' l' ↔
 i = i' ∧ j = j' ∧ k = k' ∧ l = l':=by
  constructor
  · intro h
    have h₀:= congrArg (fun m:Fin 4 →₀ U=>m 0) h
    have h₁:= congrArg (fun m:Fin 4 →₀ U=>m 1) h
    have h₂:= congrArg (fun m:Fin 4 →₀ U=>m 2) h
    have h₃:= congrArg (fun m:Fin 4 →₀ U=>m 3) h
    simpa [qIndex] using And.intro h₀ (And.intro h₁ (And.intro h₂ h₃))
  · rintro ⟨rfl,rfl,rfl,rfl⟩
    rfl
private theorem bU {R:Type*} [CommRing R]
 (r:R) (i j:U):
 monomial (bIndex i j) r = C r*(X (0:Fin 2))^i*(X 1)^j:=by
  calc
    _ = monomial (ao (0:Fin 2) i) r *
        monomial (ao (1:Fin 2) j) (1:R):=by
      rw [aL]
      simp [bIndex]
    _ = _:=by
      rw [←ap,←ap]
      simp [mul_assoc]
private theorem bV {R:Type*} [CommRing R]
 (r:R) (i j k l:U):
 monomial (qIndex i j k l) r =
 C r*(X (0:Fin 4))^i*(X 1)^j*(X 2)^k*(X 3)^l:=by
  calc
    _ = monomial (ao (0:Fin 4) i) r *
        monomial (ao (1:Fin 4) j) (1:R) *
        monomial (ao (2:Fin 4) k) (1:R) *
        monomial (ao (3:Fin 4) l) (1:R):=by
      rw [aL,aL,aL]
      simp [qIndex]
    _ = _:=by
      rw [←ap,←ap,
        ←ap,←ap]
      simp [mul_assoc]
private def bW {R:Type*} [CommRing R] (p₀ p₁ p₂ p₃ p₄:R):
    MvPolynomial (Fin 2) R:=
  monomial (bIndex 4 0) p₀+monomial (bIndex 3 1) p₁+
    monomial (bIndex 2 2) p₂+monomial (bIndex 1 3) p₃+
    monomial (bIndex 0 4) p₄
private theorem bX {R:Type*} [CommRing R]
 (p₀ p₁ p₂ p₃ p₄:R):
 (bW p₀ p₁ p₂ p₃ p₄).IsHomogeneous 4:=by
  have hx₀:(X (0:Fin 2):MvPolynomial (Fin 2) R).IsHomogeneous 1:=
    MvPolynomial.isHomogeneous_X R _
  have hx₁:(X (1:Fin 2):MvPolynomial (Fin 2) R).IsHomogeneous 1:=
    MvPolynomial.isHomogeneous_X R _
  have hc (r:R):(C r:MvPolynomial (Fin 2) R).IsHomogeneous 0:=
    MvPolynomial.isHomogeneous_C (Fin 2) r
  have h₀:(C p₀*(X (0:Fin 2))^4:MvPolynomial (Fin 2) R).IsHomogeneous 4:=by
    simpa using (hc p₀).mul (hx₀.pow 4)
  have h₁:(C p₁*(X (0:Fin 2))^3*X 1:MvPolynomial (Fin 2) R).IsHomogeneous 4:=by
    simpa using ((hc p₁).mul (hx₀.pow 3)).mul hx₁
  have h₂:(C p₂*(X (0:Fin 2))^2*(X 1)^2:MvPolynomial (Fin 2) R).IsHomogeneous 4:=by
    simpa using ((hc p₂).mul (hx₀.pow 2)).mul (hx₁.pow 2)
  have h₃:(C p₃*X (0:Fin 2)*(X 1)^3:MvPolynomial (Fin 2) R).IsHomogeneous 4:=by
    simpa using ((hc p₃).mul hx₀).mul (hx₁.pow 3)
  have h₄:(C p₄*(X (1:Fin 2))^4:MvPolynomial (Fin 2) R).IsHomogeneous 4:=by
    simpa using (hc p₄).mul (hx₁.pow 4)
  simpa only [bW,bU,pow_zero,pow_one,mul_one] using
    (((h₀.add h₁).add h₂).add h₃).add h₄
private theorem bY
 (p₀ p₁ p₂ p₃ p₄:I) (H:O)
 (hH:0 ≤ H) (h₀:|(p₀:O)| ≤ H) (h₁:|(p₁:O)| ≤ H)
 (h₂:|(p₂:O)| ≤ H) (h₃:|(p₃:O)| ≤ H) (h₄:|(p₄:O)| ≤ H):
 ∀t:Fin 2 →₀ U,
 |(((bW p₀ p₁ p₂ p₃ p₄).coeff t:I):O)| ≤ H:=by
  intro t
  by_cases h0:bIndex 4 0 = t
  · subst t
    simpa [bW,av,bS] using h₀
  by_cases h1:bIndex 3 1 = t
  · subst t
    simpa [bW,av,bS] using h₁
  by_cases h2:bIndex 2 2 = t
  · subst t
    simpa [bW,av,bS] using h₂
  by_cases h3:bIndex 1 3 = t
  · subst t
    simpa [bW,av,bS] using h₃
  by_cases h4:bIndex 0 4 = t
  · subst t
    simpa [bW,av,bS] using h₄
  simpa [bW,av,h0,h1,h2,h3,h4] using hH
private theorem bZ (m:Fin 4 →₀ U)
 (hm:m 0+m 1 = 4) (hm':m 2+m 3 = 1):
 m = qIndex 4 0 1 0 ∨ m = qIndex 3 1 1 0 ∨ m = qIndex 2 2 1 0 ∨
 m = qIndex 1 3 1 0 ∨ m = qIndex 0 4 1 0 ∨
 m = qIndex 4 0 0 1 ∨ m = qIndex 3 1 0 1 ∨ m = qIndex 2 2 0 1 ∨
 m = qIndex 1 3 0 1 ∨ m = qIndex 0 4 0 1:=by
  have hext (i j k l:U) (h0:m 0=i) (h1:m 1=j) (h2:m 2=k) (h3:m 3=l):
      m=qIndex i j k l:=by
    ext r
    fin_cases r <;> simp [qIndex,h0,h1,h2,h3]
  have h0:m 0=0 ∨ m 0=1 ∨ m 0=2 ∨ m 0=3 ∨ m 0=4:=by omega
  have h2:m 2=0 ∨ m 2=1:=by omega
  rcases h2 with h2|h2
