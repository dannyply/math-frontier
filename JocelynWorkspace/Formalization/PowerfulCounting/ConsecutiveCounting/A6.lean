    · intro r _
      exact ⟨(0,1),bu _,r,by simp⟩
  | @insert p iI hp ih =>
    intro bG
    obtain ⟨A,hAc,hAg,hAv⟩:= bG p (Finset.mem_insert_self _ _)
    obtain ⟨S0,hS0c,hS0g,hS0v⟩:= ih (fun q hq =>
      bG q (Finset.mem_insert_of_mem hq))
    let D:= (S0.product A).filter (fun z =>
      ∃ r:I,dB z.1 r ∧ dB z.2 r)
    have chooseIntersection (z:{z:(I × U) × (I × U) // z ∈ D}):
        ∃ s:I × U,0 < s.2 ∧
          dB z.1.1 s.1 ∧ dB z.1.2 s.1 ∧
          (z.1.1.2:I) ∣ (s.2:I) ∧ (z.1.2.2:I) ∣ (s.2:I) ∧
          (∀ r:I,dB z.1.1 r → dB z.1.2 r →
            dB s r):=by
      have hz:= aq z.2
      have hm:= Finset.mem_product.mp hz.1
