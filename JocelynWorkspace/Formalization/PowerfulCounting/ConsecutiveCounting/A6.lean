    ext z r
    change (a * S r) ^ (z.1 : ℕ) * (b * W r) ^ (z.2 : ℕ) =
      (a ^ (z.1 : ℕ) * b ^ (z.2 : ℕ)) *
        (S r ^ (z.1 : ℕ) * W r ^ (z.2 : ℕ))
    rw [mul_pow, mul_pow]
