    refine ⟨ai ((a ^ 4)⁻¹) * q,?_⟩
    calc
      P = ai ((a ^ 4)⁻¹) * (ai a ^ 4 * P):=by
        rw [← mul_assoc,hi,one_mul]
      _ = L * (ai ((a ^ 4)⁻¹) * q):=by rw [hq'];ring
  · have hr:= cv
      (ai p₀) (ai p₁) (ai p₂)
      (ai p₃) (ai p₄)
      (ai a) (ai b)
      (aj (0:Fin 2)) (aj 1)
