  ((z.1.1^3*z.2.1:ℕ):ℝ)≤x ∧
  (z.2.1:ℤ)*eval ![(z.1.1:ℤ),(z.1.2:ℤ)] Q =
    (z.2.2:ℤ)*eval ![(z.1.1:ℤ),(z.1.2:ℤ)] P}
private theorem quartic_cell_subset_e0_swapped
    (x D E : ℝ) (M j : ℕ) (G : Four) (P Q : Binary)
    (hGraph : Graph G P Q) :
    {z : Point | z∈sourceCell x D E M j ∧
      eval ![(z.1.1:ℤ),(z.1.2:ℤ),(z.2.1:ℤ),(z.2.2:ℤ)] G=0}
      ⊆ e0Population Q P x := by
  intro z hz
  rcases hz with ⟨hz,hzero⟩
  rcases hz with ⟨hd,he,hu,hv,hshift,hnlo,hnup,hDlo,hDup,hElo,hEup,hrlo,hrup⟩
  exact ⟨hd,he,hu,hv,hshift,hnup,graph_zero_e0_swapped G P Q hGraph z hzero⟩

