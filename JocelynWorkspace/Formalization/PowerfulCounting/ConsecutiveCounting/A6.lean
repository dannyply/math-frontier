    solve | simp
  have bG:
      ag (bO P Q) =
        bO (ag P)
          (ag Q):=by
    simp [bO,bN,MvPolynomial.map_rename]
  have hcopC:= bP
    (ag P)
    (ag Q) (bG ▸ hG)
  intro D hDP hDQ
  obtain ⟨iU,hU⟩:= hDP
  obtain ⟨V,hV⟩:= hDQ
  have hDP':aO f D ∣ ag P:=by
    refine ⟨aO f iU,?_⟩
    rw [←hmap P,hU,map_mul]
  have hDQ':aO f D ∣ ag Q:=by
    refine ⟨aO f V,?_⟩
    rw [←hmap Q,hV,map_mul]
  have bI:IsUnit (aO f D):= hcopC hDP' hDQ'
  have hi:aH f:= RingHom.injective f
  have hs:(aO f D).support = D.support:=
    aE D hi
  have bK:(aO f D).totalDegree = D.totalDegree:=by
    simp only [MvPolynomial.totalDegree,hs]
  have hDdeg:D.totalDegree = 0:=by
    rw [←bK]
    exact (aG bI).2
  have hD0:D ≠ 0:=by
    intro hz
    rw [hz,map_zero] at bI
    exact bI.ne_zero rfl
  have hDC:D = ai (D.coeff 0):=
    bw hDdeg
  have bJ:D.coeff 0 ≠ 0:=by
    intro hz
    rw [hz,map_zero] at hDC
    exact hD0 hDC
  rw [hDC]
  exact ((isUnit_iff_ne_zero).mpr bJ).map
    (ai:ℚ →+* ac)
private theorem bR
 (P Q:ab)
 (hP:P.IsHomogeneous 4) (hQ:Q.IsHomogeneous 4)
 (hcop:IsRelPrime (ah P)
 (ah Q)):
 P ≠ 0 ∧ Q ≠ 0:=by
  have bG:P.coeff 0 = 0:= hP.coeff_eq_zero (by simp)
  have bI:Q.coeff 0 = 0:= hQ.coeff_eq_zero (by simp)
