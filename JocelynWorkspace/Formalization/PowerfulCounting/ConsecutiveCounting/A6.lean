 C r*(X (0:Fin 4))^i*(X 1)^j*(X 2)^k*(X 3)^l:=by
  calc
    _ = monomial (ao (0:Fin 4) i) r *
        monomial (ao (1:Fin 4) j) (1:R) *
        monomial (ao (2:Fin 4) k) (1:R) *
        monomial (ao (3:Fin 4) l) (1:R):=by
      rw [aL,aL,aL]
