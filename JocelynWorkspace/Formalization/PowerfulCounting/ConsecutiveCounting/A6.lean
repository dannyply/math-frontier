                U / 8 ≤ (u r : ℝ) ∧ (u r : ℝ) ≤ 8 * U ∧
                V / 8 ≤ (v r : ℝ) ∧ (v r : ℝ) ≤ 8 * V ∧
                |(((d r : ℝ) / (e r : ℝ)) / (D / E)) - S₀| ≤ L * x ^ (-μ) ∧
                (e r : ℤ) ^ 3 * (v r : ℤ) - (d r : ℤ) ^ 3 * (u r : ℤ) = h) →
              |((clearedMatrix A B d e u v).det : ℝ)| ≤
                C * (D * E) ^ xDegreeSum A B * (U * V) ^ yDegreeSum A B *
                  x ^ (-affineSigma A B μ) := by
  classical
  intro A B hBA L hL
  let rowCost : ℝ :=
    ((2 : ℝ) ^ A * (8 : ℝ) ^ B) ^ (Fintype.card (Rect A B))
  let basisCost : ℝ := cubicBasisConstant A B L
  have hrowCost : 0 < rowCost := by dsimp [rowCost]; positivity
  have hbasisCost : 0 < basisCost := cubicBasisConstant_pos A B L hL
  refine ⟨rowCost * basisCost, cubicThreshold L,
    mul_pos hrowCost hbasisCost, ?_, ?_⟩
  · unfold cubicThreshold
    nlinarith [sq_nonneg (8 + L ^ 3)]
  intro x μ D E U V c hx hμlo hμhi hD hE hU hV hbalD hbalE
    hc0 hc1 h hh d e u v hpts
  have hx2 : 2 ≤ x := by
    unfold cubicThreshold at hx
    nlinarith [sq_nonneg (8 + L ^ 3)]
  have hx0 : 0 < x := by linarith
  let S : Cols A B → ℝ := fun r => ((d r : ℝ) / (e r : ℝ)) / (D / E)
  let W : Cols A B → ℝ := fun r => ((v r : ℝ) / (u r : ℝ)) / (V / U)
  have he : ∀ r, 0 < e r := fun r => (hpts r).2.1
  have hu : ∀ r, 0 < u r := fun r => (hpts r).2.2.1
  have hecap : ∀ r, (e r : ℝ) ≤ 2 * E := by
    intro r
    rcases hpts r with ⟨hd, her, hur, hv, hdlo, hdhi, helo, hehi,
      hulo, huhi, hvlo, hvhi, hcell, hsurf⟩
    exact hehi
  have hucap : ∀ r, (u r : ℝ) ≤ 8 * U := by
    intro r
    rcases hpts r with ⟨hd, her, hur, hv, hdlo, hdhi, helo, hehi,
      hulo, huhi, hvlo, hvhi, hcell, hsurf⟩
    exact huhi
  have hS : ∀ r, |S r - c| ≤ L * x ^ (-μ) := by
    intro r
    rcases hpts r with ⟨hd, her, hur, hv, hdlo, hdhi, helo, hehi,
      hulo, huhi, hvlo, hvhi, hcell, hsurf⟩
    exact hcell
  have hhR : |(h : ℝ)| = 1 := by
    rcases hh with rfl | rfl <;> norm_num
  have hW : ∀ r, |W r - (S r) ^ 3| ≤ 8 * x ^ (-1 : ℝ) := by
    intro r
    rcases hpts r with ⟨hd, her, hur, hv, hdlo, hdhi, helo, hehi,
      hulo, huhi, hvlo, hvhi, hcell, hsurf⟩
    have heR : 0 < (e r : ℝ) := by exact_mod_cast her
    have huR : 0 < (u r : ℝ) := by exact_mod_cast hur
    have hsurface :
        (e r : ℝ) ^ 3 * (v r : ℝ) - (d r : ℝ) ^ 3 * (u r : ℝ) = (h : ℝ) := by
      exact_mod_cast hsurf
    have herror := cubic_surface_error
      x D E U V (d r : ℝ) (e r : ℝ) (u r : ℝ) (v r : ℝ) (h : ℝ)
      hx0 hD hE hU hV heR huR hbalD hbalE helo hulo hhR hsurface
    simpa only [S, W, Real.rpow_neg_one, div_eq_mul_inv] using herror
  have hnormal := normalized_cubic_det_bound
    A B hBA L hL x μ c S W hx hμlo hμhi hc0 hc1 hS hW
  have hcleared := original_cleared_det_bound
    A B D E U V hD hE hU hV d e u v he hu hecap hucap
  change |((clearedMatrix A B d e u v).det : ℝ)| ≤
    rowCost * (D * E) ^ xDegreeSum A B * (U * V) ^ yDegreeSum A B *
      |(monomialEvaluationMatrix A B S W).det| at hcleared
  change |(monomialEvaluationMatrix A B S W).det| ≤
    basisCost * x ^ (-affineSigma A B μ) at hnormal
  have hpref :
      0 ≤ rowCost * (D * E) ^ xDegreeSum A B * (U * V) ^ yDegreeSum A B := by
    positivity
  calc
    |((clearedMatrix A B d e u v).det : ℝ)| ≤
        rowCost * (D * E) ^ xDegreeSum A B * (U * V) ^ yDegreeSum A B *
          |(monomialEvaluationMatrix A B S W).det| := hcleared
    _ ≤ rowCost * (D * E) ^ xDegreeSum A B * (U * V) ^ yDegreeSum A B *
        (basisCost * x ^ (-affineSigma A B μ)) :=
      mul_le_mul_of_nonneg_left hnormal hpref
    _ = (rowCost * basisCost) * (D * E) ^ xDegreeSum A B *
        (U * V) ^ yDegreeSum A B * x ^ (-affineSigma A B μ) := by ring

end A6K1CubicDenominator

namespace A6K1Aux

open scoped BigOperators

abbrev Point := (ℕ × ℕ) × (ℕ × ℕ)
abbrev Cols (A B : ℕ) := Fin (A + 1) × Fin (B + 1)
abbrev iSum := FormalAB.S9652ac8c.A5AffineFiniteGate.xDegreeSum
abbrev jSum := FormalAB.S9652ac8c.A5AffineFiniteGate.yDegreeSum
abbrev weight := FormalAB.S9652ac8c.A5AffineFiniteGate.affineSigma
abbrev entry := FormalAB.Sb751f117.A5CentralOriginalAuxiliary.entry

def rho (D E : ℝ) (M j : ℕ) : ℝ :=
  D / (2 * E) * (1 + 1 / (M : ℝ)) ^ j

def cells (D E : ℝ) (M : ℕ) : Finset ℕ := by
  classical
  exact (Finset.range (3 * M + 1)).filter
    (fun j => D / (2 * E) ≤ rho D E M j ∧ rho D E M j ≤ 2 * D / E)

def originalCell (x D E : ℝ) (M j : ℕ) (h : ℤ) : Set Point :=
  {z | 1 ≤ z.1.1 ∧ 1 ≤ z.1.2 ∧ 1 ≤ z.2.1 ∧ 1 ≤ z.2.2 ∧
    ((z.1.2 ^ 3 * z.2.2 : ℕ) : ℤ) =
      ((z.1.1 ^ 3 * z.2.1 : ℕ) : ℤ) + h ∧
    x / 2 < ((z.1.1 ^ 3 * z.2.1 : ℕ) : ℝ) ∧
    ((z.1.1 ^ 3 * z.2.1 : ℕ) : ℝ) ≤ x ∧
    D / 2 < (z.1.1 : ℝ) ∧ (z.1.1 : ℝ) ≤ D ∧
    E / 2 < (z.1.2 : ℝ) ∧ (z.1.2 : ℝ) ≤ E ∧
    rho D E M j < (z.1.1 : ℝ) / (z.1.2 : ℝ) ∧
    (z.1.1 : ℝ) / (z.1.2 : ℝ) ≤ rho D E M j * (1 + 1 / (M : ℝ))}

private lemma cofactor_window (x D a b : ℝ)
    (_hx : 0 < x) (hD : 0 < D) (ha : 0 ≤ a) (hb : 0 ≤ b)
    (haD : D / 2 < a) (haD' : a ≤ D)
    (hn : x / 4 < a ^ 3 * b) (hn' : a ^ 3 * b ≤ 2 * x) :
    (2 * x / D ^ 3) / 8 ≤ b ∧ b ≤ 8 * (2 * x / D ^ 3) := by
  have hD3 : 0 < D ^ 3 := by positivity
  have hpow : a ^ 3 ≤ D ^ 3 := pow_le_pow_left₀ ha haD' 3
  have hpow' : (D / 2) ^ 3 ≤ a ^ 3 :=
    pow_le_pow_left₀ (by positivity) haD.le 3
  have hl := mul_le_mul_of_nonneg_right hpow hb
  have hu := mul_le_mul_of_nonneg_right hpow' hb
  constructor
  · apply (div_le_iff₀ (by norm_num : (0 : ℝ) < 8)).mpr
    apply (div_le_iff₀ hD3).mpr
    nlinarith
  · rw [← mul_div_assoc]
    apply (le_div_iff₀ hD3).mpr
    nlinarith

private lemma cell_cofactor_windows (x D E : ℝ) (M j : ℕ) (h : ℤ)
    (hx : 8 ≤ x) (hD : 0 < D) (hE : 0 < E)
    (hh : h = 1 ∨ h = -1) (z : Point)
    (hz : z ∈ originalCell x D E M j h) :
    (2 * x / D ^ 3) / 8 ≤ (z.2.1 : ℝ) ∧
      (z.2.1 : ℝ) ≤ 8 * (2 * x / D ^ 3) ∧
      (2 * x / E ^ 3) / 8 ≤ (z.2.2 : ℝ) ∧
      (z.2.2 : ℝ) ≤ 8 * (2 * x / E ^ 3) := by
  rcases hz with ⟨hd, he, hu, hv, hshift, hn, hn', hdD, hdD', heE, heE', -, -⟩
  have hx0 : 0 < x := by linarith
  have hnR : x / 2 < (z.1.1 : ℝ) ^ 3 * (z.2.1 : ℝ) := by exact_mod_cast hn
  have hnR' : (z.1.1 : ℝ) ^ 3 * (z.2.1 : ℝ) ≤ x := by exact_mod_cast hn'
  have hshiftR :
      (z.1.2 : ℝ) ^ 3 * (z.2.2 : ℝ) =
        (z.1.1 : ℝ) ^ 3 * (z.2.1 : ℝ) + (h : ℝ) := by exact_mod_cast hshift
  have hhr : -(1 : ℝ) ≤ (h : ℝ) ∧ (h : ℝ) ≤ 1 := by
    rcases hh with rfl | rfl <;> norm_num
  have huWin := cofactor_window x D (z.1.1 : ℝ) (z.2.1 : ℝ)
    hx0 hD (Nat.cast_nonneg _) (Nat.cast_nonneg _) hdD hdD'
    (by linarith) (by linarith)
  have hvWin := cofactor_window x E (z.1.2 : ℝ) (z.2.2 : ℝ)
    hx0 hE (Nat.cast_nonneg _) (Nat.cast_nonneg _) heE heE'
    (by linarith) (by linarith)
  exact ⟨huWin.1, huWin.2, hvWin.1, hvWin.2⟩

private lemma cell_coordinate_bounds (x D E : ℝ) (M j : ℕ) (h : ℤ)
    (hx : 8 ≤ x) (hh : h = 1 ∨ h = -1) (z : Point)
    (hz : z ∈ originalCell x D E M j h) :
    (z.1.1 : ℝ) ≤ 2 * x ∧ (z.1.2 : ℝ) ≤ 2 * x ∧
      (z.2.1 : ℝ) ≤ 2 * x ∧ (z.2.2 : ℝ) ≤ 2 * x := by
  rcases hz with ⟨hd, he, hu, hv, hshift, -, hn, -⟩
  have hd1 : (1 : ℝ) ≤ (z.1.1 : ℝ) := by exact_mod_cast hd
  have he1 : (1 : ℝ) ≤ (z.1.2 : ℝ) := by exact_mod_cast he
  have hu1 : (1 : ℝ) ≤ (z.2.1 : ℝ) := by exact_mod_cast hu
  have hv1 : (1 : ℝ) ≤ (z.2.2 : ℝ) := by exact_mod_cast hv
  have hnR : (z.1.1 : ℝ) ^ 3 * (z.2.1 : ℝ) ≤ x := by exact_mod_cast hn
  have hshiftR :
      (z.1.2 : ℝ) ^ 3 * (z.2.2 : ℝ) =
        (z.1.1 : ℝ) ^ 3 * (z.2.1 : ℝ) + (h : ℝ) := by exact_mod_cast hshift
  have hhr : (h : ℝ) ≤ 1 := by rcases hh with rfl | rfl <;> norm_num
  have hprodE : (z.1.2 : ℝ) ^ 3 * (z.2.2 : ℝ) ≤ 2 * x := by linarith
  have hd3 : (z.1.1 : ℝ) ≤ (z.1.1 : ℝ) ^ 3 := by
    have hp := pow_le_pow_right₀ hd1 (show (1 : ℕ) ≤ 3 by omega)
    simpa using hp
  have he3 : (z.1.2 : ℝ) ≤ (z.1.2 : ℝ) ^ 3 := by
    have hp := pow_le_pow_right₀ he1 (show (1 : ℕ) ≤ 3 by omega)
    simpa using hp
  have hd31 : (1 : ℝ) ≤ (z.1.1 : ℝ) ^ 3 := one_le_pow₀ hd1
  have he31 : (1 : ℝ) ≤ (z.1.2 : ℝ) ^ 3 := one_le_pow₀ he1
  have hdprod : (z.1.1 : ℝ) ^ 3 ≤ (z.1.1 : ℝ) ^ 3 * (z.2.1 : ℝ) := by
    simpa using mul_le_mul_of_nonneg_left hu1 (pow_nonneg (Nat.cast_nonneg _) 3)
  have heprod : (z.1.2 : ℝ) ^ 3 ≤ (z.1.2 : ℝ) ^ 3 * (z.2.2 : ℝ) := by
    simpa using mul_le_mul_of_nonneg_left hv1 (pow_nonneg (Nat.cast_nonneg _) 3)
  have huprod : (z.2.1 : ℝ) ≤ (z.1.1 : ℝ) ^ 3 * (z.2.1 : ℝ) := by
    simpa using mul_le_mul_of_nonneg_right hd31 (Nat.cast_nonneg z.2.1 : (0 : ℝ) ≤ z.2.1)
  have hvprod : (z.2.2 : ℝ) ≤ (z.1.2 : ℝ) ^ 3 * (z.2.2 : ℝ) := by
    simpa using mul_le_mul_of_nonneg_right he31 (Nat.cast_nonneg z.2.2 : (0 : ℝ) ≤ z.2.2)
  exact ⟨by linarith, he3.trans (heprod.trans hprodE), by linarith, hvprod.trans hprodE⟩

private lemma cell_width (x D E μ : ℝ) (j : ℕ)
    (hx : 8 ≤ x) (hD : 0 < D) (hE : 0 < E)
    (hμ : 0 ≤ μ) (h : ℤ) (z : Point)
    (hj : j ∈ cells D E ⌈x ^ μ⌉₊)
    (hz : z ∈ originalCell x D E ⌈x ^ μ⌉₊ j h) :
    (1 / 2 : ℝ) ≤ rho D E ⌈x ^ μ⌉₊ j / (D / E) ∧
      rho D E ⌈x ^ μ⌉₊ j / (D / E) ≤ 2 ∧
      |((z.1.1 : ℝ) / (z.1.2 : ℝ)) / (D / E) -
          rho D E ⌈x ^ μ⌉₊ j / (D / E)| ≤ 2 * (x / 4) ^ (-μ) := by
  let M : ℕ := ⌈x ^ μ⌉₊
  let r : ℝ := rho D E M j
  let t : ℝ := (z.1.1 : ℝ) / (z.1.2 : ℝ)
  have hx0 : 0 < x := by linarith
  have hp : 0 < x ^ μ := Real.rpow_pos_of_pos hx0 _
  have hceil : x ^ μ ≤ (M : ℝ) := Nat.le_ceil _
  have hM : 0 < (M : ℝ) := hp.trans_le hceil
  have hQ : 0 < D / E := div_pos hD hE
  have hc := (Finset.mem_filter.mp hj).2
  change D / (2 * E) ≤ r ∧ r ≤ 2 * D / E at hc
  rcases hz with ⟨-, -, -, -, -, -, -, -, -, -, -, htlo, hthi⟩
  have ht : r < t ∧ t ≤ r * (1 + 1 / (M : ℝ)) := ⟨htlo, hthi⟩
  have hrlo : (D / E) / 2 ≤ r := by
    convert hc.1 using 1 ; field_simp [hE.ne']
  have hrhi : r ≤ 2 * (D / E) := by
    convert hc.2 using 1 ; field_simp [hE.ne']
  have hdiff : t - r ≤ 2 * (D / E) / (M : ℝ) := by
    have hw : t - r ≤ r / (M : ℝ) := by
      have hid : r * (1 + 1 / (M : ℝ)) = r + r / (M : ℝ) := by ring
      rw [hid] at ht
      linarith
    exact hw.trans (div_le_div_of_nonneg_right hrhi hM.le)
  have habs : |t / (D / E) - r / (D / E)| ≤ 2 / (M : ℝ) := by
    rw [abs_of_nonneg (sub_nonneg.mpr (div_le_div_of_nonneg_right ht.1.le hQ.le))]
    calc
      t / (D / E) - r / (D / E) = (t - r) / (D / E) := by ring
      _ ≤ (2 * (D / E) / (M : ℝ)) / (D / E) :=
        div_le_div_of_nonneg_right hdiff hQ.le
      _ = 2 / (M : ℝ) := by field_simp [hD.ne', hE.ne', hM.ne']
  have hinv : 1 / (M : ℝ) ≤ x ^ (-μ) := by
    apply (div_le_iff₀ hM).mpr
    have hmul : x ^ μ * x ^ (-μ) = 1 := by rw [← Real.rpow_add hx0]; simp
    have hp' := mul_le_mul_of_nonneg_right hceil (Real.rpow_nonneg hx0.le (-μ))
    nlinarith
  have hanti : x ^ (-μ) ≤ (x / 4) ^ (-μ) :=
    Real.rpow_le_rpow_of_nonpos (by linarith) (by linarith) (by linarith)
  refine ⟨?_, ?_, ?_⟩
  · exact (le_div_iff₀ hQ).mpr (by linarith [hrlo])
  · exact (div_le_iff₀ hQ).mpr hrhi
  · change |t / (D / E) - r / (D / E)| ≤ 2 * (x / 4) ^ (-μ)
    calc
      _ ≤ 2 / (M : ℝ) := habs
      _ = 2 * (1 / (M : ℝ)) := by ring
      _ ≤ 2 * x ^ (-μ) := mul_le_mul_of_nonneg_left hinv (by norm_num)
      _ ≤ 2 * (x / 4) ^ (-μ) := mul_le_mul_of_nonneg_left hanti (by norm_num)

private lemma cell_entry_height (A B : ℕ) (hB : B ≤ A)
    (x D E : ℝ) (M j : ℕ) (h : ℤ) (hx : 8 ≤ x)
    (hh : h = 1 ∨ h = -1) (z : Point)
    (hz : z ∈ originalCell x D E M j h) (c : Cols A B) :
    |(entry A B z c : ℝ)| ≤ (2 : ℝ) ^ (2 * A) * x ^ (2 * A) := by
  have hp := cell_coordinate_bounds x D E M j h hx hh z hz
  have heq :
      |(entry A B z c : ℝ)| =
        (z.1.1 : ℝ) ^ (c.1 : ℕ) * (z.1.2 : ℝ) ^ (A - (c.1 : ℕ)) *
        (z.2.2 : ℝ) ^ (c.2 : ℕ) * (z.2.1 : ℝ) ^ (B - (c.2 : ℕ)) := by
    simp only [entry, FormalAB.Sb751f117.A5CentralOriginalAuxiliary.entry,
      Int.cast_mul, Int.cast_pow, Int.cast_natCast]
    exact abs_of_nonneg (by positivity)
  rw [heq]
  calc
    _ ≤ (2 * x) ^ (c.1 : ℕ) * (2 * x) ^ (A - (c.1 : ℕ)) *
        (2 * x) ^ (c.2 : ℕ) * (2 * x) ^ (B - (c.2 : ℕ)) := by
      gcongr <;> first | exact hp.1 | exact hp.2.1 | exact hp.2.2.1 | exact hp.2.2.2
    _ = (2 * x) ^ (A + B) := by
      rw [← pow_add, mul_assoc, ← pow_add, ← pow_add]
      congr 1
      have hi := c.1.isLt
      have hj := c.2.isLt
      omega
    _ ≤ (2 * x) ^ (2 * A) :=
      pow_le_pow_right₀ (by linarith) (by omega)
    _ = _ := by rw [mul_pow]

private lemma degree_values :
    (FormalAB.S9652ac8c.A5AffineFiniteGate.xDegreeSum 42 14 : ℝ) = 13545 ∧
      (FormalAB.S9652ac8c.A5AffineFiniteGate.yDegreeSum 42 14 : ℝ) = 4515 := by
  have hd := FormalAB.S9652ac8c.A5AffineFiniteGate.MarginInternal.degree_sum_formula 42 14
  unfold FormalAB.S9652ac8c.A5AffineFiniteGate.affineH at hd
  push_cast at hd
  constructor
  · linarith [hd.1]
  · linarith [hd.2]

private lemma degree_nat :
    iSum 42 14 = 3 * 4515 ∧ jSum 42 14 = 4515 := by
  obtain ⟨h1, h2⟩ := degree_values
  have h1' : ((iSum 42 14 : ℕ) : ℝ) = 13545 := h1
  have h2' : ((jSum 42 14 : ℕ) : ℝ) = 4515 := h2
  have h1n : iSum 42 14 = 13545 := by exact_mod_cast h1'
  have h2n : jSum 42 14 = 4515 := by exact_mod_cast h2'
  constructor
  · omega
  · exact h2n

private lemma weight_value (μ : ℝ) : weight 42 14 μ = 14105 * μ + 3955 := by
  have hS := FormalAB.S9652ac8c.A5AffineFiniteGate.MarginInternal.affineSigma_formula
    42 14 (by norm_num) μ
  unfold FormalAB.S9652ac8c.A5AffineFiniteGate.affineH
    FormalAB.S9652ac8c.A5AffineFiniteGate.affineR at hS
  have h2 : 2 * weight 42 14 μ = 28210 * μ + 7910 := by
    change 2 * FormalAB.S9652ac8c.A5AffineFiniteGate.affineSigma 42 14 μ = _
    rw [hS]
    push_cast
    ring
  linarith

private lemma cost_identity (x μ D E : ℝ) (hx : 0 < x) (hD : 0 < D) (hE : 0 < E) :
    ((D / 2) * (E / 2)) ^ iSum 42 14 *
        ((2 * x / D ^ 3) * (2 * x / E ^ 3)) ^ jSum 42 14 *
        (x / 4) ^ (-weight 42 14 μ) =
      (x / 4) ^ (-(14105 * μ - 5075)) := by
  obtain ⟨hI, hJ⟩ := degree_nat
  have hbase : ((D / 2) * (E / 2)) ^ 3 * ((2 * x / D ^ 3) * (2 * x / E ^ 3)) =
      (x / 4) ^ 2 := by
    field_simp [hD.ne', hE.ne']
    ring
  have hx4 : 0 < x / 4 := by positivity
  rw [hI, hJ, pow_mul, ← mul_pow, hbase, ← pow_mul, weight_value μ,
    ← Real.rpow_natCast, ← Real.rpow_add hx4]
  have hexp : ((2 * 4515 : ℕ) : ℝ) + -(14105 * μ + 3955) = -(14105 * μ - 5075) := by
    push_cast
    ring
  exact congrArg (fun t : ℝ => (x / 4) ^ t) hexp

private lemma cell_minor_decay :
    ∃ C X : ℝ, 0 < C ∧ 8 ≤ X ∧
      ∀ x μ D E : ℝ, X ≤ x →
        (9 / 25 : ℝ) ≤ μ → μ ≤ (1 / 2 : ℝ) →
        0 < D → 0 < E →
        ∀ j : ℕ, j ∈ cells D E ⌈x ^ μ⌉₊ →
          ∀ h : ℤ, (h = 1 ∨ h = -1) →
            ∀ z : Cols 42 14 → Point,
              (∀ i, z i ∈ originalCell x D E ⌈x ^ μ⌉₊ j h) →
              |((Matrix.det (fun i c : Cols 42 14 => entry 42 14 (z i) c) : ℤ) : ℝ)| ≤
                C * (x / 4) ^ (-(14105 * μ - 5075)) := by
  obtain ⟨C, X, hC, hX, hgate⟩ :=
    A6K1CubicDenominator.cubic_gate 42 14 (by norm_num) 2 (by norm_num)
  refine ⟨C, 4 * X, hC, by linarith, ?_⟩
  intro x μ D E hx hμ hμ' hD hE j hj h hh z hz
  have hx8 : 8 ≤ x := by linarith
  have hx0 : 0 < x := by linarith
  let M : ℕ := ⌈x ^ μ⌉₊
  let S₀ : ℝ := rho D E M j / (D / E)
  have hw₀ := cell_width x D E μ j hx8 hD hE (by linarith) h
    (z (0, 0)) hj (hz (0, 0))
  have hdres : (D / 2) ^ 3 * (2 * x / D ^ 3) = x / 4 := by
    field_simp [hD.ne']
