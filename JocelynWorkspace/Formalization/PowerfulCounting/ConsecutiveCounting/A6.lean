private theorem dF (K:U → U) (F G:ae):
 ∀ iI:Finset U,
 (∀ p ∈ iI,∃ A:Finset (I × U),A.card ≤ 8 ∧
 (∀ s ∈ A,0 < s.2 ∧
 C ((p:I) ^ K p) ∣ F.comp (dA s) ∧
 C ((p:I) ^ K p) ∣ G.comp (dA s)) ∧
 (∀ r:I,(p:I) ^ K p ∣ F.eval r → (p:I) ^ K p ∣ G.eval r →
 ∃ s ∈ A,dB s r)) →
 ∃ S:Finset (I × U),S.card ≤ 8 ^ iI.card ∧
 (∀ s ∈ S,0 < s.2 ∧ ∀ p ∈ iI,
 C ((p:I) ^ K p) ∣ F.comp (dA s) ∧
 C ((p:I) ^ K p) ∣ G.comp (dA s)) ∧
 (∀ r:I,
 (∀ p ∈ iI,(p:I) ^ K p ∣ F.eval r ∧ (p:I) ^ K p ∣ G.eval r) →
 ∃ s ∈ S,dB s r):=by
  classical
  intro iI
  induction iI using Finset.induction_on with
  | empty =>
    intro bG
