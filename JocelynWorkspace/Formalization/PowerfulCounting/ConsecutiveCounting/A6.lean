  have hq : eval ![(d:ℤ),(e:ℤ)] Q=0 := by
    linear_combination (u:ℤ)*hr-(e:ℤ)^3*hg-(eval ![(d:ℤ),(e:ℤ)] Q)*hs
  have hvec : (fun i : Fin 2=>((![(d:ℤ),(e:ℤ)] i:ℤ):ℂ))=
      ![(d:ℂ),(e:ℂ)] := by
    funext i
    fin_cases i <;> simp
  have hpC : eval ![(d:ℂ),(e:ℂ)] (map (Int.castRingHom ℂ) P)=0 := by
    have hh := eval_int_map (K:=ℂ) P ![(d:ℤ),(e:ℤ)]
    rw [hvec,hp,Int.cast_zero] at hh
    exact hh
  have hqC : eval ![(d:ℂ),(e:ℂ)] (map (Int.castRingHom ℂ) Q)=0 := by
    have hh := eval_int_map (K:=ℂ) Q ![(d:ℤ),(e:ℤ)]
    rw [hvec,hq,Int.cast_zero] at hh
    exact hh
  have hw : (![(d:ℂ),(e:ℂ)] : Fin 2→ℂ)≠0 := by
    intro hh
    have hdC : (d:ℂ)=0 := congrFun hh (0:Fin 2)
    have : d=0 := by exact_mod_cast hdC
    omega
  exact JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C01.PcCurves.no_common_zero
    (hP.map _) (hQ.map _) hcop hw hpC hqC

def alpha3Population (x : ℝ) (G : Four) : Set Point := {z |
  1≤z.1.1 ∧ 1≤z.1.2 ∧ 1≤z.2.1 ∧ 1≤z.2.2 ∧
  z.1.2^3*z.2.2=z.1.1^3*z.2.1+1 ∧
  ((z.1.1^3*z.2.1:ℕ):ℝ)≤x ∧
  eval ![(z.1.1:ℤ),(z.1.2:ℤ),(z.2.1:ℤ),(z.2.2:ℤ)] G=0}

private theorem actual_alpha3_nonpure_factor_cell_count (h47e : W847cHypAlpha3)
    (hSt : StewartHyp) (K : ℝ) (hK : 0≤K) (eps : ℝ) (heps : 0<eps) :
    ∃ C : ℝ, 0<C ∧
      ∀ x : ℝ, 2≤x →
        ∀ G : Four, G≠0 → Bihom G 3 1 →
          Irreducible (map (Int.castRingHom ℂ) G) →
          (∀ m : Fin 4→₀ℕ, |((G.coeff m:ℤ):ℝ)|≤x^K) →
          ¬RationalPure (A6AlphaThreePrivate.cubicP G) (A6AlphaThreePrivate.cubicQ G) 6 →
          ∀ D E : ℝ, ∀ M j : ℕ,
            (factorCellOutside x D E M j G).Finite ∧
            ((factorCellOutside x D E M j G).ncard:ℝ)≤C*x^eps := by
  classical
  obtain ⟨C,hC,hcount⟩ :=
    h47e
      hSt K hK eps heps
  refine ⟨C,hC,?_⟩
  intro x hx G hG hBi hGeom hheight hnotPure D E M j
  by_cases hempty : factorCellOutside x D E M j G=∅
  · rw [hempty]
    exact ⟨Set.finite_empty,by simpa using mul_nonneg hC.le (by positivity : 0≤x^eps)⟩
  obtain ⟨z₀,hz₀⟩ := Set.nonempty_iff_ne_empty.mpr hempty
  have hzcell := hz₀.1.1
  have hzG := hz₀.1.2
  rcases hzcell with ⟨hd,he,hu,hv,hshift,hnlo,hnup,hDlo,hDup,hElo,hEup,hrlo,hrup⟩
  have hunit : z₀.1.2^3*z₀.2.2=z₀.1.1^3*z₀.2.1+1 := by exact_mod_cast hshift
  have hdata := A6AlphaThreePrivate.canonical_cubic_data G hBi
  have hcop := A6AlphaThreePrivate.canonical_cubic_complex_relPrime G hBi hGeom
  have hgraph := A6AlphaThreePrivate.canonical_cubic_graph_eval G hBi
    (z₀.1.1:ℤ) (z₀.1.2:ℤ) (z₀.2.1:ℤ) (z₀.2.2:ℤ) hzG
  have hvalue := original_graph_residual_value_ne_zero
    (A6AlphaThreePrivate.cubicP G) (A6AlphaThreePrivate.cubicQ G) 3
    hdata.2.1 hdata.2.2.1 hcop z₀.1.1 z₀.1.2 z₀.2.1 z₀.2.2 (by omega) hunit hgraph
  let R := A6AlphaThreePrivate.sexticResidual G
  have hRnz : eval ![(z₀.1.1:ℤ),(z₀.1.2:ℤ)] R≠0 := by
    simpa [R,A6AlphaThreePrivate.sexticResidual] using hvalue
  have hcanon :
      ((eval ![(z₀.1.1:ℤ),(z₀.1.2:ℤ)] R:ℤ):ℚ)=
        A6AlphaThreePrivate.canonicalResidual G (z₀.1.1:ℚ) (z₀.1.2:ℚ) := by
    rw [←A6AlphaThreePrivate.canonical_residual_eval]
    have hh := eval_int_map (K:=ℚ) R ![(z₀.1.1:ℤ),(z₀.1.2:ℤ)]
    have hvect : (fun i : Fin 2=>((![(z₀.1.1:ℤ),(z₀.1.2:ℤ)] i:ℤ):ℚ))=
        ![(z₀.1.1:ℚ),(z₀.1.2:ℚ)] := by
      funext i
      fin_cases i <;> simp
    rw [hvect] at hh
    exact hh.symm
  have hres : ∃ r s : ℚ, A6AlphaThreePrivate.canonicalResidual G r s≠0 := by
    refine ⟨(z₀.1.1:ℚ),(z₀.1.2:ℚ),?_⟩
    intro hz
    apply hRnz
    exact_mod_cast (hcanon.trans hz)
  have hnp : ¬∃κ a b : ℚ, κ≠0 ∧ (a≠0 ∨ b≠0) ∧ ∀ r s : ℚ,
      A6AlphaThreePrivate.canonicalResidual G r s=κ*(a*r+b*s)^6 := by
    rintro ⟨κ,a,b,hκ,hab,hpure⟩
    apply hnotPure
    refine ⟨κ,a,b,hκ,hab,?_⟩
    intro r s
    have hh := hpure r s
    rw [←A6AlphaThreePrivate.canonical_residual_eval G r s] at hh
    simpa [A6AlphaThreePrivate.sexticResidual,map_sub,map_mul,map_pow,map_X] using hh
  have hT : (alpha3Population x G).Finite ∧
      ((alpha3Population x G).ncard:ℝ)≤C*x^eps :=
    hcount x hx G hG hBi hGeom hheight ⟨hres,hnp⟩
  have hmap : ∀z∈factorCellOutside x D E M j G, z∈alpha3Population x G := by
    intro z hz
    rcases hz.1 with ⟨hz,hzero⟩
    rcases hz with ⟨hd,he,hu,hv,hshift,hnlo,hnup,hDlo,hDup,hElo,hEup,hrlo,hrup⟩
    exact ⟨hd,he,hu,hv,by exact_mod_cast hshift,hnup,hzero⟩
  have hinj : Set.InjOn (fun z : Point=>z) (factorCellOutside x D E M j G) := by
    intro z hz w hw h
    exact h
  have hfin := Set.Finite.of_injOn hmap hinj hT.1
  have hn := Set.ncard_le_ncard_of_injOn (fun z : Point=>z) hmap hinj hT.1
  exact ⟨hfin,(by exact_mod_cast hn :
    ((factorCellOutside x D E M j G).ncard:ℝ)≤
      ((alpha3Population x G).ncard:ℝ)).trans hT.2⟩

end A6WholeF8ActualJoins

