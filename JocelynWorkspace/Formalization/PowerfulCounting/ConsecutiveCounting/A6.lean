private theorem finite_subset_ncard_real {α : Type*} (S T : Set α)
    (hST : S⊆T) (hT : T.Finite) :
    S.Finite ∧ (S.ncard:ℝ)≤(T.ncard:ℝ) := by
  have hinj : Set.InjOn (fun z : α=>z) S := by
    intro z hz w hw h
    exact h
  exact ⟨Set.Finite.of_injOn hST hinj hT,
    by exact_mod_cast Set.ncard_le_ncard_of_injOn (fun z : α=>z) hST hinj hT⟩

private theorem actual_all_factor_counts (hEab : W847cHypEab) (h0180 : W847cHypLow)
    (h4928 : W847cHypFull12) (h47e : W847cHypAlpha3) (hE0 : W847cHypE0) (h2628 : W847cHypP3)
    (hSt : StewartHyp) (N : ℕ) (hN : 1≤N)
    (K : ℝ) (hK : 0<K) (eps : ℝ) (heps : 0<eps) :
    ∃ C : ℝ, 0<C ∧
      ∀ x D E : ℝ, 2≤x → 0<D → 0<E → x^((21:ℝ)/50)≤D*E →
        ∀ M : ℕ, 1≤M → x^((1:ℝ)/3)≤(M:ℝ) →
          ∀j∈A6WholeF8GridJoins.cells D E M,
            ∀F G : Four, ∀a b : ℕ,
              1≤a+b → a+b≤N → G∣F → Irreducible G → Bihom G a b →
              (∀t : Fin 4→₀ℕ, |((G.coeff t:ℤ):ℝ)|≤x^K) →
              (HighUnion x D E M j F).Finite →
              (pureUnion x D E M j F 4 7).Finite →
              (factorCellOutside x D E M j G).Finite ∧
                ((factorCellOutside x D E M j G).ncard:ℝ) ≤
                  C*x^eps*p3Price x D E M+(HighUnion x D E M j F).ncard+
                    (pureUnion x D E M j F 4 7).ncard := by
  classical
  obtain ⟨Cr,hCr,hResidual⟩ := actual_residual_factor_cell_count hEab hSt N hN
  obtain ⟨Cl,hCl,hLow⟩ := actual_low_factor_cell_count h0180 hSt K hK.le eps heps
  obtain ⟨Ct,hCt,hTwelve⟩ := actual_full12_factor_cell_count h4928 hSt K hK.le eps heps
  obtain ⟨C3,hC3,hThree⟩ := actual_alpha3_nonpure_factor_cell_count h47e hSt K hK.le eps heps
  obtain ⟨C4,hC4,hFour⟩ := actual_quartic_factor_cell_count hE0 hSt K hK.le eps heps
  obtain ⟨Cp,hCp,hPure6⟩ := actual_pure6_fixed_factor_count h2628 K hK eps heps
  let C : ℝ := Cr+Cl+Ct+C3+C4+Cp+1
  have hC : 0<C := by dsimp [C]; linarith
  have hCrC : Cr≤C := by dsimp [C]; linarith
  have hClC : Cl≤C := by dsimp [C]; linarith
  have hCtC : Ct≤C := by dsimp [C]; linarith
  have hC3C : C3≤C := by dsimp [C]; linarith
  have hC4C : C4≤C := by dsimp [C]; linarith
  have hCpC : Cp≤C := by dsimp [C]; linarith
  refine ⟨C,hC,?_⟩
  intro x D E hx hD hE hDE M hM hMthree j hj F G a b hab habN hGF hirr hBi hheight hHigh hSeven
  let S := factorCellOutside x D E M j G
  let B : ℝ := C*x^eps*p3Price x D E M+
    (HighUnion x D E M j F).ncard+(pureUnion x D E M j F 4 7).ncard
  have hxe : 0≤x^eps := by positivity
  have hxe1 : 1≤x^eps := Real.one_le_rpow (by linarith) heps.le
  have hprice : 1≤p3Price x D E M := by
    have hz : 0≤x^((1:ℝ)/3)/((M:ℝ)^((2:ℝ)/3)*(D*E)^((1:ℝ)/5)) := by positivity
    dsimp [p3Price]
    linarith
  have hnHigh : (0:ℝ)≤((HighUnion x D E M j F).ncard:ℝ) := Nat.cast_nonneg _
  have hnSeven : (0:ℝ)≤((pureUnion x D E M j F 4 7).ncard:ℝ) := Nat.cast_nonneg _
  have hCxe : 0≤C*x^eps := mul_nonneg hC.le hxe
  have hCxeP : 0≤C*x^eps*p3Price x D E M := mul_nonneg hCxe (by linarith)
  have hbPrice : C*x^eps*p3Price x D E M≤B := by dsimp [B]; linarith
  have hbSmall : C*x^eps≤B := by
    have hh : C*x^eps≤C*x^eps*p3Price x D E M := by
      nlinarith [mul_nonneg hCxe (sub_nonneg.mpr hprice)]
    exact hh.trans hbPrice
  have hbHigh : ((HighUnion x D E M j F).ncard:ℝ)≤B := by dsimp [B]; linarith
  have hbSeven : ((pureUnion x D E M j F 4 7).ncard:ℝ)≤B := by dsimp [B]; linarith
  have small (c : ℝ) (hc : c≤C)
      (hs : S.Finite ∧ (S.ncard:ℝ)≤c*x^eps) :
      S.Finite ∧ (S.ncard:ℝ)≤B :=
    ⟨hs.1,hs.2.trans ((mul_le_mul_of_nonneg_right hc hxe).trans hbSmall)⟩
  have subset (T : Set Point) (hT : T.Finite) (hST : S⊆T)
      (hTB : (T.ncard:ℝ)≤B) : S.Finite ∧ (S.ncard:ℝ)≤B := by
    have hh := finite_subset_ncard_real S T hST hT
    exact ⟨hh.1,hh.2.trans hTB⟩
  change S.Finite ∧ (S.ncard:ℝ)≤B
  rcases actual_full8_case G a b with hres | ⟨hGeom,ha,hb,hcase⟩
  · have hh := hResidual x D E hx hD hE hDE a b hab habN G hBi hirr hres M j
    apply small Cr hCrC
    refine ⟨hh.1,hh.2.trans ?_⟩
    nlinarith [mul_nonneg hCr.le (sub_nonneg.mpr hxe1)]
  rcases hcase with hhigh | hlow
  · apply subset (HighUnion x D E M j F) hHigh ?_ hbHigh
    intro z hz
    exact high_factor_point_in_same_F_union x D E M j F G a b
      hGF hirr.ne_zero hGeom ha hb hhigh hBi z hz.1.1 hz.1.2
  rcases hlow with h|h|h|h|h
  · rcases h with ⟨rfl,rfl⟩
    exact small Cl hClC (hLow x hx 1 (Or.inl rfl) G hirr.ne_zero hBi hGeom hheight D E M j)
  · rcases h with ⟨rfl,rfl⟩
    exact small Cl hClC (hLow x hx 2 (Or.inr rfl) G hirr.ne_zero hBi hGeom hheight D E M j)
  · rcases h with ⟨rfl,rfl⟩
    by_cases hpure : RationalPure (A6AlphaThreePrivate.cubicP G) (A6AlphaThreePrivate.cubicQ G) 6
    · have hh := hPure6 x D E hx hD hE M hM hMthree j hj G hBi hGeom hheight hpure
      have hs := finite_subset_ncard_real S (componentCell x D E M j G) (fun z hz=>hz.1) hh.1
      refine ⟨hs.1,hs.2.trans (hh.2.trans ?_)⟩
      exact (mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_right hCpC hxe) (by linarith : 0≤p3Price x D E M)).trans hbPrice
    · exact small C3 hC3C (hThree x hx G hirr.ne_zero hBi hGeom hheight hpure D E M j)
  · rcases h with ⟨rfl,rfl⟩
    obtain ⟨P,Q,hGraph,hCount⟩ := hFour x hx G hBi hGeom hheight
    by_cases hpure : RationalPure P Q 7
    · obtain ⟨κ,A,B,hκ,hAB,hpow⟩ := hpure
      apply subset (pureUnion x D E M j F 4 7) hSeven ?_ hbSeven
      intro z hz
      exact rational_pure_point_in_same_F_union x D E M j 4 7 F G P Q
        hGF hirr.ne_zero hGeom hBi hGraph κ A B hκ hAB hpow z hz.1.1 hz.1.2
    · exact small C4 hC4C (hCount hpure D E M j)
  · rcases h with ⟨rfl,rfl⟩
    exact small Ct hCtC (hTwelve x hx G hBi hGeom hheight D E M j)

