private theorem prime_subset (N n : ℕ) (hN : N ≠ 0) (hn : n ∣ N) :
    (n^7).primeFactors ⊆ N.primeFactors := by
  intro p hp
  obtain ⟨hpp,hpd,_⟩ := Nat.mem_primeFactors.mp hp
  exact Nat.mem_primeFactors.mpr
    ⟨hpp, dvd_trans (hpp.dvd_of_dvd_pow hpd) hn, hN⟩

private theorem weighted_tau (N : ℕ) (hN : N ≠ 0) :
    (∑ n ∈ N.divisors, (8 : ℝ)^((n^7).primeFactors.card)) ≤
      (N.divisors.card : ℝ)^4 := by
  have ht : (2:ℝ)^N.primeFactors.card ≤ (N.divisors.card : ℝ) := by
    exact_mod_cast
      JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C01.PcLowdegRed.two_pow_card_primeFactors_le N hN
  have hterm (n : ℕ) (hn : n ∈ N.divisors) :
      (8:ℝ)^((n^7).primeFactors.card) ≤ (N.divisors.card : ℝ)^3 := by
    have hcard := Finset.card_le_card (prime_subset N n hN (Nat.mem_divisors.mp hn).1)
    have hexp : (8:ℝ)^((n^7).primeFactors.card) ≤ (8:ℝ)^N.primeFactors.card := by
      gcongr ; norm_num
    have heq : (8:ℝ)^N.primeFactors.card = ((2:ℝ)^N.primeFactors.card)^3 := by
      rw [show (8:ℝ)=2^3 by norm_num, ← pow_mul, ← pow_mul, Nat.mul_comm]
    calc
      _ ≤ (8:ℝ)^N.primeFactors.card := hexp
      _ = ((2:ℝ)^N.primeFactors.card)^3 := heq
      _ ≤ (N.divisors.card : ℝ)^3 := by gcongr
  calc
    _ ≤ ∑ _n ∈ N.divisors, (N.divisors.card : ℝ)^3 := Finset.sum_le_sum hterm
    _ = (N.divisors.card : ℝ)*(N.divisors.card : ℝ)^3 := by simp
    _ = _ := by ring

theorem budget : (∀ ε : ℝ, 0 < ε → ∃ C : ℝ, 1 ≤ C ∧
  ∀ N : ℕ, N ≠ 0 →
  2 * (∑ n ∈ N.divisors, (8 : ℝ)^((n^7).primeFactors.card)) ≤
    C * (N : ℝ)^ε) := by
  intro ε hε
  have hδ : 0 < ε/4 := by positivity
  obtain ⟨A,hA,hdiv⟩ :=
    JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C01.PcLowdegRed.divisor_bound (ε/4) hδ
  refine ⟨max 1 (2*A^4), le_max_left _ _, ?_⟩
  intro N hN
  have hAp : 0 < A := by linarith
  have hpow : ((N:ℝ)^(ε/4))^4 = (N:ℝ)^ε := by
    calc
      _ = ((N:ℝ)^(ε/4))^(4:ℝ) := (Real.rpow_natCast _ 4).symm
      _ = (N:ℝ)^((ε/4)*4) := (Real.rpow_mul (Nat.cast_nonneg N) _ _).symm
      _ = _ := by congr 1; ring
  calc
    _ ≤ 2*(N.divisors.card : ℝ)^4 :=
      mul_le_mul_of_nonneg_left (weighted_tau N hN) (by norm_num)
    _ ≤ 2*(A*(N:ℝ)^(ε/4))^4 := by
      gcongr
      exact hdiv N hN
    _ = (2*A^4)*(N:ℝ)^ε := by rw [mul_pow,hpow]; ring
    _ ≤ max 1 (2*A^4)*(N:ℝ)^ε :=
      mul_le_mul_of_nonneg_right (le_max_right _ _) (Real.rpow_nonneg (Nat.cast_nonneg N) _)
end A6SignedSepticBudget
