theorem second_linear_axis_count_k (k : ℕ) (hk : 1 ≤ k)
    (x D E : ℝ) (M j : ℕ) (h p r : ℤ)
    (hD : 0<D) (hE : 0<E) (hM : 1≤M) (hj : j∈cells D E M)
    (hs : h=1 ∨ h=-1) (hpr : (p,r)≠(0,0))
    (ed : FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.EllipseData
      ((M:ℝ)/(8*D)) (rho D E M j) (4*E)) :
    let S : Set Point :=
      {z | z∈cellK k x D E M j h ∧ p*(z.2.1:ℤ)+r*(z.2.2:ℤ)=0}
    S.Finite ∧ (S.ncard:ℝ)≤6*(k:ℝ)*(1+FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.sideLength
      ((M:ℝ)/(8*D)) (rho D E M j) (4*E) ed.P 0) := by
  classical
  dsimp only
  let S : Set Point :=
    {z | z∈cellK k x D E M j h ∧ p*(z.2.1:ℤ)+r*(z.2.2:ℤ)=0}
  let L : ℝ := FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.sideLength
    ((M:ℝ)/(8*D)) (rho D E M j) (4*E) ed.P 0
  have hL : 0<L := ed.hpos.trans_le ed.horder
  change S.Finite ∧ (S.ncard:ℝ)≤6*(k:ℝ)*(1+L)
  by_cases hne : S.Nonempty
  swap
  · have hS : S=∅ := Set.not_nonempty_iff_eq_empty.mp hne
    rw [hS]
    refine ⟨Set.finite_empty, ?_⟩
    simp only [Set.ncard_empty, Nat.cast_zero]
    positivity
  obtain ⟨z₀,hz₀⟩ := hne
  have hsub₀ := box_shift_int hz₀.1.1
  have hprim₀ := unit_shift_primitive_k k hk
    (z₀.1.1:ℤ) (z₀.1.2:ℤ) (z₀.2.1:ℤ) (z₀.2.2:ℤ) h hs hsub₀
  have hu₀ : 1 ≤ z₀.2.1 := hz₀.1.1.2.2.1
  have hv₀ : 1 ≤ z₀.2.2 := hz₀.1.1.2.2.2.1
  have hfix : ∀ z∈S, z.2=z₀.2 := by
    intro z hz
    have hsub := box_shift_int hz.1.1
    have hprim := unit_shift_primitive_k k hk
      (z.1.1:ℤ) (z.1.2:ℤ) (z.2.1:ℤ) (z.2.2:ℤ) h hs hsub
    obtain ⟨huq,hvq⟩ := positive_linear_pair_unique p r hpr
      z.2.1 z.2.2 z₀.2.1 z₀.2.2 hz.1.1.2.2.1 hz.1.1.2.2.2.1 hu₀ hv₀
      hprim.2 hprim₀.2 hz.2 hz₀.2
    exact Prod.ext huq hvq
  let u0 : ℤ := (z₀.2.1:ℤ)
  let v0 : ℤ := (z₀.2.2:ℤ)
  let F := binaryChange ed.P (axisPhiK k u0 v0)
  have hF : F.IsHomogeneous k :=
    binaryChange_homogeneous k ed.P (axisPhiK k u0 v0) (axisPhiK_homogeneous k u0 v0)
  let c : Fin (k+1) → ℚ := fun i => ((F.coeff (binaryExponent k i):ℤ):ℚ)
  let N : ℕ := ⌈L⌉₊
  have hLN : L≤(N:ℝ) := Nat.le_ceil _
  have hNup : (N:ℝ)≤L+1 := (Nat.ceil_lt_add_one hL.le).le
  let grid := integerRationalGrid N
  let roots : Finset (ℚ×ℚ) :=
    (grid.product grid).filter (fun w =>
      (∑ i : Fin (k+1),c i*w.1^i.val*w.2^(k-i.val))=(h:ℚ))
  let lam : Point → Fin 2 → ℤ := fun q => ed.A.mulVec ![(q.1.1:ℤ),(q.1.2:ℤ)]
  let label : Point → ℚ×ℚ := fun q => ((lam q 0:ℚ),(lam q 1:ℚ))
  have hmap : Set.MapsTo label S (↑roots : Set (ℚ×ℚ)) := by
    intro q hq
    have hcover := ed.hcover ((q.1.1:ℤ),(q.1.2:ℤ))
      (first_ellipse_k k x D E M j h hD hE hM hj q hq.1)
    have hc0 : |(lam q 0:ℤ)|≤(N:ℤ) := by
      have hh : |((lam q 0:ℤ):ℝ)|≤(N:ℝ) := hcover.1.trans hLN
      exact_mod_cast hh
    have hc1 : |(lam q 1:ℤ)|≤(N:ℤ) := by
      have hh : |((lam q 1:ℤ):ℝ)|≤(N:ℝ) := (hcover.2.trans ed.horder).trans hLN
      exact_mod_cast hh
    have hgrid0 : (lam q 0:ℚ)∈grid := integerRationalGrid_mem N (lam q 0) hc0
    have hgrid1 : (lam q 1:ℚ)∈grid := integerRationalGrid_mem N (lam q 1) hc1
    have hsub := box_shift_int hq.1.1
    have hq2 := hfix q hq
    have hu : (q.2.1:ℤ)=u0 := by
      have hh : q.2.1=z₀.2.1 := congrArg Prod.fst hq2
      show (q.2.1:ℤ)=(z₀.2.1:ℤ)
      exact_mod_cast hh
    have hv : (q.2.2:ℤ)=v0 := by
      have hh : q.2.2=z₀.2.2 := congrArg Prod.snd hq2
      show (q.2.2:ℤ)=(z₀.2.2:ℤ)
      exact_mod_cast hh
    have hlevel0 :
        MvPolynomial.eval ![(q.1.1:ℤ),(q.1.2:ℤ)] (axisPhiK k u0 v0)=h := by
      rw [axisPhiK_eval, ← hu, ← hv]
      linear_combination hsub
    have hlam : ![lam q 0,lam q 1]=lam q := by
      funext i
      fin_cases i <;> rfl
    have hlevelZ : MvPolynomial.eval ![lam q 0,lam q 1] F=h := by
      rw [hlam]
      change MvPolynomial.eval (ed.A.mulVec ![(q.1.1:ℤ),(q.1.2:ℤ)])
        (binaryChange ed.P (axisPhiK k u0 v0))=h
      rw [binaryChange_eval,matrix_left_inverse_mulVec ed.P ed.A ed.hPA]
      exact hlevel0
    have hsumZ :
        (∑ i : Fin (k+1),F.coeff (binaryExponent k i)*
          (lam q 0)^i.val*(lam q 1)^(k-i.val))=h := by
      rw [← homogeneous_binary_eval k F hF (lam q 0) (lam q 1)]
      exact hlevelZ
    have hlevelQ :
        (∑ i : Fin (k+1),c i*(lam q 0:ℚ)^i.val*
          (lam q 1:ℚ)^(k-i.val))=(h:ℚ) := by
      dsimp only [c]
      exact_mod_cast hsumZ
    change label q ∈ roots
    apply Finset.mem_filter.mpr
    exact ⟨Finset.mem_product.mpr ⟨hgrid0,hgrid1⟩,hlevelQ⟩
  have hinj : Set.InjOn label S := by
    intro q hq q' hq' heq
    have hl0 : lam q 0=lam q' 0 := by
      have hh : (lam q 0:ℚ)=(lam q' 0:ℚ) := congrArg Prod.fst heq
      exact_mod_cast hh
    have hl1 : lam q 1=lam q' 1 := by
      have hh : (lam q 1:ℚ)=(lam q' 1:ℚ) := congrArg Prod.snd heq
      exact_mod_cast hh
    have hlv : lam q=lam q' := by
      funext i
      fin_cases i
      · exact hl0
      · exact hl1
    have hvec : ![(q.1.1:ℤ),(q.1.2:ℤ)]=![(q'.1.1:ℤ),(q'.1.2:ℤ)] := by
      calc
        _ = ed.P.mulVec (lam q) :=
          (matrix_left_inverse_mulVec ed.P ed.A ed.hPA _).symm
        _ = ed.P.mulVec (lam q') := congrArg ed.P.mulVec hlv
        _ = _ := matrix_left_inverse_mulVec ed.P ed.A ed.hPA _
    have hd : q.1.1=q'.1.1 := by
      have hh : (q.1.1:ℤ)=(q'.1.1:ℤ) := congrFun hvec 0
      exact_mod_cast hh
    have he : q.1.2=q'.1.2 := by
      have hh : (q.1.2:ℤ)=(q'.1.2:ℤ) := congrFun hvec 1
      exact_mod_cast hh
    have h2 : q.2=q'.2 := (hfix q hq).trans (hfix q' hq').symm
    exact Prod.ext (Prod.ext hd he) h2
  have hh0 : (h:ℚ)≠0 := by rcases hs with hs | hs <;> rw [hs] <;> norm_num
  have hrootcard : roots.card≤k*(grid.card+grid.card) :=
    homogeneous_binary_level_grid_count k hk c (h:ℚ) hh0 grid grid
  have hgrid := integerRationalGrid_card N
  have hfin : S.Finite := Set.Finite.of_injOn hmap hinj (Finset.finite_toSet roots)
  refine ⟨hfin,?_⟩
  have hcard0 : S.ncard≤roots.card := by
    have hh := Set.ncard_le_ncard_of_injOn label hmap hinj (Finset.finite_toSet roots)
    simpa only [Set.ncard_coe_finset] using hh
  have hcard : S.ncard≤k*((2*N+1)+(2*N+1)) :=
    hcard0.trans (hrootcard.trans (Nat.mul_le_mul_left k (Nat.add_le_add hgrid hgrid)))
  have hcardR : (S.ncard:ℝ)≤(k:ℝ)*((2*(N:ℝ)+1)+(2*(N:ℝ)+1)) := by
    exact_mod_cast hcard
  calc (S.ncard:ℝ)≤(k:ℝ)*((2*(N:ℝ)+1)+(2*(N:ℝ)+1)) := hcardR
    _ ≤ (k:ℝ)*(6*(1+L)) := by
      apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
      linarith
    _ = 6*(k:ℝ)*(1+L) := by ring

def betaOneBoxK (k : ℕ) (G : MvPolynomial (Fin 4) ℤ)
    (Q : Matrix (Fin 2) (Fin 2) ℤ) (N : ℕ) (h : ℤ) : Set Point :=
  {q | 1≤q.1.1 ∧ 1≤q.1.2 ∧ 1≤q.2.1 ∧ 1≤q.2.2 ∧
    (q.1.2:ℤ)^k*(q.2.2:ℤ)-(q.1.1:ℤ)^k*(q.2.1:ℤ)=h ∧
    MvPolynomial.eval ![(q.1.1:ℤ),(q.1.2:ℤ),(q.2.1:ℤ),(q.2.2:ℤ)] G=0 ∧
    ∀ i : Fin 2, |(Q.mulVec ![(q.1.1:ℤ),(q.1.2:ℤ)]) i|≤(N:ℤ)}

theorem beta_one_lattice_count_k (k : ℕ) (hk : 1 ≤ k)
    (a : ℕ) (ha : 1≤a) (H : ℝ) (hH : 1≤H)
    (G : MvPolynomial (Fin 4) ℤ)
    (hG : ∀ m∈G.support, m 0+m 1=a ∧ m 2+m 3=1)
    (hirr : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G))
    (hcoef : ∀ m : Fin 4 →₀ ℕ, |((G.coeff m:ℤ):ℝ)|≤H) :
    ∃ R : ℤ, R≠0 ∧ |(R:ℝ)|≤((2*a).factorial:ℝ)^2*H^(4*a) ∧
      ∀ P Q : Matrix (Fin 2) (Fin 2) ℤ, P*Q=1 →
        ∀ (N : ℕ) (h : ℤ), (h=1 ∨ h=-1) →
          (betaOneBoxK k G Q N h).Finite ∧
          (betaOneBoxK k G Q N h).ncard≤
            4*(a+k)*R.natAbs.divisors.card*(2*N+1) := by
  classical
  obtain ⟨A,B,R,hA,hB,hABheight,hR,hRbound,hrow⟩ :=
    beta_one_resultant_k k hk a ha H hH G hG hirr hcoef
  refine ⟨R,hR,hRbound,?_⟩
  intro P Q hPQ N h hs
  let n := a+k
  let F := binaryChange P (betaOnePhiK k A B)
  have hF : F.IsHomogeneous n :=
    binaryChange_homogeneous n P (betaOnePhiK k A B)
      (betaOnePhiK_homogeneous k a A B hA hB)
  let c : Fin (n+1) → ℚ := fun i => ((F.coeff (binaryExponent n i):ℤ):ℚ)
  let grid := integerRationalGrid N
  let K := (FormalAB.S84900580.ConsecutiveCountingA5Full12Nonexceptional.signedDivisors R).erase 0
  let roots : ℤ → Finset (ℚ×ℚ) := fun κ =>
    (grid.product grid).filter (fun w =>
      (∑ i : Fin (n+1),c i*w.1^i.val*w.2^(n-i.val))=(κ:ℚ))
  let T : Finset (ℤ×(ℚ×ℚ)) :=
    K.biUnion (fun κ => (roots κ).image (fun w => (κ,w)))
  let lambda : Point → Fin 2 → ℤ := fun q =>
    Q.mulVec ![(q.1.1:ℤ),(q.1.2:ℤ)]
  let kappa : Point → ℤ := fun q =>
    MvPolynomial.eval ![(q.1.1:ℤ),(q.1.2:ℤ)] (betaOnePhiK k A B)
  let label : Point → ℤ×(ℚ×ℚ) := fun q =>
    (kappa q,((lambda q 0:ℚ),(lambda q 1:ℚ)))
  have hdata : ∀ q∈betaOneBoxK k G Q N h,
      kappa q≠0 ∧ kappa q∣R ∧
      kappa q*(q.2.1:ℤ)=h*MvPolynomial.eval ![(q.1.1:ℤ),(q.1.2:ℤ)] A ∧
      kappa q*(q.2.2:ℤ)=h*MvPolynomial.eval ![(q.1.1:ℤ),(q.1.2:ℤ)] B := by
    intro q hq
    exact hrow (q.1.1:ℤ) (q.1.2:ℤ) (q.2.1:ℤ) (q.2.2:ℤ) h
      hs hq.2.2.2.2.1 hq.2.2.2.2.2.1
  have hmap : Set.MapsTo label (betaOneBoxK k G Q N h) (↑T : Set (ℤ×(ℚ×ℚ))) := by
    intro q hq
    have hd := hdata q hq
    have hkK : kappa q∈K := by
      apply Finset.mem_erase.mpr
      exact ⟨hd.1,
        FormalAB.S84900580.ConsecutiveCountingA5Full12Nonexceptional.mem_signedDivisors
          R (kappa q) hR hd.2.1⟩
    have hgrid0 : (lambda q 0:ℚ)∈grid :=
      integerRationalGrid_mem N (lambda q 0) (hq.2.2.2.2.2.2 0)
    have hgrid1 : (lambda q 1:ℚ)∈grid :=
      integerRationalGrid_mem N (lambda q 1) (hq.2.2.2.2.2.2 1)
    have hlambda : ![lambda q 0,lambda q 1]=lambda q := by
      funext i
      fin_cases i <;> rfl
    have hlevelZ :
        MvPolynomial.eval ![lambda q 0,lambda q 1] F=kappa q := by
      rw [hlambda]
      change MvPolynomial.eval
        (Q.mulVec ![(q.1.1:ℤ),(q.1.2:ℤ)])
        (binaryChange P (betaOnePhiK k A B))=kappa q
      rw [binaryChange_eval,matrix_left_inverse_mulVec P Q hPQ]
    have hsumZ :
        (∑ i : Fin (n+1),F.coeff (binaryExponent n i)*
          (lambda q 0)^i.val*(lambda q 1)^(n-i.val))=kappa q := by
      rw [← homogeneous_binary_eval n F hF (lambda q 0) (lambda q 1)]
      exact hlevelZ
    have hlevelQ :
        (∑ i : Fin (n+1),c i*(lambda q 0:ℚ)^i.val*
          (lambda q 1:ℚ)^(n-i.val))=(kappa q:ℚ) := by
      dsimp only [c]
      exact_mod_cast hsumZ
    change label q∈T
    apply Finset.mem_biUnion.mpr
    refine ⟨kappa q,hkK,Finset.mem_image.mpr
      ⟨((lambda q 0:ℚ),(lambda q 1:ℚ)),?_,rfl⟩⟩
    apply Finset.mem_filter.mpr
    exact ⟨Finset.mem_product.mpr ⟨hgrid0,hgrid1⟩,hlevelQ⟩
  have hinj : Set.InjOn label (betaOneBoxK k G Q N h) := by
    intro q hq q' hq' heq
    have hk' : kappa q=kappa q' := congrArg Prod.fst heq
    have hl : ((lambda q 0:ℚ),(lambda q 1:ℚ))=
        ((lambda q' 0:ℚ),(lambda q' 1:ℚ)) := congrArg Prod.snd heq
    have hl0 : lambda q 0=lambda q' 0 := by
      have hh : (lambda q 0:ℚ)=(lambda q' 0:ℚ) := congrArg Prod.fst hl
      exact_mod_cast hh
    have hl1 : lambda q 1=lambda q' 1 := by
      have hh : (lambda q 1:ℚ)=(lambda q' 1:ℚ) := congrArg Prod.snd hl
      exact_mod_cast hh
    have hlv : lambda q=lambda q' := by
      funext i
      fin_cases i
      · exact hl0
      · exact hl1
    have hvec : ![(q.1.1:ℤ),(q.1.2:ℤ)]=![(q'.1.1:ℤ),(q'.1.2:ℤ)] := by
      calc
        _ = P.mulVec (lambda q) :=
          (matrix_left_inverse_mulVec P Q hPQ _).symm
        _ = P.mulVec (lambda q') := congrArg P.mulVec hlv
        _ = _ := matrix_left_inverse_mulVec P Q hPQ _
    have hd : q.1.1=q'.1.1 := by
      have hh : (q.1.1:ℤ)=(q'.1.1:ℤ) := congrFun hvec 0
      exact_mod_cast hh
    have he : q.1.2=q'.1.2 := by
      have hh : (q.1.2:ℤ)=(q'.1.2:ℤ) := congrFun hvec 1
      exact_mod_cast hh
    have hr := hdata q hq
    have hr' := hdata q' hq'
    have hu' : kappa q*(q'.2.1:ℤ)=
        h*MvPolynomial.eval ![(q.1.1:ℤ),(q.1.2:ℤ)] A := by
      simpa only [← hk',← hd,← he] using hr'.2.2.1
    have hv' : kappa q*(q'.2.2:ℤ)=
        h*MvPolynomial.eval ![(q.1.1:ℤ),(q.1.2:ℤ)] B := by
      simpa only [← hk',← hd,← he] using hr'.2.2.2
    obtain ⟨hu,hv⟩ := beta_one_cofactor_unique (kappa q) h
      (MvPolynomial.eval ![(q.1.1:ℤ),(q.1.2:ℤ)] A)
      (MvPolynomial.eval ![(q.1.1:ℤ),(q.1.2:ℤ)] B)
      (q.2.1:ℤ) (q.2.2:ℤ) (q'.2.1:ℤ) (q'.2.2:ℤ)
      hr.1 hr.2.2.1 hr.2.2.2 hu' hv'
    have huN : q.2.1=q'.2.1 := by exact_mod_cast hu
    have hvN : q.2.2=q'.2.2 := by exact_mod_cast hv
    exact Prod.ext (Prod.ext hd he) (Prod.ext huN hvN)
  have hrootcard : ∀ κ∈K, (roots κ).card≤2*n*(2*N+1) := by
    intro κ hκ
    have hk0 : κ≠0 := (Finset.mem_erase.mp hκ).1
    have hkQ : (κ:ℚ)≠0 := by exact_mod_cast hk0
    have hzero := homogeneous_binary_level_grid_count n (by dsimp [n]; omega)
      c (κ:ℚ) hkQ grid grid
    have hgrid := integerRationalGrid_card N
    change (roots κ).card≤_
    calc
      _ ≤ n*(grid.card+grid.card) := hzero
      _ ≤ n*((2*N+1)+(2*N+1)) :=
        Nat.mul_le_mul_left n (Nat.add_le_add hgrid hgrid)
      _ = 2*n*(2*N+1) := by ring
  have hKcard : K.card≤2*R.natAbs.divisors.card :=
    (Finset.card_le_card (Finset.erase_subset _ _)).trans
      (FormalAB.S84900580.ConsecutiveCountingA5Full12Nonexceptional.signedDivisors_card R)
  have hTcard : T.card≤4*(a+k)*R.natAbs.divisors.card*(2*N+1) := by
    calc
      T.card ≤ ∑ κ∈K,((roots κ).image (fun w => (κ,w))).card :=
        Finset.card_biUnion_le
      _ ≤ ∑ κ∈K,(roots κ).card :=
        Finset.sum_le_sum (fun κ hκ => Finset.card_image_le)
      _ ≤ ∑ κ∈K,2*n*(2*N+1) := Finset.sum_le_sum hrootcard
      _ = K.card*(2*n*(2*N+1)) := by simp
      _ ≤ (2*R.natAbs.divisors.card)*(2*n*(2*N+1)) :=
        Nat.mul_le_mul_right _ hKcard
      _ = 4*(a+k)*R.natAbs.divisors.card*(2*N+1) := by dsimp [n]; ring
  have hfin : (betaOneBoxK k G Q N h).Finite :=
    Set.Finite.of_injOn hmap hinj (Finset.finite_toSet T)
  refine ⟨hfin,?_⟩
  exact (Set.ncard_le_ncard_of_injOn label hmap hinj
    (Finset.finite_toSet T)).trans (by simpa only [Set.ncard_coe_finset] using hTcard)

theorem beta_one_cell_count_k (k : ℕ) (hk : 1 ≤ k)
    (a : ℕ) (ha : 1≤a) (H : ℝ) (hH : 1≤H)
    (G : MvPolynomial (Fin 4) ℤ)
    (hG : ∀ m∈G.support, m 0+m 1=a ∧ m 2+m 3=1)
    (hirr : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G))
    (hcoef : ∀ m : Fin 4 →₀ ℕ, |((G.coeff m:ℤ):ℝ)|≤H) :
    ∃ R : ℤ, R≠0 ∧ |(R:ℝ)|≤((2*a).factorial:ℝ)^2*H^(4*a) ∧
      ∀ (x D E : ℝ), 0<D → 0<E →
        ∀ (M j : ℕ), 1≤M → j∈cells D E M →
          ∀ h : ℤ, (h=1 ∨ h=-1) →
          ∀ ed :
            FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.EllipseData
              ((M:ℝ)/(8*D)) (rho D E M j) (4*E),
            let S : Set Point :=
              {q | q∈cellK k x D E M j h ∧
                MvPolynomial.eval ![(q.1.1:ℤ),(q.1.2:ℤ),
                  (q.2.1:ℤ),(q.2.2:ℤ)] G=0}
            S.Finite ∧ (S.ncard:ℝ)≤
              12*((a+k : ℕ):ℝ)*(R.natAbs.divisors.card:ℝ)*
                (1+FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.sideLength
                  ((M:ℝ)/(8*D)) (rho D E M j) (4*E) ed.P 0) := by
  classical
  obtain ⟨R,hR,hRbound,hcount⟩ :=
    beta_one_lattice_count_k k hk a ha H hH G hG hirr hcoef
  refine ⟨R,hR,hRbound,?_⟩
  intro x D E hD hE M j hM hj h hs ed
  dsimp only
  let S : Set Point :=
    {q | q∈cellK k x D E M j h ∧
      MvPolynomial.eval ![(q.1.1:ℤ),(q.1.2:ℤ),(q.2.1:ℤ),(q.2.2:ℤ)] G=0}
  let L : ℝ := FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.sideLength
    ((M:ℝ)/(8*D)) (rho D E M j) (4*E) ed.P 0
  have hL : 0<L := ed.hpos.trans_le ed.horder
  let N : ℕ := ⌈L⌉₊
  have hLN : L≤(N:ℝ) := Nat.le_ceil _
  have hNup : (N:ℝ)≤L+1 := (Nat.ceil_lt_add_one hL.le).le
  have hsub : S⊆betaOneBoxK k G ed.A N h := by
    intro q hq
    have hcover := ed.hcover ((q.1.1:ℤ),(q.1.2:ℤ))
      (first_ellipse_k k x D E M j h hD hE hM hj q hq.1)
    have hc0 : |((ed.A.mulVec ![(q.1.1:ℤ),(q.1.2:ℤ)]) 0:ℝ)|≤(N:ℝ) :=
      hcover.1.trans hLN
    have hc1 : |((ed.A.mulVec ![(q.1.1:ℤ),(q.1.2:ℤ)]) 1:ℝ)|≤(N:ℝ) :=
      (hcover.2.trans ed.horder).trans hLN
    have hshiftZ := box_shift_int hq.1.1
    rcases hq.1.1 with ⟨hd,he,hu,hv,hshift,hm0,hm1,hd0,hd1,he0,he1⟩
    refine ⟨hd,he,hu,hv,hshiftZ,hq.2,?_⟩
    intro i
    fin_cases i
    · exact_mod_cast hc0
    · exact_mod_cast hc1
  have hb := hcount ed.P ed.A ed.hPA N h hs
  have hfin : S.Finite := hb.1.subset hsub
  have hcard : S.ncard≤4*(a+k)*R.natAbs.divisors.card*(2*N+1) :=
    (Set.ncard_le_ncard hsub hb.1).trans hb.2
  have hcardR : (S.ncard:ℝ)≤
      4*((a+k : ℕ):ℝ)*(R.natAbs.divisors.card:ℝ)*(2*(N:ℝ)+1) := by
    exact_mod_cast hcard
  refine ⟨hfin,?_⟩
  change (S.ncard:ℝ)≤12*((a+k : ℕ):ℝ)*(R.natAbs.divisors.card:ℝ)*(1+L)
  calc
    (S.ncard:ℝ)≤4*((a+k : ℕ):ℝ)*(R.natAbs.divisors.card:ℝ)*(2*(N:ℝ)+1) :=
      hcardR
    _ ≤ 4*((a+k : ℕ):ℝ)*(R.natAbs.divisors.card:ℝ)*(3*(1+L)) := by
      apply mul_le_mul_of_nonneg_left
      · linarith
      · positivity
    _ = 12*((a+k : ℕ):ℝ)*(R.natAbs.divisors.card:ℝ)*(1+L) := by ring

theorem beta_one_cell_subpower_k (k : ℕ) (hk : 1 ≤ k)
    (a K : ℕ) (ha : 1≤a) (hK : 1≤K) :
    ∀ ε : ℝ, 0<ε →
      ∃ C : ℝ, 0<C ∧
        ∀ x : ℝ, 2≤x →
          ∀ G : MvPolynomial (Fin 4) ℤ,
            (∀ m∈G.support, m 0+m 1=a ∧ m 2+m 3=1) →
            Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G) →
            (∀ m : Fin 4 →₀ ℕ, |((G.coeff m:ℤ):ℝ)|≤x^K) →
            ∀ D E : ℝ, 0<D → 0<E →
              ∀ M j : ℕ, 1≤M → j∈cells D E M →
                ∀ h : ℤ, (h=1 ∨ h=-1) →
                ∀ ed :
                  FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.EllipseData
                    ((M:ℝ)/(8*D)) (rho D E M j) (4*E),
                  let S : Set Point :=
                    {q | q∈cellK k x D E M j h ∧
                      MvPolynomial.eval ![(q.1.1:ℤ),(q.1.2:ℤ),
                        (q.2.1:ℤ),(q.2.2:ℤ)] G=0}
                  S.Finite ∧ (S.ncard:ℝ)≤
                    C*x^ε*
                      (1+FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.sideLength
                        ((M:ℝ)/(8*D)) (rho D E M j) (4*E) ed.P 0) := by
  intro ε hε
  obtain ⟨C,hC,hdiv⟩ := resultant_divisor_subpower a K ha hK ε hε
  refine ⟨12*((a+k:ℕ):ℝ)*C,by positivity,?_⟩
  intro x hx G hG hirr hcoef D E hD hE M j hM hj h hs ed
  have hx1 : 1≤x := by linarith
  have hH : 1≤x^K := one_le_pow₀ hx1
  obtain ⟨R,hR,hRbound,hcount⟩ :=
    beta_one_cell_count_k k hk a ha (x^K) hH G hG hirr hcoef
  obtain ⟨hfin,hcard⟩ := hcount x D E hD hE M j hM hj h hs ed
  refine ⟨hfin,?_⟩
  have hτ := hdiv x hx R hR hRbound
  let L : ℝ := FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.sideLength
    ((M:ℝ)/(8*D)) (rho D E M j) (4*E) ed.P 0
  have hL : 0<L := ed.hpos.trans_le ed.horder
  calc
    _ ≤ 12*((a+k:ℕ):ℝ)*(R.natAbs.divisors.card:ℝ)*(1+L) := hcard
    _ ≤ 12*((a+k:ℕ):ℝ)*(C*x^ε)*(1+L) := by
      apply mul_le_mul_of_nonneg_right
      · exact mul_le_mul_of_nonneg_left hτ (by positivity)
      · linarith
    _ = (12*((a+k:ℕ):ℝ)*C)*x^ε*(1+L) := by ring

end OSKPrivate

