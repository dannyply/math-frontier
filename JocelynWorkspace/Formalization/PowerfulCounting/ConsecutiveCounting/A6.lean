        simp [hcrit, ArithmeticFunction.moebius_apply_prime hp]
      · simp [ArithmeticFunction.moebius_apply_prime_pow hp hi0, hi0, hi1]
  have hsum : kDivSum k (p ^ j) = 1 + (if k ≤ j then (-1 : ℤ) else 0) := by
    unfold kDivSum
    rw [Nat.sum_divisors_prime_pow hp]
    calc
      _ = ∑ i ∈ Finset.range (j + 1),
          ((if i = 0 then (1 : ℤ) else 0) +
           (if i = 1 then (if k ≤ j then (-1 : ℤ) else 0) else 0)) := by
        apply Finset.sum_congr rfl
        intro i hi
        exact hterm i
      _ = _ := by
        rw [Finset.sum_add_distrib]
        simp only [Finset.sum_ite_eq', Finset.mem_range, Nat.zero_lt_succ, ite_true]
        by_cases hkj : k ≤ j
        · have hj1 : 1 < j + 1 := by omega
          simp [hj1, hkj]
        · simp [hkj]
  rw [hsum]
  by_cases hj : j < k
  · simp [hj, Nat.not_le.mpr hj]
  · simp [hj, Nat.le_of_not_gt hj]

private theorem kDivSum_eq_indicator (k : ℕ) (hk : 1 ≤ k) (n : ℕ) :
    kDivSum k n = if kFree k n then 1 else 0 := by
  refine Nat.recOnPosPrimePosCoprime ?_ ?_ ?_ ?_ n
  · intro p j hp hj
    rw [kDivSum_prime_pow k p j hk hp]
    simp only [kFree_prime_pow k p j hk hp]
  · have hn : ¬ kFree k 0 := by
      intro h
      exact h 2 Nat.prime_two (dvd_zero _)
    simp [kDivSum, hn]
  · have hn : kFree k 1 := by
      intro p hp hdiv
      have hpdiv : p ∣ 1 := dvd_trans (base_dvd_power k p hk) hdiv
      exact hp.not_dvd_one hpdiv
    simp [kDivSum, hn]
  · intro a b ha hb hab hsa hsb
    rw [kDivSum_mul k a b hab, hsa, hsb]
    simp only [kFree_mul_iff k a b hk hab]
    by_cases ha : kFree k a <;> by_cases hb : kFree k b <;> simp [ha, hb]

private theorem kFree_indicator (k : ℕ) (hk : 1 ≤ k) (n : ℕ) :
    (if kFree k n then (1 : ℝ) else 0) =
      ∑ d ∈ n.divisors,
        if d ^ k ∣ n then (ArithmeticFunction.moebius d : ℝ) else 0 := by
  have h : (kDivSum k n : ℝ) = if kFree k n then (1 : ℝ) else 0 := by
    rw [kDivSum_eq_indicator k hk]
    split_ifs <;> norm_num
  rw [← h]
  simp [kDivSum]

end
end GenericKFreeCore

namespace GenericKFreeCore
noncomputable section
open FormalAB.Sc7482db2.A5ExactOriginalSieveRetainedTruncation.ConsecutiveCountingA5Source
variable (k : ℕ) (hk : 1 ≤ k)

def kFreePairs (j : ℕ) (x : ℝ) : ℕ :=
  ((Finset.Icc 1 ⌊x⌋₊).filter
    (fun n => kFree j n ∧ kFree j (n+1))).card

noncomputable def shortPairSum (x y : ℝ) : ℝ :=
  ∑ n ∈ Finset.Icc 1 ⌊x⌋₊,
    ∑ d ∈ n.divisors, ∑ e ∈ (n + 1).divisors,
      if d ^ k ∣ n ∧ e ^ k ∣ n + 1 ∧ ((d * e : ℕ) : ℝ) ≤ y then
        ((ArithmeticFunction.moebius d * ArithmeticFunction.moebius e : ℤ) : ℝ)
      else 0

def largeDivisorTail (x y : ℝ) : Set ((ℕ × ℕ) × (ℕ × ℕ)) :=
  {q | 1 ≤ q.1.1 ∧ 1 ≤ q.1.2 ∧ 1 ≤ q.2.1 ∧ 1 ≤ q.2.2 ∧
    ((q.1.1 ^ k * q.2.1 : ℕ) : ℝ) ≤ x ∧
    q.1.2 ^ k * q.2.2 = q.1.1 ^ k * q.2.1 + 1 ∧
    y < ((q.1.1 * q.1.2 : ℕ) : ℝ)}

private def admissibleTriple (t : Σ _ : ℕ, ℕ × ℕ) : Prop :=
  t.2.1 ^ k ∣ t.1 ∧ t.2.2 ^ k ∣ t.1 + 1

private noncomputable def badTriples (x y : ℝ) :
    Finset (Σ _ : ℕ, ℕ × ℕ) :=
  (divisorTriples x).filter (fun t =>
    admissibleTriple k t ∧ y < ((t.2.1 * t.2.2 : ℕ) : ℝ))

include hk in
private theorem count_eq_sum (x : ℝ) :
    (kFreePairs k x : ℝ) =
      ∑ t ∈ divisorTriples x,
        if admissibleTriple k t then pairWeight t else 0 := by
  unfold kFreePairs
  rw [Finset.card_filter]
  push_cast
  simp only [divisorTriples, Finset.sum_sigma, Finset.sum_product]
  apply Finset.sum_congr rfl
  intro n hn
  calc
    (if kFree k n ∧ kFree k (n + 1) then (1 : ℝ) else 0) =
        (if kFree k n then (1 : ℝ) else 0) *
        (if kFree k (n + 1) then (1 : ℝ) else 0) := by
      by_cases h₁ : kFree k n <;> by_cases h₂ : kFree k (n + 1) <;> simp [h₁, h₂]
    _ = _ := by
      rw [kFree_indicator k hk n, kFree_indicator k hk (n + 1), Finset.sum_mul_sum]
      apply Finset.sum_congr rfl
      intro d hd
      apply Finset.sum_congr rfl
      intro e he
      by_cases hd₂ : d ^ k ∣ n <;> by_cases he₂ : e ^ k ∣ n + 1 <;>
        simp [admissibleTriple, pairWeight, hd₂, he₂]

private theorem short_eq_sum (x y : ℝ) :
    shortPairSum k x y =
      ∑ t ∈ divisorTriples x,
        if admissibleTriple k t ∧ ((t.2.1 * t.2.2 : ℕ) : ℝ) ≤ y then
          pairWeight t else 0 := by
  simp only [shortPairSum, divisorTriples, Finset.sum_sigma,
    Finset.sum_product, admissibleTriple, pairWeight, and_assoc]

include hk in
private theorem difference_eq (x y : ℝ) :
    (kFreePairs k x : ℝ) - shortPairSum k x y =
      ∑ t ∈ badTriples k x y, pairWeight t := by
  rw [count_eq_sum k hk, short_eq_sum k, ← Finset.sum_sub_distrib]
  simp only [badTriples, Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro t ht
  simp only [Nat.cast_mul]
  by_cases ht₁ : admissibleTriple k t
  · by_cases ht₂ : (t.2.1 : ℝ) * (t.2.2 : ℝ) ≤ y
    · simp [ht₁, ht₂, not_lt.mpr ht₂]
    · simp [ht₁, ht₂, lt_of_not_ge ht₂]
  · simp [ht₁]

include hk in
private theorem difference_le_bad_card (x y : ℝ) :
    |(kFreePairs k x : ℝ) - shortPairSum k x y| ≤
      ((badTriples k x y).card : ℝ) := by
  rw [difference_eq k hk]
  calc
    |∑ t ∈ badTriples k x y, pairWeight t| ≤
        ∑ t ∈ badTriples k x y, |pairWeight t| :=
      Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _t ∈ badTriples k x y, (1 : ℝ) :=
      Finset.sum_le_sum (fun t ht => weight_abs_le_one t)
    _ = _ := by simp

include hk in
private theorem positive_factor_bounds {d u N : ℕ}
    (hd : 1 ≤ d) (hu : 1 ≤ u) (hN : d ^ k * u ≤ N) :
    d ≤ N ∧ u ≤ N := by
  have hd₂ : d ≤ d ^ k := Nat.le_of_dvd
    (pow_pos (by omega : 0 < d) k) (base_dvd_power k d hk)
  have hsq : 0 < d ^ k := pow_pos (by omega : 0 < d) k
  have hdN : d ^ k ≤ d ^ k * u :=
    Nat.le_mul_of_pos_right _ (by omega)
  have huN : u ≤ d ^ k * u := Nat.le_mul_of_pos_left _ hsq
  exact ⟨le_trans hd₂ (le_trans hdN hN), le_trans huN hN⟩

include hk in
private theorem tail_finite (x y : ℝ) :
    (largeDivisorTail k x y).Finite := by
  let M := ⌊x⌋₊ + 1
  let box : Finset ((ℕ × ℕ) × (ℕ × ℕ)) :=
    ((Finset.Icc 1 M) ×ˢ (Finset.Icc 1 M)) ×ˢ
      ((Finset.Icc 1 M) ×ˢ (Finset.Icc 1 M))
  apply box.finite_toSet.subset
  rintro ⟨⟨d, e⟩, ⟨u, v⟩⟩ h
  rcases h with ⟨hd, he, hu, hv, hx, heq, hde⟩
  dsimp only at hd he hu hv hx heq hde
  have hn : d ^ k * u ≤ ⌊x⌋₊ := Nat.le_floor hx
  have hn' : e ^ k * v ≤ ⌊x⌋₊ + 1 := by omega
  rcases positive_factor_bounds k hk hd hu hn with ⟨hdN, huN⟩
  rcases positive_factor_bounds k hk he hv hn' with ⟨heN, hvN⟩
  change ((d, e), (u, v)) ∈ box
  simp only [box, Finset.mem_product, Finset.mem_Icc, M]
  omega

private theorem bad_mem {x y : ℝ} {t : Σ _ : ℕ, ℕ × ℕ}
    (ht : t ∈ badTriples k x y) :
    1 ≤ t.1 ∧ t.1 ≤ ⌊x⌋₊ ∧
    1 ≤ t.2.1 ∧ 1 ≤ t.2.2 ∧
    t.2.1 ^ k ∣ t.1 ∧ t.2.2 ^ k ∣ t.1 + 1 ∧
    y < ((t.2.1 * t.2.2 : ℕ) : ℝ) := by
  rcases Finset.mem_filter.mp ht with ⟨ht, hadm, hcut⟩
  rcases Finset.mem_sigma.mp ht with ⟨hn, hde⟩
  rcases Finset.mem_Icc.mp hn with ⟨hn₁, hn₂⟩
  rcases Finset.mem_product.mp hde with ⟨hd, he⟩
  have hdpos := Nat.pos_of_dvd_of_pos (Nat.mem_divisors.mp hd).1 (by omega : 0 < t.1)
  have hepos := Nat.pos_of_dvd_of_pos (Nat.mem_divisors.mp he).1 (by omega : 0 < t.1 + 1)
  exact ⟨hn₁, hn₂, by omega, by omega, hadm.1, hadm.2, hcut⟩

private def tailMap (t : Σ _ : ℕ, ℕ × ℕ) :
    ((ℕ × ℕ) × (ℕ × ℕ)) :=
  ((t.2.1, t.2.2), (t.1 / t.2.1 ^ k, (t.1 + 1) / t.2.2 ^ k))

private theorem tailMap_mem {x y : ℝ} (hx : 2 ≤ x)
    {t : Σ _ : ℕ, ℕ × ℕ} (ht : t ∈ badTriples k x y) :
    tailMap k t ∈ largeDivisorTail k x y := by
  rcases bad_mem k ht with ⟨hn, hnN, hd, he, hd₂, he₂, hcut⟩
  have hnpos : 0 < t.1 := by omega
  have hnpos' : 0 < t.1 + 1 := by omega
  have hdpos : 0 < t.2.1 ^ k := pow_pos (by omega) k
  have hepos : 0 < t.2.2 ^ k := pow_pos (by omega) k
  have hupos : 1 ≤ t.1 / t.2.1 ^ k := by
    have := Nat.div_pos (Nat.le_of_dvd hnpos hd₂) hdpos
    omega
  have hvpos : 1 ≤ (t.1 + 1) / t.2.2 ^ k := by
    have := Nat.div_pos (Nat.le_of_dvd hnpos' he₂) hepos
    omega
  have hdu := Nat.mul_div_cancel' hd₂
  have hev := Nat.mul_div_cancel' he₂
  change 1 ≤ t.2.1 ∧ 1 ≤ t.2.2 ∧
    1 ≤ t.1 / t.2.1 ^ k ∧ 1 ≤ (t.1 + 1) / t.2.2 ^ k ∧
    ((t.2.1 ^ k * (t.1 / t.2.1 ^ k) : ℕ) : ℝ) ≤ x ∧
    t.2.2 ^ k * ((t.1 + 1) / t.2.2 ^ k) =
      t.2.1 ^ k * (t.1 / t.2.1 ^ k) + 1 ∧
    y < ((t.2.1 * t.2.2 : ℕ) : ℝ)
  refine ⟨hd, he, hupos, hvpos, ?_, ?_, hcut⟩
  · rw [hdu]
    exact le_trans (by exact_mod_cast hnN)
      (Nat.floor_le (by linarith : 0 ≤ x))
  · rw [hdu, hev]

private theorem tailMap_injOn (x y : ℝ) :
    Set.InjOn (tailMap k) (↑(badTriples k x y) : Set (Σ _ : ℕ, ℕ × ℕ)) := by
  rintro ⟨n, d, e⟩ ha ⟨m, f, g⟩ hb hab
  have ha' := bad_mem k ha
  have hb' := bad_mem k hb
  have hd : d = f := congrArg (fun q : ((ℕ × ℕ) × (ℕ × ℕ)) => q.1.1) hab
  have he : e = g := congrArg (fun q : ((ℕ × ℕ) × (ℕ × ℕ)) => q.1.2) hab
  have hu : n / d ^ k = m / f ^ k :=
    congrArg (fun q : ((ℕ × ℕ) × (ℕ × ℕ)) => q.2.1) hab
  subst f
  subst g
  have hnd : d ^ k * (n / d ^ k) = n := Nat.mul_div_cancel' ha'.2.2.2.2.1
  have hmd : d ^ k * (m / d ^ k) = m := Nat.mul_div_cancel' hb'.2.2.2.2.1
  have hnm : n = m := by
    calc
      n = d ^ k * (n / d ^ k) := hnd.symm
      _ = d ^ k * (m / d ^ k) := congrArg (fun z : ℕ => d ^ k * z) hu
      _ = m := hmd
  subst m
  rfl

include hk in
private theorem bad_card_le_tail (x y : ℝ) (hx : 2 ≤ x) :
    (badTriples k x y).card ≤ (largeDivisorTail k x y).ncard := by
  have himage :
      (↑((badTriples k x y).image (tailMap k)) : Set ((ℕ × ℕ) × (ℕ × ℕ))) ⊆
        largeDivisorTail k x y := by
    intro q hq
    rcases Finset.mem_image.mp hq with ⟨t, ht, rfl⟩
    exact tailMap_mem k hx ht
  calc
    (badTriples k x y).card = ((badTriples k x y).image (tailMap k)).card :=
      (Finset.card_image_of_injOn (tailMap_injOn k x y)).symm
    _ = (↑((badTriples k x y).image (tailMap k)) :
        Set ((ℕ × ℕ) × (ℕ × ℕ))).ncard := (Set.ncard_coe_finset _).symm
    _ ≤ _ := Set.ncard_le_ncard himage (tail_finite k hk x y)

include hk in
theorem finite_truncation :
    ∀ (x y : ℝ), 2 ≤ x → 1 ≤ y →
      (largeDivisorTail k x y).Finite ∧
      |(kFreePairs k x : ℝ) - shortPairSum k x y| ≤
        ((largeDivisorTail k x y).ncard : ℝ) := by
  intro x y hx hy
  refine ⟨tail_finite k hk x y, ?_⟩
  exact le_trans (difference_le_bad_card k hk x y)
    (by exact_mod_cast bad_card_le_tail k hk x y hx)

end
end GenericKFreeCore

namespace GenericKFreeAnalytic
noncomputable section
open FormalAB.Sb23c796c.ConsecutiveCountingA5Analytic
open FormalAB.Sb23c796c.ConsecutiveCountingA5CRT
open GenericKFreeCore
variable (k : ℕ)
set_option maxHeartbeats 1500000
set_option maxRecDepth 4000
set_option linter.all false

private noncomputable def densityCoeff : ArithmeticFunction ℝ :=
  ⟨fun n => (ArithmeticFunction.moebius n : ℝ) *
      (n.divisors.card : ℝ) / (n : ℝ) ^ k, by simp⟩

private theorem densityCoeff_multiplicative : (densityCoeff k).IsMultiplicative := by
  rw [ArithmeticFunction.IsMultiplicative.iff_ne_zero]
  refine ⟨?_, ?_⟩
  · norm_num [densityCoeff]
  · intro m n hm hn hcop
    have hmR : (m : ℝ) ≠ 0 := by exact_mod_cast hm
    have hnR : (n : ℝ) ≠ 0 := by exact_mod_cast hn
    have hmu := ArithmeticFunction.isMultiplicative_moebius.map_mul_of_coprime hcop
    have hcard := hcop.card_divisors_mul
    change (ArithmeticFunction.moebius (m * n) : ℝ) *
        ((m * n).divisors.card : ℝ) / ((m * n : ℕ) : ℝ) ^ k =
      ((ArithmeticFunction.moebius m : ℝ) *
        (m.divisors.card : ℝ) / (m : ℝ) ^ k) *
      ((ArithmeticFunction.moebius n : ℝ) *
        (n.divisors.card : ℝ) / (n : ℝ) ^ k)
    rw [hmu, hcard]
    push_cast
    rw [mul_pow]
    field_simp [hmR, hnR] <;> ring

private theorem densityCoeff_prime_pow (p j : ℕ) (hp : p.Prime) :
    (densityCoeff k) (p ^ j) =
      if j = 0 then 1 else if j = 1 then -2 / (p : ℝ) ^ k else 0 := by
  by_cases hk0 : j = 0
  · subst j
    norm_num [densityCoeff]
  · by_cases hk1 : j = 1
    · subst j
      have hcard : p.divisors.card = 2 := by
        simpa using prime_pow_divisor_card p 1 hp
      simp [densityCoeff, ArithmeticFunction.moebius_apply_prime hp, hcard]
    · simp [densityCoeff, ArithmeticFunction.moebius_apply_prime_pow hp hk0, hk0, hk1]

private theorem densityCoeff_unitary_sum (n : ℕ) :
    (densityCoeff k) n =
      (∑ d ∈ n.divisors,
        if d.Coprime (n / d) then
          ((ArithmeticFunction.moebius d *
            ArithmeticFunction.moebius (n / d) : ℤ) : ℝ)
        else 0) / (n : ℝ) ^ k := by
  have h : (∑ d ∈ n.divisors,
      if d.Coprime (n / d) then
        ((ArithmeticFunction.moebius d *
          ArithmeticFunction.moebius (n / d) : ℤ) : ℝ)
      else 0) =
      (ArithmeticFunction.moebius n : ℝ) * (n.divisors.card : ℝ) := by
    exact_mod_cast unitary_moebius_coefficient n
  change (ArithmeticFunction.moebius n : ℝ) *
      (n.divisors.card : ℝ) / (n : ℝ) ^ k = _
  rw [h]

private theorem densityCoeff_euler_factor (p : Nat.Primes) :
    (∑' j : ℕ, (densityCoeff k) ((p : ℕ) ^ j)) =
      1 - 2 / ((p : ℕ) : ℝ) ^ k := by
  have hsupp : ∀ j ∉ ({0, 1} : Finset ℕ),
      (densityCoeff k) ((p : ℕ) ^ j) = 0 := by
    intro j hj
    have hj0 : j ≠ 0 := by
      intro h
      apply hj
      simp [h]
    have hj1 : j ≠ 1 := by
      intro h
      apply hj
      simp [h]
    simp [densityCoeff_prime_pow k _ _ p.property, hj0, hj1]
  calc
    _ = ∑ j ∈ ({0, 1} : Finset ℕ), (densityCoeff k) ((p : ℕ) ^ j) :=
      tsum_eq_sum hsupp
    _ = _ := by
      simp [densityCoeff_prime_pow, p.property, sub_eq_add_neg, neg_div]

private theorem densityCoeff_euler_product
    (habs : Summable (fun n : ℕ => ‖(densityCoeff k) n‖)) :
    (∏' p : Nat.Primes, (1 - 2 / ((p : ℕ) : ℝ) ^ k)) =
      ∑' n : ℕ, (densityCoeff k) n := by
  have h := (densityCoeff_multiplicative k).eulerProduct_tprod habs
  simpa only [densityCoeff_euler_factor k] using h

private theorem densityCoeff_norm_raw (n : ℕ) :
    ‖densityCoeff k n‖ ≤ (n.divisors.card : ℝ) / (n : ℝ)^k := by
  have hμ : |(ArithmeticFunction.moebius n : ℝ)| ≤ 1 := by
    exact_mod_cast ArithmeticFunction.abs_moebius_le_one (n := n)
  have hτ : 0 ≤ (n.divisors.card : ℝ) := Nat.cast_nonneg _
  have hp : 0 ≤ (n : ℝ)^k := pow_nonneg (Nat.cast_nonneg _) _
  rw [Real.norm_eq_abs]
  change |(ArithmeticFunction.moebius n : ℝ) * (n.divisors.card : ℝ) / (n : ℝ)^k| ≤ _
  simp only [abs_div, abs_mul, abs_of_nonneg hτ, abs_of_nonneg hp]
  simpa using div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right hμ hτ) hp

private theorem densityCoeff_norm_le_majorant (hk : 2 ≤ k) (n : ℕ) :
    ‖densityCoeff k n‖ ≤ divisorMajorant 1 n := by
  by_cases hn : n = 0
  · subst n
    simp [densityCoeff, divisorMajorant]
  · have hnN : 1 ≤ n := Nat.one_le_iff_ne_zero.mpr hn
    have hnR : 0 < (n : ℝ) := by exact_mod_cast Nat.pos_of_ne_zero hn
    have hn1 : 1 ≤ (n : ℝ) := by exact_mod_cast hnN
    have hp : (n : ℝ)^2 ≤ (n : ℝ)^k :=
      pow_le_pow_right₀ hn1 hk
    calc
      _ ≤ (n.divisors.card : ℝ) / (n : ℝ)^k := densityCoeff_norm_raw k n
      _ ≤ (n.divisors.card : ℝ) / (n : ℝ)^2 :=
        div_le_div_of_nonneg_left (Nat.cast_nonneg _) (by positivity) hp
      _ = divisorMajorant 1 n := by norm_num [divisorMajorant]

private theorem densityCoeff_norm_summable (hk : 2 ≤ k) :
    Summable (fun n : ℕ => ‖densityCoeff k n‖) := by
  have hmajor := divisorMajorant_summable 1 (by norm_num)
  refine hmajor.of_norm_bounded ?_
  intro n
  simpa only [norm_norm] using densityCoeff_norm_le_majorant k hk n

private theorem densityCoeff_euler_identity (hk : 2 ≤ k) :
    (∏' p : Nat.Primes, (1 - 2 / ((p : ℕ) : ℝ)^k)) =
      ∑' n : ℕ, densityCoeff k n :=
  densityCoeff_euler_product k (densityCoeff_norm_summable k hk)

private theorem densityCoeff_tail_pointwise (hk : 2 ≤ k)
    (δ y : ℝ) (hδ : 0 < δ) (hδ1 : δ < 1) (hy : 1 ≤ y)
    (n : ℕ) (hyn : y < (n : ℝ)) :
    ‖densityCoeff k n‖ ≤ divisorMajorant δ n / y^((k : ℝ)-1-δ) := by
  have hyR : 0 < y := by linarith
  have hnR : 0 < (n : ℝ) := lt_trans hyR hyn
  have hkR : (2 : ℝ) ≤ k := by exact_mod_cast hk
  have ha : 0 ≤ (k : ℝ)-1-δ := by linarith
  have hnpow : 0 < (n : ℝ)^((k : ℝ)-1-δ) := Real.rpow_pos_of_pos hnR _
  have hypow : 0 < y^((k : ℝ)-1-δ) := Real.rpow_pos_of_pos hyR _
  have hbase : y^((k : ℝ)-1-δ) ≤ (n : ℝ)^((k : ℝ)-1-δ) :=
    Real.rpow_le_rpow hyR.le hyn.le ha
  have heq : (n.divisors.card : ℝ) / (n : ℝ)^k =
      divisorMajorant δ n / (n : ℝ)^((k : ℝ)-1-δ) := by
    unfold divisorMajorant
    rw [div_div, ← Real.rpow_add hnR]
    have hex : (1+δ)+((k : ℝ)-1-δ) = (k : ℝ) := by ring
    rw [hex, Real.rpow_natCast]
  calc
    _ ≤ (n.divisors.card : ℝ) / (n : ℝ)^k := densityCoeff_norm_raw k n
    _ = divisorMajorant δ n / (n : ℝ)^((k : ℝ)-1-δ) := heq
    _ ≤ divisorMajorant δ n / y^((k : ℝ)-1-δ) :=
      (div_le_div_iff₀ hnpow hypow).mpr
        (mul_le_mul_of_nonneg_left hbase (divisorMajorant_nonneg δ n))

variable (hk : 2 ≤ k)

private theorem coprime_kth_interval_discrepancy
    (x : ℝ) (hx : 0 ≤ x) (d e : ℕ)
    (hd : 0 < d) (he : 0 < e) (hcop : d.Coprime e) :
    |(((Finset.Icc 1 ⌊x⌋₊).filter
        (fun n => d ^ k ∣ n ∧ e ^ k ∣ n + 1)).card : ℝ) -
        x / (((d * e : ℕ) : ℝ) ^ k)| ≤ 1 := by
  let D := d ^ k
  let E := e ^ k
  let q := D * E
  have hD : 0 < D := pow_pos hd k
  have hE : 0 < E := pow_pos he k
  have hq : 0 < q := Nat.mul_pos hD hE
  have hcop' : D.Coprime E := Nat.Coprime.pow k k hcop
  let z := Nat.chineseRemainder hcop' 0 (E - 1)
  let r : ℕ := z.val
  have hrD : r % D = 0 := by
    have h := z.property.1
    change r % D = 0 % D at h
    simpa using h
  have hrE : r % E = E - 1 := by
    have h := z.property.2
    change r % E = (E - 1) % E at h
    simpa only [Nat.mod_eq_of_lt (by omega : E - 1 < E)] using h
  have hr : r < q := Nat.chineseRemainder_lt_mul hcop' 0 (E - 1) hD.ne' hE.ne'
  have hpred : ∀ n : ℕ, (D ∣ n ∧ E ∣ n + 1) ↔ n % q = r := by
    intro n
    constructor
    · rintro ⟨hDn, hEn⟩
      have hnd : n ≡ 0 [MOD D] := by
        change n % D = 0 % D
        simpa using Nat.mod_eq_zero_of_dvd hDn
      have hne : n ≡ E - 1 [MOD E] := by
        change n % E = (E - 1) % E
        rw [Nat.mod_eq_of_lt (by omega : E - 1 < E)]
        exact (dvd_succ_iff_mod_pred n E hE).mp hEn
      have h := Nat.chineseRemainder_modEq_unique hcop' hnd hne
      change n % q = r % q at h
      simpa only [Nat.mod_eq_of_lt hr] using h
    · intro hn
      have hnrepr : n = q * (n / q) + r := by
        have h := Nat.mod_add_div n q
        rw [hn] at h
        omega
      have hnD : n % D = r % D := by
        rw [hnrepr]
        dsimp [q]
        simp [Nat.add_mod, Nat.mul_mod, mul_assoc]
      have hnE : n % E = r % E := by
        rw [hnrepr]
        dsimp [q]
        simp [Nat.add_mod, Nat.mul_mod, mul_assoc]
      constructor
      · exact Nat.dvd_of_mod_eq_zero (hnD.trans hrD)
      · exact (dvd_succ_iff_mod_pred n E hE).mpr (hnE.trans hrE)
  have hset :
      ((Finset.Icc 1 ⌊x⌋₊).filter
        (fun n => d ^ k ∣ n ∧ e ^ k ∣ n + 1)) =
      ((Finset.Icc 1 ⌊x⌋₊).filter (fun n => n % q = r)) := by
    ext n
    simp only [Finset.mem_filter]
    change (n ∈ Finset.Icc 1 ⌊x⌋₊ ∧ (D ∣ n ∧ E ∣ n + 1)) ↔ _
    rw [hpred n]
  have hqR : (q : ℝ) = (((d * e : ℕ) : ℝ) ^ k) := by
    dsimp [q, D, E]
    push_cast
    rw [mul_pow]
  rw [hset]
  simpa only [hqR] using residue_interval_discrepancy x hx q r hq hr

include hk in
private theorem consecutive_kth_divisors_coprime (d e n : ℕ)
    (hd : d ^ k ∣ n) (he : e ^ k ∣ n + 1) : d.Coprime e := by
  have hd' : d ∣ n := dvd_trans
    (GenericKFreeCore.base_dvd_power k d (by omega)) hd
  have he' : e ∣ n + 1 := dvd_trans
    (GenericKFreeCore.base_dvd_power k e (by omega)) he
  have hcon : n.Coprime (n + 1) := by
    rw [Nat.coprime_self_add_right]
    exact Nat.coprime_one_right _
  exact Nat.Coprime.of_dvd_right he'
    (Nat.Coprime.of_dvd_left hd' hcon)

include hk in
private theorem noncoprime_kth_interval_empty
    (x : ℝ) (d e : ℕ) (hcop : ¬ d.Coprime e) :
    ((Finset.Icc 1 ⌊x⌋₊).filter
      (fun n => d ^ k ∣ n ∧ e ^ k ∣ n + 1)) = ∅ := by
  ext n
  simp only [Finset.mem_filter, Finset.notMem_empty, iff_false]
  rintro ⟨hn, hd, he⟩
  exact hcop (consecutive_kth_divisors_coprime k hk d e n hd he)

include hk in
private theorem kth_interval_discrepancy
    (x : ℝ) (hx : 0 ≤ x) (d e : ℕ) (hd : 0 < d) (he : 0 < e) :
    |(((Finset.Icc 1 ⌊x⌋₊).filter
        (fun n => d ^ k ∣ n ∧ e ^ k ∣ n + 1)).card : ℝ) -
      (if d.Coprime e then x / (((d * e : ℕ) : ℝ) ^ k) else 0)| ≤ 1 := by
  by_cases hcop : d.Coprime e
  · simpa only [if_pos hcop] using
      coprime_kth_interval_discrepancy k x hx d e hd he hcop
  · rw [noncoprime_kth_interval_empty k hk x d e hcop]
    simp [hcop]

private theorem hyperbola_density_sum (y : ℝ) :
    (∑ p ∈ hyperbolaPairs y,
      if p.1.Coprime p.2 then
        mobiusPairWeight p / (((p.1 * p.2 : ℕ) : ℝ) ^ k)
      else 0) =
      ∑ m ∈ Finset.Icc 1 ⌊y⌋₊, (densityCoeff k) m := by
  rw [hyperbola_sum_reindex]
  apply Finset.sum_congr rfl
  intro m hm
  calc
    _ = (∑ d ∈ m.divisors,
        if d.Coprime (m / d) then
          ((ArithmeticFunction.moebius d *
            ArithmeticFunction.moebius (m / d) : ℤ) : ℝ)
        else 0) / (m : ℝ) ^ k := by
      rw [Finset.sum_div]
      apply Finset.sum_congr rfl
      intro d hd
      have hprod : d * (m / d) = m :=
        Nat.mul_div_cancel' (Nat.mem_divisors.mp hd).1
      change
        (if d.Coprime (m / d) then
          ((ArithmeticFunction.moebius d *
            ArithmeticFunction.moebius (m / d) : ℤ) : ℝ) /
              (((d * (m / d) : ℕ) : ℝ) ^ k)
        else 0) =
        (if d.Coprime (m / d) then
          ((ArithmeticFunction.moebius d *
            ArithmeticFunction.moebius (m / d) : ℤ) : ℝ)
        else 0) / (m : ℝ) ^ k
      by_cases hcop : d.Coprime (m / d)
      · simp only [if_pos hcop, hprod]
      · simp only [if_neg hcop, zero_div]
    _ = (densityCoeff k) m := (densityCoeff_unitary_sum k m).symm

include hk in
private theorem short_inner_eq_hyperbola
    (n : ℕ) (hn : 0 < n) (y : ℝ) (hy : 1 ≤ y) (w : ℕ × ℕ → ℝ) :
    (∑ d ∈ n.divisors, ∑ e ∈ (n + 1).divisors,
      if d ^ k ∣ n ∧ e ^ k ∣ n + 1 ∧ ((d * e : ℕ) : ℝ) ≤ y then
        w (d, e) else 0) =
      ∑ p ∈ hyperbolaPairs y,
        if p.1 ^ k ∣ n ∧ p.2 ^ k ∣ n + 1 then w p else 0 := by
  let s := (n.divisors ×ˢ (n + 1).divisors).filter (fun p =>
    p.1 ^ k ∣ n ∧ p.2 ^ k ∣ n + 1 ∧ ((p.1 * p.2 : ℕ) : ℝ) ≤ y)
  let t := (hyperbolaPairs y).filter (fun p =>
    p.1 ^ k ∣ n ∧ p.2 ^ k ∣ n + 1)
  have hst : s = t := by
    ext p
    constructor
    · intro hp
      rcases Finset.mem_filter.mp hp with ⟨hp, hd₂, he₂, hprod⟩
      rcases Finset.mem_product.mp hp with ⟨hd, he⟩
      have hdpos : 0 < p.1 :=
        Nat.pos_of_dvd_of_pos (Nat.mem_divisors.mp hd).1 hn
      have hepos : 0 < p.2 :=
        Nat.pos_of_dvd_of_pos (Nat.mem_divisors.mp he).1 (by omega)
      have hprodN : p.1 * p.2 ≤ ⌊y⌋₊ := Nat.le_floor hprod
      have hdle : p.1 ≤ p.1 * p.2 := Nat.le_mul_of_pos_right _ hepos
      have hele : p.2 ≤ p.1 * p.2 := Nat.le_mul_of_pos_left _ hdpos
      apply Finset.mem_filter.mpr
      refine ⟨?_, hd₂, he₂⟩
      apply Finset.mem_filter.mpr
      refine ⟨Finset.mem_product.mpr ⟨?_, ?_⟩, hprodN⟩
      · exact Finset.mem_Icc.mpr ⟨by omega, le_trans hdle hprodN⟩
      · exact Finset.mem_Icc.mpr ⟨by omega, le_trans hele hprodN⟩
    · intro hp
      rcases Finset.mem_filter.mp hp with ⟨hp, hd₂, he₂⟩
      rcases Finset.mem_filter.mp hp with ⟨hpbox, hprod⟩
      have hd : p.1 ∣ n := dvd_trans
        (GenericKFreeCore.base_dvd_power k p.1 (by omega)) hd₂
      have he : p.2 ∣ n + 1 := dvd_trans
        (GenericKFreeCore.base_dvd_power k p.2 (by omega)) he₂
      apply Finset.mem_filter.mpr
      refine ⟨Finset.mem_product.mpr
        ⟨Nat.mem_divisors.mpr ⟨hd, hn.ne'⟩,
         Nat.mem_divisors.mpr ⟨he, by omega⟩⟩, hd₂, he₂, ?_⟩
      exact le_trans (by exact_mod_cast hprod)
        (Nat.floor_le (by linarith : 0 ≤ y))
  calc
    _ = ∑ p ∈ n.divisors ×ˢ (n + 1).divisors,
        if p.1 ^ k ∣ n ∧ p.2 ^ k ∣ n + 1 ∧ ((p.1 * p.2 : ℕ) : ℝ) ≤ y then
          w p else 0 := by rw [Finset.sum_product]
    _ = ∑ p ∈ s, w p := by
      symm
      exact Finset.sum_filter _ _
    _ = ∑ p ∈ t, w p := by rw [hst]
    _ = _ := Finset.sum_filter _ _

include hk in
private theorem shortPairSum_hyperbola (x y : ℝ) (hy : 1 ≤ y) :
    GenericKFreeCore.shortPairSum k x y =
      ∑ p ∈ hyperbolaPairs y, mobiusPairWeight p *
        (((Finset.Icc 1 ⌊x⌋₊).filter
          (fun n => p.1 ^ k ∣ n ∧ p.2 ^ k ∣ n + 1)).card : ℝ) := by
  unfold GenericKFreeCore.shortPairSum
  calc
    _ = ∑ n ∈ Finset.Icc 1 ⌊x⌋₊, ∑ p ∈ hyperbolaPairs y,
        if p.1 ^ k ∣ n ∧ p.2 ^ k ∣ n + 1 then mobiusPairWeight p else 0 := by
      apply Finset.sum_congr rfl
      intro n hn
      exact short_inner_eq_hyperbola k hk n
        (by have h := (Finset.mem_Icc.mp hn).1; omega) y hy mobiusPairWeight
    _ = ∑ p ∈ hyperbolaPairs y, ∑ n ∈ Finset.Icc 1 ⌊x⌋₊,
        if p.1 ^ k ∣ n ∧ p.2 ^ k ∣ n + 1 then mobiusPairWeight p else 0 := by
      rw [Finset.sum_comm]
    _ = _ := by
      apply Finset.sum_congr rfl
      intro p hp
      calc
        _ = ∑ n ∈ Finset.Icc 1 ⌊x⌋₊, mobiusPairWeight p *
            (if p.1 ^ k ∣ n ∧ p.2 ^ k ∣ n + 1 then (1 : ℝ) else 0) := by
          apply Finset.sum_congr rfl
          intro n hn
          by_cases h : p.1 ^ k ∣ n ∧ p.2 ^ k ∣ n + 1 <;> simp [h]
        _ = mobiusPairWeight p *
            ∑ n ∈ Finset.Icc 1 ⌊x⌋₊,
              if p.1 ^ k ∣ n ∧ p.2 ^ k ∣ n + 1 then (1 : ℝ) else 0 := by
          rw [Finset.mul_sum]
        _ = _ := by
          congr 1
          exact_mod_cast (Finset.card_filter
            (fun n => p.1 ^ k ∣ n ∧ p.2 ^ k ∣ n + 1)
            (Finset.Icc 1 ⌊x⌋₊)).symm

include hk in
private theorem shortPairSum_finite_error
    (x y : ℝ) (hx : 0 ≤ x) (hy : 1 ≤ y) :
    |GenericKFreeCore.shortPairSum k x y -
      x * (∑ m ∈ Finset.Icc 1 ⌊y⌋₊, (densityCoeff k) m)| ≤
        ((hyperbolaPairs y).card : ℝ) := by
  have hmain :
      x * (∑ m ∈ Finset.Icc 1 ⌊y⌋₊, (densityCoeff k) m) =
        ∑ p ∈ hyperbolaPairs y, mobiusPairWeight p *
          (if p.1.Coprime p.2 then
            x / (((p.1 * p.2 : ℕ) : ℝ) ^ k) else 0) := by
    rw [← hyperbola_density_sum k, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro p hp
    by_cases hcop : p.1.Coprime p.2 <;> simp [hcop] <;> ring
  have herr :
      GenericKFreeCore.shortPairSum k x y -
        x * (∑ m ∈ Finset.Icc 1 ⌊y⌋₊, (densityCoeff k) m) =
      ∑ p ∈ hyperbolaPairs y, mobiusPairWeight p *
        ((((Finset.Icc 1 ⌊x⌋₊).filter
            (fun n => p.1 ^ k ∣ n ∧ p.2 ^ k ∣ n + 1)).card : ℝ) -
          (if p.1.Coprime p.2 then
            x / (((p.1 * p.2 : ℕ) : ℝ) ^ k) else 0)) := by
    rw [shortPairSum_hyperbola k hk x y hy, hmain, ← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro p hp
    ring
  rw [herr]
  calc
    _ ≤ ∑ p ∈ hyperbolaPairs y,
        |mobiusPairWeight p *
          ((((Finset.Icc 1 ⌊x⌋₊).filter
              (fun n => p.1 ^ k ∣ n ∧ p.2 ^ k ∣ n + 1)).card : ℝ) -
            (if p.1.Coprime p.2 then
              x / (((p.1 * p.2 : ℕ) : ℝ) ^ k) else 0))| :=
      Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _p ∈ hyperbolaPairs y, (1 : ℝ) := by
      apply Finset.sum_le_sum
      intro p hp
      have hpbox := (Finset.mem_filter.mp hp).1
      have hd : 0 < p.1 := by
        have h := (Finset.mem_Icc.mp (Finset.mem_product.mp hpbox).1).1
        omega
      have he : 0 < p.2 := by
        have h := (Finset.mem_Icc.mp (Finset.mem_product.mp hpbox).2).1
        omega
      have hc := kth_interval_discrepancy k hk
        x hx p.1 p.2 hd he
      rw [abs_mul]
      simpa using mul_le_mul (mobiusPairWeight_abs_le p) hc
        (abs_nonneg _) (by norm_num : (0 : ℝ) ≤ 1)
    _ = _ := by simp

private noncomputable def finiteDensityPart (y : ℝ) (n : ℕ) : ℝ :=
  if n ∈ Finset.Icc 1 ⌊y⌋₊ then (densityCoeff k) n else 0

include hk in
private theorem densityCoeff_tail_sum
    (δ : ℝ) (hδ : 0 < δ) (hδ1 : δ < 1) (y : ℝ) (hy : 1 ≤ y) :
    |(∑' n : ℕ, (densityCoeff k) n) -
        (∑ n ∈ Finset.Icc 1 ⌊y⌋₊, (densityCoeff k) n)| ≤
      (∑' n : ℕ, divisorMajorant δ n) / y ^ ((k : ℝ) - 1 - δ) := by
  have ha : Summable (fun n : ℕ => (densityCoeff k) n) :=
    (densityCoeff_norm_summable k hk).of_norm
  have hsmall : Summable (fun n : ℕ => (finiteDensityPart k) y n) := by
    refine (densityCoeff_norm_summable k hk).of_norm_bounded ?_
    intro n
    by_cases hn : n ∈ Finset.Icc 1 ⌊y⌋₊ <;>
      simp [finiteDensityPart, hn]
  have htail := ha.sub hsmall
  have htailnorm : Summable
      (fun n : ℕ => ‖(densityCoeff k) n - (finiteDensityPart k) y n‖) := by
    refine (densityCoeff_norm_summable k hk).of_norm_bounded ?_
    intro n
    by_cases hn : n ∈ Finset.Icc 1 ⌊y⌋₊ <;>
      simp [finiteDensityPart, hn]
  have hsmalltsum :
      (∑' n : ℕ, finiteDensityPart k y n) =
        ∑ n ∈ Finset.Icc 1 ⌊y⌋₊, (densityCoeff k) n := by
    calc
      _ = ∑ n ∈ Finset.Icc 1 ⌊y⌋₊, finiteDensityPart k y n :=
        tsum_eq_sum (fun n hn => by simp [finiteDensityPart, hn])
      _ = _ := by
        apply Finset.sum_congr rfl
        intro n hn
        simp [finiteDensityPart, hn]
  have htailtsum :
      (∑' n : ℕ, (densityCoeff k) n) -
          (∑ n ∈ Finset.Icc 1 ⌊y⌋₊, (densityCoeff k) n) =
        ∑' n : ℕ, ((densityCoeff k) n - (finiteDensityPart k) y n) := by
    rw [ha.tsum_sub hsmall, hsmalltsum]
  have hbound : ∀ n : ℕ,
      ‖(densityCoeff k) n - (finiteDensityPart k) y n‖ ≤
        divisorMajorant δ n / y ^ ((k : ℝ) - 1 - δ) := by
    intro n
    by_cases hn : n ∈ Finset.Icc 1 ⌊y⌋₊
    · simp only [finiteDensityPart, if_pos hn, sub_self, norm_zero]
      exact div_nonneg (divisorMajorant_nonneg δ n)
        (Real.rpow_nonneg (by linarith : 0 ≤ y) _)
    · by_cases hn0 : n = 0
      · subst n
        simp [densityCoeff, finiteDensityPart, divisorMajorant]
      · have hnpos : 0 < n := Nat.pos_of_ne_zero hn0
        have hnot : ¬ n ≤ ⌊y⌋₊ := by
          intro hN
          exact hn (Finset.mem_Icc.mpr ⟨by omega, hN⟩)
        have hyn : y < (n : ℝ) := lt_of_not_ge (fun h => hnot (Nat.le_floor h))
        simpa only [finiteDensityPart, if_neg hn, sub_zero] using
          densityCoeff_tail_pointwise k hk δ y hδ hδ1 hy n hyn
  have hmajor := (divisorMajorant_summable δ hδ).div_const (y ^ ((k : ℝ) - 1 - δ))
  calc
    _ = ‖∑' n : ℕ, ((densityCoeff k) n - (finiteDensityPart k) y n)‖ := by
      rw [htailtsum, Real.norm_eq_abs]
    _ ≤ ∑' n : ℕ, ‖(densityCoeff k) n - (finiteDensityPart k) y n‖ :=
      norm_tsum_le_tsum_norm htailnorm
    _ ≤ ∑' n : ℕ, divisorMajorant δ n / y ^ ((k : ℝ) - 1 - δ) :=
      by
        first
        | exact htailnorm.tsum_le_tsum hbound hmajor
        | exact Summable.tsum_le_tsum hbound htailnorm hmajor
    _ = _ := by rw [tsum_div_const]

include hk in
private theorem short_pair_root_local :
    ∀ ε : ℝ, 0 < ε → ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ, 2 ≤ x →
      |GenericKFreeCore.shortPairSum k x (x ^ ((1 : ℝ) / (k : ℝ))) -
        x * (∏' p : Nat.Primes, (1 - 2 / ((p : ℕ) : ℝ)^k))| ≤
          C * x ^ ((1 : ℝ) / (k : ℝ) + ε) := by
  intro ε hε
  let δ : ℝ := min ε ((1 : ℝ)/2)
  have hδ : 0 < δ := lt_min hε (by norm_num)
  have hδε : δ ≤ ε := min_le_left _ _
  have hδhalf : δ ≤ (1 : ℝ)/2 := min_le_right _ _
  have hδ1 : δ < 1 := by linarith
  have hkR : (2 : ℝ) ≤ (k : ℝ) := by exact_mod_cast hk
  have hkpos : 0 < (k : ℝ) := by linarith
  have hkone : (1 : ℝ) ≤ k := by linarith
  obtain ⟨C0, hC0, hP⟩ := hyperbola_subpower δ hδ
  let W : ℝ := ∑' n : ℕ, divisorMajorant δ n
  have hW : 0 ≤ W := tsum_nonneg (divisorMajorant_nonneg δ)
  refine ⟨C0 + W, add_nonneg hC0.le hW, ?_⟩
  intro x hx
  have hxpos : 0 < x := by linarith
  have hx0 : 0 ≤ x := hxpos.le
  have hx1 : 1 ≤ x := by linarith
  let y : ℝ := x ^ ((1 : ℝ)/(k : ℝ))
  have hy : 1 ≤ y := Real.one_le_rpow hx1 (one_div_nonneg.mpr hkpos.le)
  let A : ℝ := ∑ n ∈ Finset.Icc 1 ⌊y⌋₊, densityCoeff k n
  have herr :
      |GenericKFreeCore.shortPairSum k x y - x*A| ≤
        ((hyperbolaPairs y).card : ℝ) := by
    simpa only [A] using shortPairSum_finite_error k hk x y hx0 hy
  have htail :
      |(∑' n : ℕ, densityCoeff k n)-A| ≤
        W / y ^ ((k : ℝ)-1-δ) := by
    simpa only [A,W] using densityCoeff_tail_sum k hk δ hδ hδ1 y hy
  have hsmall := hP y hy
  have habsolute :
      |GenericKFreeCore.shortPairSum k x y -
        x*(∑' n : ℕ, densityCoeff k n)| ≤
        C0*y^(1+δ) + x*(W/y^((k : ℝ)-1-δ)) := by
    calc
      _ = |(GenericKFreeCore.shortPairSum k x y-x*A) +
            x*(A-(∑' n : ℕ, densityCoeff k n))| := by congr 1; ring
      _ ≤ |GenericKFreeCore.shortPairSum k x y-x*A| +
          |x*(A-(∑' n : ℕ, densityCoeff k n))| := abs_add_le _ _
      _ = |GenericKFreeCore.shortPairSum k x y-x*A| +
          x*|(∑' n : ℕ, densityCoeff k n)-A| := by
        rw [abs_mul,abs_of_nonneg hx0,abs_sub_comm A (∑' n : ℕ,densityCoeff k n)]
      _ ≤ _ := add_le_add (le_trans herr hsmall)
        (mul_le_mul_of_nonneg_left htail hx0)
  have hpowS : y^(1+δ) = x^((1+δ)/(k : ℝ)) := by
    dsimp [y]
    rw [← Real.rpow_mul hx0]
    congr 1
    ring
  have hpowT : x/y^((k : ℝ)-1-δ) = x^((1+δ)/(k : ℝ)) := by
    calc
      _ = x^(1 : ℝ) / x^(((1 : ℝ)/(k : ℝ))*((k : ℝ)-1-δ)) := by
        rw [Real.rpow_one]
        congr 1
        dsimp [y]
        rw [← Real.rpow_mul hx0]
      _ = x^(1-((1 : ℝ)/(k : ℝ))*((k : ℝ)-1-δ)) := by
