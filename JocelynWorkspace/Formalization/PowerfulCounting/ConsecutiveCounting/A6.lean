open MvPolynomial

private def p3U (G : Four) (i : Fin 4) : ℤ :=
  G.coeff (A6AlphaThreePrivate.quadIndex (i:ℕ) (3-(i:ℕ)) 1 0)
private def p3V (G : Four) (i : Fin 4) : ℤ :=
  -G.coeff (A6AlphaThreePrivate.quadIndex (i:ℕ) (3-(i:ℕ)) 0 1)
private def p3Form (A : Fin 4→ℤ) : MvPolynomial (Fin 2) ℚ :=
  ∑i : Fin 4, C (A i:ℚ)*X (0:Fin 2)^(i:ℕ)*X 1^(3-(i:ℕ))
private def p3Ev (A : Fin 4→ℤ) (d e : ℤ) : ℤ :=
  ∑i : Fin 4, A i*d^(i:ℕ)*e^(3-(i:ℕ))
private def p3Price (x D E : ℝ) (M : ℕ) : ℝ :=
  1+x^((1:ℝ)/3)/((M:ℝ)^((2:ℝ)/3)*(D*E)^((1:ℝ)/5))

private theorem p3_forms (G : Four) :
    map (Int.castRingHom ℚ) (A6AlphaThreePrivate.cubicP G)=p3Form (p3U G) ∧
    map (Int.castRingHom ℚ) (A6AlphaThreePrivate.cubicQ G)=p3Form (p3V G) := by
  constructor <;>
    simp [p3Form,p3U,p3V,A6AlphaThreePrivate.cubicP,A6AlphaThreePrivate.cubicQ,
      A6AlphaThreePrivate.binaryCubic,A6AlphaThreePrivate.binary_monomial,
      Fin.sum_univ_four] <;> ring

private theorem p3_evals (G : Four) (d e : ℤ) :
    eval ![d,e] (A6AlphaThreePrivate.cubicP G)=p3Ev (p3U G) d e ∧
    eval ![d,e] (A6AlphaThreePrivate.cubicQ G)=p3Ev (p3V G) d e := by
  constructor <;>
    simp [p3Ev,p3U,p3V,A6AlphaThreePrivate.cubicP,A6AlphaThreePrivate.cubicQ,
      A6AlphaThreePrivate.binaryCubic,A6AlphaThreePrivate.binary_monomial,
      Fin.sum_univ_four] <;> ring

private def p3Population (x D E M s₀ : ℝ) (P Q : Fin 4→ℤ) : Set (Fin 4→ℕ) :=
  {z | 0<z 0 ∧ 0<z 1 ∧ 0<z 2 ∧ 0<z 3 ∧
    (z 1:ℤ)^3*(z 3:ℤ)-(z 0:ℤ)^3*(z 2:ℤ)=1 ∧
    1≤(z 0:ℝ)^3*(z 2:ℝ) ∧ (z 0:ℝ)^3*(z 2:ℝ)≤x ∧
    D/2<(z 0:ℝ) ∧ (z 0:ℝ)≤D ∧ E/2<(z 1:ℝ) ∧ (z 1:ℝ)≤E ∧
    |(z 0:ℝ)/(z 1:ℝ)-s₀|≤2*D/(E*M) ∧
    (z 2:ℤ)*p3Ev Q (z 0) (z 1)=(z 3:ℤ)*p3Ev P (z 0) (z 1)}

private theorem actual_pure6_fixed_factor_count (h2628 : W847cHypP3)
    (K : ℝ) (hK : 0<K) (eps : ℝ) (heps : 0<eps) :
    ∃ Cp : ℝ, 0<Cp ∧
      ∀ x D E : ℝ, 2≤x → 0<D → 0<E →
        ∀ M : ℕ, 1≤M → x^((1:ℝ)/3)≤(M:ℝ) →
          ∀j∈A6WholeF8GridJoins.cells D E M,
            ∀G : Four, Bihom G 3 1 →
              Irreducible (map (Int.castRingHom ℂ) G) →
              (∀t : Fin 4→₀ℕ, |((G.coeff t:ℤ):ℝ)|≤x^K) →
              RationalPure (A6AlphaThreePrivate.cubicP G) (A6AlphaThreePrivate.cubicQ G) 6 →
              (componentCell x D E M j G).Finite ∧
                ((componentCell x D E M j G).ncard:ℝ)≤Cp*x^eps*p3Price x D E M := by
  classical
   
  obtain ⟨Cp,hCp,hcount⟩ :=
    h2628
      2 K 1 (by norm_num) hK (by norm_num) eps heps
  refine ⟨Cp,hCp,?_⟩
  intro x D E hx hD hE M hM hMthree j hj G hBi hGeom hheight hPure
  have hMfive : x^((1:ℝ)/5)≤(M:ℝ) :=
    (Real.rpow_le_rpow_of_exponent_le (by linarith : 1≤x)
      (by norm_num : (1:ℝ)/5≤(1:ℝ)/3)).trans hMthree
  obtain ⟨κ,a,b,hκ,hab,hRational⟩ := hPure
  let R := A6AlphaThreePrivate.sexticResidual G
  have hR : ∀r s : ℚ, eval ![r,s] (map (Int.castRingHom ℚ) R)=κ*(a*r+b*s)^6 := by
    intro r s
    simpa [R,A6AlphaThreePrivate.sexticResidual,map_sub,map_mul,map_pow,map_X]
      using hRational r s
  obtain ⟨A,B,c,hAB,hc,hInteger⟩ :=
    rational_pure_to_integral_primitive R 6 κ a b hκ hab hR
  have hGraph₀ : G=P7A.bO (A6AlphaThreePrivate.cubicP G) (A6AlphaThreePrivate.cubicQ G) := by
    simpa [P7A.bO,P7A.bN,A6AlphaThreePrivate.cubicGraph,A6AlphaThreePrivate.embedBinary]
      using (A6AlphaThreePrivate.canonical_cubic_data G hBi).1
  have hcop := P7A.bQ (A6AlphaThreePrivate.cubicP G) (A6AlphaThreePrivate.cubicQ G)
    (by rw [←hGraph₀]; exact hGeom)
  have hUF := (p3_forms G).1
  have hVF := (p3_forms G).2
  have hcopForms : ∀T : MvPolynomial (Fin 2) ℚ,
      T∣p3Form (p3V G) → T∣p3Form (p3U G) → IsUnit T := by
    intro T hV hU
    rw [←hVF] at hV
    rw [←hUF] at hU
    exact hcop hU hV
  have hpower : X (1:Fin 2)^3*p3Form (p3U G)-X (0:Fin 2)^3*p3Form (p3V G)=
      C (c:ℚ)*(C (A:ℚ)*X 0+C (B:ℚ)*X 1)^6 := by
    have hh := congrArg (map (Int.castRingHom ℚ)) hInteger
    rw [←hUF,←hVF]
    simpa [R,A6AlphaThreePrivate.sexticResidual,map_sub,map_mul,map_pow,map_add,map_C,map_X] using hh
  have hUheight : ∀i : Fin 4, |(p3U G i:ℝ)|≤x^K := fun i=>hheight _
  have hVheight : ∀i : Fin 4, |(p3V G i:ℝ)|≤x^K := by
    intro i
    simpa [p3V] using hheight (A6AlphaThreePrivate.quadIndex (i:ℕ) (3-(i:ℕ)) 0 1)
   
  have hT : (p3Population x D E (M:ℝ) (A6WholeF8GridJoins.rho D E M j) (p3V G) (p3U G)).Finite ∧
      ((p3Population x D E (M:ℝ) (A6WholeF8GridJoins.rho D E M j) (p3V G) (p3U G)).ncard:ℝ)≤
        Cp*x^eps*p3Price x D E M :=
    hcount x D E (M:ℝ) (A6WholeF8GridJoins.rho D E M j) hx hD hE
      (by simpa only [one_mul] using hMfive) (p3V G) (p3U G)
      hVheight hUheight hcopForms A B c hAB hc hpower
  have hmap : ∀z∈componentCell x D E M j G,
      toVector z∈p3Population x D E (M:ℝ) (A6WholeF8GridJoins.rho D E M j) (p3V G) (p3U G) := by
    intro z hz
    obtain ⟨hzcell,hzero⟩ := hz
    rcases hzcell with ⟨hd,he,hu,hv,hshift,hnlo,hnup,hDlo,hDup,hElo,hEup,hrlo,hrup⟩
    have hunit : (z.1.2:ℤ)^3*(z.2.2:ℤ)-(z.1.1:ℤ)^3*(z.2.1:ℤ)=1 := by
      have hh : (z.1.2:ℤ)^3*(z.2.2:ℤ)=(z.1.1:ℤ)^3*(z.2.1:ℤ)+1 := by exact_mod_cast hshift
      linarith
    have hn1 : 1≤(z.1.1:ℝ)^3*(z.2.1:ℝ) := by
      have hh : x/2<(z.1.1:ℝ)^3*(z.2.1:ℝ) := by
        simpa only [Nat.cast_mul,Nat.cast_pow] using hnlo
      linarith
    have hwidth := (ActualSourceGrid.main D E hD hE M hM).2 j
      ((A6WholeF8GridJoins.mem_cells_iff D E M j hD hE hM).mp hj)
      ((z.1.1:ℝ)/(z.1.2:ℝ)) ⟨hrlo,hrup⟩
    have hgraph := A6AlphaThreePrivate.canonical_cubic_graph_eval G hBi
      (z.1.1:ℤ) (z.1.2:ℤ) (z.2.1:ℤ) (z.2.2:ℤ) hzero
    change 0<z.1.1 ∧ 0<z.1.2 ∧ 0<z.2.1 ∧ 0<z.2.2 ∧ _
    refine ⟨by omega,by omega,by omega,by omega,hunit,hn1,?_,hDlo,hDup,hElo,hEup,hwidth,?_⟩
    · show (z.1.1:ℝ)^3*(z.2.1:ℝ)≤x
      simpa only [Nat.cast_mul,Nat.cast_pow] using hnup
    · show (z.2.1:ℤ)*p3Ev (p3U G) (z.1.1:ℤ) (z.1.2:ℤ)=(z.2.2:ℤ)*p3Ev (p3V G) (z.1.1:ℤ) (z.1.2:ℤ)
      rw [←(p3_evals G (z.1.1:ℤ) (z.1.2:ℤ)).1,
        ←(p3_evals G (z.1.1:ℤ) (z.1.2:ℤ)).2]
      simpa only [mul_comm] using hgraph
  have hfin := Set.Finite.of_injOn hmap toVector_injective.injOn hT.1
  have hn := Set.ncard_le_ncard_of_injOn toVector hmap toVector_injective.injOn hT.1
  exact ⟨hfin,(by exact_mod_cast hn :
    ((componentCell x D E M j G).ncard:ℝ)≤
      ((p3Population x D E (M:ℝ) (A6WholeF8GridJoins.rho D E M j) (p3V G) (p3U G)).ncard:ℝ)).trans hT.2⟩

