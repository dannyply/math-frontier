private theorem ca
 (p₀ p₁ p₂ p₃ p₄ q₀ q₁ q₂ q₃ q₄:I):
 bO (bW p₀ p₁ p₂ p₃ p₄)
 (bW (-q₀) (-q₁) (-q₂) (-q₃) (-q₄)) =
 monomial (qIndex 4 0 1 0) p₀+monomial (qIndex 3 1 1 0) p₁+
 monomial (qIndex 2 2 1 0) p₂+monomial (qIndex 1 3 1 0) p₃+
 monomial (qIndex 0 4 1 0) p₄+
 monomial (qIndex 4 0 0 1) q₀+monomial (qIndex 3 1 0 1) q₁+
 monomial (qIndex 2 2 0 1) q₂+monomial (qIndex 1 3 0 1) q₃+
 monomial (qIndex 0 4 0 1) q₄:=by
  simp only [bO,bN,bW,bU,bV,
    map_add,map_mul,map_pow,
    pow_zero,pow_one,mul_one,map_neg]
  norm_num
  ring
private theorem cb
 (G:aa)
 (hG:∀m ∈ G.support,m 0+m 1 = 4 ∧ m 2+m 3 = 1):
 ∃P Q:ab,
 G = bO P Q ∧ P.IsHomogeneous 4 ∧ Q.IsHomogeneous 4 ∧
 ∀H:O,0 ≤ H → (∀m:Fin 4 →₀ U,|((G.coeff m:I):O)| ≤ H) →
 (∀t:Fin 2 →₀ U,|((P.coeff t:I):O)| ≤ H ∧ |((Q.coeff t:I):O)| ≤ H):=by
  let P:= bW
    (G.coeff (qIndex 4 0 1 0)) (G.coeff (qIndex 3 1 1 0))
    (G.coeff (qIndex 2 2 1 0)) (G.coeff (qIndex 1 3 1 0)) (G.coeff (qIndex 0 4 1 0))
  let Q:= bW
    (-G.coeff (qIndex 4 0 0 1)) (-G.coeff (qIndex 3 1 0 1))
    (-G.coeff (qIndex 2 2 0 1)) (-G.coeff (qIndex 1 3 0 1)) (-G.coeff (qIndex 0 4 0 1))
  have heq:G = bO P Q:=by
    dsimp only [P,Q]
    rw [ca]
    ext m
    by_cases hm:m ∈ G.support
    · obtain ⟨hm₁,hm₂⟩:= hG m hm
      rcases bZ m hm₁ hm₂ with h|h|h|h|h|h|h|h|h|h <;>
        subst m <;> simp [av,bT]
    · have hz:G.coeff m = 0:=by
        by_contra hn
        exact hm (MvPolynomial.mem_support_iff.mpr hn)
      have hterm (i j k l:U):
          (if qIndex i j k l = m then G.coeff (qIndex i j k l) else 0) = 0:=by
        split_ifs with h
        · simpa only [h] using hz
        · rfl
      simp only [ba,av,hterm,hz,add_zero]
  refine ⟨P,Q,heq,bX _ _ _ _ _,
    bX _ _ _ _ _,?_⟩
  intro H hH bG t
  constructor
  · exact bY _ _ _ _ _ H hH
      (bG _) (bG _) (bG _) (bG _) (bG _) t
  · apply bY _ _ _ _ _ H hH
      (by simpa using bG _) (by simpa using bG _)
      (by simpa using bG _) (by simpa using bG _)
      (by simpa using bG _) t
private def cd {R:Type*} [CommRing R] (u v:R):
    MvPolynomial (Fin 4) R →+* MvPolynomial (Fin 2) R:=
  MvPolynomial.eval₂Hom ai ![X 0,X 1,C u,C v]
private theorem ce {R:Type*} [CommRing R]
 (u v:R) (P:MvPolynomial (Fin 2) R):
 cd u v (bN P) = P:=by
  have hvars:(fun i:Fin 2=>
      (![X 0,X 1,C u,C v]:Fin 4 → MvPolynomial (Fin 2) R)
        (if i = 0 then (0:Fin 4) else 1)) = X:=by
    funext i
    fin_cases i <;> simp
  change bx ai ![X 0,X 1,C u,C v]
    (aJ (fun i:Fin 2=>if i=0 then (0:Fin 4) else 1) P)=P
  rw [MvPolynomial.eval₂_rename]
  change bx ai
    (fun i:Fin 2=>(![X 0,X 1,C u,C v]:Fin 4→MvPolynomial (Fin 2) R)
      (if i=0 then (0:Fin 4) else 1)) P=P
  rw [hvars]
