        pow_le_pow_left₀ (Nat.cast_nonneg _) htau _
      _ =Cd^3*|(h:ℝ)|^(3*delta) := by
        rw [mul_pow]
        congr 1
        rw [←Real.rpow_natCast,←Real.rpow_mul (abs_nonneg _)]
        congr 1
        push_cast
        ring
  have hbase0 : 0<A*x^L := mul_pos hA0 (Real.rpow_pos_of_pos hx0 _)
  have hcost : |(h:ℝ)|^(3*delta)*Y^delta≤A^(4*delta)*x^epsilon := by
    calc
      |(h:ℝ)|^(3*delta)*Y^delta≤(A*x^L)^(3*delta)*(A*x^L)^delta :=
        mul_le_mul (Real.rpow_le_rpow (abs_nonneg _) hhbound (by positivity))
          (Real.rpow_le_rpow (by linarith : 0≤Y) hYbound hd.le)
          (Real.rpow_nonneg (by linarith : 0≤Y) _)
          (Real.rpow_nonneg hbase0.le _)
      _ =(A*x^L)^(4*delta) := by rw [←Real.rpow_add hbase0]; congr 1; ring
      _ =A^(4*delta)*x^(4*L*delta) := by
        rw [Real.mul_rpow hA0.le (Real.rpow_nonneg hx0.le _),←Real.rpow_mul hx0.le]
        congr 2
        ring
      _ ≤A^(4*delta)*x^epsilon :=
        mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_le hx1 hexp)
          (Real.rpow_nonneg hA0.le _)
  obtain ⟨T,hcover,hcard⟩ := all_norm_cover Delta h Z hDelta hh
  refine ⟨T,hcover,?_⟩
  calc
    (T.card:ℝ)≤16*(h.natAbs.divisors.card:ℝ)^3*(4*(Real.log K/Real.log 2)+2) := hcard
    _ ≤16*(Cd^3*|(h:ℝ)|^(3*delta))*((6+24/delta)*Y^delta) := by
      have hlognonneg : 0≤4*(Real.log K/Real.log 2)+2 := by
        have hklog : 0≤Real.log K := Real.log_nonneg hK1
        have h2log : 0<Real.log 2 := Real.log_pos (by norm_num)
        positivity
      exact mul_le_mul (mul_le_mul_of_nonneg_left htau3 (by norm_num))
        hlog hlognonneg (by positivity)
    _ =(16*Cd^3*(6+24/delta))*(|(h:ℝ)|^(3*delta)*Y^delta) := by ring
    _ ≤(16*Cd^3*(6+24/delta))*(A^(4*delta)*x^epsilon) :=
      mul_le_mul_of_nonneg_left hcost (by positivity)
    _ ≤C*x^epsilon := by
      dsimp [C]
      nlinarith only [Real.rpow_nonneg hx0.le epsilon]

private theorem positive_quadratic_level_count (J : ℝ) (hJ : 0≤J)
    (epsilon : ℝ) (hepsilon : 0<epsilon) :
    ∃C:ℝ,0<C ∧ ∀x:ℝ,2≤x → ∀A B C0 m:ℤ,
      A≠0 → m≠0 → 0<B^2-4*A*C0 →
      |(A:ℝ)|≤x^J → |(B:ℝ)|≤x^J → |(C0:ℝ)|≤x^J → |(m:ℝ)|≤x^J →
      let S : Set (ℤ×ℤ) := {z |
        |(z.1:ℝ)|≤x^J ∧ |(z.2:ℝ)|≤x^J ∧
          A*z.1^2+B*z.1*z.2+C0*z.2^2=m};
      S.Finite ∧ (S.ncard:ℝ)≤C*x^epsilon := by
  obtain ⟨Cn,hCn,hnormcount⟩ :=
    norm_cover_subpower 30 (4*J) (by norm_num) (by positivity) epsilon hepsilon
  refine ⟨Cn,hCn,?_⟩
  intro x hx A B C0 m hA hm hDisc hAb hBb hCb hmb
  let H : ℝ := x^J
  let Delta : ℤ := B^2-4*A*C0
  let D : ℕ := Delta.toNat
  let Z : ℕ := Nat.ceil (3*H^2)
  let N : ℤ := 4*A*m
  let S : Set (ℤ×ℤ) := {z |
    |(z.1:ℝ)|≤H ∧ |(z.2:ℝ)|≤H ∧ A*z.1^2+B*z.1*z.2+C0*z.2^2=m}
  let phi : ℤ×ℤ → ℤ×ℤ := fun z=>(2*A*z.1+B*z.2,z.2)
  change S.Finite ∧ (S.ncard:ℝ)≤Cn*x^epsilon
  have hx0 : 0<x := by linarith
  have hx1 : 1≤x := by linarith
  have hH : 1≤H := Real.one_le_rpow hx1 hJ
  have hH0 : 0≤H := by linarith
  have hHsq : 1≤H^2 := one_le_pow₀ hH
  have hDcast : (D:ℤ)=Delta := Int.toNat_of_nonneg hDisc.le
  have hD : 0<D := by
    have ht : (0:ℤ)<(D:ℤ) := by rw [hDcast]; exact hDisc
    exact_mod_cast ht
  have hN : N≠0 := mul_ne_zero (mul_ne_zero (by norm_num) hA) hm
  have hZlower : 3*H^2≤(Z:ℝ) := Nat.le_ceil _
  have hZupper : (Z:ℝ)≤4*H^2 := by
    have ht : (Z:ℝ)<3*H^2+1 := Nat.ceil_lt_add_one (by positivity)
    linarith
  have hZ1 : 1≤Z := by
    have ht : (1:ℝ)≤Z := by linarith
    exact_mod_cast ht
  have hAb' : |(A:ℝ)|≤H := hAb
  have hBb' : |(B:ℝ)|≤H := hBb
  have hCb' : |(C0:ℝ)|≤H := hCb
  have hmb' : |(m:ℝ)|≤H := hmb
  have hAC : |(A:ℝ)*(C0:ℝ)|≤H^2 := by
    rw [abs_mul,pow_two]
    exact mul_le_mul hAb' hCb' (abs_nonneg _) hH0
  have hBsq : (B:ℝ)^2≤H^2 := by
    rw [←sq_abs]
    exact pow_le_pow_left₀ (abs_nonneg _) hBb' 2
  have hDeltaBound : (Delta:ℝ)≤5*H^2 := by
    dsimp [Delta]
    push_cast
    have ht := neg_le_abs ((A:ℝ)*(C0:ℝ))
    nlinarith only [hBsq,hAC,ht]
  have hDupper : (((D+1:ℕ):ℝ))≤6*H^2 := by
    have ht : (D:ℝ)=(Delta:ℝ) := by exact_mod_cast hDcast
    push_cast
    rw [ht]
    linarith
  have hNbound : |(N:ℝ)|≤4*H^2 := by
    dsimp [N]
    push_cast
    rw [abs_mul,abs_mul,show |(4:ℝ)|=4 by norm_num]
    nlinarith only [mul_le_mul hAb' hmb' (abs_nonneg _) hH0]
  have hH4 : H^4=x^(4*J) := by
    dsimp [H]
    rw [←Real.rpow_natCast,←Real.rpow_mul hx0.le]
    congr 1
    push_cast
    ring
  have hNormBound : |(N:ℝ)|≤30*x^(4*J) := by
    rw [←hH4]
    have hh : H^2≤H^4 := pow_le_pow_right₀ hH (by norm_num : 2≤4)
    nlinarith only [hNbound,hh,hHsq]
  have hInputBound : (((D+1:ℕ):ℝ)*(Z:ℝ))≤30*x^(4*J) := by
    rw [←hH4]
    calc
      (((D+1:ℕ):ℝ)*(Z:ℝ))≤(6*H^2)*(4*H^2) :=
        mul_le_mul hDupper hZupper (Nat.cast_nonneg _) (by positivity)
      _ ≤30*H^4 := by nlinarith only [sq_nonneg (H^2)]
  obtain ⟨T,hTcover,hTcard⟩ := hnormcount x hx D hD N hN Z hZ1 hNormBound hInputBound
  have hinj : Function.Injective phi := by
    intro z z' hp
    have he : z.2=z'.2 := by
      have ht := congrArg (fun w : ℤ×ℤ => w.2) hp
      change z.2=z'.2 at ht
      exact ht
    have hd : 2*A*z.1=2*A*z'.1 := by
      have ht := congrArg Prod.fst hp
      change 2*A*z.1+B*z.2=2*A*z'.1+B*z'.2 at ht
      rw [he] at ht
      linear_combination ht
    exact Prod.ext (mul_left_cancel₀ (mul_ne_zero (by norm_num) hA) hd) he
  have hmap : ∀z∈S,phi z∈(↑T : Set (ℤ×ℤ)) := by
    intro z hz
    obtain ⟨hd,he,hq⟩ := hz
    have hYbound : |(z.2:ℝ)|≤(Z:ℝ) := by
      have ht : H≤H^2 := by simpa using pow_le_pow_right₀ hH (by norm_num : 1≤2)
      linarith
    have hXbound : |((2*A*z.1+B*z.2:ℤ):ℝ)|≤(Z:ℝ) := by
      have habs : |((2*A*z.1+B*z.2:ℤ):ℝ)|≤
          2*|(A:ℝ)| *|(z.1:ℝ)|+|(B:ℝ)| *|(z.2:ℝ)| := by
        push_cast
        calc
          |2*(A:ℝ)*(z.1:ℝ)+(B:ℝ)*(z.2:ℝ)|≤
              |2*(A:ℝ)*(z.1:ℝ)|+|(B:ℝ)*(z.2:ℝ)| := abs_add_le _ _
          _ =_ := by rw [abs_mul,abs_mul,abs_mul]; norm_num
      have hp1 := mul_le_mul hAb' hd (abs_nonneg _) hH0
      have hp2 := mul_le_mul hBb' he (abs_nonneg _) hH0
      nlinarith only [habs,hp1,hp2,hZlower]
    change (2*A*z.1+B*z.2,z.2)∈T
    apply hTcover
    · have ht : (((2*A*z.1+B*z.2).natAbs:ℕ):ℝ)≤Z := by
        rw [natAbs_real]
        exact hXbound
      exact_mod_cast ht
    · have ht : ((z.2.natAbs:ℕ):ℝ)≤Z := by rw [natAbs_real]; exact hYbound
      exact_mod_cast ht
    · rw [hDcast]
      dsimp [Delta,N]
      linear_combination 4*A*hq
  have himg : (phi '' S).Finite :=
    (Finset.finite_toSet T).subset (by rintro _ ⟨z,hz,rfl⟩; exact hmap z hz)
  have hfin : S.Finite := Set.Finite.of_finite_image himg hinj.injOn
  have hcard : S.ncard≤T.card := by
    calc
      S.ncard≤(↑T : Set (ℤ×ℤ)).ncard :=
        Set.ncard_le_ncard_of_injOn phi hmap hinj.injOn (Finset.finite_toSet T)
      _ =T.card := Set.ncard_coe_finset T
  refine ⟨hfin,?_⟩
  exact (show (S.ncard:ℝ)≤(T.card:ℝ) by exact_mod_cast hcard).trans hTcard

private theorem all_quadratic_level_count (J : ℝ) (hJ : 0 ≤ J)
    (epsilon : ℝ) (hepsilon : 0 < epsilon) :
    ∃ C : ℝ, 0 < C ∧ ∀ x : ℝ, 2 ≤ x → ∀ A B C0 m : ℤ,
      A ≠ 0 → m ≠ 0 → B^2-4*A*C0 ≠ 0 →
      |(A:ℝ)| ≤ x^J → |(B:ℝ)| ≤ x^J → |(C0:ℝ)| ≤ x^J → |(m:ℝ)| ≤ x^J →
      let S : Set (ℤ × ℤ) := {z |
        |(z.1:ℝ)| ≤ x^J ∧ |(z.2:ℝ)| ≤ x^J ∧
          A*z.1^2+B*z.1*z.2+C0*z.2^2=m}
      S.Finite ∧ (S.ncard:ℝ) ≤ C*x^epsilon := by
  obtain ⟨Cp,hCp,hpos⟩ := positive_quadratic_level_count J hJ epsilon hepsilon
  obtain ⟨Cn,hCn,hneg⟩ := negative_quadratic_level_count J hJ epsilon hepsilon
  refine ⟨Cp+Cn, by positivity, ?_⟩
  intro x hx A B C0 m hA hm hDisc hAb hBb hCb hmb
  have hx0 : 0 < x := by linarith
  rcases lt_trichotomy (B^2-4*A*C0) 0 with hlt | heq | hgt
  · obtain ⟨hfin,hcard⟩ := hneg x hx A B C0 m hA hm hlt hAb hBb hCb hmb
    refine ⟨hfin,hcard.trans ?_⟩
    exact mul_le_mul_of_nonneg_right (by linarith : Cn ≤ Cp+Cn)
      (Real.rpow_nonneg hx0.le _)
  · exact (hDisc heq).elim
  · obtain ⟨hfin,hcard⟩ := hpos x hx A B C0 m hA hm hgt hAb hBb hCb hmb
    refine ⟨hfin,hcard.trans ?_⟩
    exact mul_le_mul_of_nonneg_right (by linarith : Cp ≤ Cp+Cn)
      (Real.rpow_nonneg hx0.le _)

private theorem all_quadratic_divisor_pair_cover (J : ℝ) (hJ : 0≤J)
    (epsilon : ℝ) (hepsilon : 0<epsilon) :
    ∃C:ℝ,0<C ∧ ∀x:ℝ,2≤x → ∀A B C0 R0:ℤ,
      A≠0 → R0≠0 → B^2-4*A*C0≠0 →
      |(A:ℝ)|≤x^J → |(B:ℝ)|≤x^J → |(C0:ℝ)|≤x^J → |(R0:ℝ)|≤x^J →
      ∃T:Finset (ℤ×ℤ),
        (∀r s:ℤ,|(r:ℝ)|≤x^J → |(s:ℝ)|≤x^J →
          A*r^2+B*r*s+C0*s^2≠0 → A*r^2+B*r*s+C0*s^2∣R0 →
          (r,s)∈T) ∧ (T.card:ℝ)≤C*x^epsilon := by
  classical
  have heps : 0<epsilon/2 := by positivity
  obtain ⟨Cq,hCq,hquad⟩ := all_quadratic_level_count J hJ (epsilon/2) heps
  obtain ⟨Cf,hCf,hfee⟩ := divisor_fee J hJ (epsilon/2) heps
  refine ⟨2*Cf*Cq,by positivity,?_⟩
  intro x hx A B C0 R0 hA hR0 hDisc hAb hBb hCb hRb
  have hx0 : 0<x := by linarith
  have hx1 : 1≤x := by linarith
  let I := (signedDivisors R0).filter (fun m=>m≠0 ∧ m∣R0)
  let E := {m:ℤ // m∈I}
  have hfamily : ∀m:E,∃F:Finset (ℤ×ℤ),
      (∀r s:ℤ,|(r:ℝ)|≤x^J → |(s:ℝ)|≤x^J →
        A*r^2+B*r*s+C0*s^2=m.val → (r,s)∈F) ∧
      (F.card:ℝ)≤Cq*x^(epsilon/2) := by
    intro m
    have hprops := (Finset.mem_filter.mp m.property).2
    have hnat : m.val.natAbs∣R0.natAbs :=
      Int.natCast_dvd.mp (Int.natAbs_dvd.mpr hprops.2)
    have hmNat : m.val.natAbs≤R0.natAbs :=
      Nat.le_of_dvd (Int.natAbs_pos.mpr hR0) hnat
    have hmAbs : |(m.val:ℝ)|≤|(R0:ℝ)| := by
      rw [←natAbs_real m.val,←natAbs_real R0]
      exact_mod_cast hmNat
    obtain ⟨hfin,hcard⟩ :=
      hquad x hx A B C0 m.val hA hprops.1 hDisc hAb hBb hCb (hmAbs.trans hRb)
    refine ⟨hfin.toFinset,?_,?_⟩
    · intro r s hr hs heq
      exact hfin.mem_toFinset.mpr ⟨hr,hs,heq⟩
    · have hSet : (↑hfin.toFinset:Set (ℤ×ℤ))=
          {z | |(z.1:ℝ)|≤x^J ∧ |(z.2:ℝ)|≤x^J ∧
            A*z.1^2+B*z.1*z.2+C0*z.2^2=m.val} := by
        ext z
        exact hfin.mem_toFinset
      have hcardEq : hfin.toFinset.card=
          {z:ℤ×ℤ | |(z.1:ℝ)|≤x^J ∧ |(z.2:ℝ)|≤x^J ∧
            A*z.1^2+B*z.1*z.2+C0*z.2^2=m.val}.ncard := by
        calc
          hfin.toFinset.card=(↑hfin.toFinset:Set (ℤ×ℤ)).ncard :=
            (Set.ncard_coe_finset hfin.toFinset).symm
          _ =_ := congrArg Set.ncard hSet
      simpa only [hcardEq] using hcard
  choose F hFcover hFcard using hfamily
  let phi : Sigma (fun _ : E => ℤ×ℤ) → ℤ×ℤ := fun z=>z.2
  let T := ((Finset.univ:Finset E).sigma F).image phi
  refine ⟨T,?_,?_⟩
  · intro r s hr hs hq0 hqd
    let m : ℤ := A*r^2+B*r*s+C0*s^2
    have hm : m∈I := Finset.mem_filter.mpr
      ⟨mem_signedDivisors R0 m hR0 hqd,hq0,hqd⟩
    let j : E := ⟨m,hm⟩
    have hj : (r,s)∈F j := hFcover j r s hr hs rfl
    exact Finset.mem_image.mpr
      ⟨⟨j,(r,s)⟩,Finset.mem_sigma.mpr ⟨Finset.mem_univ _,hj⟩,rfl⟩
  · have hI : I.card≤2*R0.natAbs.divisors.card :=
      (Finset.card_filter_le _ _).trans (signedDivisors_card R0)
    have hE : (Fintype.card E:ℝ)≤2*(R0.natAbs.divisors.card:ℝ) := by
      rw [Fintype.card_coe I]
      exact_mod_cast hI
    have hcardN : T.card≤∑j:E,(F j).card := by
      calc
        T.card≤((Finset.univ:Finset E).sigma F).card := Finset.card_image_le
        _ =∑j:E,(F j).card := Finset.card_sigma _ _
    have hcardR : (T.card:ℝ)≤∑j:E,((F j).card:ℝ) := by exact_mod_cast hcardN
    have hRcap : |(R0:ℝ)|≤1625702400*x^(16*J) := by
      have hp : x^J≤x^(16*J) :=
        Real.rpow_le_rpow_of_exponent_le hx1 (by nlinarith)
      have hn := Real.rpow_nonneg hx0.le (16*J)
      nlinarith only [hRb,hp,hn]
    have htau1N : 1≤R0.natAbs.divisors.card := by
      have hm : 1∈R0.natAbs.divisors :=
        Nat.mem_divisors.mpr ⟨one_dvd _,Int.natAbs_ne_zero.mpr hR0⟩
      exact Finset.card_pos.mpr ⟨1,hm⟩
    have htau1 : (1:ℝ)≤(R0.natAbs.divisors.card:ℝ) := by exact_mod_cast htau1N
    have htauPow : (R0.natAbs.divisors.card:ℝ)≤(R0.natAbs.divisors.card:ℝ)^8 := by
      simpa only [pow_one] using pow_le_pow_right₀ htau1 (by norm_num : 1≤8)
    have htauFee : (R0.natAbs.divisors.card:ℝ)≤Cf*x^(epsilon/2) := by
      have hpaid := hfee x hx R0 hR0 hRcap
      have hn := pow_nonneg (Nat.cast_nonneg R0.natAbs.divisors.card : (0:ℝ)≤_) 8
      nlinarith only [htauPow,hpaid,hn]
    calc
      (T.card:ℝ)≤∑j:E,((F j).card:ℝ) := hcardR
      _ ≤∑_j:E,Cq*x^(epsilon/2) :=
        Finset.sum_le_sum (fun j _=>hFcard j)
      _ =(Fintype.card E:ℝ)*(Cq*x^(epsilon/2)) := by simp
      _ ≤(2*(R0.natAbs.divisors.card:ℝ))*(Cq*x^(epsilon/2)) :=
        mul_le_mul_of_nonneg_right hE (by positivity)
      _ ≤(2*(Cf*x^(epsilon/2)))*(Cq*x^(epsilon/2)) :=
        mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_left htauFee (by norm_num)) (by positivity)
      _ =(2*Cf*Cq)*(x^(epsilon/2)*x^(epsilon/2)) := by ring
      _ =(2*Cf*Cq)*x^epsilon := by
        rw [←Real.rpow_add hx0]
        congr 2
        ring

private def embedBinary {R:Type*} [CommRing R]:
    MvPolynomial (Fin 2) R →+* MvPolynomial (Fin 4) R:=
  (MvPolynomial.rename (fun i:Fin 2 => if i = 0 then (0:Fin 4) else 1)).toRingHom
private def cubicGraph {R:Type*} [CommRing R]
    (P Q:MvPolynomial (Fin 2) R):MvPolynomial (Fin 4) R:=
  embedBinary P * X 2 - embedBinary Q * X 3
private theorem graph_isRelPrime
 {K:Type*} [Field K] (P Q:MvPolynomial (Fin 2) K)
 (hG:Irreducible (cubicGraph P Q)):IsRelPrime P Q:=by
  intro D hDP hDQ
  obtain ⟨iU,hU⟩:= hDP
  obtain ⟨V,hV⟩:= hDQ
  have hfac:cubicGraph P Q =
      embedBinary D * (embedBinary iU * X 2 - embedBinary V * X 3):=by
    dsimp only [cubicGraph]
    rw [hU,hV,map_mul,map_mul]
    ring
  rcases hG.isUnit_or_isUnit hfac with hD | hUV
  · let r:Fin 4 → Fin 2:= fun i => if i = 0 then 0 else 1
    have hret:(fun i:Fin 2 =>
        r (if i = 0 then (0:Fin 4) else 1)) = id:=by
      funext i
      fin_cases i <;> simp [r]
    have hD':= hD.map (MvPolynomial.rename r)
    change IsUnit (MvPolynomial.rename r
      (MvPolynomial.rename (fun i:Fin 2=>if i=0 then (0:Fin 4) else 1) D)) at hD'
    rw [MvPolynomial.rename_rename] at hD'
    change IsUnit (MvPolynomial.rename
      (fun i:Fin 2=>r (if i=0 then (0:Fin 4) else 1)) D) at hD'
    simpa [hret,MvPolynomial.rename_id] using hD'
  · let ev:MvPolynomial (Fin 4) K →+* K:=
      MvPolynomial.eval₂Hom (RingHom.id K) (fun _ => 0)
    have hz:IsUnit (0:K):=by
      simpa [ev] using hUV.map ev
    exact False.elim (hz.ne_zero rfl)
private def biIndex (i j:ℕ):Fin 2 →₀ ℕ:=
  Finsupp.single 0 i+Finsupp.single 1 j
private def quadIndex (i j k l:ℕ):Fin 4 →₀ ℕ:=
  Finsupp.single 0 i+Finsupp.single 1 j+Finsupp.single 2 k+Finsupp.single 3 l
private theorem biIndex_injective (i j i' j':ℕ):
 biIndex i j = biIndex i' j' ↔ i = i' ∧ j = j':=by
  constructor
  · intro h
    have h₀:= congrArg (fun m:Fin 2 →₀ ℕ=>m 0) h
    have h₁:= congrArg (fun m:Fin 2 →₀ ℕ=>m 1) h
    simpa [biIndex] using And.intro h₀ h₁
  · rintro ⟨rfl,rfl⟩
    rfl
private theorem quadIndex_injective (i j k l i' j' k' l':ℕ):
 quadIndex i j k l = quadIndex i' j' k' l' ↔
 i = i' ∧ j = j' ∧ k = k' ∧ l = l':=by
  constructor
  · intro h
    have h₀:= congrArg (fun m:Fin 4 →₀ ℕ=>m 0) h
    have h₁:= congrArg (fun m:Fin 4 →₀ ℕ=>m 1) h
    have h₂:= congrArg (fun m:Fin 4 →₀ ℕ=>m 2) h
    have h₃:= congrArg (fun m:Fin 4 →₀ ℕ=>m 3) h
    simpa [quadIndex] using And.intro h₀ (And.intro h₁ (And.intro h₂ h₃))
  · rintro ⟨rfl,rfl,rfl,rfl⟩
    rfl
private theorem binary_monomial {R:Type*} [CommRing R]
 (r:R) (i j:ℕ):
 monomial (biIndex i j) r = C r*(X (0:Fin 2))^i*(X 1)^j:=by
  calc
    _ = monomial (Finsupp.single (0:Fin 2) i) r *
        monomial (Finsupp.single (1:Fin 2) j) (1:R):=by
      rw [MvPolynomial.monomial_mul]
      simp [biIndex]
    _ = _:=by
      rw [←MvPolynomial.C_mul_X_pow_eq_monomial,←MvPolynomial.C_mul_X_pow_eq_monomial]
      simp [mul_assoc]
private theorem quad_monomial {R:Type*} [CommRing R]
 (r:R) (i j k l:ℕ):
 monomial (quadIndex i j k l) r =
 C r*(X (0:Fin 4))^i*(X 1)^j*(X 2)^k*(X 3)^l:=by
  calc
    _ = monomial (Finsupp.single (0:Fin 4) i) r *
        monomial (Finsupp.single (1:Fin 4) j) (1:R) *
        monomial (Finsupp.single (2:Fin 4) k) (1:R) *
        monomial (Finsupp.single (3:Fin 4) l) (1:R):=by
      rw [MvPolynomial.monomial_mul,MvPolynomial.monomial_mul,MvPolynomial.monomial_mul]
      simp [quadIndex]
    _ = _:=by
      rw [←MvPolynomial.C_mul_X_pow_eq_monomial,←MvPolynomial.C_mul_X_pow_eq_monomial,
        ←MvPolynomial.C_mul_X_pow_eq_monomial,←MvPolynomial.C_mul_X_pow_eq_monomial]
      simp [mul_assoc]

private def binaryCubic {R:Type*} [CommRing R] (p₀ p₁ p₂ p₃:R):
    MvPolynomial (Fin 2) R :=
  monomial (biIndex 3 0) p₀ + monomial (biIndex 2 1) p₁ +
    monomial (biIndex 1 2) p₂ + monomial (biIndex 0 3) p₃

private theorem cubic_homogeneous {R:Type*} [CommRing R] (p₀ p₁ p₂ p₃:R):
    (binaryCubic p₀ p₁ p₂ p₃).IsHomogeneous 3 := by
  have hx₀:(X (0:Fin 2):MvPolynomial (Fin 2) R).IsHomogeneous 1 :=
    MvPolynomial.isHomogeneous_X R _
  have hx₁:(X (1:Fin 2):MvPolynomial (Fin 2) R).IsHomogeneous 1 :=
    MvPolynomial.isHomogeneous_X R _
  have hc (r:R):(C r:MvPolynomial (Fin 2) R).IsHomogeneous 0 :=
    MvPolynomial.isHomogeneous_C (Fin 2) r
  have h₀:(C p₀*(X (0:Fin 2))^3:MvPolynomial (Fin 2) R).IsHomogeneous 3 := by
    simpa using (hc p₀).mul (hx₀.pow 3)
  have h₁:(C p₁*(X (0:Fin 2))^2*X 1:MvPolynomial (Fin 2) R).IsHomogeneous 3 := by
    simpa using ((hc p₁).mul (hx₀.pow 2)).mul hx₁
  have h₂:(C p₂*X (0:Fin 2)*(X 1)^2:MvPolynomial (Fin 2) R).IsHomogeneous 3 := by
    simpa using ((hc p₂).mul hx₀).mul (hx₁.pow 2)
  have h₃:(C p₃*(X (1:Fin 2))^3:MvPolynomial (Fin 2) R).IsHomogeneous 3 := by
    simpa using (hc p₃).mul (hx₁.pow 3)
  simpa only [binaryCubic,binary_monomial,pow_zero,pow_one,mul_one] using
    ((h₀.add h₁).add h₂).add h₃

private theorem cubic_coeff_bound (p₀ p₁ p₂ p₃:ℤ) (H:ℝ)
    (hH:0≤H) (h₀:|(p₀:ℝ)|≤H) (h₁:|(p₁:ℝ)|≤H)
    (h₂:|(p₂:ℝ)|≤H) (h₃:|(p₃:ℝ)|≤H):
    ∀t:Fin 2→₀ℕ, |(((binaryCubic p₀ p₁ p₂ p₃).coeff t:ℤ):ℝ)|≤H := by
  intro t
  by_cases h0:biIndex 3 0=t
  · subst t
    simpa [binaryCubic,MvPolynomial.coeff_monomial,biIndex_injective] using h₀
  by_cases h1:biIndex 2 1=t
  · subst t
    simpa [binaryCubic,MvPolynomial.coeff_monomial,biIndex_injective] using h₁
  by_cases h2:biIndex 1 2=t
  · subst t
    simpa [binaryCubic,MvPolynomial.coeff_monomial,biIndex_injective] using h₂
  by_cases h3:biIndex 0 3=t
  · subst t
    simpa [binaryCubic,MvPolynomial.coeff_monomial,biIndex_injective] using h₃
  simpa [binaryCubic,MvPolynomial.coeff_monomial,h0,h1,h2,h3] using hH

private theorem cubic_support_eight (m:Fin 4→₀ℕ)
    (hm:m 0+m 1=3) (hm':m 2+m 3=1):
    m=quadIndex 3 0 1 0 ∨ m=quadIndex 2 1 1 0 ∨ m=quadIndex 1 2 1 0 ∨
    m=quadIndex 0 3 1 0 ∨ m=quadIndex 3 0 0 1 ∨ m=quadIndex 2 1 0 1 ∨
    m=quadIndex 1 2 0 1 ∨ m=quadIndex 0 3 0 1 := by
  have hext (i j k l:ℕ) (h0:m 0=i) (h1:m 1=j) (h2:m 2=k) (h3:m 3=l):
      m=quadIndex i j k l := by
    ext r
    fin_cases r <;> simp [quadIndex,h0,h1,h2,h3]
  have h0:m 0=0 ∨ m 0=1 ∨ m 0=2 ∨ m 0=3 := by omega
  have h2:m 2=0 ∨ m 2=1 := by omega
  rcases h2 with h2|h2
  · rcases h0 with h0|h0|h0|h0
    · have h1:m 1=3 := by omega
      have h3:m 3=1 := by omega
      exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (hext 0 3 0 1 h0 h1 h2 h3)))))))
    · have h1:m 1=2 := by omega
      have h3:m 3=1 := by omega
      exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl (hext 1 2 0 1 h0 h1 h2 h3)))))))
    · have h1:m 1=1 := by omega
      have h3:m 3=1 := by omega
      exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl (hext 2 1 0 1 h0 h1 h2 h3))))))
    · have h1:m 1=0 := by omega
      have h3:m 3=1 := by omega
      exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl (hext 3 0 0 1 h0 h1 h2 h3)))))
  · rcases h0 with h0|h0|h0|h0
    · have h1:m 1=3 := by omega
      have h3:m 3=0 := by omega
      exact Or.inr (Or.inr (Or.inr (Or.inl (hext 0 3 1 0 h0 h1 h2 h3))))
    · have h1:m 1=2 := by omega
      have h3:m 3=0 := by omega
      exact Or.inr (Or.inr (Or.inl (hext 1 2 1 0 h0 h1 h2 h3)))
    · have h1:m 1=1 := by omega
      have h3:m 3=0 := by omega
      exact Or.inr (Or.inl (hext 2 1 1 0 h0 h1 h2 h3))
    · have h1:m 1=0 := by omega
      have h3:m 3=0 := by omega
      exact Or.inl (hext 3 0 1 0 h0 h1 h2 h3)

private theorem cubic_graph_expand (p₀ p₁ p₂ p₃ q₀ q₁ q₂ q₃:ℤ):
    cubicGraph (binaryCubic p₀ p₁ p₂ p₃) (binaryCubic (-q₀) (-q₁) (-q₂) (-q₃)) =
    monomial (quadIndex 3 0 1 0) p₀ + monomial (quadIndex 2 1 1 0) p₁ +
    monomial (quadIndex 1 2 1 0) p₂ + monomial (quadIndex 0 3 1 0) p₃ +
    monomial (quadIndex 3 0 0 1) q₀ + monomial (quadIndex 2 1 0 1) q₁ +
    monomial (quadIndex 1 2 0 1) q₂ + monomial (quadIndex 0 3 0 1) q₃ := by
  simp only [cubicGraph,embedBinary,binaryCubic,binary_monomial,quad_monomial,map_add,map_mul,map_pow,
    pow_zero,pow_one,mul_one,map_neg]
  norm_num
  ring

private def cubicP (G : MvPolynomial (Fin 4) ℤ) : MvPolynomial (Fin 2) ℤ :=
  binaryCubic (G.coeff (quadIndex 3 0 1 0)) (G.coeff (quadIndex 2 1 1 0))
    (G.coeff (quadIndex 1 2 1 0)) (G.coeff (quadIndex 0 3 1 0))

private def cubicQ (G : MvPolynomial (Fin 4) ℤ) : MvPolynomial (Fin 2) ℤ :=
  binaryCubic (-G.coeff (quadIndex 3 0 0 1)) (-G.coeff (quadIndex 2 1 0 1))
    (-G.coeff (quadIndex 1 2 0 1)) (-G.coeff (quadIndex 0 3 0 1))

private theorem canonical_cubic_data (G : MvPolynomial (Fin 4) ℤ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = 3 ∧ m 2 + m 3 = 1) :
    G = cubicGraph (cubicP G) (cubicQ G) ∧
    (cubicP G).IsHomogeneous 3 ∧ (cubicQ G).IsHomogeneous 3 ∧
    ∀ H : ℝ, 0 ≤ H →
      (∀ m : Fin 4 →₀ ℕ, |((G.coeff m : ℤ) : ℝ)| ≤ H) →
      ∀ t : Fin 2 →₀ ℕ, |(((cubicP G).coeff t : ℤ) : ℝ)| ≤ H ∧
        |(((cubicQ G).coeff t : ℤ) : ℝ)| ≤ H := by
  have heq : G = cubicGraph (cubicP G) (cubicQ G) := by
    dsimp only [cubicP, cubicQ]
    rw [cubic_graph_expand]
    ext m
    by_cases hm : m ∈ G.support
    · obtain ⟨hm₁, hm₂⟩ := hG m hm
      rcases cubic_support_eight m hm₁ hm₂ with h | h | h | h | h | h | h | h <;>
        subst m <;> simp [MvPolynomial.coeff_monomial, quadIndex_injective]
    · have hz : G.coeff m = 0 := by
        by_contra hn
        exact hm (MvPolynomial.mem_support_iff.mpr hn)
      have hterm (i j k l : ℕ) :
          (if quadIndex i j k l = m then G.coeff (quadIndex i j k l) else 0) = 0 := by
        split_ifs with h
        · simpa only [h] using hz
        · rfl
      simp only [MvPolynomial.coeff_add, MvPolynomial.coeff_monomial, hterm, hz, add_zero]
  refine ⟨heq, cubic_homogeneous _ _ _ _, cubic_homogeneous _ _ _ _, ?_⟩
  intro H hH hh t
  constructor
  · exact cubic_coeff_bound _ _ _ _ H hH (hh _) (hh _) (hh _) (hh _) t
  · apply cubic_coeff_bound _ _ _ _ H hH
    · simpa using hh (quadIndex 3 0 0 1)
    · simpa using hh (quadIndex 2 1 0 1)
    · simpa using hh (quadIndex 1 2 0 1)
    · simpa using hh (quadIndex 0 3 0 1)

private theorem canonical_cubic_complex_relPrime
    (G : MvPolynomial (Fin 4) ℤ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = 3 ∧ m 2 + m 3 = 1)
    (hirred : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G)) :
    IsRelPrime (MvPolynomial.map (Int.castRingHom ℂ) (cubicP G))
      (MvPolynomial.map (Int.castRingHom ℂ) (cubicQ G)) := by
  have heq := (canonical_cubic_data G hG).1
  apply graph_isRelPrime
  have hmap : MvPolynomial.map (Int.castRingHom ℂ)
      (cubicGraph (cubicP G) (cubicQ G)) =
      cubicGraph (MvPolynomial.map (Int.castRingHom ℂ) (cubicP G))
        (MvPolynomial.map (Int.castRingHom ℂ) (cubicQ G)) := by
    simp [cubicGraph, embedBinary, MvPolynomial.map_rename]
  rw [← hmap, ← heq]
  exact hirred

private theorem canonical_cubic_no_common
    (G : MvPolynomial (Fin 4) ℤ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = 3 ∧ m 2 + m 3 = 1)
    (hirred : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G)) :
    ∀ w : Fin 2 → ℂ, w ≠ 0 →
      eval w (MvPolynomial.map (Int.castRingHom ℂ) (cubicP G)) = 0 →
      eval w (MvPolynomial.map (Int.castRingHom ℂ) (cubicQ G)) = 0 → False := by
  obtain ⟨heq, hP, hQ, hheight⟩ := canonical_cubic_data G hG
  intro w hw hp hq
  exact C01.PcCurves.no_common_zero
    (hP.map (Int.castRingHom ℂ)) (hQ.map (Int.castRingHom ℂ))
    (canonical_cubic_complex_relPrime G hG hirred) hw hp hq

private theorem canonical_cubic_graph_eval (G : MvPolynomial (Fin 4) ℤ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = 3 ∧ m 2 + m 3 = 1)
    (d e u v : ℤ) (hz : eval ![d, e, u, v] G = 0) :
    eval ![d, e] (cubicP G) * u = eval ![d, e] (cubicQ G) * v := by
  rw [(canonical_cubic_data G hG).1] at hz
  have hemb (T : MvPolynomial (Fin 2) ℤ) :
      eval ![d, e, u, v] (embedBinary T) = eval ![d, e] T := by
    have hvars : (![d, e, u, v] ∘
        (fun i : Fin 2 => if i = 0 then (0 : Fin 4) else 1)) = ![d, e] := by
      funext i
      fin_cases i <;> rfl
    rw [show embedBinary T =
      MvPolynomial.rename (fun i : Fin 2 => if i = 0 then (0 : Fin 4) else 1) T from rfl,
      MvPolynomial.eval_rename, hvars]
  simp only [cubicGraph, map_sub, map_mul, MvPolynomial.eval_X, hemb] at hz
  change eval ![d, e] (cubicP G) * u - eval ![d, e] (cubicQ G) * v = 0 at hz
  linear_combination hz

private def sexticResidual (G : MvPolynomial (Fin 4) ℤ) : MvPolynomial (Fin 2) ℤ :=
  X 1 ^ 3 * cubicP G - X 0 ^ 3 * cubicQ G

private def canonicalResidual (G : MvPolynomial (Fin 4) ℤ) (r s : ℚ) : ℚ :=
  s ^ 3 * (∑ i : Fin 4,
    ((G.coeff (quadIndex (i : ℕ) (3 - (i : ℕ)) 1 0) : ℤ) : ℚ) *
      r ^ (i : ℕ) * s ^ (3 - (i : ℕ))) +
  r ^ 3 * (∑ i : Fin 4,
    ((G.coeff (quadIndex (i : ℕ) (3 - (i : ℕ)) 0 1) : ℤ) : ℚ) *
      r ^ (i : ℕ) * s ^ (3 - (i : ℕ)))

private lemma canonical_residual_eval (G : MvPolynomial (Fin 4) ℤ) (r s : ℚ) :
    eval ![r, s] (MvPolynomial.map (Int.castRingHom ℚ) (sexticResidual G)) =
      canonicalResidual G r s := by
  simp [sexticResidual, canonicalResidual, cubicP, cubicQ, binaryCubic,
    binary_monomial, Fin.sum_univ_succ]
  ring

private theorem canonical_residual_homogeneous (G : MvPolynomial (Fin 4) ℤ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = 3 ∧ m 2 + m 3 = 1) :
    (sexticResidual G).IsHomogeneous 6 := by
  obtain ⟨_, hP, hQ, _⟩ := canonical_cubic_data G hG
  exact (((MvPolynomial.isHomogeneous_X ℤ (1 : Fin 2)).pow 3).mul hP).sub
    (((MvPolynomial.isHomogeneous_X ℤ (0 : Fin 2)).pow 3).mul hQ)

private theorem canonical_residual_ne_zero (G : MvPolynomial (Fin 4) ℤ)
    (hres : ∃ r s : ℚ, canonicalResidual G r s ≠ 0) : sexticResidual G ≠ 0 := by
  intro hz
  obtain ⟨r, s, hrs⟩ := hres
  apply hrs
  rw [← canonical_residual_eval G r s, hz, map_zero, map_zero]

private theorem cubic_cube_scalar_edges
    (p0 p1 p2 p3 q0 q1 q2 q3 c A B C0 : ℚ)
    (heq : ∀ r s : ℚ,
      s ^ 3 * (p0*r^3+p1*r^2*s+p2*r*s^2+p3*s^3) -
        r ^ 3 * (q0*r^3+q1*r^2*s+q2*r*s^2+q3*s^3) =
          c * (A*r^2+B*r*s+C0*s^2) ^ 3) :
    q0 = -c*A^3 ∧ q1 = -3*c*A^2*B ∧ p3 = c*C0^3 := by
  have hinf := heq 1 0
  have hzero := heq 0 1
  have h1 := heq 1 1
  have hm1 := heq 1 (-1)
  have h2 := heq 1 2
  have hm2 := heq 1 (-2)
  have h3 := heq 1 3
  have hm3 := heq 1 (-3)
  refine ⟨?_, ?_, ?_⟩
  · linear_combination -hinf
  · linear_combination (-3/4:ℚ)*h1 + (3/4:ℚ)*hm1 +
      (3/20:ℚ)*h2 - (3/20:ℚ)*hm2 -
      (1/60:ℚ)*h3 + (1/60:ℚ)*hm3
  · simpa using hzero

private theorem cubic_cube_direct_height
    (c A B C0 : ℤ) (hc : c ≠ 0) (hA : A ≠ 0)
    (H : ℝ) (hH : 1 ≤ H)
    (hleft : |((c*A^3 : ℤ) : ℝ)| ≤ H)
    (hmiddle : |((3*c*A^2*B : ℤ) : ℝ)| ≤ H)
    (hright : |((c*C0^3 : ℤ) : ℝ)| ≤ H) :
    |(A : ℝ)| ≤ H ∧ |(B : ℝ)| ≤ H ∧ |(C0 : ℝ)| ≤ H := by
  have hc1 : (1 : ℝ) ≤ |(c : ℝ)| := by
    have hcZ : (1 : ℤ) ≤ |c| := by
      have ht := abs_pos.mpr hc
      omega
    exact_mod_cast hcZ
  have hA1 : (1 : ℝ) ≤ |(A : ℝ)| := by
    have hAZ : (1 : ℤ) ≤ |A| := by
      have ht := abs_pos.mpr hA
      omega
    exact_mod_cast hAZ
  have habs_cube : ∀ z : ℝ, |(c : ℝ) * z ^ 3| ≤ H → |z| ≤ H := by
    intro z hz
    rw [abs_mul, abs_pow] at hz
    have hcube : |z| ^ 3 ≤ H := by
      calc
        |z| ^ 3 = 1 * |z| ^ 3 := by ring
        _ ≤ |(c : ℝ)| * |z| ^ 3 :=
          mul_le_mul_of_nonneg_right hc1 (pow_nonneg (abs_nonneg z) 3)
        _ ≤ H := hz
    by_contra hn
    have hlt : H < |z| := lt_of_not_ge hn
    have hone : 1 ≤ |z| := hH.trans hlt.le
    have hle : |z| ≤ |z| ^ 3 := by
      simpa only [pow_one] using pow_le_pow_right₀ hone (by norm_num : 1 ≤ 3)
    linarith
  have hAb : |(A : ℝ)| ≤ H := habs_cube A (by exact_mod_cast hleft)
  have hCb : |(C0 : ℝ)| ≤ H := habs_cube C0 (by exact_mod_cast hright)
  have hcoef : 1 ≤ 3 * |(c : ℝ)| * |(A : ℝ)| ^ 2 := by
    exact one_le_mul_of_one_le_of_one_le
      (one_le_mul_of_one_le_of_one_le (by norm_num) hc1) (one_le_pow₀ hA1)
  have hmid : (3 * |(c : ℝ)| * |(A : ℝ)| ^ 2) * |(B : ℝ)| ≤ H := by
    push_cast at hmiddle
    simpa only [abs_mul, abs_pow, show |(3:ℝ)| = 3 by norm_num] using hmiddle
  refine ⟨hAb, ?_, hCb⟩
  calc
    |(B : ℝ)| = 1 * |(B : ℝ)| := by ring
    _ ≤ (3 * |(c : ℝ)| * |(A : ℝ)| ^ 2) * |(B : ℝ)| :=
      mul_le_mul_of_nonneg_right hcoef (abs_nonneg _)
    _ ≤ H := hmid

private theorem original_cubic_cube_height
    (G : MvPolynomial (Fin 4) ℤ) (H : ℝ) (hH : 1 ≤ H)
    (hheight : ∀ m : Fin 4 →₀ ℕ, |((G.coeff m : ℤ) : ℝ)| ≤ H)
    (c A B C0 : ℤ) (hc : c ≠ 0) (hA : A ≠ 0)
    (hfac : sexticResidual G = MvPolynomial.C c * (quadraticForm A B C0) ^ 3) :
    |(A : ℝ)| ≤ H ∧ |(B : ℝ)| ≤ H ∧ |(C0 : ℝ)| ≤ H := by
  let p0 := G.coeff (quadIndex 3 0 1 0)
  let p1 := G.coeff (quadIndex 2 1 1 0)
  let p2 := G.coeff (quadIndex 1 2 1 0)
  let p3 := G.coeff (quadIndex 0 3 1 0)
  let q0 := -G.coeff (quadIndex 3 0 0 1)
  let q1 := -G.coeff (quadIndex 2 1 0 1)
  let q2 := -G.coeff (quadIndex 1 2 0 1)
  let q3 := -G.coeff (quadIndex 0 3 0 1)
  have heq : ∀ r s : ℚ,
      s ^ 3 * ((p0:ℚ)*r^3+(p1:ℚ)*r^2*s+(p2:ℚ)*r*s^2+(p3:ℚ)*s^3) -
        r ^ 3 * ((q0:ℚ)*r^3+(q1:ℚ)*r^2*s+(q2:ℚ)*r*s^2+(q3:ℚ)*s^3) =
          (c:ℚ) * ((A:ℚ)*r^2+(B:ℚ)*r*s+(C0:ℚ)*s^2) ^ 3 := by
    intro r s
    have ht := congrArg (fun R : MvPolynomial (Fin 2) ℤ =>
      eval ![r, s] (MvPolynomial.map (Int.castRingHom ℚ) R)) hfac
    simpa [sexticResidual, cubicP, cubicQ, binaryCubic, binary_monomial,
      quadraticForm, p0, p1, p2, p3, q0, q1, q2, q3] using ht
  have hparts := cubic_cube_scalar_edges p0 p1 p2 p3 q0 q1 q2 q3 c A B C0 heq
  have hq0 : q0 = -c*A^3 := by exact_mod_cast hparts.1
  have hq1 : q1 = -3*c*A^2*B := by exact_mod_cast hparts.2.1
  have hp3 : p3 = c*C0^3 := by exact_mod_cast hparts.2.2
  have hleft : |((c*A^3 : ℤ) : ℝ)| ≤ H := by
    have hb : |(q0 : ℝ)| ≤ H := by simpa [q0] using hheight (quadIndex 3 0 0 1)
    simpa only [hq0, neg_mul, Int.cast_neg, abs_neg] using hb
  have hmiddle : |((3*c*A^2*B : ℤ) : ℝ)| ≤ H := by
    have hb : |(q1 : ℝ)| ≤ H := by simpa [q1] using hheight (quadIndex 2 1 0 1)
    simpa only [hq1, neg_mul, Int.cast_neg, abs_neg] using hb
  have hright : |((c*C0^3 : ℤ) : ℝ)| ≤ H := by
    have hb : |(p3 : ℝ)| ≤ H := hheight (quadIndex 0 3 1 0)
    simpa only [hp3] using hb
  exact cubic_cube_direct_height c A B C0 hc hA H hH hleft hmiddle hright

private theorem original_cubic_cube_discriminant_ne_zero
    (G : MvPolynomial (Fin 4) ℤ) (c A B C0 : ℤ) (hc : c ≠ 0) (hA : A ≠ 0)
    (hfac : sexticResidual G = MvPolynomial.C c * (quadraticForm A B C0) ^ 3)
    (hnotpure : ¬ ∃ kappa a b : ℚ, kappa ≠ 0 ∧ (a ≠ 0 ∨ b ≠ 0) ∧
      ∀ r s : ℚ, canonicalResidual G r s = kappa * (a*r+b*s)^6) :
    B ^ 2 - 4*A*C0 ≠ 0 := by
  intro hdisc
  have hcQ : (c : ℚ) ≠ 0 := by exact_mod_cast hc
  have hAQ : (A : ℚ) ≠ 0 := by exact_mod_cast hA
  have hdiscQ : (B : ℚ) ^ 2 - 4*(A : ℚ)*(C0 : ℚ) = 0 := by exact_mod_cast hdisc
  have h4A : (4 : ℚ) * (A : ℚ) ≠ 0 := mul_ne_zero (by norm_num) hAQ
  apply hnotpure
  refine ⟨(c : ℚ) / (4*(A : ℚ)) ^ 3, 2*(A : ℚ), (B : ℚ),
    div_ne_zero hcQ (pow_ne_zero 3 h4A), Or.inl (mul_ne_zero (by norm_num) hAQ), ?_⟩
  intro r s
  have hsq : (2*(A:ℚ)*r+(B:ℚ)*s)^2 =
      4*(A:ℚ)*((A:ℚ)*r^2+(B:ℚ)*r*s+(C0:ℚ)*s^2) := by
    linear_combination s^2*hdiscQ
  rw [← canonical_residual_eval G r s, hfac]
  simp only [map_mul, map_pow, MvPolynomial.map_C, 
    MvPolynomial.eval_C, quadraticForm, map_add, MvPolynomial.map_X,
    MvPolynomial.eval_X, Matrix.cons_val_zero, Matrix.cons_val_one]
  calc
    (c:ℚ)*((A:ℚ)*r^2+(B:ℚ)*r*s+(C0:ℚ)*s^2)^3 =
        ((c:ℚ)/(4*(A:ℚ))^3)*((2*(A:ℚ)*r+(B:ℚ)*s)^2)^3 := by
      rw [hsq]
      field_simp
    _ = _ := by ring

private def RationalPurePower (n : ℕ) (R : MvPolynomial (Fin 2) ℤ) : Prop :=
  ∃ kappa a b : ℚ,kappa≠0 ∧ (a≠0 ∨ b≠0) ∧ ∀r s:ℚ,
    eval ![r,s] (MvPolynomial.map (Int.castRingHom ℚ) R)=kappa*(a*r+b*s)^n

private def IntegralTwoLines (n : ℕ) (R : MvPolynomial (Fin 2) ℤ) : Prop :=
  ∃c a b a' b':ℤ,∃j:ℕ,c≠0 ∧ a*b'-a'*b≠0 ∧ 1≤j ∧ j<n ∧
    R=C c*(C a*X 0+C b*X 1)^j*(C a'*X 0+C b'*X 1)^(n-j)

private theorem binary_integer_linear_factorization
    (n : ℕ) (R : MvPolynomial (Fin 2) ℤ) (hR : R.IsHomogeneous n) (hR0 : R ≠ 0)
    (hsplit : ((C01.PcCurves.dehom R).map (Int.castRingHom ℚ)).Splits) :
    ∃ c : ℤ, c ≠ 0 ∧ ∃ s : Multiset (Option ℚ),
      s.card = n ∧ R = MvPolynomial.C c * (s.map labelLine).prod := by
  classical
  let f : Polynomial ℤ := C01.PcCurves.dehom R
  have hf : f ≠ 0 := fun h => hR0 (C01.PcCurves.eq_zero_of_dehom hR h)
  obtain ⟨c, hc, roots, hcard, hfac, hroots⟩ :=
    integer_linear_factorization f hf hsplit
  let s : Multiset (Option ℚ) :=
    roots.map some + Multiset.replicate (n - f.natDegree) none
  have hle : f.natDegree ≤ n := C01.PcCurves.dehom_natDegree_le hR
  have hs : s.card = n := by
    simp only [s, Multiset.card_add, Multiset.card_map, Multiset.card_replicate,
      hcard]
    omega
  have hdehomprod : (s.map labelPoly).prod = (roots.map rationalLinear).prod := by
    simp [s, Multiset.map_add, Multiset.prod_add, Multiset.map_map,
      Function.comp_def, labelPoly]
  let B : MvPolynomial (Fin 2) ℤ := MvPolynomial.C c * (s.map labelLine).prod
  have hB : B.IsHomogeneous n := by
    simpa only [B, hs, zero_add] using
      (MvPolynomial.isHomogeneous_C (Fin 2) c).mul (label_product_homogeneous s)
  have hdehom : C01.PcCurves.dehom B = f := by
    rw [show C01.PcCurves.dehom B =
      C01.PcCurves.dehom (MvPolynomial.C c) *
        C01.PcCurves.dehom ((s.map labelLine).prod) from
      C01.PcCurves.dehom_mul _ _]
    rw [label_product_dehom, hdehomprod]
    have hconst : C01.PcCurves.dehom (MvPolynomial.C c : MvPolynomial (Fin 2) ℤ) =
        Polynomial.C c := by simp [C01.PcCurves.dehom]
    rw [hconst]
    exact hfac.symm
  have hsub : C01.PcCurves.dehom (R - B) = 0 := by
    rw [C01.PcCurves.dehom_sub, hdehom]
    exact sub_self f
  have heq : R = B := sub_eq_zero.mp
    (C01.PcCurves.eq_zero_of_dehom (hR.sub hB) hsub)
  exact ⟨c, hc, s, hs, heq⟩

private theorem factored_label_projective_zero
    (n : ℕ) (R : MvPolynomial (Fin 2) ℤ) (hR : R.IsHomogeneous n)
    (c : ℤ) (s : Multiset (Option ℚ))
    (hfac : R = MvPolynomial.C c * (s.map labelLine).prod)
    (z : Option ℚ) (hz : z ∈ s) :
    MvPolynomial.eval (projectivePoint (labelToComplex z)).rep
      (R.map (Int.castRingHom ℂ)) = 0 := by
  apply eval_projectivePoint_rep_zero _ n (hR.map (Int.castRingHom ℂ))
  rw [hfac, map_mul, MvPolynomial.eval_mul,
    label_product_root s z hz, mul_zero]

private theorem twoSupportProduct {M : Type*} [CommMonoid M] (n : ℕ) (s : Multiset (Option ℚ)) (a b : Option ℚ) (hcard : s.card = n)
    (ha : a ∈ s) (hb : b ∈ s) (hne : a ≠ b)
    (hcover : ∀ x ∈ s, x = a ∨ x = b) :
    ∃ j : ℕ, 1 ≤ j ∧ j < n ∧
      ∀ f : Option ℚ → M, (s.map f).prod = f a ^ j * f b ^ (n - j) := by
  obtain ⟨j, hj, haj, hbj, hprod⟩ :=
    binarySupportProduct (M := M) a b hne s hcover
  refine ⟨j, ?_, ?_, ?_⟩
  · exact haj ha
  · have hlt := hbj hb
    omega
  · intro f
    simpa only [hcard] using hprod f

private theorem split_binary_classification
    (n : ℕ) (hn : 1 ≤ n) (R : MvPolynomial (Fin 2) ℤ)
    (hR : R.IsHomogeneous n) (hR0 : R ≠ 0)
    (hthree : ¬ HasThreeProjectiveZeros R)
    (hsplit : ((C01.PcCurves.dehom R).map (Int.castRingHom ℚ)).Splits) :
    RationalPurePower n R ∨ IntegralTwoLines n R := by
  classical
  obtain ⟨c, hc, labels, hcard, hfac⟩ :=
    binary_integer_linear_factorization n R hR hR0 hsplit
  obtain ⟨a, ha⟩ := FormalAB.S84900580.A5PrivateOddRoot.multiset_has_member labels (by omega)
  by_cases hone : ∀ z ∈ labels, z = a
  · have hp : R = MvPolynomial.C c * FormalAB.S84900580.A5PrivateOddRoot.labelLine a ^ n := by
      rw [hfac, FormalAB.S84900580.A5PrivateOddRoot.label_product_eq_pow labels a hone, hcard]
    left
    refine ⟨(c : ℚ), (FormalAB.S84900580.A5PrivateOddRoot.lineCoeffA a : ℚ),
      (FormalAB.S84900580.A5PrivateOddRoot.lineCoeffB a : ℚ), ?_, ?_, ?_⟩
    · exact_mod_cast hc
    · rcases FormalAB.S84900580.A5PrivateOddRoot.label_coeff_nonzero a with ha' | hb'
      · left; exact_mod_cast ha'
      · right; exact_mod_cast hb'
    · intro r s
      rw [hp]
      simp [FormalAB.S84900580.A5PrivateOddRoot.labelLine]
  · push Not at hone
    obtain ⟨b, hb, hba⟩ := hone
    have hab : a ≠ b := Ne.symm hba
    have hproj : Function.Injective (fun z : Option ℚ =>
        FormalAB.S84900580.A5PrivateOddRoot.projectivePoint (FormalAB.S84900580.A5PrivateOddRoot.labelToComplex z)) :=
      FormalAB.S84900580.A5PrivateOddRoot.projectivePoint_injective.comp
        FormalAB.S84900580.A5PrivateOddRoot.labelToComplex_injective
    have hzero : ∀ z ∈ labels,
        MvPolynomial.eval
          (FormalAB.S84900580.A5PrivateOddRoot.projectivePoint
            (FormalAB.S84900580.A5PrivateOddRoot.labelToComplex z)).rep
          (R.map (Int.castRingHom ℂ)) = 0 :=
      factored_label_projective_zero n R hR c labels hfac
    have hcover : ∀ z ∈ labels, z = a ∨ z = b := by
      intro z hz
      by_cases hza : z = a
      · exact Or.inl hza
      by_cases hzb : z = b
      · exact Or.inr hzb
      exfalso
      apply hthree
      refine ⟨FormalAB.S84900580.A5PrivateOddRoot.projectivePoint (FormalAB.S84900580.A5PrivateOddRoot.labelToComplex a),
        FormalAB.S84900580.A5PrivateOddRoot.projectivePoint (FormalAB.S84900580.A5PrivateOddRoot.labelToComplex b),
        FormalAB.S84900580.A5PrivateOddRoot.projectivePoint (FormalAB.S84900580.A5PrivateOddRoot.labelToComplex z),
        ?_, ?_, ?_, hzero a ha, hzero b hb, hzero z hz⟩
      · exact fun he => hab (hproj he)
      · exact fun he => hza (hproj he).symm
      · exact fun he => hzb (hproj he).symm
    obtain ⟨j, hj, hj6, hprod⟩ :=
      twoSupportProduct (M := MvPolynomial (Fin 2) ℤ)
        n labels a b hcard ha hb hab hcover
    right
    refine ⟨c, FormalAB.S84900580.A5PrivateOddRoot.lineCoeffA a, FormalAB.S84900580.A5PrivateOddRoot.lineCoeffB a,
      FormalAB.S84900580.A5PrivateOddRoot.lineCoeffA b, FormalAB.S84900580.A5PrivateOddRoot.lineCoeffB b,
      j, hc, FormalAB.S84900580.A5PrivateOddRoot.label_coeff_independent a b hab,
      hj, hj6, ?_⟩
    rw [hfac, hprod FormalAB.S84900580.A5PrivateOddRoot.labelLine]
    simp only [FormalAB.S84900580.A5PrivateOddRoot.labelLine, mul_assoc]

private theorem nonlinear_factor_two_roots (f p : Polynomial ℚ)
    (hf : f ≠ 0) (htwo : AtMostTwoRoots f)
    (hp : Irreducible p) (hpf : p ∣ f) (hne : p.natDegree ≠ 1) :
    p.natDegree = 2 ∧ ∀ z : ℂ,
      Polynomial.eval₂ (algebraMap ℚ ℂ) z f = 0 →
        Polynomial.eval₂ (algebraMap ℚ ℂ) z p = 0 := by
  classical
  have hpos : 0 < p.natDegree :=
    Polynomial.natDegree_pos_iff_degree_pos.mpr
      (Polynomial.degree_pos_of_irreducible hp)
  have hge : 2 ≤ p.natDegree := by omega
  let pc : Polynomial ℂ := p.map (algebraMap ℚ ℂ)
  have hpc : pc ≠ 0 := by
    exact (Polynomial.map_ne_zero_iff (RingHom.injective _)).mpr hp.ne_zero
  have hsep : pc.Separable := hp.separable.map
  let S : Finset ℂ := pc.roots.toFinset
  have hcard : S.card = p.natDegree := by
    calc
      S.card = pc.roots.card :=
        Multiset.toFinset_card_of_nodup (Polynomial.nodup_roots hsep)
      _ = pc.natDegree := (IsAlgClosed.splits pc).natDegree_eq_card_roots.symm
      _ = p.natDegree := Polynomial.natDegree_map _
  obtain ⟨z₁, hz₁, z₂, hz₂, h12⟩ := Finset.one_lt_card.mp
    (show 1 < S.card from by omega)
  have hroot : ∀ z ∈ S,
      Polynomial.eval₂ (algebraMap ℚ ℂ) z p = 0 := by
    intro z hz
    have hz' : z ∈ pc.roots := by simpa only [S, Multiset.mem_toFinset] using hz
    have hr := (Polynomial.mem_roots hpc).mp hz'
    simpa only [Polynomial.IsRoot.def, pc, Polynomial.eval_map] using hr
  have hpfroot : ∀ z : ℂ,
      Polynomial.eval₂ (algebraMap ℚ ℂ) z p = 0 →
      Polynomial.eval₂ (algebraMap ℚ ℂ) z f = 0 := by
    intro z hz
    obtain ⟨g, rfl⟩ := hpf
    rw [Polynomial.eval₂_mul, hz, zero_mul]
  have h₁ := hroot z₁ hz₁
  have h₂ := hroot z₂ hz₂
  have hf₁ := hpfroot z₁ h₁
  have hf₂ := hpfroot z₂ h₂
  have hsub : S ⊆ {z₁, z₂} := by
    intro z hz
    rcases htwo z₁ z₂ z hf₁ hf₂ (hpfroot z (hroot z hz)) with h | h | h
    · exact (h12 h).elim
    · simp [← h]
    · simp [← h]
  have hle : S.card ≤ 2 := by
    calc
      S.card ≤ ({z₁, z₂} : Finset ℂ).card := Finset.card_le_card hsub
      _ = 2 := by simp [h12]
  have hdeg : p.natDegree = 2 := by omega
  have hsupport : ∀ z : ℂ,
      Polynomial.eval₂ (algebraMap ℚ ℂ) z f = 0 →
      Polynomial.eval₂ (algebraMap ℚ ℂ) z p = 0 := by
    intro z hz
    rcases htwo z₁ z₂ z hf₁ hf₂ hz with h | h | h
    · exact (h12 h).elim
    · simpa only [← h] using h₁
    · simpa only [← h] using h₂
  exact ⟨hdeg,hsupport⟩
private theorem primitive_rational_polynomial_exists (g : Polynomial ℚ) (hg : g≠0) :
    ∃q : Polynomial ℤ,q.IsPrimitive ∧ q.natDegree=g.natDegree ∧
      ∃k:ℚ,k≠0 ∧ q.map (Int.castRingHom ℚ)=Polynomial.C k*g := by
  obtain ⟨b, hbM, hb⟩ := IsLocalization.integerNormalization_spec
    (nonZeroDivisors ℤ) g
  let f := IsLocalization.integerNormalization (nonZeroDivisors ℤ) g
  have hbne : b ≠ 0 := nonZeroDivisors.ne_zero hbM
  have hb0 : (b : ℚ) ≠ 0 := by exact_mod_cast hbne
  have hb' : f.map (Int.castRingHom ℚ) = Polynomial.C (b : ℚ) * g := by
    rw [← algebraMap_int_eq, hb, ← Int.cast_smul_eq_zsmul ℚ, Polynomial.smul_eq_C_mul]
  have hCb : (Polynomial.C (b : ℚ)) ≠ 0 := by simpa using hb0
  have hf : f ≠ 0 := by
    intro h
    rw [h, Polynomial.map_zero] at hb'
    exact (mul_ne_zero hCb hg) hb'.symm
  have hp : f.primPart.IsPrimitive := Polynomial.isPrimitive_primPart f
  have hc : f.content ≠ 0 := by rwa [Ne, Polynomial.content_eq_zero_iff]
  have hcQ : (f.content : ℚ) ≠ 0 := by exact_mod_cast hc
  have hCc : (Polynomial.C (f.content : ℚ) : Polynomial ℚ) ≠ 0 := by
    simpa using hcQ
  have he : Polynomial.C (f.content : ℚ) *
      f.primPart.map (Int.castRingHom ℚ) = Polynomial.C (b : ℚ) * g := by
    rw [← hb']
    conv_rhs => rw [Polynomial.eq_C_content_mul_primPart f]
    rw [Polynomial.map_mul, Polynomial.map_C]
    simp
  have hscalar : (f.content : ℚ) * ((b : ℚ) / (f.content : ℚ)) = (b : ℚ) := by
    field_simp
  have hmap : f.primPart.map (Int.castRingHom ℚ) =
      Polynomial.C ((b : ℚ) / (f.content : ℚ)) * g := by
    apply mul_left_cancel₀ hCc
    rw [he, ← mul_assoc, ← map_mul, hscalar]
  have hk : ((b : ℚ) / (f.content : ℚ)) ≠ 0 := div_ne_zero hb0 hcQ
  have hCk : (Polynomial.C ((b : ℚ) / (f.content : ℚ)) : Polynomial ℚ) ≠ 0 := by
    simpa using hk
  have hd : f.primPart.natDegree = g.natDegree := by
    calc
      f.primPart.natDegree =
          (f.primPart.map (Int.castRingHom ℚ)).natDegree :=
        (Polynomial.natDegree_map_eq_of_injective (RingHom.injective_int _) _).symm
      _ = g.natDegree := by
        rw [hmap, Polynomial.natDegree_mul hCk hg, Polynomial.natDegree_C]
        simp only [zero_add]
  exact ⟨f.primPart, hp, hd, (b : ℚ) / (f.content : ℚ), hk, hmap⟩

private theorem dehom_atMostTwo (n : ℕ) (R : MvPolynomial (Fin 2) ℤ)
    (hR : R.IsHomogeneous n) (hR0 : R ≠ 0)
    (hthree : ¬ HasThreeProjectiveZeros R) :
    AtMostTwoRoots ((C01.PcCurves.dehom R).map (Int.castRingHom ℚ)) := by
  classical
  let f0 : Polynomial ℤ := C01.PcCurves.dehom R
  let f : Polynomial ℚ := f0.map (Int.castRingHom ℚ)
  let RC : MvPolynomial (Fin 2) ℂ := R.map (Int.castRingHom ℂ)
  have hRC : RC.IsHomogeneous n := hR.map (Int.castRingHom ℂ)
  have hf0 : f0 ≠ 0 := fun h => hR0 (C01.PcCurves.eq_zero_of_dehom hR h)
  have hinj : Function.Injective (Int.castRingHom ℚ) := RingHom.injective_int _
  have hf : f ≠ 0 := (Polynomial.map_ne_zero_iff hinj).mpr hf0
  have hdeg : f.natDegree = f0.natDegree :=
    Polynomial.natDegree_map_eq_of_injective hinj f0
  have hcomp : (algebraMap ℚ ℂ).comp (Int.castRingHom ℚ) =
      Int.castRingHom ℂ := by
    ext n ; simp
  have hvec : ∀ z : ℂ, Polynomial.eval₂ (algebraMap ℚ ℂ) z f = 0 →
      MvPolynomial.eval (pointVector (some z)) RC = 0 := by
    intro z hz
    have hz' : Polynomial.eval₂ (Int.castRingHom ℂ) z f0 = 0 := by
      simpa only [f, Polynomial.eval₂_map, hcomp] using hz
    change MvPolynomial.eval ![z, 1] RC = 0
    rw [← C01.PcCurves.dehom_eval hRC, C01.PcRes.dehom_map hR,
      Polynomial.eval_map]
    exact hz'
  have hrep : ∀ z : ℂ, Polynomial.eval₂ (algebraMap ℚ ℂ) z f = 0 →
      MvPolynomial.eval (projectivePoint (some z)).rep RC = 0 := by
    intro z hz
    exact eval_projectivePoint_rep_zero RC n hRC (some z) (hvec z hz)
  have htwo : AtMostTwoRoots f := by
    intro z₁ z₂ z₃ hz₁ hz₂ hz₃
    by_contra hn
    have h12 : z₁ ≠ z₂ := by intro h; exact hn (Or.inl h)
    have h13 : z₁ ≠ z₃ := by intro h; exact hn (Or.inr (Or.inl h))
    have h23 : z₂ ≠ z₃ := by intro h; exact hn (Or.inr (Or.inr h))
    apply hthree
    refine ⟨projectivePoint (some z₁), projectivePoint (some z₂),
      projectivePoint (some z₃), ?_, ?_, ?_, hrep z₁ hz₁, hrep z₂ hz₂, hrep z₃ hz₃⟩
    · intro h
      exact h12 (Option.some.inj (projectivePoint_injective h))
    · intro h
      exact h13 (Option.some.inj (projectivePoint_injective h))
    · intro h
      exact h23 (Option.some.inj (projectivePoint_injective h))
  exact htwo
private theorem dehom_degree_or_split (n : ℕ) (R : MvPolynomial (Fin 2) ℤ)
    (hR : R.IsHomogeneous n) (hR0 : R ≠ 0)
    (hthree : ¬ HasThreeProjectiveZeros R) :
    ((C01.PcCurves.dehom R).map (Int.castRingHom ℚ)).natDegree=n ∨
      ((C01.PcCurves.dehom R).map (Int.castRingHom ℚ)).Splits := by
  classical
  let f0 : Polynomial ℤ := C01.PcCurves.dehom R
  let f : Polynomial ℚ := f0.map (Int.castRingHom ℚ)
  let RC : MvPolynomial (Fin 2) ℂ := R.map (Int.castRingHom ℂ)
  have hRC : RC.IsHomogeneous n := hR.map (Int.castRingHom ℂ)
  have hf0 : f0 ≠ 0 := fun h => hR0 (C01.PcCurves.eq_zero_of_dehom hR h)
  have hinj : Function.Injective (Int.castRingHom ℚ) := RingHom.injective_int _
  have hf : f ≠ 0 := (Polynomial.map_ne_zero_iff hinj).mpr hf0
  have hdeg : f.natDegree = f0.natDegree :=
    Polynomial.natDegree_map_eq_of_injective hinj f0
  have hcomp : (algebraMap ℚ ℂ).comp (Int.castRingHom ℚ) =
      Int.castRingHom ℂ := by
    ext n ; simp
  have hvec : ∀ z : ℂ, Polynomial.eval₂ (algebraMap ℚ ℂ) z f = 0 →
      MvPolynomial.eval (pointVector (some z)) RC = 0 := by
    intro z hz
    have hz' : Polynomial.eval₂ (Int.castRingHom ℂ) z f0 = 0 := by
      simpa only [f, Polynomial.eval₂_map, hcomp] using hz
    change MvPolynomial.eval ![z, 1] RC = 0
    rw [← C01.PcCurves.dehom_eval hRC, C01.PcRes.dehom_map hR,
      Polynomial.eval_map]
    exact hz'
  have hrep : ∀ z : ℂ, Polynomial.eval₂ (algebraMap ℚ ℂ) z f = 0 →
      MvPolynomial.eval (projectivePoint (some z)).rep RC = 0 := by
    intro z hz
    exact eval_projectivePoint_rep_zero RC n hRC (some z) (hvec z hz)
  have htwo : AtMostTwoRoots f := by
    intro z₁ z₂ z₃ hz₁ hz₂ hz₃
    by_contra hn
    have h12 : z₁ ≠ z₂ := by intro h; exact hn (Or.inl h)
    have h13 : z₁ ≠ z₃ := by intro h; exact hn (Or.inr (Or.inl h))
    have h23 : z₂ ≠ z₃ := by intro h; exact hn (Or.inr (Or.inr h))
    apply hthree
    refine ⟨projectivePoint (some z₁), projectivePoint (some z₂),
      projectivePoint (some z₃), ?_, ?_, ?_, hrep z₁ hz₁, hrep z₂ hz₂, hrep z₃ hz₃⟩
    · intro h
      exact h12 (Option.some.inj (projectivePoint_injective h))
    · intro h
      exact h13 (Option.some.inj (projectivePoint_injective h))
    · intro h
      exact h23 (Option.some.inj (projectivePoint_injective h))
  by_cases h7 : f0.natDegree = n
  · exact Or.inl (hdeg.trans h7)
  · right
    have hle : f0.natDegree ≤ n := C01.PcCurves.dehom_natDegree_le hR
    have hlt : f0.natDegree < n := by omega
    have hc7 : f0.coeff n = R.coeff (C01.PcCurves.ex n 0) := by
      simpa only [f0, Nat.sub_self, if_pos (le_refl n)] using
        (C01.PcCurves.dehom_coeff hR n)
    have hc0 : R.coeff (C01.PcCurves.ex n 0) = 0 := by
      rw [← hc7]
      exact Polynomial.coeff_eq_zero_of_natDegree_lt hlt
    have hinf : MvPolynomial.eval (pointVector none) RC = 0 := by
      change MvPolynomial.eval ![1, 0] RC = 0
      rw [C01.PcCurves.eval_one_zero hRC, MvPolynomial.coeff_map]
      simp only [hc0, map_zero]
    have hinfrep : MvPolynomial.eval (projectivePoint none).rep RC = 0 :=
      eval_projectivePoint_rep_zero RC n hRC none hinf
    have hone : ∀ z w : ℂ,
        Polynomial.eval₂ (algebraMap ℚ ℂ) z f = 0 →
        Polynomial.eval₂ (algebraMap ℚ ℂ) w f = 0 → z = w := by
      intro z w hz hw
      by_contra hzw
      apply hthree
      refine ⟨projectivePoint none, projectivePoint (some z),
        projectivePoint (some w), ?_, ?_, ?_, hinfrep, hrep z hz, hrep w hw⟩
      · intro h
        have h' := projectivePoint_injective h
        simp at h'
      · intro h
        have h' := projectivePoint_injective h
        simp at h'
      · intro h
        exact hzw (Option.some.inj (projectivePoint_injective h))
    exact one_root_splits f hf hone

private theorem sextic_nonsplit_cube (fZ : Polynomial ℤ) (hfZ : fZ ≠ 0)
    (hdegZ : fZ.natDegree = 6)
    (htwo : AtMostTwoRoots (fZ.map (Int.castRingHom ℚ)))
    (hnsplit : ¬ (fZ.map (Int.castRingHom ℚ)).Splits) :
    ∃ q : Polynomial ℤ, q.IsPrimitive ∧ q.natDegree = 2 ∧
      ∃ c : ℤ, c ≠ 0 ∧ fZ = Polynomial.C c * q ^ 3 := by
  classical
  let f := fZ.map (Int.castRingHom ℚ)
  have hf : f ≠ 0 :=
    (Polynomial.map_ne_zero_iff (RingHom.injective_int (Int.castRingHom ℚ))).mpr hfZ
  have hdeg : f.natDegree = 6 := by
    rw [Polynomial.natDegree_map_eq_of_injective
      (RingHom.injective_int (Int.castRingHom ℚ))]
    exact hdegZ
  by_cases hlinear : ∀ p : Polynomial ℚ, Irreducible p → p ∣ f → p.natDegree = 1
  · exact (hnsplit (splits_of_linear_factors f hf hlinear)).elim
  push Not at hlinear
  obtain ⟨p, hp, hpf, hpd⟩ := hlinear
  obtain ⟨hp2, hsupport⟩ := nonlinear_factor_two_roots f p hf htwo hp hpf hpd
  obtain ⟨g, hfg⟩ := hpf
  have hg : g ≠ 0 := by
    intro hz
    rw [hz, mul_zero] at hfg
    exact hf hfg
  have hg4 : g.natDegree = 4 := by
    have hsum : f.natDegree = p.natDegree + g.natDegree := by
      rw [hfg, Polynomial.natDegree_mul hp.ne_zero hg]
    omega
  have hgpos : g.degree ≠ 0 :=
    ne_of_gt (Polynomial.natDegree_pos_iff_degree_pos.mp (by omega : 0 < g.natDegree))
  obtain ⟨z, hgz⟩ := IsAlgClosed.exists_eval₂_eq_zero (algebraMap ℚ ℂ) g hgpos
  have hfz : Polynomial.eval₂ (algebraMap ℚ ℂ) z f = 0 := by
    rw [hfg, Polynomial.eval₂_mul, hgz, mul_zero]
  obtain ⟨r, hgr⟩ := common_root_dvd p g hp z (hsupport z hfz) hgz
  have hr : r ≠ 0 := by
    intro hz
    rw [hz, mul_zero] at hgr
    exact hg hgr
  have hr2 : r.natDegree = 2 := by
    have hsum : g.natDegree = p.natDegree + r.natDegree := by
      rw [hgr, Polynomial.natDegree_mul hp.ne_zero hr]
    omega
  have hrpos : r.degree ≠ 0 :=
    ne_of_gt (Polynomial.natDegree_pos_iff_degree_pos.mp (by omega : 0 < r.natDegree))
  obtain ⟨w, hrw⟩ := IsAlgClosed.exists_eval₂_eq_zero (algebraMap ℚ ℂ) r hrpos
  have hfw : Polynomial.eval₂ (algebraMap ℚ ℂ) w f = 0 := by
    rw [hfg, hgr, Polynomial.eval₂_mul, Polynomial.eval₂_mul, hrw, mul_zero, mul_zero]
  obtain ⟨s, hrs⟩ := common_root_dvd p r hp w (hsupport w hfw) hrw
  have hs : s ≠ 0 := by
    intro hz
    rw [hz, mul_zero] at hrs
    exact hr hrs
  have hs0 : s.natDegree = 0 := by
    have hsum : r.natDegree = p.natDegree + s.natDegree := by
      rw [hrs, Polynomial.natDegree_mul hp.ne_zero hs]
    omega
  let cQ : ℚ := s.coeff 0
  have hsC : s = Polynomial.C cQ := Polynomial.eq_C_of_natDegree_eq_zero hs0
  have hfac : f = Polynomial.C cQ * p ^ 3 := by
    rw [hfg, hgr, hrs, hsC]
    ring
  obtain ⟨q, hqprim, hqdegree, k, hk, hqmap⟩ :=
    primitive_rational_polynomial_exists p hp.ne_zero
  have hq2 : q.natDegree = 2 := hqdegree.trans hp2
  have hqcube : q ^ 3 = q * q * q := by ring
  have hqpow : (q ^ 3).IsPrimitive := by
    rw [hqcube]
    exact Polynomial.IsPrimitive.mul (Polynomial.IsPrimitive.mul hqprim hqprim) hqprim
  have hdiv : q ^ 3 ∣ fZ := by
    rw [Polynomial.IsPrimitive.Int.dvd_iff_map_cast_dvd_map_cast (q ^ 3) fZ hqpow]
    refine ⟨Polynomial.C (cQ / k ^ 3), ?_⟩
    rw [Polynomial.map_pow, hqmap]
    have hsc : k ^ 3 * (cQ / k ^ 3) = cQ := by field_simp
    have hC : (Polynomial.C k : Polynomial ℚ) ^ 3 *
        Polynomial.C (cQ / k ^ 3) = Polynomial.C cQ := by
      rw [← map_pow, ← map_mul, hsc]
    change f = (Polynomial.C k * p) ^ 3 * Polynomial.C (cQ / k ^ 3)
    rw [hfac]
    calc
      Polynomial.C cQ * p ^ 3 =
          ((Polynomial.C k) ^ 3 * Polynomial.C (cQ / k ^ 3)) * p ^ 3 := by rw [hC]
      _ = _ := by ring
  obtain ⟨t, hft⟩ := hdiv
  have ht : t ≠ 0 := by
    intro hz
    rw [hz, mul_zero] at hft
    exact hfZ hft
  have hqpowdeg : (q ^ 3).natDegree = 6 := by
    rw [hqcube, Polynomial.natDegree_mul (mul_ne_zero hqprim.ne_zero hqprim.ne_zero)
      hqprim.ne_zero, Polynomial.natDegree_mul hqprim.ne_zero hqprim.ne_zero, hq2]
  have ht0 : t.natDegree = 0 := by
    have hsum : fZ.natDegree = (q ^ 3).natDegree + t.natDegree := by
      rw [hft, Polynomial.natDegree_mul (pow_ne_zero 3 hqprim.ne_zero) ht]
    omega
  have htC : t = Polynomial.C (t.coeff 0) := Polynomial.eq_C_of_natDegree_eq_zero ht0
  have hct : t.coeff 0 ≠ 0 := by
    intro hz
    apply ht
    rw [htC, hz, Polynomial.C_0]
  refine ⟨q, hqprim, hq2, t.coeff 0, hct, ?_⟩
  calc
    fZ = q ^ 3 * t := hft
    _ = q ^ 3 * Polynomial.C (t.coeff 0) := congrArg (fun z => q ^ 3 * z) htC
    _ = Polynomial.C (t.coeff 0) * q ^ 3 := mul_comm _ _

private theorem sextic_binary_classification
    (R : MvPolynomial (Fin 2) ℤ) (hR : R.IsHomogeneous 6) (hR0 : R ≠ 0) :
    ThreeProjectiveZeros R ∨ RationalPurePower 6 R ∨ IntegralTwoLines 6 R ∨
      ∃ c A B C : ℤ, c ≠ 0 ∧ A ≠ 0 ∧
        R = MvPolynomial.C c * (quadraticForm A B C) ^ 3 := by
  classical
  by_cases ht : HasThreeProjectiveZeros R
  · exact Or.inl ht
  right
  by_cases hs : ((C01.PcCurves.dehom R).map (Int.castRingHom ℚ)).Splits
  · rcases split_binary_classification 6 (by norm_num) R hR hR0 ht hs with hp | hl
    · exact Or.inl hp
    · exact Or.inr (Or.inl hl)
  right
  right
  let fZ := C01.PcCurves.dehom R
  have hfZ : fZ ≠ 0 := fun hz => hR0 (C01.PcCurves.eq_zero_of_dehom hR hz)
  have hdegQ : (fZ.map (Int.castRingHom ℚ)).natDegree = 6 :=
    (dehom_degree_or_split 6 R hR hR0 ht).resolve_right hs
  have hdeg : fZ.natDegree = 6 := by
    rwa [Polynomial.natDegree_map_eq_of_injective (RingHom.injective_int _)] at hdegQ
  obtain ⟨q, hqprim, hqdeg, c, hc, hfac⟩ :=
    sextic_nonsplit_cube fZ hfZ hdeg (dehom_atMostTwo 6 R hR hR0 ht) hs
  let A := q.coeff 2
  let B := q.coeff 1
  let C0 := q.coeff 0
  have hA : A ≠ 0 := by
    dsimp [A]
    rw [← hqdeg, Polynomial.coeff_natDegree]
    exact Polynomial.leadingCoeff_ne_zero.mpr hqprim.ne_zero
  have hqform : q = Polynomial.C A * Polynomial.X ^ 2 +
      Polynomial.C B * Polynomial.X + Polynomial.C C0 := by
    ext n
    simp only [Polynomial.coeff_add, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow,
      Polynomial.coeff_X, Polynomial.coeff_C]
    by_cases hn : n ≤ 2
    · interval_cases n <;> simp [A, B, C0]
    · have hqn : q.coeff n = 0 :=
        Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)
      simp [hqn, show n ≠ 0 from by omega, 
        show n ≠ 2 from by omega, 
        show 1 ≠ n from by omega]
  have hdehomq : C01.PcCurves.dehom (quadraticForm A B C0) = q := by
    calc
      C01.PcCurves.dehom (quadraticForm A B C0) =
          Polynomial.C A * Polynomial.X ^ 2 + Polynomial.C B * Polynomial.X +
            Polynomial.C C0 := by
        simp [C01.PcCurves.dehom, quadraticForm]
      _ = q := hqform.symm
  let S := MvPolynomial.C c * (quadraticForm A B C0) ^ 3
  have hS : S.IsHomogeneous 6 := by
    exact (isHomogeneous_C (Fin 2) c).mul ((quadratic_homogeneous A B C0).pow 3)
  have hdehomS : C01.PcCurves.dehom S = fZ := by
    rw [show C01.PcCurves.dehom S =
      C01.PcCurves.dehom (MvPolynomial.C c) *
        C01.PcCurves.dehom ((quadraticForm A B C0) ^ 3) from
          C01.PcCurves.dehom_mul _ _]
    have hC : C01.PcCurves.dehom (MvPolynomial.C c : MvPolynomial (Fin 2) ℤ) =
        Polynomial.C c := by simp [C01.PcCurves.dehom]
    have hp : C01.PcCurves.dehom ((quadraticForm A B C0) ^ 3) =
        (C01.PcCurves.dehom (quadraticForm A B C0)) ^ 3 := by
      calc
        C01.PcCurves.dehom ((quadraticForm A B C0) ^ 3) =
            C01.PcCurves.dehom ((quadraticForm A B C0) *
              (quadraticForm A B C0) * (quadraticForm A B C0)) := by
          congr 1
          ring
        _ = C01.PcCurves.dehom (quadraticForm A B C0) *
            C01.PcCurves.dehom (quadraticForm A B C0) *
            C01.PcCurves.dehom (quadraticForm A B C0) := by
          rw [C01.PcCurves.dehom_mul, C01.PcCurves.dehom_mul]
        _ = (C01.PcCurves.dehom (quadraticForm A B C0)) ^ 3 := by ring
    rw [hC, hp, hdehomq]
    exact hfac.symm
  have hz : C01.PcCurves.dehom (R - S) = 0 := by
    rw [C01.PcCurves.dehom_sub, hdehomS]
    exact sub_self fZ
  exact ⟨c, A, B, C0, hc, hA,
    sub_eq_zero.mp (C01.PcCurves.eq_zero_of_dehom (hR.sub hS) hz)⟩

private theorem both_coprime3 (d e u v : ℕ) (h : ℤ)
    (hsign : h = 1 ∨ h = -1)
    (hshift : ((e ^ 3 * v : ℕ) : ℤ) = ((d ^ 3 * u : ℕ) : ℤ) + h) :
    d.Coprime e ∧ u.Coprime v := by
  have hn := (unit_coprime (e ^ 3 * v) (d ^ 3 * u) h hsign hshift).symm
  have hdvd : d ∣ d ^ 3 * u := ⟨d ^ 2 * u, by ring⟩
  have hevd : e ∣ e ^ 3 * v := ⟨e ^ 2 * v, by ring⟩
  have huvd : u ∣ d ^ 3 * u := ⟨d ^ 3, by ring⟩
  have hvvd : v ∣ e ^ 3 * v := ⟨e ^ 3, by ring⟩
  exact ⟨hn.of_dvd hdvd hevd, hn.of_dvd huvd hvvd⟩

private theorem graph_shift_transfer
    (C E d e u v h : ℤ)
    (hgraph : C * u = E * v)
    (hshift : e ^ 3 * v - d ^ 3 * u = h) :
    let R := e ^ 3 * C - d ^ 3 * E
    R * u = h * E ∧ R * v = h * C := by
  dsimp
  constructor
  · linear_combination e ^ 3 * hgraph + E * hshift
  · linear_combination d ^ 3 * hgraph + C * hshift

private theorem graph_value_divides_resultant
    (C E d e u v h B : ℤ)
    (hsign : h = 1 ∨ h = -1)
    (hgraph : C * u = E * v)
    (hshift : e ^ 3 * v - d ^ 3 * u = h)
    (hres : (Int.gcd E C : ℤ) ∣ B)
    (hB : B ≠ 0) :
    let R := e ^ 3 * C - d ^ 3 * E
    R ≠ 0 ∧ R ∣ B := by
  dsimp
  let R : ℤ := e ^ 3 * C - d ^ 3 * E
  have htrans : R * u = h * E ∧ R * v = h * C :=
    graph_shift_transfer C E d e u v h hgraph hshift
  have hRC : R ∣ C := by
    rcases hsign with rfl | rfl
    · refine ⟨v, ?_⟩
      simpa only [one_mul] using htrans.2.symm
    · refine ⟨-v, ?_⟩
      nlinarith [htrans.2]
  have hRE : R ∣ E := by
    rcases hsign with rfl | rfl
    · refine ⟨u, ?_⟩
      simpa only [one_mul] using htrans.1.symm
    · refine ⟨-u, ?_⟩
      nlinarith [htrans.1]
  have hRgcd : R ∣ (Int.gcd E C : ℤ) := by
    first | exact Int.dvd_gcd hRE hRC | exact Int.dvd_coe_gcd hRE hRC
  have hRB : R ∣ B := hRgcd.trans hres
  have hR0 : R ≠ 0 := by
    intro hz
    rw [hz, zero_dvd_iff] at hRB
    exact hB hRB
  exact ⟨hR0, hRB⟩

private theorem second_pair_unique
    (C E d e u v u' v' h : ℤ)
    (hR0 : e ^ 3 * C - d ^ 3 * E ≠ 0)
    (hg : C * u = E * v)
    (hs : e ^ 3 * v - d ^ 3 * u = h)
    (hg' : C * u' = E * v')
    (hs' : e ^ 3 * v' - d ^ 3 * u' = h) :
    u = u' ∧ v = v' := by
  have h1 := graph_shift_transfer C E d e u v h hg hs
  have h2 := graph_shift_transfer C E d e u' v' h hg' hs'
  constructor
  · exact mul_left_cancel₀ hR0 (h1.1.trans h2.1.symm)
  · exact mul_left_cancel₀ hR0 (h1.2.trans h2.2.symm)

private theorem shift_int
    (d e u v : ℕ) (h : ℤ)
    (hs : ((e ^ 3 * v : ℕ) : ℤ) = ((d ^ 3 * u : ℕ) : ℤ) + h) :
    (e : ℤ) ^ 3 * (v : ℤ) - (d : ℤ) ^ 3 * (u : ℤ) = h := by
  push_cast at hs
  linear_combination hs

private lemma three_root_divisor_cover (hSt : StewartHyp)
    (n : ℕ) (hn7 : n ≤ 7)
    (R : MvPolynomial (Fin 2) ℤ) (hRh : R.IsHomogeneous n)
    (hR0 : R ≠ 0) (hroots : ThreeProjectiveZeros R)
    (M : ℤ) (hM : M ≠ 0) :
    ∃ T : Finset (ℤ×ℤ),
      (∀ rs : ℤ×ℤ, Int.gcd rs.1 rs.2=1 →
        eval ![rs.1,rs.2] R ∣ M → rs ∈ T) ∧
      T.card ≤ 39200*M.natAbs.divisors.card^8 := by
  classical
  obtain ⟨q,a,hq3,hqn,hcontent,hsqf,hkernel⟩ :=
    C01.PcKer.p_kernel n R hRh hR0 hroots
  have hq7 : q ≤ 7 := hqn.trans hn7
  let F : ℤ×ℤ → ℤ := fun rs =>
    ∑ i : Fin (q+1), a i*rs.1^(i:ℕ)*rs.2^(q-(i:ℕ))
  obtain ⟨T,hTmem,hTcard⟩ := C01.PcLowdegRed.count_T F q (by omega)
    (hSt q hq3 a hcontent hsqf) M hM
  refine ⟨T,?_,?_⟩
  · intro rs hp hdvd
    exact hTmem rs hp ((hkernel rs.1 rs.2).trans hdvd)
  · have hn0 : M.natAbs ≠ 0 := Int.natAbs_ne_zero.mpr hM
    have hω : 2^M.natAbs.primeFactors.card ≤ M.natAbs.divisors.card :=
      C01.PcLowdegRed.two_pow_card_primeFactors_le _ hn0
    have hqpow : q^(1+M.natAbs.primeFactors.card) ≤
        7*M.natAbs.divisors.card^7 := by
      calc
        q^(1+M.natAbs.primeFactors.card) ≤ 7^(1+M.natAbs.primeFactors.card) :=
          Nat.pow_le_pow_left hq7 _
        _ = 7*7^M.natAbs.primeFactors.card := by rw [pow_add,pow_one]
        _ ≤ 7*(2^7)^M.natAbs.primeFactors.card :=
          Nat.mul_le_mul le_rfl (Nat.pow_le_pow_left (by norm_num : 7≤2^7) _)
        _ = 7*(2^M.natAbs.primeFactors.card)^7 := by
          rw [←pow_mul,←pow_mul,Nat.mul_comm 7 M.natAbs.primeFactors.card]
        _ ≤ 7*M.natAbs.divisors.card^7 :=
          Nat.mul_le_mul le_rfl (Nat.pow_le_pow_left hω _)
    calc
      T.card ≤ M.natAbs.divisors.card*
          (2*(2800*q^(1+M.natAbs.primeFactors.card))) := hTcard
      _ ≤ M.natAbs.divisors.card*(2*(2800*(7*M.natAbs.divisors.card^7))) :=
        Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ hqpow))
      _ = 39200*M.natAbs.divisors.card^8 := by ring

private lemma two_linear_divisor_cover (n : ℕ) (R : MvPolynomial (Fin 2) ℤ)
    (hR : IntegralTwoLines n R) (M : ℤ) (hM : M ≠ 0) :
    ∃ T : Finset (ℤ×ℤ),
      (∀ rs : ℤ×ℤ, Int.gcd rs.1 rs.2=1 →
        eval ![rs.1,rs.2] R ∣ M → rs ∈ T) ∧
      T.card ≤ 4*M.natAbs.divisors.card^2 := by
  classical
  obtain ⟨c,a,b,a',b',j,hc,hdet,hj,hjn,hfac⟩ := hR
  let φ : ℤ×ℤ → ℤ×ℤ := fun rs => (a*rs.1+b*rs.2,a'*rs.1+b'*rs.2)
  let S : Set (ℤ×ℤ) :=
    {rs | Int.gcd rs.1 rs.2=1 ∧ eval ![rs.1,rs.2] R ∣ M}
  let U := (signedDivisors M) ×ˢ (signedDivisors M)
  have hφ := linear_pair_injective a b a' b' hdet
  have hmap : ∀ rs ∈ S, φ rs ∈ (↑U : Set (ℤ×ℤ)) := by
    intro rs hrs
    have heval : eval ![rs.1,rs.2] R =
        c*(a*rs.1+b*rs.2)^j*(a'*rs.1+b'*rs.2)^(n-j) := by
      rw [hfac]
      simp []
    have h1 : a*rs.1+b*rs.2 ∣ eval ![rs.1,rs.2] R := by
      rw [heval]
      exact dvd_mul_of_dvd_left
        (dvd_mul_of_dvd_right (dvd_pow_self _ (by omega : j ≠ 0)) c) _
    have h2 : a'*rs.1+b'*rs.2 ∣ eval ![rs.1,rs.2] R := by
      rw [heval]
      exact dvd_mul_of_dvd_right
        (dvd_pow_self _ (by omega : n-j ≠ 0)) _
    exact Finset.mem_product.mpr
      ⟨mem_signedDivisors M _ hM (h1.trans hrs.2),
       mem_signedDivisors M _ hM (h2.trans hrs.2)⟩
  have himg : (φ '' S).Finite :=
    (Finset.finite_toSet U).subset (by rintro _ ⟨rs,hrs,rfl⟩; exact hmap rs hrs)
  have hfin : S.Finite := Set.Finite.of_finite_image himg hφ.injOn
  refine ⟨hfin.toFinset,?_,?_⟩
  · intro rs hp hdvd
    exact hfin.mem_toFinset.mpr ⟨hp,hdvd⟩
  · have hs : S.ncard ≤ U.card := by
      calc
        S.ncard ≤ (↑U : Set (ℤ×ℤ)).ncard :=
          Set.ncard_le_ncard_of_injOn φ hmap hφ.injOn (Finset.finite_toSet U)
        _ = U.card := Set.ncard_coe_finset U
    rw [← Set.ncard_eq_toFinset_card S hfin]
    calc
      S.ncard ≤ U.card := hs
      _ = (signedDivisors M).card*(signedDivisors M).card := Finset.card_product _ _
      _ ≤ (2*M.natAbs.divisors.card)*(2*M.natAbs.divisors.card) :=
        Nat.mul_le_mul (signedDivisors_card M) (signedDivisors_card M)
      _ = 4*M.natAbs.divisors.card^2 := by ring

private theorem original_graph_coordinate_cap
    (x : ℝ) (hx : 2≤x) (d e u v : ℕ)
    (hd : 1≤d) (he : 1≤e) (hu : 1≤u) (hv : 1≤v)
    (hunit : e^3*v=d^3*u+1) (hcut : ((d^3*u:ℕ):ℝ)≤x) :
    (d:ℝ)≤2*x ∧ (e:ℝ)≤2*x ∧ (u:ℝ)≤2*x ∧ (v:ℝ)≤2*x := by
  have hdR : (1:ℝ)≤d := by exact_mod_cast hd
  have heR : (1:ℝ)≤e := by exact_mod_cast he
  have huR : (1:ℝ)≤u := by exact_mod_cast hu
  have hvR : (1:ℝ)≤v := by exact_mod_cast hv
  have hunitR : (e:ℝ)^3*(v:ℝ)=(d:ℝ)^3*(u:ℝ)+1 := by exact_mod_cast hunit
  have hcutR : (d:ℝ)^3*(u:ℝ)≤x := by
    simpa only [Nat.cast_mul,Nat.cast_pow] using hcut
  have hc : ∀z:ℝ,1≤z → z≤z^3 := by
    intro z hz
    calc
      z=z*1 := by ring
      _ ≤z*z^2 := mul_le_mul_of_nonneg_left (one_le_pow₀ hz) (by linarith)
      _ =z^3 := by ring
  have hdN : (d:ℝ)≤(d:ℝ)^3*(u:ℝ) := by
    calc
      (d:ℝ)≤(d:ℝ)^3 := hc d hdR
