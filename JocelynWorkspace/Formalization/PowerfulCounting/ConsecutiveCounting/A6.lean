private theorem dM
 (a b c R S d₀ e₀ u₀ v₀:I)
 (hab:bt a b = 1) (hc:c ≠ 0)
 (hK:co a b c R S ≠ 0)
 (hF₀:e₀ ^ 3 * v₀ = d₀ ^ 3 * u₀ + 1)
 (hG₀:pNF a b c R S d₀ e₀ * u₀ -
 qNF a b c R S d₀ e₀ * v₀ = 0):
