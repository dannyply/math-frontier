theorem cubic_value_dvd_det
    (A B C D d e u v h : ℤ)
    (hh : h = 1 ∨ h = -1)
    (hs : e ^ 2 * v = d ^ 2 * u + h)
    (hg : (A * d + B * e) * u = (C * d + D * e) * v) :
    (e ^ 2 * (A * d + B * e) - d ^ 2 * (C * d + D * e)) ∣
      (A * D - B * C) := by
  let X : ℤ := A * d + B * e
  let Y : ℤ := C * d + D * e
  let R : ℤ := e ^ 2 * X - d ^ 2 * Y
  let T : ℤ := e * v * (A * u - C * v) - d * u * (D * v - B * u)
  have hgraph : X * u = Y * v := hg
  have hshift : e ^ 2 * v - d ^ 2 * u = h := by
    linear_combination hs
  have hsq : h * h = 1 := by
    rcases hh with rfl | rfl <;> norm_num
  have hRv : R * v = h * X := by
    calc
      R * v =
          (e ^ 2 * v - d ^ 2 * u) * X +
            d ^ 2 * (X * u - Y * v) := by
              dsimp [R]
              ring
      _ = h * X := by rw [hshift, hgraph]; ring
  have hRu : R * u = h * Y := by
    calc
      R * u =
          e ^ 2 * (X * u - Y * v) +
            (e ^ 2 * v - d ^ 2 * u) * Y := by
              dsimp [R]
              ring
      _ = h * Y := by rw [hshift, hgraph]; ring
  have hX : X = h * R * v := by
    calc
      X = (h * h) * X := by rw [hsq]; ring
      _ = h * (R * v) := by rw [hRv]; ring
      _ = h * R * v := by ring
  have hY : Y = h * R * u := by
    calc
      Y = (h * h) * Y := by rw [hsq]; ring
      _ = h * (R * u) := by rw [hRu]; ring
      _ = h * R * u := by ring
  have hdetd : (A * D - B * C) * d = h * R * (D * v - B * u) := by
    calc
      (A * D - B * C) * d = D * X - B * Y := by dsimp [X, Y]; ring
      _ = h * R * (D * v - B * u) := by rw [hX, hY]; ring
  have hdete : (A * D - B * C) * e = h * R * (A * u - C * v) := by
    calc
      (A * D - B * C) * e = A * Y - C * X := by dsimp [X, Y]; ring
      _ = h * R * (A * u - C * v) := by rw [hX, hY]; ring
  have hmain : A * D - B * C = R * T := by
    calc
      A * D - B * C = (h * h) * (A * D - B * C) := by rw [hsq]; ring
      _ = h * (A * D - B * C) * (e ^ 2 * v - d ^ 2 * u) := by
        rw [hshift]
        ring
      _ = h * ((A * D - B * C) * e) * (e * v) -
            h * ((A * D - B * C) * d) * (d * u) := by ring
      _ = R * T := by
        rw [hdete, hdetd]
        dsimp [T]
        calc
          h * (h * R * (A * u - C * v)) * (e * v) -
              h * (h * R * (D * v - B * u)) * (d * u) =
                (h * h) * R *
                  (e * v * (A * u - C * v) - d * u * (D * v - B * u)) := by ring
          _ = R * (e * v * (A * u - C * v) - d * u * (D * v - B * u)) := by
            rw [hsq]
            ring
  change R ∣ A * D - B * C
  exact ⟨T, hmain⟩
abbrev Quad := (ℕ × ℕ) × (ℕ × ℕ)
def graphSet (A B C D h : ℤ) : Set Quad :=
  {q | ((q.1.2 ^ 2 * q.2.2 : ℕ) : ℤ) =
        ((q.1.1 ^ 2 * q.2.1 : ℕ) : ℤ) + h ∧
      (A * (q.1.1 : ℤ) + B * (q.1.2 : ℤ)) * (q.2.1 : ℤ) =
        (C * (q.1.1 : ℤ) + D * (q.1.2 : ℤ)) * (q.2.2 : ℤ)}
def pairMap (q : Quad) : ℤ × ℤ := ((q.1.1 : ℤ), (q.1.2 : ℤ))
private theorem cubic_value_identities
    (A B C D d e u v h : ℤ)
    (hs : e ^ 2 * v = d ^ 2 * u + h)
    (hg : (A * d + B * e) * u = (C * d + D * e) * v) :
    let R := e ^ 2 * (A * d + B * e) -
      d ^ 2 * (C * d + D * e)
    R * v = h * (A * d + B * e) ∧
      R * u = h * (C * d + D * e) := by
  let X : ℤ := A * d + B * e
  let Y : ℤ := C * d + D * e
  let R : ℤ := e ^ 2 * X - d ^ 2 * Y
  have hgraph : X * u = Y * v := hg
  have hshift : e ^ 2 * v - d ^ 2 * u = h := by
    linear_combination hs
  change R * v = h * X ∧ R * u = h * Y
  constructor
  · calc
      R * v =
          (e ^ 2 * v - d ^ 2 * u) * X +
            d ^ 2 * (X * u - Y * v) := by
              dsimp [R]
              ring
      _ = h * X := by rw [hshift, hgraph]; ring
  · calc
      R * u =
          e ^ 2 * (X * u - Y * v) +
            (e ^ 2 * v - d ^ 2 * u) * Y := by
              dsimp [R]
              ring
      _ = h * Y := by rw [hshift, hgraph]; ring
theorem graphSet_pairMap_inj
    (A B C D h : ℤ)
    (hsign : h = 1 ∨ h = -1)
    (hdet : A * D - B * C ≠ 0) :
    Set.InjOn pairMap (graphSet A B C D h) := by
  intro q hq q' hq' heq
  rcases q with ⟨⟨d, e⟩, ⟨u, v⟩⟩
  rcases q' with ⟨⟨d', e'⟩, ⟨u', v'⟩⟩
  obtain ⟨hs, hg⟩ := hq
  obtain ⟨hs', hg'⟩ := hq'
  have hdZ : (d : ℤ) = (d' : ℤ) := congrArg Prod.fst heq
  have heZ : (e : ℤ) = (e' : ℤ) := congrArg Prod.snd heq
  have hd : d = d' := by exact_mod_cast hdZ
  have he : e = e' := by exact_mod_cast heZ
  subst d'
  subst e'
  have hsZ : (e : ℤ) ^ 2 * (v : ℤ) =
      (d : ℤ) ^ 2 * (u : ℤ) + h := by exact_mod_cast hs
  have hsZ' : (e : ℤ) ^ 2 * (v' : ℤ) =
      (d : ℤ) ^ 2 * (u' : ℤ) + h := by exact_mod_cast hs'
  let R : ℤ := (e : ℤ) ^ 2 * (A * (d : ℤ) + B * (e : ℤ)) -
    (d : ℤ) ^ 2 * (C * (d : ℤ) + D * (e : ℤ))
  have hdiv : R ∣ A * D - B * C := by
    exact cubic_value_dvd_det A B C D (d : ℤ) (e : ℤ)
      (u : ℤ) (v : ℤ) h hsign hsZ hg
  have hR0 : R ≠ 0 := by
    intro h0
    rw [h0, zero_dvd_iff] at hdiv
    exact hdet hdiv
  have hident := cubic_value_identities A B C D
    (d : ℤ) (e : ℤ) (u : ℤ) (v : ℤ) h hsZ hg
  have hident' := cubic_value_identities A B C D
    (d : ℤ) (e : ℤ) (u' : ℤ) (v' : ℤ) h hsZ' hg'
  have hvZ : (v : ℤ) = (v' : ℤ) := by
    exact mul_left_cancel₀ hR0 (hident.1.trans hident'.1.symm)
  have huZ : (u : ℤ) = (u' : ℤ) := by
    exact mul_left_cancel₀ hR0 (hident.2.trans hident'.2.symm)
  have hu : u = u' := by exact_mod_cast huZ
  have hv : v = v' := by exact_mod_cast hvZ
  exact Prod.ext (Prod.ext rfl rfl) (Prod.ext hu hv)
theorem graphSet_count_of_pair_cover
    (A B C D h : ℤ)
    (hsign : h = 1 ∨ h = -1)
    (hdet : A * D - B * C ≠ 0)
    (T : Finset (ℤ × ℤ))
    (hcover : ∀ q ∈ graphSet A B C D h, pairMap q ∈ T) :
    (graphSet A B C D h).Finite ∧
      (graphSet A B C D h).ncard ≤ T.card := by
  let S := graphSet A B C D h
  have hinj : Set.InjOn pairMap S :=
    graphSet_pairMap_inj A B C D h hsign hdet
  have hmap : ∀ q ∈ S, pairMap q ∈ (↑T : Set (ℤ × ℤ)) := by
    intro q hq
    exact hcover q hq
  have himage : (pairMap '' S).Finite :=
    (Finset.finite_toSet T).subset
      (by rintro _ ⟨q, hq, rfl⟩; exact hmap q hq)
  have hfinite : S.Finite := Set.Finite.of_finite_image himage hinj
  change S.Finite ∧ S.ncard ≤ T.card
  refine ⟨hfinite, ?_⟩
  calc
    S.ncard ≤ (↑T : Set (ℤ × ℤ)).ncard :=
      Set.ncard_le_ncard_of_injOn pairMap hmap hinj
        (Finset.finite_toSet T)
    _ = T.card := Set.ncard_coe_finset T
noncomputable def linearForm (a b : ℤ) : MvPolynomial (Fin 2) ℤ :=
  MvPolynomial.C a * MvPolynomial.X 0 +
    MvPolynomial.C b * MvPolynomial.X 1
def signedDivisors (M : ℤ) : Finset ℤ :=
  M.natAbs.divisors.image (fun n : ℕ => (n : ℤ)) ∪
    M.natAbs.divisors.image (fun n : ℕ => -(n : ℤ))
private lemma mem_signedDivisors (M z : ℤ)
    (hM : M ≠ 0) (hz : z ∣ M) :
    z ∈ signedDivisors M := by
  have habs : z.natAbs ∈ M.natAbs.divisors := by
    exact Nat.mem_divisors.mpr
      ⟨Int.natAbs_dvd_natAbs.mpr hz, Int.natAbs_ne_zero.mpr hM⟩
  rcases Int.natAbs_eq z with h | h
  · exact Finset.mem_union.mpr
      (Or.inl (Finset.mem_image.mpr ⟨_, habs, h.symm⟩))
  · exact Finset.mem_union.mpr
      (Or.inr (Finset.mem_image.mpr ⟨_, habs, h.symm⟩))
private lemma signedDivisors_card (M : ℤ) :
    (signedDivisors M).card ≤ 2 * M.natAbs.divisors.card := by
  calc
    (signedDivisors M).card ≤
        (M.natAbs.divisors.image (fun n : ℕ => (n : ℤ))).card +
        (M.natAbs.divisors.image (fun n : ℕ => -(n : ℤ))).card :=
      Finset.card_union_le _ _
    _ ≤ M.natAbs.divisors.card + M.natAbs.divisors.card :=
      Nat.add_le_add Finset.card_image_le Finset.card_image_le
    _ = 2 * M.natAbs.divisors.card := by omega
private lemma linear_pair_injective (a b a' b' : ℤ)
    (hdet : a * b' - a' * b ≠ 0) :
    Function.Injective (fun rs : ℤ × ℤ =>
      (a * rs.1 + b * rs.2, a' * rs.1 + b' * rs.2)) := by
  intro rs ts ht
  have h1 := congrArg Prod.fst ht
  have h2 := congrArg Prod.snd ht
  dsimp at h1 h2
  have hr : (a * b' - a' * b) * (rs.1 - ts.1) = 0 := by
    linear_combination b' * h1 - b * h2
  have hs : (a * b' - a' * b) * (rs.2 - ts.2) = 0 := by
    linear_combination a * h2 - a' * h1
  exact Prod.ext
    (sub_eq_zero.mp ((mul_eq_zero.mp hr).resolve_left hdet))
    (sub_eq_zero.mp ((mul_eq_zero.mp hs).resolve_left hdet))
theorem two_integral_line_divisor_cover
    (R : MvPolynomial (Fin 2) ℤ) (M : ℤ) (hM : M ≠ 0)
    (a b a' b' : ℤ)
    (hdet : a * b' - a' * b ≠ 0)
    (hL : linearForm a b ∣ R)
    (hL' : linearForm a' b' ∣ R) :
    ∃ T : Finset (ℤ × ℤ),
      (∀ rs : ℤ × ℤ, MvPolynomial.eval ![rs.1, rs.2] R ∣ M →
        rs ∈ T) ∧
      T.card ≤ 4 * M.natAbs.divisors.card ^ 2 := by
  classical
  let φ : ℤ × ℤ → ℤ × ℤ :=
    fun rs => (a * rs.1 + b * rs.2, a' * rs.1 + b' * rs.2)
  let S : Set (ℤ × ℤ) :=
    {rs | MvPolynomial.eval ![rs.1, rs.2] R ∣ M}
  let U := (signedDivisors M) ×ˢ (signedDivisors M)
  have hφ := linear_pair_injective a b a' b' hdet
  have hmap : ∀ rs ∈ S, φ rs ∈ (↑U : Set (ℤ × ℤ)) := by
    intro rs hrs
    have h1 : a * rs.1 + b * rs.2 ∣
        MvPolynomial.eval ![rs.1, rs.2] R := by
      obtain ⟨Q, hQ⟩ := hL
      refine ⟨MvPolynomial.eval ![rs.1, rs.2] Q, ?_⟩
      rw [hQ, MvPolynomial.eval_mul]
      simp [linearForm]
    have h2 : a' * rs.1 + b' * rs.2 ∣
        MvPolynomial.eval ![rs.1, rs.2] R := by
      obtain ⟨Q, hQ⟩ := hL'
      refine ⟨MvPolynomial.eval ![rs.1, rs.2] Q, ?_⟩
      rw [hQ, MvPolynomial.eval_mul]
