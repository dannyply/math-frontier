        s₀-2*R<dR.eval (z:ℝ)/eR.eval (z:ℝ) ∧
        dR.eval (z:ℝ)/eR.eval (z:ℝ)≤ s₀-2*R+(3*C₀)*D/(E*M)
      intro z hz
      obtain ⟨p,hp,rfl⟩:=Finset.mem_image.mp hz
      have hpS:sf p=s := (Finset.mem_filter.mp hp).2
      have hrepr:r p.val=s.1+(s.2:ℤ)*tf p := by simpa only [hpS] using htf p
      obtain ⟨hpos,hn1,hnx,hdlo,hdhi,helo,hehi,hratio,hshift,hmlev,hu,hv⟩:=hT p.val p.property
      obtain ⟨hdp,hep⟩:=hcoords p.val p.property
      have hdInt:p.val 0=m*d₀+b*s.1+(b*(s.2:ℤ))*tf p := by rw [hdp,hrepr]; ring
      have heInt:p.val 1=m*e₀-a*s.1-(a*(s.2:ℤ))*tf p := by rw [hep,hrepr]; ring
      have hdval:dR.eval (tf p:ℝ)=(p.val 0:ℝ) := by
        simp only [dR,eval_add,eval_mul,eval_C,eval_X]
        exact_mod_cast hdInt.symm
      have heval:eR.eval (tf p:ℝ)=(p.val 1:ℝ) := by
        simp only [eR,eval_sub,eval_mul,eval_C,eval_X]
        exact_mod_cast heInt.symm
      have huR:(m:ℝ)^3*(p.val 2:ℝ)=(q:ℝ)*(p.val 1:ℝ)^2-
          (a:ℝ)^2*((a:ℝ)*(p.val 0:ℝ)+3*(b:ℝ)*(p.val 1:ℝ)) := by exact_mod_cast hu
      have hN:NR.eval (tf p:ℝ)=(((p.val 0)^2*p.val 2:ℤ):ℝ) := by
        dsimp only [NR]
        simp only [eval_mul,eval_pow,eval_sub,eval_add,eval_C,hdval,heval]
        push_cast
        rw [←huR]
        field_simp [hmR]
      have hnxR:(p.val 0:ℝ)^2*(p.val 2:ℝ)≤x := by exact_mod_cast hnx
      have hu1:(1:ℝ)≤(p.val 2:ℝ) := by exact_mod_cast (show 1≤p.val 2 by have:=hpos 2; omega)
      have hv1:(1:ℝ)≤(p.val 3:ℝ) := by exact_mod_cast (show 1≤p.val 3 by have:=hpos 3; omega)
      have hd2:(p.val 0:ℝ)^2≤x := by
        have hh:=mul_le_mul_of_nonneg_left hu1 (sq_nonneg (p.val 0:ℝ))
        nlinarith only [hh,hnxR]
      have he2:(p.val 1:ℝ)^2≤2*x := by
        have hh:=mul_le_mul_of_nonneg_left hv1 (sq_nonneg (p.val 1:ℝ))
        have heq:(p.val 1:ℝ)^2*(p.val 3:ℝ)=(p.val 0:ℝ)^2*(p.val 2:ℝ)+1 := by exact_mod_cast hshift
        nlinarith only [hh,heq,hnxR,hx]
      have hn0:(0:ℝ)≤(((p.val 0)^2*p.val 2:ℤ):ℝ) := by
        exact_mod_cast (show 0≤(p.val 0)^2*p.val 2 by omega)
      have hr:=abs_le.mp hratio
      have h3:(3*C₀)*D/(E*M)=3*R := by dsimp [R]; ring
      rw [hdval,heval,hN,h3]
      exact ⟨hdlo,hdhi,helo,hehi,hd2,he2,hn0,hnx,
        by dsimp [R] at hR; linarith [hr.1],
        by linarith [hr.2]⟩
    have hinj:Set.InjOn tf ↑(Tf s) := by
      intro p hp p' hp' hsame
      have hs1:sf p=s := (Finset.mem_filter.mp hp).2
      have hs2:sf p'=s := (Finset.mem_filter.mp hp').2
      have hr:r p.val=r p'.val := by rw [htf p,htf p',hs1,hs2,hsame]
      obtain ⟨hd1,he1⟩:=hcoords p.val p.property
      obtain ⟨hd2,he2⟩:=hcoords p'.val p'.property
      have hd:p.val 0=p'.val 0 := by rw [hd1,hd2,hr]
      have he:p.val 1=p'.val 1 := by rw [he1,he2,hr]
      have hu1: m^3*p.val 2=q*(p.val 1)^2-a^2*(a*p.val 0+3*b*p.val 1) :=
        (hT p.val p.property).2.2.2.2.2.2.2.2.2.2.1
      have hv1: m^3*p.val 3=q*(p.val 0)^2+b^2*(3*a*p.val 0+b*p.val 1) :=
        (hT p.val p.property).2.2.2.2.2.2.2.2.2.2.2
      have hu2: m^3*p'.val 2=q*(p'.val 1)^2-a^2*(a*p'.val 0+3*b*p'.val 1) :=
        (hT p'.val p'.property).2.2.2.2.2.2.2.2.2.2.1
      have hv2: m^3*p'.val 3=q*(p'.val 0)^2+b^2*(3*a*p'.val 0+b*p'.val 1) :=
        (hT p'.val p'.property).2.2.2.2.2.2.2.2.2.2.2
      have hu:p.val 2=p'.val 2 := by
        apply mul_left_cancel₀ (pow_ne_zero 3 hm)
        rw [hu1,hu2,hd,he]
      have hv:p.val 3=p'.val 3 := by
        apply mul_left_cancel₀ (pow_ne_zero 3 hm)
        rw [hv1,hv2,hd,he]
      apply Subtype.ext
      funext i
      fin_cases i <;> assumption
    have himage:(Zf s).card=(Tf s).card := Finset.card_image_iff.mpr hinj
    rw [←himage]
    exact hparam
  have hcard:T.card=∑s∈S,(Tf s).card := by
    have hh:=Finset.card_eq_sum_card_fiberwise (f:=sf) (s:=T.attach) (t:=S)
      (by intro p hp; exact hsf p)
    simpa only [Finset.card_attach,Tf] using hh
  have hScR:(S.card:ℝ)≤(6:ℝ)^m.natAbs.primeFactors.card := by exact_mod_cast hSc
  calc
    (T.card:ℝ)=∑s∈S,((Tf s).card:ℝ) := by exact_mod_cast hcard
    _≤∑s∈S,C*Price := Finset.sum_le_sum hfiber
    _=(S.card:ℝ)*(C*Price) := by simp
    _≤(6:ℝ)^m.natAbs.primeFactors.card*(C*Price) :=
      mul_le_mul_of_nonneg_right hScR (mul_nonneg (by linarith) hPrice)
    _=C*(6:ℝ)^m.natAbs.primeFactors.card*Price := by ring
end A5P2GraphAssembly
namespace A5PureQuarticArithmetic
open MvPolynomial
set_option maxHeartbeats 2000000
set_option maxRecDepth 3000
noncomputable abbrev X₀ : MvPolynomial (Fin 2) ℤ := X 0
noncomputable abbrev X₁ : MvPolynomial (Fin 2) ℤ := X 1
noncomputable abbrev m20 : Fin 2 →₀ ℕ := Finsupp.single 0 2
noncomputable abbrev m11 : Fin 2 →₀ ℕ := Finsupp.single 0 1 + Finsupp.single 1 1
noncomputable abbrev m02 : Fin 2 →₀ ℕ := Finsupp.single 1 2
lemma quadratic_index_three (m : Fin 2 →₀ ℕ)
    (hm : Finsupp.degree m = 2) :
    m = m20 ∨ m = m11 ∨ m = m02 := by
  have hs : m 0 + m 1 = 2 := by
    simpa [Finsupp.degree_eq_sum, Fin.sum_univ_two] using hm
  have hc : m 0 = 0 ∨ m 0 = 1 ∨ m 0 = 2 := by omega
  rcases hc with h0 | h1 | h2
  · right; right
    ext i; fin_cases i <;> simp [m02] <;> omega
  · right; left
    ext i; fin_cases i <;> simp [m11,  Finsupp.add_apply] <;> omega
  · left
    ext i; fin_cases i <;> simp [m20] <;> omega
lemma homogeneous_quadratic_three (P : MvPolynomial (Fin 2) ℤ)
    (hP : P.IsHomogeneous 2) :
    P = monomial m20 (coeff m20 P) + monomial m11 (coeff m11 P) +
      monomial m02 (coeff m02 P) := by
  classical
  have h2011 : m20 ≠ m11 := by
    intro h; have hh := congrArg (fun z : Fin 2 →₀ ℕ => z 0) h
    norm_num [m20,m11,Finsupp.add_apply] at hh
  have h2002 : m20 ≠ m02 := by
    intro h; have hh := congrArg (fun z : Fin 2 →₀ ℕ => z 0) h
    norm_num [m20,m02] at hh
  have h1102 : m11 ≠ m02 := by
    intro h; have hh := congrArg (fun z : Fin 2 →₀ ℕ => z 0) h
    norm_num [m11,m02,Finsupp.add_apply] at hh
  ext m
  simp only [coeff_add, coeff_monomial]
  by_cases h20 : m20 = m
  · subst m; simp [Ne.symm h2011,Ne.symm h2002]
  by_cases h11 : m11 = m
  · subst m; simp [h2011,Ne.symm h1102]
  by_cases h02 : m02 = m
  · subst m; simp [h2002,h1102,]
  have hz : coeff m P = 0 := by
    by_contra hc
    have hd : Finsupp.degree m = 2 := by
      by_contra hn
      exact hc (hP.coeff_eq_zero hn)
    rcases quadratic_index_three m hd with h | h | h
    · exact h20 h.symm
    · exact h11 h.symm
    · exact h02 h.symm
  simp [h20,h11,h02,hz]
lemma homogeneous_quadratic_explicit (P : MvPolynomial (Fin 2) ℤ)
    (hP : P.IsHomogeneous 2) :
    P = C (coeff m20 P) * X₀ ^ 2 +
      C (coeff m11 P) * X₀ * X₁ + C (coeff m02 P) * X₁ ^ 2 := by
  conv_lhs => rw [homogeneous_quadratic_three P hP]
  rw [show m11 = Finsupp.single (0 : Fin 2) 1 + Finsupp.single 1 1 from rfl]
  rw [FormalAB.S4e61b76c.ConsecutiveCountingA5PureCubicNormalForm.monomial_mixed]
  rw [← C_mul_X_pow_eq_monomial, ← C_mul_X_pow_eq_monomial]
  simp only [pow_one]
lemma eval_quadratic (P : MvPolynomial (Fin 2) ℤ)
    (hP : P.IsHomogeneous 2) (t : ℤ) :
    eval ![(1 : ℤ),t] P =
      coeff m20 P + coeff m11 P * t + coeff m02 P * t ^ 2 := by
  conv_lhs => rw [homogeneous_quadratic_explicit P hP]
  simp [X₀,X₁]
lemma five_coefficients
    (p20 p11 p02 q20 q11 q02 a b c : ℤ)
    (h : ∀ t : ℤ, t ^ 2 * (q20 + q11 * t + q02 * t ^ 2) -
      (p20 + p11 * t + p02 * t ^ 2) = c * (a + b * t) ^ 4) :
    p20 = -c * a ^ 4 ∧ p11 = -4 * c * a ^ 3 * b ∧
    q20 - p02 = 6 * c * a ^ 2 * b ^ 2 ∧
    q11 = 4 * c * a * b ^ 3 ∧ q02 = c * b ^ 4 := by
  have h0 := h 0
  have h1 := h 1
  have hm1 := h (-1)
  have h2 := h 2
  have hm2 := h (-2)
  norm_num at h0 h1 hm1 h2 hm2
  constructor
  · nlinarith only [h0]
  constructor
  · nlinarith only [h0,h1,hm1,h2,hm2]
  constructor
  · nlinarith only [h0,h1,hm1,h2,hm2]
  constructor
  · nlinarith only [h0,h1,hm1,h2,hm2]
  · nlinarith only [h0,h1,hm1,h2,hm2]
lemma normal_form
    (P Q : MvPolynomial (Fin 2) ℤ) (a b c : ℤ)
    (hP : P.IsHomogeneous 2) (hQ : Q.IsHomogeneous 2)
    (hcop : IsRelPrime (map (Int.castRingHom ℚ) P)
      (map (Int.castRingHom ℚ) Q))
    (hab : Int.gcd a b = 1)
    (hpure : X₁ ^ 2 * Q - X₀ ^ 2 * P =
      C c * (C a * X₀ + C b * X₁) ^ 4) :
    ∃ K₀ : ℤ, K₀ ≠ 0 ∧
      P = C K₀ * X₁ ^ 2 - C c * (C a * X₀ + C b * X₁) *
        C (a ^ 2) * (C a * X₀ + C (3 * b) * X₁) ∧
      Q = C K₀ * X₀ ^ 2 + C c * (C a * X₀ + C b * X₁) *
        C (b ^ 2) * (C (3 * a) * X₀ + C b * X₁) := by
  have hvals : ∀ t : ℤ,
      t ^ 2 * (coeff m20 Q + coeff m11 Q * t + coeff m02 Q * t ^ 2) -
      (coeff m20 P + coeff m11 P * t + coeff m02 P * t ^ 2) =
        c * (a + b * t) ^ 4 := by
    intro t
    have hh := congrArg (eval ![(1 : ℤ),t]) hpure
    simpa [X₀,X₁,eval_quadratic P hP t,eval_quadratic Q hQ t] using hh
  obtain ⟨h20,h11,hqd,hq11,hq02⟩ := five_coefficients
    (coeff m20 P) (coeff m11 P) (coeff m02 P)
    (coeff m20 Q) (coeff m11 Q) (coeff m02 Q) a b c hvals
  let K₀ := coeff m02 P + 3 * c * a ^ 2 * b ^ 2
  have hq20 : coeff m20 Q = coeff m02 P + 6 * c * a ^ 2 * b ^ 2 := by
    linarith only [hqd]
  have hPn : P = C K₀ * X₁ ^ 2 - C c * (C a * X₀ + C b * X₁) *
      C (a ^ 2) * (C a * X₀ + C (3 * b) * X₁) := by
    conv_lhs => rw [homogeneous_quadratic_explicit P hP]
    dsimp [K₀]
    rw [h20,h11]
    simp [map_add,map_mul,map_pow,map_neg]  ; ring
  have hQn : Q = C K₀ * X₀ ^ 2 + C c * (C a * X₀ + C b * X₁) *
      C (b ^ 2) * (C (3 * a) * X₀ + C b * X₁) := by
    conv_lhs => rw [homogeneous_quadratic_explicit Q hQ]
    dsimp [K₀]
    rw [hq20,hq11,hq02]
    simp [map_add,map_mul,map_pow]  ; ring
  have habnz : a ≠ 0 ∨ b ≠ 0 := by
    by_contra hz
    push Not at hz
    obtain ⟨ha,hb⟩ := hz
    simp [ha,hb] at hab
  have hK : K₀ ≠ 0 := by
    intro hz
    let Lq : MvPolynomial (Fin 2) ℚ :=
      C (a : ℚ) * X 0 + C (b : ℚ) * X 1
    have hpZ : (C a * X₀ + C b * X₁) ∣ P := by
      refine ⟨-C c * C (a ^ 2) * (C a * X₀ + C (3 * b) * X₁), ?_⟩
      rw [hPn,hz]
      simp only [map_zero,zero_mul,zero_sub]
      ring
    have hqZ : (C a * X₀ + C b * X₁) ∣ Q := by
      refine ⟨C c * C (b ^ 2) * (C (3 * a) * X₀ + C b * X₁), ?_⟩
      rw [hQn,hz]
      simp only [map_zero,zero_mul,zero_add]
      ring
    have hpL : Lq ∣ map (Int.castRingHom ℚ) P := by
      obtain ⟨T,hT⟩ := hpZ
      refine ⟨map (Int.castRingHom ℚ) T, ?_⟩
      have hh := congrArg (map (Int.castRingHom ℚ)) hT
      simpa [Lq,X₀,X₁,map_mul,map_add,map_C,map_X] using hh
    have hqL : Lq ∣ map (Int.castRingHom ℚ) Q := by
      obtain ⟨T,hT⟩ := hqZ
      refine ⟨map (Int.castRingHom ℚ) T, ?_⟩
      have hh := congrArg (map (Int.castRingHom ℚ)) hT
      simpa [Lq,X₀,X₁,map_mul,map_add,map_C,map_X] using hh
    have hunit : IsUnit Lq := hcop hpL hqL
    rcases habnz with ha | hb
    · exact (FormalAB.S4e61b76c.ConsecutiveCountingA5PureCubicNormalForm.linear_factor_nonunit_of_a
        (a : ℚ) (b : ℚ) (by exact_mod_cast ha)) hunit
    · exact (FormalAB.S4e61b76c.ConsecutiveCountingA5PureCubicNormalForm.linear_factor_nonunit_of_b
        (a : ℚ) (b : ℚ) (by exact_mod_cast hb)) hunit
  exact ⟨K₀,hK,hPn,hQn⟩
lemma signed_level
    (d e u v pval qval a b c K₀ : ℤ)
    (he : e ≠ 0) (hc : c ≠ 0) (hK : K₀ ≠ 0)
    (hF1 : e ^ 2 * v = d ^ 2 * u + 1)
    (hparallel : u * qval = v * pval)
    (hpure : e ^ 2 * qval - d ^ 2 * pval = c * (a * d + b * e) ^ 4)
    (hPn : pval = K₀ * e ^ 2 - c * (a * d + b * e) *
      a ^ 2 * (a * d + 3 * b * e))
    (hQn : qval = K₀ * d ^ 2 + c * (a * d + b * e) *
      b ^ 2 * (3 * a * d + b * e)) :
    let m : ℤ := a * d + b * e;
    m ≠ 0 ∧ ∃ q : ℤ, K₀ = c * m * q ∧
      m ^ 3 * u = q * e ^ 2 - a ^ 2 * (a * d + 3 * b * e) ∧
      m ^ 3 * v = q * d ^ 2 + b ^ 2 * (3 * a * d + b * e) := by
  intro m
  have hPs : pval = c * m ^ 4 * u := by
    dsimp [m]
    linear_combination u * hpure - e ^ 2 * hparallel - pval * hF1
  have hQs : qval = c * m ^ 4 * v := by
    dsimp [m]
    linear_combination v * hpure - d ^ 2 * hparallel - qval * hF1
  change pval = K₀ * e ^ 2 - c * m * a ^ 2 * (a * d + 3 * b * e) at hPn
  change qval = K₀ * d ^ 2 + c * m * b ^ 2 * (3 * a * d + b * e) at hQn
  have hm : m ≠ 0 := by
    intro hz
    have hpzero : pval = 0 := by simpa [hz] using hPs
    have hprod : K₀ * e ^ 2 = 0 := by simpa [hz,hpzero] using hPn.symm
    exact (mul_ne_zero hK (pow_ne_zero 2 he)) hprod
  have hde := FormalAB.S4e61b76c.ConsecutiveCountingA5PureCubicRange.signed_level_bezout
    d e u v hF1
  have hdvd_e : c * m ∣ K₀ * e ^ 2 := by
    refine ⟨m ^ 3 * u + a ^ 2 * (a * d + 3 * b * e), ?_⟩
    linear_combination hPs - hPn
  have hdvd_d : c * m ∣ K₀ * d ^ 2 := by
    refine ⟨m ^ 3 * v - b ^ 2 * (3 * a * d + b * e), ?_⟩
    linear_combination hQs - hQn
  obtain ⟨q,hq⟩ :=
    FormalAB.S4e61b76c.ConsecutiveCountingA5PureCubicRange.signed_level_dvd_square
      (c * m) K₀ d e (-d * u) (e * v) hde hdvd_d hdvd_e
  refine ⟨hm,q,hq,?_,?_⟩
  · apply mul_left_cancel₀ (mul_ne_zero hc hm)
    calc
      c * m * (m ^ 3 * u) = c * m ^ 4 * u := by ring
      _ = pval := hPs.symm
      _ = c * m * (q * e ^ 2 - a ^ 2 * (a * d + 3 * b * e)) := by
        rw [hPn,hq]; ring
  · apply mul_left_cancel₀ (mul_ne_zero hc hm)
    calc
      c * m * (m ^ 3 * v) = c * m ^ 4 * v := by ring
      _ = qval := hQs.symm
      _ = c * m * (q * d ^ 2 + b ^ 2 * (3 * a * d + b * e)) := by
        rw [hQn,hq]; ring
end A5PureQuarticArithmetic
