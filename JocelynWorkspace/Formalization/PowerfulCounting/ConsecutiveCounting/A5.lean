private theorem fibre_sum_bound {α β : Type*} [DecidableEq α] [DecidableEq β]
    (S : Finset α) (B : Finset β) (f : α → β) (L : ℕ)
    (hmaps : ∀ a ∈ S, f a ∈ B)
    (hfib : ∀ b ∈ B, (S.filter (fun a => f a = b)).card ≤ L) :
    S.card ≤ B.card * L := by
  calc
    S.card = ∑ b ∈ B, (S.filter (fun a => f a = b)).card :=
      Finset.card_eq_sum_card_fiberwise hmaps
    _ ≤ ∑ _b ∈ B, L := Finset.sum_le_sum hfib
    _ = B.card * L := by simp [Finset.sum_const]
