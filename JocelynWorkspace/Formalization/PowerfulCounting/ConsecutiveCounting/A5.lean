  let Price:ℝ:=1+Real.sqrt x/(Real.sqrt M*(D*E)^((1:ℝ)/3))
  have hPrice:0≤Price := by dsimp [Price]; positivity
  have hfiber (s:ℤ×ℕ) (hs:s∈S) : ((Tf s).card:ℝ)≤C*Price := by
    obtain ⟨hJ,hsize,hUi,hVi⟩:=hSg s hs
    have hJZ:0<(s.2:ℤ) := by exact_mod_cast hJ
    have hsizeZ:m.natAbs≤(s.2:ℤ).natAbs := by simpa only [Int.natAbs_natCast] using hsize
    let dR:Polynomial ℝ:=
      Polynomial.C (((m*d₀+b*s.1:ℤ):ℝ))+
        Polynomial.C (((b*(s.2:ℤ):ℤ):ℝ))*Polynomial.X
    let eR:Polynomial ℝ:=
      Polynomial.C (((m*e₀-a*s.1:ℤ):ℝ))-
        Polynomial.C (((a*(s.2:ℤ):ℤ):ℝ))*Polynomial.X
    let NR:Polynomial ℝ:=dR^2*
