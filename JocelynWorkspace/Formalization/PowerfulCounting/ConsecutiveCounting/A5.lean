      1 + Real.log (n : ℝ) / Real.log 2 := by
    have heq : level n =
        FormalAB.S75c3b853.ConsecutiveCountingA5SecondMoments.shellLevel n := by rfl
    rw [heq]
    exact FormalAB.S75c3b853.ConsecutiveCountingA5SecondMoments.shellLevel_log n hn
  have hcap : (cap x : ℝ) ≤
      2 + Real.log (n : ℝ) / Real.log 2 := by
    have heq : cap x = level n + 1 := by rfl
    rw [heq]
    push_cast
    linarith
  have hdiv : Real.log (n : ℝ) / Real.log 2 ≤
      1 + Real.log x / Real.log 2 := by
    rw [hlogmul] at hlogn
    apply (div_le_iff₀ hlog2).mpr
    have hratio : (1 + Real.log x / Real.log 2) * Real.log 2 =
        Real.log 2 + Real.log x := by
      field_simp [ne_of_gt hlog2]
    rw [hratio]
    exact hlogn
  have hcoef : 0 ≤ 1 / Real.log 2 := by positivity
  have hh : (cap x : ℝ) ≤ 3 + Real.log x / Real.log 2 := by linarith
  have hdiveq : Real.log x / Real.log 2 =
      (1 / Real.log 2) * Real.log x := by ring
  rw [hdiveq] at hh
  nlinarith [mul_nonneg hcoef hlogx]
private theorem cap_power (ε : ℝ) (hε : 0 < ε) :
    ∃ C : ℝ, 0 < C ∧
      ∀ x : ℝ, 2 ≤ x → ((cap x : ℝ) ^ 5) ≤ C * x ^ ε := by
  let β : ℝ := ε / 5
  let A : ℝ := 4 + 1 / Real.log 2
  let C : ℝ := (A * (1 + 1 / β)) ^ 5
  have hβ : 0 < β := by dsimp [β]; positivity
  have hA : 0 < A := by dsimp [A]; positivity
  have hC : 0 < C := by dsimp [C]; positivity
  refine ⟨C, hC, ?_⟩
  intro x hx
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hlog := Real.log_le_rpow_div hx0.le hβ
  have hone : (1 : ℝ) ≤ x ^ β := Real.one_le_rpow hx1 hβ.le
  have hlogcap : 1 + Real.log x ≤ (1 + 1 / β) * x ^ β := by
    have hβinv : 0 ≤ 1 / β := by positivity
    have heq : x ^ β / β = (1 / β) * x ^ β := by ring
    rw [heq] at hlog
    nlinarith [mul_nonneg hβinv (show 0 ≤ x ^ β by positivity)]
  have hcap0 : 0 ≤ (cap x : ℝ) := by positivity
  have hcapB : (cap x : ℝ) ≤
      (A * (1 + 1 / β)) * x ^ β := by
    calc
      (cap x : ℝ) ≤ A * (1 + Real.log x) := cap_log x hx
      _ ≤ A * ((1 + 1 / β) * x ^ β) :=
        mul_le_mul_of_nonneg_left hlogcap hA.le
      _ = (A * (1 + 1 / β)) * x ^ β := by ring
  have hp : (x ^ β) ^ 5 = x ^ ε := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul hx0.le]
    have he : β * (5 : ℝ) = ε := by dsimp [β]; ring
    simpa only [Nat.cast_ofNat] using congrArg (fun t : ℝ => x ^ t) he
  calc
    ((cap x : ℝ) ^ 5) ≤ ((A * (1 + 1 / β)) * x ^ β) ^ 5 :=
      pow_le_pow_left₀ hcap0 hcapB 5
    _ = C * x ^ ε := by
      rw [mul_pow, hp]
private theorem bounded_filtered_pair
    (P : ℕ → Prop) (ρ B α x : ℝ)
    (hB : 2 ≤ B) (hx : 2 ≤ x) (hxB : x ≤ B) (hα : 0 ≤ α) :
    let S : Finset ℕ :=
