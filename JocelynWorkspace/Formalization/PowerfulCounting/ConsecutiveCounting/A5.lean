abbrev Quad := (ℕ × ℕ) × (ℕ × ℕ)
private def sign (b : Bool) : ℤ := if b then -1 else 1
private theorem signed_nat_shift (b : Bool) (d e u v : ℕ)
    (heq : (e : ℤ) ^ 2 * (v : ℤ) - (d : ℤ) ^ 2 * (u : ℤ) = sign b) :
    (if b then d ^ 2 * u = e ^ 2 * v + 1
      else e ^ 2 * v = d ^ 2 * u + 1) := by
  cases b
  · change e ^ 2 * v = d ^ 2 * u + 1
    have hh : (e : ℤ) ^ 2 * (v : ℤ) -
        (d : ℤ) ^ 2 * (u : ℤ) = 1 := by simpa [sign] using heq
    have hi : (e : ℤ) ^ 2 * (v : ℤ) =
        (d : ℤ) ^ 2 * (u : ℤ) + 1 := by linarith
    exact_mod_cast hi
  · change d ^ 2 * u = e ^ 2 * v + 1
    have hh : (e : ℤ) ^ 2 * (v : ℤ) -
        (d : ℤ) ^ 2 * (u : ℤ) = -1 := by simpa [sign] using heq
    have hi : (d : ℤ) ^ 2 * (u : ℤ) =
        (e : ℤ) ^ 2 * (v : ℤ) + 1 := by linarith
    exact_mod_cast hi
private theorem coprime_of_unit_shift (m a t u : ℕ)
    (h : m * a = t * u + 1 ∨ t * u = m * a + 1) :
    Nat.Coprime u m := by
  apply Nat.coprime_of_dvd
  intro p hp hpu hpm
  have htu : p ∣ t * u := dvd_mul_of_dvd_right hpu t
  have hma : p ∣ m * a := dvd_mul_of_dvd_left hpm a
  have hp1 : p ∣ 1 := by
    rcases h with h | h
    · have hs : p ∣ t * u + 1 := by rw [← h]; exact hma
      exact (Nat.dvd_add_right htu).mp hs
    · have hs : p ∣ m * a + 1 := by rw [← h]; exact htu
      exact (Nat.dvd_add_right hma).mp hs
  exact hp.one_lt.ne' (Nat.dvd_one.mp hp1)
private theorem pred_coprime (m : ℕ) (hm : 0 < m) :
    Nat.Coprime (m - 1) m := by
  apply Nat.coprime_of_dvd
  intro p hp hpred hmod
  have hsucc : m - 1 + 1 = m := by omega
  have hs : p ∣ (m - 1) + 1 := by simpa only [hsucc] using hmod
  have hp1 : p ∣ 1 := (Nat.dvd_add_right hpred).mp hs
  exact hp.one_lt.ne' (Nat.dvd_one.mp hp1)
private def targetResidue (b : Bool) (m : ℕ) : ℕ :=
  if b then 1 else m - 1
private theorem targetResidue_coprime (b : Bool) (m u : ℕ)
    (hm : 0 < m) (hu : Nat.Coprime u m) :
    Nat.Coprime (u * targetResidue b m) m := by
  have ht : Nat.Coprime (targetResidue b m) m := by
    cases b
    · simpa [targetResidue] using pred_coprime m hm
    · simp [targetResidue]
  exact (Nat.Coprime.mul_right hu.symm ht.symm).symm
private theorem modular_interval_count
    (m N a t : ℕ) (hm : 0 < m) (hcop : Nat.Coprime (a * t) m) :
    ((Finset.Icc 1 N).filter
      (fun d : ℕ => (a : ZMod m) * (d : ZMod m) ^ 2 = t)).card ≤
      2 * m.divisors.card * (N / m + 1) := by
  classical
  have : NeZero m := ⟨by omega⟩
  let R : Finset (ZMod m) :=
    Finset.univ.filter (fun r : ZMod m => (a : ZMod m) * r ^ 2 = t)
  let S : Finset ℕ :=
    (Finset.Icc 1 N).filter
      (fun d : ℕ => (a : ZMod m) * (d : ZMod m) ^ 2 = t)
  have hmap : ∀ d ∈ S, (d : ZMod m) ∈ R := by
    intro d hd
    simp only [S, R, Finset.mem_filter, Finset.mem_univ, true_and] at hd ⊢
    exact hd.2
  have hroot : R.card ≤ 2 * m.divisors.card := by
    simpa only [R] using
      (FormalAB.Se37df572.A2InheritedPell.card_sqrt_le m a t hcop)
  have hfib : ∀ r ∈ R,
      (S.filter (fun d : ℕ => (d : ZMod m) = r)).card ≤ N / m + 1 := by
    intro r hr
    have hsub :
        (S.filter (fun d : ℕ => (d : ZMod m) = r)).card ≤
          ((Finset.Icc 1 N).filter (fun d => d % m = r.val)).card := by
      apply Finset.card_le_card
      intro d hd
      simp only [Finset.mem_filter] at hd ⊢
      have hcast : (d : ZMod m) = (r.val : ZMod m) := by
        simpa only [ZMod.natCast_zmod_val] using hd.2
      have hdvd : (m : ℤ) ∣ (d : ℤ) - (r.val : ℤ) := by
        have hz : (((d : ℤ) - (r.val : ℤ)) : ZMod m) = 0 := by
          push_cast
          rw [hcast, sub_self]
        have hz' : (((d : ℤ) - (r.val : ℤ) : ℤ) : ZMod m) = 0 := by
          simpa only [Int.cast_sub] using hz
        exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ m).mp hz'
      have hmod : r.val % m = d % m :=
        Nat.modEq_iff_dvd.mpr hdvd
      refine ⟨(Finset.mem_filter.mp hd.1).1, ?_⟩
      exact hmod.symm.trans (Nat.mod_eq_of_lt (ZMod.val_lt r))
    exact hsub.trans
      (FormalAB.Sb23c796c.ConsecutiveCountingA5CRT.residue_Icc_bounds
        N m r.val hm (ZMod.val_lt r)).2
  change S.card ≤ _
  rw [Finset.card_eq_sum_card_fiberwise hmap]
  calc
    ∑ r ∈ R, (S.filter (fun d : ℕ => (d : ZMod m) = r)).card
        ≤ ∑ _r ∈ R, (N / m + 1) := Finset.sum_le_sum hfib
    _ = R.card * (N / m + 1) := by simp
    _ ≤ 2 * m.divisors.card * (N / m + 1) :=
      Nat.mul_le_mul_right _ hroot
private theorem unit_coprime_and_root (b : Bool) (d e u v : ℕ)
    (heN : 0 < e)
    (heq : (e : ℤ)^2*(v : ℤ)-(d : ℤ)^2*(u : ℤ)=sign b) :
    Nat.Coprime u (e^2) ∧
      (u : ZMod (e^2))*(d : ZMod (e^2))^2=targetResidue b (e^2) := by
  have hm : 0 < e ^ 2 := pow_pos heN _
  have : NeZero (e ^ 2) := ⟨by omega⟩
  have hs := signed_nat_shift b d e u v heq
  cases b with
  | false =>
      have hshift : e ^ 2 * v = d ^ 2 * u + 1 := by simpa using hs
      have hcop : Nat.Coprime u (e ^ 2) :=
        coprime_of_unit_shift (e ^ 2) v (d ^ 2) u (Or.inl hshift)
      constructor
      · exact hcop
      · let m : ℕ := e ^ 2
        have hplus : m - 1 + 1 = m := by dsimp [m]; omega
        have hzero : ((d ^ 2 * u : ℕ) : ZMod m) + 1 = 0 := by
          calc
            ((d ^ 2 * u : ℕ) : ZMod m) + 1 =
                ((d ^ 2 * u + 1 : ℕ) : ZMod m) := by push_cast; ring
            _ = ((e ^ 2 * v : ℕ) : ZMod m) :=
                congrArg (fun n : ℕ => (n : ZMod m)) hshift.symm
            _ = 0 := by dsimp [m]; simp
        have htarget : (((m - 1 : ℕ) : ZMod m) + 1) = 0 := by
          calc
            (((m - 1 : ℕ) : ZMod m) + 1) =
                ((m - 1 + 1 : ℕ) : ZMod m) := by push_cast; ring
            _ = (m : ZMod m) := congrArg (fun n : ℕ => (n : ZMod m)) hplus
            _ = 0 := by simp
        have hroot : ((d ^ 2 * u : ℕ) : ZMod m) = ((m - 1 : ℕ) : ZMod m) :=
          add_right_cancel (hzero.trans htarget.symm)
        simpa [m, targetResidue, mul_comm] using hroot
  | true =>
      have hshift : d ^ 2 * u = e ^ 2 * v + 1 := by simpa using hs
      have hcop : Nat.Coprime u (e ^ 2) :=
        coprime_of_unit_shift (e ^ 2) v (d ^ 2) u (Or.inr hshift)
      constructor
      · exact hcop
      · let m : ℕ := e ^ 2
        have hroot : ((d ^ 2 * u : ℕ) : ZMod m) = 1 := by
          calc
            ((d ^ 2 * u : ℕ) : ZMod m) =
                ((e ^ 2 * v + 1 : ℕ) : ZMod m) :=
                  congrArg (fun n : ℕ => (n : ZMod m)) hshift
            _ = 1 := by dsimp [m]; simp
        simpa [m, targetResidue, mul_comm] using hroot
private theorem point_v_unique (b : Bool) (d e u v v' : ℕ)
    (he : 0 < e)
    (h : (e : ℤ) ^ 2 * (v : ℤ) -
      (d : ℤ) ^ 2 * (u : ℤ) = sign b)
    (h' : (e : ℤ) ^ 2 * (v' : ℤ) -
      (d : ℤ) ^ 2 * (u : ℤ) = sign b) :
    v = v' := by
  have hmul : (e : ℤ) ^ 2 * (v : ℤ) =
      (e : ℤ) ^ 2 * (v' : ℤ) := by linarith
  have he0 : (e : ℤ) ^ 2 ≠ 0 := pow_ne_zero _ (by exact_mod_cast (Nat.ne_of_gt he))
  have hz : (v : ℤ) = (v' : ℤ) := mul_left_cancel₀ he0 hmul
  exact_mod_cast hz
private def AxisData (b : Bool) (x D E U : ℝ) (q : Quad) : Prop :=
  1 ≤ q.1.1 ∧ 1 ≤ q.1.2 ∧ 1 ≤ q.2.1 ∧ 1 ≤ q.2.2 ∧
  D/2 < (q.1.1 : ℝ) ∧ (q.1.1 : ℝ) ≤ D ∧
  E/2 < (q.1.2 : ℝ) ∧ (q.1.2 : ℝ) ≤ E ∧
  (q.2.1 : ℝ) ≤ U ∧ (q.1.2 : ℝ)^2 ≤ 2*x ∧
  (q.1.2 : ℤ)^2*(q.2.2 : ℤ)-(q.1.1 : ℤ)^2*(q.2.1 : ℤ)=sign b
private def label (q : Quad) : ℕ × ℕ := (q.1.2,q.2.1)
private theorem axis_injective (b : Bool) (x D E U : ℝ)
    (q r : Quad) (hq : AxisData b x D E U q) (hr : AxisData b x D E U r)
    (hd : q.1.1=r.1.1) (he : q.1.2=r.1.2) (hu : q.2.1=r.2.1) : q=r := by
  rcases q with ⟨⟨d,e⟩,⟨u,v⟩⟩
  rcases r with ⟨⟨d',e'⟩,⟨u',v'⟩⟩
  dsimp only at hd he hu
  subst d'; subst e'; subst u'
  have heN : 0 < e := by have hh : 1 ≤ e := hq.2.1; omega
  have hv := point_v_unique b d e u v v' heN hq.2.2.2.2.2.2.2.2.2.2
    hr.2.2.2.2.2.2.2.2.2.2
  subst v'
  rfl
private theorem axis_fibre (b : Bool) (x D E U : ℝ) (S : Finset Quad)
    (hS : ∀ q ∈ S, AxisData b x D E U q)
    (t : ℕ × ℕ) (ht : t ∈ S.image label) :
    (S.filter (fun q => label q=t)).card ≤
      2*(t.1^2).divisors.card*(⌈D⌉₊/(t.1^2)+1) := by
  classical
  obtain ⟨q₀,hq₀,hlabel⟩ := Finset.mem_image.mp ht
  have hq := hS q₀ hq₀
  have hte : q₀.1.2=t.1 := congrArg Prod.fst hlabel
  have htu : q₀.2.1=t.2 := congrArg Prod.snd hlabel
  have htpos : 0 < t.1 := by have hh := hq.2.1; omega
  have hm : 0 < t.1^2 := pow_pos htpos _
  have hc₀ := (unit_coprime_and_root b q₀.1.1 q₀.1.2 q₀.2.1 q₀.2.2
    (by have hh := hq.2.1; omega) hq.2.2.2.2.2.2.2.2.2.2).1
  have hc : Nat.Coprime t.2 (t.1^2) := by simpa only [←hte,←htu] using hc₀
  have hcop := targetResidue_coprime b (t.1^2) t.2 hm hc
  have hmap :
      (S.filter (fun q => label q=t)).card ≤
      ((Finset.Icc 1 ⌈D⌉₊).filter
        (fun d : ℕ => (t.2 : ZMod (t.1^2))*(d : ZMod (t.1^2))^2 =
          targetResidue b (t.1^2))).card := by
    apply Finset.card_le_card_of_injOn (fun q : Quad => q.1.1)
    · intro q hqf
      obtain ⟨hqs,hqt⟩ := Finset.mem_filter.mp hqf
      have hqd := hS q hqs
      have he : q.1.2=t.1 := congrArg Prod.fst hqt
      have hu : q.2.1=t.2 := congrArg Prod.snd hqt
      have hdN : q.1.1 ≤ ⌈D⌉₊ := by
        have hh : (q.1.1 : ℝ) ≤ (⌈D⌉₊ : ℝ) :=
          hqd.2.2.2.2.2.1.trans (Nat.le_ceil D)
        exact_mod_cast hh
      have hroot := (unit_coprime_and_root b q.1.1 q.1.2 q.2.1 q.2.2
        (by have hh := hqd.2.1; omega) hqd.2.2.2.2.2.2.2.2.2.2).2
      refine Finset.mem_filter.mpr ⟨Finset.mem_Icc.mpr ⟨hqd.1,hdN⟩,?_⟩
      rw [←he,←hu]
      exact hroot
    · intro q hq r hr hdd
      obtain ⟨hqs,hqt⟩ := Finset.mem_filter.mp hq
      obtain ⟨hrs,hrt⟩ := Finset.mem_filter.mp hr
      have heq : label q=label r := hqt.trans hrt.symm
      exact axis_injective b x D E U q r (hS q hqs) (hS r hrs)
        hdd (congrArg Prod.fst heq) (congrArg Prod.snd heq)
  exact hmap.trans (modular_interval_count (t.1^2) ⌈D⌉₊ t.2
    (targetResidue b (t.1^2)) hm hcop)
private theorem label_card (b : Bool) (x D E U : ℝ) (S : Finset Quad)
    (hS : ∀ q ∈ S, AxisData b x D E U q)
    (hE : 1 ≤ E) (hU : 1 ≤ U) :
    ((S.image label).card : ℝ) ≤ 4*E*U := by
  classical
  have hsub : S.image label ⊆ (Finset.Icc 1 ⌈E⌉₊) ×ˢ (Finset.Icc 1 ⌈U⌉₊) := by
    intro t ht
    obtain ⟨q,hq,rfl⟩ := Finset.mem_image.mp ht
    have hh := hS q hq
    have he : q.1.2 ≤ ⌈E⌉₊ := by
      have : (q.1.2 : ℝ) ≤ (⌈E⌉₊ : ℝ) :=
        hh.2.2.2.2.2.2.2.1.trans (Nat.le_ceil E)
      exact_mod_cast this
    have hu : q.2.1 ≤ ⌈U⌉₊ := by
      have : (q.2.1 : ℝ) ≤ (⌈U⌉₊ : ℝ) :=
        hh.2.2.2.2.2.2.2.2.1.trans (Nat.le_ceil U)
      exact_mod_cast this
    simp only [label,Finset.mem_product,Finset.mem_Icc]
    exact ⟨⟨hh.2.1,he⟩,⟨hh.2.2.1,hu⟩⟩
  have hc : (S.image label).card ≤ ⌈E⌉₊*⌈U⌉₊ := by
    simpa using Finset.card_le_card hsub
  have hec : (⌈E⌉₊ : ℝ) ≤ 2*E := by
    have hh := Nat.ceil_lt_add_one (show 0 ≤ E by linarith)
    linarith
  have huc : (⌈U⌉₊ : ℝ) ≤ 2*U := by
    have hh := Nat.ceil_lt_add_one (show 0 ≤ U by linarith)
    linarith
  have hcr : ((S.image label).card : ℝ) ≤ (⌈E⌉₊ : ℝ)*(⌈U⌉₊ : ℝ) := by
    exact_mod_cast hc
  have hm := mul_le_mul hec huc (Nat.cast_nonneg _) (by linarith)
  nlinarith
private theorem axis_numeric (A x D E U : ℝ)
    (hA : 0 ≤ A) (hD : 0 < D) (hE : 0 < E) (hU : 0 ≤ U)
    (hcap : D^2*U ≤ 8*x) :
    A*(8*D*U/E+E*U) ≤ 64*A*(x/(D*E)+E*U) := by
  have hDE : 0 < D*E := mul_pos hD hE
  have hh := mul_le_mul_of_nonneg_right hcap hE.le
  have hmain : 8*D*U/E ≤ 64*x/(D*E) := by
    apply (div_le_div_iff₀ hE hDE).mpr
    nlinarith [hh]
  have ht : 0 ≤ E*U := mul_nonneg hE.le hU
  calc
    A*(8*D*U/E+E*U) ≤ A*(64*x/(D*E)+E*U) :=
      mul_le_mul_of_nonneg_left (by linarith) hA
    _ = 64*A*(x/(D*E))+A*(E*U) := by ring
    _ ≤ 64*A*(x/(D*E))+64*A*(E*U) := by nlinarith [mul_nonneg hA ht]
    _ = 64*A*(x/(D*E)+E*U) := by ring
private theorem one_axis_count
    (ε Cdiv x D E U : ℝ) (hε : 0 < ε) (hCdiv : 0 < Cdiv)
    (hx : 0 < x) (hD : 0 < D) (hE : 0 < E) (hU : 0 < U)
    (hdiv : ∀ n : ℕ, 0 < n → (n.divisors.card : ℝ) ≤ Cdiv*(n : ℝ)^ε)
    (b : Bool) (S : Finset Quad)
    (hS : ∀ q ∈ S, AxisData b x D E U q)
    (hcap : D^2*U ≤ 8*x) :
    (S.card : ℝ) ≤ (512*Cdiv*2^ε)*x^ε*(x/(D*E)+E*U) := by
  classical
  let T := S.image label
  rcases S.eq_empty_or_nonempty with rfl | ⟨q₀,hq₀⟩
  · simp only [Finset.card_empty,Nat.cast_zero]
    positivity
  have hq₀d := hS q₀ hq₀
  have hD1 : 1 ≤ D := le_trans (by exact_mod_cast hq₀d.1) hq₀d.2.2.2.2.2.1
  have hE1 : 1 ≤ E := le_trans (by exact_mod_cast hq₀d.2.1) hq₀d.2.2.2.2.2.2.2.1
  have hU1 : 1 ≤ U := le_trans (by exact_mod_cast hq₀d.2.2.1) hq₀d.2.2.2.2.2.2.2.2.1
  have hN : (⌈D⌉₊ : ℝ) ≤ 2*D := by
    have hh := Nat.ceil_lt_add_one hD.le
    linarith
  have hterm : ∀ t ∈ T,
      (((2*(t.1^2).divisors.card*(⌈D⌉₊/(t.1^2)+1) : ℕ) : ℝ)) ≤
        2*Cdiv*2^ε*x^ε*(8*D/E^2+1) := by
    intro t ht
    obtain ⟨q,hq,heql⟩ := Finset.mem_image.mp ht
    have hqd := hS q hq
    have hte : q.1.2=t.1 := congrArg Prod.fst heql
    have htpos : 0 < t.1 := by have he := hqd.2.1; omega
    have hm : 0 < t.1^2 := pow_pos htpos _
    have hmR : 0 < ((t.1^2 : ℕ) : ℝ) := by exact_mod_cast hm
    have hmBound : ((t.1^2 : ℕ) : ℝ) ≤ 2*x := by
      simpa only [Nat.cast_pow,←hte] using hqd.2.2.2.2.2.2.2.2.2.1
    have hτ : ((t.1^2).divisors.card : ℝ) ≤ Cdiv*2^ε*x^ε := by
      calc
        _ ≤ Cdiv*(((t.1^2 : ℕ) : ℝ))^ε := hdiv _ hm
        _ ≤ Cdiv*(2*x)^ε := mul_le_mul_of_nonneg_left
          (Real.rpow_le_rpow (by positivity) hmBound hε.le) hCdiv.le
        _ = Cdiv*2^ε*x^ε := by
          rw [Real.mul_rpow (by norm_num : (0 : ℝ) ≤ 2) hx.le]
          ring
    have hden : (E/2)^2 ≤ ((t.1^2 : ℕ) : ℝ) := by
      have helo : E/2 < (t.1 : ℝ) := by simpa only [←hte] using hqd.2.2.2.2.2.2.1
      rw [Nat.cast_pow]
      nlinarith
    have hdivR : ((⌈D⌉₊/(t.1^2) : ℕ) : ℝ)*((t.1^2 : ℕ) : ℝ) ≤ (⌈D⌉₊ : ℝ) := by
      exact_mod_cast (Nat.div_mul_le_self ⌈D⌉₊ (t.1^2))
    have hquot : ((⌈D⌉₊/(t.1^2) : ℕ) : ℝ) ≤ 8*D/E^2 := by
      calc
        _ ≤ (⌈D⌉₊ : ℝ)/((t.1^2 : ℕ) : ℝ) := (le_div_iff₀ hmR).mpr hdivR
        _ ≤ (⌈D⌉₊ : ℝ)/(E/2)^2 := div_le_div_of_nonneg_left
          (Nat.cast_nonneg _) (sq_pos_of_pos (div_pos hE (by norm_num))) hden
        _ ≤ (2*D)/(E/2)^2 := div_le_div_of_nonneg_right hN (sq_nonneg _)
        _ = 8*D/E^2 := by field_simp ; ring
    have hqplus : ((⌈D⌉₊/(t.1^2)+1 : ℕ) : ℝ) ≤ 8*D/E^2+1 := by
      push_cast
      linarith
    have hp := mul_le_mul hτ hqplus (by positivity) (by positivity)
    push_cast
    nlinarith
  have hsumN : S.card ≤ ∑ t ∈ T, 2*(t.1^2).divisors.card*(⌈D⌉₊/(t.1^2)+1) := by
    have hmap : ∀ q ∈ S, label q ∈ T := by
      intro q hq
      exact Finset.mem_image.mpr ⟨q,hq,rfl⟩
    rw [Finset.card_eq_sum_card_fiberwise hmap]
    exact Finset.sum_le_sum (fun t ht => axis_fibre b x D E U S hS t ht)
  have hsumR : (S.card : ℝ) ≤ ∑ t ∈ T,
      (((2*(t.1^2).divisors.card*(⌈D⌉₊/(t.1^2)+1) : ℕ) : ℝ)) := by
    exact_mod_cast hsumN
  have hsum : (S.card : ℝ) ≤
