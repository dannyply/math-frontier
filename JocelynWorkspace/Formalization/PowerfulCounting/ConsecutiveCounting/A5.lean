private def realEmbedding (D : ℤ) (hD0 : (0 : ℝ) ≤ (D : ℝ)) :
    QuadraticAlgebra ℚ (D : ℚ) 0 →+* ℝ where
  toFun z := (z.re : ℝ)+Real.sqrt (D : ℝ)*(z.im : ℝ)
  map_zero' := by
    change ((0 : ℚ) : ℝ)+Real.sqrt (D : ℝ)*((0 : ℚ) : ℝ)=0
    norm_num
  map_one' := by
    change ((1 : ℚ) : ℝ)+Real.sqrt (D : ℝ)*((0 : ℚ) : ℝ)=1
    norm_num
  map_add' := by
    intro z w
    change (((z.re+w.re : ℚ) : ℝ)+Real.sqrt (D : ℝ)*((z.im+w.im : ℚ) : ℝ)) =
      ((z.re : ℝ)+Real.sqrt (D : ℝ)*(z.im : ℝ))+
      ((w.re : ℝ)+Real.sqrt (D : ℝ)*(w.im : ℝ))
    push_cast
    ring
  map_mul' := by
    intro z w
    change (((z.re*w.re+(D : ℚ)*z.im*w.im : ℚ) : ℝ)+
      Real.sqrt (D : ℝ)*((z.re*w.im+z.im*w.re+(0 : ℚ)*z.im*w.im : ℚ) : ℝ)) =
      ((z.re : ℝ)+Real.sqrt (D : ℝ)*(z.im : ℝ))*
      ((w.re : ℝ)+Real.sqrt (D : ℝ)*(w.im : ℝ))
    push_cast
    linear_combination -((z.im : ℝ)*(w.im : ℝ))*(Real.sq_sqrt hD0)
theorem count : ∀ (D : ℤ) (_hDpos : 0 < D) (hD : ¬ IsSquare D),
  letI : Fact (¬ IsSquare D) := ⟨hD⟩;
  let K := QuadraticAlgebra ℚ (D : ℚ) 0;
  letI : NumberField K :=
    FormalAB.S9f3929ee.A1QuadraticField.quadraticNumberField D;
  let O := NumberField.RingOfIntegers K;
  ∀ H : ℝ, 1 ≤ H → ∀ N : ℤ, N ≠ 0 → ∀ T : Finset O,
    (∀ α ∈ T,
      |((α : K).re : ℝ)| ≤ H ∧ |((α : K).im : ℝ)| ≤ H ∧
      (Algebra.norm ℚ) (α : K) = (N : ℚ)) →
    (∀ α ∈ T, ∀ β ∈ T,
      Ideal.span ({α} : Set O) = Ideal.span ({β} : Set O)) →
    T.card ≤ 4 * ⌈Real.log (H*(1+Real.sqrt (D : ℝ))) / Real.log 2⌉₊ + 2 := by
  classical
  intro D hDpos hD
  let : Fact (¬ IsSquare D) := ⟨hD⟩
  let K := QuadraticAlgebra ℚ (D : ℚ) 0
  let : NumberField K :=
    FormalAB.S9f3929ee.A1QuadraticField.quadraticNumberField D
  let O := NumberField.RingOfIntegers K
  change ∀ H : ℝ, 1 ≤ H → ∀ N : ℤ, N ≠ 0 → ∀ T : Finset O,
    (∀ α ∈ T,
      |((α : K).re : ℝ)| ≤ H ∧ |((α : K).im : ℝ)| ≤ H ∧
      (Algebra.norm ℚ) (α : K) = (N : ℚ)) →
    (∀ α ∈ T, ∀ β ∈ T,
      Ideal.span ({α} : Set O) = Ideal.span ({β} : Set O)) →
    T.card ≤ 4*⌈Real.log (H*(1+Real.sqrt (D : ℝ)))/Real.log 2⌉₊+2
  intro H hH N hN T hT hI
  have hD0 : (0 : ℝ) ≤ (D : ℝ) := by exact_mod_cast hDpos.le
  let σ : K →+* ℝ := realEmbedding D hD0
  let r : ℝ := Real.sqrt (D : ℝ)
  let B : ℝ := H*(1+r)
  let f : O → ℝ := fun α => σ (α : K)
  let S : Finset ℝ := T.image f
  have hr : 0 ≤ r := Real.sqrt_nonneg _
  have hB : 1 ≤ B := by
    dsimp [B]
    nlinarith [mul_nonneg (by linarith : 0 ≤ H) hr]
  have hB0 : 0 < B := by linarith
  have hNabsZ : (1 : ℤ) ≤ |N| := by
    have hh : 0 < |N| := abs_pos.mpr hN
    omega
  have hNabs : (1 : ℝ) ≤ |(N : ℝ)| := by exact_mod_cast hNabsZ
  have hbound : ∀ y ∈ S, 1/B ≤ |y| ∧ |y| ≤ B := by
    intro y hy
    obtain ⟨α,hα,rfl⟩ := Finset.mem_image.mp hy
    let z : K := (α : K)
    have ha : |(z.re : ℝ)| ≤ H := (hT α hα).1
    have hb : |(z.im : ℝ)| ≤ H := (hT α hα).2.1
    have hNq : z.re^2-(D : ℚ)*z.im^2=(N : ℚ) := by
      rw [← FormalAB.Sbcd28934.BasisPrivate.norm_formula D z]
      exact (hT α hα).2.2
    have hNr : (z.re : ℝ)^2-(D : ℝ)*(z.im : ℝ)^2=(N : ℝ) := by
      exact_mod_cast hNq
    have hroot : r^2=(D : ℝ) := Real.sq_sqrt hD0
    have hprod : σ z*((z.re : ℝ)-r*(z.im : ℝ))=(N : ℝ) := by
      change ((z.re : ℝ)+r*(z.im : ℝ))*((z.re : ℝ)-r*(z.im : ℝ))=(N : ℝ)
      linear_combination hNr-((z.im : ℝ)^2)*hroot
    have hupper : |f α| ≤ B := by
      change |(z.re : ℝ)+r*(z.im : ℝ)| ≤ B
      calc
        |(z.re : ℝ)+r*(z.im : ℝ)| ≤ |(z.re : ℝ)|+|r*(z.im : ℝ)| :=
          abs_add_le _ _
        _ = |(z.re : ℝ)|+r*|(z.im : ℝ)| := by rw [abs_mul,abs_of_nonneg hr]
        _ ≤ H+r*H := add_le_add ha (mul_le_mul_of_nonneg_left hb hr)
