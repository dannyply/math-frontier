private theorem actual_label_level_recovery
    (a b m d₀ e₀ r₀ J t : ℤ)
    (q : (ℕ × ℕ) × (ℕ × ℕ))
    (hbez : a * d₀ + b * e₀ = 1)
    (hJ : 0 < J)
    (hd : (q.1.1 : ℤ) = m * d₀ + b * (r₀ + J * t))
    (he : (q.1.2 : ℤ) = m * e₀ - a * (r₀ + J * t)) :
    levelR d₀ e₀ q = r₀ + J * t ∧
      levelT d₀ e₀ r₀ J q = t := by
  have hr : levelR d₀ e₀ q = r₀ + J * t := by
    change e₀ * (q.1.1 : ℤ) - d₀ * (q.1.2 : ℤ) = _
    rw [hd, he]
    calc
      e₀ * (m * d₀ + b * (r₀ + J * t)) -
          d₀ * (m * e₀ - a * (r₀ + J * t)) =
        (a * d₀ + b * e₀) * (r₀ + J * t) := by ring
      _ = r₀ + J * t := by rw [hbez]; ring
  refine ⟨hr, ?_⟩
  unfold levelT
  rw [hr, show r₀ + J * t - r₀ = J * t by ring]
  simp [ne_of_gt hJ]
private theorem actual_family_point_coverage
    (x D E M ρ₀ C₀ : ℝ)
    (P Q : MvPolynomial (Fin 2) ℤ)
    (a b d₀ e₀ : ℤ) (F : Finset (ℤ × (ℤ × ℕ)))
    (U V : ℤ → Polynomial ℚ)
    (hbez : a * d₀ + b * e₀ = 1)
    (hstep : ∀ z ∈ F, 0 < z.2.2)
    (hcover : ∀ d e u v : ℕ,
      1 ≤ d → 1 ≤ e → 1 ≤ u → 1 ≤ v →
      (e : ℤ) ^ 2 * (v : ℤ) = (d : ℤ) ^ 2 * (u : ℤ) + 1 →
      (u : ℤ) * MvPolynomial.eval ![(d : ℤ), (e : ℤ)] Q =
        (v : ℤ) * MvPolynomial.eval ![(d : ℤ), (e : ℤ)] P →
      ∃ z ∈ F, ∃ t : ℤ,
        z.1 = a * (d : ℤ) + b * (e : ℤ) ∧
        (d : ℤ) = z.1 * d₀ + b * (z.2.1 + (z.2.2 : ℤ) * t) ∧
        (e : ℤ) = z.1 * e₀ - a * (z.2.1 + (z.2.2 : ℤ) * t) ∧
        (U z.1).eval ((z.2.1 : ℚ) + (z.2.2 : ℚ) * (t : ℚ)) = (u : ℚ) ∧
        (V z.1).eval ((z.2.1 : ℚ) + (z.2.2 : ℚ) * (t : ℚ)) = (v : ℚ)) :
    ∀ q ∈ OriginalS x D E M ρ₀ C₀ P Q,
      ∃ z ∈ F, ∃ t : ℤ,
        q ∈ FixedProgressionS x D E M ρ₀ C₀ P Q
          a b z.1 d₀ e₀ z.2.1 (z.2.2 : ℤ) ∧
        levelT d₀ e₀ z.2.1 (z.2.2 : ℤ) q = t ∧
        (U z.1).eval ((z.2.1 : ℚ) + (z.2.2 : ℚ) * (t : ℚ)) =
          (q.2.1 : ℚ) ∧
        (V z.1).eval ((z.2.1 : ℚ) + (z.2.2 : ℚ) * (t : ℚ)) =
          (q.2.2 : ℚ) := by
  intro q hq
  have hOrig := hq
  rcases hq with
    ⟨hd, he, hu, hv, hF1, hx, hDlo, hDhi, hElo, hEhi,
      hρlo, hρhi, hparallel⟩
  have hF1z : (q.1.2 : ℤ) ^ 2 * (q.2.2 : ℤ) =
      (q.1.1 : ℤ) ^ 2 * (q.2.1 : ℤ) + 1 := by
    simpa only [Nat.cast_mul, Nat.cast_pow] using hF1
  obtain ⟨z, hz, t, hm, hdc, hec, hU, hV⟩ :=
    hcover q.1.1 q.1.2 q.2.1 q.2.2 hd he hu hv hF1z hparallel
  have hJ : (0 : ℤ) < (z.2.2 : ℤ) := by
    exact_mod_cast hstep z hz
  obtain ⟨hr, ht⟩ := actual_label_level_recovery
    a b z.1 d₀ e₀ z.2.1 (z.2.2 : ℤ) t q hbez hJ hdc hec
  refine ⟨z, hz, t, ?_, ht, hU, hV⟩
  change q ∈ OriginalS x D E M ρ₀ C₀ P Q ∧
    a * (q.1.1 : ℤ) + b * (q.1.2 : ℤ) = z.1 ∧
    levelR d₀ e₀ q =
      z.2.1 + (z.2.2 : ℤ) * levelT d₀ e₀ z.2.1 (z.2.2 : ℤ) q
  exact ⟨hOrig, hm.symm, by simpa only [ht] using hr⟩
private theorem actual_originalS_eq_label_union
    (x D E M ρ₀ C₀ : ℝ)
    (P Q : MvPolynomial (Fin 2) ℤ)
    (a b d₀ e₀ : ℤ) (F : Finset (ℤ × (ℤ × ℕ)))
    (hcover : ∀ q ∈ OriginalS x D E M ρ₀ C₀ P Q,
      ∃ z ∈ F, q ∈ FixedProgressionS x D E M ρ₀ C₀ P Q
        a b z.1 d₀ e₀ z.2.1 (z.2.2 : ℤ)) :
    OriginalS x D E M ρ₀ C₀ P Q =
      ⋃ z ∈ F, FixedProgressionS x D E M ρ₀ C₀ P Q
        a b z.1 d₀ e₀ z.2.1 (z.2.2 : ℤ) := by
  ext q
  constructor
  · intro hq
    obtain ⟨z, hz, hqz⟩ := hcover q hq
    exact Set.mem_iUnion.mpr ⟨z, Set.mem_iUnion.mpr ⟨hz, hqz⟩⟩
  · intro hq
    obtain ⟨z, hqz⟩ := Set.mem_iUnion.mp hq
    obtain ⟨hz, hqz⟩ := Set.mem_iUnion.mp hqz
    exact hqz.1
private theorem actual_originalS_ncard_le_label_sum
    (x D E M ρ₀ C₀ : ℝ)
    (P Q : MvPolynomial (Fin 2) ℤ)
    (a b d₀ e₀ : ℤ) (F : Finset (ℤ × (ℤ × ℕ)))
    (hcover : ∀ q ∈ OriginalS x D E M ρ₀ C₀ P Q,
      ∃ z ∈ F, q ∈ FixedProgressionS x D E M ρ₀ C₀ P Q
        a b z.1 d₀ e₀ z.2.1 (z.2.2 : ℤ)) :
    (OriginalS x D E M ρ₀ C₀ P Q).ncard ≤
      ∑ z ∈ F, (FixedProgressionS x D E M ρ₀ C₀ P Q
        a b z.1 d₀ e₀ z.2.1 (z.2.2 : ℤ)).ncard := by
  classical
  let sf := (originalS_finite x D E M ρ₀ C₀ P Q).toFinset
  let fibres : (ℤ × (ℤ × ℕ)) →
      Finset ((ℕ × ℕ) × (ℕ × ℕ)) := fun z =>
    (fixedProgressionS_finite x D E M ρ₀ C₀ P Q
      a b z.1 d₀ e₀ z.2.1 (z.2.2 : ℤ)).toFinset
  have hsub : sf ⊆ F.biUnion fibres := by
    intro q hq
    have hqS : q ∈ OriginalS x D E M ρ₀ C₀ P Q := by
      simpa only [sf, Set.Finite.mem_toFinset] using hq
    obtain ⟨z, hz, hqz⟩ := hcover q hqS
    apply Finset.mem_biUnion.mpr
    refine ⟨z, hz, ?_⟩
    simpa only [fibres, Set.Finite.mem_toFinset] using hqz
  have hscoe : (↑sf : Set ((ℕ × ℕ) × (ℕ × ℕ))) =
