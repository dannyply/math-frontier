theorem claim_bd5254a45575a9ce7bc6fdb5cccca75e33f679f9febe9b1bf9c70cf273fff44a :
∀ (P Q : MvPolynomial (Fin 2) ℤ) (a b c : ℤ),
  P.IsHomogeneous 2 → Q.IsHomogeneous 2 →
  IsRelPrime (MvPolynomial.map (Int.castRingHom ℚ) P)
    (MvPolynomial.map (Int.castRingHom ℚ) Q) →
  Int.gcd a b = 1 → c ≠ 0 →
  let X₀ : MvPolynomial (Fin 2) ℤ := MvPolynomial.X 0;
  let X₁ : MvPolynomial (Fin 2) ℤ := MvPolynomial.X 1;
  let L := MvPolynomial.C a * X₀ + MvPolynomial.C b * X₁;
  X₁ ^ 2 * Q - X₀ ^ 2 * P = MvPolynomial.C c * L ^ 4 →
  ∃ K₀ : ℤ, K₀ ≠ 0 ∧
    P = MvPolynomial.C K₀ * X₁ ^ 2 -
      MvPolynomial.C c * L * MvPolynomial.C (a ^ 2) *
        (MvPolynomial.C a * X₀ + MvPolynomial.C (3 * b) * X₁) ∧
    Q = MvPolynomial.C K₀ * X₀ ^ 2 +
      MvPolynomial.C c * L * MvPolynomial.C (b ^ 2) *
        (MvPolynomial.C (3 * a) * X₀ + MvPolynomial.C b * X₁) ∧
    ∀ d e u v : ℤ, e ≠ 0 →
      e ^ 2 * v = d ^ 2 * u + 1 →
      u * MvPolynomial.eval ![d,e] Q = v * MvPolynomial.eval ![d,e] P →
      let m : ℤ := a * d + b * e;
      m ≠ 0 ∧ ∃ q : ℤ, K₀ = c * m * q ∧
        m ^ 3 * u = q * e ^ 2 - a ^ 2 * (a * d + 3 * b * e) ∧
        m ^ 3 * v = q * d ^ 2 + b ^ 2 * (3 * a * d + b * e) := by
  intro P Q a b c hP hQ hcop hab hc X₀ X₁ L hpure
  obtain ⟨K₀,hK,hPn,hQn⟩ := A5PureQuarticArithmetic.normal_form
    P Q a b c hP hQ hcop hab hpure
  refine ⟨K₀,hK,hPn,hQn,?_⟩
  intro d e u v he hF1 hparallel
  have hpp := congrArg (MvPolynomial.eval ![d,e]) hpure
  have hp := congrArg (MvPolynomial.eval ![d,e]) hPn
  have hq := congrArg (MvPolynomial.eval ![d,e]) hQn
  simp only [X₀,X₁,L,MvPolynomial.eval_sub,MvPolynomial.eval_add,
    MvPolynomial.eval_mul,MvPolynomial.eval_pow,MvPolynomial.eval_C,
    MvPolynomial.eval_X,Matrix.cons_val_zero,Matrix.cons_val_one] at hpp hp hq
  exact A5PureQuarticArithmetic.signed_level d e u v
    (MvPolynomial.eval ![d,e] P) (MvPolynomial.eval ![d,e] Q)
    a b c K₀ he hc hK hF1 hparallel hpp hp hq
end JocelynClaims
