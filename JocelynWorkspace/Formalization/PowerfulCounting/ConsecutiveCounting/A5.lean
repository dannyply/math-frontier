    complexFirstHom 1 F=F := by
  have he : complexFirstHom (1 : Matrix (Fin 2) (Fin 2) ℤ)=RingHom.id _ := by
    apply MvPolynomial.ringHom_ext
    · intro c
      simp [complexFirstHom]
    · intro i
      fin_cases i <;> simp [complexFirstHom,complexFirstSubstitution]
  exact DFunLike.congr_fun he F
