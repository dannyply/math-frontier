    calc
      (unitBudget D H : ℝ) ≤ A*(1+Real.log x) := unit_budget L x hx D H hH hHb hDb
      _ ≤ A*((1+1/e)*x^e) := mul_le_mul_of_nonneg_left hlogbound hA.le
      _ = (A*(1+1/e))*x^e := by ring
  push_cast
  calc
    (n.divisors.card : ℝ)^4 * (unitBudget D H : ℝ) ≤
        (C^4*x^e) * ((A*(1+1/e))*x^e) :=
      mul_le_mul ht4 hu (Nat.cast_nonneg _) (by positivity)
    _ = Cbound*x^ε := by
      have heq : ε = e+e := by dsimp [e]; ring
      rw [heq, Real.rpow_add hx0]
      dsimp [Cbound]
      ring
