theorem rational_power_integral_primitive
    (R:MvPolynomial (Fin 2) ℤ) (A B c:ℚ)
    (hAB:(A,B)≠(0,0)) (hc:c≠0)
    (hR:map (Int.castRingHom ℚ) R=
