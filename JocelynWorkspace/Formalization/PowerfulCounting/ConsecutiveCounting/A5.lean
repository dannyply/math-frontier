lemma mu_half_and_upper (s δ : ℝ)
    (hs : (599/1000 : ℝ) ≤ s) (hs' : s ≤ (5/8 : ℝ))
    (hδ : 0 < δ) (hδ' : δ ≤ (1/2000 : ℝ)) :
    (1/2 : ℝ) < mu s δ ∧ mu s δ ≤ 1 := by
  let Q : ℝ := 13*s^2-14*s+4
  have hQ : 0 ≤ Q := by
    have hh := sq_nonneg (13*s-7)
    dsimp [Q]
    nlinarith
  have hQlt : Q < s^2 := by
    have hh : (3*s-2)*(2*s-1) < 0 :=
      mul_neg_of_neg_of_pos (by linarith) (by linarith)
    dsimp [Q]
    nlinarith
  have hsq : (Real.sqrt Q)^2=Q := Real.sq_sqrt hQ
  have hroot : Real.sqrt Q < s := by
    have hroot0 := Real.sqrt_nonneg Q
    nlinarith
  have hlow : (1/2 : ℝ) < mu s δ := by
    change (1/2 : ℝ) < (1+s-Real.sqrt Q)/2+δ
    linarith
  have hb :=
    FormalAB.Sb751f117.A5CentralOriginalAuxiliary.mu_bounds
      s δ hs hs' hδ hδ'
