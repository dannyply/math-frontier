    simpa only [Fset,dif_pos hm] using ht
  have hTcard : (T.card:ℝ) ≤
      (Menu.card:ℝ)*(Cq*x^(ε/2)) := by
    calc
      (T.card:ℝ) ≤
        ((∑ m∈Menu, (Fset m).card : ℕ):ℝ) := by
          exact_mod_cast Finset.card_biUnion_le
      _ = ∑ m∈Menu, ((Fset m).card:ℝ) := by simp
      _ ≤ ∑ m∈Menu, (Cq*x^(ε/2)) :=
        Finset.sum_le_sum (fun m hm => hFcard m hm)
      _ = (Menu.card:ℝ)*(Cq*x^(ε/2)) := by
        simp only [Finset.sum_const, nsmul_eq_mul]
