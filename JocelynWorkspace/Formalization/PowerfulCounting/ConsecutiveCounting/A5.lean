private theorem quartic_value_divides_resultant
    (C E d e u v h Br : ℤ)
    (hsign : h = 1 ∨ h = -1)
    (hgraph : C * u = E * v)
    (hshift : e ^ 2 * v - d ^ 2 * u = h)
    (hres : (Int.gcd C (-E) : ℤ) ∣ Br)
    (hBr : Br ≠ 0) :
    let R := e ^ 2 * C - d ^ 2 * E
    R ≠ 0 ∧ R ∣ Br := by
  let R : ℤ := e ^ 2 * C - d ^ 2 * E
  have htrans : R * u = h * E ∧ R * v = h * C :=
    graph_shift_transfer C E d e u v h hgraph hshift
  have hRC : R ∣ C := by
    rcases hsign with rfl | rfl
    · refine ⟨v, ?_⟩
      simpa only [one_mul] using htrans.2.symm
    · refine ⟨-v, ?_⟩
      nlinarith [htrans.2]
  have hRE : R ∣ E := by
    rcases hsign with rfl | rfl
    · refine ⟨u, ?_⟩
      simpa only [one_mul] using htrans.1.symm
    · refine ⟨-u, ?_⟩
      nlinarith [htrans.1]
  have hRgcd : R ∣ (Int.gcd C (-E) : ℤ) := by
    first | exact Int.dvd_gcd hRC (dvd_neg.mpr hRE)
          | exact Int.dvd_coe_gcd hRC (dvd_neg.mpr hRE)
  have hRBr : R ∣ Br := hRgcd.trans hres
  have hR0 : R ≠ 0 := by
    intro hz
    rw [hz, zero_dvd_iff] at hRBr
    exact hBr hRBr
  exact ⟨hR0,hRBr⟩
private theorem actual_quartic_eval_eq_elimination
    (G : MvPolynomial (Fin 4) ℤ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = 2 ∧ m 2 + m 3 = 1)
