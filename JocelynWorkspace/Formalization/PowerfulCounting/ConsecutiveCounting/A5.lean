  have hDivBound : (N.divisors.card:ℝ) ≤ Cd*x^(ε/2) := by
    calc
      (N.divisors.card:ℝ) ≤ Cd*(N:ℝ)^δ := hDiv
      _ ≤ Cd*x^(ε/2) :=
        mul_le_mul_of_nonneg_left hNpow (by linarith)
  have hMenuReal :
      (Menu.card:ℝ) ≤ 2*Cd*x^(ε/2) := by
    have hh : (Menu.card:ℝ)≤2*(N.divisors.card:ℝ) := by
      exact_mod_cast hMenuCard
    nlinarith [hDivBound]
  have hHalfNonneg : 0≤Cq*x^(ε/2) := by positivity
  have hExpAdd : x^(ε/2)*x^(ε/2)=x^ε := by
    have hxPos : 0 < x := by linarith
    rw [←Real.rpow_add hxPos]
    congr 1
    ring
  change S.Finite ∧ (S.ncard:ℝ) ≤ Cbound*x^ε
  refine ⟨hSfin,?_⟩
  calc
    (S.ncard:ℝ) ≤ (T.card:ℝ) := by exact_mod_cast hScard
    _ ≤ (Menu.card:ℝ)*(Cq*x^(ε/2)) := hTcard
    _ ≤ (2*Cd*x^(ε/2))*(Cq*x^(ε/2)) :=
      mul_le_mul_of_nonneg_right hMenuReal hHalfNonneg
    _ = Cbound*x^ε := by
      calc
        (2*Cd*x^(ε/2))*(Cq*x^(ε/2)) =
            (2*Cd*Cq)*(x^(ε/2)*x^(ε/2)) := by ring
        _ = Cbound*x^ε := by simpa only [Cbound] using congrArg (fun z : ℝ => (2*Cd*Cq)*z) hExpAdd
end A5QuarticConjugateOriginalGraphFreeze
