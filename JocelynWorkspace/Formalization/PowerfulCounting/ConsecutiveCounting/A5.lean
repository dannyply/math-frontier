    have hbar : |(z.re : ℝ)-r*(z.im : ℝ)| ≤ B := by
      calc
        |(z.re : ℝ)-r*(z.im : ℝ)| ≤ |(z.re : ℝ)|+|r*(z.im : ℝ)| :=
          by simpa only [sub_eq_add_neg,abs_neg] using
            (abs_add_le (z.re : ℝ) (-(r*(z.im : ℝ))))
        _ = |(z.re : ℝ)|+r*|(z.im : ℝ)| := by rw [abs_mul,abs_of_nonneg hr]
