private theorem graph_shift_transfer
    (C E d e u v h : ℤ)
    (hgraph : C * u = E * v)
    (hshift : e ^ 2 * v - d ^ 2 * u = h) :
    let R := e ^ 2 * C - d ^ 2 * E
    R * u = h * E ∧ R * v = h * C := by
  dsimp
  constructor
  · linear_combination e ^ 2 * hgraph + E * hshift
  · linear_combination d ^ 2 * hgraph + C * hshift
private theorem square_value_divides_resultant
    (C E d e u v h B cR F : ℤ)
    (hsign : h = 1 ∨ h = -1)
    (hgraph : C * u = E * v)
    (hshift : e ^ 2 * v - d ^ 2 * u = h)
    (hres : (Int.gcd C (-E) : ℤ) ∣ B)
    (hB : B ≠ 0)
    (hR : e ^ 2 * C - d ^ 2 * E = cR * F ^ 2) :
    F ≠ 0 ∧ F ∣ B ∧
      (∀ u' : ℤ, C * u' = E * v →
        e ^ 2 * v - d ^ 2 * u' = h → u' = u) := by
  let R : ℤ := e ^ 2 * C - d ^ 2 * E
  have htrans : R * u = h * E ∧ R * v = h * C :=
    graph_shift_transfer C E d e u v h hgraph hshift
  have hRC : R ∣ C := by
    rcases hsign with rfl | rfl
    · refine ⟨v, ?_⟩
      simpa only [one_mul] using htrans.2.symm
    · refine ⟨-v, ?_⟩
      nlinarith [htrans.2]
  have hRE : R ∣ E := by
    rcases hsign with rfl | rfl
    · refine ⟨u, ?_⟩
      simpa only [one_mul] using htrans.1.symm
    · refine ⟨-u, ?_⟩
      nlinarith [htrans.1]
  have hRnegE : R ∣ -E := dvd_neg.mpr hRE
  have hRgcd : R ∣ (Int.gcd C (-E) : ℤ) := by
    first | exact Int.dvd_gcd hRC hRnegE | exact Int.dvd_coe_gcd hRC hRnegE
  have hRB : R ∣ B := hRgcd.trans hres
  have hR0 : R ≠ 0 := by
    intro hz
    rw [hz, zero_dvd_iff] at hRB
    exact hB hRB
  have hF0 : F ≠ 0 := by
    intro hz
    apply hR0
    change e ^ 2 * C - d ^ 2 * E = 0
    rw [hR, hz]
    ring
  have hFR : F ∣ R := by
    refine ⟨cR * F, ?_⟩
    change e ^ 2 * C - d ^ 2 * E = F * (cR * F)
    rw [hR]
    ring
  refine ⟨hF0, hFR.trans hRB, ?_⟩
  intro u' hgraph' hshift'
  have htrans' : R * u' = h * E ∧ R * v = h * C :=
    graph_shift_transfer C E d e u' v h hgraph' hshift'
  exact mul_left_cancel₀ hR0 (htrans'.1.trans htrans.1.symm)
