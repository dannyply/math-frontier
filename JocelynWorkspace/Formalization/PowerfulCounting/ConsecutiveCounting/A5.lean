theorem signed_cover (m : ℤ) (hm : m ≠ 0)
    (F G : Polynomial ℤ) (U V : Polynomial ℚ)
    (hF : F.natDegree ≤ 3) (hG : G.natDegree ≤ 3)
    (hFU : F.map (Int.castRingHom ℚ) = C ((m:ℚ)^3)*U)
    (hGV : G.map (Int.castRingHom ℚ) = C ((m:ℚ)^3)*V) :
    ∃ S : Finset (ℤ × ℕ), S.card ≤ 6^m.natAbs.primeFactors.card ∧
      (∀ s ∈ S, 0 < s.2 ∧
        C (m^3) ∣ F.comp (progressionAffine s) ∧
        C (m^3) ∣ G.comp (progressionAffine s) ∧
        (∀ k:ℕ, ∃ z:ℤ, (U.comp (C (s.1:ℚ)+C (s.2:ℚ)*X)).coeff k=(z:ℚ)) ∧
        (∀ k:ℕ, ∃ z:ℤ, (V.comp (C (s.1:ℚ)+C (s.2:ℚ)*X)).coeff k=(z:ℚ))) ∧
      (∀ r:ℤ, (∃u:ℤ,U.eval (r:ℚ)=(u:ℚ)) →
        (∃v:ℤ,V.eval (r:ℚ)=(v:ℚ)) →
