      _ = x^(m)*x^(betaAxis x m D E) :=
        Real.rpow_add hx0 _ _
      _ ≤ (M : ℝ)*x^(betaAxis x m D E) :=
        mul_le_mul_of_nonneg_right hMp (Real.rpow_nonneg hx0.le _)
