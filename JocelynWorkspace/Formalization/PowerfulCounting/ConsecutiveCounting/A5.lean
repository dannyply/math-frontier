  have hlog := Real.log_le_sub_one_of_pos (Real.rpow_pos_of_pos hx0 e)
  rw [Real.log_rpow hx0 e] at hlog
  have hlogbound : 1 + Real.log x ≤ (1 + 1/e) * x^e := by
    have hmul : e * (1 + Real.log x) ≤ e * ((1 + 1/e) * x^e) := by
      have heinv : e * (1/e) = 1 := by field_simp
      nlinarith
    nlinarith only [hmul, he]
