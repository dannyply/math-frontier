    calc
      U*V*(1+Real.log (M : ℝ))+(U^2+V^2)/(M : ℝ) ≤
          U*V*(1+Real.log (M : ℝ))*x^β+3*(U*V)*x^β :=
        add_le_add (by simpa only [mul_one] using hh) haxis
      _ ≤ (U*V)*(13+Real.log (M : ℝ))*x^β := by
        nlinarith [show 0 ≤ U*V*x^β by positivity]
  have hsub :
      Finset.sum (occupiedCells x D E M h)
        (fun j => (secondLength D E U V M Q j)^2) ≤
      Finset.sum (cells D E M)
        (fun j => (secondLength D E U V M Q j)^2) := by
    apply Finset.sum_le_sum_of_subset_of_nonneg (occupied_subset x D E M h)
    intro j hj hj'
    exact sq_nonneg _
  have hprice := logarithmic_price ε x M hε hx hM hMx
  have hUV : U*V=32*x^(2-2*s) := cofactor_product x s D E hx0 hD hE hDE
  calc
    Finset.sum (occupiedCells x D E M h)
        (fun j => (secondLength D E (4*x/D^2) (8*x/E^2) M Q j)^2) ≤
        Cmom*secondMomentScale U V M := hsub.trans hraw
    _ ≤ Cmom*((U*V)*(13+Real.log (M : ℝ))*x^β) :=
      mul_le_mul_of_nonneg_left hscale hCmom
    _ ≤ Cmom*((U*V)*((13+Real.log 2+1/ε)*x^ε)*x^β) :=
      mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_left hprice (mul_pos hU hV).le)
          (Real.rpow_nonneg hx0.le _)) hCmom
    _ = (32*Cmom*(13+Real.log 2+1/ε))*x^ε*x^(2-2*s+β) := by
      rw [hUV,Real.rpow_add hx0]
      ring
private lemma mixed_unit_bound (κ : ℕ) (hκ : 2 ≤ κ)
    (p q : ℝ) (hq : 0 ≤ q) :
    (p^2*q)^((1 : ℝ)/(κ : ℝ)) ≤ 1+p^2+q^2 := by
  let w : ℝ := 1+p^2+q^2
  have hκR : (2 : ℝ) ≤ (κ : ℝ) := by exact_mod_cast hκ
  have hκ0 : (0 : ℝ) < (κ : ℝ) := by linarith
  have hw1 : 1 ≤ w := by dsimp [w]; nlinarith [sq_nonneg p,sq_nonneg q]
  have hw0 : 0 < w := by linarith
  have hpw : p^2 ≤ w := by dsimp [w]; nlinarith [sq_nonneg q]
  have hqw : q^2 ≤ w := by dsimp [w]; nlinarith [sq_nonneg p]
  have hqpow : q^((1 : ℝ)/(κ : ℝ)) =
      (q^2)^((1 : ℝ)/(2*(κ : ℝ))) := by
    rw [powers q hq 2]
    norm_num only [Nat.cast_ofNat]
    congr 1
    field_simp [hκ0.ne']
  have he1 : (1 : ℝ)/(κ : ℝ) ≤ 1/2 := by
    apply (div_le_div_iff₀ hκ0 (by norm_num)).mpr
    linarith
  have he2 : (1 : ℝ)/(2*(κ : ℝ)) ≤ 1/4 := by
    apply (div_le_div_iff₀ (by positivity) (by norm_num)).mpr
    linarith
  calc
    (p^2*q)^((1 : ℝ)/(κ : ℝ)) =
        (p^2)^((1 : ℝ)/(κ : ℝ))*
          (q^2)^((1 : ℝ)/(2*(κ : ℝ))) := by
      rw [Real.mul_rpow (sq_nonneg p) hq,hqpow]
    _ ≤ w^((1 : ℝ)/(κ : ℝ))*w^((1 : ℝ)/(2*(κ : ℝ))) :=
      mul_le_mul
        (Real.rpow_le_rpow (sq_nonneg p) hpw (by positivity))
        (Real.rpow_le_rpow (sq_nonneg q) hqw (by positivity))
        (Real.rpow_nonneg (sq_nonneg q) _) (Real.rpow_nonneg hw0.le _)
    _ = w^((1 : ℝ)/(κ : ℝ)+(1 : ℝ)/(2*(κ : ℝ))) := by
      rw [Real.rpow_add hw0]
    _ ≤ w^(1 : ℝ) :=
      Real.rpow_le_rpow_of_exponent_le hw1 (by linarith)
    _ = 1+p^2+q^2 := by rw [Real.rpow_one]
private lemma scaled_mixed_bound (κ : ℕ) (hκ : 2 ≤ κ)
    (l t r v : ℝ)
    (_hl : 0 ≤ l) (ht : 0 ≤ t) (hr : 0 < r) (hv : 0 < v) :
    (l^2*t)^((1 : ℝ)/(κ : ℝ)) ≤
      (r^2*v)^((1 : ℝ)/(κ : ℝ))*(1+(l/r)^2+(t/v)^2) := by
  have hid : l^2*t=(r^2*v)*((l/r)^2*(t/v)) := by
    field_simp [hr.ne',hv.ne']
    
  calc
    (l^2*t)^((1 : ℝ)/(κ : ℝ)) =
        (r^2*v)^((1 : ℝ)/(κ : ℝ))*
          ((l/r)^2*(t/v))^((1 : ℝ)/(κ : ℝ)) := by
      rw [hid,Real.mul_rpow (by positivity) (by positivity)]
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (mixed_unit_bound κ hκ (l/r) (t/v) (div_nonneg ht hv.le))
      (Real.rpow_nonneg (by positivity) _)
private lemma occupied_card_bound (x D E : ℝ) (M : ℕ) (h : ℤ) (hM : 1 ≤ M) :
    ((occupiedCells x D E M h).card : ℝ) ≤ 4*(M : ℝ) := by
  have hsub : cells D E M ⊆ Finset.range (3*M+1) := by
    intro j hj
    exact ((filter_mem_explicit
      (fun k => D/(2*E) ≤ rho D E M k ∧ rho D E M k ≤ 2*D/E)
      (Classical.decPred _) (Finset.range (3*M+1)) j).mp hj).1
  have h1 := Finset.card_le_card (occupied_subset x D E M h)
  have h2 := Finset.card_le_card hsub
  have hNat : (occupiedCells x D E M h).card ≤ 4*M := by
    simp only [Finset.card_range] at h2
    omega
  exact_mod_cast hNat
private theorem occupied_mixed_moment
    (κ : ℕ) (hκ : 2 ≤ κ)
    (G ε x s m D E : ℝ) (M : ℕ) (L T : ℕ → ℝ) (h : ℤ)
    (_hG : 0 ≤ G) (hε : 0 < ε) (hx : 4 ≤ x) (hM : 1 ≤ M)
    (hMu : (M : ℝ) ≤ 2*x^(m))
    (hL : ∀ j ∈ occupiedCells x D E M h, 0 ≤ L j)
    (hT : ∀ j ∈ occupiedCells x D E M h, 0 ≤ T j)
    (hLm : Finset.sum (occupiedCells x D E M h) (fun j => (L j)^2) ≤
      G*x^ε*x^s)
    (hTm : Finset.sum (occupiedCells x D E M h) (fun j => (T j)^2) ≤
      G*x^ε*x^(2-2*s+betaAxis x m D E)) :
    Finset.sum (occupiedCells x D E M h)
        (fun j => ((L j)^2*T j)^((1 : ℝ)/(κ : ℝ))) ≤
      (8+2*G)*x^ε*x^(fullDegreeExponent κ m (betaAxis x m D E)) := by
  classical
  let J := occupiedCells x D E M h
  let β := betaAxis x m D E
  let r : ℝ := x^((s-m)/2)
  let v : ℝ := x^((2-2*s+β-m)/2)
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hr : 0 < r := Real.rpow_pos_of_pos hx0 _
  have hv : 0 < v := Real.rpow_pos_of_pos hx0 _
  have hr2 : r^2=x^(s-m) := by
    dsimp only [r]
    rw [←Real.rpow_natCast,←Real.rpow_mul hx0.le]
    congr 1
    ring
  have hv2 : v^2=x^(2-2*s+β-m) := by
    dsimp only [v]
    rw [←Real.rpow_natCast,←Real.rpow_mul hx0.le]
    congr 1
    ring
  have hfactor : (r^2*v)^((1 : ℝ)/(κ : ℝ))=
      x^(fullDegreeExponent κ m (betaAxis x m D E)-m) := by
    rw [hr2]
    dsimp only [v]
    rw [←Real.rpow_add hx0,←Real.rpow_mul hx0.le]
    congr 1
    dsimp only [fullDegreeExponent,β]
    have hκ0 : (0 : ℝ) < (κ : ℝ) := by exact_mod_cast (show 0 < κ by omega)
    field_simp [hκ0.ne']
    ; ring
  have hLratio :
      Finset.sum J (fun j => (L j/r)^2) ≤ G*x^ε*x^m := by
    calc
      Finset.sum J (fun j => (L j/r)^2) =
          (Finset.sum J (fun j => (L j)^2))/r^2 := by
        simp only [div_pow,Finset.sum_div]
      _ ≤ (G*x^ε*x^s)/r^2 :=
        div_le_div_of_nonneg_right hLm (sq_nonneg r)
      _ = G*x^ε*(x^s/x^(s-m)) := by rw [hr2]; ring
      _ = G*x^ε*x^m := by
        rw [←Real.rpow_sub hx0]
        congr 2
        ring
  have hTratio :
      Finset.sum J (fun j => (T j/v)^2) ≤ G*x^ε*x^m := by
    calc
      Finset.sum J (fun j => (T j/v)^2) =
          (Finset.sum J (fun j => (T j)^2))/v^2 := by
        simp only [div_pow,Finset.sum_div]
      _ ≤ (G*x^ε*x^(2-2*s+β))/v^2 :=
        div_le_div_of_nonneg_right hTm (sq_nonneg v)
      _ = G*x^ε*(x^(2-2*s+β)/x^(2-2*s+β-m)) := by rw [hv2]; ring
      _ = G*x^ε*x^m := by
        rw [←Real.rpow_sub hx0]
        congr 2
        ring
  have hcard : (J.card : ℝ) ≤ 8*x^m := by
    have hc := occupied_card_bound x D E M h hM
    dsimp only [J]
    linarith
  have hep : 1 ≤ x^ε := Real.one_le_rpow hx1 hε.le
  have hcard' : (J.card : ℝ) ≤ 8*x^ε*x^m := by
    have hh := mul_le_mul_of_nonneg_right hep
      (show 0 ≤ 8*x^m by positivity)
    nlinarith
  have hunit :
      Finset.sum J (fun j => 1+(L j/r)^2+(T j/v)^2) ≤
        (8+2*G)*x^ε*x^m := by
    simp only [Finset.sum_add_distrib,Finset.sum_const,nsmul_eq_mul,mul_one]
    nlinarith
  calc
    Finset.sum J (fun j => ((L j)^2*T j)^((1 : ℝ)/(κ : ℝ))) ≤
        Finset.sum J
          (fun j => (r^2*v)^((1 : ℝ)/(κ : ℝ))*(1+(L j/r)^2+(T j/v)^2)) :=
      Finset.sum_le_sum (by
        intro j hj
        exact scaled_mixed_bound κ hκ (L j) (T j) r v (hL j hj) (hT j hj) hr hv)
    _ = (r^2*v)^((1 : ℝ)/(κ : ℝ))*
        Finset.sum J (fun j => 1+(L j/r)^2+(T j/v)^2) := by
      rw [Finset.mul_sum]
    _ ≤ (r^2*v)^((1 : ℝ)/(κ : ℝ))*((8+2*G)*x^ε*x^m) :=
      mul_le_mul_of_nonneg_left hunit (Real.rpow_nonneg (by positivity) _)
    _ = (8+2*G)*x^ε*
        (x^(fullDegreeExponent κ m (betaAxis x m D E)-m)*x^m) := by rw [hfactor]; ring
    _ = (8+2*G)*x^ε*x^(fullDegreeExponent κ m (betaAxis x m D E)) := by
      rw [←Real.rpow_add hx0]
      congr 2
      ring
private theorem occupied_one_plus_mixed
    (κ : ℕ)
    (G ε x _s m D E : ℝ) (M : ℕ) (L T : ℕ → ℝ) (h : ℤ)
    (hG : 0 ≤ G) (hε : 0 < ε) (hx : 4 ≤ x) (hM : 1 ≤ M)
    (hMu : (M : ℝ) ≤ 2*x^(m))
    (hmix : Finset.sum (occupiedCells x D E M h)
        (fun j => ((L j)^2*T j)^((1 : ℝ)/(κ : ℝ))) ≤
      G*x^ε*x^(fullDegreeExponent κ m (betaAxis x m D E))) :
    Finset.sum (occupiedCells x D E M h)
        (fun j => 1+((L j)^2*T j)^((1 : ℝ)/(κ : ℝ))) ≤
      (8+G)*x^ε*(x^(m)+x^(fullDegreeExponent κ m (betaAxis x m D E))) := by
  have hx0 : 0 < x := by linarith
  have hp : 1 ≤ x^ε := Real.one_le_rpow (by linarith) hε.le
  have hcard : ((occupiedCells x D E M h).card : ℝ) ≤
      8*x^ε*x^(m) := by
    have hc := occupied_card_bound x D E M h hM
    have hh := mul_le_mul_of_nonneg_right hp
      (show 0 ≤ 8*x^(m) by positivity)
    nlinarith
  simp only [Finset.sum_add_distrib,Finset.sum_const,nsmul_eq_mul,mul_one]
  have hcross1 : 0 ≤ 8*x^ε*x^(fullDegreeExponent κ m (betaAxis x m D E)) := by positivity
  have hcross2 : 0 ≤ G*x^ε*x^(m) := by positivity
  nlinarith
private theorem original_high_shell_union
    (κ : ℕ) (h : ℤ)
    (x D E : ℝ) (M : ℕ)
    (k : ℕ → ℕ) (Gs : (j : ℕ) → Fin (k j) → Poly)
    (dg : (j : ℕ) → Fin (k j) → ℕ × ℕ)
    (L T : ℕ → ℝ) (B : ℝ)
    (_hB : 0 ≤ B)
    (hcell : ∀ j ∈ cells D E M,
      (highPopulation κ h x D E M j (k j) (Gs j) (dg j)).Finite ∧
      ((highPopulation κ h x D E M j (k j) (Gs j) (dg j)).ncard : ℝ) ≤
        B*(1+((L j)^2*T j)^((1 : ℝ)/(κ : ℝ)))) :
    (highShellPopulation κ h x D E M k Gs dg).Finite ∧
    ((highShellPopulation κ h x D E M k Gs dg).ncard : ℝ) ≤
      B*Finset.sum (occupiedCells x D E M h)
        (fun j => 1+((L j)^2*T j)^((1 : ℝ)/(κ : ℝ))) := by
  classical
  let J := occupiedCells x D E M h
  let Z : ℕ → Set Point := fun j =>
    highPopulation κ h x D E M j (k j) (Gs j) (dg j)
  have hZfin : ∀ j ∈ J, (Z j).Finite := by
    intro j hj
    exact (hcell j ((occupied_mem x D E M j h).mp hj).1).1
  have hUnion : (⋃ j ∈ J, Z j).Finite :=
    (Finset.finite_toSet J).biUnion hZfin
  have hsub : highShellPopulation κ h x D E M k Gs dg ⊆ ⋃ j ∈ J, Z j := by
    rintro z ⟨hzshell,j,hj,hz⟩
    have hocc : (originalCell x D E M j h).Nonempty := ⟨z,hz.1⟩
    have hjJ : j ∈ J := (occupied_mem x D E M j h).mpr ⟨hj,hocc⟩
    exact Set.mem_iUnion.mpr ⟨j,Set.mem_iUnion.mpr ⟨hjJ,hz⟩⟩
  have hcardNat :
      (highShellPopulation κ h x D E M k Gs dg).ncard ≤
        Finset.sum J (fun j => (Z j).ncard) :=
    (Set.ncard_le_ncard hsub hUnion).trans (Finset.set_ncard_biUnion_le J Z)
  have hcardReal :
      ((highShellPopulation κ h x D E M k Gs dg).ncard : ℝ) ≤
        Finset.sum J (fun j => ((Z j).ncard : ℝ)) := by
    exact_mod_cast hcardNat
  refine ⟨hUnion.subset hsub,hcardReal.trans ?_⟩
  calc
    Finset.sum J (fun j => ((Z j).ncard : ℝ)) ≤
        Finset.sum J (fun j => B*(1+((L j)^2*T j)^((1 : ℝ)/(κ : ℝ)))) :=
      Finset.sum_le_sum (by
        intro j hj
        exact (hcell j ((occupied_mem x D E M j h).mp hj).1).2)
    _ = _ := by rw [Finset.mul_sum]
private theorem actual_both_signs_full_degree_same_family_shell
    (κ q : ℕ) (K Kg c : ℝ) (hκ : 2 ≤ κ)
    (hCC : CCDNAt6 c) :
    ∀ ε : ℝ, 0 < ε → ∃ C : ℝ, 1 ≤ C ∧
      ∀ x s m D E : ℝ, 4 ≤ x → s ≤ 1 → m ≤ 1 → 1 ≤ m+s →
      0 < D → 0 < E → D*E=x^s →
      ∀ M : ℕ, 1 ≤ M → x^m ≤ (M : ℝ) →
        (M : ℝ) ≤ 2*x^m →
      ∀ b : ℕ, b ≤ q →
      ∀ h : ℤ, (h=1 ∨ h= -1) →
      ∀ P Q A B : ℕ → Mat,
      ∀ F : ℕ → Poly, ∀ k : ℕ → ℕ,
      ∀ Gs : (j : ℕ) → Fin (k j) → Poly,
      ∀ dg : (j : ℕ) → Fin (k j) → ℕ × ℕ,
        (∀ j ∈ cells D E M,
          GeometryAt x D E M j Kg (P j) (Q j) (A j) (B j)) →
        (∀ j ∈ cells D E M,
          CoverAt x D E M j q b K h (F j) (k j) (Gs j) (dg j)) →
        (highShellPopulation κ h x D E M k Gs dg).Finite ∧
        ((highShellPopulation κ h x D E M k Gs dg).ncard : ℝ) ≤
          C*x^(2*ε)*(x^m+x^(fullDegreeExponent κ m (betaAxis x m D E))) := by
  classical
  obtain ⟨Cmom,hCmom,hraw⟩ := raw_moments
  intro ε hε
  let G : ℝ := 32*Cmom*(13+Real.log 2+1/ε)
  let A0 : ℝ := (2*(q : ℝ))*priceCoefficient q c ε
  let C0 : ℝ := A0*(16+2*G)
  have hlog2 : 0 ≤ Real.log (2 : ℝ) := Real.log_nonneg (by norm_num)
  have hG : 0 ≤ G := by dsimp [G]; positivity
  have hA0 : 0 ≤ A0 :=
    mul_nonneg (by positivity) (priceCoefficient_nonneg q c ε hε)
  refine ⟨max 1 C0,le_max_left _ _,?_⟩
  intro x s m D E hx hs hm hms hD hE hDE M hM hMp hMu b hbq h hh
    P Q A B F k Gs dg hgeom hcov
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hMx : (M : ℝ) ≤ 2*x := by
    calc
      (M : ℝ) ≤ 2*x^m := hMu
      _ ≤ 2*x^(1 : ℝ) :=
        mul_le_mul_of_nonneg_left
          (Real.rpow_le_rpow_of_exponent_le hx1 hm) (by norm_num)
      _ = 2*x := by rw [Real.rpow_one]
  let U : ℝ := 4*x/D^2
  let V : ℝ := 8*x/E^2
  have hU : 0 < U := by dsimp [U]; positivity
  have hV : 0 < V := by dsimp [V]; positivity
  have hratio : V/U=2*(D/E)^2 := by
    dsimp [U,V]
    field_simp [hD.ne',hE.ne',hx0.ne']
    ; ring
  have hcomp : (D/E)^2/32 ≤ V/U ∧ V/U ≤ 32*(D/E)^2 := by
    rw [hratio]
    constructor <;> nlinarith [sq_nonneg (D/E)]
  have hP0 : ∀ j ∈ cells D E M, col (P j) 0 ≠ 0 := by
    intro j hj
    have ht := hgeom j hj
    dsimp only [GeometryAt] at ht
    rcases ht with ⟨_,_,_,_,_,_,_,_,hP0,_,_⟩
    exact hP0
  have hQ0 : ∀ j ∈ cells D E M, col (Q j) 0 ≠ 0 := by
    intro j hj
    have ht := hgeom j hj
    dsimp only [GeometryAt] at ht
    rcases ht with ⟨_,_,_,_,_,_,_,_,_,hQ0,_⟩
    exact hQ0
  have hmom := hraw D E U V hD hE hU hV M hM hcomp P Q hP0 hQ0
  let L : ℕ → ℝ := firstLength D E M P
  let T : ℕ → ℝ := secondLength D E U V M Q
  have hLmom :
      Finset.sum (occupiedCells x D E M h) (fun j => (L j)^2) ≤
        G*x^ε*x^s := by
    have ht := occupied_first_moment Cmom ε x s m D E M P h hh
      (by linarith) hε hx hms hD hE hDE hM hMx hMp hmom.1
    have hcoeff : Cmom*(13+Real.log 2+1/ε) ≤ G := by
      dsimp [G]
      have hp : 0 ≤ Cmom*(13+Real.log 2+1/ε) := by positivity
      nlinarith
    exact ht.trans
      (mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_right hcoeff (Real.rpow_nonneg hx0.le _))
        (Real.rpow_nonneg hx0.le _))
  have hTmom :
      Finset.sum (occupiedCells x D E M h) (fun j => (T j)^2) ≤
        G*x^ε*x^(2-2*s+betaAxis x m D E) := by
    exact occupied_second_moment Cmom ε x s m D E M Q h
      (by linarith) hε hx hD hE hDE hM hMx hMp hmom.2
  have hmix := occupied_mixed_moment κ hκ G ε x s m D E M L T h
    hG hε hx hM hMu
    (by intro j hj; exact firstLength_nonneg D E M P j)
    (by intro j hj; exact secondLength_nonneg D E U V M Q j) hLmom hTmom
  have hone := occupied_one_plus_mixed κ (8+2*G) ε x s m D E M L T h
    (by linarith) hε hx hM hMu hmix
  have hcell : ∀ j ∈ cells D E M,
      (highPopulation κ h x D E M j (k j) (Gs j) (dg j)).Finite ∧
      ((highPopulation κ h x D E M j (k j) (Gs j) (dg j)).ncard : ℝ) ≤
        (A0*x^ε)*(1+((L j)^2*T j)^((1 : ℝ)/(κ : ℝ))) := by
    intro j hj
    simpa only [A0,L,T,U,V,firstLength,secondLength] using
      actual_high_cell_count κ h (by omega) hh q b K Kg c ε x s D E M j
        (P j) (Q j) (A j) (B j) (F j) (k j) (Gs j) (dg j)
        hCC hε hx hs hD hE hDE hM hbq (hgeom j hj) (hcov j hj)
  have hu := original_high_shell_union κ h x D E M k Gs dg L T (A0*x^ε)
    (mul_nonneg hA0 (Real.rpow_nonneg hx0.le _)) hcell
  refine ⟨hu.1,hu.2.trans ?_⟩
  calc
    (A0*x^ε)*Finset.sum (occupiedCells x D E M h)
        (fun j => 1+((L j)^2*T j)^((1 : ℝ)/(κ : ℝ))) ≤
        (A0*x^ε)*((8+(8+2*G))*x^ε*
          (x^m+x^(fullDegreeExponent κ m (betaAxis x m D E)))) :=
      mul_le_mul_of_nonneg_left hone
        (mul_nonneg hA0 (Real.rpow_nonneg hx0.le _))
    _ = C0*x^(2*ε)*(x^m+x^(fullDegreeExponent κ m (betaAxis x m D E))) := by
      dsimp only [C0]
      rw [show 2*ε=ε+ε by ring,Real.rpow_add hx0]
      ring
    _ ≤ (max 1 C0)*x^(2*ε)*
        (x^m+x^(fullDegreeExponent κ m (betaAxis x m D E))) :=
      mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_right (le_max_right 1 C0)
          (Real.rpow_nonneg hx0.le _)) (by positivity)
private lemma full_degree_exponent_five (m β : ℝ) :
    fullDegreeExponent 5 m β = (2+7*m+β)/10 := by
