    apply (div_le_iff₀ hDs).mpr
    have hm := mul_le_mul_of_nonneg_left hw.1.le hDs.le
    nlinarith
  · have hm := mul_le_mul_of_nonneg_right hw.2 hDs.le
    have hbound : w*D^2 ≤ 8*x := by nlinarith
    have hh : w ≤ (8*x)/D^2 := (le_div_iff₀ hDs).mpr hbound
