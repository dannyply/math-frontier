private theorem two_linear_divisor_cover4
    (R : MvPolynomial (Fin 2) ℤ) (hR : TwoIndependentLines4 R)
    (M : ℤ) (hM : M ≠ 0) :
    ∃ T : Finset (ℤ × ℤ),
      (∀ rs : ℤ × ℤ, Int.gcd rs.1 rs.2 = 1 →
        eval ![rs.1,rs.2] R ∣ M → rs ∈ T) ∧
      T.card ≤ 4 * M.natAbs.divisors.card ^ 2 := by
  classical
  obtain ⟨c,a,b,a',b',j,hc,hdet,hj,hj3,hfac⟩ := hR
  let φ : ℤ × ℤ → ℤ × ℤ :=
    fun rs => (a*rs.1+b*rs.2,a'*rs.1+b'*rs.2)
  let S : Set (ℤ × ℤ) :=
    {rs | Int.gcd rs.1 rs.2 = 1 ∧ eval ![rs.1,rs.2] R ∣ M}
  let U := (signedDivisors M) ×ˢ (signedDivisors M)
  have hφ := linear_pair_injective a b a' b' hdet
  have hmap : ∀ rs ∈ S, φ rs ∈ (↑U : Set (ℤ × ℤ)) := by
    intro rs hrs
    have heval : eval ![rs.1,rs.2] R =
        c * (a*rs.1+b*rs.2)^j *
          (a'*rs.1+b'*rs.2)^(4-j) := by
      rw [hfac]
      simp []
    have h1 : a*rs.1+b*rs.2 ∣ eval ![rs.1,rs.2] R := by
      rw [heval]
      exact dvd_mul_of_dvd_left
        (dvd_mul_of_dvd_right (dvd_pow_self _ (by omega : j ≠ 0)) c) _
    have h2 : a'*rs.1+b'*rs.2 ∣ eval ![rs.1,rs.2] R := by
      rw [heval]
      exact dvd_mul_of_dvd_right
        (dvd_pow_self _ (by omega : 4-j ≠ 0)) _
    exact Finset.mem_product.mpr
      ⟨mem_signedDivisors M _ hM (h1.trans hrs.2),
       mem_signedDivisors M _ hM (h2.trans hrs.2)⟩
  have himg : (φ '' S).Finite :=
    (Finset.finite_toSet U).subset
      (by rintro _ ⟨rs,hrs,rfl⟩; exact hmap rs hrs)
  have hfin : S.Finite := Set.Finite.of_finite_image himg hφ.injOn
  refine ⟨hfin.toFinset,?_,?_⟩
  · intro rs hp hdvd
    exact hfin.mem_toFinset.mpr ⟨hp,hdvd⟩
  · have hs : S.ncard ≤ U.card := by
      calc
        S.ncard ≤ (↑U : Set (ℤ × ℤ)).ncard :=
          Set.ncard_le_ncard_of_injOn φ hmap hφ.injOn
            (Finset.finite_toSet U)
        _ = U.card := Set.ncard_coe_finset U
    rw [← Set.ncard_eq_toFinset_card S hfin]
    calc
      S.ncard ≤ U.card := hs
      _ = (signedDivisors M).card*(signedDivisors M).card :=
        Finset.card_product _ _
      _ ≤ (2*M.natAbs.divisors.card)*
          (2*M.natAbs.divisors.card) :=
        Nat.mul_le_mul (signedDivisors_card M) (signedDivisors_card M)
      _ = 4*M.natAbs.divisors.card^2 := by ring
private theorem three_root_divisor_cover4
    (hSt : StewartHyp)
    (R : MvPolynomial (Fin 2) ℤ)
    (hRh : R.IsHomogeneous 4) (hR0 : R ≠ 0)
    (hroots : HasThreeProjectiveZeros R)
    (M : ℤ) (hM : M ≠ 0) :
    ∃ T : Finset (ℤ × ℤ),
      (∀ rs : ℤ × ℤ, Int.gcd rs.1 rs.2 = 1 →
        eval ![rs.1,rs.2] R ∣ M → rs ∈ T) ∧
      T.card ≤ 28000 * M.natAbs.divisors.card ^ 6 := by
  classical
  have hroots' :
      FormalAB.S84900580.ConsecutiveCountingA5Full12Nonexceptional.ThreeProjectiveZeros R := by
    simpa only [FormalAB.S84900580.ConsecutiveCountingA5Full12Nonexceptional.ThreeProjectiveZeros,
      FormalAB.S84900580.A5PrivateOddRoot.HasThreeProjectiveZeros] using hroots
  obtain ⟨q,a,hq3,hq4,hcontent,hsqf,hkernel⟩ :=
    C01.PcKer.p_kernel 4 R hRh hR0 hroots'
  let F : ℤ × ℤ → ℤ := fun rs =>
    ∑ i : Fin (q+1), a i*rs.1^(i:ℕ)*rs.2^(q-(i:ℕ))
  obtain ⟨T,hTmem,hTcard⟩ :=
    C01.PcLowdegRed.count_T F q (by omega)
      (hSt q hq3 a hcontent hsqf) M hM
  refine ⟨T,?_,?_⟩
  · intro rs hp hdvd
    exact hTmem rs hp ((hkernel rs.1 rs.2).trans hdvd)
  · have hn0 : M.natAbs ≠ 0 := Int.natAbs_ne_zero.mpr hM
    have hω : 2^M.natAbs.primeFactors.card ≤
        M.natAbs.divisors.card :=
      C01.PcLowdegRed.two_pow_card_primeFactors_le _ hn0
    have hq5 : q ≤ 5 := by omega
    have hqpow : q^(1+M.natAbs.primeFactors.card) ≤
        5*M.natAbs.divisors.card^5 := by
      calc
        q^(1+M.natAbs.primeFactors.card) ≤
            5^(1+M.natAbs.primeFactors.card) :=
          Nat.pow_le_pow_left hq5 _
        _ = 5*5^M.natAbs.primeFactors.card := by rw [pow_add,pow_one]
        _ ≤ 5*(2^5)^M.natAbs.primeFactors.card :=
          Nat.mul_le_mul le_rfl
            (Nat.pow_le_pow_left (by norm_num : 5≤2^5) _)
        _ = 5*(2^M.natAbs.primeFactors.card)^5 := by
          rw [←pow_mul,←pow_mul,
            Nat.mul_comm 5 M.natAbs.primeFactors.card]
        _ ≤ 5*M.natAbs.divisors.card^5 :=
          Nat.mul_le_mul le_rfl (Nat.pow_le_pow_left hω _)
    calc
      T.card ≤ M.natAbs.divisors.card*
          (2*(2800*q^(1+M.natAbs.primeFactors.card))) := hTcard
      _ ≤ M.natAbs.divisors.card*
          (2*(2800*(5*M.natAbs.divisors.card^5))) :=
        Nat.mul_le_mul_left _
          (Nat.mul_le_mul_left _
            (Nat.mul_le_mul_left _ hqpow))
      _ = 28000*M.natAbs.divisors.card^6 := by ring
private theorem alternative_divisor_cover4
    (hSt : StewartHyp)
    (R : MvPolynomial (Fin 2) ℤ)
    (hRh : R.IsHomogeneous 4) (hR0 : R ≠ 0)
    (halt : HasThreeProjectiveZeros R ∨ TwoIndependentLines4 R)
    (M : ℤ) (hM : M ≠ 0) :
    ∃ T : Finset (ℤ × ℤ),
      (∀ rs : ℤ × ℤ, Int.gcd rs.1 rs.2 = 1 →
        eval ![rs.1,rs.2] R ∣ M → rs ∈ T) ∧
      T.card ≤ 28000 * M.natAbs.divisors.card ^ 6 := by
  rcases halt with hr | hf
  · exact three_root_divisor_cover4 hSt R hRh hR0 hr M hM
  · obtain ⟨T,hcover,hcard⟩ := two_linear_divisor_cover4 R hf M hM
    have hτ : 1 ≤ M.natAbs.divisors.card := by
      have hm : 1 ∈ M.natAbs.divisors :=
        Nat.mem_divisors.mpr
          ⟨one_dvd _,Int.natAbs_ne_zero.mpr hM⟩
      have hc := Finset.card_pos.mpr ⟨1,hm⟩
      omega
    refine ⟨T,hcover,?_⟩
    calc
      T.card ≤ 4*M.natAbs.divisors.card^2 := hcard
      _ ≤ 4*M.natAbs.divisors.card^6 :=
        Nat.mul_le_mul_left _
          (Nat.pow_le_pow_right hτ (by omega : 2≤6))
      _ ≤ 28000*M.natAbs.divisors.card^6 :=
        Nat.mul_le_mul_right _ (by norm_num : 4≤28000)
end A5EvenQuarticClassificationPrivate
