private theorem cap_log (x : ℝ) (hx : 2 ≤ x) :
    (cap x : ℝ) ≤
      (4 + 1 / Real.log 2) * (1 + Real.log x) := by
  let n : ℕ := ⌊x⌋₊ + 1
  have hn : 1 ≤ n := by dsimp [n]; omega
  have hn0 : (0 : ℝ) < n := by exact_mod_cast (show 0 < n by omega)
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hlogx : 0 ≤ Real.log x := Real.log_nonneg hx1
  have hfloor : ((⌊x⌋₊ : ℕ) : ℝ) ≤ x := Nat.floor_le hx0.le
  have hnle : (n : ℝ) ≤ 2 * x := by
    dsimp [n]
    push_cast
    linarith
  have hlogn : Real.log (n : ℝ) ≤ Real.log (2 * x) :=
    Real.log_le_log hn0 hnle
  have hlogmul : Real.log (2 * x) =
      Real.log 2 + Real.log x := Real.log_mul (by norm_num) (ne_of_gt hx0)
