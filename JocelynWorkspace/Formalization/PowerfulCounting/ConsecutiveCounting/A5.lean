    exact_mod_cast hp30
  have hq03R : ((coeff m03 Q : ℤ) : ℝ) = (c : ℝ) * (b : ℝ) ^ 5 := by
    exact_mod_cast hq03
  have hca5 : |(c : ℝ)| * |(a : ℝ)| ^ 5 ≤ H := by
    have hh := (hCoeffs m30).1
    rw [hp30R, abs_mul, abs_neg, abs_pow] at hh
