    (hdiv n hn.ne').trans (mul_le_mul_of_nonneg_left hpow (by linarith))
  have ht4 : (n.divisors.card : ℝ)^4 ≤ C^4 * x^e := by
    calc
      (n.divisors.card : ℝ)^4 ≤ (C*x^(ε/8))^4 := by gcongr
      _ = C^4 * x^e := by
        rw [mul_pow, ← Real.rpow_natCast (x^(ε/8)) 4, ← Real.rpow_mul hx0.le]
        congr 1
