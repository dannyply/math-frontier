    (G : MvPolynomial (Fin 4) ℤ)
    (hbi : ∀ m ∈ G.support, m 0+m 1=1 ∧ m 2+m 3=1)
    (hirr : Irreducible G) (H : ℝ)
    (hheight : ∀ m : Fin 4 →₀ ℕ, |((G.coeff m : ℤ) : ℝ)| ≤ H) :
    ∃ A B C D : ℤ, A*D-B*C ≠ 0 ∧
      |(A : ℝ)| ≤ H ∧ |(B : ℝ)| ≤ H ∧
      |(C : ℝ)| ≤ H ∧ |(D : ℝ)| ≤ H ∧
      ∀ d e u v : ℕ,
        eval ![(d : ℤ),(e : ℤ),(u : ℤ),(v : ℤ)] G=0 →
        (A*(d : ℤ)+B*(e : ℤ))*(u : ℤ)=
          (C*(d : ℤ)+D*(e : ℤ))*(v : ℤ) := by
  have htd : G.totalDegree=2 :=
    (JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C02.PcClassify.isHomogeneous_of_bihom
