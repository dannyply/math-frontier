private theorem a5_ratio_window_additive
    (D E M ρ : ℝ) (hE : 0 < E) (hM : 0 < M)
    (hρ : ρ ≤ 2 * D / E) :
    ρ * (1 + 1 / M) ≤ ρ + 2 * D / (E * M) := by
  have hMinv : 0 ≤ 1 / M := (one_div_pos.mpr hM).le
  have hmul : ρ * (1 / M) ≤ (2 * D / E) * (1 / M) :=
    mul_le_mul_of_nonneg_right hρ hMinv
  calc
    ρ * (1 + 1 / M) = ρ + ρ * (1 / M) := by ring
    _ ≤ ρ + (2 * D / E) * (1 / M) := add_le_add_right hmul ρ
    _ = ρ + 2 * D / (E * M) := by
      field_simp
abbrev Point := (ℕ × ℕ) × (ℕ × ℕ)
abbrev Poly := MvPolynomial (Fin 4) ℤ
def rho (D E : ℝ) (M j : ℕ) : ℝ :=
  D / (2 * E) * (1 + 1 / (M : ℝ)) ^ j
def originalShell (x D E : ℝ) (h : ℤ) : Set Point :=
  {z | 1 ≤ z.1.1 ∧ 1 ≤ z.1.2 ∧ 1 ≤ z.2.1 ∧ 1 ≤ z.2.2 ∧
    ((z.1.2 ^ 2 * z.2.2 : ℕ) : ℤ) =
      ((z.1.1 ^ 2 * z.2.1 : ℕ) : ℤ) + h ∧
    x / 2 < ((z.1.1 ^ 2 * z.2.1 : ℕ) : ℝ) ∧
    ((z.1.1 ^ 2 * z.2.1 : ℕ) : ℝ) ≤ x ∧
    D / 2 < (z.1.1 : ℝ) ∧ (z.1.1 : ℝ) ≤ D ∧
    E / 2 < (z.1.2 : ℝ) ∧ (z.1.2 : ℝ) ≤ E}
def originalCell (x D E : ℝ) (M j : ℕ) (h : ℤ) : Set Point :=
  {z | z ∈ originalShell x D E h ∧
    rho D E M j < (z.1.1 : ℝ) / (z.1.2 : ℝ) ∧
    (z.1.1 : ℝ) / (z.1.2 : ℝ) ≤
      rho D E M j * (1 + 1 / (M : ℝ))}
