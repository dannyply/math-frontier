      _ = x^(2 : ℝ)/(x^s)^(2 : ℝ) := by
        rw [hDE]
        norm_num [Real.rpow_natCast]
      _ = x^(2-2*s) := by
        rw [←Real.rpow_mul hx.le,←Real.rpow_sub hx]
        congr 1
        ring
