theorem exact_count :
∀ K : ℕ, ∀ ε : ℝ, 0 < ε →
  ∃ Cbound : ℝ, 0 < Cbound ∧
    ∀ x : ℝ, 2 ≤ x →
      ∀ a b c m : ℤ,
        |(a : ℝ)| ≤ x ^ K →
        |(b : ℝ)| ≤ x ^ K →
        |(c : ℝ)| ≤ x ^ K →
        m ≠ 0 →
        |(m : ℝ)| ≤ x ^ K →
        ¬ IsSquare (b ^ 2 - 4 * a * c) →
        let S : Set (ℤ × ℤ) :=
          {rs | Int.gcd rs.1 rs.2 = 1 ∧
            |(rs.1 : ℝ)| ≤ x ^ K ∧
            |(rs.2 : ℝ)| ≤ x ^ K ∧
            a * rs.1 ^ 2 + b * rs.1 * rs.2 + c * rs.2 ^ 2 = m}
        S.Finite ∧ (S.ncard : ℝ) ≤ Cbound * x ^ ε := by
  classical
  intro K ε hε
  let L : ℕ := 2*K+3
  have hL : 0 < L := by dsimp [L]; omega
  obtain ⟨Cbound,hCbound,hbound⟩ := uniform_absorption L hL ε hε
  refine ⟨Cbound,hCbound,?_⟩
  intro x hx a b c m ha hb hc hm hmb hD
  let R : ℝ := x^K
  let H : ℝ := 3*R^2
  let D : ℤ := b^2-4*a*c
  let N : ℤ := 4*a*m
  let n : ℕ := N.natAbs
  let : Fact (¬ IsSquare D) := ⟨hD⟩
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hR1 : 1 ≤ R := one_le_pow₀ hx1
  have hR0 : 0 ≤ R := by linarith
  have hH : 1 ≤ H := by dsimp [H]; nlinarith
  have ha0 : a ≠ 0 := by
    intro hz
    apply hD
    refine ⟨b,?_⟩
    rw [hz]
    ring
  have hN : N ≠ 0 := by
    dsimp [N]
    exact mul_ne_zero (mul_ne_zero (by norm_num) ha0) hm
  have hn : 0 < n := Int.natAbs_pos.mpr hN
  have hRR : R^2=x^(2*K) := by
    dsimp [R]
    rw [←pow_mul]
    congr 1
    omega
  have hx3 : (8 : ℝ) ≤ x^3 := by
    calc
      (8 : ℝ)=(2 : ℝ)^3 := by norm_num
      _ ≤ x^3 := by gcongr
  have hscale : 5*R^2 ≤ x^L := by
    dsimp [L]
    rw [pow_add, ←hRR]
    nlinarith [sq_nonneg R]
  have hHb : H ≤ x^L := by
    exact (show H ≤ 5*R^2 by dsimp [H]; nlinarith [sq_nonneg R]).trans hscale
  have hDb0 : |(D : ℝ)| ≤ 5*R^2 := by
    have hb2 : |(b : ℝ)|^2 ≤ R^2 := by gcongr
    have hac : |(a : ℝ)| * |(c : ℝ)| ≤ R^2 := by
      have hh := mul_le_mul ha hc (abs_nonneg (c : ℝ)) hR0
      nlinarith
    have htriangle : |(b : ℝ)^2-4*(a : ℝ)*(c : ℝ)| ≤
        |(b : ℝ)^2| + |4*(a : ℝ)*(c : ℝ)| := by
      simpa only [sub_eq_add_neg,abs_neg] using
        (abs_add_le ((b : ℝ)^2) (-(4*(a : ℝ)*(c : ℝ))))
    have hconvert : |(D : ℝ)| =
        |(b : ℝ)^2-4*(a : ℝ)*(c : ℝ)| := by dsimp [D]; push_cast; rfl
    rw [hconvert]
    have habs : |(b : ℝ)^2| + |4*(a : ℝ)*(c : ℝ)| =
        |(b : ℝ)|^2+4*(|(a : ℝ)| * |(c : ℝ)|) := by
      simp only [abs_pow,abs_mul]
      norm_num
      ring
    rw [habs] at htriangle
    nlinarith
  have hDb : |(D : ℝ)| ≤ x^L := hDb0.trans hscale
  have hnb0 : (n : ℝ) ≤ 4*R^2 := by
    have ham : |(a : ℝ)| * |(m : ℝ)| ≤ R^2 := by
      have hh := mul_le_mul ha hmb (abs_nonneg (m : ℝ)) hR0
      nlinarith
    have hnabs : (n : ℝ)=|(N : ℝ)| := by
      dsimp [n]
      calc
        (N.natAbs : ℝ) = ((N.natAbs : ℤ) : ℝ) := (Int.cast_natCast N.natAbs).symm
        _ = ((|N| : ℤ) : ℝ) :=
          congrArg (fun z : ℤ => (z : ℝ)) (Int.natCast_natAbs N)
        _ = |(N : ℝ)| := by simp
    rw [hnabs]
    dsimp [N]
    push_cast
    simp only [abs_mul]
    norm_num
    nlinarith
  have hnb : (n : ℝ) ≤ x^L :=
    hnb0.trans ((by nlinarith [sq_nonneg R] : 4*R^2 ≤ 5*R^2).trans hscale)
  let S : Set (ℤ × ℤ) :=
    {rs | Int.gcd rs.1 rs.2 = 1 ∧
      |(rs.1 : ℝ)| ≤ x^K ∧ |(rs.2 : ℝ)| ≤ x^K ∧
      a*rs.1^2+b*rs.1*rs.2+c*rs.2^2=m}
  change S.Finite ∧ (S.ncard : ℝ) ≤ Cbound*x^ε
  have hSfin : S.Finite := by
    let Z : ℤ := ⌈R⌉
    have hRZ : R ≤ (Z : ℝ) := Int.le_ceil R
    apply ((Set.finite_Icc (-Z) Z).prod (Set.finite_Icc (-Z) Z)).subset
    intro p hp
    change (-Z ≤ p.1 ∧ p.1 ≤ Z) ∧ (-Z ≤ p.2 ∧ p.2 ≤ Z)
    have hp1 : |(p.1 : ℝ)| ≤ (Z : ℝ) := hp.2.1.trans hRZ
    have hp2 : |(p.2 : ℝ)| ≤ (Z : ℝ) := hp.2.2.1.trans hRZ
    have h1 := abs_le.mp hp1
    have h2 := abs_le.mp hp2
    constructor
    · constructor
      · exact_mod_cast h1.1
      · exact_mod_cast h1.2
    · constructor
      · exact_mod_cast h2.1
      · exact_mod_cast h2.2
  refine ⟨hSfin,?_⟩
  let T : Finset (ℤ × ℤ) := hSfin.toFinset
  let f : (ℤ × ℤ) → (ℤ × ℤ) :=
    fun p => (2*a*p.1+b*p.2,p.2)
  have hf : Function.Injective f := by
    intro p q hpq
    have hs := congrArg (fun z : ℤ × ℤ => z.2) hpq
    have ht := congrArg (fun z : ℤ × ℤ => z.1) hpq
    change p.2=q.2 at hs
    change 2*a*p.1+b*p.2=2*a*q.1+b*q.2 at ht
    have h2a : 2*a ≠ 0 := mul_ne_zero (by norm_num) ha0
    have hmul : (2*a)*p.1=(2*a)*q.1 := by
      rw [hs] at ht
      linear_combination ht
    exact Prod.ext (mul_left_cancel₀ h2a hmul) hs
  let W : Finset (ℤ × ℤ) := T.image f
  have hWcard : W.card=T.card := Finset.card_image_of_injective T hf
  have hW : ∀ p ∈ W,
      |(p.1 : ℝ)| ≤ H ∧ |(p.2 : ℝ)| ≤ H ∧ p.1^2-D*p.2^2=N := by
    intro p hp
    obtain ⟨rs,hrs,rfl⟩ := Finset.mem_image.mp hp
    have hrsS : rs ∈ S := by simpa only [T,Set.Finite.mem_toFinset] using hrs
    obtain ⟨hprim,hr,hs,hQ⟩ := hrsS
    have har : |(a : ℝ)| * |(rs.1 : ℝ)| ≤ R^2 := by
      have hh := mul_le_mul ha hr (abs_nonneg (rs.1 : ℝ)) hR0
      nlinarith
    have hbs : |(b : ℝ)| * |(rs.2 : ℝ)| ≤ R^2 := by
      have hh := mul_le_mul hb hs (abs_nonneg (rs.2 : ℝ)) hR0
      nlinarith
    constructor
    · change |((2*a*rs.1+b*rs.2 : ℤ) : ℝ)| ≤ H
      push_cast
      calc
        |2*(a : ℝ)*(rs.1 : ℝ)+(b : ℝ)*(rs.2 : ℝ)| ≤
            |2*(a : ℝ)*(rs.1 : ℝ)| + |(b : ℝ)*(rs.2 : ℝ)| := abs_add_le _ _
        _ = 2*(|(a : ℝ)| * |(rs.1 : ℝ)|)+|(b : ℝ)| * |(rs.2 : ℝ)| := by
          simp only [abs_mul]
          norm_num
          ring
        _ ≤ H := by dsimp [H]; nlinarith
    constructor
    · change |(rs.2 : ℝ)| ≤ H
      exact hs.trans (by dsimp [H]; nlinarith)
    · change (2*a*rs.1+b*rs.2)^2-D*rs.2^2=N
      dsimp [D,N]
      calc
        (2*a*rs.1+b*rs.2)^2-(b^2-4*a*c)*rs.2^2 =
            4*a*(a*rs.1^2+b*rs.1*rs.2+c*rs.2^2) := by ring
        _ = 4*a*m := by rw [hQ]
  have hcount : W.card ≤ n.divisors.card^4*unitBudget D H := by
    exact A5MovingQuadraticFiniteLiftPrivate.finite_lift_card D H hH N hN W hW
  calc
    (S.ncard : ℝ) = (T.card : ℝ) := by rw [Set.ncard_eq_toFinset_card S hSfin]
    _ = (W.card : ℝ) := by rw [hWcard]
    _ ≤ ((n.divisors.card^4*unitBudget D H : ℕ) : ℝ) := by exact_mod_cast hcount
    _ ≤ Cbound*x^ε := hbound x hx n hn hnb D H hH hHb hDb
end A5MovingQuadraticFull
