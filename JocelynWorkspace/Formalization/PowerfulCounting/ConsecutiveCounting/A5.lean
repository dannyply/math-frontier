    intro i hi
    calc
      (Polynomial.C (c i*y^(n-i.val))*Polynomial.X^i.val).natDegree≤
          (Polynomial.C (c i*y^(n-i.val))).natDegree+
            (Polynomial.X^i.val).natDegree := Polynomial.natDegree_mul_le
      _ ≤ n := by
        simp only [Polynomial.natDegree_C,Polynomial.natDegree_X_pow,zero_add]
        exact Nat.lt_succ_iff.mp i.isLt
  · simp
private theorem binaryRow_eval (n : ℕ) (c : Fin (n+1) → ℚ) (k x y : ℚ) :
    (binaryRow n c k y).eval x=
      (∑ i : Fin (n+1),c i*x^i.val*y^(n-i.val))-k := by
  simp only [binaryRow,Polynomial.eval_sub,Polynomial.eval_finset_sum,
    Polynomial.eval_mul,Polynomial.eval_C,Polynomial.eval_pow,Polynomial.eval_X]
  congr 1
  apply Finset.sum_congr rfl
  intro i hi
  ring
private theorem binaryRow_eval_zero (n : ℕ) (c : Fin (n+1) → ℚ) (k y : ℚ) :
    (binaryRow n c k y).eval 0=c 0*y^n-k := by
  rw [binaryRow_eval]
  congr 1
  calc
    (∑ i : Fin (n+1),c i*(0:ℚ)^i.val*y^(n-i.val))=
        c 0*(0:ℚ)^((0:Fin (n+1)).val)*y^(n-(0:Fin (n+1)).val) := by
      apply Finset.sum_eq_single (0:Fin (n+1))
      · intro i hi hne
        have hval : i.val≠0 := by
          intro hh
          exact hne (Fin.ext hh)
        simp [hval]
      · simp
    _ = c 0*y^n := by simp
private theorem homogeneous_binary_level_grid_count
    (n : ℕ) (hn : 1≤n) (c : Fin (n+1) → ℚ)
    (k : ℚ) (hk : k≠0) (A B : Finset ℚ) :
    ((A.product B).filter (fun z =>
      (∑ i : Fin (n+1),c i*z.1^i.val*z.2^(n-i.val))=k)).card≤
