    field_simp [hU.ne',hV.ne']
    
  have hfirst : U^2+V^2 ≤ 3*(U*V)*x^(2*asymmetry x D E) := by
    rw [hid]
    nlinarith [mul_le_mul_of_nonneg_left hratio (mul_pos hU hV).le]
  apply (div_le_iff₀ hM0).mpr
  nlinarith [mul_le_mul_of_nonneg_left hshift (show 0 ≤ 3*(U*V) by positivity)]
