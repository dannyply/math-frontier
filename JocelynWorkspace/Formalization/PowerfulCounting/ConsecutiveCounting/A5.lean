private theorem assembly :
∀ ε : ℝ, 0 < ε →
  ∃ C : ℝ, 1 ≤ C ∧
    ∀ H : ℝ, 1 ≤ H →
      ∀ (P Q : MvPolynomial (Fin 2) ℤ) (a b c A₀ B₀ : ℤ),
        P ≠ 0 → Q ≠ 0 →
        P.IsHomogeneous 3 → Q.IsHomogeneous 3 →
        IsRelPrime (MvPolynomial.map (Int.castRingHom ℚ) P)
