private theorem signed_divisor_natAbs_dvd
    (N : ℕ) (m : ℤ)
    (hm : m ∈ signedDivisors (N:ℤ)) :
    m.natAbs ∣ N := by
  unfold signedDivisors at hm
  rcases Finset.mem_union.mp hm with hp | hn
  · obtain ⟨d,hd,hdm⟩ := Finset.mem_image.mp hp
    have hdvd : d ∣ N := (Nat.mem_divisors.mp hd).1
    have hEq : m.natAbs = d := by
      rw [←hdm]
      simp
    rw [hEq]
    exact hdvd
  · obtain ⟨d,hd,hdm⟩ := Finset.mem_image.mp hn
    have hdvd : d ∣ N := (Nat.mem_divisors.mp hd).1
    have hEq : m.natAbs = d := by
      rw [←hdm]
      simp
    rw [hEq]
    exact hdvd
private theorem original_quartic_conjugate_graph_count :
    OriginalQuarticConjugateGraphCountStatement := by
  classical
  intro K ε hε
  obtain ⟨K',hcover⟩ := graph_to_norm_finite_cover K
  have hK' : (0:ℝ) < (K':ℝ)+1 := by exact_mod_cast (Nat.succ_pos K')
  let δ : ℝ := ε/(2*((K':ℝ)+1))
  have hδ : 0 < δ := div_pos hε (by positivity)
  obtain ⟨Cd,hCd,hdiv⟩ :=
    JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C01.PcLowdegRed.divisor_bound
