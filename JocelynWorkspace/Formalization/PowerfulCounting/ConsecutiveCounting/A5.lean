        (Polynomial.C (a:ℝ)*dR+Polynomial.C ((3*b:ℤ):ℝ)*eR))*
          Polynomial.C (((m:ℝ)^3)⁻¹)
    let R:ℝ:=C₀*D/(E*M)
    have hR:0<R := by dsimp [R]; positivity
    have hparam:((Zf s).card:ℝ)≤C*Price := by
      apply hcount x D E M (s₀-2*R) hx hD hE hM hfloor
        a b m d₀ e₀ s.1 q (s.2:ℤ) hprim hm hq hJZ hbez hsizeZ (Zf s)
      change ∀z∈Zf s,
        D/2<dR.eval (z:ℝ) ∧ dR.eval (z:ℝ)≤D ∧
        E/2<eR.eval (z:ℝ) ∧ eR.eval (z:ℝ)≤E ∧
        (dR.eval (z:ℝ))^2≤x ∧ (eR.eval (z:ℝ))^2≤2*x ∧
