      _ ≤ H := hcb5
  have ha : |(a : ℝ)| ≤ H := (int_abs_le_fifth a).trans ha5
  have hb : |(b : ℝ)| ≤ H := (int_abs_le_fifth b).trans hb5
  have habnz : a ≠ 0 ∨ b ≠ 0 := by
