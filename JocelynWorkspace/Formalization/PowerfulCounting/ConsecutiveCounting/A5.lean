  have ha5 : |(a : ℝ)| ^ 5 ≤ H := by
    calc
      |(a : ℝ)| ^ 5 = 1 * |(a : ℝ)| ^ 5 := by ring
      _ ≤ |(c : ℝ)| * |(a : ℝ)| ^ 5 :=
        mul_le_mul_of_nonneg_right hc1 (pow_nonneg (abs_nonneg (a : ℝ)) 5)
      _ ≤ H := hca5
  have hb5 : |(b : ℝ)| ^ 5 ≤ H := by
    calc
      |(b : ℝ)| ^ 5 = 1 * |(b : ℝ)| ^ 5 := by ring
      _ ≤ |(c : ℝ)| * |(b : ℝ)| ^ 5 :=
