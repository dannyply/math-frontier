  by_cases hcenter : sUpper z ≤ 5/8
  · right; right; left
    exact ⟨le_of_not_gt hlow, hcenter⟩
  by_cases hright : sUpper z ≤ 1
  · right; right; right
    exact ⟨le_of_not_ge hcenter, hright⟩
