      rw [← hJnorm]
      exact map_dvd Ideal.absNorm hQdiv
    rcases (Nat.dvd_prime_pow hp).mp hdiv with ⟨k, hk, heq⟩
    interval_cases k
    · have hOne : Ideal.absNorm Q = 1 := by simpa using heq
      exact False.elim (hQnormne hOne)
    · have hEq : Ideal.absNorm Q = p := by simpa using heq
      omega
    · have hp2 : p ≤ p ^ 2 := by nlinarith [hp.two_le]
      simpa [heq] using hp2
