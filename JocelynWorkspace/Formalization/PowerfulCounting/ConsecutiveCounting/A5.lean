lemma actual_ceiling_resources (x s δ : ℝ)
    (hx : 4 ≤ x) (hs : (599/1000 : ℝ) ≤ s) (hs' : s ≤ (5/8 : ℝ))
    (hδ : 0 < δ) (hδ' : δ ≤ (1/2000 : ℝ)) :
    let M : ℕ := ⌈x^(mu s δ)⌉₊;
    1 ≤ M ∧ x^(mu s δ) ≤ (M : ℝ) ∧
      (M : ℝ) ≤ 2*x^(mu s δ) ∧ (M : ℝ) ≤ 2*x := by
  let M : ℕ := ⌈x^(mu s δ)⌉₊
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hm := mu_half_and_upper s δ hs hs' hδ hδ'
  have hp : 0 < x^(mu s δ) := Real.rpow_pos_of_pos hx0 _
  have hp1 : 1 ≤ x^(mu s δ) := Real.one_le_rpow hx1 (by linarith)
  have hMl : x^(mu s δ) ≤ (M : ℝ) := Nat.le_ceil _
  have hMp : (0 : ℝ) < M := hp.trans_le hMl
  have hM : 1 ≤ M := by
    have hh : 0 < M := by exact_mod_cast hMp
    omega
  have hMu : (M : ℝ) < x^(mu s δ)+1 := Nat.ceil_lt_add_one hp.le
  have hpx : x^(mu s δ) ≤ x := by
    calc
