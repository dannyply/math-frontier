                  (T : ℚ) * (U z.1).coeff k = (A : ℚ)) ∧
                (∀ k : ℕ, ∃ B : ℤ,
                  (T : ℚ) * (V z.1).coeff k = (B : ℚ)) ∧
                (∀ k : ℕ, ∃ A : ℤ,
                  ((U z.1).comp
                    (Polynomial.C (z.2.1 : ℚ) +
                      Polynomial.C (z.2.2 : ℚ) * Polynomial.X)).coeff k =
                    (A : ℚ)) ∧
                (∀ k : ℕ, ∃ B : ℤ,
                  ((V z.1).comp
