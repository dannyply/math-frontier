    ArithmeticFunction.isMultiplicative_moebius.map_mul_of_coprime hde
  change (if (d * e) ^ k ∣ a * b then ArithmeticFunction.moebius (d * e) else 0) =
    (if d ^ k ∣ a then ArithmeticFunction.moebius d else 0) *
    (if e ^ k ∣ b then ArithmeticFunction.moebius e else 0)
  simp only [hcond, hmu]
  by_cases hd2 : d ^ k ∣ a <;> by_cases he2 : e ^ k ∣ b <;> simp [hd2, he2]
private theorem kFree_mul_iff (k a b : ℕ) (hk : 1 ≤ k) (hab : a.Coprime b) :
    kFree k (a * b) ↔ kFree k a ∧ kFree k b := by
  constructor
  · intro h
    constructor
    · intro p hp hd
      exact h p hp (dvd_trans hd (dvd_mul_right _ _))
    · intro p hp hd
      exact h p hp (dvd_trans hd (dvd_mul_left _ _))
  · rintro ⟨ha, hb⟩ p hp hd
    by_cases hpa : p ∣ a
    · have hpb : ¬ p ∣ b := by
        intro hpb
        have hdiv : p ∣ Nat.gcd a b := Nat.dvd_gcd hpa hpb
        rw [hab.gcd_eq_one] at hdiv
        exact hp.not_dvd_one hdiv
      have hcop : p.Coprime b := (hp.coprime_iff_not_dvd).mpr hpb
      exact ha p hp (Nat.Coprime.dvd_of_dvd_mul_right
        (Nat.Coprime.pow_left k hcop) hd)
    · have hcop : p.Coprime a := (hp.coprime_iff_not_dvd).mpr hpa
      exact hb p hp (Nat.Coprime.dvd_of_dvd_mul_left
        (Nat.Coprime.pow_left k hcop) hd)
private theorem kFree_prime_pow (k p j : ℕ) (hk : 1 ≤ k) (hp : p.Prime) :
    kFree k (p ^ j) ↔ j < k := by
  constructor
  · intro h
    by_contra hj
    exact h p hp ((Nat.pow_dvd_pow_iff_le_right hp.one_lt).mpr (by omega))
  · intro hj q hq hdiv
    have hqp : q ∣ p := hq.dvd_of_dvd_pow
      (dvd_trans (base_dvd_power k q hk) hdiv)
    have heq : q = p := ((Nat.dvd_prime hp).mp hqp).resolve_left hq.ne_one
    subst q
    have := (Nat.pow_dvd_pow_iff_le_right hp.one_lt).mp hdiv
    omega
private theorem kDivSum_prime_pow (k p j : ℕ) (hk : 1 ≤ k) (hp : p.Prime) :
    kDivSum k (p ^ j) = if j < k then 1 else 0 := by
  have hcrit : p ^ k ∣ p ^ j ↔ k ≤ j := Nat.pow_dvd_pow_iff_le_right hp.one_lt
  have hterm : ∀ i : ℕ,
      (if (p ^ i) ^ k ∣ p ^ j then ArithmeticFunction.moebius (p ^ i) else 0) =
        (if i = 0 then (1 : ℤ) else 0) +
        (if i = 1 then (if k ≤ j then (-1 : ℤ) else 0) else 0) := by
    intro i
    by_cases hi0 : i = 0
    · subst i
      simp
    · by_cases hi1 : i = 1
      · subst i
        simp [hcrit, ArithmeticFunction.moebius_apply_prime hp]
      · simp [ArithmeticFunction.moebius_apply_prime_pow hp hi0, hi0, hi1]
  have hsum : kDivSum k (p ^ j) = 1 + (if k ≤ j then (-1 : ℤ) else 0) := by
    unfold kDivSum
    rw [Nat.sum_divisors_prime_pow hp]
    calc
      _ = ∑ i ∈ Finset.range (j + 1),
          ((if i = 0 then (1 : ℤ) else 0) +
           (if i = 1 then (if k ≤ j then (-1 : ℤ) else 0) else 0)) := by
        apply Finset.sum_congr rfl
        intro i hi
        exact hterm i
      _ = _ := by
        rw [Finset.sum_add_distrib]
        simp only [Finset.sum_ite_eq', Finset.mem_range, Nat.zero_lt_succ, ite_true]
        by_cases hkj : k ≤ j
        · have hj1 : 1 < j + 1 := by omega
          simp [hj1, hkj]
        · simp [hkj]
  rw [hsum]
  by_cases hj : j < k
  · simp [hj, Nat.not_le.mpr hj]
  · simp [hj, Nat.le_of_not_gt hj]
private theorem kDivSum_eq_indicator (k : ℕ) (hk : 1 ≤ k) (n : ℕ) :
    kDivSum k n = if kFree k n then 1 else 0 := by
  refine Nat.recOnPosPrimePosCoprime ?_ ?_ ?_ ?_ n
  · intro p j hp hj
    rw [kDivSum_prime_pow k p j hk hp]
    simp only [kFree_prime_pow k p j hk hp]
  · have hn : ¬ kFree k 0 := by
      intro h
      exact h 2 Nat.prime_two (dvd_zero _)
    simp [kDivSum, hn]
  · have hn : kFree k 1 := by
      intro p hp hdiv
      have hpdiv : p ∣ 1 := dvd_trans (base_dvd_power k p hk) hdiv
      exact hp.not_dvd_one hpdiv
    simp [kDivSum, hn]
  · intro a b ha hb hab hsa hsb
    rw [kDivSum_mul k a b hab, hsa, hsb]
    simp only [kFree_mul_iff k a b hk hab]
    by_cases ha : kFree k a <;> by_cases hb : kFree k b <;> simp [ha, hb]
private theorem kFree_indicator (k : ℕ) (hk : 1 ≤ k) (n : ℕ) :
    (if kFree k n then (1 : ℝ) else 0) =
      ∑ d ∈ n.divisors,
        if d ^ k ∣ n then (ArithmeticFunction.moebius d : ℝ) else 0 := by
  have h : (kDivSum k n : ℝ) = if kFree k n then (1 : ℝ) else 0 := by
    rw [kDivSum_eq_indicator k hk]
    split_ifs <;> norm_num
  rw [← h]
  simp [kDivSum]
end
end GenericKFreeCore
