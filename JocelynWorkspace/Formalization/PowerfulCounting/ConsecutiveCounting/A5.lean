private theorem actual_partition_sum (x T K β : ℝ)
    (hx : 2 ≤ x)
    (hlarge : max 1024 (64 * T ^ 2) < x)
    (hK : 0 ≤ K) (hβ : 0 ≤ β)
    (hcenter : ∀ (b : Bool) (z : Index),
      z ∈ indices x (Real.sqrt x) →
      (599/1000:ℝ) ≤ sUpper z → sUpper z ≤ 5/8 →
      ((points b z \ (orient b '' globalS)).ncard : ℝ) ≤ K*x^β)
    (hright : ∀ (b : Bool) (z : Index),
      z ∈ indices x (Real.sqrt x) →
      (5/8:ℝ) ≤ sUpper z → sUpper z ≤ 1 →
      ((points b z \ (orient b '' globalS)).ncard : ℝ) ≤ K*x^β) :
    (∑ b : Bool, ∑ z ∈ indices x (Real.sqrt x),
      ((points b z \ (orient b '' globalS)).ncard : ℝ)) ≤
      (∑ b : Bool, ∑ z ∈ endpointIndices x,
        ((points b z).ncard : ℝ)) +
      (∑ b : Bool, ∑ z ∈ leftIndices x,
        ((points b z).ncard : ℝ)) +
      2 * ((indices x (Real.sqrt x)).card : ℝ) * (K*x^β) := by
  let I := indices x (Real.sqrt x)
  have hbase : 0 ≤ K*x^β := mul_nonneg hK (by positivity)
  have hterm (b : Bool) (z : Index) (hz : z ∈ I) :
      ((points b z \ (orient b '' globalS)).ncard : ℝ) ≤
      (if endpointCollar z then ((points b z).ncard : ℝ) else 0) +
      (if leftCondition z then ((points b z).ncard : ℝ) else 0) +
      K*x^β := by
    have hpt : 0 ≤ ((points b z).ncard : ℝ) := Nat.cast_nonneg _
