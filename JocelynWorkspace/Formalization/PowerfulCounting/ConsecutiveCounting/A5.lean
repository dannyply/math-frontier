  have hpw : p^2 ≤ w := by dsimp [w]; nlinarith [sq_nonneg q]
  have hqw : q^2 ≤ w := by dsimp [w]; nlinarith [sq_nonneg p]
  have hqpow : q^((1 : ℝ)/6)=(q^2)^((1 : ℝ)/12) := by
    rw [powers q hq 2]
    norm_num
  calc
    (p^2*q)^((1 : ℝ)/6) =
        (p^2)^((1 : ℝ)/6)*(q^2)^((1 : ℝ)/12) := by
      rw [Real.mul_rpow (sq_nonneg p) hq,hqpow]
    _ ≤ w^((1 : ℝ)/6)*w^((1 : ℝ)/12) :=
      mul_le_mul
        (Real.rpow_le_rpow (sq_nonneg p) hpw (by norm_num))
        (Real.rpow_le_rpow (sq_nonneg q) hqw (by norm_num))
        (Real.rpow_nonneg (sq_nonneg q) _) (Real.rpow_nonneg hw0.le _)
    _ = w^((1 : ℝ)/4) := by
      rw [←Real.rpow_add hw0]
      norm_num
    _ ≤ w^(1 : ℝ) :=
      Real.rpow_le_rpow_of_exponent_le hw1 (by norm_num)
    _ = 1+p^2+q^2 := by rw [Real.rpow_one]
