private theorem signed_nat_shift (b : Bool) (d e u v : ℕ)
    (heq : (e : ℤ) ^ 2 * (v : ℤ) - (d : ℤ) ^ 2 * (u : ℤ) = sign b) :
    (if b then d ^ 2 * u = e ^ 2 * v + 1
      else e ^ 2 * v = d ^ 2 * u + 1) := by
  cases b
  · change e ^ 2 * v = d ^ 2 * u + 1
    have hh : (e : ℤ) ^ 2 * (v : ℤ) -
        (d : ℤ) ^ 2 * (u : ℤ) = 1 := by simpa [sign] using heq
    have hi : (e : ℤ) ^ 2 * (v : ℤ) =
        (d : ℤ) ^ 2 * (u : ℤ) + 1 := by linarith
    exact_mod_cast hi
  · change d ^ 2 * u = e ^ 2 * v + 1
    have hh : (e : ℤ) ^ 2 * (v : ℤ) -
        (d : ℤ) ^ 2 * (u : ℤ) = -1 := by simpa [sign] using heq
    have hi : (d : ℤ) ^ 2 * (u : ℤ) =
        (e : ℤ) ^ 2 * (v : ℤ) + 1 := by linarith
    exact_mod_cast hi
private theorem coprime_of_unit_shift (m a t u : ℕ)
    (h : m * a = t * u + 1 ∨ t * u = m * a + 1) :
    Nat.Coprime u m := by
  apply Nat.coprime_of_dvd
  intro p hp hpu hpm
  have htu : p ∣ t * u := dvd_mul_of_dvd_right hpu t
  have hma : p ∣ m * a := dvd_mul_of_dvd_left hpm a
  have hp1 : p ∣ 1 := by
    rcases h with h | h
    · have hs : p ∣ t * u + 1 := by rw [← h]; exact hma
      exact (Nat.dvd_add_right htu).mp hs
    · have hs : p ∣ m * a + 1 := by rw [← h]; exact htu
      exact (Nat.dvd_add_right hma).mp hs
  exact hp.one_lt.ne' (Nat.dvd_one.mp hp1)
private theorem pred_coprime (m : ℕ) (hm : 0 < m) :
    Nat.Coprime (m - 1) m := by
  apply Nat.coprime_of_dvd
  intro p hp hpred hmod
  have hsucc : m - 1 + 1 = m := by omega
  have hs : p ∣ (m - 1) + 1 := by simpa only [hsucc] using hmod
  have hp1 : p ∣ 1 := (Nat.dvd_add_right hpred).mp hs
  exact hp.one_lt.ne' (Nat.dvd_one.mp hp1)
private def targetResidue (b : Bool) (m : ℕ) : ℕ :=
  if b then 1 else m - 1
private theorem targetResidue_coprime (b : Bool) (m u : ℕ)
    (hm : 0 < m) (hu : Nat.Coprime u m) :
    Nat.Coprime (u * targetResidue b m) m := by
  have ht : Nat.Coprime (targetResidue b m) m := by
    cases b
    · simpa [targetResidue] using pred_coprime m hm
    · simp [targetResidue]
  exact (Nat.Coprime.mul_right hu.symm ht.symm).symm
private theorem modular_interval_count
    (m N a t : ℕ) (hm : 0 < m) (hcop : Nat.Coprime (a * t) m) :
    ((Finset.Icc 1 N).filter
      (fun d : ℕ => (a : ZMod m) * (d : ZMod m) ^ 2 = t)).card ≤
      2 * m.divisors.card * (N / m + 1) := by
  classical
  have : NeZero m := ⟨by omega⟩
  let R : Finset (ZMod m) :=
    Finset.univ.filter (fun r : ZMod m => (a : ZMod m) * r ^ 2 = t)
  let S : Finset ℕ :=
    (Finset.Icc 1 N).filter
      (fun d : ℕ => (a : ZMod m) * (d : ZMod m) ^ 2 = t)
  have hmap : ∀ d ∈ S, (d : ZMod m) ∈ R := by
    intro d hd
    simp only [S, R, Finset.mem_filter, Finset.mem_univ, true_and] at hd ⊢
    exact hd.2
  have hroot : R.card ≤ 2 * m.divisors.card := by
    simpa only [R] using
      (FormalAB.Se37df572.A2InheritedPell.card_sqrt_le m a t hcop)
  have hfib : ∀ r ∈ R,
      (S.filter (fun d : ℕ => (d : ZMod m) = r)).card ≤ N / m + 1 := by
    intro r hr
    have hsub :
        (S.filter (fun d : ℕ => (d : ZMod m) = r)).card ≤
          ((Finset.Icc 1 N).filter (fun d => d % m = r.val)).card := by
      apply Finset.card_le_card
      intro d hd
      simp only [Finset.mem_filter] at hd ⊢
      have hcast : (d : ZMod m) = (r.val : ZMod m) := by
        simpa only [ZMod.natCast_zmod_val] using hd.2
      have hdvd : (m : ℤ) ∣ (d : ℤ) - (r.val : ℤ) := by
        have hz : (((d : ℤ) - (r.val : ℤ)) : ZMod m) = 0 := by
          push_cast
          rw [hcast, sub_self]
        have hz' : (((d : ℤ) - (r.val : ℤ) : ℤ) : ZMod m) = 0 := by
          simpa only [Int.cast_sub] using hz
        exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ m).mp hz'
      have hmod : r.val % m = d % m :=
        Nat.modEq_iff_dvd.mpr hdvd
      refine ⟨(Finset.mem_filter.mp hd.1).1, ?_⟩
      exact hmod.symm.trans (Nat.mod_eq_of_lt (ZMod.val_lt r))
    exact hsub.trans
      (FormalAB.Sb23c796c.ConsecutiveCountingA5CRT.residue_Icc_bounds
        N m r.val hm (ZMod.val_lt r)).2
  change S.card ≤ _
  rw [Finset.card_eq_sum_card_fiberwise hmap]
  calc
    ∑ r ∈ R, (S.filter (fun d : ℕ => (d : ZMod m) = r)).card
        ≤ ∑ _r ∈ R, (N / m + 1) := Finset.sum_le_sum hfib
    _ = R.card * (N / m + 1) := by simp
    _ ≤ 2 * m.divisors.card * (N / m + 1) :=
      Nat.mul_le_mul_right _ hroot
private theorem point_coprime_and_root (b : Bool) (z : Index) (q : Quad)
    (hq : q ∈ points b z) :
    Nat.Coprime q.2.1 (q.1.2 ^ 2) ∧
      (q.2.1 : ZMod (q.1.2 ^ 2)) *
          (q.1.1 : ZMod (q.1.2 ^ 2)) ^ 2 =
        targetResidue b (q.1.2 ^ 2) := by
  rcases q with ⟨⟨d, e⟩, ⟨u, v⟩⟩
  rcases hq with ⟨hd, he, hu, hv, hx, hdb, heb, hub, hvb, heq⟩
  dsimp only at hd he hu hv hx hdb heb hub hvb heq
  have heN : 0 < e := by
    have he' : 1 ≤ e := by simpa only using he
    omega
  have hm : 0 < e ^ 2 := pow_pos heN _
  have : NeZero (e ^ 2) := ⟨by omega⟩
  have hs := signed_nat_shift b d e u v heq
  cases b with
  | false =>
      have hshift : e ^ 2 * v = d ^ 2 * u + 1 := by simpa using hs
      have hcop : Nat.Coprime u (e ^ 2) :=
        coprime_of_unit_shift (e ^ 2) v (d ^ 2) u (Or.inl hshift)
      constructor
      · exact hcop
      · let m : ℕ := e ^ 2
        have hplus : m - 1 + 1 = m := by dsimp [m]; omega
        have hzero : ((d ^ 2 * u : ℕ) : ZMod m) + 1 = 0 := by
          calc
            ((d ^ 2 * u : ℕ) : ZMod m) + 1 =
                ((d ^ 2 * u + 1 : ℕ) : ZMod m) := by push_cast; ring
            _ = ((e ^ 2 * v : ℕ) : ZMod m) :=
                congrArg (fun n : ℕ => (n : ZMod m)) hshift.symm
            _ = 0 := by dsimp [m]; simp
        have htarget : (((m - 1 : ℕ) : ZMod m) + 1) = 0 := by
          calc
            (((m - 1 : ℕ) : ZMod m) + 1) =
                ((m - 1 + 1 : ℕ) : ZMod m) := by push_cast; ring
            _ = (m : ZMod m) := congrArg (fun n : ℕ => (n : ZMod m)) hplus
            _ = 0 := by simp
        have hroot : ((d ^ 2 * u : ℕ) : ZMod m) = ((m - 1 : ℕ) : ZMod m) :=
          add_right_cancel (hzero.trans htarget.symm)
        simpa [m, targetResidue, mul_comm] using hroot
  | true =>
      have hshift : d ^ 2 * u = e ^ 2 * v + 1 := by simpa using hs
      have hcop : Nat.Coprime u (e ^ 2) :=
        coprime_of_unit_shift (e ^ 2) v (d ^ 2) u (Or.inr hshift)
      constructor
      · exact hcop
      · let m : ℕ := e ^ 2
        have hroot : ((d ^ 2 * u : ℕ) : ZMod m) = 1 := by
          calc
            ((d ^ 2 * u : ℕ) : ZMod m) =
                ((e ^ 2 * v + 1 : ℕ) : ZMod m) :=
                  congrArg (fun n : ℕ => (n : ZMod m)) hshift
            _ = 1 := by dsimp [m]; simp
        simpa [m, targetResidue, mul_comm] using hroot
private theorem point_v_unique (b : Bool) (d e u v v' : ℕ)
    (he : 0 < e)
    (h : (e : ℤ) ^ 2 * (v : ℤ) -
      (d : ℤ) ^ 2 * (u : ℤ) = sign b)
    (h' : (e : ℤ) ^ 2 * (v' : ℤ) -
      (d : ℤ) ^ 2 * (u : ℤ) = sign b) :
    v = v' := by
  have hmul : (e : ℤ) ^ 2 * (v : ℤ) =
      (e : ℤ) ^ 2 * (v' : ℤ) := by linarith
  have he0 : (e : ℤ) ^ 2 ≠ 0 := pow_ne_zero _ (by exact_mod_cast (Nat.ne_of_gt he))
  have hz : (v : ℤ) = (v' : ℤ) := mul_left_cancel₀ he0 hmul
  exact_mod_cast hz
private def pointFinset (b : Bool) (z : Index) : Finset Quad :=
  (points_finite b z).toFinset
private def label (q : Quad) : ℕ × ℕ := (q.1.2, q.2.1)
private theorem pointFinset_mem (b : Bool) (z : Index) (q : Quad) :
    q ∈ pointFinset b z ↔ q ∈ points b z := by
  exact (points_finite b z).mem_toFinset
private theorem point_injective_d_label
    (b : Bool) (z : Index) (q r : Quad)
    (hq : q ∈ points b z) (hr : r ∈ points b z)
    (hd : q.1.1 = r.1.1) (he : q.1.2 = r.1.2)
    (hu : q.2.1 = r.2.1) : q = r := by
  rcases q with ⟨⟨d, e⟩, ⟨u, v⟩⟩
  rcases r with ⟨⟨d', e'⟩, ⟨u', v'⟩⟩
  dsimp only at hd he hu
  subst d'
  subst e'
  subst u'
  rcases hq with ⟨_, hepos, _, _, _, _, _, _, _, heq⟩
  rcases hr with ⟨_, _, _, _, _, _, _, _, _, heq'⟩
  dsimp only at hepos
  have heN : 0 < e := by
    have he' : 1 ≤ e := by simpa only using hepos
    omega
  have hv : v = v' :=
    point_v_unique b d e u v v' heN heq heq'
  subst v'
  rfl
private theorem point_fiber_count (b : Bool) (z : Index) (t : ℕ × ℕ)
    (ht : t ∈ (pointFinset b z).image label) :
    ((pointFinset b z).filter (fun q : Quad => label q = t)).card ≤
      2 * (t.1 ^ 2).divisors.card *
        ((2 ^ z.2.1) / (t.1 ^ 2) + 1) := by
  classical
  obtain ⟨q₀, hq₀F, hq₀label⟩ := Finset.mem_image.mp ht
  have hq₀ : q₀ ∈ points b z := (pointFinset_mem b z q₀).mp hq₀F
  have hte : q₀.1.2 = t.1 := congrArg Prod.fst hq₀label
  have htu : q₀.2.1 = t.2 := congrArg Prod.snd hq₀label
  have htpos : 0 < t.1 := by
    have hpos : 1 ≤ q₀.1.2 := hq₀.2.1
    omega
  have hm : 0 < t.1 ^ 2 := pow_pos htpos _
  have hc₀ := (point_coprime_and_root b z q₀ hq₀).1
  have hc : Nat.Coprime t.2 (t.1 ^ 2) := by
    simpa only [← hte, ← htu] using hc₀
  have hcop : Nat.Coprime
      (t.2 * targetResidue b (t.1 ^ 2)) (t.1 ^ 2) :=
    targetResidue_coprime b (t.1 ^ 2) t.2 hm hc
  have hmap :
      ((pointFinset b z).filter (fun q : Quad => label q = t)).card ≤
        ((Finset.Icc 1 (2 ^ z.2.1)).filter
          (fun d : ℕ => (t.2 : ZMod (t.1 ^ 2)) *
            (d : ZMod (t.1 ^ 2)) ^ 2 =
              targetResidue b (t.1 ^ 2))).card := by
    apply Finset.card_le_card_of_injOn (fun q : Quad => q.1.1)
    · intro q hq
      obtain ⟨hqF, hqt⟩ := Finset.mem_filter.mp hq
      have hqP : q ∈ points b z := (pointFinset_mem b z q).mp hqF
      have hroot := (point_coprime_and_root b z q hqP).2
      have he : q.1.2 = t.1 := congrArg Prod.fst hqt
      have hu : q.2.1 = t.2 := congrArg Prod.snd hqt
      rcases hqP with ⟨hdpos, _, _, _, _, hdb, _, _, _, _⟩
      have hdN : q.1.1 ≤ 2 ^ z.2.1 := band_upper_nat hdb
      refine Finset.mem_filter.mpr ⟨Finset.mem_Icc.mpr ⟨hdpos, hdN⟩, ?_⟩
      rw [← he, ← hu]
      exact hroot
    · intro q hq r hr hdd
      obtain ⟨hqF, hqt⟩ := Finset.mem_filter.mp hq
      obtain ⟨hrF, hrt⟩ := Finset.mem_filter.mp hr
      have hqr : label q = label r := hqt.trans hrt.symm
      exact point_injective_d_label b z q r
        ((pointFinset_mem b z q).mp hqF)
        ((pointFinset_mem b z r).mp hrF) hdd
        (congrArg Prod.fst hqr) (congrArg Prod.snd hqr)
  exact hmap.trans
    (modular_interval_count (t.1 ^ 2) (2 ^ z.2.1) t.2
      (targetResidue b (t.1 ^ 2)) hm hcop)
private theorem point_card_le_fiber_sum (b : Bool) (z : Index) :
    (pointFinset b z).card ≤
      ∑ t ∈ (pointFinset b z).image label,
        2 * (t.1 ^ 2).divisors.card *
          ((2 ^ z.2.1) / (t.1 ^ 2) + 1) := by
  classical
  have hmap : ∀ q ∈ pointFinset b z,
      label q ∈ (pointFinset b z).image label := by
    intro q hq
    exact Finset.mem_image.mpr ⟨q, hq, rfl⟩
  rw [Finset.card_eq_sum_card_fiberwise hmap]
  exact Finset.sum_le_sum (fun t ht => point_fiber_count b z t ht)
private theorem half_le_scale (j : ℕ) : (1 / 2 : ℝ) ≤ scale j := by
  have hp : (1 : ℝ) ≤ (2 : ℝ) ^ j := one_le_pow₀ (by norm_num)
  unfold scale
  linarith
private theorem point_products_le_four_X (b : Bool) (z : Index) (q : Quad)
    (hq : q ∈ points b z) :
    (((q.1.1 ^ 2 * q.2.1 : ℕ) : ℝ) ≤ 4 * X z) ∧
      (((q.1.2 ^ 2 * q.2.2 : ℕ) : ℝ) ≤ 4 * X z) := by
  rcases q with ⟨⟨d, e⟩, ⟨u, v⟩⟩
  rcases hq with ⟨hd, he, hu, hv, hx, hdb, heb, hub, hvb, heq⟩
  dsimp only at hd he hu hv hx hdb heb hub hvb heq
  have hmin : (((min (d ^ 2 * u) (e ^ 2 * v) : ℕ) : ℝ) ≤ 2 * X z) := hx.2
  have hH : (1 / 2 : ℝ) ≤ X z := half_le_scale z.1
  have hs := signed_nat_shift b d e u v heq
  cases b with
  | false =>
      have hshift : e ^ 2 * v = d ^ 2 * u + 1 := by simpa using hs
      have hminEq : min (d ^ 2 * u) (e ^ 2 * v) = d ^ 2 * u :=
        Nat.min_eq_left (by omega)
      rw [hminEq] at hmin
      have hcast : (((e ^ 2 * v : ℕ) : ℝ)) =
          (((d ^ 2 * u : ℕ) : ℝ)) + 1 := by exact_mod_cast hshift
      constructor <;> linarith
  | true =>
      have hshift : d ^ 2 * u = e ^ 2 * v + 1 := by simpa using hs
      have hminEq : min (d ^ 2 * u) (e ^ 2 * v) = e ^ 2 * v :=
        Nat.min_eq_right (by omega)
      rw [hminEq] at hmin
      have hcast : (((d ^ 2 * u : ℕ) : ℝ)) =
          (((e ^ 2 * v : ℕ) : ℝ)) + 1 := by exact_mod_cast hshift
      constructor <;> linarith
private theorem label_card_le_four_EU (b : Bool) (z : Index) :
    (((pointFinset b z).image label).card : ℝ) ≤
      4 * E z * U z := by
  classical
  let T := (pointFinset b z).image label
  have hsub :
      T ⊆ (Finset.Icc 1 (2 ^ z.2.2.1)) ×ˢ
        (Finset.Icc 1 (2 ^ z.2.2.2.1)) := by
    intro t ht
    obtain ⟨q, hqF, rfl⟩ := Finset.mem_image.mp ht
    have hq : q ∈ points b z := (pointFinset_mem b z q).mp hqF
    rcases hq with ⟨_, he, hu, _, _, _, heb, hub, _, _⟩
    simp only [label, Finset.mem_product, Finset.mem_Icc]
    exact ⟨⟨he, band_upper_nat heb⟩, ⟨hu, band_upper_nat hub⟩⟩
  have hcard : T.card ≤ (2 ^ z.2.2.1) * (2 ^ z.2.2.2.1) := by
    calc
      T.card ≤ ((Finset.Icc 1 (2 ^ z.2.2.1)) ×ˢ
        (Finset.Icc 1 (2 ^ z.2.2.2.1))).card :=
          Finset.card_le_card hsub
      _ = (2 ^ z.2.2.1) * (2 ^ z.2.2.2.1) := by simp
  have hcardR : (T.card : ℝ) ≤
      (2 : ℝ) ^ z.2.2.1 * (2 : ℝ) ^ z.2.2.2.1 := by exact_mod_cast hcard
  change (T.card : ℝ) ≤ 4 * E z * U z
  calc
    (T.card : ℝ) ≤
        (2 : ℝ) ^ z.2.2.1 * (2 : ℝ) ^ z.2.2.2.1 := hcardR
    _ = 4 * E z * U z := by
      dsimp [E, U, scale]
      ring
private def swapIndex (z : Index) : Index :=
  (z.1, z.2.2.1, z.2.1, z.2.2.2.2, z.2.2.2.1)
private theorem point_swap (b : Bool) (z : Index) (q : Quad) :
    q ∈ points b z ↔ orient true q ∈ points (!b) (swapIndex z) := by
  rcases q with ⟨⟨d, e⟩, ⟨u, v⟩⟩
  cases b with
  | false =>
      change
        (1 ≤ d ∧ 1 ≤ e ∧ 1 ≤ u ∧ 1 ≤ v ∧
          band z.1 (min (d ^ 2 * u) (e ^ 2 * v)) ∧
          band z.2.1 d ∧ band z.2.2.1 e ∧
          band z.2.2.2.1 u ∧ band z.2.2.2.2 v ∧
          (e : ℤ) ^ 2 * (v : ℤ) - (d : ℤ) ^ 2 * (u : ℤ) = 1) ↔
        (1 ≤ e ∧ 1 ≤ d ∧ 1 ≤ v ∧ 1 ≤ u ∧
          band z.1 (min (e ^ 2 * v) (d ^ 2 * u)) ∧
          band z.2.2.1 e ∧ band z.2.1 d ∧
          band z.2.2.2.2 v ∧ band z.2.2.2.1 u ∧
          (d : ℤ) ^ 2 * (u : ℤ) - (e : ℤ) ^ 2 * (v : ℤ) = -1)
      constructor
      · rintro ⟨hd, he, hu, hv, hx, hdb, heb, hub, hvb, heq⟩
        exact ⟨he, hd, hv, hu, by simpa only [min_comm] using hx,
          heb, hdb, hvb, hub, by linarith⟩
      · rintro ⟨he, hd, hv, hu, hx, heb, hdb, hvb, hub, heq⟩
        exact ⟨hd, he, hu, hv, by simpa only [min_comm] using hx,
          hdb, heb, hub, hvb, by linarith⟩
  | true =>
      change
        (1 ≤ d ∧ 1 ≤ e ∧ 1 ≤ u ∧ 1 ≤ v ∧
          band z.1 (min (d ^ 2 * u) (e ^ 2 * v)) ∧
          band z.2.1 d ∧ band z.2.2.1 e ∧
          band z.2.2.2.1 u ∧ band z.2.2.2.2 v ∧
          (e : ℤ) ^ 2 * (v : ℤ) - (d : ℤ) ^ 2 * (u : ℤ) = -1) ↔
        (1 ≤ e ∧ 1 ≤ d ∧ 1 ≤ v ∧ 1 ≤ u ∧
          band z.1 (min (e ^ 2 * v) (d ^ 2 * u)) ∧
          band z.2.2.1 e ∧ band z.2.1 d ∧
          band z.2.2.2.2 v ∧ band z.2.2.2.1 u ∧
          (d : ℤ) ^ 2 * (u : ℤ) - (e : ℤ) ^ 2 * (v : ℤ) = 1)
      constructor
      · rintro ⟨hd, he, hu, hv, hx, hdb, heb, hub, hvb, heq⟩
        exact ⟨he, hd, hv, hu, by simpa only [min_comm] using hx,
          heb, hdb, hvb, hub, by linarith⟩
      · rintro ⟨he, hd, hv, hu, hx, heb, hdb, hvb, hub, heq⟩
        exact ⟨hd, he, hu, hv, by simpa only [min_comm] using hx,
          hdb, heb, hub, hvb, by linarith⟩
private theorem point_scale_caps (b : Bool) (z : Index) (q : Quad)
    (hq : q ∈ points b z) :
    E z ^ 2 ≤ 4 * X z ∧ D z ^ 2 * U z ≤ 4 * X z := by
  rcases q with ⟨⟨d, e⟩, ⟨u, v⟩⟩
  have hp := point_products_le_four_X b z ((d, e), (u, v)) hq
  rcases hq with ⟨_, _, _, hv, _, hdb, heb, hub, _, _⟩
  dsimp only at hv hdb heb hub hp
  have hE : E z < (e : ℝ) := heb.1
  have hD : D z < (d : ℝ) := hdb.1
  have hU : U z < (u : ℝ) := hub.1
  have hEpos : 0 < E z := scale_pos z.2.2.1
  have hDpos : 0 < D z := scale_pos z.2.1
  have hUpos : 0 < U z := scale_pos z.2.2.2.1
  have hvR : (1 : ℝ) ≤ v := by exact_mod_cast hv
  have heprod : (e : ℝ) ^ 2 * (v : ℝ) ≤ 4 * X z := by
    simpa only [Nat.cast_mul, Nat.cast_pow] using hp.2
  have hdprod : (d : ℝ) ^ 2 * (u : ℝ) ≤ 4 * X z := by
    simpa only [Nat.cast_mul, Nat.cast_pow] using hp.1
  have hE2 : E z ^ 2 ≤ (e : ℝ) ^ 2 := by nlinarith
  have hD2 : D z ^ 2 ≤ (d : ℝ) ^ 2 := by nlinarith
  have hUle : U z ≤ (u : ℝ) := hU.le
  have he2le : (e : ℝ) ^ 2 ≤ (e : ℝ) ^ 2 * (v : ℝ) := by
    nlinarith [mul_nonneg (sq_nonneg (e : ℝ)) (sub_nonneg.mpr hvR)]
  have hD2U : D z ^ 2 * U z ≤ (d : ℝ) ^ 2 * (u : ℝ) := by
    calc
      D z ^ 2 * U z ≤ (d : ℝ) ^ 2 * U z :=
        mul_le_mul_of_nonneg_right hD2 hUpos.le
      _ ≤ (d : ℝ) ^ 2 * (u : ℝ) :=
        mul_le_mul_of_nonneg_left hUle (sq_nonneg (d : ℝ))
  exact ⟨hE2.trans (he2le.trans heprod), hD2U.trans hdprod⟩
private theorem axis_numeric
    (A H D E U : ℝ) (hA : 0 ≤ A) (hD : 0 < D)
    (hE : 0 < E) (hU : 0 ≤ U)
    (hcap : D ^ 2 * U ≤ 4 * H) :
    A * (2 * D * U / E + E * U) ≤
      8 * A * (H / (D * E) + E * U) := by
  have hDE : 0 < D * E := mul_pos hD hE
  have hh : D ^ 2 * U * E ≤ 4 * H * E :=
    mul_le_mul_of_nonneg_right hcap hE.le
  have hmain : 2 * D * U / E ≤ 8 * H / (D * E) := by
    apply (div_le_div_iff₀ hE hDE).2
    nlinarith [hh]
  have hterm : 0 ≤ E * U := mul_nonneg hE.le hU
  calc
    A * (2 * D * U / E + E * U) ≤
        A * (8 * H / (D * E) + E * U) :=
          mul_le_mul_of_nonneg_left (by linarith [hmain]) hA
    _ = 8 * A * (H / (D * E)) + A * (E * U) := by ring
    _ ≤ 8 * A * (H / (D * E)) + 8 * A * (E * U) := by
      nlinarith [mul_nonneg hA hterm]
    _ = 8 * A * (H / (D * E) + E * U) := by ring
private theorem one_axis_count
    (ε Cdiv : ℝ) (hε : 0 < ε) (hCdiv : 0 < Cdiv)
    (hdiv : ∀ n : ℕ, 0 < n →
      (n.divisors.card : ℝ) ≤ Cdiv * (n : ℝ) ^ ε)
    (b : Bool) (z : Index) :
    ((pointFinset b z).card : ℝ) ≤
      (64 * Cdiv * 4 ^ ε) * (X z) ^ ε *
        (X z / (D z * E z) + E z * U z) := by
  classical
