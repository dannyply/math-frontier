private theorem original_second_pair_unique
    (C E d e u v u' v' h : ℤ)
    (hR0 : e ^ 2 * C - d ^ 2 * E ≠ 0)
    (hg : C * u = E * v)
    (hs : e ^ 2 * v - d ^ 2 * u = h)
    (hg' : C * u' = E * v')
