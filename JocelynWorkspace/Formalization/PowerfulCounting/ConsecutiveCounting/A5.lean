private theorem unit_back (D : MvPolynomial (Fin 2) ℚ)
    (h : IsUnit (MvPolynomial.map (algebraMap ℚ ℂ) D)) : IsUnit D := by
  obtain ⟨c, hc, hd⟩ := MvPolynomial.isUnit_iff_eq_C_of_isReduced.mp h
  have hcc : c = (algebraMap ℚ ℂ) (D.coeff 0) := by
    have h0 := congrArg (MvPolynomial.coeff (0 : Fin 2 →₀ ℕ)) hd
    simpa [MvPolynomial.coeff_map] using h0.symm
  have hinj : Function.Injective
      (MvPolynomial.map (algebraMap ℚ ℂ) : MvPolynomial (Fin 2) ℚ → MvPolynomial (Fin 2) ℂ) :=
    MvPolynomial.map_injective _ (RingHom.injective _)
  have hD : D = MvPolynomial.C (D.coeff 0) := by
    apply hinj
    rw [hd, hcc, MvPolynomial.map_C]
  have hc0 : D.coeff 0 ≠ 0 := by
    intro h0
    rw [h0, map_zero] at hcc
    exact hc.ne_zero hcc
  exact MvPolynomial.isUnit_iff_eq_C_of_isReduced.mpr
    ⟨D.coeff 0, isUnit_iff_ne_zero.mpr hc0, hD⟩
private theorem relprime_back (P Q : MvPolynomial (Fin 2) ℚ)
    (h : IsRelPrime (MvPolynomial.map (algebraMap ℚ ℂ) P)
       (MvPolynomial.map (algebraMap ℚ ℂ) Q)) : IsRelPrime P Q := by
  intro D hDP hDQ
  have hP : MvPolynomial.map (algebraMap ℚ ℂ) D ∣
      MvPolynomial.map (algebraMap ℚ ℂ) P := by
    obtain ⟨R, rfl⟩ := hDP
    exact ⟨MvPolynomial.map (algebraMap ℚ ℂ) R, by simp only [map_mul]⟩
  have hQ : MvPolynomial.map (algebraMap ℚ ℂ) D ∣
      MvPolynomial.map (algebraMap ℚ ℂ) Q := by
    obtain ⟨R, rfl⟩ := hDQ
    exact ⟨MvPolynomial.map (algebraMap ℚ ℂ) R, by simp only [map_mul]⟩
  exact unit_back D (h hP hQ)
private theorem map_int_rat_complex (P : MvPolynomial (Fin 2) ℤ) :
    MvPolynomial.map (Int.castRingHom ℂ) P =
      MvPolynomial.map (algebraMap ℚ ℂ)
        (MvPolynomial.map (Int.castRingHom ℚ) P) := by
  ext m
  simp [MvPolynomial.coeff_map]
private theorem hom_pos_map_nonunit (R : MvPolynomial (Fin 2) ℤ) (a : ℕ)
    (ha : 0 < a) (hhom : R.IsHomogeneous a) :
    ¬ IsUnit (MvPolynomial.map (Int.castRingHom ℂ) R) := by
  intro hu
  obtain ⟨c, hc, hRc⟩ := MvPolynomial.isUnit_iff_eq_C_of_isReduced.mp hu
  have hRne : R ≠ 0 := by
    intro h0
    rw [h0, map_zero] at hu
    exact not_isUnit_zero hu
  have hRconst : R = MvPolynomial.C (R.coeff 0) := by
    ext m
    rw [MvPolynomial.coeff_C]
    split_ifs with hm
    · subst hm; rfl
    · have hcm := congrArg (MvPolynomial.coeff m) hRc
      rw [MvPolynomial.coeff_map, MvPolynomial.coeff_C, if_neg hm] at hcm
      have hcm' : ((R.coeff m : ℤ) : ℂ) = ((0 : ℤ) : ℂ) := by simpa using hcm
      exact Int.cast_injective hcm'
  have hdeg : R.totalDegree = a := hhom.totalDegree hRne
  rw [hRconst, MvPolynomial.totalDegree_C] at hdeg
  omega
