      (hMenuNe m hm) (hMenuBound m hm) hdisc
    change (Level m).Finite ∧ ((Level m).ncard:ℝ)≤Cq*x^(ε/2) at hq
    exact hq
  let Fset (m:ℤ) : Finset (ℤ×ℤ) :=
    if hm : m∈Menu then (hLevel m hm).1.toFinset else ∅
  let T : Finset (ℤ×ℤ) := Menu.biUnion Fset
  let f : OriginalQuad → ℤ×ℤ :=
