        (fun m => ⟨
          JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C01.PcParam.PP_coeff
            G 2 hG H (by linarith) hcoef m,
          JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C01.PcParam.QQ_coeff
            G 2 hG H (by linarith) hcoef m⟩)
private theorem original_CForm_eq_PP
    (G : MvPolynomial (Fin 4) ℤ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = 2 ∧ m 2 + m 3 = 1)
    (d e : ℤ) :
    A5QuarticConjugateOriginalGraphFreeze.CForm G d e =
      MvPolynomial.eval ![d,e]
        (JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C01.PcParam.PP G) := by
  have hlin :=
    JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C01.PcParam.lin_eval
      G 2 hG d e 1 0
  simpa [A5QuarticConjugateOriginalGraphFreeze.CForm] using hlin
private theorem original_EForm_eq_neg_QQ
    (G : MvPolynomial (Fin 4) ℤ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = 2 ∧ m 2 + m 3 = 1)
    (d e : ℤ) :
    A5QuarticConjugateOriginalGraphFreeze.EForm G d e =
      -MvPolynomial.eval ![d,e]
        (JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C01.PcParam.QQ G) := by
  have hlin :=
    JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C01.PcParam.lin_eval
      G 2 hG d e 0 1
  simpa [A5QuarticConjugateOriginalGraphFreeze.EForm] using
    congrArg (fun z : ℤ => -z) hlin
private theorem original_graph_relation
    (G : MvPolynomial (Fin 4) ℤ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = 2 ∧ m 2 + m 3 = 1)
    (d e u v : ℤ)
    (hz : MvPolynomial.eval ![d,e,u,v] G = 0) :
    A5QuarticConjugateOriginalGraphFreeze.CForm G d e * u =
      A5QuarticConjugateOriginalGraphFreeze.EForm G d e * v := by
  have hlin :=
    JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C01.PcParam.lin_eval
      G 2 hG d e u v
  rw [hz] at hlin
  rw [original_CForm_eq_PP G hG d e, original_EForm_eq_neg_QQ G hG d e]
  linear_combination -hlin
private theorem finite_original_parameter_cover
    (S : Set A5QuarticConjugateOriginalGraphFreeze.OriginalQuad)
    (T : Finset (ℤ × ℤ))
    (f : A5QuarticConjugateOriginalGraphFreeze.OriginalQuad → ℤ × ℤ)
    (hinj : Set.InjOn f S)
    (hmap : ∀ q ∈ S, f q ∈ T) :
    S.Finite ∧ S.ncard ≤ T.card := by
  have hmap' : ∀ q ∈ S, f q ∈ (↑T : Set (ℤ × ℤ)) := hmap
  have himg : (f '' S).Finite :=
    (Finset.finite_toSet T).subset
      (by rintro _ ⟨q,hq,rfl⟩; exact hmap' q hq)
  refine ⟨Set.Finite.of_finite_image himg hinj, ?_⟩
  calc
    S.ncard ≤ (↑T : Set (ℤ × ℤ)).ncard :=
      Set.ncard_le_ncard_of_injOn f hmap' hinj (Finset.finite_toSet T)
    _ = T.card := Set.ncard_coe_finset T
end A5QuarticConjugateResultantPrivate
namespace A5QuarticConjugateFactorHeightPrivate
private theorem nonneg_le_of_sq_le
    (y T : ℝ) (_hy : 0 ≤ y) (hT : 1 ≤ T) (hsq : y ^ 2 ≤ T) :
    y ≤ T := by
  by_contra h
  have hgt : T < y := lt_of_not_ge h
  have hy1 : 1 < y := lt_of_le_of_lt hT hgt
  have hm : 0 < y * (y - 1) :=
    mul_pos (by linarith) (by linarith)
  nlinarith
private theorem factor_coeff_bound_from_three_samples
    (A B C₀ : ℤ) (cabs H : ℝ)
    (hc : 1 ≤ cabs) (hH : 1 ≤ H)
    (hA : cabs * |(A : ℝ)| ^ 2 ≤ H)
    (hC : cabs * |(C₀ : ℝ)| ^ 2 ≤ H)
    (hS : cabs * |((A + B + C₀ : ℤ) : ℝ)| ^ 2 ≤ 6 * H) :
    |(A : ℝ)| ≤ H ∧ |(B : ℝ)| ≤ 8 * H ∧
      |(C₀ : ℝ)| ≤ H := by
  have ha2 : |(A : ℝ)| ^ 2 ≤ H := by
    have hm := mul_le_mul_of_nonneg_right hc (sq_nonneg |(A : ℝ)|)
    nlinarith
  have hc2 : |(C₀ : ℝ)| ^ 2 ≤ H := by
    have hm := mul_le_mul_of_nonneg_right hc (sq_nonneg |(C₀ : ℝ)|)
    nlinarith
  have hs2 : |((A + B + C₀ : ℤ) : ℝ)| ^ 2 ≤ 6 * H := by
    have hm := mul_le_mul_of_nonneg_right hc
      (sq_nonneg |((A + B + C₀ : ℤ) : ℝ)|)
    nlinarith
  have ha : |(A : ℝ)| ≤ H :=
    nonneg_le_of_sq_le _ _ (abs_nonneg _) hH ha2
  have hc0 : |(C₀ : ℝ)| ≤ H :=
    nonneg_le_of_sq_le _ _ (abs_nonneg _) hH hc2
  have hs : |((A + B + C₀ : ℤ) : ℝ)| ≤ 6 * H :=
    nonneg_le_of_sq_le _ _ (abs_nonneg _) (by linarith) hs2
  have hbtri :
      |(B : ℝ)| ≤
        |((A + B + C₀ : ℤ) : ℝ)| + |(A : ℝ)| + |(C₀ : ℝ)| := by
    have h₁ :
        |((A + B + C₀ : ℤ) : ℝ) - (A : ℝ) - (C₀ : ℝ)| ≤
          |((A + B + C₀ : ℤ) : ℝ) - (A : ℝ)| + |(C₀ : ℝ)| := by
      simpa only [sub_eq_add_neg, abs_neg] using
        (abs_add_le (((A + B + C₀ : ℤ) : ℝ) - (A : ℝ)) (-(C₀ : ℝ)))
    have h₂ :
        |((A + B + C₀ : ℤ) : ℝ) - (A : ℝ)| ≤
          |((A + B + C₀ : ℤ) : ℝ)| + |(A : ℝ)| := by
      simpa only [sub_eq_add_neg, abs_neg] using
        (abs_add_le ((A + B + C₀ : ℤ) : ℝ) (-(A : ℝ)))
    have heq :
        (B : ℝ) =
          ((A + B + C₀ : ℤ) : ℝ) - (A : ℝ) - (C₀ : ℝ) := by
      push_cast
      ring
    rw [heq]
    linarith
  refine ⟨ha, ?_, hc0⟩
  linarith
private theorem factor_coeff_bound_from_sample_identities
    (A B C₀ cR C01 C11 E10 E11 : ℤ) (H : ℝ)
    (hH : 1 ≤ H) (hcR : cR ≠ 0)
    (hE10 : |(E10 : ℝ)| ≤ H)
    (hC01 : |(C01 : ℝ)| ≤ H)
    (hC11 : |(C11 : ℝ)| ≤ 3 * H)
    (hE11 : |(E11 : ℝ)| ≤ 3 * H)
    (h10 : -(E10 : ℝ) = (cR : ℝ) * (A : ℝ) ^ 2)
    (h01 : (C01 : ℝ) = (cR : ℝ) * (C₀ : ℝ) ^ 2)
    (h11 : (C11 : ℝ) - (E11 : ℝ) =
      (cR : ℝ) * ((A + B + C₀ : ℤ) : ℝ) ^ 2) :
    |(A : ℝ)| ≤ H ∧ |(B : ℝ)| ≤ 8 * H ∧
      |(C₀ : ℝ)| ≤ H := by
  have hcabs : (1 : ℝ) ≤ |(cR : ℝ)| := by
    have hsplit : cR ≤ -1 ∨ 1 ≤ cR := by omega
    rcases hsplit with hn | hp
    · have hnr : (cR : ℝ) ≤ -1 := by exact_mod_cast hn
      rw [abs_of_nonpos (by linarith : (cR : ℝ) ≤ 0)]
      linarith
    · have hpr : (1 : ℝ) ≤ (cR : ℝ) := by exact_mod_cast hp
      rw [abs_of_nonneg (by linarith : (0 : ℝ) ≤ cR)]
      exact hpr
  have ha :
      |(cR : ℝ)| * |(A : ℝ)| ^ 2 ≤ H := by
    calc
      _ = |(cR : ℝ) * (A : ℝ) ^ 2| := by simp [abs_mul, abs_pow]
      _ = |(E10 : ℝ)| := by rw [←h10, abs_neg]
      _ ≤ H := hE10
  have hc :
      |(cR : ℝ)| * |(C₀ : ℝ)| ^ 2 ≤ H := by
    calc
      _ = |(cR : ℝ) * (C₀ : ℝ) ^ 2| := by simp [abs_mul, abs_pow]
      _ = |(C01 : ℝ)| := by rw [←h01]
      _ ≤ H := hC01
  have hs :
      |(cR : ℝ)| * |((A + B + C₀ : ℤ) : ℝ)| ^ 2 ≤ 6 * H := by
    have htri :
        |(C11 : ℝ) - (E11 : ℝ)| ≤ |(C11 : ℝ)| + |(E11 : ℝ)| := by
      simpa only [sub_eq_add_neg, abs_neg] using
        (abs_add_le (C11 : ℝ) (-(E11 : ℝ)))
    calc
      _ = |(cR : ℝ) * ((A + B + C₀ : ℤ) : ℝ) ^ 2| := by
        simp [abs_mul, abs_pow]
      _ = |(C11 : ℝ) - (E11 : ℝ)| := by rw [←h11]
      _ ≤ 6 * H := by linarith
  exact factor_coeff_bound_from_three_samples A B C₀
    |(cR : ℝ)| H hcabs hH ha hc hs
end A5QuarticConjugateFactorHeightPrivate
namespace A5PureQuarticArithmeticOrig
open MvPolynomial
def m20 : Fin 2 →₀ ℕ := Finsupp.single 0 2
def m11 : Fin 2 →₀ ℕ :=
  Finsupp.single 0 1 + Finsupp.single 1 1
def m02 : Fin 2 →₀ ℕ := Finsupp.single 1 2
abbrev X₀ : MvPolynomial (Fin 2) ℤ := X 0
abbrev X₁ : MvPolynomial (Fin 2) ℤ := X 1
lemma quadratic_index_three
    (m : Fin 2 →₀ ℕ) (hm : Finsupp.degree m = 2) :
    m = m20 ∨ m = m11 ∨ m = m02 := by
  have hs : m 0 + m 1 = 2 := by
    simpa [Finsupp.degree_eq_sum, Fin.sum_univ_two] using hm
  have hc : m 0 = 0 ∨ m 0 = 1 ∨ m 0 = 2 := by omega
  rcases hc with h0 | h1 | h2
  · right; right; ext i; fin_cases i <;>
      simp [m02] <;> omega
  · right; left; ext i; fin_cases i <;>
      simp [m11,  Finsupp.add_apply] <;> omega
  · left; ext i; fin_cases i <;>
      simp [m20] <;> omega
lemma homogeneous_quadratic_three
    (P : MvPolynomial (Fin 2) ℤ) (hP : P.IsHomogeneous 2) :
    P = monomial m20 (coeff m20 P) +
      monomial m11 (coeff m11 P) +
      monomial m02 (coeff m02 P) := by
  classical
  have h2011 : m20 ≠ m11 := by
    intro h
    have hh := congrArg (fun z : Fin 2 →₀ ℕ => z 0) h
    norm_num [m20, m11, Finsupp.add_apply] at hh
  have h2002 : m20 ≠ m02 := by
    intro h
    have hh := congrArg (fun z : Fin 2 →₀ ℕ => z 0) h
    norm_num [m20, m02] at hh
  have h1102 : m11 ≠ m02 := by
    intro h
    have hh := congrArg (fun z : Fin 2 →₀ ℕ => z 0) h
    norm_num [m11, m02, Finsupp.add_apply] at hh
  ext m
  simp only [coeff_add, coeff_monomial]
  by_cases h20 : m20 = m
  · subst m
    simp [  Ne.symm h2011, Ne.symm h2002]
  by_cases h11 : m11 = m
  · subst m
    simp [h2011,   Ne.symm h1102]
  by_cases h02 : m02 = m
  · subst m
    simp [h2002, h1102, ]
  have hz : coeff m P = 0 := by
    by_contra hc
    have hd : Finsupp.degree m = 2 := by
      by_contra hn
      exact hc (hP.coeff_eq_zero hn)
    rcases quadratic_index_three m hd with h | h | h
    · exact h20 h.symm
    · exact h11 h.symm
    · exact h02 h.symm
  simp [h20, h11, h02, hz]
lemma homogeneous_quadratic_explicit
    (P : MvPolynomial (Fin 2) ℤ) (hP : P.IsHomogeneous 2) :
    P = C (coeff m20 P) * X₀ ^ 2 +
      C (coeff m11 P) * X₀ * X₁ +
      C (coeff m02 P) * X₁ ^ 2 := by
  conv_lhs => rw [homogeneous_quadratic_three P hP]
  rw [show m11 = Finsupp.single (0 : Fin 2) 1 +
      Finsupp.single 1 1 from rfl]
  rw [FormalAB.S4e61b76c.ConsecutiveCountingA5PureCubicNormalForm.monomial_mixed]
  simp only [m20, m02, X₀, X₁]
  rw [← C_mul_X_pow_eq_monomial, ← C_mul_X_pow_eq_monomial]
  simp only [pow_one]
lemma homogeneous_quadratic_eval
    (P : MvPolynomial (Fin 2) ℤ) (hP : P.IsHomogeneous 2)
    (d e : ℤ) :
    eval ![d,e] P =
      (coeff m20 P) * d ^ 2 +
      (coeff m11 P) * d * e +
      (coeff m02 P) * e ^ 2 := by
  have h := congrArg (eval ![d,e]) (homogeneous_quadratic_explicit P hP)
  simpa [X₀, X₁, mul_assoc] using h
lemma homogeneous_quadratic_sample_bounds
    (P : MvPolynomial (Fin 2) ℤ) (hP : P.IsHomogeneous 2)
    (H : ℝ) (hc : ∀ m : Fin 2 →₀ ℕ,
      |((P.coeff m : ℤ) : ℝ)| ≤ H) :
    |((eval ![(1:ℤ),0] P : ℤ) : ℝ)| ≤ H ∧
    |((eval ![(0:ℤ),1] P : ℤ) : ℝ)| ≤ H ∧
    |((eval ![(1:ℤ),1] P : ℤ) : ℝ)| ≤ 3 * H := by
  have h0 := hc m20
  have h1 := hc m11
  have h2 := hc m02
  have e0 : eval ![(1:ℤ),0] P = coeff m20 P := by
    rw [homogeneous_quadratic_eval P hP]
    ring
  have e2 : eval ![(0:ℤ),1] P = coeff m02 P := by
    rw [homogeneous_quadratic_eval P hP]
    ring
  have e1 : eval ![(1:ℤ),1] P =
      coeff m20 P + coeff m11 P + coeff m02 P := by
    rw [homogeneous_quadratic_eval P hP]
    ring
  refine ⟨?_, ?_, ?_⟩
  · simpa [e0] using h0
  · simpa [e2] using h2
  · rw [e1]
    push_cast
    have htri :=
      abs_add_le (((coeff m20 P : ℤ) : ℝ) +
        ((coeff m11 P : ℤ) : ℝ)) ((coeff m02 P : ℤ) : ℝ)
    have htri' := abs_add_le
      ((coeff m20 P : ℤ) : ℝ) ((coeff m11 P : ℤ) : ℝ)
    linarith
end A5PureQuarticArithmeticOrig
namespace A5QuarticConjugateOriginalGraphFreeze
private theorem canonical_factor_coeff_height
    (G : MvPolynomial (Fin 4) ℤ)
    (hG : IsBidegree21 G)
    (H : ℝ) (hH : 1 ≤ H)
    (hcoef : ∀ m : Fin 4 →₀ ℕ,
      |((G.coeff m : ℤ) : ℝ)| ≤ H)
    (cR A B C₀ : ℤ) (hcR : cR ≠ 0)
    (hid : ∀ d e : ℤ,
      EliminationQuartic G d e =
        cR * (QuadraticValue A B C₀ d e) ^ 2) :
    |(A : ℝ)| ≤ H ∧ |(B : ℝ)| ≤ 8 * H ∧
      |(C₀ : ℝ)| ≤ H := by
  have hP := JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C01.PcParam.PP_hom G 2 hG
  have hQ := JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C01.PcParam.QQ_hom G 2 hG
  have hpcoef : ∀ m : Fin 2 →₀ ℕ,
      |(((JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C01.PcParam.PP G).coeff m : ℤ) : ℝ)| ≤ H := by
    intro m
    exact JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C01.PcParam.PP_coeff
      G 2 hG H (by linarith) hcoef m
  have hqcoef : ∀ m : Fin 2 →₀ ℕ,
      |(((JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C01.PcParam.QQ G).coeff m : ℤ) : ℝ)| ≤ H := by
    intro m
    exact JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C01.PcParam.QQ_coeff
      G 2 hG H (by linarith) hcoef m
  have hPs := A5PureQuarticArithmeticOrig.homogeneous_quadratic_sample_bounds
    _ hP H hpcoef
  have hQs := A5PureQuarticArithmeticOrig.homogeneous_quadratic_sample_bounds
    _ hQ H hqcoef
  have hE10 : |((EForm G 1 0 : ℤ) : ℝ)| ≤ H := by
    rw [A5QuarticConjugateResultantPrivate.original_EForm_eq_neg_QQ G hG]
    simpa only [Int.cast_neg, abs_neg] using hQs.1
  have hC01 : |((CForm G 0 1 : ℤ) : ℝ)| ≤ H := by
    rw [A5QuarticConjugateResultantPrivate.original_CForm_eq_PP G hG]
    exact hPs.2.1
  have hC11 : |((CForm G 1 1 : ℤ) : ℝ)| ≤ 3 * H := by
    rw [A5QuarticConjugateResultantPrivate.original_CForm_eq_PP G hG]
    exact hPs.2.2
  have hE11 : |((EForm G 1 1 : ℤ) : ℝ)| ≤ 3 * H := by
    rw [A5QuarticConjugateResultantPrivate.original_EForm_eq_neg_QQ G hG]
    simpa only [Int.cast_neg, abs_neg] using hQs.2.2
  have h10z : -EForm G 1 0 = cR * A ^ 2 := by
    simpa [EliminationQuartic, QuadraticValue] using hid 1 0
  have h01z : CForm G 0 1 = cR * C₀ ^ 2 := by
    simpa [EliminationQuartic, QuadraticValue] using hid 0 1
  have h11z : CForm G 1 1 - EForm G 1 1 =
      cR * (A + B + C₀) ^ 2 := by
    simpa [EliminationQuartic, QuadraticValue] using hid 1 1
  have h10r : -(EForm G 1 0 : ℝ) = (cR : ℝ) * (A : ℝ) ^ 2 := by
    exact_mod_cast h10z
  have h01r : (CForm G 0 1 : ℝ) = (cR : ℝ) * (C₀ : ℝ) ^ 2 := by
    exact_mod_cast h01z
  have h11r : (CForm G 1 1 : ℝ) - (EForm G 1 1 : ℝ) =
      (cR : ℝ) * ((A + B + C₀ : ℤ) : ℝ) ^ 2 := by
    exact_mod_cast h11z
  exact A5QuarticConjugateFactorHeightPrivate.factor_coeff_bound_from_sample_identities
    A B C₀ cR (CForm G 0 1) (CForm G 1 1)
    (EForm G 1 0) (EForm G 1 1) H hH hcR
    hE10 hC01 hC11 hE11 h10r h01r h11r
end A5QuarticConjugateOriginalGraphFreeze
namespace A5QuarticConjugateOriginalGraphFreeze
open A5QuarticConjugateResultantPrivate
open FormalAB.S84900580.ConsecutiveCountingA5Full12Nonexceptional
private theorem graph_to_norm_finite_cover :
    GraphToNormFiniteCoverStatement := by
  intro K
  refine ⟨8*K+10, ?_⟩
  intro x hx G hG hCirr hHeight h hsign cR A B C₀ hcR hdisc hid
  let K' : ℕ := 8*K+10
  let S := OriginalPositivePopulation G h x
  have hx0 : (0:ℝ) < x := by linarith
  have hx1 : (1:ℝ) ≤ x := by linarith
  have hH : (1:ℝ) ≤ x^K := one_le_pow₀ hx1
  have hcoef : ∀ m : Fin 4 →₀ ℕ,
      |((G.coeff m : ℤ) : ℝ)| ≤ x^K := by
    intro m
    by_cases hm : m ∈ G.support
    · exact hHeight m hm
    · have hz : G.coeff m = 0 := by
        by_contra hn
        exact hm (MvPolynomial.mem_support_iff.mpr hn)
      simpa [hz] using (pow_nonneg hx0.le K)
  obtain ⟨hA,hBcoef,hC⟩ :=
    canonical_factor_coeff_height G hG (x^K) hH hcoef cR A B C₀ hcR hid
  have hx3 : (8:ℝ) ≤ x^3 := by
    have ht : (2:ℝ)^3 ≤ x^3 := pow_le_pow_left₀ (by norm_num) hx 3
    norm_num at ht ⊢
    exact ht
  have h8 : 8*x^K ≤ x^K' := by
    calc
      8*x^K ≤ x^3*x^K :=
        mul_le_mul_of_nonneg_right hx3 (pow_nonneg hx0.le K)
      _ = x^(K+3) := by rw [pow_add]; ring
      _ ≤ x^K' := pow_le_pow_right₀ hx1 (by dsimp [K']; omega)
  have h1 : |(A:ℝ)| ≤ x^K' := hA.trans (le_trans
    (by nlinarith [pow_nonneg hx0.le K] : x^K ≤ 8*x^K) h8)
  have h2 : |(B:ℝ)| ≤ x^K' := hBcoef.trans h8
  have h3 : |(C₀:ℝ)| ≤ x^K' := hC.trans (le_trans
    (by nlinarith [pow_nonneg hx0.le K] : x^K ≤ 8*x^K) h8)
  obtain ⟨Br,hBr0,hBrbound,hres⟩ :=
    canonical_pp_qq_resultant G hG hCirr (x^K) hH
      hcoef
  let N : ℕ := Br.natAbs
  have hNpos : 0 < N := Int.natAbs_pos.mpr hBr0
  have hx10 : (576:ℝ) ≤ x^10 := by
    have ht : (2:ℝ)^10 ≤ x^10 := pow_le_pow_left₀ (by norm_num) hx 10
    norm_num at ht ⊢
    linarith
  have hNbound : (N:ℝ) ≤ x^K' := by
    have hcast : (N:ℝ) = |(Br:ℝ)| := by
      dsimp [N]
      rw [←Int.cast_natCast, Int.natCast_natAbs, Int.cast_abs]
    calc
      (N:ℝ) = |(Br:ℝ)| := hcast
      _ ≤ 576*(x^K)^8 := hBrbound
      _ = 576*x^(8*K) := by
        simp only [pow_mul, Nat.mul_comm 8 K]
      _ ≤ x^10*x^(8*K) :=
        mul_le_mul_of_nonneg_right hx10 (pow_nonneg hx0.le _)
      _ = x^K' := by dsimp [K']; rw [←pow_add]; congr 1; omega
  refine ⟨h1,h2,h3,N,hNpos,hNbound,?_,?_⟩
  · intro q hq
    change q ∈ OriginalPositivePopulation G h x at hq
    rcases q with ⟨⟨d,e⟩,⟨u,v⟩⟩
    dsimp [OriginalPositivePopulation] at hq
    rcases hq with ⟨hdpos,hepos,hupos,hvpos,hshift,hsize,hzero⟩
    have hshiftNat :
        ((e^2*v:ℕ):ℤ) = ((d^2*u:ℕ):ℤ)+h := by
      push_cast
      omega
    have hcop := both_coprime d e u v h hsign hshiftNat
