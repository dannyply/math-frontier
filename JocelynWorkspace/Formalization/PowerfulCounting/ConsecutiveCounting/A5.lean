def unitBudget (D : ℤ) (H : ℝ) : ℕ :=
  10 + 4 * ⌈Real.log (H * (1 + Real.sqrt |(D : ℝ)|)) / Real.log 2⌉₊ + 2
def unitConstant (L : ℕ) : ℝ :=
  4 * (2 * (L : ℝ) + 1) / Real.log 2 + 16
theorem unit_budget (L : ℕ) (x : ℝ) (hx : 2 ≤ x)
    (D : ℤ) (H : ℝ) (hH : 1 ≤ H)
    (hHb : H ≤ x ^ L) (hDb : |(D : ℝ)| ≤ x ^ L) :
    (unitBudget D H : ℝ) ≤ unitConstant L * (1 + Real.log x) := by
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hp : 1 ≤ x ^ L := one_le_pow₀ hx1
  have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hlogx : 0 ≤ Real.log x := Real.log_nonneg hx1
  have hs : 0 ≤ Real.sqrt |(D : ℝ)| := Real.sqrt_nonneg _
  have hs2 : (Real.sqrt |(D : ℝ)|)^2 = |(D : ℝ)| := Real.sq_sqrt (abs_nonneg _)
  have hsb : Real.sqrt |(D : ℝ)| ≤ x ^ L := by nlinarith
  let B : ℝ := H * (1 + Real.sqrt |(D : ℝ)|)
  have hB : 1 ≤ B := by dsimp [B]; nlinarith
  have hB0 : 0 < B := by linarith
  have hBX : B ≤ x ^ (2 * L + 1) := by
    calc
      B ≤ x ^ L * (1 + x ^ L) := by
        exact mul_le_mul hHb (by linarith) (by positivity) (by positivity)
      _ ≤ 2 * (x ^ L)^2 := by nlinarith
      _ ≤ x * (x ^ L)^2 := mul_le_mul_of_nonneg_right hx (sq_nonneg _)
      _ = x ^ (2 * L + 1) := by
        have heq : (x ^ L)^2 = x^(2*L) := by
          rw [← pow_mul]
          congr 1
          omega
        rw [heq, pow_succ]
        ring
  have hlogB : Real.log B ≤ (2 * (L : ℝ) + 1) * Real.log x := by
    have hh := Real.log_le_log hB0 hBX
    simpa only [Real.log_pow, Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat, Nat.cast_one]
      using hh
  have hq : 0 ≤ Real.log B / Real.log 2 :=
    div_nonneg (Real.log_nonneg hB) hlog2.le
  have hc := (Nat.ceil_lt_add_one hq).le
  have hd := div_le_div_of_nonneg_right hlogB hlog2.le
  have hcoeff : 0 ≤ 4 * (2 * (L : ℝ) + 1) / Real.log 2 := by positivity
  have hraw : (unitBudget D H : ℝ) ≤
      16 + (4 * (2 * (L : ℝ) + 1) / Real.log 2) * Real.log x := by
    dsimp [unitBudget]
    push_cast
    change 10 + 4 * (⌈Real.log B / Real.log 2⌉₊ : ℝ) + 2 ≤ _
