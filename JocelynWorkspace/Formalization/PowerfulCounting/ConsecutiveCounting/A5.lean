            (∀ z ∈ F,
              z.1 ≠ 0 ∧ z.1 ∣ (a * B₀ - b * A₀) ∧ 0 < z.2.2 ∧
              let T : ℕ := c.natAbs * z.1.natAbs ^ 5;
