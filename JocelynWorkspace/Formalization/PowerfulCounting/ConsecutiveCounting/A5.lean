  have hR : D/E ≤ x^(asymmetry x D E) := by
    have hr := Real.rpow_logb hx0 (ne_of_gt hx) (div_pos hD hE)
    change x^(Real.log (D/E)/Real.log x)=D/E at hr
    rw [← hr]
    apply Real.rpow_le_rpow_of_exponent_le hx.le
    exact div_le_div_of_nonneg_right (le_abs_self _) hlog.le
  have hS : E/D ≤ x^(asymmetry x D E) := by
    have hr := Real.rpow_logb hx0 (ne_of_gt hx) (div_pos hE hD)
    change x^(Real.log (E/D)/Real.log x)=E/D at hr
    rw [← hr]
    apply Real.rpow_le_rpow_of_exponent_le hx.le
    unfold asymmetry
    rw [hlogInv]
    exact div_le_div_of_nonneg_right (neg_le_abs _) hlog.le
  have hpow : (x^(asymmetry x D E))^2=x^(2*asymmetry x D E) := by
    rw [←Real.rpow_natCast,←Real.rpow_mul hx0.le]
    congr 1
    ring
  constructor
  · simpa only [hpow] using
      pow_le_pow_left₀ (div_nonneg hD.le hE.le) hR 2
  · simpa only [hpow] using
      pow_le_pow_left₀ (div_nonneg hE.le hD.le) hS 2
private lemma cofactor_product (x s D E : ℝ)
    (hx : 0 < x) (hD : 0 < D) (hE : 0 < E)
