  let Fσ : Polynomial ℤ := C σ*F
  let Gσ : Polynomial ℤ := C σ*G
  have hFσ : Fσ.natDegree ≤ 3 := by
    exact (natDegree_mul_le.trans (Nat.add_le_add (show (C σ).natDegree≤0 by simp) hF))
  have hGσ : Gσ.natDegree ≤ 3 := by
    exact (natDegree_mul_le.trans (Nat.add_le_add (show (C σ).natDegree≤0 by simp) hG))
  have hFUσ : Fσ.map (Int.castRingHom ℚ)=C (T:ℚ)*U := by
    change (C σ*F).map (Int.castRingHom ℚ)=C (T:ℚ)*U
    rw [Polynomial.map_mul,Polynomial.map_C,hFU,cast_apply]
    rw [hTmQ,C_mul]
    ring
  have hGVσ : Gσ.map (Int.castRingHom ℚ)=C (T:ℚ)*V := by
    change (C σ*G).map (Int.castRingHom ℚ)=C (T:ℚ)*V
    rw [Polynomial.map_mul,Polynomial.map_C,hGV,cast_apply]
    rw [hTmQ,C_mul]
    ring
  obtain ⟨S,hSc,hSg,hSv⟩ := integer_pair_global T hT.ne' Fσ Gσ hFσ hGσ
  refine ⟨S,?_,?_,?_⟩
  · simpa only [T,Nat.primeFactors_pow m.natAbs (by decide : (3:ℕ)≠0)] using hSc
  · intro s hs
    obtain ⟨hpos,hFs,hGs⟩ := hSg s hs
    have unscale (A : Polynomial ℤ)
        (hA : C (T:ℤ) ∣ (C σ*A).comp (progressionAffine s)) :
        C (m^3) ∣ A.comp (progressionAffine s) := by
      obtain ⟨B,hB⟩ := hA
      refine ⟨B,?_⟩
      apply mul_left_cancel₀ (C_ne_zero.mpr hσ)
      calc
        C σ*A.comp (progressionAffine s) =
            (C σ*A).comp (progressionAffine s) := by rw [mul_comp,C_comp]
        _ = C (T:ℤ)*B := hB
        _ = C σ*(C (m^3)*B) := by rw [hTm,C_mul]; ring
    exact ⟨hpos,unscale F hFs,unscale G hGs,
      denominator_coefficients T hT U Fσ hFUσ s hFs,
      denominator_coefficients T hT V Gσ hGVσ s hGs⟩
  · intro r hu hv
    exact hSv r
      (by obtain ⟨u,hu⟩:=hu; exact denominator_value T U Fσ hFUσ r u hu)
      (by obtain ⟨v,hv⟩:=hv; exact denominator_value T V Gσ hGVσ r v hv)
theorem deg_add (F G:Polynomial ℤ) (n:ℕ)
    (hF:F.natDegree≤n) (hG:G.natDegree≤n) : (F+G).natDegree≤n :=
  (natDegree_add_le F G).trans (max_le hF hG)
theorem deg_sub (F G:Polynomial ℤ) (n:ℕ)
    (hF:F.natDegree≤n) (hG:G.natDegree≤n) : (F-G).natDegree≤n :=
  (natDegree_sub_le F G).trans (max_le hF hG)
theorem deg_cmul (r:ℤ) (F:Polynomial ℤ) (n:ℕ)
    (hF:F.natDegree≤n) : (C r*F).natDegree≤n := by
  simpa using (natDegree_mul_le.trans
    (Nat.add_le_add (show (C r).natDegree≤0 by simp) hF))
theorem deg_sq (F:Polynomial ℤ) (hF:F.natDegree≤1) : (F^2).natDegree≤2 := by
  rw [pow_two]
  exact natDegree_mul_le.trans (Nat.add_le_add hF hF)
theorem coeff_certificate
    (a b q db eb J:ℤ) :
    let D:Polynomial ℤ := C db+C (b*J)*X;
    let E:Polynomial ℤ := C eb-C (a*J)*X;
    let F := C q*E^2-C (a^2)*(C a*D+C (3*b)*E);
    let G := C q*D^2+C (b^2)*(C (3*a)*D+C b*E);
    F.coeff 0=q*eb^2-a^2*(a*db+3*b*eb) ∧
    G.coeff 0=q*db^2+b^2*(3*a*db+b*eb) ∧
    F.coeff 1= -(2*a*J*(q*eb-a^2*b)) ∧
    G.coeff 1=2*b*J*(q*db+a*b^2) ∧
    F.coeff 2=q*a^2*J^2 ∧ G.coeff 2=q*b^2*J^2 := by
  intro D E F G
  have hF : F =
      C (q*eb^2-a^2*(a*db+3*b*eb))+
      C (-(2*a*J*(q*eb-a^2*b)))*X+
      C (q*a^2*J^2)*X^2 := by
    dsimp [F,D,E]
    simp only [C_add,C_sub,C_mul,C_pow,C_neg,map_ofNat]
    ring
  have hG : G =
      C (q*db^2+b^2*(3*a*db+b*eb))+
      C (2*b*J*(q*db+a*b^2))*X+
      C (q*b^2*J^2)*X^2 := by
    dsimp [G,D,E]
    simp only [C_add,C_mul,C_pow,map_ofNat]
    ring
  rw [hF,hG]
  norm_num only [coeff_add,coeff_C_mul,coeff_C,coeff_X,coeff_X_pow]
  simp only [ite_true,ite_false,mul_zero,mul_one,add_zero,zero_add]
  repeat' constructor
end A5P2LineCover
