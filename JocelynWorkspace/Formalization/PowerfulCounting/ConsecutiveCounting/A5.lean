private theorem unit_coprime (a b : ℕ) (h : ℤ)
    (hsign : h = 1 ∨ h = -1) (heq : (a : ℤ) = (b : ℤ) + h) :
    a.Coprime b := by
  apply Nat.coprime_of_dvd'
  intro p hp hpa hpb
  have haZ : (p : ℤ) ∣ (a : ℤ) := by exact_mod_cast hpa
  have hbZ : (p : ℤ) ∣ (b : ℤ) := by exact_mod_cast hpb
  have hph : (p : ℤ) ∣ h := by
    have hh : h = (a : ℤ) - (b : ℤ) := by omega
    rw [hh]
    exact dvd_sub haZ hbZ
  rcases hsign with rfl | rfl
  · exact_mod_cast hph
  · have hp1 : (p : ℤ) ∣ (1 : ℤ) := by
      simpa using (dvd_neg.mpr hph : (p : ℤ) ∣ -(-1 : ℤ))
    exact_mod_cast hp1
private theorem both_coprime (d e u v : ℕ) (h : ℤ)
    (hsign : h = 1 ∨ h = -1)
    (hshift : ((e ^ 2 * v : ℕ) : ℤ) = ((d ^ 2 * u : ℕ) : ℤ) + h) :
    d.Coprime e ∧ u.Coprime v := by
  have hn := (unit_coprime (e ^ 2 * v) (d ^ 2 * u) h hsign hshift).symm
  have hdvd : d ∣ d ^ 2 * u := ⟨d * u, by ring⟩
  have hevd : e ∣ e ^ 2 * v := ⟨e * v, by ring⟩
  have huvd : u ∣ d ^ 2 * u := ⟨d ^ 2, by ring⟩
  have hvvd : v ∣ e ^ 2 * v := ⟨e ^ 2, by ring⟩
  exact ⟨hn.of_dvd hdvd hevd, hn.of_dvd huvd hvvd⟩
private theorem coprime_rat_div_unique (a b c d : ℕ)
    (ha : 1 ≤ a) (hb : 1 ≤ b) (hd : 1 ≤ d)
    (hab : a.Coprime b) (hcd : c.Coprime d)
    (hr : (a : ℚ) / (b : ℚ) = (c : ℚ) / (d : ℚ)) :
    a = c ∧ b = d := by
  have hb0 : (b : ℚ) ≠ 0 := by exact_mod_cast (by omega : b ≠ 0)
  have hd0 : (d : ℚ) ≠ 0 := by exact_mod_cast (by omega : d ≠ 0)
  have hcross : a * d = c * b := by
    exact_mod_cast (div_eq_div_iff hb0 hd0).mp hr
  have hac : a ∣ c := hab.dvd_of_dvd_mul_right ⟨d, hcross.symm⟩
  have hca : c ∣ a := hcd.dvd_of_dvd_mul_right ⟨b, hcross⟩
  have heq : a = c := Nat.dvd_antisymm hac hca
  subst c
  have hbd : d = b := Nat.eq_of_mul_eq_mul_left (by omega : 0 < a) hcross
  exact ⟨rfl, hbd.symm⟩
theorem original_ratio_injective :
∀ h : ℤ, (h = 1 ∨ h = -1) →
  ∀ d e u v d' e' u' v' : ℕ,
    1 ≤ d → 1 ≤ e → 1 ≤ u → 1 ≤ v →
    1 ≤ d' → 1 ≤ e' → 1 ≤ u' → 1 ≤ v' →
    ((e ^ 2 * v : ℕ) : ℤ) = ((d ^ 2 * u : ℕ) : ℤ) + h →
    ((e' ^ 2 * v' : ℕ) : ℤ) = ((d' ^ 2 * u' : ℕ) : ℤ) + h →
    (d : ℚ) / (e : ℚ) = (d' : ℚ) / (e' : ℚ) →
    (v : ℚ) / (u : ℚ) = (v' : ℚ) / (u' : ℚ) →
    d = d' ∧ e = e' ∧ u = u' ∧ v = v' := by
  intro h hsign d e u v d' e' u' v' hd he hu hv hd' he' hu' hv' hs hs' hr1 hr2
  have hc := both_coprime d e u v h hsign hs
  have hc' := both_coprime d' e' u' v' h hsign hs'
  obtain ⟨hdd, hee⟩ := coprime_rat_div_unique d e d' e' hd he he' hc.1 hc'.1 hr1
  obtain ⟨hvv, huu⟩ := coprime_rat_div_unique v u v' u' hv hu hu' hc.2.symm hc'.2.symm hr2
  exact ⟨hdd, hee, huu, hvv⟩
end A5NongeometricOriginalRatios
