    intro hz
    apply hgamma
    simpa only [hz,Int.cast_zero] using hcc.symm
  refine ⟨a,b,cc,hprim,hcc0,?_⟩
  apply map_injective (Int.castRingHom ℚ) (RingHom.injective_int _)
  rw [hRq]
  simp only [map_mul,map_pow,map_add,map_C,map_X,A5P2LineCover.cast_apply]
  rw [←hcc]
theorem canonical_graph (G:MvPolynomial (Fin 4) ℤ)
    (hG:∀ t∈G.support,t 0+t 1=2 ∧ t 2+t 3=1)
    (hirr:Irreducible G) (H:ℝ) (hH:1≤H)
    (hcoef:∀ t:Fin 4→₀ℕ,|((G.coeff t:ℤ):ℝ)|≤H) :
    let P: MvPolynomial (Fin 2) ℤ := -C01.PcParam.QQ G;
    let Q: MvPolynomial (Fin 2) ℤ := C01.PcParam.PP G;
    P.IsHomogeneous 2 ∧ Q.IsHomogeneous 2 ∧
    IsRelPrime (map (Int.castRingHom ℚ) P) (map (Int.castRingHom ℚ) Q) ∧
    (∀ t:Fin 2→₀ℕ,|((P.coeff t:ℤ):ℝ)|≤H ∧ |((Q.coeff t:ℤ):ℝ)|≤H) ∧
    (∀ d e u v:ℕ,1≤d → 1≤e → 1≤u → 1≤v →
      eval ![(d:ℤ),(e:ℤ),(u:ℤ),(v:ℤ)] G=0 →
      (u:ℤ)*eval ![(d:ℤ),(e:ℤ)] Q=(v:ℤ)*eval ![(d:ℤ),(e:ℤ)] P) := by
  intro P Q
  have htd:G.totalDegree=3 :=
    (C02.PcClassify.isHomogeneous_of_bihom hG).totalDegree hirr.ne_zero
  have hQirr:Irreducible (map (Int.castRingHom ℚ) G) :=
    C02.PcClassify.irreducible_map_rat hirr (by
      intro c hc
      have hh:=htd
      rw [hc,totalDegree_C] at hh
      omega)
  have hCirr:Irreducible (map (Int.castRingHom ℂ) G) :=
    C02.PcClassify.irred_C_a1 G 2 (by omega) hG hQirr
  have hPP:(C01.PcParam.PP G).IsHomogeneous 2 := C01.PcParam.PP_hom G 2 hG
  have hQQ:(C01.PcParam.QQ G).IsHomogeneous 2 := C01.PcParam.QQ_hom G 2 hG
  have hrel:IsRelPrime (map (Int.castRingHom ℂ) (C01.PcParam.PP G))
      (map (Int.castRingHom ℂ) (C01.PcParam.QQ G)) :=
    C01.PcParam.relprime_core G 2 hG hCirr
  refine ⟨hQQ.neg,hPP,?_,?_,?_⟩
  · apply relprime_back
    rw [←map_int_rat_complex (-C01.PcParam.QQ G),←map_int_rat_complex (C01.PcParam.PP G)]
    rw [map_neg]
    intro D hdq hdp
    exact hrel hdp (dvd_neg.mp hdq)
  · intro t
    constructor
    · have hh:=C01.PcParam.QQ_coeff G 2 hG H (by linarith) hcoef t
      simpa only [P,coeff_neg,Int.cast_neg,abs_neg] using hh
    · exact C01.PcParam.PP_coeff G 2 hG H (by linarith) hcoef t
  · intro d e u v hd he hu hv hz
    have hh:=C01.PcParam.lin_eval G 2 hG (d:ℤ) (e:ℤ) (u:ℤ) (v:ℤ)
    rw [hz] at hh
    simp only [P,Q,eval_neg]
    linear_combination -hh
end A5ActualPureQuartic
