  rw [← Real.rpow_natCast, ← Real.rpow_mul hx]
private lemma asymmetry_nonneg (x D E : ℝ) (hx : 1 < x) :
    0 ≤ asymmetry x D E :=
  div_nonneg (abs_nonneg _) (Real.log_pos hx).le
private lemma ratio_square_bounds (x D E : ℝ)
    (hx : 1 < x) (hD : 0 < D) (hE : 0 < E) :
    (D/E)^2 ≤ x^(2*asymmetry x D E) ∧
    (E/D)^2 ≤ x^(2*asymmetry x D E) := by
  have hx0 : 0 < x := by linarith
  have hlog : 0 < Real.log x := Real.log_pos hx
  have hlogInv : Real.log (E/D) = -Real.log (D/E) := by
    rw [Real.log_div hE.ne' hD.ne',Real.log_div hD.ne' hE.ne']
