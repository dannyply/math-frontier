          (MvPolynomial.C A₀ * X₀ + MvPolynomial.C B₀ * X₁) * X₁ ^ 2 -
            MvPolynomial.C c *
              (MvPolynomial.C a * X₀ + MvPolynomial.C b * X₁) ^ 2 *
              MvPolynomial.C (a ^ 2) *
              (MvPolynomial.C a * X₀ + MvPolynomial.C (3 * b) * X₁) →
        Q =
