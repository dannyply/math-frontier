theorem claim_bff82147fcce51d0786cbdbb82d88b4c22080c18d34aa84329ce021942dc9286 : ∀ (P Q : MvPolynomial (Fin 2) ℤ) (a b c K₀ : ℤ) (H : ℝ),
  (∀ t, |((P.coeff t : ℤ) : ℝ)| ≤ H ∧
        |((Q.coeff t : ℤ) : ℝ)| ≤ H) →
  let X₀ : MvPolynomial (Fin 2) ℤ := MvPolynomial.X 0;
  let X₁ : MvPolynomial (Fin 2) ℤ := MvPolynomial.X 1;
