private def binaryExponent (n : ℕ) (i : Fin (n+1)) : Fin 2 →₀ ℕ :=
  Finsupp.single 0 i.val+Finsupp.single 1 (n-i.val)
private theorem binaryExponent_injective (n : ℕ) :
    Function.Injective (binaryExponent n) := by
  intro i j hij
  apply Fin.ext
  have hh := congrArg (fun m : Fin 2 →₀ ℕ => m 0) hij
  simpa [binaryExponent] using hh
private theorem homogeneous_binary_support
    (n : ℕ) (F : MvPolynomial (Fin 2) ℤ) (hF : F.IsHomogeneous n) :
    ∀ m∈F.support, m 0+m 1=n := by
  intro m hm
  have hh := hF (MvPolynomial.mem_support_iff.mp hm)
  change m.sum (fun (_ : Fin 2) (k : ℕ) => k • (1:ℕ))=n at hh
  rw [Finsupp.sum_fintype m _ (by intro i; simp)] at hh
  simpa [Fin.sum_univ_two,nsmul_eq_mul] using hh
private theorem homogeneous_binary_expansion
    (n : ℕ) (F : MvPolynomial (Fin 2) ℤ)
    (hF : ∀ m∈F.support, m 0+m 1=n) :
    F=∑ i : Fin (n+1),
      MvPolynomial.monomial (binaryExponent n i) (F.coeff (binaryExponent n i)) := by
  classical
  ext m
  rw [MvPolynomial.coeff_sum]
  by_cases hm : m 0+m 1=n
  · let i : Fin (n+1) := ⟨m 0,by omega⟩
    have hmi : binaryExponent n i=m := by
      ext j
      fin_cases j <;> simp [binaryExponent,i] <;> omega
    rw [← hmi]
    simp [MvPolynomial.coeff_monomial,(binaryExponent_injective n).eq_iff]
  · have hcoeff : F.coeff m=0 := by
      by_contra hh
      exact hm (hF m (MvPolynomial.mem_support_iff.mpr hh))
    rw [hcoeff]
    symm
    apply Finset.sum_eq_zero
    intro i hi
    rw [MvPolynomial.coeff_monomial]
    apply if_neg
    intro he
    apply hm
    have h0 := congrArg (fun t : Fin 2 →₀ ℕ => t 0) he
    have h1 := congrArg (fun t : Fin 2 →₀ ℕ => t 1) he
    simp [binaryExponent] at h0 h1
    have hiN := i.isLt
    omega
private theorem homogeneous_binary_eval
    (n : ℕ) (F : MvPolynomial (Fin 2) ℤ) (hF : F.IsHomogeneous n)
