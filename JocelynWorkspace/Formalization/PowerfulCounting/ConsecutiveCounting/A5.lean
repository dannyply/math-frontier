    · simp
  let Bad : Finset ℚ := B.filter (fun y => Q.eval y=0)
  have hbad : Bad.card≤n :=
    (univariate_finite_zero_count Q hQ B).trans hQdeg
  let F : ℚ → Finset (ℚ×ℚ) := fun y =>
    (A.filter (fun x => (binaryRow n c k y).eval x=0)).image (fun x => (x,y))
  have hsub :
      (A.product B).filter (fun z =>
        (∑ i : Fin (n+1),c i*z.1^i.val*z.2^(n-i.val))=k)⊆B.biUnion F := by
    intro z hz
    obtain ⟨hzprod,hzlevel⟩ := Finset.mem_filter.mp hz
    obtain ⟨hx,hy⟩ := Finset.mem_product.mp hzprod
    apply Finset.mem_biUnion.mpr
    refine ⟨z.2,hy,Finset.mem_image.mpr ⟨z.1,?_,by simp⟩⟩
    apply Finset.mem_filter.mpr
    refine ⟨hx,?_⟩
