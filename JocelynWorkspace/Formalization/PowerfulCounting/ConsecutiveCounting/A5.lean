          {z | Int.gcd (z 0) (z 1) = 1 ∧
            Int.gcd (z 2) (z 3) = 1 ∧
            MvPolynomial.eval z G = 0 ∧
            |(z 0 : ℝ)| ≤ X ∧ |(z 1 : ℝ)| ≤ X}
        S.Finite ∧ (S.ncard : ℝ) ≤
          C * X^(2/(b:ℝ)+ε) * (supNorm G : ℝ)^ε
