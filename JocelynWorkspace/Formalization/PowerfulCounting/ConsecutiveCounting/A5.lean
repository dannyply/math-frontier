  have hcovers (p:{p:Fin 4→ℤ // p∈T}) :
      ∃ s∈S,∃t:ℤ,r p.val=s.1+(s.2:ℤ)*t :=
    hSv (r p.val) ⟨p.val 2,(hvals p.val p.property).1⟩
      ⟨p.val 3,(hvals p.val p.property).2⟩
  choose sf hsf tf htf using hcovers
  let Tf : (ℤ×ℕ)→Finset {p:Fin 4→ℤ // p∈T} :=
