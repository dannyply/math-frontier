theorem actual_trace : ∀ (D : ℤ) (hD : ¬ IsSquare D),
  letI : Fact (¬ IsSquare D) := ⟨hD⟩;
  let K := QuadraticAlgebra ℚ (D : ℚ) 0;
  letI : NumberField K :=
    FormalAB.S9f3929ee.A1QuadraticField.quadraticNumberField D;
  let O := NumberField.RingOfIntegers K;
  ∀ α β : O, β ≠ 0 →
    Ideal.span ({α} : Set O) = Ideal.span ({β} : Set O) →
    (Algebra.norm ℚ) (α : K) = (Algebra.norm ℚ) (β : K) →
    ∃ t : ℤ, (α : K) / (β : K) + (β : K) / (α : K) = (t : K) := by
  intro D hD
  let : Fact (¬ IsSquare D) := ⟨hD⟩
  let K := QuadraticAlgebra ℚ (D : ℚ) 0
  let : NumberField K :=
    FormalAB.S9f3929ee.A1QuadraticField.quadraticNumberField D
  let O := NumberField.RingOfIntegers K
  change ∀ α β : O, β ≠ 0 →
    Ideal.span ({α} : Set O) = Ideal.span ({β} : Set O) →
    (Algebra.norm ℚ) (α : K) = (Algebra.norm ℚ) (β : K) →
    ∃ t : ℤ, (α : K) / (β : K) + (β : K) / (α : K) = (t : K)
  intro α β hβ hI hn
  have hβK : (β : K) ≠ 0 := by
    intro h
    exact hβ (Subtype.ext h)
  have hαmem : α ∈ Ideal.span ({β} : Set O) := by
    rw [←hI]
    exact Ideal.subset_span (Set.mem_singleton α)
  obtain ⟨q, hq⟩ := Ideal.mem_span_singleton.mp hαmem
  have hqK : (α : K) = (β : K) * (q : K) := by
    exact_mod_cast hq
  have hβNorm : (Algebra.norm ℚ) (β : K) ≠ 0 := by
    simpa using hβK
  have hnprod :
      (Algebra.norm ℚ) (β : K) * (Algebra.norm ℚ) (q : K) =
      (Algebra.norm ℚ) (β : K) := by
    simpa only [hqK, map_mul] using hn
  have hnq : (Algebra.norm ℚ) (q : K) = 1 := by
    apply mul_left_cancel₀ hβNorm
    simpa only [mul_one] using hnprod
  have hnq' : (q : K).re ^ 2 - (D : ℚ) * (q : K).im ^ 2 = 1 := by
    rw [← norm_formula D (q : K)]
    exact hnq
  have htrInt : IsIntegral ℤ ((Algebra.trace ℚ K) (q : K)) :=
    Algebra.isIntegral_trace q.property
  obtain ⟨t, ht⟩ :=
    (IsIntegral.exists_int_iff_exists_rat htrInt).mp ⟨_, rfl⟩
  let qc : K := ⟨(q : K).re, -(q : K).im⟩
  have hprod : (q : K) * qc = 1 := by
    apply QuadraticAlgebra.ext
    · change (q : K).re * (q : K).re + (D : ℚ) * (q : K).im * (-(q : K).im) = 1
      nlinarith [hnq']
    · change (q : K).re * (-(q : K).im) + (q : K).im * (q : K).re + (0 : ℚ) * (q : K).im * (-(q : K).im) = 0
      ring
  have hq0 : (q : K) ≠ 0 := by
    intro h
    simp [h] at hprod
  have hqc : qc = (q : K)⁻¹ := by
    apply mul_left_cancel₀ hq0
    rw [hprod, mul_inv_cancel₀ hq0]
  have hsum :
      (q : K) + qc = algebraMap ℚ K ((Algebra.trace ℚ K) (q : K)) := by
    rw [trace_formula D (q : K)]
    apply QuadraticAlgebra.ext
    · change (q : K).re + (q : K).re = 2 * (q : K).re
      ring
    · change (q : K).im + (-(q : K).im) = 0
      ring
  have hratio : (α : K) / (β : K) = (q : K) := by
    apply (div_eq_iff hβK).mpr
    simpa only [mul_comm] using hqK
  have hrev : (β : K) / (α : K) = (q : K)⁻¹ := by
    rw [← inv_div, hratio]
  refine ⟨t, ?_⟩
  rw [hratio, hrev, ← hqc, hsum, ht]
  simp
end A5ActualQuadraticTrace
