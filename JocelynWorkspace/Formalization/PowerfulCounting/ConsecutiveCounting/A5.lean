          |((MvPolynomial.coeff ν Q : ℤ) : ℝ)| ≤ H) →
        let X₀ : MvPolynomial (Fin 2) ℤ := MvPolynomial.X (0 : Fin 2);
        let X₁ : MvPolynomial (Fin 2) ℤ := MvPolynomial.X (1 : Fin 2);
