namespace A5RealTracePacking
private def idx (x : ℝ) : ℤ := ⌊Real.log x / Real.log 2⌋
private lemma ratio_lt_two (x y : ℝ) (hx : 0 < x) (hy : 0 < y)
    (hbin : idx x = idx y) : x / y < 2 := by
  have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hxu : Real.log x / Real.log 2 < (idx x : ℝ) + 1 :=
    Int.lt_floor_add_one _
  rw [hbin] at hxu
  have hyl : (idx y : ℝ) ≤ Real.log y / Real.log 2 := Int.floor_le _
  have hu := (div_lt_iff₀ hlog2).mp hxu
  have hl := (le_div_iff₀ hlog2).mp hyl
  by_contra hn
  have h : (2 : ℝ) ≤ x / y := le_of_not_gt hn
  have hh := Real.log_le_log (by norm_num : (0 : ℝ) < 2) h
  rw [Real.log_div hx.ne' hy.ne'] at hh
  nlinarith
private lemma trace_close (x y : ℝ) (hpos : 0 < x / y)
    (hxy : x / y < 2) (hyx : y / x < 2)
    (htr : ∃ z : ℤ, x / y + y / x = (z : ℝ)) : x = y := by
  have hx : x ≠ 0 := by
    intro hx
    simp [hx] at hpos
  have hy : y ≠ 0 := by
    intro hy
    simp [hy] at hpos
  have hp : (x / y) * (y / x) = 1 := by field_simp
  obtain ⟨z, hz⟩ := htr
  have hlo : (2 : ℝ) ≤ x / y + y / x := by
    by_contra hn
    have hm : (x / y) * (x / y + y / x - 2) < 0 :=
      mul_neg_of_pos_of_neg hpos (by linarith)
    nlinarith [sq_nonneg (x / y - 1)]
  have hhi : (z : ℝ) < 3 := by
    have hh : 0 < (2 - x / y) * (2 - y / x) :=
      mul_pos (by linarith) (by linarith)
    nlinarith
  have hzlo : (2 : ℤ) ≤ z := by exact_mod_cast (show (2 : ℝ) ≤ (z : ℝ) by linarith)
  have hzhi : z < 3 := by exact_mod_cast hhi
  have hz2 : z = 2 := by omega
  rw [hz2] at hz
  norm_num at hz
  have hs : (x-y)^2 = 0 := by
    field_simp [hx, hy] at hz
    nlinarith
  exact sub_eq_zero.mp (sq_eq_zero_iff.mp hs)
theorem packing : ∀ (B : ℝ) (T : Finset ℝ), 1 ≤ B →
  (∀ x ∈ T, 1 / B ≤ |x| ∧ |x| ≤ B) →
  (∀ x ∈ T, ∀ y ∈ T, ∃ z : ℤ, x / y + y / x = (z : ℝ)) →
  T.card ≤ 4 * ⌈Real.log B / Real.log 2⌉₊ + 2 := by
  classical
  intro B T hB hbound htrace
  have hB0 : 0 < B := by linarith
  have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  let N : ℕ := ⌈Real.log B / Real.log 2⌉₊
  have hN : Real.log B / Real.log 2 ≤ (N : ℝ) := Nat.le_ceil _
  have hNmul : Real.log B ≤ (N : ℝ) * Real.log 2 :=
    (div_le_iff₀ hlog2).mp hN
  have hnonzero : ∀ x ∈ T, x ≠ 0 := by
    intro x hx
    have hpos : 0 < |x| := lt_of_lt_of_le (one_div_pos.mpr hB0) (hbound x hx).1
    exact abs_pos.mp hpos
  have hidx : ∀ x ∈ T, -(N : ℤ) ≤ idx |x| ∧ idx |x| ≤ (N : ℤ) := by
    intro x hx
    have hx0 : 0 < |x| := abs_pos.mpr (hnonzero x hx)
    have hll := Real.log_le_log (one_div_pos.mpr hB0) (hbound x hx).1
    rw [one_div, Real.log_inv] at hll
    have hlu := Real.log_le_log hx0 (hbound x hx).2
    have hlow : -(N : ℝ) ≤ Real.log |x| / Real.log 2 := by
      apply (le_div_iff₀ hlog2).mpr
      nlinarith
    have hhigh : Real.log |x| / Real.log 2 ≤ (N : ℝ) :=
      (div_le_iff₀ hlog2).mpr (hlu.trans hNmul)
    have hfloorl : Real.log |x| / Real.log 2 < (idx |x| : ℝ) + 1 :=
      Int.lt_floor_add_one _
    have hflooru : (idx |x| : ℝ) ≤ Real.log |x| / Real.log 2 := Int.floor_le _
    have hlcast : ((-(N : ℤ) : ℤ) : ℝ) < ((idx |x| + 1 : ℤ) : ℝ) := by
      push_cast
      linarith
    have hlint : -(N : ℤ) < idx |x| + 1 := by exact_mod_cast hlcast
    have huint : idx |x| ≤ (N : ℤ) := by
      have : (idx |x| : ℝ) ≤ (N : ℝ) := hflooru.trans hhigh
      exact_mod_cast this
    exact ⟨by omega, huint⟩
  let label : ℝ → ℤ × Bool := fun x => (idx |x|, decide (x < 0))
  let Box : Finset (ℤ × Bool) :=
    Finset.Icc (-(N : ℤ)) (N : ℤ) ×ˢ (Finset.univ : Finset Bool)
  have hmap : ∀ x ∈ T, label x ∈ Box := by
    intro x hx
    exact Finset.mem_product.mpr ⟨Finset.mem_Icc.mpr (hidx x hx), Finset.mem_univ _⟩
  have hinj : Set.InjOn label (↑T : Set ℝ) := by
    intro x hx y hy heq
    have hi : idx |x| = idx |y| := congrArg Prod.fst heq
    have hs : decide (x < 0) = decide (y < 0) := congrArg Prod.snd heq
    have hxne := hnonzero x hx
    have hyne := hnonzero y hy
    have habsxy := ratio_lt_two |x| |y| (abs_pos.mpr hxne) (abs_pos.mpr hyne) hi
    have habsyx := ratio_lt_two |y| |x| (abs_pos.mpr hyne) (abs_pos.mpr hxne) hi.symm
    have hpos : 0 < x / y := by
      by_cases hxn : x < 0
      · have hyn : y < 0 := by
          by_contra hyn
          simp [hxn, hyn] at hs
        exact div_pos_of_neg_of_neg hxn hyn
      · have hyn : ¬ y < 0 := by
          intro hyn
          simp [hxn, hyn] at hs
        exact div_pos (lt_of_le_of_ne (le_of_not_gt hxn) hxne.symm)
          (lt_of_le_of_ne (le_of_not_gt hyn) hyne.symm)
    have hxy : x / y < 2 := (le_abs_self _).trans_lt (by simpa only [abs_div] using habsxy)
    have hyx : y / x < 2 := (le_abs_self _).trans_lt (by simpa only [abs_div] using habsyx)
    exact trace_close x y hpos hxy hyx (htrace x hx y hy)
  have hcard : T.card ≤ Box.card := Finset.card_le_card_of_injOn label hmap hinj
  have hIcard : (Finset.Icc (-(N : ℤ)) (N : ℤ)).card = 2 * N + 1 := by
    rw [Int.card_Icc]
    have ht : (N : ℤ) + 1 - -(N : ℤ) = ((2 * N + 1 : ℕ) : ℤ) := by push_cast; ring
    rw [ht, Int.toNat_natCast]
  calc
    T.card ≤ Box.card := hcard
    _ = (2 * N + 1) * 2 := by
      rw [Finset.card_product, hIcard, Finset.card_univ, Fintype.card_bool]
    _ = 4 * N + 2 := by omega
end A5RealTracePacking
theorem JocelynClaims.claim_6d4b021092e203e97d400586e4650cf5f8b6a14ef667fa72d17f98e976fc522f : ∀ (B : ℝ) (T : Finset ℝ), 1 ≤ B →
  (∀ x ∈ T, 1 / B ≤ |x| ∧ |x| ≤ B) →
  (∀ x ∈ T, ∀ y ∈ T, ∃ z : ℤ, x / y + y / x = (z : ℝ)) →
  T.card ≤ 4 * ⌈Real.log B / Real.log 2⌉₊ + 2 :=
  A5RealTracePacking.packing
