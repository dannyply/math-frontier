namespace A5QuarticConjugateOriginalGraphFreeze
abbrev OriginalQuad := (ℕ × ℕ) × (ℕ × ℕ)
def IsBidegree21 (G : MvPolynomial (Fin 4) ℤ) : Prop :=
  ∀ j ∈ G.support, j 0 + j 1 = 2 ∧ j 2 + j 3 = 1
def IsGeometricallyIrreducible (G : MvPolynomial (Fin 4) ℤ) : Prop :=
  Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G)
def GraphHeight (G : MvPolynomial (Fin 4) ℤ) (x : ℝ) (K : ℕ) : Prop :=
  ∀ j ∈ G.support,
    |((MvPolynomial.coeff j G : ℤ) : ℝ)| ≤ x ^ K
def CForm (G : MvPolynomial (Fin 4) ℤ) (d e : ℤ) : ℤ :=
  MvPolynomial.eval ![d, e, 1, 0] G
def EForm (G : MvPolynomial (Fin 4) ℤ) (d e : ℤ) : ℤ :=
  - MvPolynomial.eval ![d, e, 0, 1] G
def EliminationQuartic (G : MvPolynomial (Fin 4) ℤ) (d e : ℤ) : ℤ :=
  e ^ 2 * CForm G d e - d ^ 2 * EForm G d e
def QuadraticValue (A B C₀ d e : ℤ) : ℤ :=
  A * d ^ 2 + B * d * e + C₀ * e ^ 2
def OriginalPositivePopulation
    (G : MvPolynomial (Fin 4) ℤ) (h : ℤ) (x : ℝ) :
    Set OriginalQuad :=
  {q |
    0 < q.1.1 ∧ 0 < q.1.2 ∧ 0 < q.2.1 ∧ 0 < q.2.2 ∧
    (q.1.2 : ℤ) ^ 2 * (q.2.2 : ℤ) -
      (q.1.1 : ℤ) ^ 2 * (q.2.1 : ℤ) = h ∧
    (q.1.1 : ℝ) ^ 2 * (q.2.1 : ℝ) ≤ x ∧
    MvPolynomial.eval
      ![(q.1.1 : ℤ), (q.1.2 : ℤ),
        (q.2.1 : ℤ), (q.2.2 : ℤ)] G = 0}
def OriginalQuarticConjugateGraphCountStatement : Prop :=
  ∀ K : ℕ, ∀ ε : ℝ, 0 < ε →
    ∃ Cbound : ℝ, 0 < Cbound ∧
      ∀ x : ℝ, 2 ≤ x →
        ∀ G : MvPolynomial (Fin 4) ℤ,
          IsBidegree21 G →
          IsGeometricallyIrreducible G →
          GraphHeight G x K →
          ∀ h : ℤ, (h = 1 ∨ h = -1) →
            ∀ cR A B C₀ : ℤ,
              cR ≠ 0 →
              ¬ IsSquare (B ^ 2 - 4 * A * C₀) →
              (∀ d e : ℤ,
                EliminationQuartic G d e =
                  cR * (QuadraticValue A B C₀ d e) ^ 2) →
              let S := OriginalPositivePopulation G h x
              S.Finite ∧ (S.ncard : ℝ) ≤ Cbound * x ^ ε
def GraphToNormFiniteCoverStatement : Prop :=
  ∀ K : ℕ,
    ∃ K' : ℕ,
      ∀ x : ℝ, 2 ≤ x →
        ∀ G : MvPolynomial (Fin 4) ℤ,
          IsBidegree21 G →
          IsGeometricallyIrreducible G →
          GraphHeight G x K →
          ∀ h : ℤ, (h = 1 ∨ h = -1) →
            ∀ cR A B C₀ : ℤ,
              cR ≠ 0 →
              ¬ IsSquare (B ^ 2 - 4 * A * C₀) →
              (∀ d e : ℤ,
                EliminationQuartic G d e =
                  cR * (QuadraticValue A B C₀ d e) ^ 2) →
              let S := OriginalPositivePopulation G h x
              |(A : ℝ)| ≤ x ^ K' ∧
              |(B : ℝ)| ≤ x ^ K' ∧
              |(C₀ : ℝ)| ≤ x ^ K' ∧
              ∃ N : ℕ, 0 < N ∧ (N : ℝ) ≤ x ^ K' ∧
                (∀ q ∈ S,
                  Int.gcd (q.1.1 : ℤ) (q.1.2 : ℤ) = 1 ∧
                  QuadraticValue A B C₀ (q.1.1 : ℤ) (q.1.2 : ℤ) ≠ 0 ∧
                  (QuadraticValue A B C₀ (q.1.1 : ℤ)
                    (q.1.2 : ℤ)).natAbs ∣ N ∧
                  |((q.1.1 : ℕ) : ℝ)| ≤ x ^ K' ∧
                  |((q.1.2 : ℕ) : ℝ)| ≤ x ^ K') ∧
                (∀ q₁ ∈ S, ∀ q₂ ∈ S,
                  q₁.1 = q₂.1 → q₁ = q₂)
