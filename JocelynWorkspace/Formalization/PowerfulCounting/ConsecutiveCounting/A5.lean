    (Classical.decPred _) (Finset.range (3*M+1))
def originalShell (x D E : ℝ) (h : ℤ) : Set ((ℕ × ℕ) × (ℕ × ℕ)) :=
  {z | 1 ≤ z.1.1 ∧ 1 ≤ z.1.2 ∧ 1 ≤ z.2.1 ∧ 1 ≤ z.2.2 ∧
    ((z.1.2^2*z.2.2 : ℕ) : ℤ) =
      ((z.1.1^2*z.2.1 : ℕ) : ℤ)+h ∧
    x/2 < ((z.1.1^2*z.2.1 : ℕ) : ℝ) ∧
    ((z.1.1^2*z.2.1 : ℕ) : ℝ) ≤ x ∧
    D/2 < (z.1.1 : ℝ) ∧ (z.1.1 : ℝ) ≤ D ∧
    E/2 < (z.1.2 : ℝ) ∧ (z.1.2 : ℝ) ≤ E}
def originalCell (x D E : ℝ) (M j : ℕ) (h : ℤ) : Set ((ℕ × ℕ) × (ℕ × ℕ)) :=
  {z | z ∈ originalShell x D E h ∧
    rho D E M j < (z.1.1 : ℝ)/(z.1.2 : ℝ) ∧
    (z.1.1 : ℝ)/(z.1.2 : ℝ) ≤
      rho D E M j*(1+1/(M : ℝ))}
def col (P : Matrix (Fin 2) (Fin 2) ℤ) (i : Fin 2) : ℤ × ℤ := (P 0 i,P 1 i)
def nsq (a r c : ℝ) (b : ℤ × ℤ) : ℝ :=
  (a*((b.1 : ℝ)-r*(b.2 : ℝ)))^2+((b.2 : ℝ)/c)^2
def ip (a r c : ℝ) (b b' : ℤ × ℤ) : ℝ :=
  (a*((b.1 : ℝ)-r*(b.2 : ℝ)))*
    (a*((b'.1 : ℝ)-r*(b'.2 : ℝ)))+
    ((b.2 : ℝ)/c)*((b'.2 : ℝ)/c)
def reduced (a r c : ℝ) (P : Matrix (Fin 2) (Fin 2) ℤ) : Prop :=
  nsq a r c (col P 0) ≤ nsq a r c (col P 1) ∧
  |ip a r c (col P 0) (col P 1)| ≤ nsq a r c (col P 0)/2
def sideLength (a r c : ℝ) (P : Matrix (Fin 2) (Fin 2) ℤ) (i : Fin 2) : ℝ :=
  2/Real.sqrt (nsq a r c (col P i))
def originalPositiveBox (A B : Matrix (Fin 2) (Fin 2) ℤ) (L1 L2 T1 T2 : ℝ)
    (h : ℤ) (z : (ℕ × ℕ) × (ℕ × ℕ)) : Prop :=
  1 ≤ z.1.1 ∧ 1 ≤ z.1.2 ∧ 1 ≤ z.2.1 ∧ 1 ≤ z.2.2 ∧
    ((z.1.2^2*z.2.2 : ℕ) : ℤ) =
      ((z.1.1^2*z.2.1 : ℕ) : ℤ)+h ∧
    |((A.mulVec ![(z.1.1 : ℤ),(z.1.2 : ℤ)]) 0 : ℝ)| ≤ L1 ∧
    |((A.mulVec ![(z.1.1 : ℤ),(z.1.2 : ℤ)]) 1 : ℝ)| ≤ L2 ∧
    |((B.mulVec ![(z.2.2 : ℤ),(z.2.1 : ℤ)]) 0 : ℝ)| ≤ T1 ∧
    |((B.mulVec ![(z.2.2 : ℤ),(z.2.1 : ℤ)]) 1 : ℝ)| ≤ T2
def GeometryAt (x D E : ℝ) (M j : ℕ) (Kg : ℝ)
    (P Q A B : Matrix (Fin 2) (Fin 2) ℤ) : Prop :=
  let U : ℝ := 4*x/D^2;
  let V : ℝ := 8*x/E^2;
  (P.det=1 ∨ P.det= -1) ∧
  (Q.det=1 ∨ Q.det= -1) ∧
  (A.det=1 ∨ A.det= -1) ∧
  (B.det=1 ∨ B.det= -1) ∧
  A*P=1 ∧ P*A=1 ∧ B*Q=1 ∧ Q*B=1 ∧
  col P 0 ≠ 0 ∧ col Q 0 ≠ 0 ∧
  reduced ((M : ℝ)/(4*D)) (rho D E M j) (2*E) P ∧
  reduced ((M : ℝ)/(32*V)) ((rho D E M j)^2) (2*U) Q ∧
  let L1 := sideLength ((M : ℝ)/(4*D)) (rho D E M j) (2*E) P 0;
  let L2 := sideLength ((M : ℝ)/(4*D)) (rho D E M j) (2*E) P 1;
  let T1 := sideLength ((M : ℝ)/(32*V)) ((rho D E M j)^2) (2*U) Q 0;
  let T2 := sideLength ((M : ℝ)/(32*V)) ((rho D E M j)^2) (2*U) Q 1;
  0 < L2 ∧ L2 ≤ L1 ∧ 0 < T2 ∧ T2 ≤ T1 ∧
    16*D*E/(M : ℝ) ≤ L1*L2 ∧
    L1*L2 ≤ 32*D*E/(M : ℝ) ∧
    128*U*V/(M : ℝ) ≤ T1*T2 ∧
    T1*T2 ≤ 256*U*V/(M : ℝ) ∧
    (∀ h : ℤ, (h=1 ∨ h= -1) →
      ∀ z ∈ originalCell x D E M j h,
        nsq ((M : ℝ)/(4*D)) (rho D E M j) (2*E)
          ((z.1.1 : ℤ),(z.1.2 : ℤ)) ≤ 1 ∧
        nsq ((M : ℝ)/(32*V)) ((rho D E M j)^2) (2*U)
          ((z.2.2 : ℤ),(z.2.1 : ℤ)) ≤ 1 ∧
        originalPositiveBox A B L1 L2 T1 T2 h z) ∧
    ((∃ h : ℤ, (h=1 ∨ h= -1) ∧
        (originalCell x D E M j h).Nonempty) →
      ∀ i k : Fin 2,
        |((P i k : ℤ) : ℝ)| ≤ x^Kg ∧
        |((Q i k : ℤ) : ℝ)| ≤ x^Kg ∧
        |((A i k : ℤ) : ℝ)| ≤ x^Kg ∧
        |((B i k : ℤ) : ℝ)| ≤ x^Kg)
def factorCase (G : MvPolynomial (Fin 4) ℤ) (a b : ℕ) : Prop :=
  (b=0 ∧ 2 ≤ a ∧
    ∀ w : Fin 4 → ℤ, MvPolynomial.eval w G=0 →
      w 0=0 ∧ w 1=0) ∨
  (a=0 ∧ 2 ≤ b ∧
    ∀ w : Fin 4 → ℤ, MvPolynomial.eval w G=0 →
      w 2=0 ∧ w 3=0) ∨
  ((a,b)=(1,0) ∧ ∃ p r : ℤ, (p,r) ≠ (0,0) ∧
    G=MvPolynomial.C p*MvPolynomial.X 0+
      MvPolynomial.C r*MvPolynomial.X 1) ∨
  ((a,b)=(0,1) ∧ ∃ p r : ℤ, (p,r) ≠ (0,0) ∧
    G=MvPolynomial.C p*MvPolynomial.X 2+
      MvPolynomial.C r*MvPolynomial.X 3) ∨
  (1 ≤ a ∧ 1 ≤ b ∧ min a b=1 ∧
    Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G)) ∨
  (2 ≤ a ∧ 2 ≤ b ∧
    Irreducible (MvPolynomial.map (Int.castRingHom ℚ) G))
def CoverAt (x D E : ℝ) (M j q b : ℕ) (K : ℝ) (h : ℤ)
    (F : MvPolynomial (Fin 4) ℤ) (k : ℕ) (Gs : Fin k → MvPolynomial (Fin 4) ℤ)
    (dg : Fin k → ℕ × ℕ) : Prop :=
  F ≠ 0 ∧
  (∀ m ∈ F.support, m 0+m 1=q ∧ m 2+m 3=b) ∧
  F.totalDegree ≤ q+b ∧
  (∀ m : Fin 4 →₀ ℕ, |((F.coeff m : ℤ) : ℝ)| ≤ x^K) ∧
  k ≤ 2*q ∧
  (∀ i, Gs i ∣ F) ∧
  (∀ i, Irreducible (Gs i)) ∧
  (∀ i, ∀ m ∈ (Gs i).support,
    m 0+m 1=(dg i).1 ∧ m 2+m 3=(dg i).2) ∧
  (∀ i, (dg i).1 ≤ q ∧ (dg i).2 ≤ b) ∧
  (∀ z ∈ originalCell x D E M j h,
    ∃ i : Fin k,
      MvPolynomial.eval
        ![(z.1.1 : ℤ),(z.1.2 : ℤ),(z.2.1 : ℤ),(z.2.2 : ℤ)] (Gs i)=0) ∧
  (∀ i, ∀ m : Fin 4 →₀ ℕ,
    |(((Gs i).coeff m : ℤ) : ℝ)| ≤ x^(K+1)) ∧
  (∀ i, factorCase (Gs i) (dg i).1 (dg i).2)
def HCon : Prop :=
  ∃ K Kg X0 : ℝ, 0 < K ∧ 0 < Kg ∧ 4 ≤ X0 ∧
    ∀ x : ℝ, X0 ≤ x →
    ∀ s : ℝ, (5/8 : ℝ) ≤ s → s ≤ 1 →
    ∀ D E : ℝ, 0 < D → 0 < E → D*E=x^s →
    let M : ℕ := ⌈x^(rightMu s)⌉₊;
    ∀ h : ℤ, (h=1 ∨ h= -1) →
    ∃ P Q A B : ℕ → Matrix (Fin 2) (Fin 2) ℤ,
    ∃ F : ℕ → MvPolynomial (Fin 4) ℤ, ∃ k : ℕ → ℕ,
    ∃ Gs : (j : ℕ) → Fin (k j) → MvPolynomial (Fin 4) ℤ,
    ∃ dg : (j : ℕ) → Fin (k j) → ℕ × ℕ,
      ∀ j ∈ cells D E M,
        GeometryAt x D E M j Kg (P j) (Q j) (A j) (B j) ∧
        CoverAt x D E M j 500 (rightB s) K h
          (F j) (k j) (Gs j) (dg j)
theorem filter_decidable_irrel
    (p : ℕ → Prop) (dp dq : DecidablePred p) (S : Finset ℕ) :
    @Finset.filter ℕ p dp S = @Finset.filter ℕ p dq S := by
  have h : dp = dq := Subsingleton.elim _ _
  cases h
  rfl
theorem geom_cells_eq (D E : ℝ) (M : ℕ) :
    cells D E M =
      FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.cells D E M := by
  unfold cells FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.cells
    rho FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.rho
  exact filter_decidable_irrel _ _ _ _
theorem aux_cells_eq (D E : ℝ) (M : ℕ) :
    cells D E M =
      FormalAB.Sb751f117.A5CentralOriginalAuxiliary.cells D E M := by
  unfold cells FormalAB.Sb751f117.A5CentralOriginalAuxiliary.cells
    rho FormalAB.Sb751f117.A5CentralOriginalAuxiliary.rho
  exact filter_decidable_irrel _ _ _ _
theorem right_geometry :
    ∃ Kg Xg : ℝ, 0 < Kg ∧ 4 ≤ Xg ∧
      ∀ x : ℝ, Xg ≤ x →
      ∀ s : ℝ, (5/8 : ℝ) ≤ s → s ≤ 1 →
      ∀ D E : ℝ, 0 < D → 0 < E → D*E=x^s →
      ∃ P Q A B : ℕ → Matrix (Fin 2) (Fin 2) ℤ,
        ∀ j ∈ cells D E ⌈x^(rightMu s)⌉₊,
          GeometryAt x D E ⌈x^(rightMu s)⌉₊ j Kg
            (P j) (Q j) (A j) (B j) := by
  classical
  obtain ⟨Kg, Xg, hKg, hXg, hraw⟩ := A5RightConGeom.right_main
  refine ⟨Kg, Xg, hKg, hXg, ?_⟩
  intro x hx s hs hs' D E hD hE hDE
  obtain ⟨_, _, _, _, _, _, P, Q, A, B, hgeom⟩ := hraw x hx s hs hs' D E hD hE hDE
  refine ⟨P, Q, A, B, ?_⟩
  intro j hj
  have hj' : j ∈ FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.cells D E
      ⌈x^(rightMu s)⌉₊ := by
    rw [← geom_cells_eq]
    exact hj
  exact hgeom j hj'
theorem right_cover :
    ∃ K Xa : ℝ, 0 < K ∧ 4 ≤ Xa ∧
      ∀ x : ℝ, Xa ≤ x →
      ∀ s : ℝ, (5/8 : ℝ) ≤ s → s ≤ 1 →
      ∀ D E : ℝ, 0 < D → 0 < E → D*E=x^s →
      ∀ h : ℤ, (h=1 ∨ h= -1) →
      ∀ j ∈ cells D E ⌈x^(rightMu s)⌉₊,
        ∃ F : MvPolynomial (Fin 4) ℤ, ∃ k : ℕ,
        ∃ Gs : Fin k → MvPolynomial (Fin 4) ℤ,
        ∃ dg : Fin k → ℕ × ℕ,
          CoverAt x D E ⌈x^(rightMu s)⌉₊ j 500 (rightB s) K h
            F k Gs dg := by
  classical
  obtain ⟨Ka, Xa, hKa, hXa, haux⟩ := A5RightConAux.right_auxiliary
  obtain ⟨Cf, hCf, hfactor⟩ := A5RightConFactor.factor_cover 1000
  let X0 : ℝ := max Xa Cf
  have hX0 : (4 : ℝ) ≤ X0 := hXa.trans (le_max_left _ _)
  refine ⟨Ka, X0, hKa, hX0, ?_⟩
  intro x hx s hs hs' D E hD hE hDE h hh j hj
  have hxXa : Xa ≤ x := (le_max_left _ _).trans hx
  have hCx : Cf ≤ x := (le_max_right _ _).trans hx
  have hx0 : 0 < x := by linarith [hX0]
  have hx1 : 1 ≤ x := by linarith [hX0]
  have hB : rightB s ≤ 500 := by
    unfold rightB
    split_ifs <;> norm_num
  have hj' : j ∈ FormalAB.Sb751f117.A5CentralOriginalAuxiliary.cells D E
      ⌈x^(rightMu s)⌉₊ := by
    rw [← aux_cells_eq]
    exact hj
  obtain ⟨F, hF0, hFbi, hFdeg, hFht, hFzero⟩ :=
    haux x hxXa s hs hs' D E hD hE hDE j hj' h hh
  have hH : 1 ≤ x^Ka := Real.one_le_rpow hx1 hKa.le
  obtain ⟨k, Gs, dg, hk, hdvd, hirr, hbi, hdg, hzero, hGht, hcases⟩ :=
    hfactor (x^Ka) F 500 (rightB s) hH hF0 (by omega) hFbi hFht
  refine ⟨F, k, Gs, dg, hF0, hFbi, hFdeg, hFht, hk, hdvd, hirr, hbi, hdg, ?_, ?_, ?_⟩
  · intro z hz
    have hz' : z ∈ FormalAB.Sb751f117.A5CentralOriginalAuxiliary.originalCell x D E
        ⌈x^(rightMu s)⌉₊ j h := by
      obtain ⟨⟨h1,h2,h3,h4,h5,h6,h7,h8,h9,h10,h11⟩,h12,h13⟩ := hz
      exact ⟨h1,h2,h3,h4,h5,h6,h7,h8,h9,h10,h11,h12,h13⟩
    exact hzero _ (hFzero z hz')
  · intro i m
    calc
      |(((Gs i).coeff m : ℤ) : ℝ)| ≤ Cf*x^Ka := hGht i m
      _ ≤ x*x^Ka := mul_le_mul_of_nonneg_right hCx (Real.rpow_nonneg hx0.le _)
      _ = x^(Ka+1) := by rw [Real.rpow_add hx0,Real.rpow_one]; ring
  · intro i
    simpa only [factorCase] using hcases i
theorem actual_right_constructor : HCon := by
  classical
  obtain ⟨Kg, Xg, hKg, hXg, hgeometry⟩ := right_geometry
  obtain ⟨K, Xa, hK, hXa, hcover⟩ := right_cover
  let X0 : ℝ := max Xg Xa
  have hX0 : (4 : ℝ) ≤ X0 := hXg.trans (le_max_left _ _)
  refine ⟨K, Kg, X0, hK, hKg, hX0, ?_⟩
  intro x hx s hs hs' D E hD hE hDE
  dsimp only
  intro h hh
  have hgeom := hgeometry x ((le_max_left _ _).trans hx)
    s hs hs' D E hD hE hDE
  obtain ⟨P, Q, A, B, hgeomj⟩ := hgeom
  have hcov := hcover x ((le_max_right _ _).trans hx)
    s hs hs' D E hD hE hDE h hh
  let M : ℕ := ⌈x^(rightMu s)⌉₊
  have hwitness : ∀ j : ℕ, ∃ F : MvPolynomial (Fin 4) ℤ, ∃ k : ℕ,
      ∃ Gs : Fin k → MvPolynomial (Fin 4) ℤ, ∃ dg : Fin k → ℕ × ℕ,
      j ∈ cells D E M →
        CoverAt x D E M j 500 (rightB s) K h F k Gs dg := by
    intro j
    by_cases hj : j ∈ cells D E M
    · obtain ⟨F, k, Gs, dg, hjcov⟩ := hcov j hj
      exact ⟨F, k, Gs, dg, fun _ => hjcov⟩
    · exact ⟨0, 0, (fun i => Fin.elim0 i), (fun i => Fin.elim0 i),
        fun hj' => (hj hj').elim⟩
  choose F k Gs dg hfamily using hwitness
  refine ⟨P, Q, A, B, F, k, Gs, dg, ?_⟩
  intro j hj
  exact ⟨hgeomj j hj, hfamily j hj⟩
end A5RightCon
