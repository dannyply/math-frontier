  let n := nsq a r c z
  have hn0 : 0 ≤ n := nsq_nonneg a r c z
  have hnt : 1 ≤ n*t^2 := by
    by_cases hz2 : z.2=0
    · have hz1 : z.1 ≠ 0 := by
        intro hz1
        exact hP (Prod.ext hz1 hz2)
      have hsq := int_square_ge_one z.1 hz1
      have hn : n=a^2*(z.1 : ℝ)^2 := by
        dsimp only [n]
        simp [nsq,hz2,mul_pow]
      calc
        1 ≤ (a*t)^2 := by
          simpa only [one_pow] using
            pow_le_pow_left₀ (show (0 : ℝ) ≤ 1 by norm_num) hat 2
        _ ≤ (a*t)^2*(z.1 : ℝ)^2 := by
          simpa only [mul_one] using
            mul_le_mul_of_nonneg_left hsq (sq_nonneg (a*t))
        _ = n*t^2 := by rw [hn]; ring
    · have hsq := int_square_ge_one z.2 hz2
      have hn := FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.norm_times_sq
        a r c hc.ne' z
      have hnc : 1 ≤ n*c^2 := by
        change nsq a r c z*c^2 ≥ 1
        change nsq a r c z*c^2 =
          (c*a*((z.1 : ℝ)-r*(z.2 : ℝ)))^2+(z.2 : ℝ)^2 at hn
        nlinarith [sq_nonneg (c*a*((z.1 : ℝ)-r*(z.2 : ℝ)))]
      have hct2 : c^2 ≤ t^2 := pow_le_pow_left₀ hc.le hct 2
      exact hnc.trans (mul_le_mul_of_nonneg_left hct2 hn0)
  have hs0 : 0 ≤ Real.sqrt n := Real.sqrt_nonneg _
  have hs2 : (Real.sqrt n)^2=n := Real.sq_sqrt hn0
  have hprod2 : (Real.sqrt n*t)^2=n*t^2 := by rw [mul_pow,hs2]
