    have hh := congrArg (fun f : Polynomial ℚ => f.coeff 0) hz
    norm_num only [axisLinePoly, Polynomial.coeff_add, Polynomial.coeff_C_mul,
      Polynomial.coeff_X, Polynomial.coeff_C, Polynomial.coeff_zero] at hh
    simpa only [ite_true, ite_false, mul_one, mul_zero, add_zero, zero_add] using hh
