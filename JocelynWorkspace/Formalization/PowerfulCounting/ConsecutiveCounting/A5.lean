theorem fixed_level_count
    (C₀ c_M : ℝ) (hC:0<C₀) (hc:0<c_M) :
    ∃ C:ℝ, 1≤C ∧
    ∀ x D E M s₀:ℝ,
      2≤x → 0<D → 0<E → 0<M → c_M*x^((1:ℝ)/3)≤M →
    ∀ a b m q:ℤ, Int.gcd a b=1 → m≠0 → q≠0 →
    ∀ T:Finset (Fin 4→ℤ),
      (∀p∈T,
        (∀i,0<p i) ∧ 1≤(p 0)^2*p 2 ∧ (((p 0)^2*p 2:ℤ):ℝ)≤x ∧
        D/2<(p 0:ℝ) ∧ (p 0:ℝ)≤D ∧ E/2<(p 1:ℝ) ∧ (p 1:ℝ)≤E ∧
        |(p 0:ℝ)/(p 1:ℝ)-s₀|≤C₀*D/(E*M) ∧
        (p 1)^2*p 3=(p 0)^2*p 2+1 ∧ m=a*p 0+b*p 1 ∧
        m^3*p 2=q*(p 1)^2-a^2*(a*p 0+3*b*p 1) ∧
        m^3*p 3=q*(p 0)^2+b^2*(3*a*p 0+b*p 1)) →
      (T.card:ℝ)≤C*(6:ℝ)^m.natAbs.primeFactors.card*
        (1+Real.sqrt x/(Real.sqrt M*(D*E)^((1:ℝ)/3))) := by
  obtain ⟨C,hC1,hcount⟩ :=
    JocelynClaims.claim_e4cb379781fb59ee2c9e55019ae9e4176497fe6bc93e78b9291d887aa22f98dc
      (3*C₀) c_M (by positivity) hc
  refine ⟨C,hC1,?_⟩
  intro x D E M s₀ hx hD hE hM hfloor a b m q hprim hm hq T hT
  classical
  obtain ⟨d₀,e₀,hbez'⟩ := Int.isCoprime_iff_gcd_eq_one.mpr hprim
  have hbez : a*d₀+b*e₀=1 := by nlinarith only [hbez']
  let d : Polynomial ℚ := Polynomial.C ((m*d₀:ℤ):ℚ)+Polynomial.C (b:ℚ)*Polynomial.X
  let e : Polynomial ℚ := Polynomial.C ((m*e₀:ℤ):ℚ)-Polynomial.C (a:ℚ)*Polynomial.X
  let U : Polynomial ℚ :=
    (Polynomial.C (q:ℚ)*e^2-Polynomial.C ((a:ℚ)^2)*
      (Polynomial.C (a:ℚ)*d+Polynomial.C ((3*b:ℤ):ℚ)*e))*
        Polynomial.C (((m:ℚ)^3)⁻¹)
  let V : Polynomial ℚ :=
    (Polynomial.C (q:ℚ)*d^2+Polynomial.C ((b:ℚ)^2)*
      (Polynomial.C ((3*a:ℤ):ℚ)*d+Polynomial.C (b:ℚ)*e))*
        Polynomial.C (((m:ℚ)^3)⁻¹)
  obtain ⟨S,hSc,hSg,hSv⟩ :=
    JocelynClaims.claim_699d9d84ad6dd09c362a8e681016e58ade975eb23b64ad4227ad6858d5e066ab
      a b m d₀ e₀ q hprim hm hbez
  change S.card≤6^m.natAbs.primeFactors.card at hSc
  let r : (Fin 4→ℤ)→ℤ := fun p=>e₀*p 0-d₀*p 1
  have hcoords (p:Fin 4→ℤ) (hp:p∈T) :
      p 0=m*d₀+b*r p ∧ p 1=m*e₀-a*r p := by
    have hmlev := (hT p hp).2.2.2.2.2.2.2.2.2.1
    constructor
