      by_cases hl : leftCondition z <;> simp [hl] <;> linarith
    by_cases hl : leftCondition z
    · have hclean := clean_le_points b z
      simp only [if_neg he, if_pos hl]
      linarith
    have hX := (large_global_routing_domain x T z hx hz hlarge).1
    have hs := actual_route_split x z hx hz hX
    rcases hs with he' | hl' | hc | hr
    · exact False.elim (he he')
    · exact False.elim (hl hl')
    · simpa [he, hl] using hcenter b z hz hc.1 hc.2
    · simpa [he, hl] using hright b z hz hr.1 hr.2
  have hsum :
      (∑ b : Bool, ∑ z ∈ I,
        ((points b z \ (orient b '' globalS)).ncard : ℝ)) ≤
      ∑ b : Bool, ∑ z ∈ I,
        ((if endpointCollar z then ((points b z).ncard : ℝ) else 0) +
         (if leftCondition z then ((points b z).ncard : ℝ) else 0) +
         K*x^β) := by
    apply Finset.sum_le_sum
    intro b hb
    apply Finset.sum_le_sum
    intro z hz
    exact hterm b z hz
  calc
    _ ≤ ∑ b : Bool, ∑ z ∈ I,
        ((if endpointCollar z then ((points b z).ncard : ℝ) else 0) +
         (if leftCondition z then ((points b z).ncard : ℝ) else 0) +
         K*x^β) := hsum
    _ = (∑ b : Bool, ∑ z ∈ endpointIndices x,
          ((points b z).ncard : ℝ)) +
        (∑ b : Bool, ∑ z ∈ leftIndices x,
          ((points b z).ncard : ℝ)) +
        2 * (I.card : ℝ) * (K*x^β) := by
          simp [I, endpointIndices, leftIndices, Finset.sum_filter,
            Finset.sum_add_distrib, Finset.sum_const,
            Fintype.card_bool, nsmul_eq_mul]
          ring
private theorem actual_tail_bound_of_components
    (T K Ce Cl α δ : ℝ)
    (hK : 0 ≤ K) (hCe : 0 ≤ Ce) (hCl : 0 ≤ Cl)
    (hα : 0 ≤ α) (hδ : 0 < δ) :
    ∃ A : ℝ, 0 < A ∧
      ∀ x : ℝ, 2 ≤ x → max 1024 (64*T^2) < x →
        (∑ b : Bool, ∑ z ∈ endpointIndices x,
          ((points b z).ncard : ℝ)) ≤ Ce*x^(α+δ) →
        (∑ b : Bool, ∑ z ∈ leftIndices x,
          ((points b z).ncard : ℝ)) ≤ Cl*x^(α+δ) →
        (∀ b : Bool, ∀ z ∈ indices x (Real.sqrt x),
          (599/1000:ℝ) ≤ sUpper z → sUpper z ≤ 5/8 →
          ((points b z \ (orient b '' globalS)).ncard : ℝ) ≤ K*x^α) →
        (∀ b : Bool, ∀ z ∈ indices x (Real.sqrt x),
          (5/8:ℝ) ≤ sUpper z → sUpper z ≤ 1 →
          ((points b z \ (orient b '' globalS)).ncard : ℝ) ≤ K*x^α) →
        ((FormalAB.S9ad0e971.ConsecutiveCountingA5Source.largeDivisorTail
          x (Real.sqrt x)).ncard : ℝ) ≤
        ((FormalAB.S9ad0e971.ConsecutiveCountingA5Source.largeDivisorTail
          x (Real.sqrt x) ∩ globalS).ncard : ℝ) +
          (Ce+Cl+2*A*K)*x^(α+δ) := by
  obtain ⟨A,hA,hcap⟩ := cap_power δ hδ
  refine ⟨A,hA,?_⟩
  intro x hx hlarge hend hleft hcenter hright
  have hx0 : 0 < x := by linarith
  have hsum := actual_partition_sum x T K α hx hlarge hK hα hcenter hright
  have hidx : ((indices x (Real.sqrt x)).card : ℝ) ≤
      ((cap x : ℝ)^5) := by
    exact_mod_cast index_card x (Real.sqrt x)
  have hcap' := hcap x hx
  have hpowα : 0 ≤ x^α := by positivity
  have hpowδ : 0 ≤ x^δ := by positivity
  have hlocal :
      2*((indices x (Real.sqrt x)).card : ℝ)*(K*x^α) ≤
        2*A*K*x^(α+δ) := by
    have hfirst :
        2*((indices x (Real.sqrt x)).card : ℝ)*(K*x^α) ≤
          2*(A*x^δ)*(K*x^α) := by
      nlinarith [mul_nonneg (sub_nonneg.mpr (hidx.trans hcap'))
        (mul_nonneg hK hpowα)]
    calc
      _ ≤ 2*(A*x^δ)*(K*x^α) := hfirst
      _ = 2*A*K*(x^δ*x^α) := by ring
      _ = 2*A*K*x^(α+δ) := by
        rw [← Real.rpow_add hx0]
        ring
  have htail := actual_global_cover_real x hx
  have hsum' :
      (∑ b : Bool, ∑ z ∈ indices x (Real.sqrt x),
        ((points b z \ (orient b '' globalS)).ncard : ℝ)) ≤
          (Ce+Cl+2*A*K)*x^(α+δ) := by
    have hh := add_le_add (add_le_add hend hleft) hlocal
    have htarget :
      Ce*x^(α+δ)+Cl*x^(α+δ)+2*A*K*x^(α+δ) =
        (Ce+Cl+2*A*K)*x^(α+δ) := by ring
    linarith
  linarith
private theorem local_shell_to_global_cell
    (x C δ : ℝ) (b : Bool) (z : Index)
    (hx : 2 ≤ x) (hz : z ∈ indices x (Real.sqrt x))
    (hX : 2 ≤ X z) (hC : 0 ≤ C) (hδ : 0 ≤ δ)
    (hfin : (A5UpperPoint.shell (2 * X z + 1)
      (if b then 2 * E z else 2 * D z)
      (if b then 2 * D z else 2 * E z) \ globalS).Finite)
    (hbound :
      ((A5UpperPoint.shell (2 * X z + 1)
        (if b then 2 * E z else 2 * D z)
        (if b then 2 * D z else 2 * E z) \ globalS).ncard : ℝ) ≤
        C * (2 * X z + 1) ^
          ((4 * Real.sqrt 46 - 22) / 9 + δ)) :
    ((points b z \ (orient b '' globalS)).ncard : ℝ) ≤
      (C * (3:ℝ)^((4 * Real.sqrt 46 - 22)/9+δ)) *
        x^((4 * Real.sqrt 46 - 22)/9+δ) := by
  have hbridge := clean_to_positive_shell_count b z hX hfin
  have hbridgeR :
      ((points b z \ (orient b '' globalS)).ncard : ℝ) ≤
      ((A5UpperPoint.shell (2 * X z + 1)
        (if b then 2 * E z else 2 * D z)
        (if b then 2 * D z else 2 * E z) \ globalS).ncard : ℝ) := by
    exact_mod_cast hbridge
  have hβ : 0 ≤ (4 * Real.sqrt 46 - 22)/9+δ := by
    linarith [theta_gt_endpoint]
  have hp := upper_Y_power_le_global x
    ((4 * Real.sqrt 46 - 22)/9+δ) z hx hz hβ
  calc
    _ ≤ C * (2 * X z + 1) ^
      ((4 * Real.sqrt 46 - 22)/9+δ) := hbridgeR.trans hbound
    _ ≤ C * ((3:ℝ)^((4 * Real.sqrt 46 - 22)/9+δ) *
      x^((4 * Real.sqrt 46 - 22)/9+δ)) :=
        mul_le_mul_of_nonneg_left hp hC
    _ = (C * (3:ℝ)^((4 * Real.sqrt 46 - 22)/9+δ)) *
      x^((4 * Real.sqrt 46 - 22)/9+δ) := by ring
private def theta : ℝ := (4 * Real.sqrt 46 - 22) / 9
private def ComponentEstimate (lo hi : ℝ) : Prop :=
  ∀ δ : ℝ, 0 < δ →
    ∃ C T : ℝ, 1 ≤ C ∧ 4 ≤ T ∧
      ∀ y : ℝ, T ≤ y →
        ∀ s : ℝ, lo ≤ s → s ≤ hi →
          ∀ d e : ℝ, 0 < d → 0 < e → d*e = y^s →
            (A5UpperPoint.shell y d e \ globalS).Finite ∧
            ((A5UpperPoint.shell y d e \ globalS).ncard : ℝ) ≤
              C*y^(theta+δ)
private theorem component_to_global_cells
    (lo hi δ : ℝ) (hδ : 0 < δ)
    (hcomp : ComponentEstimate lo hi) :
    ∃ K T : ℝ, 0 ≤ K ∧ 4 ≤ T ∧
      ∀ x : ℝ, 2 ≤ x →
        ∀ z ∈ indices x (Real.sqrt x),
          2 ≤ X z → T ≤ 2*X z+1 →
          ∀ b : Bool, lo ≤ sUpper z → sUpper z ≤ hi →
            ((points b z \ (orient b '' globalS)).ncard : ℝ) ≤
              K*x^(theta+δ) := by
  obtain ⟨C,T,hC,hT,hbox⟩ := hcomp δ hδ
  let K : ℝ := C*(3:ℝ)^(theta+δ)
  have hK : 0 ≤ K := by dsimp [K]; positivity
  refine ⟨K,T,hK,hT,?_⟩
  intro x hx z hz hX hY b hlo hhi
  let d : ℝ := if b then 2*E z else 2*D z
  let e : ℝ := if b then 2*D z else 2*E z
  have hd : 0 < d := by
    dsimp [d]
    cases b <;> simp [D,E,scale] <;> positivity
  have he : 0 < e := by
    dsimp [e]
    cases b <;> simp [D,E,scale] <;> positivity
  have hprod : d*e = (2*X z+1)^(sUpper z) := by
    exact upper_parameters_power b z hX
  obtain ⟨hfin,hbound⟩ := hbox (2*X z+1) hY
    (sUpper z) hlo hhi d e hd he hprod
  have hδ0 : 0 ≤ δ := le_of_lt hδ
  exact local_shell_to_global_cell x C δ b z hx hz hX
    (by linarith) hδ0 hfin hbound
private def EndpointEstimate : Prop :=
  ∀ δ : ℝ, 0 < δ →
    ∃ Ce : ℝ, 0 < Ce ∧ ∀ x : ℝ, 2 ≤ x →
      (∑ b : Bool, ∑ z ∈ endpointIndices x,
        ((points b z).ncard : ℝ)) ≤ Ce*x^((11/20:ℝ)+δ)
private def LeftEstimate : Prop :=
  ∀ δ : ℝ, 0 < δ →
    ∃ Cl : ℝ, 1 ≤ Cl ∧ ∀ x : ℝ, 2 ≤ x →
      (∑ b : Bool, ∑ z ∈ leftIndices x,
        ((points b z).ncard : ℝ)) ≤ Cl*x^(theta+δ)
private theorem actual_tail_estimate
    (hEnd : EndpointEstimate) (hLeft : LeftEstimate)
    (hCentral : ComponentEstimate (599/1000) (5/8))
    (hRight : ComponentEstimate (5/8) 1) :
    ∀ ε : ℝ, 0 < ε →
      ∃ C B : ℝ, 0 ≤ C ∧ 2 ≤ B ∧
        ∀ x : ℝ, B ≤ x →
          ((FormalAB.S9ad0e971.ConsecutiveCountingA5Source.largeDivisorTail
            x (Real.sqrt x)).ncard : ℝ) ≤ C*x^(theta+ε) := by
  intro ε hε
  let δ : ℝ := ε/4
  have hδ : 0 < δ := by dsimp [δ]; linarith
  obtain ⟨Ce,hCe,hEndBound⟩ := hEnd δ hδ
  obtain ⟨Cl,hCl,hLeftBound⟩ := hLeft δ hδ
  obtain ⟨Kc,Tc,hKc,hTc,hCenterBound⟩ :=
    component_to_global_cells (599/1000) (5/8) δ hδ hCentral
  obtain ⟨Kr,Tr,hKr,hTr,hRightBound⟩ :=
    component_to_global_cells (5/8) 1 δ hδ hRight
  obtain ⟨C3,C5,hC3,hC5,hExc⟩ :=
    FormalAB.S9511d4c3.ConsecutiveCountingA5Exception.globalExceptionCount δ hδ
  let T : ℝ := max Tc Tr
  let K : ℝ := max Kc Kr
  have hK : 0 ≤ K := hKc.trans (le_max_left _ _)
  have hβ : 0 ≤ theta+δ := by
    dsimp [theta]
    linarith [theta_gt_endpoint]
  obtain ⟨A,hA,hTailOf⟩ :=
    actual_tail_bound_of_components T K Ce Cl (theta+δ) δ
      hK hCe.le (by nlinarith : 0 ≤ Cl) hβ hδ
  let B : ℝ := max 2 (max 1024 (64*T^2)+1)
  let C : ℝ := C3+C5+Ce+Cl+2*A*K
  have hB : 2 ≤ B := le_max_left _ _
  have hC : 0 ≤ C := by dsimp [C]; positivity
  refine ⟨C,B,hC,hB,?_⟩
  intro x hxB
  have hx : 2 ≤ x := hB.trans hxB
  have hx1 : 1 ≤ x := (by norm_num : (1:ℝ) ≤ 2).trans hx
  have hx0 : 0 < x := lt_of_lt_of_le (by norm_num : (0:ℝ) < 2) hx
  have hlarge : max 1024 (64*T^2) < x := by
    calc
      max 1024 (64*T^2) < max 1024 (64*T^2)+1 :=
        lt_add_of_pos_right _ (by norm_num : (0:ℝ) < 1)
      _ ≤ B := le_max_right _ _
      _ ≤ x := hxB
  have hend :
      (∑ b : Bool, ∑ z ∈ endpointIndices x,
        ((points b z).ncard : ℝ)) ≤
          Ce*x^((theta+δ)+δ) := by
    have hpow :
        x^((11/20:ℝ)+δ) ≤ x^((theta+δ)+δ) :=
      Real.rpow_le_rpow_of_exponent_le hx1
        (by dsimp [theta]; nlinarith [theta_gt_endpoint])
    exact (hEndBound x hx).trans (mul_le_mul_of_nonneg_left hpow hCe.le)
  have hleft :
      (∑ b : Bool, ∑ z ∈ leftIndices x,
        ((points b z).ncard : ℝ)) ≤
          Cl*x^((theta+δ)+δ) := by
    have hpow : x^(theta+δ) ≤ x^((theta+δ)+δ) :=
      Real.rpow_le_rpow_of_exponent_le hx1 (by nlinarith)
    exact (hLeftBound x hx).trans
      (mul_le_mul_of_nonneg_left hpow (by nlinarith : 0 ≤ Cl))
  have hcenter :
      ∀ b : Bool, ∀ z ∈ indices x (Real.sqrt x),
        (599/1000:ℝ) ≤ sUpper z → sUpper z ≤ 5/8 →
        ((points b z \ (orient b '' globalS)).ncard : ℝ) ≤
          K*x^(theta+δ) := by
    intro b z hz hlo hhi
    have hzlarge := large_global_routing_domain x T z hx hz hlarge
    have hy : Tc ≤ 2*X z+1 :=
      (le_max_left _ _).trans hzlarge.2
    have hh := hCenterBound x hx z hz hzlarge.1 hy b hlo hhi
    exact hh.trans (mul_le_mul_of_nonneg_right
      (le_max_left Kc Kr) (by positivity))
  have hright :
      ∀ b : Bool, ∀ z ∈ indices x (Real.sqrt x),
        (5/8:ℝ) ≤ sUpper z → sUpper z ≤ 1 →
        ((points b z \ (orient b '' globalS)).ncard : ℝ) ≤
          K*x^(theta+δ) := by
    intro b z hz hlo hhi
    have hzlarge := large_global_routing_domain x T z hx hz hlarge
    have hy : Tr ≤ 2*X z+1 :=
      (le_max_right _ _).trans hzlarge.2
    have hh := hRightBound x hx z hz hzlarge.1 hy b hlo hhi
    exact hh.trans (mul_le_mul_of_nonneg_right
      (le_max_right Kc Kr) (by positivity))
  have htail := hTailOf x hx hlarge hend hleft hcenter hright
  have hexc := (hExc x hx).2.2.2
  have hthird :
      ((FormalAB.S9ad0e971.ConsecutiveCountingA5Source.largeDivisorTail
        x (Real.sqrt x) ∩ globalS).ncard : ℝ) ≤
        (C3+C5)*x^(theta+ε) := by
    have hp3 : x^((1/3:ℝ)+δ) ≤ x^(theta+ε) :=
      Real.rpow_le_rpow_of_exponent_le hx1
        (by dsimp [theta,δ]; nlinarith [theta_gt_endpoint])
    have hp5 : x^((1/5:ℝ)+δ) ≤ x^(theta+ε) :=
      Real.rpow_le_rpow_of_exponent_le hx1
        (by dsimp [theta,δ]; nlinarith [theta_gt_endpoint])
    have hh3 := mul_le_mul_of_nonneg_left hp3 hC3
    have hh5 := mul_le_mul_of_nonneg_left hp5 hC5
    calc
      _ ≤ C3*x^((1/3:ℝ)+δ)+C5*x^((1/5:ℝ)+δ) := hexc
      _ ≤ C3*x^(theta+ε)+C5*x^(theta+ε) := add_le_add hh3 hh5
      _ = (C3+C5)*x^(theta+ε) := by ring
  have hpow : x^((theta+δ)+δ) ≤ x^(theta+ε) :=
    Real.rpow_le_rpow_of_exponent_le hx1
      (by dsimp [δ]; nlinarith)
  have hcoef : 0 ≤ Ce+Cl+2*A*K := by positivity
  have hlast := mul_le_mul_of_nonneg_left hpow hcoef
  calc
    _ ≤ ((FormalAB.S9ad0e971.ConsecutiveCountingA5Source.largeDivisorTail
      x (Real.sqrt x) ∩ globalS).ncard : ℝ) +
        (Ce+Cl+2*A*K)*x^((theta+δ)+δ) := htail
    _ ≤ (C3+C5)*x^(theta+ε) +
        (Ce+Cl+2*A*K)*x^(theta+ε) := add_le_add hthird hlast
    _ = C*x^(theta+ε) := by dsimp [C]; ring
private def kFree (k n : ℕ) : Prop :=
  ∀ p : ℕ, p.Prime → ¬ p^k ∣ n
private def pairDensity (k : ℕ) : ℝ :=
  ∏' p : Nat.Primes, (1 - 2 / ((p : ℕ) : ℝ)^k)
private def kFreePairs (k : ℕ) (x : ℝ) : ℕ :=
  (by classical exact
    ((Finset.Icc 1 ⌊x⌋₊).filter
      (fun n => kFree k n ∧ kFree k (n+1))).card)
private def SieveEstimate : Prop :=
  ∀ k : ℕ, 2 ≤ k → ∀ δ : ℝ, 0 < δ →
    ∃ Cs : ℝ, 0 ≤ Cs ∧ ∀ x : ℝ, 2 ≤ x →
      let S : Set Quad :=
        {q | 1 ≤ q.1.1 ∧ 1 ≤ q.1.2 ∧ 1 ≤ q.2.1 ∧ 1 ≤ q.2.2 ∧
          ((q.1.1^k*q.2.1 : ℕ) : ℝ) ≤ x ∧
          q.1.2^k*q.2.2 = q.1.1^k*q.2.1+1 ∧
          x^((1:ℝ)/(k:ℝ)) < ((q.1.1*q.1.2 : ℕ) : ℝ)}
      S.Finite ∧
        |(kFreePairs k x : ℝ)-x*pairDensity k| ≤
          Cs*x^((1:ℝ)/(k:ℝ)+δ)+(S.ncard : ℝ)
private theorem actual_frozen_reduction
    (hSieve : SieveEstimate)
    (hEnd : EndpointEstimate) (hLeft : LeftEstimate)
    (hCentral : ComponentEstimate (599/1000) (5/8))
    (hRight : ComponentEstimate (5/8) 1) :
    ∀ ε : ℝ, 0 < ε →
      ∃ C : ℝ, ∀ x : ℝ, 2 ≤ x →
        |(kFreePairs 2 x : ℝ)-x*pairDensity 2| ≤
          C*x^(theta+ε) := by
  intro ε hε
  let δ : ℝ := ε/4
  have hδ : 0 < δ := by dsimp [δ]; linarith
  obtain ⟨Ct,B,hCt,hB,hTail⟩ :=
    actual_tail_estimate hEnd hLeft hCentral hRight
      (ε/2) (by linarith)
  obtain ⟨Cs,hCs,hSieveBound⟩ :=
    hSieve 2 (by norm_num) δ hδ
  let C : ℝ := max (Cs+Ct) (B*(1+|pairDensity 2|))+1
  have hC : 0 ≤ C := by
    dsimp [C]
    have hh : 0 ≤ Cs+Ct := add_nonneg hCs hCt
    linarith [le_max_left (Cs+Ct) (B*(1+|pairDensity 2|))]
  have hα : 0 ≤ theta+ε := by
    dsimp [theta]
    linarith [theta_gt_endpoint]
  refine ⟨C,?_⟩
  intro x hx
  have hx1 : 1 ≤ x := by linarith
  have hx0 : 0 < x := by linarith
  by_cases hlarge : B ≤ x
  · have htail := hTail x hlarge
    have hs := (hSieveBound x hx).2
    have hset :
        {q : Quad | 1 ≤ q.1.1 ∧ 1 ≤ q.1.2 ∧
          1 ≤ q.2.1 ∧ 1 ≤ q.2.2 ∧
          ((q.1.1^2*q.2.1 : ℕ) : ℝ) ≤ x ∧
          q.1.2^2*q.2.2 = q.1.1^2*q.2.1+1 ∧
          x^((1:ℝ)/(2:ℝ)) < ((q.1.1*q.1.2 : ℕ) : ℝ)} =
        FormalAB.S9ad0e971.ConsecutiveCountingA5Source.largeDivisorTail
          x (Real.sqrt x) := by
      ext q
      simp only [FormalAB.S9ad0e971.ConsecutiveCountingA5Source.largeDivisorTail,
        Set.mem_ofPred_eq]
      rw [Real.sqrt_eq_rpow]
    have hs' :
        |(kFreePairs 2 x : ℝ)-x*pairDensity 2| ≤
          Cs*x^((1:ℝ)/2+δ)+
          ((FormalAB.S9ad0e971.ConsecutiveCountingA5Source.largeDivisorTail
            x (Real.sqrt x)).ncard : ℝ) := by
      simpa only [FormalAB.S9ad0e971.ConsecutiveCountingA5Source.largeDivisorTail,
        Real.sqrt_eq_rpow, Nat.cast_ofNat] using hs
    have hpS : x^((1:ℝ)/2+δ) ≤ x^(theta+ε) :=
      Real.rpow_le_rpow_of_exponent_le hx1
        (by dsimp [theta,δ]; linarith [theta_gt_sieve])
    have hpT : x^(theta+ε/2) ≤ x^(theta+ε) :=
      Real.rpow_le_rpow_of_exponent_le hx1 (by linarith)
    have hS := mul_le_mul_of_nonneg_left hpS hCs
    have hT := mul_le_mul_of_nonneg_left hpT hCt
    have hCbig : Cs+Ct ≤ C := by
      dsimp [C]
      linarith [le_max_left (Cs+Ct) (B*(1+|pairDensity 2|))]
    have hpow : 0 ≤ x^(theta+ε) := by positivity
    nlinarith [mul_nonneg (sub_nonneg.mpr hCbig) hpow]
  · have hxB : x ≤ B := le_of_not_ge hlarge
    have hsmall := bounded_filtered_pair
      (fun n => kFree 2 n ∧ kFree 2 (n+1))
      (pairDensity 2) B (theta+ε) x hB hx hxB hα
    have hsmall' :
        |(kFreePairs 2 x : ℝ)-x*pairDensity 2| ≤
          B*(1+|pairDensity 2|)*x^(theta+ε) := by
      have heq : kFreePairs 2 x =
          (@Finset.filter ℕ (fun n => kFree 2 n ∧ kFree 2 (n+1))
            (Classical.decPred _) (Finset.Icc 1 ⌊x⌋₊)).card := by
        unfold kFreePairs
        apply congrArg Finset.card
        ext n
        simp
      simpa only [heq] using hsmall
    have hCsmall : B*(1+|pairDensity 2|) ≤ C := by
      dsimp [C]
      linarith [le_max_right (Cs+Ct) (B*(1+|pairDensity 2|))]
    have hpow : 0 ≤ x^(theta+ε) := by positivity
    nlinarith [mul_nonneg (sub_nonneg.mpr hCsmall) hpow]
end
