          ![(z.1.1 : ℤ),(z.1.2 : ℤ),(z.2.1 : ℤ),(z.2.2 : ℤ)] G = 0} : Set Point).ncard : ℝ) ≤
        C*x^ε := by
  obtain ⟨C0, hC0, hcount⟩ := FormalAB.V3.A5.claim_2b8ac916 hSt K hK ε hε
  refine ⟨max 1 C0, le_max_left _ _, ?_⟩
  intro x D E hx M j G hhom hCI hcoeff
  have ht := hcount x (by linarith) G hhom hCI hcoeff 1 (Or.inl rfl)
  let T : Set Point :=
    {z | 1 ≤ z.1.1 ∧ 1 ≤ z.1.2 ∧ 1 ≤ z.2.1 ∧ 1 ≤ z.2.2 ∧
      ((z.1.2 ^ 2 * z.2.2 : ℕ) : ℤ) = ((z.1.1 ^ 2 * z.2.1 : ℕ) : ℤ) + 1 ∧
      ((z.1.1 ^ 2 * z.2.1 : ℕ) : ℝ) ≤ x ∧
      MvPolynomial.eval₂ (Int.castRingHom ℚ)
        (fun i : Fin 4 => if i = 0 then (z.1.1 : ℚ) else
          if i = 1 then (z.1.2 : ℚ) else
          if i = 2 then (z.2.1 : ℚ) else (z.2.2 : ℚ)) G = 0 ∧
      ¬ ∃ t : ℚ, ((z.1.1 ^ 2 * z.2.1 : ℕ) : ℚ) =
        -((1 : ℤ) : ℚ) * (1 + (16 * t ^ 5 - 20 * t ^ 3 + 5 * t)) / 2}
  change T.Finite ∧ (T.ncard : ℝ) ≤ C0 * x ^ ε at ht
  have hsub : {z | z ∈ {w | w ∈ originalCell x D E M j 1 ∧ w ∉ globalS} ∧ MvPolynomial.eval
      ![(z.1.1 : ℤ),(z.1.2 : ℤ),(z.2.1 : ℤ),(z.2.2 : ℤ)] G = 0} ⊆ T := by
    rintro z ⟨⟨hzcell, hzg⟩, hzero⟩
    have hzsh : z ∈ originalShell x D E 1 := hzcell.1
    obtain ⟨hd, he, hu, hv, hshift, -, hhi, -⟩ := hzsh
    refine ⟨hd, he, hu, hv, hshift, hhi, ?_, not_full12_spectrum z hzcell.1 hzg⟩
    have hw :
        (fun i : Fin 4 => if i = 0 then (z.1.1 : ℚ) else
          if i = 1 then (z.1.2 : ℚ) else
          if i = 2 then (z.2.1 : ℚ) else (z.2.2 : ℚ)) =
        (fun i : Fin 4 =>
          ((![(z.1.1 : ℤ),(z.1.2 : ℤ),(z.2.1 : ℤ),(z.2.2 : ℤ)] i : ℤ) : ℚ)) := by
      funext i
      fin_cases i <;> simp
    rw [hw]
    change MvPolynomial.eval₂ (Int.castRingHom ℚ)
      ((Int.castRingHom ℚ) ∘
        ![(z.1.1 : ℤ),(z.1.2 : ℤ),(z.2.1 : ℤ),(z.2.2 : ℤ)]) G = 0
    rw [← MvPolynomial.eval₂_comp]
    rw [hzero, map_zero]
  have hcard : (({z | z ∈ {w | w ∈ originalCell x D E M j 1 ∧ w ∉ globalS} ∧ MvPolynomial.eval
      ![(z.1.1 : ℤ),(z.1.2 : ℤ),(z.2.1 : ℤ),(z.2.2 : ℤ)] G = 0} : Set Point).ncard : ℝ) ≤
      (T.ncard : ℝ) := by
    exact_mod_cast Set.ncard_le_ncard hsub ht.1
  refine ⟨ht.1.subset hsub, hcard.trans (ht.2.trans ?_)⟩
  exact mul_le_mul_of_nonneg_right (le_max_right 1 C0)
    (Real.rpow_nonneg (by linarith) _)
section Bilinear
open MvPolynomial
abbrev ix (a b c d : ℕ) : Fin 4 →₀ ℕ :=
  Finsupp.single 0 a + Finsupp.single 1 b +
    Finsupp.single 2 c + Finsupp.single 3 d
theorem ix_injective (a b c d a' b' c' d' : ℕ) :
    ix a b c d = ix a' b' c' d' ↔
      a = a' ∧ b = b' ∧ c = c' ∧ d = d' := by
  constructor
  · intro h
    exact ⟨by simpa [ix] using congrArg (fun m : Fin 4 →₀ ℕ => m 0) h,
      by simpa [ix] using congrArg (fun m : Fin 4 →₀ ℕ => m 1) h,
      by simpa [ix] using congrArg (fun m : Fin 4 →₀ ℕ => m 2) h,
      by simpa [ix] using congrArg (fun m : Fin 4 →₀ ℕ => m 3) h⟩
  · rintro ⟨rfl,rfl,rfl,rfl⟩
    rfl
theorem support_four (G : MvPolynomial (Fin 4) ℤ)
    (h : ∀ m ∈ G.support, m 0 + m 1 = 1 ∧ m 2 + m 3 = 1) :
    G.support ⊆
      ({ix 1 0 1 0, ix 0 1 1 0, ix 1 0 0 1, ix 0 1 0 1} :
        Finset (Fin 4 →₀ ℕ)) := by
  intro m hm
  obtain ⟨h1,h2⟩ := h m hm
  have hc :
      (m 0 = 1 ∧ m 1 = 0 ∧ m 2 = 1 ∧ m 3 = 0) ∨
      (m 0 = 0 ∧ m 1 = 1 ∧ m 2 = 1 ∧ m 3 = 0) ∨
      (m 0 = 1 ∧ m 1 = 0 ∧ m 2 = 0 ∧ m 3 = 1) ∨
      (m 0 = 0 ∧ m 1 = 1 ∧ m 2 = 0 ∧ m 3 = 1) := by omega
  rcases hc with hc | hc | hc | hc
  · have he : m = ix 1 0 1 0 := by
      ext i
      fin_cases i <;> simp [ix] <;> omega
    rw [he]
    simp
  · have he : m = ix 0 1 1 0 := by
      ext i
      fin_cases i <;> simp [ix] <;> omega
    rw [he]
    simp
  · have he : m = ix 1 0 0 1 := by
      ext i
      fin_cases i <;> simp [ix] <;> omega
    rw [he]
    simp
  · have he : m = ix 0 1 0 1 := by
      ext i
      fin_cases i <;> simp [ix] <;> omega
    rw [he]
    simp
theorem four_coefficient_identity (G : MvPolynomial (Fin 4) ℤ)
    (h : ∀ m ∈ G.support, m 0 + m 1 = 1 ∧ m 2 + m 3 = 1) :
    G =
      (C (G.coeff (ix 1 0 1 0)) * X 0 +
       C (G.coeff (ix 0 1 1 0)) * X 1) * X 2 -
      (C (-G.coeff (ix 1 0 0 1)) * X 0 +
       C (-G.coeff (ix 0 1 0 1)) * X 1) * X 3 := by
  have hs := support_four G h
  have hsum : G =
      ∑ m ∈ ({ix 1 0 1 0, ix 0 1 1 0,
          ix 1 0 0 1, ix 0 1 0 1} : Finset (Fin 4 →₀ ℕ)),
        monomial m (G.coeff m) := by
    nth_rw 1 [G.as_sum]
    apply Finset.sum_subset hs
    intro m hm hn
    have hz : G.coeff m = 0 := by
      simpa only [MvPolynomial.mem_support_iff, not_ne_iff] using hn
    simp [hz]
  nth_rw 1 [hsum]
  simp only [Finset.sum_insert, Finset.sum_singleton,
    Finset.mem_insert, Finset.mem_singleton, ix_injective,
    and_false,  and_true, 
    Nat.reduceEqDiff, or_false,  not_false_eq_true]
  simp only [ add_mul, map_neg,  neg_mul,
    sub_eq_add_neg,   MvPolynomial.X,
    show ∀ a : ℤ, (MvPolynomial.C a : MvPolynomial (Fin 4) ℤ) =
      monomial 0 a from fun _ => rfl,
    MvPolynomial.monomial_mul, zero_add,   mul_one]
  simp only [ix, Finsupp.single_zero, zero_add, add_zero,
     add_assoc] ; abel
theorem eval_zero_nonunit (P : MvPolynomial (Fin 4) ℚ)
    (h : MvPolynomial.eval (fun _ => (0 : ℚ)) P = 0) :
    ¬ IsUnit P := by
  intro hp
  have he := hp.map (MvPolynomial.eval (fun _ => (0 : ℚ)))
  rw [h] at he
  exact not_isUnit_zero he
theorem determinant_nonzero
    (G : MvPolynomial (Fin 4) ℤ) (A B C D : ℤ)
    (hG : G =
      (MvPolynomial.C A * MvPolynomial.X 0 +
       MvPolynomial.C B * MvPolynomial.X 1) * MvPolynomial.X 2 -
      (MvPolynomial.C C * MvPolynomial.X 0 +
       MvPolynomial.C D * MvPolynomial.X 1) * MvPolynomial.X 3)
    (hi : Irreducible (MvPolynomial.map (Int.castRingHom ℚ) G)) :
    A * D - B * C ≠ 0 := by
  intro hdet
  have hmap : MvPolynomial.map (Int.castRingHom ℚ) G =
      (MvPolynomial.C (A : ℚ) * MvPolynomial.X 0 +
       MvPolynomial.C (B : ℚ) * MvPolynomial.X 1) * MvPolynomial.X 2 -
      (MvPolynomial.C (C : ℚ) * MvPolynomial.X 0 +
       MvPolynomial.C (D : ℚ) * MvPolynomial.X 1) * MvPolynomial.X 3 := by
    rw [hG]
    simp
  by_cases hA : A = 0
  · by_cases hB : B = 0
    · let L : MvPolynomial (Fin 4) ℚ := MvPolynomial.X 3
      let H : MvPolynomial (Fin 4) ℚ :=
        -(MvPolynomial.C (C : ℚ) * MvPolynomial.X 0 +
          MvPolynomial.C (D : ℚ) * MvPolynomial.X 1)
      have hf : MvPolynomial.map (Int.castRingHom ℚ) G = L * H := by
        rw [hmap]
        simp [hA, hB, L, H] ; ring
      rcases hi.isUnit_or_isUnit hf with hu | hu
      · exact eval_zero_nonunit L (by simp [L]) hu
      · exact eval_zero_nonunit H (by simp [H]) hu
    · have hBC : B * C = 0 := by
        simpa [hA] using hdet
      have hC : C = 0 := (mul_eq_zero.mp hBC).resolve_left hB
      let L : MvPolynomial (Fin 4) ℚ := MvPolynomial.X 1
      let H : MvPolynomial (Fin 4) ℚ :=
        MvPolynomial.C (B : ℚ) * MvPolynomial.X 2 -
          MvPolynomial.C (D : ℚ) * MvPolynomial.X 3
      have hf : MvPolynomial.map (Int.castRingHom ℚ) G = L * H := by
        rw [hmap]
        simp [hA, hC, L, H] ; ring
      rcases hi.isUnit_or_isUnit hf with hu | hu
      · exact eval_zero_nonunit L (by simp [L]) hu
      · exact eval_zero_nonunit H (by simp [H]) hu
  · have hAq : (A : ℚ) ≠ 0 := by exact_mod_cast hA
    have hdetq : (A : ℚ) * (D : ℚ) =
        (B : ℚ) * (C : ℚ) := by
      exact_mod_cast sub_eq_zero.mp hdet
    have hDq0 : (D : ℚ) =
        ((B : ℚ) * (C : ℚ)) / (A : ℚ) :=
      (eq_div_iff hAq).2 (by
        calc
          (D : ℚ) * (A : ℚ) = (A : ℚ) * (D : ℚ) := by ring
          _ = (B : ℚ) * (C : ℚ) := hdetq)
    have hDq : (D : ℚ) =
        (B : ℚ) * ((C : ℚ) / (A : ℚ)) := by
      calc
        (D : ℚ) = ((B : ℚ) * (C : ℚ)) / (A : ℚ) := hDq0
        _ = (B : ℚ) * ((C : ℚ) / (A : ℚ)) := by ring
    have hAcq : (A : ℚ) * ((C : ℚ) / (A : ℚ)) = (C : ℚ) := by
      field_simp [hAq]
    have hAc := congrArg
      (fun z : ℚ => (MvPolynomial.C z : MvPolynomial (Fin 4) ℚ)) hAcq
    simp only [map_mul] at hAc
    let L : MvPolynomial (Fin 4) ℚ :=
      MvPolynomial.C (A : ℚ) * MvPolynomial.X 0 +
        MvPolynomial.C (B : ℚ) * MvPolynomial.X 1
    let H : MvPolynomial (Fin 4) ℚ :=
      MvPolynomial.X 2 -
        MvPolynomial.C ((C : ℚ) / (A : ℚ)) * MvPolynomial.X 3
    have hf : MvPolynomial.map (Int.castRingHom ℚ) G = L * H := by
      rw [hmap, hDq]
      simp only [map_mul]
      dsimp [L, H]
      linear_combination (MvPolynomial.X 0 * MvPolynomial.X 3) * hAc
    rcases hi.isUnit_or_isUnit hf with hu | hu
    · exact eval_zero_nonunit L (by simp [L]) hu
    · exact eval_zero_nonunit H (by simp [H]) hu
theorem direct_original_graph
    (G : MvPolynomial (Fin 4) ℤ)
    (hbi : ∀ m ∈ G.support, m 0+m 1=1 ∧ m 2+m 3=1)
    (hirr : Irreducible G) (H : ℝ)
    (hheight : ∀ m : Fin 4 →₀ ℕ, |((G.coeff m : ℤ) : ℝ)| ≤ H) :
    ∃ A B C D : ℤ, A*D-B*C ≠ 0 ∧
      |(A : ℝ)| ≤ H ∧ |(B : ℝ)| ≤ H ∧
      |(C : ℝ)| ≤ H ∧ |(D : ℝ)| ≤ H ∧
      ∀ d e u v : ℕ,
        eval ![(d : ℤ),(e : ℤ),(u : ℤ),(v : ℤ)] G=0 →
        (A*(d : ℤ)+B*(e : ℤ))*(u : ℤ)=
          (C*(d : ℤ)+D*(e : ℤ))*(v : ℤ) := by
  have htd : G.totalDegree=2 :=
    (JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C02.PcClassify.isHomogeneous_of_bihom
      hbi).totalDegree hirr.ne_zero
  have hq : Irreducible (map (Int.castRingHom ℚ) G) :=
    JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C02.PcClassify.irreducible_map_rat
      hirr (by
        intro c hc
        have hh := htd
        rw [hc,totalDegree_C] at hh
        omega)
  let A : ℤ := G.coeff (ix 1 0 1 0)
  let B : ℤ := G.coeff (ix 0 1 1 0)
  let C : ℤ := -G.coeff (ix 1 0 0 1)
  let D : ℤ := -G.coeff (ix 0 1 0 1)
  have hG : G =
      (MvPolynomial.C A*X 0+MvPolynomial.C B*X 1)*X 2-
        (MvPolynomial.C C*X 0+MvPolynomial.C D*X 1)*X 3 :=
    four_coefficient_identity G hbi
  have hdet : A*D-B*C ≠ 0 := determinant_nonzero G A B C D hG hq
  refine ⟨A,B,C,D,hdet,hheight _,hheight _,?_,?_,?_⟩
  · simpa only [C,Int.cast_neg,abs_neg] using hheight (ix 1 0 0 1)
  · simpa only [D,Int.cast_neg,abs_neg] using hheight (ix 0 1 0 1)
  · intro d e u v hz
    rw [hG] at hz
    simp only [eval_sub,eval_mul,eval_add,eval_C,eval_X] at hz
    change (A*(d : ℤ)+B*(e : ℤ))*(u : ℤ)-
      (C*(d : ℤ)+D*(e : ℤ))*(v : ℤ)=0 at hz
    exact sub_eq_zero.mp hz
end Bilinear
def boundedLow11Population (x : ℝ) (G : Poly) : Set Point :=
  {z | 1 ≤ z.1.1 ∧ 1 ≤ z.1.2 ∧ 1 ≤ z.2.1 ∧ 1 ≤ z.2.2 ∧
    ((z.1.2^2*z.2.2 : ℕ) : ℤ)=((z.1.1^2*z.2.1 : ℕ) : ℤ)+1 ∧
    ((z.1.1^2*z.2.1 : ℕ) : ℝ) ≤ x ∧
    MvPolynomial.eval ![(z.1.1 : ℤ),(z.1.2 : ℤ),(z.2.1 : ℤ),(z.2.2 : ℤ)] G=0 ∧
    z ∉ globalS}
theorem pure_mem_globalS
    (A B C D : ℤ) (κ a b : ℚ) (z : Point)
    (hd : 1 ≤ z.1.1) (he : 1 ≤ z.1.2)
    (hu : 1 ≤ z.2.1) (hv : 1 ≤ z.2.2)
    (hdet : A*D-B*C ≠ 0) (hκ : κ ≠ 0)
    (hpure : ∀ r s : ℚ,
      s^2*((A : ℚ)*r+(B : ℚ)*s)-
        r^2*((C : ℚ)*r+(D : ℚ)*s)=κ*(a*r+b*s)^3)
    (hgraph : (A*(z.1.1 : ℤ)+B*(z.1.2 : ℤ))*(z.2.1 : ℤ)=
      (C*(z.1.1 : ℤ)+D*(z.1.2 : ℤ))*(z.2.2 : ℤ))
    (hshift : ((z.1.2^2*z.2.2 : ℕ) : ℤ)=
      ((z.1.1^2*z.2.1 : ℕ) : ℤ)+1) :
    z ∈ globalS := by
  have hgraphQ :
      (z.2.2 : ℚ)*((C : ℚ)*(z.1.1 : ℚ)+(D : ℚ)*(z.1.2 : ℚ))=
        (z.2.1 : ℚ)*((A : ℚ)*(z.1.1 : ℚ)+(B : ℚ)*(z.1.2 : ℚ)) := by
    have hhQ :
        ((A : ℚ)*(z.1.1 : ℚ)+(B : ℚ)*(z.1.2 : ℚ))*(z.2.1 : ℚ)=
          ((C : ℚ)*(z.1.1 : ℚ)+(D : ℚ)*(z.1.2 : ℚ))*(z.2.2 : ℚ) := by
      exact_mod_cast hgraph
    nlinarith only [hhQ]
  have hdetQ : (A : ℚ)*(D : ℚ)-(B : ℚ)*(C : ℚ) ≠ 0 := by
    exact_mod_cast hdet
  obtain ⟨_,hN⟩ :=
    FormalAB.S1b64778e.ConsecutiveCountingA5MinimalPure.minimalPureComponentSpectrum
      (A : ℚ) (B : ℚ) (C : ℚ) (D : ℚ) κ a b
      z.1.1 z.1.2 z.2.1 z.2.2 1 (Or.inl rfl)
      hd he hu hv hdetQ hκ hpure hgraphQ hshift
  have hsNat : z.1.2^2*z.2.2=z.1.1^2*z.2.1+1 := by
    exact_mod_cast hshift
  change z ∈ FormalAB.S9511d4c3.ConsecutiveCountingA5Exception.S3 ∪
    FormalAB.S9511d4c3.ConsecutiveCountingA5Exception.S5
  refine Or.inl ⟨⟨hd,he,hu,hv,hsNat⟩, Or.inl ⟨(a*(z.1.1 : ℚ)-b*(z.1.2 : ℚ))/
    (a*(z.1.1 : ℚ)+b*(z.1.2 : ℚ)), ?_⟩⟩
  rw [hN]
  simp only [FormalAB.S1b64778e.ConsecutiveCountingA5MinimalPure.Q2,
    FormalAB.S9511d4c3.ConsecutiveCountingA5Exception.Q2, Int.cast_one]
  ring
theorem low11_factor_count (hdfdc : Hdfdc) (hSt : StewartHyp) (K : ℝ) (hK : 0 ≤ K)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ C : ℝ, 1 ≤ C ∧
    ∀ x : ℝ, 4 ≤ x → ∀ G : Poly, Irreducible G →
      (∀ m ∈ G.support, m 0+m 1=1 ∧ m 2+m 3=1) →
      (∀ m : Fin 4 →₀ ℕ, |((G.coeff m : ℤ) : ℝ)| ≤ x^K) →
      (boundedLow11Population x G).Finite ∧
        ((boundedLow11Population x G).ncard : ℝ) ≤ C*x^ε := by
  classical
  have hSt' : FormalAB.S84900580.ConsecutiveCountingA5Full12Nonexceptional.StewartHyp := hSt
  obtain ⟨Cn,hCn,hNon⟩ := hdfdc hSt' K hK ε hε
  let C : ℝ := max 1 Cn
  have hC : 1 ≤ C := le_max_left _ _
  have hCnC : Cn ≤ C := le_max_right _ _
  refine ⟨C,hC,?_⟩
  intro x hx G hirr hbi hheight
  obtain ⟨A,B,Cg,D,hdet,hA,hB,hCg,hD,hgraph⟩ :=
    direct_original_graph G hbi hirr (x^K) hheight
  let S : Set Point := boundedLow11Population x G
  change S.Finite ∧ (S.ncard : ℝ) ≤ C*x^ε
  by_cases hpure : ∃ κ a b : ℚ, κ ≠ 0 ∧
      ∀ r s : ℚ, s^2*((A : ℚ)*r+(B : ℚ)*s)-
        r^2*((Cg : ℚ)*r+(D : ℚ)*s)=κ*(a*r+b*s)^3
  · obtain ⟨κ,a,b,hκ,hpoly⟩ := hpure
    have hempty : S=∅ := by
      ext z
      simp only [Set.mem_empty_iff_false,iff_false]
      rintro ⟨hd,he,hu,hv,hs,_,hz,hout⟩
      exact hout (pure_mem_globalS A B Cg D κ a b z
        hd he hu hv hdet hκ hpoly
        (hgraph z.1.1 z.1.2 z.2.1 z.2.2 hz) hs)
    refine ⟨by rw [hempty]; exact Set.finite_empty,?_⟩
    rw [hempty,Set.ncard_empty,Nat.cast_zero]
    exact mul_nonneg (by linarith : 0 ≤ C) (Real.rpow_nonneg (by linarith) _)
  · let N : Set Point :=
      {z | 1 ≤ z.1.1 ∧ 1 ≤ z.1.2 ∧ 1 ≤ z.2.1 ∧ 1 ≤ z.2.2 ∧
        ((z.1.1^2*z.2.1 : ℕ) : ℝ) ≤ x ∧
        ((z.1.2^2*z.2.2 : ℕ) : ℤ)=((z.1.1^2*z.2.1 : ℕ) : ℤ)+1 ∧
        (A*(z.1.1 : ℤ)+B*(z.1.2 : ℤ))*(z.2.1 : ℤ)=
          (Cg*(z.1.1 : ℤ)+D*(z.1.2 : ℤ))*(z.2.2 : ℤ)}
    have hN := hNon x (by linarith) A B Cg D hA hB hCg hD hdet hpure 1 (Or.inl rfl)
    change N.Finite ∧ (N.ncard : ℝ) ≤ Cn*x^ε at hN
    have hsub : S ⊆ N := by
      rintro z ⟨hd,he,hu,hv,hs,hn,hz,_⟩
      exact ⟨hd,he,hu,hv,hn,hs,hgraph z.1.1 z.1.2 z.2.1 z.2.2 hz⟩
    refine ⟨hN.1.subset hsub,?_⟩
    calc
      (S.ncard : ℝ) ≤ (N.ncard : ℝ) := by
        exact_mod_cast Set.ncard_le_ncard hsub hN.1
      _ ≤ Cn*x^ε := hN.2
      _ ≤ C*x^ε := mul_le_mul_of_nonneg_right hCnC
        (Real.rpow_nonneg (by linarith) _)
theorem scale_bound (n J M R B : ℝ) (hJ : J ≤ 4*M) (hR : 0 ≤ R) (hn : n ≤ J * R)
    (hMB : M * R ≤ B) : n ≤ 4 * B := by
  have h1 : J * R ≤ 4*M*R := mul_le_mul_of_nonneg_right hJ hR
  linarith
theorem j2 (h99 : H99) (h7c : H7c) (h506 : H506) (h0a4 : H0a4) (hdfdc : Hdfdc) : BAL := by
