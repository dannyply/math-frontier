  have hc :
      (m 0 = 1 ∧ m 1 = 0 ∧ m 2 = 1 ∧ m 3 = 0) ∨
      (m 0 = 0 ∧ m 1 = 1 ∧ m 2 = 1 ∧ m 3 = 0) ∨
      (m 0 = 1 ∧ m 1 = 0 ∧ m 2 = 0 ∧ m 3 = 1) ∨
      (m 0 = 0 ∧ m 1 = 1 ∧ m 2 = 0 ∧ m 3 = 1) := by omega
  rcases hc with hc | hc | hc | hc
  · have he : m = ix 1 0 1 0 := by
      ext i
      fin_cases i <;> simp [ix] <;> omega
    rw [he]
    simp
  · have he : m = ix 0 1 1 0 := by
