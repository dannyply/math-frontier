    nlinarith
  dsimp [unitConstant]
  nlinarith [mul_nonneg hcoeff (show 0 ≤ Real.log x by exact hlogx)]
theorem uniform_absorption (L : ℕ) (hL : 0 < L) (ε : ℝ) (hε : 0 < ε) :
    ∃ Cbound : ℝ, 0 < Cbound ∧
      ∀ x : ℝ, 2 ≤ x → ∀ n : ℕ, 0 < n →
      (n : ℝ) ≤ x ^ L →
