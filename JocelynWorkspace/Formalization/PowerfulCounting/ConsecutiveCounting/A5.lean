      D ≤ ((z r).1.1 : ℝ) ∧ ((z r).1.1 : ℝ) ≤ 2*D ∧
      E ≤ ((z r).1.2 : ℝ) ∧ ((z r).1.2 : ℝ) ≤ 2*E ∧
      (x/D^2)/8 ≤ ((z r).2.1 : ℝ) ∧ ((z r).2.1 : ℝ) ≤ 8*(x/D^2) ∧
