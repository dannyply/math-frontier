private theorem dehom_quartic_split_or_degree4 (R : MvPolynomial (Fin 2) ℤ)
    (hR : R.IsHomogeneous 4) (hR0 : R ≠ 0)
    (hthree : ¬ HasThreeProjectiveZeros R) :
    AtMostTwoRoots ((C01.PcCurves.dehom R).map (Int.castRingHom ℚ)) ∧
      (((C01.PcCurves.dehom R).map (Int.castRingHom ℚ)).Splits ∨
        (C01.PcCurves.dehom R).natDegree = 4) := by
  classical
  let f0 : Polynomial ℤ := C01.PcCurves.dehom R
  let f : Polynomial ℚ := f0.map (Int.castRingHom ℚ)
  let RC : MvPolynomial (Fin 2) ℂ := R.map (Int.castRingHom ℂ)
  have hRC : RC.IsHomogeneous 4 := hR.map (Int.castRingHom ℂ)
  have hf0 : f0 ≠ 0 := fun h => hR0 (C01.PcCurves.eq_zero_of_dehom hR h)
  have hinj : Function.Injective (Int.castRingHom ℚ) := RingHom.injective_int _
  have hf : f ≠ 0 := (Polynomial.map_ne_zero_iff hinj).mpr hf0
  have hdeg : f.natDegree = f0.natDegree :=
    Polynomial.natDegree_map_eq_of_injective hinj f0
  have hcomp : (algebraMap ℚ ℂ).comp (Int.castRingHom ℚ) =
      Int.castRingHom ℂ := by
    ext n ; simp
  have hvec : ∀ z : ℂ, Polynomial.eval₂ (algebraMap ℚ ℂ) z f = 0 →
      MvPolynomial.eval (pointVector (some z)) RC = 0 := by
    intro z hz
    have hz' : Polynomial.eval₂ (Int.castRingHom ℂ) z f0 = 0 := by
      simpa only [f, Polynomial.eval₂_map, hcomp] using hz
    change MvPolynomial.eval ![z, 1] RC = 0
    rw [← C01.PcCurves.dehom_eval hRC, C01.PcRes.dehom_map hR,
      Polynomial.eval_map]
    exact hz'
  have hrep : ∀ z : ℂ, Polynomial.eval₂ (algebraMap ℚ ℂ) z f = 0 →
      MvPolynomial.eval (projectivePoint (some z)).rep RC = 0 := by
    intro z hz
    exact eval_projectivePoint_rep_zero RC 4 hRC (some z) (hvec z hz)
  have htwo : AtMostTwoRoots f := by
    intro z₁ z₂ z₃ hz₁ hz₂ hz₃
    by_contra hn
    have h12 : z₁ ≠ z₂ := by intro h; exact hn (Or.inl h)
    have h13 : z₁ ≠ z₃ := by intro h; exact hn (Or.inr (Or.inl h))
    have h23 : z₂ ≠ z₃ := by intro h; exact hn (Or.inr (Or.inr h))
    apply hthree
    refine ⟨projectivePoint (some z₁), projectivePoint (some z₂),
      projectivePoint (some z₃), ?_, ?_, ?_, hrep z₁ hz₁, hrep z₂ hz₂, hrep z₃ hz₃⟩
    · intro h
      exact h12 (Option.some.inj (projectivePoint_injective h))
    · intro h
      exact h13 (Option.some.inj (projectivePoint_injective h))
    · intro h
      exact h23 (Option.some.inj (projectivePoint_injective h))
  refine ⟨htwo, ?_⟩
  by_cases h4 : f0.natDegree = 4
  · exact Or.inr h4
  · left
    have hle : f0.natDegree ≤ 4 := C01.PcCurves.dehom_natDegree_le hR
    have hlt : f0.natDegree < 4 := by omega
    have hc4 : f0.coeff 4 = R.coeff (C01.PcCurves.ex 4 0) := by
      simpa only [f0, Nat.sub_self, if_pos (le_refl 4)] using
        (C01.PcCurves.dehom_coeff hR 4)
    have hc0 : R.coeff (C01.PcCurves.ex 4 0) = 0 := by
      rw [← hc4]
      exact Polynomial.coeff_eq_zero_of_natDegree_lt hlt
    have hinf : MvPolynomial.eval (pointVector none) RC = 0 := by
      change MvPolynomial.eval ![1, 0] RC = 0
      rw [C01.PcCurves.eval_one_zero hRC, MvPolynomial.coeff_map]
      simp only [hc0, map_zero]
    have hinfrep : MvPolynomial.eval (projectivePoint none).rep RC = 0 :=
      eval_projectivePoint_rep_zero RC 4 hRC none hinf
    have hone : ∀ z w : ℂ,
        Polynomial.eval₂ (algebraMap ℚ ℂ) z f = 0 →
        Polynomial.eval₂ (algebraMap ℚ ℂ) w f = 0 → z = w := by
      intro z w hz hw
      by_contra hzw
      apply hthree
      refine ⟨projectivePoint none, projectivePoint (some z),
        projectivePoint (some w), ?_, ?_, ?_, hinfrep, hrep z hz, hrep w hw⟩
      · intro h
        have h' := projectivePoint_injective h
        simp at h'
      · intro h
        have h' := projectivePoint_injective h
        simp at h'
      · intro h
        exact hzw (Option.some.inj (projectivePoint_injective h))
    exact one_root_splits f hf hone
private theorem binary_split_factorization4
    (R : MvPolynomial (Fin 2) ℤ) (hR : R.IsHomogeneous 4) (hR0 : R ≠ 0)
    (hsplit : ((C01.PcCurves.dehom R).map (Int.castRingHom ℚ)).Splits) :
    ∃ c : ℤ, c ≠ 0 ∧ ∃ s : Multiset (Option ℚ),
      s.card = 4 ∧ R = MvPolynomial.C c * (s.map labelLine).prod := by
  classical
  let f : Polynomial ℤ := C01.PcCurves.dehom R
  have hf : f ≠ 0 := fun h => hR0 (C01.PcCurves.eq_zero_of_dehom hR h)
  obtain ⟨c, hc, roots, hcard, hfac, hroots⟩ :=
    integer_linear_factorization f hf hsplit
  let s : Multiset (Option ℚ) :=
    roots.map some + Multiset.replicate (4 - f.natDegree) none
  have hle : f.natDegree ≤ 4 := C01.PcCurves.dehom_natDegree_le hR
  have hs : s.card = 4 := by
    simp only [s, Multiset.card_add, Multiset.card_map, Multiset.card_replicate,
      hcard]
    omega
  have hdehomprod : (s.map labelPoly).prod = (roots.map rationalLinear).prod := by
    simp [s, Multiset.map_add, Multiset.prod_add, Multiset.map_map,
      Function.comp_def, labelPoly]
  let B : MvPolynomial (Fin 2) ℤ := MvPolynomial.C c * (s.map labelLine).prod
  have hB : B.IsHomogeneous 4 := by
    simpa only [B, hs, zero_add] using
      (MvPolynomial.isHomogeneous_C (Fin 2) c).mul (label_product_homogeneous s)
  have hdehom : C01.PcCurves.dehom B = f := by
    rw [show C01.PcCurves.dehom B =
      C01.PcCurves.dehom (MvPolynomial.C c) *
        C01.PcCurves.dehom ((s.map labelLine).prod) from
      C01.PcCurves.dehom_mul _ _]
    rw [label_product_dehom, hdehomprod]
    have hconst : C01.PcCurves.dehom (MvPolynomial.C c : MvPolynomial (Fin 2) ℤ) =
        Polynomial.C c := by simp [C01.PcCurves.dehom]
    rw [hconst]
    exact hfac.symm
  have hsub : C01.PcCurves.dehom (R - B) = 0 := by
    rw [C01.PcCurves.dehom_sub, hdehom]
    exact sub_self f
  have heq : R = B := sub_eq_zero.mp
    (C01.PcCurves.eq_zero_of_dehom (hR.sub hB) hsub)
  exact ⟨c, hc, s, hs, heq⟩
private theorem twoSupportProduct4 {α M : Type*} [DecidableEq α] [CommMonoid M]
    (s : Multiset α) (a b : α) (hcard : s.card = 4)
    (ha : a ∈ s) (hb : b ∈ s) (hne : a ≠ b)
    (hcover : ∀ x ∈ s, x = a ∨ x = b) :
    ∃ j : ℕ, 1 ≤ j ∧ j ≤ 3 ∧
      ∀ f : α → M, (s.map f).prod = f a ^ j * f b ^ (4 - j) := by
  obtain ⟨j,hj,haj,hbj,hprod⟩ :=
    binarySupportProduct (M := M) a b hne s hcover
  refine ⟨j,?_,?_,?_⟩
  · exact haj ha
  · have hlt := hbj hb
    omega
  · intro f
    simpa only [hcard] using hprod f
private theorem factored_label_projective_zero4
    (R : MvPolynomial (Fin 2) ℤ) (hR : R.IsHomogeneous 4)
    (c : ℤ) (s : Multiset (Option ℚ))
    (hfac : R = MvPolynomial.C c * (s.map labelLine).prod)
    (z : Option ℚ) (hz : z ∈ s) :
    MvPolynomial.eval (projectivePoint (labelToComplex z)).rep
      (R.map (Int.castRingHom ℂ)) = 0 := by
  apply eval_projectivePoint_rep_zero _ 4 (hR.map (Int.castRingHom ℂ))
  rw [hfac, map_mul, MvPolynomial.eval_mul,
    label_product_root s z hz, mul_zero]
private def PureComplexFourth (R : MvPolynomial (Fin 2) ℤ) : Prop :=
  ∃ γ α β : ℂ, γ ≠ 0 ∧ (α ≠ 0 ∨ β ≠ 0) ∧
    ∀ r s : ℂ, MvPolynomial.eval ![r,s]
      (R.map (Int.castRingHom ℂ)) = γ * (α*r + β*s)^4
private theorem pure_of_label_power4 (R : MvPolynomial (Fin 2) ℤ)
    (c : ℤ) (hc : c ≠ 0) (a : Option ℚ)
    (hfac : R = MvPolynomial.C c * labelLine a ^ 4) :
    PureComplexFourth R := by
  refine ⟨(c : ℂ), (lineCoeffA a : ℂ), (lineCoeffB a : ℂ), ?_, ?_, ?_⟩
  · exact_mod_cast hc
  · rcases label_coeff_nonzero a with ha | hb
    · left; exact_mod_cast ha
    · right; exact_mod_cast hb
  · intro r s
    rw [hfac]
    simp [labelLine]
private def TwoIndependentLines4 (R : MvPolynomial (Fin 2) ℤ) : Prop :=
  ∃ c a b a' b' : ℤ, ∃ j : ℕ,
    c ≠ 0 ∧ a*b' - a'*b ≠ 0 ∧ 1 ≤ j ∧ j ≤ 3 ∧
      R = MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1)^j *
        (MvPolynomial.C a' * MvPolynomial.X 0 +
          MvPolynomial.C b' * MvPolynomial.X 1)^(4-j)
private theorem split_quartic_two_lines_or_pure
    (R : MvPolynomial (Fin 2) ℤ)
    (hR : R.IsHomogeneous 4) (hR0 : R ≠ 0)
    (hthree : ¬ HasThreeProjectiveZeros R)
    (hsplit : ((C01.PcCurves.dehom R).map (Int.castRingHom ℚ)).Splits) :
    PureComplexFourth R ∨ TwoIndependentLines4 R := by
  classical
  obtain ⟨c,hc,labels,hcard,hfac⟩ :=
    binary_split_factorization4 R hR hR0 hsplit
  obtain ⟨a,ha⟩ := multiset_has_member labels (by omega)
  by_cases hone : ∀ z ∈ labels, z = a
  · have hp : R = MvPolynomial.C c * labelLine a ^ 4 := by
      rw [hfac, label_product_eq_pow labels a hone, hcard]
    exact Or.inl (pure_of_label_power4 R c hc a hp)
  · right
    push Not at hone
    obtain ⟨b,hb,hba⟩ := hone
    have hab : a ≠ b := Ne.symm hba
    have hproj : Function.Injective (fun z : Option ℚ =>
        projectivePoint (labelToComplex z)) :=
      projectivePoint_injective.comp labelToComplex_injective
    have hzero : ∀ z ∈ labels,
        MvPolynomial.eval (projectivePoint (labelToComplex z)).rep
          (R.map (Int.castRingHom ℂ)) = 0 :=
      factored_label_projective_zero4 R hR c labels hfac
    have hcover : ∀ z ∈ labels, z = a ∨ z = b := by
      intro z hz
      by_cases hza : z = a
      · exact Or.inl hza
      by_cases hzb : z = b
      · exact Or.inr hzb
      exfalso
      apply hthree
      refine ⟨projectivePoint (labelToComplex a),
        projectivePoint (labelToComplex b),
        projectivePoint (labelToComplex z), ?_, ?_, ?_,
        hzero a ha, hzero b hb, hzero z hz⟩
      · exact fun he => hab (hproj he)
      · exact fun he => hza (hproj he).symm
      · exact fun he => hzb (hproj he).symm
    obtain ⟨j,hj,hj3,hprod⟩ :=
      twoSupportProduct4 (M := MvPolynomial (Fin 2) ℤ)
        labels a b hcard ha hb hab hcover
    refine ⟨c,lineCoeffA a,lineCoeffB a,
      lineCoeffA b,lineCoeffB b,j,hc,
      label_coeff_independent a b hab,hj,hj3,?_⟩
    rw [hfac,hprod labelLine]
    simp only [labelLine,mul_assoc]
private theorem quadratic_polynomial_explicit
    (F : Polynomial ℤ) (hdeg : F.natDegree = 2) :
    F = Polynomial.C (F.coeff 2) * Polynomial.X ^ 2 +
        Polynomial.C (F.coeff 1) * Polynomial.X +
        Polynomial.C (F.coeff 0) := by
  ext n
  by_cases h0 : n = 0
  · subst n
    simp [ Polynomial.coeff_X]
  by_cases h1 : n = 1
  · subst n
    simp []
    change (Polynomial.C (F.coeff 0) : Polynomial ℤ).coeff 1 = 0
    rw [Polynomial.coeff_C] ; norm_num
  by_cases h2 : n = 2
  · subst n
    simp []
    have hC1 : (Polynomial.C (F.coeff 1) : Polynomial ℤ).coeff 1 = 0 := by
      rw [Polynomial.coeff_C] ; norm_num
    have hC2 : (Polynomial.C (F.coeff 0) : Polynomial ℤ).coeff 2 = 0 := by
      rw [Polynomial.coeff_C] ; norm_num
    change F.coeff 2 = F.coeff 2 +
      (Polynomial.C (F.coeff 1) : Polynomial ℤ).coeff 1 +
      (Polynomial.C (F.coeff 0) : Polynomial ℤ).coeff 2
    rw [hC1, hC2] ; ring
  have hn : 2 < n := by omega
  have hz : F.coeff n = 0 :=
    Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)
  simp [ Polynomial.coeff_X, hz,   h2]
  change 0 = (if 1 = n then F.coeff 1 else 0) +
    (Polynomial.C (F.coeff 0) : Polynomial ℤ).coeff n
  have hC : (Polynomial.C (F.coeff 0) : Polynomial ℤ).coeff n = 0 := by
    rw [Polynomial.coeff_C]
    simp [h0]
  have h1' : 1 ≠ n := Ne.symm h1
  rw [hC]
  simp [h1']
private def binaryQuadraticLift (F : Polynomial ℤ) :
    MvPolynomial (Fin 2) ℤ :=
  MvPolynomial.C (F.coeff 2) * MvPolynomial.X 0 ^ 2 +
    MvPolynomial.C (F.coeff 1) * MvPolynomial.X 0 * MvPolynomial.X 1 +
    MvPolynomial.C (F.coeff 0) * MvPolynomial.X 1 ^ 2
private theorem binaryQuadraticLift_homogeneous (F : Polynomial ℤ) :
    (binaryQuadraticLift F).IsHomogeneous 2 := by
  dsimp [binaryQuadraticLift]
  have h0 := MvPolynomial.isHomogeneous_X ℤ (0 : Fin 2)
  have h1 := MvPolynomial.isHomogeneous_X ℤ (1 : Fin 2)
  exact (((MvPolynomial.isHomogeneous_C (Fin 2) (F.coeff 2)).mul
    (h0.pow 2)).add
      (((MvPolynomial.isHomogeneous_C (Fin 2) (F.coeff 1)).mul h0).mul h1)).add
      ((MvPolynomial.isHomogeneous_C (Fin 2) (F.coeff 0)).mul (h1.pow 2))
private theorem binaryQuadraticLift_dehom
    (F : Polynomial ℤ) (hdeg : F.natDegree = 2) :
    C01.PcCurves.dehom (binaryQuadraticLift F) = F := by
  conv_rhs => rw [quadratic_polynomial_explicit F hdeg]
  simp [binaryQuadraticLift, C01.PcCurves.dehom]
private theorem homogeneous_quartic_of_integral_square
    (R : MvPolynomial (Fin 2) ℤ) (hR : R.IsHomogeneous 4)
    (c : ℤ) (F : Polynomial ℤ)
    (hdeg : F.natDegree = 2)
    (hf : C01.PcCurves.dehom R = Polynomial.C c * F ^ 2) :
    R = MvPolynomial.C c * (binaryQuadraticLift F) ^ 2 := by
  let Q : MvPolynomial (Fin 2) ℤ := binaryQuadraticLift F
  have hQ : Q.IsHomogeneous 2 := binaryQuadraticLift_homogeneous F
  have hB : (MvPolynomial.C c * Q ^ 2).IsHomogeneous 4 := by
    exact (MvPolynomial.isHomogeneous_C (Fin 2) c).mul (hQ.pow 2)
  have hdehom : C01.PcCurves.dehom
      (MvPolynomial.C c * Q ^ 2) = Polynomial.C c * F ^ 2 := by
    have hc : C01.PcCurves.dehom (MvPolynomial.C c : MvPolynomial (Fin 2) ℤ) =
        Polynomial.C c := by simp [C01.PcCurves.dehom]
    have hq : C01.PcCurves.dehom Q = F := binaryQuadraticLift_dehom F hdeg
    calc
      C01.PcCurves.dehom (MvPolynomial.C c * Q ^ 2) =
          C01.PcCurves.dehom (MvPolynomial.C c) *
            (C01.PcCurves.dehom Q * C01.PcCurves.dehom Q) := by
              rw [pow_two, C01.PcCurves.dehom_mul, C01.PcCurves.dehom_mul]
      _ = Polynomial.C c * F ^ 2 := by rw [hc, hq, pow_two]
  have hsub : C01.PcCurves.dehom
      (R - MvPolynomial.C c * Q ^ 2) = 0 := by
    rw [C01.PcCurves.dehom_sub, hf, hdehom]
    exact sub_self _
  have hEq : R = MvPolynomial.C c * Q ^ 2 := sub_eq_zero.mp
    (C01.PcCurves.eq_zero_of_dehom (hR.sub hB) hsub)
  exact hEq
private theorem nonsquare_discriminant_of_nonsplit_square
    (f F : Polynomial ℤ) (c : ℤ) (_hc : c ≠ 0)
    (hFdeg : F.natDegree = 2)
    (hf : f = Polynomial.C c * F ^ 2)
    (hn : ¬ (f.map (Int.castRingHom ℚ)).Splits) :
    ¬ IsSquare ((F.coeff 1) ^ 2 -
      4 * (F.coeff 2) * (F.coeff 0)) := by
  intro hs
  let A : ℤ := F.coeff 2
  let B : ℤ := F.coeff 1
  let C₀ : ℤ := F.coeff 0
  obtain ⟨z,hz⟩ := hs
  have hFne : F ≠ 0 := by
    intro he
    rw [he, Polynomial.natDegree_zero] at hFdeg
    omega
  have hA : A ≠ 0 := by
    have hlead : F.leadingCoeff ≠ 0 :=
      Polynomial.leadingCoeff_ne_zero.mpr hFne
    simpa only [A, ← hFdeg, Polynomial.coeff_natDegree] using hlead
  have hAQ : (A : ℚ) ≠ 0 := by exact_mod_cast hA
  have hFQne : F.map (Int.castRingHom ℚ) ≠ 0 :=
    (Polynomial.map_ne_zero_iff (RingHom.injective_int _)).mpr hFne
  have hFQdeg : (F.map (Int.castRingHom ℚ)).natDegree = 2 := by
    rw [Polynomial.natDegree_map_eq_of_injective (RingHom.injective_int _) F]
    exact hFdeg
  have hzQ : (z : ℚ) ^ 2 =
      (B : ℚ) ^ 2 - 4 * (A : ℚ) * (C₀ : ℚ) := by
    have hzInt : z ^ 2 = B ^ 2 - 4 * A * C₀ := by
      dsimp [A,B,C₀] at hz ⊢
      nlinarith [hz]
    exact_mod_cast hzInt
  let r : ℚ := ((z : ℚ) - (B : ℚ)) / (2 * (A : ℚ))
  have hval : Polynomial.eval r (F.map (Int.castRingHom ℚ)) =
      (A : ℚ) * r ^ 2 + (B : ℚ) * r + (C₀ : ℚ) := by
    conv_lhs => rw [quadratic_polynomial_explicit F hFdeg]
    simp [A,B,C₀]
  have hroot : Polynomial.eval r (F.map (Int.castRingHom ℚ)) = 0 := by
    rw [hval]
    dsimp [r]
    field_simp [hAQ]
    nlinarith [hzQ]
  have hdiv :
      Polynomial.X - Polynomial.C r ∣ F.map (Int.castRingHom ℚ) :=
    Polynomial.dvd_iff_isRoot.mpr hroot
  obtain ⟨g,hfactor⟩ := hdiv
  have hlinne : (Polynomial.X - Polynomial.C r : Polynomial ℚ) ≠ 0 := by
    intro he
    have hd : (Polynomial.X - Polynomial.C r : Polynomial ℚ).natDegree = 0 := by
      rw [he]
      simp
    rw [Polynomial.natDegree_X_sub_C r] at hd
    omega
  have hg : g ≠ 0 := by
    intro he
    rw [he,mul_zero] at hfactor
    exact hFQne hfactor
  have hdegg : g.natDegree = 1 := by
    have he := Polynomial.natDegree_mul hlinne hg
    rw [←hfactor, Polynomial.natDegree_X_sub_C, hFQdeg] at he
    omega
  have hlinS : (Polynomial.X - Polynomial.C r : Polynomial ℚ).Splits :=
    splits_degree_one _ hlinne (Polynomial.natDegree_X_sub_C r)
  have hgS : g.Splits := splits_degree_one g hg hdegg
  have hFS : (F.map (Int.castRingHom ℚ)).Splits := by
    rw [hfactor]
    exact hlinS.mul hgS
  have hfS : (f.map (Int.castRingHom ℚ)).Splits := by
    rw [hf]
    have hcCast : (Int.castRingHom ℚ) c = (c : ℚ) := rfl
    simpa only [Polynomial.map_mul, Polynomial.map_pow, Polynomial.map_C, pow_two,
      hcCast] using ((Polynomial.Splits.C (c : ℚ)).mul (hFS.mul hFS))
  exact hn hfS
private def IntegralQuadraticSquare4
    (R : MvPolynomial (Fin 2) ℤ) : Prop :=
  ∃ c A B C₀ : ℤ, c ≠ 0 ∧
    ¬ IsSquare (B ^ 2 - 4 * A * C₀) ∧
    ∀ d e : ℤ, MvPolynomial.eval ![d,e] R =
      c * (A * d ^ 2 + B * d * e + C₀ * e ^ 2) ^ 2
private theorem binary_quartic_classification_internal
    (R : MvPolynomial (Fin 2) ℤ)
    (hR : R.IsHomogeneous 4) (hR0 : R ≠ 0)
    (hnpure : ¬ PureComplexFourth R) :
    HasThreeProjectiveZeros R ∨
      TwoIndependentLines4 R ∨ IntegralQuadraticSquare4 R := by
  classical
  by_cases hthree : HasThreeProjectiveZeros R
  · exact Or.inl hthree
  right
  let f : Polynomial ℤ := C01.PcCurves.dehom R
  have hf0 : f ≠ 0 := fun h => hR0 (C01.PcCurves.eq_zero_of_dehom hR h)
  have hdehom := dehom_quartic_split_or_degree4 R hR hR0 hthree
  by_cases hsplit : (f.map (Int.castRingHom ℚ)).Splits
  · rcases split_quartic_two_lines_or_pure R hR hR0 hthree hsplit with hpure | hlines
    · exact (hnpure hpure).elim
    · exact Or.inl hlines
  · right
    have hdegf : f.natDegree = 4 := hdehom.2.resolve_left hsplit
    have hfQ0 : f.map (Int.castRingHom ℚ) ≠ 0 :=
      (Polynomial.map_ne_zero_iff (RingHom.injective_int _)).mpr hf0
    have hdegQ : (f.map (Int.castRingHom ℚ)).natDegree = 4 := by
      rw [Polynomial.natDegree_map_eq_of_injective (RingHom.injective_int _) f]
      exact hdegf
    obtain ⟨p,hp,hdegp,cQ,hcQ,hfQ⟩ :=
      nonsplit_quartic_rational_square
        (f.map (Int.castRingHom ℚ)) hfQ0 hdegQ hdehom.1 hsplit
    obtain ⟨c,hc,F,hFprim,hFdeg,hfInt⟩ :=
      integral_square_descent f hf0 hdegf p hp.ne_zero hdegp cQ hcQ hfQ
    have hRfac :
        R = MvPolynomial.C c * (binaryQuadraticLift F) ^ 2 :=
      homogeneous_quartic_of_integral_square R hR c F hFdeg hfInt
    let A : ℤ := F.coeff 2
    let B : ℤ := F.coeff 1
    let C₀ : ℤ := F.coeff 0
    have hdisc : ¬ IsSquare (B ^ 2 - 4 * A * C₀) :=
      nonsquare_discriminant_of_nonsplit_square f F c hc hFdeg hfInt hsplit
    refine ⟨c,A,B,C₀,hc,hdisc,?_⟩
    intro d e
    rw [hRfac]
    simp [binaryQuadraticLift, A, B, C₀]
theorem binary_quartic_classification_gated_literal :
    (let ThreeProjectiveZeros : MvPolynomial (Fin 2) ℤ → Prop := fun R => ∃ p₁ p₂ p₃ : Projectivization ℂ (Fin 2 → ℂ), p₁ ≠ p₂ ∧ p₁ ≠ p₃ ∧ p₂ ≠ p₃ ∧ MvPolynomial.eval p₁.rep (MvPolynomial.map (Int.castRingHom ℂ) R) = 0 ∧ MvPolynomial.eval p₂.rep (MvPolynomial.map (Int.castRingHom ℂ) R) = 0 ∧ MvPolynomial.eval p₃.rep (MvPolynomial.map (Int.castRingHom ℂ) R) = 0;let PureComplexFourth : MvPolynomial (Fin 2) ℤ → Prop := fun R => ∃ γ α β : ℂ, γ ≠ 0 ∧ (α ≠ 0 ∨ β ≠ 0) ∧ ∀ r s : ℂ, MvPolynomial.eval ![r, s] (MvPolynomial.map (Int.castRingHom ℂ) R) = γ * (α * r + β * s) ^ 4;let IntegralTwoLinearFactors4 : MvPolynomial (Fin 2) ℤ → Prop := fun R => ∃ (c a b a' b' : ℤ) (j : ℕ), c ≠ 0 ∧ a * b' - a' * b ≠ 0 ∧ 1 ≤ j ∧ j ≤ 3 ∧ R = MvPolynomial.C c * (MvPolynomial.C a * MvPolynomial.X 0 + MvPolynomial.C b * MvPolynomial.X 1) ^ j * (MvPolynomial.C a' * MvPolynomial.X 0 + MvPolynomial.C b' * MvPolynomial.X 1) ^ (4 - j);let IntegralQuadraticSquare4 : MvPolynomial (Fin 2) ℤ → Prop := fun R => ∃ c A B C₀ : ℤ, c ≠ 0 ∧ ¬ IsSquare (B ^ 2 - 4 * A * C₀) ∧ ∀ d e : ℤ, MvPolynomial.eval ![d, e] R = c * (A * d ^ 2 + B * d * e + C₀ * e ^ 2) ^ 2;∀ R : MvPolynomial (Fin 2) ℤ, R.IsHomogeneous 4 → R ≠ 0 → ¬ PureComplexFourth R → ThreeProjectiveZeros R ∨ IntegralTwoLinearFactors4 R ∨ IntegralQuadraticSquare4 R) := by
  exact binary_quartic_classification_internal
