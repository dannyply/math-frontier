private theorem raw_moments :
    ∃ Cmom : ℝ, 1 ≤ Cmom ∧
      ∀ D E U V : ℝ, 0 < D → 0 < E → 0 < U → 0 < V →
      ∀ M : ℕ, 1 ≤ M →
        ((D/E)^2/32 ≤ V/U ∧ V/U ≤ 32*(D/E)^2) →
      ∀ P Q : ℕ → Mat,
        (∀ j ∈ cells D E M, col (P j) 0 ≠ 0) →
        (∀ j ∈ cells D E M, col (Q j) 0 ≠ 0) →
        Finset.sum (cells D E M) (fun j => (firstLength D E M P j)^2) ≤
          Cmom*firstMomentScale D E M ∧
        Finset.sum (cells D E M)
            (fun j => (secondLength D E U V M Q j)^2) ≤
          Cmom*secondMomentScale U V M := by
  classical
  have hmom := FormalAB.V3.A5.claim_6e81562a
  dsimp only at hmom
  obtain ⟨C0,hC0,hmom⟩ := hmom
  refine ⟨max 1 C0,le_max_left _ _,?_⟩
  intro D E U V hD hE hU hV M hM hcomp P Q hP hQ
  have hh := hmom D E U V hD hE hU hV M hM hcomp
    (fun j => col (P j) 0) (fun j => col (Q j) 0) hP hQ
  change
    Finset.sum (cells D E M) (fun j => (firstLength D E M P j)^2) ≤
      C0*firstMomentScale D E M ∧
    Finset.sum (cells D E M) (fun j => (secondLength D E U V M Q j)^2) ≤
      C0*secondMomentScale U V M at hh
  have hM1 : (1 : ℝ) ≤ M := by exact_mod_cast hM
  have hlog : 0 ≤ Real.log (M : ℝ) := Real.log_nonneg hM1
  have hscaleL : 0 ≤ firstMomentScale D E M := by
    unfold firstMomentScale
    positivity
  have hscaleT : 0 ≤ secondMomentScale U V M := by
    unfold secondMomentScale
    positivity
  constructor
  · exact hh.1.trans
      (mul_le_mul_of_nonneg_right (le_max_right 1 C0) hscaleL)
  · exact hh.2.trans
      (mul_le_mul_of_nonneg_right (le_max_right 1 C0) hscaleT)
private lemma occupied_square_scales (x D E : ℝ) (M j : ℕ)
    (h : ℤ) (hh : h=1 ∨ h= -1)
    (hx : 1 ≤ x) (hD : 0 < D) (hE : 0 < E)
    (hocc : (originalCell x D E M j h).Nonempty) :
    D^2+E^2 ≤ 12*x := by
  obtain ⟨z,hz⟩ := hocc
  rcases hz.1 with
    ⟨hd,he,hu,hv,hF,hnlo,hnhi,hdlo,hdhi,helo,hehi⟩
  have hu1 : (1 : ℝ) ≤ z.2.1 := by exact_mod_cast hu
  have hv1 : (1 : ℝ) ≤ z.2.2 := by exact_mod_cast hv
  have hnr : (z.1.1 : ℝ)^2*(z.2.1 : ℝ) ≤ x := by
    exact_mod_cast hnhi
  have hFr : (z.1.2 : ℝ)^2*(z.2.2 : ℝ) =
      (z.1.1 : ℝ)^2*(z.2.1 : ℝ)+(h : ℝ) := by
    exact_mod_cast hF
  have hhR : (h : ℝ) ≤ 1 := by
    rcases hh with rfl | rfl <;> norm_num
  have hd2 : (z.1.1 : ℝ)^2 ≤ x := by
    nlinarith [mul_nonneg (sq_nonneg (z.1.1 : ℝ)) (sub_nonneg.mpr hu1)]
  have he2 : (z.1.2 : ℝ)^2 ≤ x+1 := by
    nlinarith [mul_nonneg (sq_nonneg (z.1.2 : ℝ)) (sub_nonneg.mpr hv1)]
  have hDle : D ≤ 2*(z.1.1 : ℝ) := by linarith
  have hEle : E ≤ 2*(z.1.2 : ℝ) := by linarith
  have hDs := pow_le_pow_left₀ hD.le hDle 2
  have hEs := pow_le_pow_left₀ hE.le hEle 2
  nlinarith
private lemma first_axis_dominated (x s m D E : ℝ) (M j : ℕ)
    (h : ℤ) (hh : h=1 ∨ h= -1)
    (hx : 4 ≤ x) (hms : 1 ≤ m+s)
    (hD : 0 < D) (hE : 0 < E) (hM : 1 ≤ M)
    (hMp : x^(m) ≤ (M : ℝ))
    (hocc : (originalCell x D E M j h).Nonempty) :
    (D^2+E^2)/(M : ℝ) ≤ 12*x^s := by
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hM0 : (0 : ℝ) < M := by
    exact_mod_cast (show 0 < M by omega)
  have hexp : 1 ≤ m+s := by linarith
  have hxp : x ≤ (M : ℝ)*x^s := by
    calc
      x = x^(1 : ℝ) := (Real.rpow_one x).symm
      _ ≤ x^(m+s) :=
        Real.rpow_le_rpow_of_exponent_le hx1 hexp
      _ = x^(m)*x^s := Real.rpow_add hx0 _ _
      _ ≤ (M : ℝ)*x^s :=
        mul_le_mul_of_nonneg_right hMp (Real.rpow_nonneg hx0.le _)
  have hscale := occupied_square_scales x D E M j h hh hx1 hD hE hocc
  apply (div_le_iff₀ hM0).mpr
  nlinarith
private lemma logarithmic_price (ε x : ℝ) (M : ℕ)
    (hε : 0 < ε) (hx : 4 ≤ x) (hM : 1 ≤ M)
    (hMx : (M : ℝ) ≤ 2*x) :
    13+Real.log (M : ℝ) ≤
      (13+Real.log 2+1/ε)*x^ε := by
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hM0 : (0 : ℝ) < M := by
    exact_mod_cast (show 0 < M by omega)
  have hlogM : Real.log (M : ℝ) ≤ Real.log 2+Real.log x := by
    have hh := Real.log_le_log hM0 hMx
    rwa [Real.log_mul (by norm_num) hx0.ne'] at hh
  have hlogx : Real.log x ≤ x^ε/ε :=
    Real.log_le_rpow_div hx0.le hε
  have hp : 1 ≤ x^ε := Real.one_le_rpow hx1 hε.le
  have hconst : 0 ≤ (13 : ℝ)+Real.log 2 := by
    have hh : 0 ≤ Real.log (2 : ℝ) := Real.log_nonneg (by norm_num)
    linarith
  have hmul := mul_le_mul_of_nonneg_left hp hconst
  calc
    13+Real.log (M : ℝ) ≤ 13+Real.log 2+x^ε/ε := by linarith
    _ ≤ (13+Real.log 2)*x^ε+x^ε/ε := by linarith
    _ = _ := by ring
private theorem occupied_first_moment
    (Cmom ε x s m D E : ℝ) (M : ℕ) (P : ℕ → Mat)
    (h : ℤ) (hh : h=1 ∨ h= -1)
    (hCmom : 0 ≤ Cmom) (hε : 0 < ε)
    (hx : 4 ≤ x) (hms : 1 ≤ m+s)
    (hD : 0 < D) (hE : 0 < E) (hDE : D*E=x^s)
    (hM : 1 ≤ M) (hMx : (M : ℝ) ≤ 2*x)
    (hMp : x^(m) ≤ (M : ℝ))
    (hraw : Finset.sum (cells D E M)
        (fun j => (firstLength D E M P j)^2) ≤
      Cmom*firstMomentScale D E M) :
    Finset.sum (occupiedCells x D E M h)
        (fun j => (firstLength D E M P j)^2) ≤
      (Cmom*(13+Real.log 2+1/ε))*x^ε*x^s := by
  classical
  let J := occupiedCells x D E M h
  have hx0 : 0 < x := by linarith
  by_cases hJ : J.Nonempty
  · obtain ⟨j,hj⟩ := hJ
    have hocc := ((occupied_mem x D E M j h).mp hj).2
    have haxis := first_axis_dominated x s m D E M j h hh
      hx hms hD hE hM hMp hocc
    have hsub :
        Finset.sum J (fun j => (firstLength D E M P j)^2) ≤
          Finset.sum (cells D E M)
            (fun j => (firstLength D E M P j)^2) := by
      apply Finset.sum_le_sum_of_subset_of_nonneg
        (occupied_subset x D E M h)
      intro j hj hj'
      exact sq_nonneg _
    have hscale : firstMomentScale D E M ≤
        (13+Real.log (M : ℝ))*x^s := by
      unfold firstMomentScale
      rw [hDE]
      nlinarith
    have hprice := logarithmic_price ε x M hε hx hM hMx
    calc
      Finset.sum (occupiedCells x D E M h)
          (fun j => (firstLength D E M P j)^2) ≤
          Cmom*firstMomentScale D E M := hsub.trans hraw
      _ ≤ Cmom*((13+Real.log (M : ℝ))*x^s) :=
        mul_le_mul_of_nonneg_left hscale hCmom
      _ ≤ Cmom*(((13+Real.log 2+1/ε)*x^ε)*x^s) :=
        mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_right hprice (Real.rpow_nonneg hx0.le _)) hCmom
      _ = _ := by ring
  · have hJe : J=∅ := Finset.not_nonempty_iff_eq_empty.mp hJ
    change Finset.sum J _ ≤ _
    rw [hJe,Finset.sum_empty]
    have hlog2 : 0 ≤ Real.log (2 : ℝ) := Real.log_nonneg (by norm_num)
    positivity
private lemma powers (x : ℝ) (hx : 0 ≤ x) (n : ℕ) (a : ℝ) :
