    rw [he,mul_zero] at hgk
    exact hg hgk
  have hdegk : k.natDegree = 0 := by
    have he := Polynomial.natDegree_mul hp.ne_zero hk
    rw [←hgk,hdegp,hdegg] at he
    omega
  have hkeq : k = Polynomial.C (k.coeff 0) :=
    Polynomial.eq_C_of_natDegree_eq_zero hdegk
  have hc : k.coeff 0 ≠ 0 := by
    intro he
    rw [hkeq,he,Polynomial.C_0] at hk
    exact hk rfl
  refine ⟨p,hp,hdegp,k.coeff 0,hc,?_⟩
  calc
    f = p * g := hfg
    _ = p * (p * k) := by rw [hgk]
    _ = Polynomial.C (k.coeff 0) * p ^ 2 := by
      conv_lhs => rw [hkeq]
      ring
private theorem primitive_integer_quadratic_normalization
    (p : Polynomial ℚ) (hp : p ≠ 0) (hd : p.natDegree = 2) :
    ∃ F : Polynomial ℤ, F.IsPrimitive ∧ F.natDegree = 2 ∧
      ∃ k : ℚ, k ≠ 0 ∧
        F.map (Int.castRingHom ℚ) = Polynomial.C k * p := by
  obtain ⟨b,hbM,hb⟩ := IsLocalization.integerNormalization_spec
    (nonZeroDivisors ℤ) p
  let f := IsLocalization.integerNormalization (nonZeroDivisors ℤ) p
  have hbne : b ≠ 0 := nonZeroDivisors.ne_zero hbM
  have hb0 : (b : ℚ) ≠ 0 := by exact_mod_cast hbne
  have hfmap : f.map (Int.castRingHom ℚ) = Polynomial.C (b : ℚ) * p := by
    rw [← algebraMap_int_eq, hb, ← Int.cast_smul_eq_zsmul ℚ, Polynomial.smul_eq_C_mul]
  have hCb : (Polynomial.C (b : ℚ)) ≠ 0 := by simpa using hb0
  have hf : f ≠ 0 := by
    intro h
    rw [h, Polynomial.map_zero] at hfmap
    exact (mul_ne_zero hCb hp) hfmap.symm
  have hprim : f.primPart.IsPrimitive := Polynomial.isPrimitive_primPart f
  have hc : f.content ≠ 0 := by rwa [Ne, Polynomial.content_eq_zero_iff]
  have hcQ : (f.content : ℚ) ≠ 0 := by exact_mod_cast hc
  have hCc : (Polynomial.C (f.content : ℚ) : Polynomial ℚ) ≠ 0 := by
    simpa using hcQ
  have he : Polynomial.C (f.content : ℚ) *
      f.primPart.map (Int.castRingHom ℚ) = Polynomial.C (b : ℚ) * p := by
    rw [← hfmap]
    conv_rhs => rw [Polynomial.eq_C_content_mul_primPart f]
    rw [Polynomial.map_mul, Polynomial.map_C]
    simp
  have hscalar : (f.content : ℚ) * ((b : ℚ) / (f.content : ℚ)) = (b : ℚ) := by
    field_simp
  have hmap : f.primPart.map (Int.castRingHom ℚ) =
      Polynomial.C ((b : ℚ) / (f.content : ℚ)) * p := by
    apply mul_left_cancel₀ hCc
    rw [he, ← mul_assoc, ← map_mul, hscalar]
  have hk : ((b : ℚ) / (f.content : ℚ)) ≠ 0 := div_ne_zero hb0 hcQ
  have hCk : (Polynomial.C ((b : ℚ) / (f.content : ℚ)) : Polynomial ℚ) ≠ 0 := by
    simpa using hk
  have hdegree : f.primPart.natDegree = 2 := by
    calc
      f.primPart.natDegree =
          (f.primPart.map (Int.castRingHom ℚ)).natDegree :=
        (Polynomial.natDegree_map_eq_of_injective (RingHom.injective_int _) _).symm
      _ = 2 := by
        rw [hmap, Polynomial.natDegree_mul hCk hp, Polynomial.natDegree_C]
        simpa only [zero_add] using hd
  exact ⟨f.primPart,hprim,hdegree,
    (b : ℚ) / (f.content : ℚ),hk,hmap⟩
private theorem integral_square_descent
    (f : Polynomial ℤ) (hf : f ≠ 0) (hdegf : f.natDegree = 4)
    (p : Polynomial ℚ) (hp : p ≠ 0) (hdegp : p.natDegree = 2)
    (cQ : ℚ) (hcQ : cQ ≠ 0)
    (hfQ : f.map (Int.castRingHom ℚ) = Polynomial.C cQ * p ^ 2) :
    ∃ c : ℤ, c ≠ 0 ∧ ∃ F : Polynomial ℤ,
      F.IsPrimitive ∧ F.natDegree = 2 ∧ f = Polynomial.C c * F ^ 2 := by
  classical
  obtain ⟨F,hFprim,hFdeg,k,hk,hFQ⟩ :=
    primitive_integer_quadratic_normalization p hp hdegp
  have hFC : (Polynomial.C k : Polynomial ℚ) ≠ 0 := by simpa using hk
  have hFQ0 : F.map (Int.castRingHom ℚ) ≠ 0 := by
    rw [hFQ]
    exact mul_ne_zero hFC hp
  have hF0 : F ≠ 0 := by
    intro he
    rw [he,Polynomial.map_zero] at hFQ0
    exact hFQ0 rfl
  have hscalar : k * (cQ / k) = cQ := by field_simp [hk]
  have hFdivQ : F.map (Int.castRingHom ℚ) ∣
      f.map (Int.castRingHom ℚ) := by
    refine ⟨Polynomial.C (cQ / k) * p, ?_⟩
    calc
      f.map (Int.castRingHom ℚ) = Polynomial.C cQ * p ^ 2 := hfQ
      _ = Polynomial.C (k * (cQ / k)) * p ^ 2 := by rw [hscalar]
      _ = F.map (Int.castRingHom ℚ) * (Polynomial.C (cQ / k) * p) := by
        rw [hFQ]
        simp only [map_mul]
        ring
  have hFdiv : F ∣ f := by
    rw [Polynomial.IsPrimitive.Int.dvd_iff_map_cast_dvd_map_cast F f hFprim]
    exact hFdivQ
  obtain ⟨g,hfg⟩ := hFdiv
  have hg : g ≠ 0 := by
    intro he
    rw [he,mul_zero] at hfg
    exact hf hfg
  have hmapfg : F.map (Int.castRingHom ℚ) *
      g.map (Int.castRingHom ℚ) =
      Polynomial.C cQ * p ^ 2 := by
    rw [←Polynomial.map_mul,←hfg,hfQ]
  have hscalar2 : k ^ 2 * (cQ / k ^ 2) = cQ := by
    have hk2 : k ^ 2 ≠ 0 := pow_ne_zero 2 hk
    field_simp [hk2]
  have hmapg : g.map (Int.castRingHom ℚ) =
      Polynomial.C (cQ / k ^ 2) * F.map (Int.castRingHom ℚ) := by
    apply mul_left_cancel₀ hFQ0
    rw [hmapfg,hFQ]
    calc
      Polynomial.C cQ * p ^ 2 = Polynomial.C (k ^ 2 * (cQ / k ^ 2)) * p ^ 2 := by rw [hscalar2]
      _ = (Polynomial.C k * p) * (Polynomial.C (cQ / k ^ 2) * (Polynomial.C k * p)) := by
        simp only [pow_two, map_mul]
        ring
  have hFdivgQ : F.map (Int.castRingHom ℚ) ∣
      g.map (Int.castRingHom ℚ) := by
    refine ⟨Polynomial.C (cQ / k ^ 2), ?_⟩
    rw [hmapg]
    ring
  have hFdivg : F ∣ g := by
    rw [Polynomial.IsPrimitive.Int.dvd_iff_map_cast_dvd_map_cast F g hFprim]
    exact hFdivgQ
  obtain ⟨h,hgh⟩ := hFdivg
  have hh : h ≠ 0 := by
    intro he
    rw [he,mul_zero] at hgh
    exact hg hgh
  have hdegg : g.natDegree = 2 := by
    have he := Polynomial.natDegree_mul hF0 hg
    rw [←hfg,hFdeg,hdegf] at he
    omega
  have hdegh : h.natDegree = 0 := by
    have he := Polynomial.natDegree_mul hF0 hh
    rw [←hgh,hFdeg,hdegg] at he
    omega
  have hheq : h = Polynomial.C (h.coeff 0) :=
    Polynomial.eq_C_of_natDegree_eq_zero hdegh
  have hc : h.coeff 0 ≠ 0 := by
    intro he
    rw [hheq,he,Polynomial.C_0] at hh
    exact hh rfl
  refine ⟨h.coeff 0,hc,F,hFprim,hFdeg,?_⟩
  calc
    f = F * g := hfg
    _ = F * (F * h) := by rw [hgh]
    _ = Polynomial.C (h.coeff 0) * F ^ 2 := by
      conv_lhs => rw [hheq]
      ring
