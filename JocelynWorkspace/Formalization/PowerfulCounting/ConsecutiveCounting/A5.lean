  let U : ℝ := 4*x/D^2;
  let V : ℝ := 8*x/E^2;
  (P.det=1 ∨ P.det= -1) ∧
  (Q.det=1 ∨ Q.det= -1) ∧
  (A.det=1 ∨ A.det= -1) ∧
  (B.det=1 ∨ B.det= -1) ∧
  A*P=1 ∧ P*A=1 ∧ B*Q=1 ∧ Q*B=1 ∧
  col P 0 ≠ 0 ∧ col Q 0 ≠ 0 ∧
  reduced ((M : ℝ)/(4*D)) (rho D E M j) (2*E) P ∧
  reduced ((M : ℝ)/(32*V)) ((rho D E M j)^2) (2*U) Q ∧
  let L1 := sideLength ((M : ℝ)/(4*D)) (rho D E M j) (2*E) P 0;
  let L2 := sideLength ((M : ℝ)/(4*D)) (rho D E M j) (2*E) P 1;
  let T1 := sideLength ((M : ℝ)/(32*V)) ((rho D E M j)^2) (2*U) Q 0;
  let T2 := sideLength ((M : ℝ)/(32*V)) ((rho D E M j)^2) (2*U) Q 1;
  0 < L2 ∧ L2 ≤ L1 ∧ 0 < T2 ∧ T2 ≤ T1 ∧
    16*D*E/(M : ℝ) ≤ L1*L2 ∧
    L1*L2 ≤ 32*D*E/(M : ℝ) ∧
    128*U*V/(M : ℝ) ≤ T1*T2 ∧
    T1*T2 ≤ 256*U*V/(M : ℝ) ∧
    (∀ h : ℤ, (h=1 ∨ h= -1) →
      ∀ z ∈ originalCell x D E M j h,
        nsq ((M : ℝ)/(4*D)) (rho D E M j) (2*E)
          ((z.1.1 : ℤ),(z.1.2 : ℤ)) ≤ 1 ∧
        nsq ((M : ℝ)/(32*V)) ((rho D E M j)^2) (2*U)
          ((z.2.2 : ℤ),(z.2.1 : ℤ)) ≤ 1 ∧
        originalPositiveBox A B L1 L2 T1 T2 h z) ∧
    ((∃ h : ℤ, (h=1 ∨ h= -1) ∧
        (originalCell x D E M j h).Nonempty) →
      ∀ i k : Fin 2,
        |((P i k : ℤ) : ℝ)| ≤ x^Kg ∧
        |((Q i k : ℤ) : ℝ)| ≤ x^Kg ∧
        |((A i k : ℤ) : ℝ)| ≤ x^Kg ∧
        |((B i k : ℤ) : ℝ)| ≤ x^Kg)
def factorCase (G : Poly) (a b : ℕ) : Prop :=
  (b=0 ∧ 2 ≤ a ∧
    ∀ w : Fin 4 → ℤ, MvPolynomial.eval w G=0 →
      w 0=0 ∧ w 1=0) ∨
  (a=0 ∧ 2 ≤ b ∧
    ∀ w : Fin 4 → ℤ, MvPolynomial.eval w G=0 →
      w 2=0 ∧ w 3=0) ∨
  ((a,b)=(1,0) ∧ ∃ p r : ℤ, (p,r) ≠ (0,0) ∧
    G=MvPolynomial.C p*MvPolynomial.X 0+
      MvPolynomial.C r*MvPolynomial.X 1) ∨
  ((a,b)=(0,1) ∧ ∃ p r : ℤ, (p,r) ≠ (0,0) ∧
    G=MvPolynomial.C p*MvPolynomial.X 2+
      MvPolynomial.C r*MvPolynomial.X 3) ∨
  (1 ≤ a ∧ 1 ≤ b ∧ min a b=1 ∧
    Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G)) ∨
  (2 ≤ a ∧ 2 ≤ b ∧
    Irreducible (MvPolynomial.map (Int.castRingHom ℚ) G))
def CoverAt (x D E : ℝ) (M j q b : ℕ) (K : ℝ)
    (F : Poly) (k : ℕ) (Gs : Fin k → Poly)
    (dg : Fin k → ℕ × ℕ) : Prop :=
  F ≠ 0 ∧
  (∀ m ∈ F.support, m 0+m 1=q ∧ m 2+m 3=b) ∧
  F.totalDegree ≤ q+b ∧
  (∀ m : Fin 4 →₀ ℕ, |((F.coeff m : ℤ) : ℝ)| ≤ x^K) ∧
  k ≤ 2*q ∧
  (∀ i, Gs i ∣ F) ∧
  (∀ i, Irreducible (Gs i)) ∧
  (∀ i, ∀ m ∈ (Gs i).support,
    m 0+m 1=(dg i).1 ∧ m 2+m 3=(dg i).2) ∧
  (∀ i, (dg i).1 ≤ q ∧ (dg i).2 ≤ b) ∧
  (∀ z ∈ originalCell x D E M j 1,
    ∃ i : Fin k,
      MvPolynomial.eval
        ![(z.1.1 : ℤ),(z.1.2 : ℤ),(z.2.1 : ℤ),(z.2.2 : ℤ)] (Gs i)=0) ∧
  (∀ i, ∀ m : Fin 4 →₀ ℕ,
    |(((Gs i).coeff m : ℤ) : ℝ)| ≤ x^(K+1)) ∧
  (∀ i, factorCase (Gs i) (dg i).1 (dg i).2)
def highMixed (a b : ℕ) : Prop :=
  1 ≤ a ∧ 1 ≤ b ∧ 6 ≤ a+2*b
def highPopulation (x D E : ℝ) (M j k : ℕ)
    (Gs : Fin k → Poly) (dg : Fin k → ℕ × ℕ) : Set Point :=
  {z | z ∈ originalCell x D E M j 1 ∧
    ∃ i : Fin k, highMixed (dg i).1 (dg i).2 ∧
      MvPolynomial.eval
        ![(z.1.1 : ℤ),(z.1.2 : ℤ),(z.2.1 : ℤ),(z.2.2 : ℤ)] (Gs i)=0}
def CCDNAt6 (c : ℝ) : Prop :=
  ∀ d : ℕ, 1 ≤ d →
    ∀ I : Ideal (MvPolynomial (Fin 6) ℚ), I.IsPrime →
      ringKrullDim (MvPolynomial (Fin 6) ℚ ⧸ I)=1 →
      (∃ e : ℤ, ∃ s0 : ℕ, ∀ s : ℕ, s0 ≤ s →
        (Module.finrank ℚ
          (Submodule.map (Ideal.Quotient.mkₐ ℚ I).toLinearMap
            (MvPolynomial.restrictTotalDegree (Fin 6) ℚ s)) : ℤ)=
              (d : ℤ)*(s : ℤ)+e) →
      ∀ H : ℝ, 1 ≤ H →
        (({p : Fin 6 → ℤ |
          (∀ f ∈ I, MvPolynomial.eval (fun i => (p i : ℚ)) f=0) ∧
          ∀ i, |(p i : ℝ)| ≤ H} : Set (Fin 6 → ℤ)).ncard : ℝ) ≤
            c*(d : ℝ)^3*H^(1/(d : ℝ))*(Real.log H+(d : ℝ))
def Statement : Prop :=
  ∀ δ : ℝ, 0 < δ → δ ≤ (1/2000 : ℝ) →
    ∃ q : ℕ, ∃ K Kg X0 : ℝ,
      1 ≤ q ∧ 5/δ ≤ (q : ℝ) ∧ 0 < K ∧ 0 < Kg ∧ 4 ≤ X0 ∧
      ∀ c : ℝ, CCDNAt6 c →
        ∀ ε : ℝ, 0 < ε →
          ∃ C : ℝ, 1 ≤ C ∧
            ∀ x : ℝ, X0 ≤ x →
            ∀ s : ℝ, (599/1000 : ℝ) ≤ s → s ≤ (5/8 : ℝ) →
            ∀ D E : ℝ, 0 < D → 0 < E → D*E=x^s →
            let b : ℕ := degreeB q s;
            let M : ℕ := ⌈x^(mStar s+δ)⌉₊;
            let U : ℝ := 4*x/D^2;
            let V : ℝ := 8*x/E^2;
            1 ≤ b ∧ b ≤ q ∧
            1 ≤ M ∧ (M : ℝ) ≤ 2*x ∧ 0 < U ∧ 0 < V ∧
            ((D/E)^2/32 ≤ V/U ∧ V/U ≤ 32*(D/E)^2) ∧
            (∀ h : ℤ, (h=1 ∨ h= -1) →
              ∀ z ∈ originalShell x D E h,
                ∃ j ∈ cells D E M, z ∈ originalCell x D E M j h) ∧
            ∃ P Q A B : ℕ → Mat,
              (∀ j ∈ cells D E M,
                GeometryAt x D E M j Kg (P j) (Q j) (A j) (B j)) ∧
              ∀ j ∈ cells D E M,
                ∃ F : Poly, ∃ k : ℕ,
                ∃ Gs : Fin k → Poly, ∃ dg : Fin k → ℕ × ℕ,
                  CoverAt x D E M j q b K F k Gs dg ∧
                  let L1 := sideLength ((M : ℝ)/(4*D))
                    (rho D E M j) (2*E) (P j) 0;
                  let T1 := sideLength ((M : ℝ)/(32*V))
                    ((rho D E M j)^2) (2*U) (Q j) 0;
                  let S := highPopulation x D E M j k Gs dg;
                  S.Finite ∧ (S.ncard : ℝ) ≤
                    C*x^ε*(1+(L1^2*T1)^((1 : ℝ)/6))
end A5ActualOriginalHighFamilyType
