  obtain ⟨Cq,hCq,hquad⟩ :=
    JocelynClaims.claim_c11d2040a946c0ca0cb49022ffee26b2014bdfeea084fcf80ddebfd185282010
      K' (ε/2) (by linarith)
  let Cbound : ℝ := 2*Cd*Cq
  have hCbound : 0 < Cbound := by dsimp [Cbound]; positivity
  refine ⟨Cbound,hCbound,?_⟩
  intro x hx G hG hCirr hHeight h hsign cR A B C₀ hcR hdisc hid
  obtain ⟨hA,hB,hC,N,hNpos,hNbound,hpoint,huniq⟩ :=
    hcover x hx G hG hCirr hHeight h hsign
      cR A B C₀ hcR hdisc hid
  let S := OriginalPositivePopulation G h x
  let Menu : Finset ℤ := signedDivisors (N:ℤ)
  let Level (m : ℤ) : Set (ℤ×ℤ) :=
    {p | Int.gcd p.1 p.2=1 ∧
      |(p.1:ℝ)|≤x^K' ∧ |(p.2:ℝ)|≤x^K' ∧
      QuadraticValue A B C₀ p.1 p.2=m}
  have hMenuDiv : ∀ m∈Menu, m.natAbs ∣ N := by
    intro m hm
    exact signed_divisor_natAbs_dvd N m hm
  have hMenuNe : ∀ m∈Menu, m ≠ 0 := by
    intro m hm hz
    subst m
    have hh := hMenuDiv 0 hm
