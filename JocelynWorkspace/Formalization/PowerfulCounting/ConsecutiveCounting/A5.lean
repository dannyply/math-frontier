  have hBA : |(b : ℝ)| * |(A : ℝ)| ≤ H * H :=
    mul_le_mul hb hA (abs_nonneg (A : ℝ)) hHnonneg
  have htriangle : |(a : ℝ) * (B : ℝ) - (b : ℝ) * (A : ℝ)| ≤
      |(a : ℝ)| * |(B : ℝ)| + |(b : ℝ)| * |(A : ℝ)| := by
    have hn : |(-((b : ℝ) * (A : ℝ)))| = |(b : ℝ) * (A : ℝ)| := abs_neg _
    have hh := abs_add_le ((a : ℝ) * (B : ℝ)) (-((b : ℝ) * (A : ℝ)))
    rw [hn] at hh
    have hs : |(a : ℝ) * (B : ℝ) - (b : ℝ) * (A : ℝ)| ≤
