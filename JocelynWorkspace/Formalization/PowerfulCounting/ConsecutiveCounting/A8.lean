theorem projective_eq_of_det_zero
    (p q : Projectivization ℂ (Fin 2 → ℂ))
    (hdet : p.rep 0 * q.rep 1 - q.rep 0 * p.rep 1 = 0) : p = q := by
  rw [← Projectivization.mk_rep p, ← Projectivization.mk_rep q]
  apply (Projectivization.mk_eq_mk_iff' ℂ _ _ _ _).mpr
  by_cases hq0 : q.rep 0 = 0
  · have hq1 : q.rep 1 ≠ 0 := by
      intro h1
      apply q.rep_nonzero
      ext i
      fin_cases i <;> simp_all
    refine ⟨p.rep 1 / q.rep 1, ?_⟩
    ext i
    fin_cases i
    · simp only [Pi.smul_apply, smul_eq_mul]
      have hp0 : p.rep 0 = 0 := by
        have hh : p.rep 0 * q.rep 1 = 0 := by simpa [hq0] using hdet
        exact (mul_eq_zero.mp hh).resolve_right hq1
      simp [hq0,hp0]
    · simp only [Pi.smul_apply, smul_eq_mul]
      exact div_mul_cancel₀ _ hq1
  · refine ⟨p.rep 0 / q.rep 0, ?_⟩
    ext i
    fin_cases i
    · simp only [Pi.smul_apply, smul_eq_mul]
      exact div_mul_cancel₀ _ hq0
    · simp only [Pi.smul_apply, smul_eq_mul]
      rw [div_mul_eq_mul_div]
      apply (div_eq_iff hq0).mpr
      change p.rep 0*q.rep 1=p.rep 1*q.rep 0
      linear_combination hdet

theorem pure_projective_zero_unique (n : ℕ) (hn : n ≠ 0)
    (R : MvPolynomial (Fin 2) ℤ)
    (hpure : A6A8OddClassification.PureComplexPower n R)
    (p q : Projectivization ℂ (Fin 2 → ℂ))
    (hp : eval p.rep (R.map (Int.castRingHom ℂ)) = 0)
    (hq : eval q.rep (R.map (Int.castRingHom ℂ)) = 0) : p = q := by
  obtain ⟨γ,α,β,hγ,hαβ,hval⟩ := hpure
  have hker : ∀ z : Projectivization ℂ (Fin 2 → ℂ),
      eval z.rep (R.map (Int.castRingHom ℂ)) = 0 →
      α*z.rep 0+β*z.rep 1=0 := by
    intro z hz
    have hv : z.rep = ![z.rep 0,z.rep 1] := by
      ext i
      fin_cases i <;> rfl
    rw [hv,hval] at hz
    exact (pow_eq_zero_iff hn).mp ((mul_eq_zero.mp hz).resolve_left hγ)
  have hp' := hker p hp
  have hq' := hker q hq
  apply projective_eq_of_det_zero
  rcases hαβ with ha | hb
  · have ht : α*(p.rep 0*q.rep 1-q.rep 0*p.rep 1)=0 := by
      linear_combination q.rep 1*hp' - p.rep 1*hq'
    exact (mul_eq_zero.mp ht).resolve_left ha
  · have ht : β*(p.rep 0*q.rep 1-q.rep 0*p.rep 1)=0 := by
      linear_combination p.rep 0*hq' - q.rep 0*hp'
    exact (mul_eq_zero.mp ht).resolve_left hb

theorem pure_integer_label_power (n : ℕ) (hnodd : Odd n) (hn : 0<n)
    (R : MvPolynomial (Fin 2) ℤ) (hR : R.IsHomogeneous n)
    (hR0 : R≠0) (hpure : A6A8OddClassification.PureComplexPower n R) :
    ∃ c : ℤ, c≠0 ∧ ∃ a : Option ℚ, R=MvPolynomial.C c*labelLine a^n := by
  have hthree : ¬ HasThreeProjectiveZeros R := by
    rintro ⟨p,q,r,hpq,hpr,hqr,hp,hq,hr⟩
    exact hpq (pure_projective_zero_unique n (by omega) R hpure p q hp hq)
  obtain ⟨c,hc,labels,hcard,hfac⟩ :=
    A6A8OddClassification.binary_integer_linear_factorization n hnodd R hR hR0 hthree
  obtain ⟨a,ha⟩ := multiset_has_member labels (by omega)
  have hinj : Function.Injective (fun z : Option ℚ =>
      projectivePoint (labelToComplex z)) :=
    projectivePoint_injective.comp labelToComplex_injective
  have hzero := A6A8OddClassification.factored_label_projective_zero n R hR c labels hfac
  have hone : ∀z∈labels,z=a := by
    intro z hz
    apply hinj
    exact pure_projective_zero_unique n (by omega) R hpure _ _ (hzero z hz) (hzero a ha)
  refine ⟨c,hc,a,?_⟩
  rw [hfac,label_product_eq_pow labels a hone,hcard]

theorem label_bezout (z : Option ℚ) :
    ∃ A B : ℤ, A*lineCoeffA z+B*lineCoeffB z=1 := by
  cases z with
  | none => exact ⟨0,1,by norm_num [lineCoeffA,lineCoeffB]⟩
  | some r =>
    let a := (rationalLinear r).coeff 1
    let b := (rationalLinear r).coeff 0
    let g : ℤ := Int.gcd a b
    obtain ⟨u,hu⟩ := Int.gcd_dvd_left a b
    obtain ⟨v,hv⟩ := Int.gcd_dvd_right a b
    have hd : Polynomial.C g ∣ rationalLinear r := by
      refine ⟨Polynomial.C u*Polynomial.X+Polynomial.C v,?_⟩
      rw [rationalLinear_form]
      change Polynomial.C a*Polynomial.X+Polynomial.C b=_
      have hpa : Polynomial.C a=Polynomial.C g*Polynomial.C u := by
        rw [← Polynomial.C_mul]
        exact congrArg Polynomial.C hu
      have hpb : Polynomial.C b=Polynomial.C g*Polynomial.C v := by
        rw [← Polynomial.C_mul]
        exact congrArg Polynomial.C hv
      rw [hpa,hpb]
      ring
    have hunit : IsUnit g := (rationalLinear_spec r).1 g hd
    obtain ⟨t,ht⟩ := isUnit_iff_dvd_one.mp hunit
    refine ⟨a.gcdA b*t,a.gcdB b*t,?_⟩
    change a.gcdA b*t*a+a.gcdB b*t*b=1
    have hg := Int.gcd_eq_gcd_ab a b
    change g=a*a.gcdA b+b*a.gcdB b at hg
    linear_combination -t*hg-ht

end
end A8Pure51

