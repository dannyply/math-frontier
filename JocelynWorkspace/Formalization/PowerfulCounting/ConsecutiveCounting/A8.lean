          simpa [bO] using congrFun vR ⟨k,Nat.lt_succ_self k⟩
        rw [←h1] at fB
        exact da (u5 k hb) fB
      · have vG:z 3*(ag A z 0)^k=w 3*(ag A w 0)^k:=by
          simpa [bO] using congrFun vR ⟨0,Nat.zero_lt_succ k⟩
        rw [←h0] at vG
