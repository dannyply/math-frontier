variable {K:Type*} [Field K] [Algebra ℚ K]
lemma po (k:ℕ) (_g:wC) (d e t:K):
    (ao.eta d e t).toRingHom.comp (ah.au k)= eval₂Hom (algebraMap ℚ K) ![d,e,e^k-t,d^k]:=by
  apply bE
  · intro c
    have heq:((ao.eta d e t).toRingHom.comp (ah.au k)).comp C= (eval₂Hom (algebraMap ℚ K) ![d,e,e^k-t,d^k]).comp C:= Subsingleton.elim _ _
    exact congrArg (fun f:ℚ→+*K=> f c) heq
  · intro i
    fin_cases i<;> simp [ao.eta,ah.au,aeval_def]
lemma pp (k:ℕ) (g:wC) (alpha beta:ℕ)
    (hg:∀ m∈ g.support,m 0+m 1=alpha∧ m 2+m 3=beta)
    (d e u v:K) (hv:v ≠ 0) (vI:wR d e u v g=0):
    ao.eta d e ((e^k*v-d^k*u)/v) (ah.au k g)=0:=by
  let t:=(e^k*v-d^k*u)/v
  have hmap:∀ m∈(uJ (algebraMap ℚ K) g).support,m 0+m 1=alpha∧ m 2+m 3=beta:=by
    intro m hm
    exact hg m (support_map_subset _ _ hm)
  have hs:=j6 (uJ (algebraMap ℚ K) g) alpha beta hmap
    d e u v 1 (d^k/v)
  have hvv:d^k/v*v=d^k:=div_mul_cancel₀ _ hv
  have htu:d^k/v*u=e^k-t:=by dsimp [t];field_simp [hv]; ring
  simp only [one_mul,one_pow,hvv,htu] at hs
  change eval₂ (RingHom.id K) _ (uJ (algebraMap ℚ K) g)= (d^k/v)^beta*eval₂ (RingHom.id K) _ (uJ (algebraMap ℚ K) g) at hs
  simp only [eval₂_map,RingHom.id_comp] at hs
  have pq:eval₂ (algebraMap ℚ K) ![d,e,u,v] g=0:=vI
  rw [pq,mul_zero] at hs
  have heq:=congrArg (fun f:wC→+*K=> f g) (po k g d e t)
  change ao.eta d e t (ah.au k g)= eval₂ (algebraMap ℚ K) ![d,e,e^k-t,d^k] g at heq
  exact heq.trans hs
lemma pr (k:ℕ) (g:wC) (alpha beta:ℕ)
    (hg:∀ m∈ g.support,m 0+m 1=alpha∧ m 2+m 3=beta)
    (H0:wG) (nu:ℕ)
    (hH:ah.au k g=X 0^nu*H0)
    (d e u v:K) (hd:d ≠ 0) (hv:v ≠ 0)
    (vI:wR d e u v g=0):
    ao.eta d e ((e^k*v-d^k*u)/v) H0=0:=by
  have hz:=pp k g alpha beta hg d e u v hv vI
  rw [hH,map_mul,map_pow] at hz
  have hx:ao.eta d e ((e^k*v-d^k*u)/v) (X 0)=d:=by
    simp [ao.eta]
  rw [hx] at hz
  exact (mul_eq_zero.mp hz).resolve_left (u5 _ hd)
end
