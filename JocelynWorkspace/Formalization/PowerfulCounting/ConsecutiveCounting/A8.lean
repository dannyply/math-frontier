lemma kv
    (F L:ℝ) (hF:0≤ F) (hL:0≤ L) (e:ℕ) (D:ℝ) (hD:0≤ D)
    (ε:ℝ) (hε:0< ε):
    ∃ C:ℝ,0< C∧∀ x:ℝ,2≤ x→ ∀ B:ℤ,B ≠ 0→ |(B:ℝ)|≤ F*x^L→ D*(B.natAbs.divisors.card:ℝ)^e≤ C*x^ε:=by
  let δ:ℝ:=ε/(L*e+1)
  have hden:0< L*e+1:=by positivity
  have hδ:0< δ:=div_pos hε hden
  have hδeq:δ*(L*e+1)=ε:=div_mul_cancel₀ ε (ne_of_gt hden)
  have hexp:L*((e:ℝ)*δ)≤ ε:=by nlinarith
  obtain ⟨Cd,hCd,hdb⟩:=C01.PcLowdegRed.divisor_bound δ hδ
  have hFd:0≤ F^((e:ℝ)*δ):=uY hF _
  have hCd0:0≤ Cd:=by linarith
  have h0:0≤ D*Cd^e*F^((e:ℝ)*δ):= aw (aw hD (aY hCd0 e)) hFd
  refine ⟨D*Cd^e*F^((e:ℝ)*δ)+1,by linarith,?_⟩
  intro x hx B hB hBb
  have hx0:0< x:=by linarith
  have hx1:1≤ x:=by linarith
  have bs:(B.natAbs:ℝ)= |(B:ℝ)|:=by
    rw [← Int.cast_natCast,Int.natCast_natAbs,Int.cast_abs]
  have hD1:(B.natAbs.divisors.card:ℝ)≤ Cd* |(B:ℝ)| ^δ:=by
    have ht:=hdb B.natAbs (Int.natAbs_ne_zero.mpr hB)
    rwa [bs] at ht
  have hDe:(B.natAbs.divisors.card:ℝ)^e≤ Cd^e* |(B:ℝ)| ^((e:ℝ)*δ):=by
    calc
      (B.natAbs.divisors.card:ℝ)^e≤(Cd* |(B:ℝ)| ^δ)^e:= aW (a2 _) hD1 _
      _=Cd^e* |(B:ℝ)| ^((e:ℝ)*δ):=by
        rw [mul_pow]
        congr 1
        rw [← aN,← aQ (abs_nonneg _)]
        congr 1
        ring
  have ii:|(B:ℝ)| ^((e:ℝ)*δ)≤ F^((e:ℝ)*δ)*x^ε:=by
    calc
      |(B:ℝ)| ^((e:ℝ)*δ)≤(F*x^L)^((e:ℝ)*δ):= cB (abs_nonneg _) hBb (by positivity)
      _=F^((e:ℝ)*δ)*(x^L)^((e:ℝ)*δ):= cE hF (uY hx0.le _)
      _=F^((e:ℝ)*δ)*x^(L*((e:ℝ)*δ)):=by
        rw [← aQ hx0.le]
      _≤ F^((e:ℝ)*δ)*x^ε:= ad
          (u0 hx1 hexp) hFd
  calc
    D*(B.natAbs.divisors.card:ℝ)^e≤ D*(Cd^e* |(B:ℝ)| ^((e:ℝ)*δ)):= ad hDe hD
    _≤ D*(Cd^e*(F^((e:ℝ)*δ)*x^ε)):= ad
        (ad ii (aY hCd0 _)) hD
    _=(D*Cd^e*F^((e:ℝ)*δ))*x^ε:=by ring
    _≤(D*Cd^e*F^((e:ℝ)*δ)+1)*x^ε:=by
      apply uH _ (uY hx0.le _)
      linarith
lemma kw (x K:ℝ) (hx:2≤ x) (hK:0≤ K) (α N:ℕ) (hαN:α≤ N):
    (x^K)^(4*α)≤ x^(4*(N:ℝ)*K):=by
  have hx0:0< x:=by linarith
  have hx1:1≤ x:=by linarith
  have hH:1≤ x^K:=cc hx1 hK
