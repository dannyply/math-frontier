      algebraMap R (Localization.Away d) p):H∣ p:=by
  obtain ⟨q,hq⟩:=h
  obtain ⟨⟨r,s⟩,hs⟩:=IsLocalization.surj (Submonoid.powers d) q
  obtain ⟨n,hn⟩:=s.property
  have hi:uX (algebraMap R (Localization.Away d)):= IsLocalization.injective (Localization.Away d)
      (powers_le_nonZeroDivisors_of_noZeroDivisors hd.ne_zero)
  have hdiv:H∣ d^n*p:=by
    refine ⟨r,hi ?_⟩
    simp only [map_mul,map_pow]
    rw [hq]
    have hs':q*(algebraMap R (Localization.Away d) d)^n= algebraMap R (Localization.Away d) r:=by
      simpa only [←hn,map_pow] using hs
    calc
      _=algebraMap R (Localization.Away d) H* (q*(algebraMap R (Localization.Away d) d)^n):=by ring
      _=_:=by rw [hs']
  exact pe d H p hd hH n hdiv
abbrev wG:=ah.wG
abbrev wC:=ah.wC
abbrev Away:=Localization.Away (X (0:Fin 3):wG)
def am:wG→+*Away:=algebraMap wG Away
def x (i:Fin 3):Away:=am (X i)
def di:Away:=IsLocalization.Away.invSelf (X (0:Fin 3):wG)
def sub (k:ℕ):wG→+*wG:= eval₂Hom C ![X 0,X 1,X 1^k-X 0^k*X 2]
def down (k:ℕ):wG→+*Away:= eval₂Hom (am.comp C) ![x 0,x 1,(x 1^k-x 2)*di^k]
lemma x_di:x 0*di=1:= IsLocalization.Away.mul_invSelf (X (0:Fin 3):wG)
lemma pg (k:ℕ):(down k).comp (sub k)=am:=by
  apply bE
  · intro c
    have heq:((down k).comp (sub k)).comp C=am.comp C:=Subsingleton.elim _ _
    exact congrArg (fun f:ℚ→+*Away=> f c) heq
  · intro i
    fin_cases i
    · simp [down,sub,x]
    · simp [down,sub,x]
    · simp [RingHom.comp_apply,sub,down]
      change x 1^k-x 0^k*((x 1^k-x 2)*di^k)=x 2
      calc
        _=x 1^k-(x 1^k-x 2)*(x 0*di)^k:=by ring
        _=_:=by rw [x_di];ring
def dehom:wC→+*wG:=eval₂Hom C ![X 0,X 1,X 2,1]
def hdMap (k:ℕ):wC→+*Away:= eval₂Hom (am.comp C) ![x 0,x 1,x 1^k-x 2,x 0^k]
def gdMap (k:ℕ):wC→+*Away:= eval₂Hom (am.comp C) ![x 0,x 1,(x 1^k-x 2)*di^k,1]
lemma ph (k:ℕ):am.comp (ah.au k)=hdMap k:=by
  apply bE
  · intro c
    have heq:(am.comp (ah.au k)).comp C=(hdMap k).comp C:= Subsingleton.elim _ _
    exact congrArg (fun f:ℚ→+*Away=> f c) heq
  · intro i
    fin_cases i<;> simp [ah.au,hdMap,x]
lemma pj (k:ℕ):(down k).comp dehom=gdMap k:=by
  apply bE
  · intro c
    have heq:((down k).comp dehom).comp C=(gdMap k).comp C:= Subsingleton.elim _ _
    exact congrArg (fun f:ℚ→+*Away=> f c) heq
  · intro i
    fin_cases i<;> simp [dehom,gdMap,down]
end
