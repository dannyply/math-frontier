open Polynomial
open JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure
noncomputable section

theorem coeff_mul_at_bounds
    (P Q : Polynomial ℝ) (r s : ℕ)
    (hP : P.natDegree ≤ r) (hQ : Q.natDegree ≤ s) :
    (P * Q).coeff (r + s) = P.coeff r * Q.coeff s := by
  classical
  rw [Polynomial.coeff_mul]
  refine Finset.sum_eq_single (r, s) ?_ ?_
  · rintro ⟨u, v⟩ huv hne
    have hsum : u + v = r + s := by simpa using huv
    by_cases hu : r < u
    · have hz : P.coeff u = 0 :=
        (Polynomial.natDegree_le_iff_coeff_eq_zero.mp hP) u hu
      simp [hz]
    · have hule : u ≤ r := by omega
      have hv : s < v := by
        by_contra hn
        have hvle : v ≤ s := by omega
        have hur : u = r := by omega
        have hvs : v = s := by omega
        exact hne (by simp [hur, hvs])
      have hz : Q.coeff v = 0 :=
        (Polynomial.natDegree_le_iff_coeff_eq_zero.mp hQ) v hv
      simp [hz]
  · intro hnot
    exact False.elim (hnot (by simp))

theorem coeff_finset_sum {α : Type*} (s : Finset α)
    (F : α → Polynomial ℝ) (n : ℕ) :
    (∑ i ∈ s,F i).coeff n=∑ i ∈ s,(F i).coeff n := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih =>
    simp [Finset.sum_insert hi,ih]

theorem homogeneous_substitution_top
    (R : MvPolynomial (Fin 2) ℝ) (n : ℕ) (hR : R.IsHomogeneous n)
    (d e : Polynomial ℝ) (hd : d.natDegree ≤ 1) (he : e.natDegree ≤ 1) :
    (MvPolynomial.eval₂Hom Polynomial.C ![d,e] R).coeff n =
      MvPolynomial.eval ![d.coeff 1,e.coeff 1] R := by
  classical
  have hx0 : (MvPolynomial.eval₂Hom Polynomial.C ![d,e]) (MvPolynomial.X (0:Fin 2))=d := by simp
  have hx1 : (MvPolynomial.eval₂Hom Polynomial.C ![d,e]) (MvPolynomial.X (1:Fin 2))=e := by simp
  have hpoly : MvPolynomial.eval₂Hom Polynomial.C ![d,e] R =
      ∑i∈Finset.range (n+1),
        C (R.coeff (C01.PcCurves.ex i (n-i)))*d^i*e^(n-i) := by
    conv_lhs => rw [C01.PcCurves.hom_repr hR]
    simp only [map_sum,map_mul,map_pow,MvPolynomial.eval₂Hom_C,hx0,hx1]
  rw [hpoly,coeff_finset_sum,C01.PcCurves.eval_eq_sum hR]
  apply Finset.sum_congr rfl
  intro i hi
  have hin : i ≤ n := by simpa only [Finset.mem_range,Nat.lt_succ_iff] using hi
  have hdi : (d^i).natDegree ≤ i := by
    exact Polynomial.natDegree_pow_le.trans (by simpa using Nat.mul_le_mul_left i hd)
  have hei : (e^(n-i)).natDegree ≤ n-i := by
    exact Polynomial.natDegree_pow_le.trans (by simpa using Nat.mul_le_mul_left (n-i) he)
  have hdi' := (Polynomial.natDegree_C_mul_le (R.coeff (C01.PcCurves.ex i (n-i))) (d^i)).trans hdi
  have hc := coeff_mul_at_bounds
    (C (R.coeff (C01.PcCurves.ex i (n-i)))*d^i) (e^(n-i)) i (n-i) hdi' hei
  rw [show i+(n-i)=n by omega] at hc
  rw [hc,Polynomial.coeff_C_mul]
  have hdp : (d^i).coeff i=(d.coeff 1)^i := by
    simpa only [Nat.mul_one] using (Polynomial.coeff_pow_of_natDegree_le (m:=i) hd)
  have hep : (e^(n-i)).coeff (n-i)=(e.coeff 1)^(n-i) := by
    simpa only [Nat.mul_one] using (Polynomial.coeff_pow_of_natDegree_le (m:=n-i) he)
  rw [hdp,hep]
  rfl

theorem homogeneous_eval_scale
    (R : MvPolynomial (Fin 2) ℝ) (n : ℕ) (hR : R.IsHomogeneous n)
    (t a b : ℝ) :
    MvPolynomial.eval ![t*a,t*b] R=t^n*MvPolynomial.eval ![a,b] R := by
  rw [C01.PcCurves.eval_eq_sum hR,C01.PcCurves.eval_eq_sum hR,Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  have hin : i ≤ n := by simpa only [Finset.mem_range,Nat.lt_succ_iff] using hi
  simp only [Matrix.cons_val_zero,Matrix.cons_val_one,mul_pow]
  have hp : t^i*t^(n-i)=t^n := by rw [←pow_add];congr 1;omega
  calc
    _ = t^i*t^(n-i)*(R.coeff (C01.PcCurves.ex i (n-i))*a^i*b^(n-i)) := by ring
    _ = _ := by rw [hp]

theorem original_height_top_coefficient
    (k : ℕ) (Q : MvPolynomial (Fin 2) ℝ) (hQ : Q.IsHomogeneous (k+1))
    (a b c ell : ℝ) (ha : a ≠ 0) (hb : b ≠ 0) (hc : c ≠ 0) (hell : ell ≠ 0) :
    let d : Polynomial ℝ := C (ell/a)*X
    let e : Polynomial ℝ := C (ell/b)*(1-X)
    let φ := MvPolynomial.eval₂Hom Polynomial.C ![d,e]
    let F : Polynomial ℝ := C (1/(c*ell^(2*k+1)))*(d^k*φ Q)
    F.coeff (2*k+1) =
      MvPolynomial.eval ![b,-a] Q/(c*a^k*(a*b)^(k+1)) := by
  intro d e φ F
  have hd : d.natDegree ≤ 1 := by
    exact (Polynomial.natDegree_C_mul_le _ _).trans (by simp)
  have he : e.natDegree ≤ 1 := by
    exact (Polynomial.natDegree_C_mul_le _ _).trans
      ((Polynomial.natDegree_sub_le _ _).trans (by simp))
  have hφQ := homogeneous_substitution_degree Q (k+1) hQ d e hd he
  have hdk : (d^k).natDegree ≤ k := by
    exact Polynomial.natDegree_pow_le.trans (by simpa using Nat.mul_le_mul_left k hd)
  have hcprod := coeff_mul_at_bounds (d^k) (φ Q) k (k+1) hdk hφQ
  rw [show k+(k+1)=2*k+1 by omega] at hcprod
  have hdkc : (d^k).coeff k=(ell/a)^k := by
    have h := Polynomial.coeff_pow_of_natDegree_le (m:=k) hd
    simpa [d] using h
  have htop : (φ Q).coeff (k+1)=MvPolynomial.eval ![ell/a,-(ell/b)] Q := by
    have h := homogeneous_substitution_top Q (k+1) hQ d e hd he
    simpa [φ,d,e,Polynomial.coeff_one] using h
  have hv : MvPolynomial.eval ![ell/a,-(ell/b)] Q =
      (ell/(a*b))^(k+1)*MvPolynomial.eval ![b,-a] Q := by
    have hz : ![ell/a,-(ell/b)]=![ell/(a*b)*b,ell/(a*b)*(-a)] := by
      ext i
      fin_cases i <;> simp only [Matrix.cons_val_zero,Matrix.cons_val_one] <;> field_simp <;> ring
    rw [hz]
    exact homogeneous_eval_scale Q (k+1) hQ _ _ _
  dsimp only [F]
  rw [Polynomial.coeff_C_mul,hcprod,hdkc,htop,hv]
  have hepow : ell^(2*k+1)=ell^k*ell^(k+1) := by
    rw [←pow_add];congr 1;omega
  rw [hepow]
  simp only [div_pow,mul_pow]
  field_simp
  <;> ring

end
end A8FloorExt

