lemma vP (k alpha beta:ℕ)
    (hk:0< k) (hα:1≤ alpha) (hβ:1≤ beta)
    (hab:2≤ beta∨ k< alpha)
    (A P:Matrix (Fin 2) (Fin 2) ℤ) (hPA:P*A=1)
    (G:aa (Fin 4) ℤ)
    (hdeg:∀ m∈ G.support,m 0+m 1=alpha∧ m 2+m 3=beta)
    (hirr:uZ (uJ (uG ℂ) G)):
    ∃ nu:ℕ,∃ H0:ah.wG,ah.au k (ak G)=X 0^nu*H0∧ ¬ (X (0:Fin 3):ah.wG)∣ H0∧ (∀ n:ℕ,(X (0:Fin 3):ah.wG)^n∣
        ah.au k (ak G)→ n≤ nu)∧ nu≤ alpha∧ H0 ≠ 0∧ uK (af.wt k) H0
        (alpha+k*beta-nu)∧ ∀ m:ℕ,Module.finrank ℚ
          (Submodule.map
            (uV ℚ
              (RingHom.ker (aJ k G A).toRingHom)).toLinearMap
            (restrictTotalDegree (Fin (k+1)) ℚ m))= af.Qrank k H0 (k*m):=by
  let g:=ak G
  let f:=az k
  let C:=ac.Inc g f
  let:IsDomain C:=gC k alpha beta hab G hdeg hirr
  let K:=FractionRing C
  let h:C→+*K:=algebraMap C K
  have hi:uX h:= IsLocalization.injective (M:=nonZeroDivisors C) (FractionRing C) le_rfl
  let c:ℚ→+*K:=h.comp (algebraMap ℚ C)
  let:Algebra ℚ K:=c.toAlgebra
  let hA:C→ₐ[ℚ] K:={h with commutes':=fun r=> rfl}
  let q:=ac.q g f
  let d:=h (q (X 0))
  let e:=h (q (X 1))
  let u:=h (q (X 2))
  let v:=h (q (X 3))
  let z:=h (q (X 4))
  let t:=(e^k*v-d^k*u)/v
  have hv:v ≠ 0:=by
    intro hz
    have hq:q (X 3) ≠ 0:=by
      change ac.q g f (X (3:Fin 5)) ≠ 0
      simpa [ac.wM,g,f] using
        vL k alpha beta hα hβ hab G hdeg hirr
          (3:Fin 4)
    apply hq
    apply hi
    simpa only [map_zero] using hz
  have hzF:z*(e^k*v-d^k*u)=1:=by
    have hr:=congrArg h (ac.eP g f)
    have hs:h (q (ac.wM f))=e^k*v-d^k*u:=by
      have vw:ac.wM f= (X (1:Fin 5):ac.Five)^k*X 3-X 0^k*X 2:=by
        simp [ac.wM,f,az]
      rw [vw]
      simp only [map_sub,map_mul,map_pow]
      rfl
    simp only [map_mul,map_one] at hr
    change h (q (ac.wM f))*z=1 at hr
    rw [hs] at hr
    simpa only [mul_comm] using hr
  have hF:e^k*v-d^k*u ≠ 0:=by
    intro hz
    rw [hz,mul_zero] at hzF
    exact zero_ne_one hzF
  have ht:t ≠ 0:=div_ne_zero hF hv
  have htz:t*(z*v)=1:=by
    calc
      _=(t*v)*z:=by ring
      _=(e^k*v-d^k*u)*z:=by
        rw [show t*v=e^k*v-d^k*u from div_mul_cancel₀ _ hv]
      _=1:=by simpa only [mul_comm] using hzF
  have hzv:z*v=t⁻¹:=by
    apply cC ht
    rw [htz,mul_inv_cancel₀ ht]
  have hmap:hA.comp (aJ k G A)= ao.bj k
        (b5.cM A d e) (b5.cN A d e) t:=by
    apply c6
    intro i
    simp [AlgHom.comp_apply,aJ,ao.bj,aeval_def,hA,d,e,q,b5.cM,b5.cN,map_mul,map_pow,map_add]
    ; change z*v*(b5.cM A d e)^(k-i.val)* (b5.cN A d e)^i.val= (b5.cM A d e)^(k-i.val)* (b5.cN A d e)^i.val*t⁻¹
    ; rw [hzv]
    ; ring
  obtain ⟨nu,H0,hH,vK,hmax,hnu,hWH⟩:= j0 k alpha beta hα hβ G hdeg hirr
  have dK:ah.au k g ≠ 0:=by
    have cL:∀ m∈ g.support,m 0+m 1=alpha∧ m 2+m 3=beta:=by
      intro m hm
      exact hdeg m (support_map_subset _ _ hm)
    exact ah.gF k g alpha beta cL
      (cn G hirr).ne_zero
  have hH0:H0 ≠ 0:=by
    intro hz
    rw [hH,hz,mul_zero] at dK
    exact dK rfl
  have hker:=eR.j8
    k alpha beta hα hβ hab G hdeg hirr h hi H0 nu hH vK
  change RingHom.ker (ao.eta d e t).toRingHom= a5 ({H0}:Set ah.wG) at hker
  refine ⟨nu,H0,hH,vK,hmax,hnu,hH0,hWH,?_⟩
  intro m
  exact pG k hk G A P hPA
    hA hi d e t ht H0 hmap hker m
end
end ae.cq
