lemma vB
    (G:aa (Fin 4) ℤ) (hG:G ≠ 0)
    (dB:uZ (uJ (uG ℂ) G)):
    ∃ p:aa (Fin 4) ℤ,Prime p∧ 0< p.totalDegree∧ p∣ G∧ Associated (uJ (uG ℂ) p)
          (uJ (uG ℂ) G):=by
  obtain ⟨s,vC,vy,hsum⟩:=gn G hG
  have uk:=vA G dB
  have nR:0<(s.map MvPolynomial.totalDegree).sum:=by omega
  have find_pos:∀ t:Multiset (aa (Fin 4) ℤ),0<(t.map MvPolynomial.totalDegree).sum→ ∃ p∈ t,0< p.totalDegree:=by
    intro t
    induction t using Multiset.induction_on with
    | empty=> simp
    | @cons a t ih=>
      intro h
      by_cases ha:0< a.totalDegree
      · exact ⟨a,by simp,ha⟩
      · have ht:0<(t.map MvPolynomial.totalDegree).sum:=by
          simp only [Multiset.map_cons,Multiset.sum_cons] at h
          omega
        obtain ⟨p,hp,dC⟩:=ih ht
        exact ⟨p,by simp [hp],dC⟩
  obtain ⟨p,hp,dC⟩:=find_pos s nR
  have hpd:p∣ G:=(Multiset.dvd_prod hp).trans vy.dvd
  have nS:uJ (uG ℂ) p∣
      uJ (uG ℂ) G:=by
    obtain ⟨r,hr⟩:=hpd
    refine ⟨uJ (uG ℂ) r,?_⟩
    simp [hr]
  have vy:Associated
      (uJ (uG ℂ) p)
      (uJ (uG ℂ) G):=by
    rcases (Irreducible.dvd_iff dB).mp nS with hu | ha
    · exact False.elim ((vz p dC) hu)
    · exact ha.symm
  exact ⟨p,vC p hp,dC,hpd,vy⟩
lemma vD
    (F G:aa (Fin 4) ℤ)
    (s:Multiset (aa (Fin 4) ℤ))
    (vC:∀ q∈ s,Prime q)
    (fO:Associated s.prod F)
    (hG:G ≠ 0) (hGF:G∣ F)
    (dB:uZ (uJ (uG ℂ) G)):
    ∃ q∈ s,Prime q∧ 0< q.totalDegree∧ q∣ F∧ Associated (uJ (uG ℂ) q)
        (uJ (uG ℂ) G):=by
  obtain ⟨p,hp,dC,hpdG,hpmG⟩:= vB G hG dB
  have hpdF:p∣ F:=hpdG.trans hGF
  have nT:p∣ s.prod:=hpdF.trans fO.symm.dvd
  have nU:p∣ s.toList.prod:=by simpa using nT
  obtain ⟨q,hqList,hpdq⟩:=(Prime.dvd_prod_iff hp).mp nU
  have hqs:q∈ s:=by simpa using hqList
  have go:Prime q:=vC q hqs
  have hpq:Associated p q:= (Prime.dvd_prime_iff_associated hp go).mp hpdq
  have ee:0< q.totalDegree:=by
    have heq:=fN p q hp.ne_zero go.ne_zero hpq
    omega
  have hqF:q∣ F:=(Multiset.dvd_prod hqs).trans fO.dvd
  have map_dvd:∀ {a b:aa (Fin 4) ℤ},a∣ b→ uJ (uG ℂ) a∣
        uJ (uG ℂ) b:=by
    intro a b hab
    obtain ⟨r,hr⟩:=hab
    refine ⟨uJ (uG ℂ) r,?_⟩
    simp [hr]
  have hqmP:Associated
      (uJ (uG ℂ) q)
      (uJ (uG ℂ) p):=by
    exact associated_of_dvd_dvd (map_dvd hpq.symm.dvd)
      (map_dvd hpq.dvd)
  exact ⟨q,hqs,go,ee,hqF,hqmP.trans hpmG⟩
lemma vE
    (P Q:aa (Fin 4) ℂ)
    (h:Associated P Q):P.support=Q.support:=by
  obtain ⟨u,hu⟩:=h
  have hui:IsUnit (u:aa (Fin 4) ℂ):=⟨u,rfl⟩
  obtain ⟨c,hc,huc⟩:= (MvPolynomial.isUnit_iff_eq_C_of_isReduced).mp hui
  have hq:Q=u2 c*P:=by
    rw [← hu,huc,mul_comm]
  apply Finset.ext
  intro m
  simp only [MvPolynomial.mem_support_iff]
  rw [hq,MvPolynomial.coeff_C_mul]
  simp [hc.ne_zero]
lemma nV
    (p q:aa (Fin 4) ℤ)
    (h:Associated (uJ (uG ℂ) p)
      (uJ (uG ℂ) q)):
    p.support=q.support:=by
  have hi:uX (fun z:ℤ=>(z:ℂ)):=by
    exact_mod_cast (Int.cast_injective:uX (fun z:ℤ=>(z:ℂ)))
  calc
    p.support=(uJ (uG ℂ) p).support:= (MvPolynomial.support_map_of_injective p hi).symm
    _=(uJ (uG ℂ) q).support:= vE _ _ h
    _=q.support:=MvPolynomial.support_map_of_injective q hi
lemma vF
    (p q:aa (Fin 4) ℤ)
    (h:Associated (uJ (uG ℂ) p)
      (uJ (uG ℂ) q))
    (x:Fin 4→ ℤ):
    uI x p=0↔ uI x q=0:=by
  have bridge (r:aa (Fin 4) ℤ):
      uI (fun i=>(x i:ℂ))
        (uJ (uG ℂ) r)= ((uI x r:ℤ):ℂ):=by
    simpa [Function.comp_def] using
      (MvPolynomial.map_eval (uG ℂ) x r).symm
  have dvd_zero (P Q:aa (Fin 4) ℂ) (hd:P∣ Q):
      uI (fun i=>(x i:ℂ)) P=0→ uI (fun i=>(x i:ℂ)) Q=0:=by
    obtain ⟨R,hR⟩:=hd
    intro hP
    simp [hR,hP]
  constructor
  · intro hp
    have hpc:uI (fun i=>(x i:ℂ))
        (uJ (uG ℂ) p)=0:=by
      rw [bridge]
      exact_mod_cast hp
    have hqc:=dvd_zero _ _ h.dvd hpc
    rw [bridge] at hqc
    exact_mod_cast hqc
  · intro hq
    have hqc:uI (fun i=>(x i:ℂ))
        (uJ (uG ℂ) q)=0:=by
      rw [bridge]
      exact_mod_cast hq
    have hpc:=dvd_zero _ _ h.symm.dvd hqc
    rw [bridge] at hpc
    exact_mod_cast hpc
end ed
end cW
open cW.ed
lemma nW
    (k thr:ℕ) (F:aa (Fin 4) ℤ) (hF:F ≠ 0)
    (D:ℕ) (hdeg:F.totalDegree≤ D):
    ∃ S:Finset (aa (Fin 4) ℤ),S.card≤ D∧ (∀ q∈ S,gk q∧ ck k thr F q)∧ ∀ G,ck k thr F G→ ∃ q∈ S,∀ x:Fin 4→ ℤ,(uI x G=0↔ uI x q=0):=by
  obtain ⟨s,vC,fO,hsum⟩:= cW.ed.gn F hF
  classical
  let S₀:Finset (aa (Fin 4) ℤ):= (s.filter (fun p=>0< p.totalDegree)).toFinset
  let S:Finset (aa (Fin 4) ℤ):= S₀.filter (ck k thr F)
  refine ⟨S,?_,?_,?_⟩
  · have nX:S₀.card≤ D:=by
      have h1:=Multiset.toFinset_card_le
        (s.filter (fun p=>0< p.totalDegree))
      have h2:=cW.gl.nO s
      dsimp [S₀]
      omega
    exact (ds (Finset.filter_subset _ _)).trans nX
  · intro q hq
    have hqE:ck k thr F q:=(Finset.mem_filter.mp hq).2
    have hqS₀:q∈ S₀:=(Finset.mem_filter.mp hq).1
    have hqs:q∈ s:=by
      exact (Multiset.mem_filter.mp ((Multiset.mem_toFinset).mp hqS₀)).1
    have hqp:Prime q:=vC q hqs
    have nY:uZ (uJ (uG ℂ) q):=hqE.2.2.1
    exact ⟨cW.jD.nQ
      q hqp.irreducible nY,hqE⟩
  · intro G hG
    rcases hG with ⟨hGF,hG0,dB,α,β,hα,hβ,bM,hBi⟩
    obtain ⟨q,hqs,hqp,ee,hqF,hass⟩:= cW.ed.vD
        F G s vC fO hG0 hGF dB
    have hqBi:wp q α β:=by
      intro m hm
      apply hBi
      have nZ:=cW.ed.nV q G hass
      rw [← nZ]
      exact hm
    have hqE:ck k thr F q:= ⟨hqF,hqp.ne_zero,hass.irreducible_iff.mpr dB,⟨α,β,hα,hβ,bM,hqBi⟩⟩
    have hqS:q∈ S:=by
      apply Finset.mem_filter.mpr
      constructor
      · change q∈(s.filter (fun p=>0< p.totalDegree)).toFinset
        exact (Multiset.mem_toFinset).mpr
          (Multiset.mem_filter.mpr ⟨hqs,ee⟩)
      · exact hqE
    refine ⟨q,hqS,?_⟩
    intro x
    exact (cW.ed.vF q G hass x).symm
end aS
namespace gp
lemma eJ (x:ℝ) (hx:0≤ x) (n:ℕ) (a:ℝ):
    (x^n)^a=x^((n:ℝ)*a):=by
  rw [←aN,←aQ hx]
lemma n0 (k thr:ℕ)
    (hk:1≤ k) (hthr:2*k+1≤ thr)
    (l t:ℝ) (hl:0≤ l) (ht:0≤ t):
    (l^k*t)^((1:ℝ)/(thr:ℝ))≤1+l^2+t^2:=by
  let w:ℝ:=1+l^2+t^2
  let p:ℝ:=(k:ℝ)/(2*(thr:ℝ))
  let q:ℝ:=(1:ℝ)/(2*(thr:ℝ))
  have hw1:1≤ w:=by dsimp [w];nlinarith only [sq_nonneg l,sq_nonneg t]
  have hw0:0< w:=by linarith only [hw1]
  have hlw:l^2≤ w:=by dsimp [w];nlinarith only [sq_nonneg t]
  have htw:t^2≤ w:=by dsimp [w];nlinarith only [sq_nonneg l]
  have eK:(0:ℝ)< thr:=by exact_mod_cast (show 0< thr by omega)
  have hp0:0≤ p:=by dsimp [p];positivity
  have hq0:0≤ q:=by dsimp [q];positivity
  have hsum:p+q≤1:=by
    have hn:k+1≤2*thr:=by omega
    have hr:((k+1:ℕ):ℝ)≤((2*thr:ℕ):ℝ):=by exact_mod_cast hn
    dsimp [p,q]
    rw [← add_div]
    apply (aX (by positivity:0<2*(thr:ℝ))).mpr
    push_cast at hr
    nlinarith only [hr]
  have n3:(l^k)^((1:ℝ)/(thr:ℝ))=(l^2)^p:=by
    rw [eJ l hl k,eJ l hl 2]
    congr 1
    dsimp [p]
    field_simp [eK.ne']
  have n4:t^((1:ℝ)/(thr:ℝ))=(t^2)^q:=by
    rw [eJ t ht 2]
    congr 1
    dsimp [q]
    field_simp [eK.ne']
  calc
    (l^k*t)^((1:ℝ)/(thr:ℝ))= (l^2)^p*(t^2)^q:=by
      rw [cE (by positivity) ht,n3,n4]
    _≤ w^p*w^q:= bq
        (cB (sq_nonneg l) hlw hp0)
        (cB (sq_nonneg t) htw hq0)
        (uY (sq_nonneg t) _)
        (uY hw0.le _)
    _=w^(p+q):=by rw [bH hw0]
    _≤ w^(1:ℝ):=u0 hw1 hsum
    _=1+l^2+t^2:=by rw [Real.rpow_one]
lemma n5 (k thr:ℕ)
    (hk:1≤ k) (hthr:2*k+1≤ thr)
    (l t r v:ℝ)
    (hl:0≤ l) (ht:0≤ t) (hr:0< r) (hv:0< v):
    (l^k*t)^((1:ℝ)/(thr:ℝ))≤
      (r^k*v)^((1:ℝ)/(thr:ℝ))* (1+(l/r)^2+(t/v)^2):=by
  have hid:l^k*t=(r^k*v)*((l/r)^k*(t/v)):=by
    have hrk:r^k ≠ 0:=u5 k hr.ne'
    rw [div_pow]
    field_simp [hrk,hv.ne']
  calc
    (l^k*t)^((1:ℝ)/(thr:ℝ))= (r^k*v)^((1:ℝ)/(thr:ℝ))* ((l/r)^k*(t/v))^((1:ℝ)/(thr:ℝ)):=by
      rw [hid,cE (by positivity) (by positivity)]
    _≤ _:=ad
      (n0 k thr hk hthr (l/r) (t/v)
        (div_nonneg hl hr.le) (div_nonneg ht hv.le))
      (uY (by positivity) _)
lemma n6 (k thr:ℕ)
    (hk:1≤ k) (hthr:2*k+1≤ thr)
    (J:Finset ℕ) (m R S A:ℝ) (L T:ℕ→ℝ)
    (hm:0< m) (hR:0< R) (hS:0< S) (hA:1≤ A)
    (vd:(J.card:ℝ)≤4*m)
    (hL:∀ j∈J,0≤ L j) (hT:∀ j∈J,0≤ T j)
    (hLm:(∑ j∈J,(L j)^2)≤ A*R)
    (hTm:(∑ j∈J,(T j)^2)≤ A*S):
    let p:ℝ:=(k:ℝ)/(2*(thr:ℝ))
    let q:ℝ:=(1:ℝ)/(2*(thr:ℝ))
    (∑ j∈J,(1+((L j)^k*T j)^((1:ℝ)/(thr:ℝ))))≤
      10*A*(m+m^(1-p-q)*R^p*S^q):=by
  let p:ℝ:=(k:ℝ)/(2*(thr:ℝ))
  let q:ℝ:=(1:ℝ)/(2*(thr:ℝ))
  let r:ℝ:=(R/m)^((1:ℝ)/2)
  let v:ℝ:=(S/m)^((1:ℝ)/2)
  have eK:(0:ℝ)< thr:=by exact_mod_cast (show 0< thr by omega)
  have hr:0< r:=d1 (by positivity) _
  have hv:0< v:=d1 (by positivity) _
  have hr2:r^2=R/m:=by
    dsimp [r]
    rw [←aN,←aQ (by positivity:0≤ R/m)]
    norm_num
  have hv2:v^2=S/m:=by
    dsimp [v]
    rw [←aN,←aQ (by positivity:0≤ S/m)]
    norm_num
  have n7:(∑ j∈J,(L j/r)^2)≤ A*m:=by
    calc
      (∑ j∈J,(L j/r)^2)=(∑ j∈J,(L j)^2)/r^2:=by
