lemma j9 (k:ℕ) (d e t:K) (ht:t ≠ 0) (m:ℕ):
    Module.finrank ℚ
      (Submodule.map (ao.theta d e t m)
        (weightedHomogeneousSubmodule ℚ (af.wt k) (k*m)))= Module.finrank ℚ
