    have hp := p.hcover ((z.1.1:ℤ),(z.1.2:ℤ)) hn.1
    have hq := q.hcover ((z.2.2:ℤ),(z.2.1:ℤ)) hn.2
    exact ⟨hp.1,hp.2,hq.1,hq.2⟩
  exact A8HighFPriceCellPrice.highCell_priceK
    k thr N M j c η x D E hk hthr hCC hη hx1
    F G hF hFD hG p q hc hLcap hTcap
