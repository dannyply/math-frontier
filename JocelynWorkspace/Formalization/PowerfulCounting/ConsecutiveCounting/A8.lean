    exact_mod_cast hh
  · have hh:(p i:ℝ)≤(⌈H⌉:ℝ):=by linarith [hi.2]
    exact_mod_cast hh
def aO (k:ℕ) (G:wB) (A:Mat) (h:ℤ) (L V:ℝ):
    Set (Fin 4→ ℤ):= {z | (∀ i:Fin 4,0< z i)∧ uI z G=0∧ (z 1)^k*z 3-(z 0)^k*z 2=h∧ (∀ i:Fin 2,|((ag A z i:ℤ):ℝ)|≤ L)∧ (z 3:ℝ)≤ V}
lemma kg (k:ℕ) (G:wB) (A:Mat)
    (h:ℤ) (L V:ℝ):
    aO k G A h L V ⊆ kb k h:=by
  intro z hz
  exact ⟨hz.1,hz.2.2.1⟩
lemma pR (k:ℕ) (hk:1≤ k) (P A:Mat)
    (hPA:P*A=1) (G:wB)
    (h:ℤ) (vQ:h=1∨ h= -1) (L V:ℝ) (hL:0≤ L):
    (aO k G A h L V).Finite:=by
  let T:Set (Fin (k+1)→ ℤ):= {w | ∀ i,|(w i:ℝ)|≤ L^k*V}
  have hT:T.Finite:=eU (k+1) (L^k*V)
  have hinj:Set.InjOn (cr k A h) (aO k G A h L V):= (kd k hk P A hPA h vQ).mono
      (kg k G A h L V)
  have hm:cr k A h '' aO k G A h L V ⊆ T:=by
    rintro w ⟨z,hz,rfl⟩
    intro i
    exact ke k A h vQ z (hz.1 3).le L V hL
      hz.2.2.2.2 hz.2.2.2.1 i
  exact (hT.subset hm).of_finite_image hinj
end
