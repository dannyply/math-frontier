lemma gK (D d t:ℕ)
    (ht0:0< t) (ht:t≤d) (hdD:d≤D)
    (c x B E eps:ℝ) (hx:2≤x) (hE:0< E) (heps:0< eps)
    (hB:0≤B) (hXX:B≤x^E):
    c*(d:ℝ)^3*(max 1 B)^((1:ℝ)/(d:ℝ))* (Real.log (max 1 B)+(d:ℝ))≤
    ((|c|+1)*(D:ℝ)^3*(E/eps+(D:ℝ)))* x^eps*(1+B^((1:ℝ)/(t:ℝ))):=by
  have hD:0< D:=lt_of_lt_of_le (lt_of_lt_of_le ht0 ht) hdD
  have hx0:0< x:=by linarith
  have hx1:1≤x:=by linarith
  have gL:(0:ℝ)<(D:ℝ):=by exact_mod_cast hD
  have pS:(0:ℝ)<(d:ℝ):=by exact_mod_cast (by omega:0< d)
  have htR:(t:ℝ)≤(d:ℝ):=by exact_mod_cast ht
  have hdDR:(d:ℝ)≤(D:ℝ):=by exact_mod_cast hdD
  have hX:0≤B:=hB
  have hH:1≤ max 1 B:=a3 _ _
  have hH0:0< max 1 B:=by linarith
  have hHX:max 1 B≤x^E:= max_le (cc hx1 (by positivity)) hXX
  have hlog:0≤Real.log (max 1 B):=Real.log_nonneg hH
  have gM:Real.log (max 1 B)≤E*Real.log x:=by
    calc
      _≤Real.log (x^E):=Real.log_le_log hH0 hHX
      _=E*Real.log x:=Real.log_rpow hx0 _
  have hlx:Real.log x≤x^eps/eps:=Real.log_le_rpow_div hx0.le heps
  have cs:1≤x^eps:=cc hx1 heps.le
  have vS:
      Real.log (max 1 B)+(d:ℝ)≤(E/eps+(D:ℝ))*x^eps:=by
    have hh:=gM.trans (ad hlx (by positivity))
    have hhD:=ad cs gL.le
    calc
      _≤E*(x^eps/eps)+(D:ℝ)*x^eps:=by nlinarith
      _=_:=by ring
  have hpow:
      (max 1 B)^((1:ℝ)/(d:ℝ))≤1+B^((1:ℝ)/(t:ℝ)):=by
    rcases le_total B 1 with hlo|hhi
    · rw [max_eq_left hlo,Real.one_rpow]
      exact le_add_of_nonneg_right (uY hX _)
    · rw [max_eq_right hhi]
      have he:(1:ℝ)/(d:ℝ)≤1/(t:ℝ):= one_div_le_one_div_of_le (by exact_mod_cast ht0) htR
      have hh:=u0 hhi he
      linarith
  have gN:(d:ℝ)^3≤(D:ℝ)^3:=by gcongr
  have hc:c≤|c|+1:=by linarith [le_abs_self c]
  have vG:
      c*(d:ℝ)^3*(max 1 B)^((1:ℝ)/(d:ℝ))* (Real.log (max 1 B)+(d:ℝ))≤
      (|c|+1)*(d:ℝ)^3*(max 1 B)^((1:ℝ)/(d:ℝ))* (Real.log (max 1 B)+(d:ℝ)):=by
    apply uH
    · apply uH
      · exact uH hc (by positivity)
      · exact uY hH0.le _
    · positivity
  have gO:=ad gN
    (by positivity:0≤|c|+1)
  have gP:=bq gO hpow
    (uY hH0.le _)
    (by positivity:0≤(|c|+1)*(D:ℝ)^3)
  have gQ:=bq gP vS
    (by positivity:0≤Real.log (max 1 B)+(d:ℝ))
    (by positivity:
      0≤(|c|+1)*(D:ℝ)^3*(1+B^((1:ℝ)/(t:ℝ))))
  exact vG.trans (by nlinarith [gQ])
lemma pT (k:ℕ) (eh:k≤123)
    (x L V Cexp:ℝ) (hx:2≤x) (hC:0< Cexp)
    (hL:0≤L) (hLX:L≤x^Cexp)
    (hV:0≤V) (hVX:V≤x^Cexp):
    L^k*V≤x^(124*Cexp):=by
  have hx0:0< x:=by linarith
  have hx1:1≤x:=by linarith
  have bf:L^k*V≤x^(((k:ℝ)+1)*Cexp):=by
    calc
      L^k*V≤(x^Cexp)^k*x^Cexp:=by gcongr
      _=x^(((k:ℝ)+1)*Cexp):=by
        rw [←aN,←aQ hx0.le,←bH hx0]
        congr 1
        ring
  have hE:((k:ℝ)+1)*Cexp≤124*Cexp:=by
    have hkR:(k:ℝ)≤123:=by exact_mod_cast eh
    nlinarith
  exact bf.trans (u0 hx1 hE)
lemma pU (N k d:ℕ) (hk:5≤k) (eh:k≤123)
    (vM:2*k+1≤d) (hdN:d≤123*(N+2))
    (c x L V Cexp eps:ℝ)
    (hx:2≤x) (hC:0< Cexp) (heps:0< eps)
    (hL:0≤L) (hLX:L≤x^Cexp)
    (hV:0≤V) (hVX:V≤x^Cexp):
    c*(d:ℝ)^3*(max 1 (L^k*V))^((1:ℝ)/(d:ℝ))* (Real.log (max 1 (L^k*V))+(d:ℝ))≤
    ((|c|+1)*((123*(N+2):ℕ):ℝ)^3* (124*Cexp/eps+((123*(N+2):ℕ):ℝ)))* x^eps*(1+(L^k*V)^((1:ℝ)/((2*k+1:ℕ):ℝ))):=by
  exact gK (123*(N+2)) d (2*k+1)
    (by omega) vM hdN c x (L^k*V) (124*Cexp) eps hx
    (by positivity) heps (by positivity)
    (pT k eh x L V Cexp hx hC hL hLX hV hVX)
end
