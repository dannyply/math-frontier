variable {K:Type*} [Field K] [Algebra ℚ K]
lemma j8 (k alpha beta:ℕ)
    (hα:1≤ alpha) (hβ:1≤ beta)
    (hab:2≤ beta∨ k< alpha)
    (G:aa (Fin 4) ℤ)
    (hdeg:∀ m∈ G.support,m 0+m 1=alpha∧ m 2+m 3=beta)
    (hirr:uZ (uJ (uG ℂ) G))
    (h:ac.Inc (ak G) (az k)→+*K)
    (hi:uX h)
    (H0:ah.wG) (nu:ℕ)
    (hH:ah.au k (ak G)=X 0^nu*H0)
    (vK:¬ (X (0:Fin 3):ah.wG)∣ H0):
    RingHom.ker (fT k (ak G) h).toRingHom= a5 ({H0}:Set ah.wG):=by
  let g:=ak G
  let f:=az k
  let d:=h (ac.q g f (X 0))
  let e:=h (ac.q g f (X 1))
  let u:=h (ac.q g f (X 2))
  let v:=h (ac.q g f (X 3))
  have eg (i:Fin 4):h (ac.q g f (X i.castSucc)) ≠ 0:=by
    intro hx
    apply vL k alpha beta hα hβ hab G hdeg hirr i
    apply hi
    simpa [g,f,ac.wM] using hx
  have hd:d ≠ 0:=eg 0
  have hv:v ≠ 0:=eg 3
  have cL:∀ m∈ g.support,m 0+m 1=alpha∧ m 2+m 3=beta:=by
    intro m hm
    exact hdeg m (support_map_subset _ _ hm)
  have vI:aL.wR d e u v g=0:=by
    have heq:=congrArg (fun ff:ac.wC→+*K=> ff g)
      (j7 g f h)
    change aL.wR d e u v g= h (ac.q g f (ac.wM g)) at heq
    rw [heq,ac.q_g,map_zero]
  have hH0:fT k g h H0=0:= aL.pr k g alpha beta cL H0 nu hH
      d e u v hd hv vI
  ext p
  rw [ez]
  change fT k g h p=0↔ H0∣p
  constructor
  · intro hp
    have hc:g∣aL.b4 k p p.totalDegree:= ps k alpha beta hα hβ hab G hdeg hirr h hi p hp
    have hde:=map_dvd aL.dehom hc
    rw [aL.pm] at hde
    exact aL.pl k g alpha beta cL
      p H0 nu hH vK hde
  · rintro ⟨r,rfl⟩
    rw [map_mul,hH0,zero_mul]
end
end ae.eR
