  have hδN := A8HighFPriceFactor.weighted_degree_capK k hk G hG0 a b N hBi hdeg
  have hδR : (thr:ℝ)≤Δ := by dsimp [Δ]; exact_mod_cast hδ
  have hδcap : Δ≤((k*N:ℕ):ℝ) := by dsimp [Δ]; exact_mod_cast hδN
  have hTr := A8HighFPriceInternal.positive_original_transport
