  have hx0 : (MvPolynomial.eval₂Hom Polynomial.C ![d,e]) (MvPolynomial.X (0:Fin 2))=d := by simp
  have hx1 : (MvPolynomial.eval₂Hom Polynomial.C ![d,e]) (MvPolynomial.X (1:Fin 2))=e := by simp
  rw [C01.PcCurves.hom_repr hR]
  simp only [map_sum,map_mul,map_pow,MvPolynomial.eval₂Hom_C,hx0,hx1]
  apply Polynomial.natDegree_sum_le_of_forall_le
  intro i hi
  have hin : i≤n := by simpa only [Finset.mem_range,Nat.lt_succ_iff] using hi
  calc
    (C (MvPolynomial.coeff (C01.PcCurves.ex i (n-i)) R)*d^i*e^(n-i)).natDegree
        ≤ (C (MvPolynomial.coeff (C01.PcCurves.ex i (n-i)) R)*d^i).natDegree
          +(e^(n-i)).natDegree := Polynomial.natDegree_mul_le
    _ ≤ (d^i).natDegree+(e^(n-i)).natDegree :=
      Nat.add_le_add_right (Polynomial.natDegree_C_mul_le _ _) _
    _ ≤ i*d.natDegree+(n-i)*e.natDegree :=
      Nat.add_le_add Polynomial.natDegree_pow_le Polynomial.natDegree_pow_le
    _ ≤ i*1+(n-i)*1 := Nat.add_le_add (Nat.mul_le_mul_left i hd)
      (Nat.mul_le_mul_left (n-i) he)
    _ = n := by omega

theorem original_height_jets
    (k : ℕ) (P Q : MvPolynomial (Fin 2) ℝ)
    (hQ : Q.IsHomogeneous (k+1))
    (a b c ell : ℝ) (ha : a≠0) (hb : b≠0) (hc : c≠0) (hell : ell≠0)
    (hres : MvPolynomial.X (1:Fin 2)^k*P-MvPolynomial.X (0:Fin 2)^k*Q =
      MvPolynomial.C c*(MvPolynomial.C a*MvPolynomial.X (0:Fin 2)+
        MvPolynomial.C b*MvPolynomial.X (1:Fin 2))^(2*k+1)) :
    let d : Polynomial ℝ := C (ell/a)*X
    let e : Polynomial ℝ := C (ell/b)*(1-X)
    let φ := MvPolynomial.eval₂Hom Polynomial.C ![d,e]
    let F : Polynomial ℝ := C (1/(c*ell^(2*k+1)))*(d^k*φ Q)
    X^k∣F ∧ (1-X)^k∣F+1 ∧ F.natDegree≤2*k+1 := by
  intro d e φ F
  have hda : a*(ell/a)=ell := by field_simp
  have hdb : b*(ell/b)=ell := by field_simp
  have hlin : C a*d+C b*e=C ell := by
    calc
      C a*d+C b*e=C (a*(ell/a))*X+C (b*(ell/b))*(1-X) := by
        simp only [d,e,Polynomial.C_mul]
        ring
      _=C ell := by rw [hda,hdb];ring
  have hφC : ∀ t : ℝ, φ (MvPolynomial.C t)=C t := by
    intro t
    simp [φ]
  have hφX : ∀ i : Fin 2, φ (MvPolynomial.X i)=![d,e] i := by
    intro i
    simp [φ]
  have hp := congrArg φ hres
  simp only [map_sub,map_add,map_mul,map_pow,hφC,hφX,Matrix.cons_val_zero,
    Matrix.cons_val_one,hlin] at hp
  have hrel : e^k*φ P-d^k*φ Q=C (c*ell^(2*k+1)) := by
    simpa only [Polynomial.C_mul,Polynomial.C_pow] using hp
  let J : Polynomial ℝ := C (1/(c*ell^(2*k+1)))
  have hJ : J*C (c*ell^(2*k+1))=1 := by
    dsimp only [J]
    rw [← Polynomial.C_mul]
    have hden : c*ell^(2*k+1)≠0 := mul_ne_zero hc (pow_ne_zero _ hell)
    have hh : 1/(c*ell^(2*k+1))*(c*ell^(2*k+1))=1 := by
      field_simp
    exact congrArg Polynomial.C hh
  have hFp : F+1=J*(e^k*φ P) := by
    have hh : e^k*φ P=d^k*φ Q+C (c*ell^(2*k+1)) :=
      by linear_combination hrel
    rw [hh,mul_add,hJ]
  refine ⟨?_,?_,?_⟩
  · refine ⟨J*C (ell/a)^k*φ Q,?_⟩
    dsimp only [F,d,J]
    simp only [mul_pow]
    ring
  · rw [hFp]
    refine ⟨J*C (ell/b)^k*φ P,?_⟩
    dsimp only [e]
    simp only [mul_pow]
    ring
  · have hd : d.natDegree≤1 := by
      exact (Polynomial.natDegree_C_mul_le _ _).trans (by simp)
    have he : e.natDegree≤1 := by
      exact (Polynomial.natDegree_C_mul_le _ _).trans
        ((Polynomial.natDegree_sub_le _ _).trans (by simp))
    have hφQ := homogeneous_substitution_degree Q (k+1) hQ d e hd he
    calc
      F.natDegree ≤ (d^k*φ Q).natDegree := Polynomial.natDegree_C_mul_le _ _
      _ ≤ (d^k).natDegree+(φ Q).natDegree := Polynomial.natDegree_mul_le
      _ ≤ k*d.natDegree+(k+1) := Nat.add_le_add Polynomial.natDegree_pow_le hφQ
      _ ≤ k*1+(k+1) := Nat.add_le_add_right (Nat.mul_le_mul_left k hd) _
      _=2*k+1 := by omega

end
end A8FloorExt

