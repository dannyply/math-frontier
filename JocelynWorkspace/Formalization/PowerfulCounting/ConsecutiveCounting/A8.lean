lemma qr {M:Type*} [CommMonoid M] (n:ℕ) (s:Multiset (Option ℚ)) (a b:Option ℚ) (vd:s.card=n)
    (ha:a∈ s) (hb:b∈ s) (hne:a ≠ b)
    (vH:∀ x∈ s,x=a∨ x=b):
    ∃ j:ℕ,1≤ j∧ j< n∧ ∀ f:Option ℚ→ M,(s.map f).prod=f a^j*f b^(n-j):=by
  obtain ⟨j,hj,haj,hbj,vf⟩:= binarySupportProduct (M:=M) a b hne s vH
  refine ⟨j,?_,?_,?_⟩
  · exact haj ha
  · have hlt:=hbj hb
    omega
  · intro f
    simpa only [vd] using vf f
lemma wc
    (n:ℕ) (hn:1≤ n) (R:aa (Fin 2) ℤ)
    (hR:R.IsHomogeneous n) (hR0:R ≠ 0)
    (dh:¬ HasThreeProjectiveZeros R)
    (hInf:uI ![(1:ℂ),0] (R.map (uG ℂ))=0)
    (il:((C01.PcCurves.dehom R).map (uG ℚ)).Splits):
    (∃c:ℤ,R=u2 c*uQ 1^n)∨ ei n R:=by
  classical
  obtain ⟨c,hc,labels,vd,hfac⟩:= wb n R hR hR0 il
  obtain ⟨a,ha⟩:=FormalAB.S84900580.A5PrivateOddRoot.multiset_has_member labels (by omega)
  by_cases hone:∀ z∈ labels,z=a
  · have hp:R=u2 c*FormalAB.S84900580.A5PrivateOddRoot.labelLine a^n:=by
      rw [hfac,FormalAB.S84900580.A5PrivateOddRoot.label_product_eq_pow labels a hone,vd]
    left
    have vf:(c:ℂ)*(lineCoeffA a:ℂ)^n=0:=by
      simpa [hp,labelLine] using hInf
    have hcC:(c:ℂ) ≠ 0:=by exact_mod_cast hc
    have hpow:(lineCoeffA a:ℂ)^n=0:=(mul_eq_zero.mp vf).resolve_left hcC
    have hA:lineCoeffA a=0:=by
      by_contra ha0
      have haC:(lineCoeffA a:ℂ) ≠ 0:=by exact_mod_cast ha0
      exact (u5 n haC) hpow
    refine ⟨c*(lineCoeffB a)^n,?_⟩
    rw [hp,labelLine,hA]
    simp only [map_zero,zero_mul,zero_add,mul_pow,←map_pow]
    rw [←aG,←map_mul]
  · push Not at hone
    obtain ⟨b,hb,hba⟩:=hone
    have hab:a ≠ b:=Ne.symm hba
    have eQ:uX (fun z:Option ℚ=>
        es (et z)):= FormalAB.S84900580.A5PrivateOddRoot.projectivePoint_injective.comp
        FormalAB.S84900580.A5PrivateOddRoot.labelToComplex_injective
    have vI:∀ z∈ labels,uI
          (es
            (et z)).rep
          (R.map (uG ℂ))=0:= qq n R hR c labels hfac
    have vH:∀ z∈ labels,z=a∨ z=b:=by
      intro z hz
      by_cases hza:z=a
      · exact Or.inl hza
      by_cases hzb:z=b
      · exact Or.inr hzb
      exfalso
      apply dh
      refine ⟨es (et a),es (et b),es (et z),?_,?_,?_,vI a ha,vI b hb,vI z hz⟩
      · exact fun he=> hab (eQ he)
      · exact fun he=> hza (eQ he).symm
      · exact fun he=> hzb (eQ he).symm
    obtain ⟨j,hj,hj6,vf⟩:= qr (M:=aa (Fin 2) ℤ)
        n labels a b vd ha hb hab vH
    right
    refine ⟨c,FormalAB.S84900580.A5PrivateOddRoot.lineCoeffA a,FormalAB.S84900580.A5PrivateOddRoot.lineCoeffB a,FormalAB.S84900580.A5PrivateOddRoot.lineCoeffA b,FormalAB.S84900580.A5PrivateOddRoot.lineCoeffB b,j,hc,FormalAB.S84900580.A5PrivateOddRoot.label_coeff_independent a b hab,hj,hj6,?_⟩
    rw [hfac,vf FormalAB.S84900580.A5PrivateOddRoot.labelLine]
    all_goals simp only [FormalAB.S84900580.A5PrivateOddRoot.labelLine,aG]
lemma wd (n:ℕ) (hn:1≤ n)
    (R:aa (Fin 2) ℤ) (hR:R.IsHomogeneous n) (hR0:R ≠ 0)
