theorem originalUnitError : OriginalUnitErrorStatement := by
  unfold OriginalUnitErrorStatement
  intro k hk5 hk123 x D E d e u v hx hD hE hd he hu hunit hband hS
  have hDk : D ^ k ≠ 0 := pow_ne_zero _ (ne_of_gt hD)
  have hdk : d ^ k ≠ 0 := pow_ne_zero _ (ne_of_gt hd)
  have hek : e ^ k ≠ 0 := pow_ne_zero _ (ne_of_gt he)
  have hsmall : v / u - (d / e) ^ k = 1 / (e ^ k * u) := by
    rw [div_pow]
    field_simp [hek, ne_of_gt hu]
    nlinarith only [hunit]
  have hid :
      (E / D) ^ k * (v / u) - ((E / D) * (d / e)) ^ k =
        ((E / D) * (d / e)) ^ k / (d ^ k * u) := by
    calc
      _ = (E / D) ^ k * (v / u - (d / e) ^ k) := by
        rw [mul_pow]
        ring
      _ = (E / D) ^ k * (1 / (e ^ k * u)) := by rw [hsmall]
      _ = _ := by
        simp only [mul_pow, div_pow]
        field_simp [hDk, hdk, hek, ne_of_gt hu]

  have hden : 0 < d ^ k * u := mul_pos (pow_pos hd _) hu
  have hnum : |(E / D) * (d / e)| ^ k ≤ (2 : ℝ) ^ k := by
    gcongr
  rw [hid, abs_div, abs_pow, abs_of_pos hden]
  calc
    _ ≤ (2 : ℝ) ^ k / (x / 2) := by
      have hxhalf : 0 < x / 2 := by positivity
      apply (div_le_div_iff₀ hden hxhalf).mpr
      have hleft := mul_le_mul_of_nonneg_right hnum hxhalf.le
      have hright := mul_le_mul_of_nonneg_left (le_of_lt hband)
        (pow_nonneg (by norm_num : (0 : ℝ) ≤ 2) k)
      nlinarith only [hleft, hright]
