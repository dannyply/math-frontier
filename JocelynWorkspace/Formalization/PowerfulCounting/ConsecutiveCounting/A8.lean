theorem affine_first_order_alternative
    (k : ℕ) (F : Polynomial ℝ) (z0 γ x R c₁ C₁ lam A B : ℝ)
    (hx : 0<x) (hR : 0<R) (hc₁ : 0<c₁) (hlam : lam≠0) (hγ : γ≠0)
    (hC : C₁≤R) (hscale : C₁≤ |lam| *R^2)
    (hscale2 : C₁*x≤ |lam| *R^(2*k+1))
    (hfirst : ∀ z : ℝ, C₁≤ |z| → C₁≤ |lam| *|z|^2 →
      C₁*x≤ |lam| *|z|^(2*k+1) → |F.eval z|≤x →
      c₁*|lam| *|z|^(2*k)≤ |F.derivative.eval z|)
    (hwhole : ∀ t∈Set.Icc A B,R≤ |z0+γ*t|) :
    let N := F.comp (C z0+C γ*X)
    let l : ℝ := c₁*|lam| *|γ| *R^(2*k)
    0<l ∧ ∀ t∈Set.Icc A B,x/2<N.eval t → N.eval t≤x →
      l≤ |N.derivative.eval t| := by
  intro N l
  have hlampos : 0< |lam| := abs_pos.mpr hlam
  have hγpos : 0< |γ| := abs_pos.mpr hγ
  have hl : 0<l := by dsimp [l]; positivity
  refine ⟨hl,?_⟩
  intro t ht hlow hupp
  have hz := hwhole t ht
  have hz0 : 0≤ |z0+γ*t| := abs_nonneg _
  have hpow : ∀ n : ℕ,R^n≤ |z0+γ*t|^n :=
    fun n => pow_le_pow_left₀ hR.le hz n
  have hlam0 : 0≤ |lam| := abs_nonneg _
  have hFval : |F.eval (z0+γ*t)|≤x := by
    have hn := (affine_height_derivatives F z0 γ t).1
    change N.eval t=_ at hn
    rw [←hn,abs_of_pos (by linarith : 0<N.eval t)]
    exact hupp
  have hd := hfirst (z0+γ*t) (hC.trans hz)
    (hscale.trans (mul_le_mul_of_nonneg_left (hpow 2) hlam0))
    (hscale2.trans (mul_le_mul_of_nonneg_left (hpow (2*k+1)) hlam0)) hFval
  have hder := (affine_height_derivatives F z0 γ t).2.1
  change N.derivative.eval t=_ at hder
  rw [hder,abs_mul]
  have hp := mul_le_mul_of_nonneg_left (hpow (2*k)) (by positivity : 0≤c₁*|lam|)
  have hmul := mul_le_mul_of_nonneg_left (hp.trans hd) (abs_nonneg γ)
  calc
    l=|γ| *(c₁*|lam| *R^(2*k)) := by dsimp [l];ring
    _≤ |γ| *|F.derivative.eval (z0+γ*t)| := hmul

end
