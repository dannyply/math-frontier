  obtain ⟨C₁, T₁, hC₁, hT₁, hb₁⟩ := hB₁ δ hδ
  obtain ⟨C₂, T₂, hC₂, hT₂, hb₂⟩ := hB₂ δ hδ
  refine ⟨C₁ + C₂, max T₁ T₂, by linarith, le_trans hT₁ (le_max_left _ _), ?_⟩
  intro y hy s hlo hhi D E hD hE hDE hNC
  have hy1 : 1 ≤ y := le_trans (by linarith) (le_trans (le_max_left T₁ T₂) hy)
  have hP : 0 ≤ y ^ (th + δ) := by positivity
  by_cases hs : s ≤ mid
  · obtain ⟨hf, hb⟩ := hb₁ y (le_trans (le_max_left _ _) hy) s hlo hs D E hD hE hDE hNC
    refine ⟨hf, hb.trans ?_⟩
    have hm : y ^ (th₁ + δ) ≤ y ^ (th + δ) := Real.rpow_le_rpow_of_exponent_le hy1 (by linarith)
    calc C₁ * y ^ (th₁ + δ) ≤ C₁ * y ^ (th + δ) := mul_le_mul_of_nonneg_left hm (by linarith)
      _ ≤ (C₁ + C₂) * y ^ (th + δ) := mul_le_mul_of_nonneg_right (by linarith) hP
  · push Not at hs
    obtain ⟨hf, hb⟩ := hb₂ y (le_trans (le_max_right _ _) hy) s hs.le hhi D E hD hE hDE hNC
    refine ⟨hf, hb.trans ?_⟩
    have hm : y ^ (th₂ + δ) ≤ y ^ (th + δ) := Real.rpow_le_rpow_of_exponent_le hy1 (by linarith)
    calc C₂ * y ^ (th₂ + δ) ≤ C₂ * y ^ (th + δ) := mul_le_mul_of_nonneg_left hm (by linarith)
      _ ≤ (C₁ + C₂) * y ^ (th + δ) := mul_le_mul_of_nonneg_right (by linarith) hP

theorem min_le_of_mul_le (A B c : ℝ) (hc : 0 ≤ c) (hAB : A * B ≤ c ^ 2) :
    min A B ≤ c := by
  by_contra hcon
  push Not at hcon
  have h1 : c < A := lt_of_lt_of_le hcon (min_le_left _ _)
  have h2 : c < B := lt_of_lt_of_le hcon (min_le_right _ _)
  have : c * c < A * B := mul_lt_mul'' h1 h2 hc hc
  nlinarith

