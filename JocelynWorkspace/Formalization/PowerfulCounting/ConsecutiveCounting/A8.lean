  classical
  intro d
  simp_rw [MvPolynomial.coeff_mul]
  apply continuous_finsetSum
  intro p hp
  exact (hP p.1).mul (hQ p.2)
lemma eG {T:Type*} [TopologicalSpace T]
    {P:T→ aa (Fin 2) ℝ} (hP:bl P) (n:ℕ):
