  have hR : 24 * (k : ℝ) + 5 ≤ Real.sqrt (580 * (k : ℝ) ^ 2 + 276 * (k : ℝ) + 9) := by
    apply Real.le_sqrt_of_sq_le
    nlinarith
  have hRu : Real.sqrt (580 * (k : ℝ) ^ 2 + 276 * (k : ℝ) + 9) ≤ 25 * (k : ℝ) + 6 := by
    have h1 : Real.sqrt (580 * (k : ℝ) ^ 2 + 276 * (k : ℝ) + 9) ≤ Real.sqrt ((25 * (k : ℝ) + 6) ^ 2) :=
      Real.sqrt_le_sqrt (by nlinarith)
    rw [Real.sqrt_sq (by positivity)] at h1
    exact h1
  have hlow : (1 : ℝ) / (k : ℝ) + 1 / (2 * (k : ℝ) ^ 2) ≤
      ((3 * (k : ℝ) + 2) * ((2 * (k : ℝ) - 3 + Real.sqrt (580 * (k : ℝ) ^ 2 + 276 * (k : ℝ) + 9)) /
        (9 * (k : ℝ) * (2 * (k : ℝ) + 1))) - 2) / (2 * (k : ℝ) + 1) := by
    have hs : (26 * (k : ℝ) + 2) / (9 * (k : ℝ) * (2 * (k : ℝ) + 1)) ≤
        (2 * (k : ℝ) - 3 + Real.sqrt (580 * (k : ℝ) ^ 2 + 276 * (k : ℝ) + 9)) /
          (9 * (k : ℝ) * (2 * (k : ℝ) + 1)) := by
