  have hq:q ≠ 0:=right_ne_zero_of_mul hpq
  have h1:p.natDegree+q.natDegree=n:=by
    rw [← Polynomial.natDegree_mul hp hq,h,fu _ _ hc]
  have h2:p.natTrailingDegree+q.natTrailingDegree=n:=by
    rw [← fv hp hq,h,dV,ft hc]
  have h3:p.natTrailingDegree≤ p.natDegree:=c1 p
  have h4:q.natTrailingDegree≤ q.natDegree:=c1 q
  intro k hk
  rcases lt_or_gt_of_ne hk with hlt | hgt
  · exact fq (by omega)
  · exact fs hgt
