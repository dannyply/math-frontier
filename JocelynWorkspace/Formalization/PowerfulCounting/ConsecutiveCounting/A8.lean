    · exact hd0
    · exact he0
    · exact hu
    · exact hv
  · exfalso
    rw [hc,hd] at hw0
    have hneg:w 0= -z 0:=by linear_combination-hw0-hz0
    have hzp:=hzpos 0
    have hwp:=hwpos 0
    omega
lemma pQ (k:ℕ) (v a b:ℤ) (L V:ℝ)
    (hv:0≤ v) (hL:0≤ L) (hV:(v:ℝ)≤ V)
    (ha:|(a:ℝ)|≤ L) (hb:|(b:ℝ)|≤ L)
    (i:Fin (k+1)):
    |((bO k v a b i:ℤ):ℝ)|≤ L^k*V:=by
  have hvR:(0:ℝ)≤ v:=by exact_mod_cast hv
  have hidx:i.val≤ k:=Nat.le_of_lt_succ i.isLt
  have hsum:k-i.val+i.val=k:=cA hidx
  change |((v*a^(k-i.val)*b^i.val:ℤ):ℝ)|≤ _
  simp only [Int.cast_mul,Int.cast_pow,abs_mul,abs_pow,abs_of_nonneg hvR]
  calc
    (v:ℝ)*|(a:ℝ)|^(k-i.val)*|(b:ℝ)|^i.val
