  y ^ ((1 : ℝ) / (2 * (k : ℝ) ^ 2)) < E ∧
  y ^ ((1 : ℝ) / (2 * (k : ℝ) ^ 2)) * D ^ k < y ∧
  y ^ ((1 : ℝ) / (2 * (k : ℝ) ^ 2)) * E ^ k < y

private def Bihom (G : MvPolynomial (Fin 4) ℤ) (a b : ℕ) : Prop :=
  ∀ q ∈ G.support, q 0 + q 1 = a ∧ q 2 + q 3 = b

private def AbsIrred {σ : Type} (G : MvPolynomial σ ℤ) : Prop :=
  Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G)

private noncomputable def m0K (k : ℕ) (s : ℝ) : ℝ :=
