        sideLength ((M:ℝ)/
          (4*((2:ℝ)^k*(1+(k:ℝ)*(2:ℝ)^k))*(x/E^k)))
          ((A8HighFPriceCellTuple.rhoK D E M j)^k)
          (4*(2:ℝ)^k*(x/D^k)) q.P 1 ∧
      MvPolynomial.eval ![(z.1.1:ℤ),(z.1.2:ℤ),
        (z.2.1:ℤ),(z.2.2:ℤ)] G=0}
  have hsub : HighCellK k x D E M j G ⊆ S0 := by
    rintro z ⟨hz,hzero⟩
    have hc := hcover z hz
    rcases hz with ⟨hbox,_,_⟩
    rcases hbox with ⟨hd,he,hu,hv,hshift,_,_,_,_,_,_⟩
    have hshiftZ :
        ((z.1.2^k*z.2.2:ℕ):ℤ)=((z.1.1^k*z.2.1:ℕ):ℤ)+1 := by
      exact_mod_cast hshift
    exact ⟨hd,he,hu,hv,hshiftZ,hc.1,hc.2.1,hc.2.2.1,hc.2.2.2,hzero⟩
  have hcard : ((HighCellK k x D E M j G).ncard:ℝ)≤
      2*|c| *Δ^3*H^(1/Δ)*(Real.log H+Δ) := by
    have hn := Set.ncard_le_ncard hsub hTr.1
    have hnr : ((HighCellK k x D E M j G).ncard:ℝ)≤(S0.ncard:ℝ) := by
      exact_mod_cast hn
    exact hnr.trans hTr.2
  refine ⟨hTr.1.subset hsub,hcard.trans ?_⟩
  exact A8HighFPriceInternal.high_numeric_priceK
    k thr N c η x Δ L T hk hthr hη hx hL hT hδR hδcap hLcap hTcap

end A8HighFPriceCellPrice

namespace A8HighFPriceSum
private theorem high_union_sum_from_pricesK
    {α γ : Type*} (k thr N : ℕ)
    (hk : 1≤ k) (hthr : 2*k+1≤ thr)
    (J : Finset ℕ) (S : ℕ→Finset γ)
    (U : ℕ→Set α) (V : ℕ→γ→Set α)
    (m RD RU Ascale Ccell xη : ℝ)
    (L T : ℕ→ℝ)
    (hm : 0 < m) (hRD : 0<RD) (hRU : 0<RU)
    (hAscale : 1≤ Ascale) (hCcell : 0≤ Ccell) (hxη : 0≤ xη)
    (hcard : (J.card:ℝ)≤4*m)
    (hL : ∀ j∈J, 0≤ L j) (hT : ∀ j∈J, 0≤ T j)
    (hLm : (∑ j∈J, (L j)^2)≤ Ascale*RD)
    (hTm : (∑ j∈J, (T j)^2)≤ Ascale*RU)
    (hUfin : ∀ j∈J, (U j).Finite)
    (hVfin : ∀ j∈J, ∀ G∈S j, (V j G).Finite)
    (hcover : ∀ j∈J, ∀ z∈U j, ∃ G∈S j, z∈V j G)
    (hScard : ∀ j∈J, (S j).card≤ N)
    (hprice : ∀ j∈J, ∀ G∈S j,
      ((V j G).ncard:ℝ)≤ Ccell*xη*(1+((L j)^k*T j)^((1:ℝ)/(thr:ℝ)))) :
    let p : ℝ := (k:ℝ)/(2*(thr:ℝ))
    let q : ℝ := (1:ℝ)/(2*(thr:ℝ))
    (∑ j∈J, ((U j).ncard:ℝ))≤
      10*(N:ℝ)*Ccell*xη*Ascale*
        (m+m^(1-p-q)*RD^p*RU^q) := by
  classical
  let p : ℝ := (k:ℝ)/(2*(thr:ℝ))
  let q : ℝ := (1:ℝ)/(2*(thr:ℝ))
  have hfactor0 (j : ℕ) (hj : j∈J) : 0≤
      Ccell*xη*(1+((L j)^k*T j)^((1:ℝ)/(thr:ℝ))) := by
    have hbase : 0≤(L j)^k*T j :=
      mul_nonneg (pow_nonneg (hL j hj) k) (hT j hj)
    positivity
  have hlocal (j : ℕ) (hj : j∈J) :
      ((U j).ncard:ℝ)≤
        (N:ℝ)*Ccell*xη*
          (1+((L j)^k*T j)^((1:ℝ)/(thr:ℝ))) := by
    let W : γ→Set α := fun G => if G∈S j then V j G else ∅
    have hWfin : ∀ G, (W G).Finite := by
      intro G
      by_cases hGS : G∈S j
      · simpa [W,hGS] using hVfin j hj G hGS
      · simp [W,hGS]
    have hWcover : ∀ z∈U j, ∃ G∈S j, z∈W G := by
      intro z hz
      obtain ⟨G,hGS,hzG⟩ := hcover j hj z hz
      exact ⟨G,hGS,by simpa [W,hGS] using hzG⟩
    have hcovW := A8HighFPriceCardCover.ncard_le_sum_of_finite_cover
      (S j) (U j) W (hUfin j hj) hWfin hWcover
    have heq : (∑ G∈S j, ((W G).ncard:ℝ)) =
        ∑ G∈S j, ((V j G).ncard:ℝ) := by
      apply Finset.sum_congr rfl
      intro G hGS
      simp [W,hGS]
    have hcov : ((U j).ncard:ℝ)≤
        ∑ G∈S j, ((V j G).ncard:ℝ) := by
      rw [←heq]
      exact hcovW
    have hcardR : ((S j).card:ℝ)≤ N := by exact_mod_cast hScard j hj
    calc
      ((U j).ncard:ℝ)≤
          ∑ G∈S j, ((V j G).ncard:ℝ) := hcov
      _ ≤ ∑ G∈S j,
          Ccell*xη*(1+((L j)^k*T j)^((1:ℝ)/(thr:ℝ))) :=
        Finset.sum_le_sum (fun G hGS => hprice j hj G hGS)
      _ = ((S j).card:ℝ)*
          (Ccell*xη*(1+((L j)^k*T j)^((1:ℝ)/(thr:ℝ)))) := by
        simp only [Finset.sum_const,nsmul_eq_mul]
      _ ≤ (N:ℝ)*
          (Ccell*xη*(1+((L j)^k*T j)^((1:ℝ)/(thr:ℝ)))) :=
        mul_le_mul_of_nonneg_right hcardR (hfactor0 j hj)
      _ = _ := by ring
  have htotal :
      (∑ j∈J, ((U j).ncard:ℝ))≤
        ((N:ℝ)*Ccell*xη)*
          (∑ j∈J, (1+((L j)^k*T j)^((1:ℝ)/(thr:ℝ)))) := by
    calc
      _ ≤ ∑ j∈J,
          (N:ℝ)*Ccell*xη*
            (1+((L j)^k*T j)^((1:ℝ)/(thr:ℝ))) :=
        Finset.sum_le_sum hlocal
      _ = _ := by rw [Finset.mul_sum]
  have hsum := A8HighFPriceHolder.mixed_raw_sumK
    k thr hk hthr J m RD RU Ascale L T hm hRD hRU hAscale
    hcard hL hT hLm hTm
  dsimp only at hsum
  calc
    (∑ j∈J, ((U j).ncard:ℝ))≤
        ((N:ℝ)*Ccell*xη)*
          (10*Ascale*(m+m^(1-p-q)*RD^p*RU^q)) :=
      htotal.trans (mul_le_mul_of_nonneg_left hsum (by positivity))
    _ = 10*(N:ℝ)*Ccell*xη*Ascale*
          (m+m^(1-p-q)*RD^p*RU^q) := by ring
end A8HighFPriceSum

namespace A8HighFPriceCeil
private def sK (k : ℕ) : ℝ :=
  let kr : ℝ := k
  (2*kr-3+Real.sqrt (580*kr^2+276*kr+9))/(9*kr*(2*kr+1))
private def m0K (k : ℕ) (s : ℝ) : ℝ :=
  (9:ℝ)/8*s*(2-(k:ℝ)*s)

private theorem sK_lower (k : ℕ) (hk : 5 ≤ k) :
    (4:ℝ)/(3*(k:ℝ)) ≤ sK k := by
  let kr : ℝ := k
  have hkr : 5≤ kr := by dsimp [kr]; exact_mod_cast hk
  have hkr0 : 0<kr := by linarith only [hkr]
  let rad : ℝ := 580*kr^2+276*kr+9
  have hrad : 0≤ rad := by dsimp [rad]; positivity
  have hsqr : (Real.sqrt rad)^2=rad := Real.sq_sqrt hrad
  have hq : 0≤4*kr^2-16*kr-9 := by
    have hz : 3≤ kr-2 := by linarith only [hkr]
    have hzsq : 9≤(kr-2)^2 := by
      nlinarith only [hz,sq_nonneg (kr-5)]
    nlinarith only [hzsq]
  have hroot : 22*kr+15≤ Real.sqrt rad := by
    have hsqrt0 := Real.sqrt_nonneg rad
    dsimp [rad] at hsqr
    nlinarith only [hsqr,hq,hsqrt0,hkr]
  have hden1 : 0<3*kr := by positivity
  have hden2 : 0<9*kr*(2*kr+1) := by positivity
  change 4/(3*kr)≤
    (2*kr-3+Real.sqrt rad)/(9*kr*(2*kr+1))
  apply (div_le_div_iff₀ hden1 hden2).mpr
  have hmul := mul_le_mul_of_nonneg_left hroot
    (show 0≤3*kr by positivity)
  nlinarith only [hmul]
end A8HighFPriceCeil

namespace A8HighFPriceCeil
private def NonCollarK (k : ℕ) (x D E : ℝ) : Prop :=
  D*E < x^((2:ℝ)/(k:ℝ)) ∧
  x^((1:ℝ)/(2*(k:ℝ)^2)) < D ∧
  x^((1:ℝ)/(2*(k:ℝ)^2)) < E ∧
  x^((1:ℝ)/(2*(k:ℝ)^2))*D^k < x ∧
  x^((1:ℝ)/(2*(k:ℝ)^2))*E^k < x

private theorem noncollar_scale_caps (k : ℕ) (x D E : ℝ)
    (hk : 1≤ k) (hx : 2≤ x) (hD : 0<D) (hE : 0<E)
    (hNC : NonCollarK k x D E) :
    1≤ D ∧ 1≤ E ∧ D≤ x ∧ E≤ x ∧
      x/D^k≤ x ∧ x/E^k≤ x := by
  have hx0 : 0<x := by linarith only [hx]
  have hx1 : 1≤ x := by linarith only [hx]
  have hkR : (0:ℝ)<k := by exact_mod_cast (show 0<k by omega)
  have hexp : (0:ℝ)<1/(2*(k:ℝ)^2) := by positivity
  have hpow1 : 1≤ x^((1:ℝ)/(2*(k:ℝ)^2)) :=
    Real.one_le_rpow hx1 hexp.le
  have hD1 : 1≤ D := hpow1.trans hNC.2.1.le
  have hE1 : 1≤ E := hpow1.trans hNC.2.2.1.le
  have hDpow : D^k≤ x := by
    have hp := mul_le_mul_of_nonneg_right hpow1 (pow_nonneg hD.le k)
    nlinarith only [hp,hNC.2.2.2.1]
  have hEpow : E^k≤ x := by
    have hp := mul_le_mul_of_nonneg_right hpow1 (pow_nonneg hE.le k)
    nlinarith only [hp,hNC.2.2.2.2]
  have hDself : D≤ D^k := by
    have hp := pow_le_pow_right₀ hD1 hk
    simpa only [pow_one] using hp
  have hEself : E≤ E^k := by
    have hp := pow_le_pow_right₀ hE1 hk
    simpa only [pow_one] using hp
  refine ⟨hD1,hE1,hDself.trans hDpow,hEself.trans hEpow,?_,?_⟩
  · apply (div_le_iff₀ (pow_pos hD k)).mpr
    have hp : (1:ℝ)≤ D^k := one_le_pow₀ hD1
    nlinarith only [mul_le_mul_of_nonneg_left hp hx0.le]
  · apply (div_le_iff₀ (pow_pos hE k)).mpr
    have hp : (1:ℝ)≤ E^k := one_le_pow₀ hE1
    nlinarith only [mul_le_mul_of_nonneg_left hp hx0.le]
end A8HighFPriceCeil

namespace A8HighFPriceCeil
private theorem actualM_guards
    (k : ℕ) (hk5 : 5≤ k) (hk123 : k≤123)
    (s δ x : ℝ) (hslo : sK k ≤ s)
    (hshi : s≤14/(9*(k:ℝ)))
    (hδ0 : 0<δ) (hδ : δ<1/4000)
    (hx : (2:ℝ)^4000≤ x) :
    let t : ℝ := 2-(k:ℝ)*s
    let M : ℕ := ⌈x^(A8HighFPriceCeil.m0K k s+δ)⌉₊
    1≤ M ∧ (M:ℝ)≤ x ∧ (M:ℝ)≤ x^s ∧ (M:ℝ)≤ x^t := by
  let kr : ℝ := k
  let t : ℝ := 2-kr*s
  let m : ℝ := m0K k s
  let a : ℝ := m+δ
  let γ : ℝ := 1/4000
  let M : ℕ := ⌈x^a⌉₊
  have hkrlo : 5≤ kr := by dsimp [kr]; exact_mod_cast hk5
  have hkrhi : kr≤123 := by dsimp [kr]; exact_mod_cast hk123
  have hkr0 : 0<kr := by linarith only [hkrlo]
  have hx0 : 0<x := lt_of_lt_of_le (by positivity) hx
  have hx1 : 1≤ x :=
    (one_le_pow₀ (by norm_num : (1:ℝ)≤2)).trans hx
  have hsbase := (sK_lower k hk5).trans hslo
  have hks : 4/3≤ kr*s := by
    have hp := mul_le_mul_of_nonneg_right hsbase
      (show 0≤3*kr by positivity)
    have heq : ((4:ℝ)/(3*kr))*(3*kr)=4 := by
      field_simp [hkr0.ne']
    rw [heq] at hp
    nlinarith only [hp]
  have hs0 : 0≤ s := by
    have ht : 0≤4/(3*kr) := by positivity
    linarith only [hsbase,ht]
  have hksup : kr*s≤14/9 := by
    have hp := mul_le_mul_of_nonneg_right hshi hkr0.le
    have heq : (14/(9*kr))*kr=(14:ℝ)/9 := by
      field_simp [hkr0.ne']
    rw [heq] at hp
    simpa only [mul_comm s kr] using hp
  have hslo0 : 4/369≤ s := by
    have hp := mul_le_mul_of_nonneg_left hkrhi hs0
    nlinarith only [hks,hp]
  have hshi0 : s≤14/45 := by
    have hp := mul_le_mul_of_nonneg_right hkrlo hs0
    nlinarith only [hp,hksup]
  have htlo : 4/9≤ t := by dsimp [t]; linarith only [hksup]
  have htup : t≤2/3 := by dsimp [t]; linarith only [hks]
  have ht0 : 0≤ t := by linarith only [htlo]
  have hm0 : 0≤ m := by dsimp [m,m0K,t]; positivity
  have hms : m≤3*s/4 := by
    have hp := mul_le_mul_of_nonneg_left htup
      (show 0≤(9:ℝ)/8*s by positivity)
    dsimp [m,m0K,t]
    nlinarith only [hp]
  have hmt : m≤7*t/20 := by
    have hscoef : (9:ℝ)/8*s≤7/20 := by
      nlinarith only [hshi0]
    have hp := mul_le_mul_of_nonneg_right hscoef ht0
    dsimp [m,m0K,t]
    nlinarith only [hp]
  have hm1 : m≤7/30 := by
    nlinarith only [hms,hshi0]
  have hδγ : δ+γ<1/2000 := by dsimp [γ]; linarith only [hδ]
  have hδγle : δ+γ ≤ 1/2000 := hδγ.le
  have hagapS : a+γ ≤ s := by
    have hgapS : (1:ℝ)/2000 ≤ s/4 := by
      linarith only [hslo0]
    dsimp [a]
    calc
      m+δ+γ = m+(δ+γ) := by ring
      _ ≤ 3*s/4+s/4 :=
        add_le_add hms (hδγle.trans hgapS)
      _ = s := by ring
  have hagapT : a+γ ≤ t := by
    have hgapT : (1:ℝ)/2000 ≤ 13*t/20 := by
      linarith only [htlo]
    dsimp [a]
    calc
      m+δ+γ = m+(δ+γ) := by ring
      _ ≤ 7*t/20+13*t/20 :=
        add_le_add hmt (hδγle.trans hgapT)
      _ = t := by ring
  have hagap1 : a+γ ≤ 1 := by
    have hgap1 : (1:ℝ)/2000 ≤ 1-7/30 := by norm_num
    dsimp [a]
    calc
      m+δ+γ = m+(δ+γ) := by ring
      _ ≤ 7/30+(1-7/30) :=
        add_le_add hm1 (hδγle.trans hgap1)
      _ = 1 := by ring
  have ha0 : 0≤ a := by dsimp [a]; linarith only [hm0,hδ0]
  have hroot : 2≤ x^γ := by
    have hxeq : (x^γ)^(4000:ℕ)=x := by
      rw [←Real.rpow_natCast,←Real.rpow_mul hx0.le]
      dsimp [γ]
      norm_num
    by_contra hh
    have hlt : x^γ<2 := lt_of_not_ge hh
    have hp := pow_lt_pow_left₀ hlt
      (Real.rpow_nonneg hx0.le _) (by norm_num : (4000:ℕ)≠0)
    rw [hxeq] at hp
    exact (not_lt_of_ge hx) hp
  have hMlo : 1≤ M := by
    have hp : 1≤ x^a := Real.one_le_rpow hx1 ha0
    have hc : x^a≤(M:ℝ) := Nat.le_ceil _
    have hr : (1:ℝ)≤ M := hp.trans hc
    exact_mod_cast hr
  have hMup : (M:ℝ)≤2*x^a := by
    have hc := Nat.ceil_lt_add_one (Real.rpow_nonneg hx0.le a)
    have hp : 1≤ x^a := Real.one_le_rpow hx1 ha0
    dsimp [M]
    linarith only [hc,hp]
  have hMpow : (M:ℝ)≤ x^(a+γ) := by
    have hp : 2*x^a ≤ x^(a+γ) := by
      calc
        2*x^a = x^a*2 := by ring
        _ ≤ x^a*x^γ :=
          mul_le_mul_of_nonneg_left hroot (Real.rpow_nonneg hx0.le a)
        _ = x^(a+γ) := (Real.rpow_add hx0 a γ).symm
    exact hMup.trans hp
  refine ⟨hMlo,?_,?_,?_⟩
  · calc
      (M:ℝ)≤ x^(a+γ) := hMpow
      _ ≤ x^(1:ℝ) := Real.rpow_le_rpow_of_exponent_le hx1 hagap1
      _ = x := by rw [Real.rpow_one]
  · exact hMpow.trans (Real.rpow_le_rpow_of_exponent_le hx1 hagapS)
  · exact hMpow.trans (Real.rpow_le_rpow_of_exponent_le hx1 hagapT)
end A8HighFPriceCeil

namespace A8HighFPriceDoubleMoment
open A8HighFPricePowGrid
open A8HighFPriceMoments

private theorem cells_card (D E : ℝ) (M : ℕ) :
    ((A8HighFPricePowGrid.cells D E M).card : ℝ) ≤ 3*(M:ℝ)+1 := by
  classical
  have hc : (A8HighFPricePowGrid.cells D E M).card ≤ 3*M+1 :=
    (Finset.card_filter_le _ _).trans_eq (Finset.card_range _)
  exact_mod_cast hc

private theorem double_momentK
    (k : ℕ) (hk : 1≤ k)
    (κ₁ κ₂ η : ℝ) (hκ₁ : 1≤κ₁) (hκ₂ : 1≤κ₂) (hη : 0<η) :
    ∃ C : ℝ, 0<C ∧
    ∀ (x D E : ℝ), 8≤ x → 1≤ D → 1≤ E → D≤2*x → E≤2*x →
    let U : ℝ := x/D^k
    let V : ℝ := x/E^k
    0<U → 0<V → U≤2*x → V≤2*x →
    ∀ (M : ℕ), 1≤ M → (M:ℝ)≤ D*E → (M:ℝ)≤ U*V →
    ∀ (b c : ℕ→ℤ×ℤ),
      (∀ j∈A8HighFPricePowGrid.cells D E M, b j≠0) →
      (∀ j∈A8HighFPricePowGrid.cells D E M, c j≠0) →
    (∑ j∈A8HighFPricePowGrid.cells D E M,
      (A8HighFPriceMoments.length ((M:ℝ)/(κ₁*D))
        (A8HighFPricePowGrid.rho D E M j) (2*E) (b j))^2) ≤
        C*x^η*(D*E+(D^2+E^2)/(M:ℝ)) ∧
    (∑ j∈A8HighFPricePowGrid.cells D E M,
      (A8HighFPriceMoments.length ((M:ℝ)/(κ₂*V))
        ((A8HighFPricePowGrid.rho D E M j)^k) (2*U) (c j))^2) ≤
        C*x^η*(U*V+(U^2+V^2)/(M:ℝ)) := by
  classical
  obtain ⟨C1,hC1,h1⟩ :=
    A8HighFPriceMoments.raw_grid_moment_W κ₁ 2 η hκ₁ (by norm_num) hη
  obtain ⟨C2,hC2,h2⟩ :=
    A8HighFPriceMoments.raw_grid_moment_W κ₂ ((2:ℝ)^k) η hκ₂
      (one_le_pow₀ (by norm_num : (1:ℝ)≤2)) hη
  let C : ℝ := max C1 C2
  have hC : 0<C := hC1.trans_le (le_max_left _ _)
  refine ⟨C,hC,?_⟩
  intro x D E hx hD1 hE1 hDx hEx U V hU hV hUx hVx M hM hMDE hMUV b c hb hc
  have hx0 : 0<x := by linarith only [hx]
  have hD : 0<D := by linarith only [hD1]
  have hE : 0<E := by linarith only [hE1]
  have hscale : (D/E)^k=V/U := by
    dsimp [U,V]
    rw [div_pow]
    field_simp [hD.ne',hE.ne',hx0.ne']

  have hfirstScale : (D/E)^1=D/E := by simp
  obtain ⟨hsp1,hbound1⟩ := A8HighFPricePowGrid.power_grid 1 M D E E D
    (by omega) hM hD hE hE hD hfirstScale
  obtain ⟨hsp2,hbound2⟩ := A8HighFPricePowGrid.power_grid k M D E U V
    hk hM hD hE hU hV hscale
  have hcard := cells_card D E M
  have hfirst := h1 x D E hx hD hE hDx hEx M hM hMDE
    (A8HighFPricePowGrid.cells D E M) (A8HighFPricePowGrid.rho D E M)
    hcard (by simpa only [pow_one] using hsp1)
      (by simpa only [pow_one] using hbound1) b hb
  have hsecond := h2 x V U hx hV hU hVx hUx M hM
    (by rw [mul_comm]; exact hMUV)
    (A8HighFPricePowGrid.cells D E M)
    (fun j => (A8HighFPricePowGrid.rho D E M j)^k)
    hcard hsp2 hbound2 c hc
  have hsecond' :
      (∑ j∈A8HighFPricePowGrid.cells D E M,
        (A8HighFPriceMoments.length ((M:ℝ)/(κ₂*V))
          ((A8HighFPricePowGrid.rho D E M j)^k) (2*U) (c j))^2) ≤
        C2*x^η*(U*V+(U^2+V^2)/(M:ℝ)) := by
    simpa only [mul_comm V U, add_comm (V^2) (U^2)] using hsecond
  refine ⟨?_,?_⟩
  · exact hfirst.trans
      (mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_right (le_max_left C1 C2)
          (Real.rpow_nonneg hx0.le η))
        (by positivity))
  · exact hsecond'.trans
      (mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_right (le_max_right C1 C2)
          (Real.rpow_nonneg hx0.le η))
        (by positivity))
end A8HighFPriceDoubleMoment

namespace A8HighFPriceBasisPrice
open FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry
private abbrev Poly := MvPolynomial (Fin 4) ℤ
