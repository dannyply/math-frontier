namespace A8AdapterCopy
namespace A7QuarticCore
open A7Inherited
private abbrev Cols (A B : ℕ) := Fin (A + 1) × Fin (B + 1)
private def jetBox (k A B : ℕ) : Finset (ℕ × ℕ) :=
  (Finset.range (A+k*B+1)).product (Finset.range (B+1))
private def exponentPair (d : Fin 2 →₀ ℕ) : ℕ × ℕ := (d 0,d 1)
private theorem exponentPair_injective : Function.Injective exponentPair := by
  intro d e h
  have h0 := congrArg Prod.fst h
  have h1 := congrArg Prod.snd h
  ext i
  fin_cases i
  · exact h0
  · exact h1
private theorem jetExp_pair (d : Fin 2 →₀ ℕ) :
    jetExp (exponentPair d) = d := by
  ext i
  fin_cases i <;> simp [jetExp,exponentPair]
private theorem pair_jetExp (p : ℕ × ℕ) :
    exponentPair (jetExp p) = p := by
  ext <;> simp [jetExp,exponentPair]

private theorem polynomial_evaluation_box (k A B : ℕ)
    (P : MvPolynomial (Fin 2) ℝ) (a b : ℝ)
    (hsupport : ∀ d ∈ P.support, d 0 ≤ A+k*B ∧ d 1 ≤ B) :
    MvPolynomial.eval (fun i : Fin 2 => if i = 0 then a else b) P =
      ∑ p : {p : ℕ × ℕ // p ∈ jetBox k A B},
        a^p.val.1*b^p.val.2*MvPolynomial.coeff (jetExp p.val) P := by
  classical
  let S := P.support.image exponentPair
  let term : ℕ × ℕ → ℝ := fun p =>
    MvPolynomial.coeff (jetExp p) P*a^p.1*b^p.2
  have heval :
      MvPolynomial.eval (fun i : Fin 2 => if i = 0 then a else b) P =
        ∑ d ∈ P.support, MvPolynomial.coeff d P*a^(d 0)*b^(d 1) := by
    rw [MvPolynomial.eval_eq']
    apply Finset.sum_congr rfl
    intro d hd
    simp [Fin.prod_univ_two,mul_assoc]
  have hS : S ⊆ jetBox k A B := by
    intro p hp
    obtain ⟨d,hd,rfl⟩ := Finset.mem_image.mp hp
    have hh := hsupport d hd
    exact Finset.mem_product.mpr
      ⟨Finset.mem_range.mpr (by simpa [exponentPair] using Nat.lt_succ_of_le hh.1),
       Finset.mem_range.mpr (by simpa [exponentPair] using Nat.lt_succ_of_le hh.2)⟩
  have hsumS :
      MvPolynomial.eval (fun i : Fin 2 => if i = 0 then a else b) P =
        ∑ p ∈ S, term p := by
    rw [heval]
    dsimp [S]
    rw [Finset.sum_image]
    · apply Finset.sum_congr rfl
      intro d hd
      change MvPolynomial.coeff d P*a^(d 0)*b^(d 1) =
        MvPolynomial.coeff (jetExp (exponentPair d)) P*a^(d 0)*b^(d 1)
      rw [jetExp_pair]
    · intro d hd e he hde
      exact exponentPair_injective hde
  have hext : (∑ p ∈ S,term p) = ∑ p ∈ jetBox k A B,term p := by
    apply Finset.sum_subset hS
    intro p hp hnot
    have hz : MvPolynomial.coeff (jetExp p) P = 0 := by
      by_contra h
      apply hnot
      exact Finset.mem_image.mpr
        ⟨jetExp p,MvPolynomial.mem_support_iff.mpr h,pair_jetExp p⟩
    simp [term,hz]
  rw [hsumS,hext]
  have hh := Finset.sum_coe_sort (jetBox k A B) term
  first
  | simpa only [term,mul_comm,mul_left_comm,mul_assoc] using hh
  | simpa only [term,mul_comm,mul_left_comm,mul_assoc] using hh.symm

private def graphPoly (k : ℕ) (c : ℝ) (i j : ℕ) :
    MvPolynomial (Fin 2) ℝ :=
  (MvPolynomial.C c + MvPolynomial.X 0) ^ i *
    ((MvPolynomial.C c + MvPolynomial.X 0) ^ k +
      MvPolynomial.X 1) ^ j

private theorem graphPoly_eval (k : ℕ) (c a b : ℝ) (i j : ℕ) :
    MvPolynomial.eval (fun t : Fin 2 => if t = 0 then a else b)
      (graphPoly k c i j) = (c + a) ^ i * ((c + a) ^ k + b) ^ j := by
  simp [graphPoly]

private theorem graphPoly_support (k : ℕ) (c : ℝ) (i j : ℕ)
    (d : Fin 2 →₀ ℕ) (hd : d ∈ (graphPoly k c i j).support) :
    d 0 ≤ i + k * j ∧ d 1 ≤ j := by
  let Q : MvPolynomial (Fin 2) ℝ :=
    MvPolynomial.C c + MvPolynomial.X 0
  let G : MvPolynomial (Fin 2) ℝ := Q ^ k + MvPolynomial.X 1
  have hQ0 : MvPolynomial.degreeOf (0 : Fin 2) Q ≤ 1 := by
    dsimp [Q]
    apply (MvPolynomial.degreeOf_add_le _ _ _).trans
    exact max_le (by simp) (by simp [])
  have hQ1 : MvPolynomial.degreeOf (1 : Fin 2) Q ≤ 0 := by
    dsimp [Q]
    apply (MvPolynomial.degreeOf_add_le _ _ _).trans
    exact max_le (by simp) (by simp [MvPolynomial.degreeOf_X])
  have hG0 : MvPolynomial.degreeOf (0 : Fin 2) G ≤ k := by
    dsimp [G]
    apply (MvPolynomial.degreeOf_add_le _ _ _).trans
    apply max_le
    · exact (MvPolynomial.degreeOf_pow_le (0 : Fin 2) Q k).trans
        (by simpa using Nat.mul_le_mul_left k hQ0)
    · simp [MvPolynomial.degreeOf_X]
  have hG1 : MvPolynomial.degreeOf (1 : Fin 2) G ≤ 1 := by
    dsimp [G]
    apply (MvPolynomial.degreeOf_add_le _ _ _).trans
    apply max_le
    · have hh := MvPolynomial.degreeOf_pow_le (1 : Fin 2) Q k
      have hm := Nat.mul_le_mul_left k hQ1
      omega
    · simp []
  have hP0 :
      MvPolynomial.degreeOf (0 : Fin 2) (graphPoly k c i j) ≤ i + k * j := by
    change MvPolynomial.degreeOf (0 : Fin 2) (Q ^ i * G ^ j) ≤ _
    apply (MvPolynomial.degreeOf_mul_le _ _ _).trans
    have hi := (MvPolynomial.degreeOf_pow_le (0 : Fin 2) Q i).trans
      (Nat.mul_le_mul_left i hQ0)
    have hj := (MvPolynomial.degreeOf_pow_le (0 : Fin 2) G j).trans
      (Nat.mul_le_mul_left j hG0)
    simpa [Nat.mul_comm, Nat.mul_left_comm, Nat.mul_assoc] using
      Nat.add_le_add hi hj
  have hP1 :
      MvPolynomial.degreeOf (1 : Fin 2) (graphPoly k c i j) ≤ j := by
    change MvPolynomial.degreeOf (1 : Fin 2) (Q ^ i * G ^ j) ≤ _
    apply (MvPolynomial.degreeOf_mul_le _ _ _).trans
    have hi := (MvPolynomial.degreeOf_pow_le (1 : Fin 2) Q i).trans
      (Nat.mul_le_mul_left i hQ1)
    have hj := (MvPolynomial.degreeOf_pow_le (1 : Fin 2) G j).trans
      (Nat.mul_le_mul_left j hG1)
    simpa using Nat.add_le_add hi hj
  exact ⟨MvPolynomial.degreeOf_le_iff.mp hP0 d hd,
    MvPolynomial.degreeOf_le_iff.mp hP1 d hd⟩

private theorem graphPoly_continuous (k i j : ℕ) :
    A7Inherited.A1UniformTaylor.CoeffContinuous
      (fun c : ℝ => graphPoly k c i j) := by
  let Q : ℝ → MvPolynomial (Fin 2) ℝ :=
    fun c => MvPolynomial.C c + MvPolynomial.X 0
  have hQ : A7Inherited.A1UniformTaylor.CoeffContinuous Q :=
    A7Inherited.A1UniformTaylor.coeffContinuous_add
      (A7Inherited.A1UniformTaylor.coeffContinuous_C continuous_id)
      (A7Inherited.A1UniformTaylor.coeffContinuous_const _)
  have hG : A7Inherited.A1UniformTaylor.CoeffContinuous
      (fun c => Q c ^ k + MvPolynomial.X 1) :=
    A7Inherited.A1UniformTaylor.coeffContinuous_add
      (A7Inherited.A1UniformTaylor.coeffContinuous_pow hQ k)
      (A7Inherited.A1UniformTaylor.coeffContinuous_const _)
  simpa only [Q, graphPoly] using
    A7Inherited.A1UniformTaylor.coeffContinuous_mul
      (A7Inherited.A1UniformTaylor.coeffContinuous_pow hQ i)
      (A7Inherited.A1UniformTaylor.coeffContinuous_pow hG j)

private def coeffMass (k A B : ℕ) (c : ℝ) : ℝ :=
  1 + ∑ i ∈ Finset.range (A + 1), ∑ j ∈ Finset.range (B + 1),
    ∑ p ∈ jetBox k A B,
      |MvPolynomial.coeff (jetExp p) (graphPoly k c i j)|

private theorem coeffMass_pos (k A B : ℕ) (c : ℝ) :
    0 < coeffMass k A B c := by
  unfold coeffMass
  have hh : 0 ≤ ∑ i ∈ Finset.range (A + 1),
      ∑ j ∈ Finset.range (B + 1), ∑ p ∈ jetBox k A B,
        |MvPolynomial.coeff (jetExp p) (graphPoly k c i j)| :=
    Finset.sum_nonneg (fun i hi =>
      Finset.sum_nonneg (fun j hj =>
        Finset.sum_nonneg (fun p hp => abs_nonneg _)))
  linarith

private theorem coeffMass_continuous (k A B : ℕ) :
    Continuous (coeffMass k A B) := by
  unfold coeffMass
  apply continuous_const.add
  apply continuous_finsetSum
  intro i hi
  apply continuous_finsetSum
  intro j hj
  apply continuous_finsetSum
  intro p hp
  exact (graphPoly_continuous k i j (jetExp p)).abs

private theorem coeff_le_mass (k A B : ℕ) (c : ℝ)
    (i j : ℕ) (hi : i ≤ A) (hj : j ≤ B) (d : Fin 2 →₀ ℕ) :
    |MvPolynomial.coeff d (graphPoly k c i j)| ≤ coeffMass k A B c := by
  classical
  by_cases hd : MvPolynomial.coeff d (graphPoly k c i j) = 0
  · rw [hd, abs_zero]
    exact (coeffMass_pos k A B c).le
  have hsup := graphPoly_support k c i j d
    (MvPolynomial.mem_support_iff.mpr hd)
  have hmem : exponentPair d ∈ jetBox k A B := by
    exact Finset.mem_product.mpr
      ⟨Finset.mem_range.mpr (by
        simpa [exponentPair] using Nat.lt_succ_of_le
          (hsup.1.trans (Nat.add_le_add hi (Nat.mul_le_mul_left k hj)))),
       Finset.mem_range.mpr (by
        simpa [exponentPair] using Nat.lt_succ_of_le (hsup.2.trans hj))⟩
  have hp := Finset.single_le_sum
    (f := fun p => |MvPolynomial.coeff (jetExp p) (graphPoly k c i j)|)
    (fun p hp => abs_nonneg _) hmem
  have hjj := Finset.single_le_sum
    (f := fun j => ∑ p ∈ jetBox k A B,
      |MvPolynomial.coeff (jetExp p) (graphPoly k c i j)|)
    (fun j hj => Finset.sum_nonneg (fun p hp => abs_nonneg _))
    (Finset.mem_range.mpr (by omega : j < B + 1))
  have hii := Finset.single_le_sum
    (f := fun i => ∑ j ∈ Finset.range (B + 1),
      ∑ p ∈ jetBox k A B,
        |MvPolynomial.coeff (jetExp p) (graphPoly k c i j)|)
    (fun i hi => Finset.sum_nonneg (fun j hj =>
      Finset.sum_nonneg (fun p hp => abs_nonneg _)))
    (Finset.mem_range.mpr (by omega : i < A + 1))
  have hp' : |MvPolynomial.coeff d (graphPoly k c i j)| ≤
      ∑ p ∈ jetBox k A B,
        |MvPolynomial.coeff (jetExp p) (graphPoly k c i j)| := by
    simpa only [jetExp_pair] using hp
  exact (hp'.trans hjj).trans ((hii).trans (by
    unfold coeffMass
    exact le_add_of_nonneg_left zero_le_one))

private theorem graphPoly_uniform_coefficients (k A B : ℕ) :
    ∃ C₀ : ℝ, 0 < C₀ ∧
      ∀ c : ℝ, 0 ≤ c → c ≤ 2 →
      ∀ i j : ℕ, i ≤ A → j ≤ B →
      ∀ d : Fin 2 →₀ ℕ,
        |MvPolynomial.coeff d (graphPoly k c i j)| ≤ C₀ := by
  let S : Set ℝ := Set.Icc 0 2
  have hS : IsCompact S := isCompact_Icc
  have hne : S.Nonempty := ⟨0, by norm_num [S]⟩
  obtain ⟨z, hz, hmax⟩ := hS.exists_isMaxOn hne
    (coeffMass_continuous k A B).continuousOn
  refine ⟨coeffMass k A B z, coeffMass_pos k A B z, ?_⟩
  intro c hc0 hc2 i j hi hj d
  exact (coeff_le_mass k A B c i j hi hj d).trans
    (hmax ⟨hc0, hc2⟩)

private theorem jet_evaluation_det_bound (deg : ℕ)
    {I K : Type*} [Fintype I] [Fintype K]
    [DecidableEq I] [DecidableEq K]
    (V : Matrix I K ℝ) (C : Matrix K I ℝ)
    (e : K → ℕ × ℕ) (he : Function.Injective e)
    (m X C0 : ℝ) (hm : 0 < m) (hm1 : m ≤ 1)
    (hX : 1 ≤ X) (hC0 : 0 < C0)
    (hV : ∀ i k, |V i k| ≤
      (2 : ℝ)^(e k).1 * ((2 : ℝ) ^ (deg + 1))^(e k).2 *
        X^(-pairWeight m (e k)))
    (hC : ∀ k j, |C k j| ≤ C0) :
    |(V*C).det| ≤
      (Fintype.card K : ℝ)^(Fintype.card I) *
      ((Fintype.card I).factorial : ℝ) * C0^(Fintype.card I) *
      (∑ f : I → K, ∏ i : I, (2 : ℝ)^(e (f i)).1 *
        ((2 : ℝ) ^ (deg + 1))^(e (f i)).2) *
      X^(-((2*Real.sqrt (2*m)/3)*(Fintype.card I : ℝ)*
        Real.sqrt (Fintype.card I : ℝ)-5*(Fintype.card I : ℝ))) := by
  apply A1OriginalDeterminant.finite_weighted_det V C
    (fun k => pairWeight m (e k))
    (fun k => (2 : ℝ)^(e k).1 * ((2 : ℝ) ^ (deg + 1))^(e k).2)
    _ C0 X hX hC0
  · intro k
    positivity
  · exact hV
  · exact hC
  · intro f hf
    have hfi := nonzero_rows_injective C f hf
    exact injective_jet_weight m hm hm1 (e ∘ f) (he.comp hfi)

private theorem normalized_determinant (deg A B : ℕ) :
    ∃ C : ℝ, 0 < C ∧
      ∀ c m X : ℝ, 0 ≤ c → c ≤ 2 → 0 < m → m ≤ 1 → 1 ≤ X →
      ∀ S T : Cols A B → ℝ,
        (∀ r, |S r-c| ≤ 2*X^(-m)) →
        (∀ r, |T r-(S r)^deg| ≤ ((2 : ℝ) ^ (deg + 1))*X^(-(1 : ℝ))) →
        |Matrix.det (fun r col : Cols A B => (S r)^(col.1 : ℕ)*(T r)^(col.2 : ℕ))|
          ≤ C*X^(-((2*Real.sqrt (2*m)/3)*
            ((A+1)*(B+1) : ℕ)*Real.sqrt ((A+1)*(B+1) : ℕ)
              -5*((A+1)*(B+1) : ℕ))) := by
  classical
  let I := Cols A B
  let K := {p : ℕ × ℕ // p ∈ jetBox deg A B}
  obtain ⟨C0,hC0,hcoeff⟩ := graphPoly_uniform_coefficients deg A B
  let Ctotal : ℝ :=
    (Fintype.card K : ℝ)^(Fintype.card I) *
    ((Fintype.card I).factorial : ℝ)*C0^(Fintype.card I) *
    (∑ f : I → K, ∏ i : I, (2 : ℝ)^(f i).val.1*((2 : ℝ) ^ (deg + 1))^(f i).val.2)
  have hCtotal : 0 ≤ Ctotal := by
    dsimp [Ctotal]
    positivity
  refine ⟨1+Ctotal,by positivity,?_⟩
  intro c m X hc0 hc2 hm hm1 hX S T ha hb
  let V : Matrix I K ℝ := fun r p => (S r-c)^p.val.1*(T r-(S r)^deg)^p.val.2
  let Cmat : Matrix K I ℝ := fun p col =>
    MvPolynomial.coeff (jetExp p.val) (graphPoly deg c (col.1 : ℕ) (col.2 : ℕ))
  have hC : ∀ p col, |Cmat p col| ≤ C0 := by
    intro p col
    exact hcoeff c hc0 hc2 (col.1 : ℕ) (col.2 : ℕ)
      (Nat.lt_succ_iff.mp col.1.isLt) (Nat.lt_succ_iff.mp col.2.isLt) _
  have hV : ∀ r p, |V r p| ≤
      (2 : ℝ)^p.val.1*((2 : ℝ) ^ (deg + 1))^p.val.2*X^(-pairWeight m p.val) := by
    intro r p
    exact A1OriginalDeterminant.jet_value_bound m X 2 ((2 : ℝ) ^ (deg + 1)) p.val.1 p.val.2
      hX (by norm_num) (by positivity) _ _ (ha r) (hb r)
  have hmat : V*Cmat =
      (fun r col : Cols A B => (S r)^(col.1 : ℕ)*(T r)^(col.2 : ℕ)) := by
    ext r col
    rw [Matrix.mul_apply]
    have hs : ∀ d ∈ (graphPoly deg c (col.1 : ℕ) (col.2 : ℕ)).support,
        d 0 ≤ A+deg*B ∧ d 1 ≤ B := by
      intro d hd
      have hh := graphPoly_support deg c (col.1 : ℕ) (col.2 : ℕ) d hd
      exact ⟨hh.1.trans (Nat.add_le_add (Nat.lt_succ_iff.mp col.1.isLt)
        (Nat.mul_le_mul_left deg (Nat.lt_succ_iff.mp col.2.isLt))),
        hh.2.trans (Nat.lt_succ_iff.mp col.2.isLt)⟩
    have heval := polynomial_evaluation_box deg A B
      (graphPoly deg c (col.1 : ℕ) (col.2 : ℕ)) (S r-c) (T r-(S r)^deg) hs
    change (∑ p : K, (S r-c)^p.val.1*(T r-(S r)^deg)^p.val.2*
      MvPolynomial.coeff (jetExp p.val) (graphPoly deg c (col.1 : ℕ) (col.2 : ℕ))) = _
    rw [← heval,graphPoly_eval deg]
    have h1 : c+(S r-c)=S r := by ring
    rw [h1]
    have h2 : (S r)^deg+(T r-(S r)^deg)=T r := by ring
    rw [h2]
  have hbnd := jet_evaluation_det_bound deg V Cmat
    (fun p : K => p.val) Subtype.val_injective
    m X C0 hm hm1 hX hC0 hV hC
  rw [hmat] at hbnd
  have hcard : Fintype.card I = (A+1)*(B+1) := by simp [I,Cols]
  simp only [hcard] at hbnd
  calc
    _ ≤ Ctotal*X^(-((2*Real.sqrt (2*m)/3)*
        ((A+1)*(B+1) : ℕ)*Real.sqrt ((A+1)*(B+1) : ℕ)
          -5*((A+1)*(B+1) : ℕ))) := by
      simpa only [Ctotal,hcard] using hbnd
    _ ≤ _ := by gcongr; linarith

