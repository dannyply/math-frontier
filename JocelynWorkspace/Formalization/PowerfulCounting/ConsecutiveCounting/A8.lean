theorem affine_second_order_alternative
    (k : ℕ) (hk : 2≤k) (F : Polynomial ℝ)
    (z0 γ x R c₂ C₂ A B : ℝ)
    (hx : 0<x) (hR : 0<R) (hc₂ : 0<c₂) (hγ : γ≠0)
    (hC : C₂≤R) (hscale : x≤c₂*R^(2*k-1))
    (hsecond : ∀ z : ℝ,C₂≤ |z| →
      |F.eval z|≤c₂*|z|^(2*k-1) →
      |F.derivative.eval z|≤c₂*|z|^(2*k-2) →
      c₂*|z|^(2*k-3)≤ |F.derivative.derivative.eval z|)
    (hwhole : ∀ t∈Set.Icc A B,R≤ |z0+γ*t|) :
    let N := F.comp (C z0+C γ*X)
    let L : ℝ := c₂*γ^2*R^(2*k-3)
    0<L ∧ ∀ t∈Set.Icc A B,x/2<N.eval t → N.eval t≤x →
      Real.sqrt (x*L)≤ |N.derivative.eval t| ∨
        L≤ |N.derivative.derivative.eval t| := by
  intro N L
  have hg : 0< |γ| := abs_pos.mpr hγ
  have hL : 0<L := by dsimp [L]; positivity
  have hexp : (2*k-2)*2=(2*k-3)+(2*k-1) := by omega
  have hpow : (R^(2*k-2))^2=R^(2*k-3)*R^(2*k-1) := by
    rw [←pow_mul,hexp,pow_add]
  have hbound : Real.sqrt (x*L)≤ |γ| *c₂*R^(2*k-2) := by
    have hsq : (|γ| *c₂*R^(2*k-2))^2 =
        L*(c₂*R^(2*k-1)) := by
      dsimp only [L]
      rw [mul_pow,mul_pow,hpow,sq_abs]
      ring
    have hmul := mul_le_mul_of_nonneg_left hscale hL.le
    have hroot := Real.sq_sqrt (by positivity : 0≤x*L)
    have hright : 0≤ |γ| *c₂*R^(2*k-2) := by positivity
    have hleft := Real.sqrt_nonneg (x*L)
    nlinarith
  refine ⟨hL,?_⟩
  intro t ht hlow hupp
  by_cases hlarge : Real.sqrt (x*L)≤ |N.derivative.eval t|
  · exact Or.inl hlarge
  · right
    have hz := hwhole t ht
    have hp : ∀ n : ℕ,R^n≤ |z0+γ*t|^n :=
      fun n => pow_le_pow_left₀ hR.le hz n
    have hv := (affine_height_derivatives F z0 γ t).1
    have hd := (affine_height_derivatives F z0 γ t).2
    change N.eval t=_ at hv
    change N.derivative.eval t=_ ∧ N.derivative.derivative.eval t=_ at hd
    have hFval : |F.eval (z0+γ*t)|≤c₂*|z0+γ*t|^(2*k-1) := by
      rw [←hv,abs_of_pos (by linarith : 0<N.eval t)]
      exact hupp.trans (hscale.trans (mul_le_mul_of_nonneg_left (hp _) hc₂.le))
    have hFder : |F.derivative.eval (z0+γ*t)|≤c₂*|z0+γ*t|^(2*k-2) := by
      have hn : |N.derivative.eval t|≤ |γ| *(c₂*R^(2*k-2)) :=
        (le_of_not_ge hlarge).trans (by nlinarith [hbound])
      rw [hd.1,abs_mul] at hn
      have hh : |F.derivative.eval (z0+γ*t)|≤c₂*R^(2*k-2) := by
        nlinarith only [hn,hg]
      exact hh.trans (mul_le_mul_of_nonneg_left (hp _) hc₂.le)
    have hs := hsecond (z0+γ*t) (hC.trans hz) hFval hFder
    rw [hd.2,abs_mul,abs_of_nonneg (sq_nonneg γ)]
    have hmul := mul_le_mul_of_nonneg_left
      ((mul_le_mul_of_nonneg_left (hp (2*k-3)) hc₂.le).trans hs) (sq_nonneg γ)
    calc
      L=γ^2*(c₂*R^(2*k-3)) := by dsimp [L];ring
      _≤γ^2*|F.derivative.derivative.eval (z0+γ*t)| := hmul

end
