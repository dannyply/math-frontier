    have hshift : ((e^k*v : ℕ) : ℤ) = ((d^k*u : ℕ) : ℤ)+1 := by exact_mod_cast hunit
    have hcop := (A6A8Full12.both_coprime k (by omega) d e u v 1 (Or.inl rfl) hshift).1
