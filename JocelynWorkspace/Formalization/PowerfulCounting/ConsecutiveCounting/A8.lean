lemma fU {A B:Type*} [CommRing A] [CommRing B]
    [Algebra ℚ A] [Algebra ℚ B] (f:A→ₐ[ℚ] B) (W:Submodule ℚ A):
    Module.finrank ℚ (W.map (uV ℚ (RingHom.ker f)).toLinearMap)= Module.finrank ℚ (W.map f.toLinearMap):=by
  have hf:f.toLinearMap=(Ideal.kerLiftAlg f).toLinearMap.comp
      (uV ℚ (RingHom.ker f)).toLinearMap:=by
    apply LinearMap.ext
    intro x
    exact (Ideal.kerLiftAlg_mk f x).symm
  have hinj:uX (Ideal.kerLiftAlg f).toLinearMap:=by
    intro x y hxy
    exact Ideal.kerLiftAlg_injective f hxy
  rw [hf,Submodule.map_comp]
  exact LinearEquiv.finrank_eq
    (fw (Ideal.kerLiftAlg f).toLinearMap hinj _)
