private def HighUnionK (k thr : ℕ) (x D E : ℝ) (M j : ℕ)
    (F : Poly) : Set Point :=
  {z | z∈A8HighFPriceCellTuple.cellK k x D E M j ∧
    ∃ G : Poly, A8HighFPriceFactor.HighFactor k thr F G ∧
      MvPolynomial.eval ![(z.1.1:ℤ),(z.1.2:ℤ),
        (z.2.1:ℤ),(z.2.2:ℤ)] G=0}

private theorem sameF_finite_family
    (k thr N : ℕ) (x D E : ℝ) (M : ℕ)
    (J : Finset ℕ) (F : ℕ→Poly)
    (hFdata : ∀ j∈J,
      F j≠0 ∧
      (∃ a b : ℕ, A8HighFPriceFactor.Bihom (F j) a b ∧ a+b≤ N) ∧
      (HighUnionK k thr x D E M j (F j)).Finite) :
    ∃ S : ℕ→Finset Poly,
      ∀ j∈J, (S j).card≤ N ∧
        (∀ G∈S j, A8HighFPriceFactor.Primitive G ∧
          A8HighFPriceFactor.HighFactor k thr (F j) G) ∧
        (∀ z : Point, z∈HighUnionK k thr x D E M j (F j) ↔
          z∈A8HighFPriceCellTuple.cellK k x D E M j ∧
            ∃ G∈S j, MvPolynomial.eval
              ![(z.1.1:ℤ),(z.1.2:ℤ),
                (z.2.1:ℤ),(z.2.2:ℤ)] G=0) := by
  classical
  let Data : ℕ→Finset Poly→Prop := fun j S =>
    S.card≤ N ∧
      (∀ G∈S, A8HighFPriceFactor.Primitive G ∧
        A8HighFPriceFactor.HighFactor k thr (F j) G) ∧
      (∀ z : Point, z∈HighUnionK k thr x D E M j (F j) ↔
        z∈A8HighFPriceCellTuple.cellK k x D E M j ∧
          ∃ G∈S, MvPolynomial.eval
            ![(z.1.1:ℤ),(z.1.2:ℤ),
              (z.2.1:ℤ),(z.2.2:ℤ)] G=0)
  have hchoose : ∀ j : ℕ, ∃ S : Finset Poly, j∈J→Data j S := by
    intro j
    by_cases hj : j∈J
    · obtain ⟨hFj,⟨a,b,hBi,hAB⟩,_⟩ := hFdata j hj
      have hFD : (F j).totalDegree≤ N :=
        (A8HighFPriceFactor.totalDegree_le_bihom (F j) a b hBi).trans hAB
      obtain ⟨S,hScard,hSgood,hScover⟩ :=
        A8HighFPriceFactor.finite_primitive_high_cover
          k thr (F j) hFj N hFD
      refine ⟨S,fun _ => ⟨hScard,hSgood,?_⟩⟩
      intro z
      constructor
      · rintro ⟨hz,G,hGE,hzero⟩
        obtain ⟨G',hG'S,hiff⟩ := hScover G hGE
        exact ⟨hz,G',hG'S,(hiff _).mp hzero⟩
      · rintro ⟨hz,G,hGS,hzero⟩
        exact ⟨hz,G,(hSgood G hGS).2,hzero⟩
    · exact ⟨∅,fun hj' => (hj hj').elim⟩
  choose S hData using hchoose
  exact ⟨S,fun j hj => hData j hj⟩
end A8HighFPriceSameF

