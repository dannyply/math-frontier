theorem rich_whole_interval_geometry
    (a b ell d0 e0 D E C : ℝ)
    (ha : a≠0) (hb : b≠0) (hell : ell≠0)
    (hD : 0<D) (hE : 0<E) (hC : 8≤C)
    (hd0 : D/2<d0) (hd1 : d0≤D) (he0 : E/2<e0) (he1 : e0≤E)
    (hlevel : a*d0+b*e0=ell)
    (hrich : |ell| *C< max (|a| *D) (|b| *E)) :
    let T : ℝ := Real.sqrt (|a*b| *(D*E))
    0<T ∧ C/8<T/(4*|ell|) ∧
      T≤2*(|a| *D) ∧ T≤2*(|b| *E) ∧
      (∀ d : ℝ, d∈Set.Icc (D/2) D →
        T/(4*|ell|)≤ |a*d/ell| ∧
        |a*d/ell|≤2*T/|ell|) := by
  intro T
  have ha0 : 0< |a| := abs_pos.mpr ha
  have hb0 : 0< |b| := abs_pos.mpr hb
  have hL : 0< |ell| := abs_pos.mpr hell
  have hdpos : 0<d0 := by linarith
  have hepos : 0<e0 := by linarith
  have hAp : 0< |a| *D := mul_pos ha0 hD
  have hBp : 0< |b| *E := mul_pos hb0 hE
  have hsmall : 8*|ell|< max (|a| *D) (|b| *E) := by
    calc
      8*|ell|≤ |ell| *C := by nlinarith only [mul_le_mul_of_nonneg_right hC hL.le]
      _< max (|a| *D) (|b| *E) := hrich
  have hA : |a| *d0≤ |ell|+|b| *E := by
    have hv : |a*d0|≤ |ell|+|b*e0| := by
      calc
        |a*d0|=|ell-b*e0| := by congr 1; linarith
        _≤ |ell|+|b*e0| := by simpa using (abs_sub_le ell 0 (b*e0))
    rw [abs_mul,abs_of_pos hdpos,abs_mul,abs_of_pos hepos] at hv
    exact hv.trans (add_le_add le_rfl (mul_le_mul_of_nonneg_left he1 hb0.le))
  have hB : |b| *e0≤ |ell|+|a| *D := by
    have hv : |b*e0|≤ |ell|+|a*d0| := by
      calc
        |b*e0|=|ell-a*d0| := by congr 1; linarith
        _≤ |ell|+|a*d0| := by simpa using (abs_sub_le ell 0 (a*d0))
    rw [abs_mul,abs_of_pos hepos,abs_mul,abs_of_pos hdpos] at hv
    exact hv.trans (add_le_add le_rfl (mul_le_mul_of_nonneg_left hd1 ha0.le))
  have hAlo : |a| *D/2< |a| *d0 := by
    nlinarith only [mul_lt_mul_of_pos_left hd0 ha0]
  have hBlo : |b| *E/2< |b| *e0 := by
    nlinarith only [mul_lt_mul_of_pos_left he0 hb0]
  have hAB : |a| *D≤4*(|b| *E) ∧ |b| *E≤4*(|a| *D) := by
    rcases le_total (|a| *D) (|b| *E) with hab | hba
    · rw [max_eq_right hab] at hsmall
      constructor <;> linarith
    · rw [max_eq_left hba] at hsmall
      constructor <;> linarith
  have hTpos : 0<T := by
    apply Real.sqrt_pos.mpr
    rw [abs_mul]
    positivity
  have hTsq : T^2=(|a| *D)*(|b| *E) := by
    dsimp only [T]
    rw [Real.sq_sqrt (by positivity : 0≤ |a*b| *(D*E)),abs_mul]
    ring
  have hTa : T≤2*(|a| *D) := by
    nlinarith only [hTsq,hTpos,hAp,
      mul_le_mul_of_nonneg_left hAB.2 hAp.le]
  have hTb : T≤2*(|b| *E) := by
    nlinarith only [hTsq,hTpos,hBp,
      mul_le_mul_of_nonneg_left hAB.1 hBp.le]
  have haT : |a| *D≤2*T := by
    nlinarith only [hTsq,hTpos,hAp,
      mul_le_mul_of_nonneg_left hAB.1 hAp.le]
  have hbT : |b| *E≤2*T := by
    nlinarith only [hTsq,hTpos,hBp,
      mul_le_mul_of_nonneg_left hAB.2 hBp.le]
  have hmax : max (|a| *D) (|b| *E)≤2*T := max_le haT hbT
  have hlarge : C/8<T/(4*|ell|) := by
    apply (div_lt_div_iff₀ (by norm_num : (0:ℝ)<8) (by positivity : 0<4*|ell|)).mpr
    nlinarith only [hrich,hmax]
  refine ⟨hTpos,hlarge,hTa,hTb,?_⟩
  intro d hd
  have hdpos' : 0<d := by linarith [hd.1]
  rw [abs_div,abs_mul,abs_of_pos hdpos']
  constructor
  · apply (div_le_div_iff₀ (by positivity : 0<4*|ell|) hL).mpr
    have hbase : T≤4*(|a| *d) := by
      nlinarith only [hTa,mul_le_mul_of_nonneg_left hd.1 ha0.le]
    calc
      T*|ell|≤(4*(|a| *d))*|ell| := mul_le_mul_of_nonneg_right hbase hL.le
      _=(|a| *d)*(4*|ell|) := by ring
  · apply (div_le_div_iff₀ hL hL).mpr
    exact mul_le_mul_of_nonneg_right
      ((mul_le_mul_of_nonneg_left hd.2 ha0.le).trans haT) hL.le
end
