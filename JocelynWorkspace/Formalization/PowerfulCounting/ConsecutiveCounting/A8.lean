theorem pure_axis_kernel_nonzero
    (k : ℕ) (hk : 2≤k) (P Q : MvPolynomial (Fin 2) ℤ)
    (hP : ∀ μ∈P.support,μ 0+μ 1=k+1)
    (hQ : ∀ μ∈Q.support,μ 0+μ 1=k+1)
    (a b c A B : ℤ) (hab : A*a+B*b=1) (haxis : a=0 ∨ b=0)
    (hno : ∀ w : Fin 2 → ℂ,w≠0 →
      MvPolynomial.eval w (P.map (Int.castRingHom ℂ))=0 →
      MvPolynomial.eval w (Q.map (Int.castRingHom ℂ))=0 → False)
    (hres : MvPolynomial.X (1:Fin 2)^k*P-MvPolynomial.X (0:Fin 2)^k*Q =
      MvPolynomial.C c*(MvPolynomial.C a*MvPolynomial.X (0:Fin 2)+
        MvPolynomial.C b*MvPolynomial.X (1:Fin 2))^(2*k+1)) :
    let S := P.coeff (Finsupp.single (0:Fin 2) (k+1))
    let R := P.coeff (Finsupp.single (0:Fin 2) k+Finsupp.single (1:Fin 2) 1)
    let K0 : ℤ := b*S-a*R+(Nat.choose (2*k) (k-1):ℤ)*c*a^(k+1)*b^(k+1)
    K0≠0 := by
  intro S R K0 hzero
  have hPeval : MvPolynomial.eval ![b,-a] P=b^k*K0 := by
    simpa [S,R,K0,A8OddPureOriginal.binMono] using
      A8OddPureOriginal.pure_P_signed_eval k hk P Q a b c hP hQ hres
  have hQeval : MvPolynomial.eval ![b,-a] Q=(-1:ℤ)^k*a^k*K0 := by
    simpa [S,R,K0,A8OddPureOriginal.binMono] using
      A8OddPureOriginal.pure_Q_signed_eval k hk P Q a b c hP hQ hres
  apply hno ![(b:ℂ),-(a:ℂ)] _ _ _
  · intro hw
    rcases haxis with ha | hb
    · have hb0 : b≠0 := by intro hz;simp [ha,hz] at hab
      have hh := congrArg (fun w : Fin 2 → ℂ => w 0) hw
      have hbC : (b:ℂ)=0 := by simpa using hh
      exact hb0 (by exact_mod_cast hbC)
    · have ha0 : a≠0 := by intro hz;simp [hb,hz] at hab
      have hh := congrArg (fun w : Fin 2 → ℂ => w 1) hw
      have haC : (a:ℂ)=0 := by simpa using hh
      exact ha0 (by exact_mod_cast haC)
  · have hx := eval_int_map (Int.castRingHom ℂ) b (-a) P
    rw [hPeval,hzero,mul_zero,map_zero] at hx
    simpa using hx
  · have hx := eval_int_map (Int.castRingHom ℂ) b (-a) Q
    rw [hQeval,hzero,mul_zero,map_zero] at hx
    simpa using hx

theorem pure_primitive_kernel_nonzero
    (k : ℕ) (hk : 2≤k) (P Q : MvPolynomial (Fin 2) ℤ)
    (hP : P.IsHomogeneous (k+1)) (hQ : Q.IsHomogeneous (k+1))
    (a b c A B : ℤ) (hc : c≠0) (hab : A*a+B*b=1)
    (hno : ∀ w : Fin 2 → ℂ,w≠0 →
      MvPolynomial.eval w (P.map (Int.castRingHom ℂ))=0 →
      MvPolynomial.eval w (Q.map (Int.castRingHom ℂ))=0 → False)
    (hres : MvPolynomial.X (1:Fin 2)^k*P-MvPolynomial.X (0:Fin 2)^k*Q =
      MvPolynomial.C c*(MvPolynomial.C a*MvPolynomial.X (0:Fin 2)+
        MvPolynomial.C b*MvPolynomial.X (1:Fin 2))^(2*k+1)) :
    let S := P.coeff (Finsupp.single (0:Fin 2) (k+1))
    let R := P.coeff (Finsupp.single (0:Fin 2) k+Finsupp.single (1:Fin 2) 1)
    let K0 : ℤ := b*S-a*R+(Nat.choose (2*k) (k-1):ℤ)*c*a^(k+1)*b^(k+1)
    K0≠0 := by
  by_cases ha : a=0
  · exact pure_axis_kernel_nonzero k hk P Q (homogeneous_binary_support P _ hP)
      (homogeneous_binary_support Q _ hQ) a b c A B hab (Or.inl ha) hno hres
  by_cases hb : b=0
  · exact pure_axis_kernel_nonzero k hk P Q (homogeneous_binary_support P _ hP)
      (homogeneous_binary_support Q _ hQ) a b c A B hab (Or.inr hb) hno hres
  exact (integer_pure_height_physical_data k hk P Q hP hQ a b c 1 ha hb hc
    (by norm_num) hno hres).1

end
