namespace A5NongeometricKronecker
open MvPolynomial
noncomputable def kron {R : Type*} [CommSemiring R] (N : ℕ) :
    MvPolynomial (Fin 2) R →+* Polynomial R :=
  MvPolynomial.eval₂Hom Polynomial.C ![Polynomial.X, Polynomial.X ^ N]
def enc (N : ℕ) (m : Fin 2 →₀ ℕ) : ℕ := m 0 + N * m 1

theorem enc_injective {N : ℕ} {m n : Fin 2 →₀ ℕ}
    (hm : m 0 < N) (hn : n 0 < N) (h : enc N m = enc N n) : m = n := by
  have h0 : m 0 = n 0 := by
    have hmod := congrArg (fun t : ℕ => t % N) h
    simpa [enc, Nat.add_mod, Nat.mul_mod, Nat.mod_eq_of_lt hm, Nat.mod_eq_of_lt hn] using hmod
  have hp : 0 < N := by omega
  have hmul : N * m 1 = N * n 1 := by dsimp [enc] at h; omega
  have h1 : m 1 = n 1 := Nat.eq_of_mul_eq_mul_left hp hmul
  ext i
  fin_cases i
  · exact h0
  · exact h1

theorem kron_monomial {R : Type*} [CommSemiring R]
    (N : ℕ) (m : Fin 2 →₀ ℕ) (c : R) :
    kron N (MvPolynomial.monomial m c) = Polynomial.C c * Polynomial.X ^ enc N m := by
  simp [kron, MvPolynomial.eval₂_monomial, Finsupp.prod_fintype,
    Fin.prod_univ_two, enc, pow_add, pow_mul]

theorem coeff_kron {R : Type*} [CommSemiring R] (N : ℕ)
    (P : MvPolynomial (Fin 2) R) (hP : ∀ m ∈ P.support, m 0 < N)
    (m : Fin 2 →₀ ℕ) (hm : m 0 < N) :
    (kron N P).coeff (enc N m) = P.coeff m := by
  classical
  conv_lhs => rw [P.as_sum]
  rw [map_sum]
  simp only [kron_monomial, Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul_X_pow]
  rw [Finset.sum_eq_single m]
  · simp
  · intro n hn hnm
    have hne : enc N m ≠ enc N n :=
      fun h => hnm (enc_injective (hP n hn) hm h.symm)
    simp [hne]
  · intro hnm
    have hz : P.coeff m = 0 := by
      by_contra h
      exact hnm (MvPolynomial.mem_support_iff.mpr h)
    simp [hz]

theorem kron_ne_zero {R : Type*} [CommSemiring R] (N : ℕ)
    (P : MvPolynomial (Fin 2) R) (hP0 : P ≠ 0) (hP : ∀ m ∈ P.support, m 0 < N) :
    kron N P ≠ 0 := by
  classical
  obtain ⟨m, hm⟩ : ∃ m, P.coeff m ≠ 0 := by
    by_contra! h
    apply hP0
    ext m
    exact h m
  have hmem := MvPolynomial.mem_support_iff.mpr hm
  intro hk
  have h := coeff_kron N P hP m (hP m hmem)
  rw [hk, Polynomial.coeff_zero] at h
  exact hm h.symm

theorem support_bound {R : Type*} [CommSemiring R]
    (P : MvPolynomial (Fin 2) R) (D : ℕ) (hD : P.totalDegree ≤ D) :
    ∀ m ∈ P.support, m 0 < D + 1 := by
  intro m hm
  have hs := (MvPolynomial.le_totalDegree hm).trans hD
  rw [Finsupp.sum_fintype _ _ (by simp), Fin.sum_univ_two] at hs
  omega

theorem kron_map {R S : Type*} [CommSemiring R] [CommSemiring S]
    (N : ℕ) (φ : R →+* S) (P : MvPolynomial (Fin 2) R) :
    kron N (MvPolynomial.map φ P) = Polynomial.map φ (kron N P) := by
  induction P using MvPolynomial.induction_on
  next c => simp [kron]
  next p q hp hq => simp only [map_add, Polynomial.map_add, hp, hq]
  next p i hp =>
    simp only [map_mul, MvPolynomial.map_X, hp]
    congr 1
    fin_cases i <;> simp [kron]

@[simp] theorem kron_C {R : Type*} [CommSemiring R] (N : ℕ) (c : R) :
    kron N (MvPolynomial.C c) = Polynomial.C c := by simp [kron]

theorem support_C_mul_bound {R : Type*} [CommSemiring R] (N : ℕ)
    (P : MvPolynomial (Fin 2) R) (c : R) (hP : ∀ m ∈ P.support, m 0 < N) :
    ∀ m ∈ (MvPolynomial.C c * P).support, m 0 < N := by
  intro m hm
  have hc : P.coeff m ≠ 0 := by
    intro hz
    apply MvPolynomial.mem_support_iff.mp hm
    rw [MvPolynomial.coeff_C_mul, hz, mul_zero]
  exact hP m (MvPolynomial.mem_support_iff.mpr hc)

theorem univariate_coeff_algebraic (F : Polynomial ℚ) (hF : F ≠ 0)
    (P : Polynomial ℂ) (hdiv : P ∣ Polynomial.map (algebraMap ℚ ℂ) F)
    (hl : IsAlgebraic ℚ P.leadingCoeff) :
    ∀ n, IsAlgebraic ℚ (P.coeff n) := by
  have hroots : ∀ z : ℂ, P.IsRoot z → IsIntegral ℚ z := by
    intro z hz
    have hFz : Polynomial.eval z (F.map (algebraMap ℚ ℂ)) = 0 := by
      obtain ⟨Q, hQ⟩ := hdiv
      change Polynomial.eval z P = 0 at hz
      rw [hQ, Polynomial.eval_mul, hz, zero_mul]
    have halg : IsAlgebraic ℚ z := by
      refine ⟨F, hF, ?_⟩
      simpa only [Polynomial.eval_map, Polynomial.aeval_def] using hFz
    exact halg.isIntegral
  intro n
  exact (Polynomial.isIntegral_coeff_of_factors P hl.isIntegral
    (IsAlgClosed.splits P) hroots n).isAlgebraic

theorem algebraic_rat_cast (r : ℚ) : IsAlgebraic ℚ (algebraMap ℚ ℂ r) := by
  refine ⟨Polynomial.X - Polynomial.C r, ?_, ?_⟩
  · intro hz
    have h := congrArg (Polynomial.coeff · 1) hz
    simp at h
  · simp

theorem coeff_algebraic_of_kron (N : ℕ) (P : MvPolynomial (Fin 2) ℂ)
    (hP : ∀ m ∈ P.support, m 0 < N)
    (hκ : ∀ n, IsAlgebraic ℚ ((kron N P).coeff n)) :
    ∀ m, IsAlgebraic ℚ (P.coeff m) := by
  intro m
  by_cases hm : m ∈ P.support
  · rw [← coeff_kron N P hP m (hP m hm)]
    exact hκ _
  · have hz : P.coeff m = 0 := by
      by_contra h
      exact hm (MvPolynomial.mem_support_iff.mpr h)
    rw [hz]
    exact isIntegral_zero.isAlgebraic

theorem normalized_pair_algebraic (f : MvPolynomial (Fin 2) ℚ) (hf : f ≠ 0)
    (g h : MvPolynomial (Fin 2) ℂ)
    (hprod : MvPolynomial.map (algebraMap ℚ ℂ) f = g * h) :
    ∃ c : ℂ, c ≠ 0 ∧
      (∀ m, IsAlgebraic ℚ ((MvPolynomial.C c⁻¹ * g).coeff m)) ∧
      (∀ m, IsAlgebraic ℚ ((MvPolynomial.C c * h).coeff m)) := by
  classical
  let F := MvPolynomial.map (algebraMap ℚ ℂ) f
  have hF0 : F ≠ 0 := by
    intro hz
    apply hf
    apply MvPolynomial.map_injective _ (algebraMap ℚ ℂ).injective
    simpa [F] using hz
  have hgh0 : g * h ≠ 0 := by rw [← hprod]; exact hF0
  have hg0 := left_ne_zero_of_mul hgh0
  have hh0 := right_ne_zero_of_mul hgh0
  have hdeg : g.totalDegree + h.totalDegree = F.totalDegree := by
    rw [← MvPolynomial.totalDegree_mul_of_isDomain hg0 hh0, ← hprod]
  let D := F.totalDegree
  let N := D + 1
  have hgb : ∀ m ∈ g.support, m 0 < N := support_bound g D (by dsimp [D]; omega)
  have hhb : ∀ m ∈ h.support, m 0 < N := support_bound h D (by dsimp [D]; omega)
  have hFb : ∀ m ∈ F.support, m 0 < N := support_bound F D le_rfl
  have hκg0 : kron N g ≠ 0 := kron_ne_zero N g hg0 hgb
  have hκF0 : kron N F ≠ 0 := kron_ne_zero N F hF0 hFb
  have hκf0 : kron N f ≠ 0 := by
    intro hz
    apply hκF0
    rw [show F = MvPolynomial.map (algebraMap ℚ ℂ) f from rfl, kron_map, hz, Polynomial.map_zero]
  let c := (kron N g).leadingCoeff
  have hc : c ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hκg0
  let gn := MvPolynomial.C c⁻¹ * g
  let hn := MvPolynomial.C c * h
  have hprod' : F = gn * hn := by
    dsimp [gn, hn]
    calc F = g * h := hprod
      _ = (MvPolynomial.C c⁻¹ * MvPolynomial.C c) * (g * h) := by
        rw [← MvPolynomial.C_mul, inv_mul_cancel₀ hc, MvPolynomial.C_1, one_mul]
      _ = _ := by ring
  have hκprod : Polynomial.map (algebraMap ℚ ℂ) (kron N f) = kron N gn * kron N hn := by
    calc
      Polynomial.map (algebraMap ℚ ℂ) (kron N f) = kron N F :=
        (kron_map N (algebraMap ℚ ℂ) f).symm
      _ = kron N (gn * hn) := congrArg (kron N) hprod'
      _ = _ := map_mul _ _ _
  have hgmonic : (kron N gn).Monic := by
    change (kron N gn).leadingCoeff = 1
    have he : kron N gn = Polynomial.C c⁻¹ * kron N g := by
      simp only [gn, map_mul, kron_C]
    rw [he, Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_C]
    exact inv_mul_cancel₀ hc
  have hκgdiv : kron N gn ∣ Polynomial.map (algebraMap ℚ ℂ) (kron N f) :=
    ⟨kron N hn, hκprod⟩
  have hκhdiv : kron N hn ∣ Polynomial.map (algebraMap ℚ ℂ) (kron N f) :=
    ⟨kron N gn, by rw [hκprod, mul_comm]⟩
  have hκgalg : ∀ n, IsAlgebraic ℚ ((kron N gn).coeff n) := by
    apply univariate_coeff_algebraic (kron N f) hκf0 (kron N gn) hκgdiv
    rw [hgmonic.leadingCoeff]
    exact isIntegral_one.isAlgebraic
  have hκhalg : ∀ n, IsAlgebraic ℚ ((kron N hn).coeff n) := by
    apply univariate_coeff_algebraic (kron N f) hκf0 (kron N hn) hκhdiv
    have hl := congrArg Polynomial.leadingCoeff hκprod
    rw [Polynomial.leadingCoeff_mul, hgmonic.leadingCoeff, one_mul] at hl
    rw [← hl, Polynomial.leadingCoeff_map]
    exact algebraic_rat_cast _
  refine ⟨c, hc, ?_, ?_⟩
  · exact coeff_algebraic_of_kron N gn (support_C_mul_bound N g c⁻¹ hgb) hκgalg
  · exact coeff_algebraic_of_kron N hn (support_C_mul_bound N h c hhb) hκhalg

theorem isUnit_of_map_isUnit {k L : Type*} [Field k] [Field L]
    (φ : k →+* L) (f : MvPolynomial (Fin 2) k)
    (hu : IsUnit (MvPolynomial.map φ f)) : IsUnit f := by
  classical
  obtain ⟨c, hc, he⟩ := MvPolynomial.isUnit_iff_eq_C_of_isReduced.mp hu
  have hf : f = MvPolynomial.C (f.coeff 0) := by
    ext m
    rw [MvPolynomial.coeff_C]
    split_ifs with hm
    · subst hm
      rfl
    · have hcoeff := congrArg (MvPolynomial.coeff m) he
      rw [MvPolynomial.coeff_map, MvPolynomial.coeff_C, if_neg hm] at hcoeff
      exact φ.injective (by simpa using hcoeff)
  have h0 : f.coeff 0 ≠ 0 := by
    intro hz
    have hf0 : f = 0 := by rw [hf, hz, MvPolynomial.C_0]
    apply hu.ne_zero
    simp [hf0]
  rw [hf]
  exact (isUnit_iff_ne_zero.mpr h0).map MvPolynomial.C
 
end A5NongeometricKronecker

namespace A5NongeometricCoefficientField

theorem finite_coefficient_field_witness :
    ∀ S : Finset ℂ,
      (∀ c ∈ S, IsAlgebraic ℚ c) →
      ∃ L : IntermediateField ℚ ℂ,
        FiniteDimensional ℚ L ∧ IsGalois ℚ L ∧
        ∀ c ∈ S, c ∈ L := by
  classical
  intro S hS
  let K : IntermediateField ℚ ℂ :=
    IntermediateField.adjoin ℚ (↑S : Set ℂ)
  have hfinite : (↑S : Set ℂ).Finite := S.finite_toSet
  have hgen : ∀ c ∈ (↑S : Set ℂ), IsAlgebraic ℚ c := by
    intro c hc
    exact hS c hc
  have hint : ∀ c ∈ (↑S : Set ℂ), IsIntegral ℚ c := by
    intro c hc
    exact (hgen c hc).isIntegral
  letI : FiniteDimensional ℚ K := by
    apply IntermediateField.finiteDimensional_adjoin
    all_goals assumption
  letI : Algebra.IsAlgebraic ℚ K := inferInstance
  let L : IntermediateField ℚ ℂ :=
    IntermediateField.normalClosure ℚ K ℂ
  letI : IsNormalClosure ℚ K L :=
    Algebra.IsAlgebraic.isNormalClosure_normalClosure
      (F := ℚ) (K := K) (L := ℂ)
      (fun x => IsAlgClosed.splits
        (Polynomial.map (algebraMap ℚ ℂ) (minpoly ℚ x)))
  letI : FiniteDimensional ℚ L := inferInstance
  letI : Normal ℚ L := IsNormalClosure.normal (F := ℚ) (K := K) (L := L)
  letI : IsGalois ℚ L := IsGalois.mk
  have hSK : (↑S : Set ℂ) ⊆ (K : Set ℂ) :=
    IntermediateField.adjoin_le_iff.mp (le_refl K)
  have hKL : K ≤ L := by
    change K ≤ ⨆ σ : K →ₐ[ℚ] ℂ, σ.fieldRange
    intro c hc
    exact (le_iSup (fun σ : K →ₐ[ℚ] ℂ => σ.fieldRange) K.val)
      (show c ∈ K.val.fieldRange from ⟨⟨c, hc⟩, rfl⟩)
  refine ⟨L, inferInstance, inferInstance, ?_⟩
  intro c hc
  exact hKL (hSK hc)

end A5NongeometricCoefficientField

namespace A5NongeometricClosure
open MvPolynomial

theorem lift_coeffs_to_field (L : IntermediateField ℚ ℂ)
    (p : MvPolynomial (Fin 2) ℂ) (hp : ∀ m, p.coeff m ∈ L) :
    ∃ q : MvPolynomial (Fin 2) L, MvPolynomial.map L.val.toRingHom q = p := by
  classical
  refine ⟨∑ m ∈ p.support, MvPolynomial.monomial m (⟨p.coeff m, hp m⟩ : L), ?_⟩
  simp only [map_sum, MvPolynomial.map_monomial]
  exact p.as_sum.symm

theorem finite_galois_reducibility (f : MvPolynomial (Fin 2) ℚ)
    (hf : Irreducible f)
    (hred : ¬ Irreducible (MvPolynomial.map (algebraMap ℚ ℂ) f)) :
    ∃ L : IntermediateField ℚ ℂ,
      FiniteDimensional ℚ L ∧ IsGalois ℚ L ∧
      ¬ Irreducible (MvPolynomial.map (algebraMap ℚ L) f) := by
  classical
  let F := MvPolynomial.map (algebraMap ℚ ℂ) f
  have hFnu : ¬ IsUnit F := fun hu =>
    hf.not_isUnit (A5NongeometricKronecker.isUnit_of_map_isUnit (algebraMap ℚ ℂ) f hu)
  obtain ⟨g, h, hprod, hgnu, hhnu⟩ :
      ∃ g h : MvPolynomial (Fin 2) ℂ, F = g * h ∧ ¬ IsUnit g ∧ ¬ IsUnit h := by
    by_contra! H
    apply hred
    refine irreducible_iff.mpr ⟨hFnu, ?_⟩
    intro a b hab
    by_cases hu : IsUnit a
    · exact Or.inl hu
    · exact Or.inr (H a b hab hu)
  obtain ⟨c, hc, hga, hha⟩ :=
    A5NongeometricKronecker.normalized_pair_algebraic f hf.ne_zero g h hprod
  let gn := MvPolynomial.C c⁻¹ * g
  let hn := MvPolynomial.C c * h
  have hgnnu : ¬ IsUnit gn := fun hu => hgnu (isUnit_of_mul_isUnit_right hu)
  have hhnnu : ¬ IsUnit hn := fun hu => hhnu (isUnit_of_mul_isUnit_right hu)
  have hprod' : F = gn * hn := by
    dsimp [gn, hn]
    calc F = g * h := hprod
      _ = (MvPolynomial.C c⁻¹ * MvPolynomial.C c) * (g * h) := by
        rw [← MvPolynomial.C_mul, inv_mul_cancel₀ hc, MvPolynomial.C_1, one_mul]
      _ = _ := by ring
  let S : Finset ℂ := gn.support.image (fun m => gn.coeff m) ∪
    hn.support.image (fun m => hn.coeff m)
  have hSa : ∀ x ∈ S, IsAlgebraic ℚ x := by
    intro x hx
    rcases Finset.mem_union.mp hx with hx | hx
    · obtain ⟨m, hm, rfl⟩ := Finset.mem_image.mp hx
      exact hga m
    · obtain ⟨m, hm, rfl⟩ := Finset.mem_image.mp hx
      exact hha m
  obtain ⟨L, hLfd, hLgal, hSL⟩ :=
    A5NongeometricCoefficientField.finite_coefficient_field_witness S hSa
  have hgLmem : ∀ m, gn.coeff m ∈ L := by
    intro m
    by_cases hm : m ∈ gn.support
    · apply hSL
      exact Finset.mem_union_left _ (Finset.mem_image.mpr ⟨m, hm, rfl⟩)
    · have hz : gn.coeff m = 0 := by
        by_contra hne
        exact hm (MvPolynomial.mem_support_iff.mpr hne)
      rw [hz]
      exact L.zero_mem
  have hhLmem : ∀ m, hn.coeff m ∈ L := by
    intro m
    by_cases hm : m ∈ hn.support
    · apply hSL
      exact Finset.mem_union_right _ (Finset.mem_image.mpr ⟨m, hm, rfl⟩)
    · have hz : hn.coeff m = 0 := by
        by_contra hne
        exact hm (MvPolynomial.mem_support_iff.mpr hne)
      rw [hz]
      exact L.zero_mem
  obtain ⟨gL, hgL⟩ := lift_coeffs_to_field L gn hgLmem
  obtain ⟨hL, hhL⟩ := lift_coeffs_to_field L hn hhLmem
  have hFmap : MvPolynomial.map L.val.toRingHom
      (MvPolynomial.map (algebraMap ℚ L) f) = F := by
    ext m
    simp only [MvPolynomial.coeff_map]
    exact L.val.commutes (f.coeff m)
  have hprodL : MvPolynomial.map (algebraMap ℚ L) f = gL * hL := by
    apply MvPolynomial.map_injective _ L.val.toRingHom.injective
    rw [map_mul, hgL, hhL, hFmap]
    exact hprod'
  refine ⟨L, hLfd, hLgal, ?_⟩
  intro hir
  rcases hir.isUnit_or_isUnit hprodL with hu | hu
  · apply hgnnu
    rw [← hgL]
    exact hu.map _
  · apply hhnnu
    rw [← hhL]
    exact hu.map _

theorem complex_singularity (f : MvPolynomial (Fin 2) ℚ)
    (hf : Irreducible f)
    (hred : ¬ Irreducible (MvPolynomial.map (algebraMap ℚ ℂ) f))
    (a : Fin 2 → ℚ) (ha : MvPolynomial.eval a f = 0) (i : Fin 2) :
    MvPolynomial.eval a (MvPolynomial.pderiv i f) = 0 := by
  obtain ⟨L, hLfd, hLgal, hLred⟩ := finite_galois_reducibility f hf hred
  letI : FiniteDimensional ℚ L := hLfd
  letI : IsGalois ℚ L := hLgal
  exact A5NongeometricOwned.finite_galois_singularity (K := L) f hf hLred a ha i

end A5NongeometricClosure

namespace JocelynClaims
theorem claim_cf796a562073a28fafbae183327a9f6b7ead3dbe1736b529dea4062de2620fae :
∀ f : MvPolynomial (Fin 2) ℚ,
  Irreducible f →
  ¬ Irreducible (MvPolynomial.map (algebraMap ℚ ℂ) f) →
  ∀ a : Fin 2 → ℚ,
    MvPolynomial.eval a f = 0 →
    ∀ i : Fin 2,
      MvPolynomial.eval a (MvPolynomial.pderiv i f) = 0 := by
  intro f hf hred a ha i
  exact A5NongeometricClosure.complex_singularity f hf hred a ha i
end JocelynClaims

