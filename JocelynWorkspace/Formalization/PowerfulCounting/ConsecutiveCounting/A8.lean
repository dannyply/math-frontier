theorem finite_cover_card_bound
    {α β : Type*} [DecidableEq α] [DecidableEq β]
    (S : Finset α) (I : Finset β) (F : β→Finset α) (C : ℝ)
    (hcover : ∀ p∈S,∃ i∈I,p∈F i)
    (hbound : ∀ i∈I,((F i).card:ℝ)≤C) :
    (S.card:ℝ)≤(I.card:ℝ)*C := by
  have hsub : S⊆I.biUnion F := by
    intro p hp
    obtain ⟨i,hi,hpF⟩ := hcover p hp
    exact Finset.mem_biUnion.mpr ⟨i,hi,hpF⟩
  have hc : S.card≤∑ i∈I,(F i).card :=
    (Finset.card_le_card hsub).trans (Finset.card_biUnion_le)
  have hcR : (S.card:ℝ)≤∑ i∈I,((F i).card:ℝ) := by exact_mod_cast hc
  calc
    (S.card:ℝ)≤∑ i∈I,((F i).card:ℝ) := hcR
    _≤∑ i∈I,C := Finset.sum_le_sum hbound
    _=(I.card:ℝ)*C := by simp

end
end A8FloorExt

