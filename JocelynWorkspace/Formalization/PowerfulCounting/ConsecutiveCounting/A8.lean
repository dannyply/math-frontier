  apply o2
  apply oZ g
  intro m hm
  have hc:=jY k g beta (fun r hr=>(hg r hr).2) m hm
  have hp:cK k m∈(b3 k g).support:=by
    rw [mem_support_iff,hc]
    exact mem_support_iff.mp hm
  have hlow:=oY (b3 k g) nu eQ (cK k m) hp
  simp [cK] at hlow
  obtain ⟨h1,h2⟩:=hg m hm
  by_contra vI
