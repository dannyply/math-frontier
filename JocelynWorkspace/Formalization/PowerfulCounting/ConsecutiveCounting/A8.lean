private theorem polynomial_eq_of_derivative_coeff_zero
    (p q : Polynomial ℚ)
    (hd : derivative p = derivative q)
    (h0 : p.coeff 0 = q.coeff 0) : p = q := by
  apply Polynomial.ext
  intro i
  cases i with
  | zero => exact h0
  | succ i =>
    have h := congrArg (fun r : Polynomial ℚ => r.coeff i) hd
    rw [Polynomial.coeff_derivative, Polynomial.coeff_derivative] at h
    exact mul_right_cancel₀ (by positivity : (i : ℚ) + 1 ≠ 0) h

private theorem sum_Icc_difference
    (f : ℕ → Polynomial ℚ) (a b : ℕ) (hab : a ≤ b) :
    (∑ j ∈ Finset.Icc a b, (f j - f (j + 1))) =
      f a - f (b + 1) := by
  induction b with
  | zero =>
    have ha : a = 0 := by omega
    subst a
    simp
  | succ b ih =>
    by_cases h : a ≤ b
    · rw [Finset.sum_Icc_succ_top (by omega)]
      rw [ih h]
      ring
    · have ha : a = b + 1 := by omega
      subst a
      simp

private theorem choose_mul_index
    (n j : ℕ) (hn : 1 ≤ n) (hj : 1 ≤ j) :
    n.choose j * j = n * (n - 1).choose (j - 1) := by
  have h1 := Nat.choose_succ_right_eq n (j - 1)
  have h2 := Nat.choose_mul_succ_eq (n - 1) (j - 1)
  have hn' : n - 1 + 1 = n := by omega
  have hj' : j - 1 + 1 = j := by omega
  rw [hj'] at h1
  rw [hn'] at h2
  calc
    n.choose j * j = n.choose (j - 1) * (n - (j - 1)) := h1
    _ = (n - 1).choose (j - 1) * n := h2.symm
    _ = n * (n - 1).choose (j - 1) := Nat.mul_comm _ _

private theorem choose_mul_complement
    (n j : ℕ) (hn : 1 ≤ n) :
    n.choose j * (n - j) = n * (n - 1).choose j := by
  have h := Nat.choose_mul_succ_eq (n - 1) j
  have hn' : n - 1 + 1 = n := by omega
  rw [hn'] at h
  exact h.symm.trans (Nat.mul_comm _ _)

private def U : Polynomial ℚ := 1 + X
private def V : Polynomial ℚ := 1 - X
private def basis (n j : ℕ) : Polynomial ℚ :=
  C (n.choose j : ℚ) * U ^ j * V ^ (n - j)
private def flux (n j : ℕ) : Polynomial ℚ :=
  C ((n : ℚ) * ((n - 1).choose (j - 1) : ℚ)) *
    U ^ (j - 1) * V ^ (n - j)
private def tail (n m : ℕ) : Polynomial ℚ :=
  ∑ j ∈ Finset.Icc m n, basis n j

private theorem derivative_basis
    (n j : ℕ) (hn : 1 ≤ n) (hj : 1 ≤ j) (_hjn : j ≤ n) :
    derivative (basis n j) = flux n j - flux n (j + 1) := by
  have hleft : (n.choose j : ℚ) * (j : ℚ) =
      (n : ℚ) * ((n - 1).choose (j - 1) : ℚ) := by
    exact_mod_cast choose_mul_index n j hn hj
  have hright : (n.choose j : ℚ) * ((n - j : ℕ) : ℚ) =
      (n : ℚ) * ((n - 1).choose j : ℚ) := by
    exact_mod_cast choose_mul_complement n j hn
  have he : n - (j + 1) = n - j - 1 := by omega
  simp only [basis, flux, U, V, Polynomial.derivative_mul,
    Polynomial.derivative_pow, Polynomial.derivative_C,
    Polynomial.derivative_add, Polynomial.derivative_sub,
    Polynomial.derivative_one, Polynomial.derivative_X,
    zero_add, zero_sub, zero_mul, zero_add, mul_one,
    Nat.add_sub_cancel, he]
  have hl : C (n.choose j : ℚ) * C (j : ℚ) =
      C ((n : ℚ) * ((n - 1).choose (j - 1) : ℚ)) := by
    rw [← map_mul, hleft]
  have hr : C (n.choose j : ℚ) * C ((n - j : ℕ) : ℚ) =
      C ((n : ℚ) * ((n - 1).choose j : ℚ)) := by
    rw [← map_mul, hright]
  linear_combination
    (1 + (X : Polynomial ℚ)) ^ (j - 1) *
      (1 - (X : Polynomial ℚ)) ^ (n - j) * hl -
    (1 + (X : Polynomial ℚ)) ^ j *
      (1 - (X : Polynomial ℚ)) ^ (n - j - 1) * hr

private theorem derivative_tail
    (n m : ℕ) (hn : 1 ≤ n) (hm : 1 ≤ m) (hmn : m ≤ n) :
    derivative (tail n m) = flux n m := by
  unfold tail
  rw [Polynomial.derivative_sum]
  calc
    (∑ j ∈ Finset.Icc m n, derivative (basis n j)) =
        ∑ j ∈ Finset.Icc m n, (flux n j - flux n (j + 1)) := by
      apply Finset.sum_congr rfl
      intro j hj
      obtain ⟨hmj, hjn⟩ := Finset.mem_Icc.mp hj
      exact derivative_basis n j hn (by omega) hjn
    _ = flux n m - flux n (n + 1) :=
      sum_Icc_difference (flux n) m n hmn
    _ = flux n m := by
      have hz : (n - 1).choose n = 0 :=
        Nat.choose_eq_zero_of_lt (by omega)
      simp [flux, hz]

private theorem derivative_central_tail
    (k : ℕ) (hk : 1 ≤ k) :
    derivative (tail (2 * k - 1) k) =
      C (((2 * k - 1 : ℕ) : ℚ) *
        ((2 * k - 2).choose (k - 1) : ℚ)) *
        (1 - (X : Polynomial ℚ) ^ 2) ^ (k - 1) := by
  rw [derivative_tail (2 * k - 1) k (by omega) hk (by omega)]
  have h1 : 2 * k - 1 - 1 = 2 * k - 2 := by omega
  have h2 : 2 * k - 1 - k = k - 1 := by omega
  simp only [flux, h1, h2, U, V]
  rw [mul_assoc, ← mul_pow]
  congr 2
  ring

private def oddPrimitive (k : ℕ) : Polynomial ℚ :=
  ∑ i ∈ Finset.range k,
    C ((-1 : ℚ) ^ i * ((k - 1).choose i : ℚ) /
      (2 * (i : ℚ) + 1)) * X ^ (2 * i + 1)

private def normalizer (k : ℕ) : ℚ :=
  ∑ i ∈ Finset.range k,
    (-1 : ℚ) ^ i * ((k - 1).choose i : ℚ) /
      (2 * (i : ℚ) + 1)

private theorem derivative_odd_term (c : ℚ) (i : ℕ) :
    derivative (C (c / (2 * (i : ℚ) + 1)) * X ^ (2 * i + 1)) =
      C c * X ^ (2 * i) := by
  have he : 2 * i + 1 - 1 = 2 * i := by omega
  have hz : 2 * (i : ℚ) + 1 ≠ 0 := by positivity
  simp only [Polynomial.derivative_mul, Polynomial.derivative_C,
    Polynomial.derivative_pow, Polynomial.derivative_X,
    zero_mul, zero_add, mul_one, he]
  rw [← mul_assoc, ← map_mul]
  congr 2
  push_cast
  field_simp

private theorem binomial_even_polynomial (k : ℕ) (hk : 1 ≤ k) :
    (1 - (X : Polynomial ℚ) ^ 2) ^ (k - 1) =
      ∑ i ∈ Finset.range k,
        C ((-1 : ℚ) ^ i * ((k - 1).choose i : ℚ)) * X ^ (2 * i) := by
  have hr : k - 1 + 1 = k := by omega
  rw [show 1 - (X : Polynomial ℚ) ^ 2 = -(X ^ 2) + 1 by ring, add_pow, hr]
  apply Finset.sum_congr rfl
  intro i hi
  simp only [one_pow, mul_one]
  have hc :
      (C ((-1 : ℚ) ^ i * ((k - 1).choose i : ℚ)) : Polynomial ℚ) =
        (-1 : Polynomial ℚ) ^ i * ((k - 1).choose i : Polynomial ℚ) := by
    simp only [map_mul, map_pow, map_neg, map_one, map_natCast]
  have hpow : (-(X ^ 2) : Polynomial ℚ) ^ i =
      (-1 : Polynomial ℚ) ^ i * X ^ (2 * i) := by
    calc
      (-(X ^ 2) : Polynomial ℚ) ^ i = ((-1) * X ^ 2) ^ i := by congr 1; ring
      _ = (-1 : Polynomial ℚ) ^ i * (X ^ 2) ^ i := mul_pow _ _ _
      _ = (-1 : Polynomial ℚ) ^ i * X ^ (2 * i) := by rw [← pow_mul]
  rw [hc, hpow]
  ring

private theorem derivative_oddPrimitive (k : ℕ) (hk : 1 ≤ k) :
    derivative (oddPrimitive k) = (1 - (X : Polynomial ℚ) ^ 2) ^ (k - 1) := by
  unfold oddPrimitive
  rw [Polynomial.derivative_sum, binomial_even_polynomial k hk]
  apply Finset.sum_congr rfl
  intro i hi
  exact derivative_odd_term _ i

private theorem eval_finite_sum {ι : Type*} (s : Finset ι)
    (f : ι → Polynomial ℚ) (x : ℚ) :
    Polynomial.eval x (∑ i ∈ s, f i) =
      ∑ i ∈ s, Polynomial.eval x (f i) := by
  exact map_sum (Polynomial.evalRingHom x) f s

private theorem oddPrimitive_eval_one (k : ℕ) :
    Polynomial.eval 1 (oddPrimitive k) = normalizer k := by
  unfold oddPrimitive normalizer
  rw [eval_finite_sum]
  apply Finset.sum_congr rfl
  intro i hi
  simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow,
    Polynomial.eval_X, one_pow, mul_one]

private theorem oddPrimitive_eval_neg_one (k : ℕ) :
    Polynomial.eval (-1) (oddPrimitive k) = -normalizer k := by
  unfold oddPrimitive normalizer
  rw [eval_finite_sum, ← Finset.sum_neg_distrib]
  apply Finset.sum_congr rfl
  intro i hi
  have hpow : (-1 : ℚ) ^ (2 * i + 1) = -1 := by
    rw [pow_add, pow_mul]
    norm_num
  simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow,
    Polynomial.eval_X, hpow, mul_neg_one]

private theorem tail_eval_neg_one (n m : ℕ) (hm : 1 ≤ m) :
    Polynomial.eval (-1) (tail n m) = 0 := by
  unfold tail
  rw [eval_finite_sum]
  apply Finset.sum_eq_zero
  intro j hj
  have hj0 : j ≠ 0 := by have := (Finset.mem_Icc.mp hj).1; omega
  simp [basis, U, V, Polynomial.eval_mul, Polynomial.eval_pow,
     Polynomial.eval_add, Polynomial.eval_sub,
    Polynomial.eval_one, Polynomial.eval_X, zero_pow hj0]

private theorem tail_eval_one (n m : ℕ) (hmn : m ≤ n) :
    Polynomial.eval 1 (tail n m) = (2 : ℚ) ^ n := by
  unfold tail
  rw [eval_finite_sum]
  rw [Finset.sum_eq_single n]
  · norm_num [basis, U, V, Polynomial.eval_mul, Polynomial.eval_pow,
      Polynomial.eval_C, Polynomial.eval_add, Polynomial.eval_sub,
      Polynomial.eval_one, Polynomial.eval_X]
  · intro j hj hjn
    have hlt : j < n := by have := (Finset.mem_Icc.mp hj).2; omega
    have he : n - j ≠ 0 := by omega
    simp [basis, U, V, Polynomial.eval_mul, Polynomial.eval_pow,
       Polynomial.eval_add, Polynomial.eval_sub,
      Polynomial.eval_one, Polynomial.eval_X, zero_pow he]
  · intro hnot
    exact (hnot (Finset.mem_Icc.mpr ⟨hmn, le_rfl⟩)).elim

private theorem central_tail_affine_odd (k : ℕ) (hk : 1 ≤ k) :
    ∃ d : ℚ,
      tail (2 * k - 1) k =
        C (((2 * k - 1 : ℕ) : ℚ) *
          ((2 * k - 2).choose (k - 1) : ℚ)) * oddPrimitive k + C d := by
  let c : ℚ := ((2 * k - 1 : ℕ) : ℚ) *
    ((2 * k - 2).choose (k - 1) : ℚ)
  let p := tail (2 * k - 1) k - C c * oddPrimitive k
  refine ⟨p.coeff 0, ?_⟩
  have hp : derivative p = 0 := by
    simp only [p, Polynomial.derivative_sub, Polynomial.derivative_mul,
      Polynomial.derivative_C, zero_mul, zero_add]
    rw [derivative_central_tail k hk, derivative_oddPrimitive k hk]
    simp [c]
  have heq : p = C (p.coeff 0) := by
    apply polynomial_eq_of_derivative_coeff_zero
    · simpa only [Polynomial.derivative_C] using hp
    · simp
  change tail (2 * k - 1) k = C c * oddPrimitive k + C (p.coeff 0)
  linear_combination heq

private theorem central_tail_normalized (k : ℕ) (hk : 1 ≤ k) :
    normalizer k ≠ 0 ∧
    tail (2 * k - 1) k =
      C ((2 : ℚ) ^ (2 * k - 1)) *
        (C (1 / 2 : ℚ) + C (1 / (2 * normalizer k)) * oddPrimitive k) := by
  obtain ⟨d, hd⟩ := central_tail_affine_odd k hk
  let c : ℚ := ((2 * k - 1 : ℕ) : ℚ) *
    ((2 * k - 2).choose (k - 1) : ℚ)
  have hp := congrArg (Polynomial.eval (1 : ℚ)) hd
  have hm := congrArg (Polynomial.eval (-1 : ℚ)) hd
  rw [tail_eval_one _ _ (by omega)] at hp
  rw [tail_eval_neg_one _ _ hk] at hm
  simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C,
    oddPrimitive_eval_one, oddPrimitive_eval_neg_one] at hp hm
  change (2 : ℚ) ^ (2 * k - 1) = c * normalizer k + d at hp
  change (0 : ℚ) = c * -normalizer k + d at hm
  have hprod : 2 * c * normalizer k = (2 : ℚ) ^ (2 * k - 1) := by
    linear_combination -hp + hm
  have hI : normalizer k ≠ 0 := by
    intro hz
    rw [hz] at hprod
    have hp2 : (2 : ℚ) ^ (2 * k - 1) ≠ 0 := pow_ne_zero _ (by norm_num)
    exact hp2 (by simpa using hprod.symm)
  have hc : c = (2 : ℚ) ^ (2 * k - 1) * (1 / (2 * normalizer k)) := by
    field_simp [hI]
    linear_combination hprod
  have hd' : d = (2 : ℚ) ^ (2 * k - 1) * (1 / 2) := by
    linear_combination -(hp + hm) / 2
  refine ⟨hI, ?_⟩
  change tail (2 * k - 1) k = C c * oddPrimitive k + C d at hd
  rw [hc, hd'] at hd
  rw [hd]
  simp only [map_mul]
  ring

private def exactQk (k : ℕ) (t : ℚ) : ℚ :=
  1 / 2 + (1 / (2 * normalizer k)) *
    ∑ i ∈ Finset.range k,
      (-1 : ℚ) ^ i * ((k - 1).choose i : ℚ) *
        t ^ (2 * i + 1) / (2 * (i : ℚ) + 1)

private theorem oddPrimitive_eval (k : ℕ) (t : ℚ) :
    Polynomial.eval t (oddPrimitive k) =
      ∑ i ∈ Finset.range k,
        (-1 : ℚ) ^ i * ((k - 1).choose i : ℚ) *
          t ^ (2 * i + 1) / (2 * (i : ℚ) + 1) := by
  unfold oddPrimitive
  rw [eval_finite_sum]
  apply Finset.sum_congr rfl
  intro i hi
  simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow,
    Polynomial.eval_X]
  ring

private theorem central_tail_eval_normalized (k : ℕ) (hk : 1 ≤ k) (t : ℚ) :
    Polynomial.eval t (tail (2 * k - 1) k) =
      (2 : ℚ) ^ (2 * k - 1) * exactQk k t := by
  rw [(central_tail_normalized k hk).2]
  simp only [Polynomial.eval_mul, Polynomial.eval_add, Polynomial.eval_C,
    oddPrimitive_eval, exactQk]

private theorem homogeneous_split_product
    (n j : ℕ) (hjn : j ≤ n) (r u v : ℚ) :
    (r * u) ^ j * (r * v) ^ (n - j) =
      r ^ n * u ^ j * v ^ (n - j) := by
  rw [mul_pow, mul_pow]
  have he : j + (n - j) = n := by omega
  calc
    r ^ j * u ^ j * (r ^ (n - j) * v ^ (n - j)) =
        (r ^ j * r ^ (n - j)) * u ^ j * v ^ (n - j) := by ring
    _ = r ^ n * u ^ j * v ^ (n - j) := by rw [← pow_add, he]

private theorem normalized_binomial_tail
    (k : ℕ) (hk : 1 ≤ k) (A B : ℚ) (hS : A + B ≠ 0) :
    normalizer k ≠ 0 ∧
    (A + B) ^ (2 * k - 1) * exactQk k ((A - B) / (A + B)) =
      ∑ j ∈ Finset.Icc k (2 * k - 1),
        ((2 * k - 1).choose j : ℚ) * A ^ j * B ^ (2 * k - 1 - j) := by
  let t : ℚ := (A - B) / (A + B)
  let r : ℚ := (A + B) / 2
  have ha : A = r * (1 + t) := by
    dsimp [r, t]
    field_simp [hS]
    ring
  have hb : B = r * (1 - t) := by
    dsimp [r, t]
    field_simp
    ring
  have htail :
      (∑ j ∈ Finset.Icc k (2 * k - 1),
        ((2 * k - 1).choose j : ℚ) * A ^ j * B ^ (2 * k - 1 - j)) =
      r ^ (2 * k - 1) * Polynomial.eval t (tail (2 * k - 1) k) := by
    unfold tail
    rw [eval_finite_sum, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j hj
    have hjn := (Finset.mem_Icc.mp hj).2
    have hsplit :
        A ^ j * B ^ (2 * k - 1 - j) =
          r ^ (2 * k - 1) * (1 + t) ^ j * (1 - t) ^ (2 * k - 1 - j) := by
      calc
        A ^ j * B ^ (2 * k - 1 - j) =
            (r * (1 + t)) ^ j * (r * (1 - t)) ^ (2 * k - 1 - j) :=
          congrArg₂ (fun a b : ℚ => a ^ j * b ^ (2 * k - 1 - j)) ha hb
        _ = _ := homogeneous_split_product _ _ hjn r (1 + t) (1 - t)
    simp only [basis, U, V, Polynomial.eval_mul, Polynomial.eval_pow,
      Polynomial.eval_C, Polynomial.eval_add, Polynomial.eval_sub,
      Polynomial.eval_one, Polynomial.eval_X]
    linear_combination ((2 * k - 1).choose j : ℚ) * hsplit
  rw [central_tail_eval_normalized k hk t] at htail
  have hr : r * 2 = A + B := by dsimp [r]; ring
  rw [← mul_assoc, ← mul_pow, hr] at htail
  exact ⟨(central_tail_normalized k hk).1, htail.symm⟩

private theorem scalar_graph_transfer (k : ℕ)
    (P Q d e u v : ℚ)
    (hg : P * u = Q * v) (hs : e ^ k * v - d ^ k * u = 1) :
    (e ^ k * P - d ^ k * Q) * u = Q ∧
      (e ^ k * P - d ^ k * Q) * v = P := by
  constructor
  · linear_combination e ^ k * hg + Q * hs
  · linear_combination d ^ k * hg + P * hs

private theorem scalar_original_SQ_value
    (k : ℕ) (hk : 1 ≤ k)
    (κ β P Q d e u v : ℚ) (hκ : κ ≠ 0)
    (hno : P ≠ 0 ∨ Q ≠ 0)
    (hg : P * u = Q * v) (hs : e ^ k * v - d ^ k * u = 1)
    (hres : e ^ k * P - d ^ k * Q =
      κ * (d + β * e) ^ (2 * k - 1))
    (htail : d ^ k * Q =
      -κ * (∑ j ∈ Finset.Icc k (2 * k - 1),
        ((2 * k - 1).choose j : ℚ) * d ^ j *
          (β * e) ^ (2 * k - 1 - j))) :
    d ^ k * u = -exactQk k ((d - β * e) / (d + β * e)) := by
  have htrans := scalar_graph_transfer k P Q d e u v hg hs
  have hS : d + β * e ≠ 0 := by
    intro hz
    have hn : 2 * k - 1 ≠ 0 := by omega
    have hR0 : e ^ k * P - d ^ k * Q = 0 := by
      rw [hres, hz, zero_pow hn, mul_zero]
    have hQ0 : Q = 0 := by simpa [hR0] using htrans.1.symm
    have hP0 : P = 0 := by simpa [hR0] using htrans.2.symm
    rcases hno with hp | hq
    · exact hp hP0
    · exact hq hQ0
  have hnorm := (normalized_binomial_tail k hk d (β * e) hS).2
  rw [← hnorm] at htail
  rw [hres] at htrans
  have hprod :
      (κ * (d + β * e) ^ (2 * k - 1)) *
        (d ^ k * u + exactQk k ((d - β * e) / (d + β * e))) = 0 := by
    linear_combination d ^ k * htrans.1 + htail
  have hz := (mul_eq_zero.mp hprod).resolve_left
    (mul_ne_zero hκ (pow_ne_zero _ hS))
  linear_combination hz

open JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure

private theorem rational_pure_descent_nonaxis
    (n : ℕ) (hn : 1 ≤ n) (p : Polynomial ℚ)
    (γ a b : ℂ) (hγ : γ ≠ 0) (ha : a ≠ 0)
    (hp : p.map (Rat.castHom ℂ) =
      Polynomial.C γ * (Polynomial.C a * Polynomial.X + Polynomial.C b) ^ n) :
    ∃ κ β : ℚ, κ ≠ 0 ∧
      p = Polynomial.C κ * (Polynomial.X + Polynomial.C β) ^ n := by
  have hfac : (Polynomial.C a * Polynomial.X + Polynomial.C b : Polynomial ℂ) =
      Polynomial.C a * (Polynomial.X + Polynomial.C (b / a)) := by
    rw [mul_add, ← Polynomial.C_mul, mul_div_cancel₀ b ha]
  have hn0 : (n : ℂ) ≠ 0 := by exact_mod_cast (by omega : n ≠ 0)
  have htop : (p.coeff n : ℂ) = γ * a ^ n := by
    have h := congrArg (fun f : Polynomial ℂ => f.coeff n) hp
    rw [Polynomial.coeff_map, hfac, mul_pow, ← Polynomial.C_pow,
      ← mul_assoc, ← Polynomial.C_mul,
      Polynomial.coeff_C_mul, Polynomial.coeff_X_add_C_pow] at h
    simpa using h
  have hchoose : n.choose (n - 1) = n := by
    have h := Nat.choose_symm (show n - 1 ≤ n by omega)
    have he : n - (n - 1) = 1 := by omega
    rw [he] at h
    simpa using h.symm
  have hnext : (p.coeff (n - 1) : ℂ) = γ * a ^ n * (b / a) * (n : ℂ) := by
    have h := congrArg (fun f : Polynomial ℂ => f.coeff (n - 1)) hp
    rw [Polynomial.coeff_map, hfac, mul_pow, ← Polynomial.C_pow,
      ← mul_assoc, ← Polynomial.C_mul,
      Polynomial.coeff_C_mul, Polynomial.coeff_X_add_C_pow] at h
    have he : n - (n - 1) = 1 := by omega
    rw [he, pow_one, hchoose] at h
    simpa [mul_assoc] using h
  let κ : ℚ := p.coeff n
  let β : ℚ := p.coeff (n - 1) / ((n : ℚ) * p.coeff n)
  have hκ : κ ≠ 0 := by
    intro hz
    have hzC : (p.coeff n : ℂ) = 0 := by exact_mod_cast hz
    rw [htop] at hzC
    exact (mul_ne_zero hγ (pow_ne_zero n ha)) hzC
  have hβ : (β : ℂ) = b / a := by
    dsimp [β]
    push_cast
    rw [htop, hnext]
    field_simp [hγ, ha, hn0]
  refine ⟨κ, β, hκ, ?_⟩
  have hmaps :
      p.map (Rat.castHom ℂ) =
      (Polynomial.C κ * (Polynomial.X + Polynomial.C β) ^ n).map
        (Rat.castHom ℂ) := by
    rw [hp, hfac, mul_pow, ← Polynomial.C_pow, ← mul_assoc, ← Polynomial.C_mul]
    simp only [Polynomial.map_mul, Polynomial.map_pow, Polynomial.map_add,
      Polynomial.map_C, Polynomial.map_X]
    change Polynomial.C (γ * a ^ n) * (Polynomial.X + Polynomial.C (b / a)) ^ n =
      Polynomial.C (κ : ℂ) * (Polynomial.X + Polynomial.C (β : ℂ)) ^ n
    rw [hβ]
    have hκC : (κ : ℂ) = γ * a ^ n := htop
    rw [hκC]
  apply Polynomial.ext
  intro i
  have h := congrArg (fun f : Polynomial ℂ => f.coeff i) hmaps
  simp only [Polynomial.coeff_map] at h
  exact (Rat.castHom ℂ).injective h

private theorem upper_block_zero_of_constant
    (k : ℕ) (hk : 1 ≤ k) (p q : Polynomial ℂ)
    (hp : p.natDegree < k) (c : ℂ)
    (h : p + Polynomial.X ^ k * q = Polynomial.C c) : q = 0 := by
  apply Polynomial.ext
  intro i
  have he := congrArg (fun f : Polynomial ℂ => f.coeff (i + k)) h
  have hpi : p.coeff (i + k) = 0 :=
    Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)
  have hi0 : i + k ≠ 0 := by omega
  rw [Polynomial.coeff_add, hpi, zero_add,
    Polynomial.coeff_X_pow_mul', if_pos (by omega : k ≤ i + k),
    show i + k - k = i by omega,
    Polynomial.coeff_C, if_neg hi0] at he
  simpa using he

private theorem lower_block_zero_of_high_monomial
    (k n : ℕ) (hkn : k ≤ n) (p q : Polynomial ℂ)
    (hp : p.natDegree < k) (c : ℂ)
    (h : p + Polynomial.X ^ k * q = Polynomial.C c * Polynomial.X ^ n) :
    p = 0 := by
  apply Polynomial.ext
  intro i
  by_cases hik : i < k
  · have he := congrArg (fun f : Polynomial ℂ => f.coeff i) h
    rw [Polynomial.coeff_add, Polynomial.coeff_X_pow_mul',
      if_neg (by omega : ¬ k ≤ i), add_zero,
      Polynomial.coeff_C_mul_X_pow, if_neg (by omega : i ≠ n)] at he
    simpa using he
  · exact Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)

private theorem upper_block_coeff
    (k n : ℕ) (p q : Polynomial ℚ) (hp : p.natDegree < k)
    (κ β : ℚ)
    (h : p - Polynomial.X ^ k * q =
      Polynomial.C κ * (Polynomial.X + Polynomial.C β) ^ n)
    (i : ℕ) :
    q.coeff i =
