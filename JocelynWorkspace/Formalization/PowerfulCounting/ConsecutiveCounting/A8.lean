private lemma spacing_of_step (f : ℕ → ℝ) (g : ℝ) (hstep : ∀ j : ℕ, g ≤ f (j + 1) - f j) :
    ∀ i j : ℕ, i ≤ j → ((j : ℝ) - i) * g ≤ f j - f i := by
  intro i j hij
  induction j, hij using Nat.le_induction with
  | base => simp
  | succ k hik ih =>
    have h1 := hstep k
    have h2 : (((k + 1 : ℕ) : ℝ) - i) * g = ((k : ℝ) - i) * g + g := by push_cast; ring
    rw [h2]
    linarith

private lemma count_window (f : ℕ → ℝ) (g : ℝ) (hg : 0 < g)
    (hsp : ∀ i j : ℕ, i ≤ j → ((j : ℝ) - i) * g ≤ f j - f i)
    (S : Finset ℕ) (c r : ℝ) (hr : 0 ≤ r)
    (hS : ∀ j ∈ S, |f j - c| ≤ r) :
    (S.card : ℝ) ≤ 1 + 2 * r / g := by
  rcases S.eq_empty_or_nonempty with h | hne
  · rw [h, Finset.card_empty, Nat.cast_zero]
    have : 0 ≤ 2 * r / g := by positivity
    linarith
  · have hamem : S.min' hne ∈ S := S.min'_mem hne
    have hbmem : S.max' hne ∈ S := S.max'_mem hne
    have hab : S.min' hne ≤ S.max' hne := S.min'_le _ hbmem
    have hsub : S ⊆ Finset.Icc (S.min' hne) (S.max' hne) := by
      intro j hj
      rw [Finset.mem_Icc]
      exact ⟨S.min'_le j hj, S.le_max' j hj⟩
    have hcard : S.card ≤ S.max' hne + 1 - S.min' hne := by
      have := Finset.card_le_card hsub
      rwa [Nat.card_Icc] at this
    have h1 := hsp _ _ hab
    have ha := abs_le.mp (hS _ hamem)
    have hb := abs_le.mp (hS _ hbmem)
    have h2 : ((S.max' hne : ℕ) : ℝ) - ((S.min' hne : ℕ) : ℝ) ≤ 2 * r / g := by
      rw [le_div_iff₀ hg]
      linarith
    have hcardR : (S.card : ℝ) ≤ ((S.max' hne : ℕ) : ℝ) + 1 - ((S.min' hne : ℕ) : ℝ) := by
      have h3 : (S.card : ℝ) ≤ ((S.max' hne + 1 - S.min' hne : ℕ) : ℝ) := by exact_mod_cast hcard
      rw [Nat.cast_sub (by omega), Nat.cast_add, Nat.cast_one] at h3
      exact h3
    linarith

private lemma sum_bound (fmax A g : ℝ) (N : ℕ) (hf : 0 ≤ fmax) (hA : 0 ≤ A) (hg : 0 < g) :
    ∑ n2 ∈ Finset.Icc 1 N, (⌊fmax * n2 + A⌋₊ : ℝ) * (1 + 2 * (A / n2) / g)
      ≤ N * (fmax * N + A + 2 * A * fmax / g + 2 * A ^ 2 / g) := by
  have hterm : ∀ n2 ∈ Finset.Icc 1 N, (⌊fmax * n2 + A⌋₊ : ℝ) * (1 + 2 * (A / n2) / g)
      ≤ fmax * N + A + 2 * A * fmax / g + 2 * A ^ 2 / g := by
    intro n2 hn2
    rw [Finset.mem_Icc] at hn2
    have hn1 : (1:ℝ) ≤ n2 := by exact_mod_cast hn2.1
    have hnN : (n2:ℝ) ≤ N := by exact_mod_cast hn2.2
    have hpos : (0:ℝ) < n2 := by linarith
    have hfl : (⌊fmax * n2 + A⌋₊ : ℝ) ≤ fmax * n2 + A := Nat.floor_le (by positivity)
    have hnn : 0 ≤ 1 + 2 * (A / n2) / g := by positivity
    calc (⌊fmax * n2 + A⌋₊ : ℝ) * (1 + 2 * (A / n2) / g)
        ≤ (fmax * n2 + A) * (1 + 2 * (A / n2) / g) := mul_le_mul_of_nonneg_right hfl hnn
      _ = fmax * n2 + A + 2 * A * fmax / g + 2 * A ^ 2 / g * (1 / n2) := by
          field_simp
          ring
      _ ≤ fmax * N + A + 2 * A * fmax / g + 2 * A ^ 2 / g * 1 := by
          have h1 : fmax * n2 ≤ fmax * N := mul_le_mul_of_nonneg_left hnN hf
          have h2 : 1 / (n2:ℝ) ≤ 1 := by rw [div_le_one hpos]; exact hn1
          have h3 : 0 ≤ 2 * A ^ 2 / g := by positivity
          have h4 := mul_le_mul_of_nonneg_left h2 h3
          linarith
      _ = fmax * N + A + 2 * A * fmax / g + 2 * A ^ 2 / g := by ring
  calc ∑ n2 ∈ Finset.Icc 1 N, (⌊fmax * n2 + A⌋₊ : ℝ) * (1 + 2 * (A / n2) / g)
      ≤ (Finset.Icc 1 N).card • (fmax * N + A + 2 * A * fmax / g + 2 * A ^ 2 / g) :=
        Finset.sum_le_card_nsmul _ _ _ hterm
    _ = N * (fmax * N + A + 2 * A * fmax / g + 2 * A ^ 2 / g) := by
        rw [Nat.card_Icc, nsmul_eq_mul]
        simp

private lemma tail_abstract (f : ℕ → ℝ) (g fmin fmax A B : ℝ) (hg : 0 < g)
    (hsp : ∀ i j : ℕ, i ≤ j → ((j : ℝ) - i) * g ≤ f j - f i)
    (S : Finset ℕ) (hfmin : ∀ j ∈ S, fmin ≤ f j) (hfmax : ∀ j ∈ S, f j ≤ fmax)
    (hA0 : 0 ≤ A) (hA1 : A < 1) (hAf : A < fmin)
    (P : Finset ℕ) (hPS : P ⊆ S)
    (hP : ∀ j ∈ P, ∃ x1 x2 : ℤ, (x1, x2) ≠ (0 : ℤ × ℤ) ∧
      |(x1 : ℝ) - f j * x2| ≤ A ∧ |(x2 : ℝ)| ≤ B) :
    (P.card : ℝ) ≤ ∑ n2 ∈ Finset.Icc 1 ⌊B⌋₊,
        (⌊fmax * n2 + A⌋₊ : ℝ) * (1 + 2 * (A / n2) / g) := by
  classical
  have hwit : ∀ j ∈ P, ∃ n2 ∈ Finset.Icc 1 ⌊B⌋₊, ∃ n1 ∈ Finset.Icc 1 ⌊fmax * n2 + A⌋₊,
      |(n1 : ℝ) - f j * n2| ≤ A := by
    intro j hj
    obtain ⟨x1, x2, hne, h1, h2⟩ := hP j hj
    have hjS := hPS hj
    have hfj : fmin ≤ f j := hfmin j hjS
    have hfj' : f j ≤ fmax := hfmax j hjS
    have key : ∃ y1 y2 : ℤ, 0 < y2 ∧ |(y1 : ℝ) - f j * y2| ≤ A ∧ |(y2 : ℝ)| ≤ B := by
      rcases lt_trichotomy x2 0 with hx2 | hx2 | hx2
      · refine ⟨-x1, -x2, by omega, ?_, ?_⟩
        · push_cast
          have e : (-(x1:ℝ) - f j * -(x2:ℝ)) = -((x1:ℝ) - f j * x2) := by ring
          rw [e, abs_neg]; exact h1
        · push_cast; rw [abs_neg]; exact h2
      · exfalso
        subst hx2
        apply hne
        have h3 : |(x1 : ℝ)| ≤ A := by simpa using h1
        have hlt : |(x1 : ℝ)| < 1 := lt_of_le_of_lt h3 hA1
        have h4 : |x1| < 1 := by exact_mod_cast hlt
        have h5 : x1 = 0 := by rw [abs_lt] at h4; omega
        simp [h5]
      · exact ⟨x1, x2, hx2, h1, h2⟩
    obtain ⟨y1, y2, hy2, h1, h2⟩ := key
    have hy2R : (1 : ℝ) ≤ y2 := by exact_mod_cast hy2
    have hfpos : 0 < f j := by linarith
    have hy1 : 0 < y1 := by
      by_contra hc
      push Not at hc
      have hy1R : (y1 : ℝ) ≤ 0 := by exact_mod_cast hc
      have h5 : f j ≤ f j * y2 := by nlinarith
      have habs := (abs_le.mp h1).1
      linarith
    obtain ⟨n1, rfl⟩ := Int.eq_ofNat_of_zero_le hy1.le
    obtain ⟨n2, rfl⟩ := Int.eq_ofNat_of_zero_le hy2.le
    have e1 : ((n1 : ℤ) : ℝ) = (n1 : ℝ) := Int.cast_natCast n1
    have e2 : ((n2 : ℤ) : ℝ) = (n2 : ℝ) := Int.cast_natCast n2
    rw [e1, e2] at h1
    rw [e2] at h2 hy2R
    have hn1pos : 1 ≤ n1 := by omega
    have hn2pos : 1 ≤ n2 := by omega
    have hn1up : (n1 : ℝ) ≤ fmax * n2 + A := by
      have h6 := (abs_le.mp h1).2
      have h7 : f j * n2 ≤ fmax * n2 := by nlinarith
      linarith
    have hn2up : (n2 : ℝ) ≤ B := le_trans (le_abs_self _) h2
    refine ⟨n2, ?_, n1, ?_, h1⟩
    · rw [Finset.mem_Icc]
      exact ⟨hn2pos, Nat.le_floor hn2up⟩
    · rw [Finset.mem_Icc]
      exact ⟨hn1pos, Nat.le_floor hn1up⟩
  have hsub : P ⊆ (Finset.Icc 1 ⌊B⌋₊).biUnion (fun n2 =>
      (Finset.Icc 1 ⌊fmax * n2 + A⌋₊).biUnion (fun n1 =>
        S.filter (fun j => |(n1 : ℝ) - f j * n2| ≤ A))) := by
    intro j hj
    obtain ⟨n2, hn2, n1, hn1, h⟩ := hwit j hj
    rw [Finset.mem_biUnion]
    refine ⟨n2, hn2, ?_⟩
    rw [Finset.mem_biUnion]
    refine ⟨n1, hn1, ?_⟩
    rw [Finset.mem_filter]
    exact ⟨hPS hj, h⟩
  calc (P.card : ℝ)
      ≤ (((Finset.Icc 1 ⌊B⌋₊).biUnion (fun n2 =>
          (Finset.Icc 1 ⌊fmax * n2 + A⌋₊).biUnion (fun n1 =>
            S.filter (fun j => |(n1 : ℝ) - f j * n2| ≤ A)))).card : ℝ) := by
        exact_mod_cast Finset.card_le_card hsub
    _ ≤ ∑ n2 ∈ Finset.Icc 1 ⌊B⌋₊, (((Finset.Icc 1 ⌊fmax * n2 + A⌋₊).biUnion (fun n1 =>
            S.filter (fun j => |(n1 : ℝ) - f j * n2| ≤ A))).card : ℝ) := by
        exact_mod_cast Finset.card_biUnion_le
    _ ≤ ∑ n2 ∈ Finset.Icc 1 ⌊B⌋₊, ∑ n1 ∈ Finset.Icc 1 ⌊fmax * n2 + A⌋₊,
          ((S.filter (fun j => |(n1 : ℝ) - f j * n2| ≤ A)).card : ℝ) := by
        apply Finset.sum_le_sum
        intro n2 _
        exact_mod_cast Finset.card_biUnion_le
    _ ≤ ∑ n2 ∈ Finset.Icc 1 ⌊B⌋₊, ∑ n1 ∈ Finset.Icc 1 ⌊fmax * n2 + A⌋₊,
          (1 + 2 * (A / n2) / g) := by
        apply Finset.sum_le_sum
        intro n2 hn2
        apply Finset.sum_le_sum
        intro n1 _
        have hn2pos : (0:ℝ) < n2 := by
          have := (Finset.mem_Icc.mp hn2).1
          exact_mod_cast this
        apply count_window f g hg hsp _ ((n1:ℝ) / n2) (A / n2) (by positivity)
        intro j hj
        rw [Finset.mem_filter] at hj
        have e : f j - (n1:ℝ) / n2 = -((n1:ℝ) - f j * n2) / n2 := by
          field_simp
          ring
        rw [e, abs_div, abs_neg, abs_of_pos hn2pos]
        exact div_le_div_of_nonneg_right hj.2 hn2pos.le
    _ = ∑ n2 ∈ Finset.Icc 1 ⌊B⌋₊, (⌊fmax * n2 + A⌋₊ : ℝ) * (1 + 2 * (A / n2) / g) := by
        apply Finset.sum_congr rfl
        intro n2 _
        rw [Finset.sum_const, Nat.card_Icc, nsmul_eq_mul]
        simp

private lemma coords_of_inv_norm (L p q : ℝ) (hL : 0 < L) (h : L ≤ 2 / Real.sqrt (p ^ 2 + q ^ 2)) :
    |p| ≤ 2 / L ∧ |q| ≤ 2 / L := by
  have hs0 : 0 ≤ Real.sqrt (p ^ 2 + q ^ 2) := Real.sqrt_nonneg _
  have hs : 0 < Real.sqrt (p ^ 2 + q ^ 2) := by
    rcases hs0.lt_or_eq with h' | h'
    · exact h'
    · rw [← h', div_zero] at h; linarith
  have hsL : Real.sqrt (p ^ 2 + q ^ 2) ≤ 2 / L := by
    rw [le_div_iff₀ hL]
    rw [le_div_iff₀ hs] at h
    linarith
  constructor
  · exact le_trans (Real.abs_le_sqrt (by nlinarith [sq_nonneg q])) hsL
  · exact le_trans (Real.abs_le_sqrt (by nlinarith [sq_nonneg p])) hsL

private lemma scaled_abs (k y r : ℝ) (hk : 0 < k) (h : |k * y| ≤ r) : |y| ≤ r / k := by
  rw [abs_mul, abs_of_pos hk] at h
  rw [le_div_iff₀ hk]
  linarith

private lemma div_abs_le (y c r : ℝ) (hc : 0 < c) (h : |y / c| ≤ r) : |y| ≤ r * c := by
  rw [abs_div, abs_of_pos hc, div_le_iff₀ hc] at h
  exact h

private lemma pointwise_shell (ℓ Ls θ : ℝ) (K : ℕ) (hLs : 0 < Ls) (hℓ0 : 0 ≤ ℓ) (hθ : 0 ≤ θ)
    (hK : ℓ ≤ 2 ^ K * Ls) :
    ℓ ^ θ ≤ Ls ^ θ + ∑ k ∈ Finset.range K,
      (if 2 ^ k * Ls ≤ ℓ then ((2:ℝ) ^ (k + 1) * Ls) ^ θ else 0) := by
  have hnn : ∀ k ∈ Finset.range K,
      0 ≤ (if 2 ^ k * Ls ≤ ℓ then ((2:ℝ) ^ (k + 1) * Ls) ^ θ else 0) := by
    intro k _
    split_ifs
    · positivity
    · exact le_refl 0
  have hsum0 := Finset.sum_nonneg hnn
  by_cases h1 : ℓ ≤ Ls
  · have h2 : ℓ ^ θ ≤ Ls ^ θ := Real.rpow_le_rpow hℓ0 h1 hθ
    linarith
  · push Not at h1
    have hex : ∃ k : ℕ, ℓ ≤ 2 ^ k * Ls := ⟨K, hK⟩
    have hk0 : ℓ ≤ 2 ^ (Nat.find hex) * Ls := Nat.find_spec hex
    have hk0pos : 0 < Nat.find hex := by
      by_contra h
      have h0 : Nat.find hex = 0 := by omega
      rw [h0, pow_zero, one_mul] at hk0
      linarith
    have hk0K : Nat.find hex ≤ K := Nat.find_min' hex hK
    have hlow : 2 ^ (Nat.find hex - 1) * Ls < ℓ := by
      have h3 := Nat.find_min hex (show Nat.find hex - 1 < Nat.find hex by omega)
      push Not at h3
      exact h3
    have hmem : Nat.find hex - 1 ∈ Finset.range K := by rw [Finset.mem_range]; omega
    have hterm : ℓ ^ θ ≤ (if 2 ^ (Nat.find hex - 1) * Ls ≤ ℓ
        then ((2:ℝ) ^ (Nat.find hex - 1 + 1) * Ls) ^ θ else 0) := by
      rw [if_pos hlow.le, Nat.sub_add_cancel hk0pos]
      exact Real.rpow_le_rpow hℓ0 hk0 hθ
    have hsingle := Finset.single_le_sum hnn hmem
    have h4 : 0 ≤ Ls ^ θ := by positivity
    linarith

private lemma geom_le (r : ℝ) (hr0 : 0 ≤ r) (hr1 : r < 1) (K : ℕ) :
    ∑ k ∈ Finset.range K, r ^ k ≤ 1 / (1 - r) := by
  have h1 : 0 < 1 - r := by linarith
  have hrK : 0 ≤ r ^ K := pow_nonneg hr0 K
  rw [geom_sum_eq (ne_of_lt hr1) K]
  have e : (r ^ K - 1) / (r - 1) = (1 - r ^ K) / (1 - r) := by
    rw [div_eq_div_iff (ne_of_lt (by linarith)) h1.ne']
    ring
  rw [e]
  apply div_le_div_of_nonneg_right _ h1.le
  linarith

private lemma moment_from_tails (θ : ℝ) (hθ0 : 0 < θ) (r : ℝ) (hr : r = (2:ℝ) ^ θ / 4) (hr1 : r < 1)
    (S : Finset ℕ) (ℓ : ℕ → ℝ) (hℓ0 : ∀ j ∈ S, 0 ≤ ℓ j)
    (Ls Mr K0 Q : ℝ) (hLs : 0 < Ls) (hMr : 1 ≤ Mr) (_hQ0 : 0 ≤ Q) (hQ : Q ≤ Mr * Ls ^ 2)
    (hK0 : 0 ≤ K0)
    (hcard : (S.card : ℝ) ≤ 3 * Mr + 1)
    (htail : ∀ L : ℝ, Ls ≤ L → ((S.filter (fun j => L ≤ ℓ j)).card : ℝ) ≤ K0 * Q / L ^ 2) :
    ∑ j ∈ S, ℓ j ^ θ ≤ (4 + K0 * 2 ^ θ / (1 - r)) * Mr * Ls ^ θ := by
  classical
  have h2θ : 0 < (2:ℝ) ^ θ := Real.rpow_pos_of_pos (by norm_num) θ
  have hr0 : 0 ≤ r := by rw [hr]; positivity
  have h1r : 0 < 1 - r := by linarith
  have hLsθ : 0 ≤ Ls ^ θ := by positivity
  obtain ⟨K, hKb⟩ : ∃ K : ℕ, ∀ j ∈ S, ℓ j ≤ 2 ^ K * Ls := by
    refine ⟨S.sup (fun j => ⌈ℓ j / Ls⌉₊), ?_⟩
    intro j hj
    have h1 : ℓ j / Ls ≤ (⌈ℓ j / Ls⌉₊ : ℝ) := Nat.le_ceil _
    have h2 : ⌈ℓ j / Ls⌉₊ ≤ S.sup (fun j => ⌈ℓ j / Ls⌉₊) :=
      Finset.le_sup (f := fun j => ⌈ℓ j / Ls⌉₊) hj
    have h3 : S.sup (fun j => ⌈ℓ j / Ls⌉₊) < 2 ^ (S.sup (fun j => ⌈ℓ j / Ls⌉₊)) :=
      Nat.lt_two_pow_self
    have h4 : (⌈ℓ j / Ls⌉₊ : ℝ) ≤ ((2 ^ (S.sup (fun j => ⌈ℓ j / Ls⌉₊)) : ℕ) : ℝ) := by
      exact_mod_cast (le_trans h2 h3.le)
    push_cast at h4
    have h5 : ℓ j / Ls ≤ 2 ^ (S.sup (fun j => ⌈ℓ j / Ls⌉₊)) := le_trans h1 h4
    rwa [div_le_iff₀ hLs] at h5
  have hpt : ∀ j ∈ S, ℓ j ^ θ ≤ Ls ^ θ + ∑ k ∈ Finset.range K,
      (if 2 ^ k * Ls ≤ ℓ j then ((2:ℝ) ^ (k + 1) * Ls) ^ θ else 0) :=
    fun j hj => pointwise_shell (ℓ j) Ls θ K hLs (hℓ0 j hj) hθ0.le (hKb j hj)
  have hshell : ∀ k ∈ Finset.range K, ∑ j ∈ S,
      (if 2 ^ k * Ls ≤ ℓ j then ((2:ℝ) ^ (k + 1) * Ls) ^ θ else 0)
        ≤ K0 * 2 ^ θ * Mr * Ls ^ θ * r ^ k := by
    intro k _
    rw [Finset.sum_ite, Finset.sum_const_zero, add_zero, Finset.sum_const, nsmul_eq_mul]
    have h2k : (1:ℝ) ≤ 2 ^ k := one_le_pow₀ (by norm_num)
    have hL : Ls ≤ 2 ^ k * Ls := by nlinarith
    have hcnt := htail (2 ^ k * Ls) hL
    have hw : ((2:ℝ) ^ (k + 1) * Ls) ^ θ = 2 ^ θ * ((2:ℝ) ^ θ) ^ k * Ls ^ θ := by
      rw [Real.mul_rpow (by positivity) hLs.le, ← Real.rpow_natCast_mul (by norm_num),
        mul_comm ((k + 1 : ℕ) : ℝ) θ, Real.rpow_mul_natCast (by norm_num), pow_succ]
      ring
    rw [hw]
    have hwnn : 0 ≤ 2 ^ θ * ((2:ℝ) ^ θ) ^ k * Ls ^ θ := by positivity
    calc ((S.filter (fun j => 2 ^ k * Ls ≤ ℓ j)).card : ℝ) * (2 ^ θ * ((2:ℝ) ^ θ) ^ k * Ls ^ θ)
        ≤ K0 * Q / (2 ^ k * Ls) ^ 2 * (2 ^ θ * ((2:ℝ) ^ θ) ^ k * Ls ^ θ) :=
          mul_le_mul_of_nonneg_right hcnt hwnn
      _ ≤ K0 * (Mr * Ls ^ 2) / (2 ^ k * Ls) ^ 2 * (2 ^ θ * ((2:ℝ) ^ θ) ^ k * Ls ^ θ) := by
          gcongr
      _ = K0 * 2 ^ θ * Mr * Ls ^ θ * r ^ k := by
          have h4k : (4:ℝ) ^ k = ((2:ℝ) ^ k) ^ 2 := by
            rw [← pow_mul, mul_comm k 2, pow_mul]
            norm_num
          have hLs' : Ls ≠ 0 := hLs.ne'
          rw [hr, div_pow, h4k]
          field_simp
  have hgeom := geom_le r hr0 hr1 K
  have hA : (S.card : ℝ) * Ls ^ θ ≤ (3 * Mr + 1) * Ls ^ θ :=
    mul_le_mul_of_nonneg_right hcard hLsθ
  have hB : ∑ k ∈ Finset.range K, ∑ j ∈ S,
      (if 2 ^ k * Ls ≤ ℓ j then ((2:ℝ) ^ (k + 1) * Ls) ^ θ else 0)
        ≤ K0 * 2 ^ θ * Mr * Ls ^ θ * (1 / (1 - r)) := by
    calc ∑ k ∈ Finset.range K, ∑ j ∈ S,
          (if 2 ^ k * Ls ≤ ℓ j then ((2:ℝ) ^ (k + 1) * Ls) ^ θ else 0)
        ≤ ∑ k ∈ Finset.range K, K0 * 2 ^ θ * Mr * Ls ^ θ * r ^ k := Finset.sum_le_sum hshell
      _ = K0 * 2 ^ θ * Mr * Ls ^ θ * ∑ k ∈ Finset.range K, r ^ k := by rw [Finset.mul_sum]
      _ ≤ K0 * 2 ^ θ * Mr * Ls ^ θ * (1 / (1 - r)) := by
          apply mul_le_mul_of_nonneg_left hgeom
          have : (0:ℝ) ≤ Mr := by linarith
          positivity
  have hC : (3 * Mr + 1) * Ls ^ θ ≤ 4 * Mr * Ls ^ θ := by nlinarith
  have e : K0 * 2 ^ θ * Mr * Ls ^ θ * (1 / (1 - r)) = K0 * 2 ^ θ / (1 - r) * Mr * Ls ^ θ := by
    ring
  calc ∑ j ∈ S, ℓ j ^ θ
      ≤ ∑ j ∈ S, (Ls ^ θ + ∑ k ∈ Finset.range K,
          (if 2 ^ k * Ls ≤ ℓ j then ((2:ℝ) ^ (k + 1) * Ls) ^ θ else 0)) := Finset.sum_le_sum hpt
    _ = (S.card : ℝ) * Ls ^ θ + ∑ k ∈ Finset.range K, ∑ j ∈ S,
          (if 2 ^ k * Ls ≤ ℓ j then ((2:ℝ) ^ (k + 1) * Ls) ^ θ else 0) := by
        rw [Finset.sum_add_distrib, Finset.sum_const, nsmul_eq_mul, Finset.sum_comm]
    _ ≤ 4 * Mr * Ls ^ θ + K0 * 2 ^ θ / (1 - r) * Mr * Ls ^ θ := by
        rw [← e]
        linarith
    _ = (4 + K0 * 2 ^ θ / (1 - r)) * Mr * Ls ^ θ := by ring

end A8HighFPriceMoments.Source

namespace A8HighFPriceMoments

open scoped BigOperators

private def nsq (α r c : ℝ) (v : ℤ × ℤ) : ℝ :=
  (α * ((v.1 : ℝ) - r * (v.2 : ℝ))) ^ 2 + ((v.2 : ℝ) / c) ^ 2

private def length (α r c : ℝ) (v : ℤ × ℤ) : ℝ := 2 / Real.sqrt (nsq α r c v)

private lemma int_abs_one (n : ℤ) (hn : n ≠ 0) :
    (1 : ℝ) ≤ |(n : ℝ)| := by
  have h : (1 : ℤ) ≤ |n| := by
    by_cases hneg : n < 0
    · rw [abs_of_neg hneg]
      omega
    · rw [abs_of_nonneg (by omega : 0 ≤ n)]
      omega
  exact_mod_cast h

private lemma sqrt_two_squares_left (p q : ℝ) :
    |p| ≤ Real.sqrt (p ^ 2 + q ^ 2) :=
  Real.abs_le_sqrt (by nlinarith [sq_nonneg q])

private lemma sqrt_two_squares_right (p q : ℝ) :
    |q| ≤ Real.sqrt (p ^ 2 + q ^ 2) :=
  Real.abs_le_sqrt (by nlinarith [sq_nonneg p])

private lemma length_pos_cap (κ a b : ℝ) (M : ℕ) (r : ℝ)
    (hκ : 1 ≤ κ) (ha : 0 < a) (hb : 0 < b) (hM : 1 ≤ M)
    (v : ℤ × ℤ) (hv : v ≠ 0) :
    0 < length ((M : ℝ) / (κ * a)) r (2 * b) v ∧
      length ((M : ℝ) / (κ * a)) r (2 * b) v ≤ 2 * κ * a + 4 * b := by
  have hκ0 : 0 < κ := by linarith
  have hM1 : (1 : ℝ) ≤ M := by exact_mod_cast hM
  have hM0 : (0 : ℝ) < M := by linarith
  let α : ℝ := (M : ℝ) / (κ * a)
  let p : ℝ := α * ((v.1 : ℝ) - r * (v.2 : ℝ))
  let q : ℝ := (v.2 : ℝ) / (2 * b)
  have hα : 0 < α := by dsimp [α]; positivity
  have hleft := sqrt_two_squares_left p q
  have hright := sqrt_two_squares_right p q
  by_cases hv2 : v.2 = 0
  · have hv1 : v.1 ≠ 0 := by
      intro hh
      apply hv
      exact Prod.ext hh hv2
    have hp : α ≤ |p| := by
      have hz := int_abs_one v.1 hv1
      dsimp [p]
      rw [hv2, Int.cast_zero, mul_zero, sub_zero, abs_mul, abs_of_pos hα]
      nlinarith only [hz, hα]
    have hn : 0 < Real.sqrt (p ^ 2 + q ^ 2) := hα.trans_le (hp.trans hleft)
    have hcap : 2 / Real.sqrt (p ^ 2 + q ^ 2) ≤ 2 / α :=
      div_le_div_of_nonneg_left (by norm_num) hα (hp.trans hleft)
    have hcancel : 2 / α = 2 * κ * a / (M : ℝ) := by
      dsimp [α]
      field_simp [hM0.ne', hκ0.ne', ha.ne']

    have hfinal : 2 * κ * a / (M : ℝ) ≤ 2 * κ * a := by
      apply (div_le_iff₀ hM0).mpr
      nlinarith only [mul_le_mul_of_nonneg_left hM1
        (show 0 ≤ 2 * κ * a by positivity)]
    change 0 < 2 / Real.sqrt (p ^ 2 + q ^ 2) ∧
      2 / Real.sqrt (p ^ 2 + q ^ 2) ≤ 2 * κ * a + 4 * b
    exact ⟨div_pos (by norm_num) hn, by rw [hcancel] at hcap; linarith⟩
  · have hz := int_abs_one v.2 hv2
    have hq : 1 / (2 * b) ≤ |q| := by
      dsimp [q]
      rw [abs_div, abs_of_pos (by positivity : 0 < 2 * b)]
      exact div_le_div_of_nonneg_right hz (by positivity)
    have hn : 0 < Real.sqrt (p ^ 2 + q ^ 2) :=
      (by positivity : 0 < 1 / (2 * b)).trans_le (hq.trans hright)
    have hcap : 2 / Real.sqrt (p ^ 2 + q ^ 2) ≤ 2 / (1 / (2 * b)) :=
      div_le_div_of_nonneg_left (by norm_num) (by positivity) (hq.trans hright)
    have hid : 2 / (1 / (2 * b)) = 4 * b := by field_simp ; ring
    change 0 < 2 / Real.sqrt (p ^ 2 + q ^ 2) ∧
      2 / Real.sqrt (p ^ 2 + q ^ 2) ≤ 2 * κ * a + 4 * b
    exact ⟨div_pos (by norm_num) hn, by rw [hid] at hcap; nlinarith [mul_pos hκ0 ha]⟩

private theorem grid_tail (κ a b : ℝ) (M : ℕ)
    (hκ : 1 ≤ κ) (ha : 0 < a) (hb : 0 < b) (hM : 1 ≤ M)
    (S : Finset ℕ) (f : ℕ → ℝ)
    (hsp : ∀ i j : ℕ, i ≤ j →
      ((j : ℝ) - i) * (a / (8 * b * (M : ℝ))) ≤ f j - f i)
    (hf : ∀ j ∈ S, a / (8 * b) ≤ f j ∧ f j ≤ 8 * a / b)
    (v : ℕ → ℤ × ℤ) (hv : ∀ j ∈ S, v j ≠ 0)
    (L : ℝ) (hcut : 64 * κ * (a + b) / (M : ℝ) ≤ L) :
    ((S.filter (fun j => L ≤ length ((M : ℝ) / (κ * a)) (f j) (2 * b) (v j))).card : ℝ) ≤
      (4096 * κ) * (a * b) / L ^ 2 := by
  classical
  have hκ0 : 0 < κ := by linarith
  have hM1 : (1 : ℝ) ≤ M := by exact_mod_cast hM
  have hM0 : (0 : ℝ) < M := by linarith
  have hcut0 : 0 < 64 * κ * (a + b) / (M : ℝ) := by positivity
  have hL : 0 < L := hcut0.trans_le hcut
  have hLM : 64 * κ * (a + b) ≤ (M : ℝ) * L := by
    have ht := (div_le_iff₀ hM0).mp hcut
    nlinarith only [ht]
  let err : ℝ := 2 * κ * a / ((M : ℝ) * L)
  let den : ℝ := 4 * b / L
  let g : ℝ := a / (8 * b * (M : ℝ))
  let fmax : ℝ := 8 * a / b
  let P : Finset ℕ :=
    S.filter (fun j => L ≤ length ((M : ℝ) / (κ * a)) (f j) (2 * b) (v j))
  have he0 : 0 ≤ err := by dsimp [err]; positivity
  have hd0 : 0 ≤ den := by dsimp [den]; positivity
  have hg : 0 < g := by dsimp [g]; positivity
  have hfm : 0 ≤ fmax := by dsimp [fmax]; positivity
  have herr1 : err < 1 := by
    apply (div_lt_one (by positivity : 0 < (M : ℝ) * L)).mpr
    have hp : 0 < κ * (62 * a + 64 * b) := by positivity
    nlinarith only [hLM, hp]
  have herrf : err < a / (8 * b) := by
    apply (div_lt_div_iff₀ (by positivity : 0 < (M : ℝ) * L)
      (by positivity : 0 < 8 * b)).mpr
    have ht := mul_le_mul_of_nonneg_left hLM ha.le
    have hp : 0 < κ * a * (64 * a + 48 * b) := by positivity
    nlinarith only [ht, hp]
  have hPsub : P ⊆ S := Finset.filter_subset _ _
  have hWitness : ∀ j ∈ P, ∃ z1 z2 : ℤ, (z1, z2) ≠ (0 : ℤ × ℤ) ∧
      |(z1 : ℝ) - f j * z2| ≤ err ∧ |(z2 : ℝ)| ≤ den := by
    intro j hj
    have hjS := hPsub hj
    have hjL := (Finset.mem_filter.mp hj).2
    have hp := Source.coords_of_inv_norm L
      ((M : ℝ) / (κ * a) * (((v j).1 : ℝ) - f j * ((v j).2 : ℝ)))
      (((v j).2 : ℝ) / (2 * b)) hL hjL
    have he := Source.scaled_abs ((M : ℝ) / (κ * a))
      (((v j).1 : ℝ) - f j * ((v j).2 : ℝ)) (2 / L) (by positivity) hp.1
    have hd := Source.div_abs_le ((v j).2 : ℝ) (2 * b) (2 / L) (by positivity) hp.2
    have heq : (2 / L) / ((M : ℝ) / (κ * a)) = err := by
      dsimp [err]
      field_simp [hL.ne', hM0.ne', hκ0.ne', ha.ne']

    have hdq : (2 / L) * (2 * b) = den := by dsimp [den]; ring
    rw [heq] at he
    rw [hdq] at hd
    exact ⟨(v j).1, (v j).2, hv j hjS, he, hd⟩
  have hCard := Source.tail_abstract f g (a / (8 * b)) fmax err den hg hsp
    S (fun j hj => (hf j hj).1) (fun j hj => (hf j hj).2)
    he0 herr1 herrf P hPsub hWitness
  let N : ℕ := ⌊den⌋₊
  have hN : (N : ℝ) ≤ den := Nat.floor_le hd0
  have hSum := Source.sum_bound fmax err g N hfm he0 hg
  have hminmax : a / (8 * b) ≤ fmax := by
    dsimp [fmax]
    apply (div_le_div_iff₀ (by positivity : 0 < 8 * b) hb).mpr
    nlinarith [mul_pos ha hb]
  have hemax : err ≤ fmax := herrf.le.trans hminmax
  have hesq : err ^ 2 ≤ err * fmax := by nlinarith [mul_le_mul_of_nonneg_left hemax he0]
  have ht : fmax * (N : ℝ) + err + 2 * err * fmax / g + 2 * err ^ 2 / g ≤
      fmax * den + err + 4 * err * fmax / g := by
    have hn := mul_le_mul_of_nonneg_left hN hfm
    have he := div_le_div_of_nonneg_right
      (mul_le_mul_of_nonneg_left hesq (by norm_num : (0 : ℝ) ≤ 2)) hg.le
    have he' : 2 * err ^ 2 / g ≤ 2 * err * fmax / g := by
      simpa only [mul_assoc] using he
    calc
      fmax * (N : ℝ) + err + 2 * err * fmax / g + 2 * err ^ 2 / g ≤
          fmax * den + err + 2 * err * fmax / g + 2 * err * fmax / g :=
        by
          simpa only [add_comm, add_left_comm, add_assoc] using
            (add_le_add
              (add_le_add_right (add_le_add_right hn err) (2 * err * fmax / g)) he')
      _ = fmax * den + err + 4 * err * fmax / g := by
        field_simp [hg.ne']
        ; ring
  have hval0 : 0 ≤ fmax * den + err + 4 * err * fmax / g := by positivity
  have hid : den * (fmax * den + err + 4 * err * fmax / g) =
      (128 + 2048 * κ) * (a * b) / L ^ 2 +
        8 * κ * (a * b) / ((M : ℝ) * L ^ 2) := by
    dsimp [den, fmax, err, g]
    field_simp [ha.ne', hb.ne', hM0.ne', hL.ne']
    ; ring
  have hMterm : 8 * κ * (a * b) / ((M : ℝ) * L ^ 2) ≤
      8 * κ * (a * b) / L ^ 2 := by
    apply div_le_div_of_nonneg_left (by positivity) (by positivity : 0 < L ^ 2)
    nlinarith only [mul_le_mul_of_nonneg_right hM1 (sq_nonneg L)]
  change (P.card : ℝ) ≤ _
  calc
    (P.card : ℝ) ≤
        (N : ℝ) * (fmax * (N : ℝ) + err + 2 * err * fmax / g + 2 * err ^ 2 / g) :=
      hCard.trans hSum
    _ ≤ (N : ℝ) * (fmax * den + err + 4 * err * fmax / g) :=
      mul_le_mul_of_nonneg_left ht (Nat.cast_nonneg N)
    _ ≤ den * (fmax * den + err + 4 * err * fmax / g) :=
      mul_le_mul_of_nonneg_right hN hval0
    _ = (128 + 2048 * κ) * (a * b) / L ^ 2 +
        8 * κ * (a * b) / ((M : ℝ) * L ^ 2) := hid
    _ ≤ (128 + 2056 * κ) * (a * b) / L ^ 2 := by
      calc
        (128 + 2048 * κ) * (a * b) / L ^ 2 +
            8 * κ * (a * b) / ((M : ℝ) * L ^ 2) ≤
            (128 + 2048 * κ) * (a * b) / L ^ 2 + 8 * κ * (a * b) / L ^ 2 :=
          by
            simpa only [add_comm, add_left_comm, add_assoc] using
              (add_le_add_left hMterm ((128 + 2048 * κ) * (a * b) / L ^ 2))
        _ = (128 + 2056 * κ) * (a * b) / L ^ 2 := by
          field_simp [hL.ne']
          ; ring
    _ ≤ (4096 * κ) * (a * b) / L ^ 2 := by
      apply div_le_div_of_nonneg_right _ (sq_nonneg L)
      exact mul_le_mul_of_nonneg_right (by linarith : 128 + 2056 * κ ≤ 4096 * κ)
        (mul_nonneg ha.le hb.le)

private theorem raw_grid_moment (κ η : ℝ) (hκ : 1 ≤ κ) (hη : 0 < η) :
    ∃ C : ℝ, 0 < C ∧
      ∀ x a b : ℝ, 8 ≤ x → 0 < a → 0 < b → a ≤ 2 * x → b ≤ 2 * x →
      ∀ M : ℕ, 1 ≤ M → (M : ℝ) ≤ a * b →
      ∀ (S : Finset ℕ) (f : ℕ → ℝ),
      (S.card : ℝ) ≤ 3 * (M : ℝ) + 1 →
      (∀ i j : ℕ, i ≤ j →
        ((j : ℝ) - i) * (a / (8 * b * (M : ℝ))) ≤ f j - f i) →
      (∀ j ∈ S, a / (8 * b) ≤ f j ∧ f j ≤ 8 * a / b) →
      ∀ v : ℕ → ℤ × ℤ, (∀ j ∈ S, v j ≠ 0) →
      (∑ j ∈ S, (length ((M : ℝ) / (κ * a)) (f j) (2 * b) (v j)) ^ 2) ≤
        C * x ^ η * (a * b + (a ^ 2 + b ^ 2) / (M : ℝ)) := by
  classical
  let ζ : ℝ := min (1 / 2 : ℝ) η
  let θ : ℝ := 2 - ζ
  let r : ℝ := (2 : ℝ) ^ θ / 4
  let G : ℝ := 4 + (4096 * κ) * (2 : ℝ) ^ θ / (1 - r)
  let H : ℝ := 1 + 8192 * κ ^ 2
  let C : ℝ := G * (16 * κ) ^ ζ * H
  have hκ0 : 0 < κ := by linarith
  have hζ : 0 < ζ := by
    dsimp [ζ]
    exact lt_min (by norm_num) hη
  have hζhalf : ζ ≤ (1 / 2 : ℝ) := min_le_left _ _
  have hζη : ζ ≤ η := min_le_right _ _
  have hθ : 0 < θ := by dsimp [θ]; linarith
  have hθlt : θ < 2 := by dsimp [θ]; linarith
  have hθle : θ ≤ 2 := hθlt.le
  have hr : r < 1 := by
    have ht := Real.rpow_lt_rpow_of_exponent_lt (by norm_num : (1 : ℝ) < 2) hθlt
    norm_num [Real.rpow_natCast] at ht
    exact (div_lt_one (by norm_num : (0 : ℝ) < 4)).mpr ht
  have h1r : 0 < 1 - r := by linarith only [hr]
  have hG : 0 < G := by dsimp [G]; positivity
  have hH : 0 < H := by dsimp [H]; positivity
  have hC : 0 < C := by dsimp [C]; positivity
  refine ⟨C, hC, ?_⟩
  intro x a b hx ha hb haX hbX M hM hab S f hcard hsp hf v hv
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hM1 : (1 : ℝ) ≤ M := by exact_mod_cast hM
  have hM0 : (0 : ℝ) < M := by linarith
  let ℓ : ℕ → ℝ := fun j => length ((M : ℝ) / (κ * a)) (f j) (2 * b) (v j)
  let Q : ℝ := a * b
  let L0 : ℝ := Real.sqrt (Q / (M : ℝ))
  let L1 : ℝ := 64 * κ * (a + b) / (M : ℝ)
  let Ls : ℝ := max L0 L1
  let R : ℝ := a * b + (a ^ 2 + b ^ 2) / (M : ℝ)
  have hQ : 0 < Q := mul_pos ha hb
  have hQdiv : 0 ≤ Q / (M : ℝ) := by positivity
  have hL0 : 0 ≤ L0 := Real.sqrt_nonneg _
  have hL0sq : L0 ^ 2 = Q / (M : ℝ) := Real.sq_sqrt hQdiv
  have hL1 : 0 < L1 := by dsimp [L1]; positivity
  have hL0one : 1 ≤ L0 := by
    have hratio : (1 : ℝ) ≤ Q / (M : ℝ) := by
      apply (le_div_iff₀ hM0).mpr
      simpa only [one_mul, Q] using hab
    nlinarith only [hL0, hL0sq, hratio]
  have hLs1 : 1 ≤ Ls := hL0one.trans (le_max_left _ _)
  have hLs : 0 < Ls := lt_of_lt_of_le (by norm_num) hLs1
  have hcut : L1 ≤ Ls := le_max_right _ _
  have hQL : Q ≤ (M : ℝ) * Ls ^ 2 := by
    have hls0 : L0 ≤ Ls := le_max_left _ _
    have hs : L0 ^ 2 ≤ Ls ^ 2 := by
      nlinarith only [hL0, hLs.le, hls0]
    have hm := mul_le_mul_of_nonneg_left hs hM0.le
    rw [hL0sq] at hm
    have heq : (M : ℝ) * (Q / (M : ℝ)) = Q := by
      field_simp [hM0.ne']
    rwa [heq] at hm
  have hℓ : ∀ j ∈ S, 0 < ℓ j ∧ ℓ j ≤ 16 * κ * x := by
    intro j hj
    obtain ⟨hp, hc⟩ := length_pos_cap κ a b M (f j) hκ ha hb hM (v j) (hv j hj)
    have hax := mul_le_mul_of_nonneg_left haX
      (show 0 ≤ 2 * κ by positivity)
    have hbx := mul_le_mul_of_nonneg_left hbX (by norm_num : (0 : ℝ) ≤ 4)
    have hκx := mul_le_mul_of_nonneg_right hκ hx0.le
    have hκx0 : 0 ≤ κ * x := mul_nonneg hκ0.le hx0.le
    refine ⟨hp, ?_⟩
    change length _ _ _ _ ≤ _
    nlinarith only [hc, hax, hbx, hκx, hκx0]
  have htail : ∀ L : ℝ, Ls ≤ L →
      ((S.filter (fun j => L ≤ ℓ j)).card : ℝ) ≤
        (4096 * κ) * Q / L ^ 2 := by
    intro L hL
    exact grid_tail κ a b M hκ ha hb hM S f hsp hf v hv L (hcut.trans hL)
  have hmom := Source.moment_from_tails θ hθ r rfl hr S ℓ
    (fun j hj => (hℓ j hj).1.le) Ls (M : ℝ) (4096 * κ) Q hLs hM1 hQ.le hQL
    (by positivity) hcard htail
  change ∑ j ∈ S, ℓ j ^ θ ≤ G * (M : ℝ) * Ls ^ θ at hmom
  have hLsθ : Ls ^ θ ≤ Ls ^ (2 : ℝ) :=
    Real.rpow_le_rpow_of_exponent_le hLs1 hθle
  have hLsθ' : Ls ^ θ ≤ Ls ^ 2 :=
    hLsθ.trans_eq (Real.rpow_natCast Ls 2)
  have hLsSq : Ls ^ 2 ≤ L0 ^ 2 + L1 ^ 2 := by
    rcases le_total L0 L1 with hh | hh
    · rw [show Ls = L1 from max_eq_right hh]
      nlinarith only [sq_nonneg L0]
    · rw [show Ls = L0 from max_eq_left hh]
      nlinarith only [sq_nonneg L1]
  have harea : (M : ℝ) * Ls ^ 2 ≤ H * R := by
    have hs := mul_le_mul_of_nonneg_left hLsSq hM0.le
    have hid : (M : ℝ) * (L0 ^ 2 + L1 ^ 2) =
        a * b + 4096 * κ ^ 2 * (a + b) ^ 2 / (M : ℝ) := by
      rw [hL0sq]
      dsimp [L1, Q]
      field_simp [hM0.ne']
      ; ring
    rw [hid] at hs
    have habsq : (a + b) ^ 2 ≤ 2 * (a ^ 2 + b ^ 2) := by
      nlinarith only [sq_nonneg (a - b)]
    have hh := div_le_div_of_nonneg_right
      (mul_le_mul_of_nonneg_left habsq (show 0 ≤ 4096 * κ ^ 2 by positivity)) hM0.le
    have hRa : 0 ≤ a * b := mul_nonneg ha.le hb.le
    have hRb : 0 ≤ (a ^ 2 + b ^ 2) / (M : ℝ) := by positivity
    have hκsq : 0 ≤ 8192 * κ ^ 2 := by positivity
    have hh' : 4096 * κ ^ 2 * (a + b) ^ 2 / (M : ℝ) ≤
        8192 * κ ^ 2 * ((a ^ 2 + b ^ 2) / (M : ℝ)) := by
      calc
        4096 * κ ^ 2 * (a + b) ^ 2 / (M : ℝ) ≤
            4096 * κ ^ 2 * (2 * (a ^ 2 + b ^ 2)) / (M : ℝ) := hh
        _ = 8192 * κ ^ 2 * ((a ^ 2 + b ^ 2) / (M : ℝ)) := by
          field_simp [hM0.ne']
          ; ring
    dsimp [H, R]
    calc
      (M : ℝ) * Ls ^ 2 ≤ a * b + 4096 * κ ^ 2 * (a + b) ^ 2 / (M : ℝ) := hs
      _ ≤ a * b + 8192 * κ ^ 2 * ((a ^ 2 + b ^ 2) / (M : ℝ)) :=
        by
          simpa only [add_comm, add_left_comm, add_assoc] using
            (add_le_add_left hh' (a * b))
      _ ≤ (1 + 8192 * κ ^ 2) * (a * b + (a ^ 2 + b ^ 2) / (M : ℝ)) := by
        nlinarith only [mul_nonneg hκsq hRa, hRb]
  have hR : 0 ≤ R := by dsimp [R]; positivity
  have hsq : ∑ j ∈ S, ℓ j ^ 2 ≤
      (16 * κ * x) ^ ζ * ∑ j ∈ S, ℓ j ^ θ := by
    calc
      ∑ j ∈ S, ℓ j ^ 2 ≤ ∑ j ∈ S, (16 * κ * x) ^ ζ * ℓ j ^ θ := by
        apply Finset.sum_le_sum
        intro j hj
        have hjpos := (hℓ j hj).1
        have hexp : θ + ζ = 2 := by dsimp [θ]; ring
        have heq : ℓ j ^ 2 = ℓ j ^ θ * ℓ j ^ ζ := by
          rw [← Real.rpow_add hjpos, hexp]
          norm_num [Real.rpow_natCast]
        rw [heq, mul_comm ((16 * κ * x) ^ ζ)]
        exact mul_le_mul_of_nonneg_left
          (Real.rpow_le_rpow hjpos.le (hℓ j hj).2 hζ.le)
          (Real.rpow_nonneg hjpos.le θ)
      _ = (16 * κ * x) ^ ζ * ∑ j ∈ S, ℓ j ^ θ := by
        rw [Finset.mul_sum]
  have hpow : (16 * κ * x) ^ ζ = (16 * κ) ^ ζ * x ^ ζ := by
    exact Real.mul_rpow (by positivity) hx0.le
  have hxpow : x ^ ζ ≤ x ^ η :=
    Real.rpow_le_rpow_of_exponent_le hx1 hζη
  calc
    (∑ j ∈ S, (length ((M : ℝ) / (κ * a)) (f j) (2 * b) (v j)) ^ 2)
        ≤ (16 * κ * x) ^ ζ * (G * (M : ℝ) * Ls ^ θ) :=
      hsq.trans (mul_le_mul_of_nonneg_left hmom (by positivity))
    _ ≤ (16 * κ * x) ^ ζ * (G * (M : ℝ) * Ls ^ 2) := by
      exact mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left hLsθ' (by positivity)) (by positivity)
    _ = (16 * κ * x) ^ ζ * G * ((M : ℝ) * Ls ^ 2) := by ring
    _ ≤ (16 * κ * x) ^ ζ * G * (H * R) :=
      mul_le_mul_of_nonneg_left harea (by positivity)
    _ = C * x ^ ζ * R := by rw [hpow]; dsimp [C]; ring
    _ ≤ C * x ^ η * R :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hxpow hC.le) hR

end A8HighFPriceMoments

namespace A8HighFPriceMoments
private theorem grid_tail_W (κ W a b : ℝ) (M : ℕ)
    (hκ : 1 ≤ κ) (hW : 1 ≤ W) (ha : 0 < a) (hb : 0 < b) (hM : 1 ≤ M)
    (S : Finset ℕ) (f : ℕ → ℝ)
    (hsp : ∀ i j : ℕ, i ≤ j →
      ((j : ℝ) - i) * (a / (W * b * (M : ℝ))) ≤ f j - f i)
    (hf : ∀ j ∈ S, a / (W * b) ≤ f j ∧ f j ≤ W * a / b)
    (v : ℕ → ℤ × ℤ) (hv : ∀ j ∈ S, v j ≠ 0)
    (L : ℝ) (hcut : 8 * κ * W ^ 2 * (a + b) / (M : ℝ) ≤ L) :
    ((S.filter (fun j => L ≤ length ((M : ℝ) / (κ * a)) (f j) (2 * b) (v j))).card : ℝ) ≤
      (64 * κ * W ^ 2) * (a * b) / L ^ 2 := by
  classical
  have hκ0 : 0 < κ := by linarith
  have hW0 : 0 < W := by linarith
  have hM1 : (1 : ℝ) ≤ M := by exact_mod_cast hM
  have hM0 : (0 : ℝ) < M := by linarith
  have hcut0 : 0 < 8 * κ * W ^ 2 * (a + b) / (M : ℝ) := by positivity
  have hL : 0 < L := hcut0.trans_le hcut
  have hLM : 8 * κ * W ^ 2 * (a + b) ≤ (M : ℝ) * L := by
    have ht := (div_le_iff₀ hM0).mp hcut
    nlinarith only [ht]
  let err : ℝ := 2 * κ * a / ((M : ℝ) * L)
  let den : ℝ := 4 * b / L
  let g : ℝ := a / (W * b * (M : ℝ))
  let fmax : ℝ := W * a / b
  let P : Finset ℕ :=
    S.filter (fun j => L ≤ length ((M : ℝ) / (κ * a)) (f j) (2 * b) (v j))
  have he0 : 0 ≤ err := by dsimp [err]; positivity
  have hd0 : 0 ≤ den := by dsimp [den]; positivity
  have hg : 0 < g := by dsimp [g]; positivity
  have hfm : 0 ≤ fmax := by dsimp [fmax]; positivity
  have hW2 : 1 ≤ W ^ 2 := by nlinarith only [hW, sq_nonneg (W-1)]
  have hWstep : W ≤ W ^ 2 := by nlinarith only [hW, sq_nonneg (W-1)]
  have hWa : 2 * κ * a ≤ 2 * κ * W ^ 2 * a := by
    nlinarith only [mul_le_mul_of_nonneg_left hW2 (show 0 ≤ 2*κ*a by positivity)]
  have hWb : 2 * κ * W * b ≤ 2 * κ * W ^ 2 * b := by
    nlinarith only [mul_le_mul_of_nonneg_left hWstep (show 0 ≤ 2*κ*b by positivity)]
  have hmoreA : 0 < 6*κ*W^2*a+8*κ*W^2*b := by positivity
  have hmoreB : 0 < 8*κ*W^2*a+6*κ*W^2*b := by positivity
  have hLMa : 2*κ*a < (M:ℝ)*L := by nlinarith only [hLM,hWa,hmoreA]
  have hLMb : 2*κ*W*b < (M:ℝ)*L := by nlinarith only [hLM,hWb,hmoreB]
  have herr1 : err < 1 := by
    dsimp [err]
    exact (div_lt_one (by positivity : 0 < (M:ℝ)*L)).mpr hLMa
  have herrf : err < a / (W * b) := by
    dsimp [err]
    apply (div_lt_div_iff₀ (by positivity : 0 < (M:ℝ)*L)
      (by positivity : 0 < W*b)).mpr
    nlinarith only [mul_lt_mul_of_pos_left hLMb ha]
  have hPsub : P ⊆ S := Finset.filter_subset _ _
  have hWitness : ∀ j ∈ P, ∃ z1 z2 : ℤ, (z1, z2) ≠ (0 : ℤ × ℤ) ∧
      |(z1 : ℝ) - f j * z2| ≤ err ∧ |(z2 : ℝ)| ≤ den := by
    intro j hj
    have hjS := hPsub hj
    have hjL := (Finset.mem_filter.mp hj).2
    have hp := Source.coords_of_inv_norm L
      ((M : ℝ) / (κ * a) * (((v j).1 : ℝ) - f j * ((v j).2 : ℝ)))
      (((v j).2 : ℝ) / (2 * b)) hL hjL
    have he := Source.scaled_abs ((M : ℝ) / (κ * a))
      (((v j).1 : ℝ) - f j * ((v j).2 : ℝ)) (2 / L) (by positivity) hp.1
    have hd := Source.div_abs_le ((v j).2 : ℝ) (2 * b) (2 / L) (by positivity) hp.2
    have heq : (2 / L) / ((M : ℝ) / (κ * a)) = err := by
      dsimp [err]
      field_simp [hL.ne', hM0.ne', hκ0.ne', ha.ne']

    have hdq : (2 / L) * (2 * b) = den := by dsimp [den]; ring
    rw [heq] at he
    rw [hdq] at hd
    exact ⟨(v j).1, (v j).2, hv j hjS, he, hd⟩
  have hCard := Source.tail_abstract f g (a / (W * b)) fmax err den hg hsp
    S (fun j hj => (hf j hj).1) (fun j hj => (hf j hj).2)
    he0 herr1 herrf P hPsub hWitness
  let N : ℕ := ⌊den⌋₊
  have hN : (N : ℝ) ≤ den := Nat.floor_le hd0
  have hSum := Source.sum_bound fmax err g N hfm he0 hg
  have hminmax : a / (W * b) ≤ fmax := by
    dsimp [fmax]
    apply (div_le_div_iff₀ (by positivity : 0 < W*b) hb).mpr
    nlinarith only [mul_le_mul_of_nonneg_left hW2 (show 0 ≤ a*b by positivity)]
  have hemax : err ≤ fmax := herrf.le.trans hminmax
  have hesq : err ^ 2 ≤ err * fmax := by nlinarith [mul_le_mul_of_nonneg_left hemax he0]
  have ht : fmax * (N : ℝ) + err + 2 * err * fmax / g + 2 * err ^ 2 / g ≤
      fmax * den + err + 4 * err * fmax / g := by
    have hn := mul_le_mul_of_nonneg_left hN hfm
    have he := div_le_div_of_nonneg_right
      (mul_le_mul_of_nonneg_left hesq (by norm_num : (0 : ℝ) ≤ 2)) hg.le
    have he' : 2 * err ^ 2 / g ≤ 2 * err * fmax / g := by
      simpa only [mul_assoc] using he
    calc
      fmax * (N : ℝ) + err + 2 * err * fmax / g + 2 * err ^ 2 / g ≤
          fmax * den + err + 2 * err * fmax / g + 2 * err * fmax / g :=
        by
          simpa only [add_comm, add_left_comm, add_assoc] using
            (add_le_add
              (add_le_add_right (add_le_add_right hn err) (2 * err * fmax / g)) he')
      _ = fmax * den + err + 4 * err * fmax / g := by
        field_simp [hg.ne']
        ; ring
  have hval0 : 0 ≤ fmax * den + err + 4 * err * fmax / g := by positivity
  have hid : den * (fmax * den + err + 4 * err * fmax / g) =
      (16*W + 32*κ*W^2) * (a*b) / L^2 +
        8*κ*(a*b)/((M:ℝ)*L^2) := by
    dsimp [den, fmax, err, g]
    field_simp [ha.ne', hb.ne', hM0.ne', hL.ne', hW0.ne']
    ; ring
  have hMterm : 8*κ*(a*b)/((M:ℝ)*L^2) ≤ 8*κ*(a*b)/L^2 := by
    apply div_le_div_of_nonneg_left (by positivity) (by positivity : 0 < L^2)
    nlinarith only [mul_le_mul_of_nonneg_right hM1 (sq_nonneg L)]
  have hκW : W ≤ κ*W^2 := by
    have ht := mul_le_mul_of_nonneg_right hκ (show 0 ≤ W^2 by positivity)
    nlinarith only [hWstep,ht]
  have hκW2 : 8*κ ≤ 8*κ*W^2 := by
    nlinarith only [mul_le_mul_of_nonneg_left hW2 (show 0≤8*κ by positivity)]
  have hcoef : 16*W+32*κ*W^2+8*κ ≤ 64*κ*W^2 := by
    nlinarith only [hκW,hκW2,hW]
  change (P.card : ℝ) ≤ _
  calc
    (P.card : ℝ) ≤
        (N : ℝ) * (fmax * (N : ℝ) + err + 2 * err * fmax / g + 2 * err ^ 2 / g) :=
      hCard.trans hSum
    _ ≤ (N : ℝ) * (fmax * den + err + 4 * err * fmax / g) :=
      mul_le_mul_of_nonneg_left ht (Nat.cast_nonneg N)
    _ ≤ den * (fmax * den + err + 4 * err * fmax / g) :=
      mul_le_mul_of_nonneg_right hN hval0
    _ = (16*W + 32*κ*W^2)*(a*b)/L^2 +
        8*κ*(a*b)/((M:ℝ)*L^2) := hid
    _ ≤ (16*W + 32*κ*W^2+8*κ)*(a*b)/L^2 := by
      calc
        (16*W + 32*κ*W^2)*(a*b)/L^2 +
            8*κ*(a*b)/((M:ℝ)*L^2) ≤
            (16*W + 32*κ*W^2)*(a*b)/L^2 + 8*κ*(a*b)/L^2 :=
          add_le_add_right hMterm _
        _ = (16*W + 32*κ*W^2+8*κ)*(a*b)/L^2 := by
          field_simp [hL.ne']

    _ ≤ (64*κ*W^2)*(a*b)/L^2 := by
      exact div_le_div_of_nonneg_right
        (mul_le_mul_of_nonneg_right hcoef (mul_nonneg ha.le hb.le)) (sq_nonneg L)

private theorem raw_grid_moment_W (κ W η : ℝ) (hκ : 1 ≤ κ) (hW : 1 ≤ W) (hη : 0 < η) :
    ∃ C : ℝ, 0 < C ∧
      ∀ x a b : ℝ, 8 ≤ x → 0 < a → 0 < b → a ≤ 2 * x → b ≤ 2 * x →
      ∀ M : ℕ, 1 ≤ M → (M : ℝ) ≤ a * b →
      ∀ (S : Finset ℕ) (f : ℕ → ℝ),
      (S.card : ℝ) ≤ 3 * (M : ℝ) + 1 →
      (∀ i j : ℕ, i ≤ j →
        ((j : ℝ) - i) * (a / (W * b * (M : ℝ))) ≤ f j - f i) →
      (∀ j ∈ S, a / (W * b) ≤ f j ∧ f j ≤ W * a / b) →
      ∀ v : ℕ → ℤ × ℤ, (∀ j ∈ S, v j ≠ 0) →
      (∑ j ∈ S, (length ((M : ℝ) / (κ * a)) (f j) (2 * b) (v j)) ^ 2) ≤
        C * x ^ η * (a * b + (a ^ 2 + b ^ 2) / (M : ℝ)) := by
  classical
  let ζ : ℝ := min (1 / 2 : ℝ) η
  let θ : ℝ := 2 - ζ
  let r : ℝ := (2 : ℝ) ^ θ / 4
  let G : ℝ := 4 + (64 * κ * W ^ 2) * (2 : ℝ) ^ θ / (1 - r)
  let H : ℝ := 1 + 128 * κ ^ 2 * W ^ 4
  let C : ℝ := G * (16 * κ) ^ ζ * H
  have hκ0 : 0 < κ := by linarith
  have hW0 : 0 < W := by linarith
  have hζ : 0 < ζ := by
    dsimp [ζ]
    exact lt_min (by norm_num) hη
  have hζhalf : ζ ≤ (1 / 2 : ℝ) := min_le_left _ _
  have hζη : ζ ≤ η := min_le_right _ _
  have hθ : 0 < θ := by dsimp [θ]; linarith
  have hθlt : θ < 2 := by dsimp [θ]; linarith
  have hθle : θ ≤ 2 := hθlt.le
  have hr : r < 1 := by
    have ht := Real.rpow_lt_rpow_of_exponent_lt (by norm_num : (1 : ℝ) < 2) hθlt
    norm_num [Real.rpow_natCast] at ht
    exact (div_lt_one (by norm_num : (0 : ℝ) < 4)).mpr ht
  have h1r : 0 < 1 - r := by linarith only [hr]
  have hG : 0 < G := by dsimp [G]; positivity
  have hH : 0 < H := by dsimp [H]; positivity
  have hC : 0 < C := by dsimp [C]; positivity
  refine ⟨C, hC, ?_⟩
  intro x a b hx ha hb haX hbX M hM hab S f hcard hsp hf v hv
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hM1 : (1 : ℝ) ≤ M := by exact_mod_cast hM
  have hM0 : (0 : ℝ) < M := by linarith
  let ℓ : ℕ → ℝ := fun j => length ((M : ℝ) / (κ * a)) (f j) (2 * b) (v j)
  let Q : ℝ := a * b
  let L0 : ℝ := Real.sqrt (Q / (M : ℝ))
  let L1 : ℝ := 8 * κ * W ^ 2 * (a + b) / (M : ℝ)
  let Ls : ℝ := max L0 L1
  let R : ℝ := a * b + (a ^ 2 + b ^ 2) / (M : ℝ)
  have hQ : 0 < Q := mul_pos ha hb
  have hQdiv : 0 ≤ Q / (M : ℝ) := by positivity
  have hL0 : 0 ≤ L0 := Real.sqrt_nonneg _
  have hL0sq : L0 ^ 2 = Q / (M : ℝ) := Real.sq_sqrt hQdiv
  have hL1 : 0 < L1 := by dsimp [L1]; positivity
  have hL0one : 1 ≤ L0 := by
    have hratio : (1 : ℝ) ≤ Q / (M : ℝ) := by
      apply (le_div_iff₀ hM0).mpr
      simpa only [one_mul, Q] using hab
    nlinarith only [hL0, hL0sq, hratio]
  have hLs1 : 1 ≤ Ls := hL0one.trans (le_max_left _ _)
  have hLs : 0 < Ls := lt_of_lt_of_le (by norm_num) hLs1
  have hcut : L1 ≤ Ls := le_max_right _ _
  have hQL : Q ≤ (M : ℝ) * Ls ^ 2 := by
    have hls0 : L0 ≤ Ls := le_max_left _ _
    have hs : L0 ^ 2 ≤ Ls ^ 2 := by
      nlinarith only [hL0, hLs.le, hls0]
    have hm := mul_le_mul_of_nonneg_left hs hM0.le
    rw [hL0sq] at hm
    have heq : (M : ℝ) * (Q / (M : ℝ)) = Q := by
      field_simp [hM0.ne']
    rwa [heq] at hm
  have hℓ : ∀ j ∈ S, 0 < ℓ j ∧ ℓ j ≤ 16 * κ * x := by
    intro j hj
    obtain ⟨hp, hc⟩ := length_pos_cap κ a b M (f j) hκ ha hb hM (v j) (hv j hj)
    have hax := mul_le_mul_of_nonneg_left haX
      (show 0 ≤ 2 * κ by positivity)
    have hbx := mul_le_mul_of_nonneg_left hbX (by norm_num : (0 : ℝ) ≤ 4)
    have hκx := mul_le_mul_of_nonneg_right hκ hx0.le
    have hκx0 : 0 ≤ κ * x := mul_nonneg hκ0.le hx0.le
    refine ⟨hp, ?_⟩
    change length _ _ _ _ ≤ _
    nlinarith only [hc, hax, hbx, hκx, hκx0]
  have htail : ∀ L : ℝ, Ls ≤ L →
      ((S.filter (fun j => L ≤ ℓ j)).card : ℝ) ≤
        (64 * κ * W ^ 2) * Q / L ^ 2 := by
    intro L hL
    exact grid_tail_W κ W a b M hκ hW ha hb hM S f hsp hf v hv L (hcut.trans hL)
  have hmom := Source.moment_from_tails θ hθ r rfl hr S ℓ
    (fun j hj => (hℓ j hj).1.le) Ls (M : ℝ) (64 * κ * W ^ 2) Q hLs hM1 hQ.le hQL
    (by positivity) hcard htail
  change ∑ j ∈ S, ℓ j ^ θ ≤ G * (M : ℝ) * Ls ^ θ at hmom
  have hLsθ : Ls ^ θ ≤ Ls ^ (2 : ℝ) :=
    Real.rpow_le_rpow_of_exponent_le hLs1 hθle
  have hLsθ' : Ls ^ θ ≤ Ls ^ 2 :=
    hLsθ.trans_eq (Real.rpow_natCast Ls 2)
  have hLsSq : Ls ^ 2 ≤ L0 ^ 2 + L1 ^ 2 := by
    rcases le_total L0 L1 with hh | hh
    · rw [show Ls = L1 from max_eq_right hh]
      nlinarith only [sq_nonneg L0]
    · rw [show Ls = L0 from max_eq_left hh]
      nlinarith only [sq_nonneg L1]
  have harea : (M : ℝ) * Ls ^ 2 ≤ H * R := by
    have hs := mul_le_mul_of_nonneg_left hLsSq hM0.le
    have hid : (M : ℝ) * (L0 ^ 2 + L1 ^ 2) =
        a * b + 64 * κ ^ 2 * W ^ 4 * (a + b) ^ 2 / (M : ℝ) := by
      rw [hL0sq]
      dsimp [L1, Q]
      field_simp [hM0.ne']
      ; ring
    rw [hid] at hs
    have habsq : (a + b) ^ 2 ≤ 2 * (a ^ 2 + b ^ 2) := by
      nlinarith only [sq_nonneg (a - b)]
    have hh := div_le_div_of_nonneg_right
      (mul_le_mul_of_nonneg_left habsq (show 0 ≤ 64 * κ ^ 2 * W ^ 4 by positivity)) hM0.le
    have hRa : 0 ≤ a * b := mul_nonneg ha.le hb.le
    have hRb : 0 ≤ (a ^ 2 + b ^ 2) / (M : ℝ) := by positivity
    have hκsq : 0 ≤ 128 * κ ^ 2 * W ^ 4 := by positivity
    have hh' : 64 * κ ^ 2 * W ^ 4 * (a + b) ^ 2 / (M : ℝ) ≤
        128 * κ ^ 2 * W ^ 4 * ((a ^ 2 + b ^ 2) / (M : ℝ)) := by
      calc
        64 * κ ^ 2 * W ^ 4 * (a + b) ^ 2 / (M : ℝ) ≤
            64 * κ ^ 2 * W ^ 4 * (2 * (a ^ 2 + b ^ 2)) / (M : ℝ) := hh
        _ = 128 * κ ^ 2 * W ^ 4 * ((a ^ 2 + b ^ 2) / (M : ℝ)) := by
          field_simp [hM0.ne']
          ; ring
    dsimp [H, R]
    calc
      (M : ℝ) * Ls ^ 2 ≤ a * b + 64 * κ ^ 2 * W ^ 4 * (a + b) ^ 2 / (M : ℝ) := hs
      _ ≤ a * b + 128 * κ ^ 2 * W ^ 4 * ((a ^ 2 + b ^ 2) / (M : ℝ)) :=
        by
          simpa only [add_comm, add_left_comm, add_assoc] using
            (add_le_add_left hh' (a * b))
      _ ≤ (1 + 128 * κ ^ 2 * W ^ 4) * (a * b + (a ^ 2 + b ^ 2) / (M : ℝ)) := by
        nlinarith only [mul_nonneg hκsq hRa, hRb]
  have hR : 0 ≤ R := by dsimp [R]; positivity
  have hsq : ∑ j ∈ S, ℓ j ^ 2 ≤
      (16 * κ * x) ^ ζ * ∑ j ∈ S, ℓ j ^ θ := by
    calc
      ∑ j ∈ S, ℓ j ^ 2 ≤ ∑ j ∈ S, (16 * κ * x) ^ ζ * ℓ j ^ θ := by
        apply Finset.sum_le_sum
        intro j hj
        have hjpos := (hℓ j hj).1
        have hexp : θ + ζ = 2 := by dsimp [θ]; ring
        have heq : ℓ j ^ 2 = ℓ j ^ θ * ℓ j ^ ζ := by
          rw [← Real.rpow_add hjpos, hexp]
          norm_num [Real.rpow_natCast]
        rw [heq, mul_comm ((16 * κ * x) ^ ζ)]
        exact mul_le_mul_of_nonneg_left
          (Real.rpow_le_rpow hjpos.le (hℓ j hj).2 hζ.le)
          (Real.rpow_nonneg hjpos.le θ)
      _ = (16 * κ * x) ^ ζ * ∑ j ∈ S, ℓ j ^ θ := by
        rw [Finset.mul_sum]
  have hpow : (16 * κ * x) ^ ζ = (16 * κ) ^ ζ * x ^ ζ := by
    exact Real.mul_rpow (by positivity) hx0.le
  have hxpow : x ^ ζ ≤ x ^ η :=
    Real.rpow_le_rpow_of_exponent_le hx1 hζη
  calc
    (∑ j ∈ S, (length ((M : ℝ) / (κ * a)) (f j) (2 * b) (v j)) ^ 2)
        ≤ (16 * κ * x) ^ ζ * (G * (M : ℝ) * Ls ^ θ) :=
      hsq.trans (mul_le_mul_of_nonneg_left hmom (by positivity))
    _ ≤ (16 * κ * x) ^ ζ * (G * (M : ℝ) * Ls ^ 2) := by
      exact mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left hLsθ' (by positivity)) (by positivity)
    _ = (16 * κ * x) ^ ζ * G * ((M : ℝ) * Ls ^ 2) := by ring
    _ ≤ (16 * κ * x) ^ ζ * G * (H * R) :=
      mul_le_mul_of_nonneg_left harea (by positivity)
    _ = C * x ^ ζ * R := by rw [hpow]; dsimp [C]; ring
    _ ≤ C * x ^ η * R :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hxpow hC.le) hR

end A8HighFPriceMoments

namespace A8HighFPricePowGrid

private def rho (D E : ℝ) (M j : ℕ) : ℝ :=
  D/(2*E)*(1+1/(M:ℝ))^j
private def cells (D E : ℝ) (M : ℕ) : Finset ℕ :=
  (Finset.range (3*M+1)).filter
    (fun j => D/(2*E) ≤ rho D E M j ∧ rho D E M j ≤ 2*D/E)

private lemma rho_lower (D E : ℝ) (M : ℕ)
    (hD : 0<D) (hE : 0<E) (hM : 1≤ M) (j : ℕ) :
    D/(2*E) ≤ rho D E M j := by
  have hM0 : (0:ℝ)<M := by exact_mod_cast (show 0<M by omega)
  have hbase : (1:ℝ) ≤ 1+1/(M:ℝ) := by
    have hq : 0≤1/(M:ℝ) := by positivity
    linarith only [hq]
  have hp : (1:ℝ) ≤ (1+1/(M:ℝ))^j := one_le_pow₀ hbase
  change D/(2*E) ≤ D/(2*E)*(1+1/(M:ℝ))^j
  nlinarith only [mul_le_mul_of_nonneg_left hp
    (show 0 ≤ D/(2*E) by positivity)]

private lemma rho_step (D E : ℝ) (M j : ℕ) :
    rho D E M (j+1)=rho D E M j*(1+1/(M:ℝ)) := by
  change D/(2*E)*(1+1/(M:ℝ))^(j+1)=
    (D/(2*E)*(1+1/(M:ℝ))^j)*(1+1/(M:ℝ))
  rw [pow_succ, mul_assoc]

private lemma spacing_of_step (f : ℕ→ℝ) (g : ℝ)
    (hstep : ∀ j, g ≤ f (j+1)-f j) :
    ∀ i j : ℕ, i≤ j → ((j:ℝ)-i)*g ≤ f j-f i := by
  intro i j hij
  induction j, hij using Nat.le_induction with
  | base => simp
  | succ n hin ih =>
      have h1 := hstep n
      have h2 : (((n+1:ℕ):ℝ)-i)*g=((n:ℝ)-i)*g+g := by
        push_cast
        ring
      rw [h2]
      linarith

private theorem power_grid (k M : ℕ) (D E U V : ℝ)
    (hk : 1≤ k) (hM : 1≤ M) (hD : 0<D) (hE : 0<E)
    (hU : 0<U) (hV : 0<V)
    (hscale : (D/E)^k=V/U) :
    let W : ℝ := (2:ℝ)^k
    (∀ i j : ℕ, i≤ j →
      ((j:ℝ)-i)*(V/(W*U*(M:ℝ))) ≤
        (rho D E M j)^k-(rho D E M i)^k) ∧
    (∀ j∈cells D E M,
      V/(W*U) ≤ (rho D E M j)^k ∧
      (rho D E M j)^k ≤ W*V/U) := by
  classical
  let W : ℝ := (2:ℝ)^k
  have hW : 0<W := by dsimp [W]; positivity
  have hM0 : (0:ℝ)<M := by exact_mod_cast (show 0<M by omega)
  have hq0 : 0≤1/(M:ℝ) := by positivity
  have hbase : 1≤(1+1/(M:ℝ)) := by linarith only [hq0]
  have hkr : (1:ℝ)≤ k := by exact_mod_cast hk
  have hber := one_add_mul_le_pow (a:=1/(M:ℝ))
    (by linarith only [hq0]) k
  have hdelta : 1/(M:ℝ) ≤ (1+1/(M:ℝ))^k-1 := by
    have ht := mul_le_mul_of_nonneg_right hkr hq0
    nlinarith only [hber,ht]
  have hrbase : D/(2*E)=(D/E)/2 := by field_simp [hE.ne']
  have hrupper : 2*D/E=2*(D/E) := by ring
  have hlow : ∀ j, V/(W*U) ≤ (rho D E M j)^k := by
    intro j
    have ht := pow_le_pow_left₀
      (show 0≤ D/(2*E) by positivity)
      (rho_lower D E M hD hE hM j) k
    have heq : (D/(2*E))^k=V/(W*U) := by
      rw [hrbase, div_pow, hscale]
      dsimp [W]
      field_simp [hU.ne', (by positivity : ((2:ℝ)^k) ≠ 0)]

    rwa [heq] at ht
  have hstep : ∀ j, V/(W*U*(M:ℝ)) ≤
      (rho D E M (j+1))^k-(rho D E M j)^k := by
    intro j
    have hf0 : 0≤(rho D E M j)^k := by
      have hr := rho_lower D E M hD hE hM j
      have hr0 : 0≤ rho D E M j :=
        (show 0≤ D/(2*E) by positivity).trans hr
      exact pow_nonneg hr0 k
    have hprod := mul_le_mul (hlow j) hdelta hq0 hf0
    have hform : (rho D E M (j+1))^k-(rho D E M j)^k =
        (rho D E M j)^k*((1+1/(M:ℝ))^k-1) := by
      rw [rho_step, mul_pow]
      ring
    have hcoeff : (V/(W*U))*(1/(M:ℝ))=V/(W*U*(M:ℝ)) := by ring
    rw [hform]
    nlinarith only [hprod,hcoeff]
  refine ⟨spacing_of_step (fun j => (rho D E M j)^k)
    (V/(W*U*(M:ℝ))) hstep,?_⟩
  intro j hj
  have hrange : D/(2*E)≤ rho D E M j ∧ rho D E M j≤2*D/E :=
    (Finset.mem_filter.mp hj).2
  have hr0 : 0≤ rho D E M j :=
    (show 0≤ D/(2*E) by positivity).trans hrange.1
  have ht := pow_le_pow_left₀ hr0 hrange.2 k
  have heq : (2*D/E)^k=W*V/U := by
    rw [hrupper, mul_pow, hscale]
    dsimp [W]
    ring
  exact ⟨hlow j, by rwa [heq] at ht⟩

end A8HighFPricePowGrid

namespace A8HighFPriceCofactor

private lemma one_add_pow_upper (k : ℕ) (q : ℝ)
    (hq0 : 0≤ q) (hq1 : q≤1) :
    (1+q)^k-1 ≤ (k:ℝ)*(2:ℝ)^k*q := by
  have hb : 0≤1+q := by linarith
  have hb2 : 1+q≤2 := by linarith
  have hstep : ∀ n : ℕ, n≤ k →
      (1+q)^n-1 ≤ (n:ℝ)*(2:ℝ)^k*q := by
    intro n
    induction n with
    | zero =>
        intro _
        simp
    | succ n ih =>
        intro hn
        have hnk : n≤ k := by omega
        have hih := ih hnk
        have hp : (1+q)^n≤(2:ℝ)^n :=
          pow_le_pow_left₀ hb hb2 n
        have hp2 : (2:ℝ)^n≤(2:ℝ)^k :=
          pow_le_pow_right₀ (by norm_num : (1:ℝ)≤2) hnk
        have hqpow : q*(1+q)^n≤ q*(2:ℝ)^k :=
          mul_le_mul_of_nonneg_left (hp.trans hp2) hq0
        rw [pow_succ]
        push_cast
        nlinarith only [hih,hqpow]
  exact hstep k le_rfl

private lemma cofactor_unit_bound (k M : ℕ) (x D E d e u v r : ℝ)
    (hk : 1≤ k) (hM : 1≤ M) (hx : 1≤ x) (hMx : (M:ℝ)≤ x)
    (_hD : 0<D) (hE : 0<E)
    (hd : 0<d) (he : 0<e) (hu : 0≤ u) (hr : 0<r)
    (_hdlo : D/2<d) (helo : E/2<e)
    (hn : d^k*u≤ x)
    (hshift : e^k*v=d^k*u+1)
    (hcelllo : r≤ d/e)
    (hcellhi : d/e≤ r*(1+1/(M:ℝ))) :
    let V : ℝ := x/E^k
    let B : ℝ := (2:ℝ)^k*(1+(k:ℝ)*(2:ℝ)^k)
    |v-r^k*u|≤ B*V/(M:ℝ) := by
  let V : ℝ := x/E^k
  let B : ℝ := (2:ℝ)^k*(1+(k:ℝ)*(2:ℝ)^k)
  let t : ℝ := d/e
  let q : ℝ := 1/(M:ℝ)
  have hM0 : (0:ℝ)<M := by exact_mod_cast (show 0<M by omega)
  have hx0 : 0<x := by linarith
  have hV : 0<V := by dsimp [V]; positivity
  have ht : 0<t := by dsimp [t]; positivity
  have hq0 : 0≤ q := by dsimp [q]; positivity
  have hq1 : q≤1 := by
    dsimp [q]
    have hM1 : (1:ℝ)≤ M := by exact_mod_cast hM
    exact (div_le_iff₀ hM0).mpr (by simpa using hM1)
  have h2k : 0<(2:ℝ)^k := by positivity
  have h2kk : (2:ℝ)^(2*k)=(2:ℝ)^k*(2:ℝ)^k := by
    rw [show 2*k=k+k by omega, pow_add]
  have hE2e : E≤2*e := by linarith only [helo]
  have hEpow : E^k≤(2:ℝ)^k*e^k := by
    have hp := pow_le_pow_left₀ hE.le hE2e k
    simpa only [mul_pow] using hp
  have hteq : t^k*u=d^k*u/e^k := by
    dsimp [t]
    rw [div_pow]
    ring
  have hscale : x/e^k≤(2:ℝ)^k*V := by
    calc
      x/e^k≤((2:ℝ)^k*x)/E^k := by
        apply (div_le_div_iff₀ (pow_pos he k) (pow_pos hE k)).mpr
        nlinarith only [mul_le_mul_of_nonneg_left hEpow hx0.le]
      _ = (2:ℝ)^k*V := by dsimp [V]; ring
  have hru : r^k*u≤(2:ℝ)^k*V := by
    have hrpow := pow_le_pow_left₀ hr.le hcelllo k
    have hru0 := mul_le_mul_of_nonneg_right hrpow hu
    calc
      r^k*u≤ t^k*u := hru0
      _ = d^k*u/e^k := hteq
      _ ≤ x/e^k := div_le_div_of_nonneg_right hn (pow_nonneg he.le k)
      _ ≤ (2:ℝ)^k*V := hscale
  have hsurface : |v-t^k*u|≤(2:ℝ)^k*V/(M:ℝ) := by
    have heq : v-t^k*u=1/e^k := by
      rw [hteq]
      field_simp [he.ne']
      nlinarith only [hshift]
    rw [heq, abs_div, abs_one, abs_of_pos (pow_pos he k)]
    calc
      1/e^k≤(2:ℝ)^k/E^k := by
        apply (div_le_div_iff₀ (pow_pos he k) (pow_pos hE k)).mpr
        simpa only [one_mul] using hEpow
      _ = (2:ℝ)^k*V/x := by
        dsimp [V]
        field_simp [hx0.ne',hE.ne']

      _ ≤ (2:ℝ)^k*V/(M:ℝ) :=
        div_le_div_of_nonneg_left (by positivity) hM0 hMx
  have hbin := one_add_pow_upper k q hq0 hq1
  have hdiff0 : 0≤ t^k-r^k := by
    have hp := pow_le_pow_left₀ hr.le hcelllo k
    linarith only [hp]
  have hdiff : t^k-r^k≤(k:ℝ)*(2:ℝ)^k*r^k/(M:ℝ) := by
    have hp := pow_le_pow_left₀ ht.le hcellhi k
    change t^k≤(r*(1+q))^k at hp
    rw [mul_pow] at hp
    calc
      t^k-r^k≤ r^k*((1+q)^k-1) := by nlinarith only [hp]
      _ ≤ r^k*((k:ℝ)*(2:ℝ)^k*q) :=
        mul_le_mul_of_nonneg_left hbin (pow_nonneg hr.le k)
      _ = (k:ℝ)*(2:ℝ)^k*r^k/(M:ℝ) := by dsimp [q]; ring
  have hcenter : (t^k-r^k)*u≤
      (k:ℝ)*(2:ℝ)^(2*k)*V/(M:ℝ) := by
    calc
      (t^k-r^k)*u≤
          ((k:ℝ)*(2:ℝ)^k*r^k/(M:ℝ))*u :=
        mul_le_mul_of_nonneg_right hdiff hu
      _ = ((k:ℝ)*(2:ℝ)^k/(M:ℝ))*(r^k*u) := by ring
      _ ≤ ((k:ℝ)*(2:ℝ)^k/(M:ℝ))*((2:ℝ)^k*V) :=
        mul_le_mul_of_nonneg_left hru (by positivity)
      _ = (k:ℝ)*(2:ℝ)^(2*k)*V/(M:ℝ) := by
        rw [h2kk]
        ring
  calc
    |v-r^k*u|=|(v-t^k*u)+(t^k-r^k)*u| := by congr 1 ; ring
    _ ≤ |v-t^k*u|+|(t^k-r^k)*u| := abs_add_le _ _
    _ = |v-t^k*u|+(t^k-r^k)*u := by
      rw [abs_of_nonneg (mul_nonneg hdiff0 hu)]
    _ ≤ (2:ℝ)^k*V/(M:ℝ) +
          (k:ℝ)*(2:ℝ)^(2*k)*V/(M:ℝ) :=
      add_le_add hsurface hcenter
    _ = B*V/(M:ℝ) := by
      dsimp [B]
      rw [h2kk]
      ring

end A8HighFPriceCofactor

set_option maxHeartbeats 4000000
noncomputable section
namespace A8HighFPriceFactor
private abbrev Poly := MvPolynomial (Fin 4) ℤ
private def Bihom (G : Poly) (a b : ℕ) : Prop :=
  ∀ m ∈ G.support, m 0 + m 1 = a ∧ m 2 + m 3 = b
private def Primitive (G : Poly) : Prop :=
  ∀ z : ℤ, (∀ m : Fin 4 →₀ ℕ, z ∣ G.coeff m) → IsUnit z
private def HighFactor (k thr : ℕ) (F G : Poly) : Prop :=
  G ∣ F ∧ G ≠ 0 ∧ Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G) ∧
    ∃ a b : ℕ, 1 ≤ a ∧ 1 ≤ b ∧ thr ≤ a + k*b ∧ Bihom G a b

namespace FactorAlgebra
namespace A5FactorDegreeTrial
open MvPolynomial

private theorem totalDegree_prod_eq_sum
    (s : Multiset (MvPolynomial (Fin 4) ℤ))
    (hs : ∀ p ∈ s, p ≠ 0) :
    s.prod ≠ 0 ∧
      s.prod.totalDegree = (s.map MvPolynomial.totalDegree).sum := by
  induction s using Multiset.induction_on with
  | empty => simp
  | @cons p t ih =>
      have hp : p ≠ 0 := hs p (by simp)
      have ht : ∀ q ∈ t, q ≠ 0 := by
        intro q hq
        exact hs q (by simp [hq])
      obtain ⟨ht0, htd⟩ := ih ht
      constructor
      · simpa using mul_ne_zero hp ht0
      · simp only [Multiset.prod_cons, Multiset.map_cons, Multiset.sum_cons]
        rw [MvPolynomial.totalDegree_mul_of_isDomain hp ht0, htd]

private theorem degree_le_of_dvd (a b : MvPolynomial (Fin 4) ℤ)
    (ha : a ≠ 0) (hb : b ≠ 0) (hab : a ∣ b) :
    a.totalDegree ≤ b.totalDegree := by
  obtain ⟨c, rfl⟩ := hab
  have hc : c ≠ 0 := by
    intro hc
    simp [hc] at hb
  rw [MvPolynomial.totalDegree_mul_of_isDomain ha hc]
  omega

private theorem degree_eq_of_associated (a b : MvPolynomial (Fin 4) ℤ)
    (ha : a ≠ 0) (hb : b ≠ 0) (hab : Associated a b) :
    a.totalDegree = b.totalDegree := by
  exact le_antisymm (degree_le_of_dvd a b ha hb hab.dvd)
    (degree_le_of_dvd b a hb ha hab.symm.dvd)

private theorem exists_prime_factors_degree (F : MvPolynomial (Fin 4) ℤ)
    (hF : F ≠ 0) :
    ∃ s : Multiset (MvPolynomial (Fin 4) ℤ),
      (∀ p ∈ s, Prime p) ∧
        Associated s.prod F ∧
          (s.map MvPolynomial.totalDegree).sum = F.totalDegree := by
  obtain ⟨s, hprime, hassoc⟩ :=
    UniqueFactorizationMonoid.exists_prime_factors F hF
  have hs : ∀ p ∈ s, p ≠ 0 := by
    intro p hp
    exact (hprime p hp).ne_zero
  obtain ⟨hs0, hdeg⟩ := totalDegree_prod_eq_sum s hs
  refine ⟨s, hprime, hassoc, ?_⟩
  rw [← hdeg]
  exact degree_eq_of_associated s.prod F hs0 hF hassoc

private theorem card_positive_degree_le_sum
    (s : Multiset (MvPolynomial (Fin 4) ℤ)) :
    (s.filter (fun p => 0 < p.totalDegree)).card ≤
      (s.map MvPolynomial.totalDegree).sum := by
  induction s using Multiset.induction_on with
  | empty => simp
  | @cons p t ih =>
      by_cases hp : 0 < p.totalDegree
      · simp only [Multiset.filter_cons, if_pos hp, Multiset.card_add,
          Multiset.card_singleton, Multiset.map_cons, Multiset.sum_cons]
        omega
      · simp only [Multiset.filter_cons, if_neg hp, zero_add,
          Multiset.map_cons, Multiset.sum_cons]
        omega

private theorem exists_bounded_prime_family (F : MvPolynomial (Fin 4) ℤ)
    (hF : F ≠ 0) (D : ℕ) (hdeg : F.totalDegree ≤ D) :
    ∃ S : Finset (MvPolynomial (Fin 4) ℤ),
      S.card ≤ D ∧
        ∀ p ∈ S, Prime p ∧ 0 < p.totalDegree ∧ p ∣ F := by
  obtain ⟨s, hprime, hassoc, hsum⟩ := exists_prime_factors_degree F hF
  classical
  let S : Finset (MvPolynomial (Fin 4) ℤ) :=
    (s.filter (fun p => 0 < p.totalDegree)).toFinset
  refine ⟨S, ?_, ?_⟩
  · have h1 := Multiset.toFinset_card_le
      (s.filter (fun p => 0 < p.totalDegree))
    have h2 := card_positive_degree_le_sum s
    dsimp [S]
    omega
  · intro p hp
    have hp' : p ∈ s.filter (fun p => 0 < p.totalDegree) :=
      (Multiset.mem_toFinset).mp hp
    obtain ⟨hps, hpos⟩ := Multiset.mem_filter.mp hp'
    have hpd : p ∣ s.prod := Multiset.dvd_prod hps
    exact ⟨hprime p hps, hpos, hpd.trans hassoc.dvd⟩

end A5FactorDegreeTrial

namespace A5PrimitiveNormalizationTrial

private def PrimitiveIntegral (G : MvPolynomial (Fin 4) ℤ) : Prop :=
  ∀ z : ℤ,
    (∀ m : Fin 4 →₀ ℕ, z ∣ MvPolynomial.coeff m G) →
      IsUnit z

private theorem primitive_of_irreducibles
    (p : MvPolynomial (Fin 4) ℤ)
    (hp : Irreducible p)
    (hpC : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) p)) :
    PrimitiveIntegral p := by
  intro z hz
  have hd : MvPolynomial.C z ∣ p :=
    (MvPolynomial.C_dvd_iff_dvd_coeff z p).mpr hz
  have hz0 : z ≠ 0 := by
    intro hz0
    subst z
    obtain ⟨q, hq⟩ := hd
    have hp0 : p = 0 := by simpa using hq
    exact hp.ne_zero hp0
  rcases (hp.dvd_iff).mp hd with hu | ha
  · let ev : MvPolynomial (Fin 4) ℤ →+* ℤ :=
      MvPolynomial.eval₂Hom (RingHom.id ℤ) (fun _ => 0)
    have he : IsUnit (ev (MvPolynomial.C z)) := hu.map ev
    simpa [ev] using he
  · have hpz : p ∣ MvPolynomial.C z := ha.dvd
    obtain ⟨b, hbz, hpb⟩ := (MvPolynomial.dvd_C_iff_exists hz0).mp hpz
    have hb0 : b ≠ 0 := by
      intro hb0
      have hp0 : p = 0 := by simpa [hb0] using hpb
      exact hp.ne_zero hp0
    have hbC : (b : ℂ) ≠ 0 := by exact_mod_cast hb0
    have huC : IsUnit (MvPolynomial.C (b : ℂ) : MvPolynomial (Fin 4) ℂ) :=
      ((isUnit_iff_ne_zero).mpr hbC).map (MvPolynomial.C : ℂ →+* MvPolynomial (Fin 4) ℂ)
    have hmap : MvPolynomial.map (Int.castRingHom ℂ) p =
        MvPolynomial.C (b : ℂ) := by solve | simp [hpb]
    exact False.elim (hpC.not_isUnit (hmap.symm ▸ huC))

end A5PrimitiveNormalizationTrial

namespace A5CoverageTrial
open MvPolynomial

private theorem intToComplex_totalDegree
    (p : MvPolynomial (Fin 4) ℤ) :
    (MvPolynomial.map (Int.castRingHom ℂ) p).totalDegree = p.totalDegree := by
  have hs : (MvPolynomial.map (Int.castRingHom ℂ) p).support = p.support :=
    MvPolynomial.support_map_of_injective p (by exact_mod_cast (Int.cast_injective : Function.Injective (fun z : ℤ => (z : ℂ))))
  simp only [MvPolynomial.totalDegree, hs]

private theorem intToComplex_nonunit_of_pos_degree
    (p : MvPolynomial (Fin 4) ℤ)
    (hp : 0 < p.totalDegree) :
    ¬IsUnit (MvPolynomial.map (Int.castRingHom ℂ) p) := by
  intro hu
  have hd := (MvPolynomial.isUnit_iff_totalDegree_of_isReduced.mp hu).2
  rw [intToComplex_totalDegree] at hd
  omega

private theorem positive_degree_of_complex_irreducible
    (p : MvPolynomial (Fin 4) ℤ)
    (hp : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) p)) :
    0 < p.totalDegree := by
  by_contra hpos
  have hd : p.totalDegree = 0 := by omega
  have hdc : (MvPolynomial.map (Int.castRingHom ℂ) p).totalDegree = 0 := by
    rw [intToComplex_totalDegree]
    exact hd
  have hC := (MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp hdc
  have hc0 : MvPolynomial.coeff 0
      (MvPolynomial.map (Int.castRingHom ℂ) p) ≠ 0 := by
    intro hz
    have hp0 : MvPolynomial.map (Int.castRingHom ℂ) p = 0 := by
      simpa [hz] using hC
    exact hp.ne_zero hp0
  have hu0 : IsUnit (MvPolynomial.coeff 0
      (MvPolynomial.map (Int.castRingHom ℂ) p)) :=
    (isUnit_iff_ne_zero).mpr hc0
  have hu : IsUnit (MvPolynomial.map (Int.castRingHom ℂ) p) :=
    (MvPolynomial.isUnit_iff_totalDegree_of_isReduced).mpr ⟨hu0, hdc⟩
  exact hp.not_isUnit hu

private theorem totalDegree_prod_eq_sum
    (s : Multiset (MvPolynomial (Fin 4) ℤ))
    (hs : ∀ p ∈ s, p ≠ 0) :
    s.prod ≠ 0 ∧
      s.prod.totalDegree = (s.map MvPolynomial.totalDegree).sum := by
  induction s using Multiset.induction_on with
  | empty => simp
  | @cons p t ih =>
      have hp : p ≠ 0 := hs p (by simp)
      have ht : ∀ q ∈ t, q ≠ 0 := by
        intro q hq
        exact hs q (by simp [hq])
      obtain ⟨ht0, htd⟩ := ih ht
      constructor
      · simpa using mul_ne_zero hp ht0
      · simp only [Multiset.prod_cons, Multiset.map_cons, Multiset.sum_cons]
        rw [MvPolynomial.totalDegree_mul_of_isDomain hp ht0, htd]

private theorem degree_le_of_dvd (a b : MvPolynomial (Fin 4) ℤ)
    (ha : a ≠ 0) (hb : b ≠ 0) (hab : a ∣ b) :
    a.totalDegree ≤ b.totalDegree := by
  obtain ⟨c, rfl⟩ := hab
  have hc : c ≠ 0 := by
    intro hc
    simp [hc] at hb
  rw [MvPolynomial.totalDegree_mul_of_isDomain ha hc]
  omega

private theorem degree_eq_of_associated (a b : MvPolynomial (Fin 4) ℤ)
    (ha : a ≠ 0) (hb : b ≠ 0) (hab : Associated a b) :
    a.totalDegree = b.totalDegree := by
  exact le_antisymm (degree_le_of_dvd a b ha hb hab.dvd)
    (degree_le_of_dvd b a hb ha hab.symm.dvd)

private theorem exists_prime_factors_degree (F : MvPolynomial (Fin 4) ℤ)
    (hF : F ≠ 0) :
    ∃ s : Multiset (MvPolynomial (Fin 4) ℤ),
      (∀ p ∈ s, Prime p) ∧
        Associated s.prod F ∧
          (s.map MvPolynomial.totalDegree).sum = F.totalDegree := by
  obtain ⟨s, hprime, hassoc⟩ :=
    UniqueFactorizationMonoid.exists_prime_factors F hF
  have hs : ∀ p ∈ s, p ≠ 0 := by
    intro p hp
    exact (hprime p hp).ne_zero
  obtain ⟨hs0, hdeg⟩ := totalDegree_prod_eq_sum s hs
  refine ⟨s, hprime, hassoc, ?_⟩
  rw [← hdeg]
  exact degree_eq_of_associated s.prod F hs0 hF hassoc

private theorem positive_prime_factor_of_geometric_irreducible
    (G : MvPolynomial (Fin 4) ℤ) (hG : G ≠ 0)
    (hGeom : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G)) :
    ∃ p : MvPolynomial (Fin 4) ℤ,
      Prime p ∧ 0 < p.totalDegree ∧ p ∣ G ∧
        Associated (MvPolynomial.map (Int.castRingHom ℂ) p)
          (MvPolynomial.map (Int.castRingHom ℂ) G) := by
  obtain ⟨s, hsprime, hassoc, hsum⟩ := exists_prime_factors_degree G hG
  have hGpos := positive_degree_of_complex_irreducible G hGeom
  have hsumpos : 0 < (s.map MvPolynomial.totalDegree).sum := by omega
  have find_pos : ∀ t : Multiset (MvPolynomial (Fin 4) ℤ),
      0 < (t.map MvPolynomial.totalDegree).sum →
      ∃ p ∈ t, 0 < p.totalDegree := by
    intro t
    induction t using Multiset.induction_on with
    | empty => simp
    | @cons a t ih =>
      intro h
      by_cases ha : 0 < a.totalDegree
      · exact ⟨a, by simp, ha⟩
      · have ht : 0 < (t.map MvPolynomial.totalDegree).sum := by
          simp only [Multiset.map_cons, Multiset.sum_cons] at h
          omega
        obtain ⟨p, hp, hpdeg⟩ := ih ht
        exact ⟨p, by simp [hp], hpdeg⟩
  obtain ⟨p, hp, hpdeg⟩ := find_pos s hsumpos
  have hpd : p ∣ G := (Multiset.dvd_prod hp).trans hassoc.dvd
  have hmapd : MvPolynomial.map (Int.castRingHom ℂ) p ∣
      MvPolynomial.map (Int.castRingHom ℂ) G := by
    obtain ⟨r, hr⟩ := hpd
    refine ⟨MvPolynomial.map (Int.castRingHom ℂ) r, ?_⟩
    simp [hr]
  have hassoc : Associated
      (MvPolynomial.map (Int.castRingHom ℂ) p)
      (MvPolynomial.map (Int.castRingHom ℂ) G) := by
    rcases (Irreducible.dvd_iff hGeom).mp hmapd with hu | ha
    · exact False.elim ((intToComplex_nonunit_of_pos_degree p hpdeg) hu)
    · exact ha.symm
  exact ⟨p, hsprime p hp, hpdeg, hpd, hassoc⟩

private theorem match_geometric_factor_to_prime_family
    (F G : MvPolynomial (Fin 4) ℤ)
    (s : Multiset (MvPolynomial (Fin 4) ℤ))
    (hsprime : ∀ q ∈ s, Prime q)
    (hassF : Associated s.prod F)
    (hG : G ≠ 0) (hGF : G ∣ F)
    (hGeom : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G)) :
    ∃ q ∈ s, Prime q ∧ 0 < q.totalDegree ∧ q ∣ F ∧
      Associated (MvPolynomial.map (Int.castRingHom ℂ) q)
        (MvPolynomial.map (Int.castRingHom ℂ) G) := by
  obtain ⟨p, hp, hpdeg, hpdG, hpmG⟩ :=
    positive_prime_factor_of_geometric_irreducible G hG hGeom
  have hpdF : p ∣ F := hpdG.trans hGF
  have hpdProd : p ∣ s.prod := hpdF.trans hassF.symm.dvd
  have hpdList : p ∣ s.toList.prod := by simpa using hpdProd
  obtain ⟨q, hqList, hpdq⟩ := (Prime.dvd_prod_iff hp).mp hpdList
  have hqs : q ∈ s := by simpa using hqList
  have hqprime : Prime q := hsprime q hqs
  have hpq : Associated p q :=
    (Prime.dvd_prime_iff_associated hp hqprime).mp hpdq
  have hqdeg : 0 < q.totalDegree := by
    have heq := degree_eq_of_associated p q hp.ne_zero hqprime.ne_zero hpq
    omega
  have hqF : q ∣ F := (Multiset.dvd_prod hqs).trans hassF.dvd
  have map_dvd : ∀ {a b : MvPolynomial (Fin 4) ℤ}, a ∣ b →
      MvPolynomial.map (Int.castRingHom ℂ) a ∣
        MvPolynomial.map (Int.castRingHom ℂ) b := by
    intro a b hab
    obtain ⟨r, hr⟩ := hab
    refine ⟨MvPolynomial.map (Int.castRingHom ℂ) r, ?_⟩
    simp [hr]
  have hqmP : Associated
      (MvPolynomial.map (Int.castRingHom ℂ) q)
      (MvPolynomial.map (Int.castRingHom ℂ) p) := by
    exact associated_of_dvd_dvd (map_dvd hpq.symm.dvd)
      (map_dvd hpq.dvd)
  exact ⟨q, hqs, hqprime, hqdeg, hqF, hqmP.trans hpmG⟩

private theorem support_eq_of_associated_complex
    (P Q : MvPolynomial (Fin 4) ℂ)
    (h : Associated P Q) : P.support = Q.support := by
  obtain ⟨u, hu⟩ := h
  have hui : IsUnit (u : MvPolynomial (Fin 4) ℂ) := ⟨u, rfl⟩
  obtain ⟨c, hc, huc⟩ :=
    (MvPolynomial.isUnit_iff_eq_C_of_isReduced).mp hui
  have hq : Q = MvPolynomial.C c * P := by
    rw [← hu, huc, mul_comm]
  apply Finset.ext
  intro m
  simp only [MvPolynomial.mem_support_iff]
  rw [hq, MvPolynomial.coeff_C_mul]
  simp [hc.ne_zero]

private theorem support_eq_of_associated_maps
    (p q : MvPolynomial (Fin 4) ℤ)
    (h : Associated (MvPolynomial.map (Int.castRingHom ℂ) p)
      (MvPolynomial.map (Int.castRingHom ℂ) q)) :
    p.support = q.support := by
  have hi : Function.Injective (fun z : ℤ => (z : ℂ)) := by
    exact_mod_cast (Int.cast_injective : Function.Injective (fun z : ℤ => (z : ℂ)))
  calc
    p.support = (MvPolynomial.map (Int.castRingHom ℂ) p).support :=
      (MvPolynomial.support_map_of_injective p hi).symm
    _ = (MvPolynomial.map (Int.castRingHom ℂ) q).support :=
      support_eq_of_associated_complex _ _ h
    _ = q.support := MvPolynomial.support_map_of_injective q hi

private theorem eval_zero_iff_of_associated_maps
    (p q : MvPolynomial (Fin 4) ℤ)
    (h : Associated (MvPolynomial.map (Int.castRingHom ℂ) p)
      (MvPolynomial.map (Int.castRingHom ℂ) q))
    (x : Fin 4 → ℤ) :
    MvPolynomial.eval x p = 0 ↔ MvPolynomial.eval x q = 0 := by
  have bridge (r : MvPolynomial (Fin 4) ℤ) :
      MvPolynomial.eval (fun i => (x i : ℂ))
        (MvPolynomial.map (Int.castRingHom ℂ) r) =
        ((MvPolynomial.eval x r : ℤ) : ℂ) := by
    simpa [Function.comp_def] using
      (MvPolynomial.map_eval (Int.castRingHom ℂ) x r).symm
  have dvd_zero (P Q : MvPolynomial (Fin 4) ℂ) (hd : P ∣ Q) :
      MvPolynomial.eval (fun i => (x i : ℂ)) P = 0 →
        MvPolynomial.eval (fun i => (x i : ℂ)) Q = 0 := by
    obtain ⟨R, hR⟩ := hd
    intro hP
    simp [hR, hP]
  constructor
  · intro hp
    have hpc : MvPolynomial.eval (fun i => (x i : ℂ))
        (MvPolynomial.map (Int.castRingHom ℂ) p) = 0 := by
      rw [bridge]
      exact_mod_cast hp
    have hqc := dvd_zero _ _ h.dvd hpc
    rw [bridge] at hqc
    exact_mod_cast hqc
  · intro hq
    have hqc : MvPolynomial.eval (fun i => (x i : ℂ))
        (MvPolynomial.map (Int.castRingHom ℂ) q) = 0 := by
      rw [bridge]
      exact_mod_cast hq
    have hpc := dvd_zero _ _ h.symm.dvd hqc
    rw [bridge] at hpc
    exact_mod_cast hpc

end A5CoverageTrial

end FactorAlgebra

open FactorAlgebra.A5CoverageTrial

private theorem finite_primitive_high_cover
    (k thr : ℕ) (F : MvPolynomial (Fin 4) ℤ) (hF : F ≠ 0)
    (D : ℕ) (hdeg : F.totalDegree ≤ D) :
    ∃ S : Finset (MvPolynomial (Fin 4) ℤ),
      S.card ≤ D ∧
      (∀ q ∈ S, Primitive q ∧ HighFactor k thr F q) ∧
      ∀ G, HighFactor k thr F G →
        ∃ q ∈ S, ∀ x : Fin 4 → ℤ,
          (MvPolynomial.eval x G = 0 ↔ MvPolynomial.eval x q = 0) := by
  obtain ⟨s, hsprime, hassF, hsum⟩ :=
    FactorAlgebra.A5CoverageTrial.exists_prime_factors_degree F hF
  classical
  let S₀ : Finset (MvPolynomial (Fin 4) ℤ) :=
    (s.filter (fun p => 0 < p.totalDegree)).toFinset
  let S : Finset (MvPolynomial (Fin 4) ℤ) :=
    S₀.filter (HighFactor k thr F)
  refine ⟨S, ?_, ?_, ?_⟩
  · have hcard0 : S₀.card ≤ D := by
      have h1 := Multiset.toFinset_card_le
        (s.filter (fun p => 0 < p.totalDegree))
      have h2 := FactorAlgebra.A5FactorDegreeTrial.card_positive_degree_le_sum s
      dsimp [S₀]
      omega
    exact (Finset.card_le_card (Finset.filter_subset _ _)).trans hcard0
  · intro q hq
    have hqE : HighFactor k thr F q := (Finset.mem_filter.mp hq).2
    have hqS₀ : q ∈ S₀ := (Finset.mem_filter.mp hq).1
    have hqs : q ∈ s := by
      exact (Multiset.mem_filter.mp ((Multiset.mem_toFinset).mp hqS₀)).1
    have hqp : Prime q := hsprime q hqs
    have hqGeom : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) q) := hqE.2.2.1
    exact ⟨FactorAlgebra.A5PrimitiveNormalizationTrial.primitive_of_irreducibles
      q hqp.irreducible hqGeom, hqE⟩
  · intro G hG
    rcases hG with ⟨hGF, hG0, hGeom, α, β, hα, hβ, hhigh, hBi⟩
    obtain ⟨q, hqs, hqp, hqdeg, hqF, hass⟩ :=
      FactorAlgebra.A5CoverageTrial.match_geometric_factor_to_prime_family
        F G s hsprime hassF hG0 hGF hGeom
    have hqBi : Bihom q α β := by
      intro m hm
      apply hBi
      have hsupp := FactorAlgebra.A5CoverageTrial.support_eq_of_associated_maps q G hass
      rw [← hsupp]
      exact hm
    have hqE : HighFactor k thr F q :=
      ⟨hqF, hqp.ne_zero, hass.irreducible_iff.mpr hGeom,
        ⟨α, β, hα, hβ, hhigh, hqBi⟩⟩
    have hqS : q ∈ S := by
      apply Finset.mem_filter.mpr
      constructor
      · change q ∈ (s.filter (fun p => 0 < p.totalDegree)).toFinset
        exact (Multiset.mem_toFinset).mpr
          (Multiset.mem_filter.mpr ⟨hqs, hqdeg⟩)
      · exact hqE
    refine ⟨q, hqS, ?_⟩
    intro x
    exact (FactorAlgebra.A5CoverageTrial.eval_zero_iff_of_associated_maps q G hass x).symm

end A8HighFPriceFactor

