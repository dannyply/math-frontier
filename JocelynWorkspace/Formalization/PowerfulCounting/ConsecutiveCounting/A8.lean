theorem nonaxis_Q_at_kernel_ne_zero
    (k : ℕ) (P Q : MvPolynomial (Fin 2) ℝ)
    (a b c : ℝ) (ha : a≠0)
    (hno : ∀ w : Fin 2 → ℝ, w≠0 →
      MvPolynomial.eval w P=0 → MvPolynomial.eval w Q=0 → False)
    (hres : MvPolynomial.X (1:Fin 2)^k*P-MvPolynomial.X (0:Fin 2)^k*Q =
      MvPolynomial.C c*(MvPolynomial.C a*MvPolynomial.X (0:Fin 2)+
        MvPolynomial.C b*MvPolynomial.X (1:Fin 2))^(2*k+1)) :
    MvPolynomial.eval ![b,-a] Q≠0 := by
  intro hQ
  have hv := congrArg (MvPolynomial.eval ![b,-a]) hres
  have hlin : a*b+b*(-a)=0 := by ring
  simp only [map_sub,map_add,map_mul,map_pow,MvPolynomial.eval_X,MvPolynomial.eval_C,
    Matrix.cons_val_zero,Matrix.cons_val_one,hlin,zero_pow (by omega : 2*k+1≠0),mul_zero,
    hQ,sub_zero] at hv
  have hP : MvPolynomial.eval ![b,-a] P=0 :=
    (mul_eq_zero.mp hv).resolve_left (pow_ne_zero k (neg_ne_zero.mpr ha))
  apply hno ![b,-a] _ hP hQ
  intro hw
  have hh := congrArg (fun w : Fin 2 → ℝ => w 1) hw
  exact ha (by simpa using hh)

end
