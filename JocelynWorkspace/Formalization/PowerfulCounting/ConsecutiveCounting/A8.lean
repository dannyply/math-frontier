lemma o6 (k:ℕ) (n:Fin (k+1)→₀ ℕ):
    aExp k n+bExp k n=k*deg k n:=by
  unfold aExp bExp deg
  rw [←cz,cD]
  apply u4 rfl
  intro i hi
  have hle:i.val≤ k:=by omega
  calc
    (k-i.val)*n i+i.val*n i=((k-i.val)+i.val)*n i:=by ring
    _=k*n i:=by rw [cA hle]
lemma o7 (k:ℕ) (n:Fin (k+1)→₀ ℕ):
    deg k n=n.sum (fun _ a=> a):=by
  simp [deg,aD]
lemma o8 (k:ℕ) (d e t:K) (ht:t ≠ 0)
    (m:ℕ) (a:Fin (k+1)→₀ ℕ) (ha:deg k a≤ m) (c:ℚ):
    ∃ p∈ weightedHomogeneousSubmodule ℚ (af.wt k) (k*m),theta d e t m p=bj k d e t (monomial a c):=by
  let n:Fin 3→₀ ℕ:=Finsupp.equivFunOnFinite.symm
