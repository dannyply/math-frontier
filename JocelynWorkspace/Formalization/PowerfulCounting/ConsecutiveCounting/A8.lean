      exact hk (hd.symm.trans (hP hne))
    · rw [if_neg hd]
lemma vJ {A:Type*} [CommRing A] [IsDomain A]
    {p q:ar A} {c:A} {n:ℕ} (hc:c ≠ 0)
    (h:p*q=uL c*uR^n):
    ∀ k,k ≠ p.natDegree→ p.coeff k=0:=by
  have hpq:p*q ≠ 0:=by
    rw [h];exact aV (Polynomial.C_ne_zero.mpr hc) (u5 _ Polynomial.X_ne_zero)
