def emb (j : ℕ) (z : Quad) : Quad :=
  ((z.1.1, z.1.2), (z.1.1 ^ j * z.2.1, z.1.2 ^ j * z.2.2))

def excSet (j : ℕ) (Q : ℚ → ℚ) (x : ℝ) : Set Quad :=
  {z | 1 ≤ z.1.1 ∧ 1 ≤ z.1.2 ∧ 1 ≤ z.2.1 ∧ 1 ≤ z.2.2 ∧
    z.1.2 ^ (j + 2) * z.2.2 = z.1.1 ^ (j + 2) * z.2.1 + 1 ∧
    ((z.1.1 ^ (j + 2) * z.2.1 : ℕ) : ℝ) ≤ x ∧
    ((∃ t : ℚ, ((z.1.1 ^ (j + 2) * z.2.1 : ℕ) : ℚ) = -Q t) ∨
      (∃ t : ℚ, ((z.1.1 ^ (j + 2) * z.2.1 + 1 : ℕ) : ℚ) = Q t))}

theorem emb_value (j : ℕ) (z : Quad) :
    (emb j z).1.1 ^ 2 * (emb j z).2.1 = z.1.1 ^ (j + 2) * z.2.1 := by
  simp only [emb]
  ring

theorem emb_pos (j : ℕ) (Q : ℚ → ℚ) (x : ℝ) (z : Quad) (hz : z ∈ excSet j Q x) :
    1 ≤ (emb j z).1.1 ∧ 1 ≤ (emb j z).1.2 ∧ 1 ≤ (emb j z).2.1 ∧ 1 ≤ (emb j z).2.2 ∧
      (emb j z).1.2 ^ 2 * (emb j z).2.2 = (emb j z).1.1 ^ 2 * (emb j z).2.1 + 1 := by
  rcases z with ⟨⟨d, e⟩, ⟨u, v⟩⟩
  obtain ⟨hd, he, hu, hv, heq, -, -⟩ := hz
  simp only [emb]
  refine ⟨hd, he, Nat.one_le_iff_ne_zero.mpr (by positivity),
    Nat.one_le_iff_ne_zero.mpr (by positivity), ?_⟩
  calc e ^ 2 * (e ^ j * v) = e ^ (j + 2) * v := by ring
    _ = d ^ (j + 2) * u + 1 := heq
    _ = d ^ 2 * (d ^ j * u) + 1 := by ring

theorem emb_inj (j : ℕ) (Q : ℚ → ℚ) (x : ℝ) : Set.InjOn (emb j) (excSet j Q x) := by
  rintro ⟨⟨d, e⟩, ⟨u, v⟩⟩ hz ⟨⟨d', e'⟩, ⟨u', v'⟩⟩ hw heq
  have hd : d = d' := congrArg (fun p => p.1.1) heq
  have he : e = e' := congrArg (fun p => p.1.2) heq
  have hdu : d ^ j * u = d' ^ j * u' := congrArg (fun p => p.2.1) heq
  have hev : e ^ j * v = e' ^ j * v' := congrArg (fun p => p.2.2) heq
  subst d'
  subst e'
  have hd1 : 1 ≤ d := hz.1
  have he1 : 1 ≤ e := hz.2.1
  have hu : u = u' := Nat.eq_of_mul_eq_mul_left (by positivity : 0 < d ^ j) hdu
  have hv : v = v' := Nat.eq_of_mul_eq_mul_left (by positivity : 0 < e ^ j) hev
  subst u'
  subst v'
  rfl

theorem finite_excSet (j : ℕ) (Q : ℚ → ℚ) (x : ℝ) : (excSet j Q x).Finite := by
  have hf : (emb j '' excSet j Q x).Finite :=
    (A8ExcGen.finite_positivePairs x).subset (by
      intro q hq
      obtain ⟨z, hz, rfl⟩ := hq
      obtain ⟨hd, he, hu, hv, heq⟩ := emb_pos j Q x z hz
      refine ⟨hd, he, hu, hv, ?_, heq⟩
      rw [emb_value]
      exact hz.2.2.2.2.2.1)
  exact Set.Finite.of_finite_image hf (emb_inj j Q x)

