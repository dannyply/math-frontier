    refine (ncard_biUnion_le _ _).trans ?_
    apply Finset.sum_le_sum
    intro j _
    refine (ncard_biUnion_le _ _).trans ?_
    apply Finset.sum_le_sum
    intro a _
    exact ncard_biUnion_le _ _
  omega

