def FirstOriginalAlgebraicImplication : Prop :=
  ∀ (k : ℕ), 2 ≤ k →
  ∀ (P Q : MvPolynomial (Fin 2) ℤ)
    (a b c A B : ℤ) (d e u v : ℕ),
    (∀ μ ∈ P.support, μ 0 + μ 1 = k + 1) →
    (∀ μ ∈ Q.support, μ 0 + μ 1 = k + 1) →
    (∀ F : MvPolynomial (Fin 2) ℚ,
      F ∣ MvPolynomial.map (Int.castRingHom ℚ) P →
      F ∣ MvPolynomial.map (Int.castRingHom ℚ) Q →
      IsUnit F) →
    c ≠ 0 →
    A * a + B * b = 1 →
    MvPolynomial.X (1 : Fin 2) ^ k * P -
      MvPolynomial.X (0 : Fin 2) ^ k * Q =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ (2 * k + 1) →
    1 ≤ d → 1 ≤ e → 1 ≤ u → 1 ≤ v →
    (e : ℤ) ^ k * (v : ℤ) -
      (d : ℤ) ^ k * (u : ℤ) = 1 →
    MvPolynomial.eval ![(d : ℤ), (e : ℤ)] P * (u : ℤ) =
      MvPolynomial.eval ![(d : ℤ), (e : ℤ)] Q * (v : ℤ) →
    let S : ℤ := P.coeff (Finsupp.single (0 : Fin 2) (k + 1))
    let R : ℤ := P.coeff
      (Finsupp.single (0 : Fin 2) k +
        Finsupp.single (1 : Fin 2) 1)
    let K0 : ℤ :=
      b * S - a * R +
        (Nat.choose (2 * k) (k - 1) : ℤ) *
          c * a ^ (k + 1) * b ^ (k + 1)
    let m : ℤ := a * (d : ℤ) + b * (e : ℤ)
    K0 ≠ 0 ∧ m ≠ 0 ∧ m ∣ K0 ∧
      MvPolynomial.eval ![b, -a] P = b ^ k * K0 ∧
      MvPolynomial.eval ![b, -a] Q =
        (-1 : ℤ) ^ k * a ^ k * K0

private theorem homogeneous_binary_eval₂_scaling
    {R : Type*} [CommRing R]
    (F : MvPolynomial (Fin 2) ℤ) (n : ℕ)
    (hF : ∀ μ ∈ F.support, μ 0 + μ 1 = n)
    (f : ℤ →+* R) (t x y : R) :
    MvPolynomial.eval₂ f ![t * x, t * y] F =
      t ^ n * MvPolynomial.eval₂ f ![x, y] F := by
  classical
  conv_lhs => rw [MvPolynomial.as_sum F]
  conv_rhs => rw [MvPolynomial.as_sum F]
  simp only [MvPolynomial.eval₂_sum, MvPolynomial.eval₂_monomial]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro μ hμ
  have hdeg := hF μ hμ
  simp [Finsupp.prod_fintype, Fin.prod_univ_two, mul_pow]
  have hp : t ^ μ 0 * t ^ μ 1 = t ^ n := by
    rw [← pow_add, hdeg]
  let z : ℤ := F.coeff μ
  change (z : R) * (t ^ μ 0 * x ^ μ 0 *
      (t ^ μ 1 * y ^ μ 1)) =
    t ^ n * ((z : R) * (x ^ μ 0 * y ^ μ 1))
  calc
    _ = (z : R) * (t ^ μ 0 * t ^ μ 1) *
          x ^ μ 0 * y ^ μ 1 := by ring
    _ = _ := by rw [hp]; ring

private theorem eval₂_C_X_self (F : MvPolynomial (Fin 2) ℤ) :
    MvPolynomial.eval₂ (MvPolynomial.C : ℤ →+* MvPolynomial (Fin 2) ℤ)
      ![MvPolynomial.X 0, MvPolynomial.X 1] F = F := by
  have hp :
      (⇑(RingHom.id (MvPolynomial (Fin 2) ℤ)) ∘ MvPolynomial.X) =
      ![MvPolynomial.X 0, MvPolynomial.X 1] := by
    funext i
    fin_cases i <;> rfl
  have h := MvPolynomial.eval₂Hom_X
      (c := (MvPolynomial.C : ℤ →+* MvPolynomial (Fin 2) ℤ))
      (f := RingHom.id (MvPolynomial (Fin 2) ℤ)) F
  rw [hp] at h
  simpa only [RingHom.id_apply] using h

private theorem eval₂_C_eval (F : MvPolynomial (Fin 2) ℤ)
    (x y : ℤ) :
    MvPolynomial.eval₂ (MvPolynomial.C : ℤ →+* MvPolynomial (Fin 2) ℤ)
      ![MvPolynomial.C x, MvPolynomial.C y] F =
        MvPolynomial.C (MvPolynomial.eval ![x, y] F) := by
  let g : MvPolynomial (Fin 2) ℤ →+* ℤ :=
    MvPolynomial.eval₂Hom (RingHom.id ℤ) ![x, y]
  let f : MvPolynomial (Fin 2) ℤ →+* MvPolynomial (Fin 2) ℤ :=
    MvPolynomial.C.comp g
  have hp : (⇑f ∘ MvPolynomial.X) =
      ![MvPolynomial.C x, MvPolynomial.C y] := by
    funext i
    fin_cases i <;> simp [f, g, Function.comp_def]
  have hg : g F = MvPolynomial.eval ![x, y] F := by
    rfl
  have h := MvPolynomial.eval₂Hom_X
      (c := (MvPolynomial.C : ℤ →+* MvPolynomial (Fin 2) ℤ))
      (f := f) F
  rw [hp] at h
  change _ = MvPolynomial.C (g F) at h
  simpa only [hg] using h

private theorem binary_eval₂_sub_dvd
    {R : Type*} [CommRing R]
    (F : MvPolynomial (Fin 2) ℤ) (f : ℤ →+* R)
    (m x y x' y' : R)
    (hx : m ∣ x - x') (hy : m ∣ y - y') :
    m ∣ MvPolynomial.eval₂ f ![x, y] F -
      MvPolynomial.eval₂ f ![x', y'] F := by
  classical
  conv_rhs => rw [MvPolynomial.as_sum F]
  conv_rhs => rw [MvPolynomial.as_sum F]
  simp only [MvPolynomial.eval₂_sum, ← Finset.sum_sub_distrib]
  apply Finset.dvd_sum
  intro μ hμ
  have hxp : m ∣ x ^ μ 0 - x' ^ μ 0 :=
    dvd_trans hx (sub_dvd_pow_sub_pow x x' (μ 0))
  have hyp : m ∣ y ^ μ 1 - y' ^ μ 1 :=
    dvd_trans hy (sub_dvd_pow_sub_pow y y' (μ 1))
  have hmon : m ∣ x ^ μ 0 * y ^ μ 1 -
      x' ^ μ 0 * y' ^ μ 1 := by
    have h₁ : m ∣ (x ^ μ 0 - x' ^ μ 0) * y ^ μ 1 :=
      dvd_mul_of_dvd_left hxp _
    have h₂ : m ∣ x' ^ μ 0 * (y ^ μ 1 - y' ^ μ 1) :=
      dvd_mul_of_dvd_right hyp _
    have heq : x ^ μ 0 * y ^ μ 1 - x' ^ μ 0 * y' ^ μ 1 =
      (x ^ μ 0 - x' ^ μ 0) * y ^ μ 1 +
        x' ^ μ 0 * (y ^ μ 1 - y' ^ μ 1) := by ring
    rw [heq]
    exact dvd_add h₁ h₂
  have hcoeff : m ∣
      f (MvPolynomial.coeff μ F) *
        (x ^ μ 0 * y ^ μ 1 - x' ^ μ 0 * y' ^ μ 1) :=
    dvd_mul_of_dvd_right hmon _
  simpa [MvPolynomial.eval₂_monomial, Finsupp.prod_fintype,
    Fin.prod_univ_two, mul_sub] using hcoeff

private theorem homogeneous_primitive_direction_factor
    (F : MvPolynomial (Fin 2) ℤ) (n : ℕ)
    (hF : ∀ μ ∈ F.support, μ 0 + μ 1 = n)
    (a b A B : ℤ) (hab : A * a + B * b = 1)
    (hroot : MvPolynomial.eval ![b, -a] F = 0) :
    (MvPolynomial.C a * MvPolynomial.X 0 +
      MvPolynomial.C b * MvPolynomial.X 1) ∣ F := by
  let X0 : MvPolynomial (Fin 2) ℤ := MvPolynomial.X 0
  let X1 : MvPolynomial (Fin 2) ℤ := MvPolynomial.X 1
  let L : MvPolynomial (Fin 2) ℤ :=
    MvPolynomial.C a * X0 + MvPolynomial.C b * X1
  let T : MvPolynomial (Fin 2) ℤ :=
    MvPolynomial.C B * X0 - MvPolynomial.C A * X1
  have habp : MvPolynomial.C A * MvPolynomial.C a +
      MvPolynomial.C B * MvPolynomial.C b =
      (1 : MvPolynomial (Fin 2) ℤ) := by
    calc
      _ = MvPolynomial.C (A * a + B * b) := by simp
      _ = 1 := by rw [hab]; simp
  have hxid : X0 = MvPolynomial.C A * L + MvPolynomial.C b * T := by
    calc
      X0 = (MvPolynomial.C A * MvPolynomial.C a +
          MvPolynomial.C B * MvPolynomial.C b) * X0 := by rw [habp]; ring
      _ = MvPolynomial.C A * L + MvPolynomial.C b * T := by
        dsimp [L, T]
        ring
  have hyid : X1 = MvPolynomial.C B * L - MvPolynomial.C a * T := by
    calc
      X1 = (MvPolynomial.C A * MvPolynomial.C a +
          MvPolynomial.C B * MvPolynomial.C b) * X1 := by rw [habp]; ring
      _ = MvPolynomial.C B * L - MvPolynomial.C a * T := by
        dsimp [L, T]
        ring
  have hx : L ∣ X0 - T * MvPolynomial.C b := by
    rw [hxid]
    refine ⟨MvPolynomial.C A, ?_⟩
    ring
  have hy : L ∣ X1 - T * (-MvPolynomial.C a) := by
    rw [hyid]
    refine ⟨MvPolynomial.C B, ?_⟩
    ring
  have hsub := binary_eval₂_sub_dvd F
    (MvPolynomial.C : ℤ →+* MvPolynomial (Fin 2) ℤ)
    L X0 X1 (T * MvPolynomial.C b) (T * (-MvPolynomial.C a)) hx hy
  have hsc := homogeneous_binary_eval₂_scaling F n hF
    (MvPolynomial.C : ℤ →+* MvPolynomial (Fin 2) ℤ)
    T (MvPolynomial.C b) (-MvPolynomial.C a)
  have hzero :
      MvPolynomial.eval₂
        (MvPolynomial.C : ℤ →+* MvPolynomial (Fin 2) ℤ)
        ![MvPolynomial.C b, -MvPolynomial.C a] F = 0 := by
    have hv := eval₂_C_eval F b (-a)
    simpa [hroot] using hv
  rw [hzero, mul_zero] at hsc
  rw [eval₂_C_X_self, hsc] at hsub
  simpa only [L, X0, X1, sub_zero] using hsub

private theorem level_nonzero_of_signed_evaluations
    (k : ℕ) (P Q : MvPolynomial (Fin 2) ℤ)
    (a b A B K0 : ℤ)
    (hP : ∀ μ ∈ P.support, μ 0 + μ 1 = k + 1)
    (hQ : ∀ μ ∈ Q.support, μ 0 + μ 1 = k + 1)
    (hab : A * a + B * b = 1)
    (hcoprime : ∀ F : MvPolynomial (Fin 2) ℚ,
      F ∣ MvPolynomial.map (Int.castRingHom ℚ) P →
      F ∣ MvPolynomial.map (Int.castRingHom ℚ) Q →
      IsUnit F)
    (hPeval : MvPolynomial.eval ![b, -a] P = b ^ k * K0)
    (hQeval : MvPolynomial.eval ![b, -a] Q =
      (-1 : ℤ) ^ k * a ^ k * K0) :
    K0 ≠ 0 := by
  intro hzero
  let L : MvPolynomial (Fin 2) ℤ :=
    MvPolynomial.C a * MvPolynomial.X 0 +
      MvPolynomial.C b * MvPolynomial.X 1
  have hPzero : MvPolynomial.eval ![b, -a] P = 0 := by
    rw [hPeval, hzero]
    ring
  have hQzero : MvPolynomial.eval ![b, -a] Q = 0 := by
    rw [hQeval, hzero]
    ring
  have hdP : L ∣ P := by
    exact homogeneous_primitive_direction_factor P (k + 1)
      hP a b A B hab hPzero
  have hdQ : L ∣ Q := by
    exact homogeneous_primitive_direction_factor Q (k + 1)
      hQ a b A B hab hQzero
  let Lq : MvPolynomial (Fin 2) ℚ :=
    MvPolynomial.map (Int.castRingHom ℚ) L
  have hdPq : Lq ∣ MvPolynomial.map (Int.castRingHom ℚ) P := by
    rcases hdP with ⟨T, hT⟩
    refine ⟨MvPolynomial.map (Int.castRingHom ℚ) T, ?_⟩
    rw [hT]
    simp [Lq, map_mul]
  have hdQq : Lq ∣ MvPolynomial.map (Int.castRingHom ℚ) Q := by
    rcases hdQ with ⟨T, hT⟩
    refine ⟨MvPolynomial.map (Int.castRingHom ℚ) T, ?_⟩
    rw [hT]
    simp [Lq, map_mul]
  obtain ⟨unit, hunit⟩ := hcoprime Lq hdPq hdQq
  have hone : Lq * (↑(unit⁻¹) : MvPolynomial (Fin 2) ℚ) = 1 := by
    rw [← hunit]
    simp
  have heval := congrArg (MvPolynomial.eval ![(0 : ℚ), (0 : ℚ)]) hone
  have h01 : (0 : ℚ) = 1 := by
    simpa [Lq, L] using heval
  exact zero_ne_one h01

private theorem original_graph_values
    (k : ℕ) (a b c d e u v P Q : ℤ)
    (hpure : e ^ k * P - d ^ k * Q =
      c * (a * d + b * e) ^ (2 * k + 1))
    (hgraph : P * u = Q * v)
    (hunit : e ^ k * v - d ^ k * u = 1) :
    P = c * (a * d + b * e) ^ (2 * k + 1) * v ∧
      Q = c * (a * d + b * e) ^ (2 * k + 1) * u := by
  constructor
  · linear_combination v * hpure - d ^ k * hgraph - P * hunit
  · linear_combination u * hpure - e ^ k * hgraph - Q * hunit

private theorem original_inverse_coordinates
    (a b A B d e : ℤ) (hab : A * a + B * b = 1) :
    d = A * (a * d + b * e) + b * (B * d - A * e) ∧
      e = B * (a * d + b * e) - a * (B * d - A * e) := by
  constructor
  · calc
      d = (A * a + B * b) * d := by rw [hab]; ring
      _ = A * (a * d + b * e) + b * (B * d - A * e) := by ring
  · calc
      e = (A * a + B * b) * e := by rw [hab]; ring
      _ = B * (a * d + b * e) - a * (B * d - A * e) := by ring

private theorem original_unit_bezout
    (k : ℕ) (hk : 1 ≤ k) (d e u v : ℤ)
    (hunit : e ^ k * v - d ^ k * u = 1) :
    (-d ^ (k - 1) * u) * d + (e ^ (k - 1) * v) * e = 1 := by
  have hd : d ^ (k - 1) * d = d ^ k := by
    rw [← pow_succ, Nat.sub_add_cancel hk]
  have he : e ^ (k - 1) * e = e ^ k := by
    rw [← pow_succ, Nat.sub_add_cancel hk]
  calc
    (-d ^ (k - 1) * u) * d + (e ^ (k - 1) * v) * e =
        e ^ k * v - d ^ k * u := by rw [← hd, ← he]; ring
    _ = 1 := hunit

private theorem original_level_coordinate_bezout
    (k : ℕ) (hk : 1 ≤ k) (a b A B d e u v : ℤ)
    (hab : A * a + B * b = 1)
    (hunit : e ^ k * v - d ^ k * u = 1) :
    ∃ r s : ℤ,
      r * (a * d + b * e) + s * (B * d - A * e) = 1 := by
  let r₀ : ℤ := -d ^ (k - 1) * u
  let s₀ : ℤ := e ^ (k - 1) * v
  have hprim : r₀ * d + s₀ * e = 1 :=
    original_unit_bezout k hk d e u v hunit
  obtain ⟨hd, he⟩ := original_inverse_coordinates a b A B d e hab
  refine ⟨r₀ * A + s₀ * B, r₀ * b - s₀ * a, ?_⟩
  calc
    (r₀ * A + s₀ * B) * (a * d + b * e) +
        (r₀ * b - s₀ * a) * (B * d - A * e) =
        r₀ * (A * (a * d + b * e) + b * (B * d - A * e)) +
          s₀ * (B * (a * d + b * e) - a * (B * d - A * e)) := by ring
    _ = r₀ * d + s₀ * e := by rw [← hd, ← he]
    _ = 1 := hprim

private theorem homogeneous_binary_eval_scaling
    (F : MvPolynomial (Fin 2) ℤ) (n : ℕ)
    (hF : ∀ μ ∈ F.support, μ 0 + μ 1 = n)
    (t x y : ℤ) :
    MvPolynomial.eval ![t * x, t * y] F =
      t ^ n * MvPolynomial.eval ![x, y] F := by
  classical
  conv_lhs => rw [MvPolynomial.as_sum F]
  conv_rhs => rw [MvPolynomial.as_sum F]
  simp only [MvPolynomial.eval_sum, MvPolynomial.eval_monomial]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro μ hμ
  have hdeg := hF μ hμ
  simp [Finsupp.prod_fintype, Fin.prod_univ_two, mul_pow]
  have hp : t ^ μ 0 * t ^ μ 1 = t ^ n := by
    rw [← pow_add, hdeg]
  calc
    _ = MvPolynomial.coeff μ F * (t ^ μ 0 * t ^ μ 1) *
          x ^ μ 0 * y ^ μ 1 := by ring
    _ = _ := by rw [hp]; ring

private theorem binary_eval_sub_dvd
    (F : MvPolynomial (Fin 2) ℤ)
    (m x y x' y' : ℤ)
    (hx : m ∣ x - x') (hy : m ∣ y - y') :
    m ∣ MvPolynomial.eval ![x, y] F -
      MvPolynomial.eval ![x', y'] F := by
  classical
  conv_rhs => rw [MvPolynomial.as_sum F]
  conv_rhs => rw [MvPolynomial.as_sum F]
  simp only [MvPolynomial.eval_sum, ← Finset.sum_sub_distrib]
  apply Finset.dvd_sum
  intro μ hμ
  have hxp : m ∣ x ^ μ 0 - x' ^ μ 0 :=
    dvd_trans hx (sub_dvd_pow_sub_pow x x' (μ 0))
  have hyp : m ∣ y ^ μ 1 - y' ^ μ 1 :=
    dvd_trans hy (sub_dvd_pow_sub_pow y y' (μ 1))
  have hmon : m ∣ x ^ μ 0 * y ^ μ 1 -
      x' ^ μ 0 * y' ^ μ 1 := by
    have h₁ : m ∣ (x ^ μ 0 - x' ^ μ 0) * y ^ μ 1 :=
      dvd_mul_of_dvd_left hxp _
    have h₂ : m ∣ x' ^ μ 0 * (y ^ μ 1 - y' ^ μ 1) :=
      dvd_mul_of_dvd_right hyp _
    have heq : x ^ μ 0 * y ^ μ 1 - x' ^ μ 0 * y' ^ μ 1 =
      (x ^ μ 0 - x' ^ μ 0) * y ^ μ 1 +
        x' ^ μ 0 * (y ^ μ 1 - y' ^ μ 1) := by ring
    rw [heq]
    exact dvd_add h₁ h₂
  have hcoeff : m ∣
      MvPolynomial.coeff μ F *
        (x ^ μ 0 * y ^ μ 1 - x' ^ μ 0 * y' ^ μ 1) :=
    dvd_mul_of_dvd_right hmon _
  simpa [MvPolynomial.eval_monomial, Finsupp.prod_fintype,
    Fin.prod_univ_two, mul_sub] using hcoeff

private theorem original_level_divides_of_signed_evaluations
    (k : ℕ) (hk : 1 ≤ k)
    (P Q : MvPolynomial (Fin 2) ℤ)
    (a b c A B K0 : ℤ) (d e u v : ℕ)
    (hP : ∀ μ ∈ P.support, μ 0 + μ 1 = k + 1)
    (hQ : ∀ μ ∈ Q.support, μ 0 + μ 1 = k + 1)
    (hab : A * a + B * b = 1)
    (hpure : MvPolynomial.X (1 : Fin 2) ^ k * P -
      MvPolynomial.X (0 : Fin 2) ^ k * Q =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ (2 * k + 1))
    (hunit : (e : ℤ) ^ k * (v : ℤ) -
      (d : ℤ) ^ k * (u : ℤ) = 1)
    (hgraph : MvPolynomial.eval ![(d : ℤ), (e : ℤ)] P * (u : ℤ) =
      MvPolynomial.eval ![(d : ℤ), (e : ℤ)] Q * (v : ℤ))
    (hPeval : MvPolynomial.eval ![b, -a] P = b ^ k * K0)
    (hQeval : MvPolynomial.eval ![b, -a] Q =
      (-1 : ℤ) ^ k * a ^ k * K0) :
    (a * (d : ℤ) + b * (e : ℤ)) ∣ K0 := by
  let m : ℤ := a * (d : ℤ) + b * (e : ℤ)
  let t : ℤ := B * (d : ℤ) - A * (e : ℤ)
  let P0 : ℤ := MvPolynomial.eval ![(d : ℤ), (e : ℤ)] P
  let Q0 : ℤ := MvPolynomial.eval ![(d : ℤ), (e : ℤ)] Q
  have hpeq := congrArg (MvPolynomial.eval ![(d : ℤ), (e : ℤ)]) hpure
  have hpuree :
      (e : ℤ) ^ k * P0 - (d : ℤ) ^ k * Q0 =
        c * m ^ (2 * k + 1) := by
    simpa [P0, Q0, m] using hpeq
  obtain ⟨hP0, hQ0⟩ :=
    original_graph_values k a b c (d : ℤ) (e : ℤ) (u : ℤ) (v : ℤ)
      P0 Q0 hpuree hgraph hunit
  have hdivP : m ∣ P0 := by
    rw [hP0]
    refine ⟨c * m ^ (2 * k) * (v : ℤ), ?_⟩
    rw [pow_succ]
    ring
  have hdivQ : m ∣ Q0 := by
    rw [hQ0]
    refine ⟨c * m ^ (2 * k) * (u : ℤ), ?_⟩
    rw [pow_succ]
    ring
  obtain ⟨hdid, heid⟩ :=
    original_inverse_coordinates a b A B (d : ℤ) (e : ℤ) hab
  have hx : m ∣ (d : ℤ) - t * b := by
    change m ∣ (d : ℤ) - t * b
    rw [hdid]
    refine ⟨A, ?_⟩
    dsimp [m, t]
    ring
  have hy : m ∣ (e : ℤ) - t * (-a) := by
    rw [heid]
    refine ⟨B, ?_⟩
    dsimp [m, t]
    ring
  have hmodP := binary_eval_sub_dvd P m (d : ℤ) (e : ℤ)
    (t * b) (t * (-a)) hx hy
  have hmodQ := binary_eval_sub_dvd Q m (d : ℤ) (e : ℤ)
    (t * b) (t * (-a)) hx hy
  have hscaleP := homogeneous_binary_eval_scaling P (k + 1)
    hP t b (-a)
  have hscaleQ := homogeneous_binary_eval_scaling Q (k + 1)
    hQ t b (-a)
  rw [hscaleP, hPeval] at hmodP
  rw [hscaleQ, hQeval] at hmodQ
  have hbp : m ∣ t ^ (k + 1) * (b ^ k * K0) := by
    have hh := dvd_sub hdivP hmodP
    have heq : P0 - (P0 - t ^ (k + 1) * (b ^ k * K0)) =
      t ^ (k + 1) * (b ^ k * K0) := by ring
    rw [heq] at hh
    exact hh
  have hqsign : m ∣ t ^ (k + 1) * ((-a) ^ k * K0) := by
    have hh := dvd_sub hdivQ hmodQ
    have hsign : (-1 : ℤ) ^ k * a ^ k = (-a) ^ k := by
      calc
        _ = ((-1 : ℤ) * a) ^ k := by rw [mul_pow]
        _ = (-a) ^ k := by congr 1; ring
    have heq : Q0 - (Q0 - t ^ (k + 1) *
        ((-1 : ℤ) ^ k * a ^ k * K0)) =
      t ^ (k + 1) * ((-a) ^ k * K0) := by rw [← hsign]; ring
    rw [heq] at hh
    exact hh
  obtain ⟨r, s, hrs⟩ :=
    original_level_coordinate_bezout k hk a b A B
      (d : ℤ) (e : ℤ) (u : ℤ) (v : ℤ) hab hunit
  have hcopmt : IsCoprime m t := ⟨r, s, hrs⟩
  have hpowmt : IsCoprime m (t ^ (k + 1)) := hcopmt.pow_right
  have hbb : m ∣ b ^ k * K0 :=
    hpowmt.dvd_of_dvd_mul_left hbp
  have haa : m ∣ (-a) ^ k * K0 :=
    hpowmt.dvd_of_dvd_mul_left hqsign
  have hcopba : IsCoprime b (-a) := by
    refine ⟨B, -A, ?_⟩
    linear_combination hab
  obtain ⟨R, S, hRS⟩ := hcopba.pow (m := k) (n := k)
  have hsum : m ∣ (R * b ^ k + S * (-a) ^ k) * K0 := by
    have h₁ : m ∣ R * (b ^ k * K0) :=
      dvd_mul_of_dvd_right hbb R
    have h₂ : m ∣ S * ((-a) ^ k * K0) :=
      dvd_mul_of_dvd_right haa S
    have heq : (R * b ^ k + S * (-a) ^ k) * K0 =
      R * (b ^ k * K0) + S * ((-a) ^ k * K0) := by ring
    rw [heq]
    exact dvd_add h₁ h₂
  rw [hRS] at hsum
  simpa [m] using hsum

private theorem original_algebra_of_signed_evaluations
    (k : ℕ) (hk : 2 ≤ k)
    (P Q : MvPolynomial (Fin 2) ℤ)
    (a b c A B K0 : ℤ) (d e u v : ℕ)
    (hP : ∀ μ ∈ P.support, μ 0 + μ 1 = k + 1)
    (hQ : ∀ μ ∈ Q.support, μ 0 + μ 1 = k + 1)
    (hcoprime : ∀ F : MvPolynomial (Fin 2) ℚ,
      F ∣ MvPolynomial.map (Int.castRingHom ℚ) P →
      F ∣ MvPolynomial.map (Int.castRingHom ℚ) Q →
      IsUnit F)
    (hab : A * a + B * b = 1)
    (hpure : MvPolynomial.X (1 : Fin 2) ^ k * P -
      MvPolynomial.X (0 : Fin 2) ^ k * Q =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ (2 * k + 1))
    (hunit : (e : ℤ) ^ k * (v : ℤ) -
      (d : ℤ) ^ k * (u : ℤ) = 1)
    (hgraph : MvPolynomial.eval ![(d : ℤ), (e : ℤ)] P * (u : ℤ) =
      MvPolynomial.eval ![(d : ℤ), (e : ℤ)] Q * (v : ℤ))
    (hPeval : MvPolynomial.eval ![b, -a] P = b ^ k * K0)
    (hQeval : MvPolynomial.eval ![b, -a] Q =
      (-1 : ℤ) ^ k * a ^ k * K0) :
    K0 ≠ 0 ∧
      a * (d : ℤ) + b * (e : ℤ) ≠ 0 ∧
      a * (d : ℤ) + b * (e : ℤ) ∣ K0 := by
  have hK : K0 ≠ 0 :=
    level_nonzero_of_signed_evaluations k P Q a b A B K0
      hP hQ hab hcoprime hPeval hQeval
  have hdiv : a * (d : ℤ) + b * (e : ℤ) ∣ K0 :=
    original_level_divides_of_signed_evaluations k
      (by omega) P Q a b c A B K0 d e u v
      hP hQ hab hpure hunit hgraph hPeval hQeval
  have hm : a * (d : ℤ) + b * (e : ℤ) ≠ 0 := by
    intro hz
    have hzero : (0 : ℤ) ∣ K0 := by simpa [hz] using hdiv
    rcases hzero with ⟨z, hz'⟩
    exact hK (by simpa using hz')
  exact ⟨hK, hm, hdiv⟩

private theorem linear_pow_explicit (a b : ℤ) (N : ℕ) :
    (MvPolynomial.C a * MvPolynomial.X (0 : Fin 2) +
      MvPolynomial.C b * MvPolynomial.X (1 : Fin 2)) ^ N =
      ∑ j ∈ Finset.range (N + 1),
        MvPolynomial.C ((Nat.choose N j : ℤ) * a ^ j * b ^ (N - j)) *
          MvPolynomial.X 0 ^ j * MvPolynomial.X 1 ^ (N - j) := by
  rw [add_pow]
  apply Finset.sum_congr rfl
  intro j hj
  simp only [mul_pow, map_pow, map_mul]
  have hc : ((N.choose j : ℕ) : MvPolynomial (Fin 2) ℤ) =
      MvPolynomial.C (N.choose j : ℤ) := by simp
  rw [hc]
  ring

private noncomputable def binMono (i j : ℕ) : Fin 2 →₀ ℕ :=
  Finsupp.single 0 i + Finsupp.single 1 j

private theorem binary_monomial_mixed (r : ℤ) (i j : ℕ) :
    MvPolynomial.monomial (binMono i j) r =
      MvPolynomial.C r * MvPolynomial.X (0 : Fin 2) ^ i *
        MvPolynomial.X (1 : Fin 2) ^ j := by
  dsimp [binMono]
  calc
    _ = MvPolynomial.monomial (Finsupp.single (0 : Fin 2) i) r *
        MvPolynomial.monomial (Finsupp.single (1 : Fin 2) j) (1 : ℤ) := by
      rw [MvPolynomial.monomial_mul]
      simp
    _ = _ := by
      rw [← MvPolynomial.C_mul_X_pow_eq_monomial,
        ← MvPolynomial.C_mul_X_pow_eq_monomial]
      simp [mul_assoc]

private theorem coeff_linear_pow (a b : ℤ) (N j : ℕ)
    (hj : j ≤ N) :
    MvPolynomial.coeff (binMono j (N - j))
      ((MvPolynomial.C a * MvPolynomial.X (0 : Fin 2) +
        MvPolynomial.C b * MvPolynomial.X (1 : Fin 2)) ^ N) =
      (Nat.choose N j : ℤ) * a ^ j * b ^ (N - j) := by
  classical
  rw [linear_pow_explicit]
  have hcoeffsum (ss : Finset ℕ)
      (f : ℕ → MvPolynomial (Fin 2) ℤ)
      (μ : Fin 2 →₀ ℕ) :
      MvPolynomial.coeff μ (∑ i ∈ ss, f i) =
        ∑ i ∈ ss, MvPolynomial.coeff μ (f i) := by
    induction ss using Finset.induction_on with
    | empty => simp
    | @insert i ss hi ih =>
      simp [Finset.sum_insert hi, MvPolynomial.coeff_add, ih]
  rw [hcoeffsum]
  have hmono : ∀ i : ℕ,
      binMono i (N - i) = binMono j (N - j) ↔ i = j := by
    intro i
    constructor
    · intro h
      have h0 := congrArg (fun μ : Fin 2 →₀ ℕ => μ 0) h
      simpa [binMono, Finsupp.add_apply] using h0
    · intro h
      subst i
      rfl
  simp only [← binary_monomial_mixed, MvPolynomial.coeff_monomial]
  simp [hmono, hj]

private theorem homogeneous_binary_explicit
    (F : MvPolynomial (Fin 2) ℤ) (n : ℕ)
    (hF : ∀ μ ∈ F.support, μ 0 + μ 1 = n) :
    F = ∑ j ∈ Finset.range (n + 1),
      MvPolynomial.C (F.coeff (binMono j (n - j))) *
        MvPolynomial.X 0 ^ j * MvPolynomial.X 1 ^ (n - j) := by
  classical
  ext μ
  have hcoeffsum (ss : Finset ℕ)
      (f : ℕ → MvPolynomial (Fin 2) ℤ) :
      MvPolynomial.coeff μ (∑ i ∈ ss, f i) =
        ∑ i ∈ ss, MvPolynomial.coeff μ (f i) := by
    induction ss using Finset.induction_on with
    | empty => simp
    | @insert i ss hi ih =>
      simp [Finset.sum_insert hi, MvPolynomial.coeff_add, ih]
  rw [hcoeffsum]
  simp only [← binary_monomial_mixed, MvPolynomial.coeff_monomial]
  by_cases hdeg : μ 0 + μ 1 = n
  · have hj : μ 0 ≤ n := by omega
    have hμ : binMono (μ 0) (n - μ 0) = μ := by
      ext i
      fin_cases i
      · simp [binMono]
      · simp [binMono, Finsupp.add_apply]
        omega
    have hiff (j : ℕ) :
        binMono j (n - j) = μ ↔ j = μ 0 := by
      constructor
      · intro h
        have h0 := congrArg (fun z : Fin 2 →₀ ℕ => z 0) h
        simpa [binMono, Finsupp.add_apply] using h0
      · intro h
        subst j
        exact hμ
    simp [hiff, hj, hμ]
  · have hz : F.coeff μ = 0 := by
      by_contra hne
      exact hdeg (hF μ (by simpa using hne))
    rw [hz]
    have hnom (j : ℕ) (hj : j ∈ Finset.range (n + 1)) :
        binMono j (n - j) ≠ μ := by
      intro heq
      have h0 := congrArg (fun z : Fin 2 →₀ ℕ => z 0) heq
      have h1 := congrArg (fun z : Fin 2 →₀ ℕ => z 1) heq
      have hjle : j ≤ n := by simpa using hj
      simp [binMono, Finsupp.add_apply] at h0 h1
      omega
    symm
    apply Finset.sum_eq_zero
    intro j hj
    simp [hnom j hj]

private theorem coeff_sum_binary (ss : Finset ℕ)
    (f : ℕ → MvPolynomial (Fin 2) ℤ) (μ : Fin 2 →₀ ℕ) :
    MvPolynomial.coeff μ (∑ i ∈ ss, f i) =
      ∑ i ∈ ss, MvPolynomial.coeff μ (f i) := by
  classical
  induction ss using Finset.induction_on with
  | empty => simp
  | @insert i ss hi ih =>
    simp [Finset.sum_insert hi, MvPolynomial.coeff_add, ih]

private theorem ypow_homogeneous_explicit
    (F : MvPolynomial (Fin 2) ℤ) (n k : ℕ)
    (hF : ∀ μ ∈ F.support, μ 0 + μ 1 = n) :
    MvPolynomial.X (1 : Fin 2) ^ k * F =
      ∑ i ∈ Finset.range (n + 1),
        MvPolynomial.C (F.coeff (binMono i (n - i))) *
          MvPolynomial.X 0 ^ i * MvPolynomial.X 1 ^ (k + n - i) := by
  conv_lhs => rw [homogeneous_binary_explicit F n hF]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  have hi' : i ≤ n := by simpa using hi
  have hexp : k + (n - i) = k + n - i := by omega
  calc
    MvPolynomial.X (1 : Fin 2) ^ k *
        (MvPolynomial.C (F.coeff (binMono i (n - i))) *
          MvPolynomial.X 0 ^ i * MvPolynomial.X 1 ^ (n - i)) =
        MvPolynomial.C (F.coeff (binMono i (n - i))) *
          MvPolynomial.X 0 ^ i * MvPolynomial.X 1 ^ (k + (n - i)) := by
          simp only [pow_add]
          ring
    _ = _ := by rw [hexp]

private theorem xpow_homogeneous_explicit
    (F : MvPolynomial (Fin 2) ℤ) (n k : ℕ)
    (hF : ∀ μ ∈ F.support, μ 0 + μ 1 = n) :
    MvPolynomial.X (0 : Fin 2) ^ k * F =
      ∑ i ∈ Finset.range (n + 1),
        MvPolynomial.C (F.coeff (binMono i (n - i))) *
          MvPolynomial.X 0 ^ (k + i) * MvPolynomial.X 1 ^ (n - i) := by
  conv_lhs => rw [homogeneous_binary_explicit F n hF]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  calc
    MvPolynomial.X (0 : Fin 2) ^ k *
        (MvPolynomial.C (F.coeff (binMono i (n - i))) *
          MvPolynomial.X 0 ^ i * MvPolynomial.X 1 ^ (n - i)) =
        MvPolynomial.C (F.coeff (binMono i (n - i))) *
          MvPolynomial.X 0 ^ (k + i) * MvPolynomial.X 1 ^ (n - i) := by
          simp only [pow_add]
          ring

private theorem coeff_ypow_homogeneous
    (F : MvPolynomial (Fin 2) ℤ) (n k j : ℕ)
    (hF : ∀ μ ∈ F.support, μ 0 + μ 1 = n)
    (hj : j ≤ n) :
    MvPolynomial.coeff (binMono j (k + n - j))
      (MvPolynomial.X (1 : Fin 2) ^ k * F) =
      F.coeff (binMono j (n - j)) := by
  classical
  rw [ypow_homogeneous_explicit F n k hF, coeff_sum_binary]
  simp only [← binary_monomial_mixed, MvPolynomial.coeff_monomial]
  have hmono : ∀ i : ℕ,
      binMono i (k + n - i) = binMono j (k + n - j) ↔ i = j := by
    intro i
    constructor
    · intro h
      have h0 := congrArg (fun μ : Fin 2 →₀ ℕ => μ 0) h
      simpa [binMono, Finsupp.add_apply] using h0
    · intro h
      subst i
      rfl
  simp [hmono, hj]

private theorem coeff_xpow_homogeneous_zero
    (F : MvPolynomial (Fin 2) ℤ) (n k j : ℕ)
    (hF : ∀ μ ∈ F.support, μ 0 + μ 1 = n)
    (hj : j < k) :
    MvPolynomial.coeff (binMono j (k + n - j))
      (MvPolynomial.X (0 : Fin 2) ^ k * F) = 0 := by
  classical
  rw [xpow_homogeneous_explicit F n k hF, coeff_sum_binary]
  apply Finset.sum_eq_zero
  intro i hi
  rw [← binary_monomial_mixed, MvPolynomial.coeff_monomial]
  have hneq : binMono (k + i) (n - i) ≠
      binMono j (k + n - j) := by
    intro h
    have h0 := congrArg (fun μ : Fin 2 →₀ ℕ => μ 0) h
    have hx : k + i = j := by
      simpa [binMono, Finsupp.add_apply] using h0
    omega
  simp [hneq]

private theorem coeff_xpow_homogeneous_at_k
    (F : MvPolynomial (Fin 2) ℤ) (n k : ℕ)
    (hF : ∀ μ ∈ F.support, μ 0 + μ 1 = n) :
    MvPolynomial.coeff (binMono k n)
      (MvPolynomial.X (0 : Fin 2) ^ k * F) =
      F.coeff (binMono 0 n) := by
  classical
  rw [xpow_homogeneous_explicit F n k hF, coeff_sum_binary]
  simp only [← binary_monomial_mixed, MvPolynomial.coeff_monomial]
  have hmono : ∀ i : ℕ,
      binMono (k + i) (n - i) = binMono k n ↔ i = 0 := by
    intro i
    constructor
    · intro h
      have h0 := congrArg (fun μ : Fin 2 →₀ ℕ => μ 0) h
      have hx : k + i = k := by
        simpa [binMono, Finsupp.add_apply] using h0
      omega
    · intro h
      subst i
      simp
  simp [hmono]

private theorem coeff_c_linear_pow
    (a b c : ℤ) (N j : ℕ) (hj : j ≤ N) :
    MvPolynomial.coeff (binMono j (N - j))
      (MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X (0 : Fin 2) +
          MvPolynomial.C b * MvPolynomial.X (1 : Fin 2)) ^ N) =
      c * (Nat.choose N j : ℤ) * a ^ j * b ^ (N - j) := by
  classical
  conv_lhs => rw [linear_pow_explicit a b N]
  rw [Finset.mul_sum, coeff_sum_binary]
  have hmono : ∀ i : ℕ,
      binMono i (N - i) = binMono j (N - j) ↔ i = j := by
    intro i
    constructor
    · intro h
      have h0 := congrArg (fun μ : Fin 2 →₀ ℕ => μ 0) h
      simpa [binMono, Finsupp.add_apply] using h0
    · intro h
      subst i
      rfl
  have hsummand (i : ℕ) :
      MvPolynomial.C c *
        (MvPolynomial.C ((Nat.choose N i : ℤ) * a ^ i * b ^ (N - i)) *
          MvPolynomial.X 0 ^ i * MvPolynomial.X 1 ^ (N - i)) =
      MvPolynomial.monomial (binMono i (N - i))
        (c * (Nat.choose N i : ℤ) * a ^ i * b ^ (N - i)) := by
    rw [binary_monomial_mixed]
    simp only [map_mul]
    ring
  simp only [hsummand, MvPolynomial.coeff_monomial]
  simp [hmono, hj]

private theorem pure_low_coeff
    (k : ℕ) (P Q : MvPolynomial (Fin 2) ℤ)
    (a b c : ℤ)
    (hP : ∀ μ ∈ P.support, μ 0 + μ 1 = k + 1)
    (hQ : ∀ μ ∈ Q.support, μ 0 + μ 1 = k + 1)
    (hpure : MvPolynomial.X (1 : Fin 2) ^ k * P -
      MvPolynomial.X (0 : Fin 2) ^ k * Q =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ (2 * k + 1))
    (j : ℕ) (hj : j < k) :
    P.coeff (binMono j (k + 1 - j)) =
      c * (Nat.choose (2 * k + 1) j : ℤ) *
        a ^ j * b ^ (2 * k + 1 - j) := by
  let μ := binMono j (2 * k + 1 - j)
  have hindex : k + (k + 1) - j = 2 * k + 1 - j := by omega
  have hleft : MvPolynomial.coeff μ
      (MvPolynomial.X (1 : Fin 2) ^ k * P) =
      P.coeff (binMono j (k + 1 - j)) := by
    simpa only [μ, hindex] using
      coeff_ypow_homogeneous P (k + 1) k j hP (by omega)
  have hright : MvPolynomial.coeff μ
      (MvPolynomial.X (0 : Fin 2) ^ k * Q) = 0 := by
    simpa only [μ, hindex] using
      coeff_xpow_homogeneous_zero Q (k + 1) k j hQ hj
  have hrhs : MvPolynomial.coeff μ
      (MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ (2 * k + 1)) =
      c * (Nat.choose (2 * k + 1) j : ℤ) *
        a ^ j * b ^ (2 * k + 1 - j) := by
    exact coeff_c_linear_pow a b c (2 * k + 1) j (by omega)
  have h := congrArg (MvPolynomial.coeff μ) hpure
  rw [MvPolynomial.coeff_sub, hleft, hright, sub_zero, hrhs] at h
  exact h

private theorem pure_q0_coeff
    (k : ℕ) (P Q : MvPolynomial (Fin 2) ℤ)
    (a b c : ℤ)
    (hP : ∀ μ ∈ P.support, μ 0 + μ 1 = k + 1)
    (hQ : ∀ μ ∈ Q.support, μ 0 + μ 1 = k + 1)
    (hpure : MvPolynomial.X (1 : Fin 2) ^ k * P -
      MvPolynomial.X (0 : Fin 2) ^ k * Q =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ (2 * k + 1)) :
    P.coeff (binMono k 1) - Q.coeff (binMono 0 (k + 1)) =
      c * (Nat.choose (2 * k + 1) k : ℤ) *
        a ^ k * b ^ (k + 1) := by
  let μ := binMono k (k + 1)
  have hindex : k + (k + 1) - k = k + 1 := by omega
  have hleft : MvPolynomial.coeff μ
      (MvPolynomial.X (1 : Fin 2) ^ k * P) =
      P.coeff (binMono k 1) := by
    simpa only [μ, hindex, show k + 1 - k = 1 by omega] using
      coeff_ypow_homogeneous P (k + 1) k k hP (by omega)
  have hright : MvPolynomial.coeff μ
      (MvPolynomial.X (0 : Fin 2) ^ k * Q) =
      Q.coeff (binMono 0 (k + 1)) := by
    simpa only [μ] using
      coeff_xpow_homogeneous_at_k Q (k + 1) k hQ
  have hrhs : MvPolynomial.coeff μ
      (MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ (2 * k + 1)) =
      c * (Nat.choose (2 * k + 1) k : ℤ) *
        a ^ k * b ^ (k + 1) := by
    have hdiff : 2 * k + 1 - k = k + 1 := by omega
    simpa only [μ, hdiff] using
      coeff_c_linear_pow a b c (2 * k + 1) k (by omega)
  have h := congrArg (MvPolynomial.coeff μ) hpure
  rw [MvPolynomial.coeff_sub, hleft, hright, hrhs] at h
  exact h

private theorem homogeneous_binary_eval_explicit
    (F : MvPolynomial (Fin 2) ℤ) (n : ℕ)
    (hF : ∀ μ ∈ F.support, μ 0 + μ 1 = n)
    (x y : ℤ) :
    MvPolynomial.eval ![x, y] F =
      ∑ j ∈ Finset.range (n + 1),
        F.coeff (binMono j (n - j)) * x ^ j * y ^ (n - j) := by
  conv_lhs => rw [homogeneous_binary_explicit F n hF]
  simp [MvPolynomial.eval_sum, mul_assoc]

private theorem alternating_partial (N n : ℕ) :
    (∑ j ∈ Finset.range (n + 1),
      (-1 : ℤ)^j * (Nat.choose (N + 1) j : ℤ)) =
      (-1 : ℤ)^n * (Nat.choose N n : ℤ) := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [Finset.sum_range_succ, ih, Nat.choose_succ_succ, Nat.cast_add]
      rw [pow_succ]
      ring

private theorem neg_one_pow_self (n : ℕ) :
    (-1 : ℤ)^n * (-1 : ℤ)^n = 1 := by
  rw [← pow_add, show n + n = 2 * n by omega, pow_mul]
  norm_num

private theorem alternating_variant (k : ℕ) (hk : 1 ≤ k) :
    (∑ j ∈ Finset.range k,
      (-1 : ℤ) ^ (k + 1 - j) *
        (Nat.choose (2 * k + 1) j : ℤ)) =
      (Nat.choose (2 * k) (k - 1) : ℤ) := by
  have hpar (j : ℕ) (hj : j < k) :
      (-1 : ℤ) ^ (k + 1 - j) =
        (-1 : ℤ) ^ (k - 1) * (-1 : ℤ) ^ j := by
    have hsum : k + 1 - j + j = k + 1 := by omega
    have hbase : k + 1 = (k - 1) + 2 := by omega
    have hprod :
        (-1 : ℤ) ^ (k + 1 - j) * (-1 : ℤ) ^ j =
          (-1 : ℤ) ^ (k - 1) := by
      rw [← pow_add, hsum, hbase, pow_add]
      norm_num
    calc
      (-1 : ℤ) ^ (k + 1 - j) =
          (-1 : ℤ) ^ (k + 1 - j) * 1 := by ring
      _ = (-1 : ℤ) ^ (k + 1 - j) *
            ((-1 : ℤ) ^ j * (-1 : ℤ) ^ j) := by
              rw [neg_one_pow_self]
      _ = (-1 : ℤ) ^ (k - 1) * (-1 : ℤ) ^ j := by
            rw [← mul_assoc, hprod]
  have hrange : k - 1 + 1 = k := by omega
  have hpart := alternating_partial (2 * k) (k - 1)
  rw [hrange] at hpart
  calc
    (∑ j ∈ Finset.range k,
        (-1 : ℤ) ^ (k + 1 - j) *
          (Nat.choose (2 * k + 1) j : ℤ)) =
        (-1 : ℤ) ^ (k - 1) *
          (∑ j ∈ Finset.range k,
            (-1 : ℤ)^j * (Nat.choose (2 * k + 1) j : ℤ)) := by
              rw [Finset.mul_sum]
              apply Finset.sum_congr rfl
              intro j hj
              rw [hpar j (by simpa using hj)]
              ring
    _ = (-1 : ℤ) ^ (k - 1) *
        ((-1 : ℤ) ^ (k - 1) *
          (Nat.choose (2 * k) (k - 1) : ℤ)) := by rw [hpart]
    _ = (Nat.choose (2 * k) (k - 1) : ℤ) := by
          rw [← mul_assoc, neg_one_pow_self, one_mul]

private theorem pure_P_signed_eval
    (k : ℕ) (hk : 2 ≤ k)
    (P Q : MvPolynomial (Fin 2) ℤ) (a b c : ℤ)
    (hP : ∀ μ ∈ P.support, μ 0 + μ 1 = k + 1)
    (hQ : ∀ μ ∈ Q.support, μ 0 + μ 1 = k + 1)
    (hpure : MvPolynomial.X (1 : Fin 2) ^ k * P -
      MvPolynomial.X (0 : Fin 2) ^ k * Q =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ (2 * k + 1)) :
    MvPolynomial.eval ![b, -a] P =
      b ^ k * (b * P.coeff (binMono (k + 1) 0) -
        a * P.coeff (binMono k 1) +
        (Nat.choose (2 * k) (k - 1) : ℤ) *
          c * a ^ (k + 1) * b ^ (k + 1)) := by
  let f : ℕ → ℤ := fun j =>
    P.coeff (binMono j (k + 1 - j)) *
      b ^ j * (-a) ^ (k + 1 - j)
  have hterm (j : ℕ) (hj : j < k) :
      f j =
        c * a ^ (k + 1) * b ^ (2 * k + 1) *
          ((-1 : ℤ) ^ (k + 1 - j) *
            (Nat.choose (2 * k + 1) j : ℤ)) := by
    dsimp [f]
    rw [pure_low_coeff k P Q a b c hP hQ hpure j hj]
    have hneg : (-a) ^ (k + 1 - j) =
        (-1 : ℤ) ^ (k + 1 - j) * a ^ (k + 1 - j) := by
      calc
        _ = ((-1 : ℤ) * a) ^ (k + 1 - j) := by congr 1; ring
        _ = _ := by rw [mul_pow]
    rw [hneg]
    have ha : a ^ j * a ^ (k + 1 - j) = a ^ (k + 1) := by
      rw [← pow_add, show j + (k + 1 - j) = k + 1 by omega]
    have hb : b ^ (2 * k + 1 - j) * b ^ j = b ^ (2 * k + 1) := by
      rw [← pow_add, show 2 * k + 1 - j + j = 2 * k + 1 by omega]
    calc
      _ = c * (a ^ j * a ^ (k + 1 - j)) *
          (b ^ (2 * k + 1 - j) * b ^ j) *
          ((-1 : ℤ) ^ (k + 1 - j) *
            (Nat.choose (2 * k + 1) j : ℤ)) := by ring
      _ = _ := by rw [ha, hb]
  have hlow :
      (∑ j ∈ Finset.range k, f j) =
        c * a ^ (k + 1) * b ^ (2 * k + 1) *
          (Nat.choose (2 * k) (k - 1) : ℤ) := by
    calc
      _ = ∑ j ∈ Finset.range k,
            c * a ^ (k + 1) * b ^ (2 * k + 1) *
              ((-1 : ℤ) ^ (k + 1 - j) *
                (Nat.choose (2 * k + 1) j : ℤ)) := by
          apply Finset.sum_congr rfl
          intro j hj
          exact hterm j (by simpa using hj)
      _ = c * a ^ (k + 1) * b ^ (2 * k + 1) *
          (∑ j ∈ Finset.range k,
            (-1 : ℤ) ^ (k + 1 - j) *
              (Nat.choose (2 * k + 1) j : ℤ)) := by rw [Finset.mul_sum]
      _ = _ := by rw [alternating_variant k (by omega)]
  have hEval := homogeneous_binary_eval_explicit P (k + 1) hP b (-a)
  have hsplit :
      (∑ j ∈ Finset.range (k + 1 + 1), f j) =
        (∑ j ∈ Finset.range k, f j) +
          f k + f (k + 1) := by
    rw [Finset.sum_range_succ, Finset.sum_range_succ]
  have hEval' : MvPolynomial.eval ![b, -a] P =
      (∑ j ∈ Finset.range k, f j) + f k + f (k + 1) := by
    rw [hEval]
    exact hsplit
  have hbpow : b ^ (2 * k + 1) = b ^ k * b ^ (k + 1) := by
    rw [show 2 * k + 1 = k + (k + 1) by omega, pow_add]
  calc
    MvPolynomial.eval ![b, -a] P =
      (∑ j ∈ Finset.range k, f j) + f k + f (k + 1) := hEval'
    _ = b ^ k * (b * P.coeff (binMono (k + 1) 0) -
        a * P.coeff (binMono k 1) +
        (Nat.choose (2 * k) (k - 1) : ℤ) *
          c * a ^ (k + 1) * b ^ (k + 1)) := by
      rw [hlow, hbpow]
      simp [f, show k + 1 - k = 1 by omega]
      ring

private theorem homogeneous_eval_x_zero
    (F : MvPolynomial (Fin 2) ℤ) (n : ℕ)
    (hF : ∀ μ ∈ F.support, μ 0 + μ 1 = n)
    (y : ℤ) :
    MvPolynomial.eval ![(0 : ℤ), y] F =
      F.coeff (binMono 0 n) * y ^ n := by
  rw [homogeneous_binary_eval_explicit F n hF 0 y]
  calc
    (∑ j ∈ Finset.range (n + 1),
      F.coeff (binMono j (n - j)) * (0 : ℤ) ^ j * y ^ (n - j)) =
        F.coeff (binMono 0 (n - 0)) * (0 : ℤ) ^ 0 * y ^ (n - 0) := by
          apply Finset.sum_eq_single 0
          · intro j hj hj0
            have hjpos : 0 < j := Nat.pos_of_ne_zero hj0
            simp [hj0]
          · intro hzero
            exact False.elim (hzero (by simp))
    _ = _ := by simp

private theorem pure_Q_signed_eval
    (k : ℕ) (hk : 2 ≤ k)
    (P Q : MvPolynomial (Fin 2) ℤ) (a b c : ℤ)
    (hP : ∀ μ ∈ P.support, μ 0 + μ 1 = k + 1)
    (hQ : ∀ μ ∈ Q.support, μ 0 + μ 1 = k + 1)
    (hpure : MvPolynomial.X (1 : Fin 2) ^ k * P -
      MvPolynomial.X (0 : Fin 2) ^ k * Q =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ (2 * k + 1)) :
    MvPolynomial.eval ![b, -a] Q =
      (-1 : ℤ) ^ k * a ^ k *
        (b * P.coeff (binMono (k + 1) 0) -
          a * P.coeff (binMono k 1) +
          (Nat.choose (2 * k) (k - 1) : ℤ) *
            c * a ^ (k + 1) * b ^ (k + 1)) := by
  let K : ℤ := b * P.coeff (binMono (k + 1) 0) -
    a * P.coeff (binMono k 1) +
    (Nat.choose (2 * k) (k - 1) : ℤ) *
      c * a ^ (k + 1) * b ^ (k + 1)
  have hPeval : MvPolynomial.eval ![b, -a] P = b ^ k * K := by
    exact pure_P_signed_eval k hk P Q a b c hP hQ hpure
  have hneg : (-a) ^ k = (-1 : ℤ) ^ k * a ^ k := by
    calc
      _ = ((-1 : ℤ) * a) ^ k := by congr 1; ring
      _ = _ := by rw [mul_pow]
  by_cases hb : b = 0
  · have hq0 : Q.coeff (binMono 0 (k + 1)) =
        P.coeff (binMono k 1) := by
      have h := pure_q0_coeff k P Q a b c hP hQ hpure
      rw [hb] at h
      have hpos : 0 < k + 1 := by omega
      simp [show k + 1 ≠ 0 by omega] at h
      exact (sub_eq_zero.mp h).symm
    have hK : K = -a * P.coeff (binMono k 1) := by
      dsimp [K]
      rw [hb]
      have hpos : 0 < k + 1 := by omega
      simp [show k + 1 ≠ 0 by omega] <;> ring
    have haxis := homogeneous_eval_x_zero Q (k + 1) hQ (-a)
    calc
      MvPolynomial.eval ![b, -a] Q =
          MvPolynomial.eval ![(0 : ℤ), -a] Q := by rw [hb]
      _ = Q.coeff (binMono 0 (k + 1)) * (-a) ^ (k + 1) := haxis
      _ = (-1 : ℤ) ^ k * a ^ k * K := by
            rw [hq0, hK, pow_succ, hneg]
            ring
  · have hrel0 := congrArg (MvPolynomial.eval ![b, -a]) hpure
    have hrel :
        (-a) ^ k * MvPolynomial.eval ![b, -a] P -
          b ^ k * MvPolynomial.eval ![b, -a] Q =
        c * (a * b + b * (-a)) ^ (2 * k + 1) := by
      simpa using hrel0
    have hzero : a * b + b * (-a) = 0 := by ring
    rw [hzero] at hrel
    have hpowpos : 0 < 2 * k + 1 := by omega
    simp [show 2 * k + 1 ≠ 0 by omega] at hrel
    rw [hPeval] at hrel
    have hmul : b ^ k *
        ((-a) ^ k * K - MvPolynomial.eval ![b, -a] Q) = 0 := by
      calc
        _ = (-a) ^ k * (b ^ k * K) -
            b ^ k * MvPolynomial.eval ![b, -a] Q := by ring
        _ = 0 := hrel
    have hraw : MvPolynomial.eval ![b, -a] Q = (-a) ^ k * K := by
      rcases mul_eq_zero.mp hmul with hz | hz
      · exact False.elim ((pow_ne_zero k hb) hz)
      · exact (sub_eq_zero.mp hz).symm
    rw [hraw, hneg]

theorem firstOriginalAlgebraicImplication :
    FirstOriginalAlgebraicImplication := by
  intro k hk P Q a b c A B d e u v
    hP hQ hcoprime hc hab hpure hd he hu hv hunit hgraph
  let S : ℤ := P.coeff (Finsupp.single (0 : Fin 2) (k + 1))
  let R : ℤ := P.coeff
    (Finsupp.single (0 : Fin 2) k +
      Finsupp.single (1 : Fin 2) 1)
  let K0 : ℤ := b * S - a * R +
    (Nat.choose (2 * k) (k - 1) : ℤ) *
      c * a ^ (k + 1) * b ^ (k + 1)
  let m : ℤ := a * (d : ℤ) + b * (e : ℤ)
  have hPeval : MvPolynomial.eval ![b, -a] P = b ^ k * K0 := by
    have hh := pure_P_signed_eval k hk P Q a b c hP hQ hpure
    simpa [S, R, K0, binMono] using hh
  have hQeval : MvPolynomial.eval ![b, -a] Q =
      (-1 : ℤ) ^ k * a ^ k * K0 := by
    have hh := pure_Q_signed_eval k hk P Q a b c hP hQ hpure
    simpa [S, R, K0, binMono] using hh
  obtain ⟨hK, hm, hdiv⟩ :=
    original_algebra_of_signed_evaluations k hk P Q a b c A B K0
      d e u v hP hQ hcoprime hab hpure hunit hgraph hPeval hQeval
  change K0 ≠ 0 ∧ m ≠ 0 ∧ m ∣ K0 ∧
    MvPolynomial.eval ![b, -a] P = b ^ k * K0 ∧
    MvPolynomial.eval ![b, -a] Q = (-1 : ℤ) ^ k * a ^ k * K0
  exact ⟨hK, hm, hdiv, hPeval, hQeval⟩

private theorem pure_P_normal_form
    (k : ℕ) (P Q : MvPolynomial (Fin 2) ℤ) (a b c : ℤ)
    (hP : ∀ μ ∈ P.support, μ 0 + μ 1 = k + 1)
    (hQ : ∀ μ ∈ Q.support, μ 0 + μ 1 = k + 1)
    (hpure : MvPolynomial.X (1 : Fin 2) ^ k * P -
      MvPolynomial.X (0 : Fin 2) ^ k * Q =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ (2 * k + 1)) :
    P =
      MvPolynomial.C (P.coeff (binMono (k + 1) 0)) *
        MvPolynomial.X 0 ^ (k + 1) +
      MvPolynomial.C (P.coeff (binMono k 1)) *
        MvPolynomial.X 0 ^ k * MvPolynomial.X 1 +
      MvPolynomial.C c *
        (∑ j ∈ Finset.range k,
          MvPolynomial.C
            ((Nat.choose (2 * k + 1) j : ℤ) *
              a ^ j * b ^ (2 * k + 1 - j)) *
            MvPolynomial.X 0 ^ j *
              MvPolynomial.X 1 ^ (k + 1 - j)) := by
  classical
  let t : ℕ → MvPolynomial (Fin 2) ℤ := fun j =>
    MvPolynomial.C (P.coeff (binMono j (k + 1 - j))) *
      MvPolynomial.X 0 ^ j * MvPolynomial.X 1 ^ (k + 1 - j)
  have he : P = ∑ j ∈ Finset.range (k + 2), t j := by
    simpa only [t, show k + 1 + 1 = k + 2 by omega] using
      homogeneous_binary_explicit P (k + 1) hP
  have hs : (∑ j ∈ Finset.range (k + 2), t j) =
      (∑ j ∈ Finset.range k, t j) + t k + t (k + 1) := by
    rw [show k + 2 = (k + 1) + 1 by omega,
      Finset.sum_range_succ, Finset.sum_range_succ]
  have hlo : (∑ j ∈ Finset.range k, t j) =
      MvPolynomial.C c *
        (∑ j ∈ Finset.range k,
          MvPolynomial.C
            ((Nat.choose (2 * k + 1) j : ℤ) *
              a ^ j * b ^ (2 * k + 1 - j)) *
            MvPolynomial.X 0 ^ j *
              MvPolynomial.X 1 ^ (k + 1 - j)) := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j hj
    have hc := pure_low_coeff k P Q a b c hP hQ hpure j
      (Finset.mem_range.mp hj)
    dsimp [t]
    rw [hc]
    simp only [map_mul]
    ring
  have htk : t k =
      MvPolynomial.C (P.coeff (binMono k 1)) *
        MvPolynomial.X 0 ^ k * MvPolynomial.X 1 := by
    dsimp [t]
    rw [show k + 1 - k = 1 by omega]
    simp
  have htk1 : t (k + 1) =
      MvPolynomial.C (P.coeff (binMono (k + 1) 0)) *
        MvPolynomial.X 0 ^ (k + 1) := by
    dsimp [t]
    rw [show k + 1 - (k + 1) = 0 by omega]
    simp
  calc
    P = (∑ j ∈ Finset.range (k + 2), t j) := he
    _ = (∑ j ∈ Finset.range k, t j) + t k + t (k + 1) := hs
    _ = _ := by rw [hlo, htk, htk1]; ring

private theorem coeff_ypow_homogeneous_zero_high
    (F : MvPolynomial (Fin 2) ℤ) (n k j : ℕ)
    (hF : ∀ μ ∈ F.support, μ 0 + μ 1 = n)
    (hj : n < j) :
    MvPolynomial.coeff (binMono j (k + n - j))
      (MvPolynomial.X (1 : Fin 2) ^ k * F) = 0 := by
  classical
  rw [ypow_homogeneous_explicit F n k hF, coeff_sum_binary]
  apply Finset.sum_eq_zero
  intro i hi
  rw [← binary_monomial_mixed, MvPolynomial.coeff_monomial]
  have hneq : binMono i (k + n - i) ≠
      binMono j (k + n - j) := by
    intro heq
    have h0 := congrArg (fun μ : Fin 2 →₀ ℕ => μ 0) heq
    have hx : i = j := by
      simpa [binMono, Finsupp.add_apply] using h0
    have hi' : i ≤ n := by simpa using hi
    omega
  simp [hneq]

private theorem coeff_xpow_homogeneous_shift
    (F : MvPolynomial (Fin 2) ℤ) (n k i : ℕ)
    (hF : ∀ μ ∈ F.support, μ 0 + μ 1 = n)
    (hi : i ≤ n) :
    MvPolynomial.coeff (binMono (k + i) (n - i))
      (MvPolynomial.X (0 : Fin 2) ^ k * F) =
        F.coeff (binMono i (n - i)) := by
  classical
  rw [xpow_homogeneous_explicit F n k hF, coeff_sum_binary]
  simp only [← binary_monomial_mixed, MvPolynomial.coeff_monomial]
  have hmono : ∀ j : ℕ,
      binMono (k + j) (n - j) = binMono (k + i) (n - i) ↔
        j = i := by
    intro j
    constructor
    · intro heq
      have h0 := congrArg (fun μ : Fin 2 →₀ ℕ => μ 0) heq
      simpa [binMono, Finsupp.add_apply] using h0
    · intro heq
      subst j
      rfl
  simp [hmono, hi]

private theorem pure_Q_high_coeff
    (k : ℕ) (P Q : MvPolynomial (Fin 2) ℤ)
    (a b c : ℤ)
    (hP : ∀ μ ∈ P.support, μ 0 + μ 1 = k + 1)
    (hQ : ∀ μ ∈ Q.support, μ 0 + μ 1 = k + 1)
    (hpure : MvPolynomial.X (1 : Fin 2) ^ k * P -
      MvPolynomial.X (0 : Fin 2) ^ k * Q =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ (2 * k + 1))
    (i : ℕ) (hi : 2 ≤ i) (hib : i ≤ k + 1) :
    Q.coeff (binMono i (k + 1 - i)) =
      -c * (Nat.choose (2 * k + 1) (k + i) : ℤ) *
        a ^ (k + i) * b ^ (k + 1 - i) := by
  let μ := binMono (k + i) (k + 1 - i)
  have hleft : MvPolynomial.coeff μ
      (MvPolynomial.X (1 : Fin 2) ^ k * P) = 0 := by
    have hidx : k + (k + 1) - (k + i) = k + 1 - i := by omega
    simpa only [μ, hidx] using
      coeff_ypow_homogeneous_zero_high P (k + 1) k (k + i) hP
        (by omega)
  have hright : MvPolynomial.coeff μ
      (MvPolynomial.X (0 : Fin 2) ^ k * Q) =
        Q.coeff (binMono i (k + 1 - i)) := by
    simpa only [μ] using
      coeff_xpow_homogeneous_shift Q (k + 1) k i hQ hib
  have hrhs : MvPolynomial.coeff μ
      (MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ (2 * k + 1)) =
      c * (Nat.choose (2 * k + 1) (k + i) : ℤ) *
        a ^ (k + i) * b ^ (k + 1 - i) := by
    have hidx : 2 * k + 1 - (k + i) = k + 1 - i := by omega
    simpa only [μ, hidx] using
      coeff_c_linear_pow a b c (2 * k + 1) (k + i) (by omega)
  have h := congrArg (MvPolynomial.coeff μ) hpure
  rw [MvPolynomial.coeff_sub, hleft, hright, hrhs] at h
  linear_combination -h

private theorem pure_Q_overlap_one
    (k : ℕ) (P Q : MvPolynomial (Fin 2) ℤ)
    (a b c : ℤ)
    (hP : ∀ μ ∈ P.support, μ 0 + μ 1 = k + 1)
    (hQ : ∀ μ ∈ Q.support, μ 0 + μ 1 = k + 1)
    (hpure : MvPolynomial.X (1 : Fin 2) ^ k * P -
      MvPolynomial.X (0 : Fin 2) ^ k * Q =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ (2 * k + 1)) :
    P.coeff (binMono (k + 1) 0) -
      Q.coeff (binMono 1 k) =
        c * (Nat.choose (2 * k + 1) (k + 1) : ℤ) *
          a ^ (k + 1) * b ^ k := by
  let μ := binMono (k + 1) k
  have hleft : MvPolynomial.coeff μ
      (MvPolynomial.X (1 : Fin 2) ^ k * P) =
        P.coeff (binMono (k + 1) 0) := by
    have hidx : k + (k + 1) - (k + 1) = k := by omega
    have hidx' : (k + 1) - (k + 1) = 0 := by omega
    simpa only [μ, hidx, hidx'] using
      coeff_ypow_homogeneous P (k + 1) k (k + 1) hP (by omega)
  have hright : MvPolynomial.coeff μ
      (MvPolynomial.X (0 : Fin 2) ^ k * Q) =
        Q.coeff (binMono 1 k) := by
    simpa only [μ, show k + 1 - 1 = k by omega] using
      coeff_xpow_homogeneous_shift Q (k + 1) k 1 hQ (by omega)
  have hrhs : MvPolynomial.coeff μ
      (MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ (2 * k + 1)) =
      c * (Nat.choose (2 * k + 1) (k + 1) : ℤ) *
        a ^ (k + 1) * b ^ k := by
    have hidx : 2 * k + 1 - (k + 1) = k := by omega
    simpa only [μ, hidx] using
      coeff_c_linear_pow a b c (2 * k + 1) (k + 1) (by omega)
  have h := congrArg (MvPolynomial.coeff μ) hpure
  rw [MvPolynomial.coeff_sub, hleft, hright, hrhs] at h
  exact h

private theorem pure_Q_coefficient_form
    (k : ℕ) (P Q : MvPolynomial (Fin 2) ℤ)
    (a b c : ℤ)
    (hP : ∀ μ ∈ P.support, μ 0 + μ 1 = k + 1)
    (hQ : ∀ μ ∈ Q.support, μ 0 + μ 1 = k + 1)
    (hpure : MvPolynomial.X (1 : Fin 2) ^ k * P -
      MvPolynomial.X (0 : Fin 2) ^ k * Q =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ (2 * k + 1))
    (i : ℕ) (hi : i ≤ k + 1) :
    Q.coeff (binMono i (k + 1 - i)) =
      (if i = 0 then P.coeff (binMono k 1)
       else if i = 1 then P.coeff (binMono (k + 1) 0)
       else 0) -
      c * (Nat.choose (2 * k + 1) (k + i) : ℤ) *
        a ^ (k + i) * b ^ (k + 1 - i) := by
  by_cases hi0 : i = 0
  · subst i
    simp only [ite_true, Nat.add_zero, Nat.zero_add, Nat.sub_zero]
    have h := pure_q0_coeff k P Q a b c hP hQ hpure
    linear_combination -h
  by_cases hi1 : i = 1
  · subst i
    simp only [show (1 : ℕ) ≠ 0 by decide, ite_false, ite_true]
    have h := pure_Q_overlap_one k P Q a b c hP hQ hpure
    have hidx : k + 1 - 1 = k := by omega
    rw [hidx]
    linear_combination -h
  have hi2 : 2 ≤ i := by omega
  simp only [hi0, hi1, ite_false, zero_sub]
  have h := pure_Q_high_coeff k P Q a b c hP hQ hpure i hi2 hi
  linear_combination h

private theorem pure_Q_normal_form_sum
    (k : ℕ) (P Q : MvPolynomial (Fin 2) ℤ)
    (a b c : ℤ)
    (hP : ∀ μ ∈ P.support, μ 0 + μ 1 = k + 1)
    (hQ : ∀ μ ∈ Q.support, μ 0 + μ 1 = k + 1)
    (hpure : MvPolynomial.X (1 : Fin 2) ^ k * P -
      MvPolynomial.X (0 : Fin 2) ^ k * Q =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ (2 * k + 1)) :
    Q =
      ∑ i ∈ Finset.range (k + 2),
        MvPolynomial.C
          ((if i = 0 then P.coeff (binMono k 1)
            else if i = 1 then P.coeff (binMono (k + 1) 0)
            else 0) -
            c * (Nat.choose (2 * k + 1) (k + i) : ℤ) *
              a ^ (k + i) * b ^ (k + 1 - i)) *
          MvPolynomial.X 0 ^ i *
            MvPolynomial.X 1 ^ (k + 1 - i) := by
  classical
  calc
    Q = ∑ i ∈ Finset.range (k + 2),
        MvPolynomial.C (Q.coeff (binMono i (k + 1 - i))) *
          MvPolynomial.X 0 ^ i *
            MvPolynomial.X 1 ^ (k + 1 - i) := by
          simpa only [show k + 1 + 1 = k + 2 by omega] using
            homogeneous_binary_explicit Q (k + 1) hQ
    _ = _ := by
      apply Finset.sum_congr rfl
      intro i hi
      rw [pure_Q_coefficient_form k P Q a b c hP hQ hpure i
        (by have hlt : i < k + 2 := Finset.mem_range.mp hi; omega)]

private theorem sum_two_spikes
    {T : Type*} [AddCommMonoid T] (r s : T) (n : ℕ) :
    (∑ i ∈ Finset.range (n + 2),
      if i = 0 then r else if i = 1 then s else 0) = r + s := by
  induction n with
  | zero =>
      rw [show 2 = 1 + 1 by omega, Finset.sum_range_succ,
        show 1 = 0 + 1 by omega, Finset.sum_range_succ]
      simp
  | succ n ih =>
      rw [show n + 1 + 2 = (n + 2) + 1 by omega,
        Finset.sum_range_succ]
      simp [ih, show n + 2 ≠ 0 by omega,
        show n + 2 ≠ 1 by omega]

private theorem pure_Q_base_sum
    (k : ℕ) (R S : ℤ) :
    (∑ i ∈ Finset.range (k + 2),
      MvPolynomial.C
        (if i = 0 then R else if i = 1 then S else 0) *
        MvPolynomial.X (0 : Fin 2) ^ i *
        MvPolynomial.X (1 : Fin 2) ^ (k + 1 - i)) =
      MvPolynomial.C R * MvPolynomial.X (1 : Fin 2) ^ (k + 1) +
        MvPolynomial.C S * MvPolynomial.X (0 : Fin 2) *
          MvPolynomial.X (1 : Fin 2) ^ k := by
  classical
  have hterm (i : ℕ) :
      MvPolynomial.C
        (if i = 0 then R else if i = 1 then S else 0) *
        MvPolynomial.X (0 : Fin 2) ^ i *
        MvPolynomial.X (1 : Fin 2) ^ (k + 1 - i) =
      (if i = 0 then
        MvPolynomial.C R * MvPolynomial.X (1 : Fin 2) ^ (k + 1)
       else if i = 1 then
        MvPolynomial.C S * MvPolynomial.X (0 : Fin 2) *
          MvPolynomial.X (1 : Fin 2) ^ k
       else 0) := by
    by_cases hi0 : i = 0
    · subst i
      simp
    by_cases hi1 : i = 1
    · subst i
      simp [show k + 1 - 1 = k by omega]
    simp [hi0, hi1]
  simp_rw [hterm]
  exact sum_two_spikes
    (MvPolynomial.C R * MvPolynomial.X (1 : Fin 2) ^ (k + 1))
    (MvPolynomial.C S * MvPolynomial.X (0 : Fin 2) *
      MvPolynomial.X (1 : Fin 2) ^ k) k

private theorem pure_Q_normal_form
    (k : ℕ) (P Q : MvPolynomial (Fin 2) ℤ)
    (a b c : ℤ)
    (hP : ∀ μ ∈ P.support, μ 0 + μ 1 = k + 1)
    (hQ : ∀ μ ∈ Q.support, μ 0 + μ 1 = k + 1)
    (hpure : MvPolynomial.X (1 : Fin 2) ^ k * P -
      MvPolynomial.X (0 : Fin 2) ^ k * Q =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X (0 : Fin 2) +
          MvPolynomial.C b * MvPolynomial.X (1 : Fin 2)) ^ (2 * k + 1)) :
    Q =
      MvPolynomial.C (P.coeff (binMono k 1)) *
        MvPolynomial.X (1 : Fin 2) ^ (k + 1) +
      MvPolynomial.C (P.coeff (binMono (k + 1) 0)) *
        MvPolynomial.X (0 : Fin 2) * MvPolynomial.X (1 : Fin 2) ^ k -
      MvPolynomial.C c *
        (∑ i ∈ Finset.range (k + 2),
          MvPolynomial.C
            ((Nat.choose (2 * k + 1) (k + i) : ℤ) *
              a ^ (k + i) * b ^ (k + 1 - i)) *
            MvPolynomial.X (0 : Fin 2) ^ i *
              MvPolynomial.X (1 : Fin 2) ^ (k + 1 - i)) := by
  classical
  have hform := pure_Q_normal_form_sum k P Q a b c hP hQ hpure
  rw [hform]
  calc
    (∑ i ∈ Finset.range (k + 2),
        MvPolynomial.C
          ((if i = 0 then P.coeff (binMono k 1)
            else if i = 1 then P.coeff (binMono (k + 1) 0)
            else 0) -
            c * (Nat.choose (2 * k + 1) (k + i) : ℤ) *
              a ^ (k + i) * b ^ (k + 1 - i)) *
          MvPolynomial.X (0 : Fin 2) ^ i *
            MvPolynomial.X (1 : Fin 2) ^ (k + 1 - i)) =
      (∑ i ∈ Finset.range (k + 2),
        MvPolynomial.C
          (if i = 0 then P.coeff (binMono k 1)
           else if i = 1 then P.coeff (binMono (k + 1) 0)
           else 0) *
          MvPolynomial.X (0 : Fin 2) ^ i *
            MvPolynomial.X (1 : Fin 2) ^ (k + 1 - i)) -
      MvPolynomial.C c *
        (∑ i ∈ Finset.range (k + 2),
          MvPolynomial.C
            ((Nat.choose (2 * k + 1) (k + i) : ℤ) *
              a ^ (k + i) * b ^ (k + 1 - i)) *
            MvPolynomial.X (0 : Fin 2) ^ i *
              MvPolynomial.X (1 : Fin 2) ^ (k + 1 - i)) := by
        rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
        apply Finset.sum_congr rfl
        intro i hi
        simp only [map_sub, map_mul]
        ring
    _ = _ := by rw [pure_Q_base_sum]

private theorem pure_mod_c_forms
    (k : ℕ) (P Q : MvPolynomial (Fin 2) ℤ)
    (a b c : ℤ)
    (hP : ∀ μ ∈ P.support, μ 0 + μ 1 = k + 1)
    (hQ : ∀ μ ∈ Q.support, μ 0 + μ 1 = k + 1)
    (hpure : MvPolynomial.X (1 : Fin 2) ^ k * P -
      MvPolynomial.X (0 : Fin 2) ^ k * Q =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ (2 * k + 1)) :
    let S := P.coeff (binMono (k + 1) 0)
    let R := P.coeff (binMono k 1)
    let J := MvPolynomial.C S * MvPolynomial.X (0 : Fin 2) +
      MvPolynomial.C R * MvPolynomial.X (1 : Fin 2)
    MvPolynomial.C c ∣ P - MvPolynomial.X 0 ^ k * J ∧
    MvPolynomial.C c ∣ Q - MvPolynomial.X 1 ^ k * J := by
  classical
  let S := P.coeff (binMono (k + 1) 0)
  let R := P.coeff (binMono k 1)
  let J : MvPolynomial (Fin 2) ℤ :=
    MvPolynomial.C S * MvPolynomial.X 0 +
      MvPolynomial.C R * MvPolynomial.X 1
  let PP : MvPolynomial (Fin 2) ℤ :=
    ∑ j ∈ Finset.range k,
      MvPolynomial.C
        ((Nat.choose (2 * k + 1) j : ℤ) *
          a ^ j * b ^ (2 * k + 1 - j)) *
        MvPolynomial.X 0 ^ j *
          MvPolynomial.X 1 ^ (k + 1 - j)
  let QQ : MvPolynomial (Fin 2) ℤ :=
    ∑ i ∈ Finset.range (k + 2),
      MvPolynomial.C
        ((Nat.choose (2 * k + 1) (k + i) : ℤ) *
          a ^ (k + i) * b ^ (k + 1 - i)) *
        MvPolynomial.X 0 ^ i *
          MvPolynomial.X 1 ^ (k + 1 - i)
  have hpn := pure_P_normal_form k P Q a b c hP hQ hpure
  have hqn := pure_Q_normal_form k P Q a b c hP hQ hpure
  have hpn' : P =
      MvPolynomial.C S * MvPolynomial.X 0 ^ (k + 1) +
      MvPolynomial.C R * MvPolynomial.X 0 ^ k * MvPolynomial.X 1 +
      MvPolynomial.C c * PP := by
    simpa only [S, R, PP] using hpn
  have hqn' : Q =
      MvPolynomial.C R * MvPolynomial.X 1 ^ (k + 1) +
      MvPolynomial.C S * MvPolynomial.X 0 * MvPolynomial.X 1 ^ k -
      MvPolynomial.C c * QQ := by
    simpa only [S, R, QQ] using hqn
  change MvPolynomial.C c ∣ P - MvPolynomial.X 0 ^ k * J ∧
    MvPolynomial.C c ∣ Q - MvPolynomial.X 1 ^ k * J
  constructor
  · refine ⟨PP, ?_⟩
    rw [hpn']
    dsimp only [J]
    ring
  · refine ⟨-QQ, ?_⟩
    rw [hqn']
    dsimp only [J]
    ring

private theorem content_from_mod_c
    (k : ℕ) (c S R d e u v Pv Qv : ℤ)
    (hunit : e ^ k * v - d ^ k * u = 1)
    (hPv : c ∣ Pv) (hQv : c ∣ Qv)
    (hPmod : c ∣ Pv - d ^ k * (S * d + R * e))
    (hQmod : c ∣ Qv - e ^ k * (S * d + R * e)) :
    c ∣ S * d + R * e := by
  let J : ℤ := S * d + R * e
  obtain ⟨p0, hp0⟩ := hPv
  obtain ⟨q0, hq0⟩ := hQv
  obtain ⟨p1, hp1⟩ := hPmod
  obtain ⟨q1, hq1⟩ := hQmod
  have hd : d ^ k * J = c * (p0 - p1) := by
    change d ^ k * (S * d + R * e) = c * (p0 - p1)
    linear_combination hp0 - hp1
  have he : e ^ k * J = c * (q0 - q1) := by
    change e ^ k * (S * d + R * e) = c * (q0 - q1)
    linear_combination hq0 - hq1
  refine ⟨v * (q0 - q1) - u * (p0 - p1), ?_⟩
  change J = c * (v * (q0 - q1) - u * (p0 - p1))
  linear_combination -J * hunit + v * he - u * hd

private theorem actual_content_divides
    (k : ℕ) (P Q : MvPolynomial (Fin 2) ℤ)
    (a b c d e u v : ℤ)
    (hP : ∀ μ ∈ P.support, μ 0 + μ 1 = k + 1)
    (hQ : ∀ μ ∈ Q.support, μ 0 + μ 1 = k + 1)
    (hpure : MvPolynomial.X (1 : Fin 2) ^ k * P -
      MvPolynomial.X (0 : Fin 2) ^ k * Q =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ (2 * k + 1))
    (hunit : e ^ k * v - d ^ k * u = 1)
    (hgraph : MvPolynomial.eval ![d, e] P * u =
      MvPolynomial.eval ![d, e] Q * v) :
    c ∣ P.coeff (binMono (k + 1) 0) * d +
      P.coeff (binMono k 1) * e := by
  let S : ℤ := P.coeff (binMono (k + 1) 0)
  let R : ℤ := P.coeff (binMono k 1)
  let J : MvPolynomial (Fin 2) ℤ :=
    MvPolynomial.C S * MvPolynomial.X 0 +
      MvPolynomial.C R * MvPolynomial.X 1
  let P0 : ℤ := MvPolynomial.eval ![d, e] P
  let Q0 : ℤ := MvPolynomial.eval ![d, e] Q
  let m : ℤ := a * d + b * e
  have hpureEval := congrArg (MvPolynomial.eval ![d, e]) hpure
  have hpuree : e ^ k * P0 - d ^ k * Q0 =
      c * m ^ (2 * k + 1) := by
    simpa [P0, Q0, m] using hpureEval
  obtain ⟨hP0, hQ0⟩ :=
    original_graph_values k a b c d e u v P0 Q0 hpuree hgraph hunit
  have hcP : c ∣ P0 := by
    refine ⟨m ^ (2 * k + 1) * v, ?_⟩
    simpa [mul_assoc] using hP0
  have hcQ : c ∣ Q0 := by
    refine ⟨m ^ (2 * k + 1) * u, ?_⟩
    simpa [mul_assoc] using hQ0
  have hforms := pure_mod_c_forms k P Q a b c hP hQ hpure
  change MvPolynomial.C c ∣ P - MvPolynomial.X 0 ^ k * J ∧
    MvPolynomial.C c ∣ Q - MvPolynomial.X 1 ^ k * J at hforms
  obtain ⟨⟨PP, hPP⟩, ⟨QQ, hQQ⟩⟩ := hforms
  have hcPmod : c ∣ P0 - d ^ k * (S * d + R * e) := by
    refine ⟨MvPolynomial.eval ![d, e] PP, ?_⟩
    have h := congrArg (MvPolynomial.eval ![d, e]) hPP
    simpa [P0, J] using h
  have hcQmod : c ∣ Q0 - e ^ k * (S * d + R * e) := by
    refine ⟨MvPolynomial.eval ![d, e] QQ, ?_⟩
    have h := congrArg (MvPolynomial.eval ![d, e]) hQQ
    simpa [Q0, J] using h
  exact content_from_mod_c k c S R d e u v P0 Q0
    hunit hcP hcQ hcPmod hcQmod

private theorem same_level_content_difference_general
    (a b c S R K T d₁ e₁ d₂ e₂ A B : ℤ)
    (hab : A * a + B * b = 1)
    (hlevel : a * d₁ + b * e₁ = a * d₂ + b * e₂)
    (hK : K = b * S - a * R + c * T)
    (hc₁ : c ∣ S * d₁ + R * e₁)
    (hc₂ : c ∣ S * d₂ + R * e₂) :
    c ∣ K * ((B * d₁ - A * e₁) -
      (B * d₂ - A * e₂)) := by
  let Δt : ℤ := (B * d₁ - A * e₁) - (B * d₂ - A * e₂)
  let ΔJ : ℤ := (S * d₁ + R * e₁) - (S * d₂ + R * e₂)
  have hm : a * (d₁ - d₂) + b * (e₁ - e₂) = 0 := by
    linear_combination hlevel
  have hpoly :
      (A * a + B * b) * ΔJ =
      (S * A + R * B) *
        (a * (d₁ - d₂) + b * (e₁ - e₂)) +
      (b * S - a * R) * Δt := by
    dsimp [ΔJ, Δt]
    ring
  have hdiff : ΔJ = (b * S - a * R) * Δt := by
    rw [hab, hm] at hpoly
    simpa using hpoly
  have hJ : c ∣ (b * S - a * R) * Δt := by
    have h := dvd_sub hc₁ hc₂
    change c ∣ ΔJ at h
    rw [hdiff] at h
    exact h
  have hplus : c ∣ c * (T * Δt) := ⟨T * Δt, rfl⟩
  have hsum := dvd_add hJ hplus
  have heq : (b * S - a * R) * Δt + c * (T * Δt) =
      K * Δt := by rw [hK]; ring
  rw [heq] at hsum
  exact hsum

private theorem normalized_gcd_literal (c K : ℤ)
    (hc : c ≠ 0) (hK : K ≠ 0) :
    let g0 : ℕ := Nat.gcd c.natAbs K.natAbs
    let h0 : ℕ := c.natAbs / g0
    let h : ℤ := (h0 : ℤ)
    let q : ℤ :=
      c.sign * K.sign * ((K.natAbs / g0 : ℕ) : ℤ)
    0 < g0 ∧ 0 < h0 ∧ q ≠ 0 ∧
      c * q = K * h ∧ Nat.Coprime h0 q.natAbs := by
  let C : ℕ := c.natAbs
  let Kabs : ℕ := K.natAbs
  let gN : ℕ := C.gcd Kabs
  let hN : ℕ := C / gN
  let kN : ℕ := Kabs / gN
  have hCpos : 0 < C := Int.natAbs_pos.mpr hc
  have hKpos : 0 < Kabs := Int.natAbs_pos.mpr hK
  have hgNpos : 0 < gN := Nat.gcd_pos_of_pos_left Kabs hCpos
  have hgC : gN ∣ C := Nat.gcd_dvd_left C Kabs
  have hgK : gN ∣ Kabs := Nat.gcd_dvd_right C Kabs
  have hgCle : gN ≤ C := Nat.le_of_dvd hCpos hgC
  have hgKle : gN ≤ Kabs := Nat.le_of_dvd hKpos hgK
  have hhNpos : 0 < hN := Nat.div_pos hgCle hgNpos
  have hkNpos : 0 < kN := Nat.div_pos hgKle hgNpos
  have hCeq : gN * hN = C := Nat.mul_div_cancel' hgC
  have hKeq : gN * kN = Kabs := Nat.mul_div_cancel' hgK
  have hCcast : (C : ℤ) = (gN : ℤ) * (hN : ℤ) := by
    exact_mod_cast hCeq.symm
  have hKcast : (Kabs : ℤ) = (gN : ℤ) * (kN : ℤ) := by
    exact_mod_cast hKeq.symm
  have hcRep : c = c.sign * (C : ℤ) :=
    (Int.sign_mul_natAbs c).symm
  have hKRep : K = K.sign * (Kabs : ℤ) :=
    (Int.sign_mul_natAbs K).symm
  have hcSign : c.sign.natAbs = 1 := by
    rcases lt_trichotomy c 0 with hneg | hzero | hpos
    · rw [Int.sign_eq_neg_one_of_neg hneg]
      norm_num
    · exact False.elim (hc hzero)
    · rw [Int.sign_eq_one_of_pos hpos]
      norm_num
  have hKSign : K.sign.natAbs = 1 := by
    rcases lt_trichotomy K 0 with hneg | hzero | hpos
    · rw [Int.sign_eq_neg_one_of_neg hneg]
      norm_num
    · exact False.elim (hK hzero)
    · rw [Int.sign_eq_one_of_pos hpos]
      norm_num
  have hcSignSq : c.sign * c.sign = 1 := by
    rcases lt_trichotomy c 0 with hneg | hzero | hpos
    · rw [Int.sign_eq_neg_one_of_neg hneg]
      norm_num
    · exact False.elim (hc hzero)
    · rw [Int.sign_eq_one_of_pos hpos]
      norm_num
  let q : ℤ := c.sign * K.sign * (kN : ℤ)
  have hqabs : q.natAbs = kN := by
    simp [q, Int.natAbs_mul, hcSign, hKSign]
  have hq0 : q ≠ 0 :=
    Int.natAbs_pos.mp (by rw [hqabs]; exact hkNpos)
  have hqeq : c * q = K * (hN : ℤ) := by
    calc
      c * q = (c.sign * (C : ℤ)) * q :=
        congrArg (fun z : ℤ => z * q) hcRep
      _ = (c.sign * (C : ℤ)) *
          (c.sign * K.sign * (kN : ℤ)) := rfl
      _ = (c.sign * c.sign) *
          ((C : ℤ) * K.sign * (kN : ℤ)) := by ring
      _ = (C : ℤ) * K.sign * (kN : ℤ) := by
        rw [hcSignSq]
        ring
      _ = K * (hN : ℤ) := by
        calc
          (C : ℤ) * K.sign * (kN : ℤ) =
            ((gN : ℤ) * (hN : ℤ)) *
              K.sign * (kN : ℤ) := by rw [hCcast]
          _ = (K.sign * ((gN : ℤ) * (kN : ℤ))) *
              (hN : ℤ) := by ring
          _ = K * (hN : ℤ) := by
            rw [← hKcast, ← hKRep]
  have hcop : Nat.Coprime hN kN :=
    Nat.coprime_div_gcd_div_gcd hgNpos
  change 0 < gN ∧ 0 < hN ∧ q ≠ 0 ∧
    c * q = K * (hN : ℤ) ∧ Nat.Coprime hN q.natAbs
  exact ⟨hgNpos, hhNpos, hq0, hqeq, by simpa [hqabs] using hcop⟩

private theorem gcd_progression_cancel
    (c K Δ : ℤ) (hc : c ≠ 0) (hK : K ≠ 0)
    (hdiv : c ∣ K * Δ) :
    ((c.natAbs / c.natAbs.gcd K.natAbs : ℕ) : ℤ) ∣ Δ := by
  let C : ℕ := c.natAbs
  let Kabs : ℕ := K.natAbs
  let gN : ℕ := C.gcd Kabs
  let hN : ℕ := C / gN
  let kN : ℕ := Kabs / gN
  have hCpos : 0 < C := Int.natAbs_pos.mpr hc
  have hgNpos : 0 < gN :=
    Nat.gcd_pos_of_pos_left Kabs hCpos
  have hg0 : gN ≠ 0 := Nat.ne_of_gt hgNpos
  have hgC : gN ∣ C := Nat.gcd_dvd_left C Kabs
  have hgK : gN ∣ Kabs := Nat.gcd_dvd_right C Kabs
  have hCeq : gN * hN = C := Nat.mul_div_cancel' hgC
  have hKeq : gN * kN = Kabs := Nat.mul_div_cancel' hgK
  have hcop : Nat.Coprime hN kN :=
    Nat.coprime_div_gcd_div_gcd hgNpos
  have hnat : C ∣ Kabs * Δ.natAbs := by
    have h := (Int.natAbs_dvd_natAbs).2 hdiv
    simpa [C, Kabs, Int.natAbs_mul] using h
  obtain ⟨z, hz⟩ := hnat
  have hkdiv : hN ∣ kN * Δ.natAbs := by
    refine ⟨z, ?_⟩
    apply mul_left_cancel₀ hg0
    calc
      gN * (kN * Δ.natAbs) =
        (gN * kN) * Δ.natAbs := by ring
      _ = Kabs * Δ.natAbs := by rw [hKeq]
      _ = C * z := hz
      _ = (gN * hN) * z := by rw [hCeq]
      _ = gN * (hN * z) := by ring
  have hfinal : hN ∣ Δ.natAbs :=
    hcop.dvd_of_dvd_mul_left hkdiv
  change (hN : ℤ) ∣ Δ
  apply (Int.natAbs_dvd_natAbs).1
  simpa using hfinal

private def pPartR {T : Type*} [CommRing T]
    (k : ℕ) (a b d e : T) : T :=
  ∑ j ∈ Finset.range k,
    (Nat.choose (2 * k + 1) j : T) *
      a ^ j * b ^ (2 * k + 1 - j) *
      d ^ j * e ^ (k + 1 - j)

private def qPartR {T : Type*} [CommRing T]
    (k : ℕ) (a b d e : T) : T :=
  ∑ i ∈ Finset.range (k + 2),
    (Nat.choose (2 * k + 1) (k + i) : T) *
      a ^ (k + i) * b ^ (k + 1 - i) *
      d ^ i * e ^ (k + 1 - i)

private theorem pure_evaluated_normal_forms
    (k : ℕ) (P Q : MvPolynomial (Fin 2) ℤ)
    (a b c d e : ℤ)
    (hP : ∀ μ ∈ P.support, μ 0 + μ 1 = k + 1)
    (hQ : ∀ μ ∈ Q.support, μ 0 + μ 1 = k + 1)
    (hpure : MvPolynomial.X (1 : Fin 2) ^ k * P -
      MvPolynomial.X (0 : Fin 2) ^ k * Q =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ (2 * k + 1)) :
    let S := P.coeff (binMono (k + 1) 0)
    let R := P.coeff (binMono k 1)
    MvPolynomial.eval ![d, e] P =
      d ^ k * (S * d + R * e) + c * pPartR k a b d e ∧
    MvPolynomial.eval ![d, e] Q =
      e ^ k * (S * d + R * e) - c * qPartR k a b d e := by
  classical
  let S := P.coeff (binMono (k + 1) 0)
  let R := P.coeff (binMono k 1)
  have hpn := congrArg (MvPolynomial.eval ![d, e])
    (pure_P_normal_form k P Q a b c hP hQ hpure)
  have hqn := congrArg (MvPolynomial.eval ![d, e])
    (pure_Q_normal_form k P Q a b c hP hQ hpure)
  change MvPolynomial.eval ![d, e] P =
      d ^ k * (S * d + R * e) + c * pPartR k a b d e ∧
    MvPolynomial.eval ![d, e] Q =
      e ^ k * (S * d + R * e) - c * qPartR k a b d e
  constructor
  · simp [S, R, pPartR, MvPolynomial.eval_sum, mul_assoc,
      pow_succ] at hpn ⊢
    linear_combination hpn
  · simp [S, R, qPartR, MvPolynomial.eval_sum, mul_assoc,
      pow_succ] at hqn ⊢
    linear_combination hqn

private noncomputable def dAffine (d0 D : ℤ) : Polynomial ℤ :=
  Polynomial.C d0 + Polynomial.C D * Polynomial.X

private noncomputable def eAffine (e0 E : ℤ) : Polynomial ℤ :=
  Polynomial.C e0 + Polynomial.C E * Polynomial.X

private noncomputable def jAffine (j0 j1 : ℤ) : Polynomial ℤ :=
  Polynomial.C j0 + Polynomial.C j1 * Polynomial.X

private noncomputable def fProgression
    (k : ℕ) (a b d0 D e0 E j0 j1 : ℤ) : Polynomial ℤ :=
  dAffine d0 D ^ k * jAffine j0 j1 +
    pPartR k (Polynomial.C a) (Polynomial.C b)
      (dAffine d0 D) (eAffine e0 E)

private noncomputable def gProgression
    (k : ℕ) (a b d0 D e0 E j0 j1 : ℤ) : Polynomial ℤ :=
  eAffine e0 E ^ k * jAffine j0 j1 -
    qPartR k (Polynomial.C a) (Polynomial.C b)
      (dAffine d0 D) (eAffine e0 E)

private theorem eval_sum_poly {α : Type*} (s : Finset α)
    (F : α → Polynomial ℤ) (y : ℤ) :
    Polynomial.eval y (∑ i ∈ s, F i) =
      ∑ i ∈ s, Polynomial.eval y (F i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih =>
      simp [Finset.sum_insert hi, ih]

private theorem eval_pPartR
    (k : ℕ) (a b y : ℤ) (D E : Polynomial ℤ) :
    Polynomial.eval y
      (pPartR k (Polynomial.C a) (Polynomial.C b) D E) =
      pPartR k a b (Polynomial.eval y D) (Polynomial.eval y E) := by
  simp [pPartR, eval_sum_poly]

private theorem eval_qPartR
    (k : ℕ) (a b y : ℤ) (D E : Polynomial ℤ) :
    Polynomial.eval y
      (qPartR k (Polynomial.C a) (Polynomial.C b) D E) =
      qPartR k a b (Polynomial.eval y D) (Polynomial.eval y E) := by
  simp [qPartR, eval_sum_poly]

private theorem integral_progression_values
    (k : ℕ) (P Q : MvPolynomial (Fin 2) ℤ)
    (a b c S R d0 D e0 E j0 j1 y : ℤ)
    (hS : S = P.coeff (binMono (k + 1) 0))
    (hR : R = P.coeff (binMono k 1))
    (hP : ∀ μ ∈ P.support, μ 0 + μ 1 = k + 1)
    (hQ : ∀ μ ∈ Q.support, μ 0 + μ 1 = k + 1)
    (hpure : MvPolynomial.X (1 : Fin 2) ^ k * P -
      MvPolynomial.X (0 : Fin 2) ^ k * Q =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ (2 * k + 1))
    (hJ0 : S * d0 + R * e0 = c * j0)
    (hJ1 : S * D + R * E = c * j1) :
    c * (fProgression k a b d0 D e0 E j0 j1).eval y =
      MvPolynomial.eval ![d0 + D * y, e0 + E * y] P ∧
    c * (gProgression k a b d0 D e0 E j0 j1).eval y =
      MvPolynomial.eval ![d0 + D * y, e0 + E * y] Q := by
  let d : ℤ := d0 + D * y
  let e : ℤ := e0 + E * y
  have hJ : S * d + R * e = c * (j0 + j1 * y) := by
    dsimp [d, e]
    linear_combination hJ0 + y * hJ1
  have hforms := pure_evaluated_normal_forms k P Q a b c d e hP hQ hpure
  change MvPolynomial.eval ![d, e] P =
      d ^ k * (P.coeff (binMono (k + 1) 0) * d +
        P.coeff (binMono k 1) * e) + c * pPartR k a b d e ∧
    MvPolynomial.eval ![d, e] Q =
      e ^ k * (P.coeff (binMono (k + 1) 0) * d +
        P.coeff (binMono k 1) * e) - c * qPartR k a b d e at hforms
  rw [← hS, ← hR] at hforms
  have hf :
      (fProgression k a b d0 D e0 E j0 j1).eval y =
        d ^ k * (j0 + j1 * y) + pPartR k a b d e := by
    unfold fProgression
    rw [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_pow]
    rw [eval_pPartR]
    simp [dAffine, eAffine, jAffine, d, e] <;> ring
  have hg :
      (gProgression k a b d0 D e0 E j0 j1).eval y =
        e ^ k * (j0 + j1 * y) - qPartR k a b d e := by
    unfold gProgression
    rw [Polynomial.eval_sub, Polynomial.eval_mul, Polynomial.eval_pow]
    rw [eval_qPartR]
    simp [dAffine, eAffine, jAffine, d, e] <;> ring
  constructor
  · rw [hf, hforms.1, hJ]
    ring
  · rw [hg, hforms.2, hJ]
    ring

private theorem anchored_integral_progression
    (k : ℕ) (P Q : MvPolynomial (Fin 2) ℤ)
    (a b c S R K d e u v : ℤ)
    (hS : S = P.coeff (binMono (k + 1) 0))
    (hR : R = P.coeff (binMono k 1))
    (hKdef : K =
      b * S - a * R +
        (Nat.choose (2 * k) (k - 1) : ℤ) *
          c * a ^ (k + 1) * b ^ (k + 1))
    (hK : K ≠ 0) (hc : c ≠ 0)
    (hP : ∀ μ ∈ P.support, μ 0 + μ 1 = k + 1)
    (hQ : ∀ μ ∈ Q.support, μ 0 + μ 1 = k + 1)
    (hpure : MvPolynomial.X (1 : Fin 2) ^ k * P -
      MvPolynomial.X (0 : Fin 2) ^ k * Q =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ (2 * k + 1))
    (hunit : e ^ k * v - d ^ k * u = 1)
    (hgraph : MvPolynomial.eval ![d, e] P * u =
      MvPolynomial.eval ![d, e] Q * v) :
    let g0 : ℕ := Nat.gcd c.natAbs K.natAbs
    let h0 : ℕ := c.natAbs / g0
    let h : ℤ := (h0 : ℤ)
    let q : ℤ := c.sign * K.sign * ((K.natAbs / g0 : ℕ) : ℤ)
    0 < g0 ∧ 0 < h0 ∧ q ≠ 0 ∧ c * q = K * h ∧
    Nat.Coprime h0 q.natAbs ∧
    c ∣ S * d + R * e ∧
    (b * S - a * R) * h =
      c * (q -
        (Nat.choose (2 * k) (k - 1) : ℤ) *
          h * a ^ (k + 1) * b ^ (k + 1)) ∧
    ∃ f g : Polynomial ℤ,
      ∀ y : ℤ,
        c * f.eval y =
          MvPolynomial.eval ![d + b * h * y, e - a * h * y] P ∧
        c * g.eval y =
          MvPolynomial.eval ![d + b * h * y, e - a * h * y] Q := by
  let g0 : ℕ := Nat.gcd c.natAbs K.natAbs
  let h0 : ℕ := c.natAbs / g0
  let h : ℤ := (h0 : ℤ)
  let q : ℤ := c.sign * K.sign * ((K.natAbs / g0 : ℕ) : ℤ)
  have hnorm := normalized_gcd_literal c K hc hK
  change 0 < g0 ∧ 0 < h0 ∧ q ≠ 0 ∧
    c * q = K * h ∧ Nat.Coprime h0 q.natAbs at hnorm
  obtain ⟨hg0, hh0, hq0, hq, hcop⟩ := hnorm
  have hcontent : c ∣ S * d + R * e := by
    have hz := actual_content_divides k P Q a b c d e u v
      hP hQ hpure hunit hgraph
    simpa only [hS, hR] using hz
  obtain ⟨j0, hj0⟩ := hcontent
  let j1 : ℤ :=
    q - (Nat.choose (2 * k) (k - 1) : ℤ) *
      h * a ^ (k + 1) * b ^ (k + 1)
  have hj1 : (b * S - a * R) * h = c * j1 := by
    calc
      (b * S - a * R) * h =
        K * h -
          c * ((Nat.choose (2 * k) (k - 1) : ℤ) *
            h * a ^ (k + 1) * b ^ (k + 1)) := by
              rw [hKdef]
              ring
      _ = c * q -
          c * ((Nat.choose (2 * k) (k - 1) : ℤ) *
            h * a ^ (k + 1) * b ^ (k + 1)) := by rw [← hq]
      _ = c * j1 := by dsimp [j1]; ring
  have hJ1 : S * (b * h) + R * (-a * h) = c * j1 := by
    calc
      _ = (b * S - a * R) * h := by ring
      _ = c * j1 := hj1
  let f : Polynomial ℤ :=
    fProgression k a b d (b * h) e (-a * h) j0 j1
  let g : Polynomial ℤ :=
    gProgression k a b d (b * h) e (-a * h) j0 j1
  change 0 < g0 ∧ 0 < h0 ∧ q ≠ 0 ∧
    c * q = K * h ∧ Nat.Coprime h0 q.natAbs ∧
    c ∣ S * d + R * e ∧
    (b * S - a * R) * h = c * j1 ∧
    ∃ f g : Polynomial ℤ, ∀ y : ℤ,
      c * f.eval y =
        MvPolynomial.eval ![d + b * h * y, e - a * h * y] P ∧
      c * g.eval y =
        MvPolynomial.eval ![d + b * h * y, e - a * h * y] Q
  refine ⟨hg0, hh0, hq0, hq, hcop, ⟨j0, hj0⟩, hj1, f, g, ?_⟩
  intro y
  have hv := integral_progression_values k P Q a b c S R
    d (b * h) e (-a * h) j0 j1 y hS hR hP hQ hpure
      hj0 hJ1
  simpa [f, g, sub_eq_add_neg, mul_assoc] using hv

open Polynomial

private theorem coeff_mul_at_bounded_top
    (P Q : Polynomial ℤ) (r s : ℕ)
    (hP : P.natDegree ≤ r) (hQ : Q.natDegree ≤ s) :
    (P * Q).coeff (r + s) = P.coeff r * Q.coeff s := by
  classical
  rw [Polynomial.coeff_mul]
  refine Finset.sum_eq_single (r, s) ?_ ?_
  · rintro ⟨u, v⟩ huv hne
    have hsum : u + v = r + s := by simpa using huv
    by_cases hu : r < u
    · have hz : P.coeff u = 0 :=
        (Polynomial.natDegree_le_iff_coeff_eq_zero.mp hP) u hu
      simp [hz]
    · have hule : u ≤ r := by omega
      have hv : s < v := by
        by_contra hn
        have hvle : v ≤ s := by omega
        have hur : u = r := by omega
        have hvs : v = s := by omega
        exact hne (by simp [hur, hvs])
      have hz : Q.coeff v = 0 :=
        (Polynomial.natDegree_le_iff_coeff_eq_zero.mp hQ) v hv
      simp [hz]
  · intro hnot
    exact False.elim (hnot (by simp))

private theorem natDegree_pow_le_bound
    (P : Polynomial ℤ) (r n : ℕ)
    (hP : P.natDegree ≤ r) :
    (P ^ n).natDegree ≤ r * n := by
  induction n with
  | zero => simp
  | succ n ih =>
      calc
        (P ^ (n + 1)).natDegree =
            (P ^ n * P).natDegree := by rw [pow_succ]
        _ ≤ (P ^ n).natDegree + P.natDegree := by
          first
          | exact Polynomial.natDegree_mul_le _ _
          | exact Polynomial.natDegree_mul_le
        _ ≤ r * n + r := by omega
        _ = r * (n + 1) := by ring

private theorem coeff_pow_at_bounded_top
    (P : Polynomial ℤ) (r n : ℕ)
    (hP : P.natDegree ≤ r) :
    (P ^ n).coeff (r * n) = (P.coeff r) ^ n := by
  induction n with
  | zero => simp
  | succ n ih =>
      calc
        (P ^ (n + 1)).coeff (r * (n + 1)) =
            (P ^ n * P).coeff (r * n + r) := by
              simp [pow_succ, Nat.mul_succ]
        _ = (P ^ n).coeff (r * n) * P.coeff r :=
          coeff_mul_at_bounded_top (P ^ n) P (r * n) r
            (natDegree_pow_le_bound P r n hP) hP
        _ = (P.coeff r) ^ (n + 1) := by rw [ih, pow_succ]

private theorem natDegree_constant_le_zero (u : ℤ) :
    (C u : Polynomial ℤ).natDegree ≤ 0 := by
  simp

private theorem coeff_constant_pos_zero (u : ℤ) (n : ℕ) (hn : 0 < n) :
    (C u : Polynomial ℤ).coeff n = 0 := by
  exact (Polynomial.natDegree_le_iff_coeff_eq_zero.mp
    (natDegree_constant_le_zero u)) n hn

private theorem natDegree_affine_le_one (u v : ℤ) :
    (C u + C v * X).natDegree ≤ 1 := by
  apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
  intro n hn
  have hn1 : n ≠ 1 := by omega
  have hcu : (C u : Polynomial ℤ).coeff n = 0 :=
    coeff_constant_pos_zero u n (by omega)
  have hx : (X : Polynomial ℤ).coeff n = 0 := by
    have hpow : ((X : Polynomial ℤ) ^ 1).coeff n = 0 := by
      simp only [Polynomial.coeff_X_pow]
      split_ifs with h
      · omega
      · rfl
    simpa only [pow_one] using hpow
  simp only [Polynomial.coeff_add, Polynomial.coeff_C_mul, hcu, hx]
  ring

private theorem coeff_affine_one (u v : ℤ) :
    (C u + C v * X).coeff 1 = v := by
  have hcu : (C u : Polynomial ℤ).coeff 1 = 0 :=
    coeff_constant_pos_zero u 1 (by omega)
  simp only [Polynomial.coeff_add, Polynomial.coeff_C_mul, hcu]
  simp

private theorem coeff_affine_monomial
    (d₀ D e₀ E : ℤ) (i j : ℕ) :
    ((C d₀ + C D * X) ^ i *
      (C e₀ + C E * X) ^ j).coeff (i + j) =
        D ^ i * E ^ j := by
  let DP : Polynomial ℤ := C d₀ + C D * X
  let EP : Polynomial ℤ := C e₀ + C E * X
  change (DP ^ i * EP ^ j).coeff (i + j) = D ^ i * E ^ j
  have hD : DP.natDegree ≤ 1 :=
    natDegree_affine_le_one d₀ D
  have hE : EP.natDegree ≤ 1 :=
    natDegree_affine_le_one e₀ E
  have hDi : (DP ^ i).natDegree ≤ i := by
    simpa using natDegree_pow_le_bound DP 1 i hD
  have hEj : (EP ^ j).natDegree ≤ j := by
    simpa using natDegree_pow_le_bound EP 1 j hE
  have hDcoeff : DP.coeff 1 = D := by
    simpa only [DP] using coeff_affine_one d₀ D
  have hEcoeff : EP.coeff 1 = E := by
    simpa only [EP] using coeff_affine_one e₀ E
  have hDtop : (DP ^ i).coeff i = D ^ i := by
    simpa only [one_mul, hDcoeff] using
      coeff_pow_at_bounded_top DP 1 i hD
  have hEtop : (EP ^ j).coeff j = E ^ j := by
    simpa only [one_mul, hEcoeff] using
      coeff_pow_at_bounded_top EP 1 j hE
  rw [coeff_mul_at_bounded_top (DP ^ i) (EP ^ j) i j hDi hEj,
    hDtop, hEtop]

private theorem coeff_affine_monomial_scaled
    (c d₀ D e₀ E : ℤ) (i j : ℕ) :
    (C c * ((C d₀ + C D * X) ^ i *
      (C e₀ + C E * X) ^ j)).coeff (i + j) =
        c * D ^ i * E ^ j := by
  rw [Polynomial.coeff_C_mul,
    coeff_affine_monomial]
  ring

private theorem coeff_sum_poly {α : Type*} (s : Finset α)
    (F : α → Polynomial ℤ) (n : ℕ) :
    (∑ i ∈ s, F i).coeff n =
      ∑ i ∈ s, (F i).coeff n := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih =>
      simp [Finset.sum_insert hi, ih]

private theorem pPart_affine_top
    (k : ℕ) (a b d0 D e0 E : ℤ) :
    (pPartR k (Polynomial.C a) (Polynomial.C b)
      (dAffine d0 D) (eAffine e0 E)).coeff (k + 1) =
        pPartR k a b D E := by
  classical
  simp only [pPartR, coeff_sum_poly]
  apply Finset.sum_congr rfl
  intro j hj
  have hjle : j ≤ k := by
    have hlt : j < k := Finset.mem_range.mp hj
    omega
  have hdeg : j + (k + 1 - j) = k + 1 := by omega
  have hc :
      (Nat.choose (2 * k + 1) j : Polynomial ℤ) *
        (Polynomial.C a) ^ j *
        (Polynomial.C b) ^ (2 * k + 1 - j) =
      Polynomial.C
        ((Nat.choose (2 * k + 1) j : ℤ) *
          a ^ j * b ^ (2 * k + 1 - j)) := by
    simp [map_mul, map_pow]
  rw [hc, mul_assoc]
  simpa only [dAffine, eAffine, hdeg] using
    coeff_affine_monomial_scaled
      ((Nat.choose (2 * k + 1) j : ℤ) *
        a ^ j * b ^ (2 * k + 1 - j))
      d0 D e0 E j (k + 1 - j)

private theorem qPart_affine_top
    (k : ℕ) (a b d0 D e0 E : ℤ) :
    (qPartR k (Polynomial.C a) (Polynomial.C b)
      (dAffine d0 D) (eAffine e0 E)).coeff (k + 1) =
        qPartR k a b D E := by
  classical
  simp only [qPartR, coeff_sum_poly]
  apply Finset.sum_congr rfl
  intro i hi
  have hile : i ≤ k + 1 := by
    have hlt : i < k + 2 := Finset.mem_range.mp hi
    omega
  have hdeg : i + (k + 1 - i) = k + 1 := by omega
  have hc :
      (Nat.choose (2 * k + 1) (k + i) : Polynomial ℤ) *
        (Polynomial.C a) ^ (k + i) *
        (Polynomial.C b) ^ (k + 1 - i) =
      Polynomial.C
        ((Nat.choose (2 * k + 1) (k + i) : ℤ) *
          a ^ (k + i) * b ^ (k + 1 - i)) := by
    simp [map_mul, map_pow]
  rw [hc, mul_assoc]
  simpa only [dAffine, eAffine, hdeg] using
    coeff_affine_monomial_scaled
      ((Nat.choose (2 * k + 1) (k + i) : ℤ) *
        a ^ (k + i) * b ^ (k + 1 - i))
      d0 D e0 E i (k + 1 - i)

private theorem natDegree_sum_le_of {α : Type*}
    (s : Finset α) (F : α → Polynomial ℤ) (n : ℕ)
    (h : ∀ i ∈ s, (F i).natDegree ≤ n) :
    (∑ i ∈ s, F i).natDegree ≤ n := by
  classical
  apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
  intro m hm
  rw [coeff_sum_poly]
  apply Finset.sum_eq_zero
  intro i hi
  exact (Polynomial.natDegree_le_iff_coeff_eq_zero.mp
    (h i hi)) m hm

private theorem natDegree_add_le_of
    (P Q : Polynomial ℤ) (n : ℕ)
    (hP : P.natDegree ≤ n) (hQ : Q.natDegree ≤ n) :
    (P + Q).natDegree ≤ n := by
  apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
  intro m hm
  rw [Polynomial.coeff_add,
    (Polynomial.natDegree_le_iff_coeff_eq_zero.mp hP) m hm,
    (Polynomial.natDegree_le_iff_coeff_eq_zero.mp hQ) m hm]
  ring

private theorem affine_monomial_degree_le
    (c d0 D e0 E : ℤ) (i j : ℕ) :
    (Polynomial.C c * dAffine d0 D ^ i *
      eAffine e0 E ^ j).natDegree ≤ i + j := by
  have hD : (dAffine d0 D).natDegree ≤ 1 := by
    simpa only [dAffine] using natDegree_affine_le_one d0 D
  have hE : (eAffine e0 E).natDegree ≤ 1 := by
    simpa only [eAffine] using natDegree_affine_le_one e0 E
  have hDi : (dAffine d0 D ^ i).natDegree ≤ i := by
    simpa using natDegree_pow_le_bound (dAffine d0 D) 1 i hD
  have hEj : (eAffine e0 E ^ j).natDegree ≤ j := by
    simpa using natDegree_pow_le_bound (eAffine e0 E) 1 j hE
  have hC : (Polynomial.C c).natDegree ≤ 0 :=
    natDegree_constant_le_zero c
  have h1 :
      (Polynomial.C c * dAffine d0 D ^ i).natDegree ≤ i := by
    have hm : (Polynomial.C c * dAffine d0 D ^ i).natDegree ≤
        (Polynomial.C c).natDegree + (dAffine d0 D ^ i).natDegree :=
      Polynomial.natDegree_mul_le
    omega
  have h2 :
      (Polynomial.C c * dAffine d0 D ^ i *
        eAffine e0 E ^ j).natDegree ≤
        (Polynomial.C c * dAffine d0 D ^ i).natDegree +
          (eAffine e0 E ^ j).natDegree :=
    Polynomial.natDegree_mul_le
  omega

private theorem pPart_degree_le
    (k : ℕ) (a b d0 D e0 E : ℤ) :
    (pPartR k (Polynomial.C a) (Polynomial.C b)
      (dAffine d0 D) (eAffine e0 E)).natDegree ≤ k + 1 := by
  dsimp [pPartR]
  apply natDegree_sum_le_of
  intro j hj
  have hjle : j ≤ k + 1 := by
    have hlt : j < k := Finset.mem_range.mp hj
    omega
  have hdegree := affine_monomial_degree_le
    ((Nat.choose (2 * k + 1) j : ℤ) *
      a ^ j * b ^ (2 * k + 1 - j))
      d0 D e0 E j (k + 1 - j)
  have hscalar :
      (Nat.choose (2 * k + 1) j : Polynomial ℤ) *
        (Polynomial.C a) ^ j *
        (Polynomial.C b) ^ (2 * k + 1 - j) =
      Polynomial.C
        ((Nat.choose (2 * k + 1) j : ℤ) *
          a ^ j * b ^ (2 * k + 1 - j)) := by
    simp [map_mul, map_pow]
  rw [hscalar]
  omega

private theorem qPart_degree_le
    (k : ℕ) (a b d0 D e0 E : ℤ) :
    (qPartR k (Polynomial.C a) (Polynomial.C b)
      (dAffine d0 D) (eAffine e0 E)).natDegree ≤ k + 1 := by
  dsimp [qPartR]
  apply natDegree_sum_le_of
  intro i hi
  have hile : i ≤ k + 1 := by
    have hlt : i < k + 2 := Finset.mem_range.mp hi
    omega
  have hdegree := affine_monomial_degree_le
    ((Nat.choose (2 * k + 1) (k + i) : ℤ) *
      a ^ (k + i) * b ^ (k + 1 - i))
      d0 D e0 E i (k + 1 - i)
  have hscalar :
      (Nat.choose (2 * k + 1) (k + i) : Polynomial ℤ) *
        (Polynomial.C a) ^ (k + i) *
        (Polynomial.C b) ^ (k + 1 - i) =
      Polynomial.C
        ((Nat.choose (2 * k + 1) (k + i) : ℤ) *
          a ^ (k + i) * b ^ (k + 1 - i)) := by
    simp [map_mul, map_pow]
  rw [hscalar]
  omega

private theorem progression_degree_le
    (k : ℕ) (a b d0 D e0 E j0 j1 : ℤ) :
    (fProgression k a b d0 D e0 E j0 j1).natDegree ≤ k + 1 ∧
    (gProgression k a b d0 D e0 E j0 j1).natDegree ≤ k + 1 := by
  have hD : (dAffine d0 D).natDegree ≤ 1 := by
    simpa only [dAffine] using natDegree_affine_le_one d0 D
  have hE : (eAffine e0 E).natDegree ≤ 1 := by
    simpa only [eAffine] using natDegree_affine_le_one e0 E
  have hJ : (jAffine j0 j1).natDegree ≤ 1 := by
    simpa only [jAffine] using natDegree_affine_le_one j0 j1
  have hDP : (dAffine d0 D ^ k).natDegree ≤ k := by
    simpa using natDegree_pow_le_bound (dAffine d0 D) 1 k hD
  have hEP : (eAffine e0 E ^ k).natDegree ≤ k := by
    simpa using natDegree_pow_le_bound (eAffine e0 E) 1 k hE
  have hDJ :
      (dAffine d0 D ^ k * jAffine j0 j1).natDegree ≤ k + 1 := by
    have hm : (dAffine d0 D ^ k * jAffine j0 j1).natDegree ≤
        (dAffine d0 D ^ k).natDegree + (jAffine j0 j1).natDegree :=
      Polynomial.natDegree_mul_le
    omega
  have hEJ :
      (eAffine e0 E ^ k * jAffine j0 j1).natDegree ≤ k + 1 := by
    have hm : (eAffine e0 E ^ k * jAffine j0 j1).natDegree ≤
        (eAffine e0 E ^ k).natDegree + (jAffine j0 j1).natDegree :=
      Polynomial.natDegree_mul_le
    omega
  have hPP := pPart_degree_le k a b d0 D e0 E
  have hQQ := qPart_degree_le k a b d0 D e0 E
  constructor
  · change (dAffine d0 D ^ k * jAffine j0 j1 +
      pPartR k (Polynomial.C a) (Polynomial.C b)
        (dAffine d0 D) (eAffine e0 E)).natDegree ≤ k + 1
    exact natDegree_add_le_of _ _ _ hDJ hPP
  · change (eAffine e0 E ^ k * jAffine j0 j1 -
      qPartR k (Polynomial.C a) (Polynomial.C b)
        (dAffine d0 D) (eAffine e0 E)).natDegree ≤ k + 1
    have hneg : (-(qPartR k (Polynomial.C a) (Polynomial.C b)
        (dAffine d0 D) (eAffine e0 E))).natDegree ≤ k + 1 := by
      simpa using hQQ
    simpa only [sub_eq_add_neg] using
      natDegree_add_le_of _ _ _ hEJ hneg

private theorem progression_top_form
    (k : ℕ) (a b d0 D e0 E j0 j1 : ℤ) :
    (fProgression k a b d0 D e0 E j0 j1).coeff (k + 1) =
      D ^ k * j1 + pPartR k a b D E ∧
    (gProgression k a b d0 D e0 E j0 j1).coeff (k + 1) =
      E ^ k * j1 - qPartR k a b D E := by
  have hD :
      (dAffine d0 D ^ k * jAffine j0 j1).coeff (k + 1) =
        D ^ k * j1 := by
    simpa only [dAffine, jAffine, pow_one] using
      coeff_affine_monomial d0 D j0 j1 k 1
  have hE :
      (eAffine e0 E ^ k * jAffine j0 j1).coeff (k + 1) =
        E ^ k * j1 := by
    simpa only [eAffine, jAffine, pow_one] using
      coeff_affine_monomial e0 E j0 j1 k 1
  constructor
  · change (dAffine d0 D ^ k * jAffine j0 j1 +
      pPartR k (Polynomial.C a) (Polynomial.C b)
        (dAffine d0 D) (eAffine e0 E)).coeff (k + 1) =
        D ^ k * j1 + pPartR k a b D E
    rw [Polynomial.coeff_add, hD, pPart_affine_top]
  · change (eAffine e0 E ^ k * jAffine j0 j1 -
      qPartR k (Polynomial.C a) (Polynomial.C b)
        (dAffine d0 D) (eAffine e0 E)).coeff (k + 1) =
        E ^ k * j1 - qPartR k a b D E
    rw [Polynomial.coeff_sub, hE, qPart_affine_top]

private theorem progression_top_matches_eval
    (k : ℕ) (P Q : MvPolynomial (Fin 2) ℤ)
    (a b c S R d0 D e0 E j0 j1 : ℤ)
    (hS : S = P.coeff (binMono (k + 1) 0))
    (hR : R = P.coeff (binMono k 1))
    (hP : ∀ μ ∈ P.support, μ 0 + μ 1 = k + 1)
    (hQ : ∀ μ ∈ Q.support, μ 0 + μ 1 = k + 1)
    (hpure : MvPolynomial.X (1 : Fin 2) ^ k * P -
      MvPolynomial.X (0 : Fin 2) ^ k * Q =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ (2 * k + 1))
    (hJ1 : S * D + R * E = c * j1) :
    c * (fProgression k a b d0 D e0 E j0 j1).coeff (k + 1) =
      MvPolynomial.eval ![D, E] P ∧
    c * (gProgression k a b d0 D e0 E j0 j1).coeff (k + 1) =
      MvPolynomial.eval ![D, E] Q := by
  have htop := progression_top_form k a b d0 D e0 E j0 j1
  have hforms := pure_evaluated_normal_forms k P Q a b c D E
    hP hQ hpure
  change MvPolynomial.eval ![D, E] P =
      D ^ k * (P.coeff (binMono (k + 1) 0) * D +
        P.coeff (binMono k 1) * E) + c * pPartR k a b D E ∧
    MvPolynomial.eval ![D, E] Q =
      E ^ k * (P.coeff (binMono (k + 1) 0) * D +
        P.coeff (binMono k 1) * E) - c * qPartR k a b D E at hforms
  rw [← hS, ← hR] at hforms
  constructor
  · rw [htop.1]
    calc
      c * (D ^ k * j1 + pPartR k a b D E) =
        D ^ k * (S * D + R * E) +
          c * pPartR k a b D E := by
            linear_combination -D ^ k * hJ1
      _ = MvPolynomial.eval ![D, E] P := hforms.1.symm
  · rw [htop.2]
    calc
      c * (E ^ k * j1 - qPartR k a b D E) =
        E ^ k * (S * D + R * E) -
          c * qPartR k a b D E := by
            linear_combination -E ^ k * hJ1
      _ = MvPolynomial.eval ![D, E] Q := hforms.2.symm

private theorem homogeneous_eval_scaling
    (F : MvPolynomial (Fin 2) ℤ) (n : ℕ)
    (hF : ∀ μ ∈ F.support, μ 0 + μ 1 = n)
    (t x y : ℤ) :
    MvPolynomial.eval ![t * x, t * y] F =
      t ^ n * MvPolynomial.eval ![x, y] F := by
  rw [homogeneous_binary_eval_explicit F n hF (t * x) (t * y),
    homogeneous_binary_eval_explicit F n hF x y,
    Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro j hj
  have hjle : j ≤ n := by
    have hlt : j < n + 1 := Finset.mem_range.mp hj
    omega
  have hpow : t ^ j * t ^ (n - j) = t ^ n := by
    rw [← pow_add, Nat.add_sub_of_le hjle]
  rw [mul_pow, mul_pow]
  calc
    F.coeff (binMono j (n - j)) *
        (t ^ j * x ^ j) * (t ^ (n - j) * y ^ (n - j)) =
      (t ^ j * t ^ (n - j)) *
        (F.coeff (binMono j (n - j)) *
          x ^ j * y ^ (n - j)) := by ring
    _ = _ := by rw [hpow]

private theorem progression_signed_top
    (k : ℕ) (P Q : MvPolynomial (Fin 2) ℤ)
    (a b c S R K q h d0 e0 j0 j1 : ℤ)
    (hc : c ≠ 0)
    (hS : S = P.coeff (binMono (k + 1) 0))
    (hR : R = P.coeff (binMono k 1))
    (hP : ∀ μ ∈ P.support, μ 0 + μ 1 = k + 1)
    (hQ : ∀ μ ∈ Q.support, μ 0 + μ 1 = k + 1)
    (hpure : MvPolynomial.X (1 : Fin 2) ^ k * P -
      MvPolynomial.X (0 : Fin 2) ^ k * Q =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ (2 * k + 1))
    (hPeval : MvPolynomial.eval ![b, -a] P = b ^ k * K)
    (hQeval : MvPolynomial.eval ![b, -a] Q =
      (-1 : ℤ) ^ k * a ^ k * K)
    (hq : c * q = K * h)
    (hJ1 : S * (b * h) + R * (-a * h) = c * j1) :
    (fProgression k a b d0 (b * h) e0 (-a * h) j0 j1).coeff (k + 1) =
      q * h ^ k * b ^ k ∧
    (gProgression k a b d0 (b * h) e0 (-a * h) j0 j1).coeff (k + 1) =
      (-1 : ℤ) ^ k * q * h ^ k * a ^ k := by
  have ht := progression_top_matches_eval k P Q a b c S R
    d0 (b * h) e0 (-a * h) j0 j1
    hS hR hP hQ hpure hJ1
  have hscaleP :
      MvPolynomial.eval ![b * h, -a * h] P =
        h ^ (k + 1) * MvPolynomial.eval ![b, -a] P := by
    simpa [mul_assoc, mul_comm, mul_left_comm] using
      homogeneous_eval_scaling P (k + 1) hP h b (-a)
  have hscaleQ :
      MvPolynomial.eval ![b * h, -a * h] Q =
        h ^ (k + 1) * MvPolynomial.eval ![b, -a] Q := by
    simpa [mul_assoc, mul_comm, mul_left_comm] using
      homogeneous_eval_scaling Q (k + 1) hQ h b (-a)
  constructor
  · apply mul_left_cancel₀ hc
    calc
      c * (fProgression k a b d0 (b * h) e0 (-a * h)
          j0 j1).coeff (k + 1) =
        MvPolynomial.eval ![b * h, -a * h] P := ht.1
      _ = h ^ (k + 1) * MvPolynomial.eval ![b, -a] P := hscaleP
      _ = (K * h) * (h ^ k * b ^ k) := by
        rw [hPeval, pow_succ]
        ring
      _ = c * (q * h ^ k * b ^ k) := by rw [← hq]; ring
  · apply mul_left_cancel₀ hc
    calc
      c * (gProgression k a b d0 (b * h) e0 (-a * h)
          j0 j1).coeff (k + 1) =
        MvPolynomial.eval ![b * h, -a * h] Q := ht.2
      _ = h ^ (k + 1) * MvPolynomial.eval ![b, -a] Q := hscaleQ
      _ = (K * h) * ((-1 : ℤ) ^ k * h ^ k * a ^ k) := by
        rw [hQeval, pow_succ]
        ring
      _ = c * ((-1 : ℤ) ^ k * q * h ^ k * a ^ k) := by
        rw [← hq]
        ring

private theorem same_level_anchored_step
    (a b c A B S R K T d0 e0 d1 e1 : ℤ)
    (hab : A * a + B * b = 1)
    (hc : c ≠ 0) (hK : K ≠ 0)
    (hKdef : K = b * S - a * R + c * T)
    (hlevel : a * d1 + b * e1 = a * d0 + b * e0)
    (hc0 : c ∣ S * d0 + R * e0)
    (hc1 : c ∣ S * d1 + R * e1) :
    ∃ y : ℤ,
      d1 = d0 + b *
        ((c.natAbs / c.natAbs.gcd K.natAbs : ℕ) : ℤ) * y ∧
      e1 = e0 - a *
        ((c.natAbs / c.natAbs.gcd K.natAbs : ℕ) : ℤ) * y := by
  let h : ℤ :=
    ((c.natAbs / c.natAbs.gcd K.natAbs : ℕ) : ℤ)
  let m : ℤ := a * d0 + b * e0
  let t0 : ℤ := B * d0 - A * e0
  let t1 : ℤ := B * d1 - A * e1
  have hdiv : c ∣ K * (t1 - t0) := by
    change c ∣ K * ((B * d1 - A * e1) -
      (B * d0 - A * e0))
    exact same_level_content_difference_general
      a b c S R K T d1 e1 d0 e0 A B
      hab hlevel hKdef hc1 hc0
  have hstep : h ∣ t1 - t0 :=
    gcd_progression_cancel c K (t1 - t0) hc hK hdiv
  obtain ⟨y, hy⟩ := hstep
  have ht : t1 = t0 + h * y := by
    linear_combination hy
  have hd0 : d0 = A * m + b * t0 := by
    simpa only [m, t0] using
      (original_inverse_coordinates a b A B d0 e0 hab).1
  have he0 : e0 = B * m - a * t0 := by
    simpa only [m, t0] using
      (original_inverse_coordinates a b A B d0 e0 hab).2
  have hd1 : d1 = A * m + b * t1 := by
    have h :=
      (original_inverse_coordinates a b A B d1 e1 hab).1
    rw [hlevel] at h
    simpa only [m, t1] using h
  have he1 : e1 = B * m - a * t1 := by
    have h :=
      (original_inverse_coordinates a b A B d1 e1 hab).2
    rw [hlevel] at h
    simpa only [m, t1] using h
  refine ⟨y, ?_, ?_⟩
  · change d1 = d0 + b * h * y
    linear_combination hd1 - hd0 + b * ht
  · change e1 = e0 - a * h * y
    linear_combination he1 - he0 - a * ht

private theorem anchored_progression_graph_values
    (k : ℕ) (P Q : MvPolynomial (Fin 2) ℤ)
    (a b c A B S R K T d0 e0 d1 e1 u1 v1 : ℤ)
    (f g : Polynomial ℤ)
    (hab : A * a + B * b = 1)
    (hc : c ≠ 0) (hK : K ≠ 0)
    (hKdef : K = b * S - a * R + c * T)
    (hlevel : a * d1 + b * e1 = a * d0 + b * e0)
    (hc0 : c ∣ S * d0 + R * e0)
    (hc1 : c ∣ S * d1 + R * e1)
    (hpure : MvPolynomial.X (1 : Fin 2) ^ k * P -
      MvPolynomial.X (0 : Fin 2) ^ k * Q =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ (2 * k + 1))
    (hunit1 : e1 ^ k * v1 - d1 ^ k * u1 = 1)
    (hgraph1 : MvPolynomial.eval ![d1, e1] P * u1 =
      MvPolynomial.eval ![d1, e1] Q * v1)
    (hfg : ∀ y : ℤ,
      c * f.eval y =
        MvPolynomial.eval ![d0 + b *
          ((c.natAbs / c.natAbs.gcd K.natAbs : ℕ) : ℤ) * y,
          e0 - a *
          ((c.natAbs / c.natAbs.gcd K.natAbs : ℕ) : ℤ) * y] P ∧
      c * g.eval y =
        MvPolynomial.eval ![d0 + b *
          ((c.natAbs / c.natAbs.gcd K.natAbs : ℕ) : ℤ) * y,
          e0 - a *
          ((c.natAbs / c.natAbs.gcd K.natAbs : ℕ) : ℤ) * y] Q) :
    ∃ y : ℤ,
      d1 = d0 + b *
        ((c.natAbs / c.natAbs.gcd K.natAbs : ℕ) : ℤ) * y ∧
      e1 = e0 - a *
        ((c.natAbs / c.natAbs.gcd K.natAbs : ℕ) : ℤ) * y ∧
      f.eval y = (a * d0 + b * e0) ^ (2 * k + 1) * v1 ∧
      g.eval y = (a * d0 + b * e0) ^ (2 * k + 1) * u1 := by
  obtain ⟨y, hd, he⟩ :=
    same_level_anchored_step a b c A B S R K T
      d0 e0 d1 e1 hab hc hK hKdef hlevel hc0 hc1
  let P1 : ℤ := MvPolynomial.eval ![d1, e1] P
  let Q1 : ℤ := MvPolynomial.eval ![d1, e1] Q
  let m : ℤ := a * d0 + b * e0
  have hpureEval := congrArg (MvPolynomial.eval ![d1, e1]) hpure
  have hpuree : e1 ^ k * P1 - d1 ^ k * Q1 =
      c * (a * d1 + b * e1) ^ (2 * k + 1) := by
    simpa [P1, Q1] using hpureEval
  obtain ⟨hP1, hQ1⟩ :=
    original_graph_values k a b c d1 e1 u1 v1 P1 Q1
      hpuree hgraph1 hunit1
  have hm : a * d1 + b * e1 = m := hlevel
  have hP1' : P1 = c * m ^ (2 * k + 1) * v1 := by
    simpa only [hm] using hP1
  have hQ1' : Q1 = c * m ^ (2 * k + 1) * u1 := by
    simpa only [hm] using hQ1
  obtain ⟨hf, hg⟩ := hfg y
  rw [← hd, ← he] at hf hg
  change c * f.eval y = P1 at hf
  change c * g.eval y = Q1 at hg
  refine ⟨y, hd, he, ?_, ?_⟩
  · apply mul_left_cancel₀ hc
    calc
      c * f.eval y = P1 := hf
      _ = c * (m ^ (2 * k + 1) * v1) := by rw [hP1']; ring
  · apply mul_left_cancel₀ hc
    calc
      c * g.eval y = Q1 := hg
      _ = c * (m ^ (2 * k + 1) * u1) := by rw [hQ1']; ring

open Polynomial
private theorem mod_zero_iff (p : ℕ) (F : Polynomial ℤ) :
    Polynomial.map (Int.castRingHom (ZMod p)) F = 0 ↔
      Polynomial.C (p : ℤ) ∣ F := by
  rw [Polynomial.ext_iff, Polynomial.C_dvd_iff_dvd_coeff]
  simp [ZMod.intCast_zmod_eq_zero_iff_dvd]
private theorem extract_content (p : ℕ) (k : ℕ) (F : Polynomial ℤ) :
    C ((p : ℤ) ^ k) ∣ F ∨
    ∃ v < k, ∃ H : Polynomial ℤ,
      F = C ((p : ℤ) ^ v) * H ∧
      Polynomial.map (Int.castRingHom (ZMod p)) H ≠ 0 := by
  induction k generalizing F with
  | zero => left; simp
  | succ k ih =>
    by_cases h : C (p : ℤ) ∣ F
    · obtain ⟨G, hG⟩ := h
      rcases ih G with hD | ⟨v, hv, H, hH, hn⟩
      · left
        obtain ⟨A, hA⟩ := hD
        refine ⟨A, ?_⟩
        rw [hG, hA, pow_succ', Polynomial.C_mul, mul_assoc]
      · right
        refine ⟨v + 1, by omega, H, ?_, hn⟩
        rw [hG, hH, pow_succ', Polynomial.C_mul, mul_assoc]
    · right
      refine ⟨0, by omega, F, by simp, ?_⟩
      intro hz
      exact h ((mod_zero_iff p F).mp hz)
private theorem coeff_scale (F : Polynomial ℤ) (c : ℤ) (j : ℕ) :
    (F.comp (C c * X)).coeff j = c ^ j * F.coeff j := by
  induction F using Polynomial.induction_on' with
  | add F G hF hG =>
    simp only [Polynomial.add_comp, Polynomial.coeff_add, hF, hG]
    ring
  | monomial n a =>
    simp only [← Polynomial.C_mul_X_pow_eq_monomial, Polynomial.mul_comp,
      Polynomial.C_comp, Polynomial.pow_comp, Polynomial.X_comp]
    simp only [mul_pow, ← Polynomial.C_pow, 
      Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
    split_ifs <;> simp_all ; ring
private theorem coeff_affine (F : Polynomial ℤ) (r p : ℤ) (j : ℕ) :
    (F.comp (C r + C p * X)).coeff j =
      p ^ j * ((taylor r) F).coeff j := by
  have h : C r + C p * X = (X + C r).comp (C p * X) := by
    simp
    ring
  rw [h, ← Polynomial.comp_assoc, ← Polynomial.taylor_apply]
  exact coeff_scale ((taylor r) F) p j
private theorem power_cancel (p : ℤ) (hp : p ≠ 0) (v : ℕ) (b : ℤ) :
    p ^ (v + 1) ∣ p ^ v * b ↔ p ∣ b := by
  constructor
  · rintro ⟨c, hc⟩
    refine ⟨c, ?_⟩
    apply mul_left_cancel₀ (pow_ne_zero v hp)
    calc
      p ^ v * b = p ^ (v + 1) * c := hc
      _ = p ^ v * (p * c) := by rw [pow_succ]; ring
  · rintro ⟨c, rfl⟩
    refine ⟨c, ?_⟩
    rw [pow_succ]
    ring
private theorem root_taylor_unit (p : ℕ) [Fact p.Prime]
    (F : Polynomial ℤ) (r : ℤ)
    (hF : Polynomial.map (Int.castRingHom (ZMod p)) F ≠ 0) :
    ¬ (p : ℤ) ∣ ((taylor r) F).coeff
      (rootMultiplicity (r : ZMod p)
        (Polynomial.map (Int.castRingHom (ZMod p)) F)) := by
  let B := Polynomial.map (Int.castRingHom (ZMod p)) F
  let m := rootMultiplicity (r : ZMod p) B
  have ht : (taylor (r : ZMod p)) B ≠ 0 := by
    intro hz
    exact hF ((Polynomial.taylor_eq_zero (r : ZMod p) B).mp hz)
  have hc := (Polynomial.coeff_natTrailingDegree_ne_zero).mpr ht
  have hm : m = ((taylor (r : ZMod p)) B).natTrailingDegree := by
    dsimp [m]
    rw [Polynomial.taylor_apply, Polynomial.rootMultiplicity_eq_natTrailingDegree]
  rw [← hm] at hc
  have hc' : (Polynomial.map (Int.castRingHom (ZMod p)) ((taylor r) F)).coeff m ≠ 0 := by
    rw [Polynomial.map_taylor]
    exact hc
  rw [Polynomial.coeff_map] at hc'
  exact fun h => hc' ((ZMod.intCast_zmod_eq_zero_iff_dvd _ p).mpr h)
private theorem root_degree_reduction (p : ℕ) [Fact p.Prime]
    (F H : Polynomial ℤ) (r : ℤ) (v : ℕ)
    (hF : Polynomial.map (Int.castRingHom (ZMod p)) F ≠ 0)
    (hroot : (Polynomial.map (Int.castRingHom (ZMod p)) F).IsRoot (r : ZMod p))
    (hH : Polynomial.map (Int.castRingHom (ZMod p)) H ≠ 0)
    (heq : F.comp (C r + C (p : ℤ) * X) = C ((p : ℤ) ^ v) * H) :
    1 ≤ v ∧
    v ≤ rootMultiplicity (r : ZMod p)
      (Polynomial.map (Int.castRingHom (ZMod p)) F) ∧
    (Polynomial.map (Int.castRingHom (ZMod p)) H).natDegree ≤
      rootMultiplicity (r : ZMod p)
        (Polynomial.map (Int.castRingHom (ZMod p)) F) := by
  let B := Polynomial.map (Int.castRingHom (ZMod p)) F
  let m := rootMultiplicity (r : ZMod p) B
  have hp : (p : ℤ) ≠ 0 := by
    exact_mod_cast (Fact.out : p.Prime).ne_zero
  have hc (j : ℕ) :
      (p : ℤ) ^ v * H.coeff j =
        (p : ℤ) ^ j * ((taylor r) F).coeff j := by
    calc
      (p : ℤ) ^ v * H.coeff j =
          (F.comp (C r + C (p : ℤ) * X)).coeff j := by
        rw [heq, Polynomial.coeff_C_mul]
      _ = (p : ℤ) ^ j * ((taylor r) F).coeff j := coeff_affine F r p j
  have hm : v ≤ m := by
    by_contra hn
    have hvm : m + 1 ≤ v := by omega
    have hd : (p : ℤ) ^ (m + 1) ∣ (p : ℤ) ^ v * H.coeff m :=
      dvd_mul_of_dvd_left (pow_dvd_pow (p : ℤ) hvm) _
    rw [hc m] at hd
    exact root_taylor_unit p F r hF ((power_cancel (p : ℤ) hp m _).mp hd)
  have hdeg : (Polynomial.map (Int.castRingHom (ZMod p)) H).natDegree ≤ m := by
    apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
    intro j hj
    rw [Polynomial.coeff_map]
    apply (ZMod.intCast_zmod_eq_zero_iff_dvd _ p).mpr
    apply (power_cancel (p : ℤ) hp v _).mp
    rw [hc j]
    exact dvd_mul_of_dvd_left (pow_dvd_pow (p : ℤ) (by omega)) _
  have hz : Polynomial.map (Int.castRingHom (ZMod p))
      (F.comp (C r + C (p : ℤ) * X)) = 0 := by
    rw [Polynomial.map_comp]
    have hp0 : (Int.castRingHom (ZMod p)) (p : ℤ) = 0 := by simp
    simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C,
      Polynomial.map_X, hp0, Polynomial.C_0, zero_mul, add_zero,
      Polynomial.comp_C]
    change C (B.eval (r : ZMod p)) = 0
    rw [hroot]
    simp
  have hv : 1 ≤ v := by
    by_contra hv
    have hv0 : v = 0 := by omega
    have he : F.comp (C r + C (p : ℤ) * X) = H := by simpa [hv0] using heq
    apply hH
    rw [← he]
    exact hz
  exact ⟨hv, hm, hdeg⟩
private theorem root_multiplicity_budget (p : ℕ) [Fact p.Prime]
    (B : Polynomial (ZMod p)) :
    ∑ r ∈ B.roots.toFinset, rootMultiplicity r B ≤ B.natDegree := by
  calc
    ∑ r ∈ B.roots.toFinset, rootMultiplicity r B =
        ∑ r ∈ B.roots.toFinset, Multiset.count r B.roots := by
      simp only [Polynomial.count_roots]
    _ = B.roots.card := Multiset.toFinset_sum_count_eq B.roots
    _ ≤ B.natDegree := Polynomial.card_roots' B
private theorem eval_reduce (p : ℕ) (F : Polynomial ℤ) (r : ℤ) :
    (Polynomial.map (Int.castRingHom (ZMod p)) F).eval (r : ZMod p) =
      ((F.eval r : ℤ) : ZMod p) := by
  have h := Polynomial.eval₂_at_apply (p := F) (Int.castRingHom (ZMod p)) r
  rw [← Polynomial.eval_map] at h
  simp
private theorem compose_affine (r J s K : ℤ) :
    (C r + C J * X).comp (C s + C K * X) =
      C (r + J * s) + C (J * K) * X := by
  simp only [Polynomial.add_comp, Polynomial.mul_comp,
    Polynomial.C_comp, Polynomial.X_comp, Polynomial.C_add, Polynomial.C_mul]
  ring
private theorem cancel_pow_div {R : Type*} [CommRing R] [IsDomain R]
    (p : R) (hp : p ≠ 0) (v k : ℕ) (hv : v ≤ k) (b : R) :
    p ^ k ∣ p ^ v * b ↔ p ^ (k - v) ∣ b := by
  have hk : v + (k - v) = k := Nat.add_sub_of_le hv
  have hpow : p ^ k = p ^ v * p ^ (k - v) := by rw [← pow_add, hk]
  constructor
  · rintro ⟨c, hc⟩
    refine ⟨c, ?_⟩
    apply mul_left_cancel₀ (pow_ne_zero v hp)
    calc
      p ^ v * b = p ^ k * c := hc
      _ = p ^ v * (p ^ (k - v) * c) := by rw [hpow, mul_assoc]
  · rintro ⟨c, rfl⟩
    refine ⟨c, ?_⟩
    rw [← mul_assoc, ← pow_add, hk]
private noncomputable def classAffine (p : ℕ) (s : ℤ × ℕ) : Polynomial ℤ :=
  C s.1 + C ((p : ℤ) ^ s.2) * X
private def liftClass (p : ℕ) (r : ℤ) (s : ℤ × ℕ) : ℤ × ℕ :=
  (r + (p : ℤ) * s.1, s.2 + 1)
private theorem lift_comp (p : ℕ) (r : ℤ) (s : ℤ × ℕ) :
    (C r + C (p : ℤ) * X).comp (classAffine p s) =
      classAffine p (liftClass p r s) := by
  rw [classAffine, compose_affine]
  simp only [classAffine, liftClass,   pow_succ']
private theorem lift_certificate (p k v : ℕ) (hv : v ≤ k)
    (F H : Polynomial ℤ) (r : ℤ) (s : ℤ × ℕ)
    (heq : F.comp (C r + C (p : ℤ) * X) = C ((p : ℤ) ^ v) * H)
    (h : C ((p : ℤ) ^ (k - v)) ∣ H.comp (classAffine p s)) :
    C ((p : ℤ) ^ k) ∣ F.comp (classAffine p (liftClass p r s)) := by
  obtain ⟨A, hA⟩ := h
  refine ⟨A, ?_⟩
  rw [← lift_comp, ← Polynomial.comp_assoc, heq, Polynomial.mul_comp,
    Polynomial.C_comp, hA, ← mul_assoc, ← Polynomial.C_mul,
    ← pow_add, Nat.add_sub_of_le hv]
set_option maxHeartbeats 1200000
set_option maxRecDepth 2000
private theorem primitive_cover (p : ℕ) [Fact p.Prime] :
    ∀ k : ℕ, 0 < k → ∀ F : Polynomial ℤ,
      Polynomial.map (Int.castRingHom (ZMod p)) F ≠ 0 →
      ∃ S : Finset (ℤ × ℕ),
        S.card ≤ (Polynomial.map (Int.castRingHom (ZMod p)) F).natDegree ∧
        (∀ s ∈ S, s.2 ≤ k ∧
          C ((p : ℤ) ^ k) ∣ F.comp (classAffine p s)) ∧
        (∀ r : ℤ, (p : ℤ) ^ k ∣ F.eval r →
          ∃ s ∈ S, ∃ t : ℤ, r = s.1 + (p : ℤ) ^ s.2 * t) := by
  classical
  intro k
  induction k using Nat.strong_induction_on with
  | h k ih =>
    intro hk F hF
    let B := Polynomial.map (Int.castRingHom (ZMod p)) F
    let roots := B.roots.toFinset
    have hp : (p : ℤ) ≠ 0 := by
      exact_mod_cast (Fact.out : p.Prime).ne_zero
    have branch (a : {a : ZMod p // a ∈ roots}) :
        ∃ S : Finset (ℤ × ℕ),
          S.card ≤ rootMultiplicity a.1 B ∧
          (∀ s ∈ S, s.2 ≤ k ∧ C ((p : ℤ) ^ k) ∣ F.comp (classAffine p s)) ∧
          (∀ r : ℤ, (r : ZMod p) = a.1 → (p : ℤ) ^ k ∣ F.eval r →
            ∃ s ∈ S, ∃ t : ℤ, r = s.1 + (p : ℤ) ^ s.2 * t) := by
      let r0 : ℤ := a.1.val
      have har : (r0 : ZMod p) = a.1 := by
        simp [r0]
      have hamem : a.1 ∈ B.roots := Multiset.mem_toFinset.mp a.2
      have ha : B.IsRoot a.1 := (Polynomial.mem_roots hF).mp hamem
      have hm : 0 < rootMultiplicity a.1 B := (Polynomial.rootMultiplicity_pos hF).mpr ha
      have residue (r : ℤ) (hr : (r : ZMod p) = a.1) :
          ∃ z : ℤ, r = r0 + (p : ℤ) * z := by
        have hd : (p : ℤ) ∣ r - r0 := by
          apply (ZMod.intCast_zmod_eq_zero_iff_dvd _ p).mp
          push_cast
          rw [hr, har, sub_self]
        obtain ⟨z, hz⟩ := hd
        exact ⟨z, by linarith⟩
      rcases extract_content p k (F.comp (C r0 + C (p : ℤ) * X)) with
        hD | ⟨v, hv, H, heq, hH⟩
      · refine ⟨{(r0, 1)}, ?_, ?_, ?_⟩
        · simp only [Finset.card_singleton]
          omega
        · intro s hs
          have hs' : s = (r0, 1) := Finset.mem_singleton.mp hs
          subst s
          refine ⟨hk, ?_⟩
          simpa only [classAffine, Prod.fst, Prod.snd, pow_one] using hD
        · intro r hr hd
          obtain ⟨z, hz⟩ := residue r hr
          exact ⟨(r0, 1), Finset.mem_singleton_self _, z, by simpa only [pow_one] using hz⟩
      · have hred := root_degree_reduction p F H r0 v hF
          (by simpa only [har] using ha) hH heq
        obtain ⟨S, hSc, hSg, hSv⟩ := ih (k - v) (by omega) (by omega) H hH
        refine ⟨S.image (liftClass p r0), ?_, ?_, ?_⟩
        · exact (Finset.card_image_le).trans (hSc.trans (by simpa only [har] using hred.2.2))
        · intro s hs
          obtain ⟨b, hb, rfl⟩ := Finset.mem_image.mp hs
          obtain ⟨hbexp, hbdiv⟩ := hSg b hb
          refine ⟨by dsimp [liftClass]; omega, ?_⟩
          exact lift_certificate p k v (by omega) F H r0 b heq hbdiv
        · intro r hr hd
          obtain ⟨z, hz⟩ := residue r hr
          have heval := congrArg (fun Q : Polynomial ℤ => Q.eval z) heq
          simp only [Polynomial.eval_comp, Polynomial.eval_add, Polynomial.eval_C,
            Polynomial.eval_mul, Polynomial.eval_X] at heval
          rw [← hz] at heval
          have hdH : (p : ℤ) ^ (k - v) ∣ H.eval z := by
            apply (cancel_pow_div (p : ℤ) hp v k (by omega) (H.eval z)).mp
            rw [← heval]
            exact hd
          obtain ⟨b, hb, t, ht⟩ := hSv z hdH
          refine ⟨liftClass p r0 b, Finset.mem_image.mpr ⟨b, hb, rfl⟩, t, ?_⟩
          dsimp [liftClass]
          rw [hz, ht, pow_succ']
          ring
    choose R hRc hRg hRv using branch
    let S := roots.attach.biUnion R
    refine ⟨S, ?_, ?_, ?_⟩
    · calc
        S.card ≤ ∑ a ∈ roots.attach, (R a).card := Finset.card_biUnion_le
        _ ≤ ∑ a ∈ roots.attach, rootMultiplicity a.1 B :=
          Finset.sum_le_sum (fun a _ => hRc a)
        _ = ∑ a ∈ roots, rootMultiplicity a B := Finset.sum_attach roots (fun a : ZMod p => rootMultiplicity a B)
        _ ≤ B.natDegree := root_multiplicity_budget p B
    · intro s hs
      obtain ⟨a, ha, hs⟩ := Finset.mem_biUnion.mp hs
      exact hRg a s hs
    · intro r hd
      have hpd : (p : ℤ) ∣ (p : ℤ) ^ k := by
        have hpow := pow_dvd_pow (p : ℤ) (show 1 ≤ k by omega)
        simpa only [pow_one] using hpow
      have hpr : (p : ℤ) ∣ F.eval r := hpd.trans hd
      have hroot : B.IsRoot (r : ZMod p) := by
        change (Polynomial.map (Int.castRingHom (ZMod p)) F).eval (r : ZMod p) = 0
        rw [eval_reduce]
        exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ p).mpr hpr
      have ha : (r : ZMod p) ∈ roots :=
        Multiset.mem_toFinset.mpr ((Polynomial.mem_roots hF).mpr hroot)
      let a : {a : ZMod p // a ∈ roots} := ⟨r, ha⟩
      obtain ⟨s, hs, t, ht⟩ := hRv a r rfl hd
      exact ⟨s, Finset.mem_biUnion.mpr ⟨a, Finset.mem_attach _ _, hs⟩, t, ht⟩
private theorem restore_content (p k v : ℕ) (hv : v ≤ k)
    (F H A : Polynomial ℤ)
    (heq : F = C ((p : ℤ) ^ v) * H)
    (h : C ((p : ℤ) ^ (k - v)) ∣ H.comp A) :
    C ((p : ℤ) ^ k) ∣ F.comp A := by
  obtain ⟨G, hG⟩ := h
  refine ⟨G, ?_⟩
  rw [heq, Polynomial.mul_comp, Polynomial.C_comp, hG,
    ← mul_assoc, ← Polynomial.C_mul, ← pow_add, Nat.add_sub_of_le hv]
private theorem affine_top_coeff_general
    (t : ℕ) (F : Polynomial ℤ) (hdeg : F.natDegree = t)
    (center step : ℤ) :
    (F.comp (C center + C step * X)).coeff t =
      step ^ t * F.coeff t := by
  rw [coeff_affine]
  congr 1
  first
  | have ht := Polynomial.leadingCoeff_taylor center F
    simpa [Polynomial.leadingCoeff, Polynomial.natDegree_taylor,
      hdeg] using ht
  | have ht := Polynomial.leadingCoeff_taylor F center
    simpa [Polynomial.leadingCoeff, Polynomial.natDegree_taylor,
      hdeg] using ht
  | simpa [Polynomial.coeff_taylor, hdeg]
  | exact?

private theorem certified_depth_ge_general
    (p r k t : ℕ) (F : Polynomial ℤ) (s : ℤ × ℕ)
    (hp : p.Prime) (hk : 0 < k)
    (hrange : t * (k - 1) ≤ r)
    (hcrit : ¬ ((p : ℤ) ^ (r - t * (k - 1)) ∣ F.coeff t))
    (htop : ∀ s : ℤ × ℕ,
      (F.comp (classAffine p s)).coeff t =
        (p : ℤ) ^ (t * s.2) * F.coeff t)
    (hcert : C ((p : ℤ) ^ r) ∣ F.comp (classAffine p s)) :
    k ≤ s.2 := by
  by_contra hnot
  have hj : s.2 ≤ k - 1 := by omega
  have h5j : t * s.2 ≤ r := by
    have hm := Nat.mul_le_mul_left t hj
    omega
  have hcoeff :
      (p : ℤ) ^ r ∣ (F.comp (classAffine p s)).coeff t :=
    ((Polynomial.C_dvd_iff_dvd_coeff
      ((p : ℤ) ^ r) (F.comp (classAffine p s))).mp hcert) t
  rw [htop s] at hcoeff
  have hp0 : (p : ℤ) ≠ 0 := by exact_mod_cast hp.ne_zero
  have hpow :
      (p : ℤ) ^ (r - t * s.2) ∣ F.coeff t :=
    (cancel_pow_div (p : ℤ) hp0 (t * s.2) r h5j (F.coeff t)).mp hcoeff
  have hle : r - t * (k - 1) ≤ r - t * s.2 := by
    have hm := Nat.mul_le_mul_left t hj
    omega
  exact hcrit ((pow_dvd_pow (p : ℤ) hle).trans hpow)

private theorem covered_centers_at_fixed_depth
    (p r k t : ℕ) (F : Polynomial ℤ) (S : Finset (ℤ × ℕ))
    (hcard : S.card ≤ t)
    (hdepth : ∀ s ∈ S, k ≤ s.2)
    (hcover : ∀ z : ℤ, (p : ℤ) ^ r ∣ F.eval z →
      ∃ s ∈ S, ∃ t : ℤ, z = s.1 + (p : ℤ) ^ s.2 * t) :
    ∃ T : Finset ℤ, T.card ≤ t ∧
      ∀ z : ℤ, (p : ℤ) ^ r ∣ F.eval z →
        ∃ a ∈ T, (p : ℤ) ^ k ∣ z - a := by
  classical
  refine ⟨S.image Prod.fst, (Finset.card_image_le).trans hcard, ?_⟩
  intro z hz
  obtain ⟨s, hs, t, ht⟩ := hcover z hz
  refine ⟨s.1, Finset.mem_image.mpr ⟨s, hs, rfl⟩, ?_⟩
  rw [ht]
  have hpow : (p : ℤ) ^ k ∣ (p : ℤ) ^ s.2 :=
    pow_dvd_pow (p : ℤ) (hdepth s hs)
  simpa only [add_sub_cancel_left] using dvd_mul_of_dvd_left hpow t

private theorem fixed_depth_general_from_generic_cover
    (p r k t : ℕ) [Fact p.Prime] (F : Polynomial ℤ)
    (hdeg : F.natDegree = t)
    (hr : 0 < r) (hk : 0 < k)
    (hrange : t * (k - 1) ≤ r)
    (hcrit : ¬ ((p : ℤ) ^ (r - t * (k - 1)) ∣ F.coeff t))
    (htop : ∀ s : ℤ × ℕ,
      (F.comp (classAffine p s)).coeff t =
        (p : ℤ) ^ (t * s.2) * F.coeff t) :
    ∃ T : Finset ℤ, T.card ≤ t ∧
      ∀ z : ℤ, (p : ℤ) ^ r ∣ F.eval z →
        ∃ a ∈ T, (p : ℤ) ^ k ∣ z - a := by
  classical
  let hp : p.Prime := Fact.out
  have hp0 : (p : ℤ) ≠ 0 := by exact_mod_cast hp.ne_zero
  rcases extract_content p r F with hAll | ⟨v, hv, H, heq, hH⟩
  · have hcoef : (p : ℤ) ^ r ∣ F.coeff t :=
      ((Polynomial.C_dvd_iff_dvd_coeff
        ((p : ℤ) ^ r) F).mp hAll) t
    have hpow : (p : ℤ) ^ (r - t * (k - 1)) ∣
        (p : ℤ) ^ r :=
      pow_dvd_pow (p : ℤ) (by omega)
    exact False.elim (hcrit (hpow.trans hcoef))
  · have hvle : v ≤ r := by omega
    have hHdeg : H.natDegree ≤ t := by
      apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
      intro j hj
      have hFdeg : F.natDegree ≤ t := by omega
      have hzF : F.coeff j = 0 :=
        (Polynomial.natDegree_le_iff_coeff_eq_zero.mp hFdeg) j hj
      rw [heq, Polynomial.coeff_C_mul] at hzF
      apply mul_left_cancel₀ (pow_ne_zero v hp0)
      simpa only [mul_zero] using hzF
    have hmapdeg :
        (Polynomial.map (Int.castRingHom (ZMod p)) H).natDegree ≤ t := by
      apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
      intro j hj
      rw [Polynomial.coeff_map]
      rw [(Polynomial.natDegree_le_iff_coeff_eq_zero.mp hHdeg) j hj]
      simp
    obtain ⟨S, hSc, hSg, hSv⟩ :=
      primitive_cover p (r - v) (by omega) H hH
    have hdepth : ∀ s ∈ S, k ≤ s.2 := by
      intro s hs
      have hcert : C ((p : ℤ) ^ r) ∣
          F.comp (classAffine p s) :=
        restore_content p r v hvle F H (classAffine p s)
          heq (hSg s hs).2
      exact certified_depth_ge_general p r k t F s hp hk hrange
        hcrit htop hcert
    have hcover : ∀ z : ℤ, (p : ℤ) ^ r ∣ F.eval z →
        ∃ s ∈ S, ∃ t : ℤ,
          z = s.1 + (p : ℤ) ^ s.2 * t := by
      intro z hz
      have heval : F.eval z = (p : ℤ) ^ v * H.eval z := by
        rw [heq]
        simp
      have hzH : (p : ℤ) ^ (r - v) ∣ H.eval z :=
        (cancel_pow_div (p : ℤ) hp0 v r hvle (H.eval z)).mp
          (by simpa only [heval] using hz)
      exact hSv z hzH
    exact covered_centers_at_fixed_depth p r k t F S
      (hSc.trans hmapdeg) hdepth hcover

private theorem fixed_depth_general_complete
    (p r k t : ℕ) [Fact p.Prime] (F : Polynomial ℤ)
    (hdeg : F.natDegree = t)
    (hr : 0 < r) (hk : 0 < k)
    (hrange : t * (k - 1) ≤ r)
    (hcrit : ¬ ((p : ℤ) ^ (r - t * (k - 1)) ∣ F.coeff t)) :
    ∃ T : Finset ℤ, T.card ≤ t ∧
      ∀ z : ℤ, (p : ℤ) ^ r ∣ F.eval z →
        ∃ a ∈ T, (p : ℤ) ^ k ∣ z - a := by
  apply fixed_depth_general_from_generic_cover p r k t F
    hdeg hr hk hrange hcrit
  intro s
  simpa only [classAffine, ← pow_mul, Nat.mul_comm s.2 t] using
    affine_top_coeff_general t F hdeg s.1 ((p : ℤ) ^ s.2)

private theorem prime_coordinate_choice
    (p : ℕ) (hp : p.Prime)
    (a b A B : ℤ) (hab : A * a + B * b = 1) :
    ¬ (p : ℤ) ∣ b ∨ ¬ (p : ℤ) ∣ a := by
  by_cases hb : (p : ℤ) ∣ b
  · right
    intro ha
    have hpa : (p : ℤ) ∣ A * a := by
      simpa only [mul_comm] using dvd_mul_of_dvd_right ha A
    have hpb : (p : ℤ) ∣ B * b := by
      simpa only [mul_comm] using dvd_mul_of_dvd_right hb B
    have hpone : (p : ℤ) ∣ (1 : ℤ) := by
      rw [← hab]
      exact dvd_add hpa hpb
    have hpN : p ∣ (1 : ℕ) := by
      have h := (Int.natAbs_dvd_natAbs).2 hpone
      simpa using h
    exact hp.ne_one (Nat.dvd_one.mp hpN)
  · exact Or.inl hb

private theorem original_selected_local_cover
    (k p r delta : ℕ) [Fact p.Prime]
    (a b A B q h m : ℤ) (f g : Polynomial ℤ)
    (hab : A * a + B * b = 1)
    (hq0 : q ≠ 0) (hh0 : h ≠ 0)
    (hfdeg : f.natDegree ≤ k + 1)
    (hgdeg : g.natDegree ≤ k + 1)
    (hftop : f.coeff (k + 1) = q * h ^ k * b ^ k)
    (hgtop : g.coeff (k + 1) =
      (-1 : ℤ) ^ k * q * h ^ k * a ^ k)
    (hr : 0 < r) (hdelta : 0 < delta)
    (hrange : (k + 1) * (delta - 1) ≤ r)
    (hmdiv : (p : ℤ) ^ r ∣ m ^ (2 * k + 1))
    (hcrit : ¬ ((p : ℤ) ^
      (r - (k + 1) * (delta - 1)) ∣
      if (p : ℤ) ∣ b then
        (-1 : ℤ) ^ k * q * h ^ k * a ^ k
      else q * h ^ k * b ^ k)) :
    ∃ T : Finset ℤ, T.card ≤ k + 1 ∧
      ∀ z u v : ℤ,
        f.eval z = m ^ (2 * k + 1) * v →
        g.eval z = m ^ (2 * k + 1) * u →
        ∃ center ∈ T, (p : ℤ) ^ delta ∣ z - center := by
  classical
  let F : Polynomial ℤ := if (p : ℤ) ∣ b then g else f
  have hdegree : F.natDegree = k + 1 := by
    by_cases hb : (p : ℤ) ∣ b
    · have hna : ¬ (p : ℤ) ∣ a :=
        (prime_coordinate_choice p Fact.out a b A B hab).resolve_left
          (not_not.mpr hb)
      have ha0 : a ≠ 0 := by
        intro ha
        exact hna (by simp [ha])
      apply le_antisymm (by simpa [F, hb] using hgdeg)
      apply Polynomial.le_natDegree_of_ne_zero
      simp only [F, if_pos hb, hgtop]
      exact mul_ne_zero
        (mul_ne_zero
          (mul_ne_zero (pow_ne_zero k (by norm_num)) hq0)
          (pow_ne_zero k hh0))
        (pow_ne_zero k ha0)
    · have hb0 : b ≠ 0 := by
        intro hz
        exact hb (by simp [hz])
      apply le_antisymm (by simpa [F, hb] using hfdeg)
      apply Polynomial.le_natDegree_of_ne_zero
      simp only [F, if_neg hb, hftop]
      exact mul_ne_zero
        (mul_ne_zero hq0 (pow_ne_zero k hh0))
        (pow_ne_zero k hb0)
  have hcoeff : F.coeff (k + 1) =
      if (p : ℤ) ∣ b then
        (-1 : ℤ) ^ k * q * h ^ k * a ^ k
      else q * h ^ k * b ^ k := by
    by_cases hb : (p : ℤ) ∣ b
    · simp [F, hb, hgtop]
    · simp [F, hb, hftop]
  have hcritF : ¬ ((p : ℤ) ^
      (r - (k + 1) * (delta - 1)) ∣ F.coeff (k + 1)) := by
    rw [hcoeff]
    exact hcrit
  obtain ⟨T, hTc, hTcover⟩ :=
    fixed_depth_general_complete p r delta (k + 1) F
      hdegree hr hdelta hrange hcritF
  refine ⟨T, hTc, ?_⟩
  intro z u v hf hg
  have hFval : F.eval z =
      m ^ (2 * k + 1) * (if (p : ℤ) ∣ b then u else v) := by
    by_cases hb : (p : ℤ) ∣ b
    · simpa [F, hb] using hg
    · simpa [F, hb] using hf
  have hpval : (p : ℤ) ^ r ∣ F.eval z := by
    rw [hFval]
    exact dvd_mul_of_dvd_left hmdiv _
  exact hTcover z hpval

theorem padic_unit_general
    (p k : ℕ) [Fact p.Prime] (N s : ℤ)
    (hN : N ≠ 0) (hsunit : ¬ (p : ℤ) ∣ s) :
    padicValNat p ((N * s ^ k).natAbs) =
      padicValNat p N.natAbs := by
  have hs0 : s ≠ 0 := by
    intro hzero
    exact hsunit (by simp [hzero])
  have hNabs0 : N.natAbs ≠ 0 :=
    Nat.ne_of_gt (Int.natAbs_pos.mpr hN)
  have hsabs0 : s.natAbs ≠ 0 :=
    Nat.ne_of_gt (Int.natAbs_pos.mpr hs0)
  have hsnot : ¬ p ∣ s.natAbs := by
    intro h
    exact hsunit ((Int.natAbs_dvd_natAbs).1 (by simpa using h))
  have hsval0 : padicValNat p s.natAbs = 0 := by
    by_contra hn
    have hvalpos : 1 ≤ padicValNat p s.natAbs := by omega
    have hdiv : p ^ 1 ∣ s.natAbs :=
      (padicValNat_dvd_iff_le hsabs0).2 hvalpos
    exact hsnot (by simpa using hdiv)
  calc
    padicValNat p ((N * s ^ k).natAbs) =
        padicValNat p (N.natAbs * s.natAbs ^ k) := by
          simp [Int.natAbs_mul, Int.natAbs_pow]
    _ = padicValNat p N.natAbs +
        padicValNat p (s.natAbs ^ k) := by
          exact padicValNat.mul hNabs0 (pow_ne_zero k hsabs0)
    _ = padicValNat p N.natAbs := by
          rw [padicValNat.pow, hsval0]
          omega

theorem padic_noncritical_general
    (p k : ℕ) [Fact p.Prime] (N s : ℤ)
    (hN : N ≠ 0) (hsunit : ¬ (p : ℤ) ∣ s)
    (t : ℕ) (ht : padicValNat p N.natAbs < t) :
    ¬ ((p : ℤ) ^ t ∣ N * s ^ k) := by
  intro hdiv
  have hNat : p ^ t ∣ (N * s ^ k).natAbs := by
    have h := (Int.natAbs_dvd_natAbs).2 hdiv
    simpa using h
  have hprod0 : (N * s ^ k).natAbs ≠ 0 := by
    have hs0 : s ≠ 0 := by
      intro hz
      exact hsunit (by simp [hz])
    exact Nat.ne_of_gt (Int.natAbs_pos.mpr
      (mul_ne_zero hN (pow_ne_zero k hs0)))
  have hle : t ≤ padicValNat p ((N * s ^ k).natAbs) :=
    (padicValNat_dvd_iff_le hprod0).1 hNat
  rw [padic_unit_general p k N s hN hsunit] at hle
  omega

private def originalDepth (k r w : ℕ) : ℕ :=
  if r ≤ w then 0 else (r - w - 1) / (k + 1) + 1

private theorem originalDepth_budget (k r w : ℕ) :
    (k + 1) * originalDepth k r w + w ≥ r := by
  unfold originalDepth
  by_cases h : r ≤ w
  · simp only [if_pos h]
    omega
  · simp only [if_neg h]
    let z : ℕ := r - w - 1
    have hz : r = w + z + 1 := by
      dsimp [z]
      omega
    have ht : 0 < k + 1 := by omega
    have hdiv : z % (k + 1) + (k + 1) * (z / (k + 1)) = z :=
      Nat.mod_add_div z (k + 1)
    have hmod : z % (k + 1) < k + 1 :=
      Nat.mod_lt z ht
    have hmul :
        (k + 1) * (z / (k + 1) + 1) =
          (k + 1) * (z / (k + 1)) + (k + 1) := by ring
    change (k + 1) * (z / (k + 1) + 1) + w ≥ r
    omega

private theorem originalDepth_critical (k r w : ℕ)
    (hwr : w < r) :
    0 < originalDepth k r w ∧
    (k + 1) * (originalDepth k r w - 1) ≤ r ∧
    w < r - (k + 1) * (originalDepth k r w - 1) := by
  have hnot : ¬ r ≤ w := by omega
  unfold originalDepth
  simp only [if_neg hnot]
  let z : ℕ := r - w - 1
  have hz : r = w + z + 1 := by
    dsimp [z]
    omega
  have hdiv : z % (k + 1) + (k + 1) * (z / (k + 1)) = z :=
    Nat.mod_add_div z (k + 1)
  have hq : z / (k + 1) + 1 - 1 = z / (k + 1) := by simp
  change 0 < z / (k + 1) + 1 ∧
    (k + 1) * (z / (k + 1) + 1 - 1) ≤ r ∧
    w < r - (k + 1) * (z / (k + 1) + 1 - 1)
  rw [hq]
  omega

private theorem originalDepth_padic_bridge
    (k p : ℕ) [Fact p.Prime]
    (a b A B m N : ℤ)
    (hab : A * a + B * b = 1)
    (hm0 : m ≠ 0) (hN0 : N ≠ 0) :
    let r := padicValNat p (m ^ (2 * k + 1)).natAbs
    let w := padicValNat p N.natAbs
    let delta := originalDepth k r w
    (k + 1) * delta + w ≥ r ∧
    (0 < delta →
      0 < r ∧
      (k + 1) * (delta - 1) ≤ r ∧
      (p : ℤ) ^ r ∣ m ^ (2 * k + 1) ∧
      ¬ ((p : ℤ) ^ (r - (k + 1) * (delta - 1)) ∣
        if (p : ℤ) ∣ b then
          (-1 : ℤ) ^ k * N * a ^ k
        else N * b ^ k)) := by
  let n : ℕ := (m ^ (2 * k + 1)).natAbs
  let r : ℕ := padicValNat p n
  let w : ℕ := padicValNat p N.natAbs
  let delta : ℕ := originalDepth k r w
  change (k + 1) * delta + w ≥ r ∧
    (0 < delta →
      0 < r ∧
      (k + 1) * (delta - 1) ≤ r ∧
      (p : ℤ) ^ r ∣ m ^ (2 * k + 1) ∧
      ¬ ((p : ℤ) ^ (r - (k + 1) * (delta - 1)) ∣
        if (p : ℤ) ∣ b then
          (-1 : ℤ) ^ k * N * a ^ k
        else N * b ^ k))
  constructor
  · exact originalDepth_budget k r w
  · intro hdelta
    have hwr : w < r := by
      by_contra hn
      have hle : r ≤ w := by omega
      have hzero : delta = 0 := by
        simp [delta, originalDepth, hle]
      omega
    obtain ⟨_, hrange, hcrit⟩ := originalDepth_critical k r w hwr
    have hrpos : 0 < r := by omega
    have hmexp0 : m ^ (2 * k + 1) ≠ 0 :=
      pow_ne_zero _ hm0
    have hn0 : n ≠ 0 := Nat.ne_of_gt (Int.natAbs_pos.mpr hmexp0)
    have hnat : p ^ r ∣ n :=
      (padicValNat_dvd_iff_le hn0).2 (le_refl r)
    have hint : (p : ℤ) ^ r ∣ m ^ (2 * k + 1) :=
      (Int.natAbs_dvd_natAbs).1 (by simpa [n] using hnat)
    refine ⟨hrpos, hrange, hint, ?_⟩
    have hchoice := prime_coordinate_choice p Fact.out a b A B hab
    by_cases hb : (p : ℤ) ∣ b
    · have haunit : ¬ (p : ℤ) ∣ a :=
        hchoice.resolve_left (not_not.mpr hb)
      have hsignAbs :
          (((-1 : ℤ) ^ k * N).natAbs) = N.natAbs := by
        simp [Int.natAbs_mul, Int.natAbs_pow]
      have hsign0 : (-1 : ℤ) ^ k * N ≠ 0 :=
        mul_ne_zero (pow_ne_zero _ (by norm_num)) hN0
      have hw' :
          padicValNat p (((-1 : ℤ) ^ k * N).natAbs) = w := by
        rw [hsignAbs]
      have hnon :=
        padic_noncritical_general p k ((-1 : ℤ) ^ k * N) a
          hsign0 haunit (r - (k + 1) * (delta - 1))
          (by rw [hw']; exact hcrit)
      simpa only [if_pos hb, mul_assoc] using hnon
    · have hbunit : ¬ (p : ℤ) ∣ b := hb
      have hnon :=
        padic_noncritical_general p k N b hN0 hbunit
          (r - (k + 1) * (delta - 1)) hcrit
      simpa only [if_neg hb] using hnon

private theorem original_selected_local_cover_padic
    (k p : ℕ) [Fact p.Prime]
    (a b A B q h m : ℤ) (f g : Polynomial ℤ)
    (hab : A * a + B * b = 1)
    (hm0 : m ≠ 0) (hq0 : q ≠ 0) (hh0 : h ≠ 0)
    (hfdeg : f.natDegree ≤ k + 1)
    (hgdeg : g.natDegree ≤ k + 1)
    (hftop : f.coeff (k + 1) = q * h ^ k * b ^ k)
    (hgtop : g.coeff (k + 1) =
      (-1 : ℤ) ^ k * q * h ^ k * a ^ k) :
    let N : ℤ := q * h ^ k
    let r := padicValNat p (m ^ (2 * k + 1)).natAbs
    let w := padicValNat p N.natAbs
    let delta := originalDepth k r w
    0 < delta →
      ∃ T : Finset ℤ, T.card ≤ k + 1 ∧
        ∀ z u v : ℤ,
          f.eval z = m ^ (2 * k + 1) * v →
          g.eval z = m ^ (2 * k + 1) * u →
          ∃ center ∈ T, (p : ℤ) ^ delta ∣ z - center := by
  let N : ℤ := q * h ^ k
  let r := padicValNat p (m ^ (2 * k + 1)).natAbs
  let w := padicValNat p N.natAbs
  let delta := originalDepth k r w
  change 0 < delta →
    ∃ T : Finset ℤ, T.card ≤ k + 1 ∧
      ∀ z u v : ℤ,
        f.eval z = m ^ (2 * k + 1) * v →
        g.eval z = m ^ (2 * k + 1) * u →
        ∃ center ∈ T, (p : ℤ) ^ delta ∣ z - center
  intro hdelta
  have hN0 : N ≠ 0 := mul_ne_zero hq0 (pow_ne_zero k hh0)
  have hbridge := originalDepth_padic_bridge k p a b A B m N
    hab hm0 hN0
  change (k + 1) * delta + w ≥ r ∧
    (0 < delta →
      0 < r ∧
      (k + 1) * (delta - 1) ≤ r ∧
      (p : ℤ) ^ r ∣ m ^ (2 * k + 1) ∧
      ¬ ((p : ℤ) ^ (r - (k + 1) * (delta - 1)) ∣
        if (p : ℤ) ∣ b then
          (-1 : ℤ) ^ k * N * a ^ k
        else N * b ^ k)) at hbridge
  obtain ⟨hrpos, hrange, hmdiv, hcrit⟩ := hbridge.2 hdelta
  have hcrit' :
      ¬ ((p : ℤ) ^ (r - (k + 1) * (delta - 1)) ∣
        if (p : ℤ) ∣ b then
          (-1 : ℤ) ^ k * q * h ^ k * a ^ k
        else q * h ^ k * b ^ k) := by
    simpa only [N, mul_assoc] using hcrit
  exact original_selected_local_cover k p r delta
    a b A B q h m f g hab hq0 hh0
    hfdeg hgdeg hftop hgtop
    hrpos hdelta hrange hmdiv hcrit'

private theorem originalModulus_budget
    (k n N : ℕ) (hn : n ≠ 0) (hN : N ≠ 0) :
    let s := n.primeFactors
    let delta : ℕ → ℕ := fun p =>
      originalDepth k (padicValNat p n) (padicValNat p N)
    let W := ∏ p ∈ s, p ^ delta p
    0 < W ∧ n ∣ W ^ (k + 1) * N := by
  let s := n.primeFactors
  let delta : ℕ → ℕ := fun p =>
    originalDepth k (padicValNat p n) (padicValNat p N)
  let W := ∏ p ∈ s, p ^ delta p
  change 0 < W ∧ n ∣ W ^ (k + 1) * N
  have hsprime : ∀ p ∈ s, p.Prime := by
    intro p hp
    exact (Nat.mem_primeFactors.mp hp).1
  have hWpos : 0 < W := by
    dsimp [W]
    apply Finset.prod_pos
    intro p hp
    exact pow_pos (hsprime p hp).pos _
  have hW0 : W ≠ 0 := Nat.ne_of_gt hWpos
  have htarget0 : W ^ (k + 1) * N ≠ 0 :=
    mul_ne_zero (pow_ne_zero (k + 1) hW0) hN
  refine ⟨hWpos, ?_⟩
  apply (Nat.factorization_le_iff_dvd hn htarget0).mp
  change ∀ p : ℕ,
    n.factorization p ≤ (W ^ (k + 1) * N).factorization p
  intro p
  by_cases hp : p.Prime
  · letI : Fact p.Prime := ⟨hp⟩
    rw [Nat.factorization_def n hp,
      Nat.factorization_def (W ^ (k + 1) * N) hp]
    by_cases hmem : p ∈ s
    · have hdiv : p ^ delta p ∣ W := by
        dsimp [W]
        exact Finset.dvd_prod_of_mem
          (fun q => q ^ delta q) hmem
      have hkw : delta p ≤ padicValNat p W :=
        (padicValNat_dvd_iff_le hW0).1 hdiv
      have hbudget :=
        originalDepth_budget k (padicValNat p n)
          (padicValNat p N)
      have hvaltarget :
          padicValNat p (W ^ (k + 1) * N) =
            (k + 1) * padicValNat p W +
              padicValNat p N := by
        rw [padicValNat.mul (pow_ne_zero (k + 1) hW0) hN,
          padicValNat.pow]
      have hmul := Nat.mul_le_mul_left (k + 1) hkw
      dsimp [delta] at hkw hbudget hmul
      rw [hvaltarget]
      omega
    · have hnotdvd : ¬ p ∣ n := by
        intro hdiv
        exact hmem ((Nat.mem_primeFactors).2 ⟨hp, hdiv, hn⟩)
      rw [padicValNat.eq_zero_of_not_dvd hnotdvd]
      omega
  · rw [Nat.factorization_eq_zero_of_not_prime n hp]
    omega

private noncomputable def crtRep (A B : ℕ) (hcop : A.Coprime B) (r s : ℤ) : ℤ :=
  (((ZMod.chineseRemainder hcop).symm ((r : ZMod A), (s : ZMod B))).val : ℤ)

private theorem crtRep_congr
    (A B : ℕ) (hA : 0 < A) (hB : 0 < B) (hcop : A.Coprime B)
    (r s : ℤ) :
    (A : ℤ) ∣ crtRep A B hcop r s - r ∧
    (B : ℤ) ∣ crtRep A B hcop r s - s := by
  let : NeZero (A * B) := ⟨mul_ne_zero (Nat.ne_of_gt hA) (Nat.ne_of_gt hB)⟩
  let z := (ZMod.chineseRemainder hcop).symm ((r : ZMod A), (s : ZMod B))
  have hz : (z.val : ZMod (A * B)) = z := ZMod.natCast_zmod_val z
  have hp : ((z.val : ZMod A), (z.val : ZMod B)) =
      ((r : ZMod A), (s : ZMod B)) := by
    calc
      _ = (ZMod.chineseRemainder hcop) (z.val : ZMod (A * B)) :=
        (map_natCast (ZMod.chineseRemainder hcop) z.val).symm
      _ = _ := by rw [hz]; exact (ZMod.chineseRemainder hcop).apply_symm_apply _
  constructor
  · apply (ZMod.intCast_zmod_eq_zero_iff_dvd _ A).mp
    push_cast
    have ht := congrArg Prod.fst hp
    simpa [crtRep, z] using sub_eq_zero.mpr ht
  · apply (ZMod.intCast_zmod_eq_zero_iff_dvd _ B).mp
    push_cast
    have ht := congrArg Prod.snd hp
    simpa [crtRep, z] using sub_eq_zero.mpr ht

private theorem combine_cover
    (A B : ℕ) (hA : 0 < A) (hB : 0 < B) (hcop : A.Coprime B)
    (R S : Finset ℤ) (Pred : ℤ → Prop)
    (hR : ∀ x, Pred x → ∃ r ∈ R, (A : ℤ) ∣ x - r)
    (hS : ∀ x, Pred x → ∃ s ∈ S, (B : ℤ) ∣ x - s) :
    ∃ T : Finset ℤ, T.card ≤ R.card * S.card ∧
      ∀ x, Pred x → ∃ t ∈ T, ((A * B : ℕ) : ℤ) ∣ x - t := by
  classical
  let T := (R ×ˢ S).image (fun rs => crtRep A B hcop rs.1 rs.2)
  refine ⟨T, ?_, ?_⟩
  · exact (Finset.card_image_le).trans (by rw [Finset.card_product])
  · intro x hx
    obtain ⟨r, hr, hxr⟩ := hR x hx
    obtain ⟨s, hs, hxs⟩ := hS x hx
    let t := crtRep A B hcop r s
    refine ⟨t, Finset.mem_image.mpr ⟨(r,s), Finset.mem_product.mpr ⟨hr,hs⟩, rfl⟩, ?_⟩
    have ht := crtRep_congr A B hA hB hcop r s
    have hAt : (A : ℤ) ∣ x - t := by
      simpa only [sub_sub_sub_cancel_right] using dvd_sub hxr ht.1
    have hBt : (B : ℤ) ∣ x - t := by
      simpa only [sub_sub_sub_cancel_right] using dvd_sub hxs ht.2
    have hco : (A : ℤ).natAbs.Coprime (B : ℤ).natAbs := by simpa using hcop
    have hmod : Int.ModEq ((A : ℤ) * (B : ℤ)) t x :=
      (Int.modEq_and_modEq_iff_modEq_mul hco).mp
        ⟨Int.modEq_iff_dvd.mpr hAt, Int.modEq_iff_dvd.mpr hBt⟩
    simpa only [Nat.cast_mul] using Int.modEq_iff_dvd.mp hmod

private theorem finite_cover {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (Q L : ι → ℕ) (Pred : ℤ → Prop)
    (hpos : ∀ i ∈ s, 0 < Q i)
    (hpair : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → (Q i).Coprime (Q j))
    (hloc : ∀ i ∈ s, ∃ R : Finset ℤ, R.card ≤ L i ∧
      ∀ z, Pred z → ∃ a ∈ R, (Q i : ℤ) ∣ z - a) :
    ∃ T : Finset ℤ, T.card ≤ ∏ i ∈ s, L i ∧
      ∀ z, Pred z → ∃ a ∈ T, ((∏ i ∈ s, Q i : ℕ) : ℤ) ∣ z - a := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    refine ⟨{0}, by simp, ?_⟩
    intro z hz
    refine ⟨0, Finset.mem_singleton_self _, ?_⟩
    simp
  | @insert i s hi ih =>
    obtain ⟨R, hRc, hRv⟩ := hloc i (Finset.mem_insert_self _ _)
    have hposS : ∀ j ∈ s, 0 < Q j :=
      fun j hj => hpos j (Finset.mem_insert_of_mem hj)
    have hpairS : ∀ j ∈ s, ∀ k ∈ s, j ≠ k → (Q j).Coprime (Q k) :=
      fun j hj k hk hne => hpair j (Finset.mem_insert_of_mem hj)
        k (Finset.mem_insert_of_mem hk) hne
    have hlocS : ∀ j ∈ s, ∃ R : Finset ℤ, R.card ≤ L j ∧
        ∀ z, Pred z → ∃ a ∈ R, (Q j : ℤ) ∣ z - a :=
      fun j hj => hloc j (Finset.mem_insert_of_mem hj)
    obtain ⟨S, hSc, hSv⟩ := ih hposS hpairS hlocS
    have hcop : (Q i).Coprime (∏ j ∈ s, Q j) := by
      apply Nat.Coprime.prod_right
      intro j hj
      exact hpair i (Finset.mem_insert_self _ _)
        j (Finset.mem_insert_of_mem hj) (by intro hij; subst j; exact hi hj)
    have hprodpos : 0 < ∏ j ∈ s, Q j := Finset.prod_pos hposS
    obtain ⟨T, hTc, hTv⟩ := combine_cover (Q i) (∏ j ∈ s, Q j)
      (hpos i (Finset.mem_insert_self _ _)) hprodpos hcop R S Pred hRv hSv
    refine ⟨T, ?_, ?_⟩
    · rw [Finset.prod_insert hi]
      exact hTc.trans (Nat.mul_le_mul hRc hSc)
    · simpa only [Finset.prod_insert hi] using hTv

private theorem original_finite_prime_cover
    (k : ℕ) (a b A B q h m : ℤ)
    (f g : Polynomial ℤ)
    (hab : A * a + B * b = 1)
    (hm0 : m ≠ 0) (hq0 : q ≠ 0) (hh0 : h ≠ 0)
    (hfdeg : f.natDegree ≤ k + 1)
    (hgdeg : g.natDegree ≤ k + 1)
    (hftop : f.coeff (k + 1) = q * h ^ k * b ^ k)
    (hgtop : g.coeff (k + 1) =
      (-1 : ℤ) ^ k * q * h ^ k * a ^ k)
    (s : Finset ℕ) (hsprime : ∀ p ∈ s, p.Prime) :
    let delta : ℕ → ℕ := fun p =>
      originalDepth k
        (padicValNat p (m ^ (2 * k + 1)).natAbs)
        (padicValNat p (q * h ^ k).natAbs)
    ∃ T : Finset ℤ,
      T.card ≤ (k + 1) ^ s.card ∧
      ∀ z u v : ℤ,
        f.eval z = m ^ (2 * k + 1) * v →
        g.eval z = m ^ (2 * k + 1) * u →
        ∃ center ∈ T,
          ((∏ p ∈ s, p ^ delta p : ℕ) : ℤ) ∣ z - center := by
  classical
  let delta : ℕ → ℕ := fun p =>
    originalDepth k
      (padicValNat p (m ^ (2 * k + 1)).natAbs)
      (padicValNat p (q * h ^ k).natAbs)
  let Q : ℕ → ℕ := fun p => p ^ delta p
  let L : ℕ → ℕ := fun _ => k + 1
  let Pred : ℤ → Prop := fun z =>
    ∃ u v : ℤ,
      f.eval z = m ^ (2 * k + 1) * v ∧
      g.eval z = m ^ (2 * k + 1) * u
  change ∃ T : Finset ℤ,
    T.card ≤ (k + 1) ^ s.card ∧
    ∀ z u v : ℤ,
      f.eval z = m ^ (2 * k + 1) * v →
      g.eval z = m ^ (2 * k + 1) * u →
      ∃ center ∈ T,
        ((∏ p ∈ s, Q p : ℕ) : ℤ) ∣ z - center
  have hpos : ∀ p ∈ s, 0 < Q p := by
    intro p hp
    exact pow_pos (hsprime p hp).pos _
  have hpairQ : ∀ p ∈ s, ∀ t ∈ s, p ≠ t →
      (Q p).Coprime (Q t) := by
    intro p hp t ht hne
    have hcop : p.Coprime t :=
      (Nat.coprime_primes (hsprime p hp) (hsprime t ht)).2 hne
    exact Nat.Coprime.pow (delta p) (delta t) hcop
  have hloc : ∀ p ∈ s, ∃ T : Finset ℤ,
      T.card ≤ L p ∧
      ∀ z, Pred z → ∃ center ∈ T, (Q p : ℤ) ∣ z - center := by
    intro p hp
    by_cases hd : delta p = 0
    · refine ⟨{0}, ?_, ?_⟩
      · simp [L]
      · intro z _
        refine ⟨0, by simp, ?_⟩
        simp [Q, hd]
    · letI : Fact p.Prime := ⟨hsprime p hp⟩
      have hdpos : 0 < delta p := Nat.pos_of_ne_zero hd
      have hlocal := original_selected_local_cover_padic k p
        a b A B q h m f g hab hm0 hq0 hh0
        hfdeg hgdeg hftop hgtop
      change 0 < delta p →
        ∃ T : Finset ℤ, T.card ≤ k + 1 ∧
          ∀ z u v : ℤ,
            f.eval z = m ^ (2 * k + 1) * v →
            g.eval z = m ^ (2 * k + 1) * u →
            ∃ center ∈ T, (p : ℤ) ^ delta p ∣ z - center at hlocal
      obtain ⟨T, hTc, hTv⟩ := hlocal hdpos
      refine ⟨T, by simpa [L] using hTc, ?_⟩
      intro z hz
      obtain ⟨u, v, hf, hg⟩ := hz
      simpa [Q] using hTv z u v hf hg
  obtain ⟨T, hTc, hTv⟩ :=
    finite_cover s Q L Pred hpos hpairQ hloc
  refine ⟨T, ?_, ?_⟩
  · simpa [L] using hTc
  · intro z u v hf hg
    exact hTv z ⟨u, v, hf, hg⟩

private theorem original_allprime_cover_and_modulus
    (k : ℕ) (a b A B q h m : ℤ)
    (f g : Polynomial ℤ)
    (hab : A * a + B * b = 1)
    (hm0 : m ≠ 0) (hq0 : q ≠ 0) (hh0 : h ≠ 0)
    (hfdeg : f.natDegree ≤ k + 1)
    (hgdeg : g.natDegree ≤ k + 1)
    (hftop : f.coeff (k + 1) = q * h ^ k * b ^ k)
    (hgtop : g.coeff (k + 1) =
      (-1 : ℤ) ^ k * q * h ^ k * a ^ k) :
    let n : ℕ := (m ^ (2 * k + 1)).natAbs
    let N : ℕ := (q * h ^ k).natAbs
    let s := n.primeFactors
    let delta : ℕ → ℕ := fun p =>
      originalDepth k (padicValNat p n) (padicValNat p N)
    let W := ∏ p ∈ s, p ^ delta p
    0 < W ∧ n ∣ W ^ (k + 1) * N ∧
      ∃ T : Finset ℤ,
        T.card ≤ (k + 1) ^ s.card ∧
        ∀ z u v : ℤ,
          f.eval z = m ^ (2 * k + 1) * v →
          g.eval z = m ^ (2 * k + 1) * u →
          ∃ center ∈ T, (W : ℤ) ∣ z - center := by
  let n : ℕ := (m ^ (2 * k + 1)).natAbs
  let N : ℕ := (q * h ^ k).natAbs
  let s := n.primeFactors
  let delta : ℕ → ℕ := fun p =>
    originalDepth k (padicValNat p n) (padicValNat p N)
  let W := ∏ p ∈ s, p ^ delta p
  change 0 < W ∧ n ∣ W ^ (k + 1) * N ∧
    ∃ T : Finset ℤ,
      T.card ≤ (k + 1) ^ s.card ∧
      ∀ z u v : ℤ,
        f.eval z = m ^ (2 * k + 1) * v →
        g.eval z = m ^ (2 * k + 1) * u →
        ∃ center ∈ T, (W : ℤ) ∣ z - center
  have hn0 : n ≠ 0 :=
    Nat.ne_of_gt (Int.natAbs_pos.mpr
      (pow_ne_zero (2 * k + 1) hm0))
  have hNint : q * h ^ k ≠ 0 :=
    mul_ne_zero hq0 (pow_ne_zero k hh0)
  have hN0 : N ≠ 0 :=
    Nat.ne_of_gt (Int.natAbs_pos.mpr hNint)
  obtain ⟨hWpos, hmod⟩ :=
    originalModulus_budget k n N hn0 hN0
  have hsprime : ∀ p ∈ s, p.Prime := by
    intro p hp
    exact (Nat.mem_primeFactors.mp hp).1
  have hcov := original_finite_prime_cover k
    a b A B q h m f g hab hm0 hq0 hh0
    hfdeg hgdeg hftop hgtop s hsprime
  change ∃ T : Finset ℤ,
      T.card ≤ (k + 1) ^ s.card ∧
      ∀ z u v : ℤ,
        f.eval z = m ^ (2 * k + 1) * v →
        g.eval z = m ^ (2 * k + 1) * u →
        ∃ center ∈ T, (W : ℤ) ∣ z - center at hcov
  exact ⟨hWpos, hmod, hcov⟩

private theorem signed_progression_det
    (a b A B m t₀ h z z' : ℤ)
    (hab : A * a + B * b = 1) :
    (A * m + b * (t₀ + h * z)) *
        (B * m - a * (t₀ + h * z')) -
      (A * m + b * (t₀ + h * z')) *
        (B * m - a * (t₀ + h * z)) =
      m * h * (z - z') := by
  linear_combination m * h * (z - z') * hab

theorem original_relative_cell_diameter
    (a b A B m t₀ h z z' d e d' e' : ℤ)
    (D E M C : ℝ)
    (hab : A * a + B * b = 1)
    (hd : d = A * m + b * (t₀ + h * z))
    (he : e = B * m - a * (t₀ + h * z))
    (hd' : d' = A * m + b * (t₀ + h * z'))
    (he' : e' = B * m - a * (t₀ + h * z'))
    (hepos : 0 < (e : ℝ)) (he'pos : 0 < (e' : ℝ))
    (heE : (e : ℝ) ≤ E) (he'E : (e' : ℝ) ≤ E)
    (hE : 0 < E) (hM : 0 < M)
    (hD : 0 ≤ D) (hC : 0 ≤ C)
    (hcell : |(d : ℝ) / (e : ℝ) - (d' : ℝ) / (e' : ℝ)| ≤
      2 * C * D / (E * M)) :
    M * |((m * h : ℤ) : ℝ)| * |((z - z' : ℤ) : ℝ)| ≤ 2 * C * D * E := by
  have hdetI : d * e' - d' * e = m * h * (z - z') := by
    rw [hd, he, hd', he']
    exact signed_progression_det a b A B m t₀ h z z' hab
  have hdet : (d : ℝ) * (e' : ℝ) - (d' : ℝ) * (e : ℝ) =
      ((m * h : ℤ) : ℝ) * ((z - z' : ℤ) : ℝ) := by
    exact_mod_cast hdetI
  have he0 : (e : ℝ) ≠ 0 := ne_of_gt hepos
  have he'0 : (e' : ℝ) ≠ 0 := ne_of_gt he'pos
  have hratio : (d : ℝ) * (e' : ℝ) - (d' : ℝ) * (e : ℝ) =
      (e : ℝ) * (e' : ℝ) *
        ((d : ℝ) / (e : ℝ) - (d' : ℝ) / (e' : ℝ)) := by
    field_simp
  have hbound : |(d : ℝ) * (e' : ℝ) - (d' : ℝ) * (e : ℝ)| ≤
      E * E * (2 * C * D / (E * M)) := by
    rw [hratio, abs_mul, abs_mul, abs_of_pos hepos, abs_of_pos he'pos]
    calc
      (e : ℝ) * (e' : ℝ) *
          |(d : ℝ) / (e : ℝ) - (d' : ℝ) / (e' : ℝ)| ≤
        E * E * |(d : ℝ) / (e : ℝ) - (d' : ℝ) / (e' : ℝ)| := by
          gcongr
      _ ≤ E * E * (2 * C * D / (E * M)) := by
          gcongr
  have hEM : E * M ≠ 0 := mul_ne_zero (ne_of_gt hE) (ne_of_gt hM)
  calc
    M * |((m * h : ℤ) : ℝ)| * |((z - z' : ℤ) : ℝ)| =
        M * |(d : ℝ) * (e' : ℝ) - (d' : ℝ) * (e : ℝ)| := by
          rw [hdet, abs_mul]
          ring
    _ ≤ M * (E * E * (2 * C * D / (E * M))) := by
          gcongr
    _ = 2 * C * D * E := by
          field_simp

theorem finite_original_class_count
    (S T : Finset ℤ) (W L U : ℤ)
    (hW : 0 < W)
    (hinterval : ∀ z ∈ S, L ≤ z ∧ z ≤ U)
    (hcover : ∀ z ∈ S, ∃ t ∈ T, W ∣ z - t) :
    S.card ≤ T.card * (Finset.Icc (L / W) (U / W)).card := by
  classical
  let R : Finset ℤ := T.image (fun t => t % W)
  let J : Finset ℤ := Finset.Icc (L / W) (U / W)
  have hR (z : ℤ) (hz : z ∈ S) : z % W ∈ R := by
    obtain ⟨t, ht, hdiv⟩ := hcover z hz
    apply Finset.mem_image.mpr
    refine ⟨t, ht, ?_⟩
    symm
    apply (Int.emod_eq_emod_iff_emod_sub_eq_zero).2
    exact Int.emod_eq_zero_of_dvd hdiv
  have hJ (z : ℤ) (hz : z ∈ S) : z / W ∈ J := by
    obtain ⟨hL, hU⟩ := hinterval z hz
    exact Finset.mem_Icc.mpr
      ⟨Int.ediv_le_ediv hW hL, Int.ediv_le_ediv hW hU⟩
  let F : S → R × J := fun z =>
    (⟨z.1 % W, hR z.1 z.2⟩, ⟨z.1 / W, hJ z.1 z.2⟩)
  have hinj : Function.Injective F := by
    intro z z' h
    apply Subtype.ext
    have hr : z.1 % W = z'.1 % W :=
      congrArg (fun w : R × J => w.1.1) h
    have hq : z.1 / W = z'.1 / W :=
      congrArg (fun w : R × J => w.2.1) h
    have hz : z.1 = W * (z.1 / W) + z.1 % W := by
      have h := Int.ediv_mul_add_emod z.1 W
      linear_combination -h
    have hz' : z'.1 = W * (z'.1 / W) + z'.1 % W := by
      have h := Int.ediv_mul_add_emod z'.1 W
      linear_combination -h
    calc
      z.1 = W * (z.1 / W) + z.1 % W := hz
      _ = W * (z'.1 / W) + z'.1 % W := by rw [hq, hr]
      _ = z'.1 := hz'.symm
  have hcard := Fintype.card_le_of_injective F hinj
  have hRcard : R.card ≤ T.card := Finset.card_image_le
  have hcard' : S.card ≤ R.card * J.card := by
    simpa [Fintype.card_prod, Fintype.card_coe] using hcard
  exact le_trans hcard' (Nat.mul_le_mul_right J.card hRcard)

theorem finite_original_class_count_real_width
    (S T : Finset ℤ) (W L U : ℤ)
    (hW : 0 < W) (hLU : L ≤ U)
    (hinterval : ∀ z ∈ S, L ≤ z ∧ z ≤ U)
    (hcover : ∀ z ∈ S, ∃ t ∈ T, W ∣ z - t) :
    (S.card : ℝ) ≤ (T.card : ℝ) *
      (2 + ((U - L : ℤ) : ℝ) / (W : ℝ)) := by
  let q : ℤ := U / W + 1 - L / W
  have hdivle : L / W ≤ U / W := Int.ediv_le_ediv hW hLU
  have hqnonneg : 0 ≤ q := by dsimp [q]; omega
  have hremL : L % W < W := Int.emod_lt_of_pos L hW
  have hremU : 0 ≤ U % W := Int.emod_nonneg U (ne_of_gt hW)
  have hLrecon := Int.ediv_mul_add_emod L W
  have hUrecon := Int.ediv_mul_add_emod U W
  have hZ : (q - 2) * W ≤ U - L := by
    dsimp [q]
    nlinarith
  have hWr : (0 : ℝ) < (W : ℝ) := by exact_mod_cast hW
  have hZr : ((q : ℝ) - 2) * (W : ℝ) ≤ ((U - L : ℤ) : ℝ) := by
    exact_mod_cast hZ
  have hdivEq : (((U - L : ℤ) : ℝ) / (W : ℝ)) * (W : ℝ) =
      ((U - L : ℤ) : ℝ) := div_mul_cancel₀ _ (ne_of_gt hWr)
  have hqbound : (q : ℝ) ≤
      2 + ((U - L : ℤ) : ℝ) / (W : ℝ) := by
    nlinarith
  have hcount := finite_original_class_count S T W L U hW hinterval hcover
  have hIcc : (Finset.Icc (L / W) (U / W)).card = q.toNat := by
    simpa only [q, sub_eq_add_neg, add_assoc, add_comm, add_left_comm] using
      Int.card_Icc (L / W) (U / W)
  rw [hIcc] at hcount
  have hqcast : ((q.toNat : ℕ) : ℝ) = (q : ℝ) := by
    exact_mod_cast Int.toNat_of_nonneg hqnonneg
  have hcountR : (S.card : ℝ) ≤ (T.card : ℝ) * ((q.toNat : ℕ) : ℝ) := by
    exact_mod_cast hcount
  rw [hqcast] at hcountR
  nlinarith [mul_le_mul_of_nonneg_left hqbound
    (show 0 ≤ (T.card : ℝ) by positivity)]

theorem finite_class_count_from_pairwise_diameter
    (S T : Finset ℤ) (W : ℤ) (L : ℝ)
    (hW : 0 < W) (hL : 0 ≤ L)
    (hdiam : ∀ z ∈ S, ∀ z' ∈ S,
      |((z - z' : ℤ) : ℝ)| ≤ L)
    (hcover : ∀ z ∈ S, ∃ t ∈ T, W ∣ z - t) :
    (S.card : ℝ) ≤ (T.card : ℝ) *
      (2 + L / (W : ℝ)) := by
  classical
  by_cases hS : S.Nonempty
  · let lo := S.min' hS
    let hi := S.max' hS
    have hlo : lo ∈ S := Finset.min'_mem S hS
    have hhi : hi ∈ S := Finset.max'_mem S hS
    have hloc (z : ℤ) (hz : z ∈ S) : lo ≤ z :=
      Finset.min'_le S z hz
    have hhic (z : ℤ) (hz : z ∈ S) : z ≤ hi :=
      Finset.le_max' S z hz
    have hLU : lo ≤ hi := hloc hi hhi
    have hdiam' := hdiam hi hhi lo hlo
    have hdiff : (((hi - lo : ℤ) : ℝ)) ≤ L := by
      exact (le_abs_self _).trans hdiam'
    have hbase := finite_original_class_count_real_width
      S T W lo hi hW hLU (fun z hz => ⟨hloc z hz, hhic z hz⟩) hcover
    have hWr : (0 : ℝ) < (W : ℝ) := by exact_mod_cast hW
    have hdiv := div_le_div_of_nonneg_right hdiff (le_of_lt hWr)
    nlinarith [mul_le_mul_of_nonneg_left hdiv
      (show 0 ≤ (T.card : ℝ) by positivity)]
  · have hempty : S = ∅ := Finset.not_nonempty_iff_eq_empty.mp hS
    have hWr : (0 : ℝ) < (W : ℝ) := by exact_mod_cast hW
    simp [hempty]
    positivity

theorem finite_point_count_from_pairwise_diameter
    {α : Type*} [DecidableEq α]
    (S : Finset α) (T : Finset ℤ) (zfun : α → ℤ)
    (W : ℤ) (L : ℝ)
    (hW : 0 < W) (hL : 0 ≤ L)
    (hinj : ∀ p ∈ S, ∀ p' ∈ S, zfun p = zfun p' → p = p')
    (hdiam : ∀ p ∈ S, ∀ p' ∈ S,
      |(((zfun p - zfun p' : ℤ) : ℝ))| ≤ L)
    (hcover : ∀ p ∈ S, ∃ t ∈ T, W ∣ zfun p - t) :
    (S.card : ℝ) ≤ (T.card : ℝ) * (2 + L / (W : ℝ)) := by
  classical
  let Z : Finset ℤ := S.image zfun
  let F : S → Z := fun p =>
    ⟨zfun p.1, Finset.mem_image.mpr ⟨p.1, p.2, rfl⟩⟩
  have hF : Function.Injective F := by
    intro p p' heq
    apply Subtype.ext
    exact hinj p.1 p.2 p'.1 p'.2 (congrArg Subtype.val heq)
  have hcard : S.card ≤ Z.card := by
    simpa only [Fintype.card_coe] using Fintype.card_le_of_injective F hF
  have hZdiam : ∀ z ∈ Z, ∀ z' ∈ Z,
      |(((z - z' : ℤ) : ℝ))| ≤ L := by
    intro z hz z' hz'
    obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hz
    obtain ⟨p', hp', rfl⟩ := Finset.mem_image.mp hz'
    exact hdiam p hp p' hp'
  have hZcover : ∀ z ∈ Z, ∃ t ∈ T, W ∣ z - t := by
    intro z hz
    obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hz
    exact hcover p hp
  have hbound := finite_class_count_from_pairwise_diameter
    Z T W L hW hL hZdiam hZcover
  have hcardR : (S.card : ℝ) ≤ (Z.card : ℝ) := by exact_mod_cast hcard
  linarith

end A8OddPureOriginal

namespace OddPureOriginalCRTAtLeastTwo

abbrev OriginalPoint := (ℕ × ℕ) × (ℕ × ℕ)

def pd (p : OriginalPoint) : ℕ := p.1.1
def pe (p : OriginalPoint) : ℕ := p.1.2
def pu (p : OriginalPoint) : ℕ := p.2.1
def pv (p : OriginalPoint) : ℕ := p.2.2

def OriginalCellPoint
    (k : ℕ) (P Q : MvPolynomial (Fin 2) ℤ)
    (x D E U V M rho Ccell : ℝ) (p : OriginalPoint) : Prop :=
  1 ≤ pd p ∧ 1 ≤ pe p ∧ 1 ≤ pu p ∧ 1 ≤ pv p ∧
  D / 2 < (pd p : ℝ) ∧ (pd p : ℝ) ≤ D ∧
  E / 2 < (pe p : ℝ) ∧ (pe p : ℝ) ≤ E ∧
  U / 2 < (pu p : ℝ) ∧ (pu p : ℝ) ≤ U ∧
  V / 2 < (pv p : ℝ) ∧ (pv p : ℝ) ≤ V ∧
  x / 2 < (pd p : ℝ) ^ k * (pu p : ℝ) ∧
    (pd p : ℝ) ^ k * (pu p : ℝ) ≤ x ∧
  (pe p : ℤ) ^ k * (pv p : ℤ) -
    (pd p : ℤ) ^ k * (pu p : ℤ) = 1 ∧
  MvPolynomial.eval ![(pd p : ℤ), (pe p : ℤ)] P * (pu p : ℤ) =
    MvPolynomial.eval ![(pd p : ℤ), (pe p : ℤ)] Q * (pv p : ℤ) ∧
  |(pd p : ℝ) / (pe p : ℝ) - rho| ≤
    Ccell * D / (E * M)

def depth (k r w : ℕ) : ℕ :=
  if r ≤ w then 0 else (r - w - 1) / (k + 1) + 1

def OriginalArithmeticCRTStatement : Prop :=
  ∀ (k : ℕ), 2 ≤ k →
  ∀ (H : ℕ) (eps Ccell : ℝ), 0 < eps → 0 ≤ Ccell →
  ∃ C : ℝ, 0 < C ∧
  ∀ (x D E U V M rho : ℝ)
    (P Q : MvPolynomial (Fin 2) ℤ)
    (a b c A B : ℤ)
    (p0 : OriginalPoint) (Spts : Finset OriginalPoint),
    2 ≤ x → 0 < D → 0 < E → 0 < U → 0 < V →
    1 ≤ M → M ≤ x →
    (∀ μ ∈ P.support, μ 0 + μ 1 = k + 1) →
    (∀ μ ∈ Q.support, μ 0 + μ 1 = k + 1) →
    (∀ μ : Fin 2 →₀ ℕ,
      |((P.coeff μ : ℤ) : ℝ)| ≤ x ^ H ∧
      |((Q.coeff μ : ℤ) : ℝ)| ≤ x ^ H) →
    |(a : ℝ)| ≤ x ^ H →
    |(b : ℝ)| ≤ x ^ H →
    |(c : ℝ)| ≤ x ^ H →
    (∀ F : MvPolynomial (Fin 2) ℚ,
      F ∣ MvPolynomial.map (Int.castRingHom ℚ) P →
      F ∣ MvPolynomial.map (Int.castRingHom ℚ) Q →
      IsUnit F) →
    c ≠ 0 → A * a + B * b = 1 →
    MvPolynomial.X (1 : Fin 2) ^ k * P -
      MvPolynomial.X (0 : Fin 2) ^ k * Q =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ (2 * k + 1) →
    OriginalCellPoint k P Q x D E U V M rho Ccell p0 →
    (∀ p ∈ Spts,
      OriginalCellPoint k P Q x D E U V M rho Ccell p ∧
      a * (pd p : ℤ) + b * (pe p : ℤ) =
        a * (pd p0 : ℤ) + b * (pe p0 : ℤ)) →
    let S : ℤ := P.coeff (Finsupp.single (0 : Fin 2) (k + 1))
    let R : ℤ := P.coeff
      (Finsupp.single (0 : Fin 2) k +
        Finsupp.single (1 : Fin 2) 1)
    let K0 : ℤ :=
      b * S - a * R +
        (Nat.choose (2 * k) (k - 1) : ℤ) *
          c * a ^ (k + 1) * b ^ (k + 1)
    let m : ℤ := a * (pd p0 : ℤ) + b * (pe p0 : ℤ)
    let g0 : ℕ := Nat.gcd c.natAbs K0.natAbs
    let h0 : ℕ := c.natAbs / g0
    let h : ℤ := (h0 : ℤ)
    let q : ℤ :=
      c.sign * K0.sign * ((K0.natAbs / g0 : ℕ) : ℤ)
    let n : ℕ := (m ^ (2 * k + 1)).natAbs
    let N : ℕ := (q * h ^ k).natAbs
    let W : ℕ :=
      ∏ p ∈ n.primeFactors,
        p ^ depth k (padicValNat p n) (padicValNat p N)
    K0 ≠ 0 ∧ m ≠ 0 ∧ m ∣ K0 ∧
    0 < g0 ∧ 0 < h0 ∧ q ≠ 0 ∧
    c * q = K0 * h ∧
    Nat.Coprime h0 q.natAbs ∧
    c ∣ S * (pd p0 : ℤ) + R * (pe p0 : ℤ) ∧
    (b * S - a * R) * h =
      c * (q -
        (Nat.choose (2 * k) (k - 1) : ℤ) *
          h * a ^ (k + 1) * b ^ (k + 1)) ∧
    ∃ f g : Polynomial ℤ,
      f.natDegree ≤ k + 1 ∧
      g.natDegree ≤ k + 1 ∧
      f.coeff (k + 1) = q * h ^ k * b ^ k ∧
      g.coeff (k + 1) = (-1 : ℤ) ^ k * q * h ^ k * a ^ k ∧
      (∀ y : ℤ,
        c * f.eval y =
          MvPolynomial.eval
            ![(pd p0 : ℤ) + b * h * y,
              (pe p0 : ℤ) - a * h * y] P ∧
        c * g.eval y =
          MvPolynomial.eval
            ![(pd p0 : ℤ) + b * h * y,
              (pe p0 : ℤ) - a * h * y] Q) ∧
      (∀ p ∈ Spts, ∃ y : ℤ,
        (pd p : ℤ) = (pd p0 : ℤ) + b * h * y ∧
        (pe p : ℤ) = (pe p0 : ℤ) - a * h * y ∧
        f.eval y = m ^ (2 * k + 1) * (pv p : ℤ) ∧
        g.eval y = m ^ (2 * k + 1) * (pu p : ℤ)) ∧
      0 < W ∧
      n ∣ W ^ (k + 1) * N ∧
      (∃ T : Finset ℤ,
        T.card ≤ (k + 1) ^ n.primeFactors.card ∧
        ∀ y : ℤ,
          (n : ℤ) ∣ f.eval y →
          (n : ℤ) ∣ g.eval y →
          ∃ r ∈ T, (W : ℤ) ∣ y - r) ∧
      (Spts.card : ℝ) ≤
        (((k + 1) ^ n.primeFactors.card : ℕ) : ℝ) *
          (2 + 2 * Ccell * D * E /
            (M * |((m * h : ℤ) : ℝ)| * (W : ℝ))) ∧
      (((k + 1) ^ n.primeFactors.card : ℕ) : ℝ) ≤
        C * x ^ eps ∧
      ((Nat.divisors K0.natAbs).card : ℝ) ≤
        C * x ^ eps ∧
      (Spts.card : ℝ) ≤ C * x ^ eps *
        (1 + D * E / M *
          (q.natAbs : ℝ) ^ (1 / ((k + 1 : ℕ) : ℝ)) *
          (h0 : ℝ) ^ (-(1 / ((k + 1 : ℕ) : ℝ))) *
          (m.natAbs : ℝ) ^
            (-(((3 * k + 2 : ℕ) : ℝ) /
              ((k + 1 : ℕ) : ℝ))))

end OddPureOriginalCRTAtLeastTwo

set_option maxHeartbeats 1200000
set_option maxRecDepth 2000
namespace OddPureOriginalCRTAtLeastTwo
open A8OddPureOriginal

private theorem original_point_count_from_certificates
    (k : ℕ) (P Q : MvPolynomial (Fin 2) ℤ)
    (x D E U V M rho Ccell : ℝ)
    (a b A B m h : ℤ) (p0 : OriginalPoint)
    (Spts : Finset OriginalPoint)
    (f g : Polynomial ℤ) (T : Finset ℤ) (W : ℕ)
    (hab : A * a + B * b = 1)
    (hmdef : m = a * (pd p0 : ℤ) + b * (pe p0 : ℤ))
    (hm0 : m ≠ 0) (hh0 : h ≠ 0)
    (hD : 0 < D) (hE : 0 < E) (hM : 0 < M)
    (hC : 0 ≤ Ccell) (hW : 0 < W)
    (hS : ∀ p ∈ Spts,
      OriginalCellPoint k P Q x D E U V M rho Ccell p)
    (hcert : ∀ p ∈ Spts, ∃ y : ℤ,
      (pd p : ℤ) = (pd p0 : ℤ) + b * h * y ∧
      (pe p : ℤ) = (pe p0 : ℤ) - a * h * y ∧
      f.eval y = m ^ (2 * k + 1) * (pv p : ℤ) ∧
      g.eval y = m ^ (2 * k + 1) * (pu p : ℤ))
    (hcover : ∀ y u v : ℤ,
      f.eval y = m ^ (2 * k + 1) * v →
      g.eval y = m ^ (2 * k + 1) * u →
      ∃ t ∈ T, (W : ℤ) ∣ y - t) :
    (Spts.card : ℝ) ≤ (T.card : ℝ) *
      (2 + 2 * Ccell * D * E /
        (M * |((m * h : ℤ) : ℝ)| * (W : ℝ))) := by
  classical
  let t0 : ℤ := B * (pd p0 : ℤ) - A * (pe p0 : ℤ)
  have hd0 : (pd p0 : ℤ) = A * m + b * t0 := by
    rw [hmdef]
    dsimp [t0]
    linear_combination -(pd p0 : ℤ) * hab
  have he0 : (pe p0 : ℤ) = B * m - a * t0 := by
    rw [hmdef]
    dsimp [t0]
    linear_combination -(pe p0 : ℤ) * hab
  have hmh : m * h ≠ 0 := mul_ne_zero hm0 hh0
  have hmhR : ((m * h : ℤ) : ℝ) ≠ 0 := by exact_mod_cast hmh
  have hden : 0 < M * |((m * h : ℤ) : ℝ)| :=
    mul_pos hM (abs_pos.mpr hmhR)
  let L : ℝ := (2 * Ccell * D * E) /
    (M * |((m * h : ℤ) : ℝ)|)
  have hL : 0 ≤ L := by
    dsimp [L]
    exact div_nonneg (by positivity) (le_of_lt hden)
  let cert (p : {r // r ∈ Spts}) :
      ∃ y : ℤ,
        (pd p.1 : ℤ) = A * m + b * (t0 + h * y) ∧
        (pe p.1 : ℤ) = B * m - a * (t0 + h * y) ∧
        f.eval y = m ^ (2 * k + 1) * (pv p.1 : ℤ) ∧
        g.eval y = m ^ (2 * k + 1) * (pu p.1 : ℤ) ∧
        ∃ t ∈ T, (W : ℤ) ∣ y - t := by
    obtain ⟨y, hd, he, hf, hg⟩ := hcert p.1 p.2
    obtain ⟨t, ht, hcong⟩ := hcover y (pu p.1 : ℤ)
      (pv p.1 : ℤ) hf hg
    refine ⟨y, ?_, ?_, hf, hg, t, ht, hcong⟩
    · calc
        (pd p.1 : ℤ) = (pd p0 : ℤ) + b * h * y := hd
        _ = A * m + b * (t0 + h * y) := by rw [hd0]; ring
    · calc
        (pe p.1 : ℤ) = (pe p0 : ℤ) - a * h * y := he
        _ = B * m - a * (t0 + h * y) := by rw [he0]; ring
  let param (p : {r // r ∈ Spts}) : ℤ := Classical.choose (cert p)
  have hcert' (p : {r // r ∈ Spts}) :
      (pd p.1 : ℤ) = A * m + b * (t0 + h * param p) ∧
      (pe p.1 : ℤ) = B * m - a * (t0 + h * param p) ∧
      f.eval (param p) = m ^ (2 * k + 1) * (pv p.1 : ℤ) ∧
      g.eval (param p) = m ^ (2 * k + 1) * (pu p.1 : ℤ) ∧
      ∃ t ∈ T, (W : ℤ) ∣ param p - t :=
    Classical.choose_spec (cert p)
  have hparam : Function.Injective param := by
    intro p p' heq
    obtain ⟨hdp, hep, hfp, hgp, _⟩ := hcert' p
    obtain ⟨hdp', hep', hfp', hgp', _⟩ := hcert' p'
    have hdd : (pd p.1 : ℤ) = (pd p'.1 : ℤ) := by
      rw [hdp, hdp', heq]
    have hee : (pe p.1 : ℤ) = (pe p'.1 : ℤ) := by
      rw [hep, hep', heq]
    have huu : (pu p.1 : ℤ) = (pu p'.1 : ℤ) := by
      apply mul_left_cancel₀ (pow_ne_zero (2 * k + 1) hm0)
      calc
        m ^ (2 * k + 1) * (pu p.1 : ℤ) =
          g.eval (param p) := hgp.symm
        _ = g.eval (param p') := by rw [heq]
        _ = m ^ (2 * k + 1) * (pu p'.1 : ℤ) := hgp'
    have hvv : (pv p.1 : ℤ) = (pv p'.1 : ℤ) := by
      apply mul_left_cancel₀ (pow_ne_zero (2 * k + 1) hm0)
      calc
        m ^ (2 * k + 1) * (pv p.1 : ℤ) =
          f.eval (param p) := hfp.symm
        _ = f.eval (param p') := by rw [heq]
        _ = m ^ (2 * k + 1) * (pv p'.1 : ℤ) := hfp'
    apply Subtype.ext
    apply Prod.ext
    · apply Prod.ext
      · exact_mod_cast hdd
      · exact_mod_cast hee
    · apply Prod.ext
      · exact_mod_cast huu
      · exact_mod_cast hvv
  have hinj : ∀ p ∈ Spts.attach, ∀ p' ∈ Spts.attach,
      param p = param p' → p = p' := by
    intro p _ p' _ heq
    exact hparam heq
  have hdiam : ∀ p ∈ Spts.attach, ∀ p' ∈ Spts.attach,
      |(((param p - param p' : ℤ) : ℝ))| ≤ L := by
    intro p _ p' _
    obtain ⟨hdp, hep, _, _, _⟩ := hcert' p
    obtain ⟨hdp', hep', _, _, _⟩ := hcert' p'
    obtain ⟨_, hepos, _, _, _, _, _, heE, _, _, _, _, _, _,
      _, _, hcell⟩ := hS p.1 p.2
    obtain ⟨_, hepos', _, _, _, _, _, heE', _, _, _, _, _, _,
      _, _, hcell'⟩ := hS p'.1 p'.2
    have heposR : (0 : ℝ) < (pe p.1 : ℝ) := by
      exact_mod_cast (show 0 < pe p.1 by omega)
    have heposR' : (0 : ℝ) < (pe p'.1 : ℝ) := by
      exact_mod_cast (show 0 < pe p'.1 by omega)
    have hcellpair :
        |(pd p.1 : ℝ) / (pe p.1 : ℝ) -
          (pd p'.1 : ℝ) / (pe p'.1 : ℝ)| ≤
          2 * Ccell * D / (E * M) := by
      calc
        _ = |((pd p.1 : ℝ) / (pe p.1 : ℝ) - rho) -
          ((pd p'.1 : ℝ) / (pe p'.1 : ℝ) - rho)| := by
            congr 1 <;> ring
        _ ≤ |(pd p.1 : ℝ) / (pe p.1 : ℝ) - rho| +
          |(pd p'.1 : ℝ) / (pe p'.1 : ℝ) - rho| :=
            by
              simpa only [sub_zero, zero_sub, abs_neg] using
                (abs_sub_le
                  ((pd p.1 : ℝ) / (pe p.1 : ℝ) - rho)
                  0
                  ((pd p'.1 : ℝ) / (pe p'.1 : ℝ) - rho))
        _ ≤ 2 * Ccell * D / (E * M) := by
          have heq : 2 * (Ccell * D / (E * M)) =
              2 * Ccell * D / (E * M) := by ring
          rw [← heq]
          linarith
    have hdet := original_relative_cell_diameter
      a b A B m t0 h (param p) (param p')
      (pd p.1 : ℤ) (pe p.1 : ℤ)
      (pd p'.1 : ℤ) (pe p'.1 : ℤ)
      D E M Ccell hab hdp hep hdp' hep'
      heposR heposR' heE heE' hE hM (le_of_lt hD) hC hcellpair
    dsimp [L]
    apply (le_div_iff₀ hden).2
    calc
      |(((param p - param p' : ℤ) : ℝ))| *
          (M * |((m * h : ℤ) : ℝ)|) =
          M * |((m * h : ℤ) : ℝ)| *
            |(((param p - param p' : ℤ) : ℝ))| := by ring
      _ ≤ 2 * Ccell * D * E := hdet
  have hcover' : ∀ p ∈ Spts.attach,
      ∃ t ∈ T, (W : ℤ) ∣ param p - t := by
    intro p _
    exact (hcert' p).2.2.2.2
  have hWint : (0 : ℤ) < (W : ℤ) := by exact_mod_cast hW
  have hcount := finite_point_count_from_pairwise_diameter
    Spts.attach T param (W : ℤ) L hWint hL
      hinj hdiam hcover'
  have hcount' : (Spts.card : ℝ) ≤
      (T.card : ℝ) * (2 + L / (W : ℝ)) := by
    simpa using hcount
  have hfrac :
      L / (W : ℝ) =
        2 * Ccell * D * E /
          (M * |((m * h : ℤ) : ℝ)| * (W : ℝ)) := by
    dsimp [L]
    field_simp
  rw [hfrac] at hcount'
  exact hcount'

private theorem original_actual_point_transport
    (k : ℕ) (hk : 2 ≤ k)
    (P Q : MvPolynomial (Fin 2) ℤ)
    (a b c A B : ℤ) (p0 : OriginalPoint)
    (Spts : Finset OriginalPoint)
    (x D E U V M rho Ccell : ℝ)
    (hP : ∀ μ ∈ P.support, μ 0 + μ 1 = k + 1)
    (hQ : ∀ μ ∈ Q.support, μ 0 + μ 1 = k + 1)
    (hcoprime : ∀ F : MvPolynomial (Fin 2) ℚ,
      F ∣ MvPolynomial.map (Int.castRingHom ℚ) P →
      F ∣ MvPolynomial.map (Int.castRingHom ℚ) Q →
      IsUnit F)
    (hc : c ≠ 0) (hab : A * a + B * b = 1)
    (hpure : MvPolynomial.X (1 : Fin 2) ^ k * P -
      MvPolynomial.X (0 : Fin 2) ^ k * Q =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ (2 * k + 1))
    (hp0 : OriginalCellPoint k P Q x D E U V M rho Ccell p0)
    (hSpts : ∀ p ∈ Spts,
      OriginalCellPoint k P Q x D E U V M rho Ccell p ∧
      a * (pd p : ℤ) + b * (pe p : ℤ) =
        a * (pd p0 : ℤ) + b * (pe p0 : ℤ)) :
    let S : ℤ := P.coeff (Finsupp.single (0 : Fin 2) (k + 1))
    let R : ℤ := P.coeff
      (Finsupp.single (0 : Fin 2) k + Finsupp.single (1 : Fin 2) 1)
    let K0 : ℤ := b * S - a * R +
      (Nat.choose (2*k) (k-1) : ℤ) * c * a^(k+1) * b^(k+1)
    let m : ℤ := a * (pd p0 : ℤ) + b * (pe p0 : ℤ)
    let g0 : ℕ := Nat.gcd c.natAbs K0.natAbs
    let h0 : ℕ := c.natAbs / g0
    let h : ℤ := (h0 : ℤ)
    let q : ℤ := c.sign * K0.sign * ((K0.natAbs / g0 : ℕ) : ℤ)
    K0 ≠ 0 ∧ m ≠ 0 ∧ m ∣ K0 ∧
    0 < g0 ∧ 0 < h0 ∧ q ≠ 0 ∧ c*q = K0*h ∧
    Nat.Coprime h0 q.natAbs ∧
    c ∣ S * (pd p0 : ℤ) + R * (pe p0 : ℤ) ∧
    (b*S-a*R)*h =
      c*(q-(Nat.choose (2*k) (k-1) : ℤ)*h*a^(k+1)*b^(k+1)) ∧
    ∃ f g : Polynomial ℤ,
      f.natDegree ≤ k+1 ∧ g.natDegree ≤ k+1 ∧
      f.coeff (k+1) = q*h^k*b^k ∧
      g.coeff (k+1) = (-1:ℤ)^k*q*h^k*a^k ∧
      (∀ y : ℤ,
        c*f.eval y =
          MvPolynomial.eval ![(pd p0 : ℤ)+b*h*y,(pe p0 : ℤ)-a*h*y] P ∧
        c*g.eval y =
          MvPolynomial.eval ![(pd p0 : ℤ)+b*h*y,(pe p0 : ℤ)-a*h*y] Q) ∧
      (∀ p ∈ Spts, ∃ y : ℤ,
        (pd p : ℤ) = (pd p0 : ℤ)+b*h*y ∧
        (pe p : ℤ) = (pe p0 : ℤ)-a*h*y ∧
        f.eval y = m^(2*k+1)*(pv p : ℤ) ∧
        g.eval y = m^(2*k+1)*(pu p : ℤ)) := by
  classical
  let S : ℤ := P.coeff (Finsupp.single (0 : Fin 2) (k + 1))
  let R : ℤ := P.coeff
    (Finsupp.single (0 : Fin 2) k + Finsupp.single (1 : Fin 2) 1)
  let T0 : ℤ := (Nat.choose (2*k) (k-1) : ℤ) * a^(k+1)*b^(k+1)
  let K0 : ℤ := b*S-a*R+(Nat.choose (2*k) (k-1) : ℤ)*c*a^(k+1)*b^(k+1)
  let m : ℤ := a*(pd p0 : ℤ)+b*(pe p0 : ℤ)
  let g0 : ℕ := Nat.gcd c.natAbs K0.natAbs
  let h0 : ℕ := c.natAbs/g0
  let h : ℤ := (h0 : ℤ)
  let q : ℤ := c.sign*K0.sign*((K0.natAbs/g0 : ℕ) : ℤ)
  have hS : S = P.coeff (binMono (k+1) 0) := by simp [S,binMono]
  have hR : R = P.coeff (binMono k 1) := by rfl
  have hKdef : K0 = b*S-a*R+c*T0 := by dsimp [K0,T0]; ring
  rcases hp0 with ⟨hd0,he0,hu0,hv0,_,_,_,_,_,_,_,_,_,_,hunit0,hgraph0,_⟩
  have hfirst := firstOriginalAlgebraicImplication k hk P Q a b c A B
    (pd p0) (pe p0) (pu p0) (pv p0)
    hP hQ hcoprime hc hab hpure hd0 he0 hu0 hv0 hunit0 hgraph0
  change K0 ≠ 0 ∧ m ≠ 0 ∧ m ∣ K0 ∧
    MvPolynomial.eval ![b,-a] P = b^k*K0 ∧
    MvPolynomial.eval ![b,-a] Q = (-1:ℤ)^k*a^k*K0 at hfirst
  obtain ⟨hK,hm0,hmdiv,hPeval,hQeval⟩ := hfirst
  have hunit0' :
      (pe p0 : ℤ)^k*(pv p0 : ℤ)-
      (pd p0 : ℤ)^k*(pu p0 : ℤ)=1 := hunit0
  have hgraph0' :
      MvPolynomial.eval ![(pd p0 : ℤ),(pe p0 : ℤ)] P*(pu p0 : ℤ) =
      MvPolynomial.eval ![(pd p0 : ℤ),(pe p0 : ℤ)] Q*(pv p0 : ℤ) := hgraph0
  have hanchor := anchored_integral_progression k P Q a b c S R K0
    (pd p0 : ℤ) (pe p0 : ℤ) (pu p0 : ℤ) (pv p0 : ℤ)
    hS hR (by dsimp [K0,T0]) hK hc hP hQ hpure hunit0' hgraph0'
  change 0 < g0 ∧ 0 < h0 ∧ q ≠ 0 ∧ c*q=K0*h ∧
    Nat.Coprime h0 q.natAbs ∧
    c ∣ S*(pd p0 : ℤ)+R*(pe p0 : ℤ) ∧
    (b*S-a*R)*h =
      c*(q-(Nat.choose (2*k) (k-1) : ℤ)*h*a^(k+1)*b^(k+1)) ∧
    ∃ f g : Polynomial ℤ, ∀ y : ℤ,
      c*f.eval y =
        MvPolynomial.eval ![(pd p0 : ℤ)+b*h*y,(pe p0 : ℤ)-a*h*y] P ∧
      c*g.eval y =
        MvPolynomial.eval ![(pd p0 : ℤ)+b*h*y,(pe p0 : ℤ)-a*h*y] Q
    at hanchor
  obtain ⟨hg0,hh0,hq0,hqeq,hcop,hcontent,hj1eq,⟨f0,g0',hfg⟩⟩ := hanchor
  obtain ⟨j0,hj0⟩ := hcontent
  let j1 : ℤ := q-(Nat.choose (2*k) (k-1) : ℤ)*h*a^(k+1)*b^(k+1)
  have hJ1 : S*(b*h)+R*(-a*h)=c*j1 := by
    dsimp [j1]
    linear_combination hj1eq
  let f := fProgression k a b (pd p0 : ℤ) (b*h)
    (pe p0 : ℤ) (-a*h) j0 j1
  let g := gProgression k a b (pd p0 : ℤ) (b*h)
    (pe p0 : ℤ) (-a*h) j0 j1
  have hJ0 : S*(pd p0 : ℤ)+R*(pe p0 : ℤ)=c*j0 := hj0
  have hfg' (y : ℤ) :
      c*f.eval y =
        MvPolynomial.eval ![(pd p0 : ℤ)+b*h*y,(pe p0 : ℤ)-a*h*y] P ∧
      c*g.eval y =
        MvPolynomial.eval ![(pd p0 : ℤ)+b*h*y,(pe p0 : ℤ)-a*h*y] Q := by
    have hh := integral_progression_values k P Q a b c S R
      (pd p0 : ℤ) (b*h) (pe p0 : ℤ) (-a*h) j0 j1 y
      hS hR hP hQ hpure hJ0 hJ1
    simpa [f,g,sub_eq_add_neg,mul_assoc] using hh
  have hdeg := progression_degree_le k a b (pd p0 : ℤ) (b*h)
    (pe p0 : ℤ) (-a*h) j0 j1
  have htop := progression_signed_top k P Q a b c S R K0 q h
    (pd p0 : ℤ) (pe p0 : ℤ) j0 j1 hc hS hR hP hQ hpure
    hPeval hQeval hqeq hJ1
  have hcert : ∀ p ∈ Spts, ∃ y : ℤ,
      (pd p : ℤ) = (pd p0 : ℤ)+b*h*y ∧
      (pe p : ℤ) = (pe p0 : ℤ)-a*h*y ∧
      f.eval y = m^(2*k+1)*(pv p : ℤ) ∧
      g.eval y = m^(2*k+1)*(pu p : ℤ) := by
    intro p hp
    obtain ⟨hp',hlevel⟩ := hSpts p hp
    rcases hp' with ⟨_,_,_,_,_,_,_,_,_,_,_,_,_,_,hunit,hgraph,_⟩
    have hcontent' := actual_content_divides k P Q a b c
      (pd p : ℤ) (pe p : ℤ) (pu p : ℤ) (pv p : ℤ)
      hP hQ hpure hunit hgraph
    have hcontent'' : c ∣ S*(pd p : ℤ)+R*(pe p : ℤ) := by
      simpa only [hS,hR] using hcontent'
    have hh := anchored_progression_graph_values k P Q a b c A B S R K0 T0
      (pd p0 : ℤ) (pe p0 : ℤ) (pd p : ℤ) (pe p : ℤ)
      (pu p : ℤ) (pv p : ℤ) f g hab hc hK hKdef
      hlevel ⟨j0,hj0⟩ hcontent'' hpure hunit hgraph hfg'
    simpa only [h,m] using hh
  change K0 ≠ 0 ∧ m ≠ 0 ∧ m ∣ K0 ∧
    0 < g0 ∧ 0 < h0 ∧ q ≠ 0 ∧ c*q=K0*h ∧
    Nat.Coprime h0 q.natAbs ∧
    c ∣ S*(pd p0 : ℤ)+R*(pe p0 : ℤ) ∧
    (b*S-a*R)*h = c*j1 ∧
    ∃ f g : Polynomial ℤ,
      f.natDegree ≤ k+1 ∧ g.natDegree ≤ k+1 ∧
      f.coeff (k+1)=q*h^k*b^k ∧
      g.coeff (k+1)=(-1:ℤ)^k*q*h^k*a^k ∧
      (∀ y : ℤ,
        c*f.eval y =
          MvPolynomial.eval ![(pd p0 : ℤ)+b*h*y,(pe p0 : ℤ)-a*h*y] P ∧
        c*g.eval y =
          MvPolynomial.eval ![(pd p0 : ℤ)+b*h*y,(pe p0 : ℤ)-a*h*y] Q) ∧
      (∀ p ∈ Spts, ∃ y : ℤ,
        (pd p : ℤ) = (pd p0 : ℤ)+b*h*y ∧
        (pe p : ℤ) = (pe p0 : ℤ)-a*h*y ∧
        f.eval y = m^(2*k+1)*(pv p : ℤ) ∧
        g.eval y = m^(2*k+1)*(pu p : ℤ))
  exact ⟨hK,hm0,hmdiv,hg0,hh0,hq0,hqeq,hcop,
    ⟨j0,hj0⟩,hj1eq,f,g,hdeg.1,hdeg.2,htop.1,htop.2,hfg',hcert⟩

private theorem original_actual_raw_crt_count
    (k : ℕ) (hk : 2 ≤ k) (P Q : MvPolynomial (Fin 2) ℤ)
    (a b c A B : ℤ) (p0 : OriginalPoint) (Spts : Finset OriginalPoint)
    (x D E U V M rho Ccell : ℝ)
    (hP : ∀ μ ∈ P.support, μ 0 + μ 1 = k + 1)
    (hQ : ∀ μ ∈ Q.support, μ 0 + μ 1 = k + 1)
    (hcoprime : ∀ F : MvPolynomial (Fin 2) ℚ,
      F ∣ MvPolynomial.map (Int.castRingHom ℚ) P →
      F ∣ MvPolynomial.map (Int.castRingHom ℚ) Q → IsUnit F)
    (hc : c ≠ 0) (hab : A*a+B*b=1)
    (hpure : MvPolynomial.X (1 : Fin 2)^k*P -
      MvPolynomial.X (0 : Fin 2)^k*Q =
      MvPolynomial.C c *
        (MvPolynomial.C a*MvPolynomial.X 0+
          MvPolynomial.C b*MvPolynomial.X 1)^(2*k+1))
    (hp0 : OriginalCellPoint k P Q x D E U V M rho Ccell p0)
    (hSpts : ∀ p ∈ Spts,
      OriginalCellPoint k P Q x D E U V M rho Ccell p ∧
      a*(pd p : ℤ)+b*(pe p : ℤ) =
        a*(pd p0 : ℤ)+b*(pe p0 : ℤ))
    (hD : 0 < D) (hE : 0 < E) (hM : 0 < M) (hC : 0 ≤ Ccell) :
    let S : ℤ := P.coeff (Finsupp.single (0 : Fin 2) (k+1))
    let R : ℤ := P.coeff
      (Finsupp.single (0 : Fin 2) k+Finsupp.single (1 : Fin 2) 1)
    let K0 : ℤ := b*S-a*R+
      (Nat.choose (2*k) (k-1) : ℤ)*c*a^(k+1)*b^(k+1)
    let m : ℤ := a*(pd p0 : ℤ)+b*(pe p0 : ℤ)
    let g0 : ℕ := Nat.gcd c.natAbs K0.natAbs
    let h0 : ℕ := c.natAbs/g0
    let h : ℤ := (h0 : ℤ)
    let q : ℤ := c.sign*K0.sign*((K0.natAbs/g0 : ℕ) : ℤ)
    let n : ℕ := (m^(2*k+1)).natAbs
    let N : ℕ := (q*h^k).natAbs
    let W : ℕ := ∏ p ∈ n.primeFactors,
      p^depth k (padicValNat p n) (padicValNat p N)
    0 < W ∧ n ∣ W^(k+1)*N ∧
    (Spts.card : ℝ) ≤
      (((k+1)^n.primeFactors.card : ℕ) : ℝ) *
        (2+2*Ccell*D*E/(M*|((m*h : ℤ) : ℝ)| * (W : ℝ))) := by
  classical
  let S : ℤ := P.coeff (Finsupp.single (0 : Fin 2) (k+1))
  let R : ℤ := P.coeff
    (Finsupp.single (0 : Fin 2) k+Finsupp.single (1 : Fin 2) 1)
  let K0 : ℤ := b*S-a*R+
    (Nat.choose (2*k) (k-1) : ℤ)*c*a^(k+1)*b^(k+1)
  let m : ℤ := a*(pd p0 : ℤ)+b*(pe p0 : ℤ)
  let g0 : ℕ := Nat.gcd c.natAbs K0.natAbs
  let h0 : ℕ := c.natAbs/g0
  let h : ℤ := (h0 : ℤ)
  let q : ℤ := c.sign*K0.sign*((K0.natAbs/g0 : ℕ) : ℤ)
  let n : ℕ := (m^(2*k+1)).natAbs
  let N : ℕ := (q*h^k).natAbs
  let W : ℕ := ∏ p ∈ n.primeFactors,
    p^depth k (padicValNat p n) (padicValNat p N)
  obtain ⟨hK,hm0,hmdiv,hg0,hh0,hq0,hqeq,hcop,hcontent,hj1,
      f,g,hfd,hgd,hft,hgt,hfg,hcert⟩ :=
    original_actual_point_transport k hk P Q a b c A B p0 Spts
      x D E U V M rho Ccell hP hQ hcoprime hc hab hpure hp0 hSpts
  have hh0' : h ≠ 0 := by
    change (h0 : ℤ) ≠ 0
    exact_mod_cast (Nat.ne_of_gt hh0)
  have hcover := original_allprime_cover_and_modulus k a b A B q h m
    f g hab hm0 hq0 hh0' hfd hgd hft hgt
  change 0 < W ∧ n ∣ W^(k+1)*N ∧
    ∃ T : Finset ℤ, T.card ≤ (k+1)^n.primeFactors.card ∧
      ∀ z u v : ℤ,
        f.eval z = m^(2*k+1)*v →
        g.eval z = m^(2*k+1)*u →
        ∃ center ∈ T, (W : ℤ) ∣ z-center at hcover
  obtain ⟨hW,hmod,T,hTc,hTv⟩ := hcover
  have hraw := original_point_count_from_certificates
    k P Q x D E U V M rho Ccell a b A B m h p0
    Spts f g T W hab rfl hm0 hh0' hD hE hM hC hW
    (fun p hp => (hSpts p hp).1) hcert hTv
  have hfac : 0 ≤
      2+2*Ccell*D*E/(M*|((m*h : ℤ) : ℝ)| * (W : ℝ)) := by
    have hmhr : ((m*h : ℤ) : ℝ) ≠ 0 := by
      exact_mod_cast (mul_ne_zero hm0 hh0')
    have hWr : (0 : ℝ) < W := by exact_mod_cast hW
    positivity
  have hTcR : (T.card : ℝ) ≤
      (((k+1)^n.primeFactors.card : ℕ) : ℝ) := by
    exact_mod_cast hTc
  have hraw' : (Spts.card : ℝ) ≤
      (((k+1)^n.primeFactors.card : ℕ) : ℝ) *
        (2+2*Ccell*D*E/(M*|((m*h : ℤ) : ℝ)| * (W : ℝ))) := by
    nlinarith [mul_le_mul_of_nonneg_right hTcR hfac]
  change 0 < W ∧ n ∣ W^(k+1)*N ∧
    (Spts.card : ℝ) ≤
      (((k+1)^n.primeFactors.card : ℕ) : ℝ) *
        (2+2*Ccell*D*E/(M*|((m*h : ℤ) : ℝ)| * (W : ℝ)))
  exact ⟨hW,hmod,hraw'⟩

private theorem original_fixed_height_divisor_subpower
    (k H : ℕ) (eps : ℝ) (heps : 0 < eps) :
    ∃ C : ℝ, 1 ≤ C ∧
      ∀ (x : ℝ) (K : ℤ), 2 ≤ x → K ≠ 0 →
        |(K : ℝ)| ≤
          ((Nat.choose (2*k) (k-1) : ℝ)+2) * x^((2*k+3)*H) →
        (K.natAbs.divisors.card : ℝ) ≤ C*x^eps := by
  let n : ℕ := (2*k+3)*H+1
  have hn : 0 < n := by dsimp [n]; omega
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  let eta : ℝ := eps/(n : ℝ)
  have heta : 0 < eta := div_pos heps hnR
  obtain ⟨C0,hC0,hdiv⟩ :=
    JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C01.PcLowdegRed.divisor_bound
      eta heta
  let B : ℝ := (Nat.choose (2*k) (k-1) : ℝ)+2
  have hB : 0 ≤ B := by dsimp [B]; positivity
  refine ⟨max 1 (C0*B^eta),le_max_left _ _,?_⟩
  intro x K hx hK hbound
  have hx0 : 0 < x := by linarith
  have habs : (K.natAbs : ℝ) = |(K : ℝ)| := by
    rw [← Int.cast_natCast,Int.natCast_natAbs,Int.cast_abs]
  have hxp : x^((2*k+3)*H) ≤ x^n := by
    apply pow_le_pow_right₀
    · linarith
    · dsimp [n]; omega
  have hcap : (K.natAbs : ℝ) ≤ B*x^n := by
    rw [habs]
    exact hbound.trans (mul_le_mul_of_nonneg_left hxp hB)
  have heta_eq : (n : ℝ)*eta=eps := by
    dsimp only [eta]
    field_simp [hnR.ne']
  have hrpow : (B*x^n)^eta=B^eta*x^eps := by
    rw [Real.mul_rpow hB (pow_nonneg hx0.le n)]
    congr 1
    calc
      (x^n)^eta=(x^(n:ℝ))^eta := by rw [Real.rpow_natCast]
      _ = x^((n:ℝ)*eta) := (Real.rpow_mul hx0.le _ _).symm
      _ = x^eps := by rw [heta_eq]
  calc
    (K.natAbs.divisors.card : ℝ) ≤ C0*(K.natAbs:ℝ)^eta :=
      hdiv K.natAbs (Int.natAbs_ne_zero.mpr hK)
    _ ≤ C0*(B*x^n)^eta :=
      mul_le_mul_of_nonneg_left
        (Real.rpow_le_rpow (Nat.cast_nonneg _) hcap heta.le) (by linarith)
    _ = (C0*B^eta)*x^eps := by rw [hrpow]; ring
    _ ≤ max 1 (C0*B^eta)*x^eps :=
      mul_le_mul_of_nonneg_right (le_max_right _ _) (Real.rpow_nonneg hx0.le _)

private theorem original_K0_height
    (k H : ℕ) (x : ℝ) (S R a b c : ℤ)
    (hx : 2 ≤ x)
    (hS : |(S : ℝ)| ≤ x^H) (hR : |(R : ℝ)| ≤ x^H)
    (ha : |(a : ℝ)| ≤ x^H) (hb : |(b : ℝ)| ≤ x^H)
    (hc : |(c : ℝ)| ≤ x^H) :
    |((b*S-a*R+(Nat.choose (2*k) (k-1) : ℤ)*c*a^(k+1)*b^(k+1) : ℤ) : ℝ)| ≤
      ((Nat.choose (2*k) (k-1) : ℝ)+2)*x^((2*k+3)*H) := by
  let Y : ℝ := x^H
  let B : ℝ := (Nat.choose (2*k) (k-1) : ℝ)
  have hx1 : 1 ≤ x := by linarith
  have hY : 1 ≤ Y := one_le_pow₀ hx1
  have hY0 : 0 ≤ Y := by linarith
  have hB : 0 ≤ B := by dsimp [B]; positivity
  have hsmall : |(b : ℝ)*(S : ℝ)-(a : ℝ)*(R : ℝ)| ≤ 2*Y^2 := by
    calc
      _ ≤ |(b : ℝ)*(S : ℝ)|+|(a : ℝ)*(R : ℝ)| := abs_sub _ _
      _ = |(b : ℝ)| *|(S : ℝ)|+|(a : ℝ)| *|(R : ℝ)| := by rw [abs_mul,abs_mul]
      _ ≤ Y*Y+Y*Y := add_le_add
        (mul_le_mul hb hS (abs_nonneg _) hY0)
        (mul_le_mul ha hR (abs_nonneg _) hY0)
      _ = 2*Y^2 := by ring
  have hlarge :
      |B*(c : ℝ)*(a : ℝ)^(k+1)*(b : ℝ)^(k+1)| ≤ B*Y^(2*k+3) := by
    calc
      _ = B*|(c : ℝ)| *|(a : ℝ)|^(k+1)*|(b : ℝ)|^(k+1) := by
        rw [abs_mul,abs_mul,abs_mul,abs_of_nonneg hB,abs_pow,abs_pow]
      _ ≤ B*Y*Y^(k+1)*Y^(k+1) := by gcongr
      _ = B*(Y^1*Y^(k+1)*Y^(k+1)) := by simp only [pow_one];ring
      _ = B*Y^(1+(k+1)+(k+1)) := by rw [← pow_add,← pow_add]
      _ = B*Y^(2*k+3) := by congr 2 <;> omega
  have hpow : Y^2 ≤ Y^(2*k+3) :=
    pow_le_pow_right₀ hY (by omega)
  have hnorm : Y^(2*k+3)=x^((2*k+3)*H) := by
    dsimp [Y]
    rw [← pow_mul,Nat.mul_comm H (2*k+3)]
  push_cast
  change |(b : ℝ)*(S : ℝ)-(a : ℝ)*(R : ℝ)+
    B*(c : ℝ)*(a : ℝ)^(k+1)*(b : ℝ)^(k+1)| ≤ (B+2)*x^((2*k+3)*H)
  calc
    _ ≤ |(b : ℝ)*(S : ℝ)-(a : ℝ)*(R : ℝ)|+
      |B*(c : ℝ)*(a : ℝ)^(k+1)*(b : ℝ)^(k+1)| := abs_add_le _ _
    _ ≤ 2*Y^2+B*Y^(2*k+3) := add_le_add hsmall hlarge
    _ ≤ 2*Y^(2*k+3)+B*Y^(2*k+3) := by linarith
    _ = (B+2)*x^((2*k+3)*H) := by rw [hnorm];ring

private theorem original_root_weight_le_divisor_power
    (k : ℕ) (K m : ℤ) (hK : K ≠ 0) (hm : m ∣ K) :
    ((((k+1)^((m^(2*k+1)).natAbs.primeFactors.card) : ℕ) : ℝ)) ≤
      (K.natAbs.divisors.card : ℝ)^k := by
  have hsub : (m^(2*k+1)).natAbs.primeFactors ⊆ K.natAbs.primeFactors := by
    intro p hp
    obtain ⟨hpp,hpd,_⟩ := Nat.mem_primeFactors.mp hp
    have hpm : p ∣ m.natAbs :=
      hpp.dvd_of_dvd_pow (by simpa only [Int.natAbs_pow] using hpd)
    exact Nat.mem_primeFactors.mpr
      ⟨hpp,dvd_trans hpm (Int.natAbs_dvd_natAbs.mpr hm),
        Int.natAbs_ne_zero.mpr hK⟩
  have hcard := Finset.card_le_card hsub
  have hbase : ((k+1 : ℕ) : ℝ) ≤ (2 : ℝ)^k := by
    exact_mod_cast (show k+1 ≤ 2^k from Nat.lt_two_pow_self)
  have htwo : (2 : ℝ)^K.natAbs.primeFactors.card ≤ (K.natAbs.divisors.card : ℝ) := by
    exact_mod_cast
      JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C01.PcLowdegRed.two_pow_card_primeFactors_le
        K.natAbs (Int.natAbs_ne_zero.mpr hK)
  push_cast
  calc
    ((k : ℝ)+1)^((m^(2*k+1)).natAbs.primeFactors.card) ≤
      ((2 : ℝ)^k)^((m^(2*k+1)).natAbs.primeFactors.card) :=
        pow_le_pow_left₀ (by positivity) (by simpa using hbase) _
    _ ≤ ((2 : ℝ)^k)^K.natAbs.primeFactors.card :=
      pow_le_pow_right₀ (one_le_pow₀ (by norm_num)) hcard
    _ = ((2 : ℝ)^K.natAbs.primeFactors.card)^k := by rw [← pow_mul,← pow_mul,Nat.mul_comm]
    _ ≤ (K.natAbs.divisors.card : ℝ)^k :=
      pow_le_pow_left₀ (by positivity) htwo _

private theorem original_fixed_height_subpowers
    (k H : ℕ) (hk : 2 ≤ k) (eps : ℝ) (heps : 0 < eps) :
    ∃ C : ℝ, 1 ≤ C ∧
      ∀ (x : ℝ) (K m : ℤ), 2 ≤ x → K ≠ 0 → m ∣ K →
        |(K : ℝ)| ≤
          ((Nat.choose (2*k) (k-1) : ℝ)+2)*x^((2*k+3)*H) →
        (((k+1)^((m^(2*k+1)).natAbs.primeFactors.card) : ℕ) : ℝ) ≤ C*x^eps ∧
        (K.natAbs.divisors.card : ℝ) ≤ C*x^eps := by
  have hkR : (0 : ℝ) < k := by exact_mod_cast (show 0 < k by omega)
  let eta : ℝ := eps/(k : ℝ)
  have heta : 0 < eta := div_pos heps hkR
  obtain ⟨C0,hC0,hdiv0⟩ := original_fixed_height_divisor_subpower k H eta heta
  obtain ⟨C1,hC1,hdiv1⟩ := original_fixed_height_divisor_subpower k H eps heps
  let C := max 1 (max (C0^k) C1)
  refine ⟨C,le_max_left _ _,?_⟩
  intro x K m hx hK hm hbound
  have hx0 : 0 < x := by linarith
  have heq : eta*(k : ℝ)=eps := by dsimp [eta];field_simp [hkR.ne']
  have hpow : (x^eta)^k=x^eps := by
    rw [← Real.rpow_natCast (x^eta) k,← Real.rpow_mul hx0.le,heq]
  constructor
  · calc
      _ ≤ (K.natAbs.divisors.card : ℝ)^k :=
        original_root_weight_le_divisor_power k K m hK hm
      _ ≤ (C0*x^eta)^k :=
        pow_le_pow_left₀ (by positivity) (hdiv0 x K hx hK hbound) _
      _ = C0^k*x^eps := by rw [mul_pow,hpow]
      _ ≤ C*x^eps := mul_le_mul_of_nonneg_right
        ((le_max_left (C0^k) C1).trans (le_max_right 1 _)) (Real.rpow_nonneg hx0.le _)
  · exact (hdiv1 x K hx hK hbound).trans
      (mul_le_mul_of_nonneg_right
        ((le_max_right (C0^k) C1).trans (le_max_right 1 _)) (Real.rpow_nonneg hx0.le _))

private theorem rpow_nat_pow (z : ℝ) (hz : 0 ≤ z) (n : ℕ) (t : ℝ) :
    (z^n)^t=z^((n : ℝ)*t) := by
  rw [← Real.rpow_natCast z n,← Real.rpow_mul hz]

private theorem original_modulus_real_shoulder
    (k : ℕ) (Q H L W : ℝ)
    (hQ : 0 < Q) (hH : 0 < H) (hL : 0 < L) (hW : 0 < W)
    (hmod : L^(2*k+1) ≤ W^(k+1)*Q*H^k) :
    1/(L*H*W) ≤
      Q^(1/((k+1 : ℕ) : ℝ)) *
      H^(-(1/((k+1 : ℕ) : ℝ))) *
      L^(-(((3*k+2 : ℕ) : ℝ)/((k+1 : ℕ) : ℝ))) := by
  let d : ℝ := ((k+1 : ℕ) : ℝ)
  let s : ℝ := 1/d
  let t : ℝ := ((3*k+2 : ℕ) : ℝ)/d
  let alpha : ℝ := ((2*k+1 : ℕ) : ℝ)*s
  have hd : 0 < d := by dsimp [d];positivity
  have hs : 0 ≤ s := by dsimp [s];positivity
  have hds : ((k+1 : ℕ) : ℝ)*s=1 := by dsimp [s,d];field_simp
  have hp := Real.rpow_le_rpow (pow_nonneg hL.le _) hmod hs
  have hleft : (L^(2*k+1))^s=L^alpha := by dsimp [alpha];exact rpow_nat_pow _ hL.le _ _
  have hright : (W^(k+1)*Q*H^k)^s=W*Q^s*H^((k : ℝ)*s) := by
    rw [Real.mul_rpow (mul_nonneg (pow_nonneg hW.le _) hQ.le) (pow_nonneg hH.le _),
      Real.mul_rpow (pow_nonneg hW.le _) hQ.le,
      rpow_nat_pow W hW.le,rpow_nat_pow H hH.le,hds,Real.rpow_one]
  rw [hleft,hright] at hp
  have hHexp : H^(-s)*H=H^((k : ℝ)*s) := by
    conv_lhs => rhs;rw [← Real.rpow_one H]
    rw [← Real.rpow_add hH]
    congr 1
    dsimp [s,d]
    push_cast
    field_simp
    ring
  have hLexp : L^(-t)*L=L^(-alpha) := by
    conv_lhs => rhs;rw [← Real.rpow_one L]
    rw [← Real.rpow_add hL]
    congr 1
    dsimp [t,alpha,s,d]
    push_cast
    field_simp
    ring
  have hprod : 1 ≤
      (W*Q^s*H^((k : ℝ)*s))*L^(-alpha) := by
    have hh := mul_le_mul_of_nonneg_right hp (Real.rpow_nonneg hL.le (-alpha))
    have heq : L^alpha*L^(-alpha)=1 := by
      rw [← Real.rpow_add hL,add_neg_cancel,Real.rpow_zero]
    rwa [heq] at hh
  have hden : 0 < L*H*W := by positivity
  apply (div_le_iff₀ hden).2
  change 1 ≤ (Q^s*H^(-s)*L^(-t))*(L*H*W)
  calc
    1 ≤ (W*Q^s*H^((k : ℝ)*s))*L^(-alpha) := hprod
    _ = Q^s*(H^(-s)*H)*(L^(-t)*L)*W := by rw [hHexp,hLexp];ring
    _ = _ := by ring

theorem originalArithmeticCRTStatement : OriginalArithmeticCRTStatement := by
  intro k hk H eps Ccell heps hCcell
  obtain ⟨C0,hC0,hsub⟩ := original_fixed_height_subpowers k H hk eps heps
  let C : ℝ := (2+2*Ccell)*C0
  have hC0z : 0 ≤ C0 := by linarith
  have hC : 0 < C := by dsimp [C];positivity
  have hC0C : C0 ≤ C := by
    dsimp [C]
    nlinarith
  refine ⟨C,hC,?_⟩
  intro x D E U V M rho P Q a b c A B p0 Spts hx hD hE hU hV hM hMx
    hP hQ hcoeff ha hb hcHeight hcoprime hc hab hpure hp0 hSpts
  classical
  let S : ℤ := P.coeff (Finsupp.single (0 : Fin 2) (k+1))
  let R : ℤ := P.coeff
    (Finsupp.single (0 : Fin 2) k+Finsupp.single (1 : Fin 2) 1)
  let K0 : ℤ := b*S-a*R+
    (Nat.choose (2*k) (k-1) : ℤ)*c*a^(k+1)*b^(k+1)
  let m : ℤ := a*(pd p0 : ℤ)+b*(pe p0 : ℤ)
  let g0 : ℕ := Nat.gcd c.natAbs K0.natAbs
  let h0 : ℕ := c.natAbs/g0
  let h : ℤ := (h0 : ℤ)
  let q : ℤ := c.sign*K0.sign*((K0.natAbs/g0 : ℕ) : ℤ)
  let n : ℕ := (m^(2*k+1)).natAbs
  let N : ℕ := (q*h^k).natAbs
  let W : ℕ := ∏ p ∈ n.primeFactors,
    p^depth k (padicValNat p n) (padicValNat p N)
  obtain ⟨hK,hm0,hmdiv,hg0,hh0,hq0,hqeq,hcop,hcontent,hj1,
      f,g,hfd,hgd,hft,hgt,hfg,hcert⟩ :=
    original_actual_point_transport k hk P Q a b c A B p0 Spts
      x D E U V M rho Ccell hP hQ hcoprime hc hab hpure hp0 hSpts
  have hh0' : h ≠ 0 := by
    change (h0 : ℤ) ≠ 0
    exact_mod_cast (Nat.ne_of_gt hh0)
  have hheight : |(K0 : ℝ)| ≤
      ((Nat.choose (2*k) (k-1) : ℝ)+2)*x^((2*k+3)*H) :=
    original_K0_height k H x S R a b c hx
      (hcoeff _).1 (hcoeff _).1 ha hb hcHeight
  obtain ⟨hweight,hdiv⟩ := hsub x K0 m hx hK hmdiv hheight
  have hcover := original_allprime_cover_and_modulus k a b A B q h m
    f g hab hm0 hq0 hh0' hfd hgd hft hgt
  change 0 < W ∧ n ∣ W^(k+1)*N ∧
    ∃ T : Finset ℤ, T.card ≤ (k+1)^n.primeFactors.card ∧
      ∀ z u v : ℤ,
        f.eval z = m^(2*k+1)*v →
        g.eval z = m^(2*k+1)*u →
        ∃ center ∈ T, (W : ℤ) ∣ z-center at hcover
  obtain ⟨hW,hmod,T,hTc,hTv⟩ := hcover
  have hM0 : 0 < M := by linarith
  have hx0 : 0 < x := by linarith
  have hbase := original_point_count_from_certificates
    k P Q x D E U V M rho Ccell a b A B m h p0
    Spts f g T W hab rfl hm0 hh0' hD hE hM0 hCcell hW
    (fun p hp => (hSpts p hp).1) hcert hTv
  have hfac : 0 ≤
      2+2*Ccell*D*E/(M*|((m*h : ℤ) : ℝ)| * (W : ℝ)) := by
    have hWr : (0 : ℝ) < W := by exact_mod_cast hW
    positivity
  have hTcR : (T.card : ℝ) ≤ (((k+1)^n.primeFactors.card : ℕ) : ℝ) := by
    exact_mod_cast hTc
  have hraw : (Spts.card : ℝ) ≤
      (((k+1)^n.primeFactors.card : ℕ) : ℝ) *
        (2+2*Ccell*D*E/(M*|((m*h : ℤ) : ℝ)| * (W : ℝ))) :=
    hbase.trans (mul_le_mul_of_nonneg_right hTcR hfac)
  have hmr : (0 : ℝ) < m.natAbs := by exact_mod_cast (Int.natAbs_pos.mpr hm0)
  have hqr : (0 : ℝ) < q.natAbs := by exact_mod_cast (Int.natAbs_pos.mpr hq0)
  have hhr : (0 : ℝ) < h0 := by exact_mod_cast hh0
  have hWr : (0 : ℝ) < W := by exact_mod_cast hW
  have hNpos : 0 < N :=
    Int.natAbs_pos.mpr (mul_ne_zero hq0 (pow_ne_zero k hh0'))
  have hcapNat : n ≤ W^(k+1)*N :=
    Nat.le_of_dvd (mul_pos (pow_pos hW _) hNpos) hmod
  have hcap : (m.natAbs : ℝ)^(2*k+1) ≤
      (W : ℝ)^(k+1)*(q.natAbs : ℝ)*(h0 : ℝ)^k := by
    have hr : (n : ℝ) ≤ ((W^(k+1)*N : ℕ) : ℝ) := by exact_mod_cast hcapNat
    simpa only [n,N,h,Int.natAbs_pow,Int.natAbs_mul,Int.natAbs_natCast,
      Nat.cast_pow,Nat.cast_mul,mul_assoc] using hr
  have hshoulder := original_modulus_real_shoulder k
    (q.natAbs : ℝ) (h0 : ℝ) (m.natAbs : ℝ) (W : ℝ) hqr hhr hmr hWr hcap
  have hmabs : (m.natAbs : ℝ)=|(m : ℝ)| := by
    rw [← Int.cast_natCast,Int.natCast_natAbs,Int.cast_abs]
  have hmhabs : |((m*h : ℤ) : ℝ)|=(m.natAbs : ℝ)*(h0 : ℝ) := by
    simp only [h,Int.cast_mul,Int.cast_natCast,abs_mul,abs_of_nonneg hhr.le,
      ← hmabs]
  let Z : ℝ := D*E/M *
    (q.natAbs : ℝ)^(1/((k+1 : ℕ) : ℝ)) *
    (h0 : ℝ)^(-(1/((k+1 : ℕ) : ℝ))) *
    (m.natAbs : ℝ)^(-(((3*k+2 : ℕ) : ℝ)/((k+1 : ℕ) : ℝ)))
  have hZ : 0 ≤ Z := by dsimp [Z];positivity
  have hfactor :
      2+2*Ccell*D*E/(M*|((m*h : ℤ) : ℝ)| * (W : ℝ)) ≤
        (2+2*Ccell)*(1+Z) := by
    rw [hmhabs]
    have hs := mul_le_mul_of_nonneg_left hshoulder
      (show 0 ≤ 2*Ccell*(D*E/M) by positivity)
    have he1 : 2*Ccell*(D*E/M)*(1/((m.natAbs : ℝ)*(h0 : ℝ)*(W : ℝ))) =
        2*Ccell*D*E/(M*((m.natAbs : ℝ)*(h0 : ℝ))*(W : ℝ)) := by
      field_simp
    have he2 : 2*Ccell*(D*E/M)*
        ((q.natAbs : ℝ)^(1/((k+1 : ℕ) : ℝ)) *
          (h0 : ℝ)^(-(1/((k+1 : ℕ) : ℝ))) *
          (m.natAbs : ℝ)^(-(((3*k+2 : ℕ) : ℝ)/((k+1 : ℕ) : ℝ)))) =
        2*Ccell*Z := by dsimp [Z];ring
    rw [he1,he2] at hs
    nlinarith
  have hfinal : (Spts.card : ℝ) ≤ C*x^eps*(1+Z) := by
    calc
      _ ≤ (((k+1)^n.primeFactors.card : ℕ) : ℝ) *
          (2+2*Ccell*D*E/(M*|((m*h : ℤ) : ℝ)| * (W : ℝ))) := hraw
      _ ≤ (((k+1)^n.primeFactors.card : ℕ) : ℝ) *
          ((2+2*Ccell)*(1+Z)) :=
        mul_le_mul_of_nonneg_left hfactor (Nat.cast_nonneg _)
      _ ≤ (C0*x^eps)*((2+2*Ccell)*(1+Z)) :=
        mul_le_mul_of_nonneg_right hweight (by positivity)
      _ = C*x^eps*(1+Z) := by dsimp [C];ring
  refine ⟨hK,hm0,hmdiv,hg0,hh0,hq0,hqeq,hcop,hcontent,hj1,
    f,g,hfd,hgd,hft,hgt,hfg,hcert,hW,hmod,⟨T,hTc,?_⟩,hraw,?_,?_,hfinal⟩
  · intro y hfy hgy
    have hnat : (n : ℤ)=|m^(2*k+1)| := Int.natCast_natAbs _
    have hfdiv : m^(2*k+1) ∣ f.eval y := by
      rwa [hnat,abs_dvd] at hfy
    have hgdiv : m^(2*k+1) ∣ g.eval y := by
      rwa [hnat,abs_dvd] at hgy
    obtain ⟨v,hv⟩ := hfdiv
    obtain ⟨u,hu⟩ := hgdiv
    exact hTv y u v hv hu
  · exact hweight.trans
      (mul_le_mul_of_nonneg_right hC0C (Real.rpow_nonneg hx0.le _))
  · exact hdiv.trans
      (mul_le_mul_of_nonneg_right hC0C (Real.rpow_nonneg hx0.le _))

end OddPureOriginalCRTAtLeastTwo

