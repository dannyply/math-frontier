variable {K:Type*} [Field K] [Algebra ℚ K]
lemma pG (k:ℕ) (hk:0< k)
    (G:aa (Fin 4) ℤ)
    (A P:Matrix (Fin 2) (Fin 2) ℤ) (hPA:P*A=1)
    (hA:ac.Inc (ak G) (az k)→ₐ[ℚ] K)
    (hi:uX hA.toLinearMap)
    (d e t:K) (ht:t ≠ 0) (H0:ah.wG)
    (hmap:hA.comp (aJ k G A)= ao.bj k
        (b5.cM A d e) (b5.cN A d e) t)
    (hker:RingHom.ker (ao.eta d e t).toRingHom= a5 ({H0}:Set ah.wG))
    (m:ℕ):
