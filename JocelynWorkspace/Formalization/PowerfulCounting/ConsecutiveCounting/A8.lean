  | zero => simp
  | succ k ih =>
    have h1 : (0 : ℝ) ≤ 1 + a := by linarith
    have h2 := mul_le_mul_of_nonneg_right ih h1
    have h3 : (0 : ℝ) ≤ (k : ℝ) * a * a := by positivity
    rw [pow_succ]
    push_cast
    nlinarith

