  have hcov : tail k x \ S ⊆
      ⋃ j ∈ Finset.range (Nat.log 2 ⌊x⌋₊ + 2), ⋃ a ∈ Finset.range (Nat.log 2 ⌊x⌋₊ + 2),
        ⋃ b ∈ Finset.range (Nat.log 2 ⌊x⌋₊ + 2),
          ((box k (x / 2 ^ j) (2 ^ a) (2 ^ b) ∩ tail k x) \ S) := by
    rintro q ⟨hq, hqS⟩
    obtain ⟨j, a, b, hj, ha, hb, hbox⟩ := point_index k hk x hx q hq
    simp only [Set.mem_iUnion, Finset.mem_range, exists_prop]
    exact ⟨j, hj, a, ha, b, hb, ⟨hbox, hq⟩, hqS⟩
  have hUfin : (⋃ j ∈ Finset.range (Nat.log 2 ⌊x⌋₊ + 2), ⋃ a ∈ Finset.range (Nat.log 2 ⌊x⌋₊ + 2),
        ⋃ b ∈ Finset.range (Nat.log 2 ⌊x⌋₊ + 2),
          ((box k (x / 2 ^ j) (2 ^ a) (2 ^ b) ∩ tail k x) \ S)).Finite := by
    apply hfin.subset
    intro q hq
    simp only [Set.mem_iUnion, Finset.mem_range, exists_prop] at hq
    obtain ⟨j, _, a, _, b, _, hq⟩ := hq
    exact hq.1.2
  have h1 := Set.ncard_le_ncard hcov hUfin
  have h2 : (⋃ j ∈ Finset.range (Nat.log 2 ⌊x⌋₊ + 2), ⋃ a ∈ Finset.range (Nat.log 2 ⌊x⌋₊ + 2),
