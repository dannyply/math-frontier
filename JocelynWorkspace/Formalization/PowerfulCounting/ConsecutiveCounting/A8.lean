      F.coeff (2*k+1)=(-1:ℝ)^k*lam ∧
      (∀ z x : ℝ, 0≤x → C₁≤|z| → C₁≤|lam| *|z|^2 →
        C₁*x≤|lam| *|z|^(2*k+1) → |F.eval z|≤x →
        c₁*|lam| *|z|^(2*k)≤|F.derivative.eval z|) ∧
      (∀ z : ℝ, C₂≤|z| → |F.eval z|≤c₂*|z|^(2*k-1) →
        |F.derivative.eval z|≤c₂*|z|^(2*k-2) →
        c₂*|z|^(2*k-3)≤|F.derivative.derivative.eval z|) := by
  obtain ⟨H,hHd,hHX,hH1,c₂,C₂,hc₂,hc₂1,hC₂,hstiff⟩ :=
    JocelynClaims.claim_7c0763787896f52c97f48d131bb43d4a0f10f2f598455c653cb1504336591715 k hk
  obtain ⟨J,hJd,hJX,hJ1,hJuniq,hJform⟩ :=
    JocelynClaims.claim_e6440215d691076eb060d1df90be353d199534ed67b3253e9acb2ebc65218e39 k hk
  have hJH : J=H := (hJuniq H hHd.le hHX hH1).symm
  rw [hJH] at hJform
  obtain ⟨c₁,C₁,hc₁,hc₁1,hC₁,hfirst⟩ :=
    JocelynClaims.claim_04747d85f791c9ba26152da24094910ec24c2ac28367376b955ec3c53e2ab411 k hk H hHd.le
  refine ⟨H,hHd,hHX,hH1,c₁,C₁,c₂,C₂,hc₁,hc₁1,hC₁,hc₂,hc₂1,hC₂,?_⟩
  intro P Q hQ a b c ell ha hb hc hell hres d e φ F
  obtain ⟨hFX,hF1,hFd⟩ := original_height_jets k P Q hQ a b c ell ha hb hc hell hres
  obtain ⟨kappa,lam,hform,hcoeff⟩ := hJform F hFd hFX hF1
  refine ⟨kappa,lam,hform,hcoeff,?_,?_⟩
  · intro z x hx hz hscale hscale2 hval
    rw [hform] at hval ⊢
    exact hfirst kappa lam z x hx hz hscale hscale2 hval
  · intro z hz hval hder
    rw [hform] at hval hder ⊢
    exact hstiff kappa lam z hz hval hder

end
