abbrev wB:=aa (Fin 4) ℤ
abbrev Mat:=Matrix (Fin 2) (Fin 2) ℤ
def cO (z:Fin 4→ ℤ) (h:ℤ):ac.Five→ₐ[ℚ] ℚ:= aeval ![(z 0:ℚ),(z 1:ℚ),(z 2:ℚ),(z 3:ℚ),(h:ℚ)]
lemma pH (G:wB):
    ac.wM (ak G)= eval₂Hom (uG ac.Five) ![X 0,X 1,X 2,X 3] G:=by
  have heq:
      eval₂Hom (uG ac.Five) ![X 0,X 1,X 2,X 3]= ac.wM.comp (uJ (uG ℚ)):=by
    apply bE
    · intro n
      simp [ac.wM]
    · intro i
      fin_cases i<;> simp [ac.wM]
  exact (congrArg (fun f:wB→+*ac.Five=> f G) heq).symm
lemma pI (G:wB) (z:Fin 4→ ℤ) (h:ℤ):
    cO z h (ac.wM (ak G))= (uI z G:ℤ):=by
  have heq:
      (cO z h).toRingHom.comp
        (eval₂Hom (uG ac.Five) ![X 0,X 1,X 2,X 3])= (uG ℚ).comp (uI z):=by
    apply bE
    · intro c
      have hh:
          ((cO z h).toRingHom.comp
            (eval₂Hom (uG ac.Five) ![X 0,X 1,X 2,X 3])).comp C= ((uG ℚ).comp (uI z)).comp C:= Subsingleton.elim _ _
      exact congrArg (fun ff:ℤ→+*ℚ=> ff c) hh
    · intro i
      fin_cases i<;> simp [cO]
  have hG:=congrArg (fun ff:wB→+*ℚ=> ff G) heq
  rw [pH]
  exact hG
lemma pJ (k:ℕ) (G:wB) (z:Fin 4→ ℤ) (h:ℤ)
    (vQ:h=1∨ h= -1) (hG:uI z G=0)
    (hF:(z 1)^k*z 3-(z 0)^k*z 2=h):
    ac.ideal (ak G) (az k)≤
      RingHom.ker (cO z h).toRingHom:=by
  change a5
    ({ac.wM (ak G),X 4*ac.wM (az k)-1}:
      Set ac.Five)≤ _
  apply Ideal.span_le.mpr
  intro p hp
  simp only [Set.mem_insert_iff,Set.mem_singleton_iff] at hp
  rcases hp with rfl | rfl
  · change cO z h (ac.wM (ak G))=0
    rw [pI,hG]
    simp
  · change cO z h (X 4*ac.wM (az k)-1)=0
    have hFQ:(z 1:ℚ)^k*(z 3:ℚ)-(z 0:ℚ)^k*(z 2:ℚ)=(h:ℚ):=by
      exact_mod_cast hF
    simp [cO,ac.wM,az]
    rw [hFQ]
    rcases vQ with rfl | rfl<;> norm_num
def fV (k:ℕ) (G:wB) (z:Fin 4→ ℤ) (h:ℤ)
    (vQ:h=1∨ h= -1) (hG:uI z G=0)
    (hF:(z 1)^k*z 3-(z 0)^k*z 2=h):
    ac.Inc (ak G) (az k)→+*ℚ:= Ideal.Quotient.lift (ac.ideal (ak G) (az k))
    (cO z h).toRingHom
    (fun _p hp=> pJ k G z h vQ hG hF hp)
def ag (A:Mat) (z:Fin 4→ ℤ):Fin 2→ ℤ:= ![A 0 0*z 0+A 0 1*z 1,A 1 0*z 0+A 1 1*z 1]
def cr (k:ℕ) (A:Mat) (h:ℤ) (z:Fin 4→ ℤ):
    Fin (k+1)→ ℤ:= fun i=> h*z 3*(ag A z 0)^(k-i.val)*(ag A z 1)^i.val
def eT (k:ℕ) (A:Mat) (h:ℤ) (z:Fin 4→ ℤ):
    Fin (k+1)→ ℚ:=fun i=>(cr k A h z i:ℚ)
lemma pK (k:ℕ) (G:wB) (A:Mat)
    (z:Fin 4→ ℤ) (h:ℤ) (vQ:h=1∨ h= -1)
    (hG:uI z G=0)
    (hF:(z 1)^k*z 3-(z 0)^k*z 2=h):
    (fV k G z h vQ hG hF).comp
      (aJ k G A).toRingHom= uI (eT k A h z):=by
  apply bE
  · intro c
    have hh:
        ((fV k G z h vQ hG hF).comp
          (aJ k G A).toRingHom).comp C= (uI (eT k A h z)).comp C:= Subsingleton.elim _ _
    exact congrArg (fun ff:ℚ→+*ℚ=> ff c) hh
  · intro i
    simp [aJ,fV,cO,eT,cr,ag,aeval_def]
lemma pL (k:ℕ) (G:wB) (A:Mat)
    (z:Fin 4→ ℤ) (h:ℤ) (vQ:h=1∨ h= -1)
    (hG:uI z G=0)
    (hF:(z 1)^k*z 3-(z 0)^k*z 2=h)
    (f:co k)
    (hf:f∈ RingHom.ker (aJ k G A).toRingHom):
    uI (eT k A h z) f=0:=by
  have hz:(aJ k G A).toRingHom f=0:=hf
  have hh:=congrArg (fun ff:co k→+*ℚ=> ff f)
    (pK k G A z h vQ hG hF)
  change fV k G z h vQ hG hF
    ((aJ k G A).toRingHom f)= uI (eT k A h z) f at hh
  rw [hz,map_zero] at hh
  exact hh.symm
def kb (k:ℕ) (h:ℤ):Set (Fin 4→ ℤ):= {z | (∀ i,0< z i)∧(z 1)^k*z 3-(z 0)^k*z 2=h}
lemma dL (P A:Mat) (hPA:P*A=1) (z:Fin 4→ ℤ):
    P 0 0*ag A z 0+P 0 1*ag A z 1=z 0∧ P 1 0*ag A z 0+P 1 1*ag A z 1=z 1:=by
  have h00:=congrArg (fun M:Mat=> M 0 0) hPA
  have h01:=congrArg (fun M:Mat=> M 0 1) hPA
  have h10:=congrArg (fun M:Mat=> M 1 0) hPA
  have h11:=congrArg (fun M:Mat=> M 1 1) hPA
  simp [bZ,Fin.sum_univ_two] at h00 h01 h10 h11
  constructor
  · show P 0 0*(A 0 0*z 0+A 0 1*z 1)+P 0 1*(A 1 0*z 0+A 1 1*z 1)=z 0
    linear_combination z 0*h00+z 1*h01
  · show P 1 0*(A 0 0*z 0+A 0 1*z 1)+P 1 1*(A 1 0*z 0+A 1 1*z 1)=z 1
    linear_combination z 0*h10+z 1*h11
lemma pM (k:ℕ) (hk:1≤ k) (h:ℤ)
    (vQ:h=1∨ h= -1) (z:Fin 4→ ℤ)
    (hz:(z 1)^k*z 3-(z 0)^k*z 2=h):
    IsCoprime (z 0) (z 1):=by
  have hh:h*h=1:=by rcases vQ with rfl|rfl<;> norm_num
  refine ⟨-h*(z 0)^(k-1)*z 2,h*(z 1)^(k-1)*z 3,?_⟩
  have hk':k-1+1=k:=cA hk
  rw [←hk',pow_succ,pow_succ] at hz
  linear_combination h*hz+hh
lemma gJ (k:ℕ) (hk:1≤ k) (P A:Mat) (hPA:P*A=1)
    (h:ℤ) (vQ:h=1∨ h= -1) (z:Fin 4→ ℤ)
    (hz:(z 1)^k*z 3-(z 0)^k*z 2=h):
    Int.gcd (ag A z 0) (ag A z 1)=1:=by
  rw [←Int.isCoprime_iff_gcd_eq_one]
  obtain ⟨r,s,hrs⟩:=pM k hk h vQ z hz
  obtain ⟨h0,h1⟩:=dL P A hPA z
  refine ⟨r*P 0 0+s*P 1 0,r*P 0 1+s*P 1 1,?_⟩
  linear_combination hrs+r*h0+s*h1
lemma kc (a b:ℤ) (h:Int.gcd a b=1):
    ¬(a=0∧ b=0):=by
  rintro ⟨ha,hb⟩
  rw [ha,hb] at h
  simp at h
lemma pN (a b a' b':ℤ) (h:Int.gcd a b=1) (h':Int.gcd a' b'=1)
    (hD:a*b'=a'*b):∃ k:ℤ,(k=1∨ k= -1)∧ a'=k*a∧ b'=k*b:=by
  have e1:(1:ℤ)=a*Int.gcdA a b+b*Int.gcdB a b:=by
    have:=Int.gcd_eq_gcd_ab a b;rw [h] at this;exact_mod_cast this
  have e2:(1:ℤ)=a'*Int.gcdA a' b'+b'*Int.gcdB a' b':=by
    have:=Int.gcd_eq_gcd_ab a' b';rw [h'] at this;exact_mod_cast this
  have hD':a'*b=a*b':=hD.symm
  have ha':a'=(a'*Int.gcdA a b+b'*Int.gcdB a b)*a:=by
    linear_combination a'*e1-(Int.gcdB a b)*hD
  have hb':b'=(a'*Int.gcdA a b+b'*Int.gcdB a b)*b:=by
    linear_combination b'*e1+(Int.gcdA a b)*hD
  have ha:a=(a*Int.gcdA a' b'+b*Int.gcdB a' b')*a':=by
    linear_combination a*e2-(Int.gcdB a' b')*hD'
  have hb:b=(a*Int.gcdA a' b'+b*Int.gcdB a' b')*b':=by
    linear_combination b*e2+(Int.gcdA a' b')*hD'
  set k:=a'*Int.gcdA a b+b'*Int.gcdB a b with hk
  set k':=a*Int.gcdA a' b'+b*Int.gcdB a' b' with hk'
  have hkk:k'*k=1:=by
    by_cases ha0:a=0
    · have hb0:b ≠ 0:=fun hb0=> kc a b h ⟨ha0,hb0⟩
      have h1:(k'*k)*b=1*b:=by
        calc (k'*k)*b=k'*(k*b):=by ring
          _=k'*b':=by rw [← hb']
          _=b:=hb.symm
          _=1*b:=by ring
      exact da hb0 h1
    · have h1:(k'*k)*a=1*a:=by
        calc (k'*k)*a=k'*(k*a):=by ring
          _=k'*a':=by rw [← ha']
          _=a:=ha.symm
          _=1*a:=by ring
      exact da ha0 h1
  have hkk':k*k'=1:=by rw [mul_comm];exact hkk
  have hu:k=1∨ k= -1:=by
    first
      | exact Int.isUnit_iff.mp ⟨⟨k,k',hkk',hkk⟩,rfl⟩
  exact ⟨k,hu,ha',hb'⟩
def bO (k:ℕ) (v a b:ℤ):Fin (k+1)→ ℤ:= fun i=> v*a^(k-i.val)*b^i.val
lemma pO (k:ℕ) (hk:1≤ k)
    (v w a b c d:ℤ) (hv:v≠0) (hw:w≠0)
    (heq:bO k v a b=bO k w c d):a*d=c*b:=by
  have h0:v*a^k=w*c^k:=by
    simpa [bO] using congrFun heq ⟨0,Nat.zero_lt_succ k⟩
  have h1:v*a^(k-1)*b=w*c^(k-1)*d:=by
    simpa [bO] using congrFun heq ⟨1,Nat.lt_succ_of_le hk⟩
  by_cases ha:a=0
  · have hc:c=0:=by
      by_contra hc
      have hn:=aV hw (u5 k hc)
      apply hn
      have hk0:k ≠ 0:=by omega
      simpa [ha,hk0] using h0.symm
    simp [ha,hc]
  · have hc:c≠0:=by
      intro hc
      have hn:=aV hv (u5 k ha)
      apply hn
      have hk0:k ≠ 0:=by omega
      simpa [hc,hk0] using h0
    have hk':k-1+1=k:=cA hk
    rw [←hk',pow_succ,pow_succ] at h0
    have hp:v*a^(k-1)*(a*d-c*b)=0:=by
      linear_combination d*h0-c*h1
    have pP:a*d-c*b=0:= (mul_eq_zero.mp hp).resolve_left (aV hv (u5 (k-1) ha))
    exact sub_eq_zero.mp pP
lemma kd (k:ℕ) (hk:1≤ k)
    (P A:Mat) (hPA:P*A=1) (h:ℤ)
    (vQ:h=1∨ h= -1):
    Set.InjOn (cr k A h) (kb k h):=by
  intro z hz w hw heq
  obtain ⟨hzpos,hzF⟩:=hz
  obtain ⟨hwpos,hwF⟩:=hw
  have hh:h≠0:=by rcases vQ with rfl|rfl<;> norm_num
  have vR:bO k (z 3) (ag A z 0) (ag A z 1)= bO k (w 3) (ag A w 0) (ag A w 1):=by
    funext i
    have hi:=congrFun heq i
    have hi':h*bO k (z 3) (ag A z 0) (ag A z 1) i= h*bO k (w 3) (ag A w 0) (ag A w 1) i:=by
      simpa only [cr,bO,aG] using hi
    exact cC hh hi'
  obtain ⟨sgn,hsgn,hc,hd⟩:= pN
      (ag A z 0) (ag A z 1)
      (ag A w 0) (ag A w 1)
      (gJ k hk P A hPA h vQ z hzF)
      (gJ k hk P A hPA h vQ w hwF)
      (pO k hk _ _ _ _ _ _
        (hzpos 3).ne' (hwpos 3).ne' vR)
  obtain ⟨hz0,hz1⟩:=dL P A hPA z
  obtain ⟨hw0,hw1⟩:=dL P A hPA w
  rcases hsgn with rfl | rfl
  · have h0:ag A z 0=ag A w 0:=by simpa using hc.symm
    have h1:ag A z 1=ag A w 1:=by simpa using hd.symm
    have hd0:z 0=w 0:=by rw [←h0,←h1] at hw0;exact hz0.symm.trans hw0
    have he0:z 1=w 1:=by rw [←h0,←h1] at hw1;exact hz1.symm.trans hw1
    have hv:z 3=w 3:=by
      by_cases ha:ag A z 0=0
