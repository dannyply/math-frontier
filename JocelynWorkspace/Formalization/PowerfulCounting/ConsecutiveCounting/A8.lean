          ((box k (x / 2 ^ j) (2 ^ a) (2 ^ b) ∩ tail k x) \ S)).ncard ≤
      ∑ j ∈ Finset.range (Nat.log 2 ⌊x⌋₊ + 2), ∑ a ∈ Finset.range (Nat.log 2 ⌊x⌋₊ + 2),
        ∑ b ∈ Finset.range (Nat.log 2 ⌊x⌋₊ + 2),
