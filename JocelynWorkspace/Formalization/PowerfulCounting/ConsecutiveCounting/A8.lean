    obtain ⟨hfin, hcnt⟩ := hOSM y hyT D E hD1 hE1 hDy hEy hDEk _ hM1 hMy 1 (Or.inl rfl)
      ab.1 ab.2 (le_trans (Finset.le_sup (f := fun ab : ℕ × ℕ => ab.1 + ab.2) hab)
        (Nat.le_add_left _ _))
      (fun j hj => by
        obtain ⟨-, F, hF0, hFb, -, hFc, hFv⟩ :=
          hcell j (by simp only [Finset.mem_filter] at hj ⊢; exact hj) 1 (Or.inl rfl)
        exact ⟨F, hF0, hFb, fun m => (hFc m).trans
          (Real.rpow_le_rpow_of_exponent_le hy1 (le_max_right _ _)), hFv⟩)
    obtain ⟨a, ha_def⟩ : ∃ a : ℝ, a = 2 / ((k : ℝ) + 1) := ⟨_, rfl⟩
    have haK : a * ((k : ℝ) + 1) = 2 := by
      rw [ha_def, div_mul_cancel₀ _ (ne_of_gt hk1pos)]
    rw [← ha_def] at hsa
    have hexp := RIGHTJProof.right_piece_exp (k : ℝ) s sk th a sc δ δa hkR5 hksk hksk4 hthR
      hthk7 hthk169 haK hsc1 hsa hsb hδa0 hδa2
    refine RIGHTJProof.finite_ncard_of_subset ?_ hfin (le_trans hcnt ?_)
    · intro z hz
      exact RIGHTJProof.box_subK k y D E z hz.1
    · exact RIGHTJProof.endgameK y s D E _ δ C₁ th _ hy1 hC₁ hδ hD hE hDE hM2 hexp hDt hEt

