    D*(M.natAbs.divisors.card:ℝ)^p≤D*(Cd^p*|(M:ℝ)|^((p:ℝ)*δ)) :=
      mul_le_mul_of_nonneg_left hDp hD
    _ ≤D*(Cd^p*(H^((p:ℝ)*δ)*x^ε)) :=
      mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left hMeta (pow_nonneg hCd0 _)) hD
    _ =(D*Cd^p*H^((p:ℝ)*δ))*x^ε := by ring
    _ ≤C*x^ε := by
      apply mul_le_mul_of_nonneg_right _ (Real.rpow_nonneg hx0.le _)
      dsimp [C]
      linarith

end
