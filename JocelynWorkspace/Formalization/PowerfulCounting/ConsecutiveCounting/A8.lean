      (Submodule.map
        (uV ℚ
          (RingHom.ker (aJ k G A).toRingHom)).toLinearMap
        (restrictTotalDegree (Fin (k+1)) ℚ m))= af.Qrank k H0 (k*m):=by
  have hrw:
      Module.finrank ℚ
        (Submodule.map
          (uV ℚ (RingHom.ker (aJ k G A).toRingHom)).toLinearMap
          (restrictTotalDegree (Fin (k+1)) ℚ m))= Module.finrank ℚ
        (Submodule.map (aJ k G A).toLinearMap
          (restrictTotalDegree (Fin (k+1)) ℚ m)):=by
    have gH:RingHom.ker (aJ k G A)= RingHom.ker (aJ k G A).toRingHom:=by
      ext p
      rfl
    have bf:=fU (aJ k G A)
      (restrictTotalDegree (Fin (k+1)) ℚ m)
    rw [gH] at bf
    exact bf
  rw [hrw]
  have eS:=b5.pF
    k hk A P hPA d e t ht m
  rw [←hmap,AlgHom.comp_toLinearMap,Submodule.map_comp] at eS
  calc
    _=Module.finrank ℚ
      (Submodule.map (ao.theta d e t m)
