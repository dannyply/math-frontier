  have hp : (X : Polynomial ℝ)^k = X^(k-1)*X := by
    rw [← pow_succ]; congr 1; omega
  have hq : (1-X : Polynomial ℝ)^k = (1-X)^(k-1)*(1-X) := by
    rw [← pow_succ]; congr 1; omega
