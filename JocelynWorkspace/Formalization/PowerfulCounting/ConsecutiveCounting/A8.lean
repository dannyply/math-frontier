private theorem definite_norm_subpower (A L : ℝ) (hA : 1 ≤ A) (hL : 0 ≤ L)
    (epsilon : ℝ) (hepsilon : 0 < epsilon) :
    ∃ C : ℝ, 0 < C ∧ ∀ x : ℝ, 2 ≤ x →
      ∀ D M : ℕ, 0 < D → 0 < M → (M : ℝ) ≤ A*x^L →
      let S : Set (ℤ × ℤ) := {z | z.1^2+(D:ℤ)*z.2^2=M}
      S.Finite ∧ (S.ncard : ℝ) ≤ C*x^epsilon := by
  let delta : ℝ := epsilon/(2*L+1)
  have hden : 0 < 2*L+1 := by linarith
  have hd : 0 < delta := div_pos hepsilon hden
  have hdeq : delta*(2*L+1)=epsilon := div_mul_cancel₀ _ (ne_of_gt hden)
  have hexp : L*(2*delta) ≤ epsilon := by nlinarith
  obtain ⟨Cd,hCd,hdb⟩ :=
    JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C01.PcLowdegRed.divisor_bound delta hd
  let C : ℝ := 12*Cd^2*A^(2*delta)+1
  refine ⟨C, by dsimp [C]; positivity, ?_⟩
  intro x hx D M hD hM hMb
  let S : Set (ℤ × ℤ) := {z | z.1^2+(D:ℤ)*z.2^2=M}
  change S.Finite ∧ (S.ncard : ℝ) ≤ C*x^epsilon
  obtain ⟨hfin,hcard⟩ := all_signed_definite_count D M hD hM
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hA0 : 0 ≤ A := by linarith
  have hMtau : (M.divisors.card : ℝ) ≤ Cd*(M:ℝ)^delta := hdb M hM.ne'
  have hTau2 : (M.divisors.card : ℝ)^2 ≤ Cd^2*(M:ℝ)^(2*delta) := by
    calc
      (M.divisors.card : ℝ)^2 ≤ (Cd*(M:ℝ)^delta)^2 :=
        pow_le_pow_left₀ (Nat.cast_nonneg _) hMtau 2
      _ = Cd^2*(M:ℝ)^(2*delta) := by
        rw [mul_pow]
        congr 1
        rw [← Real.rpow_natCast, ← Real.rpow_mul (Nat.cast_nonneg M)]
        congr 1
        push_cast
        ring
  have hPower : (M:ℝ)^(2*delta) ≤ A^(2*delta)*x^epsilon := by
    calc
      (M:ℝ)^(2*delta) ≤ (A*x^L)^(2*delta) :=
        Real.rpow_le_rpow (Nat.cast_nonneg _) hMb (by positivity)
      _ = A^(2*delta)*x^(L*(2*delta)) := by
        rw [Real.mul_rpow hA0 (Real.rpow_nonneg hx0.le _), ← Real.rpow_mul hx0.le]
      _ ≤ A^(2*delta)*x^epsilon :=
        mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_le hx1 hexp)
          (Real.rpow_nonneg hA0 _)
  refine ⟨hfin, ?_⟩
  have hcardR : (S.ncard : ℝ) ≤ 12*(M.divisors.card : ℝ)^2 := by exact_mod_cast hcard
  calc
    (S.ncard : ℝ) ≤ 12*(M.divisors.card : ℝ)^2 := hcardR
    _ ≤ 12*(Cd^2*(M:ℝ)^(2*delta)) :=
      mul_le_mul_of_nonneg_left hTau2 (by norm_num)
    _ ≤ 12*(Cd^2*(A^(2*delta)*x^epsilon)) :=
      mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left hPower (sq_nonneg Cd)) (by norm_num)
    _ ≤ C*x^epsilon := by
      dsimp [C]
      nlinarith only [Real.rpow_nonneg hx0.le epsilon]

private theorem negative_quadratic_level_count (J : ℝ) (hJ : 0 ≤ J)
    (epsilon : ℝ) (hepsilon : 0 < epsilon) :
    ∃ C : ℝ, 0 < C ∧ ∀ x : ℝ, 2 ≤ x → ∀ A B C0 m : ℤ,
      A ≠ 0 → m ≠ 0 → B^2-4*A*C0 < 0 →
      |(A:ℝ)| ≤ x^J → |(B:ℝ)| ≤ x^J → |(C0:ℝ)| ≤ x^J → |(m:ℝ)| ≤ x^J →
      let S : Set (ℤ × ℤ) := {z |
        |(z.1:ℝ)| ≤ x^J ∧ |(z.2:ℝ)| ≤ x^J ∧
          A*z.1^2+B*z.1*z.2+C0*z.2^2=m}
      S.Finite ∧ (S.ncard:ℝ) ≤ C*x^epsilon := by
  classical
  obtain ⟨Cn,hCn,hnormcount⟩ :=
    definite_norm_subpower 4 (2*J) (by norm_num) (by positivity) epsilon hepsilon
  refine ⟨Cn,hCn,?_⟩
  intro x hx A B C0 m hA hm hDisc hAb hBb hCb hmb
  let H : ℝ := x^J
  let Delta : ℤ := B^2-4*A*C0
  let D : ℕ := (-Delta).toNat
  let N : ℤ := 4*A*m
  let M : ℕ := N.toNat
  let S : Set (ℤ × ℤ) := {z |
    |(z.1:ℝ)| ≤ H ∧ |(z.2:ℝ)| ≤ H ∧ A*z.1^2+B*z.1*z.2+C0*z.2^2=m}
  let phi : ℤ × ℤ → ℤ × ℤ := fun z => (2*A*z.1+B*z.2,z.2)
  change S.Finite ∧ (S.ncard:ℝ) ≤ Cn*x^epsilon
  have hx0 : 0 < x := by linarith
  have hH0 : 0 ≤ H := Real.rpow_nonneg hx0.le J
  have hDcast : (D:ℤ) = -Delta := Int.toNat_of_nonneg (by dsimp [Delta]; omega)
  have hD : 0 < D := by
    have ht : (0:ℤ) < (D:ℤ) := by rw [hDcast]; dsimp [Delta]; omega
    exact_mod_cast ht
  have hN : N ≠ 0 := mul_ne_zero (mul_ne_zero (by norm_num) hA) hm
  have hNorm : ∀ z ∈ S, (phi z).1^2+(D:ℤ)*(phi z).2^2=N := by
    intro z hz
    obtain ⟨_,_,hq⟩ := hz
    change (2*A*z.1+B*z.2)^2+(D:ℤ)*z.2^2=N
    rw [hDcast]
    dsimp [Delta,N]
    linear_combination 4*A*hq
  by_cases hS : S.Nonempty
  swap
  · have he : S = ∅ := Set.not_nonempty_iff_eq_empty.mp hS
    rw [he, Set.ncard_empty, Nat.cast_zero]
    exact ⟨Set.finite_empty, mul_nonneg hCn.le (Real.rpow_nonneg hx0.le _)⟩
  obtain ⟨z0,hz0⟩ := hS
  have hNnonneg : (0:ℤ) ≤ N := by
    rw [← hNorm z0 hz0]
    positivity
  have hNpos : (0:ℤ) < N := by omega
  have hMcast : (M:ℤ) = N := Int.toNat_of_nonneg hNpos.le
  have hM : 0 < M := by
    have ht : (0:ℤ) < (M:ℤ) := by rw [hMcast]; exact hNpos
    exact_mod_cast ht
  have hNbound : |(N:ℝ)| ≤ 4*H^2 := by
    dsimp [N]
    push_cast
    rw [abs_mul, abs_mul, show |(4:ℝ)|=4 by norm_num]
    have ht := mul_le_mul hAb hmb (abs_nonneg (m:ℝ)) hH0
    nlinarith only [ht]
  have hMbound : (M:ℝ) ≤ 4*x^(2*J) := by
    have hcast : (M:ℝ) = (N:ℝ) := by exact_mod_cast hMcast
    rw [hcast]
    calc
      (N:ℝ) ≤ |(N:ℝ)| := le_abs_self _
      _ ≤ 4*H^2 := hNbound
      _ = 4*x^(2*J) := by
        dsimp [H]
        rw [← Real.rpow_natCast, ← Real.rpow_mul hx0.le]
        congr 2
        push_cast
        ring
  obtain ⟨hNormfin,hNormcard⟩ := hnormcount x hx D M hD hM hMbound
  let T : Set (ℤ × ℤ) := {z | z.1^2+(D:ℤ)*z.2^2=M}
  have hinj : Function.Injective phi := by
    intro z z' hp
    have he : z.2 = z'.2 := by
      have ht := congrArg (fun w : ℤ × ℤ => w.2) hp
      change z.2 = z'.2 at ht
      exact ht
    have hd : 2*A*z.1 = 2*A*z'.1 := by
      have ht := congrArg Prod.fst hp
      change 2*A*z.1+B*z.2 = 2*A*z'.1+B*z'.2 at ht
      rw [he] at ht
      linear_combination ht
    exact Prod.ext (mul_left_cancel₀ (mul_ne_zero (by norm_num) hA) hd) he
  have hmap : ∀ z ∈ S, phi z ∈ T := by
    intro z hz
    change (phi z).1^2+(D:ℤ)*(phi z).2^2=(M:ℤ)
    rw [hMcast]
    exact hNorm z hz
  have himg : (phi '' S).Finite :=
    hNormfin.subset (by rintro _ ⟨z,hz,rfl⟩; exact hmap z hz)
  have hfin : S.Finite := Set.Finite.of_finite_image himg hinj.injOn
  have hcard : S.ncard ≤ T.ncard :=
    Set.ncard_le_ncard_of_injOn phi hmap hinj.injOn hNormfin
  refine ⟨hfin,?_⟩
  exact (show (S.ncard:ℝ) ≤ (T.ncard:ℝ) by exact_mod_cast hcard).trans hNormcard

private theorem divisor_fee (K : ℝ) (hK : 0 ≤ K)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ C : ℝ, 0 < C ∧ ∀ x : ℝ, 2 ≤ x →
      ∀ B : ℤ, B ≠ 0 →
        |(B : ℝ)| ≤ 1625702400 * x ^ (16 * K) →
        (44800 : ℝ) * (B.natAbs.divisors.card : ℝ) ^ 9 ≤ C * x ^ ε := by
  let δ : ℝ := ε / (144 * K + 1)
  have hden : 0 < 144 * K + 1 := by nlinarith
  have hδ : 0 < δ := div_pos hε hden
  have hδeq : δ * (144 * K + 1) = ε :=
    div_mul_cancel₀ ε (ne_of_gt hden)
  have hexp : (16 * K) * (9 * δ) ≤ ε := by nlinarith
  obtain ⟨Cd, hCd, hdb⟩ := C01.PcLowdegRed.divisor_bound δ hδ
  let C : ℝ := 44800 * Cd ^ 9 * (1625702400 : ℝ) ^ (9 * δ) + 1
  refine ⟨C, by dsimp [C]; positivity, ?_⟩
  intro x hx B hB hBb
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hcast : (B.natAbs : ℝ) = |(B : ℝ)| := by
    rw [← Int.cast_natCast, Int.natCast_natAbs, Int.cast_abs]
  have hD : (B.natAbs.divisors.card : ℝ) ≤ Cd * |(B : ℝ)| ^ δ := by
    have ht := hdb B.natAbs (Int.natAbs_ne_zero.mpr hB)
    rwa [hcast] at ht
  have hD8 : (B.natAbs.divisors.card : ℝ) ^ 9 ≤
      Cd ^ 9 * |(B : ℝ)| ^ (9 * δ) := by
    calc
      (B.natAbs.divisors.card : ℝ) ^ 9 ≤
          (Cd * |(B : ℝ)| ^ δ) ^ 9 :=
        pow_le_pow_left₀ (Nat.cast_nonneg _) hD _
      _ = Cd ^ 9 * |(B : ℝ)| ^ (9 * δ) := by
        rw [mul_pow]
        congr 1
        rw [← Real.rpow_natCast, ← Real.rpow_mul (abs_nonneg _)]
        congr 1
        push_cast
        ring
  have hMeta : |(B : ℝ)| ^ (9 * δ) ≤
      (1625702400 : ℝ) ^ (9 * δ) * x ^ ε := by
    calc
      |(B : ℝ)| ^ (9 * δ) ≤ (1625702400 * x ^ (16 * K)) ^ (9 * δ) :=
        Real.rpow_le_rpow (abs_nonneg _) hBb (by positivity)
      _ = (1625702400 : ℝ) ^ (9 * δ) * (x ^ (16 * K)) ^ (9 * δ) :=
        Real.mul_rpow (by norm_num) (Real.rpow_nonneg hx0.le _)
      _ = (1625702400 : ℝ) ^ (9 * δ) * x ^ ((16 * K) * (9 * δ)) := by
        rw [← Real.rpow_mul hx0.le]
      _ ≤ (1625702400 : ℝ) ^ (9 * δ) * x ^ ε :=
        mul_le_mul_of_nonneg_left
          (Real.rpow_le_rpow_of_exponent_le hx1 hexp)
          (Real.rpow_nonneg (by norm_num) _)
  calc
    (44800 : ℝ) * (B.natAbs.divisors.card : ℝ) ^ 9 ≤
        44800 * (Cd ^ 9 * |(B : ℝ)| ^ (9 * δ)) :=
      mul_le_mul_of_nonneg_left hD8 (by norm_num)
    _ ≤ 44800 * (Cd ^ 9 * ((1625702400 : ℝ) ^ (9 * δ) * x ^ ε)) :=
      mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left hMeta
          (pow_nonneg (by linarith : 0 ≤ Cd) _)) (by norm_num)
    _ = (44800 * Cd ^ 9 * (1625702400 : ℝ) ^ (9 * δ)) * x ^ ε := by ring
    _ ≤ C * x ^ ε := by
      apply mul_le_mul_of_nonneg_right _ (Real.rpow_nonneg hx0.le _)
      dsimp [C]
      linarith

private theorem primitive_norm_cover (Delta : ℕ) (h : ℤ) (Z : ℕ)
    (hDelta : 0<Delta) (hh : h ≠ 0) :
    let K : ℕ := (Delta+1)*Z^2+1;
    ∃ T : Finset (ℤ×ℤ),
      ( ∀ X Y:ℤ,X.natAbs ≤ Z → Y.natAbs ≤ Z → Int.gcd X Y=1 →
        X^2-(Delta:ℤ)*Y^2=h → (X,Y) ∈ T) ∧
      (T.card:ℝ) ≤ 8*(h.natAbs.divisors.card:ℝ)*
        (4*(Real.log K/Real.log 2)+2) := by
  classical
  let K : ℕ := (Delta+1)*Z^2+1
  let S := FormalAB.Sab87e3d4.A2InheritedPell.solSet 1 Delta h Z
  let phi : (Bool×Bool)×(ℕ×ℕ) → ℤ×ℤ := fun z =>
    (signedNat z.2.2 z.1.1,signedNat z.2.1 z.1.2)
  let T := ((Finset.univ : Finset (Bool×Bool)) ×ˢ S).image phi
  have hK1 : 1 ≤ K := by dsimp [K]; omega
  have hKbox : ((1:ℤ)*Delta+1)*(Z:ℤ)^2 ≤ (K:ℤ) := by
    dsimp [K]
    nlinarith
  have hprim := FormalAB.Sab87e3d4.A2InheritedPell.prim_count h.natAbs 1 Delta h le_rfl
    (by norm_num) hDelta (by simp) hh Z K hKbox hK1
  refine ⟨T,?_,?_⟩
  · intro X Y hX hY hcop hnorm
    have hx2 : (X.natAbs:ℤ)^2=X^2 := by
      rw [Int.natCast_natAbs]
      by_cases hx : 0 ≤ X
      · rw [abs_of_nonneg hx]
      · rw [abs_of_nonpos (by omega : X ≤ 0),neg_sq]
    have hy2 : (Y.natAbs:ℤ)^2=Y^2 := by
      rw [Int.natCast_natAbs]
      by_cases hy : 0 ≤ Y
      · rw [abs_of_nonneg hy]
      · rw [abs_of_nonpos (by omega : Y ≤ 0),neg_sq]
    have hcop' : Nat.gcd Y.natAbs X.natAbs=1 := by
      change Nat.gcd X.natAbs Y.natAbs=1 at hcop
      simpa only [Nat.gcd_comm] using hcop
    have hS : (Y.natAbs,X.natAbs) ∈ S := by
      apply FormalAB.Sab87e3d4.A2InheritedPell.mem_solSet.mpr
      refine ⟨hY,hX,hcop',?_⟩
      simpa only [Nat.cast_one,one_mul,hx2,hy2] using hnorm
    apply Finset.mem_image.mpr
    refine ⟨((decide (0 ≤ X),decide (0 ≤ Y)),(Y.natAbs,X.natAbs)),
      Finset.mem_product.mpr ⟨Finset.mem_univ _,hS⟩,?_⟩
    exact Prod.ext (signed_natAbs X) (signed_natAbs Y)
  · have hcard : T.card ≤ 4*S.card := by
      calc
        T.card ≤ ((Finset.univ : Finset (Bool×Bool)) ×ˢ S).card := Finset.card_image_le
        _ = 4*S.card := by simp
    have hcardR : (T.card:ℝ) ≤ 4*(S.card:ℝ) := by exact_mod_cast hcard
    calc
      (T.card:ℝ) ≤ 4*(S.card:ℝ) := hcardR
      _ ≤ 4*(2*(h.natAbs.divisors.card:ℝ)*(4*(Real.log K/Real.log 2)+2)) :=
        mul_le_mul_of_nonneg_left hprim (by norm_num)
      _ = _ := by ring

