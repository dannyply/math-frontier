let idx : ℕ → ℕ → ℕ → ℕ → (Fin 4 →₀ ℕ) := fun i j r s => Finsupp.single (0 : Fin 4) i + Finsupp.single (1 : Fin 4) j + Finsupp.single (2 : Fin 4) r + Finsupp.single (3 : Fin 4) s;
let P : ℕ → MvPolynomial (Fin 4) ℤ → MvPolynomial (Fin 2) ℤ := fun α G => ∑ i ∈ Finset.range (α + 1), MvPolynomial.C (G.coeff (idx i (α - i) 1 0)) * MvPolynomial.X (0 : Fin 2) ^ i * MvPolynomial.X (1 : Fin 2) ^ (α - i);
let Q : ℕ → MvPolynomial (Fin 4) ℤ → MvPolynomial (Fin 2) ℤ := fun α G => ∑ i ∈ Finset.range (α + 1), MvPolynomial.C (-G.coeff (idx i (α - i) 0 1)) * MvPolynomial.X (0 : Fin 2) ^ i * MvPolynomial.X (1 : Fin 2) ^ (α - i);
let R : ℕ → ℕ → MvPolynomial (Fin 4) ℤ → MvPolynomial (Fin 2) ℤ := fun k α G => MvPolynomial.X (1 : Fin 2) ^ k * P α G - MvPolynomial.X (0 : Fin 2) ^ k * Q α G;
∀ k : ℕ, 5 ≤ k → k ≤ 123 → ∀ α : ℕ, 1 ≤ α → α + 2 ≤ k → ∀ G : MvPolynomial (Fin 4) ℤ, G ≠ 0 → (∀ m ∈ G.support, m 0 + m 1 = α ∧ m 2 + m 3 = 1) → Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G) → ∀ γ a b : ℂ, γ ≠ 0 → (a ≠ 0 ∨ b ≠ 0) → MvPolynomial.map (Int.castRingHom ℂ) (R k α G) = MvPolynomial.C γ * (MvPolynomial.C a * MvPolynomial.X (0 : Fin 2) + MvPolynomial.C b * MvPolynomial.X (1 : Fin 2)) ^ (α + k) → False

:= by
  intro idx P Q R k hk hk123 α hα hgap G hG0 hbi hi γ a b hγ hab hres
  have hP := C01.PcParam.PP_hom G α hbi
  have hQ := C01.PcParam.QQ_hom G α hbi
  let A : MvPolynomial (Fin 2) ℂ :=
    MvPolynomial.map (Int.castRingHom ℂ) (C01.PcParam.PP G)
  let B : MvPolynomial (Fin 2) ℂ :=
    MvPolynomial.map (Int.castRingHom ℂ) (C01.PcParam.QQ G)
  have hno : ∀ w : Fin 2 → ℂ, w ≠ 0 →
      MvPolynomial.eval w A=0 → MvPolynomial.eval w B=0 → False := by
    intro w hw hp hq
    exact C01.PcCurves.no_common_zero (hP.map (Int.castRingHom ℂ))
      (hQ.map (Int.castRingHom ℂ)) (C01.PcParam.relprime_core G α hbi hi) hw hp hq
  have hcanonical : R k α G =
      X (1:Fin 2)^k*C01.PcParam.PP G+X (0:Fin 2)^k*C01.PcParam.QQ G := by
    change X (1:Fin 2)^k*canonicalP G α-X (0:Fin 2)^k*canonicalQ G α = _
    rw [(canonical_blocks G α hbi).1,(canonical_blocks G α hbi).2]
    simp only [mul_neg,sub_neg_eq_add]
  rw [hcanonical] at hres
  have hidentity : X (1:Fin 2)^k*A+X (0:Fin 2)^k*B =
      C γ*(C a*X (0:Fin 2)+C b*X (1:Fin 2))^(α+k) := by
    simpa only [map_add,map_mul,map_pow,MvPolynomial.map_X] using hres
