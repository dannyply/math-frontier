def floor_original_cell (k : ℕ) (P Q : MvPolynomial (Fin 2) ℤ)
    (x D E M r : ℝ) (p : OriginalPoint) : Prop :=
  1≤pd p ∧ 1≤pe p ∧ 1≤pu p ∧ 1≤pv p ∧
  (pe p)^k*pv p=(pd p)^k*pu p+1 ∧
  x/2<(pd p:ℝ)^k*(pu p:ℝ) ∧ (pd p:ℝ)^k*(pu p:ℝ)≤x ∧
  D/2<(pd p:ℝ) ∧ (pd p:ℝ)≤D ∧
  E/2<(pe p:ℝ) ∧ (pe p:ℝ)≤E ∧
  r<(pd p:ℝ)/(pe p:ℝ) ∧ (pd p:ℝ)/(pe p:ℝ)≤r*(1+1/M) ∧
  MvPolynomial.eval ![(pd p:ℤ),(pe p:ℤ)] P*(pu p:ℤ)=
    MvPolynomial.eval ![(pd p:ℤ),(pe p:ℤ)] Q*(pv p:ℤ)

theorem original_cell_cofactor_cover
    (k : ℕ) (P Q : MvPolynomial (Fin 2) ℤ)
    (x D E M r : ℝ) (hx : 2≤x) (hD : 0<D) (hE : 0<E) (hM : 0<M)
    (hr : r≤2*D/E) (p : OriginalPoint)
    (hp : floor_original_cell k P Q x D E M r p) :
    ∃ j j' : ℕ,j≤k ∧ j'≤k+1 ∧
      OriginalCellPoint k P Q x D E
        ((2:ℝ)^j*(x/D^k)) ((2:ℝ)^j'*(x/E^k)) M r 2 p := by
  obtain ⟨hd,he,hu,hv,hshift,hnlo,hnhi,hdlo,hdhi,helo,hehi,hrlo,hrhi,hgraph⟩ := hp
  have hshiftR : (pe p:ℝ)^k*(pv p:ℝ)=(pd p:ℝ)^k*(pu p:ℝ)+1 := by
    exact_mod_cast hshift
  have hunit : (pe p:ℤ)^k*(pv p:ℤ)-(pd p:ℤ)^k*(pu p:ℤ)=1 := by
    have hh : (pe p:ℤ)^k*(pv p:ℤ)=(pd p:ℤ)^k*(pu p:ℤ)+1 := by
      exact_mod_cast hshift
    linear_combination hh
  obtain ⟨⟨j,hj,hjlo,hjhi⟩,⟨j',hj',hj'lo,hj'hi⟩⟩ :=
    original_fixed_cofactor_windows k x D E (pd p:ℝ) (pe p:ℝ) (pu p:ℝ) (pv p:ℝ)
      hx hD hE hdlo hdhi helo hehi (Nat.cast_nonneg _) (Nat.cast_nonneg _)
      hnlo hnhi hshiftR
  refine ⟨j,j',hj,hj',hd,he,hu,hv,hdlo,hdhi,helo,hehi,hjlo,hjhi,hj'lo,hj'hi,
    hnlo,hnhi,hunit,hgraph,?_⟩
  exact relative_ratio_cell_bound D E M r (pd p:ℝ) (pe p:ℝ) hM hr hrlo hrhi

theorem floor_original_cell_finite
    (k : ℕ) (hk : 1≤k) (P Q : MvPolynomial (Fin 2) ℤ)
    (x D E M r : ℝ) :
    {p | floor_original_cell k P Q x D E M r p}.Finite := by
  apply (original_positive_population_finite k hk x).subset
  intro p hp
  obtain ⟨hd,he,hu,hv,hshift,hnlo,hnhi,hdlo,hdhi,helo,hehi,hrlo,hrhi,hgraph⟩ := hp
  refine ⟨hd,he,hu,hv,hshift,?_⟩
  simpa only [pd,pu,Nat.cast_mul,Nat.cast_pow] using hnhi

end
