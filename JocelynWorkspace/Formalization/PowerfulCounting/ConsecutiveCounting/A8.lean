namespace A8HighFPriceHolder

private lemma powers (x : ℝ) (hx : 0≤ x) (n : ℕ) (a : ℝ) :
    (x^n)^a=x^((n:ℝ)*a) := by
  rw [←Real.rpow_natCast,←Real.rpow_mul hx]

private lemma mixed_unit_boundK (k thr : ℕ)
    (hk : 1≤ k) (hthr : 2*k+1≤ thr)
    (l t : ℝ) (hl : 0≤ l) (ht : 0≤ t) :
    (l^k*t)^((1:ℝ)/(thr:ℝ))≤1+l^2+t^2 := by
  let w : ℝ := 1+l^2+t^2
  let p : ℝ := (k:ℝ)/(2*(thr:ℝ))
  let q : ℝ := (1:ℝ)/(2*(thr:ℝ))
  have hw1 : 1≤ w := by dsimp [w]; nlinarith only [sq_nonneg l,sq_nonneg t]
  have hw0 : 0<w := by linarith only [hw1]
  have hlw : l^2≤ w := by dsimp [w]; nlinarith only [sq_nonneg t]
  have htw : t^2≤ w := by dsimp [w]; nlinarith only [sq_nonneg l]
  have hthr0 : (0:ℝ)<thr := by exact_mod_cast (show 0<thr by omega)
  have hp0 : 0≤ p := by dsimp [p]; positivity
  have hq0 : 0≤ q := by dsimp [q]; positivity
  have hsum : p+q≤1 := by
    have hn : k+1≤2*thr := by omega
    have hr : ((k+1:ℕ):ℝ)≤((2*thr:ℕ):ℝ) := by exact_mod_cast hn
    dsimp [p,q]
    rw [← add_div]
    apply (div_le_iff₀ (by positivity : 0<2*(thr:ℝ))).mpr
    push_cast at hr
    nlinarith only [hr]
  have hLpow : (l^k)^((1:ℝ)/(thr:ℝ))=(l^2)^p := by
    rw [powers l hl k, powers l hl 2]
    congr 1
    dsimp [p]
    field_simp [hthr0.ne']
  have hTpow : t^((1:ℝ)/(thr:ℝ))=(t^2)^q := by
    rw [powers t ht 2]
    congr 1
    dsimp [q]
    field_simp [hthr0.ne']
  calc
    (l^k*t)^((1:ℝ)/(thr:ℝ)) =
        (l^2)^p*(t^2)^q := by
      rw [Real.mul_rpow (by positivity) ht,hLpow,hTpow]
    _ ≤ w^p*w^q :=
      mul_le_mul
        (Real.rpow_le_rpow (sq_nonneg l) hlw hp0)
        (Real.rpow_le_rpow (sq_nonneg t) htw hq0)
        (Real.rpow_nonneg (sq_nonneg t) _)
        (Real.rpow_nonneg hw0.le _)
    _ = w^(p+q) := by rw [Real.rpow_add hw0]
    _ ≤ w^(1:ℝ) := Real.rpow_le_rpow_of_exponent_le hw1 hsum
    _ = 1+l^2+t^2 := by rw [Real.rpow_one]

private lemma scaled_mixed_boundK (k thr : ℕ)
    (hk : 1≤ k) (hthr : 2*k+1≤ thr)
    (l t r v : ℝ)
    (hl : 0≤ l) (ht : 0≤ t) (hr : 0<r) (hv : 0<v) :
    (l^k*t)^((1:ℝ)/(thr:ℝ)) ≤
      (r^k*v)^((1:ℝ)/(thr:ℝ))*
        (1+(l/r)^2+(t/v)^2) := by
  have hid : l^k*t=(r^k*v)*((l/r)^k*(t/v)) := by
    have hrk : r^k ≠ 0 := pow_ne_zero k hr.ne'
    rw [div_pow]
    field_simp [hrk,hv.ne']
  calc
    (l^k*t)^((1:ℝ)/(thr:ℝ)) =
        (r^k*v)^((1:ℝ)/(thr:ℝ))*
          ((l/r)^k*(t/v))^((1:ℝ)/(thr:ℝ)) := by
      rw [hid,Real.mul_rpow (by positivity) (by positivity)]
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (mixed_unit_boundK k thr hk hthr (l/r) (t/v)
        (div_nonneg hl hr.le) (div_nonneg ht hv.le))
      (Real.rpow_nonneg (by positivity) _)

private theorem mixed_raw_sumK (k thr : ℕ)
    (hk : 1≤ k) (hthr : 2*k+1≤ thr)
    (J : Finset ℕ) (m R S A : ℝ) (L T : ℕ→ℝ)
    (hm : 0 < m) (hR : 0 < R) (hS : 0 < S) (hA : 1 ≤ A)
    (hcard : (J.card:ℝ)≤4*m)
    (hL : ∀ j∈J, 0≤ L j) (hT : ∀ j∈J, 0≤ T j)
    (hLm : (∑ j∈J, (L j)^2)≤ A*R)
    (hTm : (∑ j∈J, (T j)^2)≤ A*S) :
    let p : ℝ := (k:ℝ)/(2*(thr:ℝ))
    let q : ℝ := (1:ℝ)/(2*(thr:ℝ))
    (∑ j∈J, (1+((L j)^k*T j)^((1:ℝ)/(thr:ℝ)))) ≤
      10*A*(m+m^(1-p-q)*R^p*S^q) := by
  let p : ℝ := (k:ℝ)/(2*(thr:ℝ))
  let q : ℝ := (1:ℝ)/(2*(thr:ℝ))
  let r : ℝ := (R/m)^((1:ℝ)/2)
  let v : ℝ := (S/m)^((1:ℝ)/2)
  have hthr0 : (0:ℝ)<thr := by exact_mod_cast (show 0<thr by omega)
  have hr : 0<r := Real.rpow_pos_of_pos (by positivity) _
  have hv : 0<v := Real.rpow_pos_of_pos (by positivity) _
  have hr2 : r^2=R/m := by
    dsimp [r]
    rw [←Real.rpow_natCast,←Real.rpow_mul (by positivity : 0≤ R/m)]
    norm_num
  have hv2 : v^2=S/m := by
    dsimp [v]
    rw [←Real.rpow_natCast,←Real.rpow_mul (by positivity : 0≤ S/m)]
    norm_num
  have hLratio : (∑ j∈J, (L j/r)^2)≤ A*m := by
    calc
      (∑ j∈J, (L j/r)^2)=(∑ j∈J, (L j)^2)/r^2 := by
        simp only [div_pow,Finset.sum_div]
      _ ≤ (A*R)/r^2 := div_le_div_of_nonneg_right hLm (sq_nonneg r)
      _ = A*m := by rw [hr2]; field_simp [hR.ne',hm.ne']
  have hTratio : (∑ j∈J, (T j/v)^2)≤ A*m := by
    calc
      (∑ j∈J, (T j/v)^2)=(∑ j∈J, (T j)^2)/v^2 := by
        simp only [div_pow,Finset.sum_div]
      _ ≤ (A*S)/v^2 := div_le_div_of_nonneg_right hTm (sq_nonneg v)
      _ = A*m := by rw [hv2]; field_simp [hS.ne',hm.ne']
  have hcardA : (J.card:ℝ)≤4*A*m := by
    have ht := mul_le_mul_of_nonneg_right hA (show 0≤4*m by positivity)
    nlinarith only [hcard,ht]
  have hnorm : (∑ j∈J, (1+(L j/r)^2+(T j/v)^2))≤6*A*m := by
    simp only [Finset.sum_add_distrib,Finset.sum_const,nsmul_eq_mul,mul_one]
    linarith only [hcardA,hLratio,hTratio]
  have hrv : (r^k*v)^((1:ℝ)/(thr:ℝ))=(R/m)^p*(S/m)^q := by
    calc
      (r^k*v)^((1:ℝ)/(thr:ℝ)) =
          (r^k)^((1:ℝ)/(thr:ℝ))*v^((1:ℝ)/(thr:ℝ)) :=
        Real.mul_rpow (by positivity) hv.le
      _ = r^((k:ℝ)*((1:ℝ)/(thr:ℝ)))*v^((1:ℝ)/(thr:ℝ)) := by
        rw [powers r hr.le k]
      _ = ((R/m)^((1:ℝ)/2))^((k:ℝ)*((1:ℝ)/(thr:ℝ)))*
          ((S/m)^((1:ℝ)/2))^((1:ℝ)/(thr:ℝ)) := rfl
      _ = (R/m)^p*(S/m)^q := by
        rw [←Real.rpow_mul (by positivity : 0≤ R/m),
          ←Real.rpow_mul (by positivity : 0≤ S/m)]
        congr 1
        · dsimp [p]; field_simp [hthr0.ne']
        · dsimp [q]; field_simp [hthr0.ne']
  have hmden : m^p*m^q=m^(p+q) := by rw [←Real.rpow_add hm]
  have hminv : m/(m^p*m^q)=m^(1-p-q) := by
    rw [hmden]
    calc
      m/m^(p+q)=m^(1:ℝ)/m^(p+q) := by rw [Real.rpow_one]
      _ = m^((1:ℝ)-(p+q)) := (Real.rpow_sub hm _ _).symm
      _ = m^(1-p-q) := by congr 1; ring
  have hfactor : (r^k*v)^((1:ℝ)/(thr:ℝ))*m =
      m^(1-p-q)*R^p*S^q := by
    rw [hrv,Real.div_rpow hR.le hm.le,Real.div_rpow hS.le hm.le]
    calc
      (R^p/m^p)*(S^q/m^q)*m =
          (m/(m^p*m^q))*R^p*S^q := by ring
      _ = m^(1-p-q)*R^p*S^q := by rw [hminv]
  have hmix : (∑ j∈J, ((L j)^k*T j)^((1:ℝ)/(thr:ℝ))) ≤
      6*A*(m^(1-p-q)*R^p*S^q) := by
    calc
      (∑ j∈J, ((L j)^k*T j)^((1:ℝ)/(thr:ℝ))) ≤
          ∑ j∈J, (r^k*v)^((1:ℝ)/(thr:ℝ))*
            (1+(L j/r)^2+(T j/v)^2) :=
        Finset.sum_le_sum (fun j hj => scaled_mixed_boundK k thr hk hthr
          (L j) (T j) r v (hL j hj) (hT j hj) hr hv)
      _ = (r^k*v)^((1:ℝ)/(thr:ℝ))*
          (∑ j∈J, (1+(L j/r)^2+(T j/v)^2)) := by rw [Finset.mul_sum]
      _ ≤ (r^k*v)^((1:ℝ)/(thr:ℝ))*(6*A*m) :=
        mul_le_mul_of_nonneg_left hnorm (by positivity)
      _ = _ := by rw [show (r^k*v)^((1:ℝ)/(thr:ℝ))*(6*A*m)=
          6*A*((r^k*v)^((1:ℝ)/(thr:ℝ))*m) by ring,hfactor]
  have hRpow : (0:ℝ) ≤ (m^(1-p-q)*R^p*S^q) := by positivity
  have hA0 : 0≤ A := by linarith only [hA]
  simp only [Finset.sum_add_distrib,Finset.sum_const,nsmul_eq_mul,mul_one]
  nlinarith only [hcardA,hmix,mul_nonneg hA0 hm.le,mul_nonneg hA0 hRpow]

end A8HighFPriceHolder

namespace A8HighFPriceEllipse
private def realNsq (α r c p q : ℝ) : ℝ :=
  (α*(p-r*q))^2+(q/c)^2
private lemma norm_halves (p q : ℝ)
    (hp : |p| ≤ (1/2:ℝ)) (hq : |q| ≤ (1/2:ℝ)) :
    p^2+q^2≤1 := by
  have hp2 := pow_le_pow_left₀ (abs_nonneg p) hp 2
  have hq2 := pow_le_pow_left₀ (abs_nonneg q) hq 2
  rw [sq_abs] at hp2 hq2
  nlinarith only [hp2,hq2]

private theorem real_unit_cell_ellipses
    (k M : ℕ) (x D E d e u v r : ℝ)
    (hk : 1≤ k) (hM : 1≤ M) (hx : 1≤ x) (hMx : (M:ℝ)≤ x)
    (hD : 0<D) (hE : 0<E)
    (hd : 0<d) (he : 0<e) (hu : 0≤ u) (hr : 0<r)
    (hdlo : D/2<d) (hdhi : d≤ D) (helo : E/2<e) (hehi : e≤ E)
    (hn : d^k*u≤ x)
    (hshift : e^k*v=d^k*u+1)
    (hcelllo : r≤ d/e)
    (hcellhi : d/e≤ r*(1+1/(M:ℝ))) :
    let U : ℝ := x/D^k
    let V : ℝ := x/E^k
    let B : ℝ := (2:ℝ)^k*(1+(k:ℝ)*(2:ℝ)^k)
    realNsq ((M:ℝ)/(4*D)) r (2*E) d e≤1 ∧
    realNsq ((M:ℝ)/(4*B*V)) (r^k)
      (4*(2:ℝ)^k*U) v u≤1 := by
  let U : ℝ := x/D^k
  let V : ℝ := x/E^k
  let B : ℝ := (2:ℝ)^k*(1+(k:ℝ)*(2:ℝ)^k)
  have hM0 : (0:ℝ)<M := by exact_mod_cast (show 0<M by omega)
  have hU : 0<U := by dsimp [U]; positivity
  have hV : 0<V := by dsimp [V]; positivity
  have hB : 0<B := by dsimp [B]; positivity
  have hre : r*e≤ d := (le_div_iff₀ he).mp hcelllo
  have hce : d≤ r*(1+1/(M:ℝ))*e := (div_le_iff₀ he).mp hcellhi
  have hdiff0 : 0≤ d-r*e := by linarith only [hre]
  have hdiff : d-r*e≤ D/(M:ℝ) := by
    calc
      d-r*e≤ r*(1+1/(M:ℝ))*e-r*e := sub_le_sub_right hce _
      _ = r*e/(M:ℝ) := by ring
      _ ≤ D/(M:ℝ) :=
        div_le_div_of_nonneg_right (hre.trans hdhi) hM0.le
  have hα0 : 0≤((M:ℝ)/(4*D))*(d-r*e) := by positivity
  have hαup : ((M:ℝ)/(4*D))*(d-r*e)≤1/4 := by
    calc
      ((M:ℝ)/(4*D))*(d-r*e)≤((M:ℝ)/(4*D))*(D/(M:ℝ)) :=
        mul_le_mul_of_nonneg_left hdiff (by positivity)
      _ = 1/4 := by field_simp [hM0.ne',hD.ne']
  have hfirst : |((M:ℝ)/(4*D))*(d-r*e)|≤(1/2:ℝ) := by
    rw [abs_of_nonneg hα0]
    linarith only [hαup]
  have hesecond : |e/(2*E)|≤(1/2:ℝ) := by
    have hratio0 : 0≤ e/(2*E) := by positivity
    rw [abs_of_nonneg hratio0]
    apply (div_le_iff₀ (by positivity : 0<2*E)).mpr
    linarith only [hehi]
  have hD2d : D≤2*d := by linarith only [hdlo]
  have hDpow : D^k≤(2:ℝ)^k*d^k := by
    have hp := pow_le_pow_left₀ hD.le hD2d k
    simpa only [mul_pow] using hp
  have huCap : u≤(2:ℝ)^k*U := by
    dsimp [U]
    calc
      u≤((2:ℝ)^k*x)/D^k := by
        apply (le_div_iff₀ (pow_pos hD k)).mpr
        have hp := mul_le_mul_of_nonneg_right hDpow hu
        have hq := mul_le_mul_of_nonneg_left hn (by positivity : 0≤(2:ℝ)^k)
        nlinarith only [hp,hq]
      _ = (2:ℝ)^k*(x/D^k) := by ring
  have hcof := A8HighFPriceCofactor.cofactor_unit_bound
    k M x D E d e u v r hk hM hx hMx hD hE hd he hu hr
    hdlo helo hn hshift hcelllo hcellhi
  change |v-r^k*u|≤ B*V/(M:ℝ) at hcof
  have hα2 : |((M:ℝ)/(4*B*V))*(v-r^k*u)|≤(1/2:ℝ) := by
    rw [abs_mul,abs_of_nonneg (by positivity : 0≤(M:ℝ)/(4*B*V))]
    calc
      ((M:ℝ)/(4*B*V))*|v-r^k*u|≤
          ((M:ℝ)/(4*B*V))*(B*V/(M:ℝ)) :=
        mul_le_mul_of_nonneg_left hcof (by positivity)
      _ = 1/4 := by field_simp [hM0.ne',hB.ne',hV.ne']
      _ ≤ 1/2 := by norm_num
  have husecond : |u/(4*(2:ℝ)^k*U)|≤(1/2:ℝ) := by
    have hratio0 : 0≤ u/(4*(2:ℝ)^k*U) := by positivity
    rw [abs_of_nonneg hratio0]
    apply (div_le_iff₀ (by positivity : 0<4*(2:ℝ)^k*U)).mpr
    have hnonneg : 0≤(2:ℝ)^k*U := by positivity
    nlinarith only [huCap,hnonneg]
  constructor
  · dsimp [realNsq]
    exact norm_halves _ _ hfirst hesecond
  · dsimp [realNsq]
    exact norm_halves _ _ hα2 husecond

end A8HighFPriceEllipse

namespace A8HighFPriceMomentScaling
private lemma realNsq_cast (α r c : ℝ) (z : ℤ × ℤ) :
    A8HighFPriceEllipse.realNsq α r c (z.1:ℝ) (z.2:ℝ) =
      A8HighFPriceMoments.nsq α r c z := rfl

private lemma norm_scale (C α r c : ℝ) (hC : 0<C) (hc : c ≠ 0)
    (z : ℤ × ℤ) :
    A8HighFPriceMoments.nsq (α/C) r (C*c) z =
      A8HighFPriceMoments.nsq α r c z / C^2 := by
  unfold A8HighFPriceMoments.nsq
  field_simp [hC.ne',hc]


private lemma length_scale (C α r c : ℝ) (hC : 0<C) (hc : c ≠ 0)
    (z : ℤ × ℤ) :
    A8HighFPriceMoments.length (α/C) r (C*c) z =
      C*A8HighFPriceMoments.length α r c z := by
  have hN : 0≤ A8HighFPriceMoments.nsq α r c z := by
    unfold A8HighFPriceMoments.nsq
    positivity
  have hN' : 0≤ A8HighFPriceMoments.nsq (α/C) r (C*c) z := by
    unfold A8HighFPriceMoments.nsq
    positivity
  have hs : Real.sqrt (A8HighFPriceMoments.nsq (α/C) r (C*c) z) =
      Real.sqrt (A8HighFPriceMoments.nsq α r c z)/C := by
    have h1 := Real.sqrt_nonneg (A8HighFPriceMoments.nsq (α/C) r (C*c) z)
    have h2 := Real.sqrt_nonneg (A8HighFPriceMoments.nsq α r c z)
    have hsquared :
        (Real.sqrt (A8HighFPriceMoments.nsq (α/C) r (C*c) z))^2 =
          (Real.sqrt (A8HighFPriceMoments.nsq α r c z)/C)^2 := by
      rw [Real.sq_sqrt hN', norm_scale C α r c hC hc z,
        div_pow, Real.sq_sqrt hN]
    have h6 : 0≤ Real.sqrt (A8HighFPriceMoments.nsq α r c z)/C :=
      div_nonneg h2 hC.le
    nlinarith only [h1,h6,hsquared]
  unfold A8HighFPriceMoments.length
  rw [hs]
  by_cases hz : Real.sqrt (A8HighFPriceMoments.nsq α r c z)=0
  · simp [hz]
  · field_simp [hz,hC.ne']


private theorem cofactor_side_nominalK (k M : ℕ) (U V r : ℝ)
    (hU : 0<U) (hV : 0<V) (z : ℤ × ℤ) :
    let B : ℝ := (2:ℝ)^k*(1+(k:ℝ)*(2:ℝ)^k)
    let C : ℝ := (2:ℝ)^(k+1)
    let κ₂ : ℝ := 2*(1+(k:ℝ)*(2:ℝ)^k)
    A8HighFPriceMoments.length ((M:ℝ)/(4*B*V)) r
      (4*(2:ℝ)^k*U) z =
      C*A8HighFPriceMoments.length ((M:ℝ)/(κ₂*V)) r (2*U) z := by
  let B : ℝ := (2:ℝ)^k*(1+(k:ℝ)*(2:ℝ)^k)
  let C : ℝ := (2:ℝ)^(k+1)
  let κ₂ : ℝ := 2*(1+(k:ℝ)*(2:ℝ)^k)
  have hC : 0<C := by dsimp [C]; positivity
  have hκ₂ : 0<κ₂ := by dsimp [κ₂]; positivity
  have ha : (M:ℝ)/(4*B*V)=((M:ℝ)/(κ₂*V))/C := by
    dsimp [B,C,κ₂]
    rw [pow_succ]
    field_simp [hV.ne']
    ; ring
  have hc : 4*(2:ℝ)^k*U=C*(2*U) := by
    dsimp [C]
    rw [pow_succ]
    ring
  dsimp only
  rw [ha,hc]
  exact length_scale C ((M:ℝ)/(κ₂*V)) r (2*U) hC
    (mul_ne_zero (by norm_num) hU.ne') z
end A8HighFPriceMomentScaling

