namespace A8KCore
private abbrev Cols (A B : ℕ) := Fin (A+1) × Fin (B+1)
private def jetBox (L A B : ℕ) : Finset (ℕ × ℕ) :=
  (Finset.range (A+L*B+1)).product (Finset.range (B+1))
private def exponentPair (d : Fin 2 →₀ ℕ) : ℕ × ℕ := (d 0,d 1)
private theorem exponentPair_injective : Function.Injective exponentPair := by
  intro d e h
  have h0 := congrArg Prod.fst h
  have h1 := congrArg Prod.snd h
  ext i
  fin_cases i
  · exact h0
  · exact h1
private theorem jetExp_pair (d : Fin 2 →₀ ℕ) :
    jetExp (exponentPair d) = d := by
  ext i
  fin_cases i <;> simp [jetExp,exponentPair]
private theorem pair_jetExp (p : ℕ × ℕ) :
    exponentPair (jetExp p) = p := by
  ext <;> simp [jetExp,exponentPair]

private theorem polynomial_evaluation_box (L A B : ℕ)
    (P : MvPolynomial (Fin 2) ℝ) (a b : ℝ)
    (hsupport : ∀ d ∈ P.support, d 0 ≤ A+L*B ∧ d 1 ≤ B) :
    MvPolynomial.eval (fun i : Fin 2 => if i = 0 then a else b) P =
      ∑ p : {p : ℕ × ℕ // p ∈ jetBox L A B},
        a^p.val.1*b^p.val.2*MvPolynomial.coeff (jetExp p.val) P := by
  classical
  let S := P.support.image exponentPair
  let term : ℕ × ℕ → ℝ := fun p =>
    MvPolynomial.coeff (jetExp p) P*a^p.1*b^p.2
  have heval :
      MvPolynomial.eval (fun i : Fin 2 => if i = 0 then a else b) P =
        ∑ d ∈ P.support, MvPolynomial.coeff d P*a^(d 0)*b^(d 1) := by
    rw [MvPolynomial.eval_eq']
    apply Finset.sum_congr rfl
    intro d hd
    simp [Fin.prod_univ_two,mul_assoc]
  have hS : S ⊆ jetBox L A B := by
    intro p hp
    obtain ⟨d,hd,rfl⟩ := Finset.mem_image.mp hp
    have hh := hsupport d hd
    exact Finset.mem_product.mpr
      ⟨Finset.mem_range.mpr (by simpa [exponentPair] using Nat.lt_succ_of_le hh.1),
       Finset.mem_range.mpr (by simpa [exponentPair] using Nat.lt_succ_of_le hh.2)⟩
  have hsumS :
      MvPolynomial.eval (fun i : Fin 2 => if i = 0 then a else b) P =
        ∑ p ∈ S, term p := by
    rw [heval]
    dsimp [S]
    rw [Finset.sum_image]
    · apply Finset.sum_congr rfl
      intro d hd
      change MvPolynomial.coeff d P*a^(d 0)*b^(d 1) =
        MvPolynomial.coeff (jetExp (exponentPair d)) P*a^(d 0)*b^(d 1)
      rw [jetExp_pair]
    · intro d hd e he hde
      exact exponentPair_injective hde
  have hext : (∑ p ∈ S,term p) = ∑ p ∈ jetBox L A B,term p := by
    apply Finset.sum_subset hS
    intro p hp hnot
    have hz : MvPolynomial.coeff (jetExp p) P = 0 := by
      by_contra h
      apply hnot
      exact Finset.mem_image.mpr
        ⟨jetExp p,MvPolynomial.mem_support_iff.mpr h,pair_jetExp p⟩
    simp [term,hz]
  rw [hsumS,hext]
  have hh := Finset.sum_coe_sort (jetBox L A B) term
  first
  | simpa only [term,mul_comm,mul_left_comm,mul_assoc] using hh
  | simpa only [term,mul_comm,mul_left_comm,mul_assoc] using hh.symm

private theorem normalized_kth_determinant (L A B : ℕ) :
    ∃ C : ℝ, 0 < C ∧
      ∀ c m X : ℝ, 0 ≤ c → c ≤ 2 → 0 < m → m ≤ 1 → 1 ≤ X →
      ∀ S T : Cols A B → ℝ,
        (∀ r, |S r-c| ≤ 2*X^(-m)) →
        (∀ r, |T r-(S r)^L| ≤ 2^(L+1)*X^(-(1 : ℝ))) →
        |Matrix.det (fun r col : Cols A B => (S r)^(col.1 : ℕ)*(T r)^(col.2 : ℕ))|
          ≤ C*X^(-((2*Real.sqrt (2*m)/3)*
            ((A+1)*(B+1) : ℕ)*Real.sqrt ((A+1)*(B+1) : ℕ)
              -5*((A+1)*(B+1) : ℕ))) := by
  classical
  let I := Cols A B
  let K := {p : ℕ × ℕ // p ∈ jetBox L A B}
  obtain ⟨C0,hC0,hcoeff⟩ := graphPoly_uniform_coefficients L A B
  let Ctotal : ℝ :=
    (Fintype.card K : ℝ)^(Fintype.card I) *
    ((Fintype.card I).factorial : ℝ)*C0^(Fintype.card I) *
    (∑ f : I → K, ∏ i : I, (2 : ℝ)^(f i).val.1*((2 : ℝ)^(L+1))^(f i).val.2)
  have hCtotal : 0 ≤ Ctotal := by
    dsimp [Ctotal]
    positivity
  refine ⟨1+Ctotal,by positivity,?_⟩
  intro c m X hc0 hc2 hm hm1 hX S T ha hb
  let V : Matrix I K ℝ := fun r p => (S r-c)^p.val.1*(T r-(S r)^L)^p.val.2
  let Cmat : Matrix K I ℝ := fun p col =>
    MvPolynomial.coeff (jetExp p.val) (graphPoly L c (col.1 : ℕ) (col.2 : ℕ))
  have hC : ∀ p col, |Cmat p col| ≤ C0 := by
    intro p col
    exact hcoeff c hc0 hc2 (col.1 : ℕ) (col.2 : ℕ)
      (Nat.lt_succ_iff.mp col.1.isLt) (Nat.lt_succ_iff.mp col.2.isLt) _
  have hV : ∀ r p, |V r p| ≤
      (2 : ℝ)^p.val.1*((2 : ℝ)^(L+1))^p.val.2*X^(-pairWeight m p.val) := by
    intro r p
    exact FormalAB.S1fdb06b5.A1OriginalDeterminant.jet_value_bound m X 2 ((2 : ℝ)^(L+1))
      p.val.1 p.val.2 hX (by norm_num) (by positivity) _ _ (ha r) (hb r)
  have hmat : V*Cmat =
      (fun r col : Cols A B => (S r)^(col.1 : ℕ)*(T r)^(col.2 : ℕ)) := by
    ext r col
    rw [Matrix.mul_apply]
    have hs : ∀ d ∈ (graphPoly L c (col.1 : ℕ) (col.2 : ℕ)).support,
        d 0 ≤ A+L*B ∧ d 1 ≤ B := by
      intro d hd
      have hh := graphPoly_support L c (col.1 : ℕ) (col.2 : ℕ) d hd
      exact ⟨hh.1.trans (Nat.add_le_add (Nat.lt_succ_iff.mp col.1.isLt)
        (Nat.mul_le_mul_left L (Nat.lt_succ_iff.mp col.2.isLt))),
        hh.2.trans (Nat.lt_succ_iff.mp col.2.isLt)⟩
    have heval := polynomial_evaluation_box L A B
      (graphPoly L c (col.1 : ℕ) (col.2 : ℕ)) (S r-c) (T r-(S r)^L) hs
    change (∑ p : K, (S r-c)^p.val.1*(T r-(S r)^L)^p.val.2*
      MvPolynomial.coeff (jetExp p.val) (graphPoly L c (col.1 : ℕ) (col.2 : ℕ))) = _
    rw [← heval,graphPoly_eval]
    have h1 : c+(S r-c)=S r := by ring
    rw [h1]
    have h2 : (S r)^L+(T r-(S r)^L)=T r := by ring
    rw [h2]
  have hbnd := jet_evaluation_det_bound L V Cmat
    (fun p : K => p.val) Subtype.val_injective
    m X C0 hm hm1 hX hC0 hV hC
  rw [hmat] at hbnd
  have hcard : Fintype.card I = (A+1)*(B+1) := by simp [I,Cols]
  simp only [hcard] at hbnd
  calc
    _ ≤ Ctotal*X^(-((2*Real.sqrt (2*m)/3)*
        ((A+1)*(B+1) : ℕ)*Real.sqrt ((A+1)*(B+1) : ℕ)
          -5*((A+1)*(B+1) : ℕ))) := by
      simpa only [Ctotal,hcard] using hbnd
    _ ≤ _ := by gcongr; linarith

end A8KCore

namespace A8KCore
private def mBaseK (L : ℕ) (s : ℝ) : ℝ :=
  (9 : ℝ)/8*s*(2-(L : ℝ)*s)
private def chosenBK (L Q : ℕ) (s : ℝ) : ℕ :=
  ⌊(Q : ℝ)*s/(2-(L : ℝ)*s)⌋₊

private theorem kth_menu_margin
    (L : ℕ) (hL : 4 ≤ L)
    (δ : ℝ) (hδ : 0 < δ) (hδu : δ < (1/4000 : ℝ))
    (Q : ℕ) (hQL : L ≤ Q) (hQδ : 60*(L : ℝ)/δ ≤ (Q : ℝ))
    (s : ℝ) (hslo : 1 ≤ (L : ℝ)*s) (hshi : ((L : ℝ)+1)*s ≤ 2) :
    let B := chosenBK L Q s
    let H : ℝ := ((Q+1)*(B+1) : ℕ)
    let m := mBaseK L s+δ
    1 ≤ B ∧ B ≤ Q ∧ 0 < m ∧ m ≤ 1 ∧
      H*((Q : ℝ)*s+(B : ℝ)*(2-(L : ℝ)*s))/2 -
        (2*Real.sqrt (2*m)/3)*H*Real.sqrt H+5*H ≤ -2*H := by
  dsimp
  let z := 2-(L : ℝ)*s
  let B := chosenBK L Q s
  let H : ℝ := ((Q+1)*(B+1) : ℕ)
  let m := mBaseK L s+δ
  have hLR : (4 : ℝ) ≤ (L : ℝ) := by exact_mod_cast hL
  have hs0 : 0 < s := by nlinarith
  have hs25 : s ≤ (2/5 : ℝ) := by nlinarith [mul_le_mul_of_nonneg_right hLR hs0.le]
  have hsz : s ≤ z := by dsimp [z]; linarith
  have hz0 : 0 < z := lt_of_lt_of_le hs0 hsz
  have hz1 : z ≤ 1 := by dsimp [z]; linarith
  have hQR : (L : ℝ) ≤ (Q : ℝ) := by exact_mod_cast hQL
  have hQ0 : (0 : ℝ) < Q := by linarith
  have ht0 : 0 ≤ (Q : ℝ)*s/z := div_nonneg (mul_nonneg hQ0.le hs0.le) hz0.le
  have hBfloor : (B : ℝ) ≤ (Q : ℝ)*s/z := Nat.floor_le ht0
  have hBfloor' : (Q : ℝ)*s/z < (B : ℝ)+1 := Nat.lt_floor_add_one _
  have hBz : (B : ℝ)*z ≤ (Q : ℝ)*s := (le_div_iff₀ hz0).mp hBfloor
  have hBup : (Q : ℝ)*s < ((B : ℝ)+1)*z := (div_lt_iff₀ hz0).mp hBfloor'
  have hQs : (L : ℝ)*s ≤ (Q : ℝ)*s := mul_le_mul_of_nonneg_right hQR hs0.le
  have hB1 : 1 ≤ B := by
    apply (Nat.le_floor_iff ht0).mpr
    rw [Nat.cast_one, le_div_iff₀ hz0, one_mul]
    linarith
  have hBQ : B ≤ Q := by
    have hh : (B : ℝ) ≤ Q := hBfloor.trans
      ((div_le_iff₀ hz0).mpr (mul_le_mul_of_nonneg_left hsz hQ0.le))
    exact_mod_cast hh
  have hH : H = ((Q : ℝ)+1)*((B : ℝ)+1) := by simp [H]
  have hH0 : 0 < H := by dsimp [H]; positivity
  have hHpos := Real.sqrt_nonneg H
  have hHsq := Real.sq_sqrt hH0.le
  have hQHz : (Q : ℝ)^2*s ≤ H*z := by
    have hh := mul_lt_mul_of_pos_left hBup hQ0
    have hb : 0 ≤ ((B : ℝ)+1)*z := by positivity
    rw [hH]
    nlinarith
  have hHz : H*z ≤ H := mul_le_of_le_one_right hH0.le hz1
  have hQL2 : (Q : ℝ)^2 ≤ (L : ℝ)*H := by
    have h1 := mul_le_mul_of_nonneg_left hslo (sq_nonneg (Q : ℝ))
    have h2 := mul_le_mul_of_nonneg_left (hQHz.trans hHz)
      (by linarith : (0 : ℝ) ≤ (L : ℝ))
    nlinarith
  have hLL : (L : ℝ)*H ≤ (L : ℝ)^2*H := by
    have hL2 : (L : ℝ) ≤ (L : ℝ)^2 := by nlinarith
    exact mul_le_mul_of_nonneg_right hL2 hH0.le
  have hQdivL : ((Q : ℝ)/L)^2 ≤ H := by
    rw [div_pow, div_le_iff₀ (pow_pos (by linarith) 2)]
    nlinarith
  have hQsqrt : (Q : ℝ)/L ≤ Real.sqrt H := by
    calc (Q : ℝ)/L = Real.sqrt (((Q : ℝ)/L)^2) :=
          (Real.sqrt_sq (div_nonneg hQ0.le (by linarith))).symm
      _ ≤ Real.sqrt H := Real.sqrt_le_sqrt hQdivL
  have hsqprod : ((Q : ℝ)*s)^2 ≤ H*(s*z) := by
    have hh := mul_le_mul_of_nonneg_right hQHz hs0.le
    nlinarith
  have hsz0 : 0 ≤ s*z := mul_nonneg hs0.le hz0.le
  have hsz1 : s*z ≤ 1 := by
    have hh := mul_le_mul_of_nonneg_right (show s ≤ (1 : ℝ) by linarith) hz0.le
    linarith
  have hsqrtSz0 := Real.sqrt_nonneg (s*z)
  have hsqrtSzSq := Real.sq_sqrt hsz0
  have hprod0 : 0 ≤ Real.sqrt H*Real.sqrt (s*z) := mul_nonneg hHpos hsqrtSz0
  have hprodSq : (Real.sqrt H*Real.sqrt (s*z))^2 = H*(s*z) := by
    rw [mul_pow,hHsq,hsqrtSzSq]
  have hrootAspect : (Q : ℝ)*s ≤ Real.sqrt H*Real.sqrt (s*z) := by
    nlinarith
  have hAs : ((Q : ℝ)*s+(B : ℝ)*z)/2 ≤ Real.sqrt H*Real.sqrt (s*z) := by
    linarith
  have hheight := mul_le_mul_of_nonneg_left hAs hH0.le
  have hm0 : 0 < m := by
    dsimp [m,mBaseK]
    have hh : 0 < (9 : ℝ)/8*s*(2-(L : ℝ)*s) :=
      mul_pos (mul_pos (by norm_num) hs0) (by linarith)
    linarith
  have hmlo : (9 : ℝ)/8*s*z+δ ≤ m := by
    have hh : (9 : ℝ)/8*s*(2-(L : ℝ)*s) ≤ mBaseK L s := le_refl _
    change (9 : ℝ)/8*s*(2-(L : ℝ)*s)+δ ≤ mBaseK L s+δ
    linarith only [hh]
  have hszhalf : s*z ≤ (1/2 : ℝ) := by
    have hh := mul_le_mul_of_nonneg_left hz1 hs0.le
    linarith
  have hbase : mBaseK L s ≤ (9/16 : ℝ) := by
    change (9 : ℝ)/8*s*z ≤ 9/16
    nlinarith
  have hm1 : m ≤ 1 := by
    dsimp [m]
    linarith
  let c : ℝ := 2*Real.sqrt (2*m)/3
  let t : ℝ := Real.sqrt (s*z)
  have hc0 : 0 ≤ c := by dsimp [c]; positivity
  have ht0' : 0 ≤ t := hsqrtSz0
  have hcSq : c^2 = 8*m/9 := by
    dsimp [c]
    have hh := Real.sq_sqrt (by positivity : 0 ≤ 2*m)
    nlinarith only [hh]
  have htSq : t^2 = s*z := hsqrtSzSq
  have hc1 : c ≤ 1 := by nlinarith only [hcSq,hm1,hc0]
  have ht1 : t ≤ 1 := by nlinarith only [htSq,hsz1,ht0']
  have hdiff : 8*δ/9 ≤ c^2-t^2 := by nlinarith only [hcSq,htSq,hmlo]
  have hct : t ≤ c := by nlinarith only [hdiff,hδ,hc0,ht0']
  have hfactor : (c-t)*(c+t) ≤ 2*(c-t) := by
    calc
      (c-t)*(c+t) ≤ (c-t)*2 :=
        mul_le_mul_of_nonneg_left (by linarith only [hc1,ht1] : c+t ≤ 2)
          (by linarith only [hct] : 0 ≤ c-t)
      _ = 2*(c-t) := mul_comm _ _
  have hgap : δ/3 ≤ c-t := by
    nlinarith only [hfactor,hdiff,hδ]
  have hδQ : (60 : ℝ)*L ≤ (Q : ℝ)*δ := (div_le_iff₀ hδ).mp hQδ
  have h20 : (20 : ℝ) ≤ δ/3*((Q : ℝ)/L) := by
    have hLpos : (0 : ℝ) < L := by linarith
    have hq : (60 : ℝ) ≤ (Q : ℝ)*δ/L := by
      rw [le_div_iff₀ hLpos]
      linarith
    have he : δ/3*((Q : ℝ)/L) = ((Q : ℝ)*δ/L)/3 := by ring
    rw [he]
    linarith
  have hbudget : (10 : ℝ) ≤ δ/3*Real.sqrt H := by
    have hh := mul_le_mul_of_nonneg_left hQsqrt (by positivity : 0 ≤ δ/3)
    linarith
  have hgapProd := mul_le_mul_of_nonneg_right hgap
    (mul_nonneg hH0.le hHpos)
  have hbudgetH := mul_le_mul_of_nonneg_left hbudget hH0.le
  refine ⟨hB1,hBQ,hm0,hm1,?_⟩
  change H*((Q : ℝ)*s+(B : ℝ)*z)/2-c*H*Real.sqrt H+5*H ≤ -2*H
  change H*(((Q : ℝ)*s+(B : ℝ)*z)/2) ≤
    H*(Real.sqrt H*Real.sqrt (s*z)) at hheight
  dsimp [t] at hgapProd
  nlinarith only [hheight,hgapProd,hbudgetH,hH0.le]

private def mRK (L : ℕ) (s : ℝ) : ℝ :=
  (9 : ℝ)/32*(2-((L : ℝ)-1)*s)^2

private theorem kth_menu_margin_R
    (L : ℕ) (hL : 4 ≤ L)
    (δ : ℝ) (hδ : 0 < δ) (hδu : δ < (1/4000 : ℝ))
    (Q : ℕ) (hQ4 : 4 ≤ Q) (hQδ : 60/δ ≤ (Q : ℝ))
    (s : ℝ) (hslo : 2 ≤ ((L : ℝ)+1)*s) (hshi : (L : ℝ)*s ≤ 2) :
    0 < mRK L s+δ ∧ mRK L s+δ ≤ 1 ∧
      (((Q+1)*(Q+1) : ℕ) : ℝ)*((Q : ℝ)*s+(Q : ℝ)*(2-(L : ℝ)*s))/2 -
        (2*Real.sqrt (2*(mRK L s+δ))/3)*(((Q+1)*(Q+1) : ℕ) : ℝ)*
          Real.sqrt (((Q+1)*(Q+1) : ℕ) : ℝ)+5*(((Q+1)*(Q+1) : ℕ) : ℝ)
        ≤ -2*(((Q+1)*(Q+1) : ℕ) : ℝ) := by
  have hLR : (4 : ℝ) ≤ (L : ℝ) := by exact_mod_cast hL
  have hQR : (4 : ℝ) ≤ Q := by exact_mod_cast hQ4
  have hs0 : 0 < s := by nlinarith
  have hs12 : s ≤ 1/2 := by nlinarith [mul_le_mul_of_nonneg_right hLR hs0.le]
  have hHc : (((Q+1)*(Q+1) : ℕ) : ℝ) = ((Q : ℝ)+1)^2 := by push_cast; ring
  have hsqrtH : Real.sqrt (((Q : ℝ)+1)^2) = (Q : ℝ)+1 :=
    Real.sqrt_sq (by positivity)
  rw [hHc, hsqrtH]
  have hmR : mRK L s = 9/8*((2-((L : ℝ)-1)*s)/2)^2 := by unfold mRK; ring
  rw [hmR]
  obtain ⟨t, ht⟩ : ∃ t : ℝ, t = (2-((L : ℝ)-1)*s)/2 := ⟨_, rfl⟩
  rw [← ht]
  have ht0 : 0 < t := by rw [ht]; nlinarith
  have ht2 : t ≤ 1/2 := by rw [ht]; nlinarith
  have hkey : (Q : ℝ)*s+(Q : ℝ)*(2-(L : ℝ)*s) = 2*(Q : ℝ)*t := by rw [ht]; ring
  rw [hkey]
  have hm0 : 0 < 9/8*t^2+δ := by positivity
  have hm1 : 9/8*t^2+δ ≤ 1 := by nlinarith
  refine ⟨hm0, hm1, ?_⟩
  obtain ⟨c, hc⟩ : ∃ c : ℝ, c = 2*Real.sqrt (2*(9/8*t^2+δ))/3 := ⟨_, rfl⟩
  rw [← hc]
  have hsq := Real.sq_sqrt (by positivity : (0:ℝ) ≤ 2*(9/8*t^2+δ))
  have hsq0 := Real.sqrt_nonneg (2*(9/8*t^2+δ))
  have hc0 : 0 ≤ c := by rw [hc]; positivity
  have hcSq : c^2 = t^2 + 8*δ/9 := by
    have h1 : c^2 = 4/9*(Real.sqrt (2*(9/8*t^2+δ)))^2 := by rw [hc]; ring
    rw [h1, hsq]; ring
  have hc1 : c ≤ 1 := by nlinarith
  have hct : t ≤ c := by nlinarith
  have hprod : (c-t)*(c+t) ≤ (c-t)*2 :=
    mul_le_mul_of_nonneg_left (by linarith) (by linarith)
  have hgap : δ/3 ≤ c-t := by nlinarith
  have hδQ : (60 : ℝ) ≤ (Q : ℝ)*δ := (div_le_iff₀ hδ).mp hQδ
  have hQgap := mul_le_mul_of_nonneg_left hgap (Nat.cast_nonneg Q : (0:ℝ) ≤ Q)
  have hin : (Q : ℝ)*t - c*((Q : ℝ)+1) + 7 ≤ 0 := by nlinarith
  have hH0 : 0 ≤ ((Q : ℝ)+1)^2 := by positivity
  have hfin := mul_le_mul_of_nonneg_left hin hH0
  nlinarith [hfin]

private theorem range_conv (k : ℕ) (hk : 5 ≤ k) (s : ℝ)
    (hslo : 2 / ((k : ℝ) + 1) ≤ s) (hshi : s ≤ 2 / (k : ℝ)) :
    2 ≤ ((k : ℝ)+1)*s ∧ (k : ℝ)*s ≤ 2 := by
  have hk0 : (0 : ℝ) < (k : ℝ) := by
    have : (5 : ℝ) ≤ (k : ℝ) := by exact_mod_cast hk
    linarith
  constructor
  · have hh := (div_le_iff₀ (by linarith : (0 : ℝ) < (k : ℝ)+1)).mp hslo
    linarith
  · have hh := (le_div_iff₀ hk0).mp hshi
    linarith

private theorem range_conv_left (k : ℕ) (hk : 5 ≤ k) (s : ℝ)
    (hshi : s ≤ 2 / ((k : ℝ) + 1)) : ((k : ℝ)+1)*s ≤ 2 := by
  have hk0 : (0 : ℝ) < (k : ℝ) + 1 := by
    have : (5 : ℝ) ≤ (k : ℝ) := by exact_mod_cast hk
    linarith
  have hh := (le_div_iff₀ hk0).mp hshi
  linarith
