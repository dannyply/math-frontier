  have he1 : (1 : ℝ) ≤ (z.1.2 : ℝ) := by exact_mod_cast he
  have hu1 : (1 : ℝ) ≤ (z.2.1 : ℝ) := by exact_mod_cast hu
  have hv1 : (1 : ℝ) ≤ (z.2.2 : ℝ) := by exact_mod_cast hv
  have hdk1 : (1 : ℝ) ≤ (z.1.1 : ℝ) ^ k := one_le_pow₀ hd1
  have hek1 : (1 : ℝ) ≤ (z.1.2 : ℝ) ^ k := one_le_pow₀ he1
  have hdle : (z.1.1 : ℝ) ≤ (z.1.1 : ℝ) ^ k := by
    simpa only [pow_one] using pow_le_pow_right₀ hd1 hk
  have hele : (z.1.2 : ℝ) ≤ (z.1.2 : ℝ) ^ k := by
    simpa only [pow_one] using pow_le_pow_right₀ he1 hk
  have hnR : (z.1.1 : ℝ) ^ k * (z.2.1 : ℝ) ≤ x := hn
  have hshiftR : (z.1.2 : ℝ) ^ k * (z.2.2 : ℝ) =
      (z.1.1 : ℝ) ^ k * (z.2.1 : ℝ) + 1 := by
    exact_mod_cast hshift
  have hprodE : (z.1.2 : ℝ) ^ k * (z.2.2 : ℝ) ≤ 2 * x := by
    linarith only [hnR,hshiftR,hx]
  have hdprod : (z.1.1 : ℝ) ^ k ≤
      (z.1.1 : ℝ) ^ k * (z.2.1 : ℝ) := by
    simpa using mul_le_mul_of_nonneg_left hu1
      (pow_nonneg (Nat.cast_nonneg _) k)
  have heprod : (z.1.2 : ℝ) ^ k ≤
      (z.1.2 : ℝ) ^ k * (z.2.2 : ℝ) := by
    simpa using mul_le_mul_of_nonneg_left hv1
      (pow_nonneg (Nat.cast_nonneg _) k)
  have huprod : (z.2.1 : ℝ) ≤
      (z.1.1 : ℝ) ^ k * (z.2.1 : ℝ) := by
    simpa using mul_le_mul_of_nonneg_right hdk1
      (Nat.cast_nonneg z.2.1 : (0 : ℝ) ≤ z.2.1)
  have hvprod : (z.2.2 : ℝ) ≤
      (z.1.2 : ℝ) ^ k * (z.2.2 : ℝ) := by
    simpa using mul_le_mul_of_nonneg_right hek1
      (Nat.cast_nonneg z.2.2 : (0 : ℝ) ≤ z.2.2)
  have hdx : (z.1.1 : ℝ) ≤ x := hdle.trans (hdprod.trans hnR)
  have hux : (z.2.1 : ℝ) ≤ x := huprod.trans hnR
  exact ⟨by linarith only [hdx,hx], hele.trans (heprod.trans hprodE),
    by linarith only [hux,hx], hvprod.trans hprodE⟩

private theorem originalBoxK_entry_height
    (k A B : ℕ) (hk : 1 ≤ k) (hB : B ≤ A)
    (x D E : ℝ) (hx : 2 ≤ x)
    (z : Point) (hz : z ∈ originalBoxK k x D E)
    (c : Cols A B) :
    |(entry A B z c : ℝ)| ≤ (2 : ℝ) ^ (2 * A) * x ^ (2 * A) := by
  have hp := originalBoxK_coordinate_bounds k hk x D E hx z hz
  have heq :
      |(entry A B z c : ℝ)| =
        (z.1.1 : ℝ) ^ (c.1 : ℕ) *
        (z.1.2 : ℝ) ^ (A - (c.1 : ℕ)) *
        (z.2.2 : ℝ) ^ (c.2 : ℕ) *
        (z.2.1 : ℝ) ^ (B - (c.2 : ℕ)) := by
    simp only [entry,Int.cast_mul,Int.cast_pow,Int.cast_natCast]
    exact abs_of_nonneg (by positivity)
  rw [heq]
  calc
    _ ≤ (2 * x) ^ (c.1 : ℕ) * (2 * x) ^ (A - (c.1 : ℕ)) *
        (2 * x) ^ (c.2 : ℕ) * (2 * x) ^ (B - (c.2 : ℕ)) := by
      gcongr <;> first
        | exact hp.1
        | exact hp.2.1
        | exact hp.2.2.1
        | exact hp.2.2.2
    _ = (2 * x) ^ (A + B) := by
      rw [← pow_add,mul_assoc,← pow_add,← pow_add]
      congr 1
      have hi := c.1.isLt
      have hj := c.2.isLt
      omega
    _ ≤ (2 * x) ^ (2 * A) :=
      pow_le_pow_right₀ (by linarith only [hx]) (by omega)
    _ = _ := by rw [mul_pow]

private theorem k_reciprocal_cell_width
    (x m : ℝ) (M : ℕ) (hx : 0 < x)
    (hM : x ^ m ≤ (M : ℝ)) :
    0 < (M : ℝ) ∧ 2 / (M : ℝ) ≤ 2 * x ^ (-m) := by
  have hp : 0 < x ^ m := Real.rpow_pos_of_pos hx m
  have hMp : 0 < (M : ℝ) := lt_of_lt_of_le hp hM
  refine ⟨hMp, ?_⟩
  have hh : 2 / (M : ℝ) ≤ 2 / (x ^ m) :=
    div_le_div_of_nonneg_left (by norm_num) hp hM
  calc
    _ ≤ 2 / (x ^ m) := hh
    _ = 2 * x ^ (-m) := by rw [Real.rpow_neg hx.le]; ring

private theorem k_original_cofactor_upper
    (k : ℕ) (x D d u : ℝ) (_hx : 0 < x) (hD : 0 < D)
    (hd : D / 2 < d) (hu : 0 < u) (hprod : d ^ k * u ≤ x) :
    u ≤ (2 : ℝ) ^ k * x / D ^ k := by
  have hd0 : 0 < d := by linarith
  have hdpow : (D / 2) ^ k ≤ d ^ k := by gcongr
  have hprod' := mul_le_mul_of_nonneg_right hdpow hu.le
  have hsmall : D ^ k / (2 : ℝ) ^ k * u ≤ x := by
    simpa only [div_pow] using hprod'.trans hprod
  have htwo : 0 < (2 : ℝ) ^ k := by positivity
  have hDk : 0 < D ^ k := pow_pos hD _
  have hmain : D ^ k * u ≤ (2 : ℝ) ^ k * x := by
    calc
      D ^ k * u = (D ^ k / (2 : ℝ) ^ k * u) * (2 : ℝ) ^ k := by
        field_simp
      _ ≤ x * (2 : ℝ) ^ k :=
        mul_le_mul_of_nonneg_right hsmall htwo.le
      _ = (2 : ℝ) ^ k * x := by ring
  exact (le_div_iff₀ hDk).mpr (by simpa only [mul_comm] using hmain)

private theorem k_integer_minor_vanishes
    {I : Type*} [Fintype I] [DecidableEq I]
    (P : Matrix I I ℤ) (h : |((P.det : ℤ) : ℝ)| < 1) :
    P.det = 0 := by
  have hi : |P.det| < (1 : ℤ) := by exact_mod_cast h
  have hh := abs_lt.mp hi
  omega

private theorem k_final_integer_threshold
    (C x H : ℝ) (hC : 0 ≤ C) (hx : 8 ≤ x)
    (hCx : 2 * C ≤ x) (hH : 1 ≤ H) :
    C * x ^ (-2 * H) < 1 := by
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  calc
    C * x ^ (-2 * H) ≤ C * x ^ (-(1 : ℝ)) := by gcongr; linarith
    _ = C / x := by rw [Real.rpow_neg_one]; ring
    _ ≤ (1 / 2 : ℝ) := by
      apply (div_le_iff₀ hx0).mpr
      linarith
    _ < 1 := by norm_num

private theorem k_rectangular_degree_halves (A B : ℕ) :
    (FormalAB.Sb868eaea.A5AffineFiniteGate.xDegreeSum A B : ℝ) = (A : ℝ) * ((A + 1) * (B + 1) : ℕ) / 2 ∧
    (FormalAB.Sb868eaea.A5AffineFiniteGate.yDegreeSum A B : ℝ) = (B : ℝ) * ((A + 1) * (B + 1) : ℕ) / 2 := by
  have hi : 2 * FormalAB.Sb868eaea.A5AffineFiniteGate.xDegreeSum A B = (A + 1) * (B + 1) * A := by
    calc
      _ = (∑ c : Cols A B, (c.1 : ℕ)) +
          (∑ c : Cols A B, (A - (c.1 : ℕ))) := by
        rw [FormalAB.Sb868eaea.A5AffineFiniteGate.Internal.gap_sum_first]
        change 2 * (∑ c : Cols A B, (c.1 : ℕ)) =
          (∑ c : Cols A B, (c.1 : ℕ)) + (∑ c : Cols A B, (c.1 : ℕ))
        omega
      _ = ∑ c : Cols A B, ((c.1 : ℕ) + (A - (c.1 : ℕ))) := by
        rw [Finset.sum_add_distrib]
      _ = ∑ c : Cols A B, A := by
        apply Finset.sum_congr rfl
        intro c hc
        exact Nat.add_sub_of_le (Nat.lt_succ_iff.mp c.1.isLt)
      _ = _ := by simp [Cols]
  have hj : 2 * FormalAB.Sb868eaea.A5AffineFiniteGate.yDegreeSum A B = (A + 1) * (B + 1) * B := by
    calc
      _ = (∑ c : Cols A B, (c.2 : ℕ)) +
          (∑ c : Cols A B, (B - (c.2 : ℕ))) := by
        rw [FormalAB.Sb868eaea.A5AffineFiniteGate.Internal.gap_sum_second]
        change 2 * (∑ c : Cols A B, (c.2 : ℕ)) =
          (∑ c : Cols A B, (c.2 : ℕ)) + (∑ c : Cols A B, (c.2 : ℕ))
        omega
      _ = ∑ c : Cols A B, ((c.2 : ℕ) + (B - (c.2 : ℕ))) := by
        rw [Finset.sum_add_distrib]
      _ = ∑ c : Cols A B, B := by
        apply Finset.sum_congr rfl
        intro c hc
        exact Nat.add_sub_of_le (Nat.lt_succ_iff.mp c.2.isLt)
      _ = _ := by simp [Cols]
  have hiR : (2 : ℝ) * (FormalAB.Sb868eaea.A5AffineFiniteGate.xDegreeSum A B : ℝ) =
      ((A + 1) * (B + 1) : ℕ) * (A : ℝ) := by exact_mod_cast hi
  have hjR : (2 : ℝ) * (FormalAB.Sb868eaea.A5AffineFiniteGate.yDegreeSum A B : ℝ) =
      ((A + 1) * (B + 1) : ℕ) * (B : ℝ) := by exact_mod_cast hj
  constructor <;> nlinarith

private theorem k_physical_scale
    (k A B : ℕ) (x s D E : ℝ)
    (hx : 0 < x) (hD : 0 < D) (hE : 0 < E) (hDE : D * E = x ^ s) :
    let U : ℝ := (2 : ℝ) ^ (k - 3) * x / D ^ k
    let V : ℝ := (2 : ℝ) ^ (k - 3) * x / E ^ k
    (D * E) ^ FormalAB.Sb868eaea.A5AffineFiniteGate.xDegreeSum A B * (U * V) ^ FormalAB.Sb868eaea.A5AffineFiniteGate.yDegreeSum A B =
      ((2 : ℝ) ^ (k - 3)) ^ (2 * FormalAB.Sb868eaea.A5AffineFiniteGate.yDegreeSum A B) *
        x ^ ((((A + 1) * (B + 1) : ℕ) *
          ((A : ℝ) * s + (B : ℝ) * (2 - (k : ℝ) * s))) / 2) := by
  let c : ℝ := (2 : ℝ) ^ (k - 3)
  let U₀ : ℝ := x / D ^ k
  let V₀ : ℝ := x / E ^ k
  have hUV : U₀ * V₀ = x ^ (2 - (k : ℝ) * s) := by
    calc
      U₀ * V₀ = x ^ 2 / (D * E) ^ k := by
        dsimp [U₀,V₀]
        rw [mul_pow]
        field_simp [ne_of_gt hD,ne_of_gt hE]
      _ = x ^ (2 : ℝ) / (x ^ s) ^ k := by
        rw [hDE]
        norm_num [Real.rpow_natCast]
      _ = _ := by
        rw [← Real.rpow_natCast (x ^ s) k,
          ← Real.rpow_mul hx.le, ← Real.rpow_sub hx]
        congr 1
        ring
  have hi : (D * E) ^ FormalAB.Sb868eaea.A5AffineFiniteGate.xDegreeSum A B =
      x ^ (s * (FormalAB.Sb868eaea.A5AffineFiniteGate.xDegreeSum A B : ℝ)) := by
    rw [hDE,Real.rpow_mul hx.le,Real.rpow_natCast]
  have hj : (U₀ * V₀) ^ FormalAB.Sb868eaea.A5AffineFiniteGate.yDegreeSum A B =
      x ^ ((2 - (k : ℝ)*s)*(FormalAB.Sb868eaea.A5AffineFiniteGate.yDegreeSum A B : ℝ)) := by
    rw [hUV,Real.rpow_mul hx.le,Real.rpow_natCast]
  have hUVg : (c*x/D^k)*(c*x/E^k) = c^2*(U₀*V₀) := by
    dsimp [U₀,V₀]
    ring
  have hh := k_rectangular_degree_halves A B
  change
    (D * E) ^ FormalAB.Sb868eaea.A5AffineFiniteGate.xDegreeSum A B *
      ((c*x/D^k)*(c*x/E^k)) ^ FormalAB.Sb868eaea.A5AffineFiniteGate.yDegreeSum A B =
    c ^ (2*FormalAB.Sb868eaea.A5AffineFiniteGate.yDegreeSum A B) *
      x ^ ((((A + 1)*(B + 1) : ℕ) *
        ((A : ℝ)*s+(B : ℝ)*(2-(k : ℝ)*s))) / 2)
  rw [hUVg, mul_pow (c^2) (U₀*V₀)
    (FormalAB.Sb868eaea.A5AffineFiniteGate.yDegreeSum A B), hi, hj]
  have hcPow : (c^2)^FormalAB.Sb868eaea.A5AffineFiniteGate.yDegreeSum A B =
      c^(2*FormalAB.Sb868eaea.A5AffineFiniteGate.yDegreeSum A B) := by rw [pow_mul]
  calc
    _ = c^(2*FormalAB.Sb868eaea.A5AffineFiniteGate.yDegreeSum A B) *
        (x^(s*(FormalAB.Sb868eaea.A5AffineFiniteGate.xDegreeSum A B : ℝ)) *
          x^((2-(k : ℝ)*s)*(FormalAB.Sb868eaea.A5AffineFiniteGate.yDegreeSum A B : ℝ))) := by
      rw [hcPow]
      ring
    _ = _ := by
      rw [← Real.rpow_add hx]
      congr 2
      rw [hh.1,hh.2]
      ring

private theorem k_normalized_slope_bounds
    (D E d e ρ M : ℝ)
    (hD : 0 < D) (hE : 0 < E) (hd : 0 < d) (he : 0 < e)
    (_hdlo : D/2 < d) (hdhi : d ≤ D)
    (helo : E/2 < e) (_hehi : e ≤ E)
    (hM : 0 < M)
    (hρlo : D/(2*E) ≤ ρ) (hρhi : ρ ≤ 2*D/E)
    (hlo : ρ < d/e) (hhi : d/e ≤ ρ*(1+1/M)) :
    0 ≤ (E/D)*ρ ∧ (E/D)*ρ ≤ 2 ∧
      |(E/D)*(d/e)| ≤ 2 ∧
      |(E/D)*(d/e)-(E/D)*ρ| ≤ 2/M := by
  have hk : 0 < E/D := div_pos hE hD
  have hρ0 : 0 ≤ ρ := le_trans (by positivity : 0 ≤ D/(2*E)) hρlo
  have hc0 : 0 ≤ (E/D)*ρ := mul_nonneg hk.le hρ0
  have hc2 : (E/D)*ρ ≤ 2 := by
    have hh := mul_le_mul_of_nonneg_left hρhi hk.le
    have heq : (E/D)*(2*D/E)=2 := by
      field_simp [ne_of_gt hD,ne_of_gt hE]
    rwa [heq] at hh
  have hS0 : 0 ≤ (E/D)*(d/e) := by positivity
  have hS2 : (E/D)*(d/e) ≤ 2 := by
    have hh : E*d ≤ 2*D*e := by
      have h1 := mul_le_mul_of_nonneg_left hdhi hE.le
      have h2 := mul_lt_mul_of_pos_left helo hD
      nlinarith
    have heq : (E/D)*(d/e) = E*d/(D*e) := by
      field_simp
    rw [heq]
    apply (div_le_iff₀ (mul_pos hD he)).mpr
    nlinarith
  have hdiff0 : 0 ≤ (E/D)*(d/e)-(E/D)*ρ := by
    have hh := mul_lt_mul_of_pos_left hlo hk
    linarith
  have hdiff : (E/D)*(d/e)-(E/D)*ρ ≤ 2/M := by
    have hh := mul_le_mul_of_nonneg_left hhi hk.le
    have hcM : (E/D)*ρ/M ≤ 2/M := div_le_div_of_nonneg_right hc2 hM.le
    have heq : (E/D)*(ρ*(1+1/M)) = (E/D)*ρ+((E/D)*ρ)/M := by ring
    rw [heq] at hh
    linarith only [hh,hcM]
  exact ⟨hc0,hc2,(abs_of_nonneg hS0).le.trans hS2,
    (abs_of_nonneg hdiff0).le.trans hdiff⟩

private theorem k_actual_cell_decay (k A B : ℕ)
    (hk : 5 ≤ k) (hk123 : k ≤ 123)
    (hAdapter : AdapterBody) :
    ∃ C : ℝ, 0 < C ∧
      ∀ x s D E m : ℝ, 8 ≤ x → 0 < D → 0 < E → D*E=x^s →
        0 < m → m ≤ 1 →
      ∀ M : ℕ, x^m ≤ (M : ℝ) →
      ∀ j : ℕ, j ∈ cellsK D E M →
      ∀ z : Cols A B → Point, (∀ r, z r ∈ cellK k x D E M j) →
        |((Matrix.det (fun r col : Cols A B => entry A B (z r) col) : ℤ) : ℝ)|
          ≤ C*x^((((A+1)*(B+1) : ℕ)*
              ((A : ℝ)*s+(B : ℝ)*(2-(k : ℝ)*s)))/2 -
            (2*Real.sqrt (2*m)/3)*((A+1)*(B+1) : ℕ)*
              Real.sqrt ((A+1)*(B+1) : ℕ)+5*((A+1)*(B+1) : ℕ)) := by
  classical
  obtain ⟨CN,hCN,hgate⟩ := hAdapter.1 k hk hk123 A B
  let H : ℕ := (A+1)*(B+1)
  let R : ℝ := ((2 : ℝ)^A*(8 : ℝ)^B)^H
  let C : ℝ := R*((2 : ℝ)^(k-3))^(2*FormalAB.Sb868eaea.A5AffineFiniteGate.yDegreeSum A B)*CN
  have hC : 0 < C := by dsimp [C,R]; positivity
  refine ⟨C,hC,?_⟩
  intro x s D E m hx hD hE hDE hm hm1 M hM j hj z hz
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  let U : ℝ := (2 : ℝ)^(k-3)*x/D^k
  let V : ℝ := (2 : ℝ)^(k-3)*x/E^k
  have hU : 0 < U := by dsimp [U]; positivity
  have hV : 0 < V := by dsimp [V]; positivity
  let d : Cols A B → ℕ := fun r => (z r).1.1
  let e : Cols A B → ℕ := fun r => (z r).1.2
  let u : Cols A B → ℕ := fun r => (z r).2.1
  let v : Cols A B → ℕ := fun r => (z r).2.2
  let S : Cols A B → ℝ := fun r => (E/D)*((d r : ℝ)/(e r : ℝ))
  let T : Cols A B → ℝ := fun r => (E/D)^k*((v r : ℝ)/(u r : ℝ))
  let c : ℝ := (E/D)*rhoK D E M j
  have hcut : D/(2*E) ≤ rhoK D E M j ∧ rhoK D E M j ≤ 2*D/E := by
    have hmem := hj
    simp only [cellsK,Finset.mem_filter] at hmem
    exact hmem.2
  have hwidth := k_reciprocal_cell_width x m M hx0 hM
  have hpos (r : Cols A B) :
      0 < d r ∧ 0 < e r ∧ 0 < u r ∧ 0 < v r := by
    rcases (hz r).1 with ⟨hd,he,hu,hv,hunit,hprodlo,hprodhi,hdlo,hdhi,helo,hehi⟩
    obtain ⟨hlo,hhi⟩ := (hz r).2
    dsimp [d,e,u,v]
    exact ⟨by omega,by omega,by omega,by omega⟩
  have hposR (r : Cols A B) :
      0 < (d r : ℝ) ∧ 0 < (e r : ℝ) ∧ 0 < (u r : ℝ) ∧ 0 < (v r : ℝ) := by
    exact_mod_cast hpos r
  have hnorm (r : Cols A B) :
      0 ≤ c ∧ c ≤ 2 ∧ |S r| ≤ 2 ∧ |S r-c| ≤ 2*x^(-m) := by
    rcases (hz r).1 with ⟨hd,he,hu,hv,hunit,hprodlo,hprodhi,hdlo,hdhi,helo,hehi⟩
    obtain ⟨hlo,hhi⟩ := (hz r).2
    have hr := hposR r
    have hn := k_normalized_slope_bounds D E (d r : ℝ) (e r : ℝ)
      (rhoK D E M j) (M : ℝ) hD hE hr.1 hr.2.1
      hdlo hdhi helo hehi hwidth.1 hcut.1 hcut.2 hlo hhi
    exact ⟨hn.1,hn.2.1,hn.2.2.1,hn.2.2.2.trans hwidth.2⟩
  have herror (r : Cols A B) :
      |T r-(S r)^k| ≤ (2 : ℝ)^(k+1)*x^(-(1 : ℝ)) := by
    rcases (hz r).1 with ⟨hd,he,hu,hv,hunit,hprodlo,hprodhi,hdlo,hdhi,helo,hehi⟩
    have hr := hposR r
    have hunitR : (e r : ℝ)^k*(v r : ℝ) =
        (d r : ℝ)^k*(u r : ℝ)+1 := by exact_mod_cast hunit
    have hband : x/2 < (d r : ℝ)^k*(u r : ℝ) := hprodlo
    have heR := hAdapter.2 k hk hk123 x D E
      (d r : ℝ) (e r : ℝ) (u r : ℝ) (v r : ℝ)
      hx0 hD hE hr.1 hr.2.1 hr.2.2.1 hunitR hband (hnorm r).2.2.1
    simpa only [S,T,Real.rpow_neg_one,div_eq_mul_inv] using heR
  have hecap (r : Cols A B) : (e r : ℝ) ≤ 2*E := by
    rcases (hz r).1 with ⟨hd,he,hu,hv,hunit,hprodlo,hprodhi,hdlo,hdhi,helo,hehi⟩
    obtain ⟨hlo,hhi⟩ := (hz r).2
    change (e r : ℝ) ≤ E at hehi
    linarith
  have hucap (r : Cols A B) : (u r : ℝ) ≤ 8*U := by
    rcases (hz r).1 with ⟨hd,he,hu,hv,hunit,hprodlo,hprodhi,hdlo,hdhi,helo,hehi⟩
    obtain ⟨hlo,hhi⟩ := (hz r).2
    have hprod : (d r : ℝ)^k*(u r : ℝ) ≤ x := by exact_mod_cast hprodhi
    have hco := k_original_cofactor_upper k x D (d r : ℝ) (u r : ℝ)
      hx0 hD hdlo (hposR r).2.2.1 hprod
    have hk3 : k - 3 + 3 = k := Nat.sub_add_cancel (by omega)
    have hp2 : (2 : ℝ)^k = 8 * (2 : ℝ)^(k-3) := by
      conv_lhs => rw [← hk3]
      rw [pow_add]
      norm_num
      ring
    calc
