lemma pe {R:Type*} [CommRing R] [IsDomain R]
    (d H p:R) (hd:Prime d) (hH:¬ d∣ H) (n:ℕ)
    (h:H∣ d^n*p):H∣ p:=by
  induction n with
  | zero=> simpa using h
  | succ n ih=>
    obtain ⟨q,hq⟩:=h
    have hdq:d∣ H*q:=by
      rw [← hq,pow_succ]
      exact ⟨d^n*p,by ring⟩
    have hq':d∣ q:=(hd.dvd_or_dvd hdq).resolve_left hH
    obtain ⟨q',rfl⟩:=hq'
    apply ih
    refine ⟨q',?_⟩
    apply cC hd.ne_zero
    calc
      d*(d^n*p)=d^(n+1)*p:=by ring
      _=H*(d*q'):=hq
      _=d*(H*q'):=by ring
lemma pf {R:Type*} [CommRing R] [IsDomain R]
    (d H p:R) (hd:Prime d) (hH:¬ d∣ H)
