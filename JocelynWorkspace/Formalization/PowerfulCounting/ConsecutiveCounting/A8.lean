theorem price_core (k : ℕ) (K x s D E δ1 θ m c M RDv RUv F2 F1 Pv : ℝ) (hKk : K = (k : ℝ))
    (hk : 5 ≤ k) (hx : 2 ≤ x)
    (hD : 0 < D) (hE : 0 < E) (hDE : D * E = x ^ s)
    (hD4 : x ^ ((1 : ℝ) / (2 * K ^ 2)) * D ^ k < x)
    (hE4 : x ^ ((1 : ℝ) / (2 * K ^ 2)) * E ^ k < x)
    (hs8 : 8 / (9 * K) ≤ s) (hks : K * s < 2)
    (hm : m = (9 : ℝ) / 8 * s * (2 - K * s))
    (hc : 0 < c) (hθk : 1 / K ≤ θ) (hmθ : m + c ≤ θ)
    (hZ : (1 + m) / K - s / (2 * K + 1) + c ≤ θ) (h34 : (s + 3 * m) / 4 + c ≤ θ)
    (hδ1 : 0 < δ1)
    (hM : M = (⌈x ^ (m + δ1)⌉₊ : ℝ))
    (hRD : RDv = D * E + (D ^ 2 + E ^ 2) / M)
    (hRU : RUv = x / D ^ k * (x / E ^ k) + ((x / D ^ k) ^ 2 + (x / E ^ k) ^ 2) / M)
    (hF2 : F2 = M + max D E + x ^ θ + M ^ (1 - (K + 1) / (2 * ((2 * k + 2 : ℕ) : ℝ))) * RDv ^ (K / (2 * ((2 * k + 2 : ℕ) : ℝ))) * RUv ^ ((1 : ℝ) / (2 * ((2 * k + 2 : ℕ) : ℝ))) + M * (x ^ ((1 : ℝ) / K) * M ^ (-((K - 1) / K)) * (D * E) ^ (-((1 : ℝ) / (2 * K + 1)))))
    (hF1 : F1 = M + max D E + x ^ θ + M ^ (1 - (K + 1) / (2 * ((2 * k + 1 : ℕ) : ℝ))) * RDv ^ (K / (2 * ((2 * k + 1 : ℕ) : ℝ))) * RUv ^ ((1 : ℝ) / (2 * ((2 * k + 1 : ℕ) : ℝ))) + M * (x ^ ((1 : ℝ) / K) * M ^ (-((K - 1) / K)) * (D * E) ^ (-((1 : ℝ) / (2 * K + 1)))))
    (hPv : Pv = M + max D E + x ^ θ + M ^ ((3 * K + 2) / (4 * K + 2)) * RDv ^ (K / (4 * K + 2)) * (x / max D E ^ k) ^ ((1 : ℝ) / (2 * K + 1)) + M * (x ^ ((1 : ℝ) / K) * M ^ (-((K - 1) / K)) * (D * E) ^ (-((1 : ℝ) / (2 * K + 1)))) + M ^ ((3 : ℝ) / 4) * RDv ^ ((1 : ℝ) / 4)) :
    ((2 + (3 * K + 2) * m) / (4 * K + 3) ≤ θ →
      (¬ (M * min D E ^ k < max D E ^ k) → F2 ≤ 20 * x ^ (θ + δ1)) ∧
      (M * min D E ^ k < max D E ^ k → min F2 Pv ≤ 20 * x ^ (θ + δ1))) ∧
    ((2 + (3 * K + 1) * m) / (4 * K + 2) ≤ θ →
      (¬ (M * min D E ^ k < max D E ^ k) → F1 ≤ 20 * x ^ (θ + δ1)) ∧
      (M * min D E ^ k < max D E ^ k → Pv ≤ 20 * x ^ (θ + δ1))) := by
  subst hF2 hF1 hPv
  have hK5 : (5 : ℝ) ≤ K := by rw [hKk]; exact_mod_cast hk
  have hK0 : 0 < K := by linarith
  have hc2 : ((2 * k + 2 : ℕ) : ℝ) = 2 * K + 2 := by rw [hKk]; push_cast; ring
  have hc1 : ((2 * k + 1 : ℕ) : ℝ) = 2 * K + 1 := by rw [hKk]; push_cast; ring
  rw [hc2, hc1]
  have hα2 : 1 - (K + 1) / (2 * (2 * K + 2)) = (3 : ℝ) / 4 := by
    have : (K + 1) / (2 * (2 * K + 2)) = 1 / 4 := by
      rw [div_eq_iff (by positivity)]; ring
    rw [this]; norm_num
  rw [hα2]
  have hx0 : (0 : ℝ) < x := by linarith
  have hx1 : (1 : ℝ) < x := by linarith
  have hL : 0 < Real.log x := Real.log_pos hx1
  have hl2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hl3 : 0 < Real.log 3 := Real.log_pos (by norm_num)
  have hl6 : Real.log 6 = Real.log 2 + Real.log 3 := by
    rw [show (6 : ℝ) = 2 * 3 by norm_num, Real.log_mul (by norm_num) (by norm_num)]
  have hs0 : 0 < s := by
    have : 0 < 8 / (9 * K) := by positivity
    linarith
  have hm0 : 0 ≤ m := by
    rw [hm]; exact mul_nonneg (mul_nonneg (by norm_num) hs0.le) (by linarith)
  have hKs8 : 8 ≤ 9 * (K * s) := by
    have := (div_le_iff₀ (by positivity : (0 : ℝ) < 9 * K)).mp hs8
    linarith
  have h2ks : 2 - K * s ≤ K * m := by
    rw [hm]
    have P := mul_nonneg (show (0 : ℝ) ≤ 2 - K * s by linarith)
      (show (0 : ℝ) ≤ 9 * (K * s) - 8 by linarith)
    linarith only [P]
  have hθ1 : 1 ≤ K * θ := by
    have := (div_le_iff₀ hK0).mp hθk
    linarith
  have hθ0 : 0 ≤ θ := by linarith
  have hmθ' : m ≤ θ := by linarith
  have hμ0 : 0 ≤ m + δ1 := by linarith
  have hxmpos : 0 < x ^ (m + δ1) := by positivity
  have hxm : (1 : ℝ) ≤ x ^ (m + δ1) := Real.one_le_rpow hx1.le hμ0
  have hMge : x ^ (m + δ1) ≤ M := by rw [hM]; exact Nat.le_ceil _
  have hMlt : M < x ^ (m + δ1) + 1 := by rw [hM]; exact Nat.ceil_lt_add_one hxmpos.le
  have hMpos : 0 < M := by linarith
