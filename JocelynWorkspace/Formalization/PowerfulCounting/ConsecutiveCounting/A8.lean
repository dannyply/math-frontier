namespace A8HighFPriceInternal

private lemma high_numeric_priceK
    (k thr N : ℕ) (c η x Δ L T : ℝ)
    (hk : 1 ≤ k) (hthr : 1 ≤ thr)
    (hη : 0 < η) (hx : 1 < x) (hL : 0 < L) (hT : 0 < T)
    (hΔ : (thr : ℝ) ≤ Δ) (hΔcap : Δ ≤ ((k*N : ℕ) : ℝ))
    (hLcap : L ≤ x^2) (hTcap : T ≤ x^2) :
    let H : ℝ := max 1 (L^k*T)
    2*|c| *Δ^3*H^(1/Δ)*(Real.log H+Δ) ≤
      (2*|c| *(((k*N : ℕ) : ℝ))^3*
        ((((2*k+2 : ℕ) : ℝ))/η+(((k*N : ℕ) : ℝ))))*
      x^η*(1+(L^k*T)^(1/(thr : ℝ))) := by
  let H : ℝ := max 1 (L^k*T)
  let d : ℝ := ((k*N : ℕ) : ℝ)
  let e : ℝ := ((2*k+2 : ℕ) : ℝ)
  have hH : 1 ≤ H := le_max_left _ _
  have hH0 : 0 < H := lt_of_lt_of_le zero_lt_one hH
  have hx0 : 0 < x := by linarith only [hx]
  have hx1 : 1 ≤ x := hx.le
  have hd : 0 ≤ d := by dsimp [d]; positivity
  have he : 0 ≤ e := by dsimp [e]; positivity
  have hthr0 : (0:ℝ) < thr := by exact_mod_cast (show 0 < thr by omega)
  have hΔ0 : 0 < Δ := hthr0.trans_le hΔ
  have hBase : 0 ≤ L^k*T := by positivity
  have hpow : (x^2)^k*x^2=x^(2*k+2) := by
    rw [←pow_mul, ←pow_add]
  have hHcap : H ≤ x^(2*k+2) := by
    apply max_le
    · exact one_le_pow₀ hx1
    · calc
        L^k*T ≤ (x^2)^k*x^2 :=
          mul_le_mul (pow_le_pow_left₀ hL.le hLcap k) hTcap hT.le (by positivity)
        _ = x^(2*k+2) := hpow
  have hlog : Real.log H ≤ e*Real.log x := by
    have ht := Real.log_le_log hH0 hHcap
    rw [Real.log_pow] at ht
    simpa only [e, Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat] using ht
  have hprice : Real.log H+Δ ≤ (e/η+d)*x^η := by
    have ht := Real.log_le_rpow_div hx0.le hη
    have hp := Real.one_le_rpow hx1 hη.le
    have hconst := mul_le_mul_of_nonneg_left hp hd
    calc
      Real.log H+Δ ≤ e*Real.log x+d := add_le_add hlog hΔcap
      _ ≤ e*(x^η/η)+d :=
        add_le_add (mul_le_mul_of_nonneg_left ht he) le_rfl
      _ ≤ e*(x^η/η)+d*x^η := by linarith only [hconst]
      _ = (e/η+d)*x^η := by ring
  have hexp : (1:ℝ)/Δ ≤ (1:ℝ)/(thr:ℝ) := by
    apply (div_le_div_iff₀ hΔ0 hthr0).mpr
    nlinarith only [hΔ]
  have hpower : H^(1/Δ) ≤ 1+(L^k*T)^((1:ℝ)/(thr:ℝ)) := by
    have ht := Real.rpow_le_rpow_of_exponent_le hH hexp
    apply ht.trans
    by_cases hb : 1 ≤ L^k*T
    · dsimp [H]
      rw [max_eq_right hb]
      linarith
    · dsimp [H]
      rw [max_eq_left (le_of_not_ge hb), Real.one_rpow]
      linarith only [Real.rpow_nonneg hBase ((1:ℝ)/(thr:ℝ))]
  have hdPow : Δ^3 ≤ d^3 := pow_le_pow_left₀ hΔ0.le hΔcap 3
  have hlog0 : 0 ≤ Real.log H+Δ := add_nonneg (Real.log_nonneg hH) hΔ0.le
  change 2*|c| *Δ^3*H^(1/Δ)*(Real.log H+Δ) ≤
      (2*|c| *d^3*(e/η+d))*x^η*(1+(L^k*T)^((1:ℝ)/(thr:ℝ)))
  calc
    2*|c| *Δ^3*H^(1/Δ)*(Real.log H+Δ) ≤
        2*|c| *d^3*(1+(L^k*T)^((1:ℝ)/(thr:ℝ)))*
          ((e/η+d)*x^η) := by
      apply mul_le_mul _ hprice hlog0
        (by positivity : 0 ≤ 2*|c| *d^3*(1+(L^k*T)^((1:ℝ)/(thr:ℝ))))
      exact mul_le_mul
        (mul_le_mul_of_nonneg_left hdPow (by positivity))
        hpower (Real.rpow_nonneg hH0.le _) (by positivity)
    _ = _ := by ring

end A8HighFPriceInternal

