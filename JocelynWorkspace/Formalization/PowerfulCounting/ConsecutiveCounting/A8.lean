noncomputable section
namespace A5NongeometricDehomCore
open MvPolynomial

section FactorHom
variable {σ : Type*} {R : Type*} [CommRing R] [IsDomain R]

noncomputable def tsub (w : σ → ℕ) : MvPolynomial σ R →ₐ[R] Polynomial (MvPolynomial σ R) :=
  MvPolynomial.aeval (fun i => Polynomial.C (X i) * Polynomial.X ^ (w i))

omit [IsDomain R] in
lemma tsub_monomial (w : σ → ℕ) (m : σ →₀ ℕ) (c : R) :
    tsub w (monomial m c) =
      Polynomial.C (monomial m c) * Polynomial.X ^ (Finsupp.weight w m) := by
  classical
  rw [tsub, MvPolynomial.aeval_monomial, MvPolynomial.monomial_eq, Finsupp.weight_apply]
  simp only [Finsupp.prod, Finsupp.sum]
  have h1 : ∀ i ∈ m.support,
      (Polynomial.C (X i : MvPolynomial σ R) * Polynomial.X ^ (w i)) ^ (m i) =
        Polynomial.C ((X i : MvPolynomial σ R) ^ (m i)) * Polynomial.X ^ (m i • w i) := by
    intro i _
    rw [mul_pow, ← map_pow, ← pow_mul, smul_eq_mul, mul_comm (w i)]
  rw [Finset.prod_congr rfl h1, Finset.prod_mul_distrib, ← map_prod,
    Finset.prod_pow_eq_pow_sum, Polynomial.algebraMap_apply, MvPolynomial.algebraMap_eq, map_mul]
  ring

omit [IsDomain R] in
lemma coeff_tsub (w : σ → ℕ) (P : MvPolynomial σ R) (k : ℕ) :
    (tsub w P).coeff k = weightedHomogeneousComponent w k P := by
  classical
  conv_lhs => rw [P.as_sum]
  rw [map_sum, Polynomial.finsetSum_coeff]
  simp only [tsub_monomial, Polynomial.coeff_C_mul_X_pow]
  rw [weightedHomogeneousComponent_apply, Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro m _
  by_cases h : Finsupp.weight w m = k
  · rw [if_pos h.symm, if_pos h]
  · rw [if_neg (Ne.symm h), if_neg h]

omit [IsDomain R] in
lemma tsub_of_isWeightedHomogeneous {w : σ → ℕ} {P : MvPolynomial σ R} {n : ℕ}
    (hP : IsWeightedHomogeneous w P n) : tsub w P = Polynomial.C P * Polynomial.X ^ n := by
  ext k : 1
  rw [coeff_tsub, Polynomial.coeff_C_mul_X_pow]
  by_cases hk : k = n
  · rw [if_pos hk]
    ext d
    rw [coeff_weightedHomogeneousComponent]
    by_cases hd : Finsupp.weight w d = k
    · rw [if_pos hd]
    · rw [if_neg hd]
      by_contra hne
      exact hd ((hP (Ne.symm hne)).trans hk.symm)
  · rw [if_neg hk]
    ext d
    rw [coeff_weightedHomogeneousComponent, coeff_zero]
    by_cases hd : Finsupp.weight w d = k
    · rw [if_pos hd]
      by_contra hne
      exact hk (hd.symm.trans (hP hne))
    · rw [if_neg hd]

lemma coeff_eq_zero_of_mul_eq_monomial {A : Type*} [CommRing A] [IsDomain A]
    {p q : Polynomial A} {c : A} {n : ℕ} (hc : c ≠ 0)
    (h : p * q = Polynomial.C c * Polynomial.X ^ n) :
    ∀ k, k ≠ p.natDegree → p.coeff k = 0 := by
  have hpq : p * q ≠ 0 := by
    rw [h]; exact mul_ne_zero (Polynomial.C_ne_zero.mpr hc) (pow_ne_zero _ Polynomial.X_ne_zero)
  have hp : p ≠ 0 := left_ne_zero_of_mul hpq
  have hq : q ≠ 0 := right_ne_zero_of_mul hpq
  have h1 : p.natDegree + q.natDegree = n := by
    rw [← Polynomial.natDegree_mul hp hq, h, Polynomial.natDegree_C_mul_X_pow _ _ hc]
  have h2 : p.natTrailingDegree + q.natTrailingDegree = n := by
    rw [← Polynomial.natTrailingDegree_mul hp hq, h, Polynomial.C_mul_X_pow_eq_monomial,
      Polynomial.natTrailingDegree_monomial hc]
  have h3 : p.natTrailingDegree ≤ p.natDegree := Polynomial.natTrailingDegree_le_natDegree p
  have h4 : q.natTrailingDegree ≤ q.natDegree := Polynomial.natTrailingDegree_le_natDegree q
  intro k hk
  rcases lt_or_gt_of_ne hk with hlt | hgt
  · exact Polynomial.coeff_eq_zero_of_lt_natTrailingDegree (by omega)
  · exact Polynomial.coeff_eq_zero_of_natDegree_lt hgt

theorem isWeightedHomogeneous_of_mul {w : σ → ℕ} {F G : MvPolynomial σ R} {n : ℕ}
    (hFG : IsWeightedHomogeneous w (F * G) n) (hFG0 : F * G ≠ 0) :
    IsWeightedHomogeneous w F (tsub w F).natDegree := by
  have h := tsub_of_isWeightedHomogeneous hFG
  rw [map_mul] at h
  have hz := coeff_eq_zero_of_mul_eq_monomial hFG0 h
  intro d hd
  by_contra hne
  have h0 : (tsub w F).coeff (Finsupp.weight w d) = 0 := hz _ hne
  rw [coeff_tsub] at h0
  have h1 := congrArg (MvPolynomial.coeff d) h0
  rw [coeff_weightedHomogeneousComponent, if_pos rfl, coeff_zero] at h1
  exact hd h1

theorem wh_split {w : σ → ℕ} {G T : MvPolynomial σ R} {n : ℕ}
    (h : IsWeightedHomogeneous w (G * T) n) (h0 : G * T ≠ 0) :
    ∃ d e, d + e = n ∧ IsWeightedHomogeneous w G d ∧ IsWeightedHomogeneous w T e := by
  have g := isWeightedHomogeneous_of_mul h h0
  have t := isWeightedHomogeneous_of_mul (show IsWeightedHomogeneous w (T * G) n by
    rw [mul_comm]; exact h) (by rw [mul_comm]; exact h0)
  exact ⟨_, _, IsWeightedHomogeneous.inj_right h0 (g.mul t) h, g, t⟩

end FactorHom

def w1 : Fin 4 → ℕ := ![1, 1, 0, 0]
def w2 : Fin 4 → ℕ := ![0, 0, 1, 1]

lemma weight_w1 (m : Fin 4 →₀ ℕ) : Finsupp.weight w1 m = m 0 + m 1 := by
  rw [Finsupp.weight_apply, Finsupp.sum_fintype _ _ (by simp)]
  simp [w1, Fin.sum_univ_four]

lemma weight_w2 (m : Fin 4 →₀ ℕ) : Finsupp.weight w2 m = m 2 + m 3 := by
  rw [Finsupp.weight_apply, Finsupp.sum_fintype _ _ (by simp)]
  simp [w2, Fin.sum_univ_four]

def Bihom {R : Type*} [CommSemiring R] (F : MvPolynomial (Fin 4) R) (a b : ℕ) : Prop :=
  ∀ m ∈ F.support, m 0 + m 1 = a ∧ m 2 + m 3 = b

lemma bihom_iff {R : Type*} [CommSemiring R] (F : MvPolynomial (Fin 4) R) (a b : ℕ) :
    Bihom F a b ↔ (IsWeightedHomogeneous w1 F a ∧ IsWeightedHomogeneous w2 F b) := by
  constructor
  · intro h
    refine ⟨fun m hm => ?_, fun m hm => ?_⟩
    · rw [weight_w1]; exact (h m (MvPolynomial.mem_support_iff.mpr hm)).1
    · rw [weight_w2]; exact (h m (MvPolynomial.mem_support_iff.mpr hm)).2
  · rintro ⟨h1, h2⟩ m hm
    have hm' := MvPolynomial.mem_support_iff.mp hm
    exact ⟨by rw [← weight_w1]; exact h1 hm', by rw [← weight_w2]; exact h2 hm'⟩

lemma bihom_of_mul {R : Type*} [CommRing R] [IsDomain R] {P Q : MvPolynomial (Fin 4) R}
    {a b : ℕ} (h : Bihom (P * Q) a b) (h0 : P * Q ≠ 0) :
    ∃ a1 b1 a2 b2, a1 + a2 = a ∧ b1 + b2 = b ∧ Bihom P a1 b1 ∧ Bihom Q a2 b2 := by
  obtain ⟨h1, h2⟩ := (bihom_iff _ a b).mp h
  obtain ⟨a1, a2, ha, hP1, hQ1⟩ := wh_split h1 h0
  obtain ⟨b1, b2, hb, hP2, hQ2⟩ := wh_split h2 h0
  exact ⟨a1, b1, a2, b2, ha, hb, (bihom_iff P a1 b1).mpr ⟨hP1, hP2⟩,
    (bihom_iff Q a2 b2).mpr ⟨hQ1, hQ2⟩⟩

lemma bihom_of_dvd {F G : MvPolynomial (Fin 4) ℤ} {a b : ℕ} (hF0 : F ≠ 0)
    (hF : Bihom F a b) (hG : G ∣ F) :
    ∃ a' b', a' ≤ a ∧ b' ≤ b ∧ Bihom G a' b' := by
  obtain ⟨T, rfl⟩ := hG
  obtain ⟨a1, b1, a2, b2, ha, hb, hG', -⟩ := bihom_of_mul hF hF0
  exact ⟨a1, b1, by omega, by omega, hG'⟩

lemma isHomogeneous_of_bihom {R : Type*} [CommSemiring R] {F : MvPolynomial (Fin 4) R}
    {a b : ℕ} (hF : Bihom F a b) : F.IsHomogeneous (a + b) := by
  intro m hm
  have := hF m (MvPolynomial.mem_support_iff.mpr hm)
  rw [Finsupp.weight_apply, Finsupp.sum_fintype _ _ (by simp)]
  simp [Fin.sum_univ_four]
  omega

section Gauss
variable {σ : Type*}

lemma exists_int_multiple (P : MvPolynomial σ ℚ) :
    ∃ N : ℤ, N ≠ 0 ∧ ∃ P1 : MvPolynomial σ ℤ, map (Int.castRingHom ℚ) P1 = C (N : ℚ) * P := by
  refine MvPolynomial.induction_on' P ?_ ?_
  · intro u a
    refine ⟨a.den, by exact_mod_cast a.den_nz, monomial u a.num, ?_⟩
    rw [map_monomial, C_mul_monomial]
    congr 1
    rw [eq_intCast, Int.cast_natCast, mul_comm]
    exact (Rat.mul_den_eq_num a).symm
  · intro p q hp hq
    obtain ⟨N1, hN1, P1, h1⟩ := hp
    obtain ⟨N2, hN2, P2, h2⟩ := hq
    refine ⟨N1 * N2, mul_ne_zero hN1 hN2, C N2 * P1 + C N1 * P2, ?_⟩
    rw [map_add, map_mul, map_mul, map_C, map_C, h1, h2, eq_intCast, eq_intCast, Int.cast_mul,
      C_mul]
    ring

lemma descent : ∀ (n : ℕ) (c : ℤ), c.natAbs = n → c ≠ 0 → ∀ (G A B : MvPolynomial σ ℤ),
    C c * G = A * B → ∃ A' B' : MvPolynomial σ ℤ, G = A' * B' ∧
      (∃ c1 : ℤ, c1 ≠ 0 ∧ A = C c1 * A') ∧ (∃ c2 : ℤ, c2 ≠ 0 ∧ B = C c2 * B') := by
  intro n
  refine Nat.strong_induction_on n ?_
  intro n ih c hcn hc G A B h
  by_cases h1 : c.natAbs = 1
  · rcases Int.natAbs_eq_iff.mp h1 with h1 | h1
    · have hc1 : c = 1 := by simpa using h1
      subst hc1
      refine ⟨A, B, ?_, ⟨1, one_ne_zero, by simp⟩, ⟨1, one_ne_zero, by simp⟩⟩
      simpa using h
    · have hc1 : c = -1 := by simpa using h1
      subst hc1
      refine ⟨-A, B, ?_, ⟨-1, by norm_num, by simp⟩, ⟨1, one_ne_zero, by simp⟩⟩
      have : -G = A * B := by simpa using h
      rw [neg_mul, ← this, neg_neg]
  · obtain ⟨p, hp, hpc⟩ := Nat.exists_prime_and_dvd h1
    haveI := Fact.mk hp
    have hpz : (p : ℤ) ∣ c := Int.natCast_dvd.mpr hpc
    obtain ⟨c', hc'⟩ := hpz
    have hc'0 : c' ≠ 0 := by
      intro h0; apply hc; rw [hc', h0, mul_zero]
    have hlt : c'.natAbs < n := by
      have e : c.natAbs = p * c'.natAbs := by rw [hc', Int.natAbs_mul]; simp
      have := hp.two_le
      have : 0 < c'.natAbs := Int.natAbs_pos.mpr hc'0
      rw [← hcn, e]; nlinarith
    have hmap : map (Int.castRingHom (ZMod p)) A * map (Int.castRingHom (ZMod p)) B = 0 := by
      rw [← map_mul, ← h, map_mul, map_C, hc']
      simp
    have hCp : (C (p : ℤ) : MvPolynomial σ ℤ) ≠ 0 := by
      rw [Ne, C_eq_zero]; exact_mod_cast hp.ne_zero
    have dvd_of_map : ∀ Z : MvPolynomial σ ℤ, map (Int.castRingHom (ZMod p)) Z = 0 →
        C (p : ℤ) ∣ Z := by
      intro Z hZ
      rw [C_dvd_iff_dvd_coeff]
      intro i
      have := congrArg (coeff i) hZ
      rw [coeff_map, coeff_zero, eq_intCast, ZMod.intCast_zmod_eq_zero_iff_dvd] at this
      exact this
    rcases mul_eq_zero.mp hmap with hA | hB
    · obtain ⟨A2, hA2⟩ := dvd_of_map A hA
      have h' : C c' * G = A2 * B := by
        apply mul_left_cancel₀ hCp
        rw [← mul_assoc, ← C_mul, ← hc', h, hA2, mul_assoc]
      obtain ⟨A', B', hG, ⟨c1, hc1, hA'⟩, hB'⟩ := ih _ hlt c' rfl hc'0 G A2 B h'
      refine ⟨A', B', hG, ⟨p * c1, mul_ne_zero (by exact_mod_cast hp.ne_zero) hc1, ?_⟩, hB'⟩
      rw [hA2, hA', ← mul_assoc, ← C_mul]
    · obtain ⟨B2, hB2⟩ := dvd_of_map B hB
      have h' : C c' * G = A * B2 := by
        apply mul_left_cancel₀ hCp
        rw [← mul_assoc, ← C_mul, ← hc', h, hB2]; ring
      obtain ⟨A', B', hG, hA', ⟨c2, hc2, hB'⟩⟩ := ih _ hlt c' rfl hc'0 G A B2 h'
      refine ⟨A', B', hG, hA', ⟨p * c2, mul_ne_zero (by exact_mod_cast hp.ne_zero) hc2, ?_⟩⟩
      rw [hB2, hB', ← mul_assoc, ← C_mul]

lemma eq_C_of_map_eq_C {K : Type*} [Field K] [CharZero K] {G : MvPolynomial σ ℤ} {r : K}
    (h : map (Int.castRingHom K) G = C r) : G = C (G.coeff 0) := by
  classical
  ext m
  rw [coeff_C]
  split_ifs with hm
  · subst hm; rfl
  · have := congrArg (coeff m) h
    rw [coeff_map, coeff_C, if_neg hm] at this
    simpa using this

theorem irreducible_map_rat {G : MvPolynomial σ ℤ} (hG : Irreducible G)
    (hnc : ∀ c : ℤ, G ≠ C c) : Irreducible (map (Int.castRingHom ℚ) G) := by
  have hinj : Function.Injective (map (σ := σ) (Int.castRingHom ℚ)) :=
    map_injective _ (RingHom.injective_int _)
  have hG0 : map (Int.castRingHom ℚ) G ≠ 0 := by
    intro h; apply hG.ne_zero; apply hinj; rw [h, map_zero]
  refine irreducible_iff.mpr ⟨?_, ?_⟩
  · intro hu
    obtain ⟨r, -, hr⟩ := isUnit_iff_eq_C_of_isReduced.mp hu
    exact hnc _ (eq_C_of_map_eq_C hr)
  · intro P Q hPQ
    obtain ⟨N1, hN1, P1, hP1⟩ := exists_int_multiple P
    obtain ⟨N2, hN2, Q1, hQ1⟩ := exists_int_multiple Q
    have hP1Q1 : P1 * Q1 = C (N1 * N2) * G := by
      apply hinj
      rw [map_mul, map_mul, hP1, hQ1, map_C, hPQ, eq_intCast, Int.cast_mul, C_mul]; ring
    obtain ⟨A', B', hAB, ⟨c1, hc1, hA'⟩, ⟨c2, hc2, hB'⟩⟩ :=
      descent _ (N1 * N2) rfl (mul_ne_zero hN1 hN2) G P1 Q1 hP1Q1.symm
    rcases hG.isUnit_or_isUnit hAB with hu | hu
    · left
      obtain ⟨u, hu', hu⟩ := isUnit_iff_eq_C_of_isReduced.mp hu
      have hk : C ((N1 : ℚ)) * P = C (((c1 * u : ℤ)) : ℚ) := by
        rw [← hP1, hA', hu, ← C_mul, map_C, eq_intCast]
      have hk0 : ((c1 * u : ℤ) : ℚ) ≠ 0 := by
        have : c1 * u ≠ 0 := mul_ne_zero hc1 hu'.ne_zero
        exact_mod_cast this
      have : IsUnit (C (N1 : ℚ) * P) := by
        rw [hk]; exact (isUnit_iff_ne_zero.mpr hk0).map C
      exact isUnit_of_mul_isUnit_right this
    · right
      obtain ⟨u, hu', hu⟩ := isUnit_iff_eq_C_of_isReduced.mp hu
      have hk : C ((N2 : ℚ)) * Q = C (((c2 * u : ℤ)) : ℚ) := by
        rw [← hQ1, hB', hu, ← C_mul, map_C, eq_intCast]
      have hk0 : ((c2 * u : ℤ) : ℚ) ≠ 0 := by
        have : c2 * u ≠ 0 := mul_ne_zero hc2 hu'.ne_zero
        exact_mod_cast this
      have : IsUnit (C (N2 : ℚ) * Q) := by
        rw [hk]; exact (isUnit_iff_ne_zero.mpr hk0).map C
      exact isUnit_of_mul_isUnit_right this

end Gauss

end A5NongeometricDehomCore

namespace A5NongeometricDehom
open MvPolynomial
variable {K : Type*} [Field K]

def proj (m : Fin 4 →₀ ℕ) : Fin 2 →₀ ℕ :=
  Finsupp.single 0 (m 0) + Finsupp.single 1 (m 3)

def lift (a b : ℕ) (m : Fin 2 →₀ ℕ) : Fin 4 →₀ ℕ :=
  Finsupp.single 0 (m 0) + Finsupp.single 1 (a - m 0) +
    Finsupp.single 2 (b - m 1) + Finsupp.single 3 (m 1)

def dehom : MvPolynomial (Fin 4) K →ₐ[K] MvPolynomial (Fin 2) K :=
  MvPolynomial.aeval ![X 0, 1, 1, X 1]

def hom (a b : ℕ) : MvPolynomial (Fin 2) K →+ MvPolynomial (Fin 4) K :=
  { toFun := AddMonoidAlgebra.mapDomain (lift a b)
    map_zero' := AddMonoidAlgebra.mapDomain_zero _
    map_add' := AddMonoidAlgebra.mapDomain_add _ }

theorem hom_monomial (a b : ℕ) (m : Fin 2 →₀ ℕ) (c : K) :
    hom a b (monomial m c) = monomial (lift a b m) c := by
  exact AddMonoidAlgebra.mapDomain_single

theorem dehom_monomial (m : Fin 4 →₀ ℕ) (c : K) :
    dehom (monomial m c) = monomial (proj m) c := by
  rw [dehom, MvPolynomial.aeval_monomial, MvPolynomial.monomial_eq]
  rw [Finsupp.prod_fintype _ _ (by intro i; simp),
    Finsupp.prod_fintype _ _ (by intro i; simp)]
  simp [proj, Fin.prod_univ_four, Fin.prod_univ_two, MvPolynomial.algebraMap_eq]

theorem dehom_eq_mapDomain (F : MvPolynomial (Fin 4) K) :
    dehom F = AddMonoidAlgebra.mapDomain proj F := by
  induction F using MvPolynomial.induction_on' with
  | monomial m c =>
    have hh : AddMonoidAlgebra.mapDomain proj (monomial m c : MvPolynomial (Fin 4) K) =
        monomial (proj m) c := AddMonoidAlgebra.mapDomain_single
    exact (dehom_monomial m c).trans hh.symm
  | add F G hF hG => simp only [map_add, AddMonoidAlgebra.mapDomain_add, hF, hG]

theorem hom_dehom (F : MvPolynomial (Fin 4) K) (a b : ℕ)
    (hF : A5NongeometricDehomCore.Bihom F a b) :
    hom a b (dehom F) = F := by
  change AddMonoidAlgebra.mapDomain (lift a b) (dehom F) = F
  rw [dehom_eq_mapDomain]
  have hh : Finsupp.mapDomain (lift a b) (Finsupp.mapDomain proj (AddMonoidAlgebra.coeff F)) = (AddMonoidAlgebra.coeff F) := by
    rw [← Finsupp.mapDomain_comp]
    calc
      Finsupp.mapDomain (lift a b ∘ proj) (AddMonoidAlgebra.coeff F) = Finsupp.mapDomain id (AddMonoidAlgebra.coeff F) := by
        apply Finsupp.mapDomain_congr
        intro m hm
        obtain ⟨h1,h2⟩ := hF m hm
        ext i
        fin_cases i <;> simp [Function.comp_apply, lift, proj] <;> omega
      _ = (AddMonoidAlgebra.coeff F) := Finsupp.mapDomain_id
  ext m
  exact congrArg (fun v : (Fin 4 →₀ ℕ) →₀ K => v m) hh

theorem dehom_hom (f : MvPolynomial (Fin 2) K) (a b : ℕ) :
    dehom (hom a b f) = f := by
  rw [dehom_eq_mapDomain]
  have heq : proj ∘ lift a b = id := by
    funext m
    ext i
    fin_cases i <;> simp [Function.comp_apply, proj, lift]
  have hh : Finsupp.mapDomain proj (Finsupp.mapDomain (lift a b) (AddMonoidAlgebra.coeff f)) = (AddMonoidAlgebra.coeff f) := by
    rw [← Finsupp.mapDomain_comp, heq, Finsupp.mapDomain_id]
  ext m
  exact congrArg (fun v : (Fin 2 →₀ ℕ) →₀ K => v m) hh

theorem hom_mul (f g : MvPolynomial (Fin 2) K) (a b c d : ℕ)
    (hf : ∀ m ∈ f.support, m 0 ≤ a ∧ m 1 ≤ b)
    (hg : ∀ m ∈ g.support, m 0 ≤ c ∧ m 1 ≤ d) :
    hom a b f * hom c d g = hom (a+c) (b+d) (f*g) := by
  classical
  rw [f.as_sum, g.as_sum]
  simp only [map_sum, Finset.sum_mul, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro m hm
  apply Finset.sum_congr rfl
  intro n hn
  rw [hom_monomial, hom_monomial, MvPolynomial.monomial_mul,
    MvPolynomial.monomial_mul, hom_monomial]
  obtain ⟨h0,h1⟩ := hf n hn
  obtain ⟨h2,h3⟩ := hg m hm
  apply congrArg (fun k : Fin 4 →₀ ℕ => monomial k ((AddMonoidAlgebra.coeff f) n * g.coeff m))
  ext i
  fin_cases i <;> simp [lift] <;> omega

theorem dehom_ne_zero (F : MvPolynomial (Fin 4) K) (a b : ℕ)
    (hF : A5NongeometricDehomCore.Bihom F a b) (hF0 : F ≠ 0) :
    dehom F ≠ 0 := by
  intro hz
  have hh := congrArg (hom a b) hz
  rw [hom_dehom F a b hF, map_zero] at hh
  exact hF0 hh

theorem hom_C (a b : ℕ) (c : K) :
    hom a b (C c) = C c * X 1 ^ a * X 2 ^ b := by
  change hom a b (monomial 0 c) = _
  rw [hom_monomial, MvPolynomial.monomial_eq]
  rw [Finsupp.prod_fintype _ _ (by intro i; simp)]
  simp [lift, Fin.prod_univ_four, mul_assoc]

theorem shape_of_isUnit_dehom (F : MvPolynomial (Fin 4) K) (a b : ℕ)
    (hF : A5NongeometricDehomCore.Bihom F a b) (hu : IsUnit (dehom F)) :
    ∃ c : K, IsUnit c ∧ F = C c * X 1 ^ a * X 2 ^ b := by
  obtain ⟨c,hc,heq⟩ := MvPolynomial.isUnit_iff_eq_C_of_isReduced.mp hu
  have hh := hom_dehom F a b hF
  rw [heq, hom_C] at hh
  exact ⟨c,hc,hh.symm⟩

theorem isUnit_or_chart_dvd (F : MvPolynomial (Fin 4) K) (a b : ℕ)
    (hF : A5NongeometricDehomCore.Bihom F a b) (hu : IsUnit (dehom F)) :
    IsUnit F ∨ X 1 ∣ F ∨ X 2 ∣ F := by
  obtain ⟨c,hc,heq⟩ := shape_of_isUnit_dehom F a b hF hu
  cases a with
  | zero =>
    cases b with
    | zero =>
      left
      simpa [heq] using hc.map (MvPolynomial.C : K →+* MvPolynomial (Fin 4) K)
    | succ b =>
      right; right
      refine ⟨C c * X 2 ^ b, ?_⟩
      rw [heq, pow_succ]
      simp only [pow_zero, mul_one]
      ring
  | succ a =>
    right; left
    refine ⟨C c * X 1 ^ a * X 2 ^ b, ?_⟩
    rw [heq, pow_succ]
    ring

theorem hom_dehom_shift (F : MvPolynomial (Fin 4) K) (a b A B : ℕ)
    (hF : A5NongeometricDehomCore.Bihom F a b) (ha : a ≤ A) (hb : b ≤ B) :
    hom A B (dehom F) = X 1 ^ (A-a) * X 2 ^ (B-b) * F := by
  classical
  conv_lhs => rw [F.as_sum]
  rw [map_sum, map_sum]
  conv_rhs => rw [F.as_sum]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro m hm
  rw [dehom_monomial, hom_monomial]
  have hx := hF m hm
  have h1 : A - m 0 = (A-a) + m 1 := by omega
  have h2 : B - m 3 = (B-b) + m 2 := by omega
  simp only [MvPolynomial.monomial_eq]
  rw [Finsupp.prod_fintype _ _ (by intro i; simp),
    Finsupp.prod_fintype _ _ (by intro i; simp)]
  simp only [Fin.prod_univ_four, proj, lift, Finsupp.add_apply, Finsupp.single_apply,
    Fin.reduceEq, ite_true, ite_false, zero_add, add_zero]
  rw [h1, h2, pow_add, pow_add]
  ring

theorem irreducible_X (i : Fin 4) : Irreducible (X i : MvPolynomial (Fin 4) K) := by
  apply MvPolynomial.irreducible_of_totalDegree_eq_one (MvPolynomial.totalDegree_X i)
  intro c hc
  apply isUnit_of_dvd_one
  simpa [MvPolynomial.coeff_X] using hc (Finsupp.single i 1)

theorem associated_of_irreducibles_dvd {p q : MvPolynomial (Fin 4) K}
    (hp : Irreducible p) (hq : Irreducible q) (h : p ∣ q) : Associated p q := by
  obtain ⟨r,hr⟩ := h
  have hu : IsUnit r := (hq.isUnit_or_isUnit hr).resolve_left hp.not_isUnit
  obtain ⟨u,hu⟩ := hu
  refine ⟨u, ?_⟩
  rw [hu, ← hr]

theorem X_dvd_of_coeff_zero (F : MvPolynomial (Fin 4) K) (i : Fin 4)
    (h : ∀ m, m i = 0 → MvPolynomial.coeff m F = 0) : X i ∣ F := by
  classical
  conv_rhs => rw [F.as_sum]
  apply Finset.dvd_sum
  intro m hm
  apply MvPolynomial.X_dvd_monomial.mpr
  right
  intro hz
  exact (MvPolynomial.mem_support_iff.mp hm) (h m hz)

theorem X_dvd_of_map_X_dvd {L : Type*} [Field L] (φ : K →+* L)
    (F : MvPolynomial (Fin 4) K) (i : Fin 4)
    (h : (X i : MvPolynomial (Fin 4) L) ∣ MvPolynomial.map φ F) : X i ∣ F := by
  classical
  apply X_dvd_of_coeff_zero F i
  intro m hm
  obtain ⟨q,hq⟩ := h
  have hc := congrArg (MvPolynomial.coeff m) hq
  rw [MvPolynomial.coeff_map, mul_comm (X i) q, MvPolynomial.coeff_mul_X'] at hc
  have hn : i ∉ m.support := by simpa [Finsupp.mem_support_iff] using hm
  rw [if_neg hn] at hc
  apply φ.injective
  simpa only [map_zero] using hc

theorem not_X_dvd_of_not_irreducible_map {L : Type*} [Field L] (φ : K →+* L)
    (F : MvPolynomial (Fin 4) K) (hF : Irreducible F)
    (hred : ¬ Irreducible (MvPolynomial.map φ F)) (i : Fin 4) : ¬ X i ∣ F := by
  intro hdvd
  have hassoc := associated_of_irreducibles_dvd (irreducible_X i) hF hdvd
  have hassocL : Associated (X i : MvPolynomial (Fin 4) L) (MvPolynomial.map φ F) := by
    simpa only [MvPolynomial.map_X] using hassoc.map (MvPolynomial.map φ)
  exact hred ((hassocL.irreducible_iff).mp (irreducible_X i))

theorem unit_of_product_dvd_left {p f g : MvPolynomial (Fin 2) K}
    (hp : p ≠ 0) (hprod : p = f*g) (hdvd : p ∣ f) : IsUnit g := by
  obtain ⟨r,hr⟩ := hdvd
  have hf : f ≠ 0 := by
    intro hz
    apply hp
    rw [hprod,hz,zero_mul]
  have hh : f * (g*r) = f * 1 := by
    calc
      f * (g*r) = (f*g)*r := (mul_assoc _ _ _).symm
      _ = p*r := by rw [← hprod]
      _ = f := hr.symm
      _ = f*1 := (mul_one f).symm
  have hgr : g*r = 1 := mul_left_cancel₀ hf hh
  have hu : IsUnit (g*r) := by rw [hgr]; exact isUnit_one
  exact isUnit_of_mul_isUnit_left hu

theorem bounds_totalDegree (f : MvPolynomial (Fin 2) K) :
    ∀ m ∈ f.support, m 0 ≤ f.totalDegree ∧ m 1 ≤ f.totalDegree := by
  intro m hm
  have hh := MvPolynomial.le_totalDegree hm
  rw [Finsupp.sum_fintype _ _ (by intro i; rfl), Fin.sum_univ_two] at hh
  omega

theorem irreducible_dehom (F : MvPolynomial (Fin 4) K) (a b : ℕ)
    (hF : A5NongeometricDehomCore.Bihom F a b) (hirr : Irreducible F)
    (h1 : ¬ X 1 ∣ F) (h2 : ¬ X 2 ∣ F) : Irreducible (dehom F) := by
  have hF0 := dehom_ne_zero F a b hF hirr.ne_zero
  refine irreducible_iff.mpr ⟨?_, ?_⟩
  · intro hu
    rcases isUnit_or_chart_dvd F a b hF hu with h | h | h
    · exact hirr.not_isUnit h
    · exact h1 h
    · exact h2 h
  · intro f g hfg
    let N := f.totalDegree + a + b
    let M := g.totalDegree + a + b
    have hf : ∀ m ∈ f.support, m 0 ≤ N ∧ m 1 ≤ N := by
      intro m hm
      have hh := bounds_totalDegree f m hm
      dsimp [N]
      omega
    have hg : ∀ m ∈ g.support, m 0 ≤ M ∧ m 1 ≤ M := by
      intro m hm
      have hh := bounds_totalDegree g m hm
      dsimp [M]
      omega
    have hh := hom_mul f g N N M M hf hg
    rw [← hfg, hom_dehom_shift F a b (N+M) (N+M) hF
      (by dsimp [N,M]; omega) (by dsimp [N,M]; omega)] at hh
    have hdvd : F ∣ hom N N f * hom M M g := by
      refine ⟨X 1 ^ (N+M-a) * X 2 ^ (N+M-b), ?_⟩
      rw [hh]
      ring
    rcases (irreducible_iff_prime.mp hirr).dvd_or_dvd hdvd with hd | hd
    · right
      apply unit_of_product_dvd_left hF0 hfg
      obtain ⟨r,hr⟩ := hd
      have hz := congrArg (dehom (K := K)) hr
      rw [dehom_hom, map_mul] at hz
      exact ⟨dehom r, hz⟩
    · left
      apply unit_of_product_dvd_left hF0 (hfg.trans (mul_comm f g))
      obtain ⟨r,hr⟩ := hd
      have hz := congrArg (dehom (K := K)) hr
      rw [dehom_hom, map_mul] at hz
      exact ⟨dehom r, hz⟩

theorem bihom_map {L : Type*} [Field L] (φ : K →+* L)
    (F : MvPolynomial (Fin 4) K) (a b : ℕ)
    (hF : A5NongeometricDehomCore.Bihom F a b) :
    A5NongeometricDehomCore.Bihom (MvPolynomial.map φ F) a b := by
  intro m hm
  apply hF m
  apply MvPolynomial.mem_support_iff.mpr
  intro hz
  have hh := MvPolynomial.mem_support_iff.mp hm
  apply hh
  rw [MvPolynomial.coeff_map,hz,map_zero]

theorem map_dehom {L : Type*} [Field L] (φ : K →+* L)
    (F : MvPolynomial (Fin 4) K) :
    MvPolynomial.map φ (dehom F) = dehom (MvPolynomial.map φ F) := by
  induction F using MvPolynomial.induction_on' with
  | monomial m c => simp only [dehom_monomial, MvPolynomial.map_monomial]
  | add F G hF hG => simp only [map_add,hF,hG]

theorem isUnit_of_map_isUnit {L : Type*} [Field L] (φ : K →+* L)
    (F : MvPolynomial (Fin 4) K) (hu : IsUnit (MvPolynomial.map φ F)) : IsUnit F := by
  classical
  obtain ⟨c,hc,he⟩ := MvPolynomial.isUnit_iff_eq_C_of_isReduced.mp hu
  have hF : F = MvPolynomial.C (F.coeff 0) := by
    ext m
    rw [MvPolynomial.coeff_C]
    split_ifs with hm
    · subst hm
      rfl
    · have hcoeff := congrArg (MvPolynomial.coeff m) he
      rw [MvPolynomial.coeff_map,MvPolynomial.coeff_C,if_neg hm] at hcoeff
      exact φ.injective (by simpa using hcoeff)
  have h0 : F.coeff 0 ≠ 0 := by
    intro hz
    have hF0 : F = 0 := by rw [hF,hz,MvPolynomial.C_0]
    apply hu.ne_zero
    simp [hF0]
  rw [hF]
  exact (isUnit_iff_ne_zero.mpr h0).map MvPolynomial.C

theorem not_irreducible_map_dehom {L : Type*} [Field L] (φ : K →+* L)
    (F : MvPolynomial (Fin 4) K) (a b : ℕ)
    (hF : A5NongeometricDehomCore.Bihom F a b) (hirr : Irreducible F)
    (hred : ¬ Irreducible (MvPolynomial.map φ F)) :
    ¬ Irreducible (MvPolynomial.map φ (dehom F)) := by
  intro hd
  rw [map_dehom] at hd
  have hF0 : MvPolynomial.map φ F ≠ 0 := by
    intro hz
    apply hirr.ne_zero
    apply MvPolynomial.map_injective _ φ.injective
    simpa only [map_zero] using hz
  have hnu : ¬ IsUnit (MvPolynomial.map φ F) := fun h =>
    hirr.not_isUnit (isUnit_of_map_isUnit φ F h)
  have hnc : ∀ i : Fin 4, ¬ (X i : MvPolynomial (Fin 4) L) ∣ MvPolynomial.map φ F := by
    intro i hi
    exact not_X_dvd_of_not_irreducible_map φ F hirr hred i
      (X_dvd_of_map_X_dvd φ F i hi)
  apply hred
  refine irreducible_iff.mpr ⟨hnu, ?_⟩
  intro A B hAB
  have hbhom := bihom_map φ F a b hF
  rw [hAB] at hbhom
  obtain ⟨a1,b1,a2,b2,ha,hb,hA,hB⟩ :=
    A5NongeometricDehomCore.bihom_of_mul hbhom (by rwa [← hAB])
  have hh := congrArg (dehom (K := L)) hAB
  rw [map_mul] at hh
  rcases hd.isUnit_or_isUnit hh with hu | hu
  · rcases isUnit_or_chart_dvd A a1 b1 hA hu with h | h | h
    · exact Or.inl h
    · exact False.elim (hnc 1 (dvd_trans h ⟨B,hAB⟩))
    · exact False.elim (hnc 2 (dvd_trans h ⟨B,hAB⟩))
  · have hBdvd : B ∣ MvPolynomial.map φ F := ⟨A,hAB.trans (mul_comm A B)⟩
    rcases isUnit_or_chart_dvd B a2 b2 hB hu with h | h | h
    · exact Or.inr h
    · exact False.elim (hnc 1 (dvd_trans h hBdvd))
    · exact False.elim (hnc 2 (dvd_trans h hBdvd))

theorem totalDegree_dehom (F : MvPolynomial (Fin 4) K) (a b : ℕ)
    (hF : A5NongeometricDehomCore.Bihom F a b) :
    (dehom F).totalDegree ≤ a+b := by
  classical
  have hs : (dehom F).support ⊆ F.support.image proj := by
    rw [dehom_eq_mapDomain]
    change (Finsupp.mapDomain proj (AddMonoidAlgebra.coeff F)).support ⊆
      Finset.image proj (AddMonoidAlgebra.coeff F).support
    exact Finsupp.mapDomain_support
  unfold MvPolynomial.totalDegree
  apply Finset.sup_le
  intro n hn
  obtain ⟨m,hm,heq⟩ := Finset.mem_image.mp (hs hn)
  rw [← heq, Finsupp.sum_fintype _ _ (by intro i; rfl), Fin.sum_univ_two]
  obtain ⟨h1,h2⟩ := hF m hm
  simp only [proj,Finsupp.add_apply,Finsupp.single_apply,Fin.reduceEq,ite_true,ite_false,
    zero_add,add_zero]
  omega

end A5NongeometricDehom

namespace A5NongeometricDehomogenizationType
noncomputable def dehom (G : MvPolynomial (Fin 4) ℤ) : MvPolynomial (Fin 2) ℚ :=
  MvPolynomial.eval₂Hom
    (MvPolynomial.C.comp (Int.castRingHom ℚ))
    ![MvPolynomial.X 0, 1, 1, MvPolynomial.X 1] G
end A5NongeometricDehomogenizationType

namespace A5NongeometricDehom
open MvPolynomial
theorem int_dehom_eq (G : MvPolynomial (Fin 4) ℤ) :
    A5NongeometricDehomogenizationType.dehom G =
      dehom (MvPolynomial.map (Int.castRingHom ℚ) G) := by
  induction G using MvPolynomial.induction_on' with
  | monomial m c =>
    rw [A5NongeometricDehomogenizationType.dehom,MvPolynomial.eval₂Hom_monomial,
      MvPolynomial.map_monomial,dehom_monomial,MvPolynomial.monomial_eq]
    rw [Finsupp.prod_fintype _ _ (by intro i; simp),
      Finsupp.prod_fintype _ _ (by intro i; simp)]
    simp [proj,Fin.prod_univ_four,Fin.prod_univ_two]
  | add G H hG hH =>
    change (MvPolynomial.eval₂Hom (MvPolynomial.C.comp (Int.castRingHom ℚ))
      ![X 0,1,1,X 1]) (G+H) =
      dehom (MvPolynomial.map (Int.castRingHom ℚ) (G+H))
    rw [map_add,map_add,map_add]
    exact congrArg₂ (fun x y : MvPolynomial (Fin 2) ℚ => x+y) hG hH

theorem integral_transport (a b : ℕ) (hsum : 1 ≤ a+b) (G : MvPolynomial (Fin 4) ℤ)
    (hG : ∀ m ∈ G.support, m 0+m 1=a ∧ m 2+m 3=b)
    (hirr : Irreducible G) (hred : ¬ Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G)) :
    Irreducible (A5NongeometricDehomogenizationType.dehom G) ∧
      ¬ Irreducible (MvPolynomial.map (algebraMap ℚ ℂ)
        (A5NongeometricDehomogenizationType.dehom G)) ∧
      (A5NongeometricDehomogenizationType.dehom G).totalDegree ≤ a+b := by
  let F := MvPolynomial.map (Int.castRingHom ℚ) G
  have hnc : ∀ c : ℤ, G ≠ C c := by
    intro c hc
    have hh := (A5NongeometricDehomCore.isHomogeneous_of_bihom hG).totalDegree hirr.ne_zero
    rw [hc,MvPolynomial.totalDegree_C] at hh
    omega
  have hF : Irreducible F := A5NongeometricDehomCore.irreducible_map_rat hirr hnc
  have hFbhom : A5NongeometricDehomCore.Bihom F a b := by
    intro m hm
    apply hG m
    apply MvPolynomial.mem_support_iff.mpr
    intro hz
    have hn := MvPolynomial.mem_support_iff.mp hm
    apply hn
    rw [MvPolynomial.coeff_map,hz,map_zero]
  have hmap : MvPolynomial.map (algebraMap ℚ ℂ) F =
      MvPolynomial.map (Int.castRingHom ℂ) G := by
    ext m
    simp only [F,MvPolynomial.coeff_map]
    simp
  have hFred : ¬ Irreducible (MvPolynomial.map (algebraMap ℚ ℂ) F) := by
    rwa [hmap]
  rw [int_dehom_eq]
  refine ⟨?_, ?_, totalDegree_dehom F a b hFbhom⟩
  · exact irreducible_dehom F a b hFbhom hF
      (not_X_dvd_of_not_irreducible_map (algebraMap ℚ ℂ) F hF hFred 1)
      (not_X_dvd_of_not_irreducible_map (algebraMap ℚ ℂ) F hF hFred 2)
  · exact not_irreducible_map_dehom (algebraMap ℚ ℂ) F a b hFbhom hF hFred

end A5NongeometricDehom

namespace JocelynClaims
theorem claim_64a14d26f9c969c6efadcf09a88213dd7286bc9ea0f5636ddaa00ffb1571eb99 :
∀ α β : ℕ, 1 ≤ α + β →
  ∀ G : MvPolynomial (Fin 4) ℤ,
    (∀ m ∈ G.support, m 0 + m 1 = α ∧ m 2 + m 3 = β) →
    Irreducible G →
    ¬ Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G) →
    let f : MvPolynomial (Fin 2) ℚ :=
      MvPolynomial.eval₂Hom (MvPolynomial.C.comp (Int.castRingHom ℚ))
        ![MvPolynomial.X 0, 1, 1, MvPolynomial.X 1] G
    Irreducible f ∧
      ¬ Irreducible (MvPolynomial.map (algebraMap ℚ ℂ) f) ∧
      f.totalDegree ≤ α + β := by
  intro α β hsum G hG hirr hred
  exact A5NongeometricDehom.integral_transport α β hsum G hG hirr hred
end JocelynClaims

