theorem affine_box_interval_iff
    (d0 eta L U t : ℝ) (heta : eta≠0) (hLU : L≤U) :
    L≤d0+eta*t ∧ d0+eta*t≤U ↔
      t∈Set.Icc (min ((L-d0)/eta) ((U-d0)/eta))
        (max ((L-d0)/eta) ((U-d0)/eta)) := by
  rcases lt_or_gt_of_ne heta with hn | hp
  · have horder : (U-d0)/eta≤(L-d0)/eta :=
      by
        apply (div_le_iff_of_neg hn).mpr
        rw [div_mul_cancel₀ _ heta]
        linarith
    rw [min_eq_right horder,max_eq_left horder,Set.mem_Icc]
    constructor
    · rintro ⟨hL,hU⟩
      constructor
      · apply (div_le_iff_of_neg hn).mpr
        nlinarith
      · apply (le_div_iff_of_neg hn).mpr
        nlinarith
    · rintro ⟨hU,hL⟩
      have hhU := (div_le_iff_of_neg hn).mp hU
      have hhL := (le_div_iff_of_neg hn).mp hL
      constructor <;> nlinarith
  · have horder : (L-d0)/eta≤(U-d0)/eta :=
      by
        apply (div_le_iff₀ hp).mpr
        rw [div_mul_cancel₀ _ heta]
        linarith
    rw [min_eq_left horder,max_eq_right horder,Set.mem_Icc]
    constructor
    · rintro ⟨hL,hU⟩
      constructor
      · apply (div_le_iff₀ hp).mpr
        nlinarith
      · apply (le_div_iff₀ hp).mpr
        nlinarith
    · rintro ⟨hL,hU⟩
      have hhL := (div_le_iff₀ hp).mp hL
      have hhU := (le_div_iff₀ hp).mp hU
      constructor <;> nlinarith

end
