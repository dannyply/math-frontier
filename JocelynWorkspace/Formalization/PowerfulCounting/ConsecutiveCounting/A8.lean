theorem normalized_pure_floor :
let Point := (ℕ × ℕ) × (ℕ × ℕ);
let OriginalBox : ℕ → ℝ → ℝ → ℝ → Set Point := fun k x D E => {z |
  1 ≤ z.1.1 ∧ 1 ≤ z.1.2 ∧ 1 ≤ z.2.1 ∧ 1 ≤ z.2.2 ∧
  z.1.2 ^ k * z.2.2 = z.1.1 ^ k * z.2.1 + 1 ∧
  x / 2 < (z.1.1 : ℝ) ^ k * (z.2.1 : ℝ) ∧
  (z.1.1 : ℝ) ^ k * (z.2.1 : ℝ) ≤ x ∧
  D / 2 < (z.1.1 : ℝ) ∧ (z.1.1 : ℝ) ≤ D ∧
  E / 2 < (z.1.2 : ℝ) ∧ (z.1.2 : ℝ) ≤ E};
let SixMargin : ℕ → ℝ → ℝ → ℝ → Prop := fun k s m b =>
  0 < b ∧
  0 < ((k : ℝ) + 1) * (s - m - b) / (3 * (k : ℝ) + 2) ∧
  0 < (4 * (k : ℝ) * b - 2 * (k : ℝ) +
      (2 * (k : ℝ) ^ 2 - (k : ℝ) + 1) * s) / (2 * (k : ℝ) + 1) -
    2 * (2 * (k : ℝ) ^ 2 + (k : ℝ) + 1) / (2 * (k : ℝ) + 1) *
      (((k : ℝ) + 1) * (s - m - b) / (3 * (k : ℝ) + 2)) ∧
  0 < ((2 * (k : ℝ) ^ 2 + 3 * (k : ℝ) + 3) * b -
    2 * s - 2 * (k : ℝ) - 2) / (2 * (k : ℝ) + 1) + ((k : ℝ) + 1) * m ∧
  0 < ((k : ℝ) + 2) * b + ((k : ℝ) + 1) * m - s - 1 ∧
  0 < (2 * (2 * (k : ℝ) - 1) * m - 2) / (2 * (k : ℝ) + 1);
∀ k : ℕ, 5 ≤ k → k ≤ 123 →
∀ K : ℝ, 0 ≤ K →
∀ ε : ℝ, 0 < ε →
∀ T : Set (ℝ × ℝ × ℝ), IsCompact T →
  (∀ w ∈ T, SixMargin k w.1 w.2.1 w.2.2) →
∃ C : ℝ, 0 < C ∧
∀ x : ℝ, 2 ≤ x →
∀ s m b : ℝ, (s,m,b) ∈ T →
∀ M : ℕ, 1 ≤ M → (M : ℝ) ≤ x → (M : ℝ) = x ^ m →
∀ D E : ℝ, 0 < D → 0 < E → D * E = x ^ s →
∀ r : ℝ, D / (2 * E) ≤ r → r ≤ 2 * D / E →
∀ P Q : MvPolynomial (Fin 2) ℤ,
  P.IsHomogeneous (k + 1) → Q.IsHomogeneous (k + 1) →
  (∀ w : Fin 2 → ℂ, w ≠ 0 →
    MvPolynomial.eval w (MvPolynomial.map (Int.castRingHom ℂ) P) = 0 →
    MvPolynomial.eval w (MvPolynomial.map (Int.castRingHom ℂ) Q) = 0 → False) →
  (∀ t : Fin 2 →₀ ℕ, |((P.coeff t : ℤ) : ℝ)| ≤ x ^ K ∧
    |((Q.coeff t : ℤ) : ℝ)| ≤ x ^ K) →
∀ a b0 c : ℤ, c ≠ 0 →
  (∃ A B : ℤ, A * a + B * b0 = 1) →
  MvPolynomial.X (1 : Fin 2) ^ k * P -
    MvPolynomial.X (0 : Fin 2) ^ k * Q =
    MvPolynomial.C c *
      (MvPolynomial.C a * MvPolynomial.X (0 : Fin 2) +
        MvPolynomial.C b0 * MvPolynomial.X (1 : Fin 2)) ^ (2 * k + 1) →
  |(a : ℝ)| ≤ x ^ K → |(b0 : ℝ)| ≤ x ^ K → |(c : ℝ)| ≤ x ^ K →
  let S : Set Point := {z |
    z ∈ OriginalBox k x D E ∧
    r < (z.1.1 : ℝ) / (z.1.2 : ℝ) ∧
    (z.1.1 : ℝ) / (z.1.2 : ℝ) ≤ r * (1 + 1 / (M : ℝ)) ∧
    MvPolynomial.eval ![(z.1.1 : ℤ),(z.1.2 : ℤ)] P * (z.2.1 : ℤ) =
      MvPolynomial.eval ![(z.1.1 : ℤ),(z.1.2 : ℤ)] Q * (z.2.2 : ℤ)};
  S.Finite ∧ (S.ncard : ℝ) ≤
    C * x ^ ε * (1 + max D E / (M : ℝ) + x ^ b)

:= by

  intro Point OriginalBox SixMargin k hk hk123 K hK eps heps T hT hSix
  let H : ℕ := Nat.ceil K
  have hKH : K≤(H:ℝ) := Nat.le_ceil K
  have hmargin : ∀ w∈T,
      0<floor_sigma k w ∧ 0<floor_tau k w ∧ 0<floor_omega k w ∧
      0≤((k:ℝ)+2)*w.2.2+((k:ℝ)+1)*w.2.1-w.1-1 := by
    intro w hw
    have hh := hSix w hw
    exact ⟨hh.2.2.1,hh.2.2.2.1,hh.2.2.2.2.2,hh.2.2.2.2.1.le⟩
  obtain ⟨C,hC,hCount⟩ :=
    original_whole_uniform_count_nat_height k (by omega) H eps heps T hT hmargin
  refine ⟨C,hC,?_⟩
  intro x hx s m beta hw M hM1 hMx hMeq D E hD hE hDE rho hrlo hrhi
    P Q hP hQ hno hcoeff a b c hc hab hres haHeight hbHeight hcHeight S
  obtain ⟨A,B,hAB⟩ := hab
  have hx1 : 1≤x := by linarith
  have hheight : x^K≤x^H := by
    rw [←Real.rpow_natCast]
    exact Real.rpow_le_rpow_of_exponent_le hx1 hKH
  have hMreal : (1:ℝ)≤M := by exact_mod_cast hM1
  have hcount := hCount x hx s m beta hw (M:ℝ) D E rho hMreal hMx hMeq hD hE hDE hrhi
    P Q hP hQ hno (fun mu => ⟨(hcoeff mu).1.trans hheight,(hcoeff mu).2.trans hheight⟩)
    a b c A B hc hAB hres (haHeight.trans hheight) (hbHeight.trans hheight) (hcHeight.trans hheight)
  have hset : S={p : OddPureOriginalCRTAtLeastTwo.OriginalPoint |
      floor_original_cell k P Q x D E (M:ℝ) rho p} := by
    ext p
    constructor
    · rintro ⟨⟨hd,he,hu,hv,hshift,hnlo,hnhi,hdlo,hdhi,helo,hehi⟩,hrl,hru,hg⟩
      exact ⟨hd,he,hu,hv,hshift,hnlo,hnhi,hdlo,hdhi,helo,hehi,hrl,hru,hg⟩
    · rintro ⟨hd,he,hu,hv,hshift,hnlo,hnhi,hdlo,hdhi,helo,hehi,hrl,hru,hg⟩
      exact ⟨⟨hd,he,hu,hv,hshift,hnlo,hnhi,hdlo,hdhi,helo,hehi⟩,hrl,hru,hg⟩
  simpa only [hset] using hcount

end
