    p.A q.A p.hdetA q.hdetA L
    (sideLength ((M:ℝ)/(4*D))
      (A8HighFPriceCellTuple.rhoK D E M j) (2*E) p.P 1)
    T
    (sideLength ((M:ℝ)/
        (4*((2:ℝ)^k*(1+(k:ℝ)*(2:ℝ)^k))*(x/E^k)))
