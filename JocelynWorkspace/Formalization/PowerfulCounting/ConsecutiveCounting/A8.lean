theorem theta_bounds (k : ℕ) (hk : 5 ≤ k) :
    (1 : ℝ) / (k : ℝ) ≤ thetaK k ∧ thetaK k ≤ 1 / 2 ∧ (1 : ℝ) / (2 * (k : ℝ) - 1) ≤ thetaK k := by
  have hkR : (5 : ℝ) ≤ (k : ℝ) := by exact_mod_cast hk
