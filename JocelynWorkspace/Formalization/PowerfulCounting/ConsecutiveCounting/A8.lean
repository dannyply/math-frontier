  have hb':r*c+k*q=n 1:=by omega
  rw [hcnt,←ha,hb']
  calc
    _=algebraMap ℚ K c0*d^(n 0)*e^(n 1)*(tau^(n 2)*tau⁻¹^m):=by
      rw [ht']
    _=_:=by ring
end
