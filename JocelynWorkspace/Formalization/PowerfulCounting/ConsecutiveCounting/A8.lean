theorem original_finite_level_uniform_count
    (k : ℕ) (hk : 2≤k) (H : ℕ) (eps : ℝ) (heps : 0<eps)
    (T : Set (ℝ×ℝ×ℝ)) (hT : IsCompact T)
    (hmargin : ∀ w∈T,
      0<floor_sigma k w ∧ 0<floor_tau k w ∧ 0<floor_omega k w ∧
      0≤((k:ℝ)+2)*w.2.2+((k:ℝ)+1)*w.2.1-w.1-1) :
    ∃ C X0 : ℝ,0<C ∧ 2≤X0 ∧
    ∀ x : ℝ,X0≤x →
    ∀ s m beta : ℝ,(s,m,beta)∈T →
    ∀ M D E U V rho : ℝ,1≤M → M≤x → M=x^m →
      0<D → 0<E → 0<U → 0<V → D*E=x^s →
    ∀ P Q : MvPolynomial (Fin 2) ℤ,
      P.IsHomogeneous (k+1) → Q.IsHomogeneous (k+1) →
      (∀ w : Fin 2 → ℂ,w≠0 →
        MvPolynomial.eval w (P.map (Int.castRingHom ℂ))=0 →
        MvPolynomial.eval w (Q.map (Int.castRingHom ℂ))=0 → False) →
      (∀ mu : Fin 2 →₀ ℕ,
        |((P.coeff mu:ℤ):ℝ)|≤x^H ∧ |((Q.coeff mu:ℤ):ℝ)|≤x^H) →
    ∀ a b c A B : ℤ,c≠0 → A*a+B*b=1 →
      MvPolynomial.X (1:Fin 2)^k*P-MvPolynomial.X (0:Fin 2)^k*Q =
        MvPolynomial.C c*(MvPolynomial.C a*MvPolynomial.X (0:Fin 2)+
          MvPolynomial.C b*MvPolynomial.X (1:Fin 2))^(2*k+1) →
      |(a:ℝ)|≤x^H → |(b:ℝ)|≤x^H → |(c:ℝ)|≤x^H →
    ∀ p0 : OriginalPoint,∀ Spts : Finset OriginalPoint,
      OriginalCellPoint k P Q x D E U V M rho 2 p0 →
      (∀ p∈Spts,OriginalCellPoint k P Q x D E U V M rho 2 p ∧
        a*(pd p:ℤ)+b*(pe p:ℤ)=a*(pd p0:ℤ)+b*(pe p0:ℤ)) →
    let K0 : ℤ :=
      b*P.coeff (Finsupp.single (0:Fin 2) (k+1))-
      a*P.coeff (Finsupp.single (0:Fin 2) k+Finsupp.single (1:Fin 2) 1)+
      (Nat.choose (2*k) (k-1):ℤ)*c*a^(k+1)*b^(k+1)
    ((Nat.divisors K0.natAbs).card:ℝ)≤C*x^eps ∧
      (Spts.card:ℝ)≤C*x^eps*(1+max D E/M+x^beta) := by
  obtain ⟨c1,C1,c2,C2,C0,hc1,hc11,hC1,hc2,hc21,hC2,hC0,hC01,hC02,hClass⟩ :=
    original_finite_rich_class_band_bounds k hk
  obtain ⟨CI,CII,X0,hCI,hCII,hX0,hSwitch⟩ :=
    compact_physical_switch k hk c1 c2 C1 hc1 hc2 (by linarith) T hT hmargin
  obtain ⟨CAR,hCAR,hAr⟩ :=
    OddPureOriginalCRTAtLeastTwo.originalArithmeticCRTStatement_of_K0 k hk H eps 2 heps (by norm_num)
  let nd : ℝ := 10*((2*k+1:ℕ):ℝ)+10
  let CA := CAR*(2+4*C0)
  let CG := 6*CAR
  let CR := 2*CAR
  let CPI := nd*(1+CI)
  let CPII := nd*(1+CII)
  let C := CAR+CA+CG+CR+CPI+CPII+1
  have hC0pos : 0<C0 := by linarith
  have hnd : 0<nd := by dsimp [nd];positivity
  have hCA : 0≤CA := by dsimp [CA];positivity
  have hCG : 0≤CG := by dsimp [CG];positivity
  have hCR : 0≤CR := by dsimp [CR];positivity
  have hCPI : 0≤CPI := by dsimp [CPI];positivity
  have hCPII : 0≤CPII := by dsimp [CPII];positivity
  have hC : 0<C := by dsimp only [C];linarith only [hCAR,hCA,hCG,hCR,hCPI,hCPII]
  have hcoefs : CAR≤C ∧ CA≤C ∧ CG≤C ∧ CR≤C ∧ CPI≤C ∧ CPII≤C := by
    dsimp only [C]
    constructor
    · linarith only [hCA,hCG,hCR,hCPI,hCPII]
    constructor
    · linarith only [hCAR,hCG,hCR,hCPI,hCPII]
    constructor
    · linarith only [hCAR,hCA,hCR,hCPI,hCPII]
    constructor
    · linarith only [hCAR,hCA,hCG,hCPI,hCPII]
    constructor
    · linarith only [hCAR,hCA,hCG,hCR,hCPII]
    · linarith only [hCAR,hCA,hCG,hCR,hCPI]
  refine ⟨C,X0,hC,hX0,?_⟩
  intro x hx s m beta hw M D E U V rho hM1 hMx hMeq hD hE hU hV hDE
    P Q hP hQ hno hcoeff a b c A B hc hab hres haHeight hbHeight hcHeight p0 Spts hp0 hS K0
  have hx2 : 2≤x := hX0.trans hx
  have hxp : 0<x := by linarith
  have hx1 : 1≤x := by linarith
  have hM : 0<M := by linarith
  have hfee : 1≤x^eps := Real.one_le_rpow hx1 heps.le
  have hfeep : 0<x^eps := by positivity
  have hK0 : K0≠0 :=
    pure_primitive_kernel_nonzero k hk P Q hP hQ a b c A B hc hab hno hres
  let S0 := P.coeff (Finsupp.single (0:Fin 2) (k+1))
  let R0 := P.coeff (Finsupp.single (0:Fin 2) k+Finsupp.single (1:Fin 2) 1)
  let ell : ℤ := a*(pd p0:ℤ)+b*(pe p0:ℤ)
  let g0 := Nat.gcd c.natAbs K0.natAbs
  let h0 := c.natAbs/g0
  let h : ℤ := (h0:ℤ)
  let q : ℤ := c.sign*K0.sign*((K0.natAbs/g0:ℕ):ℤ)
  let n := (ell^(2*k+1)).natAbs
  let NN := (q*h^k).natAbs
  let W := ∏ p∈n.primeFactors,p^depth k (padicValNat p n) (padicValNat p NN)
  obtain ⟨hK,hell,hdiv,hg0,hh0,hq,hcq,hcop,hcontent,hj1,
      f,g,hfd,hgd,hft,hgt,hfg,hcert,hW,hmod,hcover,hraw,hweight,hdivcard,hRC⟩ :=
    hAr x D E U V M rho P Q a b c A B p0 Spts hx2 hD hE hU hV hM1 hMx
      (homogeneous_binary_support P _ hP) (homogeneous_binary_support Q _ hQ)
      hcoeff haHeight hbHeight hcHeight hK0 hc hab hres hp0 hS
  let L : ℝ := |(ell:ℝ)|
  let HH : ℝ := (h0:ℝ)
  let QQ : ℝ := (q.natAbs:ℝ)
  let Btar : ℝ := x^beta
  let rmax : ℝ := max D E/M
  let total : ℝ := 1+rmax+Btar
  let weight : ℝ := (((k+1)^n.primeFactors.card:ℕ):ℝ)
  let width : ℝ := D*E/(M*L*HH*(W:ℝ))
  have hellR : (ell:ℝ)≠0 := by exact_mod_cast hell
  have hL : 0<L := abs_pos.mpr hellR
  have hH1 : 1≤HH := by dsimp only [HH];exact_mod_cast hh0
  have hHpos : 0<HH := by linarith
  have hhR : (h:ℝ)≠0 := by
    dsimp [h]
    exact_mod_cast (Nat.ne_of_gt hh0)
  have hhZ : h≠0 := by exact_mod_cast hhR
  have hQ1 : 1≤QQ := by
    dsimp only [QQ]
    exact_mod_cast (Int.natAbs_pos.mpr hq)
  have hQpos : 0<QQ := by linarith
  have hW1 : (1:ℝ)≤W := by exact_mod_cast hW
  have hWp : (0:ℝ)<W := by linarith
  have hLnat : (ell.natAbs:ℝ)=L := by
    rw [←Int.cast_natCast,Int.natCast_natAbs,Int.cast_abs]
  have hQnat : (q.natAbs:ℝ)=|(q:ℝ)| := by
    rw [←Int.cast_natCast,Int.natCast_natAbs,Int.cast_abs]
  have hmhabs : |((ell*h:ℤ):ℝ)|=L*HH := by
    simp only [h,L,HH,Int.cast_mul,Int.cast_natCast,abs_mul,abs_of_nonneg ((show (0:ℝ)≤(h0:ℝ) from Nat.cast_nonneg h0))]
  have hrmax : 0≤rmax := by dsimp [rmax];positivity
  have hBtar : 0<Btar := by dsimp [Btar];positivity
  have htotal : 0<total := by dsimp [total];positivity
  have hweightp : 0≤weight := Nat.cast_nonneg _
  have hwidthp : 0≤width := by dsimp [width];positivity
  have hraw' : (Spts.card:ℝ)≤weight*(2+4*width) := by
    convert hraw using 1 <;> rw [hmhabs] <;> dsimp only [width,weight] <;> ring
  have hweight' : weight≤CAR*x^eps := hweight
  have hfinish (coef : ℝ) (hcoef : coef≤C)
      (hc : (Spts.card:ℝ)≤coef*x^eps*total) :
      (Spts.card:ℝ)≤C*x^eps*total :=
    hc.trans (mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_right hcoef hfeep.le) htotal.le)
  have hRawFinish (u coef : ℝ) (hu : 0≤u) (hwid : width≤u)
      (hbudget : 2+4*u≤coef*total) :
      (Spts.card:ℝ)≤(CAR*coef)*x^eps*total := by
    calc
      (Spts.card:ℝ)≤weight*(2+4*width) := hraw'
      _≤weight*(2+4*u) := mul_le_mul_of_nonneg_left (by linarith only [hwid]) hweightp
      _≤(CAR*x^eps)*(2+4*u) := mul_le_mul_of_nonneg_right hweight' (by positivity)
      _≤(CAR*x^eps)*(coef*total) := mul_le_mul_of_nonneg_left hbudget (by positivity)
      _=(CAR*coef)*x^eps*total := by ring
  have hdivC : ((Nat.divisors K0.natAbs).card:ℝ)≤C*x^eps :=
    hdivcard.trans (mul_le_mul_of_nonneg_right hcoefs.1 hfeep.le)
  refine ⟨hdivC,?_⟩
  change (Spts.card:ℝ)≤C*x^eps*total
  have hlevelR : (a:ℝ)*(pd p0:ℝ)+(b:ℝ)*(pe p0:ℝ)=(ell:ℝ) := by
    dsimp only [ell]
    push_cast
    rfl
  obtain ⟨hd0,he0,hu0,hv0,hdlo,hdhi,helo,hehi,hulo,huhi,hvlo,hvhi,
    hnlo,hnhi,hunit,hgraph,hcell⟩ := hp0
  by_cases hrich : L*C0 < max (|(a:ℝ)| *D) (|(b:ℝ)| *E)
  · have hnoaxis : ¬(a=0 ∨ b=0) := by
      intro haxis
      have hhaxis : (a:ℝ)=0 ∨ (b:ℝ)=0 := by
        rcases haxis with ha | hb
        · left;exact_mod_cast ha
        · right;exact_mod_cast hb
      have hbound := axis_original_box_bound (a:ℝ) (b:ℝ) D E (pd p0:ℝ) (pe p0:ℝ)
        (ell:ℝ) hD hE hdlo helo hlevelR hhaxis
      change _≤2*L at hbound
      have hCL := mul_le_mul_of_nonneg_right hC0 hL.le
      nlinarith only [hbound,hrich,hCL,hL]
    have ha : a≠0 := fun hz => hnoaxis (Or.inl hz)
    have hb : b≠0 := fun hz => hnoaxis (Or.inr hz)
    let AA : ℝ := |(a:ℝ)*(b:ℝ)|
    let gamma : ℝ := (a:ℝ)*(b:ℝ)*(h:ℝ)/(ell:ℝ)
    let lam : ℝ := (K0:ℝ)/((c:ℝ)*((a:ℝ)*(b:ℝ))^(k+1))
    let R : ℝ := Real.sqrt (AA*(D*E))/(4*L)
    have haR : (a:ℝ)≠0 := by exact_mod_cast ha
    have hbR : (b:ℝ)≠0 := by exact_mod_cast hb
    have hAA : 0<AA := abs_pos.mpr (mul_ne_zero haR hbR)
    have hgamma : |gamma|=AA*HH/L := by
      simp only [gamma,AA,HH,L,h,Int.cast_natCast,abs_div,abs_mul,
        abs_of_nonneg ((show (0:ℝ)≤(h0:ℝ) from Nat.cast_nonneg h0))]
    obtain ⟨hKK,hFd,hFc,hUnique,hPoint,hAffine⟩ :=
      integer_pure_height_physical_data k hk P Q hP hQ a b c (ell:ℝ)
        ha hb hc hellR hno hres
    obtain ⟨hNdeg,hNeval,hNder,hNpoint,hqform⟩ :=
      hAffine (pd p0:ℝ) (pe p0:ℝ) (h:ℝ) hhR hlevelR
    have hcqR : (c:ℝ)*(q:ℝ)=(K0:ℝ)*(h:ℝ) := by exact_mod_cast hcq
    have hlam : |lam|=QQ/(HH*AA^(k+1)) := by
      have hh := ((hqform (q:ℝ) hcqR).2 lam hFc).2
      simpa only [QQ,HH,AA,h,Int.cast_natCast,
        abs_of_nonneg ((show (0:ℝ)≤(h0:ℝ) from Nat.cast_nonneg h0)),hQnat] using hh
    have hL1 : 1≤L := by
      rw [←hLnat]
      have hh : 1≤ell.natAbs := Int.natAbs_pos.mpr hell
      exact_mod_cast hh
    have hcases := hSwitch x hx s m beta hw AA (D*E) M L HH QQ |gamma| |lam|
      hAA (mul_pos hD hE) hM hL1 hH1 hQ1 hDE hMeq hgamma hlam
    have hBands := hClass P Q hP hQ hno a b c h ell ha hb hc hhZ hell hres
      x D E U V M rho 2 hxp hD hE p0 Spts
      ⟨hd0,he0,hu0,hv0,hdlo,hdhi,helo,hehi,hulo,huhi,hvlo,hvhi,
        hnlo,hnhi,hunit,hgraph,hcell⟩
      (fun p hp => (hS p hp).1) rfl hrich f g hcert
    have hPhysFinish (Cp : ℝ) (hCp : 0≤Cp)
        (hc : (Spts.card:ℝ)≤nd*(1+Cp*Btar)) :
        (Spts.card:ℝ)≤(nd*(1+Cp))*x^eps*total := by
      have hbudget : 1+Cp*Btar≤(1+Cp)*total := by
        convert affine_price_budget 1 Cp Btar rmax (by norm_num) hCp hBtar.le hrmax using 1 <;>
          ring
      calc
        (Spts.card:ℝ)≤nd*(1+Cp*Btar) := hc
        _≤nd*((1+Cp)*total) := mul_le_mul_of_nonneg_left hbudget hnd.le
        _=(nd*(1+Cp))*total := by ring
        _≤(nd*(1+Cp))*x^eps*total :=
          mul_le_mul_of_nonneg_right
            (le_mul_of_one_le_right (by positivity) hfee) htotal.le
    rcases hcases with hgeom | hII | hRoot | hI
    · have hwid : width≤Btar := by
        exact (raw_width_remove_modulus (D*E) M L HH (W:ℝ)
          (by positivity) hM hL hHpos hW1).trans hgeom
      have hbudget : 2+4*Btar≤6*total := by
        convert affine_price_budget 2 4 Btar rmax (by norm_num) (by norm_num) hBtar.le hrmax using 1 <;>
          ring
      have hh := hRawFinish Btar 6 hBtar.le hwid hbudget
      apply hfinish CG hcoefs.2.2.1
      simpa only [CG,mul_comm CAR 6] using hh
    · obtain ⟨hforce,hprice⟩ := hII
      have hBand := hBands.2 hforce
      have hprice' : Real.sqrt (x/(c2*gamma^2*R^(2*k-3)))≤CII*Btar := by
        simpa only [sq_abs,Btar] using hprice
      have hh : (Spts.card:ℝ)≤nd*(1+CII*Btar) := by
        exact hBand.trans (mul_le_mul_of_nonneg_left (by linarith only [hprice']) hnd.le)
      exact hfinish CPII hcoefs.2.2.2.2.2 (hPhysFinish CII hCII.le hh)
    · have hRC' : (Spts.card:ℝ)≤CAR*x^eps*(1+Btar) := by
        have hroot : D*E/M*QQ^(1/((k+1:ℕ):ℝ))*HH^(-(1/((k+1:ℕ):ℝ)))*
            (ell.natAbs:ℝ)^(-(((3*k+2:ℕ):ℝ)/((k+1:ℕ):ℝ)))≤Btar := by
          simpa only [hLnat,Btar] using hRoot
        exact hRC.trans (mul_le_mul_of_nonneg_left (by linarith only [hroot]) (by positivity))
      have hbudget : 1+Btar≤2*total := by dsimp [total];linarith only [hrmax,hBtar.le]
      have hh : (Spts.card:ℝ)≤CR*x^eps*total := by
        calc
