  refine ⟨C (coeff m g)*X 0^(m 0)*X 1^(m 1)*X 2^(m 2)*X 3^(m 3-1),?_⟩
  calc
    (C (coeff m g):wC)*(X 0^(m 0)*X 1^(m 1)*X 2^(m 2)*X 3^(m 3))= (C (coeff m g)*X 0^(m 0)*X 1^(m 1)*X 2^(m 2))* (X 3^(m 3-1)*X 3):=by rw [hpow];ring
    _=X 3*(C (coeff m g)*X 0^(m 0)*X 1^(m 1)*X 2^(m 2)*X 3^(m 3-1)):=by ring
lemma o1 (k:ℕ) (g:wC) (alpha beta nu:ℕ)
    (hg:∀ m∈ g.support,m 0+m 1=alpha∧ m 2+m 3=beta)
    (hirr:uZ g) (hnot:¬g∣X (3:Fin 4))
