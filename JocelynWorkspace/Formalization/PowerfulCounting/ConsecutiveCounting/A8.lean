        (pd p : ℤ) = (pd p0 : ℤ)+b*h*y ∧
        (pe p : ℤ) = (pe p0 : ℤ)-a*h*y ∧
        f.eval y = m^(2*k+1)*(pv p : ℤ) ∧
        g.eval y = m^(2*k+1)*(pu p : ℤ))
  exact ⟨hK,hm0,hmdiv,hg0,hh0,hq0,hqeq,hcop,
    ⟨j0,hj0⟩,hj1eq,f,g,hdeg.1,hdeg.2,htop.1,htop.2,hfg',hcert⟩

theorem originalArithmeticCRTStatement_of_K0 : OriginalArithmeticCRTStatementOfK0 := by
  intro k hk H eps Ccell heps hCcell
  obtain ⟨C0,hC0,hsub⟩ := original_fixed_height_subpowers k H hk eps heps
  let C : ℝ := (2+2*Ccell)*C0
  have hC0z : 0 ≤ C0 := by linarith
  have hC : 0 < C := by dsimp [C];positivity
  have hC0C : C0 ≤ C := by
    dsimp [C]
    nlinarith
  refine ⟨C,hC,?_⟩
  intro x D E U V M rho P Q a b c A B p0 Spts hx hD hE hU hV hM hMx
    hP hQ hcoeff ha hb hcHeight hK0 hc hab hpure hp0 hSpts
  classical
  let S : ℤ := P.coeff (Finsupp.single (0 : Fin 2) (k+1))
  let R : ℤ := P.coeff
    (Finsupp.single (0 : Fin 2) k+Finsupp.single (1 : Fin 2) 1)
  let K0 : ℤ := b*S-a*R+
    (Nat.choose (2*k) (k-1) : ℤ)*c*a^(k+1)*b^(k+1)
  let m : ℤ := a*(pd p0 : ℤ)+b*(pe p0 : ℤ)
  let g0 : ℕ := Nat.gcd c.natAbs K0.natAbs
  let h0 : ℕ := c.natAbs/g0
  let h : ℤ := (h0 : ℤ)
  let q : ℤ := c.sign*K0.sign*((K0.natAbs/g0 : ℕ) : ℤ)
  let n : ℕ := (m^(2*k+1)).natAbs
  let N : ℕ := (q*h^k).natAbs
  let W : ℕ := ∏ p ∈ n.primeFactors,
    p^depth k (padicValNat p n) (padicValNat p N)
  obtain ⟨hK,hm0,hmdiv,hg0,hh0,hq0,hqeq,hcop,hcontent,hj1,
      f,g,hfd,hgd,hft,hgt,hfg,hcert⟩ :=
    original_actual_point_transport_of_K0 k hk P Q a b c A B p0 Spts
      x D E U V M rho Ccell hP hQ hK0 hc hab hpure hp0 hSpts
  have hh0' : h ≠ 0 := by
    change (h0 : ℤ) ≠ 0
    exact_mod_cast (Nat.ne_of_gt hh0)
  have hheight : |(K0 : ℝ)| ≤
      ((Nat.choose (2*k) (k-1) : ℝ)+2)*x^((2*k+3)*H) :=
    original_K0_height k H x S R a b c hx
      (hcoeff _).1 (hcoeff _).1 ha hb hcHeight
  obtain ⟨hweight,hdiv⟩ := hsub x K0 m hx hK hmdiv hheight
  have hcover := original_allprime_cover_and_modulus k a b A B q h m
    f g hab hm0 hq0 hh0' hfd hgd hft hgt
  change 0 < W ∧ n ∣ W^(k+1)*N ∧
    ∃ T : Finset ℤ, T.card ≤ (k+1)^n.primeFactors.card ∧
      ∀ z u v : ℤ,
        f.eval z = m^(2*k+1)*v →
        g.eval z = m^(2*k+1)*u →
        ∃ center ∈ T, (W : ℤ) ∣ z-center at hcover
  obtain ⟨hW,hmod,T,hTc,hTv⟩ := hcover
  have hM0 : 0 < M := by linarith
  have hx0 : 0 < x := by linarith
  have hbase := original_point_count_from_certificates
    k P Q x D E U V M rho Ccell a b A B m h p0
    Spts f g T W hab rfl hm0 hh0' hD hE hM0 hCcell hW
    (fun p hp => (hSpts p hp).1) hcert hTv
  have hfac : 0 ≤
      2+2*Ccell*D*E/(M*|((m*h : ℤ) : ℝ)| * (W : ℝ)) := by
    have hWr : (0 : ℝ) < W := by exact_mod_cast hW
    positivity
  have hTcR : (T.card : ℝ) ≤ (((k+1)^n.primeFactors.card : ℕ) : ℝ) := by
    exact_mod_cast hTc
  have hraw : (Spts.card : ℝ) ≤
      (((k+1)^n.primeFactors.card : ℕ) : ℝ) *
        (2+2*Ccell*D*E/(M*|((m*h : ℤ) : ℝ)| * (W : ℝ))) :=
    hbase.trans (mul_le_mul_of_nonneg_right hTcR hfac)
  have hmr : (0 : ℝ) < m.natAbs := by exact_mod_cast (Int.natAbs_pos.mpr hm0)
  have hqr : (0 : ℝ) < q.natAbs := by exact_mod_cast (Int.natAbs_pos.mpr hq0)
  have hhr : (0 : ℝ) < h0 := by exact_mod_cast hh0
  have hWr : (0 : ℝ) < W := by exact_mod_cast hW
  have hNpos : 0 < N :=
    Int.natAbs_pos.mpr (mul_ne_zero hq0 (pow_ne_zero k hh0'))
  have hcapNat : n ≤ W^(k+1)*N :=
    Nat.le_of_dvd (mul_pos (pow_pos hW _) hNpos) hmod
  have hcap : (m.natAbs : ℝ)^(2*k+1) ≤
      (W : ℝ)^(k+1)*(q.natAbs : ℝ)*(h0 : ℝ)^k := by
    have hr : (n : ℝ) ≤ ((W^(k+1)*N : ℕ) : ℝ) := by exact_mod_cast hcapNat
    simpa only [n,N,h,Int.natAbs_pow,Int.natAbs_mul,Int.natAbs_natCast,
      Nat.cast_pow,Nat.cast_mul,mul_assoc] using hr
  have hshoulder := original_modulus_real_shoulder k
    (q.natAbs : ℝ) (h0 : ℝ) (m.natAbs : ℝ) (W : ℝ) hqr hhr hmr hWr hcap
  have hmabs : (m.natAbs : ℝ)=|(m : ℝ)| := by
    rw [← Int.cast_natCast,Int.natCast_natAbs,Int.cast_abs]
  have hmhabs : |((m*h : ℤ) : ℝ)|=(m.natAbs : ℝ)*(h0 : ℝ) := by
    simp only [h,Int.cast_mul,Int.cast_natCast,abs_mul,abs_of_nonneg hhr.le,
      ← hmabs]
  let Z : ℝ := D*E/M *
    (q.natAbs : ℝ)^(1/((k+1 : ℕ) : ℝ)) *
    (h0 : ℝ)^(-(1/((k+1 : ℕ) : ℝ))) *
    (m.natAbs : ℝ)^(-(((3*k+2 : ℕ) : ℝ)/((k+1 : ℕ) : ℝ)))
  have hZ : 0 ≤ Z := by dsimp [Z];positivity
  have hfactor :
      2+2*Ccell*D*E/(M*|((m*h : ℤ) : ℝ)| * (W : ℝ)) ≤
        (2+2*Ccell)*(1+Z) := by
    rw [hmhabs]
    have hs := mul_le_mul_of_nonneg_left hshoulder
      (show 0 ≤ 2*Ccell*(D*E/M) by positivity)
    have he1 : 2*Ccell*(D*E/M)*(1/((m.natAbs : ℝ)*(h0 : ℝ)*(W : ℝ))) =
        2*Ccell*D*E/(M*((m.natAbs : ℝ)*(h0 : ℝ))*(W : ℝ)) := by
      field_simp
    have he2 : 2*Ccell*(D*E/M)*
        ((q.natAbs : ℝ)^(1/((k+1 : ℕ) : ℝ)) *
          (h0 : ℝ)^(-(1/((k+1 : ℕ) : ℝ))) *
          (m.natAbs : ℝ)^(-(((3*k+2 : ℕ) : ℝ)/((k+1 : ℕ) : ℝ)))) =
        2*Ccell*Z := by dsimp [Z];ring
    rw [he1,he2] at hs
    nlinarith
  have hfinal : (Spts.card : ℝ) ≤ C*x^eps*(1+Z) := by
    calc
      _ ≤ (((k+1)^n.primeFactors.card : ℕ) : ℝ) *
          (2+2*Ccell*D*E/(M*|((m*h : ℤ) : ℝ)| * (W : ℝ))) := hraw
      _ ≤ (((k+1)^n.primeFactors.card : ℕ) : ℝ) *
          ((2+2*Ccell)*(1+Z)) :=
        mul_le_mul_of_nonneg_left hfactor (Nat.cast_nonneg _)
      _ ≤ (C0*x^eps)*((2+2*Ccell)*(1+Z)) :=
        mul_le_mul_of_nonneg_right hweight (by positivity)
      _ = C*x^eps*(1+Z) := by dsimp [C];ring
  refine ⟨hK,hm0,hmdiv,hg0,hh0,hq0,hqeq,hcop,hcontent,hj1,
    f,g,hfd,hgd,hft,hgt,hfg,hcert,hW,hmod,⟨T,hTc,?_⟩,hraw,?_,?_,hfinal⟩
  · intro y hfy hgy
    have hnat : (n : ℤ)=|m^(2*k+1)| := Int.natCast_natAbs _
    have hfdiv : m^(2*k+1) ∣ f.eval y := by
      rwa [hnat,abs_dvd] at hfy
    have hgdiv : m^(2*k+1) ∣ g.eval y := by
      rwa [hnat,abs_dvd] at hgy
    obtain ⟨v,hv⟩ := hfdiv
    obtain ⟨u,hu⟩ := hgdiv
    exact hTv y u v hv hu
  · exact hweight.trans
      (mul_le_mul_of_nonneg_right hC0C (Real.rpow_nonneg hx0.le _))
  · exact hdiv.trans
      (mul_le_mul_of_nonneg_right hC0C (Real.rpow_nonneg hx0.le _))

end OddPureOriginalCRTAtLeastTwo

