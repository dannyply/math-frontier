theorem physical_progression_band_count :
∀ k : ℕ, 2≤k →
∃ c₁ C₁ c₂ C₂ C₀ : ℝ,
  0<c₁ ∧ c₁≤1 ∧ 2≤C₁ ∧ 0<c₂ ∧ c₂≤1 ∧ 2≤C₂ ∧
  8≤C₀ ∧ 8*C₁≤C₀ ∧ 8*C₂≤C₀ ∧
∀ P Q : MvPolynomial (Fin 2) ℤ,
  P.IsHomogeneous (k+1) → Q.IsHomogeneous (k+1) →
  (∀ w : Fin 2 → ℂ, w≠0 →
    MvPolynomial.eval w (P.map (Int.castRingHom ℂ))=0 →
    MvPolynomial.eval w (Q.map (Int.castRingHom ℂ))=0 → False) →
∀ a b c : ℤ, a≠0 → b≠0 → c≠0 →
  MvPolynomial.X (1:Fin 2)^k*P-MvPolynomial.X (0:Fin 2)^k*Q =
    MvPolynomial.C c*(MvPolynomial.C a*MvPolynomial.X (0:Fin 2)+
      MvPolynomial.C b*MvPolynomial.X (1:Fin 2))^(2*k+1) →
∀ ell x D E dstar estar : ℝ, ell≠0 → 0<x → 0<D → 0<E →
  D/2<dstar → dstar≤D → E/2<estar → estar≤E →
  (a:ℝ)*dstar+(b:ℝ)*estar=ell →
  |ell| *C₀< max (|(a:ℝ)| *D) (|(b:ℝ)| *E) →
∀ d0 e0 h : ℝ, h≠0 → (a:ℝ)*d0+(b:ℝ)*e0=ell →
  let S0 := P.coeff (Finsupp.single (0:Fin 2) (k+1))
  let R0 := P.coeff (Finsupp.single (0:Fin 2) k+Finsupp.single (1:Fin 2) 1)
  let K0 : ℤ := b*S0-a*R0+(Nat.choose (2*k) (k-1):ℤ)*c*a^(k+1)*b^(k+1)
  let Qr := Q.map (Int.castRingHom ℝ)
  let d : Polynomial ℝ := Polynomial.C (ell/(a:ℝ))*Polynomial.X
  let e : Polynomial ℝ := Polynomial.C (ell/(b:ℝ))*(1-Polynomial.X)
  let φ := MvPolynomial.eval₂Hom Polynomial.C ![d,e]
  let F : Polynomial ℝ := Polynomial.C (1/((c:ℝ)*ell^(2*k+1)))*(d^k*φ Qr)
  let z0 : ℝ := (a:ℝ)*d0/ell
  let γ : ℝ := (a:ℝ)*(b:ℝ)*h/ell
  let N := F.comp (Polynomial.C z0+Polynomial.C γ*Polynomial.X)
  let T : ℝ := Real.sqrt (|(a:ℝ)*(b:ℝ)| *(D*E))
  let R : ℝ := T/(4*|ell|)
  let lam : ℝ := (K0:ℝ)/((c:ℝ)*((a:ℝ)*(b:ℝ))^(k+1))
  let l₁ : ℝ := c₁*|lam| *|γ| *R^(2*k)
  let L₂ : ℝ := c₂*γ^2*R^(2*k-3)
  let S : Set ℤ := {j |
    D/2≤d0+(b:ℝ)*h*(j:ℝ) ∧ d0+(b:ℝ)*h*(j:ℝ)≤D ∧
    x/2<N.eval (j:ℝ) ∧ N.eval (j:ℝ)≤x}
  (C₁≤ |lam| *R^2 → C₁*x≤ |lam| *R^(2*k+1) →
    S.Finite ∧ (S.ncard:ℝ)≤(10*((2*k+1:ℕ):ℝ)+10)*(1+x/l₁)) ∧
  (x≤c₂*R^(2*k-1) →
    S.Finite ∧ (S.ncard:ℝ)≤(10*((2*k+1:ℕ):ℝ)+10)*(1+Real.sqrt (x/L₂)))

:= by
  intro k hk
  obtain ⟨H,hHd,hHX,hH1,c₁,C₁,c₂,C₂,hc₁,hc₁1,hC₁,hc₂,hc₂1,hC₂,hform⟩ :=
    original_height_fixed_normal_form k hk
  let C₀ : ℝ := 8*(C₁+C₂+8)
  have hC₀ : 8≤C₀ := by dsimp [C₀];linarith
  have hC₀1 : 8*C₁≤C₀ := by dsimp [C₀];linarith
  have hC₀2 : 8*C₂≤C₀ := by dsimp [C₀];linarith
  refine ⟨c₁,C₁,c₂,C₂,C₀,hc₁,hc₁1,hC₁,hc₂,hc₂1,hC₂,hC₀,hC₀1,hC₀2,?_⟩
  intro P Q hP hQ hno a b c ha hb hc hres ell x D E dstar estar hell hx hD hE
    hdstar hdstar' hestar hestar' hstar hrich d0 e0 h hh hlevel
    S0 R0 K0 Qr d e φ F z0 γ N T R lam l₁ L₂ S
  let Pr := P.map (Int.castRingHom ℝ)
  have haR : (a:ℝ)≠0 := by exact_mod_cast ha
  have hbR : (b:ℝ)≠0 := by exact_mod_cast hb
  have hcR : (c:ℝ)≠0 := by exact_mod_cast hc
  have hrealres : MvPolynomial.X (1:Fin 2)^k*Pr-MvPolynomial.X (0:Fin 2)^k*Qr =
      MvPolynomial.C (c:ℝ)*
        (MvPolynomial.C (a:ℝ)*MvPolynomial.X (0:Fin 2)+
          MvPolynomial.C (b:ℝ)*MvPolynomial.X (1:Fin 2))^(2*k+1) := by
    simpa [Pr,Qr] using congrArg (MvPolynomial.map (Int.castRingHom ℝ)) hres
  obtain ⟨hK,hFdeg,hFcoef,hLambda,hpoint,haff⟩ :=
    integer_pure_height_physical_data k hk P Q hP hQ a b c ell ha hb hc hell hno hres
  obtain ⟨kappa,lam0,hFform,hcoef,hfirst,hsecond⟩ :=
    hform Pr Qr (hQ.map (Int.castRingHom ℝ))
      (a:ℝ) (b:ℝ) (c:ℝ) ell haR hbR hcR hell hrealres
  have hlam0 : lam0=lam := hLambda lam0 hcoef
  rw [hlam0] at hfirst
