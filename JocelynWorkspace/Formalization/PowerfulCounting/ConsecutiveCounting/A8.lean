namespace eV
open MvPolynomial
variable {n:ℕ} (I:Ideal (aa (Fin n) ℚ))
abbrev V (s:ℕ):Submodule ℚ (aa (Fin n) ℚ ⧸ I):= Submodule.map (uV ℚ I).toLinearMap (restrictTotalDegree (Fin n) ℚ s)
lemma dM {s t:ℕ} (hst:s≤ t):V I s≤ V I t:=by
  apply Submodule.map_mono
  intro p hp
  rw [mem_restrictTotalDegree] at hp ⊢
  exact le_trans hp hst
lemma V_mul {s t:ℕ} {a b:aa (Fin n) ℚ ⧸ I} (ha:a∈ V I s) (hb:b∈ V I t):
    a*b∈ V I (s+t):=by
  obtain ⟨p,hp,rfl⟩:=Submodule.mem_map.mp ha
  obtain ⟨q,hq,rfl⟩:=Submodule.mem_map.mp hb
  refine Submodule.mem_map.mpr ⟨p*q,?_,?_⟩
  · rw [mem_restrictTotalDegree] at hp hq ⊢
    exact le_trans (totalDegree_mul p q) (bB hp hq)
  · simp
lemma V_pow {s:ℕ} {a:aa (Fin n) ℚ ⧸ I} (ha:a∈ V I s) (i:ℕ):
    a^i∈ V I (i*s):=by
  induction i with
  | zero=>
    refine Submodule.mem_map.mpr ⟨1,?_,by simp⟩
    rw [mem_restrictTotalDegree];simp
  | succ i ih=>
    rw [pow_succ,Nat.succ_mul]
    exact V_mul I ih ha
lemma eW (a:aa (Fin n) ℚ ⧸ I):∃ D,a∈ V I D:=by
  obtain ⟨p,rfl⟩:=fx a
  refine ⟨p.totalDegree,Submodule.mem_map.mpr ⟨p,?_,rfl⟩⟩
  rw [mem_restrictTotalDegree]
lemma gR (d:ℕ) (hd:1≤ d) (e:ℤ) (s₀:ℕ)
    (hHF:∀ s:ℕ,s₀≤ s→(Module.finrank ℚ (V I s):ℤ)=(d:ℤ)*(s:ℤ)+e)
    (a b:aa (Fin n) ℚ ⧸ I):
    ∃ P:ar (ar ℚ),P ≠ 0∧ Polynomial.eval₂ (vb b).toRingHom a P=0:=by
  classical
  obtain ⟨Da,ha⟩:=eW I a
  obtain ⟨Db,hb⟩:=eW I b
  set D:=Da+Db+1 with hD
  have ha':a∈ V I D:=dM I (by omega) ha
  have hb':b∈ V I D:=dM I (by omega) hb
  set k:ℕ:=2*d*D+e.natAbs+s₀+1 with hk
  have hD1n:1≤ D:=by omega
  have hkD:s₀≤ 2*k*D:=by
    have h1:s₀≤ k:=by omega
    have h2:k≤ 2*k*D:=by nlinarith
    omega
  have hmem:∀ ij:Fin (k+1)× Fin (k+1),a^(ij.1:ℕ)*b^(ij.2:ℕ)∈ V I (2*k*D):=by
    intro ij
    have h1:=V_pow I ha' ij.1
    have h2:=V_pow I hb' ij.2
    have h3:=V_mul I h1 h2
    have hi:(ij.1:ℕ)≤ k:=by have:=ij.1.isLt;omega
    have hj:(ij.2:ℕ)≤ k:=by have:=ij.2.isLt;omega
    refine dM I ?_ h3
    have hh1:=d0 D hi
    have hh2:=d0 D hj
    calc (ij.1:ℕ)*D+(ij.2:ℕ)*D≤ k*D+k*D:=bB hh1 hh2
      _=2*k*D:=by ring
  let v:Fin (k+1)× Fin (k+1)→ V I (2*k*D):= fun ij=>⟨a^(ij.1:ℕ)*b^(ij.2:ℕ),hmem ij⟩
  have hF:=hHF (2*k*D) hkD
  have he:-(e.natAbs:ℤ)≤ e:=by omega
  have he':e≤(e.natAbs:ℤ):=by omega
  have hk':(k:ℤ)=2*d*D+e.natAbs+s₀+1:=by rw [hk];push_cast;ring
  have hD1:(1:ℤ)≤ D:=by exact_mod_cast hD1n
  have hd1:(1:ℤ)≤ d:=by exact_mod_cast hd
  have hs0:(0:ℤ)≤ s₀:=by positivity
  have hab:(0:ℤ)≤ e.natAbs:=by positivity
  have hk0:(0:ℤ)≤ k:=by positivity
  have hdD:(0:ℤ)≤(d:ℤ)*D:=by positivity
  have hkD':(2*k:ℤ)≤ 2*k*D:=by nlinarith
  have hdkD:(2*k*D:ℤ)≤ d*(2*k*D):=by nlinarith
  have hkge:(2*d*D+e.natAbs+1:ℤ)≤ k:=by rw [hk'];linarith
  have hpos:0< Module.finrank ℚ (V I (2*k*D)):=by
    have:(0:ℤ)<(Module.finrank ℚ (V I (2*k*D)):ℤ):=by
      rw [hF]
      push_cast
      nlinarith
    exact_mod_cast this
  have:Module.Finite ℚ (V I (2*k*D)):=Module.finite_of_finrank_pos hpos
  have hnot:¬ LinearIndependent ℚ v:=by
    intro hli
    have vd:=hli.fintype_card_le_finrank
    rw [Fintype.card_prod,Fintype.card_fin] at vd
    have hc:(((k+1)*(k+1):ℕ):ℤ)≤(d:ℤ)*((2*k*D:ℕ):ℤ)+e:=by
      rw [← hF];exact_mod_cast vd
    push_cast at hc
    have vf:=ad hkge hk0
    have hke:(0:ℤ)≤ k*e.natAbs:=aw hk0 hab
    nlinarith
  rw [Fintype.not_linearIndependent_iff] at hnot
  obtain ⟨g,hg,ij0,hij0⟩:=hnot
  refine ⟨∑ ij:Fin (k+1)× Fin (k+1),c7 (ij.1:ℕ) (c7 (ij.2:ℕ) (g ij)),?_,?_⟩
  · intro h0
    have:=congrArg (fun P:ar (ar ℚ)=>(P.coeff (ij0.1:ℕ)).coeff (ij0.2:ℕ)) h0
    simp only [c5,dX,Polynomial.coeff_zero] at this
    rw [Finset.sum_eq_single ij0] at this
    · simp [] at this;exact hij0 this
    · intro ij _ hne
      by_cases h1:(ij.1:ℕ)=ij0.1
      · have h2:(ij.2:ℕ) ≠ ij0.2:=by
          intro h2;apply hne;exact Prod.ext (Fin.ext h1) (Fin.ext h2)
        simp [dX,h1,h2]
      · simp [h1]
    · intro h;exact absurd (Finset.mem_univ ij0) h
  · have fL:∑ x:Fin (k+1)× Fin (k+1),algebraMap ℚ (aa (Fin n) ℚ ⧸ I) (g x)*(a^(x.1:ℕ)*b^(x.2:ℕ))=0:=by
      have:=congrArg Subtype.val hg
      simp only [v,Submodule.coe_sum,Submodule.coe_smul,ZeroMemClass.coe_zero] at this
      rw [← this]
      refine u4 rfl (fun x _=>?_)
      exact (Algebra.smul_def (g x) _).symm
    rw [Polynomial.eval₂_finsetSum,← fL]
    refine u4 rfl (fun ij _=>?_)
    simp only [Polynomial.eval₂_monomial,AlgHom.toRingHom_eq_coe,RingHom.coe_coe,Polynomial.aeval_monomial]
    ring
lemma gS [hI:I.IsPrime] (d:ℕ) (hd:1≤ d) (e:ℤ) (s₀:ℕ)
    (hHF:∀ s:ℕ,s₀≤ s→(Module.finrank ℚ (V I s):ℤ)=(d:ℤ)*(s:ℤ)+e)
    (p:Ideal (aa (Fin n) ℚ ⧸ I)) (hp:p.IsPrime) (hp0:p ≠ ⊥):p.IsMaximal:=by
  classical
  obtain ⟨a,hap,ha0⟩:=Submodule.exists_mem_ne_zero_of_ne_bot hp0
  have hint:∀ b:aa (Fin n) ℚ ⧸ I,∃ q:ar ℚ,q ≠ 0∧ vb b q∈ p:=by
    intro b
    have hex:∃ N,∃ P:ar (ar ℚ),P ≠ 0∧ P.natDegree=N∧ Polynomial.eval₂ (vb b).toRingHom a P=0:=by
      obtain ⟨P,hP0,hP⟩:=gR I d hd e s₀ hHF a b
      exact ⟨_,P,hP0,rfl,hP⟩
    obtain ⟨P,hP0,hPN,hP⟩:=Nat.find_spec hex
    have hc0:P.coeff 0 ≠ 0:=by
      intro hc
      have hX:uR∣ P:=Polynomial.X_dvd_iff.mpr hc
      obtain ⟨Q,hQ⟩:=hX
      have hQ0:Q ≠ 0:=by
        rintro rfl;rw [mul_zero] at hQ;exact hP0 hQ
      have gT:Q.natDegree< Nat.find hex:=by
        rw [← hPN,hQ,Polynomial.natDegree_X_mul hQ0];omega
      have hQev:Polynomial.eval₂ (vb b).toRingHom a Q=0:=by
        rw [hQ,Polynomial.eval₂_mul,Polynomial.eval₂_X] at hP
        exact (mul_eq_zero.mp hP).resolve_left ha0
      exact Nat.find_min hex gT ⟨Q,hQ0,rfl,hQev⟩
    refine ⟨P.coeff 0,hc0,?_⟩
    have gU:=Polynomial.X_mul_divX_add P
    have hev:Polynomial.eval₂ (vb b).toRingHom a P= a*Polynomial.eval₂ (vb b).toRingHom a P.divX+ vb b (P.coeff 0):=by
      conv_lhs=> rw [← gU]
      rw [Polynomial.eval₂_add,Polynomial.eval₂_mul,Polynomial.eval₂_X,Polynomial.eval₂_C]
      rfl
    rw [hP] at hev
    have:vb b (P.coeff 0)= -(a*Polynomial.eval₂ (vb b).toRingHom a P.divX):=by
      linear_combination-hev
    rw [this]
    exact p.neg_mem (p.mul_mem_right _ hap)
  have:p.IsPrime:=hp
  have gV:IsField ((aa (Fin n) ℚ ⧸ I) ⧸ p):=by
    have:Algebra.IsIntegral ℚ ((aa (Fin n) ℚ ⧸ I) ⧸ p):=by
      constructor
      intro x
      obtain ⟨b,rfl⟩:=fx x
      obtain ⟨q,hq0,hq⟩:=hint b
      apply IsAlgebraic.isIntegral
      refine ⟨q,hq0,?_⟩
      have:(Ideal.Quotient.mk p b)=uV ℚ p b:=rfl
      rw [this,Polynomial.aeval_algHom_apply]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hq
    first
      | exact (Algebra.IsIntegral.isField_iff_isField (R:=ℚ)
          (S:=(aa (Fin n) ℚ ⧸ I) ⧸ p) (algebraMap ℚ _).injective).mp (Field.toIsField ℚ)
  exact Ideal.Quotient.maximal_of_isField p gV
lemma gW (d:ℕ) (hd:1≤ d) (e:ℤ) (s₀:ℕ)
    (hHF:∀ s:ℕ,s₀≤ s→(Module.finrank ℚ (V I s):ℤ)=(d:ℤ)*(s:ℤ)+e):
    ¬ IsField (aa (Fin n) ℚ ⧸ I):=by
  intro hF
  let:=hF.toField
  have:Algebra.FiniteType ℚ (aa (Fin n) ℚ ⧸ I):=by
    first
      | exact Algebra.FiniteType.of_surjective (uV ℚ I) (Ideal.Quotient.mkₐ_surjective ℚ I)
  have:Module.Finite ℚ (aa (Fin n) ℚ ⧸ I):= finite_of_finite_type_of_isJacobsonRing ℚ _
  set N:=Module.finrank ℚ (aa (Fin n) ℚ ⧸ I)
  set s:=s₀+N+e.natAbs+1 with hs
  have h1:=hHF s (by omega)
  have h2:Module.finrank ℚ (V I s)≤ N:=Submodule.finrank_le _
  have h3:((Module.finrank ℚ (V I s):ℕ):ℤ)≤(N:ℤ):=by exact_mod_cast h2
  rw [h1] at h3
  have he:-(e.natAbs:ℤ)≤ e:=by omega
  have hs':(s:ℤ)=s₀+N+e.natAbs+1:=by rw [hs];push_cast;ring
  have hd':(1:ℤ)≤ d:=by exact_mod_cast hd
  have hs0:(0:ℤ)≤ s:=by positivity
  have hds:(s:ℤ)≤ d*s:=by nlinarith
