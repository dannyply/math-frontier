lemma gC (k alpha beta:ℕ)
    (hab:2≤ beta∨ k< alpha) (g:aa (Fin 4) ℤ)
    (hdeg:∀ m∈ g.support,m 0+m 1=alpha∧ m 2+m 3=beta)
    (hg:uZ (uJ (uG ℂ) g)):
    IsDomain (ac.Inc (ak g) (az k)):=by
  exact ac.oN (ak g) (az k)
    (cn g hg)
    (gz k alpha beta hab g hdeg hg)
abbrev co (k:ℕ):=aa (Fin (k+1)) ℚ
def aJ (k:ℕ) (g:aa (Fin 4) ℤ)
    (A:Matrix (Fin 2) (Fin 2) ℤ):
    co k→ₐ[ℚ] ac.Inc (ak g) (az k):= let q:=uV ℚ (ac.ideal (ak g) (az k))
  let L0:ac.Five:=C (A 0 0:ℚ)*X 0+C (A 0 1:ℚ)*X 1
  let L1:ac.Five:=C (A 1 0:ℚ)*X 0+C (A 1 1:ℚ)*X 1
  vc (fun i:Fin (k+1)=>
    q (X 4*X 3*L0^(k-i.val)*L1^i.val))
lemma oO (k alpha beta:ℕ)
    (hab:2≤ beta∨ k< alpha) (g:aa (Fin 4) ℤ)
    (hdeg:∀ m∈ g.support,m 0+m 1=alpha∧ m 2+m 3=beta)
    (hg:uZ (uJ (uG ℂ) g))
    (A:Matrix (Fin 2) (Fin 2) ℤ):
    (RingHom.ker (aJ k g A).toRingHom).IsPrime:=by
  let:=gC k alpha beta hab g hdeg hg
  exact RingHom.ker_isPrime (aJ k g A).toRingHom
namespace jS
lemma gD {A:Type*} [CommRing A] [IsDomain A] [Algebra ℚ A]
    (H:A) (hH:H≠0) (U W:Submodule ℚ A) [FiniteDimensional ℚ U]
    (hmem:∀q:A,q∈W↔ H*q∈U):
    Module.finrank ℚ (Submodule.map
      (uV ℚ (a5 ({H}:Set A))).toLinearMap U)+ Module.finrank ℚ W=Module.finrank ℚ U:=by
  let I:=a5 ({H}:Set A)
  let f:U→ₗ[ℚ] A⧸I:=(uV ℚ I).toLinearMap.comp U.subtype
  let mulH:W→ₗ[ℚ] U:=
    { toFun:=fun q=>⟨H*q,(hmem q).mp q.2⟩
      map_add':=by intro x y;apply Subtype.ext;simp [mul_add]
      map_smul':=by intro c x;apply Subtype.ext;simp []}
  have hinj:uX mulH:=by
    intro x y he
    exact Subtype.ext (cC hH (congrArg Subtype.val he))
  have hker:LinearMap.ker f=LinearMap.range mulH:=by
    ext p
    simp only [LinearMap.mem_ker,LinearMap.mem_range]
    constructor
    · intro hp
      have hp':(p:A)∈I:=Ideal.Quotient.eq_zero_iff_mem.mp hp
      rw [ez] at hp'
      obtain ⟨q,hq⟩:=hp'
      refine ⟨⟨q,(hmem q).mpr (hq ▸ p.2)⟩,?_⟩
      exact Subtype.ext hq.symm
    · rintro ⟨q,rfl⟩
      change Ideal.Quotient.mk I (H*(q:A))=0
      rw [Ideal.Quotient.eq_zero_iff_mem,ez]
      exact dvd_mul_right H q
  have ea:LinearMap.range f= Submodule.map (uV ℚ I).toLinearMap U:=by
    rw [LinearMap.range_comp,Submodule.range_subtype]
  have hr:=LinearMap.finrank_range_add_finrank_ker f
  rw [hker,LinearMap.finrank_range_of_inj hinj,ea] at hr
  exact hr
end jS
namespace af
abbrev wG:=aa (Fin 3) ℚ
def wt (k:ℕ):Fin 3→ ℕ:=![1,1,k]
def piece (k n:ℕ):Submodule ℚ wG:=weightedHomogeneousSubmodule ℚ (wt k) n
lemma dJ (k:ℕ) (m:Fin 3→₀ ℕ):
    aK (wt k) m=m 0+m 1+k*m 2:=by
  simp [bG,aD,Fin.sum_univ_succ,wt]
  ring
def cp (k n:ℕ):Set (Fin 3→₀ ℕ):= {m | aK (wt k) m=n}
abbrev Index (k n:ℕ):=(c:Fin (n/k+1))× Fin (n-k*c.val+1)
def gE (k n:ℕ) (hk:0< k):cp k n ≃ Index k n where
  toFun m:=⟨⟨m.1 2,by
    have h:=m.2
    simp only [cp,Set.mem_ofPred_eq,dJ] at h
    have hm:k*m.1 2≤ n:=by omega
    have ul:m.1 2≤ n/k:= (Nat.le_div_iff_mul_le hk).2 (by simpa only [mul_comm] using hm)
    omega⟩,⟨m.1 0,by
      change m.1 0< n-k*(m.1 2)+1
      have h:=m.2
      simp only [cp,Set.mem_ofPred_eq,dJ] at h
      omega⟩⟩
  invFun ij:=⟨Finsupp.equivFunOnFinite.symm
    ![ij.2.val,n-k*ij.1.val-ij.2.val,ij.1.val],by
      simp only [cp,Set.mem_ofPred_eq,dJ]
      have hc:=ij.1.isLt
      have ha:=ij.2.isLt
      have hmul:k*ij.1.val≤ n:=by
        have hle:ij.1.val≤ n/k:=by omega
        have hd:=Nat.mod_add_div n k
        have hm:=u8 k hle
        omega
      simp
      omega⟩
  left_inv m:=by
    obtain ⟨m,hm⟩:=m
    simp only [cp,Set.mem_ofPred_eq,dJ] at hm
    apply Subtype.ext
    ext i
    fin_cases i<;> simp; omega
  right_inv ij:=by
    obtain ⟨c,a⟩:=ij
    rfl
def N (k n:ℕ):ℕ:=∑ c:Fin (n/k+1),(n-k*c.val+1)
lemma jT (k n:ℕ) (hk:0< k):
    Module.finrank ℚ (piece k n)=N k n:=by
  let:Fintype (cp k n):= Fintype.ofEquiv (Index k n) (gE k n hk).symm
  have heq:piece k n=restrictSupport ℚ (cp k n):= weightedHomogeneousSubmodule_eq_finsupp_supported ℚ (wt k) n
  rw [heq]
  have hr:=Module.finrank_eq_card_basis
    (basisRestrictSupport ℚ (cp k n))
  rw [hr,Fintype.card_congr (gE k n hk)]
  simp [N,Fintype.card_sigma]
lemma jU (k n:ℕ) (hk:0< k):
    N k (n+k)=N k n+n+k+1:=by
  unfold N
  have hq:(n+k)/k+1=(n/k+1)+1:=by
    rw [Nat.add_div_right _ hk]
  rw [hq,Fin.sum_univ_succ]
  simp only [Fin.val_zero,Nat.mul_zero,Nat.sub_zero,Fin.val_succ]
  have hs:
      (∑ i:Fin (n/k+1),(n+k-k*(i.val+1)+1))= ∑ i:Fin (n/k+1),(n-k*i.val+1):=by
    apply u4 rfl
    intro i hi
    have hle:i.val≤ n/k:=by omega
    have hmul:k*i.val≤ n:=by
      have hd:=Nat.mod_add_div n k
      have hm:=u8 k hle
      omega
    have cV:k*(i.val+1)=k*i.val+k:=by ring
    rw [cV]
    omega
  rw [hs]
  omega
lemma fS (k:ℕ) (H q:wG) (L n:ℕ)
    (hH:uK (wt k) H L) (hH0:H ≠ 0)
    (hp:uK (wt k) (H*q) n):
    uK (wt k) q (n-L):=by
  by_cases hq:q=0
  · subst q
    intro m hm
    simp at hm
  obtain ⟨a,b,hab,hHa,hqb⟩:= gx.cX hp (aV hH0 hq)
  have hLa:L=a:=IsWeightedHomogeneous.inj_right hH0 hH hHa
  have hb:b=n-L:=by omega
  simpa only [hb] using hqb
def Qrank (k:ℕ) (H:wG) (n:ℕ):ℕ:= Module.finrank ℚ
    (Submodule.map
      (uV ℚ (a5 ({H}:Set wG))).toLinearMap (piece k n))
lemma jV (k:ℕ) (hk:0< k) (H:wG) (L n:ℕ)
    (hH:uK (wt k) H L) (hH0:H ≠ 0) (hLn:L≤ n):
    Qrank k H n+N k (n-L)=N k n:=by
  let:Fintype (cp k n):= Fintype.ofEquiv (Index k n) (gE k n hk).symm
  have heq:piece k n=restrictSupport ℚ (cp k n):= weightedHomogeneousSubmodule_eq_finsupp_supported ℚ (wt k) n
  have hf:Module.Finite ℚ (piece k n):=by
    rw [heq]
    exact Module.Finite.of_basis (basisRestrictSupport ℚ (cp k n))
  let:=hf
  have hmem (q:wG):q∈ piece k (n-L)↔ H*q∈ piece k n:=by
    constructor
    · intro hq
      have hh:=hH.mul ((mem_weightedHomogeneousSubmodule ℚ (wt k) (n-L) q).mp hq)
      change uK (wt k) (H*q) n
      convert hh using 1; omega
    · intro hq
      exact fS k H q L n hH hH0
        ((mem_weightedHomogeneousSubmodule ℚ (wt k) n (H*q)).mp hq)
  have hr:=jS.gD H hH0
    (piece k n) (piece k (n-L)) hmem
  rw [jT k n hk,jT k (n-L) hk] at hr
  exact hr
lemma oP (k:ℕ) (hk:0< k) (H:wG) (L m:ℕ)
    (hH:uK (wt k) H L) (hH0:H ≠ 0) (hLm:L≤ k*m):
    Qrank k H (k*(m+1))=Qrank k H (k*m)+L:=by
  have h1:=jV k hk H L (k*m) hH hH0 hLm
  have h2:=jV k hk H L (k*(m+1)) hH hH0 (by
    have:k*m≤ k*(m+1):=u8 k (by omega)
    omega)
  have hn:N k (k*(m+1))=N k (k*m)+k*m+k+1:=by
    simpa only [Nat.mul_add,Nat.mul_one] using jU k (k*m) hk
  have hs:k*(m+1)-L=(k*m-L)+k:=by
    have ht:k*(m+1)=k*m+k:=by ring
    omega
  rw [hn,hs,jU k (k*m-L) hk] at h2
  omega
lemma oQ (k:ℕ) (hk:0< k) (H:wG) (L:ℕ)
    (hH:uK (wt k) H L) (hH0:H ≠ 0):
    ∃ b:ℤ,∀ m:ℕ,L≤ m→ (Qrank k H (k*m):ℤ)=(L:ℤ)*m+b:=by
  refine ⟨(Qrank k H (k*L):ℤ)-(L:ℤ)*L,?_⟩
  intro m hm
  induction m,hm using Nat.le_induction with
  | base=> ring
  | succ m hm ih=>
      have hr:=oP k hk H L m hH hH0 (by
        have hkm:m≤ k*m:=by nlinarith
        omega)
      rw [hr,Nat.cast_add,ih,Nat.cast_add,cF]
      ring
end af
