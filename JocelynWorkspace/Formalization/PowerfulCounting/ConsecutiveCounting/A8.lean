      obtain ⟨c', -, hcu⟩ := MvPolynomial.isUnit_iff_eq_C_of_isReduced.mp u.isUnit
      rw [hcu, MvPolynomial.totalDegree_C]
    have := congrArg MvPolynomial.totalDegree hu
    rw [MvPolynomial.totalDegree_mul_of_isDomain hp0 hu0, hut, add_zero] at this
    exact this
  rw [← htdF, ← h4, ← h3]
  exact h2

theorem absIrred_normal (F G : MvPolynomial (Fin 4) ℤ) (hF0 : F ≠ 0) (hGF : G ∣ F)
    (hG0 : G ≠ 0) (hirr : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G)) :
    ∃ q ∈ UniqueFactorizationMonoid.factors F, q.totalDegree ≠ 0 ∧
      (∀ w : Fin 4 → ℤ, MvPolynomial.eval w G = 0 → MvPolynomial.eval w q = 0) ∧
      (∀ m ∈ q.support, m ∈ G.support) ∧
      Irreducible (MvPolynomial.map (Int.castRingHom ℂ) q) := by
  classical
  have hinj : Function.Injective (Int.castRingHom ℂ) := (Int.castRingHom ℂ).injective_int
  have htdmap : ∀ P : MvPolynomial (Fin 4) ℤ,
      (MvPolynomial.map (Int.castRingHom ℂ) P).totalDegree = P.totalDegree := by
    intro P
    unfold MvPolynomial.totalDegree
    rw [MvPolynomial.support_map_of_injective P hinj]
  have hunit_td : ∀ P : MvPolynomial (Fin 4) ℂ, IsUnit P → P.totalDegree = 0 := by
    intro P hP
    obtain ⟨c, -, hc⟩ := MvPolynomial.isUnit_iff_eq_C_of_isReduced.mp hP
    rw [hc, MvPolynomial.totalDegree_C]
  have hGtd : G.totalDegree ≠ 0 := by
    intro h
    have hGC := (MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp h
    have hc0 : G.coeff 0 ≠ 0 := by
      intro hc
      apply hG0
      rw [hGC, hc, map_zero]
    apply hirr.not_isUnit
    rw [hGC, MvPolynomial.map_C]
    exact (Ne.isUnit (fun h' => hc0 (hinj (h'.trans (map_zero _).symm)))).map MvPolynomial.C
  obtain ⟨uG, huG⟩ := UniqueFactorizationMonoid.factors_prod hG0
  have hneG : ∀ g ∈ UniqueFactorizationMonoid.factors G, g ≠ 0 :=
    fun g hg => (UniqueFactorizationMonoid.irreducible_of_factor g hg).ne_zero
  have h3 : ((UniqueFactorizationMonoid.factors G).map MvPolynomial.totalDegree).sum =
      (UniqueFactorizationMonoid.factors G).prod.totalDegree :=
    (totalDegree_prod_eq _ hneG).symm
  have h4 : (UniqueFactorizationMonoid.factors G).prod.totalDegree = G.totalDegree := by
    have hu0 : (uG : MvPolynomial (Fin 4) ℤ) ≠ 0 := uG.ne_zero
    have hp0 : (UniqueFactorizationMonoid.factors G).prod ≠ 0 :=
      Multiset.prod_ne_zero (fun h => hneG 0 h rfl)
    have hut : (uG : MvPolynomial (Fin 4) ℤ).totalDegree = 0 := by
      obtain ⟨c', -, hcu⟩ := MvPolynomial.isUnit_iff_eq_C_of_isReduced.mp uG.isUnit
      rw [hcu, MvPolynomial.totalDegree_C]
    have := congrArg MvPolynomial.totalDegree huG
    rw [MvPolynomial.totalDegree_mul_of_isDomain hp0 hu0, hut, add_zero] at this
    exact this
  have hex : ∃ p ∈ UniqueFactorizationMonoid.factors G, p.totalDegree ≠ 0 := by
    by_contra hcon
    push Not at hcon
    apply hGtd
    rw [← h4, ← h3]
    apply Multiset.sum_eq_zero
    intro t ht
    obtain ⟨p, hp, rfl⟩ := Multiset.mem_map.mp ht
    exact hcon p hp
  obtain ⟨p, hpG, hptd⟩ := hex
  have hpirr : Irreducible p := UniqueFactorizationMonoid.irreducible_of_factor p hpG
  have hp0 : p ≠ 0 := hpirr.ne_zero
  obtain ⟨r, hr⟩ := UniqueFactorizationMonoid.dvd_of_mem_factors hpG
  have hmap : MvPolynomial.map (Int.castRingHom ℂ) G =
      MvPolynomial.map (Int.castRingHom ℂ) p * MvPolynomial.map (Int.castRingHom ℂ) r := by
    rw [hr, map_mul]
  have hrunit : IsUnit (MvPolynomial.map (Int.castRingHom ℂ) r) := by
    rcases hirr.isUnit_or_isUnit hmap with hu | hu
    · exfalso
      apply hptd
      rw [← htdmap p]
      exact hunit_td _ hu
    · exact hu
  have hrtd : r.totalDegree = 0 := by
    rw [← htdmap r]
    exact hunit_td _ hrunit
  have hrC : r = MvPolynomial.C (r.coeff 0) := (MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp hrtd
  have hc0 : r.coeff 0 ≠ 0 := by
    intro h0
    apply hG0
    rw [hr, hrC, h0, map_zero, mul_zero]
  have hG : G = p * MvPolynomial.C (r.coeff 0) := by
    rw [hr]
    exact congrArg (fun t => p * t) hrC
  have hpF : p ∣ F := dvd_trans ⟨r, hr⟩ hGF
  obtain ⟨q, hqF, hpq⟩ := UniqueFactorizationMonoid.exists_mem_factors_of_dvd hF0 hpirr hpF
  obtain ⟨u, hu⟩ := hpq
  obtain ⟨v, hvunit, hvC⟩ := MvPolynomial.isUnit_iff_eq_C_of_isReduced.mp u.isUnit
  have hv0 : v ≠ 0 := hvunit.ne_zero
  have hq : q = p * MvPolynomial.C v := by
    rw [← hu, hvC]
  have hCv0 : (MvPolynomial.C v : MvPolynomial (Fin 4) ℤ) ≠ 0 := by
    intro h
    apply hv0
    have := congrArg (MvPolynomial.coeff 0) h
    rw [MvPolynomial.coeff_zero_C, MvPolynomial.coeff_zero] at this
    exact this
  have hqtd : q.totalDegree ≠ 0 := by
    rw [hq, MvPolynomial.totalDegree_mul_of_isDomain hp0 hCv0, MvPolynomial.totalDegree_C,
      add_zero]
    exact hptd
  have heval : ∀ w : Fin 4 → ℤ, MvPolynomial.eval w G = 0 → MvPolynomial.eval w q = 0 := by
    intro w hw
    rw [hG, map_mul, MvPolynomial.eval_C] at hw
    have hpw : MvPolynomial.eval w p = 0 := (mul_eq_zero.mp hw).resolve_right hc0
    rw [hq, map_mul, MvPolynomial.eval_C, hpw, zero_mul]
  have hsupp : ∀ m ∈ q.support, m ∈ G.support := by
    intro m hm
    rw [MvPolynomial.mem_support_iff] at hm ⊢
    rw [hq, mul_comm, MvPolynomial.coeff_C_mul] at hm
    rw [hG, mul_comm, MvPolynomial.coeff_C_mul]
    exact mul_ne_zero hc0 (right_ne_zero_of_mul hm)
  have hcU : IsUnit (MvPolynomial.C ((Int.castRingHom ℂ) (r.coeff 0)) :
      MvPolynomial (Fin 4) ℂ) :=
    (Ne.isUnit (fun h => hc0 (hinj (h.trans (map_zero _).symm)))).map MvPolynomial.C
  have hvU : IsUnit (MvPolynomial.C ((Int.castRingHom ℂ) v) : MvPolynomial (Fin 4) ℂ) :=
    (Ne.isUnit (fun h => hv0 (hinj (h.trans (map_zero _).symm)))).map MvPolynomial.C
  have hmapG : MvPolynomial.map (Int.castRingHom ℂ) G =
      MvPolynomial.map (Int.castRingHom ℂ) p *
        MvPolynomial.C ((Int.castRingHom ℂ) (r.coeff 0)) := by
    rw [hG, map_mul, MvPolynomial.map_C]
  have hmapq : MvPolynomial.map (Int.castRingHom ℂ) q =
      MvPolynomial.map (Int.castRingHom ℂ) p * MvPolynomial.C ((Int.castRingHom ℂ) v) := by
    rw [hq, map_mul, MvPolynomial.map_C]
  have hirrp : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) p) := by
    rw [hmapG] at hirr
    exact (irreducible_mul_isUnit hcU).mp hirr
  have hirrq : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) q) := by
    rw [hmapq]
    exact (irreducible_mul_isUnit hvU).mpr hirrp
  exact ⟨q, hqF, hqtd, heval, hsupp, hirrq⟩

