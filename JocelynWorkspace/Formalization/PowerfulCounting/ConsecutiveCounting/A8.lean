theorem rd_bound (D E M x s : ℝ) (hD : 0 < D) (hE : 0 < E) (hMpos : 0 < M) (hx0 : 0 < x)
    (hDE : D * E = x ^ s)
    (hDlt : Real.log D < Real.log E + Real.log M) (hElt : Real.log E < Real.log D + Real.log M) :
    0 < D * E + (D ^ 2 + E ^ 2) / M ∧
      Real.log (D * E + (D ^ 2 + E ^ 2) / M) ≤ Real.log 3 + s * Real.log x := by
  have hDEM : D < E * M :=
    (Real.log_lt_log_iff hD (mul_pos hE hMpos)).1
      (by rw [Real.log_mul hE.ne' hMpos.ne']; exact hDlt)
  have hEDM : E < D * M :=
    (Real.log_lt_log_iff hE (mul_pos hD hMpos)).1
      (by rw [Real.log_mul hD.ne' hMpos.ne']; exact hElt)
  have hle : D * E + (D ^ 2 + E ^ 2) / M ≤ 3 * (D * E) := by
    have a := mul_lt_mul_of_pos_left hDEM hD
    have b := mul_lt_mul_of_pos_left hEDM hE
    have h1 : D ^ 2 + E ^ 2 ≤ 2 * (D * E) * M := by nlinarith
    have h2 : (D ^ 2 + E ^ 2) / M ≤ 2 * (D * E) := by
      rw [div_le_iff₀ hMpos]; linarith
    linarith
  have hpos : 0 < D * E + (D ^ 2 + E ^ 2) / M := by positivity
  refine ⟨hpos, ?_⟩
  have h := Real.log_le_log hpos hle
  have e : Real.log (D * E) = s * Real.log x := by rw [hDE, Real.log_rpow hx0]
  rw [Real.log_mul (by norm_num : (3 : ℝ) ≠ 0) (mul_pos hD hE).ne', e] at h
  exact h

theorem ru_bal (k : ℕ) (K x D E M s : ℝ) (hKk : K = (k : ℝ)) (hD : 0 < D) (hE : 0 < E)
    (hMpos : 0 < M) (hM1 : 1 ≤ M) (hx0 : 0 < x)
    (hlDE : Real.log D + Real.log E = s * Real.log x)
    (hA : ¬ (M * min D E ^ k < max D E ^ k)) :
    Real.log (x / D ^ k * (x / E ^ k) + ((x / D ^ k) ^ 2 + (x / E ^ k) ^ 2) / M) ≤
      Real.log 3 + 2 * Real.log x - K * (s * Real.log x) := by
  have hDk : 0 < D ^ k := pow_pos hD k
  have hEk : 0 < E ^ k := pow_pos hE k
  have hU : 0 < x / D ^ k := div_pos hx0 hDk
  have hV : 0 < x / E ^ k := div_pos hx0 hEk
  have hlU : Real.log (x / D ^ k) = Real.log x - K * Real.log D := by
    rw [log_div_pow k hx0 hD, hKk]
  have hlV : Real.log (x / E ^ k) = Real.log x - K * Real.log E := by
    rw [log_div_pow k hx0 hE, hKk]
  have hA' : max D E ^ k ≤ M * min D E ^ k := not_lt.mp hA
  have hc1' : E ^ k ≤ M * D ^ k := by
    rcases le_total D E with h | h
    · rw [max_eq_right h, min_eq_left h] at hA'; exact hA'
    · have h4 : E ^ k ≤ D ^ k := pow_le_pow_left₀ hE.le h k
      have h5 : 1 * D ^ k ≤ M * D ^ k := mul_le_mul_of_nonneg_right hM1 hDk.le
      linarith
  have hc2' : D ^ k ≤ M * E ^ k := by
    rcases le_total D E with h | h
    · have h4 : D ^ k ≤ E ^ k := pow_le_pow_left₀ hD.le h k
      have h5 : 1 * E ^ k ≤ M * E ^ k := mul_le_mul_of_nonneg_right hM1 hEk.le
      linarith
    · rw [max_eq_left h, min_eq_right h] at hA'; exact hA'
  have hUle : x / D ^ k ≤ M * (x / E ^ k) := by
    have h := Real.log_le_log hEk hc1'
    rw [Real.log_pow, Real.log_mul hMpos.ne' hDk.ne', Real.log_pow, ← hKk] at h
    apply (Real.log_le_log_iff hU (mul_pos hMpos hV)).1
    rw [Real.log_mul hMpos.ne' hV.ne', hlU, hlV]
    linarith
  have hVle : x / E ^ k ≤ M * (x / D ^ k) := by
    have h := Real.log_le_log hDk hc2'
    rw [Real.log_pow, Real.log_mul hMpos.ne' hEk.ne', Real.log_pow, ← hKk] at h
    apply (Real.log_le_log_iff hV (mul_pos hMpos hU)).1
    rw [Real.log_mul hMpos.ne' hU.ne', hlU, hlV]
    linarith
  have hRUpos : 0 < x / D ^ k * (x / E ^ k) + ((x / D ^ k) ^ 2 + (x / E ^ k) ^ 2) / M := by
    positivity
  have hRU_le : x / D ^ k * (x / E ^ k) + ((x / D ^ k) ^ 2 + (x / E ^ k) ^ 2) / M ≤
      3 * (x / D ^ k * (x / E ^ k)) := by
    have a := mul_le_mul_of_nonneg_left hUle hU.le
    have b := mul_le_mul_of_nonneg_left hVle hV.le
    have h1 : (x / D ^ k) ^ 2 + (x / E ^ k) ^ 2 ≤ 2 * M * (x / D ^ k * (x / E ^ k)) := by
      nlinarith
    have h2 : ((x / D ^ k) ^ 2 + (x / E ^ k) ^ 2) / M ≤ 2 * (x / D ^ k * (x / E ^ k)) := by
      rw [div_le_iff₀ hMpos]; linarith
    linarith
  have h := Real.log_le_log hRUpos hRU_le
  rw [Real.log_mul (by norm_num : (3 : ℝ) ≠ 0) (mul_pos hU hV).ne',
    Real.log_mul hU.ne' hV.ne', hlU, hlV] at h
  have eKs : K * (Real.log D + Real.log E) = K * (s * Real.log x) := by rw [hlDE]
  linarith

theorem ru_unb (k : ℕ) (K x D E M s : ℝ) (hKk : K = (k : ℝ)) (hK0 : 0 < K) (hD : 0 < D)
    (hE : 0 < E) (hMpos : 0 < M) (hx0 : 0 < x)
    (hlDE : Real.log D + Real.log E = s * Real.log x)
    (hB : M * min D E ^ k < max D E ^ k) :
    ∃ la lb : ℝ, la + lb = s * Real.log x ∧
      Real.log M + K * la < K * lb ∧
      Real.log (x / D ^ k * (x / E ^ k) + ((x / D ^ k) ^ 2 + (x / E ^ k) ^ 2) / M) ≤
        Real.log 3 + 2 * (Real.log x - K * la) - Real.log M ∧
      Real.log (x / max D E ^ k) = Real.log x - K * lb := by
  have hDk : 0 < D ^ k := pow_pos hD k
  have hEk : 0 < E ^ k := pow_pos hE k
  have hU : 0 < x / D ^ k := div_pos hx0 hDk
  have hV : 0 < x / E ^ k := div_pos hx0 hEk
  have hlU : Real.log (x / D ^ k) = Real.log x - K * Real.log D := by
    rw [log_div_pow k hx0 hD, hKk]
  have hlV : Real.log (x / E ^ k) = Real.log x - K * Real.log E := by
    rw [log_div_pow k hx0 hE, hKk]
  have hRUpos : 0 < x / D ^ k * (x / E ^ k) + ((x / D ^ k) ^ 2 + (x / E ^ k) ^ 2) / M := by
    positivity
  rcases le_total D E with h | h
  · rw [max_eq_right h, min_eq_left h] at hB
    have h1 := Real.log_lt_log (mul_pos hMpos hDk) hB
    rw [Real.log_mul hMpos.ne' hDk.ne', Real.log_pow, Real.log_pow, ← hKk] at h1
    refine ⟨Real.log D, Real.log E, hlDE, h1, ?_, by rw [max_eq_right h]; exact hlV⟩
    have hVU : x / E ^ k ≤ x / D ^ k := by
      apply (Real.log_le_log_iff hV hU).1
      rw [hlU, hlV]
      have h0 : Real.log D ≤ Real.log E := Real.log_le_log hD h
      have : K * Real.log D ≤ K * Real.log E := mul_le_mul_of_nonneg_left h0 hK0.le
      linarith
    have hMV : M * (x / E ^ k) ≤ x / D ^ k := by
      apply (Real.log_le_log_iff (mul_pos hMpos hV) hU).1
      rw [Real.log_mul hMpos.ne' hV.ne', hlU, hlV]
      linarith
    have hRU_le : x / D ^ k * (x / E ^ k) + ((x / D ^ k) ^ 2 + (x / E ^ k) ^ 2) / M ≤
        3 * (x / D ^ k) ^ 2 / M := by
      have g1 : x / D ^ k * (x / E ^ k) ≤ (x / D ^ k) ^ 2 / M := by
        rw [le_div_iff₀ hMpos]
        have a := mul_le_mul_of_nonneg_left hMV hU.le
        nlinarith
      have g2 : ((x / D ^ k) ^ 2 + (x / E ^ k) ^ 2) / M ≤ 2 * (x / D ^ k) ^ 2 / M := by
        have h3 : (x / E ^ k) ^ 2 ≤ (x / D ^ k) ^ 2 := pow_le_pow_left₀ hV.le hVU 2
        have h4 : (x / D ^ k) ^ 2 + (x / E ^ k) ^ 2 ≤ 2 * (x / D ^ k) ^ 2 := by linarith
        gcongr
      have g3 : 3 * (x / D ^ k) ^ 2 / M = (x / D ^ k) ^ 2 / M + 2 * (x / D ^ k) ^ 2 / M := by
        ring
      linarith
    have hU2 : 0 < (x / D ^ k) ^ 2 := pow_pos hU 2
    have h3U2 : 0 < 3 * (x / D ^ k) ^ 2 := by positivity
    have h2 := Real.log_le_log hRUpos hRU_le
    rw [Real.log_div h3U2.ne' hMpos.ne', Real.log_mul (by norm_num : (3 : ℝ) ≠ 0) hU2.ne',
      Real.log_pow, hlU] at h2
    push_cast at h2
    linarith
  · rw [max_eq_left h, min_eq_right h] at hB
    have h1 := Real.log_lt_log (mul_pos hMpos hEk) hB
    rw [Real.log_mul hMpos.ne' hEk.ne', Real.log_pow, Real.log_pow, ← hKk] at h1
    refine ⟨Real.log E, Real.log D, by linarith, h1, ?_, by rw [max_eq_left h]; exact hlU⟩
    have hUV : x / D ^ k ≤ x / E ^ k := by
      apply (Real.log_le_log_iff hU hV).1
      rw [hlU, hlV]
      have h0 : Real.log E ≤ Real.log D := Real.log_le_log hE h
      have : K * Real.log E ≤ K * Real.log D := mul_le_mul_of_nonneg_left h0 hK0.le
      linarith
    have hMU : M * (x / D ^ k) ≤ x / E ^ k := by
      apply (Real.log_le_log_iff (mul_pos hMpos hU) hV).1
      rw [Real.log_mul hMpos.ne' hU.ne', hlU, hlV]
      linarith
    have hRU_le : x / D ^ k * (x / E ^ k) + ((x / D ^ k) ^ 2 + (x / E ^ k) ^ 2) / M ≤
        3 * (x / E ^ k) ^ 2 / M := by
      have g1 : x / D ^ k * (x / E ^ k) ≤ (x / E ^ k) ^ 2 / M := by
        rw [le_div_iff₀ hMpos]
        have a := mul_le_mul_of_nonneg_left hMU hV.le
        nlinarith
      have g2 : ((x / D ^ k) ^ 2 + (x / E ^ k) ^ 2) / M ≤ 2 * (x / E ^ k) ^ 2 / M := by
        have h3 : (x / D ^ k) ^ 2 ≤ (x / E ^ k) ^ 2 := pow_le_pow_left₀ hU.le hUV 2
        have h4 : (x / D ^ k) ^ 2 + (x / E ^ k) ^ 2 ≤ 2 * (x / E ^ k) ^ 2 := by linarith
        gcongr
      have g3 : 3 * (x / E ^ k) ^ 2 / M = (x / E ^ k) ^ 2 / M + 2 * (x / E ^ k) ^ 2 / M := by
        ring
      linarith
    have hV2 : 0 < (x / E ^ k) ^ 2 := pow_pos hV 2
    have h3V2 : 0 < 3 * (x / E ^ k) ^ 2 := by positivity
    have h2 := Real.log_le_log hRUpos hRU_le
    rw [Real.log_div h3V2.ne' hMpos.ne', Real.log_mul (by norm_num : (3 : ℝ) ≠ 0) hV2.ne',
      Real.log_pow, hlV] at h2
    push_cast at h2
    linarith

