        ((A8HighFPriceCellTuple.rhoK D E M j)^k)
        (2*U) (col q.P 0) := by
    exact A8HighFPriceMomentScaling.cofactor_side_nominalK
      k M U V ((A8HighFPriceCellTuple.rhoK D E M j)^k) hU hV (col q.P 0)
  have hLcap : L≤ x^2 := by
    have ht := A8HighFPriceMoments.length_pos_cap 4 D E M
