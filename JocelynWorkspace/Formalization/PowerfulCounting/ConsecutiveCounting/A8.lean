    exact dC
  refine ⟨p,hp,?_⟩
  have hX (i:Fin (k+1)):
      bj k d e tau (X i)=d^(k-i.val)*e^i.val*tau⁻¹:=by
    simp [bj]
  have pc:
      bj k d e tau core= d^(k*s0+(k-r)*c)*e^(r*c+k*q)*tau⁻¹^(s0+c+q):=by
    dsimp [core]
    simp only [map_mul,map_pow,hX,hi0,hir,hik,Nat.sub_zero,Nat.sub_self,pow_zero,one_mul,mul_one]
    simp only [mul_pow,pow_mul,pow_add]
