theorem affine_price_budget (u v r B : ℝ)
    (hu : 0≤u) (hv : 0≤v) (hr : 0≤r) (hB : 0≤B) :
    u+v*r≤(u+v)*(1+r+B) := by
  calc
    u+v*r=u*1+v*r := by ring
    _≤u*(1+r+B)+v*(1+r+B) := add_le_add
      (mul_le_mul_of_nonneg_left (by linarith) hu)
      (mul_le_mul_of_nonneg_left (by linarith) hv)
    _=(u+v)*(1+r+B) := by ring

theorem raw_width_remove_modulus
    (Z M L H W : ℝ) (hZ : 0≤Z) (hM : 0<M) (hL : 0<L) (hH : 0<H) (hW : 1≤W) :
    Z/(M*L*H*W)≤Z/(M*L*H) := by
  have hden : M*L*H≤M*L*H*W :=
    le_mul_of_one_le_right (by positivity) hW
  exact div_le_div_of_nonneg_left hZ (by positivity) hden

theorem raw_width_nonrich_bound
    (D E M L H W C0 : ℝ) (hD : 0<D) (hE : 0<E) (hM : 0<M) (hL : 0<L)
    (hH : 1≤H) (hW : 1≤W) (hthin : D*E≤C0*L*max D E) :
    D*E/(M*L*H*W)≤C0*max D E/M := by
  have hML : 0<M*L := mul_pos hM hL
  have hh1 : M*L≤M*L*H := le_mul_of_one_le_right hML.le hH
  have hh2 : M*L*H≤M*L*H*W :=
    le_mul_of_one_le_right (by positivity) hW
  calc
    D*E/(M*L*H*W)≤D*E/(M*L) :=
      div_le_div_of_nonneg_left (by positivity) hML (hh1.trans hh2)
    _≤C0*max D E/M := by
      apply (div_le_iff₀ hML).2
      have heq : C0*max D E/M*(M*L)=C0*L*max D E := by
        field_simp [hM.ne']
        <;> ring
      rw [heq]
      exact hthin

end
end A8FloorExt

