  have hU : U.derivative = 2 := by dsimp [U]; simp
  have hD := congrArg derivative hG
  simp only [derivative_mul,hW,hU,derivative_C,zero_mul,zero_add] at hD
  have hA : A.derivative = C lam := by simp [A]
