      linarith
  have hreg : ∀ n ∈ vals (-P) x ∪ vals (P - Polynomial.C 1) x, 1 ≤ n ∧ (n : ℝ) ≤ x := by
    intro n hn
    have hnI : n ∈ Finset.Icc 1 ⌊x⌋₊ := by
