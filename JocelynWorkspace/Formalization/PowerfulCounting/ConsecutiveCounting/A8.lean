namespace OSNongeomK

theorem unit_coprime_k (a b : ℕ) (h : ℤ)
    (hsign : h = 1 ∨ h = -1) (heq : (a : ℤ) = (b : ℤ) + h) :
    a.Coprime b := by
  apply Nat.coprime_of_dvd'
  intro p hp hpa hpb
  have haZ : (p : ℤ) ∣ (a : ℤ) := by exact_mod_cast hpa
  have hbZ : (p : ℤ) ∣ (b : ℤ) := by exact_mod_cast hpb
  have hph : (p : ℤ) ∣ h := by
    have hh : h = (a : ℤ) - (b : ℤ) := by omega
    rw [hh]
    exact dvd_sub haZ hbZ
  rcases hsign with rfl | rfl
  · exact_mod_cast hph
  · have hp1 : (p : ℤ) ∣ (1 : ℤ) := by
      simpa using (dvd_neg.mpr hph : (p : ℤ) ∣ -(-1 : ℤ))
    exact_mod_cast hp1

theorem both_coprime_k (k : ℕ) (hk : 1 ≤ k) (d e u v : ℕ) (h : ℤ)
    (hsign : h = 1 ∨ h = -1)
    (hshift : ((e ^ k * v : ℕ) : ℤ) = ((d ^ k * u : ℕ) : ℤ) + h) :
    d.Coprime e ∧ u.Coprime v := by
  have hn := (unit_coprime_k (e ^ k * v) (d ^ k * u) h hsign hshift).symm
  have hdvd : d ∣ d ^ k * u := Dvd.dvd.mul_right (dvd_pow_self d (by omega)) u
  have hevd : e ∣ e ^ k * v := Dvd.dvd.mul_right (dvd_pow_self e (by omega)) v
  have huvd : u ∣ d ^ k * u := ⟨d ^ k, by ring⟩
  have hvvd : v ∣ e ^ k * v := ⟨e ^ k, by ring⟩
  exact ⟨hn.of_dvd hdvd hevd, hn.of_dvd huvd hvvd⟩

theorem coprime_rat_div_unique_k (a b c d : ℕ)
    (ha : 1 ≤ a) (hb : 1 ≤ b) (hd : 1 ≤ d)
    (hab : a.Coprime b) (hcd : c.Coprime d)
    (hr : (a : ℚ) / (b : ℚ) = (c : ℚ) / (d : ℚ)) :
    a = c ∧ b = d := by
  have hb0 : (b : ℚ) ≠ 0 := by exact_mod_cast (by omega : b ≠ 0)
  have hd0 : (d : ℚ) ≠ 0 := by exact_mod_cast (by omega : d ≠ 0)
  have hcross : a * d = c * b := by
    exact_mod_cast (div_eq_div_iff hb0 hd0).mp hr
  have hac : a ∣ c := hab.dvd_of_dvd_mul_right ⟨d, hcross.symm⟩
  have hca : c ∣ a := hcd.dvd_of_dvd_mul_right ⟨b, hcross⟩
  have heq : a = c := Nat.dvd_antisymm hac hca
  subst c
  have hbd : d = b := Nat.eq_of_mul_eq_mul_left (by omega : 0 < a) hcross
  exact ⟨rfl, hbd.symm⟩

theorem original_ratio_injective_k (k : ℕ) (hk : 1 ≤ k) :
∀ h : ℤ, (h = 1 ∨ h = -1) →
  ∀ d e u v d' e' u' v' : ℕ,
    1 ≤ d → 1 ≤ e → 1 ≤ u → 1 ≤ v →
    1 ≤ d' → 1 ≤ e' → 1 ≤ u' → 1 ≤ v' →
    ((e ^ k * v : ℕ) : ℤ) = ((d ^ k * u : ℕ) : ℤ) + h →
    ((e' ^ k * v' : ℕ) : ℤ) = ((d' ^ k * u' : ℕ) : ℤ) + h →
    (d : ℚ) / (e : ℚ) = (d' : ℚ) / (e' : ℚ) →
    (v : ℚ) / (u : ℚ) = (v' : ℚ) / (u' : ℚ) →
    d = d' ∧ e = e' ∧ u = u' ∧ v = v' := by
  intro h hsign d e u v d' e' u' v' hd he hu hv hd' he' hu' hv' hs hs' hr1 hr2
  have hc := both_coprime_k k hk d e u v h hsign hs
  have hc' := both_coprime_k k hk d' e' u' v' h hsign hs'
  obtain ⟨hdd, hee⟩ := coprime_rat_div_unique_k d e d' e' hd he he' hc.1 hc'.1 hr1
  obtain ⟨hvv, huu⟩ := coprime_rat_div_unique_k v u v' u' hv hu hu' hc.2.symm hc'.2.symm hr2
  exact ⟨hdd, hee, huu, hvv⟩

open MvPolynomial

theorem eval_monomial_k' {K : Type*} [Field K] (x : Fin 4 → K)
    (m : Fin 4 →₀ ℕ) (c : K) :
    MvPolynomial.eval x (monomial m c) = c * m.prod (fun i n => x i ^ n) := by
  exact MvPolynomial.eval₂Hom_monomial (RingHom.id K) x m c

theorem eval_monomial_two_k {K : Type*} [Field K] (x : Fin 2 → K)
    (m : Fin 2 →₀ ℕ) (c : K) :
    MvPolynomial.eval x (monomial m c) = c * m.prod (fun i n => x i ^ n) := by
  exact MvPolynomial.eval₂Hom_monomial (RingHom.id K) x m c

theorem eval_dehom_scaled_k {K : Type*} [Field K]
    (G : MvPolynomial (Fin 4) K) (a b : ℕ)
    (hG : A5NongeometricDehomCore.Bihom G a b) (x : Fin 4 → K)
    (hx1 : x 1 ≠ 0) (hx2 : x 2 ≠ 0) :
    MvPolynomial.eval x G =
      x 1 ^ a * x 2 ^ b *
        MvPolynomial.eval ![x 0 / x 1, x 3 / x 2]
          (A5NongeometricDehom.dehom G) := by
  classical
  conv_lhs => rw [G.as_sum]
  rw [map_sum]
  conv_rhs => rw [G.as_sum]
  rw [map_sum,map_sum,Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro m hm
  rw [A5NongeometricDehom.dehom_monomial,eval_monomial_k',eval_monomial_two_k]
  rw [Finsupp.prod_fintype _ _ (by intro i; simp),
    Finsupp.prod_fintype _ _ (by intro i; simp)]
  simp only [Fin.prod_univ_four,Fin.prod_univ_two,A5NongeometricDehom.proj,
    Finsupp.add_apply,Finsupp.single_apply,Fin.reduceEq,ite_true,ite_false,
    zero_add,add_zero]
  dsimp
  obtain ⟨ha,hb⟩ := hG m hm
  rw [← ha,← hb,pow_add,pow_add,div_pow,div_pow]
  field_simp [hx1,hx2] <;> ring

theorem eval_int_cast_k (G : MvPolynomial (Fin 4) ℤ) (x : Fin 4 → ℤ) :
    MvPolynomial.eval (fun i => (x i : ℚ))
        (MvPolynomial.map (Int.castRingHom ℚ) G) =
      ((MvPolynomial.eval x G : ℤ) : ℚ) := by
  induction G using MvPolynomial.induction_on with
  | C c => simp only [MvPolynomial.map_C,MvPolynomial.eval_C] <;> rfl
  | add G H hG hH =>
    simp only [map_add,MvPolynomial.eval_add,Int.cast_add,hG,hH]
  | mul_X G n hG =>
    simp only [map_mul,MvPolynomial.map_X,MvPolynomial.eval_mul,
      MvPolynomial.eval_X,Int.cast_mul,hG]

theorem original_count_k :
∀ k : ℕ, 1 ≤ k → ∀ D : ℕ, 1 ≤ D →
    ∃ C_D : ℝ, 1 ≤ C_D ∧
      ∀ α β : ℕ, 1 ≤ α + β → α + β ≤ D →
        ∀ G : MvPolynomial (Fin 4) ℤ,
          (∀ m ∈ G.support,
            m 0 + m 1 = α ∧ m 2 + m 3 = β) →
          Irreducible G →
          ¬ Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G) →
          ∀ h : ℤ, (h = 1 ∨ h = -1) →
            let S : Set ((ℕ × ℕ) × (ℕ × ℕ)) :=
              {z |
                1 ≤ z.1.1 ∧ 1 ≤ z.1.2 ∧
                1 ≤ z.2.1 ∧ 1 ≤ z.2.2 ∧
                ((z.1.2 ^ k * z.2.2 : ℕ) : ℤ) =
                  ((z.1.1 ^ k * z.2.1 : ℕ) : ℤ) + h ∧
                MvPolynomial.eval
                  ![(z.1.1 : ℤ), (z.1.2 : ℤ),
                    (z.2.1 : ℤ), (z.2.2 : ℤ)] G = 0}
            S.Finite ∧ (S.ncard : ℝ) ≤ C_D := by
  classical
  intro k hk D hD
  refine ⟨((2 * D^3 : ℕ) : ℝ), ?_, ?_⟩
  · have hDpos : 0 < D := by omega
    have hp : 0 < D^3 := pow_pos hDpos 3
    exact_mod_cast (show 1 ≤ 2 * D^3 by omega)
  · intro α β hsum hsumD G hGhom hirr hred h hsign
    let f := A5NongeometricDehomogenizationType.dehom G
    have hf := JocelynClaims.claim_64a14d26f9c969c6efadcf09a88213dd7286bc9ea0f5636ddaa00ffb1571eb99
      α β hsum G hGhom hirr hred
    change Irreducible f ∧ ¬ Irreducible (MvPolynomial.map (algebraMap ℚ ℂ) f) ∧
      f.totalDegree ≤ α + β at hf
    let T : Set (Fin 2 → ℚ) := {a | MvPolynomial.eval a f = 0}
    have hT := JocelynClaims.claim_3fa2d2f96e9de72be9377526617a680d7d57bf1237521751f2cc9328cc11e338
      D hD f hf.1 hf.2.1 (hf.2.2.trans hsumD)
    change T.Finite ∧ T.ncard ≤ 2 * D^3 at hT
    let S : Set ((ℕ × ℕ) × (ℕ × ℕ)) := {z |
      1 ≤ z.1.1 ∧ 1 ≤ z.1.2 ∧ 1 ≤ z.2.1 ∧ 1 ≤ z.2.2 ∧
      ((z.1.2 ^ k * z.2.2 : ℕ) : ℤ) =
        ((z.1.1 ^ k * z.2.1 : ℕ) : ℤ) + h ∧
      MvPolynomial.eval ![(z.1.1 : ℤ),(z.1.2 : ℤ),(z.2.1 : ℤ),(z.2.2 : ℤ)] G = 0}
    change S.Finite ∧ (S.ncard : ℝ) ≤ ((2 * D^3 : ℕ) : ℝ)
    let π : ((ℕ × ℕ) × (ℕ × ℕ)) → (Fin 2 → ℚ) :=
      fun z => ![(z.1.1 : ℚ) / (z.1.2 : ℚ),(z.2.2 : ℚ) / (z.2.1 : ℚ)]
    let F := MvPolynomial.map (Int.castRingHom ℚ) G
    have hFbhom : A5NongeometricDehomCore.Bihom F α β := by
      intro m hm
      apply hGhom m
      apply MvPolynomial.mem_support_iff.mpr
      intro hz
      apply MvPolynomial.mem_support_iff.mp hm
      change (Int.castRingHom ℚ) (MvPolynomial.coeff m G) = 0
      rw [hz,map_zero]
    have hmap : ∀ z ∈ S, π z ∈ T := by
      rintro ⟨⟨d,e⟩,⟨u,v⟩⟩ hz
      rcases hz with ⟨hd,he,hu,hv,hshift,hzero⟩
      have heNat : e ≠ 0 := by
        have he' : 1 ≤ e := he
        omega
      have huNat : u ≠ 0 := by
        have hu' : 1 ≤ u := hu
        omega
      have he0 : (e : ℚ) ≠ 0 := by exact_mod_cast heNat
      have hu0 : (u : ℚ) ≠ 0 := by exact_mod_cast huNat
      have hcastvec :
          (fun i : Fin 4 => ((![((d : ℤ)),((e : ℤ)),((u : ℤ)),((v : ℤ))] i : ℤ) : ℚ)) =
            ![(d : ℚ),(e : ℚ),(u : ℚ),(v : ℚ)] := by
        funext i
        fin_cases i <;> simp
      have hzeroQ : MvPolynomial.eval ![(d : ℚ),(e : ℚ),(u : ℚ),(v : ℚ)] F = 0 := by
        have hc := eval_int_cast_k G ![(d : ℤ),(e : ℤ),(u : ℤ),(v : ℤ)]
        rw [hcastvec] at hc
        rw [hc]
        simpa only [hzero,Int.cast_zero]
      have hs := eval_dehom_scaled_k F α β hFbhom
        ![(d : ℚ),(e : ℚ),(u : ℚ),(v : ℚ)] he0 hu0
      have hdehom : A5NongeometricDehom.dehom F = f := by
        exact (A5NongeometricDehom.int_dehom_eq G).symm
      rw [hdehom] at hs
      have hprod :
          (e : ℚ)^α * (u : ℚ)^β *
            MvPolynomial.eval (π ((d,e),(u,v))) f = 0 := by
        simpa [π] using hs.symm.trans hzeroQ
      have hcoef : (e : ℚ)^α * (u : ℚ)^β ≠ 0 :=
        mul_ne_zero (pow_ne_zero _ he0) (pow_ne_zero _ hu0)
      exact (mul_eq_zero.mp hprod).resolve_left hcoef
    have hinj : Set.InjOn π S := by
      rintro ⟨⟨d,e⟩,⟨u,v⟩⟩ hz ⟨⟨d',e'⟩,⟨u',v'⟩⟩ hz' hπ
