abbrev wo:=aa (Fin 4) ℤ
def wp (G:wo) (a b:ℕ):Prop:= ∀ m∈ G.support,m 0+m 1=a∧ m 2+m 3=b
def gk (G:wo):Prop:= ∀ z:ℤ,(∀ m:Fin 4→₀ ℕ,z∣ G.coeff m)→ IsUnit z
def ck (k thr:ℕ) (F G:wo):Prop:= G∣ F∧ G ≠ 0∧ uZ (uJ (uG ℂ) G)∧ ∃ a b:ℕ,1≤ a∧ 1≤ b∧ thr≤ a+k*b∧ wp G a b
namespace cW
namespace gl
open MvPolynomial
lemma gm
    (s:Multiset (aa (Fin 4) ℤ))
    (hs:∀ p∈ s,p ≠ 0):
    s.prod ≠ 0∧ s.prod.totalDegree=(s.map MvPolynomial.totalDegree).sum:=by
  induction s using Multiset.induction_on with
  | empty=> simp
  | @cons p t ih=>
      have hp:p ≠ 0:=hs p (by simp)
      have ht:∀ q∈ t,q ≠ 0:=by
        intro q hq
        exact hs q (by simp [hq])
      obtain ⟨ht0,htd⟩:=ih ht
      constructor
      · simpa using aV hp ht0
      · simp only [Multiset.prod_cons,Multiset.map_cons,Multiset.sum_cons]
        rw [u7 hp ht0,htd]
lemma ec (a b:aa (Fin 4) ℤ)
    (ha:a ≠ 0) (hb:b ≠ 0) (hab:a∣ b):
    a.totalDegree≤ b.totalDegree:=by
  obtain ⟨c,rfl⟩:=hab
  have hc:c ≠ 0:=by
    intro hc
    simp [hc] at hb
  rw [u7 ha hc]
  omega
lemma fN (a b:aa (Fin 4) ℤ)
    (ha:a ≠ 0) (hb:b ≠ 0) (hab:Associated a b):
    a.totalDegree=b.totalDegree:=by
  exact le_antisymm (ec a b ha hb hab.dvd)
    (ec b a hb ha hab.symm.dvd)
lemma gn (F:aa (Fin 4) ℤ)
    (hF:F ≠ 0):
    ∃ s:Multiset (aa (Fin 4) ℤ),(∀ p∈ s,Prime p)∧ Associated s.prod F∧ (s.map MvPolynomial.totalDegree).sum=F.totalDegree:=by
  obtain ⟨s,vx,vy⟩:= UniqueFactorizationMonoid.exists_prime_factors F hF
  have hs:∀ p∈ s,p ≠ 0:=by
    intro p hp
    exact (vx p hp).ne_zero
  obtain ⟨hs0,hdeg⟩:=gm s hs
  refine ⟨s,vx,vy,?_⟩
  rw [← hdeg]
  exact fN s.prod F hs0 hF vy
lemma nO
    (s:Multiset (aa (Fin 4) ℤ)):
    (s.filter (fun p=>0< p.totalDegree)).card≤
      (s.map MvPolynomial.totalDegree).sum:=by
  induction s using Multiset.induction_on with
  | empty=> simp
  | @cons p t ih=>
      by_cases hp:0< p.totalDegree
      · simp only [Multiset.filter_cons,if_pos hp,Multiset.card_add,Multiset.card_singleton,Multiset.map_cons,Multiset.sum_cons]
        omega
      · simp only [Multiset.filter_cons,if_neg hp,zero_add,Multiset.map_cons,Multiset.sum_cons]
        omega
end gl
namespace jD
def nP (G:aa (Fin 4) ℤ):Prop:= ∀ z:ℤ,(∀ m:Fin 4→₀ ℕ,z∣ MvPolynomial.coeff m G)→ IsUnit z
lemma nQ
    (p:aa (Fin 4) ℤ)
    (hp:uZ p)
    (hpC:uZ (uJ (uG ℂ) p)):
    nP p:=by
  intro z hz
  have hd:u2 z∣ p:= (MvPolynomial.C_dvd_iff_dvd_coeff z p).mpr hz
  have hz0:z ≠ 0:=by
    intro hz0
    subst z
    obtain ⟨q,hq⟩:=hd
    have hp0:p=0:=by simpa using hq
    exact hp.ne_zero hp0
  rcases (hp.dvd_iff).mp hd with hu | ha
  · let ev:aa (Fin 4) ℤ→+*ℤ:= bF (RingHom.id ℤ) (fun _=>0)
    have he:IsUnit (ev (u2 z)):=hu.map ev
    simpa [ev] using he
  · have hpz:p∣ u2 z:=ha.dvd
    obtain ⟨b,hbz,hpb⟩:=(MvPolynomial.dvd_C_iff_exists hz0).mp hpz
    have hb0:b ≠ 0:=by
      intro hb0
      have hp0:p=0:=by simpa [hb0] using hpb
      exact hp.ne_zero hp0
    have hbC:(b:ℂ) ≠ 0:=by exact_mod_cast hb0
    have huC:IsUnit (u2 (b:ℂ):aa (Fin 4) ℂ):= ((isUnit_iff_ne_zero).mpr hbC).map (u2:ℂ→+*aa (Fin 4) ℂ)
    have hmap:uJ (uG ℂ) p= u2 (b:ℂ):=by solve | simp [hpb]
    exact False.elim (hpC.not_isUnit (hmap.symm ▸ huC))
end jD
namespace ed
open MvPolynomial
lemma jE
    (p:aa (Fin 4) ℤ):
    (uJ (uG ℂ) p).totalDegree=p.totalDegree:=by
  have hs:(uJ (uG ℂ) p).support=p.support:= MvPolynomial.support_map_of_injective p (by exact_mod_cast (Int.cast_injective:uX (fun z:ℤ=>(z:ℂ))))
  simp only [MvPolynomial.totalDegree,hs]
lemma vz
    (p:aa (Fin 4) ℤ)
    (hp:0< p.totalDegree):
    ¬IsUnit (uJ (uG ℂ) p):=by
  intro hu
  have hd:=(MvPolynomial.isUnit_iff_totalDegree_of_isReduced.mp hu).2
  rw [jE] at hd
  omega
lemma vA
    (p:aa (Fin 4) ℤ)
    (hp:uZ (uJ (uG ℂ) p)):
    0< p.totalDegree:=by
  by_contra hpos
  have hd:p.totalDegree=0:=by omega
  have hdc:(uJ (uG ℂ) p).totalDegree=0:=by
    rw [jE]
    exact hd
  have hC:=(MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp hdc
  have hc0:MvPolynomial.coeff 0
      (uJ (uG ℂ) p) ≠ 0:=by
    intro hz
    have hp0:uJ (uG ℂ) p=0:=by
      simpa [hz] using hC
    exact hp.ne_zero hp0
  have hu0:IsUnit (MvPolynomial.coeff 0
      (uJ (uG ℂ) p)):= (isUnit_iff_ne_zero).mpr hc0
  have hu:IsUnit (uJ (uG ℂ) p):= (MvPolynomial.isUnit_iff_totalDegree_of_isReduced).mpr ⟨hu0,hdc⟩
  exact hp.not_isUnit hu
