lemma o4 (k j a b:ℕ) (hk:0< k) (hab:a+b=k*j):
    ∃ q r c t:ℕ,r< k∧ c≤ 1∧(c=0↔ r=0)∧ q+c+t=j∧ b=k*q+r*c∧ a=k*t+(k-r)*c:=by
  let q:=b/k
  let r:=b % k
  have hr:r< k:=Nat.mod_lt b hk
  have hb:b=k*q+r:=by
    have h:=Nat.mod_add_div b k
    dsimp [q,r]
    omega
  have hq:q≤ j:=by
    by_contra hn
    have vM:j+1≤ q:=by omega
    have hm:=u8 k vM
    have:b≤ k*j:=by omega
    nlinarith
  by_cases hr0:r=0
  · refine ⟨q,r,0,j-q,hr,by omega,?_,?_,?_,?_⟩
    · simp [hr0]
    · omega
    · simpa [hr0] using hb
    · have hsum:q+(j-q)=j:=by omega
      have hmul:=congrArg (fun x:ℕ=> k*x) hsum
      simp [hr0] at hb ⊢
      nlinarith
  · have um:q+1≤ j:=by
      by_contra hn
      have:j≤ q:=by omega
      have hqeq:q=j:=by omega
      have hbgt:k*j< b:=by
        rw [hb,hqeq]
        omega
      omega
    refine ⟨q,r,1,j-q-1,hr,by omega,?_,?_,?_,?_⟩
    · simp [hr0]
    · omega
    · simpa using hb
    · have hsum:q+1+(j-q-1)=j:=by omega
      have hmul:k*q+k+k*(j-q-1)=k*j:=by
        calc
          _=k*(q+1+(j-q-1)):=by ring
          _=k*j:=congrArg (fun x:ℕ=> k*x) hsum
      have hkr:(k-r)+r=k:=by omega
      omega
