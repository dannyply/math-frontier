def full12Cutoff (k : ℕ)
    (G : MvPolynomial (Fin 4) ℤ) (h : ℤ) (x : ℝ) : Set Quad :=
  {q | 1 ≤ q.1.1 ∧ 1 ≤ q.1.2 ∧ 1 ≤ q.2.1 ∧ 1 ≤ q.2.2 ∧
    ((q.1.2 ^ k * q.2.2 : ℕ) : ℤ) =
      ((q.1.1 ^ k * q.2.1 : ℕ) : ℤ) + h ∧
    ((q.1.1 ^ k * q.2.1 : ℕ) : ℝ) ≤ x ∧
    MvPolynomial.eval₂ (Int.castRingHom ℚ)
      (fun i : Fin 4 =>
        if i = 0 then (q.1.1 : ℚ) else
        if i = 1 then (q.1.2 : ℚ) else
        if i = 2 then (q.2.1 : ℚ) else (q.2.2 : ℚ)) G = 0}

def inducedForm (k : ℕ) (D E : MvPolynomial (Fin 2) ℤ) :
    MvPolynomial (Fin 2) ℤ := X 1 * E^k - X 0 * D^k

lemma induced_homogeneous (k : ℕ) (D E : MvPolynomial (Fin 2) ℤ)
    (hD : D.IsHomogeneous 2) (hE : E.IsHomogeneous 2) :
    (inducedForm k D E).IsHomogeneous (2*k+1) := by
  simpa only [inducedForm,Nat.add_comm,Nat.mul_comm] using
    ((isHomogeneous_X ℤ (1 : Fin 2)).mul (hE.pow k)).sub
      ((isHomogeneous_X ℤ (0 : Fin 2)).mul (hD.pow k))

theorem both_coprime (k : ℕ) (hk : 1≤k) (d e u v : ℕ) (h : ℤ)
    (hsign : h = 1 ∨ h = -1)
    (hshift : ((e ^ k * v : ℕ) : ℤ) = ((d ^ k * u : ℕ) : ℤ) + h) :
    d.Coprime e ∧ u.Coprime v := by
  have hn := (unit_coprime (e ^ k * v) (d ^ k * u) h hsign hshift).symm
  have hk0 : k≠0 := by omega
  have hdvd : d ∣ d ^ k * u :=
    dvd_mul_of_dvd_left (dvd_pow_self d hk0) u
  have hevd : e ∣ e ^ k * v :=
    dvd_mul_of_dvd_left (dvd_pow_self e hk0) v
  have huvd : u ∣ d ^ k * u := ⟨d ^ k, by ring⟩
  have hvvd : v ∣ e ^ k * v := ⟨e ^ k, by ring⟩
  exact ⟨hn.of_dvd hdvd hevd, hn.of_dvd huvd hvvd⟩

lemma actual_graph_value_divisor (k : ℕ) (hk : 1≤k)
    (D E : MvPolynomial (Fin 2) ℤ) (d e u v : ℕ) (h B : ℤ)
    (hsign : h=1 ∨ h=-1)
    (hshift : ((e^k*v : ℕ):ℤ)=((d^k*u : ℕ):ℤ)+h)
    (hgraph : (d:ℤ)*eval ![(u:ℤ),(v:ℤ)] E =
      (e:ℤ)*eval ![(u:ℤ),(v:ℤ)] D)
    (hB : B ≠ 0)
    (hres : (Int.gcd (eval ![(u:ℤ),(v:ℤ)] D)
      (eval ![(u:ℤ),(v:ℤ)] E) : ℤ) ∣ B) :
    ∃ g : ℤ, g ≠ 0 ∧ g ∣ B ∧
      eval ![(u:ℤ),(v:ℤ)] D = g*(d:ℤ) ∧
      eval ![(u:ℤ),(v:ℤ)] E = g*(e:ℤ) ∧
      eval ![(u:ℤ),(v:ℤ)] (inducedForm k D E) = g^k*h ∧
      eval ![(u:ℤ),(v:ℤ)] (inducedForm k D E) ≠ 0 ∧
      eval ![(u:ℤ),(v:ℤ)] (inducedForm k D E) ∣ h*B^k := by
  have hcop := (both_coprime k hk d e u v h hsign hshift).1
  have hcopZ : Int.gcd (d:ℤ) (e:ℤ) = 1 := by
    simpa using hcop.gcd_eq_one
  obtain ⟨g,hD,hE⟩ := C01.PcGlue.prop_of_coprime
    (a:=(d:ℤ)) (b:=(e:ℤ))
    (d:=eval ![(u:ℤ),(v:ℤ)] D) (e:=eval ![(u:ℤ),(v:ℤ)] E)
    hcopZ (by simpa only [mul_comm] using hgraph.symm)
  have hgD : g ∣ eval ![(u:ℤ),(v:ℤ)] D := ⟨(d:ℤ),hD⟩
  have hgE : g ∣ eval ![(u:ℤ),(v:ℤ)] E := ⟨(e:ℤ),hE⟩
  have hggcd : g ∣ (Int.gcd (eval ![(u:ℤ),(v:ℤ)] D)
      (eval ![(u:ℤ),(v:ℤ)] E) : ℤ) := by
    first | exact Int.dvd_gcd hgD hgE | exact Int.dvd_coe_gcd hgD hgE
  have hgB : g ∣ B := hggcd.trans hres
  have hg0 : g ≠ 0 := by
    intro hz
    rw [hz,zero_dvd_iff] at hgB
    exact hB hgB
  have hh : h ≠ 0 := by rcases hsign with rfl|rfl <;> norm_num
  have hlevel : (e:ℤ)^k*(v:ℤ)-(d:ℤ)^k*(u:ℤ)=h := by
    push_cast at hshift
    linear_combination hshift
  have hvalue : eval ![(u:ℤ),(v:ℤ)] (inducedForm k D E)=g^k*h := by
    simp only [inducedForm,map_sub,map_mul,map_pow,MvPolynomial.eval_X,
      Matrix.cons_val_zero,Matrix.cons_val_one,]
    rw [hD,hE]
    simp only [mul_pow]
    linear_combination g^k*hlevel
  have hv0 : eval ![(u:ℤ),(v:ℤ)] (inducedForm k D E) ≠ 0 := by
    rw [hvalue]
    exact mul_ne_zero (pow_ne_zero k hg0) hh
  have hdiv : eval ![(u:ℤ),(v:ℤ)] (inducedForm k D E) ∣ h*B^k := by
    rw [hvalue]
    simpa only [mul_comm] using
      (mul_dvd_mul_right (pow_dvd_pow_of_dvd hgB k) h)
  exact ⟨g,hg0,hgB,hD,hE,hvalue,hv0,hdiv⟩

lemma two_linear_divisor_cover (n : ℕ) (R : MvPolynomial (Fin 2) ℤ)
    (hR : TwoIndependentLines n R) (M : ℤ) (hM : M ≠ 0) :
    ∃ T : Finset (ℤ×ℤ),
      (∀ rs : ℤ×ℤ, Int.gcd rs.1 rs.2=1 →
        eval ![rs.1,rs.2] R ∣ M → rs ∈ T) ∧
      T.card ≤ 4*M.natAbs.divisors.card^2 := by
  classical
  obtain ⟨c,a,b,a',b',j,hc,hdet,hj,hj4,hfac⟩ := hR
  let φ : ℤ×ℤ → ℤ×ℤ := fun rs => (a*rs.1+b*rs.2,a'*rs.1+b'*rs.2)
  let S : Set (ℤ×ℤ) :=
    {rs | Int.gcd rs.1 rs.2=1 ∧ eval ![rs.1,rs.2] R ∣ M}
  let U := (signedDivisors M) ×ˢ (signedDivisors M)
  have hφ := linear_pair_injective a b a' b' hdet
  have hmap : ∀ rs ∈ S, φ rs ∈ (↑U : Set (ℤ×ℤ)) := by
    intro rs hrs
    have heval : eval ![rs.1,rs.2] R =
        c*(a*rs.1+b*rs.2)^j*(a'*rs.1+b'*rs.2)^(n-j) := by
      rw [hfac]
      simp []
    have h1 : a*rs.1+b*rs.2 ∣ eval ![rs.1,rs.2] R := by
      rw [heval]
      exact dvd_mul_of_dvd_left
        (dvd_mul_of_dvd_right (dvd_pow_self _ (by omega : j ≠ 0)) c) _
    have h2 : a'*rs.1+b'*rs.2 ∣ eval ![rs.1,rs.2] R := by
      rw [heval]
      exact dvd_mul_of_dvd_right
        (dvd_pow_self _ (by omega : n-j ≠ 0)) _
    exact Finset.mem_product.mpr
      ⟨mem_signedDivisors M _ hM (h1.trans hrs.2),
       mem_signedDivisors M _ hM (h2.trans hrs.2)⟩
  have himg : (φ '' S).Finite :=
    (Finset.finite_toSet U).subset (by rintro _ ⟨rs,hrs,rfl⟩; exact hmap rs hrs)
  have hfin : S.Finite := Set.Finite.of_finite_image himg hφ.injOn
  refine ⟨hfin.toFinset,?_,?_⟩
  · intro rs hp hdvd
    exact hfin.mem_toFinset.mpr ⟨hp,hdvd⟩
  · have hs : S.ncard ≤ U.card := by
      calc
        S.ncard ≤ (↑U : Set (ℤ×ℤ)).ncard :=
          Set.ncard_le_ncard_of_injOn φ hmap hφ.injOn (Finset.finite_toSet U)
        _ = U.card := Set.ncard_coe_finset U
    rw [← Set.ncard_eq_toFinset_card S hfin]
    calc
      S.ncard ≤ U.card := hs
      _ = (signedDivisors M).card*(signedDivisors M).card := Finset.card_product _ _
      _ ≤ (2*M.natAbs.divisors.card)*(2*M.natAbs.divisors.card) :=
        Nat.mul_le_mul (signedDivisors_card M) (signedDivisors_card M)
      _ = 4*M.natAbs.divisors.card^2 := by ring

lemma nat_le_two_pow (n : ℕ) : n≤2^n := by
  induction n with
  | zero => norm_num
  | succ n ih =>
    have hp : 0<(2:ℕ)^n := pow_pos (by norm_num) n
    rw [pow_succ]
    omega

lemma three_root_divisor_cover (hSt : StewartHyp) (n : ℕ)
    (R : MvPolynomial (Fin 2) ℤ) (hRh : R.IsHomogeneous n)
    (hR0 : R ≠ 0) (hroots : HasThreeProjectiveZeros R)
    (M : ℤ) (hM : M ≠ 0) :
    ∃ T : Finset (ℤ×ℤ),
      (∀ rs : ℤ×ℤ, Int.gcd rs.1 rs.2=1 →
        eval ![rs.1,rs.2] R ∣ M → rs ∈ T) ∧
      T.card ≤ 5600*n*M.natAbs.divisors.card^(n+1) := by
  classical
  obtain ⟨q,a,hq3,hqn,hcontent,hsqf,hkernel⟩ :=
    C01.PcKer.p_kernel n R hRh hR0 hroots
  let F : ℤ×ℤ → ℤ := fun rs =>
    ∑ i : Fin (q+1), a i*rs.1^(i:ℕ)*rs.2^(q-(i:ℕ))
  obtain ⟨T,hTmem,hTcard⟩ := C01.PcLowdegRed.count_T F q (by omega)
    (hSt q hq3 a hcontent hsqf) M hM
  refine ⟨T,?_,?_⟩
  · intro rs hp hdvd
    exact hTmem rs hp ((hkernel rs.1 rs.2).trans hdvd)
  · have hn0 : M.natAbs ≠ 0 := Int.natAbs_ne_zero.mpr hM
    have hω : 2^M.natAbs.primeFactors.card ≤ M.natAbs.divisors.card :=
      C01.PcLowdegRed.two_pow_card_primeFactors_le _ hn0
    have hqpow : q^(1+M.natAbs.primeFactors.card) ≤
        n*M.natAbs.divisors.card^n := by
      calc
        q^(1+M.natAbs.primeFactors.card) ≤ n^(1+M.natAbs.primeFactors.card) :=
          Nat.pow_le_pow_left hqn _
        _ = n*n^M.natAbs.primeFactors.card := by rw [pow_add,pow_one]
        _ ≤ n*(2^n)^M.natAbs.primeFactors.card :=
          Nat.mul_le_mul le_rfl (Nat.pow_le_pow_left (nat_le_two_pow n) _)
        _ = n*(2^M.natAbs.primeFactors.card)^n := by
          rw [←pow_mul,←pow_mul,Nat.mul_comm n M.natAbs.primeFactors.card]
        _ ≤ n*M.natAbs.divisors.card^n :=
          Nat.mul_le_mul le_rfl (Nat.pow_le_pow_left hω _)
    calc
      T.card ≤ M.natAbs.divisors.card*
          (2*(2800*q^(1+M.natAbs.primeFactors.card))) := hTcard
      _ ≤ M.natAbs.divisors.card*(2*(2800*(n*M.natAbs.divisors.card^n))) :=
        Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ hqpow))
      _ = 5600*n*M.natAbs.divisors.card^(n+1) := by rw [pow_succ]; ring

lemma alternative_divisor_cover (hSt : StewartHyp) (n : ℕ) (hn : 3≤n)
    (R : MvPolynomial (Fin 2) ℤ) (hRh : R.IsHomogeneous n) (hR0 : R≠0)
    (halt : HasThreeProjectiveZeros R ∨ TwoIndependentLines n R)
    (M : ℤ) (hM : M≠0) :
    ∃ T : Finset (ℤ×ℤ),
      (∀ rs : ℤ×ℤ, Int.gcd rs.1 rs.2=1 →
        eval ![rs.1,rs.2] R∣M → rs∈T) ∧
      T.card≤5600*n*M.natAbs.divisors.card^(n+1) := by
  rcases halt with hr | hf
  · exact three_root_divisor_cover hSt n R hRh hR0 hr M hM
  · obtain ⟨T,hcover,hcard⟩ := two_linear_divisor_cover n R hf M hM
    have hτ : 1≤M.natAbs.divisors.card := by
      have hm : 1∈M.natAbs.divisors :=
        Nat.mem_divisors.mpr ⟨one_dvd _,Int.natAbs_ne_zero.mpr hM⟩
      have hc := Finset.card_pos.mpr ⟨1,hm⟩
      omega
    refine ⟨T,hcover,?_⟩
    calc
      T.card≤4*M.natAbs.divisors.card^2 := hcard
      _ ≤4*M.natAbs.divisors.card^(n+1) :=
        Nat.mul_le_mul_left _ (Nat.pow_le_pow_right hτ (by omega : 2≤n+1))
      _ ≤5600*n*M.natAbs.divisors.card^(n+1) :=
        Nat.mul_le_mul_right _ (by omega : 4≤5600*n)

lemma uniform_divisor_fee (p : ℕ) (D H a : ℝ)
    (hD : 0≤D) (hH : 0<H) (ha : 0≤a) (ε : ℝ) (hε : 0<ε) :
    ∃ C : ℝ, 0<C ∧ ∀ x : ℝ, 2≤x → ∀ M : ℤ, M≠0 →
      |(M:ℝ)|≤H*x^a →
      D*(M.natAbs.divisors.card:ℝ)^p≤C*x^ε := by
  let δ : ℝ := ε/(a*(p:ℝ)+1)
  have hp0 : 0≤(p:ℝ) := Nat.cast_nonneg _
  have hden : 0<a*(p:ℝ)+1 := by positivity
  have hδ : 0<δ := div_pos hε hden
  have hδeq : δ*(a*(p:ℝ)+1)=ε := div_mul_cancel₀ ε (ne_of_gt hden)
  have hexp : a*((p:ℝ)*δ)≤ε := by nlinarith
  obtain ⟨Cd,hCd,hdb⟩ := C01.PcLowdegRed.divisor_bound δ hδ
  have hCd0 : 0≤Cd := by linarith
  let C : ℝ := D*Cd^p*H^((p:ℝ)*δ)+1
  refine ⟨C,by dsimp [C]; positivity,?_⟩
  intro x hx M hM hMb
  have hx0 : 0<x := by linarith
  have hx1 : 1≤x := by linarith
  have hcast : (M.natAbs:ℝ)=|(M:ℝ)| := by
    rw [←Int.cast_natCast,Int.natCast_natAbs,Int.cast_abs]
  have hdiv : (M.natAbs.divisors.card:ℝ)≤Cd*|(M:ℝ)|^δ := by
    have ht := hdb M.natAbs (Int.natAbs_ne_zero.mpr hM)
    rwa [hcast] at ht
  have hDp : (M.natAbs.divisors.card:ℝ)^p≤Cd^p*|(M:ℝ)|^((p:ℝ)*δ) := by
    calc
      (M.natAbs.divisors.card:ℝ)^p≤(Cd*|(M:ℝ)|^δ)^p :=
        pow_le_pow_left₀ (Nat.cast_nonneg _) hdiv _
      _ = Cd^p*|(M:ℝ)|^((p:ℝ)*δ) := by
        rw [mul_pow]
        congr 1
        rw [←Real.rpow_natCast,←Real.rpow_mul (abs_nonneg _)]
        congr 1
        ring
  have hMeta : |(M:ℝ)|^((p:ℝ)*δ)≤H^((p:ℝ)*δ)*x^ε := by
    calc
      |(M:ℝ)|^((p:ℝ)*δ)≤(H*x^a)^((p:ℝ)*δ) :=
        Real.rpow_le_rpow (abs_nonneg _) hMb (by positivity)
      _ = H^((p:ℝ)*δ)*(x^a)^((p:ℝ)*δ) :=
        Real.mul_rpow hH.le (Real.rpow_nonneg hx0.le _)
      _ = H^((p:ℝ)*δ)*x^(a*((p:ℝ)*δ)) := by rw [←Real.rpow_mul hx0.le]
      _ ≤H^((p:ℝ)*δ)*x^ε :=
        mul_le_mul_of_nonneg_left
          (Real.rpow_le_rpow_of_exponent_le hx1 hexp) (Real.rpow_nonneg hH.le _)
  calc
    D*(M.natAbs.divisors.card:ℝ)^p≤D*(Cd^p*|(M:ℝ)|^((p:ℝ)*δ)) :=
      mul_le_mul_of_nonneg_left hDp hD
    _ ≤D*(Cd^p*(H^((p:ℝ)*δ)*x^ε)) :=
      mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left hMeta (pow_nonneg hCd0 _)) hD
    _ =(D*Cd^p*H^((p:ℝ)*δ))*x^ε := by ring
    _ ≤C*x^ε := by
      apply mul_le_mul_of_nonneg_right _ (Real.rpow_nonneg hx0.le _)
      dsimp [C]
      linarith

lemma original_parameter_injective (k : ℕ) (hk : 1≤k) (S : Set Quad)
    (D E : MvPolynomial (Fin 2) ℤ) (M : ℤ) (hM : M≠0)
    (hpos : ∀ q∈S, 1≤q.1.1 ∧ 1≤q.1.2)
    (hcop : ∀ q∈S, q.1.1.Coprime q.1.2)
    (hgraph : ∀ q∈S,
      (q.1.1:ℤ)*eval ![(q.2.1:ℤ),(q.2.2:ℤ)] E =
      (q.1.2:ℤ)*eval ![(q.2.1:ℤ),(q.2.2:ℤ)] D)
    (hdiv : ∀ q∈S,
      eval ![(q.2.1:ℤ),(q.2.2:ℤ)] (inducedForm k D E) ∣ M) :
    Set.InjOn originalParameter S := by
  have hk0 : k≠0 := by omega
  rintro ⟨⟨d,e⟩,⟨u,v⟩⟩ hq ⟨⟨d',e'⟩,⟨u',v'⟩⟩ hq' hp
  change ((u:ℤ),(v:ℤ))=((u':ℤ),(v':ℤ)) at hp
  have hu : u=u' := by
    have hz := congrArg Prod.fst hp
    dsimp at hz
    exact_mod_cast hz
  have hv : v=v' := by
    have hz := congrArg Prod.snd hp
    dsimp at hz
    exact_mod_cast hz
  subst u'
  subst v'
  have hnz : eval ![(u:ℤ),(v:ℤ)] (inducedForm k D E) ≠ 0 := by
    intro hz
    have ht := hdiv ((d,e),(u,v)) hq
    rw [hz,zero_dvd_iff] at ht
    exact hM ht
  have hnot : ¬(eval ![(u:ℤ),(v:ℤ)] D=0 ∧
      eval ![(u:ℤ),(v:ℤ)] E=0) := by
    rintro ⟨hd,he⟩
    apply hnz
    simp [inducedForm,hd,he,hk0]
  have hcZ : (d:ℤ)*(e':ℤ)=(d':ℤ)*(e:ℤ) :=
    same_line_parallel _ _ _ _ _ _ hnot
      (hgraph ((d,e),(u,v)) hq) (hgraph ((d',e'),(u,v)) hq')
  have hcN : d*e'=d'*e := by exact_mod_cast hcZ
  have hdvd : d∣d' := by
    apply (hcop ((d,e),(u,v)) hq).dvd_of_dvd_mul_right
    rw [←hcN]
    exact dvd_mul_right d e'
  have hdvd' : d'∣d := by
    apply (hcop ((d',e'),(u,v)) hq').dvd_of_dvd_mul_right
    rw [hcN]
    exact dvd_mul_right d' e
  have hdeq : d=d' := Nat.dvd_antisymm hdvd hdvd'
  subst d'
  have hdpos : 0<d := by
    have ht : 1≤d := (hpos ((d,e),(u,v)) hq).1
    omega
  have heeq : e=e' := (Nat.mul_left_cancel hdpos hcN).symm
  subst e'
  rfl

lemma quadratic_graph_data_with_presentation
    (G : MvPolynomial (Fin 4) ℤ)
    (hbi : ∀ m∈G.support, m 0+m 1=1 ∧ m 2+m 3=2)
    (hi : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G))
    (H : ℝ) (hheight : ∀ m : Fin 4 →₀ ℕ, |((G.coeff m:ℤ):ℝ)|≤H) :
    ∃ D₀ D₁ D₂ E₀ E₁ E₂ : ℤ,
      G = X 0*ConsecutiveCountingA5ActualFull12Graph.binaryQuadratic E₀ E₁ E₂ -
        X 1*ConsecutiveCountingA5ActualFull12Graph.binaryQuadratic D₀ D₁ D₂ ∧
      (|(D₀:ℝ)|≤H ∧ |(D₁:ℝ)|≤H ∧ |(D₂:ℝ)|≤H ∧
        |(E₀:ℝ)|≤H ∧ |(E₁:ℝ)|≤H ∧ |(E₂:ℝ)|≤H) ∧
      (∀ r s : ℂ, r≠0 ∨ s≠0 →
        ConsecutiveCountingA5ActualFull12Graph.complexQuadratic D₀ D₁ D₂ r s≠0 ∨
        ConsecutiveCountingA5ActualFull12Graph.complexQuadratic E₀ E₁ E₂ r s≠0) ∧
      (∀ d e u v : ℕ,
        eval₂ (Int.castRingHom ℚ) (fun i : Fin 4 =>
          if i=0 then (d:ℚ) else if i=1 then (e:ℚ) else
            if i=2 then (u:ℚ) else (v:ℚ)) G=0 →
        (d:ℚ)*ConsecutiveCountingA5ActualFull12Graph.rationalQuadratic E₀ E₁ E₂ (u:ℚ) (v:ℚ)-
          (e:ℚ)*ConsecutiveCountingA5ActualFull12Graph.rationalQuadratic D₀ D₁ D₂ (u:ℚ) (v:ℚ)=0) := by
  let D₀ := -G.coeff (ConsecutiveCountingA5ActualFull12Graph.ix 0 1 2 0)
  let D₁ := -G.coeff (ConsecutiveCountingA5ActualFull12Graph.ix 0 1 1 1)
  let D₂ := -G.coeff (ConsecutiveCountingA5ActualFull12Graph.ix 0 1 0 2)
  let E₀ := G.coeff (ConsecutiveCountingA5ActualFull12Graph.ix 1 0 2 0)
  let E₁ := G.coeff (ConsecutiveCountingA5ActualFull12Graph.ix 1 0 1 1)
  let E₂ := G.coeff (ConsecutiveCountingA5ActualFull12Graph.ix 1 0 0 2)
  have hG : G=X 0*ConsecutiveCountingA5ActualFull12Graph.binaryQuadratic E₀ E₁ E₂-
      X 1*ConsecutiveCountingA5ActualFull12Graph.binaryQuadratic D₀ D₁ D₂ :=
    ConsecutiveCountingA5ActualFull12Graph.six_coefficient_identity G hbi
  refine ⟨D₀,D₁,D₂,E₀,E₁,E₂,hG,?_,
    ConsecutiveCountingA5ActualFull12Graph.graph_no_common G D₀ D₁ D₂ E₀ E₁ E₂ hG hi,?_⟩
  · exact ⟨by simpa [D₀] using hheight (ConsecutiveCountingA5ActualFull12Graph.ix 0 1 2 0),
      by simpa [D₁] using hheight (ConsecutiveCountingA5ActualFull12Graph.ix 0 1 1 1),
      by simpa [D₂] using hheight (ConsecutiveCountingA5ActualFull12Graph.ix 0 1 0 2),
      hheight _,hheight _,hheight _⟩
  · intro d e u v hz
    let f : Fin 4 → ℚ := fun i =>
      if i=0 then (d:ℚ) else if i=1 then (e:ℚ) else
        if i=2 then (u:ℚ) else (v:ℚ)
    let ev : MvPolynomial (Fin 4) ℤ →+* ℚ := eval₂Hom (Int.castRingHom ℚ) f
    have hx (i : Fin 4) : ev (X i)=f i := eval₂_X _ _ _
    have hc (a : ℤ) : ev (C a)=(a:ℚ) := eval₂_C _ _ _
    have hz' : ev G=0 := hz
    rw [hG] at hz'
    simp only [ConsecutiveCountingA5ActualFull12Graph.binaryQuadratic,
      map_sub,map_mul,map_add,map_pow,hx,hc] at hz'
    simpa [f,ConsecutiveCountingA5ActualFull12Graph.rationalQuadratic] using hz'

lemma resultant_rhs_cap (k : ℕ) (H : ℝ) (B h : ℤ)
    (hB : |(B:ℝ)|≤576*H^8) (hsign : h=1 ∨ h=-1) :
    |((h*B^k:ℤ):ℝ)|≤(576:ℝ)^k*H^(8*k) := by
  have hh : |(h:ℝ)|=1 := by rcases hsign with rfl|rfl <;> norm_num
  simp only [Int.cast_mul,Int.cast_pow,abs_mul,abs_pow,hh,one_mul]
  calc
    |(B:ℝ)|^k≤(576*H^8)^k := pow_le_pow_left₀ (abs_nonneg _) hB _
    _ =(576:ℝ)^k*H^(8*k) := by rw [mul_pow,←pow_mul]

lemma actual_not_pure (k : ℕ) (hk : 3≤k)
    (G : MvPolynomial (Fin 4) ℤ)
    (hbi : ∀ m∈G.support, m 0+m 1=1 ∧ m 2+m 3=2)
    (hi : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G))
    (D₀ D₁ D₂ E₀ E₁ E₂ : ℤ)
    (hG : G=X 0*ConsecutiveCountingA5ActualFull12Graph.binaryQuadratic E₀ E₁ E₂-
      X 1*ConsecutiveCountingA5ActualFull12Graph.binaryQuadratic D₀ D₁ D₂)
    (d e u v : ℕ) (h : ℤ)
    (hsign : h=1 ∨ h=-1) (hd : 1≤d) (he : 1≤e) (hu : 1≤u) (hv : 1≤v)
    (hpoint : eval₂ (Int.castRingHom ℚ) (fun i : Fin 4 =>
      if i=0 then (d:ℚ) else if i=1 then (e:ℚ) else
        if i=2 then (u:ℚ) else (v:ℚ)) G=0)
    (hshift : ((e^k*v:ℕ):ℤ)=((d^k*u:ℕ):ℤ)+h) :
    ¬PureComplexPower (2*k+1) (inducedForm k (quadraticForm D₀ D₁ D₂)
      (quadraticForm E₀ E₁ E₂)) := by
  rintro ⟨γ,α,β,hγ,hαβ,hpure⟩
  have hpure' : ∃ γ α β : ℂ, γ≠0 ∧ (α≠0 ∨ β≠0) ∧ ∀ r s : ℂ,
      s*(ConsecutiveCountingA5ActualFull12Graph.complexQuadratic E₀ E₁ E₂ r s)^k-
      r*(ConsecutiveCountingA5ActualFull12Graph.complexQuadratic D₀ D₁ D₂ r s)^k =
        γ*(α*r+β*s)^(2*k+1) := by
    refine ⟨γ,α,β,hγ,hαβ,?_⟩
    intro r s
    have ht := hpure r s
    simp only [inducedForm,map_sub,map_mul,map_pow,MvPolynomial.map_X,
      MvPolynomial.eval_X,Matrix.cons_val_zero,Matrix.cons_val_one,quadratic_complex_eval] at ht
    simpa only [ConsecutiveCountingA5ActualFull12Graph.complexQuadratic] using ht
  exact JocelynClaims.claim_8f1f58f67e7a253336655b26f33065e855729a2aa110043a02b7e6ad78952c6a
    G D₀ D₁ D₂ E₀ E₁ E₂ hbi hi hG k d e u v h
    hk hsign hd he hu hv hpoint hshift hpure'

theorem whole_full12_count :
(let StewartHyp : Prop := ∀ q : ℕ, 3 ≤ q → ∀ a : Fin (q + 1) → ℤ, Finset.univ.gcd a = 1 → Squarefree (∑ i : Fin (q + 1), MvPolynomial.C (a i : ℚ) * MvPolynomial.X (0 : Fin 2) ^ (i : ℕ) * MvPolynomial.X (1 : Fin 2) ^ (q - (i : ℕ))) → ∀ m : ℤ, m ≠ 0 → {rs : ℤ × ℤ | Int.gcd rs.1 rs.2 = 1 ∧ ∑ i : Fin (q + 1), a i * rs.1 ^ (i : ℕ) * rs.2 ^ (q - (i : ℕ)) = m}.encard ≤ ((2800 * q ^ (1 + m.natAbs.primeFactors.card) : ℕ) : ℕ∞); StewartHyp → ∀ k : ℕ, 3 ≤ k → ∀ K : ℝ, 0 ≤ K → ∀ ε : ℝ, 0 < ε → ∃ C : ℝ, 0 < C ∧ ∀ x : ℝ, 2 ≤ x → ∀ G : MvPolynomial (Fin 4) ℤ, (∀ m ∈ G.support, m 0 + m 1 = 1 ∧ m 2 + m 3 = 2) → Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G) → (∀ m : Fin 4 →₀ ℕ, |((G.coeff m : ℤ) : ℝ)| ≤ x ^ K) → ∀ h : ℤ, (h = 1 ∨ h = -1) → let S : Set ((ℕ × ℕ) × (ℕ × ℕ)) := {q | 1 ≤ q.1.1 ∧ 1 ≤ q.1.2 ∧ 1 ≤ q.2.1 ∧ 1 ≤ q.2.2 ∧ ((q.1.2 ^ k * q.2.2 : ℕ) : ℤ) = ((q.1.1 ^ k * q.2.1 : ℕ) : ℤ) + h ∧ ((q.1.1 ^ k * q.2.1 : ℕ) : ℝ) ≤ x ∧ MvPolynomial.eval₂ (Int.castRingHom ℚ) (fun i : Fin 4 => if i = 0 then (q.1.1 : ℚ) else if i = 1 then (q.1.2 : ℚ) else if i = 2 then (q.2.1 : ℚ) else (q.2.2 : ℚ)) G = 0}; S.Finite ∧ (S.ncard : ℝ) ≤ C * x ^ ε) := by
  dsimp only
  intro hSt k hk K hK ε hε
  obtain ⟨C,hC,hfee⟩ := uniform_divisor_fee (2*k+2)
    ((5600*(2*k+1):ℕ):ℝ) ((576:ℝ)^k) (8*(k:ℝ)*K)
    (by positivity) (by positivity) (by positivity) ε hε
  refine ⟨C,hC,?_⟩
  intro x hx G hbi hi hheight h hsign
  let S := full12Cutoff k G h x
  change S.Finite ∧ (S.ncard:ℝ)≤C*x^ε
  by_cases hS : S.Nonempty
  swap
  · have hSe : S=∅ := Set.not_nonempty_iff_eq_empty.mp hS
    rw [hSe,Set.ncard_empty,Nat.cast_zero]
    exact ⟨Set.finite_empty,mul_nonneg hC.le (Real.rpow_nonneg (by linarith) _)⟩
  have hx0 : 0<x := by linarith
  have hH : 1≤x^K := Real.one_le_rpow (by linarith : 1≤x) hK
  obtain ⟨D₀,D₁,D₂,E₀,E₁,E₂,hG,hcoeff,hno,hinc⟩ :=
    quadratic_graph_data_with_presentation G hbi hi (x^K) hheight
  let D := quadraticForm D₀ D₁ D₂
  let E := quadraticForm E₀ E₁ E₂
  let R := inducedForm k D E
  obtain ⟨B,hB,hBcap,hBdiv⟩ :=
    bounded_quadratic_graph_resultant D₀ D₁ D₂ E₀ E₁ E₂ hno (x^K) hH hcoeff
  let M : ℤ := h*B^k
