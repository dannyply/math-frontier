theorem physical_log_branch_transport
    (k : ℕ) (hk : 2≤k)
    (x A Z L H Q c1 c2 C1 G J s b alpha ell eta q delta : ℝ)
    (hx : 1<x) (hA : 0<A) (hZ : 0<Z) (hL : 0<L)
    (hH : 0<H) (hQ : 0<Q) (hc1 : 0<c1) (hc2 : 0<c2) (hC1 : 0<C1)
    (hG : G=A*H/L) (hJ : J=Q/(H*A^(k+1)))
    (hlogA : Real.log A=alpha*Real.log x)
    (hlogZ : Real.log Z=s*Real.log x)
    (hlogL : Real.log L=ell*Real.log x)
    (hlogH : Real.log H=eta*Real.log x)
    (hlogQ : Real.log Q=q*Real.log x)
    (hcost1 : Real.log C1+2*Real.log 4≤delta*Real.log x)
    (hcost2 : Real.log C1+(2*(k:ℝ)+1)*Real.log 4≤delta*Real.log x)
    (hcostII : (2*(k:ℝ)-1)*Real.log 4-Real.log c2≤delta*Real.log x) :
    let R := Real.sqrt (A*Z)/(4*L)
    let t : ℝ := (k:ℝ)
    let PI := 1+(2*t+1)*ell-q-t*s
    let PII := 1+(2*t-1)*ell-2*eta-(2*t+1)/2*alpha-(2*t-3)/2*s
    let KI := 2*t*Real.log 4-Real.log c1
    let KII := (2*t-3)/2*Real.log 4-Real.log c2/2
    ((delta<q+s-eta-t*alpha-2*ell) →
      (delta<q+(t+1/2)*s-1-eta-alpha/2-(2*t+1)*ell) →
      PI≤b →
      C1≤J*R^2 ∧ C1*x≤J*R^(2*k+1) ∧
        x/(c1*J*G*R^(2*k))≤Real.exp KI*x^b) ∧
    ((delta<(2*t-1)/2*(alpha+s)-1-(2*t-1)*ell) →
      PII≤2*b →
      x≤c2*R^(2*k-1) ∧
        Real.sqrt (x/(c2*G^2*R^(2*k-3)))≤Real.exp KII*x^b) := by
  intro R t PI PII KI KII
  have hxp : 0<x := by linarith
  have hX : 0<Real.log x := Real.log_pos hx
  obtain ⟨hRp,hGp,hJp,hr,hg,hj,hi1,hi2,hii,hpi,hpii⟩ :=
    physical_scale_log_identities k hk x A Z L H Q c1 c2 G J hxp hA hZ hL hH hQ hc1 hc2 hG hJ
  have hforce1 : Real.log (J*R^2)=
      (q+s-eta-t*alpha-2*ell)*Real.log x-2*Real.log 4 := by
    rw [hi1,hlogQ,hlogH,hlogA,hlogZ,hlogL]
    ring
  have hforce2 : Real.log (J*R^(2*k+1)/x)=
      (q+(t+1/2)*s-1-eta-alpha/2-(2*t+1)*ell)*Real.log x-(2*t+1)*Real.log 4 := by
    rw [hi2,hlogQ,hlogH,hlogA,hlogZ,hlogL]
    ring
  have hforceII : Real.log (c2*R^(2*k-1)/x)=
      ((2*t-1)/2*(alpha+s)-1-(2*t-1)*ell)*Real.log x+
        Real.log c2-(2*t-1)*Real.log 4 := by
    rw [hii,hlogA,hlogZ,hlogL]
    ring
  have hpriceI : Real.log (x/(c1*J*G*R^(2*k)))=PI*Real.log x+KI := by
    rw [hpi,hlogL,hlogQ,hlogZ]
    dsimp only [PI,KI]
    ring
  have hpriceII : Real.log (Real.sqrt (x/(c2*G^2*R^(2*k-3))))=
      PII/2*Real.log x+KII := by
    rw [hpii,hlogL,hlogH,hlogA,hlogZ]
    dsimp only [PII,KII]
    ring
  have hlogB (K : ℝ) : Real.log (Real.exp K*x^b)=K+b*Real.log x := by
    rw [Real.log_mul (ne_of_gt (Real.exp_pos K)) (by positivity : x^b≠0),
      Real.log_exp,floor_log_rpow_pos x b hxp]
  constructor
  · intro hf1 hf2 hp
    have hh1 : Real.log C1≤Real.log (J*R^2) := by
      rw [hforce1]
      have hh := mul_lt_mul_of_pos_right hf1 hX
      linarith only [hh,hcost1]
    have hh2 : Real.log C1≤Real.log (J*R^(2*k+1)/x) := by
      rw [hforce2]
      have hh := mul_lt_mul_of_pos_right hf2 hX
      linarith only [hh,hcost2]
    have hc1a := floor_le_of_log_le C1 (J*R^2) hC1 (by positivity) hh1
    have hc1b := floor_le_of_log_le C1 (J*R^(2*k+1)/x) hC1 (by positivity) hh2
    have hhprice : Real.log (x/(c1*J*G*R^(2*k)))≤Real.log (Real.exp KI*x^b) := by
      rw [hpriceI,hlogB]
      have hh := mul_le_mul_of_nonneg_right hp hX.le
      linarith only [hh]
    refine ⟨hc1a,(le_div_iff₀ hxp).mp hc1b,?_⟩
    exact floor_le_of_log_le _ _ (by positivity) (by positivity) hhprice
  · intro hf hp
    have hh : 0≤Real.log (c2*R^(2*k-1)/x) := by
      rw [hforceII]
      have hh := mul_lt_mul_of_pos_right hf hX
      linarith only [hh,hcostII]
    have hhforce : 1≤c2*R^(2*k-1)/x :=
      floor_le_of_log_le _ _ (by norm_num) (by positivity) (by simpa using hh)
    have hhprice : Real.log (Real.sqrt (x/(c2*G^2*R^(2*k-3))))≤
        Real.log (Real.exp KII*x^b) := by
      rw [hpriceII,hlogB]
      have hhalf : PII/2≤b := by linarith only [hp]
      have hh := mul_le_mul_of_nonneg_right hhalf hX.le
      linarith only [hh]
    refine ⟨?_,floor_le_of_log_le _ _ (by positivity) (by positivity) hhprice⟩
    have hh := (le_div_iff₀ hxp).mp hhforce
    simpa only [one_mul] using hh

end A8FloorExt
