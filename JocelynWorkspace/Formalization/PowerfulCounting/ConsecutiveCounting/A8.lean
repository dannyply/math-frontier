    exact signed_natAbs X
  have hyscale : (g:ℤ)*Y0=Y := by
    dsimp [Y0]
    rw [signedNat_mul,hynat]
    exact signed_natAbs Y
  have hnorm0 : X0^2-(Delta:ℤ)*Y0^2=h0 := by
    dsimp [X0,Y0,h0]
    rw [signedNat_sq,signedNat_sq]
  have hscale : h=(g:ℤ)^2*h0 := by
    calc
      h=X^2-(Delta:ℤ)*Y^2 := hnorm.symm
      _=((g:ℤ)*X0)^2-(Delta:ℤ)*((g:ℤ)*Y0)^2 := by rw [hxscale,hyscale]
      _=(g:ℤ)^2*(X0^2-(Delta:ℤ)*Y0^2) := by ring
      _=(g:ℤ)^2*h0 := by rw [hnorm0]
