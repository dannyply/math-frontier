abbrev Point := (ℕ×ℕ)×(ℕ×ℕ)
def OriginalBox : ℕ → ℝ → ℝ → ℝ → Set Point := fun k x D E => {z | 1 ≤ z.1.1 ∧ 1 ≤ z.1.2 ∧ 1 ≤ z.2.1 ∧ 1 ≤ z.2.2 ∧ z.1.2 ^ k * z.2.2 = z.1.1 ^ k * z.2.1 + 1 ∧ x / 2 < (z.1.1 : ℝ) ^ k * (z.2.1 : ℝ) ∧ (z.1.1 : ℝ) ^ k * (z.2.1 : ℝ) ≤ x ∧ D / 2 < (z.1.1 : ℝ) ∧ (z.1.1 : ℝ) ≤ D ∧ E / 2 < (z.1.2 : ℝ) ∧ (z.1.2 : ℝ) ≤ E}
def Bihom (G : MvPolynomial (Fin 4) ℤ) (a b : ℕ) : Prop := ∀ m ∈ G.support, m 0 + m 1 = a ∧ m 2 + m 3 = b
def SixMargin : ℕ → ℝ → ℝ → ℝ → Prop := fun k s m b => 0 < b ∧ 0 < ((k : ℝ) + 1) * (s - m - b) / (3 * (k : ℝ) + 2) ∧ 0 < (4 * (k : ℝ) * b - 2 * (k : ℝ) + (2 * (k : ℝ) ^ 2 - (k : ℝ) + 1) * s) / (2 * (k : ℝ) + 1) - 2 * (2 * (k : ℝ) ^ 2 + (k : ℝ) + 1) / (2 * (k : ℝ) + 1) * (((k : ℝ) + 1) * (s - m - b) / (3 * (k : ℝ) + 2)) ∧ 0 < ((2 * (k : ℝ) ^ 2 + 3 * (k : ℝ) + 3) * b - 2 * s - 2 * (k : ℝ) - 2) / (2 * (k : ℝ) + 1) + ((k : ℝ) + 1) * m ∧ 0 < ((k : ℝ) + 2) * b + ((k : ℝ) + 1) * m - s - 1 ∧ 0 < (2 * (2 * (k : ℝ) - 1) * m - 2) / (2 * (k : ℝ) + 1)

def Cell (k : ℕ) (x D E : ℝ) (M : ℕ) (r : ℝ) : Set Point :=
  {z | z ∈ OriginalBox k x D E ∧
    r < (z.1.1:ℝ)/(z.1.2:ℝ) ∧
    (z.1.1:ℝ)/(z.1.2:ℝ) ≤ r*(1+1/(M:ℝ))}

