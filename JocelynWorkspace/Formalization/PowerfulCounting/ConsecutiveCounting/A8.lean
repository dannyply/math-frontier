abbrev wG:=af.wG
abbrev Mat:=Matrix (Fin 2) (Fin 2) ℤ
def subst (A:Mat):wG→ₐ[ℚ] wG:= aeval ![
    C (A 0 0:ℚ)*X 0+C (A 0 1:ℚ)*X 1,C (A 1 0:ℚ)*X 0+C (A 1 1:ℚ)*X 1,X 2]
lemma pv (A:Mat):
    subst A (X (0:Fin 3))= C (A 0 0:ℚ)*X 0+C (A 0 1:ℚ)*X 1:=by
  simp [subst]
lemma pw (A:Mat):
    subst A (X (1:Fin 3))= C (A 1 0:ℚ)*X 0+C (A 1 1:ℚ)*X 1:=by
  simp [subst]
lemma px (A:Mat):subst A (X (2:Fin 3))=X 2:=by
  simp [subst]
lemma py (A B:Mat):
    (subst B).comp (subst A)=subst (A*B):=by
  apply c6
  intro i
  fin_cases i<;>
    simp [subst,bZ,Fin.sum_univ_two,map_add,map_mul]<;> ring
lemma pz:subst (1:Mat)=AlgHom.id ℚ wG:=by
  apply c6
  intro i
  fin_cases i<;> simp [subst,]
lemma gI (k:ℕ) (A:Mat) (i:Fin 3):
    uK (af.wt k)
      (subst A (X i)) (af.wt k i):=by
  fin_cases i
  · change uK (af.wt k)
      (subst A (X (0:Fin 3))) (af.wt k (0:Fin 3))
    rw [pv]
    have h0:=(isWeightedHomogeneous_C (af.wt k) (A 0 0:ℚ)).mul
      (isWeightedHomogeneous_X ℚ (af.wt k) (0:Fin 3))
    have h1:=(isWeightedHomogeneous_C (af.wt k) (A 0 1:ℚ)).mul
      (isWeightedHomogeneous_X ℚ (af.wt k) (1:Fin 3))
    convert h0.add h1 using 1; simp [af.wt]
  · change uK (af.wt k)
      (subst A (X (1:Fin 3))) (af.wt k (1:Fin 3))
    rw [pw]
    have h0:=(isWeightedHomogeneous_C (af.wt k) (A 1 0:ℚ)).mul
      (isWeightedHomogeneous_X ℚ (af.wt k) (0:Fin 3))
    have h1:=(isWeightedHomogeneous_C (af.wt k) (A 1 1:ℚ)).mul
      (isWeightedHomogeneous_X ℚ (af.wt k) (1:Fin 3))
    convert h0.add h1 using 1; simp [af.wt]
  · change uK (af.wt k)
      (subst A (X (2:Fin 3))) (af.wt k (2:Fin 3))
    rw [px]
    exact isWeightedHomogeneous_X ℚ (af.wt k) (2:Fin 3)
lemma pA (n:Fin 3→₀ ℕ) (c:ℚ):
    monomial n c=C c*X 0^(n 0)*X 1^(n 1)*X 2^(n 2):=by
  rw [monomial_eq,bg _ _ (by intro i;simp)]
  simp [Fin.prod_univ_succ,aG]
lemma pB (k:ℕ) (A:Mat)
    (n:Fin 3→₀ ℕ) (c:ℚ):
    uK (af.wt k)
      (subst A (monomial n c)) (aK (af.wt k) n):=by
  rw [pA,map_mul,map_mul,map_mul,map_pow,map_pow,map_pow]
  have hC:subst A (C c)=C c:=by simp [subst]
  rw [hC]
  have h0:=gI k A (0:Fin 3)
  have h1:=gI k A (1:Fin 3)
  have h2:=gI k A (2:Fin 3)
  have h:=(((isWeightedHomogeneous_C (af.wt k) c).mul
    (h0.pow (n 0))).mul (h1.pow (n 1))).mul (h2.pow (n 2))
  convert h using 1; simp only [af.dJ];
    simp [af.wt]; ring
lemma ka (k:ℕ) (A:Mat) (m:ℕ)
    (p:wG)
    (hp:p∈ weightedHomogeneousSubmodule ℚ (af.wt k) m):
    subst A p∈ weightedHomogeneousSubmodule ℚ (af.wt k) m:=by
  classical
  have hP:uK (af.wt k) p m:= (mem_weightedHomogeneousSubmodule ℚ (af.wt k) m p).mp hp
  rw [p.as_sum,map_sum]
  apply Submodule.sum_mem
  intro n hn
  rw [mem_weightedHomogeneousSubmodule]
  have hw:=hP (mem_support_iff.mp hn)
  simpa only [hw] using pB k A n (coeff n p)
lemma pC (k:ℕ) (A P:Mat)
    (hPA:P*A=1) (m:ℕ):
    Submodule.map (subst A).toLinearMap
      (weightedHomogeneousSubmodule ℚ (af.wt k) m)= weightedHomogeneousSubmodule ℚ (af.wt k) m:=by
  apply le_antisymm
  · rw [Submodule.map_le_iff_le_comap]
    intro p hp
    exact ka k A m p hp
  · intro p hp
    apply Submodule.mem_map.mpr
    refine ⟨subst P p,ka k P m p hp,?_⟩
    have bN:(subst A).comp (subst P)=AlgHom.id ℚ wG:=by
      rw [py P A,hPA,pz]
    exact congrArg (fun ff:wG→ₐ[ℚ] wG=> ff p) bN
variable {K:Type*} [Field K] [Algebra ℚ K]
def cM (A:Mat) (d e:K):K:= (A 0 0:K)*d+(A 0 1:K)*e
def cN (A:Mat) (d e:K):K:= (A 1 0:K)*d+(A 1 1:K)*e
lemma pD (A:Mat) (d e t:K):
    (ao.eta d e t).comp (subst A)= ao.eta (cM A d e) (cN A d e) t:=by
  apply c6
  intro i
  fin_cases i<;>
    simp [ao.eta,subst,cM,cN,aeval_def,map_add,map_mul]
lemma pE (A:Mat) (d e t:K) (m:ℕ):
    ao.theta (cM A d e) (cN A d e) t m= (ao.theta d e t m).comp (subst A).toLinearMap:=by
  apply LinearMap.ext
  intro p
  have h:=congrArg
    (fun ff:wG→ₐ[ℚ] K=> ff p) (pD A d e t)
  simpa only [ao.theta,LinearMap.comp_apply,LinearMap.mulRight_apply,AlgHom.comp_apply,AlgHom.toLinearMap_apply] using congrArg
      (fun z:K=> z*t⁻¹^m) h.symm
lemma pF (k:ℕ) (hk:0< k)
    (A P:Mat) (hPA:P*A=1)
    (d e t:K) (ht:t ≠ 0) (m:ℕ):
    Submodule.map
      (ao.bj k (cM A d e) (cN A d e) t).toLinearMap
      (restrictTotalDegree (Fin (k+1)) ℚ m)= Submodule.map (ao.theta d e t m)
      (weightedHomogeneousSubmodule ℚ (af.wt k) (k*m)):=by
  have h:=ao.j5 k hk
    (cM A d e) (cN A d e) t ht m
  rw [pE A d e t m,Submodule.map_comp,pC k A P hPA (k*m)] at h
  exact h
end
end ae.b5
