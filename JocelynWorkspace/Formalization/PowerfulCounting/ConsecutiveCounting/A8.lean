private theorem block_coeff (G : MvPolynomial (Fin 4) ℤ) (a i j : ℕ)
    (hG : ∀ m ∈ G.support, m 0+m 1=a ∧ m 2+m 3=1) :
    (C01.PcParam.PP G).coeff (C01.PcCurves.ex i j) = G.coeff (idx i j 1 0) ∧
    (C01.PcParam.QQ G).coeff (C01.PcCurves.ex i j) = G.coeff (idx i j 0 1) := by
  classical
  constructor
  · unfold C01.PcParam.PP
    simp only [coeff_sum, C01.PcCurves.monomial_ex, coeff_monomial]
    rw [Finset.sum_eq_single (idx i j 1 0)]
    · simp [idx, C01.PcCurves.ex]
    · intro m hm hne
      rw [if_neg]
      intro he
      have h0 : m 0=i := by simpa using congrArg (fun f => f 0) he
      have h1 : m 1=j := by simpa using congrArg (fun f => f 1) he
      obtain ⟨hmS,hm2⟩ := Finset.mem_filter.mp hm
      have hm3 : m 3=0 := by have ht := (hG m hmS).2; omega
      apply hne
      ext t
      fin_cases t <;> simp [idx] <;> omega
    · intro hn
      have hc : G.coeff (idx i j 1 0)=0 := by
        by_contra hc
        apply hn
        exact Finset.mem_filter.mpr ⟨mem_support_iff.mpr hc,by simp [idx]⟩
      simp [hc]
  · unfold C01.PcParam.QQ
    simp only [coeff_sum, C01.PcCurves.monomial_ex, coeff_monomial]
    rw [Finset.sum_eq_single (idx i j 0 1)]
    · simp [idx, C01.PcCurves.ex]
    · intro m hm hne
      rw [if_neg]
      intro he
      have h0 : m 0=i := by simpa using congrArg (fun f => f 0) he
      have h1 : m 1=j := by simpa using congrArg (fun f => f 1) he
      obtain ⟨hmS,hm2⟩ := Finset.mem_filter.mp hm
      have hm20 : m 2=0 := by have ht := (hG m hmS).2; omega
      have hm3 : m 3=1 := by have ht := (hG m hmS).2; omega
      apply hne
      ext t
      fin_cases t <;> simp [idx] <;> omega
    · intro hn
      have hc : G.coeff (idx i j 0 1)=0 := by
        by_contra hc
        apply hn
        exact Finset.mem_filter.mpr ⟨mem_support_iff.mpr hc,by simp [idx]⟩
      simp [hc]

private def canonicalP (G : MvPolynomial (Fin 4) ℤ) (a : ℕ) : MvPolynomial (Fin 2) ℤ :=
  ∑ i ∈ Finset.range (a+1), C (G.coeff (idx i (a-i) 1 0))*X 0^i*X 1^(a-i)

private def canonicalQ (G : MvPolynomial (Fin 4) ℤ) (a : ℕ) : MvPolynomial (Fin 2) ℤ :=
  ∑ i ∈ Finset.range (a+1), C (-G.coeff (idx i (a-i) 0 1))*X 0^i*X 1^(a-i)

private theorem canonical_blocks (G : MvPolynomial (Fin 4) ℤ) (a : ℕ)
    (hG : ∀ m ∈ G.support, m 0+m 1=a ∧ m 2+m 3=1) :
    canonicalP G a=C01.PcParam.PP G ∧ canonicalQ G a= -C01.PcParam.QQ G := by
  constructor
  · rw [C01.PcCurves.hom_repr (C01.PcParam.PP_hom G a hG)]
    unfold canonicalP
    apply Finset.sum_congr rfl
    intro i hi
    rw [(block_coeff G a i (a-i) hG).1]
  · rw [C01.PcCurves.hom_repr (C01.PcParam.QQ_hom G a hG),←Finset.sum_neg_distrib]
    unfold canonicalQ
    apply Finset.sum_congr rfl
    intro i hi
    rw [(block_coeff G a i (a-i) hG).2]
    simp

private theorem pure_small_noCommon
    (k α : ℕ) (hk : 5 ≤ k) (hα : 1 ≤ α) (hgap : α+2 ≤ k)
    (A B : MvPolynomial (Fin 2) ℂ)
    (hA : A.IsHomogeneous α) (hB : B.IsHomogeneous α)
    (hno : ∀ w : Fin 2 → ℂ, w ≠ 0 →
      MvPolynomial.eval w A=0 → MvPolynomial.eval w B=0 → False)
    (γ a b : ℂ) (hγ : γ ≠ 0) (_hab : a ≠ 0 ∨ b ≠ 0)
    (hR : X (1:Fin 2)^k*A+X (0:Fin 2)^k*B =
      C γ*(C a*X (0:Fin 2)+C b*X (1:Fin 2))^(α+k)) : False := by
  have hD : C01.PcCurves.dehom A+Polynomial.X^k*C01.PcCurves.dehom B =
      Polynomial.C γ*(Polynomial.C a*Polynomial.X+Polynomial.C b)^(α+k) := by
    have ht := congrArg C01.PcCurves.dehom hR
    simpa [C01.PcCurves.dehom,map_add,map_mul,map_pow,
      MvPolynomial.aeval_X,MvPolynomial.aeval_C,Polynomial.algebraMap_eq] using ht
  have hdA : (C01.PcCurves.dehom A).natDegree ≤ α :=
    C01.PcCurves.dehom_natDegree_le hA
  have hdB : (C01.PcCurves.dehom B).natDegree ≤ α :=
    C01.PcCurves.dehom_natDegree_le hB
  have hk0 : k ≠ 0 := by omega
  have hsum0 : α+k ≠ 0 := by omega
  have haxis : a=0 ∨ b=0 := by
    by_cases ha : a=0
    · exact Or.inl ha
    right
    have hcoeff : (C01.PcCurves.dehom A+Polynomial.X^k*
        C01.PcCurves.dehom B).coeff (α+1) =
        (Polynomial.C γ*(Polynomial.C a*Polynomial.X+
          Polynomial.C b)^(α+k)).coeff (α+1) := by rw [hD]
    have hAcoeff : (C01.PcCurves.dehom A).coeff (α+1)=0 :=
      Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)
    have hleft : (C01.PcCurves.dehom A+Polynomial.X^k*
        C01.PcCurves.dehom B).coeff (α+1)=0 := by
      rw [Polynomial.coeff_add,hAcoeff,Polynomial.coeff_X_pow_mul',
        if_neg (by omega : ¬ k ≤ α+1)]
      simp
    have hfac : (Polynomial.C a*Polynomial.X+Polynomial.C b : Polynomial ℂ) =
        Polynomial.C a*(Polynomial.X+Polynomial.C (b/a)) := by
      rw [mul_add,←Polynomial.C_mul,mul_div_cancel₀ b ha]
    have hright : (Polynomial.C γ*(Polynomial.C a*Polynomial.X+
        Polynomial.C b : Polynomial ℂ)^(α+k)).coeff (α+1) =
        γ*a^(α+k)*((b/a)^(α+k-(α+1))*((α+k).choose (α+1) : ℂ)) := by
      rw [hfac,mul_pow,←Polynomial.C_pow,←mul_assoc,←Polynomial.C_mul,
        Polynomial.coeff_C_mul,Polynomial.coeff_X_add_C_pow]
    rw [hleft,hright] at hcoeff
    have hchoose : ((α+k).choose (α+1) : ℂ) ≠ 0 := by
      have hp : 0 < (α+k).choose (α+1) := Nat.choose_pos (by omega)
      exact_mod_cast hp.ne'
    have hγa : γ*a^(α+k) ≠ 0 := mul_ne_zero hγ (pow_ne_zero _ ha)
    have hprod : (b/a)^(α+k-(α+1))*((α+k).choose (α+1) : ℂ)=0 :=
      (mul_eq_zero.mp hcoeff.symm).resolve_left hγa
    have hbpow : (b/a)^(α+k-(α+1))=0 :=
      (mul_eq_zero.mp hprod).resolve_right hchoose
    have hbdiv : b/a=0 := (pow_eq_zero_iff (by omega)).mp hbpow
    rcases div_eq_zero_iff.mp hbdiv with hb|ha'
    · exact hb
    · exact (ha ha').elim
  rcases haxis with ha0|hb0
  · have hB10 : MvPolynomial.eval ![(1:ℂ),0] B=0 := by
      have ht := congrArg (MvPolynomial.eval ![(1:ℂ),0]) hR
      simpa [ha0,zero_pow hk0,zero_pow hsum0] using ht
    have hcoeff : (C01.PcCurves.dehom A+Polynomial.X^k*
        C01.PcCurves.dehom B).coeff α =
        (Polynomial.C γ*(Polynomial.C a*Polynomial.X+
          Polynomial.C b)^(α+k)).coeff α := by rw [hD]
    rw [ha0,Polynomial.C_0,zero_mul,zero_add,←Polynomial.C_pow,
      ←Polynomial.C_mul,Polynomial.coeff_C,
      if_neg (by omega : ¬ α=0),Polynomial.coeff_add,
      Polynomial.coeff_X_pow_mul',if_neg (by omega : ¬ k ≤ α),add_zero,
      C01.PcCurves.dehom_coeff hA,if_pos le_rfl,Nat.sub_self] at hcoeff
    have hA10 : MvPolynomial.eval ![(1:ℂ),0] A=0 := by
      rw [C01.PcCurves.eval_one_zero hA]
      exact hcoeff
    have hw : (![(1:ℂ),0] : Fin 2 → ℂ) ≠ 0 := by
      intro hz
      have ht := congrFun hz 0
      simp at ht
    exact hno _ hw hA10 hB10
  · have hA01 : MvPolynomial.eval ![(0:ℂ),1] A=0 := by
      have ht := congrArg (MvPolynomial.eval ![(0:ℂ),1]) hR
      simpa [hb0,zero_pow hk0,zero_pow hsum0] using ht
    have hcoeff : (C01.PcCurves.dehom A+Polynomial.X^k*
        C01.PcCurves.dehom B).coeff k =
        (Polynomial.C γ*(Polynomial.C a*Polynomial.X+
          Polynomial.C b)^(α+k)).coeff k := by rw [hD]
    have hAk : (C01.PcCurves.dehom A).coeff k=0 :=
