abbrev Quad := (ℕ × ℕ) × (ℕ × ℕ)
def positivePairs (x : ℝ) : Set Quad :=
  {q | 1 ≤ q.1.1 ∧ 1 ≤ q.1.2 ∧ 1 ≤ q.2.1 ∧ 1 ≤ q.2.2 ∧
    ((q.1.1 ^ 2 * q.2.1 : ℕ) : ℝ) ≤ x ∧
    q.1.2 ^ 2 * q.2.2 = q.1.1 ^ 2 * q.2.1 + 1}

theorem pos_coords_le (d e u v : ℕ)
    (hd : 1 ≤ d) (he : 1 ≤ e) (hu : 1 ≤ u) (hv : 1 ≤ v)
    (hEq : e ^ 2 * v = d ^ 2 * u + 1) :
    d ≤ d ^ 2 * u ∧ u ≤ d ^ 2 * u ∧
    e ≤ d ^ 2 * u + 1 ∧ v ≤ d ^ 2 * u + 1 := by
  have hn : 0 < d ^ 2 * u := by positivity
  have hm : 0 < e ^ 2 * v := by positivity
  have hdvd : d ∣ d ^ 2 * u := by
    refine ⟨d * u, ?_⟩
    ring
  have huvd : u ∣ d ^ 2 * u := by
    refine ⟨d ^ 2, ?_⟩
    ring
  have hevd : e ∣ e ^ 2 * v := by
    refine ⟨e * v, ?_⟩
    ring
  have hvvd : v ∣ e ^ 2 * v := by
    refine ⟨e ^ 2, ?_⟩
    ring
  exact ⟨Nat.le_of_dvd hn hdvd, Nat.le_of_dvd hn huvd,
    hEq ▸ Nat.le_of_dvd hm hevd,
    hEq ▸ Nat.le_of_dvd hm hvvd⟩

theorem finite_positivePairs (x : ℝ) : (positivePairs x).Finite := by
  let B : ℕ := ⌊x⌋₊ + 1
  have hF : (((Set.Iic B ×ˢ Set.Iic B) ×ˢ
      (Set.Iic B ×ˢ Set.Iic B)) : Set Quad).Finite := by
    exact ((Set.finite_Iic B).prod (Set.finite_Iic B)).prod
      ((Set.finite_Iic B).prod (Set.finite_Iic B))
  apply hF.subset
  intro q hq
  rcases q with ⟨⟨d,e⟩,⟨u,v⟩⟩
  rcases hq with ⟨hd,he,hu,hv,hx,hEq⟩
  obtain ⟨hD,hU,hE,hV⟩ := pos_coords_le d e u v hd he hu hv hEq
  have hn : d ^ 2 * u ≤ ⌊x⌋₊ := Nat.le_floor hx
  simp only [Set.mem_prod, Set.mem_Iic]
  dsimp [B]
  omega

theorem count_by_n (S : Set Quad) (A : Finset ℕ)
    (hpos : ∀ q ∈ S, 1 ≤ q.1.1 ∧ 1 ≤ q.1.2 ∧ 1 ≤ q.2.1 ∧
      1 ≤ q.2.2 ∧ q.1.2 ^ 2 * q.2.2 = q.1.1 ^ 2 * q.2.1 + 1)
    (hA : ∀ q ∈ S, q.1.1 ^ 2 * q.2.1 ∈ A) :
    S.ncard ≤ ∑ n ∈ A, n.divisors.card * (n + 1).divisors.card := by
  let T : Finset (Σ n : ℕ, ℕ × ℕ) :=
    A.sigma (fun n => n.divisors.product (n + 1).divisors)
  have hc := Set.ncard_le_ncard_of_injOn
    (s := S) (t := (T : Set (Σ n : ℕ, ℕ × ℕ)))
    (fun q : Quad => ⟨q.1.1 ^ 2 * q.2.1, (q.1.1, q.1.2)⟩)
    (by
      intro q hq
      rcases q with ⟨⟨d,e⟩,⟨u,v⟩⟩
      obtain ⟨hd,he,hu,hv,hEq⟩ := hpos _ hq
      change e ^ 2 * v = d ^ 2 * u + 1 at hEq
      change (⟨d ^ 2 * u,(d,e)⟩ : Σ n : ℕ, ℕ × ℕ) ∈
        A.sigma (fun n => n.divisors.product (n + 1).divisors)
      rw [Finset.mem_sigma]
      constructor
      · exact hA _ hq
      · change (d,e) ∈ (d ^ 2 * u).divisors.product ((d ^ 2 * u) + 1).divisors
        apply Finset.mem_product.mpr
        constructor
        · exact Nat.mem_divisors.mpr
            ⟨⟨d * u, by ring⟩, by positivity⟩
        · refine Nat.mem_divisors.mpr ⟨⟨e * v, ?_⟩, by omega⟩
          calc
            d ^ 2 * u + 1 = e ^ 2 * v := hEq.symm
            _ = e * (e * v) := by ring)
    (by
      intro q hq r hr h
      rcases q with ⟨⟨d,e⟩,⟨u,v⟩⟩
      rcases r with ⟨⟨d',e'⟩,⟨u',v'⟩⟩
      obtain ⟨hd,he,hu,hv,hEq⟩ := hpos _ hq
      obtain ⟨hd',he',hu',hv',hEq'⟩ := hpos _ hr
      change e ^ 2 * v = d ^ 2 * u + 1 at hEq
      change e' ^ 2 * v' = d' ^ 2 * u' + 1 at hEq'
      have hn : d ^ 2 * u = d' ^ 2 * u' := congrArg Sigma.fst h
      have hde : (d,e) = (d',e') := congrArg Sigma.snd h
      have hdd : d = d' := congrArg Prod.fst hde
      have hee : e = e' := congrArg Prod.snd hde
      subst d'
      subst e'
      have huu : u = u' := Nat.eq_of_mul_eq_mul_left (by positivity : 0 < d ^ 2) hn
      have hvv : v = v' := by
        apply Nat.eq_of_mul_eq_mul_left (by positivity : 0 < e ^ 2)
        omega
      subst u'
      subst v'
      rfl)
  have hc' : S.ncard ≤ T.card := by
    simpa only [Set.ncard_coe_finset] using hc
  calc
    S.ncard ≤ T.card := hc'
    _ = ∑ n ∈ A, n.divisors.card * (n + 1).divisors.card := by
      simp [T, Finset.card_sigma, Finset.card_product]
theorem divisor_uniform (ε C x : ℝ) (hε : 0 < ε) (hC : 0 < C) (hx : 2 ≤ x)
    (hτ : ∀ n : ℕ, 0 < n →
      (n.divisors.card : ℝ) ≤ C * (n : ℝ) ^ (ε / 3))
    (n : ℕ) (hn : 1 ≤ n) (hnx : (n : ℝ) ≤ x) :
    ((n.divisors.card * (n + 1).divisors.card : ℕ) : ℝ) ≤
      C ^ 2 * x ^ ε := by
  have hδ : 0 < ε / 3 := by linarith
  have hn1x2 : ((n + 1 : ℕ) : ℝ) ≤ x ^ 2 := by
    have hn1x1 : ((n + 1 : ℕ) : ℝ) ≤ x + 1 := by
      simp only [Nat.cast_add, Nat.cast_one]
      linarith [hnx]
    have hx2 : x + 1 ≤ x ^ 2 := by
      nlinarith [mul_nonneg (by linarith : 0 ≤ x - 2) (by linarith : 0 ≤ x)]
    exact hn1x1.trans hx2
  have hτn := hτ n (by omega)
  have hτm := hτ (n + 1) (by omega)
  have hpowN : (n : ℝ) ^ (ε / 3) ≤ x ^ (ε / 3) :=
    Real.rpow_le_rpow (by positivity) hnx hδ.le
  have hpowM : ((n + 1 : ℕ) : ℝ) ^ (ε / 3) ≤ (x ^ 2) ^ (ε / 3) :=
    Real.rpow_le_rpow (by positivity) hn1x2 hδ.le
  have hpowM' : ((n + 1 : ℕ) : ℝ) ^ (ε / 3) ≤ x ^ (2 * (ε / 3)) := by
    simpa only [← Real.rpow_natCast_mul (by linarith : 0 ≤ x) 2 (ε / 3), Nat.cast_ofNat]
      using hpowM
  have hpair : ((n.divisors.card * (n + 1).divisors.card : ℕ) : ℝ) ≤
      (C * (n : ℝ) ^ (ε / 3)) *
      (C * ((n + 1 : ℕ) : ℝ) ^ (ε / 3)) := by
    rw [Nat.cast_mul]
    exact mul_le_mul hτn hτm (by positivity) (by positivity)
  have hpair2 : (C * (n : ℝ) ^ (ε / 3)) *
      (C * ((n + 1 : ℕ) : ℝ) ^ (ε / 3)) ≤
      (C * x ^ (ε / 3)) * (C * x ^ (2 * (ε / 3))) := by
    gcongr
  calc
    ((n.divisors.card * (n + 1).divisors.card : ℕ) : ℝ) ≤
        (C * (n : ℝ) ^ (ε / 3)) *
        (C * ((n + 1 : ℕ) : ℝ) ^ (ε / 3)) := hpair
    _ ≤ (C * x ^ (ε / 3)) * (C * x ^ (2 * (ε / 3))) := hpair2
    _ = C ^ 2 * (x ^ (ε / 3) * x ^ (2 * (ε / 3))) := by ring
    _ = C ^ 2 * x ^ ε := by
      rw [← Real.rpow_add (by linarith : 0 < x)]
      have : ε / 3 + 2 * (ε / 3) = ε := by ring
      rw [this]
theorem count_with_card (S : Set Quad) (A : Finset ℕ)
    (x ε C K α : ℝ) (hx : 2 ≤ x) (hε : 0 < ε) (hC : 0 < C)
    (hpos : ∀ q ∈ S, 1 ≤ q.1.1 ∧ 1 ≤ q.1.2 ∧ 1 ≤ q.2.1 ∧
      1 ≤ q.2.2 ∧ q.1.2 ^ 2 * q.2.2 = q.1.1 ^ 2 * q.2.1 + 1)
    (hA : ∀ q ∈ S, q.1.1 ^ 2 * q.2.1 ∈ A)
    (hAreg : ∀ n ∈ A, 1 ≤ n ∧ (n : ℝ) ≤ x)
    (hcard : (A.card : ℝ) ≤ K * x ^ α)
    (hτ : ∀ n : ℕ, 0 < n →
      (n.divisors.card : ℝ) ≤ C * (n : ℝ) ^ (ε / 3)) :
    (S.ncard : ℝ) ≤ K * C ^ 2 * x ^ (α + ε) := by
  have hsum := count_by_n S A hpos hA
  have hsumR : (S.ncard : ℝ) ≤
      ∑ n ∈ A, ((n.divisors.card * (n + 1).divisors.card : ℕ) : ℝ) := by
    exact_mod_cast hsum
  have hunif : ∀ n ∈ A,
      ((n.divisors.card * (n + 1).divisors.card : ℕ) : ℝ) ≤
        C ^ 2 * x ^ ε := by
    intro n hn
    obtain ⟨hn1, hnx⟩ := hAreg n hn
    exact divisor_uniform ε C x hε hC hx hτ n hn1 hnx
  have hsumBound :
      (∑ n ∈ A, ((n.divisors.card * (n + 1).divisors.card : ℕ) : ℝ)) ≤
        (A.card : ℝ) * (C ^ 2 * x ^ ε) := by
    calc
      _ ≤ ∑ n ∈ A, C ^ 2 * x ^ ε :=
        Finset.sum_le_sum (by intro n hn; exact hunif n hn)
      _ = (A.card : ℝ) * (C ^ 2 * x ^ ε) := by simp
  calc
    (S.ncard : ℝ) ≤
        ∑ n ∈ A, ((n.divisors.card * (n + 1).divisors.card : ℕ) : ℝ) := hsumR
    _ ≤ (A.card : ℝ) * (C ^ 2 * x ^ ε) := hsumBound
    _ ≤ (K * x ^ α) * (C ^ 2 * x ^ ε) :=
      mul_le_mul_of_nonneg_right hcard (by positivity)
    _ = K * C ^ 2 * x ^ (α + ε) := by
      rw [Real.rpow_add (by linarith : 0 < x)]
      ring
end A8ExcGen

namespace A8ExcCore
open Polynomial

abbrev Quad := (ℕ × ℕ) × (ℕ × ℕ)

theorem growth (P : ℚ[X]) (hm : 1 ≤ P.natDegree) :
    ∃ K : ℚ, 1 ≤ K ∧ ∀ t Y : ℚ, 1 ≤ Y → |P.eval t| ≤ Y →
      |t| ^ P.natDegree ≤ K * Y := by
  have hP0 : P ≠ 0 := by
    rintro rfl
    simp at hm
  have ha : P.leadingCoeff ≠ 0 := leadingCoeff_ne_zero.mpr hP0
  have ha' : 0 < |P.leadingCoeff| := abs_pos.mpr ha
  obtain ⟨A, hAeq⟩ : ∃ A : ℚ, ∑ i ∈ Finset.range P.natDegree, |P.coeff i| = A := ⟨_, rfl⟩
  have hA : 0 ≤ A := by
    rw [← hAeq]
    exact Finset.sum_nonneg (fun i _ => abs_nonneg _)
  obtain ⟨T0, hT0eq⟩ : ∃ T0 : ℚ, T0 = 1 + 2 * A / |P.leadingCoeff| := ⟨_, rfl⟩
  have hT0 : 1 ≤ T0 := by
    have : 0 ≤ 2 * A / |P.leadingCoeff| := div_nonneg (by linarith) (abs_nonneg _)
    linarith
  have hT0m : (1:ℚ) ≤ T0 ^ P.natDegree := one_le_pow₀ hT0
  have h2a : (0:ℚ) ≤ 2 / |P.leadingCoeff| := div_nonneg (by norm_num) (abs_nonneg _)
  refine ⟨T0 ^ P.natDegree + 2 / |P.leadingCoeff| + 1, by linarith, ?_⟩
  intro t Y hY hev
  have hK0 : 0 ≤ T0 ^ P.natDegree + 2 / |P.leadingCoeff| + 1 := by linarith
  by_cases ht : |t| ≤ T0
  · have h1 : |t| ^ P.natDegree ≤ T0 ^ P.natDegree :=
      pow_le_pow_left₀ (abs_nonneg t) ht _
    have h2 := mul_nonneg hK0 (by linarith : (0:ℚ) ≤ Y - 1)
    nlinarith
  · push Not at ht
    have ht1 : 1 ≤ |t| := le_trans hT0 ht.le
    have hsplit : P.eval t = P.leadingCoeff * t ^ P.natDegree +
        ∑ i ∈ Finset.range P.natDegree, P.coeff i * t ^ i := by
      rw [eval_eq_sum_range, Finset.sum_range_succ]
      simp only [leadingCoeff]
      ring
    have hlow : |∑ i ∈ Finset.range P.natDegree, P.coeff i * t ^ i| ≤
        A * |t| ^ (P.natDegree - 1) := by
      calc |∑ i ∈ Finset.range P.natDegree, P.coeff i * t ^ i|
          ≤ ∑ i ∈ Finset.range P.natDegree, |P.coeff i * t ^ i| :=
            Finset.abs_sum_le_sum_abs _ _
        _ ≤ ∑ i ∈ Finset.range P.natDegree, |P.coeff i| * |t| ^ (P.natDegree - 1) := by
            apply Finset.sum_le_sum
            intro i hi
            rw [abs_mul, abs_pow]
            apply mul_le_mul_of_nonneg_left _ (abs_nonneg _)
            apply pow_le_pow_right₀ ht1
            have := Finset.mem_range.mp hi
            omega
        _ = A * |t| ^ (P.natDegree - 1) := by rw [← Finset.sum_mul, hAeq]
    have hpow : |t| ^ P.natDegree = |t| * |t| ^ (P.natDegree - 1) := by
      rw [← pow_succ']
      congr 1
      omega
    have hkey : |P.leadingCoeff| * |t| ^ P.natDegree ≤ Y + A * |t| ^ (P.natDegree - 1) := by
      have e1 : P.leadingCoeff * t ^ P.natDegree =
          P.eval t - ∑ i ∈ Finset.range P.natDegree, P.coeff i * t ^ i := by
        rw [hsplit]; ring
      have e2 : |P.leadingCoeff| * |t| ^ P.natDegree = |P.leadingCoeff * t ^ P.natDegree| := by
        rw [abs_mul, abs_pow]
      rw [e2, e1]
      have hE := abs_le.mp (le_refl |P.eval t|)
      have hL := abs_le.mp (le_refl |∑ i ∈ Finset.range P.natDegree, P.coeff i * t ^ i|)
      apply abs_le.mpr
      constructor
      · linarith [hE.1, hE.2, hL.1, hL.2]
      · linarith [hE.1, hE.2, hL.1, hL.2]
    have h1 : 2 * A / |P.leadingCoeff| < |t| := by rw [hT0eq] at ht; linarith
    have h2 : 2 * A < |t| * |P.leadingCoeff| := (div_lt_iff₀ ha').mp h1
    have hy0 : 0 ≤ |t| ^ (P.natDegree - 1) := pow_nonneg (abs_nonneg t) _
    have h3 : 2 * (A * |t| ^ (P.natDegree - 1)) ≤ |P.leadingCoeff| * |t| ^ P.natDegree := by
      rw [hpow]
      have := mul_le_mul_of_nonneg_right h2.le hy0
      linarith
    have h4 : |P.leadingCoeff| * |t| ^ P.natDegree ≤ 2 * Y := by linarith
    have h5 : |t| ^ P.natDegree ≤ 2 / |P.leadingCoeff| * Y := by
      rw [div_mul_eq_mul_div, le_div_iff₀ ha']
      linarith
    have h6 := mul_nonneg (by linarith : (0:ℚ) ≤ T0 ^ P.natDegree + 1) (by linarith : (0:ℚ) ≤ Y)
    nlinarith

theorem root_bound {s K Y : ℝ} {d : ℕ} (hd : 1 ≤ d) (_hs : 0 ≤ s) (hK : 1 ≤ K)
    (hY : 1 ≤ Y) (h : s ^ d ≤ K * Y) : s ≤ K * Y ^ ((1:ℝ) / d) := by
  by_contra hcon
  push Not at hcon
  have hY0 : (0:ℝ) ≤ Y := by linarith
  have hy : 0 ≤ Y ^ ((1:ℝ) / d) := Real.rpow_nonneg hY0 _
  have hd0 : (d:ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
  have hyd : (Y ^ ((1:ℝ) / d)) ^ d = Y := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul hY0]
    rw [one_div_mul_cancel hd0, Real.rpow_one]
  have hKy0 : 0 ≤ K * Y ^ ((1:ℝ) / d) := mul_nonneg (by linarith) hy
  have hd0' : d ≠ 0 := by omega
  have h1 : (K * Y ^ ((1:ℝ) / d)) ^ d < s ^ d :=
    pow_lt_pow_left₀ hcon hKy0 hd0'
  have h2 : K * Y ≤ (K * Y ^ ((1:ℝ) / d)) ^ d := by
    rw [mul_pow, hyd]
    have hKd : K ≤ K ^ d := by
      calc K = K ^ 1 := (pow_one K).symm
        _ ≤ K ^ d := pow_le_pow_right₀ hK hd
    exact mul_le_mul_of_nonneg_right hKd hY0
  linarith

theorem den_bound (P : ℚ[X]) (hm : 1 ≤ P.natDegree) :
    ∃ B : ℤ, B ≠ 0 ∧ ∀ (q t : ℚ), (∃ z : ℤ, (z : ℚ) = q) → P.eval t = q →
      ∃ j : ℤ, (j : ℚ) = (B : ℚ) * t := by
  obtain ⟨b, hbmem, hb⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors ℤ) P
  obtain ⟨Z, hZ⟩ : ∃ Z : ℤ[X], Z = IsLocalization.integerNormalization (nonZeroDivisors ℤ) P :=
    ⟨_, rfl⟩
  rw [← hZ] at hb
  have hb0' : (b : ℤ) ≠ 0 := nonZeroDivisors.ne_zero hbmem
  have hb0 : ((b : ℤ) : ℚ) ≠ 0 := by exact_mod_cast hb0'
  have hmapdeg : (Z.map (algebraMap ℤ ℚ)).natDegree = Z.natDegree :=
    natDegree_map_eq_of_injective (algebraMap ℤ ℚ).injective_int Z
  have hsmul : (b : ℤ) • P = Polynomial.C ((b : ℤ) : ℚ) * P := by
    ext i
    first
    | (simp [])
  have hZdeg : Z.natDegree = P.natDegree := by
    rw [← hmapdeg, hb, hsmul, natDegree_C_mul hb0]
  have hZpos : 0 < Z.degree := natDegree_pos_iff_degree_pos.mp (by omega)
  refine ⟨Z.leadingCoeff, ?_, ?_⟩
  · intro h
    rw [leadingCoeff_eq_zero] at h
    rw [h] at hZdeg
    simp at hZdeg
    omega
  intro q t ⟨z, hz⟩ hev
  have hWlc : (Z - Polynomial.C ((b : ℤ) * z)).leadingCoeff = Z.leadingCoeff := by
    apply leadingCoeff_sub_of_degree_lt
    calc (Polynomial.C ((b : ℤ) * z)).degree ≤ 0 := degree_C_le
      _ < Z.degree := hZpos
  have hWroot : aeval t (Z - Polynomial.C ((b : ℤ) * z)) = 0 := by
    have h1 : aeval t Z = ((b : ℤ) : ℚ) * q := by
      rw [aeval_def, ← eval_map, hb, hsmul, eval_mul, eval_C, hev]
    rw [map_sub, aeval_C, h1, ← hz]
    simp
  have hint : IsIntegral ℤ ((Z - Polynomial.C ((b : ℤ) * z)).leadingCoeff • t) := by
    first
    | exact isIntegral_leadingCoeff_smul _ _ hWroot
  obtain ⟨j, hj⟩ := (IsIntegrallyClosed.isIntegral_iff (R := ℤ) (K := ℚ)).mp hint
  refine ⟨j, ?_⟩
  rw [hWlc] at hj
  first
  | simpa using hj

theorem card_le_paramZ (A : Finset ℕ) (I : Finset ℤ) (F : ℤ → ℚ)
    (h : ∀ n ∈ A, ∃ k ∈ I, (n : ℚ) = F k) :
    A.card ≤ I.card := by
  classical
  let f : ℕ → ℤ := fun n => if hn : n ∈ A then Classical.choose (h n hn) else 0
  have hfn (n : ℕ) (hn : n ∈ A) : f n = Classical.choose (h n hn) := by
    simp [f, hn]
  have hf : ∀ n ∈ A, f n ∈ I := by
    intro n hn
    rw [hfn n hn]
    exact (Classical.choose_spec (h n hn)).1
  have hInj : Set.InjOn f (A : Set ℕ) := by
    intro n hn m hm heq
    have hFn : (n : ℚ) = F (f n) := by
      rw [hfn n hn]
      exact (Classical.choose_spec (h n hn)).2
    have hFm : (m : ℚ) = F (f m) := by
      rw [hfn m hm]
      exact (Classical.choose_spec (h m hm)).2
    have : (n : ℚ) = (m : ℚ) := by
      calc
        (n : ℚ) = F (f n) := hFn
        _ = F (f m) := by rw [heq]
        _ = (m : ℚ) := hFm.symm
    exact_mod_cast this
  have hc := Set.ncard_le_ncard_of_injOn
    (s := (A : Set ℕ)) (t := (I : Set ℤ)) f hf hInj
  simpa only [Set.ncard_coe_finset] using hc

noncomputable def vals (P : ℚ[X]) (y : ℝ) : Finset ℕ := by
  classical
  exact (Finset.Icc 1 ⌊y⌋₊).filter (fun n => ∃ t : ℚ, (n : ℚ) = P.eval t)

theorem mem_vals {P : ℚ[X]} {y : ℝ} {n : ℕ} :
    n ∈ vals P y ↔ n ∈ Finset.Icc 1 ⌊y⌋₊ ∧ ∃ t : ℚ, (n : ℚ) = P.eval t := by
  classical
  unfold vals
  first
  | exact Finset.mem_filter

theorem values_count (P : ℚ[X]) (m : ℕ) (hm1 : 1 ≤ m)
    (hdeg : P.natDegree = 0 ∨ m ≤ P.natDegree) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ y : ℝ, 1 ≤ y →
      ((vals P y).card : ℝ) ≤ K * y ^ ((1:ℝ) / m) := by
  rcases hdeg with h0 | hdm
  · refine ⟨1, by norm_num, ?_⟩
    intro y hy
    have hc : (vals P y).card ≤ 1 := by
      apply Finset.card_le_one.mpr
      intro a ha b hb
      obtain ⟨_, t1, ht1⟩ := mem_vals.mp ha
      obtain ⟨_, t2, ht2⟩ := mem_vals.mp hb
      rw [eq_C_of_natDegree_eq_zero h0, eval_C] at ht1 ht2
      exact_mod_cast ht1.trans ht2.symm
    have hy1 : (1:ℝ) ≤ y ^ ((1:ℝ) / m) := Real.one_le_rpow hy (by positivity)
    have : ((vals P y).card : ℝ) ≤ 1 := by exact_mod_cast hc
    linarith
  · have hd1 : 1 ≤ P.natDegree := le_trans hm1 hdm
    obtain ⟨K0, hK0, hgrow⟩ := growth P hd1
    obtain ⟨B, hB0, hden⟩ := den_bound P hd1
    have hK0r : (1:ℝ) ≤ (K0 : ℝ) := by exact_mod_cast hK0
    have hBq : (B : ℚ) ≠ 0 := by exact_mod_cast hB0
    refine ⟨2 * |(B : ℝ)| * (K0 : ℝ) + 1,
      add_nonneg (mul_nonneg (mul_nonneg (by norm_num) (abs_nonneg _)) (by linarith))
        (by norm_num), ?_⟩
    intro y hy
    have hy1 : (1:ℝ) ≤ y ^ ((1:ℝ) / m) := Real.one_le_rpow hy (by positivity)
    obtain ⟨R, hReq⟩ : ∃ R : ℝ, R = |(B : ℝ)| * (K0 : ℝ) * y ^ ((1:ℝ) / m) := ⟨_, rfl⟩
