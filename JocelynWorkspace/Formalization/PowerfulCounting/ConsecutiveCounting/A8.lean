      Finset.abs_sum_le_sum_abs _ _
    _ = ∑ i ∈ Finset.range (n+1), |p.coeff i| * |z|^i := by
      simp only [abs_mul,abs_pow]
    _ ≤ ∑ i ∈ Finset.range (n+1), |p.coeff i| * |z|^n := by
      apply Finset.sum_le_sum
      intro i hi
      exact mul_le_mul_of_nonneg_left
        (pow_le_pow_right₀ hz (by have := Finset.mem_range.mp hi; omega))
        (abs_nonneg _)
    _ = S * |z|^n := by dsimp [S]; rw [Finset.sum_mul]
    _ ≤ (S+1) * |z|^n := by
      apply mul_le_mul_of_nonneg_right (by linarith)
      positivity

