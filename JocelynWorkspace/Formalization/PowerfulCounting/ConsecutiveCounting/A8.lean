    (dh:¬ HasThreeProjectiveZeros R)
    (hInf:uI ![(1:ℂ),0]
      (R.map (uG ℂ))=0):
    ((C01.PcCurves.dehom R).map (uG ℚ)).Splits:=by
  classical
  let f0:ar ℤ:=C01.PcCurves.dehom R
  let f:ar ℚ:=f0.map (uG ℚ)
  let RC:aa (Fin 2) ℂ:=R.map (uG ℂ)
  have hRC:RC.IsHomogeneous n:=hR.map (uG ℂ)
  have hf0:f0 ≠ 0:=fun h=> hR0 (C01.PcCurves.eq_zero_of_dehom hR h)
  have hinj:uX (uG ℚ):=RingHom.injective_int _
  have hf:f ≠ 0:=(Polynomial.map_ne_zero_iff hinj).mpr hf0
  have bN:(algebraMap ℚ ℂ).comp (uG ℚ)=uG ℂ:=by
    ext z<;> simp
  have hvec:∀ z:ℂ,Polynomial.eval₂ (algebraMap ℚ ℂ) z f=0→ uI (pointVector (some z)) RC=0:=by
    intro z hz
    have hz':Polynomial.eval₂ (uG ℂ) z f0=0:=by
      simpa only [f,Polynomial.eval₂_map,bN] using hz
    change uI ![z,1] RC=0
    rw [← C01.PcCurves.dehom_eval hRC,C01.PcRes.dehom_map hR,Polynomial.eval_map]
    exact hz'
  have hrep:∀ z:ℂ,Polynomial.eval₂ (algebraMap ℚ ℂ) z f=0→ uI (projectivePoint (some z)).rep RC=0:=by
    intro z hz
    exact eval_projectivePoint_rep_zero RC n hRC (some z) (hvec z hz)
  have qo:uI (projectivePoint none).rep RC=0:=by
    apply eval_projectivePoint_rep_zero RC n hRC none
    exact hInf
  have hone:∀ z w:ℂ,Polynomial.eval₂ (algebraMap ℚ ℂ) z f=0→ Polynomial.eval₂ (algebraMap ℚ ℂ) w f=0→ z=w:=by
    intro z w hz hw
    by_contra hzw
    apply dh
    refine ⟨projectivePoint none,projectivePoint (some z),projectivePoint (some w),?_,?_,?_,qo,hrep z hz,hrep w hw⟩
    · intro h
      have hh:=projectivePoint_injective h
      simp at hh
    · intro h
      have hh:=projectivePoint_injective h
      simp at hh
    · intro h
      exact hzw (Option.some.inj (projectivePoint_injective h))
  exact one_root_splits f hf hone
def ei (n:ℕ) (R:aa (Fin 2) ℤ):Prop:= ∃c a b a' b':ℤ,∃j:ℕ,c≠0∧ a*b'-a'*b≠0∧ 1≤j∧ j< n∧ R=C c*(C a*X 0+C b*X 1)^j*(C a'*X 0+C b'*X 1)^(n-j)
lemma wb
    (n:ℕ) (R:aa (Fin 2) ℤ) (hR:R.IsHomogeneous n) (hR0:R ≠ 0)
    (il:((C01.PcCurves.dehom R).map (uG ℚ)).Splits):
    ∃ c:ℤ,c ≠ 0∧∃ s:Multiset (Option ℚ),s.card=n∧ R=u2 c*(s.map labelLine).prod:=by
  classical
  let f:ar ℤ:=C01.PcCurves.dehom R
  have hf:f ≠ 0:=fun h=> hR0 (C01.PcCurves.eq_zero_of_dehom hR h)
  obtain ⟨c,hc,roots,vd,hfac,kx⟩:= integer_linear_factorization f hf il
  let s:Multiset (Option ℚ):= roots.map some+Multiset.replicate (n-f.natDegree) none
  have hle:f.natDegree≤ n:=C01.PcCurves.dehom_natDegree_le hR
  have hs:s.card=n:=by
    simp only [s,Multiset.card_add,Multiset.card_map,Multiset.card_replicate,vd]
    omega
  have qp:(s.map labelPoly).prod=(roots.map rationalLinear).prod:=by
    simp [s,Multiset.map_add,Multiset.prod_add,Multiset.map_map,Function.comp_def,labelPoly]
  let B:aa (Fin 2) ℤ:=u2 c*(s.map labelLine).prod
  have hB:B.IsHomogeneous n:=by
    simpa only [B,hs,zero_add] using
      (MvPolynomial.isHomogeneous_C (Fin 2) c).mul (label_product_homogeneous s)
  have im:C01.PcCurves.dehom B=f:=by
    rw [show C01.PcCurves.dehom B= C01.PcCurves.dehom (u2 c)* C01.PcCurves.dehom ((s.map labelLine).prod) from
      C01.PcCurves.dehom_mul _ _]
    rw [label_product_dehom,qp]
    have vW:C01.PcCurves.dehom (u2 c:aa (Fin 2) ℤ)= uL c:=by simp [C01.PcCurves.dehom]
    rw [vW]
    exact hfac.symm
  have hsub:C01.PcCurves.dehom (R-B)=0:=by
    rw [C01.PcCurves.dehom_sub,im]
    exact sub_self f
  have heq:R=B:=sub_eq_zero.mp
    (C01.PcCurves.eq_zero_of_dehom (hR.sub hB) hsub)
  exact ⟨c,hc,s,hs,heq⟩
lemma qq
    (n:ℕ) (R:aa (Fin 2) ℤ) (hR:R.IsHomogeneous n)
    (c:ℤ) (s:Multiset (Option ℚ))
