theorem normalized_height_degree_exact
    (k : ℕ) (P Q : MvPolynomial (Fin 2) ℝ) (hQ : Q.IsHomogeneous (k+1))
    (a b c ell : ℝ) (ha : a≠0) (hb : b≠0) (hc : c≠0) (hell : ell≠0)
    (hno : ∀ w : Fin 2 → ℝ, w≠0 →
      MvPolynomial.eval w P=0 → MvPolynomial.eval w Q=0 → False)
    (hres : MvPolynomial.X (1:Fin 2)^k*P-MvPolynomial.X (0:Fin 2)^k*Q =
      MvPolynomial.C c*(MvPolynomial.C a*MvPolynomial.X (0:Fin 2)+
        MvPolynomial.C b*MvPolynomial.X (1:Fin 2))^(2*k+1)) :
    let D : Polynomial ℝ := C (ell/a)*X
    let E : Polynomial ℝ := C (ell/b)*(1-X)
    let φ := MvPolynomial.eval₂Hom Polynomial.C ![D,E]
    let F : Polynomial ℝ := C (1/(c*ell^(2*k+1)))*(D^k*φ Q)
    F.natDegree=2*k+1 := by
  intro D E φ F
  have hQval := nonaxis_Q_at_kernel_ne_zero k P Q a b c ha hno hres
  have htop := original_height_top_coefficient k Q hQ a b c ell ha hb hc hell
  change F.coeff (2*k+1)=_ at htop
  have hcoef : F.coeff (2*k+1)≠0 := by
    rw [htop]
    exact div_ne_zero hQval
      (mul_ne_zero (mul_ne_zero hc (pow_ne_zero _ ha))
        (pow_ne_zero _ (mul_ne_zero ha hb)))
  have hdeg := (original_height_jets k P Q hQ a b c ell ha hb hc hell hres).2.2
  exact Polynomial.natDegree_eq_of_le_of_coeff_ne_zero hdeg hcoef

theorem normalized_height_lambda
    (k : ℕ) (Q : MvPolynomial (Fin 2) ℝ) (hQ : Q.IsHomogeneous (k+1))
    (a b c ell K0 : ℝ) (ha : a≠0) (hb : b≠0) (hc : c≠0) (hell : ell≠0)
    (hQval : MvPolynomial.eval ![b,-a] Q=(-1:ℝ)^k*a^k*K0) :
    let D : Polynomial ℝ := C (ell/a)*X
    let E : Polynomial ℝ := C (ell/b)*(1-X)
    let φ := MvPolynomial.eval₂Hom Polynomial.C ![D,E]
    let F : Polynomial ℝ := C (1/(c*ell^(2*k+1)))*(D^k*φ Q)
    ∀ lam : ℝ, F.coeff (2*k+1)=(-1:ℝ)^k*lam →
      lam=K0/(c*(a*b)^(k+1)) := by
  intro D E φ F lam hcoeff
  have htop := original_height_top_coefficient k Q hQ a b c ell ha hb hc hell
  change F.coeff (2*k+1)=_ at htop
  apply mul_left_cancel₀ (pow_ne_zero k (by norm_num : (-1:ℝ)≠0))
  calc
    (-1:ℝ)^k*lam=F.coeff (2*k+1) := hcoeff.symm
    _=MvPolynomial.eval ![b,-a] Q/(c*a^k*(a*b)^(k+1)) := htop
    _=(-1:ℝ)^k*(K0/(c*(a*b)^(k+1))) := by
      rw [hQval]
      field_simp

end
end A8FloorExt

