    dsimp [κ]
    ring
  have hκ:κ ≠ 0:=by
    intro hz
    apply hA0
    rw [cJ,hz,map_zero,zero_mul]
  exact ⟨κ,hκ,cJ⟩
def quadA (G:wC):Bin:=part G 1 0
def quadC (G:wC):Bin:=part G 0 1
def quadB (G:wC):Bin:=part G 1 1-quadA G-quadC G
def bQ:wC→+wC where
  toFun G:=aq (quadA G)*X 2^2+ aq (quadB G)*X 2*X 3+aq (quadC G)*X 3^2
  map_zero':=by simp [quadA,quadB,quadC,part]
  map_add':=by
    intro G H
    simp [quadA,quadB,quadC,part,map_add]
    ring
lemma de (G:wC)
    (hG:∀ m∈ G.support,m 2+m 3=2):
    G=aq (quadA G)*X 2^2+ aq (quadB G)*X 2*X 3+aq (quadC G)*X 3^2:=by
  classical
  change G=bQ G
  symm
  calc
    bQ G=∑ m∈ G.support,bQ (monomial m (G.coeff m)):=by
      conv_lhs=> rw [G.as_sum]
      rw [map_sum]
    _=∑ m∈ G.support,monomial m (G.coeff m):=by
      apply u4 rfl
      intro m hm
      have hβ:=hG m hm
      have hm2:m 2=0∨ m 2=1∨ m 2=2:=by omega
      rcases hm2 with hm2 | hm2 | hm2
      · have hm3:m 3=2:=by omega
        simp [bQ,quadA,quadB,quadC,part,aq,bw,hm2,hm3]<;> ring
      · have hm3:m 3=1:=by omega
        simp [bQ,quadA,quadB,quadC,part,aq,bw,hm2,hm3]<;> ring
      · have hm3:m 3=0:=by omega
        simp [bQ,quadA,quadB,quadC,part,aq,bw,hm2,hm3]<;> ring
    _=G:=G.as_sum.symm
def a0:wG→ₐ[ℂ] ar Bin:= aeval ![uL (X 0),uL (X 1),uR]
def bx (k:ℕ):wC→+*ar Bin:= a0.toRingHom.comp (aj k)
lemma g4 (P:Bin):
    a0 (aE P)=uL P:=by
  induction P using uW
  next c=>
    simp [aE,a0,va,b9]
  next P Q hP hQ=> simp only [map_add,hP,hQ]
  next P i hP=>
    simp only [map_mul,hP]
    fin_cases i<;>
      simp [aE,a0,va,b9]
lemma g5 (k:ℕ) (P:Bin):
    bx k (aq P)=uL P:=by
  change a0 (aj k (aq P))=_
  rw [e5,g4]
lemma dO (k:ℕ) (G:wC)
    (hG:∀ m∈ G.support,m 2+m 3=2):
    bx k G= uL (quadA G*X 1^(2*k)+ quadB G*X 0^k*X 1^k+quadC G*X 0^(2*k))+ uL (-2*quadA G*X 1^k-quadB G*X 0^k)* uR+ uL (quadA G)*uR^2:=by
  conv_lhs=> rw [de G hG]
  simp only [map_add,map_mul,map_pow,g5]
  have h2:bx k (X (2:Fin 4))= uL (X (1:Fin 2))^k-uR:=by
    simp [bx,a0,aj]
  have h3:bx k (X (3:Fin 4))= uL (X (0:Fin 2))^k:=by
    simp [bx,a0,aj]
  rw [h2,h3]
  have hpow (z:Bin):z^(2*k)=(z^k)^2:=by
    rw [← pow_mul]
    congr 1
    omega
  simp only [hpow,map_add,map_mul,map_pow,map_sub,map_neg]
  have htwo:(uL (2:Bin):ar Bin)=2:=by
    rw [show (2:Bin)=1+1 by ring]
    simp only [map_add,map_one]
    ring
  rw [htwo]
  ring
lemma vY (k α:ℕ) (G:wC)
    (hG:∀ m∈ G.support,m 2+m 3=2)
    (hcan:(X (0:Fin 3):wG)^α∣ aj k G):
    (X (0:Fin 2):Bin)^α∣ quadA G∧ (X (0:Fin 2):Bin)^(α-k)∣ quadB G∧ (X (0:Fin 2):Bin)^(α-2*k)∣ quadC G:=by
  classical
  have hx0:(X (0:Fin 2):Bin) ≠ 0:=X_ne_zero _
  have g6:uL ((X (0:Fin 2):Bin)^α)∣ bx k G:=by
    obtain ⟨r,hr⟩:=hcan
    refine ⟨a0 r,?_⟩
    change a0 (aj k G)=_
    rw [hr,map_mul,map_pow]
    simp [a0]
  have vi:=(Polynomial.C_dvd_iff_dvd_coeff _ _).mp g6
  have fa:(X (0:Fin 2):Bin)^α∣ quadA G:=by
    have hc:=vi 2
    rw [dO k G hG] at hc
    norm_num only [d2,u3,dY,Polynomial.coeff_C,Polynomial.coeff_X,dZ] at hc
    simpa using hc
  have hlin:(X (0:Fin 2):Bin)^α∣
      -2*quadA G*X 1^k-quadB G*X 0^k:=by
    have hc:=vi 1
    rw [dO k G hG] at hc
    norm_num only [d2,u3,dY,Polynomial.coeff_C,Polynomial.coeff_X,dZ] at hc
    simpa only [ite_true,ite_false,zero_add,add_zero,zero_mul,mul_zero,mul_one,one_mul] using hc
  have vW:(X (0:Fin 2):Bin)^α∣
      quadA G*X 1^(2*k)+quadB G*X 0^k*X 1^k+ quadC G*X 0^(2*k):=by
    have hc:=vi 0
    rw [dO k G hG] at hc
    norm_num only [d2,u3,dY,Polynomial.coeff_C,Polynomial.coeff_X,dZ] at hc
    simpa only [ite_true,ite_false,zero_add,add_zero,zero_mul,mul_zero,mul_one,one_mul] using hc
  obtain ⟨hB,hC⟩:=vV
    (X (0:Fin 2):Bin) (X (1:Fin 2)) (quadA G) (quadB G) (quadC G)
    hx0 k α fa hlin vW
  exact ⟨fa,hB,hC⟩
lemma g7 (k:ℕ) (hk:1≤ k) (d e u v h:ℤ)
    (hh:h=1∨ h= -1)
    (vo:e^k*v-d^k*u=h):
    IsCoprime d e:=by
  have hhsq:h^2=1:=by rcases hh with rfl | rfl<;> norm_num
  have hdk:d^(k-1)*d=d^k:=by
    rw [← pow_succ]
    congr 1
    omega
  have hek:e^(k-1)*e=e^k:=by
    rw [← pow_succ]
    congr 1
    omega
  refine ⟨-h*d^(k-1)*u,h*e^(k-1)*v,?_⟩
  calc
    _=h*((e^(k-1)*e)*v-(d^(k-1)*d)*u):=by ring
    _=h*(e^k*v-d^k*u):=by rw [hdk,hek]
    _=1:=by rw [vo];nlinarith [hhsq]
lemma g8 (k:ℕ) (c d e u v h S:ℤ)
    (vZ:(d^k*S)*u= (e^k*S-c*d^(k+1))*v)
    (vo:e^k*v-d^k*u=h):
    h*S=c*d^(k+1)*v:=by
  linear_combination-S*vo-vZ
lemma v0 (k:ℕ) (hk:1≤ k)
    (a b c d e u v h:ℤ)
    (hh:h=1∨ h= -1)
    (vZ:(d^k*(a*d+b*e))*u= (e^k*(a*d+b*e)-c*d^(k+1))*v)
    (vo:e^k*v-d^k*u=h):
    d∣ b:=by
  have hhsq:h^2=1:=by rcases hh with rfl | rfl<;> norm_num
  have g9:=g8 k c d e u v h (a*d+b*e) vZ vo
  have hS:a*d+b*e=h*c*d^(k+1)*v:=by
    calc
      a*d+b*e=h*(h*(a*d+b*e)):=by
        calc
          a*d+b*e=1*(a*d+b*e):=by ring
          _=h^2*(a*d+b*e):=by rw [hhsq]
          _=h*(h*(a*d+b*e)):=by ring
      _=h*(c*d^(k+1)*v):=by rw [g9]
      _=h*c*d^(k+1)*v:=by ring
  have hdS:d∣ a*d+b*e:=by
    rw [hS,pow_succ]
    exact ⟨h*c*d^k*v,by ring⟩
  have hdad:d∣ a*d:=⟨a,by ring⟩
  have hdbe:d∣ b*e:=by
    have ht:d∣(a*d+b*e)-a*d:=dvd_sub hdS hdad
    have heq:(a*d+b*e)-a*d=b*e:=by ring
    rw [heq] at ht
    exact ht
  obtain ⟨r,s,hrs⟩:=g7 k hk d e u v h hh vo
  obtain ⟨t,ht⟩:=hdbe
  refine ⟨b*r+s*t,?_⟩
  calc
    b=b*(r*d+s*e):=by rw [hrs,mul_one]
    _=d*(b*r)+s*(b*e):=by ring
    _=d*(b*r+s*t):=by rw [ht];ring
lemma v2 (k α:ℕ) (P Q:wJ) (c:ℤ)
    (hR:X 1^k*P-X 0^k*Q= C c*X (0:Fin 2)^(α+k)):
    ∃ S:wJ,P=X 0^k*S∧ Q=X 1^k*S-C c*X 0^α:=by
  have hxy:IsRelPrime (X (0:Fin 2):wJ) (X (1:Fin 2)):= X_prime.irreducible.isRelPrime_iff_not_dvd.mpr (by
      rw [X_dvd_X]
      exact Fin.zero_ne_one)
  have ho:IsRelPrime ((X (0:Fin 2):wJ)^k) (X 1^k):=hxy.pow
  have hO:(X (0:Fin 2):wJ)^k∣ C c*X 0^(α+k):=by
    rw [pow_add]
    exact ⟨C c*X 0^α,by ring⟩
  have eI:(X (0:Fin 2):wJ)^k∣ X 0^k*Q:=dvd_mul_right _ _
  have hY:(X (0:Fin 2):wJ)^k∣ X 1^k*P:=by
    have ht:=dvd_add hO eI
    convert ht using 1
    linear_combination hR
  have h9:(X (0:Fin 2):wJ)^k∣ P:= ho.dvd_of_dvd_mul_left hY
  obtain ⟨S,hS⟩:=h9
  refine ⟨S,hS,?_⟩
  apply cC (u5 k (X_ne_zero (0:Fin 2)))
  rw [hS,pow_add] at hR
  linear_combination-hR
namespace dP
section
variable {σ:Type*} {R:Type*} [CommRing R] [IsDomain R]
def tsub (w:σ→ ℕ):aa σ R→ₐ[R] ar (aa σ R):= vc (fun i=> uL (X i)*uR^(w i))
omit [IsDomain R] in
lemma dF (w:σ→ ℕ) (m:σ→₀ ℕ) (c:R):
    tsub w (monomial m c)= uL (monomial m c)*uR^(aK w m):=by
  classical
  rw [tsub,MvPolynomial.aeval_monomial,MvPolynomial.monomial_eq,bG]
  simp only [Finsupp.prod,Finsupp.sum]
  have h1:∀ i∈ m.support,(uL (X i:aa σ R)*uR^(w i))^(m i)= uL ((X i:aa σ R)^(m i))*uR^(m i • w i):=by
    intro i _
    rw [mul_pow,← map_pow,← pow_mul,smul_eq_mul,mul_comm (w i)]
  rw [Finset.prod_congr rfl h1,dq,← map_prod,ew,b9,va,map_mul]
  ring
omit [IsDomain R] in
lemma cl (w:σ→ ℕ) (P:aa σ R) (k:ℕ):
    (tsub w P).coeff k=weightedHomogeneousComponent w k P:=by
  classical
  conv_lhs=> rw [P.as_sum]
  rw [map_sum,c5]
  simp only [dF,u3]
  rw [weightedHomogeneousComponent_apply,Finset.sum_filter]
  apply u4 rfl
  intro m _
  by_cases h:aK w m=k
  · rw [if_pos h.symm,if_pos h]
  · rw [if_neg (Ne.symm h),if_neg h]
omit [IsDomain R] in
lemma dG {w:σ→ ℕ} {P:aa σ R} {n:ℕ}
    (hP:uK w P n):tsub w P=uL P*uR^n:=by
  ext k:1
  rw [cl,u3]
  by_cases hk:k=n
  · rw [if_pos hk]
    ext d
    rw [coeff_weightedHomogeneousComponent]
    by_cases hd:aK w d=k
    · rw [if_pos hd]
    · rw [if_neg hd]
      by_contra hne
      exact hd ((hP (Ne.symm hne)).trans hk.symm)
  · rw [if_neg hk]
    ext d
    rw [coeff_weightedHomogeneousComponent,coeff_zero]
    by_cases hd:aK w d=k
    · rw [if_pos hd]
      by_contra hne
      exact hk (hd.symm.trans (hP hne))
    · rw [if_neg hd]
lemma vJ {A:Type*} [CommRing A] [IsDomain A]
    {p q:ar A} {c:A} {n:ℕ} (hc:c ≠ 0)
    (h:p*q=uL c*uR^n):
    ∀ k,k ≠ p.natDegree→ p.coeff k=0:=by
  have hpq:p*q ≠ 0:=by
    rw [h];exact aV (Polynomial.C_ne_zero.mpr hc) (u5 _ Polynomial.X_ne_zero)
  have hp:p ≠ 0:=left_ne_zero_of_mul hpq
  have hq:q ≠ 0:=right_ne_zero_of_mul hpq
  have h1:p.natDegree+q.natDegree=n:=by
    rw [← Polynomial.natDegree_mul hp hq,h,fu _ _ hc]
  have h2:p.natTrailingDegree+q.natTrailingDegree=n:=by
    rw [← fv hp hq,h,dV,ft hc]
  have h3:p.natTrailingDegree≤ p.natDegree:=c1 p
  have h4:q.natTrailingDegree≤ q.natDegree:=c1 q
  intro k hk
  rcases lt_or_gt_of_ne hk with hlt | hgt
  · exact fq (by omega)
  · exact fs hgt
lemma cm {w:σ→ ℕ} {F G:aa σ R} {n:ℕ}
    (hFG:uK w (F*G) n) (hFG0:F*G ≠ 0):
    uK w F (tsub w F).natDegree:=by
  have h:=dG hFG
  rw [map_mul] at h
  have hz:=vJ hFG0 h
  intro d hd
  by_contra hne
  have h0:(tsub w F).coeff (aK w d)=0:=hz _ hne
  rw [cl] at h0
  have h1:=congrArg (MvPolynomial.coeff d) h0
  rw [coeff_weightedHomogeneousComponent,if_pos rfl,coeff_zero] at h1
  exact hd h1
lemma cX {w:σ→ ℕ} {G T:aa σ R} {n:ℕ}
    (h:uK w (G*T) n) (h0:G*T ≠ 0):
    ∃ d e,d+e=n∧ uK w G d∧ uK w T e:=by
  have g:=cm h h0
  have t:=cm (show uK w (T*G) n by
    rw [mul_comm];exact h) (by rw [mul_comm];exact h0)
  exact ⟨_,_,IsWeightedHomogeneous.inj_right h0 (g.mul t) h,g,t⟩
end
end dP
lemma v3 (k:ℕ) (P S:wJ)
    (hP:P.IsHomogeneous (k+1)) (hP0:P ≠ 0)
    (hPS:P=X (0:Fin 2)^k*S):
    S.IsHomogeneous 1:=by
  have vf:(X (0:Fin 2)^k*S:wJ).IsHomogeneous (k+1):=by
    rw [← hPS]
    exact hP
  have eH:(X (0:Fin 2)^k*S:wJ) ≠ 0:=by
    rw [← hPS]
    exact hP0
  obtain ⟨d,e,hde,hXd,hSe⟩:=dP.cX vf eH
  have hX:(X (0:Fin 2)^k:wJ).IsHomogeneous k:=by
    simpa using (isHomogeneous_X ℤ (0:Fin 2)).pow k
  have hkd:k=d:= IsWeightedHomogeneous.inj_right (u5 k (X_ne_zero (0:Fin 2))) hX hXd
  have he:e=1:=by omega
  intro m hm
  have hh:=hSe hm
  simpa [he,bG,aD,Fin.sum_univ_two] using hh
lemma ia (S:wJ) (hS:S.IsHomogeneous 1):
    ∃ a b:ℤ,S=C a*X (0:Fin 2)+C b*X (1:Fin 2):=by
  let a:=S.coeff (uN 1 0)
  let b:=S.coeff (uN 0 1)
  refine ⟨a,b,?_⟩
  rw [JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C01.PcCurves.hom_repr hS]
  simp [Finset.sum_range_succ,a,b]
  ring
lemma v4 (k:ℕ) (P Q:wJ) (c a b:ℤ)
    (hP:P=X 0^k*(C a*X 0+C b*X 1))
    (hQ:Q=X 1^k*(C a*X 0+C b*X 1)-C c*X 0^(k+1))
    (vX:∀ w:Fin 2→ ℂ,w ≠ 0→ uI w (uJ (uG ℂ) P)=0→ uI w (uJ (uG ℂ) Q)=0→ False):
    b ≠ 0:=by
  intro hb
  apply vX ![(0:ℂ),1]
  · intro hz
    have ht:=congrFun hz (1:Fin 2)
    norm_num at ht
  · simp [hP,hb]
  · simp [hQ,hb]
lemma v5 (k:ℕ) (P Q:wJ) (c:ℤ)
    (hP:P.IsHomogeneous (k+1)) (hP0:P ≠ 0)
    (hR:X 1^k*P-X 0^k*Q=C c*X (0:Fin 2)^((k+1)+k))
    (vX:∀ w:Fin 2→ ℂ,w ≠ 0→ uI w (uJ (uG ℂ) P)=0→ uI w (uJ (uG ℂ) Q)=0→ False):
    ∃ a b:ℤ,b ≠ 0∧ P=X 0^k*(C a*X 0+C b*X 1)∧ Q=X 1^k*(C a*X 0+C b*X 1)-C c*X 0^(k+1):=by
  obtain ⟨S,hPS,hQS⟩:=v2 k (k+1) P Q c hR
  have hSh:=v3 k P S hP hP0 hPS
  obtain ⟨a,b,hab⟩:=ia S hSh
  rw [hab] at hPS hQS
  exact ⟨a,b,v4 k P Q c a b hPS hQS vX,hPS,hQS⟩
lemma ib (k:ℕ) (P:wJ) (a b:ℤ)
    (hP:P=X 0^k*(C a*X 0+C b*X 1)):
    P.coeff (uN k 1)=b:=by
  let ex:=uN
  have cf:P=monomial (ex (k+1) 0) a+monomial (ex k 1) b:=by
    rw [hP,← fp,← fp]
    simp only [pow_zero,pow_one,mul_one]
    rw [pow_succ]
    ring
  have hne:ex (k+1) 0 ≠ ex k 1:=by
    intro he
    have ht:=congrArg (fun m:Fin 2→₀ ℕ=> m 1) he
    simp [ex,uN] at ht
  change P.coeff (ex k 1)=b
  rw [cf]
  simp [coeff_add,coeff_monomial,hne]
lemma v6 (k:ℕ) (P:wJ) (a b:ℤ)
    (hP:P=X 0^k*(C a*X 0+C b*X 1))
    (H:ℝ) (v7:∀ m,|((P.coeff m:ℤ):ℝ)|≤ H):
    |(b:ℝ)|≤ H:=by
  have hb:=ib k P a b hP
  have ht:=v7
    (uN k 1)
  rwa [hb] at ht
end al
namespace df
lemma p5 (lo len:ℝ) (hlen:0≤ len):
    ((ax ⌈lo⌉₊ ⌊lo+len⌋₊).card:ℝ)≤ len+1:=by
  rw [Nat.card_Icc]
  by_cases hpos:0≤ lo+len
  · have hfl:(⌊lo+len⌋₊:ℝ)≤ lo+len:=Nat.floor_le hpos
    have hce:lo≤(⌈lo⌉₊:ℝ):=b0 lo
    by_cases hle:⌈lo⌉₊≤⌊lo+len⌋₊+1
    · rw [Nat.cast_sub hle]
      push_cast
      linarith
    · have hlt:⌊lo+len⌋₊+1≤⌈lo⌉₊:=(Nat.not_le.mp hle).le
      rw [Nat.sub_eq_zero_of_le hlt]
      push_cast
      linarith
  · have hneg:lo+len<0:=not_le.mp hpos
    have hz:⌊lo+len⌋₊=0:=Nat.floor_of_nonpos hneg.le
    rw [hz]
    have h1:(0+1-⌈lo⌉₊:ℕ)≤ 1:=by omega
    have h2:((0+1-⌈lo⌉₊:ℕ):ℝ)≤ 1:=by exact_mod_cast h1
    linarith
lemma p6 (A:Finset ℕ) (lo:ℕ→ ℝ) (len:ℝ) (hlen:0≤ len)
    (S:Set (ℕ× ℕ))
    (hS:∀ p∈ S,p.1∈ A∧ lo p.1≤(p.2:ℝ)∧(p.2:ℝ)≤ lo p.1+len):
    S.Finite∧(S.ncard:ℝ)≤(A.card:ℝ)*(len+1):=by
  classical
  let F:Finset (ℕ× ℕ):=A.biUnion (fun a=>
    (ax ⌈lo a⌉₊ ⌊lo a+len⌋₊).image (fun b=>(a,b)))
  have hsub:S ⊆ (↑F:Set (ℕ× ℕ)):=by
    intro p hp
    obtain ⟨hA,h1,h2⟩:=hS p hp
    have hmem:p∈ F:=Finset.mem_biUnion.mpr ⟨p.1,hA,Finset.mem_image.mpr
      ⟨p.2,Finset.mem_Icc.mpr ⟨Nat.ceil_le.mpr h1,Nat.le_floor h2⟩,rfl⟩⟩
    exact Finset.mem_coe.mpr hmem
  have hfin:S.Finite:=(d3 F).subset hsub
  refine ⟨hfin,?_⟩
  have p7:S.ncard≤ F.card:=by
    calc
      S.ncard≤(↑F:Set (ℕ× ℕ)).ncard:=Set.ncard_le_ncard hsub (d3 F)
      _=F.card:=Set.ncard_coe_finset F
  have p8:F.card≤∑ a∈ A,((ax ⌈lo a⌉₊ ⌊lo a+len⌋₊).image (fun b=>(a,b))).card:= Finset.card_biUnion_le
  have fJ:∀ a∈ A,((((ax ⌈lo a⌉₊ ⌊lo a+len⌋₊).image (fun b=>(a,b))).card:ℕ):ℝ)≤
        len+1:=by
    intro a _
    have h1:((ax ⌈lo a⌉₊ ⌊lo a+len⌋₊).image (fun b=>(a,b))).card≤
        (ax ⌈lo a⌉₊ ⌊lo a+len⌋₊).card:=Finset.card_image_le
    have h1':((((ax ⌈lo a⌉₊ ⌊lo a+len⌋₊).image (fun b=>(a,b))).card:ℕ):ℝ)≤
        (((ax ⌈lo a⌉₊ ⌊lo a+len⌋₊).card:ℕ):ℝ):=by exact_mod_cast h1
    exact h1'.trans (p5 (lo a) len hlen)
  have hsum:(∑ a∈ A,((((ax ⌈lo a⌉₊ ⌊lo a+len⌋₊).image (fun b=>(a,b))).card:ℕ):ℝ))≤
