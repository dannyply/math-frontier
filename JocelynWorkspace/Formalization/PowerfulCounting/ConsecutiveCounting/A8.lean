theorem hb2_cell_bound_k (hHB2 : ActualHB2) (k : ℕ) (hk : 1 ≤ k)
    (a b : ℕ) (ha : 1≤a) (hb : 2≤b) :
    ∀ η : ℝ, 0<η →
      ∃ C : ℝ, 1≤C ∧
        ∀ (x D E H : ℝ), 0<D → 0<E → 1≤H →
          ∀ G : MvPolynomial (Fin 4) ℤ,
            (∀ m∈G.support, m 0+m 1=a ∧ m 2+m 3=b) →
            Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G) →
            (∀ m : Fin 4 →₀ ℕ, |((G.coeff m:ℤ):ℝ)|≤H) →
            ∀ M j : ℕ, 1≤M → j∈cells D E M →
              ∀ h : ℤ, (h=1 ∨ h=-1) →
                ∀ ed :
                  FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.EllipseData
                    ((M:ℝ)/(8*D)) (rho D E M j) (4*E),
                let L : ℝ :=
                  FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.sideLength
                    ((M:ℝ)/(8*D)) (rho D E M j) (4*E) ed.P 0;
                let H' : ℝ :=
                  FormalAB.Sbfeb2b3e.A1AuxTransport.coefficientConstant a b*
                    H*(firstBasisRadius D E (rho D E M j) M)^(a+b);
                let S : Set Point :=
                  {q | q∈cellK k x D E M j h ∧
                    MvPolynomial.eval ![(q.1.1:ℤ),(q.1.2:ℤ),
                      (q.2.1:ℤ),(q.2.2:ℤ)] G=0};
                S.Finite ∧ (S.ncard:ℝ)≤C*(max 1 L)^(2/(b:ℝ)+η)*(H')^η := by
  intro η hη
  obtain ⟨C,hraw⟩ := hHB2 a b ha (by omega) η hη
  refine ⟨max 1 C,le_max_left _ _,?_⟩
  intro x D E H hD hE hH G hG hirr hcoeff M j hM hj h hs ed
  dsimp only
  let r : ℝ := rho D E M j
  let R : ℝ := firstBasisRadius D E r M
  let L : ℝ := FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.sideLength
    ((M:ℝ)/(8*D)) r (4*E) ed.P 0
  let H' : ℝ := FormalAB.Sbfeb2b3e.A1AuxTransport.coefficientConstant a b*
    H*R^(a+b)
  let G' := FormalAB.Sbfeb2b3e.A1AuxTransport.transport ed.P 1 G
  let S : Set Point :=
    {q | q∈cellK k x D E M j h ∧
      MvPolynomial.eval ![(q.1.1:ℤ),(q.1.2:ℤ),(q.2.1:ℤ),(q.2.2:ℤ)] G=0}
  have hR1 : 1≤R := by
    have hT := le_max_left (1:ℝ) (((M:ℝ)/(8*D))*(4*E))
    have habs := abs_nonneg r
    dsimp only [R,firstBasisRadius]
    nlinarith
  have hmat := ed.hheight |r| (max 1 (((M:ℝ)/(8*D))*(4*E)))
    (abs_nonneg r) (le_max_left _ _) (le_refl _)
    (le_max_right _ _)
  have hP : ∀ i k : Fin 2, |(ed.P i k:ℝ)|≤R := fun i k => (hmat i k).1
  have hI : ∀ i k : Fin 2, |(((1:Matrix (Fin 2) (Fin 2) ℤ) i k):ℝ)|≤R := by
    intro i k
    fin_cases i <;> fin_cases k <;> simp <;> linarith
  have hcoef' : ∀ m : Fin 4 →₀ ℕ, |((G'.coeff m:ℤ):ℝ)|≤H' :=
    FormalAB.Sbfeb2b3e.A1AuxTransport.transport_height ed.P 1 G a b H R
      (by linarith) (by linarith) hG hcoeff hP hI
  have hG' : ∀ m∈G'.support, m 0+m 1=a ∧ m 2+m 3=b :=
    FormalAB.Sbfeb2b3e.A1AuxTransport.transport_bidegree ed.P 1 G a b hG
  have hirr' : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G') :=
    actual_first_transport_absIrred ed.P ed.A ed.hPA ed.hAP G hirr
  have hH' : 0≤H' := by
    dsimp only [H',FormalAB.Sbfeb2b3e.A1AuxTransport.coefficientConstant]
    positivity
  have hsup : (integerSupNorm G':ℝ)≤H' := integerSupNorm_le G' H' hH' hcoef'
  let T : Set (Fin 4 → ℤ) :=
    {w | Int.gcd (w 0) (w 1)=1 ∧ Int.gcd (w 2) (w 3)=1 ∧
      MvPolynomial.eval w G'=0 ∧
      |(w 0:ℝ)|≤ max 1 L ∧ |(w 1:ℝ)|≤ max 1 L}
  have hT : T.Finite ∧ (T.ncard:ℝ)≤
      C*(max 1 L)^(2/(b:ℝ)+η)*(integerSupNorm G':ℝ)^η :=
    hraw G' hG' hirr' (max 1 L) (le_max_left _ _)
  have hmap : Set.MapsTo (firstPairLift ed.A) S T := by
    intro q hq
    have hcover := ed.hcover ((q.1.1:ℤ),(q.1.2:ℤ))
      (first_ellipse_k k x D E M j h hD hE hM hj q hq.1)
    have hprim := unit_shift_primitive_k k hk (q.1.1:ℤ) (q.1.2:ℤ)
      (q.2.1:ℤ) (q.2.2:ℤ) h hs (box_shift_int hq.1.1)
    have hdetA : IsUnit ed.A.det := Int.isUnit_iff.mpr ed.hdetA
    have hp :=
      FormalAB.S94d17769.A1LocalMatrixTrial.primitive_lin ed.A hdetA
        ![(q.1.1:ℤ),(q.1.2:ℤ)] hprim.1
    rw [FormalAB.S94d17769.A1LocalMatrixTrial.lin_eq_mulVec] at hp
    have heval :=
      FormalAB.Sbfeb2b3e.A1AuxTransport.transport_eval ed.P 1 G
        (ed.A.mulVec ![(q.1.1:ℤ),(q.1.2:ℤ)]) ![(q.2.1:ℤ),(q.2.2:ℤ)]
    rw [matrix_left_inverse_mulVec ed.P ed.A ed.hPA,Matrix.one_mulVec] at heval
    change Int.gcd _ _=1 ∧ Int.gcd _ _=1 ∧
      MvPolynomial.eval (firstPairLift ed.A q) G'=0 ∧
      |((firstPairLift ed.A q) 0:ℝ)|≤ max 1 L ∧
      |((firstPairLift ed.A q) 1:ℝ)|≤ max 1 L
    refine ⟨hp,hprim.2,?_,?_,?_⟩
    · exact heval.trans hq.2
    · exact hcover.1.trans (le_max_right _ _)
    · exact (hcover.2.trans ed.horder).trans (le_max_right _ _)
  have hinj := firstPairLift_injective ed.P ed.A ed.hPA
  have hfin : S.Finite := Set.Finite.of_injOn hmap hinj.injOn hT.1
  have hcard : (S.ncard:ℝ)≤(T.ncard:ℝ) := by
    exact_mod_cast Set.ncard_le_ncard_of_injOn
      (firstPairLift ed.A) hmap hinj.injOn hT.1
  refine ⟨hfin,?_⟩
  calc
    (S.ncard:ℝ)≤(T.ncard:ℝ) := hcard
    _ ≤ C*(max 1 L)^(2/(b:ℝ)+η)*(integerSupNorm G':ℝ)^η := hT.2
    _ ≤ max 1 C*(max 1 L)^(2/(b:ℝ)+η)*(integerSupNorm G':ℝ)^η := by
      apply mul_le_mul_of_nonneg_right
      · exact mul_le_mul_of_nonneg_right (le_max_right _ _)
          (Real.rpow_nonneg (by linarith [le_max_left (1:ℝ) L]) _)
      · exact Real.rpow_nonneg (Nat.cast_nonneg _) _
    _ ≤ max 1 C*(max 1 L)^(2/(b:ℝ)+η)*(H')^η := by
      apply mul_le_mul_of_nonneg_left
      · exact Real.rpow_le_rpow (Nat.cast_nonneg _) hsup hη.le
      · exact mul_nonneg (by linarith [le_max_left (1:ℝ) C])
          (Real.rpow_nonneg (by linarith [le_max_left (1:ℝ) L]) _)

theorem first_radius_polynomial_k
    (x D E : ℝ) (M j : ℕ) (hx : 2≤x)
    (hD : (1/2:ℝ)≤D) (hE : (1/2:ℝ)≤E)
    (hD2 : D≤4*x) (hE2 : E≤4*x)
    (hM : 1≤M) (hMup : (M:ℝ)≤2*x) (hj : j∈cells D E M) :
    firstBasisRadius D E (rho D E M j) M≤x^12 := by
  have hD0 : 0<D := by linarith
  have hE0 : 0<E := by linarith
  have hDcap : D≤4*x := hD2
  have hEcap : E≤4*x := hE2
  let r := rho D E M j
  have hc := (Finset.mem_filter.mp hj).2
  change D/(2*E)≤r ∧ r≤2*D/E at hc
  have hr0 : 0≤r := (by positivity : (0:ℝ)≤D/(2*E)).trans hc.1
  have hrE : r*E≤2*D := (le_div_iff₀ hE0).mp hc.2
  have hrhalf : r*(1/2)≤r*E := mul_le_mul_of_nonneg_left hE hr0
  have hrcap : r≤16*x := by nlinarith
  have hME : (M:ℝ)*E≤8*x^2 := by
    calc
      (M:ℝ)*E≤(2*x)*(4*x) := mul_le_mul hMup hEcap hE0.le (by linarith)
      _ = 8*x^2 := by ring
  have halpha :
      ((M:ℝ)/(8*D))*(4*E)=(M:ℝ)*E/(2*D) := by
    field_simp [hD0.ne']
    ; ring
  have hterm : ((M:ℝ)/(8*D))*(4*E)≤8*x^2 := by
    rw [halpha]
    apply (div_le_iff₀ (by positivity : 0<2*D)).mpr
    exact hME.trans (le_mul_of_one_le_right (by positivity) (by linarith))
  have hT : max 1 (((M:ℝ)/(8*D))*(4*E))≤8*x^2 :=
    max_le (by nlinarith [sq_nonneg x]) hterm
  have hmul :
      (r+1)*max 1 (((M:ℝ)/(8*D))*(4*E))≤(16*x+1)*(8*x^2) :=
    mul_le_mul (by linarith) hT
      (by linarith [le_max_left (1:ℝ) (((M:ℝ)/(8*D))*(4*E))]) (by linarith)
  have hrad : firstBasisRadius D E r M≤2+2*(16*x+1)*(8*x^2) := by
    dsimp only [firstBasisRadius]
    rw [abs_of_nonneg hr0]
    linarith
  have hx1 : 1≤x := by linarith
  have hx23 : x^2≤x^3 := by
    calc
      x^2≤x*x^2 := le_mul_of_one_le_left (sq_nonneg x) hx1
      _ = x^3 := by ring
  have hx3 : 1≤x^3 := one_le_pow₀ hx1
  have hrad3 : firstBasisRadius D E r M≤512*x^3 := by nlinarith
  have hx9 : (512:ℝ)≤x^9 := by
    calc
      (512:ℝ)=(2:ℝ)^9 := by norm_num
      _ ≤ x^9 := pow_le_pow_left₀ (by norm_num) hx 9
  calc
    firstBasisRadius D E (rho D E M j) M≤512*x^3 := hrad3
    _ ≤ x^9*x^3 := mul_le_mul_of_nonneg_right hx9 (by positivity)
    _ = x^12 := by ring

theorem first_length_polynomial_k
    (x D E : ℝ) (M j : ℕ) (hx : 2≤x)
    (hD : (1/2:ℝ)≤D) (hE : (1/2:ℝ)≤E)
    (hD2 : D≤4*x) (hE2 : E≤4*x)
    (hM : 1≤M)
    (ed : FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.EllipseData
      ((M:ℝ)/(8*D)) (rho D E M j) (4*E)) :
    max 1 (FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.sideLength
      ((M:ℝ)/(8*D)) (rho D E M j) (4*E) ed.P 0)≤x^8 := by
  have hD0 : 0<D := by linarith
  have hE0 : 0<E := by linarith
  have hDcap : D≤4*x := hD2
  have hEcap : E≤4*x := hE2
  have hMr : (1:ℝ)≤M := by exact_mod_cast hM
  have hu :=
    FormalAB.S75c3b853.ConsecutiveCountingA5SecondMoments.invHeight_upper
      (2*D) (2*E) (M:ℝ) 4 (rho D E M j)
      (FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.col ed.P 0)
      (by positivity) (by positivity) hMr (by norm_num) ed.hcol
  have heq :
      FormalAB.S75c3b853.ConsecutiveCountingA5SecondMoments.invHeight
        (2*D) (2*E) (M:ℝ) 4 (rho D E M j)
        (FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.col ed.P 0)=
      FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.sideLength
        ((M:ℝ)/(8*D)) (rho D E M j) (4*E) ed.P 0 := by
    dsimp only [FormalAB.S75c3b853.ConsecutiveCountingA5SecondMoments.invHeight,
      FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.sideLength,
      FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.nsq]
    congr 2 ; field_simp [hD0.ne',hE0.ne'] ; ring
  rw [heq] at hu
  have hL :
      FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.sideLength
        ((M:ℝ)/(8*D)) (rho D E M j) (4*E) ed.P 0≤128*x := by
    nlinarith
  have hx1 : 1≤x := by linarith
  have hx7 : (128:ℝ)≤x^7 := by
    calc
      (128:ℝ)=(2:ℝ)^7 := by norm_num
      _ ≤ x^7 := pow_le_pow_left₀ (by norm_num) hx 7
  apply max_le (one_le_pow₀ hx1)
  exact hL.trans (by
    calc
      128*x≤x^7*x := mul_le_mul_of_nonneg_right hx7 (by linarith)
      _ = x^8 := by ring)

theorem hb2_cell_subpower_k (hHB2 : ActualHB2) (k : ℕ) (hk : 1 ≤ k)
    (a b K : ℕ) (ha : 1≤a) (hb : 2≤b) (hK : 1≤K) :
    ∀ ε : ℝ, 0<ε →
      ∃ C : ℝ, 0<C ∧
        ∀ (x D E : ℝ), 2≤x →
          (1/2:ℝ)≤D → (1/2:ℝ)≤E → D≤4*x → E≤4*x →
          ∀ G : MvPolynomial (Fin 4) ℤ,
            (∀ m∈G.support, m 0+m 1=a ∧ m 2+m 3=b) →
            Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G) →
            (∀ m : Fin 4 →₀ ℕ, |((G.coeff m:ℤ):ℝ)|≤x^K) →
            ∀ M j : ℕ, 1≤M → (M:ℝ)≤2*x → j∈cells D E M →
              ∀ h : ℤ, (h=1 ∨ h=-1) →
                ∀ ed :
                  FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.EllipseData
                    ((M:ℝ)/(8*D)) (rho D E M j) (4*E),
                let L : ℝ :=
                  FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.sideLength
                    ((M:ℝ)/(8*D)) (rho D E M j) (4*E) ed.P 0;
                let S : Set Point :=
                  {q | q∈cellK k x D E M j h ∧
                    MvPolynomial.eval ![(q.1.1:ℤ),(q.1.2:ℤ),
                      (q.2.1:ℤ),(q.2.2:ℤ)] G=0};
                S.Finite ∧ (S.ncard:ℝ)≤C*x^ε*(1+L) := by
  intro ε hε
  let d : ℕ := K+12*(a+b)
  let η : ℝ := ε/(8+(d:ℝ))
  have hden : (0:ℝ)<8+(d:ℝ) := by positivity
  have hη : 0<η := div_pos hε hden
  obtain ⟨C,hC,hraw⟩ := hb2_cell_bound_k hHB2 k hk a b ha hb η hη
  let Q : ℝ := FormalAB.Sbfeb2b3e.A1AuxTransport.coefficientConstant a b
  have hQ : 0<Q := by
    dsimp only [Q,FormalAB.Sbfeb2b3e.A1AuxTransport.coefficientConstant]
    positivity
  refine ⟨C*Q^η,mul_pos (by linarith) (Real.rpow_pos_of_pos hQ _),?_⟩
  intro x D E hx hD hE hD2 hE2 G hG hirr hcoeff M j hM hMup hj h hs ed
  dsimp only
  have hx0 : 0<x := by linarith
  have hx1 : 1≤x := by linarith
  have hD0 : 0<D := by linarith
  have hE0 : 0<E := by linarith
  let L : ℝ := FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.sideLength
    ((M:ℝ)/(8*D)) (rho D E M j) (4*E) ed.P 0
  let B : ℝ := max 1 L
  let R : ℝ := firstBasisRadius D E (rho D E M j) M
  let H' : ℝ := Q*x^K*R^(a+b)
  let S : Set Point :=
    {q | q∈cellK k x D E M j h ∧
      MvPolynomial.eval ![(q.1.1:ℤ),(q.1.2:ℤ),(q.2.1:ℤ),(q.2.2:ℤ)] G=0}
  have hL : 0<L := ed.hpos.trans_le ed.horder
  have hB1 : 1≤B := le_max_left _ _
  have hB0 : 0<B := by linarith
  have hR0 : 0≤R := by
    dsimp only [R,firstBasisRadius]
    positivity
  have hRcap : R≤x^12 := first_radius_polynomial_k x D E M j
    hx hD hE hD2 hE2 hM hMup hj
  have hBcap : B≤x^8 := first_length_polynomial_k x D E M j
    hx hD hE hD2 hE2 hM ed
  have hHcap : H'≤Q*x^d := by
    calc
      H'≤Q*x^K*(x^12)^(a+b) :=
        mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hR0 hRcap _)
          (mul_nonneg hQ.le (pow_nonneg hx0.le K))
      _ = Q*x^d := by
        rw [← pow_mul,mul_assoc,← pow_add]
  have hH0 : 0≤H' := by dsimp only [H']; positivity
  have hBp :
      B^(2/(b:ℝ)+η)≤B*x^(8*η) := by
    have hbR : (2:ℝ)≤b := by exact_mod_cast hb
    have hb0 : (0:ℝ)<b := by linarith
    have hf : 2/(b:ℝ)≤1 := (div_le_iff₀ hb0).mpr (by simpa using hbR)
    calc
      B^(2/(b:ℝ)+η)≤B^(1+η) :=
        Real.rpow_le_rpow_of_exponent_le hB1 (by linarith)
      _ = B*B^η := by rw [Real.rpow_add hB0,Real.rpow_one]
      _ ≤ B*(x^8)^η :=
        mul_le_mul_of_nonneg_left (Real.rpow_le_rpow hB0.le hBcap hη.le) hB0.le
      _ = B*x^(8*η) := by
        rw [← Real.rpow_natCast x 8,← Real.rpow_mul hx0.le]
        norm_num
  have hHp : H'^η≤Q^η*x^((d:ℝ)*η) := by
    calc
      H'^η≤(Q*x^d)^η := Real.rpow_le_rpow hH0 hHcap hη.le
      _ = Q^η*(x^d)^η := Real.mul_rpow hQ.le (pow_nonneg hx0.le d)
      _ = Q^η*x^((d:ℝ)*η) := by
        rw [← Real.rpow_natCast x d,← Real.rpow_mul hx0.le]
  have hηeq : 8*η+(d:ℝ)*η=ε := by
    dsimp only [η]
    field_simp [hden.ne']

  have hxpow : x^(8*η)*x^((d:ℝ)*η)=x^ε := by
    rw [← Real.rpow_add hx0,hηeq]
  have hbnd := hraw x D E (x^K) hD0 hE0 (one_le_pow₀ hx1)
    G hG hirr hcoeff M j hM hj h hs ed
  refine ⟨hbnd.1,?_⟩
  calc
    (S.ncard:ℝ)≤C*B^(2/(b:ℝ)+η)*H'^η := hbnd.2
    _ ≤ C*(B*x^(8*η))*(Q^η*x^((d:ℝ)*η)) := by
      apply mul_le_mul
      · exact mul_le_mul_of_nonneg_left hBp (by linarith)
      · exact hHp
      · exact Real.rpow_nonneg hH0 _
      · positivity
    _ = (C*Q^η)*x^ε*B := by
      calc
        _ = (C*Q^η)*B*(x^(8*η)*x^((d:ℝ)*η)) := by ring
        _ = _ := by rw [hxpow]; ring
    _ ≤ (C*Q^η)*x^ε*(1+L) := by
      apply mul_le_mul_of_nonneg_left
      · exact max_le (by linarith) (by linarith)
      · positivity

def geometricCellEstimateK (k a b K : ℕ) (ε C : ℝ) : Prop :=
  ∀ (x D E : ℝ), 2≤x →
    (1/2:ℝ)≤D → (1/2:ℝ)≤E → D≤4*x → E≤4*x →
    ∀ G : MvPolynomial (Fin 4) ℤ,
      (∀ m∈G.support, m 0+m 1=a ∧ m 2+m 3=b) →
      Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G) →
      (∀ m : Fin 4 →₀ ℕ, |((G.coeff m:ℤ):ℝ)|≤x^K) →
      ∀ M j : ℕ, 1≤M → (M:ℝ)≤2*x → j∈cells D E M →
        ∀ h : ℤ, (h=1 ∨ h=-1) →
          ∀ ed :
            FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.EllipseData
              ((M:ℝ)/(8*D)) (rho D E M j) (4*E),
            let S : Set Point :=
              {q | q∈cellK k x D E M j h ∧
                MvPolynomial.eval ![(q.1.1:ℤ),(q.1.2:ℤ),
                  (q.2.1:ℤ),(q.2.2:ℤ)] G=0};
            S.Finite ∧ (S.ncard:ℝ)≤C*x^ε*
              (1+FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.sideLength
                ((M:ℝ)/(8*D)) (rho D E M j) (4*E) ed.P 0)

theorem geometric_uniform_k (hHB2 : ActualHB2) (k : ℕ) (hk : 1 ≤ k) (Q : ℕ)
    (K : ℕ) (hK : 1≤K) (ε : ℝ) (hε : 0<ε) :
    ∃ C : ℝ, 0<C ∧
      ∀ a b : ℕ, 1≤a → a≤Q → 1≤b → b≤Q →
        geometricCellEstimateK k a b K ε C := by
  classical
  have hex : ∀ ab : Fin (Q+1) × Fin (Q+1), ∃ C : ℝ, 0<C ∧
      (1≤ab.1.val → 1≤ab.2.val →
        geometricCellEstimateK k ab.1.val ab.2.val K ε C) := by
    intro ab
    by_cases ha : 1≤ab.1.val
    · by_cases hb : 1≤ab.2.val
      · by_cases hb1 : ab.2.val=1
        · obtain ⟨C,hC,hbound⟩ :=
            beta_one_cell_subpower_k k hk ab.1.val K ha hK ε hε
          refine ⟨C,hC,?_⟩
          intro _ _ x D E hx hD hE hD2 hE2 G hG hirr hcoeff
            M j hM hMup hj h hs ed
          have hG' : ∀ m∈G.support,
              m 0+m 1=ab.1.val ∧ m 2+m 3=1 := by
            simpa only [hb1] using hG
          exact hbound x hx G hG' hirr hcoeff D E
            (by linarith) (by linarith) M j hM hj h hs ed
        · have hb2 : 2≤ab.2.val := by omega
          obtain ⟨C,hC,hbound⟩ :=
            hb2_cell_subpower_k hHB2 k hk ab.1.val ab.2.val K ha hb2 hK ε hε
          exact ⟨C,hC,fun _ _ => hbound⟩
      · exact ⟨1,by norm_num,fun _ hb' => False.elim (hb hb')⟩
    · exact ⟨1,by norm_num,fun ha' _ => False.elim (ha ha')⟩
  choose Cs hCs hbound using hex
  let C : ℝ := 1+∑ ab : Fin (Q+1) × Fin (Q+1), Cs ab
  have hsum : 0≤∑ ab : Fin (Q+1) × Fin (Q+1), Cs ab :=
    Finset.sum_nonneg (fun ab _ => (hCs ab).le)
  refine ⟨C,by dsimp only [C]; linarith,?_⟩
  intro a b ha ha96 hb hb96
  let ab : Fin (Q+1) × Fin (Q+1) := (⟨a,by omega⟩,⟨b,by omega⟩)
  have hsmall : Cs ab≤C := by
    have hh : Cs ab≤∑ cd : Fin (Q+1) × Fin (Q+1), Cs cd :=
      Finset.single_le_sum (fun cd _ => (hCs cd).le) (Finset.mem_univ ab)
    dsimp only [C]
    linarith
  have hlocal := hbound ab ha hb
  intro x D E hx hD hE hD2 hE2 G hG hirr hcoeff M j hM hMup hj h hs ed
  obtain ⟨hfin,hcard⟩ :=
    hlocal x D E hx hD hE hD2 hE2 G hG hirr hcoeff M j hM hMup hj h hs ed
  refine ⟨hfin,hcard.trans ?_⟩
  have hL : 0<
      FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.sideLength
        ((M:ℝ)/(8*D)) (rho D E M j) (4*E) ed.P 0 :=
    ed.hpos.trans_le ed.horder
  exact mul_le_mul_of_nonneg_right
    (mul_le_mul_of_nonneg_right hsmall (Real.rpow_nonneg (by linarith) ε))
    (by linarith)

