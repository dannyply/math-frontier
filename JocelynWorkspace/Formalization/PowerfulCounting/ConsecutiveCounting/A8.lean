namespace A5NongeometricCoordinates
open Polynomial MvPolynomial
private abbrev E := Polynomial.Bivariate.equivMvPolynomial ℚ
private def exps (i j : ℕ) : Fin 2 →₀ ℕ := Finsupp.single 0 i + Finsupp.single 1 j

private theorem symm_monomial (m : Fin 2 →₀ ℕ) (a : ℚ) :
    E.symm (MvPolynomial.monomial m a) =
      Polynomial.monomial (m 1) (Polynomial.monomial (m 0) a) := by
  rw [MvPolynomial.monomial_eq]
  rw [Finsupp.prod_fintype _ _ (by intro i; simp)]
  simp [mul_assoc, E, Fin.prod_univ_two, ← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow,
    Polynomial.Bivariate.equivMvPolynomial_symm_C,
    Polynomial.Bivariate.equivMvPolynomial_symm_X_0,
    Polynomial.Bivariate.equivMvPolynomial_symm_X_1]

private theorem coeff_symm (f : MvPolynomial (Fin 2) ℚ) (m : Fin 2 →₀ ℕ) :
    ((E.symm f).coeff (m 1)).coeff (m 0) = f.coeff m := by
  induction f using MvPolynomial.induction_on' with
  | add p q hp hq => simp [map_add, hp, hq]
  | monomial d a =>
    rw [symm_monomial]
    have heq : (d = m) ↔ d 0 = m 0 ∧ d 1 = m 1 := by
      constructor
      · intro h; simp [h]
      · rintro ⟨h0, h1⟩
        ext i
        fin_cases i <;> assumption
    by_cases h0 : d 0 = m 0 <;> by_cases h1 : d 1 = m 1
    all_goals simp [Polynomial.coeff_monomial, MvPolynomial.coeff_monomial, heq, h0, h1]

private theorem coeff_symm_ij (f : MvPolynomial (Fin 2) ℚ) (i j : ℕ) :
    ((E.symm f).coeff j).coeff i = f.coeff (exps i j) := by
  simpa [exps] using coeff_symm f (exps i j)

private theorem exps_sum (i j : ℕ) : (exps i j).sum (fun _ n => n) = i + j := by
  rw [Finsupp.sum_fintype _ _ (by intro k; rfl)]
  simp [Fin.sum_univ_two, exps]

private theorem degree_bounds (f : MvPolynomial (Fin 2) ℚ) (D : ℕ) (hfD : f.totalDegree ≤ D) :
    (E.symm f).natDegree ≤ D ∧ ∀ j, ((E.symm f).coeff j).natDegree ≤ D := by
  constructor
  · apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
    intro j hj
    apply Polynomial.ext
    intro i
    rw [coeff_symm_ij, Polynomial.coeff_zero]
    apply MvPolynomial.coeff_eq_zero_of_totalDegree_lt
    change f.totalDegree < (exps i j).sum (fun _ n => n)
    rw [exps_sum]
    omega
  · intro j
    apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
    intro i hi
    rw [coeff_symm_ij]
    apply MvPolynomial.coeff_eq_zero_of_totalDegree_lt
    change f.totalDegree < (exps i j).sum (fun _ n => n)
    rw [exps_sum]
    omega

private theorem eval_symm (f : MvPolynomial (Fin 2) ℚ) (x y : ℚ) :
    Polynomial.eval y (Polynomial.map (Polynomial.evalRingHom x) (E.symm f)) =
      MvPolynomial.eval ![x, y] f := by
  induction f using MvPolynomial.induction_on with
  | C a =>
    simp [E, Polynomial.Bivariate.equivMvPolynomial_symm_C, Polynomial.evalRingHom]
  | add p q hp hq =>
    simp only [map_add, Polynomial.map_add, Polynomial.eval_add, MvPolynomial.eval_add, hp, hq]
  | mul_X p n hp =>
    fin_cases n
    · simp only [map_mul, Polynomial.map_mul, Polynomial.eval_mul, hp, MvPolynomial.eval_mul]
      simp [E, Polynomial.Bivariate.equivMvPolynomial_symm_X_0, Polynomial.evalRingHom]
    · simp only [map_mul, Polynomial.map_mul, Polynomial.eval_mul, hp, MvPolynomial.eval_mul]
      simp [E, Polynomial.Bivariate.equivMvPolynomial_symm_X_1, Polynomial.evalRingHom]

private theorem eval_equiv (P : Polynomial (Polynomial ℚ)) (a : Fin 2 → ℚ) :
    MvPolynomial.eval a (E P) =
      Polynomial.eval (a 1) (Polynomial.map (Polynomial.evalRingHom (a 0)) P) := by
  have hh := eval_symm (E P) (a 0) (a 1)
  have heq : ![a 0, a 1] = a := by ext i; fin_cases i <;> rfl
  simpa only [AlgEquiv.symm_apply_apply, heq] using hh.symm

private theorem pderiv_zero_C (q : Polynomial ℚ) :
    MvPolynomial.pderiv 0 (E (Polynomial.C q)) = E (Polynomial.C q.derivative) := by
  simpa using Polynomial.Bivariate.pderiv_zero_equivMvPolynomial (Polynomial.C q)

end A5NongeometricCoordinates

namespace A5NongeometricUniformCount
open Polynomial MvPolynomial
private abbrev E := Polynomial.Bivariate.equivMvPolynomial ℚ

private theorem irreducible_of_C (q : Polynomial ℚ)
    (hq : Irreducible (Polynomial.C q : Polynomial (Polynomial ℚ))) : Irreducible q := by
  refine irreducible_iff.mpr ⟨?_, ?_⟩
  · intro hu
    exact hq.not_isUnit (hu.map Polynomial.C)
  · intro a b hab
    have heq : Polynomial.C q = (Polynomial.C a : Polynomial (Polynomial ℚ)) * Polynomial.C b := by
      rw [hab, map_mul]
    rcases hq.isUnit_or_isUnit heq with hu | hu
    · left
      obtain ⟨r, hr, h⟩ := Polynomial.isUnit_iff.mp hu
      have hh : r = a := Polynomial.C_injective h
      simpa [hh] using hr
    · right
      obtain ⟨r, hr, h⟩ := Polynomial.isUnit_iff.mp hu
      have hh : r = b := Polynomial.C_injective h
      simpa [hh] using hr

private theorem no_common_rational_root (q : Polynomial ℚ) (hq : Irreducible q)
    (x : ℚ) (hx : Polynomial.eval x q = 0) (hxd : Polynomial.eval x q.derivative = 0) :
    False := by
  have hcop := (Polynomial.separable_def _).mp hq.separable
  obtain ⟨A, B, hAB⟩ := hcop
  have hh := congrArg (Polynomial.eval x) hAB
  simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_one, hx, hxd,
    mul_zero, add_zero] at hh
  exact zero_ne_one hh

theorem rational_point_count :
  ∀ D : ℕ, 1 ≤ D →
    ∀ f : MvPolynomial (Fin 2) ℚ,
      Irreducible f →
      ¬ Irreducible (MvPolynomial.map (algebraMap ℚ ℂ) f) →
      f.totalDegree ≤ D →
      let S : Set (Fin 2 → ℚ) := {a | MvPolynomial.eval a f = 0}
      S.Finite ∧ S.ncard ≤ 2 * D ^ 3 := by
  intro D hD f hf hred hfD
  let P := E.symm f
  have hP : Irreducible P := hf.map E.symm
  have hfeq : f = E P := (E.apply_symm_apply f).symm
  have hb := A5NongeometricCoordinates.degree_bounds f D hfD
  have hPD : P.natDegree ≤ D := hb.1
  have hcoeff : ∀ j, (P.coeff j).natDegree ≤ D := hb.2
  let S : Set (Fin 2 → ℚ) := {a | MvPolynomial.eval a f = 0}
  change S.Finite ∧ S.ncard ≤ 2 * D ^ 3
  by_cases hpos : 1 ≤ P.natDegree
  · let T : Set (Fin 2 → ℚ) := {a |
      Polynomial.eval (a 1) (Polynomial.map (Polynomial.evalRingHom (a 0)) P) = 0 ∧
      Polynomial.eval (a 1) (Polynomial.map (Polynomial.evalRingHom (a 0)) P.derivative) = 0}
    have hT := A5NongeometricCount.bivariate_singular_count D hD P hP hpos hPD hcoeff
    have hsub : S ⊆ T := by
      intro a ha
      change MvPolynomial.eval a f = 0 at ha
      have hs := A5NongeometricClosure.complex_singularity f hf hred a ha 1
      have hz := ha
      rw [hfeq, A5NongeometricCoordinates.eval_equiv] at hz
      rw [hfeq, Polynomial.Bivariate.pderiv_one_equivMvPolynomial,
        A5NongeometricCoordinates.eval_equiv] at hs
      exact ⟨hz, hs⟩
    exact ⟨hT.1.subset hsub, (Set.ncard_le_ncard hsub hT.1).trans hT.2⟩
  · have hpzero : P.natDegree = 0 := by omega
    let q := P.coeff 0
    have hPq : P = Polynomial.C q := Polynomial.eq_C_of_natDegree_eq_zero hpzero
    have hq : Irreducible q := by
      apply irreducible_of_C
      rwa [← hPq]
    have hempty : S = ∅ := by
      apply Set.ext
      intro a
      constructor
      · intro ha
        change MvPolynomial.eval a f = 0 at ha
        have hs := A5NongeometricClosure.complex_singularity f hf hred a ha 0
        have hz := ha
        rw [hfeq, hPq, A5NongeometricCoordinates.eval_equiv] at hz
        rw [hfeq, hPq, A5NongeometricCoordinates.pderiv_zero_C,
          A5NongeometricCoordinates.eval_equiv] at hs
        simp only [Polynomial.map_C, Polynomial.eval_C] at hz hs
        change Polynomial.eval (a 0) q = 0 at hz
        change Polynomial.eval (a 0) q.derivative = 0 at hs
        exact no_common_rational_root q hq (a 0) hz hs
      · intro ha
        exact False.elim ha
    rw [hempty]
    simp

end A5NongeometricUniformCount

namespace JocelynClaims
theorem claim_3fa2d2f96e9de72be9377526617a680d7d57bf1237521751f2cc9328cc11e338 :
∀ D : ℕ, 1 ≤ D →
    ∀ f : MvPolynomial (Fin 2) ℚ,
      Irreducible f →
      ¬ Irreducible (MvPolynomial.map (algebraMap ℚ ℂ) f) →
      f.totalDegree ≤ D →
      let S : Set (Fin 2 → ℚ) := {a | MvPolynomial.eval a f = 0}
      S.Finite ∧ S.ncard ≤ 2 * D ^ 3 := by
  exact A5NongeometricUniformCount.rational_point_count
end JocelynClaims

