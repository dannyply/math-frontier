namespace A8HighFPriceCardCover
private theorem ncard_le_sum_of_finite_cover
    {ι α : Type*} (J : Finset ι) (U : Set α) (A : ι → Set α)
    (hU : U.Finite) (hA : ∀ j, (A j).Finite)
    (hcover : ∀ z ∈ U, ∃ j ∈ J, z ∈ A j) :
    (U.ncard : ℝ) ≤ ∑ j ∈ J, ((A j).ncard : ℝ) := by
  classical
  have hsub : hU.toFinset ⊆ J.biUnion (fun j => (hA j).toFinset) := by
    intro z hz
    obtain ⟨j,hj,hzj⟩ := hcover z (hU.mem_toFinset.mp hz)
    exact Finset.mem_biUnion.mpr ⟨j,hj,(hA j).mem_toFinset.mpr hzj⟩
  have hcard := (Finset.card_le_card hsub).trans Finset.card_biUnion_le
  rw [Set.ncard_eq_toFinset_card U hU]
  have h2 : ∀ j, (A j).ncard = (hA j).toFinset.card :=
    fun j => Set.ncard_eq_toFinset_card _ _
  simp only [h2]
  exact_mod_cast hcard
end A8HighFPriceCardCover

namespace A8HighFPriceCellTuple
private abbrev Point := (ℕ × ℕ) × (ℕ × ℕ)
private def originalBoxK (k : ℕ) (x D E : ℝ) : Set Point :=
  {z | 1≤ z.1.1 ∧ 1≤ z.1.2 ∧ 1≤ z.2.1 ∧ 1≤ z.2.2 ∧
    z.1.2^k*z.2.2=z.1.1^k*z.2.1+1 ∧
    x/2 < (z.1.1:ℝ)^k*(z.2.1:ℝ) ∧
    (z.1.1:ℝ)^k*(z.2.1:ℝ)≤ x ∧
    D/2 < (z.1.1:ℝ) ∧ (z.1.1:ℝ)≤ D ∧
    E/2 < (z.1.2:ℝ) ∧ (z.1.2:ℝ)≤ E}
private def rhoK (D E : ℝ) (M j : ℕ) : ℝ :=
  D/(2*E)*(1+1/(M:ℝ))^j
private def cellK (k : ℕ) (x D E : ℝ) (M j : ℕ) : Set Point :=
  {z | z∈originalBoxK k x D E ∧
    rhoK D E M j < (z.1.1:ℝ)/(z.1.2:ℝ) ∧
    (z.1.1:ℝ)/(z.1.2:ℝ)≤ rhoK D E M j*(1+1/(M:ℝ))}
private theorem tuple_ellipse_containmentK
    (k M j : ℕ) (x D E : ℝ)
    (hk : 1≤ k) (hM : 1≤ M) (hx : 1≤ x) (hMx : (M:ℝ)≤ x)
    (hD : 0<D) (hE : 0<E)
    (z : Point) (hz : z∈cellK k x D E M j) :
    let U : ℝ := x/D^k
    let V : ℝ := x/E^k
    let B : ℝ := (2:ℝ)^k*(1+(k:ℝ)*(2:ℝ)^k)
    A8HighFPriceMoments.nsq ((M:ℝ)/(4*D)) (rhoK D E M j) (2*E)
      ((z.1.1:ℤ),(z.1.2:ℤ))≤1 ∧
    A8HighFPriceMoments.nsq ((M:ℝ)/(4*B*V)) ((rhoK D E M j)^k)
      (4*(2:ℝ)^k*U) ((z.2.2:ℤ),(z.2.1:ℤ))≤1 := by
  rcases hz with ⟨hbox,hclo,hchi⟩
  rcases hbox with ⟨hdn,hen,hun,hvn,hshift,hnlo,hnhi,hdlo,hdhi,helo,hehi⟩
  have hd : 0<(z.1.1:ℝ) := by exact_mod_cast (show 0<z.1.1 by omega)
  have he : 0<(z.1.2:ℝ) := by exact_mod_cast (show 0<z.1.2 by omega)
  have hu : 0≤(z.2.1:ℝ) := Nat.cast_nonneg _
  have hr : 0<rhoK D E M j := by
    dsimp [rhoK]
    positivity
  have hshiftR :
      (z.1.2:ℝ)^k*(z.2.2:ℝ) =
        (z.1.1:ℝ)^k*(z.2.1:ℝ)+1 := by
    exact_mod_cast hshift
  have hEll := A8HighFPriceEllipse.real_unit_cell_ellipses
    k M x D E (z.1.1:ℝ) (z.1.2:ℝ) (z.2.1:ℝ) (z.2.2:ℝ)
    (rhoK D E M j) hk hM hx hMx hD hE hd he hu hr
    hdlo hdhi helo hehi hnhi hshiftR (le_of_lt hclo) hchi
  simpa only [A8HighFPriceMoments.nsq,
    A8HighFPriceEllipse.realNsq, Int.cast_natCast] using hEll
