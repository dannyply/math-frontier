open Polynomial

private theorem a6a8_k2_of_quadratic
    (k : ℕ) (p q linP linQ : Polynomial ℚ) (h : ℚ)
    (hk : 2 ≤ k)
    (hp2 : p.natDegree = 2)
    (hqLe : q.natDegree ≤ 2)
    (hlinP : linP.natDegree = 1)
    (hlinQ : linQ.natDegree = 1)
    (hh : h ≠ 0)
    (hid : q ^ k * linQ - p ^ k * linP = Polynomial.C h) :
    k = 2 := by
  have hp0 : p ≠ 0 := by
    intro hp
    simp [hp] at hp2
  have hlinP0 : linP ≠ 0 := by
    intro h
    simp [h] at hlinP
  have hPd : (p ^ k * linP).natDegree = 2 * k + 1 := by
    rw [Polynomial.natDegree_mul (pow_ne_zero _ hp0) hlinP0,
      Polynomial.natDegree_pow, hp2, hlinP]
    omega
  have hder0 : (p ^ k * linP).derivative ≠ 0 := by
    intro hz
    have hd := Polynomial.natDegree_derivative (p ^ k * linP)
    rw [hz, hPd] at hd
    simp only [Polynomial.natDegree_zero] at hd
    omega
  have hEq : q ^ k * linQ = p ^ k * linP + Polynomial.C h := by
    linear_combination hid
  have hEqDer :
      (q ^ k * linQ).derivative = (p ^ k * linP).derivative := by
    have ht := congrArg Polynomial.derivative hEq
    simpa only [Polynomial.derivative_add, Polynomial.derivative_C, add_zero] using ht
  have hk1 : k - 1 + 1 = k := by omega
  have hpPow : p ^ k = p ^ (k - 1) * p := by
    calc
      p ^ k = p ^ (k - 1 + 1) := by rw [hk1]
      _ = p ^ (k - 1) * p := pow_succ p (k - 1)
  have hqPow : q ^ k = q ^ (k - 1) * q := by
    calc
      q ^ k = q ^ (k - 1 + 1) := by rw [hk1]
      _ = q ^ (k - 1) * q := pow_succ q (k - 1)
  have hCunit : Polynomial.C h⁻¹ * Polynomial.C h = (1 : Polynomial ℚ) := by
    rw [← Polynomial.C_mul]
    simp [hh]
  have hcop : IsCoprime (p ^ (k - 1)) (q ^ (k - 1)) := by
    refine ⟨-(Polynomial.C h⁻¹) * p * linP,
      Polynomial.C h⁻¹ * q * linQ, ?_⟩
    calc
      (-(Polynomial.C h⁻¹) * p * linP) * p ^ (k - 1) +
          (Polynomial.C h⁻¹ * q * linQ) * q ^ (k - 1) =
        Polynomial.C h⁻¹ * (q ^ k * linQ - p ^ k * linP) := by
          rw [hpPow, hqPow]
          ring
      _ = 1 := by rw [hid]; exact hCunit
  let E : Polynomial ℚ :=
    Polynomial.C (k : ℚ) * q.derivative * linQ + q * linQ.derivative
  let D : Polynomial ℚ :=
    Polynomial.C (k : ℚ) * p.derivative * linP + p * linP.derivative
  have hQFactor : q ^ (k - 1) * E = (q ^ k * linQ).derivative := by
    dsimp [E]
    rw [Polynomial.derivative_mul, Polynomial.derivative_pow, hqPow]
    ring
  have hPFactor : p ^ (k - 1) * D = (p ^ k * linP).derivative := by
    dsimp [D]
    rw [Polynomial.derivative_mul, Polynomial.derivative_pow, hpPow]
    ring
  have hFactor : q ^ (k - 1) * E = p ^ (k - 1) * D :=
    hQFactor.trans (hEqDer.trans hPFactor.symm)
  have hE0 : E ≠ 0 := by
    intro h
    apply hder0
    rw [← hEqDer, ← hQFactor, h]
    simp
  have hq0 : q ≠ 0 := by
    intro h
    apply hE0
    dsimp [E]
    simp [h]
  have hqDer : q.derivative.natDegree ≤ 1 := by
    rw [Polynomial.natDegree_derivative]
    omega
  have hlinQDer : linQ.derivative.natDegree = 0 := by
    rw [Polynomial.natDegree_derivative, hlinQ]
  have hEterm1 :
      (Polynomial.C (k : ℚ) * q.derivative * linQ).natDegree ≤ 2 := by
    have hm1 := Polynomial.natDegree_mul_le
      (p := Polynomial.C (k : ℚ) * q.derivative) (q := linQ)
    have hm2 := Polynomial.natDegree_mul_le
      (p := Polynomial.C (k : ℚ)) (q := q.derivative)
    simp only [hlinQ, Polynomial.natDegree_C] at hm1 hm2
    omega
  have hEterm2 : (q * linQ.derivative).natDegree ≤ 2 := by
    have hm := Polynomial.natDegree_mul_le (p := q) (q := linQ.derivative)
    omega
  have hEle : E.natDegree ≤ 2 := by
    dsimp [E]
    exact (Polynomial.natDegree_add_le _ _).trans
      (max_le hEterm1 hEterm2)
  have hDiv : p ^ (k - 1) ∣ E :=
    hcop.dvd_of_dvd_mul_left ⟨D, hFactor⟩
  have hn := Polynomial.natDegree_le_of_dvd hDiv hE0
  rw [Polynomial.natDegree_pow, hp2] at hn
  omega

theorem JocelynClaims.claim_f488b62b35e4ac5ebb604de754d7ae5a6468267a436302bb0e1a08633e02d1cd :
  ∀ (kNat : ℕ) (d e u v : Polynomial ℚ) (hQ : ℚ),
    2 ≤ kNat →
    u.natDegree = 1 →
    v.natDegree = 1 →
    d.natDegree ≤ 2 →
    e.natDegree ≤ 2 →
    (d.natDegree = 2 ∨ e.natDegree = 2) →
    hQ ≠ 0 →
    e ^ kNat * v - d ^ kNat * u = Polynomial.C hQ →
    kNat = 2 := by
  intro k d e u v h hk hu hv hdLe heLe hquad hh hid
  rcases hquad with hd2 | he2
  · exact a6a8_k2_of_quadratic k d e u v h hk hd2 heLe hu hv hh hid
  · have hid' : d ^ k * u - e ^ k * v = Polynomial.C (-h) := by
      calc
        d ^ k * u - e ^ k * v = -(e ^ k * v - d ^ k * u) := by ring
