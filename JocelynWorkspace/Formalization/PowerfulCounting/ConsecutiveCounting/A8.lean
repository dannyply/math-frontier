  have h0:(tsub w F).coeff (aK w d)=0:=hz _ hne
  rw [cl] at h0
  have h1:=congrArg (MvPolynomial.coeff d) h0
  rw [coeff_weightedHomogeneousComponent,if_pos rfl,coeff_zero] at h1
  exact hd h1
