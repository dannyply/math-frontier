theorem normalized_height_eval
    (k : ℕ) (Q : MvPolynomial (Fin 2) ℝ)
    (a b c ell : ℝ) (ha : a≠0) (hb : b≠0) (hc : c≠0) (hell : ell≠0) :
    let D : Polynomial ℝ := C (ell/a)*X
    let E : Polynomial ℝ := C (ell/b)*(1-X)
    let φ := MvPolynomial.eval₂Hom Polynomial.C ![D,E]
    let F : Polynomial ℝ := C (1/(c*ell^(2*k+1)))*(D^k*φ Q)
    ∀ d e : ℝ, a*d+b*e=ell →
    F.eval (a*d/ell)=d^k*MvPolynomial.eval ![d,e] Q/(c*ell^(2*k+1)) := by
  intro D E φ F d e hlevel
  have hd : (ell/a)*(a*d/ell)=d := by field_simp
  have he : (ell/b)*(1-a*d/ell)=e := by
    calc
      _=(ell-a*d)/b := by field_simp <;> ring
      _=e := by
        apply (div_eq_iff hb).mpr
        linear_combination -hlevel
  have hcomp : (Polynomial.evalRingHom (a*d/ell)).comp φ =
      MvPolynomial.eval ![d,e] := by
    apply MvPolynomial.ringHom_ext
    · intro t
      simp [φ]
    · intro i
      fin_cases i <;> simp [φ,D,E,hd,he]
  have hQ := RingHom.congr_fun hcomp Q
  change (φ Q).eval (a*d/ell)=MvPolynomial.eval ![d,e] Q at hQ
  dsimp only [F]
  simp only [Polynomial.eval_mul,Polynomial.eval_C,Polynomial.eval_pow]
  have hD : D.eval (a*d/ell)=d := by simpa [D] using hd
  rw [hD,hQ]
  ring

theorem normalized_height_original_value
    (k : ℕ) (P Q : MvPolynomial (Fin 2) ℝ)
    (a b c ell : ℝ) (ha : a≠0) (hb : b≠0) (hc : c≠0) (hell : ell≠0)
    (hres : MvPolynomial.X (1:Fin 2)^k*P-MvPolynomial.X (0:Fin 2)^k*Q =
      MvPolynomial.C c*(MvPolynomial.C a*MvPolynomial.X (0:Fin 2)+
        MvPolynomial.C b*MvPolynomial.X (1:Fin 2))^(2*k+1)) :
    let D : Polynomial ℝ := C (ell/a)*X
    let E : Polynomial ℝ := C (ell/b)*(1-X)
    let φ := MvPolynomial.eval₂Hom Polynomial.C ![D,E]
    let F : Polynomial ℝ := C (1/(c*ell^(2*k+1)))*(D^k*φ Q)
    ∀ d e u v : ℝ, a*d+b*e=ell →
      e^k*v-d^k*u=1 →
      MvPolynomial.eval ![d,e] P*u=MvPolynomial.eval ![d,e] Q*v →
      F.eval (a*d/ell)=d^k*u := by
  intro D E φ F d e u v hlevel hshift hgraph
  have hv := congrArg (MvPolynomial.eval ![d,e]) hres
  have hR : e^k*MvPolynomial.eval ![d,e] P-d^k*MvPolynomial.eval ![d,e] Q =
      c*ell^(2*k+1) := by simpa [hlevel] using hv
  have ht : (e^k*MvPolynomial.eval ![d,e] P-d^k*MvPolynomial.eval ![d,e] Q)*u=
      MvPolynomial.eval ![d,e] Q := by
    linear_combination e^k*hgraph+MvPolynomial.eval ![d,e] Q*hshift
  rw [hR] at ht
  have hval := normalized_height_eval k Q a b c ell ha hb hc hell d e hlevel
  change F.eval (a*d/ell)=_ at hval
  rw [hval,←ht]
  field_simp
  <;> ring

theorem affine_original_height_polynomial_eval
    (k : ℕ) (Q : MvPolynomial (Fin 2) ℝ)
    (a b c ell : ℝ) (ha : a≠0) (hb : b≠0) (hc : c≠0) (hell : ell≠0) :
    let D : Polynomial ℝ := C (ell/a)*X
    let E : Polynomial ℝ := C (ell/b)*(1-X)
    let φ := MvPolynomial.eval₂Hom Polynomial.C ![D,E]
    let F : Polynomial ℝ := C (1/(c*ell^(2*k+1)))*(D^k*φ Q)
    ∀ d0 e0 h : ℝ, a*d0+b*e0=ell →
    let N := F.comp (C (a*d0/ell)+C (a*b*h/ell)*X)
    ∀ y : ℝ,
      N.eval y=(d0+b*h*y)^k*
        MvPolynomial.eval ![d0+b*h*y,e0-a*h*y] Q/(c*ell^(2*k+1)) := by
  intro D E φ F d0 e0 h hlevel N y
  have hl : a*(d0+b*h*y)+b*(e0-a*h*y)=ell := by linear_combination hlevel
  have hz : a*d0/ell+(a*b*h/ell)*y=a*(d0+b*h*y)/ell := by ring
  have hval := normalized_height_eval k Q a b c ell ha hb hc hell
    (d0+b*h*y) (e0-a*h*y) hl
  change F.eval (a*(d0+b*h*y)/ell)=_ at hval
  simpa only [N,Polynomial.eval_comp,Polynomial.eval_add,Polynomial.eval_C,
    Polynomial.eval_mul,Polynomial.eval_X,hz] using hval

end
end A8FloorExt

