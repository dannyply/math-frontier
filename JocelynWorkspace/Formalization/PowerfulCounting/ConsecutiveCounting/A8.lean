          MvPolynomial.eval ![x.1.1, x.1.2, x.2.1, x.2.2] F = h ∧
          MvPolynomial.eval ![x.1.1, x.1.2, x.2.1, x.2.2] G' = 0} :
            Set ((ℤ × ℤ) × (ℤ × ℤ))) with hS'def
  let T : (ℤ × ℤ) × (ℤ × ℤ) → (ℤ × ℤ) × (ℤ × ℤ) := fun x =>
    ((a00 * x.1.1 + a01 * x.1.2, a10 * x.1.1 + a11 * x.1.2),
      (b00 * x.2.1 + b01 * x.2.2, b10 * x.2.1 + b11 * x.2.2))
  have hback : ∀ x : (ℤ × ℤ) × (ℤ × ℤ),
      (![(T x).1.1 * p00 + (T x).1.2 * p01, (T x).1.1 * p10 + (T x).1.2 * p11,
        (T x).2.1 * q00 + (T x).2.2 * q01, (T x).2.1 * q10 + (T x).2.2 * q11] : Fin 4 → ℤ) =
        ![x.1.1, x.1.2, x.2.1, x.2.2] := by
    intro x
    have e0 : (T x).1.1 * p00 + (T x).1.2 * p01 = x.1.1 := by
      show (a00 * x.1.1 + a01 * x.1.2) * p00 + (a10 * x.1.1 + a11 * x.1.2) * p01 = x.1.1
      linear_combination x.1.1 * r1 + x.1.2 * r2
    have e1 : (T x).1.1 * p10 + (T x).1.2 * p11 = x.1.2 := by
      show (a00 * x.1.1 + a01 * x.1.2) * p10 + (a10 * x.1.1 + a11 * x.1.2) * p11 = x.1.2
      linear_combination x.1.1 * r3 + x.1.2 * r4
    have e2 : (T x).2.1 * q00 + (T x).2.2 * q01 = x.2.1 := by
      show (b00 * x.2.1 + b01 * x.2.2) * q00 + (b10 * x.2.1 + b11 * x.2.2) * q01 = x.2.1
      linear_combination x.2.1 * t1 + x.2.2 * t2
    have e3 : (T x).2.1 * q10 + (T x).2.2 * q11 = x.2.2 := by
      show (b00 * x.2.1 + b01 * x.2.2) * q10 + (b10 * x.2.1 + b11 * x.2.2) * q11 = x.2.2
      linear_combination x.2.1 * t3 + x.2.2 * t4
    rw [e0, e1, e2, e3]
  have hmaps : ∀ x ∈ ({x : (ℤ × ℤ) × (ℤ × ℤ) |
          Int.gcd x.1.1 x.1.2 = 1 ∧ Int.gcd x.2.1 x.2.2 = 1 ∧
          |((a00 * x.1.1 + a01 * x.1.2 : ℤ) : ℝ)| ≤ L₁ ∧ |((a10 * x.1.1 + a11 * x.1.2 : ℤ) : ℝ)| ≤ L₂ ∧
          |((b00 * x.2.1 + b01 * x.2.2 : ℤ) : ℝ)| ≤ T₁ ∧ |((b10 * x.2.1 + b11 * x.2.2 : ℤ) : ℝ)| ≤ T₂ ∧
          MvPolynomial.eval ![x.1.1, x.1.2, x.2.1, x.2.2] f = h ∧
          MvPolynomial.eval ![x.1.1, x.1.2, x.2.1, x.2.2] G = 0} :
            Set ((ℤ × ℤ) × (ℤ × ℤ))), T x ∈ S' := by
    intro x hx
    obtain ⟨hx1, hx2, hb1, hb2, hb3, hb4, hfx, hGx⟩ := hx
    rw [hS'def, Set.mem_ofPred_eq]
    refine ⟨gcd_lin a00 a01 a10 a11 x.1.1 x.1.2 hε hx1, gcd_lin b00 b01 b10 b11 x.2.1 x.2.2 hη hx2,
      hb1, hb2, hb3, hb4, ?_, ?_⟩
    · show eval ![(T x).1.1, (T x).1.2, (T x).2.1, (T x).2.2] F = h
      rw [hFdef, eval_linSub, hback x]
      exact hfx
    · show eval ![(T x).1.1, (T x).1.2, (T x).2.1, (T x).2.2] G' = 0
      rw [hG'def, eval_linSub, hback x]
      exact hGx
  have hinj : Set.InjOn T ({x : (ℤ × ℤ) × (ℤ × ℤ) |
          Int.gcd x.1.1 x.1.2 = 1 ∧ Int.gcd x.2.1 x.2.2 = 1 ∧
          |((a00 * x.1.1 + a01 * x.1.2 : ℤ) : ℝ)| ≤ L₁ ∧ |((a10 * x.1.1 + a11 * x.1.2 : ℤ) : ℝ)| ≤ L₂ ∧
          |((b00 * x.2.1 + b01 * x.2.2 : ℤ) : ℝ)| ≤ T₁ ∧ |((b10 * x.2.1 + b11 * x.2.2 : ℤ) : ℝ)| ≤ T₂ ∧
          MvPolynomial.eval ![x.1.1, x.1.2, x.2.1, x.2.2] f = h ∧
          MvPolynomial.eval ![x.1.1, x.1.2, x.2.1, x.2.2] G = 0} :
            Set ((ℤ × ℤ) × (ℤ × ℤ))) := by
    intro x _ y _ hxy
    have hb := hback x
    rw [hxy, hback y] at hb
    have h0 := congrFun hb 0
    have h1 := congrFun hb 1
    have h2 := congrFun hb 2
    have h3 := congrFun hb 3
    simp at h0 h1 h2 h3
    obtain ⟨⟨x0, x1⟩, ⟨x2, x3⟩⟩ := x
    obtain ⟨⟨y0, y1⟩, ⟨y2, y3⟩⟩ := y
    simp only at h0 h1 h2 h3
    rw [h0, h1, h2, h3]
  have hS'fin : S'.Finite := by
    have kbox : ∀ (z : ℤ) (L : ℝ), |(z : ℝ)| ≤ L → z ∈ Set.Icc (-⌈L⌉) ⌈L⌉ := by
      intro z L hz
      rw [abs_le] at hz
      have hc := Int.le_ceil L
      constructor
      · have : (-(⌈L⌉ : ℝ)) ≤ (z : ℝ) := by linarith [hz.1]
        exact_mod_cast this
      · have : (z : ℝ) ≤ (⌈L⌉ : ℝ) := by linarith [hz.2]
        exact_mod_cast this
    apply Set.Finite.subset (((Set.finite_Icc (-⌈L₁⌉) ⌈L₁⌉).prod (Set.finite_Icc (-⌈L₂⌉) ⌈L₂⌉)).prod
      ((Set.finite_Icc (-⌈T₁⌉) ⌈T₁⌉).prod (Set.finite_Icc (-⌈T₂⌉) ⌈T₂⌉)))
    intro y hy
    rw [hS'def, Set.mem_ofPred_eq] at hy
    obtain ⟨-, -, h1, h2, h3, h4, -⟩ := hy
    exact Set.mem_prod.mpr ⟨Set.mem_prod.mpr ⟨kbox _ _ h1, kbox _ _ h2⟩,
      Set.mem_prod.mpr ⟨kbox _ _ h3, kbox _ _ h4⟩⟩
  have hcount := Set.ncard_le_ncard_of_injOn T hmaps hinj hS'fin
  refine ⟨Set.Finite.of_finite_image (hS'fin.subset ?_) hinj, ?_⟩
  · rintro _ ⟨x,hx,rfl⟩
    exact hmaps x hx
  · calc _ ≤ ((S'.ncard : ℕ) : ℝ) := by exact_mod_cast hcount
         _ ≤ _ := key

private theorem unit_coprime (a b : ℕ) (h : ℤ)
    (hsign : h = 1 ∨ h = -1) (heq : (a : ℤ) = (b : ℤ) + h) :
    a.Coprime b := by
  apply Nat.coprime_of_dvd'
  intro p hp hpa hpb
  have haZ : (p : ℤ) ∣ (a : ℤ) := by exact_mod_cast hpa
  have hbZ : (p : ℤ) ∣ (b : ℤ) := by exact_mod_cast hpb
  have hph : (p : ℤ) ∣ h := by
    have hh : h = (a : ℤ) - (b : ℤ) := by omega
    rw [hh]
    exact dvd_sub haZ hbZ
  rcases hsign with rfl | rfl
  · exact_mod_cast hph
  · have hp1 : (p : ℤ) ∣ (1 : ℤ) := by
      simpa using (dvd_neg.mpr hph : (p : ℤ) ∣ -(-1 : ℤ))
    exact_mod_cast hp1

theorem unit_coprime_k (a b : ℕ) (h : ℤ)
    (hsign : h = 1 ∨ h = -1) (heq : (a : ℤ) = (b : ℤ) + h) :
    a.Coprime b := by
  apply Nat.coprime_of_dvd'
  intro p hp hpa hpb
  have haZ : (p : ℤ) ∣ (a : ℤ) := by exact_mod_cast hpa
  have hbZ : (p : ℤ) ∣ (b : ℤ) := by exact_mod_cast hpb
  have hph : (p : ℤ) ∣ h := by
    have hh : h = (a : ℤ) - (b : ℤ) := by omega
    rw [hh]
    exact dvd_sub haZ hbZ
  rcases hsign with rfl | rfl
  · exact_mod_cast hph
  · have hp1 : (p : ℤ) ∣ (1 : ℤ) := by
      simpa using (dvd_neg.mpr hph : (p : ℤ) ∣ -(-1 : ℤ))
    exact_mod_cast hp1

theorem both_coprime_k (k : ℕ) (hk : 1 ≤ k) (d e u v : ℕ) (h : ℤ)
    (hsign : h = 1 ∨ h = -1)
    (hshift : ((e ^ k * v : ℕ) : ℤ) = ((d ^ k * u : ℕ) : ℤ) + h) :
    d.Coprime e ∧ u.Coprime v := by
  have hn := (unit_coprime_k (e ^ k * v) (d ^ k * u) h hsign hshift).symm
  have hdvd : d ∣ d ^ k * u := Dvd.dvd.mul_right (dvd_pow_self d (by omega)) u
  have hevd : e ∣ e ^ k * v := Dvd.dvd.mul_right (dvd_pow_self e (by omega)) v
  have huvd : u ∣ d ^ k * u := ⟨d ^ k, by ring⟩
  have hvvd : v ∣ e ^ k * v := ⟨e ^ k, by ring⟩
  exact ⟨hn.of_dvd hdvd hevd, hn.of_dvd huvd hvvd⟩

private noncomputable def unitSurface (k : ℕ) : MvPolynomial (Fin 4) ℤ :=
  X 1 ^ k * X 3 - X 0 ^ k * X 2

private lemma unitSurface_eval (k : ℕ) (d e u v : ℤ) :
    eval ![d,e,u,v] (unitSurface k) = e ^ k * v - d ^ k * u := by
  simp [unitSurface]

private lemma unitSurface_hom (k : ℕ) :
    ∀ m ∈ (unitSurface k).support,
      m 0 + m 1 = k ∧ m 2 + m 3 = 1 := by
  rw [bideg_iff]
  have h1 : IsWeightedHomogeneous PcLemP.wt
      (X 1 ^ k * X 3 : MvPolynomial (Fin 4) ℤ) (k,1) := by
    have ht := ((isWeightedHomogeneous_X ℤ PcLemP.wt (1:Fin 4)).pow k).mul
      (isWeightedHomogeneous_X ℤ PcLemP.wt (3:Fin 4))
    convert ht using 1
    ext <;> simp [PcLemP.wt]
  have h2 : IsWeightedHomogeneous PcLemP.wt
      (X 0 ^ k * X 2 : MvPolynomial (Fin 4) ℤ) (k,1) := by
    have ht := ((isWeightedHomogeneous_X ℤ PcLemP.wt (0:Fin 4)).pow k).mul
      (isWeightedHomogeneous_X ℤ PcLemP.wt (2:Fin 4))
    convert ht using 1
    ext <;> simp [PcLemP.wt]
  have ht := Submodule.sub_mem _
    ((mem_weightedHomogeneousSubmodule ℤ PcLemP.wt (k,1) _).mpr h1)
    ((mem_weightedHomogeneousSubmodule ℤ PcLemP.wt (k,1) _).mpr h2)
  exact (mem_weightedHomogeneousSubmodule ℤ PcLemP.wt (k,1) _).mp ht

private def genericOriginalPositiveTransportStatement : Prop :=
  ∀ k : ℕ, 1 ≤ k →
  ∀ c : ℝ, FormalAB.S1a1f3383.ConsecutiveCountingTargetsAB.CCDNAt (2*(k+1)) c →
  ∀ α β : ℕ, 1 ≤ α → 1 ≤ β →
  ∀ G : MvPolynomial (Fin 4) ℤ,
    G ≠ 0 →
    (∀ m ∈ G.support, m 0 + m 1 = α ∧ m 2 + m 3 = β) →
    Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G) →
  ∀ A B : Matrix (Fin 2) (Fin 2) ℤ,
    (A.det = 1 ∨ A.det = -1) →
    (B.det = 1 ∨ B.det = -1) →
  ∀ L₁ L₂ T₁ T₂ : ℝ,
    L₂ ≤ L₁ → 0 < L₂ → T₂ ≤ T₁ → 0 < T₂ →
  ∀ h : ℤ, (h = 1 ∨ h = -1) →
    let δ : ℝ := (α + k*β : ℕ);
    let H : ℝ := max 1 (L₁^k*T₁);
    let S : Set ((ℕ × ℕ) × (ℕ × ℕ)) :=
      {q | 1 ≤ q.1.1 ∧ 1 ≤ q.1.2 ∧ 1 ≤ q.2.1 ∧ 1 ≤ q.2.2 ∧
        ((q.1.2^k*q.2.2 : ℕ) : ℤ) =
          ((q.1.1^k*q.2.1 : ℕ) : ℤ) + h ∧
        |((A.mulVec ![(q.1.1:ℤ),(q.1.2:ℤ)]) 0:ℝ)| ≤ L₁ ∧
        |((A.mulVec ![(q.1.1:ℤ),(q.1.2:ℤ)]) 1:ℝ)| ≤ L₂ ∧
        |((B.mulVec ![(q.2.2:ℤ),(q.2.1:ℤ)]) 0:ℝ)| ≤ T₁ ∧
        |((B.mulVec ![(q.2.2:ℤ),(q.2.1:ℤ)]) 1:ℝ)| ≤ T₂ ∧
        MvPolynomial.eval
          ![(q.1.1:ℤ),(q.1.2:ℤ),(q.2.1:ℤ),(q.2.2:ℤ)] G = 0};
    S.Finite ∧
      (S.ncard : ℝ) ≤ 2 * |c| * δ^3 * H^(1/δ) * (Real.log H+δ)

private def natToInteger (q : (ℕ×ℕ)×(ℕ×ℕ)) : (ℤ×ℤ)×(ℤ×ℤ) :=
  (((q.1.1:ℤ),(q.1.2:ℤ)),((q.2.1:ℤ),(q.2.2:ℤ)))

private lemma natToInteger_injective : Function.Injective natToInteger := by
  intro q r h
  apply Prod.ext
  · apply Prod.ext
    · have hz : (q.1.1:ℤ)=(r.1.1:ℤ) :=
        congrArg (fun z : (ℤ×ℤ)×(ℤ×ℤ) => z.1.1) h
      exact_mod_cast hz
    · have hz : (q.1.2:ℤ)=(r.1.2:ℤ) :=
        congrArg (fun z : (ℤ×ℤ)×(ℤ×ℤ) => z.1.2) h
      exact_mod_cast hz
  · apply Prod.ext
    · have hz : (q.2.1:ℤ)=(r.2.1:ℤ) :=
        congrArg (fun z : (ℤ×ℤ)×(ℤ×ℤ) => z.2.1) h
      exact_mod_cast hz
    · have hz : (q.2.2:ℤ)=(r.2.2:ℤ) :=
        congrArg (fun z : (ℤ×ℤ)×(ℤ×ℤ) => z.2.2) h
      exact_mod_cast hz

private theorem positive_original_transport :
    genericOriginalPositiveTransportStatement := by
  classical
  intro k hk c hCC α β hα hβ G hG0 hGhom hGirr A B hA hB
    L₁ L₂ T₁ T₂ hL hL2 hT hT2 h hsign
  dsimp only
  let S : Set ((ℕ×ℕ)×(ℕ×ℕ)) :=
    {q | 1≤ q.1.1 ∧ 1≤ q.1.2 ∧ 1≤ q.2.1 ∧ 1≤ q.2.2 ∧
      ((q.1.2^k*q.2.2:ℕ):ℤ)=((q.1.1^k*q.2.1:ℕ):ℤ)+h ∧
      |((A.mulVec ![(q.1.1:ℤ),(q.1.2:ℤ)]) 0:ℝ)|≤ L₁ ∧
      |((A.mulVec ![(q.1.1:ℤ),(q.1.2:ℤ)]) 1:ℝ)|≤ L₂ ∧
      |((B.mulVec ![(q.2.2:ℤ),(q.2.1:ℤ)]) 0:ℝ)|≤ T₁ ∧
      |((B.mulVec ![(q.2.2:ℤ),(q.2.1:ℤ)]) 1:ℝ)|≤ T₂ ∧
      eval ![(q.1.1:ℤ),(q.1.2:ℤ),(q.2.1:ℤ),(q.2.2:ℤ)] G=0}
  change S.Finite ∧ (S.ncard:ℝ)≤
    2 * |c| *((α+k*β:ℕ):ℝ)^3*
      (max 1 (L₁^k*T₁))^(1/((α+k*β:ℕ):ℝ))*
      (Real.log (max 1 (L₁^k*T₁))+((α+k*β:ℕ):ℝ))
  have hA' : A 0 0*A 1 1-A 0 1*A 1 0=1 ∨
      A 0 0*A 1 1-A 0 1*A 1 0=-1 := by
    simpa only [Matrix.det_fin_two] using hA

  have hB' : B 0 1*B 1 0-B 0 0*B 1 1=1 ∨
      B 0 1*B 1 0-B 0 0*B 1 1=-1 := by
    rcases hB with hB|hB
    · right
      rw [Matrix.det_fin_two] at hB
      linear_combination -hB
    · left
      rw [Matrix.det_fin_two] at hB
      linear_combination -hB
  have hh : h≠0 := by rcases hsign with rfl|rfl <;> norm_num
  have hαβ : ¬(α=0 ∧ β=0) := by omega
  obtain ⟨hTfin,hTbound⟩ := integer_unimodular_core k hk c hCC (unitSurface k) (unitSurface_hom k)
    (A 0 0) (A 0 1) (A 1 0) (A 1 1)
    (B 0 1) (B 0 0) (B 1 1) (B 1 0)
    hA' hB' h hh α β G hαβ hG0 hGhom hGirr
    L₁ L₂ T₁ T₂ hL hL2 hT hT2
  let T : Set ((ℤ×ℤ)×(ℤ×ℤ)) :=
    {z | Int.gcd z.1.1 z.1.2=1 ∧ Int.gcd z.2.1 z.2.2=1 ∧
      |((A 0 0*z.1.1+A 0 1*z.1.2:ℤ):ℝ)|≤ L₁ ∧
      |((A 1 0*z.1.1+A 1 1*z.1.2:ℤ):ℝ)|≤ L₂ ∧
      |((B 0 1*z.2.1+B 0 0*z.2.2:ℤ):ℝ)|≤ T₁ ∧
      |((B 1 1*z.2.1+B 1 0*z.2.2:ℤ):ℝ)|≤ T₂ ∧
      eval ![z.1.1,z.1.2,z.2.1,z.2.2] (unitSurface k)=h ∧
      eval ![z.1.1,z.1.2,z.2.1,z.2.2] G=0}
  have hmap : ∀ q∈S, natToInteger q∈T := by
    rintro ⟨⟨d,e⟩,⟨u,v⟩⟩ hq
    rcases hq with ⟨hd,he,hu,hv,hshift,hb1,hb2,hb3,hb4,hzero⟩
    have hcop := both_coprime_k k hk d e u v h hsign hshift
    refine ⟨?_,?_,?_,?_,?_,?_,?_,hzero⟩
    · simpa [natToInteger] using hcop.1.gcd_eq_one
    · simpa [natToInteger] using hcop.2.gcd_eq_one
    · simpa [natToInteger,Matrix.mulVec,dotProduct,Fin.sum_univ_two] using hb1
    · simpa [natToInteger,Matrix.mulVec,dotProduct,Fin.sum_univ_two] using hb2
    · simpa [natToInteger,Matrix.mulVec,dotProduct,Fin.sum_univ_two,add_comm] using hb3
    · simpa [natToInteger,Matrix.mulVec,dotProduct,Fin.sum_univ_two,add_comm] using hb4
    · change eval ![(d:ℤ),(e:ℤ),(u:ℤ),(v:ℤ)] (unitSurface k)=h
      rw [unitSurface_eval k]
      push_cast at hshift
      linarith
  have hfin : S.Finite := Set.Finite.of_finite_image
    (hTfin.subset (by rintro _ ⟨q,hq,rfl⟩; exact hmap q hq))
    natToInteger_injective.injOn
  have hcard : S.ncard≤ T.ncard :=
    Set.ncard_le_ncard_of_injOn natToInteger hmap
      natToInteger_injective.injOn hTfin
  refine ⟨hfin,?_⟩
  have hcardR : (S.ncard:ℝ)≤(T.ncard:ℝ) := by exact_mod_cast hcard
  have hδ0 : (0:ℝ)≤((α+k*β:ℕ):ℝ) := Nat.cast_nonneg _
  have hH : 1 ≤ max 1 (L₁^k*T₁) := le_max_left _ _
  have hlog : 0≤ Real.log (max 1 (L₁^k*T₁)) := Real.log_nonneg hH
  have hpow : 0≤(max 1 (L₁^k*T₁))^(1/((α+k*β:ℕ):ℝ)) :=
    Real.rpow_nonneg (by linarith) _
  have hfac : 0≤2*((α+k*β:ℕ):ℝ)^3*
      (max 1 (L₁^k*T₁))^(1/((α+k*β:ℕ):ℝ))*
      (Real.log (max 1 (L₁^k*T₁))+((α+k*β:ℕ):ℝ)) := by
    positivity
  calc
    (S.ncard:ℝ)≤(T.ncard:ℝ) := hcardR
    _ ≤ 2*c*((α+k*β:ℕ):ℝ)^3*
        (max 1 (L₁^k*T₁))^(1/((α+k*β:ℕ):ℝ))*
        (Real.log (max 1 (L₁^k*T₁))+((α+k*β:ℕ):ℝ)) := hTbound
    _ ≤ 2 * |c| *((α+k*β:ℕ):ℝ)^3*
        (max 1 (L₁^k*T₁))^(1/((α+k*β:ℕ):ℝ))*
        (Real.log (max 1 (L₁^k*T₁))+((α+k*β:ℕ):ℝ)) := by
      apply mul_le_mul_of_nonneg_right _ (add_nonneg hlog hδ0)
      apply mul_le_mul_of_nonneg_right _ hpow
      apply mul_le_mul_of_nonneg_right _ (pow_nonneg hδ0 3)
      exact mul_le_mul_of_nonneg_left (le_abs_self c) (by norm_num)

