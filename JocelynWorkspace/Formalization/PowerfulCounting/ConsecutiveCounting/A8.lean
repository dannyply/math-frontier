private theorem floor_log_rpow_pos
    (y t : ℝ) (hy : 0 < y) :
    Real.log (y ^ t) = t * Real.log y := by
  rw [Real.rpow_def_of_pos hy, Real.log_exp]
  ring

private theorem floor_le_of_log_le
    (u v : ℝ) (hu : 0 < u) (hv : 0 < v)
    (h : Real.log u ≤ Real.log v) : u ≤ v := by
  have ht := Real.exp_le_exp.mpr h
  simpa only [Real.exp_log hu, Real.exp_log hv] using ht

theorem physical_scale_log_identities
    (k : ℕ) (hk : 2≤k)
    (x A Z L H Q c1 c2 G J : ℝ)
    (hx : 0<x) (hA : 0<A) (hZ : 0<Z) (hL : 0<L)
    (hH : 0<H) (hQ : 0<Q) (hc1 : 0<c1) (hc2 : 0<c2)
    (hG : G=A*H/L) (hJ : J=Q/(H*A^(k+1))) :
    let R := Real.sqrt (A*Z)/(4*L)
    let t : ℝ := (k:ℝ)
    let XX := Real.log x
    let a := Real.log A
    let z := Real.log Z
    let l := Real.log L
    let h := Real.log H
    let q := Real.log Q
    0<R ∧ 0<G ∧ 0<J ∧
    Real.log R=(a+z)/2-Real.log 4-l ∧
    Real.log G=a+h-l ∧
    Real.log J=q-h-(t+1)*a ∧
    Real.log (J*R^2)=q-h-t*a+z-2*l-2*Real.log 4 ∧
    Real.log (J*R^(2*k+1)/x)=
      q-h-a/2+(t+1/2)*z-(2*t+1)*l-XX-(2*t+1)*Real.log 4 ∧
    Real.log (c2*R^(2*k-1)/x)=
      (2*t-1)/2*(a+z)-(2*t-1)*l-XX+Real.log c2-(2*t-1)*Real.log 4 ∧
    Real.log (x/(c1*J*G*R^(2*k)))=
      XX+(2*t+1)*l-q-t*z+2*t*Real.log 4-Real.log c1 ∧
    Real.log (Real.sqrt (x/(c2*G^2*R^(2*k-3))))=
      (XX+(2*t-1)*l-2*h-(2*t+1)/2*a-(2*t-3)/2*z)/2+
        (2*t-3)/2*Real.log 4-Real.log c2/2 := by
  intro R t XX a z l h q
  have hRp : 0<R := by dsimp [R];positivity
  have hGp : 0<G := by rw [hG];positivity
  have hJp : 0<J := by rw [hJ];positivity
  have hr : Real.log R=(a+z)/2-Real.log 4-l := by
    dsimp only [R,a,z,l]
    rw [Real.log_div (by positivity : Real.sqrt (A*Z)≠0)
      (by positivity : (4:ℝ)*L≠0)]
    rw [Real.sqrt_eq_rpow,floor_log_rpow_pos (A*Z) _ (mul_pos hA hZ)]
    rw [Real.log_mul (ne_of_gt hA) (ne_of_gt hZ),
      Real.log_mul (by norm_num : (4:ℝ)≠0) (ne_of_gt hL)]
    ring
  have hg : Real.log G=a+h-l := by
    rw [hG,Real.log_div (by positivity : A*H≠0) (ne_of_gt hL),
      Real.log_mul (ne_of_gt hA) (ne_of_gt hH)]
  have hj : Real.log J=q-h-(t+1)*a := by
    rw [hJ,Real.log_div (ne_of_gt hQ) (by positivity : H*A^(k+1)≠0),
      Real.log_mul (ne_of_gt hH) (by positivity : A^(k+1)≠0),Real.log_pow]
    dsimp only [q,h,a,t]
    push_cast
    ring
  have hcast1 : ((2*k-1:ℕ):ℝ)=2*t-1 := by
    dsimp only [t]
    rw [Nat.cast_sub (by omega)]
    push_cast
    ring
  have hcast3 : ((2*k-3:ℕ):ℝ)=2*t-3 := by
    dsimp only [t]
    rw [Nat.cast_sub (by omega)]
    push_cast
    ring
  refine ⟨hRp,hGp,hJp,hr,hg,hj,?_,?_,?_,?_,?_⟩
  · rw [Real.log_mul (ne_of_gt hJp) (by positivity : R^2≠0),Real.log_pow,hj,hr]
    ring
  · rw [Real.log_div (by positivity : J*R^(2*k+1)≠0) (ne_of_gt hx),
      Real.log_mul (ne_of_gt hJp) (by positivity : R^(2*k+1)≠0),Real.log_pow,hj,hr]
    dsimp only [XX,t]
    push_cast
    ring
  · rw [Real.log_div (by positivity : c2*R^(2*k-1)≠0) (ne_of_gt hx),
      Real.log_mul (ne_of_gt hc2) (by positivity : R^(2*k-1)≠0),Real.log_pow,hcast1,hr]
    ring
  · rw [Real.log_div (ne_of_gt hx) (by positivity : c1*J*G*R^(2*k)≠0)]
    rw [Real.log_mul (by positivity : c1*J*G≠0) (by positivity : R^(2*k)≠0),
      Real.log_mul (by positivity : c1*J≠0) (ne_of_gt hGp),
      Real.log_mul (ne_of_gt hc1) (ne_of_gt hJp),Real.log_pow,hj,hg,hr]
    dsimp only [XX,t]
    push_cast
    ring
  · rw [Real.sqrt_eq_rpow,floor_log_rpow_pos _ _ (by positivity : 0<x/(c2*G^2*R^(2*k-3)))]
    rw [Real.log_div (ne_of_gt hx) (by positivity : c2*G^2*R^(2*k-3)≠0),
      Real.log_mul (by positivity : c2*G^2≠0) (by positivity : R^(2*k-3)≠0),
      Real.log_mul (ne_of_gt hc2) (by positivity : G^2≠0),
      Real.log_pow,Real.log_pow,hcast3,hg,hr]
    dsimp only [XX]
    ring

end A8FloorExt

namespace A8FloorExt

private theorem compact_positive_lower_bound
    {α : Type*} [TopologicalSpace α]
    (T : Set α) (hT : IsCompact T) (f : α→ℝ)
    (hf : ContinuousOn f T) (hp : ∀ w∈T,0<f w) :
    ∃ delta : ℝ,0<delta ∧ ∀ w∈T,delta≤f w := by
  by_cases hne : T.Nonempty
  · obtain ⟨w,hw,hmin⟩ := hT.exists_isMinOn hne hf
    exact ⟨f w,hp w hw,fun z hz => hmin hz⟩
  · exact ⟨1,by norm_num,fun w hw => (hne ⟨w,hw⟩).elim⟩

noncomputable def floor_sigma (k : ℕ) (w : ℝ×ℝ×ℝ) : ℝ :=
  let t : ℝ := (k:ℝ)
  (4*t*w.2.2-2*t+(2*t^2-t+1)*w.1)/(2*t+1)-
    2*(2*t^2+t+1)/(2*t+1)*((t+1)*(w.1-w.2.1-w.2.2)/(3*t+2))
noncomputable def floor_tau (k : ℕ) (w : ℝ×ℝ×ℝ) : ℝ :=
  let t : ℝ := (k:ℝ)
  ((2*t^2+3*t+3)*w.2.2-2*w.1-2*t-2)/(2*t+1)+(t+1)*w.2.1
noncomputable def floor_omega (k : ℕ) (w : ℝ×ℝ×ℝ) : ℝ :=
  let t : ℝ := (k:ℝ)
  (2*(2*t-1)*w.2.1-2)/(2*t+1)

theorem compact_forcing_margin
    (k : ℕ) (T : Set (ℝ×ℝ×ℝ)) (hT : IsCompact T)
    (hp : ∀ w∈T,0<floor_sigma k w ∧ 0<floor_tau k w ∧ 0<floor_omega k w) :
    ∃ delta : ℝ,0<delta ∧
      ∀ w∈T,delta≤floor_sigma k w ∧ delta≤floor_tau k w ∧ delta≤floor_omega k w := by
  let f : (ℝ×ℝ×ℝ)→ℝ := fun w =>
    min (floor_sigma k w) (min (floor_tau k w) (floor_omega k w))
  have hf : Continuous f := by
    dsimp [f,floor_sigma,floor_tau,floor_omega]
    fun_prop
  have hfpos : ∀ w∈T,0<f w := by
    intro w hw
    obtain ⟨hs,ht,ho⟩ := hp w hw
    exact lt_min hs (lt_min ht ho)
  obtain ⟨delta,hd,hfbound⟩ := compact_positive_lower_bound T hT f hf.continuousOn hfpos
  refine ⟨delta,hd,?_⟩
  intro w hw
  have h := hfbound w hw
  exact ⟨h.trans (min_le_left _ _),
    h.trans ((min_le_right _ _).trans (min_le_left _ _)),
    h.trans ((min_le_right _ _).trans (min_le_right _ _))⟩

theorem uniform_log_threshold (delta cost : ℝ) (hd : 0<delta) :
    ∃ X0 : ℝ,2≤X0 ∧ ∀ x : ℝ,X0≤x → cost≤delta*Real.log x := by
  refine ⟨max 2 (Real.exp (cost/delta)),le_max_left _ _,?_⟩
  intro x hx
  have he : Real.exp (cost/delta)≤x := (le_max_right _ _).trans hx
  have hl : cost/delta≤Real.log x := by
    have hh := Real.log_le_log (Real.exp_pos (cost/delta)) he
    simpa only [Real.log_exp] using hh
  have hh := (div_le_iff₀ hd).mp hl
  simpa only [mul_comm] using hh

end A8FloorExt

