noncomputable section

theorem free_exponent_switch
    (t s m b alpha ell eta q : ℝ) (ht : 2≤t)
    (hell : 0≤ell) (heta : 0≤eta) (hq : 0≤q) :
    let d := 2*t+1
    let rho := (t+1)*(s-m-b)/(3*t+2)
    let A0 := (4*t*b-2*t+(2*t^2-t+1)*s)/d
    let L0 := 2*(2*t^2+t+1)/d
    let B0 := ((2*t^2+7*t+1)*b-4*t*s-2*t)/d+(t+1)*m
    let R0 := t*(2*t+5)/d
    let sigma := A0-L0*rho
    let tau := ((2*t^2+3*t+3)*b-2*s-2*t-2)/d+(t+1)*m
    let nu := (t+2)*b+(t+1)*m-s-1
    let omega := (2*(2*t-1)*m-2)/d
    (s-m-b≤ell+eta) ∨
    (omega<(2*t-1)/2*(alpha+s)-1-(2*t-1)*ell ∧
      1+(2*t-1)*ell-2*eta-d/2*alpha-(2*t-3)/2*s≤2*b) ∨
    (q≤eta+(3*t+2)*ell+(t+1)*(b+m-s)) ∨
    (sigma<q+s-eta-t*alpha-2*ell ∧
      tau<q+(t+1/2)*s-1-eta-alpha/2-d*ell ∧
      1+d*ell-q-t*s<b-nu) := by
  intro d rho A0 L0 B0 R0 sigma tau nu omega
  have hd : 0<d := by dsimp [d];linarith
  have h3 : 0<3*t+2 := by linarith
  have htpos : 0<t := by linarith
  have h2t : 0<2*t-1 := by linarith
  let threshold := 2+(4*t-2)*ell-4*b-(2*t-3)*s-4*eta
  let qstar := eta+(3*t+2)*ell+(t+1)*(b+m-s)
  by_cases hgeom : s-m-b≤ell+eta
  · exact Or.inl hgeom
  right
  have hsmall : 0<s-m-b-ell-eta := by linarith
  by_cases hlarge : threshold≤d*alpha
  · left
    have hIIslack :
        (2*t-1)/2*(alpha+s)-1-(2*t-1)*ell-omega =
        (2*t-1)/(2*d)*(d*alpha-threshold)+
          (2*(2*t-1)/d)*(s-m-b-ell-eta) := by
      dsimp only [d,threshold,omega]
      field_simp <;> ring
    have hfirst : 0≤(2*t-1)/(2*d)*(d*alpha-threshold) :=
      mul_nonneg (by positivity) (sub_nonneg.mpr hlarge)
    have hsecond : 0<(2*(2*t-1)/d)*(s-m-b-ell-eta) :=
      mul_pos (by positivity) hsmall
    have hIIprice :
        2*b-(1+(2*t-1)*ell-2*eta-d/2*alpha-(2*t-3)/2*s) =
          (d*alpha-threshold)/2 := by
      dsimp only [threshold]
      ring
    exact ⟨by linarith,by linarith⟩
  right
  by_cases hroot : q≤qstar
  · exact Or.inl hroot
  right
  have hgap : 0<threshold-d*alpha := by linarith
  have hqgap : 0<q-qstar := by linarith
  let aa : ℝ := 2*(2*t^2+t+1)/(3*t+2)
  have haa : 0<aa := by dsimp [aa];positivity
  have hda : d-aa=t*(2*t+5)/(3*t+2) := by
    dsimp only [d,aa]
    field_simp
    <;> ring
  have hda0 : 0<d-aa := by rw [hda];positivity
  have hfirst_identity :
      d*(q+s-eta-t*alpha-2*ell-sigma) =
        t*(threshold-d*alpha)+(d-aa)*q+(2*t-1+aa)*eta+aa*(q-qstar) := by
    dsimp only [d,aa,sigma,A0,L0,rho,threshold,qstar]
    field_simp
    <;> ring
  have hfirst_pos : 0<d*(q+s-eta-t*alpha-2*ell-sigma) := by
    have hp : 0<t*(threshold-d*alpha) := mul_pos htpos hgap
    have hp1 : 0≤(d-aa)*q := mul_nonneg hda0.le hq
    have hp2 : 0≤(2*t-1+aa)*eta := mul_nonneg (by linarith) heta
    have hp3 : 0<aa*(q-qstar) := mul_pos haa hqgap
    rw [hfirst_identity]
    linarith
  have hsecond_identity :
      d*(q+(t+1/2)*s-1-eta-alpha/2-d*ell-tau) =
        (threshold-d*alpha)/2+d*(q-qstar)+2*eta+(2*t^2+t+2)*ell := by
    dsimp only [d,tau,threshold,qstar]
    field_simp
    <;> ring
  have hsecond_pos : 0<d*(q+(t+1/2)*s-1-eta-alpha/2-d*ell-tau) := by
    have hp : 0<(threshold-d*alpha)/2 := by positivity
    have hp1 : 0<d*(q-qstar) := mul_pos hd hqgap
    have hp2 : 0≤(2*t^2+t+2)*ell := mul_nonneg (by positivity) hell
    rw [hsecond_identity]
    linarith
  have hprice :
      b-nu-(1+d*ell-q-t*s) =
        (q-qstar)+(t+1)*ell+eta := by
    dsimp only [nu,d,qstar]
    ring
  have hpricepos : 0<(q-qstar)+(t+1)*ell+eta := by
    have hh : 0≤(t+1)*ell := mul_nonneg (by linarith) hell
    linarith
  refine ⟨?_,?_,?_⟩
  · nlinarith only [hfirst_pos,hd]
  · nlinarith only [hsecond_pos,hd]
  · linarith

end
