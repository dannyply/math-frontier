private theorem absorb_factor_height
    (C x K : ℝ) (_hC : 1 ≤ C) (hxC : C ≤ x) (hx : 2 ≤ x) :
    C*x^K ≤ x^(K+1) := by
  have hx0 : 0 < x := by linarith
  calc
    C*x^K ≤ x*x^K := mul_le_mul_of_nonneg_right hxC (Real.rpow_nonneg hx0.le _)
    _=x^(K+1) := by rw [Real.rpow_add hx0,Real.rpow_one]; ring

private theorem finite_union_card_bound {ι α : Type*} [DecidableEq ι]
    (I : Finset ι) (S : Set α) (T : ι→Set α)
    (hT : ∀ i ∈ I,(T i).Finite) (hcover : S ⊆ ⋃ i ∈ I,T i) :
    S.Finite ∧ S.ncard ≤ ∑ i ∈ I,(T i).ncard := by
  classical
  have hFinite : ∀ J : Finset ι,(∀ i ∈ J,(T i).Finite) → (⋃ i ∈ J,T i).Finite := by
    intro J
    induction J using Finset.induction_on with
    | empty =>
      intro hJ
      simp
    | @insert i J hi ih =>
      intro hJ
      rw [Finset.set_biUnion_insert]
      exact (hJ i (Finset.mem_insert_self _ _)).union
        (ih (fun j hj => hJ j (Finset.mem_insert_of_mem hj)))
  have hCard : ∀ J : Finset ι,(⋃ i ∈ J,T i).ncard ≤ ∑ i ∈ J,(T i).ncard := by
    intro J
    induction J using Finset.induction_on with
    | empty => simp
    | @insert i J hi ih =>
      rw [Finset.set_biUnion_insert,Finset.sum_insert hi]
      exact (Set.ncard_union_le _ _).trans (Nat.add_le_add_left ih _)
  have hU := hFinite I hT
  exact ⟨hU.subset hcover,(Set.ncard_le_ncard hcover hU).trans (hCard I)⟩

