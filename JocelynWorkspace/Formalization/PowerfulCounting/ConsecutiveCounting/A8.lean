variable {K:Type*} [Field K] [Algebra ℚ K]
lemma j7 (g f:ac.wC)
    (h:ac.Inc g f→+*K):
    (aL.wR
      (h (ac.q g f (X 0)))
      (h (ac.q g f (X 1)))
      (h (ac.q g f (X 2)))
      (h (ac.q g f (X 3)))).toRingHom= h.comp ((ac.q g f).comp ac.wM):=by
  apply bE
  · intro c
    have hh:
        ((aL.wR
          (h (ac.q g f (X 0)))
          (h (ac.q g f (X 1)))
          (h (ac.q g f (X 2)))
          (h (ac.q g f (X 3)))).toRingHom).comp C= (h.comp ((ac.q g f).comp ac.wM)).comp C:= Subsingleton.elim _ _
    exact congrArg (fun ff:ℚ→+*K=> ff c) hh
  · intro i
    fin_cases i<;> simp [aL.wR,aeval_def,ac.wM]
def fT (k:ℕ) (g:ac.wC)
    (h:ac.Inc g (az k)→+*K):
    ah.wG→ₐ[ℚ] K:= ao.eta
    (h (ac.q g (az k) (X 0)))
    (h (ac.q g (az k) (X 1)))
    (((h (ac.q g (az k) (X 1)))^k* h (ac.q g (az k) (X 3))-
      (h (ac.q g (az k) (X 0)))^k* h (ac.q g (az k) (X 2)))/
      h (ac.q g (az k) (X 3)))
lemma ps (k alpha beta:ℕ)
    (hα:1≤ alpha) (hβ:1≤ beta)
    (hab:2≤ beta∨ k< alpha)
    (G:aa (Fin 4) ℤ)
    (hdeg:∀ m∈ G.support,m 0+m 1=alpha∧ m 2+m 3=beta)
    (hirr:uZ (uJ (uG ℂ) G))
    (h:ac.Inc (ak G) (az k)→+*K)
    (hi:uX h)
    (p:ah.wG)
    (hp:fT k (ak G) h p=0):
    ak G∣ aL.b4 k p p.totalDegree:=by
  let g:=ak G
  let f:=az k
  let d:=h (ac.q g f (X 0))
  let e:=h (ac.q g f (X 1))
  let u:=h (ac.q g f (X 2))
  let v:=h (ac.q g f (X 3))
  have hv:v ≠ 0:=by
    intro hv0
    apply vL k alpha beta hα hβ hab G hdeg hirr (3:Fin 4)
    apply hi
    simpa [v,f,g,ac.wM] using hv0
  have hM:∀ m∈ p.support,m 2≤ p.totalDegree:=by
    intro m hm
    have ht:=le_totalDegree hm
    change (m.sum (fun _ z=> z))≤ p.totalDegree at ht
    have hs:m.sum (fun _ z=> z)=m 0+m 1+m 2:=by
      simp [aD,Fin.sum_univ_succ,Nat.add_assoc]
    rw [hs] at ht
    omega
  have hce:=aL.pn k p p.totalDegree hM d e u v hv
  have heq:=congrArg
    (fun ff:ac.wC→+*K=>
      ff (aL.b4 k p p.totalDegree))
    (j7 g f h)
  change aL.wR d e u v
      (aL.b4 k p p.totalDegree)= h (ac.q g f
        (ac.wM (aL.b4 k p p.totalDegree))) at heq
  have hz:h (ac.q g f
      (ac.wM (aL.b4 k p p.totalDegree)))=0:=by
    rw [←heq,hce]
    rw [show ao.eta d e ((e^k*v-d^k*u)/v) p=0 from hp,mul_zero]
  have hq:ac.q g f
      (ac.wM (aL.b4 k p p.totalDegree))=0:=by
    apply hi
    simpa only [map_zero] using hz
  by_contra hg
  exact ac.j1 g f
    (aL.b4 k p p.totalDegree)
    (cn G hirr)
    (gz k alpha beta hab G hdeg hirr) hg hq
end
end ae.eR
