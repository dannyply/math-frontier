        MvPolynomial.eval w (P.map (Int.castRingHom ℂ))=0 →
        MvPolynomial.eval w (Q.map (Int.castRingHom ℂ))=0 → False) →
      (∀ mu : Fin 2 →₀ ℕ,
        |((P.coeff mu:ℤ):ℝ)|≤x^H ∧ |((Q.coeff mu:ℤ):ℝ)|≤x^H) →
    ∀ a b c A B : ℤ,c≠0 → A*a+B*b=1 →
      MvPolynomial.X (1:Fin 2)^k*P-MvPolynomial.X (0:Fin 2)^k*Q =
        MvPolynomial.C c*(MvPolynomial.C a*MvPolynomial.X (0:Fin 2)+
