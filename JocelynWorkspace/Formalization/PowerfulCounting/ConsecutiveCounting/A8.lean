private noncomputable def sK (k : ℕ) : ℝ :=
  let kr : ℝ := k
  (2 * kr - 3 + Real.sqrt (580 * kr ^ 2 + 276 * kr + 9)) /
    (9 * kr * (2 * kr + 1))

private def HighFactorK (k thr : ℕ)
