theorem pure_nonzero (n : ℕ) (R : MvPolynomial (Fin 2) ℤ)
    (hpure : A6A8OddClassification.PureComplexPower n R) : R≠0 := by
  obtain ⟨γ,α,β,hγ,hαβ,hval⟩ := hpure
  intro hR
  rcases hαβ with ha | hb
  · have hh := hval 1 0
    have hz : γ*α^n=0 := by
      simpa only [hR,map_zero,MvPolynomial.eval_zero,mul_one,mul_zero,add_zero] using hh.symm
    exact (mul_ne_zero hγ (pow_ne_zero n ha)) hz
  · have hh := hval 0 1
    have hz : γ*β^n=0 := by
      simpa only [hR,map_zero,MvPolynomial.eval_zero,mul_one,mul_zero,zero_add] using hh.symm
    exact (mul_ne_zero hγ (pow_ne_zero n hb)) hz

theorem eval_zero_one (R : MvPolynomial (Fin 2) ℤ) (n : ℕ)
    (hR : R.IsHomogeneous n) :
    eval ![(0:ℤ),1] R=R.coeff (C01.PcCurves.ex 0 n) := by
  rw [C01.PcCurves.eval_eq_sum hR,Finset.sum_eq_single 0]
  · simp
  · intro i hi hne
    simp [zero_pow hne]
  · intro h
    simp at h

theorem int_abs_le_of_dvd (a b : ℤ) (hdvd : a∣b) (hb : b≠0) :
    |(a:ℝ)|≤|(b:ℝ)| := by
  have hh := Int.natAbs_le_of_dvd_ne_zero hdvd hb
  have hcast : (a.natAbs:ℝ)≤(b.natAbs:ℝ) := by exact_mod_cast hh
  have ha : (a.natAbs:ℝ)=|(a:ℝ)| := by
    rw [← Int.cast_natCast,Int.natCast_natAbs,Int.cast_abs]
  have hb' : (b.natAbs:ℝ)=|(b:ℝ)| := by
    rw [← Int.cast_natCast,Int.natCast_natAbs,Int.cast_abs]
  rwa [ha,hb'] at hcast

theorem line_power_bounds (n : ℕ) (hn : n≠0) (R : MvPolynomial (Fin 2) ℤ)
    (hR : R.IsHomogeneous n) (hR0 : R≠0) (H : ℝ) (hH : 0≤H)
    (hheight : ∀m : Fin 2 →₀ ℕ, |((R.coeff m:ℤ):ℝ)|≤H)
    (c a b : ℤ) (hc : c≠0)
    (hfac : R=MvPolynomial.C c*(MvPolynomial.C a*MvPolynomial.X (0:Fin 2)+MvPolynomial.C b*MvPolynomial.X (1:Fin 2))^n) :
    |(a:ℝ)|≤H ∧ |(b:ℝ)|≤H ∧ |(c:ℝ)|≤H := by
  have hRa : c*a^n=R.coeff (C01.PcCurves.ex n 0) := by
    rw [← C01.PcCurves.eval_one_zero hR,hfac]
    simp
  have hRb : c*b^n=R.coeff (C01.PcCurves.ex 0 n) := by
    rw [← eval_zero_one R n hR,hfac]
    simp
  have ha : |(a:ℝ)|≤H := by
    by_cases ha : a=0
    · simpa [ha] using hH
    have hca : c*a^n≠0 := mul_ne_zero hc (pow_ne_zero n ha)
    have hd : a∣c*a^n := dvd_mul_of_dvd_right (dvd_pow_self a hn) c
    exact (int_abs_le_of_dvd a (c*a^n) hd hca).trans (by rw [hRa];exact hheight _)
  have hb : |(b:ℝ)|≤H := by
    by_cases hb : b=0
    · simpa [hb] using hH
    have hcb : c*b^n≠0 := mul_ne_zero hc (pow_ne_zero n hb)
    have hd : b∣c*b^n := dvd_mul_of_dvd_right (dvd_pow_self b hn) c
    exact (int_abs_le_of_dvd b (c*b^n) hd hcb).trans (by rw [hRb];exact hheight _)
  have hab : a≠0 ∨ b≠0 := by
    by_contra h
    push Not at h
    have hzero : R=0 := by simp [hfac,h.1,h.2,zero_pow hn]
    exact hR0 hzero
  refine ⟨ha,hb,?_⟩
  rcases hab with ha0 | hb0
  · exact (int_abs_le_of_dvd c (c*a^n) (dvd_mul_right c _) (mul_ne_zero hc (pow_ne_zero n ha0))).trans (by rw [hRa];exact hheight _)
  · exact (int_abs_le_of_dvd c (c*b^n) (dvd_mul_right c _) (mul_ne_zero hc (pow_ne_zero n hb0))).trans (by rw [hRb];exact hheight _)

private theorem sum_single_bound (N : ℕ) (f : ℕ → Fin 2 →₀ ℕ)
    (hf : Function.Injective f) (a : ℕ → ℤ) (H : ℝ) (hH : 0≤H)
    (ha : ∀i∈Finset.range N,|((a i:ℤ):ℝ)|≤H) (m : Fin 2 →₀ ℕ) :
    |((∑i∈Finset.range N,if f i=m then a i else 0 : ℤ):ℝ)|≤H := by
  classical
  by_cases hex : ∃i∈Finset.range N,f i=m
  · obtain ⟨i,hi,him⟩ := hex
    rw [Finset.sum_eq_single i]
    · simpa [him] using ha i hi
    · intro j hj hji
      rw [if_neg (fun h => hji (hf (h.trans him.symm)))]
    · exact fun h => (h hi).elim
  · have he : (∑i∈Finset.range N,if f i=m then a i else 0 : ℤ) = 0 := by
      apply Finset.sum_eq_zero
      intro i hi
      exact if_neg (fun h => hex ⟨i,hi,h⟩)
    rw [he,Int.cast_zero,abs_zero]
    exact hH

private theorem shifted_coeff_bound (F : MvPolynomial (Fin 2) ℤ) (n k : ℕ)
    (hF : F.IsHomogeneous n) (j : Fin 2) (H : ℝ) (hH : 0≤H)
    (hc : ∀m : Fin 2 →₀ ℕ,|((F.coeff m:ℤ):ℝ)|≤H) :
    ∀m : Fin 2 →₀ ℕ,|((((MvPolynomial.X j^k*F).coeff m:ℤ):ℝ))|≤H := by
  classical
  intro m
  rw [C01.PcCurves.hom_repr hF,Finset.mul_sum]
  let f : ℕ → Fin 2 →₀ ℕ := fun i =>
    Finsupp.single j k+C01.PcCurves.ex i (n-i)
  have hf : Function.Injective f := by
    intro i l he
    have h0 := congrArg (fun t : Fin 2 →₀ ℕ => t 0) he
    simp only [f,Finsupp.add_apply,C01.PcCurves.ex_zero] at h0
    omega
  have he : ∀i:ℕ,
      MvPolynomial.X j^k*(MvPolynomial.C (F.coeff (C01.PcCurves.ex i (n-i)))*MvPolynomial.X 0^i*MvPolynomial.X 1^(n-i)) =
        monomial (f i) (F.coeff (C01.PcCurves.ex i (n-i))) := by
    intro i
    rw [C01.PcCurves.monomial_ex,MvPolynomial.X_pow_eq_monomial,MvPolynomial.monomial_mul]
    simp only [one_mul]
    rfl
  simp_rw [he]
  simp only [MvPolynomial.coeff_sum,MvPolynomial.coeff_monomial]
  exact sum_single_bound (n+1) f hf
    (fun i => F.coeff (C01.PcCurves.ex i (n-i))) H hH (fun i hi => hc _) m
def part (G : MvPolynomial (Fin 4) ℤ) (u v : ℤ) : MvPolynomial (Fin 2) ℤ :=
  MvPolynomial.eval₂Hom MvPolynomial.C ![MvPolynomial.X 0, MvPolynomial.X 1, MvPolynomial.C u, MvPolynomial.C v] G

lemma eval_part (G : MvPolynomial (Fin 4) ℤ) (u v d e : ℤ) :
    eval ![d,e] (part G u v) = eval ![d,e,u,v] G := by
  have hcomp : (MvPolynomial.eval ![d,e]).comp
      (MvPolynomial.eval₂Hom MvPolynomial.C ![MvPolynomial.X 0,MvPolynomial.X 1,MvPolynomial.C u,MvPolynomial.C v]) =
      MvPolynomial.eval ![d,e,u,v] := by
    apply MvPolynomial.ringHom_ext
    · intro n
      simp
    · intro i
      fin_cases i <;> simp
  exact RingHom.congr_fun hcomp G

lemma part_PP (G : MvPolynomial (Fin 4) ℤ) (a : ℕ)
    (hG : ∀ m ∈ G.support, m 0+m 1=a ∧ m 2+m 3=1) :
    part G 1 0 = C01.PcParam.PP G := by
  apply MvPolynomial.funext
  intro z
  have hz : z = ![z 0,z 1] := by ext i; fin_cases i <;> rfl
  rw [hz, eval_part, C01.PcParam.lin_eval G a hG]
  simp

lemma part_QQ (G : MvPolynomial (Fin 4) ℤ) (a : ℕ)
    (hG : ∀ m ∈ G.support, m 0+m 1=a ∧ m 2+m 3=1) :
    part G 0 1 = C01.PcParam.QQ G := by
  apply MvPolynomial.funext
  intro z
  have hz : z = ![z 0,z 1] := by ext i; fin_cases i <;> rfl
  rw [hz, eval_part, C01.PcParam.lin_eval G a hG]
  simp

def residual (k : ℕ) (G : MvPolynomial (Fin 4) ℤ) : MvPolynomial (Fin 2) ℤ :=
  MvPolynomial.X 1 ^ k * C01.PcParam.PP G + MvPolynomial.X 0 ^ k * C01.PcParam.QQ G

theorem residual_homogeneous (k : ℕ) (G : MvPolynomial (Fin 4) ℤ) (a : ℕ)
    (hG : ∀ m ∈ G.support, m 0+m 1=a ∧ m 2+m 3=1) :
    (residual k G).IsHomogeneous (a+k) := by
  have hP := (isHomogeneous_X ℤ (1:Fin 2)).pow k
  have hQ := (isHomogeneous_X ℤ (0:Fin 2)).pow k
  have ht := (hP.mul (C01.PcParam.PP_hom G a hG)).add
    (hQ.mul (C01.PcParam.QQ_hom G a hG))
  simpa [residual,Nat.add_comm] using ht

theorem residual_coeff_bound (k : ℕ) (G : MvPolynomial (Fin 4) ℤ) (a : ℕ)
    (hG : ∀m∈G.support,m 0+m 1=a ∧ m 2+m 3=1)
    (H : ℝ) (hH : 0≤H)
    (hc : ∀m : Fin 4 →₀ ℕ,|((G.coeff m:ℤ):ℝ)|≤H) :
    ∀m : Fin 2 →₀ ℕ,|(((residual k G).coeff m:ℤ):ℝ)|≤2*H := by
  intro m
  have hp := shifted_coeff_bound _ a k (C01.PcParam.PP_hom G a hG) 1 H hH
    (C01.PcParam.PP_coeff G a hG H hH hc) m
  have hq := shifted_coeff_bound _ a k (C01.PcParam.QQ_hom G a hG) 0 H hH
    (C01.PcParam.QQ_coeff G a hG H hH hc) m
  dsimp only [residual]
  rw [MvPolynomial.coeff_add,Int.cast_add]
  exact (abs_add_le _ _).trans (by linarith)

theorem integral_normalization (k : ℕ) (hk : 5≤k)
    (K : ℝ) (hK : 0≤K) (x : ℝ) (hx : 2≤x)
    (G : MvPolynomial (Fin 4) ℤ)
    (hbi : ∀m∈G.support,m 0+m 1=k+1 ∧ m 2+m 3=1)
    (hheight : ∀m : Fin 4 →₀ ℕ,|((G.coeff m:ℤ):ℝ)|≤x^K)
    (hpure : A6A8OddClassification.PureComplexPower (2*k+1) (residual k G)) :
    ∃ a b c A B : ℤ, c≠0 ∧ A*a+B*b=1 ∧
      residual k G=MvPolynomial.C c*(MvPolynomial.C a*MvPolynomial.X (0:Fin 2)+MvPolynomial.C b*MvPolynomial.X (1:Fin 2))^(2*k+1) ∧
      |(a:ℝ)|≤x^(K+1) ∧ |(b:ℝ)|≤x^(K+1) ∧ |(c:ℝ)|≤x^(K+1) := by
  have hR : (residual k G).IsHomogeneous (2*k+1) := by
    simpa only [show k+1+k=2*k+1 by omega] using residual_homogeneous k G (k+1) hbi
  have hR0 := pure_nonzero (2*k+1) (residual k G) hpure
  obtain ⟨c,hc,z,hfac⟩ := pure_integer_label_power (2*k+1)
    (by exact ⟨k,by omega⟩) (by omega) (residual k G) hR hR0 hpure
  obtain ⟨A,B,hbez⟩ := label_bezout z
  have hcoeff := residual_coeff_bound k G (k+1) hbi (x^K) (by positivity) hheight
  obtain ⟨ha,hb,hc'⟩ := line_power_bounds (2*k+1) (by omega) (residual k G)
    hR hR0 (2*x^K) (by positivity) hcoeff c (lineCoeffA z) (lineCoeffB z) hc
    (by simpa only [labelLine] using hfac)
  have hcap : 2*x^K≤x^(K+1) := by
    rw [Real.rpow_add (by linarith : 0<x),Real.rpow_one]
    exact mul_le_mul_of_nonneg_right hx (by positivity) |>.trans_eq (by ring)
  exact ⟨lineCoeffA z,lineCoeffB z,c,A,B,hc,hbez,
    by simpa only [labelLine] using hfac,ha.trans hcap,hb.trans hcap,hc'.trans hcap⟩

end
end A8Pure51

namespace A8Mid51Consumer
noncomputable section

def m0 (k : ℕ) (s : ℝ) : ℝ := (9:ℝ)/8*s*(2-(k:ℝ)*s)

def compactStrip (k : ℕ) (theta lo hi : ℝ) : Set (ℝ×ℝ×ℝ) :=
  (fun p : ℝ×ℝ =>  (p.1,m0 k p.1+p.2,(theta-m0 k p.1-p.2)/2)) ''
    (Set.Icc lo hi ×ˢ Set.Icc (0:ℝ) (1/2000))

theorem compactStrip_isCompact (k : ℕ) (theta lo hi : ℝ) :
    IsCompact (compactStrip k theta lo hi) := by
  apply (isCompact_Icc.prod isCompact_Icc).image
  have hc : Continuous (fun p : ℝ×ℝ => 
      (p.1,m0 k p.1+p.2,(theta-m0 k p.1-p.2)/2)) := by
    dsimp [m0]
    fun_prop
  exact hc

theorem compactStrip_mem (k : ℕ) (theta lo hi s mu : ℝ)
    (hslo : lo ≤ s) (hshi : s ≤ hi)
    (hlo : m0 k s ≤ mu) (hhi : mu ≤ m0 k s+1/2000) :
    (s,mu,(theta-mu)/2) ∈ compactStrip k theta lo hi := by
  refine ⟨(s,mu-m0 k s),⟨⟨hslo,hshi⟩,?_,?_⟩,?_⟩
  · linarith
  · linarith
  · dsimp
    congr 1  <;>  ring

theorem uniform_ceiling_threshold :
    ∃ X : ℝ, 2 ≤ X ∧ ∀ x : ℝ, X ≤ x → 2 ≤ x^((1:ℝ)/4000) := by
  refine ⟨max 2 (Real.exp (4000*Real.log 2)),le_max_left _ _,?_⟩
  intro x hx
  have hx2 : 2 ≤ x := (le_max_left _ _).trans hx
  have hxp : 0 < x := by linarith
  have he : Real.exp (4000*Real.log 2) ≤ x := (le_max_right _ _).trans hx
  have hl := Real.log_le_log (Real.exp_pos (4000*Real.log 2)) he
  rw [Real.log_exp] at hl
  rw [Real.rpow_def_of_pos hxp]
  have hh : Real.log (2:ℝ) ≤ Real.log x*((1:ℝ)/4000) := by linarith
  simpa only [Real.exp_log (by norm_num : (0:ℝ) < 2)] using Real.exp_le_exp.mpr hh

theorem actual_ceiling_strip
    (k : ℕ) (hk : 5 ≤ k) (s delta x : ℝ)
    (hd : 0 < delta) (hdhi : delta < 1/4000)
    (hx : 2 ≤ x) (hfee : 2 ≤ x^((1:ℝ)/4000))
    (homega : 0 < (2*(2*(k:ℝ)-1)*m0 k s-2)/(2*(k:ℝ)+1)) :
    let M : ℕ := ⌈x^(m0 k s+delta)⌉₊
    let mu : ℝ := Real.log (M:ℝ)/Real.log x
    1 ≤ M ∧ (M:ℝ) ≤ x ∧ (M:ℝ)=x^mu ∧
      m0 k s ≤ mu ∧ mu ≤ m0 k s+1/2000 := by
  intro M mu
  have hkR : (5:ℝ) ≤ k := by exact_mod_cast hk
  have hxp : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hlog : 0 < Real.log x := Real.log_pos (by linarith)
  have hnum : 0 < 2*(2*(k:ℝ)-1)*m0 k s-2 :=
    by
      have hden : (0:ℝ) < 2*(k:ℝ)+1 := by positivity
      have hh := mul_pos homega hden
      rwa [div_mul_cancel₀ _ (ne_of_gt hden)] at hh
  have hu : 0 ≤ m0 k s := by
    by_contra hn
    have hneg : m0 k s < 0 := lt_of_not_ge hn
    have hfac : 0 < 2*(2*(k:ℝ)-1) := by linarith
    have hm := mul_neg_of_pos_of_neg hfac hneg
    linarith
  have hquad : 8*(k:ℝ)*m0 k s ≤ 9 := by
    dsimp [m0]
    nlinarith [sq_nonneg ((k:ℝ)*s-1)]
  have huhi : m0 k s ≤ 9/40 := by
    have hh := mul_nonneg (show (0:ℝ) ≤ 8*(k:ℝ)-40 by linarith) hu
    nlinarith
  have hv1 : 1 ≤ x^(m0 k s+delta) :=
    Real.one_le_rpow hx1 (by linarith)
  have hMl : x^(m0 k s+delta) ≤ (M:ℝ) := Nat.le_ceil _
  have hMreal : (1:ℝ) ≤ M := hv1.trans hMl
  have hM1 : 1 ≤ M := by exact_mod_cast hMreal
  have hMp : (0:ℝ) < M := by linarith
  have hMc : (M:ℝ) < x^(m0 k s+delta)+1 :=
    Nat.ceil_lt_add_one (Real.rpow_nonneg hxp.le _)
  have hMu : (M:ℝ) ≤ x^(m0 k s+1/2000) := by
    calc
      (M:ℝ) ≤ 2*x^(m0 k s+delta) := by linarith
      _ ≤ x^((1:ℝ)/4000)*x^(m0 k s+delta) :=
        mul_le_mul_of_nonneg_right hfee (Real.rpow_nonneg hxp.le _)
      _=x^((1:ℝ)/4000+(m0 k s+delta)) := (Real.rpow_add hxp _ _).symm
      _ ≤ x^(m0 k s+1/2000) :=
        Real.rpow_le_rpow_of_exponent_le hx1 (by linarith)
  have hMex : (M:ℝ)=x^mu := by
    dsimp [mu]
    rw [Real.rpow_def_of_pos hxp]
    have hh : Real.log x*(Real.log (M:ℝ)/Real.log x)=Real.log (M:ℝ) := by
      field_simp
    rw [hh,Real.exp_log hMp]
  have hlo : m0 k s ≤ mu := by
    have hh := Real.log_le_log (Real.rpow_pos_of_pos hxp _) hMl
    rw [Real.log_rpow hxp] at hh
    dsimp [mu]
    apply (le_div_iff₀ hlog).mpr
    nlinarith
  have hhi : mu ≤ m0 k s+1/2000 := by
    have hh := Real.log_le_log hMp hMu
    rw [Real.log_rpow hxp] at hh
    exact (div_le_iff₀ hlog).mpr hh
  have hMx : (M:ℝ) ≤ x := by
    calc
      (M:ℝ) ≤ x^(m0 k s+1/2000) := hMu
      _ ≤ x^(1:ℝ) := Real.rpow_le_rpow_of_exponent_le hx1 (by linarith)
      _=x := Real.rpow_one x
