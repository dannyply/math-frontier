theorem finite_ncard_of_subset {α : Type*} {S T : Set α} {X : ℝ} (hST : S ⊆ T)
    (hT : T.Finite) (hX : (T.ncard : ℝ) ≤ X) : S.Finite ∧ (S.ncard : ℝ) ≤ X :=
  ⟨hT.subset hST, le_trans (by exact_mod_cast Set.ncard_le_ncard hST hT) hX⟩

theorem sk_facts (kr r sk th : ℝ) (hk5 : 5 ≤ kr) (hk123 : kr ≤ 123)
    (hr0 : 0 ≤ r) (hr2 : r ^ 2 = 580 * kr ^ 2 + 276 * kr + 9)
    (hsk : sk = (2 * kr - 3 + r) / (9 * kr * (2 * kr + 1)))
    (hth : th = ((3 * kr + 2) * sk - 2) / (2 * kr + 1)) :
    kr * sk ≤ 13 / 9 ∧ th = 13 * sk / 8 - 9 * kr * sk ^ 2 / 16 ∧ 1 ≤ th * kr := by
  have hk0 : 0 < kr := by linarith
  have h2k : 0 < 2 * kr + 1 := by linarith
  have ha : 0 < 9 * kr * (2 * kr + 1) := by positivity
  have hsk' : sk * (9 * kr * (2 * kr + 1)) = 2 * kr - 3 + r := by
    rw [hsk, div_mul_cancel₀ _ (ne_of_gt ha)]
  have hT : th * (2 * kr + 1) = (3 * kr + 2) * sk - 2 := by
    rw [hth, div_mul_cancel₀ _ (ne_of_gt h2k)]
  have hr_hi : r ≤ 24 * kr + 16 := by
    by_contra h
    push Not at h
    have hpoly : 0 ≤ 4 * kr * (123 - kr) + 247 := by
      have := mul_nonneg hk0.le (sub_nonneg.mpr hk123)
      linarith
    have hb : (0 : ℝ) < 24 * kr + 16 := by linarith
    nlinarith [mul_pos (sub_pos.mpr h) hb, mul_nonneg (sub_pos.mpr h).le hr0]
  have hr_lo : 24 * kr + 5 ≤ r := by
    by_contra h
    push Not at h
    have hb : (0 : ℝ) < 24 * kr + 5 + r := by linarith
    nlinarith [mul_pos (sub_pos.mpr h) hb, sq_nonneg kr]
  have hksk : kr * sk ≤ 13 / 9 := by
    by_contra h
    push Not at h
    nlinarith [mul_pos (sub_pos.mpr h) h2k]
  have hP : 9 * kr * (2 * kr + 1) * sk ^ 2 + (6 - 4 * kr) * sk - 32 = 0 := by
    have h2 : (9 * kr * (2 * kr + 1)) *
        (9 * kr * (2 * kr + 1) * sk ^ 2 + (6 - 4 * kr) * sk - 32) = 0 := by
      linear_combination (sk * (9 * kr * (2 * kr + 1)) - 2 * kr + 3 + r) * hsk' + hr2
    rcases mul_eq_zero.mp h2 with h | h
    · exact absurd h (ne_of_gt ha)
    · exact h
  have hth' : th = 13 * sk / 8 - 9 * kr * sk ^ 2 / 16 := by
    rw [hth, div_eq_iff (ne_of_gt h2k)]
    linear_combination (1 / 16 : ℝ) * hP
  have hthk : 1 ≤ th * kr := by
    have hA : (3 * kr + 2) * (26 * kr + 2) ≤ (3 * kr + 2) * (2 * kr - 3 + r) :=
      mul_le_mul_of_nonneg_left (by linarith) (by linarith)
    have hB : 9 * (2 * kr + 1) * (kr * ((3 * kr + 2) * sk)) =
        (3 * kr + 2) * (2 * kr - 3 + r) := by
      rw [← hsk']
      ring
    have hC : 9 * (2 * kr + 1) * (4 * kr + 1) ≤
        9 * (2 * kr + 1) * (kr * ((3 * kr + 2) * sk)) := by
      rw [hB]
      nlinarith [hA, sq_nonneg kr]
    have hD : 4 * kr + 1 ≤ kr * ((3 * kr + 2) * sk) :=
      le_of_mul_le_mul_left hC (by linarith)
    have hT' : th * kr * (2 * kr + 1) = kr * ((3 * kr + 2) * sk) - 2 * kr := by
      linear_combination kr * hT
    have hE : (2 * kr + 1) * 1 ≤ (2 * kr + 1) * (th * kr) := by
      nlinarith [hT', hD]
    exact le_of_mul_le_mul_left hE h2k
  exact ⟨hksk, hth', hthk⟩

