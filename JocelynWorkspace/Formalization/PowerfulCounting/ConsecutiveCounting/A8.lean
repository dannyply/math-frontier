    let S : Set OriginalPoint := {p | floor_original_cell k P Q x D E M rho p}
    S.Finite ∧ (S.ncard:ℝ)≤C*x^eps*(1+max D E/M+x^beta) := by

  obtain ⟨CL,X0,hCL,hX0,hLarge⟩ := original_whole_large_uniform_count k hk H eps heps T hT hmargin
  let SB : Set OriginalPoint := {z |
    1≤z.1.1 ∧ 1≤z.1.2 ∧ 1≤z.2.1 ∧ 1≤z.2.2 ∧
    z.1.2^k*z.2.2=z.1.1^k*z.2.1+1 ∧
    ((z.1.1^k*z.2.1:ℕ):ℝ)≤X0}
  have hSB : SB.Finite := original_positive_population_finite k (by omega) X0
  let CS : ℝ := (SB.ncard:ℝ)+1
  let C := max CL CS
  have hC : 0<C := lt_of_lt_of_le hCL (le_max_left _ _)
  refine ⟨C,hC,?_⟩
  intro x hx s m beta hw M D E rho hM1 hMx hMeq hD hE hDE hr
    P Q hP hQ hno hcoeff a b c A B hc hab hres haHeight hbHeight hcHeight S
  have hxp : 0<x := by linarith
  have hM : 0<M := by linarith
  let budget : ℝ := 1+max D E/M+x^beta
  have hbudget : 0<budget := by dsimp [budget];positivity
  change S.Finite ∧ (S.ncard:ℝ)≤C*x^eps*budget
  by_cases hlarge : X0≤x
  · obtain ⟨hS,hcount⟩ := hLarge x hlarge s m beta hw M D E rho hM1 hMx hMeq hD hE hDE hr
      P Q hP hQ hno hcoeff a b c A B hc hab hres haHeight hbHeight hcHeight
    refine ⟨hS,?_⟩
    exact hcount.trans (mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_right (le_max_left CL CS) (by positivity)) hbudget.le)
  · have hsub : S⊆SB := by
      intro p hp
      obtain ⟨hd,he,hu,hv,hshift,hnlo,hnhi,hdlo,hdhi,helo,hehi,hrlo,hrhi,hgraph⟩ := hp
      refine ⟨hd,he,hu,hv,hshift,?_⟩
      have hh : ((pd p^k*pu p:ℕ):ℝ)≤x := by
        simpa only [Nat.cast_mul,Nat.cast_pow] using hnhi
      exact hh.trans (lt_of_not_ge hlarge).le
    have hS : S.Finite := hSB.subset hsub
    have hcN : S.ncard≤SB.ncard :=
      Set.ncard_le_ncard_of_injOn (fun p : OriginalPoint => p) hsub
        (fun _ _ _ _ heq => heq) hSB
    have hfee : 1≤x^eps := Real.one_le_rpow (by linarith) heps.le
    have hbudget1 : 1≤budget := by
      have hh : 0 ≤ max D E/M := by positivity
      have hh' : 0≤x^beta := by positivity
      dsimp only [budget]
      linarith only [hh,hh']
    refine ⟨hS,?_⟩
    calc
      (S.ncard:ℝ)≤(SB.ncard:ℝ) := by exact_mod_cast hcN
      _≤CS := by dsimp [CS];linarith
      _≤C := le_max_right _ _
      _≤C*x^eps := le_mul_of_one_le_right hC.le hfee
