  have hDc :
      C01.PcCurves.dehom PC - Polynomial.X ^ k * C01.PcCurves.dehom QC =
        Polynomial.C γ * (Polynomial.C a * Polynomial.X + Polynomial.C b) ^ (2 * k - 1) := by
    have ht := congrArg C01.PcCurves.dehom hresC
    simpa [RZ, PC, QC, C01.PcCurves.dehom, map_sub, map_mul, map_pow, map_add,
