def Sk (k : ℕ) : ℚ :=
  ∑ i ∈ Finset.range k, (-1 : ℚ) ^ i * ((k - 1).choose i : ℚ) / (2 * (i : ℚ) + 1)

noncomputable def qpoly (k : ℕ) : ℚ[X] :=
  Polynomial.C (1 / 2) + Polynomial.C (1 / (2 * Sk k)) *
    ∑ i ∈ Finset.range k,
      Polynomial.C ((-1 : ℚ) ^ i * ((k - 1).choose i : ℚ) / (2 * (i : ℚ) + 1)) * X ^ (2 * i + 1)

theorem eval_qpoly (k : ℕ) (t : ℚ) : (qpoly k).eval t =
    1 / 2 + (1 / (2 * ∑ i ∈ Finset.range k, (-1 : ℚ) ^ i * ((k - 1).choose i : ℚ) / (2 * (i : ℚ) + 1))) * ∑ i ∈ Finset.range k, (-1 : ℚ) ^ i * ((k - 1).choose i : ℚ) * t ^ (2 * i + 1) / (2 * (i : ℚ) + 1) := by
  simp only [qpoly, Sk, eval_add, eval_C, eval_mul, eval_finsetSum, eval_pow, eval_X]
  have h : ∀ i ∈ Finset.range k,
      (-1 : ℚ) ^ i * ((k - 1).choose i : ℚ) / (2 * (i : ℚ) + 1) * t ^ (2 * i + 1) =
      (-1 : ℚ) ^ i * ((k - 1).choose i : ℚ) * t ^ (2 * i + 1) / (2 * (i : ℚ) + 1) := by
    intro i _
    ring
  rw [Finset.sum_congr rfl h]

theorem coeff_qpoly (j : ℕ) : (qpoly (j + 1)).coeff (2 * j + 1) =
    1 / (2 * Sk (j + 1)) * ((-1 : ℚ) ^ j * ((j + 1 - 1).choose j : ℚ) / (2 * (j : ℚ) + 1)) := by
  unfold qpoly
  have h0 : ¬ (2 * j + 1 = 0) := by omega
  rw [coeff_add, coeff_C, if_neg h0, zero_add, coeff_C_mul, finsetSum_coeff,
    Finset.sum_eq_single j]
  · rw [coeff_C_mul_X_pow, if_pos rfl]
  · intro b _ hb
    have hne : ¬ (2 * j + 1 = 2 * b + 1) := by omega
    rw [coeff_C_mul_X_pow, if_neg hne]
  · intro hj
    exact absurd (Finset.mem_range.mpr (by omega)) hj

theorem qpoly_deg (k : ℕ) (hk : 1 ≤ k) :
    (qpoly k).natDegree = 0 ∨ 2 * k - 1 ≤ (qpoly k).natDegree := by
  obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
  by_cases hc : (1 / (2 * Sk (j + 1)) : ℚ) = 0
  · left
    unfold qpoly
    rw [hc, map_zero, zero_mul, add_zero, natDegree_C]
  · right
    have h2 : 2 * (j + 1) - 1 = 2 * j + 1 := by omega
    rw [h2]
    apply le_natDegree_of_ne_zero
    rw [coeff_qpoly]
    apply mul_ne_zero hc
    apply div_ne_zero
    · apply mul_ne_zero (pow_ne_zero _ (by norm_num))
      simp
    · positivity

theorem exc_claim
    (hτall : ∀ δ : ℝ, 0 < δ → ∃ C : ℝ, 0 < C ∧ ∀ n : ℕ, 0 < n →
      (n.divisors.card : ℝ) ≤ C * (n : ℝ) ^ δ) :
    (let Q : ℕ → ℚ → ℚ := fun k t => 1 / 2 + (1 / (2 * ∑ i ∈ Finset.range k, (-1 : ℚ) ^ i * ((k - 1).choose i : ℚ) / (2 * (i : ℚ) + 1))) * ∑ i ∈ Finset.range k, (-1 : ℚ) ^ i * ((k - 1).choose i : ℚ) * t ^ (2 * i + 1) / (2 * (i : ℚ) + 1); ∀ k : ℕ, 5 ≤ k → k ≤ 123 → ∀ ε : ℝ, 0 < ε → ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ, 2 ≤ x → let T : Set ((ℕ × ℕ) × (ℕ × ℕ)) := {z | 1 ≤ z.1.1 ∧ 1 ≤ z.1.2 ∧ 1 ≤ z.2.1 ∧ 1 ≤ z.2.2 ∧ z.1.2 ^ k * z.2.2 = z.1.1 ^ k * z.2.1 + 1 ∧ ((z.1.1 ^ k * z.2.1 : ℕ) : ℝ) ≤ x ∧ ((∃ t : ℚ, ((z.1.1 ^ k * z.2.1 : ℕ) : ℚ) = -Q k t) ∨ (∃ t : ℚ, ((z.1.1 ^ k * z.2.1 + 1 : ℕ) : ℚ) = Q k t))}; T.Finite ∧ (T.ncard : ℝ) ≤ C * x ^ ((1 : ℝ) / (2 * (k : ℝ) - 1) + ε)) := by
