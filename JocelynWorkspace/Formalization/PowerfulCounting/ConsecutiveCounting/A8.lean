  · intro i hi
    refine ⟨k + i, Finset.mem_Icc.mpr ⟨by omega, ?_⟩, ?_⟩
    · have := Finset.mem_range.mp hi
      omega
    · omega
  · intro j hj
    have := (Finset.mem_Icc.mp hj).1
    congr 1
    omega

