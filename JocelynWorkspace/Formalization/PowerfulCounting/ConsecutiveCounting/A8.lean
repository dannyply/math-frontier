theorem original_progression_band_card_le
    (k : ℕ) (Spts : Finset ((ℕ×ℕ)×(ℕ×ℕ)))
    (d0 e0 a b h ell : ℤ) (f g : Polynomial ℤ) (hell : ell≠0)
    (hcert : ∀ p∈Spts,∃ y : ℤ,
      (p.1.1:ℤ)=d0+b*h*y ∧ (p.1.2:ℤ)=e0-a*h*y ∧
      f.eval y=ell^(2*k+1)*(p.2.2:ℤ) ∧
      g.eval y=ell^(2*k+1)*(p.2.1:ℤ))
    (x D : ℝ) (N : Polynomial ℝ)
    (hbox : ∀ p∈Spts,
      D/2≤(p.1.1:ℝ) ∧ (p.1.1:ℝ)≤D ∧
      x/2<(p.1.1:ℝ)^k*(p.2.1:ℝ) ∧
      (p.1.1:ℝ)^k*(p.2.1:ℝ)≤x)
    (hheight : ∀ p∈Spts,∀ y : ℤ,
      (p.1.1:ℤ)=d0+b*h*y → (p.1.2:ℤ)=e0-a*h*y →
      N.eval (y:ℝ)=(p.1.1:ℝ)^k*(p.2.1:ℝ)) :
    let B : Set ℤ := {j |
      D/2≤(d0:ℝ)+(b:ℝ)*(h:ℝ)*(j:ℝ) ∧
      (d0:ℝ)+(b:ℝ)*(h:ℝ)*(j:ℝ)≤D ∧
      x/2<N.eval (j:ℝ) ∧ N.eval (j:ℝ)≤x}
    B.Finite → Spts.card≤B.ncard := by
  intro B hB
  obtain ⟨T,hcard,hT⟩ := original_shared_parameter_image k Spts
    (fun y => d0+b*h*y) (fun y => e0-a*h*y) ell f g hell hcert
  have hmap : ∀ y∈(↑T:Set ℤ),y∈B := by
    intro y hy
    obtain ⟨p,hp,hd,he,hf,hg⟩ := hT y hy
    obtain ⟨hdlo,hdhi,hnlo,hnhi⟩ := hbox p hp
    have hdr : (p.1.1:ℝ)=(d0:ℝ)+(b:ℝ)*(h:ℝ)*(y:ℝ) := by exact_mod_cast hd
    have hn := hheight p hp y hd he
    change D/2≤_ ∧ _≤D ∧ _ ∧ _
    rw [←hdr,hn]
    exact ⟨hdlo,hdhi,hnlo,hnhi⟩
  have hc := Set.ncard_le_ncard_of_injOn (fun y : ℤ => y) hmap
    (fun _ _ _ _ heq => heq) hB
  simpa only [Set.ncard_coe_finset,hcard] using hc

end
end A8FloorExt

