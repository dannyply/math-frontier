      (A8HighFPriceCellTuple.rhoK D E M j) (2*E) p.P 0
    let T : ℝ := sideLength ((M:ℝ)/(4*B*V))
      ((A8HighFPriceCellTuple.rhoK D E M j)^k)
      (4*(2:ℝ)^k*U) q.P 0
    (A8HighFPriceCellPrice.HighCellK k x D E M j G).Finite ∧
    (((A8HighFPriceCellPrice.HighCellK k x D E M j G).ncard:ℝ)≤
      (2*|c| *(((k*N:ℕ):ℝ))^3*
        ((((2*k+2:ℕ):ℝ))/η+(((k*N:ℕ):ℝ))))*
      x^η*(1+(L^k*T)^((1:ℝ)/(thr:ℝ)))) := by
