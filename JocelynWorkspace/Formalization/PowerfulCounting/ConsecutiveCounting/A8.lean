theorem original_whole_large_uniform_count
    (k : ℕ) (hk : 2≤k) (H : ℕ) (eps : ℝ) (heps : 0<eps)
    (T : Set (ℝ×ℝ×ℝ)) (hT : IsCompact T)
    (hmargin : ∀ w∈T,
      0<floor_sigma k w ∧ 0<floor_tau k w ∧ 0<floor_omega k w ∧
      0≤((k:ℝ)+2)*w.2.2+((k:ℝ)+1)*w.2.1-w.1-1) :
    ∃ C X0 : ℝ,0<C ∧ 2≤X0 ∧
    ∀ x : ℝ,X0≤x →
    ∀ s m beta : ℝ,(s,m,beta)∈T →
    ∀ M D E rho : ℝ,1≤M → M≤x → M=x^m →
      0<D → 0<E → D*E=x^s → rho≤2*D/E →
    ∀ P Q : MvPolynomial (Fin 2) ℤ,
      P.IsHomogeneous (k+1) → Q.IsHomogeneous (k+1) →
      (∀ w : Fin 2 → ℂ,w≠0 →
        MvPolynomial.eval w (P.map (Int.castRingHom ℂ))=0 →
        MvPolynomial.eval w (Q.map (Int.castRingHom ℂ))=0 → False) →
      (∀ mu : Fin 2 →₀ ℕ,
        |((P.coeff mu:ℤ):ℝ)|≤x^H ∧ |((Q.coeff mu:ℤ):ℝ)|≤x^H) →
    ∀ a b c A B : ℤ,c≠0 → A*a+B*b=1 →
      MvPolynomial.X (1:Fin 2)^k*P-MvPolynomial.X (0:Fin 2)^k*Q =
        MvPolynomial.C c*(MvPolynomial.C a*MvPolynomial.X (0:Fin 2)+
          MvPolynomial.C b*MvPolynomial.X (1:Fin 2))^(2*k+1) →
      |(a:ℝ)|≤x^H → |(b:ℝ)|≤x^H → |(c:ℝ)|≤x^H →
    let S : Set OriginalPoint := {p | floor_original_cell k P Q x D E M rho p}
    S.Finite ∧ (S.ncard:ℝ)≤C*x^eps*(1+max D E/M+x^beta) := by
  let eta := eps/2
  have heta : 0<eta := by dsimp [eta];positivity
  obtain ⟨CL,X0,hCL,hX0,hCount⟩ := original_finite_level_uniform_count k hk H eta heta T hT hmargin
  let C := 2*((k+1:ℕ):ℝ)*((k+2:ℕ):ℝ)*CL^2
  have hC : 0<C := by dsimp [C];positivity
  refine ⟨C,X0,hC,hX0,?_⟩
  intro x hx s m beta hw M D E rho hM1 hMx hMeq hD hE hDE hr
    P Q hP hQ hno hcoeff a b c A B hc hab hres haHeight hbHeight hcHeight S
  have hx2 : 2≤x := hX0.trans hx
  have hxp : 0<x := by linarith
  have hM : 0<M := by linarith
  have hSfin : S.Finite := floor_original_cell_finite k (by omega) P Q x D E M rho
  refine ⟨hSfin,?_⟩
  let budget : ℝ := 1+max D E/M+x^beta
  have hbudget : 0<budget := by dsimp [budget];positivity
  change (S.ncard:ℝ)≤C*x^eps*budget
  by_cases hSne : S.Nonempty
  · let SF := hSfin.toFinset
    have hSFmem (p : OriginalPoint) : p∈SF ↔ p∈S := hSfin.mem_toFinset
    let K0 : ℤ :=
      b*P.coeff (Finsupp.single (0:Fin 2) (k+1))-
      a*P.coeff (Finsupp.single (0:Fin 2) k+Finsupp.single (1:Fin 2) 1)+
      (Nat.choose (2*k) (k-1):ℤ)*c*a^(k+1)*b^(k+1)
    have hK0 : K0≠0 :=
      pure_primitive_kernel_nonzero k hk P Q hP hQ a b c A B hc hab hno hres
    let level (p : OriginalPoint) : ℤ := a*(pd p:ℤ)+b*(pe p:ℤ)
    let Uj (j : ℕ) : ℝ := (2:ℝ)^j*(x/D^k)
    let Vj (j : ℕ) : ℝ := (2:ℝ)^j*(x/E^k)
    have hUj (j : ℕ) : 0<Uj j := by dsimp [Uj];positivity
    have hVj (j : ℕ) : 0<Vj j := by dsimp [Vj];positivity
    have hCover (p : OriginalPoint) (hp : p∈S) :
        ∃ j j' : ℕ,j≤k ∧ j'≤k+1 ∧
          OriginalCellPoint k P Q x D E (Uj j) (Vj j') M rho 2 p :=
      original_cell_cofactor_cover k P Q x D E M rho hx2 hD hE hM hr p hp
    obtain ⟨pstar,hpstar⟩ := hSne
    obtain ⟨js,js',hjs,hjs',hpstarCell⟩ := hCover pstar hpstar
    have hdivBound : ((Nat.divisors K0.natAbs).card:ℝ)≤CL*x^eta := by
      have hh := hCount x hx s m beta hw M D E (Uj js) (Vj js') rho hM1 hMx hMeq
        hD hE (hUj js) (hVj js') hDE P Q hP hQ hno hcoeff
        a b c A B hc hab hres haHeight hbHeight hcHeight pstar ∅ hpstarCell
        (by intro p hp;simp at hp)
      exact hh.1
    let I := (signedDivisors K0) ×ˢ ((Finset.range (k+1)) ×ˢ (Finset.range (k+2)))
    let F (i : ℤ×(ℕ×ℕ)) : Finset OriginalPoint :=
      SF.filter (fun p => level p=i.1 ∧
        OriginalCellPoint k P Q x D E (Uj i.2.1) (Vj i.2.2) M rho 2 p)
    have hCoverI : ∀ p∈SF,∃ i∈I,p∈F i := by
      intro p hp
      have hpS : p∈S := (hSFmem p).mp hp
      obtain ⟨j,j',hj,hj',hpCell⟩ := hCover p hpS
      have hcellCopy := hpCell
      obtain ⟨hdp,hep,hup,hvp,hdlo,hdhi,helo,hehi,hulo,huhi,hvlo,hvhi,
        hnlo,hnhi,hunit,hgraph,hcell⟩ := hcellCopy
      have hdata := original_level_data_of_K0_nonzero k hk P Q a b c A B
        (pd p) (pe p) (pu p) (pv p)
        (homogeneous_binary_support P _ hP) (homogeneous_binary_support Q _ hQ)
        hab hres hunit hgraph hK0
      have hldiv : level p∣K0 := hdata.2.2.1
      have hmem : level p∈signedDivisors K0 := mem_signedDivisors K0 (level p) hK0 hldiv
      refine ⟨(level p,(j,j')),?_,?_⟩
      · exact Finset.mem_product.mpr ⟨hmem,Finset.mem_product.mpr
          ⟨Finset.mem_range.mpr (by change j<k+1;omega),Finset.mem_range.mpr (by change j'<k+2;omega)⟩⟩
      · exact Finset.mem_filter.mpr ⟨hp,rfl,hpCell⟩
    have hClassBound : ∀ i∈I,((F i).card:ℝ)≤CL*x^eta*budget := by
      intro i hi
      by_cases hFi : (F i).Nonempty
      · obtain ⟨p0,hp0F⟩ := hFi
        obtain ⟨hp0SF,hlevel0,hp0Cell⟩ := Finset.mem_filter.mp hp0F
        have hSpts : ∀ p∈F i,
            OriginalCellPoint k P Q x D E (Uj i.2.1) (Vj i.2.2) M rho 2 p ∧
            a*(pd p:ℤ)+b*(pe p:ℤ)=a*(pd p0:ℤ)+b*(pe p0:ℤ) := by
          intro p hpF
          obtain ⟨hpSF,hlevelp,hpCell⟩ := Finset.mem_filter.mp hpF
          exact ⟨hpCell,hlevelp.trans hlevel0.symm⟩
        exact (hCount x hx s m beta hw M D E (Uj i.2.1) (Vj i.2.2) rho hM1 hMx hMeq
          hD hE (hUj _) (hVj _) hDE P Q hP hQ hno hcoeff
          a b c A B hc hab hres haHeight hbHeight hcHeight p0 (F i) hp0Cell hSpts).2
      · have hFe : F i=∅ := Finset.not_nonempty_iff_eq_empty.mp hFi
        rw [hFe,Finset.card_empty,Nat.cast_zero]
        positivity
    have hglobal := finite_cover_card_bound SF I F (CL*x^eta*budget) hCoverI hClassBound
    have hIcard : (I.card:ℝ)≤
        (2*CL*x^eta)*((k+1:ℕ):ℝ)*((k+2:ℕ):ℝ) := by
      have hsigned : ((signedDivisors K0).card:ℝ)≤2*CL*x^eta := by
        have hcR : ((signedDivisors K0).card:ℝ)≤2*((Nat.divisors K0.natAbs).card:ℝ) := by
          exact_mod_cast signedDivisors_card K0
        nlinarith only [hcR,hdivBound]
      have hmul := mul_le_mul_of_nonneg_right hsigned
        (show 0≤((k+1:ℕ):ℝ)*((k+2:ℕ):ℝ) by positivity)
      simpa only [I,Finset.card_product,Finset.card_range,Nat.cast_mul,mul_assoc] using hmul
    have hpow : x^eta*x^eta=x^eps := by
      rw [←Real.rpow_add hxp]
      congr 1
      dsimp only [eta]
      ring
    calc
      (S.ncard:ℝ)=(SF.card:ℝ) := by rw [Set.ncard_eq_toFinset_card S hSfin]
      _≤(I.card:ℝ)*(CL*x^eta*budget) := hglobal
      _≤((2*CL*x^eta)*((k+1:ℕ):ℝ)*((k+2:ℕ):ℝ))*(CL*x^eta*budget) :=
        mul_le_mul_of_nonneg_right hIcard (by positivity)
      _=(2*((k+1:ℕ):ℝ)*((k+2:ℕ):ℝ)*CL^2)*(x^eta*x^eta)*budget := by ring
      _=C*x^eps*budget := by rw [hpow]
  · have hSe : S=∅ := Set.not_nonempty_iff_eq_empty.mp hSne
    rw [hSe,Set.ncard_empty,Nat.cast_zero]
    positivity

end
end A8FloorExt

