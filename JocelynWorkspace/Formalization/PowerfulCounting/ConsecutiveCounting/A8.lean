theorem homogeneous_binary_support (P : MvPolynomial (Fin 2) ℤ) (n : ℕ)
    (hP : P.IsHomogeneous n) :
    ∀ μ∈P.support, μ 0+μ 1=n := by
  intro μ hμ
  by_contra hn
  have hd : Finsupp.degree μ≠n := by
    rw [Finsupp.degree_eq_sum,Fin.sum_univ_two]
    exact hn
  exact (MvPolynomial.mem_support_iff.mp hμ) (hP.coeff_eq_zero hd)

theorem eval_int_map {R : Type*} [CommRing R]
    (f : ℤ →+* R) (d e : ℤ) (P : MvPolynomial (Fin 2) ℤ) :
    MvPolynomial.eval ![f d,f e] (MvPolynomial.map f P)=
      f (MvPolynomial.eval ![d,e] P) := by
  have hcomp : (MvPolynomial.eval ![f d,f e]).comp (MvPolynomial.map f)=
      f.comp (MvPolynomial.eval ![d,e]) := by
    apply MvPolynomial.ringHom_ext
    · intro z
      simp
    · intro i
      fin_cases i <;> simp
  exact RingHom.congr_fun hcomp P

end
