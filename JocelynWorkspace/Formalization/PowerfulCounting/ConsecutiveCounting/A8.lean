open Polynomial
noncomputable section

theorem integer_pure_height_physical_data
    (k : ℕ) (hk : 2 ≤ k) (P Q : MvPolynomial (Fin 2) ℤ)
    (hP : P.IsHomogeneous (k+1)) (hQ : Q.IsHomogeneous (k+1))
    (a b c : ℤ) (ell : ℝ) (ha : a≠0) (hb : b≠0) (hc : c≠0) (hell : ell≠0)
    (hno : ∀ w : Fin 2 → ℂ, w≠0 →
      MvPolynomial.eval w (P.map (Int.castRingHom ℂ))=0 →
      MvPolynomial.eval w (Q.map (Int.castRingHom ℂ))=0 → False)
    (hres : MvPolynomial.X (1:Fin 2)^k*P-MvPolynomial.X (0:Fin 2)^k*Q =
      MvPolynomial.C c*(MvPolynomial.C a*MvPolynomial.X (0:Fin 2)+
        MvPolynomial.C b*MvPolynomial.X (1:Fin 2))^(2*k+1)) :
    let S := P.coeff (Finsupp.single (0:Fin 2) (k+1))
    let R := P.coeff (Finsupp.single (0:Fin 2) k+Finsupp.single (1:Fin 2) 1)
    let K0 : ℤ := b*S-a*R+(Nat.choose (2*k) (k-1):ℤ)*c*a^(k+1)*b^(k+1)
    let Pr := P.map (Int.castRingHom ℝ)
    let Qr := Q.map (Int.castRingHom ℝ)
    let D : Polynomial ℝ := C (ell/(a:ℝ))*X
    let E : Polynomial ℝ := C (ell/(b:ℝ))*(1-X)
    let φ := MvPolynomial.eval₂Hom Polynomial.C ![D,E]
    let F : Polynomial ℝ := C (1/((c:ℝ)*ell^(2*k+1)))*(D^k*φ Qr)
    K0≠0 ∧ F.natDegree=2*k+1 ∧
      F.coeff (2*k+1)=(-1:ℝ)^k*((K0:ℝ)/((c:ℝ)*((a:ℝ)*(b:ℝ))^(k+1))) ∧
      (∀ lam : ℝ, F.coeff (2*k+1)=(-1:ℝ)^k*lam →
        lam=(K0:ℝ)/((c:ℝ)*((a:ℝ)*(b:ℝ))^(k+1))) ∧
      (∀ d e u v : ℝ, (a:ℝ)*d+(b:ℝ)*e=ell →
        e^k*v-d^k*u=1 →
        MvPolynomial.eval ![d,e] Pr*u=MvPolynomial.eval ![d,e] Qr*v →
        F.eval ((a:ℝ)*d/ell)=d^k*u) ∧
      (∀ d0 e0 h : ℝ, h≠0 → (a:ℝ)*d0+(b:ℝ)*e0=ell →
        let z0 : ℝ := (a:ℝ)*d0/ell
        let γ : ℝ := (a:ℝ)*(b:ℝ)*h/ell
        let N := F.comp (C z0+C γ*X)
        N.natDegree=2*k+1 ∧
        (∀ y : ℝ, N.eval y=(d0+(b:ℝ)*h*y)^k*
          MvPolynomial.eval ![d0+(b:ℝ)*h*y,e0-(a:ℝ)*h*y] Qr/
            ((c:ℝ)*ell^(2*k+1))) ∧
        (∀ y : ℝ,
          N.derivative.eval y=γ*F.derivative.eval (z0+γ*y) ∧
          N.derivative.derivative.eval y=γ^2*F.derivative.derivative.eval (z0+γ*y)) ∧
        (∀ y u v : ℝ,
          let d : ℝ := d0+(b:ℝ)*h*y
          let e : ℝ := e0-(a:ℝ)*h*y
          e^k*v-d^k*u=1 →
          MvPolynomial.eval ![d,e] Pr*u=MvPolynomial.eval ![d,e] Qr*v →
          N.eval y=d^k*u) ∧
        (∀ q : ℝ, (c:ℝ)*q=(K0:ℝ)*h →
          q≠0 ∧ ∀ lam : ℝ, F.coeff (2*k+1)=(-1:ℝ)^k*lam →
            h*lam*((a:ℝ)*(b:ℝ))^(k+1)=q ∧
            |lam|=|q|/(|h| *|(a:ℝ)*(b:ℝ)|^(k+1))))
:= by
  intro S R K0 Pr Qr D E φ F
  obtain ⟨hK0,hFd,hFc,hlam,hpoint⟩ :=
    integer_pure_height_kernel_data k hk P Q hP hQ a b c ell ha hb hc hell hno hres
  refine ⟨hK0,hFd,hFc,hlam,hpoint,?_⟩
  intro d0 e0 h hh hlevel z0 γ N
  have haR : (a:ℝ)≠0 := by exact_mod_cast ha
  have hbR : (b:ℝ)≠0 := by exact_mod_cast hb
  have hcR : (c:ℝ)≠0 := by exact_mod_cast hc
  have hγ : γ≠0 := div_ne_zero (mul_ne_zero (mul_ne_zero haR hbR) hh) hell
  refine ⟨affine_height_degree F (2*k+1) hFd z0 γ hγ,?_,?_,?_,?_⟩
  · exact affine_original_height_polynomial_eval k Qr
      (a:ℝ) (b:ℝ) (c:ℝ) ell haR hbR hcR hell d0 e0 h hlevel
  · intro y
    exact (affine_height_derivatives F z0 γ y).2
  · intro y u v d e hshift hgraph
    have hl : (a:ℝ)*d+(b:ℝ)*e=ell := by
      dsimp only [d,e]
      linear_combination hlevel
    have hval := hpoint d e u v hl hshift hgraph
    have hz : z0+γ*y=(a:ℝ)*d/ell := by
      dsimp only [z0,γ,d]
      ring
    rw [←hz] at hval
    exact (affine_height_derivatives F z0 γ y).1.trans hval
  · intro q hq
    have hK0R : (K0:ℝ)≠0 := by exact_mod_cast hK0
    refine ⟨?_,?_⟩
    · intro hzero
      rw [hzero,mul_zero] at hq
      exact (mul_ne_zero hK0R hh) hq.symm
    · intro lam hcoeff
      have hlam' := hlam lam hcoeff
      have hbasic : h*lam*((a:ℝ)*(b:ℝ))^(k+1)=q := by
        rw [hlam']
        field_simp
        <;> linear_combination -hq
      refine ⟨hbasic,?_⟩
      have habs : |h| *|lam| *|(a:ℝ)*(b:ℝ)|^(k+1)=|q| := by
        simpa only [abs_mul,abs_pow] using congrArg abs hbasic
      have hden : |h| *|(a:ℝ)*(b:ℝ)|^(k+1)≠0 :=
        mul_ne_zero (abs_ne_zero.mpr hh)
          (pow_ne_zero _ (abs_ne_zero.mpr (mul_ne_zero haR hbR)))
      apply (eq_div_iff hden).mpr
      linear_combination habs

end
end A8FloorExt

namespace JocelynOddHermiteConstruction
open Polynomial
private theorem derivative_power_factor
    (T H : Polynomial ℝ) (k : ℕ) (hk : 1 ≤ k)
    (hT : derivative T = 1) (hdiv : T^k ∣ H) :
    T^(k-1) ∣ derivative H := by
  obtain ⟨J, hJ⟩ := hdiv
  refine ⟨C (k : ℝ) * J + T * derivative J, ?_⟩
  rw [hJ, derivative_mul, derivative_pow, hT, mul_one]
  have hp : T^k = T^(k-1) * T := by
    rw [← pow_succ]
    congr 1
    omega
  rw [hp]
  ring
end JocelynOddHermiteConstruction

namespace JocelynClaims
open Polynomial
theorem claim_d3065130390def9b074e7e2c796dde7461a7b6330ed9e38f08f18f245d0e7a0b :
(∀ k : ℕ, 2 ≤ k → ∃ H : Polynomial ℝ,
  H.natDegree = 2*k-1 ∧
  (Polynomial.X : Polynomial ℝ)^k ∣ H ∧
  (1-Polynomial.X : Polynomial ℝ)^k ∣ H+1) := by
  intro k hk
  let T : Polynomial ℝ := X-1
  let P : Polynomial ℝ := X^k
  let Q : Polynomial ℝ := T^k
  let M : Polynomial ℝ := P*Q
  have hc : IsCoprime (X : Polynomial ℝ) T := by
    refine ⟨1, -1, ?_⟩
    dsimp [T]
    ring
  obtain ⟨a, b, hab⟩ := hc.pow (m := k) (n := k)
  let R : Polynomial ℝ := -(a * P)
  let H : Polynomial ℝ := R %ₘ M
  have hTmonic : T.Monic := by
    simpa [T] using (monic_X_sub_C (1 : ℝ))
  have hMmonic : M.Monic :=
    (monic_X.pow k).mul (hTmonic.pow k)
  have hTdegree : T.natDegree = 1 := by
    simpa [T] using (natDegree_X_sub_C (1 : ℝ))
  have hMdegree : M.natDegree = 2*k := by
    dsimp [M, P, Q]
    rw [natDegree_mul (pow_ne_zero _ X_ne_zero) (pow_ne_zero _ hTmonic.ne_zero),
      natDegree_pow, natDegree_pow, hTdegree, natDegree_X]
    omega
  have hMone : M ≠ 1 := by
    intro h
    have hd := congrArg natDegree h
    rw [hMdegree, natDegree_one] at hd
    omega
  have hHupper : H.natDegree < 2*k := by
    have h := natDegree_modByMonic_lt R hMmonic hMone
    simpa only [hMdegree] using h
  have hPraw : P ∣ R := by
    refine ⟨-a, ?_⟩
    dsimp [R]
    ring
  have hQraw : Q ∣ R+1 := by
    refine ⟨b, ?_⟩
    dsimp [R, P, Q]
    linear_combination -hab
  have hPM : P ∣ M := ⟨Q, rfl⟩
  have hQM : Q ∣ M := ⟨P, mul_comm P Q⟩
  have hHformula : H = R - M * (R /ₘ M) :=
    modByMonic_eq_sub_mul_div R M
  have hPH : P ∣ H := by
    rw [hHformula]
    exact dvd_sub hPraw (dvd_mul_of_dvd_left hPM _)
  have hQH : Q ∣ H+1 := by
    have hform : H+1 = (R+1)-M*(R /ₘ M) := by
      rw [hHformula]
      ring
    rw [hform]
    exact dvd_sub hQraw (dvd_mul_of_dvd_left hQM _)
  have hk0 : k ≠ 0 := by omega
  have hH0 : H.eval 0 = 0 := by
    obtain ⟨J, hJ⟩ := hPH
    rw [hJ]
    simp [P, hk0]
  have hH1 : H.eval 1 + 1 = 0 := by
    obtain ⟨J, hJ⟩ := hQH
    have h := congrArg (fun p : Polynomial ℝ => p.eval 1) hJ
    simpa [Q, T, hk0] using h
  have hDnonzero : derivative H ≠ 0 := by
    intro hD
    have hC := eq_C_of_derivative_eq_zero hD
    have heq : H.eval 0 = H.eval 1 := by rw [hC]; simp
    linarith
  have hDP : (X : Polynomial ℝ)^(k-1) ∣ derivative H :=
    JocelynOddHermiteConstruction.derivative_power_factor X H k
      (by omega) derivative_X hPH
  have hDQ : T^(k-1) ∣ derivative H := by
    have h := JocelynOddHermiteConstruction.derivative_power_factor T (H+1) k
      (by omega) (by simp [T]) hQH
