lemma qm (N:ℕ) (K:ℝ) (hK:0≤ K)
    (ε:ℝ) (hε:0< ε):
    ∃ Cst:ℝ,0< Cst∧ ∀ x:ℝ,2≤ x→ ∀ k α:ℕ,1≤ k→ 1≤ α→ α≤ N→ ∀ G:aa (Fin 4) ℤ,(∀ m∈ G.support,m 0+m 1=α∧ m 2+m 3=1)→ uZ (uJ (uG ℂ) G)→ (∀ m:Fin 4→₀ ℕ,|((G.coeff m:ℤ):ℝ)|≤ x^K)→ ∀ h:ℤ,(h=1∨ h= -1)→ ∀ D E M ρ:ℝ,0≤ D→ 0≤ E→ 1≤ M→ 0< ρ→ ∀ T:Set ((ℕ× ℕ)×(ℕ× ℕ)),(∀ z∈ T,(z.1.2:ℤ)^k*(z.2.2:ℤ)-(z.1.1:ℤ)^k*(z.2.1:ℤ)=h∧ eval ![(z.1.1:ℤ),(z.1.2:ℤ),(z.2.1:ℤ),(z.2.2:ℤ)] G=0)→ (∀ z∈ T,0<(z.1.2:ℝ)∧(z.1.1:ℝ)≤ D∧(z.1.2:ℝ)≤ E∧ ρ<(z.1.1:ℝ)/(z.1.2:ℝ)∧ (z.1.1:ℝ)/(z.1.2:ℝ)≤ ρ*(1+1/M))→ (∃ c:ℤ,X 1^k*C01.PcParam.PP G+X 0^k*C01.PcParam.QQ G= C c*X 0^(α+k)∨ X 1^k*C01.PcParam.PP G+X 0^k*C01.PcParam.QQ G= C c*X 1^(α+k))→ T.Finite∧(T.ncard:ℝ)≤ Cst*x^ε*(1+max D E/M):=by
  obtain ⟨Cst,hCst,hfee⟩:=kv
    (((2*N).factorial:ℝ)^2) (4*(N:ℝ)*K)
    (by positivity) (by positivity) 1 1 (by norm_num) ε hε
  refine ⟨Cst,hCst,?_⟩
  intro x hx k α hk hα hαN G hbi hi v7 h vQ D E M ρ hD hE hM hρ T v9 v8 cY
  have hx1:1≤ x:=by linarith
  have hH:1≤ x^K:=cc hx1 hK
  obtain ⟨B,hB,vs,hfin,vd⟩:= wa k α hk hα G hbi hi (x^K) hH v7
      h vQ D E M ρ hD hE hM hρ T v9 v8 cY
  have hfac:(((2*α).factorial:ℝ)^2)≤((2*N).factorial:ℝ)^2:=by
    have h1:(2*α).factorial≤(2*N).factorial:=Nat.factorial_le (by omega)
    have h2:((2*α).factorial:ℝ)≤((2*N).factorial:ℝ):=by exact_mod_cast h1
    exact aW (a2 _) h2 2
  have hpow:=kw x K hx hK α N hαN
  have hcap:|(B:ℝ)|≤((2*N).factorial:ℝ)^2*x^(4*(N:ℝ)*K):= vs.trans (bq hfac hpow (by positivity) (by positivity))
  have htau:(B.natAbs.divisors.card:ℝ)≤ Cst*x^ε:=by
    simpa using hfee x hx B hB hcap
  refine ⟨hfin,vd.trans ?_⟩
  exact uH htau (by positivity)
