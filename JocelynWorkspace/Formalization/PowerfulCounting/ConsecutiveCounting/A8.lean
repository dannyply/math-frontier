def StewartHyp : Prop :=
∀ q : ℕ, 3 ≤ q → ∀ a : Fin (q + 1) → ℤ,
    Finset.univ.gcd a = 1 →
    Squarefree (∑ i : Fin (q + 1), MvPolynomial.C (a i : ℚ) *
        MvPolynomial.X (0 : Fin 2) ^ (i : ℕ) * MvPolynomial.X (1 : Fin 2) ^ (q - (i : ℕ))) →
    ∀ m : ℤ, m ≠ 0 →
      {rs : ℤ × ℤ | Int.gcd rs.1 rs.2 = 1 ∧
          ∑ i : Fin (q + 1), a i * rs.1 ^ (i : ℕ) * rs.2 ^ (q - (i : ℕ)) = m}.encard ≤
        ((2800 * q ^ (1 + m.natAbs.primeFactors.card) : ℕ) : ℕ∞)

theorem unit_shift_primitive_k (k : ℕ) (hk : 1 ≤ k) (d e u v h : ℤ)
    (hs : h = 1 ∨ h = -1) (hshift : e ^ k * v - d ^ k * u = h) :
    Int.gcd d e = 1 ∧ Int.gcd u v = 1 := by
  constructor
  · apply Int.gcd_eq_one_iff.mpr
    intro c hcd hce
    have hch : c ∣ h := by
      rw [← hshift]
      exact dvd_sub (dvd_mul_of_dvd_left (dvd_pow hce (by omega)) v)
        (dvd_mul_of_dvd_left (dvd_pow hcd (by omega)) u)
    have hc1 : c ∣ (1 : ℤ) := by
      rcases hs with hs | hs
      · simpa only [hs] using hch
      · simpa only [hs, dvd_neg, neg_neg] using hch
    exact hc1
  · apply Int.gcd_eq_one_iff.mpr
    intro c hcu hcv
    have hch : c ∣ h := by
      rw [← hshift]
      exact dvd_sub (dvd_mul_of_dvd_right hcv (e ^ k))
        (dvd_mul_of_dvd_right hcu (d ^ k))
    have hc1 : c ∣ (1 : ℤ) := by
      rcases hs with hs | hs
      · simpa only [hs] using hch
      · simpa only [hs, dvd_neg, neg_neg] using hch
    exact hc1

private theorem positive_linear_pair_unique
    (p r : ℤ) (hpr : (p,r)≠(0,0))
    (d e d' e' : ℕ) (hd : 1≤d) (he : 1≤e) (hd' : 1≤d') (he' : 1≤e')
    (hc : Int.gcd (d:ℤ) (e:ℤ)=1) (hc' : Int.gcd (d':ℤ) (e':ℤ)=1)
    (hl : p*(d:ℤ)+r*(e:ℤ)=0)
    (hl' : p*(d':ℤ)+r*(e':ℤ)=0) :
    d=d' ∧ e=e' := by
  have hpr' : ¬(-r=0 ∧ p=0) := by
    rintro ⟨hr,hp⟩
    apply hpr
    have hr0 : r=0 := neg_eq_zero.mp hr
    exact Prod.ext hp hr0
  have hlin : (d:ℤ)*p=(e:ℤ)*(-r) := by linear_combination hl
  have hlin' : (d':ℤ)*p=(e':ℤ)*(-r) := by linear_combination hl'
  have hpar :=
    FormalAB.Sdd81c7c9.A1QuadraticComponents.same_line_parallel
      (-r) p (d:ℤ) (e:ℤ) (d':ℤ) (e':ℤ) hpr' hlin hlin'
  obtain ⟨k,hk,hdk,hek⟩ :=
    JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C03.PcLemP.prim_parallel
      (d:ℤ) (e:ℤ) (d':ℤ) (e':ℤ) hc hc' hpar
  rcases hk with rfl | rfl
  · constructor
    · have hz : (d':ℤ)=(d:ℤ) := by simpa using hdk
      exact_mod_cast hz.symm
    · have hz : (e':ℤ)=(e:ℤ) := by simpa using hek
      exact_mod_cast hz.symm
  · have hdZ : (1:ℤ)≤(d:ℤ) := by exact_mod_cast hd
    have hdZ' : (1:ℤ)≤(d':ℤ) := by exact_mod_cast hd'
    norm_num at hdk
    omega

private theorem squarefree_diagonal (k : ℕ) (hk : 1 ≤ k)
    (A B : ℚ) (hA : A ≠ 0) (hB : B ≠ 0) :
    Squarefree (MvPolynomial.C A * MvPolynomial.X (0 : Fin 2) ^ k -
      MvPolynomial.C B * MvPolynomial.X (1 : Fin 2) ^ k) := by
  let F : MvPolynomial (Fin 2) ℚ :=
    MvPolynomial.C A * MvPolynomial.X 0 ^ k -
      MvPolynomial.C B * MvPolynomial.X 1 ^ k
  change Squarefree F
  intro q hq
  obtain ⟨r, hr⟩ := hq
  have hd (i : Fin 2) : q ∣ MvPolynomial.pderiv i F := by
    rw [hr]
    simp only [MvPolynomial.pderiv_mul]
    refine ⟨2 * MvPolynomial.pderiv i q * r +
      q * MvPolynomial.pderiv i r, ?_⟩
    ring
  have hkQ : (k : ℚ) ≠ 0 := by exact_mod_cast (show k ≠ 0 by omega)
  have hd0 : MvPolynomial.pderiv (0 : Fin 2) F =
      MvPolynomial.C ((k : ℚ) * A) * MvPolynomial.X (0 : Fin 2) ^ (k - 1) := by
    simp [F, map_mul, mul_assoc, mul_left_comm, mul_comm]
  have hd1 : MvPolynomial.pderiv (1 : Fin 2) F =
      MvPolynomial.C (-(k : ℚ) * B) * MvPolynomial.X (1 : Fin 2) ^ (k - 1) := by
    simp [F, map_mul, mul_assoc, mul_left_comm, mul_comm]
  have huA : IsUnit (MvPolynomial.C ((k : ℚ) * A) : MvPolynomial (Fin 2) ℚ) :=
    (isUnit_iff_ne_zero.mpr (mul_ne_zero hkQ hA)).map MvPolynomial.C
  have huB : IsUnit (MvPolynomial.C (-(k : ℚ) * B) : MvPolynomial (Fin 2) ℚ) :=
    (isUnit_iff_ne_zero.mpr (mul_ne_zero (neg_ne_zero.mpr hkQ) hB)).map MvPolynomial.C
  have hq0 : q ∣ (MvPolynomial.X (0 : Fin 2) : MvPolynomial (Fin 2) ℚ) ^ (k - 1) := by
    apply huA.dvd_mul_left.mp
    rw [← hd0]
    exact hd 0
  have hq1 : q ∣ (MvPolynomial.X (1 : Fin 2) : MvPolynomial (Fin 2) ℚ) ^ (k - 1) := by
    apply huB.dvd_mul_left.mp
    rw [← hd1]
    exact hd 1
  have hxy : IsRelPrime (MvPolynomial.X (0 : Fin 2) : MvPolynomial (Fin 2) ℚ)
      (MvPolynomial.X (1 : Fin 2)) :=
    MvPolynomial.X_prime.irreducible.isRelPrime_iff_not_dvd.mpr (by
      rw [MvPolynomial.X_dvd_X]
      exact Fin.zero_ne_one)
  exact (hxy.pow : IsRelPrime
    ((MvPolynomial.X (0 : Fin 2) : MvPolynomial (Fin 2) ℚ) ^ (k - 1))
    (MvPolynomial.X (1 : Fin 2) ^ (k - 1))) hq0 hq1

private def lastIndex (k : ℕ) : Fin (k + 1) := ⟨k, by omega⟩

private def diagonalCoeffs (k : ℕ) (A B : ℤ) (i : Fin (k + 1)) : ℤ :=
  (if i = lastIndex k then A else 0) - (if i = 0 then B else 0)

private theorem diagonal_content (k : ℕ) (hk : 1 ≤ k)
    (A B : ℤ) (hcop : Int.gcd A B = 1) :
    Finset.univ.gcd (diagonalCoeffs k A B) = 1 := by
  classical
  let a := diagonalCoeffs k A B
  let z : Fin (k + 1) := 0
  let t : Fin (k + 1) := lastIndex k
  have ht0 : t ≠ z := by
    intro h
    have hv := congrArg Fin.val h
    dsimp [t, z, lastIndex] at hv
    omega
  let S : Finset (Fin (k + 1)) := (Finset.univ.erase z).erase t
  have hset : (Finset.univ : Finset (Fin (k + 1))) = insert z (insert t S) := by
    ext i
    by_cases hiz : i = z
    · subst i
      simp
    · by_cases hit : i = t
      · subst i
        simp
      · simp [S, hiz, hit]
  have hrest : S.gcd a = 0 := by
    apply Finset.gcd_eq_zero_iff.mpr
    intro i hi
    have hit : i ≠ t := (Finset.mem_erase.mp hi).1
    have hiz : i ≠ z := (Finset.mem_erase.mp (Finset.mem_erase.mp hi).2).1
    have hit' : i ≠ lastIndex k := by simpa only [t] using hit
    have hiz' : i ≠ (0 : Fin (k + 1)) := by simpa only [z] using hiz
    simp [a, diagonalCoeffs, hit', hiz']
  change Finset.univ.gcd a = 1
  rw [hset, Finset.gcd_insert, Finset.gcd_insert, hrest]
  have ht0' : lastIndex k ≠ (0 : Fin (k + 1)) := ht0
  have ha0 : a z = -B := by
    simp [a, diagonalCoeffs, z, Ne.symm ht0']
  have hat : a t = A := by
    simp [a, diagonalCoeffs, t, ht0']
  rw [ha0, hat]
  simp only [gcd_zero_right]
  rw [← Int.coe_gcd]
  norm_cast
  have hnorm : (normalize A).natAbs = A.natAbs :=
    Int.associated_iff_natAbs.mp (normalize_associated A)
  simpa only [Int.gcd_def, Int.natAbs_neg, hnorm,
    Nat.gcd_comm B.natAbs A.natAbs] using hcop

private theorem sum_single_index {ι R : Type*}
    [Fintype ι] [DecidableEq ι] [AddCommMonoid R] (i0 : ι) (f : ι → R) :
    (∑ i, if i = i0 then f i else 0) = f i0 := by
  classical
  rw [Finset.sum_eq_single i0]
  · simp
  · intro i hi hne
    simp [hne]
  · intro h
    exact (h (Finset.mem_univ i0)).elim

private theorem diagonal_polynomial (k : ℕ) (A B : ℤ) :
    (∑ i : Fin (k + 1),
      MvPolynomial.C ((diagonalCoeffs k A B i : ℤ) : ℚ) *
      MvPolynomial.X (0 : Fin 2) ^ (i : ℕ) *
      MvPolynomial.X (1 : Fin 2) ^ (k - (i : ℕ))) =
    MvPolynomial.C (A : ℚ) * MvPolynomial.X (0 : Fin 2) ^ k -
      MvPolynomial.C (B : ℚ) * MvPolynomial.X (1 : Fin 2) ^ k := by
  classical
  calc
    _ = (∑ i : Fin (k + 1), if i = lastIndex k then
          MvPolynomial.C (A : ℚ) * MvPolynomial.X (0 : Fin 2) ^ (i : ℕ) *
            MvPolynomial.X (1 : Fin 2) ^ (k - (i : ℕ)) else 0) -
        (∑ i : Fin (k + 1), if i = 0 then
          MvPolynomial.C (B : ℚ) * MvPolynomial.X (0 : Fin 2) ^ (i : ℕ) *
            MvPolynomial.X (1 : Fin 2) ^ (k - (i : ℕ)) else 0) := by
      rw [← Finset.sum_sub_distrib]
      apply Finset.sum_congr rfl
      intro i hi
      by_cases hlast : i = lastIndex k <;> by_cases hzero : i = 0 <;>
        simp [diagonalCoeffs, hlast, hzero, sub_mul, map_sub]
      all_goals split_ifs <;> simp_all
    _ = _ := by
      rw [sum_single_index, sum_single_index]
      simp [lastIndex]

private theorem diagonal_eval (k : ℕ) (A B d e : ℤ) :
    (∑ i : Fin (k + 1), diagonalCoeffs k A B i * d ^ (i : ℕ) *
      e ^ (k - (i : ℕ))) = A * d ^ k - B * e ^ k := by
  classical
  calc
    _ = (∑ i : Fin (k + 1), if i = lastIndex k then
          A * d ^ (i : ℕ) * e ^ (k - (i : ℕ)) else 0) -
        (∑ i : Fin (k + 1), if i = 0 then
          B * d ^ (i : ℕ) * e ^ (k - (i : ℕ)) else 0) := by
      rw [← Finset.sum_sub_distrib]
      apply Finset.sum_congr rfl
      intro i hi
      by_cases hlast : i = lastIndex k <;> by_cases hzero : i = 0 <;>
        simp [diagonalCoeffs, hlast, hzero, sub_mul]
    _ = _ := by
      rw [sum_single_index, sum_single_index]
      simp [lastIndex]

private theorem primitive_diagonal_count (hS : StewartHyp) (k : ℕ) (hk : 3 ≤ k)
    (A B m : ℤ) (hA : A ≠ 0) (hB : B ≠ 0)
    (hcop : Int.gcd A B = 1) (hm : m ≠ 0) :
    {rs : ℤ × ℤ | Int.gcd rs.1 rs.2 = 1 ∧
      A * rs.1 ^ k - B * rs.2 ^ k = m}.encard ≤
      ((2800 * k ^ (1 + m.natAbs.primeFactors.card) : ℕ) : ℕ∞) := by
  have hcontent := diagonal_content k (by omega) A B hcop
  have hsf : Squarefree (∑ i : Fin (k + 1),
      MvPolynomial.C ((diagonalCoeffs k A B i : ℤ) : ℚ) *
      MvPolynomial.X (0 : Fin 2) ^ (i : ℕ) *
      MvPolynomial.X (1 : Fin 2) ^ (k - (i : ℕ))) := by
    rw [diagonal_polynomial]
    exact squarefree_diagonal k (by omega) (A : ℚ) (B : ℚ)
      (by exact_mod_cast hA) (by exact_mod_cast hB)
  have hbound := hS k hk (diagonalCoeffs k A B) hcontent hsf m hm
  simpa only [diagonal_eval] using hbound

private theorem unit_thue_fiber (hS : StewartHyp) (k : ℕ) (hk : 3 ≤ k)
    (u v : ℕ) (hu : 0 < u) (hv : 0 < v)
    (F : Finset (ℕ × ℕ))
    (hF : ∀ de ∈ F, de.2 ^ k * v = de.1 ^ k * u + 1) :
    F.card ≤ 2800 * k := by
  classical
  rcases F.eq_empty_or_nonempty with hFE | ⟨de0, hde0⟩
  · simp [hFE]
  have heq0 : (de0.2 : ℤ) ^ k * (v : ℤ) =
      (de0.1 : ℤ) ^ k * (u : ℤ) + 1 := by
    exact_mod_cast hF de0 hde0
  have hcopZ : IsCoprime (v : ℤ) (u : ℤ) :=
    ⟨(de0.2 : ℤ) ^ k, -((de0.1 : ℤ) ^ k), by linear_combination heq0⟩
  have hgcd : Int.gcd (v : ℤ) (u : ℤ) = 1 :=
    Int.isCoprime_iff_gcd_eq_one.mp hcopZ
  have hv0 : (v : ℤ) ≠ 0 := by exact_mod_cast hv.ne'
  have hu0 : (u : ℤ) ≠ 0 := by exact_mod_cast hu.ne'
  have hbound := primitive_diagonal_count hS k hk (v : ℤ) (u : ℤ) 1
    hv0 hu0 hgcd one_ne_zero
  let μ : ℕ × ℕ → ℤ × ℤ := fun de => ((de.2 : ℤ), (de.1 : ℤ))
  have hmaps : Set.MapsTo μ (F : Set (ℕ × ℕ))
      {rs : ℤ × ℤ | Int.gcd rs.1 rs.2 = 1 ∧
        (v : ℤ) * rs.1 ^ k - (u : ℤ) * rs.2 ^ k = 1} := by
    intro de hde
    have hZ : (de.2 : ℤ) ^ k * (v : ℤ) =
        (de.1 : ℤ) ^ k * (u : ℤ) + 1 := by
      exact_mod_cast hF de (Finset.mem_coe.mp hde)
    have hp := unit_shift_primitive_k k (by omega)
      (de.1 : ℤ) (de.2 : ℤ) (u : ℤ) (v : ℤ) 1 (Or.inl rfl)
      (by linear_combination hZ)
    refine ⟨?_, ?_⟩
    · dsimp [μ]
      simpa only [Int.gcd_comm] using hp.1
    · dsimp [μ]
      linear_combination hZ
  have hinj : Set.InjOn μ (F : Set (ℕ × ℕ)) := by
    intro de _ de' _ h
    have h1 : (de.2 : ℤ) = (de'.2 : ℤ) := congrArg Prod.fst h
    have h2 : (de.1 : ℤ) = (de'.1 : ℤ) := congrArg Prod.snd h
    exact Prod.ext (by exact_mod_cast h2) (by exact_mod_cast h1)
  have hcard : F.card ≤ 2800 * k ^ (1 + (1 : ℤ).natAbs.primeFactors.card) := by
    apply ENat.natCast_le_natCast.mp
    rw [← Set.encard_coe_eq_coe_finsetCard]
    exact (Set.encard_le_encard_of_injOn hmaps hinj).trans hbound
  simpa using hcard

theorem axis_count (hS : StewartHyp) (k : ℕ) (hk : 3 ≤ k)
    (p r : ℤ) (hpr : (p,r) ≠ (0,0))
    (T : Finset ((ℕ × ℕ) × (ℕ × ℕ)))
    (hT : ∀ z ∈ T, 1 ≤ z.1.1 ∧ 1 ≤ z.1.2 ∧ 1 ≤ z.2.1 ∧ 1 ≤ z.2.2 ∧
      z.1.2 ^ k * z.2.2 = z.1.1 ^ k * z.2.1 + 1 ∧
      p * (z.2.1 : ℤ) + r * (z.2.2 : ℤ) = 0) :
    T.card ≤ 2800 * k := by
  classical
  rcases T.eq_empty_or_nonempty with hTE | ⟨z0, hz0⟩
  · simp [hTE]
  have hprim (z) (hz : z ∈ T) : Int.gcd (z.2.1 : ℤ) (z.2.2 : ℤ) = 1 := by
    have hZ : (z.1.2 : ℤ) ^ k * (z.2.2 : ℤ) =
        (z.1.1 : ℤ) ^ k * (z.2.1 : ℤ) + 1 := by
      exact_mod_cast (hT z hz).2.2.2.2.1
    exact (unit_shift_primitive_k k (by omega) (z.1.1 : ℤ) (z.1.2 : ℤ)
      (z.2.1 : ℤ) (z.2.2 : ℤ) 1 (Or.inl rfl)
      (by linear_combination hZ)).2
  have hcof (z) (hz : z ∈ T) :
      z.2.1 = z0.2.1 ∧ z.2.2 = z0.2.2 := by
    exact positive_linear_pair_unique p r hpr
      z.2.1 z.2.2 z0.2.1 z0.2.2
      (hT z hz).2.2.1 (hT z hz).2.2.2.1
      (hT z0 hz0).2.2.1 (hT z0 hz0).2.2.2.1
      (hprim z hz) (hprim z0 hz0)
