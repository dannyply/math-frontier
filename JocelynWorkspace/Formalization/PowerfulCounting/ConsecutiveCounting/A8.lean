      |((q.A.mulVec ![(z.2.2:ℤ),(z.2.1:ℤ)]) 0:ℝ)|≤
        sideLength ((M:ℝ)/(4*B*V))
          ((A8HighFPriceCellTuple.rhoK D E M j)^k)
          (4*(2:ℝ)^k*U) q.P 0 ∧
      |((q.A.mulVec ![(z.2.2:ℤ),(z.2.1:ℤ)]) 1:ℝ)|≤
        sideLength ((M:ℝ)/(4*B*V))
          ((A8HighFPriceCellTuple.rhoK D E M j)^k)
          (4*(2:ℝ)^k*U) q.P 1 := by
    intro z hz
    have hn := A8HighFPriceCellTuple.tuple_ellipse_containmentK
