open Polynomial
noncomputable section

theorem integer_pure_height_kernel_data
    (k : ℕ) (hk : 2 ≤ k) (P Q : MvPolynomial (Fin 2) ℤ)
    (hP : P.IsHomogeneous (k+1)) (hQ : Q.IsHomogeneous (k+1))
    (a b c : ℤ) (ell : ℝ) (ha : a≠0) (hb : b≠0) (hc : c≠0) (hell : ell≠0)
    (hno : ∀ w : Fin 2 → ℂ, w≠0 →
      MvPolynomial.eval w (P.map (Int.castRingHom ℂ))=0 →
      MvPolynomial.eval w (Q.map (Int.castRingHom ℂ))=0 → False)
    (hres : MvPolynomial.X (1:Fin 2)^k*P-MvPolynomial.X (0:Fin 2)^k*Q =
      MvPolynomial.C c*(MvPolynomial.C a*MvPolynomial.X (0:Fin 2)+
        MvPolynomial.C b*MvPolynomial.X (1:Fin 2))^(2*k+1)) :
    let S := P.coeff (Finsupp.single (0:Fin 2) (k+1))
    let R := P.coeff (Finsupp.single (0:Fin 2) k+Finsupp.single (1:Fin 2) 1)
    let K0 : ℤ := b*S-a*R+(Nat.choose (2*k) (k-1):ℤ)*c*a^(k+1)*b^(k+1)
    let Pr := P.map (Int.castRingHom ℝ)
    let Qr := Q.map (Int.castRingHom ℝ)
    let D : Polynomial ℝ := C (ell/(a:ℝ))*X
    let E : Polynomial ℝ := C (ell/(b:ℝ))*(1-X)
    let φ := MvPolynomial.eval₂Hom Polynomial.C ![D,E]
    let F : Polynomial ℝ := C (1/((c:ℝ)*ell^(2*k+1)))*(D^k*φ Qr)
    K0≠0 ∧ F.natDegree=2*k+1 ∧
      F.coeff (2*k+1)=(-1:ℝ)^k*((K0:ℝ)/((c:ℝ)*((a:ℝ)*(b:ℝ))^(k+1))) ∧
      (∀ lam : ℝ, F.coeff (2*k+1)=(-1:ℝ)^k*lam →
        lam=(K0:ℝ)/((c:ℝ)*((a:ℝ)*(b:ℝ))^(k+1))) ∧
      (∀ d e u v : ℝ, (a:ℝ)*d+(b:ℝ)*e=ell →
        e^k*v-d^k*u=1 →
        MvPolynomial.eval ![d,e] Pr*u=MvPolynomial.eval ![d,e] Qr*v →
        F.eval ((a:ℝ)*d/ell)=d^k*u) := by
  intro S R K0 Pr Qr D E φ F
  have hPb := homogeneous_binary_support P (k+1) hP
  have hQb := homogeneous_binary_support Q (k+1) hQ
  have hPeval : MvPolynomial.eval ![b,-a] P=b^k*K0 := by
    simpa [S,R,K0,A8OddPureOriginal.binMono] using
      A8OddPureOriginal.pure_P_signed_eval k hk P Q a b c hPb hQb hres
  have hQeval : MvPolynomial.eval ![b,-a] Q=(-1:ℤ)^k*a^k*K0 := by
    simpa [S,R,K0,A8OddPureOriginal.binMono] using
      A8OddPureOriginal.pure_Q_signed_eval k hk P Q a b c hPb hQb hres
  have hPc : MvPolynomial.eval ![(b:ℂ),-(a:ℂ)] (P.map (Int.castRingHom ℂ))=
      ((MvPolynomial.eval ![b,-a] P:ℤ):ℂ) := by
    simpa using eval_int_map (Int.castRingHom ℂ) b (-a) P
  have hQc : MvPolynomial.eval ![(b:ℂ),-(a:ℂ)] (Q.map (Int.castRingHom ℂ))=
      ((MvPolynomial.eval ![b,-a] Q:ℤ):ℂ) := by
    simpa using eval_int_map (Int.castRingHom ℂ) b (-a) Q
  have hK0 : K0≠0 := by
    intro hzero
    apply hno ![(b:ℂ),-(a:ℂ)] _ _ _
    · intro hw
      have hh := congrArg (fun w : Fin 2 → ℂ => w 1) hw
      have haC : (a:ℂ)≠0 := by exact_mod_cast ha
      exact haC (by simpa using hh)
    · rw [hPc,hPeval,hzero]
      simp
    · rw [hQc,hQeval,hzero]
      simp
  have haR : (a:ℝ)≠0 := by exact_mod_cast ha
  have hbR : (b:ℝ)≠0 := by exact_mod_cast hb
  have hcR : (c:ℝ)≠0 := by exact_mod_cast hc
  have hQreal : MvPolynomial.eval ![(b:ℝ),-(a:ℝ)] Qr=
      (-1:ℝ)^k*(a:ℝ)^k*(K0:ℝ) := by
    have hh := eval_int_map (Int.castRingHom ℝ) b (-a) Q
    rw [hQeval] at hh
    simpa [Qr] using hh
  have hrealres : MvPolynomial.X (1:Fin 2)^k*Pr-MvPolynomial.X (0:Fin 2)^k*Qr =
      MvPolynomial.C (c:ℝ)*
        (MvPolynomial.C (a:ℝ)*MvPolynomial.X (0:Fin 2)+
          MvPolynomial.C (b:ℝ)*MvPolynomial.X (1:Fin 2))^(2*k+1) := by
    simpa [Pr,Qr] using congrArg (MvPolynomial.map (Int.castRingHom ℝ)) hres
  have hQhom : Qr.IsHomogeneous (k+1) := hQ.map (Int.castRingHom ℝ)
  have htop := original_height_top_coefficient k Qr hQhom
    (a:ℝ) (b:ℝ) (c:ℝ) ell haR hbR hcR hell
  change F.coeff (2*k+1)=_ at htop
  have hFcoef : F.coeff (2*k+1)=
      (-1:ℝ)^k*((K0:ℝ)/((c:ℝ)*((a:ℝ)*(b:ℝ))^(k+1))) := by
    rw [htop,hQreal]
    field_simp
    <;> ring
  have hFcoeffne : F.coeff (2*k+1)≠0 := by
    rw [hFcoef]
    exact mul_ne_zero (pow_ne_zero k (by norm_num))
      (div_ne_zero (by exact_mod_cast hK0)
        (mul_ne_zero hcR (pow_ne_zero _ (mul_ne_zero haR hbR))))
  have hdegree := (original_height_jets k Pr Qr hQhom
    (a:ℝ) (b:ℝ) (c:ℝ) ell haR hbR hcR hell hrealres).2.2
  refine ⟨hK0,Polynomial.natDegree_eq_of_le_of_coeff_ne_zero hdegree hFcoeffne,
    hFcoef,?_,?_⟩
  · exact normalized_height_lambda k Qr hQhom
      (a:ℝ) (b:ℝ) (c:ℝ) ell (K0:ℝ) haR hbR hcR hell hQreal
  · exact normalized_height_original_value k Pr Qr
      (a:ℝ) (b:ℝ) (c:ℝ) ell haR hbR hcR hell hrealres

end
end A8FloorExt

