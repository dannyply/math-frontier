namespace A7QuarticCore
open A7Inherited
private def jetExp (p : ℕ × ℕ) : Fin 2 →₀ ℕ :=
  Finsupp.equivFunOnFinite.symm ![p.1,p.2]
private def pairWeight (m : ℝ) (p : ℕ × ℕ) : ℝ :=
  m * (p.1 : ℝ) + (p.2 : ℝ)
private theorem jetExp_injective : Function.Injective jetExp := by
  intro p q hp
  apply Prod.ext
  · simpa [jetExp] using congrArg (fun f : Fin 2 →₀ ℕ => f 0) hp
  · simpa [jetExp] using congrArg (fun f : Fin 2 →₀ ℕ => f 1) hp

private theorem pairWeight_nonneg (m : ℝ) (hm : 0 ≤ m) (p : ℕ × ℕ) :
    0 ≤ pairWeight m p := by
  dsimp [pairWeight]
  positivity

private theorem jet_count_from_max (m : ℝ) (hm : 0 < m)
    (s : Finset (ℕ × ℕ)) (w : ℝ) (_hw : 0 ≤ w)
    (hmax : ∀ p ∈ s, pairWeight m p ≤ w) :
    (s.card : ℝ) ≤ (A1WeightedJet.jetCount m (w+1) : ℝ) := by
  classical
  let E : Set (Fin 2 →₀ ℕ) := {e | A1WeightedJet.weight m e < w+1}
  have hE : E.Finite := A1WeightedJet.lowJets_finite m (w+1) hm
  have hsub : s.image jetExp ⊆ hE.toFinset := by
    intro e he
    obtain ⟨p,hp,rfl⟩ := Finset.mem_image.mp he
    apply hE.mem_toFinset.mpr
    change A1WeightedJet.weight m (jetExp p) < w+1
    have hh := hmax p hp
    simpa [A1WeightedJet.weight,jetExp,pairWeight] using
      (lt_of_le_of_lt hh (by linarith : w < w+1))
  have hc : s.card ≤ hE.toFinset.card := by
    have hh := Finset.card_le_card hsub
    simpa only [Finset.card_image_of_injective s jetExp_injective] using hh
  have heq : A1WeightedJet.jetCount m (w+1) = hE.toFinset.card :=
    Set.ncard_eq_toFinset_card E hE
  rw [heq]
  exact_mod_cast hc

private theorem max_weight_lower (m : ℝ) (hm : 0 < m) (hm1 : m ≤ 1)
    (s : Finset (ℕ × ℕ)) (a : ℕ × ℕ) (_ha : a ∈ s)
    (hmax : ∀ p ∈ s, pairWeight m p ≤ pairWeight m a) :
    Real.sqrt (2*m*(s.card : ℝ)) - 5 ≤ pairWeight m a := by
  let w := pairWeight m a
  have hw : 0 ≤ w := pairWeight_nonneg m hm.le a
  have hc := jet_count_from_max m hm s w hw hmax
  have ht := A1FiniteQuantitative.jetTriangleBound m (w+1) hm (by linarith)
  have hpoly :
      (w+1)^2/(2*m)+(1+1/m)*(w+1)+1 ≤ (w+5)^2/(2*m) := by
    have heq : (w+1)^2/(2*m)+(1+1/m)*(w+1)+1 =
        ((w+1)^2+2*(m+1)*(w+1)+2*m)/(2*m) := by
      field_simp [ne_of_gt hm]
    rw [heq]
    gcongr
    nlinarith [mul_le_mul_of_nonneg_right hm1 hw]
  have hcsq : 2*m*(s.card : ℝ) ≤ (w+5)^2 := by
    have hh := hc.trans (ht.trans hpoly)
    have hh' := (le_div_iff₀ (by positivity : 0 < 2*m)).mp hh
    nlinarith
  have hrs := Real.sq_sqrt (by positivity : 0 ≤ 2*m*(s.card : ℝ))
  have hr0 := Real.sqrt_nonneg (2*m*(s.card : ℝ))
  change Real.sqrt (2*m*(s.card : ℝ)) - 5 ≤ w
  by_contra hn
  have hlt : w+5 < Real.sqrt (2*m*(s.card : ℝ)) := by linarith
  nlinarith

private theorem sqrt_cost_step (n : ℕ) (hn : 1 ≤ n) :
    (2/3 : ℝ)*(n : ℝ)*Real.sqrt (n : ℝ) ≤
      (2/3 : ℝ)*((n-1 : ℕ) : ℝ)*Real.sqrt ((n-1 : ℕ) : ℝ)
        + Real.sqrt (n : ℝ) := by
  by_cases hn1 : n = 1
  · subst n
    norm_num
  have hn2 : 2 ≤ n := by omega
  have hnR : (2 : ℝ) ≤ n := by exact_mod_cast hn2
  have hcast : ((n-1 : ℕ) : ℝ) = (n : ℝ)-1 := by
    rw [Nat.cast_sub hn,Nat.cast_one]
  rw [hcast]
  let L : ℝ := (2*(n : ℝ)-3)*Real.sqrt (n : ℝ)
  let R : ℝ := 2*((n : ℝ)-1)*Real.sqrt ((n : ℝ)-1)
  have hL0 : 0 ≤ L := by
    dsimp [L]
    exact mul_nonneg (by linarith) (Real.sqrt_nonneg _)
  have hR0 : 0 ≤ R := by
    dsimp [R]
    exact mul_nonneg (mul_nonneg (by norm_num) (by linarith)) (Real.sqrt_nonneg _)
  have hsq : L^2 ≤ R^2 := by
    dsimp [L,R]
    rw [mul_pow,mul_pow,Real.sq_sqrt (by positivity : 0 ≤ (n : ℝ)),
      Real.sq_sqrt (by linarith : 0 ≤ (n : ℝ)-1)]
    nlinarith
  have hLR : L ≤ R := by
    by_contra h
    have hgt : R < L := lt_of_not_ge h
    nlinarith
  dsimp [L,R] at hLR
  linarith

private theorem finite_jet_weight (m : ℝ) (hm : 0 < m) (hm1 : m ≤ 1)
    (s : Finset (ℕ × ℕ)) :
    (2*Real.sqrt (2*m)/3)*(s.card : ℝ)*Real.sqrt (s.card : ℝ)
      - 5*(s.card : ℝ) ≤ ∑ p ∈ s, pairWeight m p := by
  classical
  have aux : ∀ n : ℕ, ∀ t : Finset (ℕ × ℕ), t.card = n →
      (2*Real.sqrt (2*m)/3)*(n : ℝ)*Real.sqrt (n : ℝ)
        - 5*(n : ℝ) ≤ ∑ p ∈ t, pairWeight m p := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro t ht
      by_cases hn0 : n = 0
      · have ht0 : t = ∅ := Finset.card_eq_zero.mp (ht.trans hn0)
        simp [ht0,hn0]
      have hn : 1 ≤ n := by omega
      have hne : t.Nonempty := Finset.card_pos.mp (by omega)
      obtain ⟨a,ha,hmax⟩ := Finset.exists_max_image t (pairWeight m) hne
      have herase : (t.erase a).card = n-1 := by
        rw [Finset.card_erase_of_mem ha,ht]
      have hrec := ih (n-1) (by omega) (t.erase a) herase
      have hmaxb := max_weight_lower m hm hm1 t a ha hmax
      rw [ht] at hmaxb
      have hstep := sqrt_cost_step n hn
      have hstep' := mul_le_mul_of_nonneg_left hstep (Real.sqrt_nonneg (2*m))
      have hroot :
          Real.sqrt (2*m*(n : ℝ)) =
            Real.sqrt (2*m)*Real.sqrt (n : ℝ) :=
        Real.sqrt_mul (by positivity : 0 ≤ 2*m) (n : ℝ)
      rw [hroot] at hmaxb
      have hcast : ((n-1 : ℕ) : ℝ) = (n : ℝ)-1 := by
        rw [Nat.cast_sub hn,Nat.cast_one]
      rw [hcast] at hrec hstep'
      have hsum := Finset.sum_erase_add t (pairWeight m) ha
      nlinarith
  exact aux s.card s rfl

private theorem injective_jet_weight {I : Type*} [Fintype I] [DecidableEq I]
    (m : ℝ) (hm : 0 < m) (hm1 : m ≤ 1)
    (f : I → ℕ × ℕ) (hf : Function.Injective f) :
    (2*Real.sqrt (2*m)/3)*(Fintype.card I : ℝ)*
      Real.sqrt (Fintype.card I : ℝ)-5*(Fintype.card I : ℝ)
      ≤ ∑ i : I, pairWeight m (f i) := by
  classical
  have hh := finite_jet_weight m hm hm1 (Finset.univ.image f)
  rw [Finset.card_image_of_injective Finset.univ hf,Finset.card_univ] at hh
  rw [Finset.sum_image (fun a _ b _ hab => hf hab)] at hh
  exact hh

private theorem nonzero_rows_injective {I K : Type*}
    [Fintype I] [DecidableEq I]
    (C : K → I → ℝ) (f : I → K)
    (hdet : Matrix.det (fun i j : I => C (f i) j) ≠ 0) :
    Function.Injective f := by
  intro i j hij
  by_contra hne
  apply hdet
  exact Matrix.det_zero_of_row_eq hne (by funext k; rw [hij])

end A7QuarticCore
