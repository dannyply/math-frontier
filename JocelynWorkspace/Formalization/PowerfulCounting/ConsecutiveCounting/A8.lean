  | empty=> simp
  | @cons p t ih=>
      have hp:p ≠ 0:=hs p (by simp)
      have ht:∀ q∈ t,q ≠ 0:=by
        intro q hq
        exact hs q (by simp [hq])
      obtain ⟨ht0,htd⟩:=ih ht
      constructor
      · simpa using aV hp ht0
      · simp only [Multiset.prod_cons,Multiset.map_cons,Multiset.sum_cons]
        rw [u7 hp ht0,htd]
lemma ec (a b:aa (Fin 4) ℤ)
    (ha:a ≠ 0) (hb:b ≠ 0) (hab:a∣ b):
    a.totalDegree≤ b.totalDegree:=by
  obtain ⟨c,rfl⟩:=hab
  have hc:c ≠ 0:=by
    intro hc
    simp [hc] at hb
  rw [u7 ha hc]
  omega
lemma fN (a b:aa (Fin 4) ℤ)
    (ha:a ≠ 0) (hb:b ≠ 0) (hab:Associated a b):
    a.totalDegree=b.totalDegree:=by
  exact le_antisymm (ec a b ha hb hab.dvd)
    (ec b a hb ha hab.symm.dvd)
lemma gn (F:aa (Fin 4) ℤ)
    (hF:F ≠ 0):
    ∃ s:Multiset (aa (Fin 4) ℤ),(∀ p∈ s,Prime p)∧ Associated s.prod F∧ (s.map MvPolynomial.totalDegree).sum=F.totalDegree:=by
  obtain ⟨s,vx,vy⟩:= UniqueFactorizationMonoid.exists_prime_factors F hF
  have hs:∀ p∈ s,p ≠ 0:=by
    intro p hp
    exact (vx p hp).ne_zero
  obtain ⟨hs0,hdeg⟩:=gm s hs
  refine ⟨s,vx,vy,?_⟩
  rw [← hdeg]
