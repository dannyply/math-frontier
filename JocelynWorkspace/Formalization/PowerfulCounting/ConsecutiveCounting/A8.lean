  rw [hr, Finset.mul_sum, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  have hik : i ≤ k - 1 := by have := Finset.mem_range.mp hi; omega
  have hqi : Q.coeff (C01.PcCurves.ex i (k - 1 - i)) =
      (C01.PcCurves.dehom Q).coeff i := by
    rw [C01.PcCurves.dehom_coeff hQ, if_pos hik]
