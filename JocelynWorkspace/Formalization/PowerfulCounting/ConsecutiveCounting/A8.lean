abbrev wG:=aa (Fin 3) ℚ
abbrev wC:=aa (Fin 4) ℚ
def au (k:ℕ):wC→+*wG:= eval₂Hom C ![X 0,X 1,X 1^k-X 2,X 0^k]
def b3 (k:ℕ):wC→+*wG:= eval₂Hom C ![X 0,X 1,X 2,X 0^k]
def flip (k:ℕ):wG→+*wG:= eval₂Hom C ![X 0,X 1,X 1^k-X 2]
lemma jW (k:ℕ):(flip k).comp (au k)=b3 k:=by
  apply bE
  · intro c
    have heq:((flip k).comp (au k)).comp C=(b3 k).comp C:= Subsingleton.elim _ _
    exact congrArg (fun f:ℚ→+*wG=> f c) heq
  · intro i
    fin_cases i<;> simp [flip,au,b3]
def cK (k:ℕ) (m:Fin 4→₀ ℕ):Fin 3→₀ ℕ:= Finsupp.equivFunOnFinite.symm ![m 0+k*m 3,m 1,m 2]
lemma jX (k:ℕ) (m:Fin 4→₀ ℕ) (c:ℚ):
    b3 k (monomial m c)=monomial (cK k m) c:=by
  have hl:b3 k (monomial m c)= C c*X 0^(m 0)*X 1^(m 1)*X 2^(m 2)*(X 0^k)^(m 3):=by
    change eval₂ C ![X 0,X 1,X 2,X 0^k] (monomial m c)=_
    rw [eval₂_monomial]
    simp [bg,Fin.prod_univ_succ,aG]
  have hr:monomial (cK k m) c= C c*X 0^(m 0+k*m 3)*X 1^(m 1)*X 2^(m 2):=by
    rw [monomial_eq]
    simp [bg,Fin.prod_univ_succ,cK,aG]
  rw [hl,hr]
  simp only [pow_add,pow_mul]
  ring
lemma oR (k beta:ℕ) (m r:Fin 4→₀ ℕ)
    (hm:m 2+m 3=beta) (hr:r 2+r 3=beta)
    (h:cK k m=cK k r):m=r:=by
  have h0:=congrArg (fun f:Fin 3→₀ ℕ=> f 0) h
  have h1:=congrArg (fun f:Fin 3→₀ ℕ=> f 1) h
  have h2:=congrArg (fun f:Fin 3→₀ ℕ=> f 2) h
  simp [cK] at h0 h1 h2
  have h3:m 3=r 3:=by omega
  rw [h3] at h0
  ext i
  fin_cases i<;> simp<;> omega
lemma jY (k:ℕ) (g:wC) (beta:ℕ)
    (hg:∀ m∈ g.support,m 2+m 3=beta)
    (m:Fin 4→₀ ℕ) (hm:m∈g.support):
    coeff (cK k m) (b3 k g)=coeff m g:=by
  classical
  conv_lhs=> rw [g.as_sum,map_sum,coeff_sum]
  rw [Finset.sum_eq_single m]
  · simp [jX]
  · intro r hr hrm
    rw [jX,coeff_monomial,if_neg]
    intro heq
    exact hrm (oR k beta r m (hg r hr) (hg m hm) heq)
  · intro hnot
    exact False.elim (hnot hm)
lemma gF (k:ℕ) (g:wC) (alpha beta:ℕ)
    (hg:∀ m∈ g.support,m 0+m 1=alpha∧ m 2+m 3=beta)
    (hg0:g ≠ 0):au k g ≠ 0:=by
  intro hz
  obtain ⟨m,hm⟩:=MvPolynomial.ne_zero_iff.mp hg0
  have heq:=congrArg (fun f:wC→+*wG=> f g) (jW k)
  have hp:b3 k g=0:=by
    change flip k (au k g)=b3 k g at heq
    rw [hz,map_zero] at heq
    exact heq.symm
  have hc:=jY k g beta (fun r hr=>(hg r hr).2)
    m (mem_support_iff.mpr hm)
  rw [hp,coeff_zero] at hc
  exact hm hc.symm
lemma oS (H:wG) (hH0:H ≠ 0) (n:ℕ)
    (hn:(X (0:Fin 3):wG)^n∣ H):n≤ H.totalDegree:=by
  obtain ⟨q,hq⟩:=hn
  have hq0:q ≠ 0:=by intro hz;apply hH0;rw [hq,hz,mul_zero]
  have hx0:(X (0:Fin 3):wG) ≠ 0:=by simp
  have hd:H.totalDegree=n+q.totalDegree:=by
    rw [hq,totalDegree_mul_of_isDomain (u5 n hx0) hq0,totalDegree_X_pow]
  omega
lemma oT (H:wG) (hH0:H ≠ 0):
    ∃ nu:ℕ,∃ H0:wG,H=X 0^nu*H0∧ ¬(X (0:Fin 3):wG)∣H0∧ ∀ n:ℕ,(X (0:Fin 3):wG)^n∣H→ n≤nu:=by
  classical
  let S:=(uP (H.totalDegree+1)).filter
    (fun n=>(X (0:Fin 3):wG)^n∣H)
  have h0:0∈S:=by simp [S]
  have hne:S.Nonempty:=⟨0,h0⟩
  let nu:=S.max' hne
  have hnu:nu∈S:=Finset.max'_mem S hne
  have hn:(X (0:Fin 3):wG)^nu∣H:=(Finset.mem_filter.mp hnu).2
  have hmax:∀ n:ℕ,(X (0:Fin 3):wG)^n∣H→ n≤nu:=by
    intro n hn
    apply Finset.le_max' S n
    exact Finset.mem_filter.mpr
      ⟨Finset.mem_range.mpr (by have hh:=oS H hH0 n hn;omega),hn⟩
  obtain ⟨H0,vg⟩:=hn
  refine ⟨nu,H0,vg,?_,hmax⟩
  rintro ⟨q,hq⟩
  have oU:(X (0:Fin 3):wG)^(nu+1)∣H:=by
    refine ⟨q,?_⟩
    rw [vg,hq,pow_succ]
    ring
  have hh:=hmax (nu+1) oU
  omega
end
