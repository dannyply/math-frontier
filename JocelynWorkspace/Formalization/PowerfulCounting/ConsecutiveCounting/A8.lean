theorem fixed_dyadic_cover (k : ℕ) :
    ∀ U t : ℝ,0<U → U/2<t → t≤(2:ℝ)^k*U →
      ∃ j : ℕ,j≤k ∧ (2:ℝ)^j*U/2<t ∧ t≤(2:ℝ)^j*U := by
  induction k with
  | zero =>
    intro U t hU hlo hup
    exact ⟨0,le_refl 0,by simpa using hlo,by simpa using hup⟩
  | succ k ih =>
    intro U t hU hlo hup
    by_cases ht : t≤U
    · exact ⟨0,Nat.zero_le _,by simpa using hlo,by simpa using ht⟩
    · have hlo' : (2*U)/2<t := by linarith
      have hup' : t≤(2:ℝ)^k*(2*U) := by
        convert hup using 1 <;> rw [pow_succ] <;> ring
      obtain ⟨j,hj,hjlo,hjup⟩ := ih (2*U) t (by positivity) hlo' hup'
      refine ⟨j+1,Nat.succ_le_succ hj,?_,?_⟩
      · convert hjlo using 1 <;> rw [pow_succ] <;> ring
      · convert hjup using 1 <;> rw [pow_succ] <;> ring

theorem original_fixed_cofactor_windows
    (k : ℕ) (x D E d e u v : ℝ)
    (hx : 2≤x) (hD : 0<D) (hE : 0<E)
    (hdlo : D/2<d) (hdhi : d≤D)
    (helo : E/2<e) (hehi : e≤E)
    (hu : 0≤u) (hv : 0≤v)
    (hlo : x/2<d^k*u) (hhi : d^k*u≤x)
    (hshift : e^k*v=d^k*u+1) :
    (∃ j : ℕ,j≤k ∧
      (2:ℝ)^j*(x/D^k)/2<u ∧ u≤(2:ℝ)^j*(x/D^k)) ∧
    (∃ j : ℕ,j≤k+1 ∧
      (2:ℝ)^j*(x/E^k)/2<v ∧ v≤(2:ℝ)^j*(x/E^k)) := by
  have hxpos : 0<x := by linarith
  have hdpos : 0<d := by linarith
  have hepos : 0<e := by linarith
  have hDp : 0<D^k := pow_pos hD k
  have hEp : 0<E^k := pow_pos hE k
  have hpowD := pow_le_pow_left₀ hdpos.le hdhi k
  have hpowE := pow_le_pow_left₀ hepos.le hehi k
  have hlou : (x/D^k)/2<u := by
    have hn : x/2<D^k*u :=
      hlo.trans_le (mul_le_mul_of_nonneg_right hpowD hu)
    have heq : (x/D^k)/2=(x/2)/D^k := by ring
    rw [heq]
    exact (div_lt_iff₀ hDp).mpr (by nlinarith only [hn])
  have hlov : (x/E^k)/2<v := by
    have hn : x/2<E^k*v := by
      have hm := mul_le_mul_of_nonneg_right hpowE hv
      nlinarith only [hlo,hshift,hm]
    have heq : (x/E^k)/2=(x/2)/E^k := by ring
    rw [heq]
    exact (div_lt_iff₀ hEp).mpr (by nlinarith only [hn])
  have hDscale : D≤2*d := by linarith
  have hEscale : E≤2*e := by linarith
  have huppU : u≤(2:ℝ)^k*(x/D^k) := by
    rw [←mul_div_assoc]
    apply (le_div_iff₀ hDp).mpr
    calc
      u*D^k≤u*(2*d)^k := mul_le_mul_of_nonneg_left
        (pow_le_pow_left₀ hD.le hDscale k) hu
      _=(2:ℝ)^k*(d^k*u) := by rw [mul_pow];ring
      _≤(2:ℝ)^k*x := mul_le_mul_of_nonneg_left hhi (by positivity)
  have huppV : v≤(2:ℝ)^(k+1)*(x/E^k) := by
    rw [←mul_div_assoc]
    apply (le_div_iff₀ hEp).mpr
    calc
      v*E^k≤v*(2*e)^k := mul_le_mul_of_nonneg_left
        (pow_le_pow_left₀ hE.le hEscale k) hv
      _=(2:ℝ)^k*(e^k*v) := by rw [mul_pow];ring
      _=(2:ℝ)^k*(d^k*u+1) := by rw [hshift]
      _≤(2:ℝ)^k*(2*x) := mul_le_mul_of_nonneg_left (by linarith) (by positivity)
      _=(2:ℝ)^(k+1)*x := by rw [pow_succ];ring
  exact ⟨fixed_dyadic_cover k (x/D^k) u (div_pos hxpos hDp) hlou huppU,
    fixed_dyadic_cover (k+1) (x/E^k) v (div_pos hxpos hEp) hlov huppV⟩

end
