      · exact (mem_vals.mp h).1
    obtain ⟨h1', h2'⟩ := Finset.mem_Icc.mp hnI
    exact ⟨h1', (Nat.cast_le.mpr h2').trans (Nat.floor_le (by linarith))⟩
  have hcard : ((vals (-P) x ∪ vals (P - Polynomial.C 1) x).card : ℝ) ≤
