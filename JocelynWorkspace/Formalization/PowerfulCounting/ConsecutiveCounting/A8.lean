theorem le_of_log_le_add {A C e x : ℝ} (hA : 0 < A) (hC : 0 < C) (hx : 0 < x)
    (h : Real.log A ≤ Real.log C + e * Real.log x) : A ≤ C * x ^ e := by
  have hxe : 0 < x ^ e := by positivity
  have hB : 0 < C * x ^ e := mul_pos hC hxe
  rw [← Real.log_le_log_iff hA hB, Real.log_mul hC.ne' hxe.ne', Real.log_rpow hx]
  exact h

theorem log_mul3 {a b c : ℝ} (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) :
    Real.log (a * b * c) = Real.log a + Real.log b + Real.log c := by
  rw [Real.log_mul (mul_pos ha hb).ne' hc.ne', Real.log_mul ha.ne' hb.ne']

theorem log_div_pow {x D : ℝ} (k : ℕ) (hx : 0 < x) (hD : 0 < D) :
    Real.log (x / D ^ k) = Real.log x - (k : ℝ) * Real.log D := by
  rw [Real.log_div hx.ne' (pow_pos hD k).ne', Real.log_pow]

theorem mul_div_eq {a b c d : ℝ} (hc : c ≠ 0) (h : a * b = d * c) : a * (b / c) = d := by
  rw [mul_div_assoc', div_eq_iff hc]; exact h

theorem zk_alg (K lM L s m δ1 θ l2 c : ℝ) (hK : 5 ≤ K) (hL : 0 < L) (hl2 : 0 ≤ l2)
    (hlM : lM ≤ l2 + (m + δ1) * L) (hZ : (1 + m) / K - s / (2 * K + 1) + c ≤ θ)
    (hc : 0 ≤ c) (hδ1 : 0 ≤ δ1) :
    lM + (1 / K * L + -((K - 1) / K) * lM + -(1 / (2 * K + 1)) * (s * L)) ≤
      l2 + (θ + δ1) * L := by
  have hK0 : K ≠ 0 := by intro h; rw [h] at hK; norm_num at hK
  have h2K : 2 * K + 1 ≠ 0 := by intro h; linarith
  have e1 : lM + (1 / K * L + -((K - 1) / K) * lM + -(1 / (2 * K + 1)) * (s * L)) =
      (lM - m * L) / K + L * ((1 + m) / K - s / (2 * K + 1)) := by
    field_simp
    ring
  rw [e1]
  have h1 : (lM - m * L) / K ≤ l2 + δ1 * L := by
    rw [div_le_iff₀ (by linarith)]
    have h0 : 0 ≤ l2 + δ1 * L := add_nonneg hl2 (mul_nonneg hδ1 hL.le)
    have : 0 ≤ (l2 + δ1 * L) * (K - 1) := mul_nonneg h0 (by linarith)
    nlinarith
  have h2 : L * ((1 + m) / K - s / (2 * K + 1)) ≤ L * θ :=
    mul_le_mul_of_nonneg_left (by linarith) hL.le
  linarith

theorem alg_bal2 (K lM lRD lRU L l2 l3 m δ1 θ s : ℝ) (hK : 0 < K) (hL : 0 < L)
    (hl2 : 0 ≤ l2) (hl3 : 0 ≤ l3)
    (hlMhi : lM ≤ l2 + (m + δ1) * L) (hlRD : lRD ≤ l3 + s * L)
    (hRU : lRU ≤ l3 + 2 * L - K * (s * L))
    (hJ : 2 + (3 * K + 2) * m ≤ θ * (4 * K + 3)) (hmθ : m ≤ θ) (hδ : 0 ≤ δ1) :
    (3 * K + 3) * lM + K * lRD + lRU ≤ (4 * K + 4) * (l2 + l3 + (θ + δ1) * L) := by
  have pM := mul_le_mul_of_nonneg_left hlMhi (by linarith : (0 : ℝ) ≤ 3 * K + 3)
  have pRD := mul_le_mul_of_nonneg_left hlRD hK.le
  have pK2 := mul_nonneg hK.le hl2
  have pK3 := mul_nonneg hK.le hl3
  have hKδ := mul_nonneg hK.le hδ
  have key : 0 ≤ ((4 * K + 4) * (θ + δ1) - (3 * K + 3) * (m + δ1) - 2) * L :=
    mul_nonneg (by linarith) hL.le
  linarith

