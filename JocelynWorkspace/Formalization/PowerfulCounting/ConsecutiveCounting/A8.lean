  have hik : i ≠ k := by omega
  have hi0 : i ≠ 0 := by omega
  change (C u * X ^ k + C h).coeff i = 0
  rw [Polynomial.coeff_add, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow,
    Polynomial.coeff_C]
  simp [hik, hi0, ]

private theorem unitMonomial_primitive (p k : ℕ) [Fact p.Prime]
    (hk : 0 < k) (u h : ℤ) (hh : h = 1 ∨ h = -1) :
    Polynomial.map (Int.castRingHom (ZMod p)) (unitMonomial k u h) ≠ 0 := by
  intro hz
  have hc := congrArg (fun F : Polynomial (ZMod p) => F.coeff 0) hz
  have h0k : (0 : ℕ) ≠ k := by omega
  rcases hh with rfl | rfl <;>
    simp [unitMonomial,  h0k] at hc

private theorem certificate_forces_step (N k J : ℕ) (hk : 0 < k)
    (u h r : ℤ) (hh : h = 1 ∨ h = -1)
    (hcert : C (N : ℤ) ∣
      (unitMonomial k u h).comp (progressionAffine (r, J))) :
    N ∣ J * k := by
  have h0 : (N : ℤ) ∣ u * r ^ k + h := by
    obtain ⟨G, hG⟩ := hcert
    refine ⟨G.eval 0, ?_⟩
    have hv := congrArg (fun P : Polynomial ℤ => P.eval 0) hG
    simpa [unitMonomial, progressionAffine] using hv
  have hval :
      ((unitMonomial k u h).comp (progressionAffine (r, J))).derivative.eval 0 =
        (J : ℤ) * (k : ℤ) * u * r ^ (k - 1) := by
    simp [unitMonomial, progressionAffine, 
      Polynomial.derivative_pow] ; ring
  have h1 : (N : ℤ) ∣ (J : ℤ) * (k : ℤ) * u * r ^ (k - 1) := by
    obtain ⟨G, hG⟩ := hcert
    refine ⟨G.derivative.eval 0, ?_⟩
    rw [← hval, hG]
    simp
  have hpow : r * r ^ (k - 1) = r ^ k := by
    rw [← pow_succ']
    congr 1
    omega
  have hid :
      (J : ℤ) * (k : ℤ) * (u * r ^ k + h) -
        r * ((J : ℤ) * (k : ℤ) * u * r ^ (k - 1)) =
          (J : ℤ) * (k : ℤ) * h := by
    calc
      _ = (J : ℤ) * (k : ℤ) * u * (r ^ k - r * r ^ (k - 1)) +
          (J : ℤ) * (k : ℤ) * h := by ring
      _ = _ := by rw [hpow]; ring
  have hd : (N : ℤ) ∣ (J : ℤ) * (k : ℤ) * h := by
    rw [← hid]
    exact dvd_sub (dvd_mul_of_dvd_right h0 _) (dvd_mul_of_dvd_right h1 _)
  have hJK : (N : ℤ) ∣ (J : ℤ) * (k : ℤ) := by
    rcases hh with rfl | rfl <;> simpa using hd
  exact_mod_cast hJK

private theorem global_unit_cover (N k : ℕ) (hN : 0 < N) (hk : 0 < k)
    (u h : ℤ) (hh : h = 1 ∨ h = -1) :
    ∃ S : Finset (ℤ × ℕ), S.card ≤ k ^ N.primeFactors.card ∧
      (∀ s ∈ S, 0 < s.2 ∧ N ∣ s.2 * k) ∧
      (∀ r : ℤ, (N : ℤ) ∣ u * r ^ k + h →
        ∃ s ∈ S, onProgression s r) := by
  let F := unitMonomial k u h
  have hlocal : ∀ p ∈ N.primeFactors, ∃ A : Finset (ℤ × ℕ),
      A.card ≤ k ∧
      (∀ s ∈ A, 0 < s.2 ∧
        C ((p : ℤ) ^ N.factorization p) ∣ F.comp (progressionAffine s)) ∧
      (∀ r : ℤ, (p : ℤ) ^ N.factorization p ∣ F.eval r →
        ∃ s ∈ A, onProgression s r) := by
    intro p hp
    have hpp : p.Prime := Nat.prime_of_mem_primeFactors hp
    let : Fact p.Prime := ⟨hpp⟩
    have hA : 0 < N.factorization p :=
      hpp.factorization_pos_of_dvd hN.ne' (Nat.dvd_of_mem_primeFactors hp)
    obtain ⟨T, hTc, hTg, hTv⟩ :=
      primitive_cover p (N.factorization p) hA F
        (unitMonomial_primitive p k hk u h hh)
    let step : (ℤ × ℕ) → (ℤ × ℕ) := fun s => (s.1, p ^ s.2)
    refine ⟨T.image step, Finset.card_image_le.trans
      (hTc.trans ((Polynomial.natDegree_map_le).trans (unitMonomial_degree k u h))), ?_, ?_⟩
    · intro s hs
      obtain ⟨b, hb, rfl⟩ := Finset.mem_image.mp hs
      refine ⟨pow_pos hpp.pos _, ?_⟩
      simpa [step, progressionAffine, classAffine] using (hTg b hb).2
    · intro r hr
      obtain ⟨s, hs, t, ht⟩ := hTv r hr
      refine ⟨step s, Finset.mem_image.mpr ⟨s, hs, rfl⟩, t, ?_⟩
      simpa [step] using ht
  obtain ⟨S, hSc, hSg, hSv⟩ :=
    glue_general k N.factorization F N.primeFactors hlocal
  have hcert : ∀ s ∈ S, C (N : ℤ) ∣ F.comp (progressionAffine s) := by
    intro s hs
    apply (Polynomial.C_dvd_iff_dvd_coeff _ _).mpr
    intro j
    apply int_dvd_prime_powers N hN.ne'
    intro p hp
    exact (Polynomial.C_dvd_iff_dvd_coeff _ _).mp ((hSg s hs).2 p hp) j
  refine ⟨S, hSc, ?_, ?_⟩
  · intro s hs
    exact ⟨(hSg s hs).1, certificate_forces_step N k s.2 hk u h s.1 hh (hcert s hs)⟩
  · intro r hr
    apply hSv r
    intro p hp
    have hpn : p ^ N.factorization p ∣ N :=
      (Nat.Prime.pow_dvd_iff_le_factorization (Nat.prime_of_mem_primeFactors hp) hN.ne').mpr le_rfl
    have hpi : (p : ℤ) ^ N.factorization p ∣ (N : ℤ) := by exact_mod_cast hpn
    exact hpi.trans (by simpa [F, unitMonomial] using hr)

private theorem progression_upper (s : ℤ × ℕ) (hJ : 0 < s.2)
    (D : ℝ) (hD : 0 ≤ D) :
    (((Finset.Icc 1 ⌊D⌋₊).filter
      (fun d : ℕ => onProgression s (d : ℤ))).card : ℝ) ≤
        D / (s.2 : ℝ) + 1 := by
  let r : ℕ := (s.1 % (s.2 : ℤ)).toNat
  have hJZ : (0 : ℤ) < (s.2 : ℤ) := by exact_mod_cast hJ
  have hr0 : 0 ≤ s.1 % (s.2 : ℤ) := Int.emod_nonneg _ hJZ.ne'
  have hrr : (r : ℤ) = s.1 % (s.2 : ℤ) := Int.toNat_of_nonneg hr0
  have hr : r < s.2 := by
    have := Int.emod_lt_of_pos s.1 hJZ
    omega
  have hm : ∀ d : ℕ, onProgression s (d : ℤ) → d % s.2 = r := by
    intro d hd
    obtain ⟨t, ht⟩ := hd
    have hi : (d : ℤ) % (s.2 : ℤ) = (r : ℤ) := by
      rw [ht, hrr]
      simp [Int.add_emod]
    exact_mod_cast hi
  have hs :
      ((Finset.Icc 1 ⌊D⌋₊).filter (fun d : ℕ => onProgression s (d : ℤ))) ⊆
      ((Finset.Icc 1 ⌊D⌋₊).filter (fun d : ℕ => d % s.2 = r)) := by
    intro d hd
    exact Finset.mem_filter.mpr ⟨(Finset.mem_filter.mp hd).1,
      hm d (Finset.mem_filter.mp hd).2⟩
  have hb := (abs_le.mp
    (FormalAB.Sb23c796c.ConsecutiveCountingA5CRT.residue_interval_discrepancy
      D hD s.2 r hJ hr)).2
  have hcount :
      (((Finset.Icc 1 ⌊D⌋₊).filter (fun d : ℕ => onProgression s (d : ℤ))).card : ℝ) ≤
        (((Finset.Icc 1 ⌊D⌋₊).filter (fun d : ℕ => d % s.2 = r)).card : ℝ) := by
    exact_mod_cast Finset.card_le_card hs
  exact hcount.trans (by linarith)

private def roots (N k : ℕ) (u h : ℤ) (D : ℝ) : Finset ℕ :=
  (Finset.Icc 1 ⌊D⌋₊).filter (fun d => (N : ℤ) ∣ u * (d : ℤ) ^ k + h)

private theorem roots_upper (N k : ℕ) (hN : 0 < N) (hk : 0 < k)
    (u h : ℤ) (hh : h = 1 ∨ h = -1) (D : ℝ) (hD : 0 < D) :
    ((roots N k u h D).card : ℝ) ≤
      (k : ℝ) ^ N.primeFactors.card * ((k : ℝ) * D / (N : ℝ) + 1) := by
  obtain ⟨S, hSc, hSg, hSv⟩ := global_unit_cover N k hN hk u h hh
  let A := fun s : ℤ × ℕ =>
    (Finset.Icc 1 ⌊D⌋₊).filter (fun d : ℕ => onProgression s (d : ℤ))
  have hsub : roots N k u h D ⊆ S.biUnion A := by
    intro d hd
    obtain ⟨s, hs, hds⟩ := hSv d (Finset.mem_filter.mp hd).2
    exact Finset.mem_biUnion.mpr ⟨s, hs,
      Finset.mem_filter.mpr ⟨(Finset.mem_filter.mp hd).1, hds⟩⟩
  have hcard : (roots N k u h D).card ≤ ∑ s ∈ S, (A s).card :=
    (Finset.card_le_card hsub).trans Finset.card_biUnion_le
  have hterm : ∀ s ∈ S, ((A s).card : ℝ) ≤ (k : ℝ) * D / (N : ℝ) + 1 := by
    intro s hs
    have hJ := (hSg s hs).1
    have hpos : 0 < s.2 * k := Nat.mul_pos hJ hk
    have hNJK : (N : ℝ) ≤ (s.2 : ℝ) * (k : ℝ) := by
      exact_mod_cast (Nat.le_of_dvd hpos (hSg s hs).2)
    have hquot : D / (s.2 : ℝ) ≤ (k : ℝ) * D / (N : ℝ) := by
      apply (div_le_div_iff₀ (by exact_mod_cast hJ) (by exact_mod_cast hN)).mpr
      nlinarith [mul_le_mul_of_nonneg_left hNJK hD.le]
    exact (progression_upper s hJ D hD.le).trans (by linarith)
  calc
    ((roots N k u h D).card : ℝ) ≤ ∑ s ∈ S, ((A s).card : ℝ) := by exact_mod_cast hcard
    _ ≤ ∑ _s ∈ S, ((k : ℝ) * D / (N : ℝ) + 1) := Finset.sum_le_sum hterm
    _ = (S.card : ℝ) * ((k : ℝ) * D / (N : ℝ) + 1) := by simp ; ring
    _ ≤ (k : ℝ) ^ N.primeFactors.card * ((k : ℝ) * D / (N : ℝ) + 1) := by
      apply mul_le_mul_of_nonneg_right
      · exact_mod_cast hSc
      · positivity

private theorem prime_weight_subpower (k : ℕ) (hk : 1 ≤ k)
    (epsilon : ℝ) (heps : 0 < epsilon) :
    ∃ W : ℝ, 0 < W ∧ ∀ n : ℕ, 0 < n →
      (k : ℝ) ^ n.primeFactors.card ≤ W * (n : ℝ) ^ epsilon := by
  have hkR : (1 : ℝ) ≤ k := by exact_mod_cast hk
  have hk0 : (0 : ℝ) < k := by linarith
  let P : ℕ := ⌈(k : ℝ) ^ (1 / epsilon)⌉₊
  refine ⟨(k : ℝ) ^ P, by positivity, ?_⟩
  intro n hn
  have hb := FormalAB.Sb23c796c.JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C08.PcPell.prod_primeFactors_le_rpow
    n hn.ne' epsilon heps (fun _ _ => (k : ℝ)) (k : ℝ) hkR P
  have hsmall : ∀ p a : ℕ, p.Prime → 1 ≤ a →
      (k : ℝ) ≤ (k : ℝ) * ((p : ℝ) ^ a) ^ epsilon := by
    intro p a hp ha
    have hpa : (1 : ℝ) ≤ (p : ℝ) ^ a :=
      one_le_pow₀ (by exact_mod_cast hp.one_lt.le)
    have hx := Real.one_le_rpow hpa heps.le
    nlinarith
  have hlarge : ∀ p a : ℕ, p.Prime → 1 ≤ a → P ≤ p →
      (k : ℝ) ≤ ((p : ℝ) ^ a) ^ epsilon := by
    intro p a hp ha hP
    have hbase : (k : ℝ) ^ (1 / epsilon) ≤ (p : ℝ) :=
      (Nat.le_ceil _).trans (by exact_mod_cast hP)
    have hbpow := Real.rpow_le_rpow (by positivity) hbase heps.le
    have hid : ((k : ℝ) ^ (1 / epsilon)) ^ epsilon = k := by
      rw [← Real.rpow_mul hk0.le, one_div, inv_mul_cancel₀ heps.ne', Real.rpow_one]
    rw [hid] at hbpow
    have hppow : (p : ℝ) ≤ (p : ℝ) ^ a :=
      le_self_pow₀ (by exact_mod_cast hp.one_lt.le) (by omega)
    exact hbpow.trans (Real.rpow_le_rpow (by positivity) hppow heps.le)
  have hout := hb (fun _ _ => hk0.le) hsmall hlarge
  simpa only [Finset.prod_const] using hout

private theorem primeFactors_power (e k : ℕ) (he : 0 < e) (hk : 0 < k) :
    (e ^ k).primeFactors = e.primeFactors := by
  ext p
  constructor
  · intro hp
    obtain ⟨hpp, hpe, _⟩ := Nat.mem_primeFactors.mp hp
    exact Nat.mem_primeFactors.mpr ⟨hpp, hpp.dvd_of_dvd_pow hpe, he.ne'⟩
  · intro hp
    obtain ⟨hpp, hpe, _⟩ := Nat.mem_primeFactors.mp hp
    exact Nat.mem_primeFactors.mpr
      ⟨hpp, hpe.trans (dvd_pow_self e hk.ne'), pow_ne_zero _ he.ne'⟩

private def population (k : ℕ) (h : ℤ) (x D E : ℝ) :
    Set ((ℕ × ℕ) × (ℕ × ℕ)) := {q |
  1 ≤ q.1.1 ∧ 1 ≤ q.1.2 ∧ 1 ≤ q.2.1 ∧ 1 ≤ q.2.2 ∧
  D / 2 < (q.1.1 : ℝ) ∧ (q.1.1 : ℝ) ≤ D ∧
  E / 2 < (q.1.2 : ℝ) ∧ (q.1.2 : ℝ) ≤ E ∧
  ((q.1.1 ^ k * q.2.1 : ℕ) : ℝ) ≤ x ∧
  ((q.1.2 ^ k * q.2.2 : ℕ) : ℤ) =
    ((q.1.1 ^ k * q.2.1 : ℕ) : ℤ) + h}

private theorem positive_power_bounds (d u k : ℕ)
    (hd : 1 ≤ d) (hu : 1 ≤ u) (hk : 0 < k) :
    d ≤ d ^ k * u ∧ u ≤ d ^ k * u := by
  have hpow0 : 1 ≤ d ^ (k - 1) := one_le_pow₀ hd
  have hpow : d * d ^ (k - 1) = d ^ k := by
    rw [← pow_succ']
    congr 1
    omega
  have hdk : d ≤ d ^ k := by nlinarith
  have hdk1 : 1 ≤ d ^ k := one_le_pow₀ hd
  constructor <;> nlinarith

private theorem point_bounds (k : ℕ) (hk : 0 < k) (h : ℤ)
    (hh : h = 1 ∨ h = -1) (x D E : ℝ) (_hx : 2 ≤ x)
    (q : (ℕ × ℕ) × (ℕ × ℕ)) (hq : q ∈ population k h x D E) :
    (q.1.1 : ℝ) ≤ x ∧ (q.2.1 : ℝ) ≤ x ∧
    (q.1.2 : ℝ) ≤ x + 1 ∧ (q.2.2 : ℝ) ≤ x + 1 ∧
    ((q.1.2 ^ k * q.2.2 : ℕ) : ℝ) ≤ x + 1 := by
  rcases hq with ⟨hd, he, hu, hv, hDl, hDu, hEl, hEu, hn, heq⟩
  have hdb := positive_power_bounds q.1.1 q.2.1 k hd hu hk
  have heb := positive_power_bounds q.1.2 q.2.2 k he hv hk
  have hhr : (h : ℝ) ≤ 1 := by rcases hh with rfl | rfl <;> norm_num
  have heqR :
      ((q.1.2 ^ k * q.2.2 : ℕ) : ℝ) =
        ((q.1.1 ^ k * q.2.1 : ℕ) : ℝ) + (h : ℝ) := by exact_mod_cast heq
  have hright : ((q.1.2 ^ k * q.2.2 : ℕ) : ℝ) ≤ x + 1 := by linarith
  have hdR : (q.1.1 : ℝ) ≤ ((q.1.1 ^ k * q.2.1 : ℕ) : ℝ) := by exact_mod_cast hdb.1
  have huR : (q.2.1 : ℝ) ≤ ((q.1.1 ^ k * q.2.1 : ℕ) : ℝ) := by exact_mod_cast hdb.2
  have heR : (q.1.2 : ℝ) ≤ ((q.1.2 ^ k * q.2.2 : ℕ) : ℝ) := by exact_mod_cast heb.1
  have hvR : (q.2.2 : ℝ) ≤ ((q.1.2 ^ k * q.2.2 : ℕ) : ℝ) := by exact_mod_cast heb.2
  exact ⟨hdR.trans hn, huR.trans hn, heR.trans hright, hvR.trans hright, hright⟩

private theorem population_finite (k : ℕ) (hk : 0 < k) (h : ℤ)
    (hh : h = 1 ∨ h = -1) (x D E : ℝ) (hx : 2 ≤ x) :
    (population k h x D E).Finite := by
  let A := Finset.Icc 1 ⌊x + 1⌋₊
  let B := (A.product A).product (A.product A)
  apply B.finite_toSet.subset
  intro q hq
  have hb := point_bounds k hk h hh x D E hx q hq
  rcases hq with ⟨hd, he, hu, hv, _⟩
  exact Finset.mem_coe.mpr (Finset.mem_product.mpr
    ⟨Finset.mem_product.mpr
      ⟨Finset.mem_Icc.mpr ⟨hd, Nat.le_floor (by linarith [hb.1])⟩,
       Finset.mem_Icc.mpr ⟨he, Nat.le_floor hb.2.2.1⟩⟩,
     Finset.mem_product.mpr
      ⟨Finset.mem_Icc.mpr ⟨hu, Nat.le_floor (by linarith [hb.2.1])⟩,
       Finset.mem_Icc.mpr ⟨hv, Nat.le_floor hb.2.2.2.1⟩⟩⟩)

private theorem cofactor_upper (k : ℕ) (D x : ℝ) (hD : 0 < D)
    (d u : ℕ) (hd : D / 2 < (d : ℝ))
    (hx : ((d ^ k * u : ℕ) : ℝ) ≤ x) :
    (u : ℝ) ≤ (2 : ℝ) ^ k * x / D ^ k := by
  have hDle : D ≤ 2 * (d : ℝ) := by linarith
  have hp := pow_le_pow_left₀ hD.le hDle k
  have hmul : (u : ℝ) * D ^ k ≤ (2 : ℝ) ^ k * x := by
    calc
      _ ≤ (u : ℝ) * (2 * (d : ℝ)) ^ k :=
        mul_le_mul_of_nonneg_left hp (Nat.cast_nonneg _)
      _ = (2 : ℝ) ^ k * ((d : ℝ) ^ k * (u : ℝ)) := by rw [mul_pow]; ring
      _ ≤ (2 : ℝ) ^ k * x := by exact mul_le_mul_of_nonneg_left (by exact_mod_cast hx) (by positivity)
  exact (le_div_iff₀ (pow_pos hD _)).mpr hmul

private theorem fiber_injective (k : ℕ) (h : ℤ) (x D E : ℝ)
    (q r : (ℕ × ℕ) × (ℕ × ℕ))
    (hq : q ∈ population k h x D E) (hr : r ∈ population k h x D E)
    (heu : (q.1.2, q.2.1) = (r.1.2, r.2.1))
    (hd : q.1.1 = r.1.1) : q = r := by
  rcases q with ⟨⟨d, e⟩, ⟨u, v⟩⟩
  rcases r with ⟨⟨d', e'⟩, ⟨u', v'⟩⟩
  simp only [Prod.mk.injEq] at heu
  dsimp only at hd
  obtain rfl := hd
  obtain ⟨rfl, rfl⟩ := heu
  dsimp only [population] at hq hr
  rcases hq with ⟨hd, he, hu, hv, hDl, hDu, hEl, hEu, hn, heq⟩
  rcases hr with ⟨hd', he', hu', hv', hDl', hDu', hEl', hEu', hn', heq'⟩
  change 1 ≤ e at he
  have he0 : e ≠ 0 := by omega
  have hmul : e ^ k * v = e ^ k * v' := by
    exact_mod_cast (show ((e ^ k * v : ℕ) : ℤ) =
      ((e ^ k * v' : ℕ) : ℤ) by linarith [heq, heq'])
  have hvv : v = v' := mul_left_cancel₀ (pow_ne_zero _ he0) hmul
  subst v'
  rfl

private theorem scale_algebra (k : ℕ) (hk : 0 < k) (x D E : ℝ)
    (hD : 0 < D) (hE : 0 < E) :
    E * ((2 : ℝ) ^ k * x / D ^ k) *
      ((k : ℝ) * D * (2 : ℝ) ^ k / E ^ k + 1) =
      ((k : ℝ) * (2 : ℝ) ^ k * (2 : ℝ) ^ k) *
        (x / (D * E) ^ (k - 1)) +
      (2 : ℝ) ^ k * (E * (x / D ^ k)) := by
  have hDk : D ^ k = D ^ (k - 1) * D := by
    rw [← pow_succ]
    congr 1
    omega
  have hEk : E ^ k = E ^ (k - 1) * E := by
    rw [← pow_succ]
    congr 1
    omega
  rw [hDk, hEk, mul_pow]
  field_simp [hD.ne', hE.ne']


private theorem one_sided (k : ℕ) (hk : 2 ≤ k) (epsilon : ℝ) (heps : 0 < epsilon) :
    ∃ C : ℝ, 0 < C ∧ ∀ x : ℝ, 2 ≤ x →
      ∀ D E : ℝ, 0 < D → 0 < E → ∀ h : ℤ, (h = 1 ∨ h = -1) →
        (population k h x D E).Finite ∧
        ((population k h x D E).ncard : ℝ) ≤
          C * x ^ epsilon *
            (x / (D * E) ^ (k - 1) + E * (x / D ^ k)) := by
  have hk0 : 0 < k := by omega
  obtain ⟨W, hW, hweight⟩ := prime_weight_subpower k (by omega) epsilon heps
  let A : ℝ := W * (3 / 2 : ℝ) ^ epsilon
  let B : ℝ := (k : ℝ) * (2 : ℝ) ^ k * (2 : ℝ) ^ k + (2 : ℝ) ^ k + 1
  have hA : 0 < A := by dsimp [A]; positivity
  have hB : 0 < B := by dsimp [B]; positivity
  refine ⟨A * B, mul_pos hA hB, ?_⟩
  intro x hx D E hD hE h hh
  have hx0 : 0 < x := by linarith
  have hfinite := population_finite k hk0 h hh x D E hx
  refine ⟨hfinite, ?_⟩
  let S := hfinite.toFinset
  let Ucap : ℝ := (2 : ℝ) ^ k * x / D ^ k
  let P : Finset (ℕ × ℕ) :=
    (Finset.Icc 1 ⌊E⌋₊).product (Finset.Icc 1 ⌊Ucap⌋₊)
