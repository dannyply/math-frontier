namespace A5NongeometricElimination
open Polynomial

private theorem primitive_of_irreducible_pos (P : Polynomial (Polynomial ℚ))
    (hP : Irreducible P) (hpos : 1 ≤ P.natDegree) : P.IsPrimitive := by
  apply Polynomial.isPrimitive_iff_isUnit_of_C_dvd.mpr
  intro r hr
  obtain ⟨q, hq⟩ := hr
  rcases hP.isUnit_or_isUnit hq with hu | hu
  · obtain ⟨a, ha, he⟩ := Polynomial.isUnit_iff.mp hu
    have har : a = r := Polynomial.C_injective he
    simpa [har] using ha
  · have hqdeg : q.natDegree = 0 := Polynomial.natDegree_eq_zero_of_isUnit hu
    have hdeg : P.natDegree ≤ 0 := by
      rw [hq]
      calc
        (Polynomial.C r * q).natDegree ≤ (Polynomial.C r).natDegree + q.natDegree :=
          Polynomial.natDegree_mul_le
        _ = 0 := by rw [Polynomial.natDegree_C, hqdeg]
    omega

private theorem matrix_natDegree_bound {n : Type*} [Fintype n] [DecidableEq n]
    (D : ℕ) (M : Matrix n n (Polynomial ℚ))
    (hM : ∀ i j, (M i j).natDegree ≤ D) :
    M.det.natDegree ≤ Fintype.card n * D := by
  classical
  apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
  intro k hk
  rw [Matrix.det_apply, Polynomial.finsetSum_coeff]
  apply Finset.sum_eq_zero
  intro σ hσ
  apply Polynomial.coeff_eq_zero_of_natDegree_lt
  apply lt_of_le_of_lt ?_ hk
  calc
    (Equiv.Perm.sign σ • ∏ i, M (σ i) i).natDegree ≤ (∏ i, M (σ i) i).natDegree :=
      Polynomial.natDegree_smul_le _ _
    _ ≤ ∑ i, (M (σ i) i).natDegree := Polynomial.natDegree_prod_le _ _
    _ ≤ ∑ _i : n, D := Finset.sum_le_sum (fun i hi => hM _ _)
    _ = Fintype.card n * D := by simp

private theorem sylvester_degree_bound (P Q : Polynomial (Polynomial ℚ))
    (D m n : ℕ) (hP : ∀ j, (P.coeff j).natDegree ≤ D)
    (hQ : ∀ j, (Q.coeff j).natDegree ≤ D) :
    ∀ i j, ((P.sylvester Q m n) i j).natDegree ≤ D := by
  intro i j
  refine Fin.addCases ?_ ?_ j
  · intro j₁
    simp only [Polynomial.sylvester, Matrix.of_apply, Fin.addCases_left]
    split_ifs
    · exact hQ _
    · simp
  · intro j₁
    simp only [Polynomial.sylvester, Matrix.of_apply, Fin.addCases_right]
    split_ifs
    · exact hP _
    · simp

private theorem derivative_coeff_bound (P : Polynomial (Polynomial ℚ))
    (D : ℕ) (hP : ∀ j, (P.coeff j).natDegree ≤ D) :
    ∀ j, (P.derivative.coeff j).natDegree ≤ D := by
  intro j
  rw [Polynomial.coeff_derivative]
  have he : P.coeff (j + 1) * ((j : Polynomial ℚ) + 1) =
      (j + 1) • P.coeff (j + 1) := by
    simp only [nsmul_eq_mul, Nat.cast_add, Nat.cast_one]
    ring
  rw [he]
  exact (Polynomial.natDegree_smul_le _ _).trans (hP _)

private theorem resultant_derivative_ne_zero (P : Polynomial (Polynomial ℚ))
    (hP : Irreducible P) (hpos : 1 ≤ P.natDegree) :
    P.resultant P.derivative ≠ 0 := by
  let K := FractionRing (Polynomial ℚ)
  let φ : Polynomial ℚ →+* K := algebraMap (Polynomial ℚ) K
  have hφ : Function.Injective φ := IsFractionRing.injective _ _
  have hp := primitive_of_irreducible_pos P hP hpos
  have hPK : Irreducible (Polynomial.map φ P) :=
    (hp.irreducible_iff_irreducible_map_fraction_map (K := K)).mp hP
  have hcop : IsCoprime (Polynomial.map φ P) (Polynomial.map φ P).derivative :=
    (Polynomial.separable_def _).mp hPK.separable
  have hne := Polynomial.resultant_ne_zero _ _ hcop
  intro hz
  have hzmap : (Polynomial.map φ P).resultant (Polynomial.map φ P.derivative)
      P.natDegree P.derivative.natDegree = 0 := by
    rw [Polynomial.resultant_map_map, hz, map_zero]
  apply hne
  rw [Polynomial.derivative_map]
  simpa only [Polynomial.natDegree_map_eq_of_injective hφ] using hzmap

private theorem common_zero_resultant (P Q : Polynomial (Polynomial ℚ))
    (hpos : 1 ≤ P.natDegree) (x y : ℚ)
    (hx : Polynomial.eval y (Polynomial.map (Polynomial.evalRingHom x) P) = 0)
    (hy : Polynomial.eval y (Polynomial.map (Polynomial.evalRingHom x) Q) = 0) :
    Polynomial.eval x (P.resultant Q) = 0 := by
  obtain ⟨A, B, hA, hB, hBez⟩ :=
    Polynomial.exists_mul_add_mul_eq_C_resultant P Q le_rfl le_rfl
      (Or.inl (by omega : P.natDegree ≠ 0))
  have hm := congrArg (Polynomial.map (Polynomial.evalRingHom x)) hBez
  rw [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_mul, Polynomial.map_C] at hm
  have he := congrArg (Polynomial.eval y) hm
  simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C,
    hx, hy, zero_mul, zero_add] at he
  change (0 : ℚ) = Polynomial.eval x (P.resultant Q) at he
  exact he.symm

theorem elimination :
∀ D : ℕ, 1 ≤ D →
  ∀ P : Polynomial (Polynomial ℚ),
    Irreducible P →
    1 ≤ P.natDegree → P.natDegree ≤ D →
    (∀ j : ℕ, (P.coeff j).natDegree ≤ D) →
    ∃ R : Polynomial ℚ, R ≠ 0 ∧ R.natDegree ≤ 2 * D ^ 2 ∧
      ∀ x y : ℚ,
        Polynomial.eval y (Polynomial.map (Polynomial.evalRingHom x) P) = 0 →
        Polynomial.eval y (Polynomial.map (Polynomial.evalRingHom x) P.derivative) = 0 →
        Polynomial.eval x R = 0 := by
  intro D hD P hP hpos hPD hcoef
  let R := P.resultant P.derivative
  refine ⟨R, resultant_derivative_ne_zero P hP hpos, ?_, ?_⟩
  · have hder := derivative_coeff_bound P D hcoef
    have hentries := sylvester_degree_bound P P.derivative D
      P.natDegree P.derivative.natDegree hcoef hder
    have hmat := matrix_natDegree_bound D
      (P.sylvester P.derivative P.natDegree P.derivative.natDegree) hentries
    have hres : R.natDegree ≤ (P.natDegree + P.derivative.natDegree) * D := by
      simpa only [R, Polynomial.resultant, Fintype.card_fin] using hmat
    apply hres.trans
    have hderlt : P.derivative.natDegree < P.natDegree :=
      Polynomial.natDegree_derivative_lt (by omega)
    calc
      (P.natDegree + P.derivative.natDegree) * D ≤ (2 * D) * D :=
        Nat.mul_le_mul_right D (by omega)
      _ = 2 * D ^ 2 := by ring
  · intro x y hx hy
    exact common_zero_resultant P P.derivative hpos x y hx hy

end A5NongeometricElimination

namespace A5NongeometricCount
open Polynomial
private theorem specialization_ne_zero (P : Polynomial (Polynomial ℚ))
    (hP : Irreducible P) (hpos : 1 ≤ P.natDegree) (x : ℚ) :
    Polynomial.map (Polynomial.evalRingHom x) P ≠ 0 := by
  intro hz
  have hp := A5NongeometricElimination.primitive_of_irreducible_pos P hP hpos
  have hdvd : Polynomial.C (Polynomial.X - Polynomial.C x) ∣ P := by
    apply (Polynomial.C_dvd_iff_dvd_coeff _ _).mpr
    intro j
    apply Polynomial.dvd_iff_isRoot.mpr
    have hc := congrArg (fun Q : Polynomial ℚ => Q.coeff j) hz
    rw [Polynomial.coeff_map, Polynomial.coeff_zero] at hc
    exact hc
  have hu := Polynomial.isPrimitive_iff_isUnit_of_C_dvd.mp hp _ hdvd
  have hdeg := Polynomial.natDegree_eq_zero_of_isUnit hu
  rw [Polynomial.natDegree_X_sub_C] at hdeg
  omega

private theorem roots_card_le (p : Polynomial ℚ) (hp : p ≠ 0) :
    p.roots.toFinset.card ≤ p.natDegree := by
  apply p.roots.toFinset_card_le.trans
  have hr := Polynomial.card_roots hp
  rw [Polynomial.degree_eq_natDegree hp] at hr
  exact_mod_cast hr

private theorem bivariate_singular_count (D : ℕ) (hD : 1 ≤ D)
    (P : Polynomial (Polynomial ℚ)) (hP : Irreducible P)
    (hpos : 1 ≤ P.natDegree) (hPD : P.natDegree ≤ D)
    (hcoeff : ∀ j, (P.coeff j).natDegree ≤ D) :
    let S : Set (Fin 2 → ℚ) := {a |
      Polynomial.eval (a 1) (Polynomial.map (Polynomial.evalRingHom (a 0)) P) = 0 ∧
      Polynomial.eval (a 1) (Polynomial.map (Polynomial.evalRingHom (a 0)) P.derivative) = 0}
    S.Finite ∧ S.ncard ≤ 2 * D ^ 3 := by
  classical
  obtain ⟨R, hR, hRD, hRzero⟩ :=
    A5NongeometricElimination.elimination D hD P hP hpos hPD hcoeff
  let B : Finset ℚ := R.roots.toFinset
  let F : ℚ → Finset (Fin 2 → ℚ) := fun x =>
    (Polynomial.map (Polynomial.evalRingHom x) P).roots.toFinset.image (fun y => ![x, y])
  let T : Finset (Fin 2 → ℚ) := B.biUnion F
  let S : Set (Fin 2 → ℚ) := {a |
      Polynomial.eval (a 1) (Polynomial.map (Polynomial.evalRingHom (a 0)) P) = 0 ∧
      Polynomial.eval (a 1) (Polynomial.map (Polynomial.evalRingHom (a 0)) P.derivative) = 0}
  have hsub : S ⊆ (T : Set (Fin 2 → ℚ)) := by
    intro a ha
    have hx : a 0 ∈ B := by
      exact Multiset.mem_toFinset.mpr ((Polynomial.mem_roots hR).mpr
        (hRzero (a 0) (a 1) ha.1 ha.2))
    have hy : a 1 ∈ (Polynomial.map (Polynomial.evalRingHom (a 0)) P).roots.toFinset := by
      exact Multiset.mem_toFinset.mpr
        ((Polynomial.mem_roots (specialization_ne_zero P hP hpos (a 0))).mpr ha.1)
    have heq : ![a 0, a 1] = a := by ext i; fin_cases i <;> rfl
    apply Finset.mem_biUnion.mpr
    refine ⟨a 0, hx, ?_⟩
    apply Finset.mem_image.mpr
    exact ⟨a 1, hy, heq⟩
  have hT : T.card ≤ 2 * D ^ 3 := by
    calc
      T.card ≤ ∑ x ∈ B, (F x).card := Finset.card_biUnion_le
      _ ≤ ∑ _x ∈ B, D := by
        apply Finset.sum_le_sum
        intro x hx
        calc
          (F x).card ≤ (Polynomial.map (Polynomial.evalRingHom x) P).roots.toFinset.card :=
            Finset.card_image_le
          _ ≤ (Polynomial.map (Polynomial.evalRingHom x) P).natDegree :=
            roots_card_le _ (specialization_ne_zero P hP hpos x)
          _ ≤ P.natDegree := Polynomial.natDegree_map_le
          _ ≤ D := hPD
      _ = B.card * D := by simp
      _ ≤ (2 * D ^ 2) * D := by
        exact Nat.mul_le_mul_right D ((roots_card_le R hR).trans hRD)
      _ = 2 * D ^ 3 := by ring
  refine ⟨(Finset.finite_toSet T).subset hsub, ?_⟩
  calc
    S.ncard ≤ (T : Set (Fin 2 → ℚ)).ncard := Set.ncard_le_ncard hsub
    _ = T.card := Set.ncard_coe_finset _
    _ ≤ 2 * D ^ 3 := hT

end A5NongeometricCount

