theorem dle (a b c : ℝ) (h : a ≤ b) (hc : 0 < c) : a / c ≤ b / c := by
  first
  | exact div_le_div_of_nonneg_right h hc.le

theorem sqrt_lo (P w : ℝ) (_hP : 0 ≤ P) (_hw0 : 0 ≤ w) (h : w ^ 2 ≤ P) : w ≤ Real.sqrt P := by
  first
  | exact le_trans (le_abs_self w) (Real.abs_le_sqrt h)

theorem sqrt_hi (P w : ℝ) (_hP : 0 ≤ P) (hw0 : 0 ≤ w) (h : P ≤ w ^ 2) : Real.sqrt P ≤ w := by
  first
  | (have h2 := Real.sqrt_le_sqrt h
     rwa [Real.sqrt_sq hw0] at h2)

theorem lem_tl (kk A W : ℝ) (h3 : 0 < 3 * kk + 2) (h : A ≤ W) :
    (3 * kk + 2) * A - 2 ≤ (3 * kk + 2) * W - 2 := by
