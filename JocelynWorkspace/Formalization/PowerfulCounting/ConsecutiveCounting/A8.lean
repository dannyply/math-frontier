private theorem kth_cell_entry_height (L : ℕ) (hL : 1 ≤ L)
    (A B : ℕ) (hB : B ≤ A)
    (x D E : ℝ) (M j : ℕ) (h : ℤ) (hx : 8 ≤ x)
    (hh : h = 1 ∨ h = -1) (z : Point)
    (hz : z ∈ originalCellK L x D E M j h) (c : Cols A B) :
    |(entry A B z c : ℝ)| ≤ (2 : ℝ)^(2*A)*x^(2*A) := by
  have hp := kth_cell_coordinate_bounds L hL x D E M j h hx hh z hz
  have heq :
      |(entry A B z c : ℝ)| =
        (z.1.1 : ℝ)^(c.1 : ℕ)*(z.1.2 : ℝ)^(A-(c.1 : ℕ))*
        (z.2.2 : ℝ)^(c.2 : ℕ)*(z.2.1 : ℝ)^(B-(c.2 : ℕ)) := by
    simp only [entry,Int.cast_mul,Int.cast_pow,Int.cast_natCast]
    exact abs_of_nonneg (by positivity)
  rw [heq]
  calc
    _ ≤ (2*x)^(c.1 : ℕ)*(2*x)^(A-(c.1 : ℕ))*
        (2*x)^(c.2 : ℕ)*(2*x)^(B-(c.2 : ℕ)) := by
      gcongr <;> first | exact hp.1 | exact hp.2.1 | exact hp.2.2.1 | exact hp.2.2.2
    _ = (2*x)^(A+B) := by
      rw [← pow_add,mul_assoc,← pow_add,← pow_add]
      congr 1
      have hi := c.1.isLt
      have hj := c.2.isLt
      omega
    _ ≤ (2*x)^(2*A) :=
      pow_le_pow_right₀ (by linarith only [hx]) (by omega)
    _ = _ := by rw [mul_pow]
end A8KCore

