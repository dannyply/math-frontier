theorem original_shared_parameter_image
    (k : ℕ) (Spts : Finset ((ℕ×ℕ)×(ℕ×ℕ)))
    (dparam eparam : ℤ→ℤ) (ell : ℤ) (f g : Polynomial ℤ)
    (hell : ell≠0)
    (hcert : ∀ p∈Spts,∃ y : ℤ,
      (p.1.1:ℤ)=dparam y ∧ (p.1.2:ℤ)=eparam y ∧
      f.eval y=ell^(2*k+1)*(p.2.2:ℤ) ∧
      g.eval y=ell^(2*k+1)*(p.2.1:ℤ)) :
    ∃ T : Finset ℤ,T.card=Spts.card ∧
      ∀ y∈T,∃ p∈Spts,
        (p.1.1:ℤ)=dparam y ∧ (p.1.2:ℤ)=eparam y ∧
        f.eval y=ell^(2*k+1)*(p.2.2:ℤ) ∧
        g.eval y=ell^(2*k+1)*(p.2.1:ℤ) := by
  classical
  let cert (p : {q // q∈Spts}) := hcert p.1 p.2
  let param (p : {q // q∈Spts}) : ℤ := Classical.choose (cert p)
  have hparam_cert (p : {q // q∈Spts}) :
      (p.1.1.1:ℤ)=dparam (param p) ∧ (p.1.1.2:ℤ)=eparam (param p) ∧
      f.eval (param p)=ell^(2*k+1)*(p.1.2.2:ℤ) ∧
      g.eval (param p)=ell^(2*k+1)*(p.1.2.1:ℤ) :=
    Classical.choose_spec (cert p)
  have hinj : Function.Injective param := by
    intro p p' heq
    obtain ⟨hd,he,hf,hg⟩ := hparam_cert p
    obtain ⟨hd',he',hf',hg'⟩ := hparam_cert p'
    have hdd : (p.1.1.1:ℤ)=(p'.1.1.1:ℤ) := by rw [hd,hd',heq]
    have hee : (p.1.1.2:ℤ)=(p'.1.1.2:ℤ) := by rw [he,he',heq]
    have huu : (p.1.2.1:ℤ)=(p'.1.2.1:ℤ) := by
      apply mul_left_cancel₀ (pow_ne_zero (2*k+1) hell)
      rw [←hg,←hg',heq]
    have hvv : (p.1.2.2:ℤ)=(p'.1.2.2:ℤ) := by
      apply mul_left_cancel₀ (pow_ne_zero (2*k+1) hell)
      rw [←hf,←hf',heq]
    apply Subtype.ext
    apply Prod.ext
    · apply Prod.ext
      · exact_mod_cast hdd
      · exact_mod_cast hee
    · apply Prod.ext
      · exact_mod_cast huu
      · exact_mod_cast hvv
  let T := Spts.attach.image param
  refine ⟨T,?_,?_⟩
  · simpa [T] using Finset.card_image_of_injective Spts.attach hinj
  · intro y hy
    obtain ⟨p,hp,rfl⟩ := Finset.mem_image.mp hy
    exact ⟨p.1,p.2,hparam_cert p⟩

theorem relative_ratio_cell_bound
    (D E M r d e : ℝ) (hM : 0<M)
    (hr : r≤2*D/E) (hlo : r<d/e) (hhi : d/e≤r*(1+1/M)) :
    |d/e-r|≤2*D/(E*M) := by
  rw [abs_of_pos (sub_pos.mpr hlo)]
  have hg : d/e-r≤r/M := by
    simp only [div_eq_mul_inv] at hhi ⊢
    nlinarith only [hhi]
  calc
    d/e-r≤r/M := hg
    _≤(2*D/E)/M := div_le_div_of_nonneg_right hr hM.le
    _=2*D/(E*M) := by field_simp

theorem nonrich_linear_box_bound
    (a b D E L C0 : ℝ) (hD : 0≤D) (hE : 0≤E)
    (hab : 1≤|a| ∨ 1≤|b|)
    (hthin : max (|a| *D) (|b| *E)≤C0*L) :
    D*E≤C0*L*max D E := by
  rcases hab with ha | hb
  · have hd : D≤C0*L := by
      have hh := mul_le_mul_of_nonneg_right ha hD
      have hm := (le_max_left (|a| *D) (|b| *E)).trans hthin
      nlinarith only [hh,hm]
    have hCL : 0≤C0*L := hD.trans hd
    calc
      D*E≤(C0*L)*E := mul_le_mul_of_nonneg_right hd hE
      _≤(C0*L)*max D E := mul_le_mul_of_nonneg_left (le_max_right D E) hCL
  · have he : E≤C0*L := by
      have hh := mul_le_mul_of_nonneg_right hb hE
      have hm := (le_max_right (|a| *D) (|b| *E)).trans hthin
      nlinarith only [hh,hm]
    have hCL : 0≤C0*L := hE.trans he
    calc
      D*E≤D*(C0*L) := mul_le_mul_of_nonneg_left he hD
      _=(C0*L)*D := by ring
      _≤(C0*L)*max D E := mul_le_mul_of_nonneg_left (le_max_left D E) hCL

theorem axis_original_box_bound
    (a b D E d e ell : ℝ)
    (hD : 0<D) (hE : 0<E) (hd : D/2<d) (he : E/2<e)
    (hlevel : a*d+b*e=ell) (haxis : a=0 ∨ b=0) :
    max (|a| *D) (|b| *E)≤2*|ell| := by
  have hdpos : 0<d := by linarith
  have hepos : 0<e := by linarith
  rcases haxis with ha | hb
  · have hEll : |ell|=|b| *e := by
      rw [←hlevel,ha,zero_mul,zero_add,abs_mul,abs_of_pos hepos]
    have hnonneg : 0≤|b| *E := mul_nonneg (abs_nonneg b) hE.le
    rw [ha,abs_zero,zero_mul,max_eq_right hnonneg,hEll]
    have hh := mul_le_mul_of_nonneg_left (show E≤2*e by linarith) (abs_nonneg b)
    nlinarith only [hh]
  · have hEll : |ell|=|a| *d := by
      rw [←hlevel,hb,zero_mul,add_zero,abs_mul,abs_of_pos hdpos]
    have hnonneg : 0≤|a| *D := mul_nonneg (abs_nonneg a) hD.le
    rw [hb,abs_zero,zero_mul,max_eq_left hnonneg,hEll]
    have hh := mul_le_mul_of_nonneg_left (show D≤2*d by linarith) (abs_nonneg a)
    nlinarith only [hh]

end
