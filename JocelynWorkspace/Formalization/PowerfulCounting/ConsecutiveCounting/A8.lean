theorem original_finite_rich_class_band_bounds :
    ∀ k : ℕ,2≤k →
    ∃ c1 C1 c2 C2 C0 : ℝ,
      0<c1 ∧ c1≤1 ∧ 2≤C1 ∧ 0<c2 ∧ c2≤1 ∧ 2≤C2 ∧
      8≤C0 ∧ 8*C1≤C0 ∧ 8*C2≤C0 ∧
    ∀ P Q : MvPolynomial (Fin 2) ℤ,
      P.IsHomogeneous (k+1) → Q.IsHomogeneous (k+1) →
      (∀ w : Fin 2 → ℂ,w≠0 →
        MvPolynomial.eval w (P.map (Int.castRingHom ℂ))=0 →
        MvPolynomial.eval w (Q.map (Int.castRingHom ℂ))=0 → False) →
    ∀ a b c h ell : ℤ,a≠0 → b≠0 → c≠0 → h≠0 → ell≠0 →
      MvPolynomial.X (1:Fin 2)^k*P-MvPolynomial.X (0:Fin 2)^k*Q =
        MvPolynomial.C c*(MvPolynomial.C a*MvPolynomial.X (0:Fin 2)+
          MvPolynomial.C b*MvPolynomial.X (1:Fin 2))^(2*k+1) →
    ∀ x D E U V M rho Ccell : ℝ,0<x → 0<D → 0<E →
    ∀ p0 : OriginalPoint,∀ Spts : Finset OriginalPoint,
      OriginalCellPoint k P Q x D E U V M rho Ccell p0 →
      (∀ p∈Spts,OriginalCellPoint k P Q x D E U V M rho Ccell p) →
      ell=a*(pd p0:ℤ)+b*(pe p0:ℤ) →
      |(ell:ℝ)| * C0 < max (|(a:ℝ)| *D) (|(b:ℝ)| *E) →
    ∀ f g : Polynomial ℤ,
      (∀ p∈Spts,∃ y : ℤ,
        (pd p:ℤ)=(pd p0:ℤ)+b*h*y ∧
        (pe p:ℤ)=(pe p0:ℤ)-a*h*y ∧
        f.eval y=ell^(2*k+1)*(pv p:ℤ) ∧
        g.eval y=ell^(2*k+1)*(pu p:ℤ)) →
    let S0 := P.coeff (Finsupp.single (0:Fin 2) (k+1))
    let R0 := P.coeff (Finsupp.single (0:Fin 2) k+Finsupp.single (1:Fin 2) 1)
    let K0 : ℤ := b*S0-a*R0+(Nat.choose (2*k) (k-1):ℤ)*c*a^(k+1)*b^(k+1)
    let gamma : ℝ := (a:ℝ)*(b:ℝ)*(h:ℝ)/(ell:ℝ)
    let R := Real.sqrt (|(a:ℝ)*(b:ℝ)| *(D*E))/(4*|(ell:ℝ)|)
    let lam : ℝ := (K0:ℝ)/((c:ℝ)*((a:ℝ)*(b:ℝ))^(k+1))
    let l1 := c1*|lam| *|gamma| *R^(2*k)
    let L2 := c2*gamma^2*R^(2*k-3)
    (C1≤|lam| *R^2 → C1*x≤|lam| *R^(2*k+1) →
      (Spts.card:ℝ)≤(10*((2*k+1:ℕ):ℝ)+10)*(1+x/l1)) ∧
    (x≤c2*R^(2*k-1) →
      (Spts.card:ℝ)≤(10*((2*k+1:ℕ):ℝ)+10)*(1+Real.sqrt (x/L2))) := by
  intro k hk
  obtain ⟨c1,C1,c2,C2,C0,hc1,hc11,hC1,hc2,hc21,hC2,hC0,hC01,hC02,hband⟩ :=
    physical_progression_band_count k hk
  refine ⟨c1,C1,c2,C2,C0,hc1,hc11,hC1,hc2,hc21,hC2,hC0,hC01,hC02,?_⟩
  intro P Q hP hQ hno a b c h ell ha hb hc hh hell hres
    x D E U V M rho Ccell hx hD hE p0 Spts hp0 hS hmdef hrich f g hcert
    S0 R0 K0 gamma R lam l1 L2
  have hellR : (ell:ℝ)≠0 := by exact_mod_cast hell
  have hhR : (h:ℝ)≠0 := by exact_mod_cast hh
  have hlevel : a*(pd p0:ℤ)+b*(pe p0:ℤ)=ell := hmdef.symm
  have hlevelR : (a:ℝ)*(pd p0:ℝ)+(b:ℝ)*(pe p0:ℝ)=(ell:ℝ) := by
    exact_mod_cast hlevel
  obtain ⟨hd0,he0,hu0,hv0,hd0lo,hd0hi,he0lo,he0hi,hU0lo,hU0hi,
    hV0lo,hV0hi,hn0lo,hn0hi,hunit0,hgraph0,hcell0⟩ := hp0
  let Qr := Q.map (Int.castRingHom ℝ)
  let dp : Polynomial ℝ := C ((ell:ℝ)/(a:ℝ))*X
  let ep : Polynomial ℝ := C ((ell:ℝ)/(b:ℝ))*(1-X)
  let phi := MvPolynomial.eval₂Hom Polynomial.C ![dp,ep]
  let F : Polynomial ℝ := C (1/((c:ℝ)*(ell:ℝ)^(2*k+1)))*(dp^k*phi Qr)
  let z0 : ℝ := (a:ℝ)*(pd p0:ℝ)/(ell:ℝ)
  let N := F.comp (C z0+C gamma*X)
  let Bset : Set ℤ := {j |
    D/2≤(pd p0:ℝ)+(b:ℝ)*(h:ℝ)*(j:ℝ) ∧
    (pd p0:ℝ)+(b:ℝ)*(h:ℝ)*(j:ℝ)≤D ∧
    x/2<N.eval (j:ℝ) ∧ N.eval (j:ℝ)≤x}
  have hBand := hband P Q hP hQ hno a b c ha hb hc hres
    (ell:ℝ) x D E (pd p0:ℝ) (pe p0:ℝ) hellR hx hD hE
    hd0lo hd0hi he0lo he0hi hlevelR hrich
    (pd p0:ℝ) (pe p0:ℝ) (h:ℝ) hhR hlevelR
  change (C1≤|lam| *R^2 → C1*x≤|lam| *R^(2*k+1) →
    Bset.Finite ∧ (Bset.ncard:ℝ)≤(10*((2*k+1:ℕ):ℝ)+10)*(1+x/l1)) ∧
    (x≤c2*R^(2*k-1) →
    Bset.Finite ∧ (Bset.ncard:ℝ)≤(10*((2*k+1:ℕ):ℝ)+10)*(1+Real.sqrt (x/L2))) at hBand
  have hbox : ∀ p∈Spts,
      D/2≤(p.1.1:ℝ) ∧ (p.1.1:ℝ)≤D ∧
      x/2<(p.1.1:ℝ)^k*(p.2.1:ℝ) ∧
      (p.1.1:ℝ)^k*(p.2.1:ℝ)≤x := by
    intro p hp
    obtain ⟨hdp,hep,hup,hvp,hdlo,hdhi,helo,hehi,hulo,huhi,hvlo,hvhi,
      hnlo,hnhi,hunit,hgraph,hcell⟩ := hS p hp
    exact ⟨hdlo.le,hdhi,hnlo,hnhi⟩
  have hheight : ∀ p∈Spts,∀ y : ℤ,
      (p.1.1:ℤ)=(pd p0:ℤ)+b*h*y →
      (p.1.2:ℤ)=(pe p0:ℤ)-a*h*y →
      N.eval (y:ℝ)=(p.1.1:ℝ)^k*(p.2.1:ℝ) := by
    intro p hp y hd he
    obtain ⟨hdp,hep,hup,hvp,hdlo,hdhi,helo,hehi,hulo,huhi,hvlo,hvhi,
      hnlo,hnhi,hunit,hgraph,hcell⟩ := hS p hp
    exact original_integer_affine_height_value k hk P Q hP hQ
      a b c (pd p0:ℤ) (pe p0:ℤ) h ell ha hb hc hell hno hres hlevel
      (pd p:ℤ) (pe p:ℤ) (pu p:ℤ) (pv p:ℤ) y hd he hunit hgraph
  have hcard (hB : Bset.Finite) : (Spts.card:ℝ)≤(Bset.ncard:ℝ) := by
    have hh := original_progression_band_card_le k Spts
      (pd p0:ℤ) (pe p0:ℤ) a b h ell f g hell hcert x D N hbox hheight hB
    have hh' : Spts.card≤Bset.ncard := by
      simpa only [Bset,Int.cast_add,Int.cast_mul,Int.cast_natCast] using hh
    exact_mod_cast hh'
  constructor
  · intro hI1 hI2
    obtain ⟨hB,hc⟩ := hBand.1 hI1 hI2
    exact (hcard hB).trans hc
  · intro hII
    obtain ⟨hB,hc⟩ := hBand.2 hII
    exact (hcard hB).trans hc

end
end A8FloorExt

