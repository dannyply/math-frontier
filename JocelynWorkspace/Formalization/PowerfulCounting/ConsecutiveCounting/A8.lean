namespace A8KCore
private def kCoeffs (L : ℕ) (c : ℝ) (n : Fin (L+1)) : ℝ :=
  (L.choose (n : ℕ) : ℝ) * c^(L-(n : ℕ))
private def graphPoly (L : ℕ) (c : ℝ) (i j : ℕ) : MvPolynomial (Fin 2) ℝ :=
  (MvPolynomial.C c+MvPolynomial.X 0)^i *
    ((MvPolynomial.C c+MvPolynomial.X 0)^L+MvPolynomial.X 1)^j

private theorem coefficientPolynomial_kth (L : ℕ) (c : ℝ) :
    FormalAB.S1fdb06b5.A1UniformTaylor.coefficientPolynomial L (kCoeffs L c) =
      (Polynomial.C c+Polynomial.X)^L := by
  rw [add_comm (Polynomial.C c) Polynomial.X, add_pow, Finset.sum_range]
  unfold FormalAB.S1fdb06b5.A1UniformTaylor.coefficientPolynomial
  apply Finset.sum_congr rfl
  intro n _
  rw [← Polynomial.C_mul_X_pow_eq_monomial]
  simp only [kCoeffs, map_mul, map_pow, map_natCast]
  ring

private theorem graphPoly_normalized (L : ℕ) (c : ℝ) (i j : ℕ) :
    graphPoly L c i j =
      FormalAB.S1fdb06b5.A1UniformTaylor.normalizedGraph
        (FormalAB.S1fdb06b5.A1UniformTaylor.coefficientPolynomial L (kCoeffs L c))
        c 1 i j := by
  rw [coefficientPolynomial_kth]
  simp [graphPoly,FormalAB.S1fdb06b5.A1UniformTaylor.normalizedGraph,
    map_pow,map_add]

private theorem graphPoly_support (L : ℕ) (c : ℝ) (i j : ℕ)
    (d : Fin 2 →₀ ℕ) (hd : d ∈ (graphPoly L c i j).support) :
    d 0 ≤ i+L*j ∧ d 1 ≤ j := by
  rw [graphPoly_normalized] at hd
  have hh := FormalAB.S1fdb06b5.A1UniformTaylor.normalizedGraph_support
    L (kCoeffs L c) c 1 i j d hd
  refine ⟨?_, hh.2⟩
  rw [Nat.mul_comm L j]
  exact hh.1

private theorem choose_le_two_pow_aux (L n : ℕ) (hn : n ≤ L) : L.choose n ≤ 2^L := by
  rw [← Nat.sum_range_choose L]
  exact Finset.single_le_sum (f := fun i => L.choose i) (fun i _ => Nat.zero_le _)
    (Finset.mem_range.mpr (Nat.lt_succ_of_le hn))

private theorem kCoeffs_bound (L : ℕ) (c : ℝ) (hc0 : 0 ≤ c) (hc2 : c ≤ 2) :
    ∀ n, |kCoeffs L c n| ≤ (4 : ℝ)^L := by
  intro n
  have hn : (n : ℕ) ≤ L := Nat.lt_succ_iff.mp n.isLt
  have hch : (L.choose (n : ℕ) : ℝ) ≤ (2 : ℝ)^L := by
    exact_mod_cast choose_le_two_pow_aux L n hn
  have hcp0 : 0 ≤ c^(L-(n : ℕ)) := pow_nonneg hc0 _
  have hcp : c^(L-(n : ℕ)) ≤ (2 : ℝ)^L :=
    calc c^(L-(n : ℕ)) ≤ (2 : ℝ)^(L-(n : ℕ)) := pow_le_pow_left₀ hc0 hc2 _
      _ ≤ (2 : ℝ)^L := pow_le_pow_right₀ (by norm_num) (Nat.sub_le L n)
  show |(L.choose (n : ℕ) : ℝ) * c^(L-(n : ℕ))| ≤ (4 : ℝ)^L
  rw [abs_of_nonneg (mul_nonneg (Nat.cast_nonneg _) hcp0)]
  calc (L.choose (n : ℕ) : ℝ) * c^(L-(n : ℕ)) ≤ (2 : ℝ)^L * (2 : ℝ)^L :=
        mul_le_mul hch hcp hcp0 (by positivity)
    _ = (4 : ℝ)^L := by rw [← mul_pow]; norm_num

private theorem graphPoly_uniform_coefficients (L A B : ℕ) :
    ∃ K : ℝ, 0 < K ∧
      ∀ c : ℝ, 0 ≤ c → c ≤ 2 →
      ∀ i j : ℕ, i ≤ A → j ≤ B →
      ∀ d : Fin 2 →₀ ℕ, |MvPolynomial.coeff d (graphPoly L c i j)| ≤ K := by
  obtain ⟨K,hK,hbound⟩ :=
    FormalAB.S1fdb06b5.A1UniformTaylor.uniform_coefficient_graph_bound
      L A B ((4 : ℝ)^L) 2 (by positivity) (by norm_num)
  refine ⟨K,hK,?_⟩
  intro c hc0 hc2 i j hi hj d
  rw [graphPoly_normalized]
  exact hbound (kCoeffs L c) (kCoeffs_bound L c hc0 hc2)
    c 1 (by rwa [abs_of_nonneg hc0]) (by norm_num) i j hi hj d

private theorem graphPoly_eval (L : ℕ) (c a b : ℝ) (i j : ℕ) :
    MvPolynomial.eval (fun t : Fin 2 => if t = 0 then a else b)
      (graphPoly L c i j) = (c+a)^i*((c+a)^L+b)^j := by
  simp [graphPoly]

