section
lemma pl (k:ℕ) (g:wC) (alpha beta:ℕ)
    (hg:∀ m∈ g.support,m 0+m 1=alpha∧ m 2+m 3=beta)
    (p H0:wG) (nu:ℕ)
    (hH:ah.au k g=X 0^nu*H0)
    (vK:¬(X (0:Fin 3):wG)∣H0)
    (hdiv:dehom g∣ sub k p):H0∣p:=by
  apply pf (X (0:Fin 3):wG) H0 p X_prime vK
  have hdp:down k (dehom g)∣ am p:=by
    have hm:=map_dvd (down k) hdiv
    have heq:=congrArg (fun f:wG→+*Away=> f p) (pg k)
    change down k (dehom g)∣ down k (sub k p) at hm
    change down k (sub k p)=am p at heq
    rw [heq] at hm
    exact hm
  have heq:down k (dehom g)=am (ah.au k g)*di^(k*beta):=by
    rw [pk k g alpha beta hg]
    calc
      down k (dehom g)=down k (dehom g)*(x 0*di)^(k*beta):=by
        rw [x_di,one_pow,mul_one]
      _=_:=by ring
  have hdH':am (ah.au k g)∣ am p:=by
    rw [heq] at hdp
    exact (dvd_mul_right _ _).trans hdp
  rw [hH,map_mul,map_pow] at hdH'
  exact (dvd_mul_left _ _).trans hdH'
end
