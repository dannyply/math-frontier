theorem ratio_bounds (D E : ℝ) (hD : 0 < D) (hE : 0 < E) (d e : ℕ) (he1 : 1 ≤ e)
    (h8 : D / 2 < (d : ℝ)) (h9 : (d : ℝ) ≤ D) (h10 : E / 2 < (e : ℝ)) (h11 : (e : ℝ) ≤ E) :
