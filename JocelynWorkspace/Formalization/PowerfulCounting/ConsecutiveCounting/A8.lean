    E / 2 < (q.1.2 : ℝ) ∧ (q.1.2 : ℝ) ≤ E ∧ ((q.1.1 ^ k * q.2.1 : ℕ) : ℝ) ≤ x ∧
    ((q.1.2 ^ k * q.2.2 : ℕ) : ℤ) = ((q.1.1 ^ k * q.2.1 : ℕ) : ℤ) + h}

def D946Stmt : Prop :=
  ∀ k : ℕ, 2 ≤ k → ∀ epsilon : ℝ, 0 < epsilon → ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ, 2 ≤ x →
    ∀ D E : ℝ, 0 < D → 0 < E → ∀ h : ℤ, (h = 1 ∨ h = -1) →
      (collarPopulation k h x D E).Finite ∧
      ((collarPopulation k h x D E).ncard : ℝ) ≤
        C * x ^ epsilon * (x / (D * E) ^ (k - 1) + min (E * (x / D ^ k)) (D * (x / E ^ k)))

noncomputable def thetaK (k : ℕ) : ℝ :=
  let kr : ℝ := k
  let s : ℝ := (2 * kr - 3 + Real.sqrt (580 * kr ^ 2 + 276 * kr + 9)) / (9 * kr * (2 * kr + 1))
  ((3 * kr + 2) * s - 2) / (2 * kr + 1)

def excT (k : ℕ) (S : Set Point) (x : ℝ) : Set Point :=
  {z | 1 ≤ z.1.1 ∧ 1 ≤ z.1.2 ∧ 1 ≤ z.2.1 ∧ 1 ≤ z.2.2 ∧ z.1.2 ^ k * z.2.2 = z.1.1 ^ k * z.2.1 + 1 ∧
    ((z.1.1 ^ k * z.2.1 : ℕ) : ℝ) ≤ x ∧ z ∈ S}

def ExcStmt (k : ℕ) (S : Set Point) : Prop :=
  ∀ ε : ℝ, 0 < ε → ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ, 2 ≤ x →
    (excT k S x).Finite ∧ ((excT k S x).ncard : ℝ) ≤ C * x ^ (thetaK k + ε)

def NonCollarK (k : ℕ) (y D E : ℝ) : Prop :=
  D * E < y ^ ((2 : ℝ) / (k : ℝ)) ∧ y ^ ((1 : ℝ) / (2 * (k : ℝ) ^ 2)) < D ∧
    y ^ ((1 : ℝ) / (2 * (k : ℝ) ^ 2)) < E ∧ y ^ ((1 : ℝ) / (2 * (k : ℝ) ^ 2)) * D ^ k < y ∧
    y ^ ((1 : ℝ) / (2 * (k : ℝ) ^ 2)) * E ^ k < y

def BandK (k : ℕ) (S : Set Point) (lo hi th : ℝ) : Prop :=
  ∀ δ : ℝ, 0 < δ → ∃ C T : ℝ, 1 ≤ C ∧ 4 ≤ T ∧ ∀ y : ℝ, T ≤ y → ∀ s : ℝ, lo ≤ s → s ≤ hi →
    ∀ D E : ℝ, 0 < D → 0 < E → D * E = y ^ s → NonCollarK k y D E →
      (boxT k y D E \ S).Finite ∧ ((boxT k y D E \ S).ncard : ℝ) ≤ C * y ^ (th + δ)

noncomputable def tailCount (k : ℕ) (x : ℝ) : ℕ :=
  ({q : (ℕ × ℕ) × (ℕ × ℕ) | 1 ≤ q.1.1 ∧ 1 ≤ q.1.2 ∧ 1 ≤ q.2.1 ∧ 1 ≤ q.2.2 ∧
    ((q.1.1 ^ k * q.2.1 : ℕ) : ℝ) ≤ x ∧ q.1.2 ^ k * q.2.2 = q.1.1 ^ k * q.2.1 + 1 ∧
    x ^ ((1 : ℝ) / (k : ℝ)) < ((q.1.1 * q.1.2 : ℕ) : ℝ)} : Set ((ℕ × ℕ) × (ℕ × ℕ))).ncard

theorem tailCount_eq (k : ℕ) (x : ℝ) : tailCount k x = (tailT k x).ncard := rfl

theorem pos_factor {k d u N : ℕ} (hk : 1 ≤ k) (hd : 1 ≤ d) (hu : 1 ≤ u)
    (hN : d ^ k * u ≤ N) : d ≤ N ∧ u ≤ N := by
  have hd₂ : d ≤ d ^ k := by
    calc d = d ^ 1 := (pow_one d).symm
      _ ≤ d ^ k := Nat.pow_le_pow_right (by omega) hk
  have hsq : 0 < d ^ k := pow_pos (by omega) k
  have hdN : d ^ k ≤ d ^ k * u := Nat.le_mul_of_pos_right _ (by omega)
  have huN : u ≤ d ^ k * u := Nat.le_mul_of_pos_left _ hsq
  exact ⟨hd₂.trans (hdN.trans hN), huN.trans hN⟩

theorem tail_crude (k : ℕ) (hk : 1 ≤ k) (x : ℝ) (hx : 2 ≤ x) :
    ((tailT k x).ncard : ℝ) ≤ (x + 1) ^ 4 := by
  let M := ⌊x⌋₊ + 1
  let B : Finset Point :=
    ((Finset.Icc 1 M) ×ˢ (Finset.Icc 1 M)) ×ˢ ((Finset.Icc 1 M) ×ˢ (Finset.Icc 1 M))
  have hsub : tailT k x ⊆ ↑B := by
    rintro ⟨⟨d, e⟩, ⟨u, v⟩⟩ h
    rcases h with ⟨hd, he, hu, hv, hxle, heq, hde⟩
    dsimp only at hd he hu hv hxle heq hde
    have hn : d ^ k * u ≤ ⌊x⌋₊ := Nat.le_floor hxle
    have hn' : e ^ k * v ≤ ⌊x⌋₊ + 1 := by rw [heq]; exact Nat.add_le_add_right hn 1
    rcases pos_factor hk hd hu hn with ⟨hdN, huN⟩
    rcases pos_factor hk he hv hn' with ⟨heN, hvN⟩
    change ((d, e), (u, v)) ∈ B
    simp only [B, M, Finset.mem_product, Finset.mem_Icc]
    omega
  have h1 : (tailT k x).ncard ≤ B.card := by
    calc (tailT k x).ncard ≤ (↑B : Set Point).ncard := Set.ncard_le_ncard hsub (Finset.finite_toSet B)
      _ = B.card := Set.ncard_coe_finset B
  have hI : (Finset.Icc 1 M).card = M := by simp [Nat.card_Icc]
  have h2 : B.card = M ^ 4 := by
    simp only [B, Finset.card_product, hI]
    ring
  have h3 : (M : ℝ) ≤ x + 1 := by
    have hf : ((⌊x⌋₊ : ℕ) : ℝ) ≤ x := Nat.floor_le (by linarith)
    simp only [M]
    push_cast
    linarith
  have h4 : ((tailT k x).ncard : ℝ) ≤ (M : ℝ) ^ 4 := by
    have : ((tailT k x).ncard : ℝ) ≤ (B.card : ℝ) := by exact_mod_cast h1
    rw [h2] at this
    push_cast at this
    exact this
  exact h4.trans (pow_le_pow_left₀ (by positivity) h3 4)

theorem exc_le (k : ℕ) (S : Set Point) (x : ℝ) (hfin : (excT k S x).Finite) :
    (tailT k x ∩ S).ncard ≤ (excT k S x).ncard := by
  apply Set.ncard_le_ncard _ hfin
  rintro q ⟨⟨hd, he, hu, hv, hxle, heq, hcut⟩, hexc⟩
  exact ⟨hd, he, hu, hv, heq, hxle, hexc⟩

theorem theta_lb (k : ℕ) (hk : 5 ≤ k) :
    (1 : ℝ) / (k : ℝ) + 1 / (2 * (k : ℝ) ^ 2) ≤ thetaK k := by
  have hkR : (5 : ℝ) ≤ (k : ℝ) := by exact_mod_cast hk
  have hk0 : (k : ℝ) ≠ 0 := by positivity
  have hkp : (0 : ℝ) < (k : ℝ) := by positivity
  have h21 : (2 * (k : ℝ) + 1) ≠ 0 := by positivity
  have hR : 24 * (k : ℝ) + 5 ≤ Real.sqrt (580 * (k : ℝ) ^ 2 + 276 * (k : ℝ) + 9) := by
    apply Real.le_sqrt_of_sq_le
    nlinarith
  show (1 : ℝ) / (k : ℝ) + 1 / (2 * (k : ℝ) ^ 2) ≤
    ((3 * (k : ℝ) + 2) * ((2 * (k : ℝ) - 3 + Real.sqrt (580 * (k : ℝ) ^ 2 + 276 * (k : ℝ) + 9)) /
      (9 * (k : ℝ) * (2 * (k : ℝ) + 1))) - 2) / (2 * (k : ℝ) + 1)
  have hs : (26 * (k : ℝ) + 2) / (9 * (k : ℝ) * (2 * (k : ℝ) + 1)) ≤
      (2 * (k : ℝ) - 3 + Real.sqrt (580 * (k : ℝ) ^ 2 + 276 * (k : ℝ) + 9)) /
        (9 * (k : ℝ) * (2 * (k : ℝ) + 1)) := by
    apply div_le_div_of_nonneg_right _ (by positivity)
    linarith
  have hθ : ((3 * (k : ℝ) + 2) * ((26 * (k : ℝ) + 2) / (9 * (k : ℝ) * (2 * (k : ℝ) + 1))) - 2) /
        (2 * (k : ℝ) + 1) ≤
      ((3 * (k : ℝ) + 2) * ((2 * (k : ℝ) - 3 + Real.sqrt (580 * (k : ℝ) ^ 2 + 276 * (k : ℝ) + 9)) /
        (9 * (k : ℝ) * (2 * (k : ℝ) + 1))) - 2) / (2 * (k : ℝ) + 1) := by
    apply div_le_div_of_nonneg_right _ (by positivity)
    have h32 : (0 : ℝ) ≤ 3 * (k : ℝ) + 2 := by positivity
    linarith [mul_le_mul_of_nonneg_left hs h32]
  have key : (1 : ℝ) / (k : ℝ) + 1 / (2 * (k : ℝ) ^ 2) ≤
      ((3 * (k : ℝ) + 2) * ((26 * (k : ℝ) + 2) / (9 * (k : ℝ) * (2 * (k : ℝ) + 1))) - 2) /
        (2 * (k : ℝ) + 1) := by
    rw [← sub_nonneg]
    have e : ((3 * (k : ℝ) + 2) * ((26 * (k : ℝ) + 2) / (9 * (k : ℝ) * (2 * (k : ℝ) + 1))) - 2) /
          (2 * (k : ℝ) + 1) - ((1 : ℝ) / (k : ℝ) + 1 / (2 * (k : ℝ) ^ 2)) =
        (12 * (k : ℝ) ^ 3 - 28 * (k : ℝ) ^ 2 - 46 * (k : ℝ) - 9) /
          (18 * (k : ℝ) ^ 2 * (2 * (k : ℝ) + 1) ^ 2) := by
      field_simp
      ring
    rw [e]
    apply div_nonneg _ (by positivity)
    nlinarith [mul_nonneg (sub_nonneg.mpr hkR)
      (by positivity : (0 : ℝ) ≤ 12 * (k : ℝ) ^ 2 + 32 * (k : ℝ) + 114)]
  exact key.trans hθ

theorem rpow_inv_pow (X : ℝ) (hX : 0 ≤ X) (k : ℕ) (hk : k ≠ 0) :
    (X ^ ((1 : ℝ) / (k : ℝ))) ^ k = X := by
  rw [← Real.rpow_natCast, ← Real.rpow_mul hX]
  have hk' : (k : ℝ) ≠ 0 := by exact_mod_cast hk
  have h1 : (1 : ℝ) / (k : ℝ) * (k : ℝ) = 1 := by field_simp
  rw [h1, Real.rpow_one]

theorem log_cap (x : ℝ) (hx : 2 ≤ x) :
    ((Nat.log 2 ⌊x⌋₊ : ℕ) : ℝ) * Real.log 2 ≤ Real.log x := by
  have hm1 : 1 ≤ ⌊x⌋₊ := Nat.le_floor (by norm_num; linarith)
  have hm : ⌊x⌋₊ ≠ 0 := by omega
  have h1 : 2 ^ (Nat.log 2 ⌊x⌋₊) ≤ ⌊x⌋₊ := Nat.pow_log_le_self 2 hm
  have h2 : (2 : ℝ) ^ (Nat.log 2 ⌊x⌋₊) ≤ x := by
    have h1R : (2 : ℝ) ^ (Nat.log 2 ⌊x⌋₊) ≤ ((⌊x⌋₊ : ℕ) : ℝ) := by exact_mod_cast h1
    exact h1R.trans (Nat.floor_le (by linarith))
  have h3 : Real.log ((2 : ℝ) ^ (Nat.log 2 ⌊x⌋₊)) ≤ Real.log x :=
    Real.log_le_log (by positivity) h2
  rw [Real.log_pow] at h3
  exact h3

theorem cap_power3 (δ : ℝ) (hδ : 0 < δ) : ∃ A : ℝ, 0 < A ∧ ∀ x : ℝ, 2 ≤ x →
    ((Nat.log 2 ⌊x⌋₊ : ℝ) + 2) ^ 3 ≤ A * x ^ δ := by
  obtain ⟨β, hβdef⟩ : ∃ β : ℝ, β = δ / 3 := ⟨_, rfl⟩
  have hβ : 0 < β := by rw [hβdef]; positivity
  have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  obtain ⟨c, hc⟩ : ∃ c : ℝ, c = 1 / (β * Real.log 2) := ⟨_, rfl⟩
  have hc0 : 0 < c := by rw [hc]; positivity
  refine ⟨(2 + c) ^ 3, by positivity, ?_⟩
  intro x hx
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hxβ : 1 ≤ x ^ β := Real.one_le_rpow hx1 hβ.le
  have hlog : Real.log x ≤ x ^ β / β := Real.log_le_rpow_div hx0.le hβ
  have hL := log_cap x hx
  have h5 : x ^ β / β / Real.log 2 = c * x ^ β := by rw [hc]; ring
  have hn : ((Nat.log 2 ⌊x⌋₊ : ℕ) : ℝ) ≤ c * x ^ β := by
    rw [← h5, le_div_iff₀ hlog2]
    linarith
  have hLA : (Nat.log 2 ⌊x⌋₊ : ℝ) + 2 ≤ (2 + c) * x ^ β := by
    have hcx : 0 ≤ c * x ^ β := by positivity
    calc (Nat.log 2 ⌊x⌋₊ : ℝ) + 2 ≤ c * x ^ β + 2 * x ^ β := by linarith
      _ = (2 + c) * x ^ β := by ring
  have hL0 : 0 ≤ (Nat.log 2 ⌊x⌋₊ : ℝ) + 2 := by positivity
  have hp : (x ^ β) ^ 3 = x ^ δ := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul hx0.le]
    congr 1
    rw [hβdef]
    push_cast
    ring
  calc ((Nat.log 2 ⌊x⌋₊ : ℝ) + 2) ^ 3 ≤ ((2 + c) * x ^ β) ^ 3 := pow_le_pow_left₀ hL0 hLA 3
    _ = (2 + c) ^ 3 * x ^ δ := by rw [mul_pow, hp]

theorem large_product_min_k (k : ℕ) (hk : 1 ≤ k) (X D E c : ℝ) (hX : 0 < X) (hD : 0 < D)
    (hE : 0 < E) (hc0 : 0 < c) (hck : c ^ k = X) (h1 : c ^ 2 ≤ D * E) :
    min (E * (X / D ^ k)) (D * (X / E ^ k)) ≤ c := by
  obtain ⟨m, rfl⟩ : ∃ m, k = m + 1 := ⟨k - 1, by omega⟩
  have hDE : 0 < D * E := mul_pos hD hE
  have hD' : D ≠ 0 := hD.ne'
  have hE' : E ≠ 0 := hE.ne'
  have hAB : (E * (X / D ^ (m + 1))) * (D * (X / E ^ (m + 1))) * (D * E) ^ m = X * X := by
    field_simp
    ring
  have hp : c ^ 2 * (c ^ 2) ^ m = X * X := by
    rw [← hck]
    ring
  have hm : (c ^ 2) ^ m ≤ (D * E) ^ m := pow_le_pow_left₀ (by positivity) h1 m
  have hABle : (E * (X / D ^ (m + 1))) * (D * (X / E ^ (m + 1))) ≤ c ^ 2 := by
    have hpos : 0 < (D * E) ^ m := by positivity
    have hcm : 0 ≤ c ^ 2 := by positivity
    have h' : (E * (X / D ^ (m + 1))) * (D * (X / E ^ (m + 1))) * (D * E) ^ m ≤
        c ^ 2 * (D * E) ^ m := by
      calc (E * (X / D ^ (m + 1))) * (D * (X / E ^ (m + 1))) * (D * E) ^ m = X * X := hAB
        _ = c ^ 2 * (c ^ 2) ^ m := hp.symm
        _ ≤ c ^ 2 * (D * E) ^ m := mul_le_mul_of_nonneg_left hm hcm
    exact le_of_mul_le_mul_right h' hpos
  by_contra hcon
  push Not at hcon
  have hA : c < E * (X / D ^ (m + 1)) := lt_of_lt_of_le hcon (min_le_left _ _)
  have hB : c < D * (X / E ^ (m + 1)) := lt_of_lt_of_le hcon (min_le_right _ _)
  have hprod : c * c < (E * (X / D ^ (m + 1))) * (D * (X / E ^ (m + 1))) :=
    mul_lt_mul'' hA hB hc0.le hc0.le
  nlinarith

theorem first_term_k (k : ℕ) (hk : 1 ≤ k) (X D E c : ℝ) (hc0 : 0 < c) (hck : c ^ k = X)
    (hDE : 0 < D * E) (hcDE : c ≤ D * E) : X / (D * E) ^ (k - 1) ≤ c := by
  obtain ⟨m, rfl⟩ : ∃ m, k = m + 1 := ⟨k - 1, by omega⟩
  simp only [Nat.add_sub_cancel]
  rw [div_le_iff₀ (by positivity)]
  have h' : c ^ m ≤ (D * E) ^ m := pow_le_pow_left₀ hc0.le hcDE m
  have hX : X = c * c ^ m := by rw [← hck]; ring
  rw [hX]
  exact mul_le_mul_of_nonneg_left h' hc0.le

theorem collar_bound_k (k : ℕ) (hk : 1 ≤ k) (X D E : ℝ) (hX : 1 ≤ X) (hD : 0 < D) (hE : 0 < E)
    (hDEk : X < (D * E) ^ k) (hDk : D ^ k < 2 ^ k * X) (hEk : E ^ k < 2 ^ k * (X + 1))
    (hcol : ¬ NonCollarK k X D E) :
    X / (D * E) ^ (k - 1) + min (E * (X / D ^ k)) (D * (X / E ^ k)) ≤
      5 * X ^ ((1 : ℝ) / (k : ℝ) + 1 / (2 * (k : ℝ) ^ 2)) := by
  have hX0 : 0 < X := by linarith
  have hDE : 0 < D * E := mul_pos hD hE
  have hk0 : k ≠ 0 := by omega
  have hkR : (1 : ℝ) ≤ (k : ℝ) := by exact_mod_cast hk
  have hkp : (0 : ℝ) < (k : ℝ) := by linarith
  obtain ⟨c, hc⟩ : ∃ c : ℝ, c = X ^ ((1 : ℝ) / (k : ℝ)) := ⟨_, rfl⟩
  obtain ⟨w, hw⟩ : ∃ w : ℝ, w = X ^ ((1 : ℝ) / (2 * (k : ℝ) ^ 2)) := ⟨_, rfl⟩
  obtain ⟨G, hG⟩ : ∃ G : ℝ, G = X ^ ((1 : ℝ) / (k : ℝ) + 1 / (2 * (k : ℝ) ^ 2)) := ⟨_, rfl⟩
  have hc0 : 0 < c := by rw [hc]; exact Real.rpow_pos_of_pos hX0 _
  have hw0 : 0 < w := by rw [hw]; exact Real.rpow_pos_of_pos hX0 _
  have hG0 : 0 ≤ G := by rw [hG]; positivity
  have hck : c ^ k = X := by rw [hc]; exact rpow_inv_pow X hX0.le k hk0
  have hcwG : c * w = G := by rw [hc, hw, hG, ← Real.rpow_add hX0]
  have hc1 : 1 ≤ c := by rw [hc]; exact Real.one_le_rpow hX (by positivity)
  have hw1 : 1 ≤ w := by rw [hw]; exact Real.one_le_rpow hX (by positivity)
  have hcG : c ≤ G := by rw [← hcwG]; nlinarith
  have hwk1 : w ^ (k + 1) ≤ G := by
    rw [hw, hG, ← Real.rpow_natCast, ← Real.rpow_mul hX0.le]
    apply Real.rpow_le_rpow_of_exponent_le hX
    have e : (1 : ℝ) / (k : ℝ) + 1 / (2 * (k : ℝ) ^ 2) -
        1 / (2 * (k : ℝ) ^ 2) * (((k + 1 : ℕ) : ℝ)) = 1 / (2 * (k : ℝ)) := by
      push_cast
      field_simp
      ring
    have hpos : (0 : ℝ) ≤ 1 / (2 * (k : ℝ)) := by positivity
    linarith
  have hcDE : c ≤ D * E := by
    by_contra h
    push Not at h
    have h' : (D * E) ^ k < c ^ k := pow_lt_pow_left₀ h hDE.le hk0
    linarith
  have hfirst : X / (D * E) ^ (k - 1) ≤ c := first_term_k k hk X D E c hc0 hck hDE hcDE
  have h2k : (2 : ℝ) ≤ 2 ^ k := by
    calc (2 : ℝ) = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ k := pow_le_pow_right₀ (by norm_num) hk
  have hmin : min (E * (X / D ^ k)) (D * (X / E ^ k)) ≤ 4 * G := by
    unfold NonCollarK at hcol
    rw [← hw] at hcol
    by_cases h1 : D * E < X ^ ((2 : ℝ) / (k : ℝ))
    · by_cases h2 : w < D
      · by_cases h3 : w < E
        · by_cases h4 : w * D ^ k < X
          · by_cases h5 : w * E ^ k < X
            · exact absurd ⟨h1, h2, h3, h4, h5⟩ hcol
            · push Not at h5
              have hDc : D < 2 * c := by
                by_contra h
                push Not at h
                have h' : (2 * c) ^ k ≤ D ^ k := pow_le_pow_left₀ (by positivity) h k
                rw [mul_pow, hck] at h'
                linarith
              have hXE : X / E ^ k ≤ w := by
                rw [div_le_iff₀ (by positivity)]
                linarith
              calc min (E * (X / D ^ k)) (D * (X / E ^ k)) ≤ D * (X / E ^ k) := min_le_right _ _
                _ ≤ (2 * c) * w := mul_le_mul hDc.le hXE (by positivity) (by positivity)
                _ = 2 * G := by rw [← hcwG]; ring
                _ ≤ 4 * G := by linarith
          · push Not at h4
            have hEc : E < 4 * c := by
              by_contra h
              push Not at h
              have h' : (4 * c) ^ k ≤ E ^ k := pow_le_pow_left₀ (by positivity) h k
              rw [mul_pow, hck] at h'
              have h44 : (4 : ℝ) ^ k = 2 ^ k * 2 ^ k := by rw [← mul_pow]; norm_num
              have hpos : (0 : ℝ) < 2 ^ k := by positivity
              have hA1 : (2 : ℝ) ^ k * (X + 1) ≤ 2 ^ k * (2 * X) :=
                mul_le_mul_of_nonneg_left (by linarith) hpos.le
              have hA2 : (2 : ℝ) ^ k * 2 * X ≤ 2 ^ k * 2 ^ k * X :=
                mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left h2k hpos.le) hX0.le
              rw [h44] at h'
              nlinarith
            have hXD : X / D ^ k ≤ w := by
              rw [div_le_iff₀ (by positivity)]
              linarith
            calc min (E * (X / D ^ k)) (D * (X / E ^ k)) ≤ E * (X / D ^ k) := min_le_left _ _
              _ ≤ (4 * c) * w := mul_le_mul hEc.le hXD (by positivity) (by positivity)
              _ = 4 * G := by rw [← hcwG]; ring
        · push Not at h3
          have hEk1 : E ^ (k + 1) ≤ w ^ (k + 1) := pow_le_pow_left₀ hE.le h3 (k + 1)
          have hstep : E * (X / D ^ k) ≤ E ^ (k + 1) := by
            rw [mul_div_assoc', div_le_iff₀ (by positivity)]
            have h' : E * X < E * (D * E) ^ k := mul_lt_mul_of_pos_left hDEk hE
