    rw [Finset.set_biUnion_insert, Finset.sum_insert ha]
    exact (Set.ncard_union_le _ _).trans (Nat.add_le_add_left ih _)

theorem cover (k : ℕ) (hk : 1 ≤ k) (x : ℝ) (hx : 2 ≤ x) (S : Set Point) :
    (tail k x).ncard ≤ (tail k x ∩ S).ncard +
      ∑ j ∈ Finset.range (Nat.log 2 ⌊x⌋₊ + 2), ∑ a ∈ Finset.range (Nat.log 2 ⌊x⌋₊ + 2),
