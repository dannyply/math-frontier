  rw [Submodule.map_comp]
  have hi:uX (LinearMap.mulRight ℚ (t⁻¹^m):K→ₗ[ℚ] K):=by
    intro x y hxy
    change x*t⁻¹^m=y*t⁻¹^m at hxy
    exact da (u5 m (inv_ne_zero ht)) hxy
  exact (LinearEquiv.finrank_eq
    (fw (LinearMap.mulRight ℚ (t⁻¹^m)) hi _)).symm
