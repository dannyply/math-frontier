lemma j6 {R:Type*} [CommRing R] (p:aa (Fin 4) R)
    (alpha beta:ℕ)
    (hp:∀ m∈ p.support,m 0+m 1=alpha∧ m 2+m 3=beta)
    (a b c d g h:R):
    eval ![g*a,g*b,h*c,h*d] p= g^alpha*h^beta*eval ![a,b,c,d] p:=by
  rw [eval_eq',eval_eq',cD]
  refine u4 rfl (fun m hm=>?_)
  obtain ⟨h1,h2⟩:=hp m hm
  rw [Fin.prod_univ_four,Fin.prod_univ_four]
  show coeff m p*((g*a)^m 0*(g*b)^m 1*(h*c)^m 2*(h*d)^m 3)= g^alpha*h^beta*(coeff m p*(a^m 0*b^m 1*c^m 2*d^m 3))
  rw [←h1,←h2]
  ring
lemma pk (k:ℕ) (g:wC) (alpha beta:ℕ)
    (hg:∀ m∈ g.support,m 0+m 1=alpha∧ m 2+m 3=beta):
    am (ah.au k g)=x 0^(k*beta)*down k (dehom g):=by
  have hmap:∀ m∈(uJ (am.comp C) g).support,m 0+m 1=alpha∧ m 2+m 3=beta:=by
    intro m hm
    exact hg m (support_map_subset _ _ hm)
  have hs:=j6 (uJ (am.comp C) g) alpha beta hmap
    (x 0) (x 1) ((x 1^k-x 2)*di^k) 1 1 (x 0^k)
  have vf:x 0^k*((x 1^k-x 2)*di^k)=x 1^k-x 2:=by
    calc
      _=(x 1^k-x 2)*(x 0*di)^k:=by ring
      _=_:=by rw [x_di];ring
  simp only [one_mul,one_pow,mul_one,vf] at hs
  have hh:am (ah.au k g)=hdMap k g:= congrArg (fun f:wC→+*Away=> f g) (ph k)
  have hd:down k (dehom g)=gdMap k g:= congrArg (fun f:wC→+*Away=> f g) (pj k)
  rw [hh,hd]
  change eval₂ (am.comp C) ![x 0,x 1,x 1^k-x 2,x 0^k] g= x 0^(k*beta)*eval₂ (am.comp C) ![x 0,x 1,(x 1^k-x 2)*di^k,1] g
  rw [←pow_mul] at hs
  change eval₂ (RingHom.id Away) _ (uJ (am.comp C) g)= x 0^(k*beta)*eval₂ (RingHom.id Away) _ (uJ (am.comp C) g) at hs
  simpa only [eval₂_map,RingHom.id_comp] using hs
end
end ae.aL
