lemma ke (k:ℕ) (A:Mat) (h:ℤ)
    (vQ:h=1∨ h= -1) (z:Fin 4→ ℤ)
    (hzv:0≤ z 3) (L V:ℝ) (hL:0≤ L)
    (hV:(z 3:ℝ)≤ V)
    (kf:∀ i:Fin 2,|((ag A z i:ℤ):ℝ)|≤ L)
    (i:Fin (k+1)):
