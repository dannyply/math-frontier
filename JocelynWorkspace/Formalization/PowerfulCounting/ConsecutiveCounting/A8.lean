open Polynomial
noncomputable section

theorem affine_height_degree
    (F : Polynomial ℝ) (n : ℕ) (hF : F.natDegree=n)
    (z0 γ : ℝ) (hγ : γ≠0) :
    (F.comp (C z0+C γ*X)).natDegree=n := by
  have hA : (C z0+C γ*X : Polynomial ℝ).natDegree=1 := by
    rw [add_comm,Polynomial.natDegree_add_C,Polynomial.natDegree_C_mul hγ,
      Polynomial.natDegree_X]
  rw [Polynomial.natDegree_comp,hF,hA,Nat.mul_one]

theorem affine_height_derivatives
    (F : Polynomial ℝ) (z0 γ t : ℝ) :
    let N := F.comp (C z0+C γ*X)
    N.eval t=F.eval (z0+γ*t) ∧
      N.derivative.eval t=γ*F.derivative.eval (z0+γ*t) ∧
      N.derivative.derivative.eval t=γ^2*F.derivative.derivative.eval (z0+γ*t) := by
  intro N
  refine ⟨?_,?_,?_⟩
  · simp [N]
  · simp [N,Polynomial.derivative_comp]
    <;> ring
  · simp [N,Polynomial.derivative_comp]
    <;> ring

end
end A8FloorExt

