variable {K:Type*} [Field K] [Algebra ℚ K]
lemma o9 (k:ℕ) (hk:0< k)
    (d e tau:K) (htau:tau ≠ 0) (m:ℕ)
    (n:Fin 3→₀ ℕ)
    (hw:aK (af.wt k) n=k*m)
    (c0:ℚ):
    ∃ p∈ restrictTotalDegree (Fin (k+1)) ℚ m,bj k d e tau p=theta d e tau m (monomial n c0):=by
  rw [af.dJ] at hw
  have hn2:n 2≤ m:=by
    have hk1:1≤ k:=hk
    nlinarith
  let j:=m-n 2
  have hsum:n 0+n 1=k*j:=by
    have hm:n 2+j=m:=by omega
    have hmul:=congrArg (fun x:ℕ=> k*x) hm
    nlinarith [hw]
  obtain ⟨q,r,c,s0,hrest,hc,hrc,vN,hb,ha⟩:= ae.j2.o4 k j (n 0) (n 1) hk hsum
  let i0:Fin (k+1):=⟨0,by omega⟩
  let ir:Fin (k+1):=⟨r,by omega⟩
  let ik:Fin (k+1):=⟨k,by omega⟩
  let core:co k:=(X i0)^s0*(X ir)^c*(X ik)^q
  let p:co k:=C c0*core
  have hi0:(i0:ℕ)=0:=rfl
  have hir:(ir:ℕ)=r:=rfl
  have hik:(ik:ℕ)=k:=rfl
  have pa:core ≠ 0:=by
    dsimp [core]
    exact aV
      (aV (u5 s0 (X_ne_zero i0))
        (u5 c (X_ne_zero ir)))
      (u5 q (X_ne_zero ik))
  have pb:core.totalDegree≤ m:=by
    have hX0:(X i0:co k) ≠ 0:=X_ne_zero i0
    have hXr:(X ir:co k) ≠ 0:=X_ne_zero ir
    have hXk:(X ik:co k) ≠ 0:=X_ne_zero ik
    change ((X i0:co k)^s0*X ir^c*X ik^q).totalDegree≤ m
    rw [totalDegree_mul_of_isDomain
          (aV (u5 s0 hX0) (u5 c hXr))
          (u5 q hXk),totalDegree_mul_of_isDomain (u5 s0 hX0) (u5 c hXr),totalDegree_X_pow,totalDegree_X_pow,totalDegree_X_pow]
    dsimp [j] at vN ⊢
    omega
  have dC:p.totalDegree≤ m:=by
    dsimp [p]
    by_cases hc0:c0=0
    · simp [hc0]
    · rw [totalDegree_mul_of_isDomain (C_ne_zero.mpr hc0) pa]
      simpa using pb
  have hp:p∈ restrictTotalDegree (Fin (k+1)) ℚ m:=by
