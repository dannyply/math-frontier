open MvPolynomial
section
lemma jZ (alpha beta:ℕ) (hα:1≤ alpha) (hβ:1≤ beta)
    (g:aa (Fin 4) ℤ)
    (hdeg:∀ m∈ g.support,m 0+m 1=alpha∧ m 2+m 3=beta)
    (hg:uZ (uJ (uG ℂ) g)) (i:Fin 4):
    ¬ ak g∣ X i:=by
  have hu:∀ j:Fin 4,a6 j< beta→¬ ak g∣ X j:=fun j hj=>
    dH a6 (ak g) (X j) beta
      (a6 j) (cn g hg).ne_zero (X_ne_zero j)
      (jQ alpha beta g hdeg)
      (isWeightedHomogeneous_X ℚ a6 j) hj
  have hx:∀ j:Fin 4,a7 j< alpha→¬ ak g∣ X j:=fun j hj=>
    dH a7 (ak g) (X j) alpha
      (a7 j) (cn g hg).ne_zero (X_ne_zero j)
      (jR alpha beta g hdeg)
      (isWeightedHomogeneous_X ℚ a7 j) hj
  fin_cases i
  · exact hu 0 (lt_of_lt_of_le (show a6 0<1 by decide) hβ)
  · exact hu 1 (lt_of_lt_of_le (show a6 1<1 by decide) hβ)
  · exact hx 2 (lt_of_lt_of_le (show a7 2<1 by decide) hα)
  · exact hx 3 (lt_of_lt_of_le (show a7 3<1 by decide) hα)
namespace ah
lemma oV (k:ℕ) (m:Fin 4→₀ ℕ) (c:ℚ):
    au k (monomial m c)= C c*X 0^(m 0)*X 1^(m 1)*(X 1^k-X 2)^(m 2)*(X 0^k)^(m 3):=by
  change eval₂ C ![X 0,X 1,X 1^k-X 2,X 0^k] (monomial m c)=_
  rw [eval₂_monomial]
  simp [bg,Fin.prod_univ_succ,aG]
lemma oW (k:ℕ) (g:wC) (alpha beta:ℕ)
    (hg:∀ m∈ g.support,m 0+m 1=alpha∧ m 2+m 3=beta):
    uK (af.wt k) (au k g) (alpha+k*beta):=by
  classical
  let w:=af.wt k
  have hd:uK w (X (0:Fin 3):wG) 1:=by
    simpa [w,af.wt] using isWeightedHomogeneous_X ℚ w (0:Fin 3)
  have he:uK w (X (1:Fin 3):wG) 1:=by
    simpa [w,af.wt] using isWeightedHomogeneous_X ℚ w (1:Fin 3)
  have hT:uK w (X (2:Fin 3):wG) k:=by
    simpa [w,af.wt] using isWeightedHomogeneous_X ℚ w (2:Fin 3)
  have hEk:uK w (X 1^k:wG) k:=by
    convert he.pow k using 1; simp [smul_eq_mul]
  have hE:uK w (X 1^k-X 2:wG) k:=hEk.sub hT
  apply (mem_weightedHomogeneousSubmodule ℚ w (alpha+k*beta) _).mp
  rw [g.as_sum,map_sum]
  apply Submodule.sum_mem
  intro m hm
  rw [mem_weightedHomogeneousSubmodule,oV]
  have hh:=((((isWeightedHomogeneous_C w (coeff m g)).mul (hd.pow (m 0))).mul
    (he.pow (m 1))).mul (hE.pow (m 2))).mul ((hd.pow k).pow (m 3))
  obtain ⟨h1,h2⟩:=hg m hm
  convert hh using 1; simp [smul_eq_mul]; nlinarith
lemma oX (k:ℕ) (g:wC) (alpha beta nu:ℕ) (H0:wG)
    (hg:∀ m∈ g.support,m 0+m 1=alpha∧ m 2+m 3=beta)
    (hH:au k g=X 0^nu*H0):
    uK (af.wt k) H0 (alpha+k*beta-nu):=by
  have hx:uK (af.wt k)
      (X (0:Fin 3):wG) 1:=by
    simpa [af.wt] using
      isWeightedHomogeneous_X ℚ (af.wt k) (0:Fin 3)
  have hp:uK (af.wt k)
      (X (0:Fin 3)^nu:wG) nu:=by simpa using hx.pow nu
  have hh:=oW k g alpha beta hg
  rw [hH] at hh
  exact af.fS k (X 0^nu) H0 nu (alpha+k*beta)
    hp (u5 nu (by simp)) hh
lemma oY (p:wG) (nu:ℕ)
    (hdiv:(X (0:Fin 3):wG)^nu∣p)
    (m:Fin 3→₀ ℕ) (hm:m∈p.support):nu≤ m 0:=by
  classical
  obtain ⟨q,hq⟩:=hdiv
  have hc:coeff m p≠0:=mem_support_iff.mp hm
