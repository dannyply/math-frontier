    have hpow : 2 ^ m ≤ 2 ^ (Nat.clog 2 d).pred := Nat.pow_le_pow_right (by norm_num) hm
    exact absurd (lt_of_le_of_lt (h.trans hpow) hlt) (lt_irrefl d)
