    dle _ _ _ (by nlinarith [mul_le_mul_of_nonneg_left hm (by linarith : (0 : ℝ) ≤ 3 * kk + 1)]) h4
  linarith

theorem B2pre (kk sl s t m : ℝ) (hk5 : 5 ≤ kk) (hslk : 1 ≤ kk * sl) (hslt : sl ≤ t)
    (hsl' : sl ≤ s) (hs2 : s ≤ t)
    (hm1 : (9 : ℝ) / 8 * s * (2 - kk * s) ≤ m)
    (hm2 : m ≤ (9 : ℝ) / 8 * s * (2 - kk * s) + 1 / 2000) :
    (9 : ℝ) / 8 * t * (2 - kk * t) ≤ m ∧ m ≤ (9 : ℝ) / 8 * sl * (2 - kk * sl) + 1 / 2000 := by
  have hk0 : (0 : ℝ) < kk := by linarith
  have hks1 : 0 ≤ kk * (t + s) - 2 := by
    nlinarith [mul_le_mul_of_nonneg_left hsl' hk0.le, mul_le_mul_of_nonneg_left hslt hk0.le]
  have hks2 : 0 ≤ kk * (s + sl) - 2 := by
    nlinarith [mul_le_mul_of_nonneg_left hsl' hk0.le]
  have hmt := m0mono kk t s hs2 hks1
  have hms := m0mono kk s sl hsl' hks2
  exact ⟨le_trans hmt hm1, by linarith⟩

theorem c1 (m TH Tl a1 : ℝ) (cb : 0 < Tl - (a1 + 1 / 2000)) (hTl : Tl ≤ TH)
    (hmhi : m ≤ a1 + 1 / 2000) : 0 < (TH - m) / 2 := by
  linarith

theorem c2 (kk s m TH sl a1 Tu : ℝ) (hk5 : 5 ≤ kk) (hsl' : sl ≤ s) (hmhi : m ≤ a1 + 1 / 2000)
    (hTu : TH ≤ Tu) (csig : 0 < sl - (a1 + 1 / 2000) / 2 - Tu / 2) :
    0 < (kk + 1) * (s - m - (TH - m) / 2) / (3 * kk + 2) := by
  refine div_pos (mul_pos (by linarith) ?_) (by linarith)
  linarith

theorem c3 (kk s m TH sl a Tl : ℝ) (hk5 : 5 ≤ kk) (hsl' : sl ≤ s) (hmlo : a ≤ m) (hTl : Tl ≤ TH)
    (crho : 0 < kk * (2 * kk + 1) * (kk - 3) * sl + (2 * kk ^ 3 - 3 * kk ^ 2 - 2 * kk + 1) * a +
      (2 * kk ^ 3 + 9 * kk ^ 2 + 6 * kk + 1) * Tl - 2 * kk * (3 * kk + 2)) :
    0 < (4 * kk * ((TH - m) / 2) - 2 * kk + (2 * kk ^ 2 - kk + 1) * s) / (2 * kk + 1) -
      2 * (2 * kk ^ 2 + kk + 1) / (2 * kk + 1) * ((kk + 1) * (s - m - (TH - m) / 2) / (3 * kk + 2)) := by
  have hk0 : (0 : ℝ) < kk := by linarith
  have hD2 : (0 : ℝ) < 2 * kk + 1 := by linarith
  have hD3 : (0 : ℝ) < 3 * kk + 2 := by linarith
  have hne1 : (2 * kk + 1) ≠ 0 := ne_of_gt hD2
  have hne2 : (3 * kk + 2) ≠ 0 := ne_of_gt hD3
  have hcs : 0 ≤ kk * (2 * kk + 1) * (kk - 3) :=
    mul_nonneg (mul_nonneg hk0.le hD2.le) (by linarith)
  have hcm : 0 ≤ 2 * kk ^ 3 - 3 * kk ^ 2 - 2 * kk + 1 := by
    nlinarith [mul_nonneg (sub_nonneg.mpr hk5)
      (by nlinarith [sq_nonneg kk] : (0 : ℝ) ≤ 2 * kk ^ 2 + 7 * kk + 33)]
  have hct : 0 ≤ 2 * kk ^ 3 + 9 * kk ^ 2 + 6 * kk + 1 := by
    nlinarith [pow_pos hk0 3, sq_nonneg kk]
  have key : (4 * kk * ((TH - m) / 2) - 2 * kk + (2 * kk ^ 2 - kk + 1) * s) / (2 * kk + 1) -
      2 * (2 * kk ^ 2 + kk + 1) / (2 * kk + 1) * ((kk + 1) * (s - m - (TH - m) / 2) / (3 * kk + 2)) =
      (kk * (2 * kk + 1) * (kk - 3) * s + (2 * kk ^ 3 - 3 * kk ^ 2 - 2 * kk + 1) * m +
        (2 * kk ^ 3 + 9 * kk ^ 2 + 6 * kk + 1) * TH - 2 * kk * (3 * kk + 2)) /
      ((2 * kk + 1) * (3 * kk + 2)) := by
    field_simp
    ring
  have hnum : 0 < kk * (2 * kk + 1) * (kk - 3) * s + (2 * kk ^ 3 - 3 * kk ^ 2 - 2 * kk + 1) * m +
      (2 * kk ^ 3 + 9 * kk ^ 2 + 6 * kk + 1) * TH - 2 * kk * (3 * kk + 2) := by
    nlinarith [mul_nonneg hcs (sub_nonneg.mpr hsl'), mul_nonneg hcm (sub_nonneg.mpr hmlo),
      mul_nonneg hct (sub_nonneg.mpr hTl)]
  have hpos := div_pos hnum (mul_pos hD2 hD3)
  linarith [key, hpos]

theorem c4 (kk s m TH t a Tl : ℝ) (hk5 : 5 ≤ kk) (hs2 : s ≤ t) (hmlo : a ≤ m) (hTl : Tl ≤ TH)
    (ctau : 0 < (2 * kk ^ 2 + 3 * kk + 3) / 2 * Tl + (2 * kk ^ 2 + 3 * kk - 1) / 2 * a - 2 * t -
      2 * kk - 2) :
    0 < ((2 * kk ^ 2 + 3 * kk + 3) * ((TH - m) / 2) - 2 * s - 2 * kk - 2) / (2 * kk + 1) +
      (kk + 1) * m := by
  have hk0 : (0 : ℝ) < kk := by linarith
  have hD2 : (0 : ℝ) < 2 * kk + 1 := by linarith
  have hne1 : (2 * kk + 1) ≠ 0 := ne_of_gt hD2
  have hc1 : 0 ≤ (2 * kk ^ 2 + 3 * kk + 3) / 2 := by nlinarith [sq_nonneg kk]
  have hc2 : 0 ≤ (2 * kk ^ 2 + 3 * kk - 1) / 2 := by nlinarith [sq_nonneg kk]
  have key : ((2 * kk ^ 2 + 3 * kk + 3) * ((TH - m) / 2) - 2 * s - 2 * kk - 2) / (2 * kk + 1) +
      (kk + 1) * m =
      ((2 * kk ^ 2 + 3 * kk + 3) / 2 * TH + (2 * kk ^ 2 + 3 * kk - 1) / 2 * m -
        2 * s - 2 * kk - 2) / (2 * kk + 1) := by
    field_simp
    ring
  have hnum : 0 < (2 * kk ^ 2 + 3 * kk + 3) / 2 * TH +
      (2 * kk ^ 2 + 3 * kk - 1) / 2 * m - 2 * s - 2 * kk - 2 := by
    nlinarith [mul_nonneg hc1 (sub_nonneg.mpr hTl), mul_nonneg hc2 (sub_nonneg.mpr hmlo)]
  have hpos := div_pos hnum hD2
  linarith [key, hpos]

theorem c5 (kk s m TH t a Tl : ℝ) (hk5 : 5 ≤ kk) (hs2 : s ≤ t) (hmlo : a ≤ m) (hTl : Tl ≤ TH)
    (cnu : 0 < (kk + 2) / 2 * Tl + kk / 2 * a - t - 1) :
    0 < (kk + 2) * ((TH - m) / 2) + (kk + 1) * m - s - 1 := by
  nlinarith [mul_nonneg (by linarith : (0 : ℝ) ≤ (kk + 2) / 2) (sub_nonneg.mpr hTl),
    mul_nonneg (by linarith : (0 : ℝ) ≤ kk / 2) (sub_nonneg.mpr hmlo)]

theorem c6 (kk m a : ℝ) (hk5 : 5 ≤ kk) (hmlo : a ≤ m) (com : 0 < 2 * (2 * kk - 1) * a - 2) :
    0 < (2 * (2 * kk - 1) * m - 2) / (2 * kk + 1) := by
  have hD2 : (0 : ℝ) < 2 * kk + 1 := by linarith
  refine div_pos ?_ hD2
  nlinarith [mul_nonneg (by linarith : (0 : ℝ) ≤ 2 * (2 * kk - 1)) (sub_nonneg.mpr hmlo)]

theorem core (k : ℕ) (hk : 5 ≤ k) (W TH : ℝ)
    (hW : W = (2 * (k : ℝ) - 3 + Real.sqrt (580 * (k : ℝ) ^ 2 + 276 * (k : ℝ) + 9)) /
      (9 * (k : ℝ) * (2 * (k : ℝ) + 1)))
    (hTH : TH = ((3 * (k : ℝ) + 2) * W - 2) / (2 * (k : ℝ) + 1))
    (wl wu sl t : ℝ) (hc : Cert k wl wu sl t) :
    ∃ t : ℝ, W ≤ t ∧ t ≤ 14 / (9 * (k : ℝ)) ∧
      (∀ s : ℝ, t ≤ s → s ≤ 26 / (9 * (k : ℝ)) - W →
        (2 + (3 * (k : ℝ) + 1) * ((9 : ℝ) / 8 * s * (2 - (k : ℝ) * s))) / (4 * (k : ℝ) + 2) ≤ TH) ∧
      ∀ s : ℝ, W ≤ s → s ≤ t → ∀ m : ℝ, (9 : ℝ) / 8 * s * (2 - (k : ℝ) * s) ≤ m →
        m ≤ (9 : ℝ) / 8 * s * (2 - (k : ℝ) * s) + 1 / 2000 → SixM k s m ((TH - m) / 2) := by
  obtain ⟨hwl0, hwl, hwu0, hwu, hsl, hslk, ht1, ht2, hJ, cb, csig, crho, ctau, cnu, com⟩ := hc
  have hkr : (5 : ℝ) ≤ (k : ℝ) := by exact_mod_cast hk
  have hk0 : (0 : ℝ) < (k : ℝ) := by linarith
  have hD : (0 : ℝ) < 9 * (k : ℝ) * (2 * (k : ℝ) + 1) := mul_pos (by linarith) (by linarith)
  have hD2 : (0 : ℝ) < 2 * (k : ℝ) + 1 := by linarith
  have hD3 : (0 : ℝ) < 3 * (k : ℝ) + 2 := by linarith
  have hP0 : (0 : ℝ) ≤ 580 * (k : ℝ) ^ 2 + 276 * (k : ℝ) + 9 := by positivity
  have hw1 := sqrt_lo _ _ hP0 hwl0 hwl
  have hw2 := sqrt_hi _ _ hP0 hwu0 hwu
  have hWl : (2 * (k : ℝ) - 3 + wl) / (9 * (k : ℝ) * (2 * (k : ℝ) + 1)) ≤ W := by
    rw [hW]; exact dle _ _ _ (by linarith) hD
  have hWu : W ≤ (2 * (k : ℝ) - 3 + wu) / (9 * (k : ℝ) * (2 * (k : ℝ) + 1)) := by
    rw [hW]; exact dle _ _ _ (by linarith) hD
  have hTl : ((3 * (k : ℝ) + 2) * ((2 * (k : ℝ) - 3 + wl) / (9 * (k : ℝ) * (2 * (k : ℝ) + 1))) - 2) /
      (2 * (k : ℝ) + 1) ≤ TH := by
    rw [hTH]
    exact dle _ _ _ (lem_tl (k : ℝ) _ _ hD3 hWl) hD2
  have hTu : TH ≤ ((3 * (k : ℝ) + 2) * ((2 * (k : ℝ) - 3 + wu) / (9 * (k : ℝ) * (2 * (k : ℝ) + 1))) - 2) /
      (2 * (k : ℝ) + 1) := by
    rw [hTH]
    exact dle _ _ _ (lem_tl (k : ℝ) _ _ hD3 hWu) hD2
  have hslt : sl ≤ t := le_trans hsl (le_trans hWl (le_trans hWu ht1))
  refine ⟨t, le_trans hWu ht1, ht2, ?_, ?_⟩
  · intro s hs1 _
    exact B1 (k : ℝ) sl s t _ TH hkr hslk hslt hs1 hJ hTl
  · intro s hs1 hs2 m hm1 hm2
    have hsl' : sl ≤ s := le_trans hsl (le_trans hWl hs1)
    obtain ⟨hmlo, hmhi⟩ := B2pre (k : ℝ) sl s t m hkr hslk hslt hsl' hs2 hm1 hm2
    exact ⟨c1 m TH _ _ cb hTl hmhi, c2 (k : ℝ) s m TH sl _ _ hkr hsl' hmhi hTu csig,
      c3 (k : ℝ) s m TH sl _ _ hkr hsl' hmlo hTl crho,
      c4 (k : ℝ) s m TH t _ _ hkr hs2 hmlo hTl ctau,
      c5 (k : ℝ) s m TH t _ _ hkr hs2 hmlo hTl cnu, c6 (k : ℝ) m _ hkr hmlo com⟩

