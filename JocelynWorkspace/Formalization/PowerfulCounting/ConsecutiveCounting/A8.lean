namespace A8HighFPriceFactor
private theorem totalDegree_le_bihom (F : Poly) (a b : ℕ)
    (hBi : Bihom F a b) : F.totalDegree ≤ a+b := by
  classical
  unfold MvPolynomial.totalDegree
  apply Finset.sup_le
  intro m hm
  change m.degree ≤ a+b
  rw [Finsupp.degree_eq_sum, Fin.sum_univ_four]
  obtain ⟨ha,hb⟩ := hBi m hm
  omega

private theorem weighted_degree_capK (k : ℕ) (hk : 1≤ k)
    (G : Poly) (hG : G ≠ 0) (a b N : ℕ)
    (hBi : Bihom G a b) (hdeg : G.totalDegree ≤ N) :
    a+k*b ≤ k*N := by
  have hs : G.support.Nonempty := by
    by_contra hh
    have he : G.support=∅ := Finset.not_nonempty_iff_eq_empty.mp hh
    apply hG
    exact MvPolynomial.support_eq_empty.mp he
  obtain ⟨m,hm⟩ := hs
  have hd := MvPolynomial.le_totalDegree hm
  change m.degree ≤ G.totalDegree at hd
  rw [Finsupp.degree_eq_sum, Fin.sum_univ_four] at hd
  obtain ⟨ha,hb⟩ := hBi m hm
  have hab : a+b≤ N := by omega
  have hka : a≤ k*a := by
    simpa only [one_mul] using Nat.mul_le_mul_right a hk
  have hKN : k*(a+b)≤ k*N := Nat.mul_le_mul_left k hab
  calc
    a+k*b ≤ k*(a+b) := by
      calc
        a+k*b = 1*a+k*b := by omega
        _ ≤ k*a+k*b := by
          simpa only [one_mul] using Nat.add_le_add_right hka (k*b)
        _ = k*(a+b) := by ring
    _ ≤ k*N := hKN
end A8HighFPriceFactor

