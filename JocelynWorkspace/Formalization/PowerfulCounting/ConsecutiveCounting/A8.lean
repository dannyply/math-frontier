private def tailR {R : Type*} [CommRing R] (k : ℕ) (A B : R) : R :=
  ∑ i ∈ Finset.range k,
    ((2 * k - 1).choose (k + i) : R) * A ^ i * B ^ (k - 1 - i)

private theorem complementary_tail {R : Type*} [CommRing R]
    (k : ℕ) (hk : 1 ≤ k) (A B : R) :
    A ^ k * tailR k A B + B ^ k * tailR k B A = (A + B) ^ (2 * k - 1) := by
  let p := 2 * k - 1
  let f : ℕ → R := fun i => A ^ i * B ^ (p - i) * (p.choose i : R)
  have hlow : (∑ i ∈ Finset.range k, f i) = B ^ k * tailR k B A := by
    calc
      (∑ i ∈ Finset.range k, f i) =
          ∑ i ∈ Finset.range k, f (k - 1 - i) :=
        (Finset.sum_range_reflect f k).symm
      _ = B ^ k * tailR k B A := by
        unfold tailR
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro i hi
        have hik : i ≤ k - 1 := by have := Finset.mem_range.mp hi; omega
        have he : p - (k - 1 - i) = k + i := by dsimp [p]; omega
        have hc : p.choose (k - 1 - i) = p.choose (k + i) := by
          rw [← Nat.choose_symm (show k - 1 - i ≤ p by dsimp [p]; omega), he]
        dsimp [f]
        rw [he, hc, pow_add]
        change A ^ (k - 1 - i) * (B ^ k * B ^ i) * (p.choose (k + i) : R) =
          B ^ k * ((p.choose (k + i) : R) * B ^ i * A ^ (k - 1 - i))
        ring
  have hupp : (∑ i ∈ Finset.range k, f (k + i)) = A ^ k * tailR k A B := by
    unfold tailR
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i hi
    have he : p - (k + i) = k - 1 - i := by dsimp [p]; omega
    dsimp [f]
    rw [he, pow_add]
    change (A ^ k * A ^ i) * B ^ (k - 1 - i) * (p.choose (k + i) : R) =
      A ^ k * ((p.choose (k + i) : R) * A ^ i * B ^ (k - 1 - i))
    ring
  have hp : p + 1 = k + k := by dsimp [p]; omega
  have hsum : (A + B) ^ p =
      (∑ i ∈ Finset.range k, f i) + (∑ i ∈ Finset.range k, f (k + i)) := by
    rw [add_pow, hp, Finset.sum_range_add]
  rw [hlow, hupp] at hsum
  exact (add_comm _ _).trans hsum.symm

private theorem tailR_homogeneous
    (k : ℕ) (hk : 1 ≤ k)
    (A B : MvPolynomial (Fin 2) ℤ)
    (hA : A.IsHomogeneous 1) (hB : B.IsHomogeneous 1) :
    (tailR k A B).IsHomogeneous (k - 1) := by
  unfold tailR
  apply MvPolynomial.IsHomogeneous.sum
  intro i hi
  have hi' : i ≤ k - 1 := by have := Finset.mem_range.mp hi; omega
  have h := ((MvPolynomial.isHomogeneous_C (Fin 2)
    ((2 * k - 1).choose (k + i) : ℤ)).mul (hA.pow i)).mul (hB.pow (k - 1 - i))
  simpa only [map_natCast, Nat.zero_add, Nat.one_mul, Nat.add_sub_of_le hi'] using h

private theorem homogeneous_syzygy_constant
    (k : ℕ) (A B : MvPolynomial (Fin 2) ℤ)
    (hA : A.IsHomogeneous k) (hB : B.IsHomogeneous k)
    (h : MvPolynomial.X (1 : Fin 2) ^ k * A =
      MvPolynomial.X (0 : Fin 2) ^ k * B) :
    ∃ K0 : ℤ,
      A = MvPolynomial.C K0 * MvPolynomial.X 0 ^ k ∧
      B = MvPolynomial.C K0 * MvPolynomial.X 1 ^ k := by
  have hd : C01.PcCurves.dehom A =
      Polynomial.X ^ k * C01.PcCurves.dehom B := by
    have ht := congrArg C01.PcCurves.dehom h
    simpa [C01.PcCurves.dehom, map_mul, map_pow,
      MvPolynomial.aeval_X, Polynomial.algebraMap_eq] using ht
  let K0 := (C01.PcCurves.dehom B).coeff 0
  have hBc : C01.PcCurves.dehom B = Polynomial.C K0 := by
    apply Polynomial.ext
    intro i
    cases i with
    | zero => simp [K0]
    | succ i =>
      have he := congrArg (fun f : Polynomial ℤ => f.coeff (k + (i + 1))) hd
      have hz : (C01.PcCurves.dehom A).coeff (k + (i + 1)) = 0 :=
        Polynomial.coeff_eq_zero_of_natDegree_lt
          (lt_of_le_of_lt (C01.PcCurves.dehom_natDegree_le hA) (by omega))
      rw [hz, Polynomial.coeff_X_pow_mul',
        if_pos (by omega : k ≤ k + (i + 1)),
        show k + (i + 1) - k = i + 1 by omega] at he
      change (C01.PcCurves.dehom B).coeff (i + 1) = (Polynomial.C K0).coeff (i + 1)
      simpa only [Polynomial.coeff_C, show i + 1 ≠ 0 by omega, if_false] using he.symm
  have hAc : C01.PcCurves.dehom A = Polynomial.C K0 * Polynomial.X ^ k := by
    rw [hd, hBc]
    ring
  have hAX : (MvPolynomial.C K0 * MvPolynomial.X (0 : Fin 2) ^ k).IsHomogeneous k := by
    simpa using (MvPolynomial.isHomogeneous_C (Fin 2) K0).mul
      ((MvPolynomial.isHomogeneous_X ℤ (0 : Fin 2)).pow k)
  have hBY : (MvPolynomial.C K0 * MvPolynomial.X (1 : Fin 2) ^ k).IsHomogeneous k := by
    simpa using (MvPolynomial.isHomogeneous_C (Fin 2) K0).mul
      ((MvPolynomial.isHomogeneous_X ℤ (1 : Fin 2)).pow k)
  refine ⟨K0, ?_, ?_⟩
  · apply sub_eq_zero.mp
    apply C01.PcCurves.eq_zero_of_dehom (hA.sub hAX)
    rw [C01.PcCurves.dehom_sub, hAc]
    simp [C01.PcCurves.dehom, map_mul, map_pow,
       MvPolynomial.aeval_X]
  · apply sub_eq_zero.mp
    apply C01.PcCurves.eq_zero_of_dehom (hB.sub hBY)
    rw [C01.PcCurves.dehom_sub, hBc]
    simp [C01.PcCurves.dehom, map_mul, map_pow,
       MvPolynomial.aeval_X]

private theorem integral_even_pure_normal_form
    (k : ℕ) (hk : 1 ≤ k)
    (A B : MvPolynomial (Fin 2) ℤ)
    (hA : A.IsHomogeneous k) (hB : B.IsHomogeneous k)
    (a b c : ℤ)
    (hres : MvPolynomial.X (1 : Fin 2) ^ k * A -
      MvPolynomial.X (0 : Fin 2) ^ k * B =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ (2 * k)) :
    ∃ K0 : ℤ,
      A = MvPolynomial.C K0 * MvPolynomial.X 0 ^ k +
        MvPolynomial.C c *
          (MvPolynomial.C a * MvPolynomial.X 0 + MvPolynomial.C b * MvPolynomial.X 1) *
          MvPolynomial.C (b ^ k) *
          tailR k (MvPolynomial.C b * MvPolynomial.X 1) (MvPolynomial.C a * MvPolynomial.X 0) ∧
      B = MvPolynomial.C K0 * MvPolynomial.X 1 ^ k -
        MvPolynomial.C c *
          (MvPolynomial.C a * MvPolynomial.X 0 + MvPolynomial.C b * MvPolynomial.X 1) *
          MvPolynomial.C (a ^ k) *
          tailR k (MvPolynomial.C a * MvPolynomial.X 0) (MvPolynomial.C b * MvPolynomial.X 1) := by
  let X : MvPolynomial (Fin 2) ℤ := MvPolynomial.X 0
  let Y : MvPolynomial (Fin 2) ℤ := MvPolynomial.X 1
  let U := MvPolynomial.C a * X
  let V := MvPolynomial.C b * Y
  let L := U + V
  let AP := MvPolynomial.C c * L * MvPolynomial.C (b ^ k) * tailR k V U
  let BP := MvPolynomial.C c * L * MvPolynomial.C (a ^ k) * tailR k U V
  have hU : U.IsHomogeneous 1 := by
    simpa [U, X] using (MvPolynomial.isHomogeneous_C (Fin 2) a).mul
      (MvPolynomial.isHomogeneous_X ℤ (0 : Fin 2))
  have hV : V.IsHomogeneous 1 := by
    simpa [V, Y] using (MvPolynomial.isHomogeneous_C (Fin 2) b).mul
      (MvPolynomial.isHomogeneous_X ℤ (1 : Fin 2))
  have hL : L.IsHomogeneous 1 := hU.add hV
  have hAP : AP.IsHomogeneous k := by
    have ht := (((MvPolynomial.isHomogeneous_C (Fin 2) c).mul hL).mul
      (MvPolynomial.isHomogeneous_C (Fin 2) (b ^ k))).mul
        (tailR_homogeneous k hk V U hV hU)
    simpa only [AP, Nat.zero_add, Nat.add_zero, show 1 + (k - 1) = k by omega] using ht
  have hBP : BP.IsHomogeneous k := by
    have ht := (((MvPolynomial.isHomogeneous_C (Fin 2) c).mul hL).mul
      (MvPolynomial.isHomogeneous_C (Fin 2) (a ^ k))).mul
        (tailR_homogeneous k hk U V hU hV)
    simpa only [BP, Nat.zero_add, Nat.add_zero, show 1 + (k - 1) = k by omega] using ht
  have hcomp : U ^ k * tailR k U V + V ^ k * tailR k V U = L ^ (2 * k - 1) :=
    complementary_tail k hk U V
  have hpart : Y ^ k * AP + X ^ k * BP = MvPolynomial.C c * L ^ (2 * k) := by
    calc
      Y ^ k * AP + X ^ k * BP =
          MvPolynomial.C c * L *
            (U ^ k * tailR k U V + V ^ k * tailR k V U) := by
        dsimp [AP, BP, U, V]
        simp only [mul_pow, map_pow]
        ring
      _ = MvPolynomial.C c * L * L ^ (2 * k - 1) := by rw [hcomp]
      _ = MvPolynomial.C c * L ^ (2 * k) := by
        rw [mul_assoc, ← pow_succ', show 2 * k - 1 + 1 = 2 * k by omega]
  have hsyz : Y ^ k * (A - AP) = X ^ k * (B + BP) := by
    change Y ^ k * A - X ^ k * B = MvPolynomial.C c * L ^ (2 * k) at hres
    linear_combination hres - hpart
  obtain ⟨K0, hKA, hKB⟩ := homogeneous_syzygy_constant k (A - AP) (B + BP)
    (hA.sub hAP) (hB.add hBP) hsyz
  refine ⟨K0, ?_, ?_⟩
  · change A = MvPolynomial.C K0 * X ^ k + AP
    linear_combination hKA
  · change B = MvPolynomial.C K0 * Y ^ k - BP
    linear_combination hKB

private theorem sum_range_difference {R : Type*} [CommRing R]
    (f : ℕ → R) (n : ℕ) :
    (∑ i ∈ Finset.range n, (f i - f (i + 1))) = f 0 - f n := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Finset.sum_range_succ, ih]
    ring

private theorem alternating_half_binomial {R : Type*} [CommRing R]
    (k : ℕ) (hk : 1 ≤ k) :
    (∑ i ∈ Finset.range k,
      (-1 : R) ^ i * ((2 * k - 1).choose (k + i) : R)) =
      ((2 * k - 2).choose (k - 1) : R) := by
  let n := 2 * k - 2
  let f : ℕ → R := fun i => (-1 : R) ^ i * (n.choose (k - 1 + i) : R)
  have hterm : ∀ i : ℕ,
      (-1 : R) ^ i * ((2 * k - 1).choose (k + i) : R) =
        f i - f (i + 1) := by
    intro i
    have he : k - 1 + i + 1 = k + i := by omega
    have hn : n + 1 = 2 * k - 1 := by dsimp [n]; omega
    have hc := Nat.choose_succ_succ n (k - 1 + i)
    simp only [Nat.succ_eq_add_one] at hc
    rw [he, hn] at hc
    have hcR := congrArg (fun a : ℕ => (a : R)) hc
    push_cast at hcR
    dsimp [f]
    have he' : k - 1 + (i + 1) = k + i := by omega
    rw [he', pow_succ, hcR]
    ring
  simp_rw [hterm]
  rw [sum_range_difference]
  have he : k - 1 + k = 2 * k - 1 := by omega
  have hz : n.choose (k - 1 + k) = 0 :=
    Nat.choose_eq_zero_of_lt (by dsimp [n]; omega)
  simp [f, hz, n]

private theorem tailR_zero_left {R : Type*} [CommRing R]
    (k : ℕ) (hk : 1 ≤ k) (B : R) :
    tailR k 0 B = ((2 * k - 1).choose k : R) * B ^ (k - 1) := by
  unfold tailR
  rw [Finset.sum_eq_single 0]
  · simp
  · intro i hi hi0
    simp [zero_pow hi0]
  · intro hnot
    exact (hnot (Finset.mem_range.mpr (by omega))).elim

private theorem tailR_opposite {R : Type*} [CommRing R]
    (k : ℕ) (hk : 1 ≤ k) (B : R) :
    tailR k (-B) B =
      ((2 * k - 2).choose (k - 1) : R) * B ^ (k - 1) := by
  unfold tailR
  have hterm : ∀ i ∈ Finset.range k,
      ((2 * k - 1).choose (k + i) : R) * (-B) ^ i * B ^ (k - 1 - i) =
        ((-1 : R) ^ i * ((2 * k - 1).choose (k + i) : R)) * B ^ (k - 1) := by
    intro i hi
    have hik : i ≤ k - 1 := by have := Finset.mem_range.mp hi; omega
    have hneg : (-B) ^ i = (-1 : R) ^ i * B ^ i := by
      rw [show -B = (-1 : R) * B by ring, mul_pow]
    rw [hneg]
    have he : i + (k - 1 - i) = k - 1 := by omega
    calc
      ((2 * k - 1).choose (k + i) : R) *
          ((-1 : R) ^ i * B ^ i) * B ^ (k - 1 - i) =
        ((-1 : R) ^ i * ((2 * k - 1).choose (k + i) : R)) *
          (B ^ i * B ^ (k - 1 - i)) := by ring
      _ = _ := by rw [← pow_add, he]
  rw [Finset.sum_congr rfl hterm, ← Finset.sum_mul, alternating_half_binomial k hk]

private theorem tailR_map {R S : Type*} [CommRing R] [CommRing S]
    (f : R →+* S) (k : ℕ) (A B : R) :
    f (tailR k A B) = tailR k (f A) (f B) := by
  simp only [tailR, map_sum, map_mul, map_pow, map_natCast]

private theorem mixed_even_power_height
    (k : ℕ) (a b c : ℤ) (H : ℝ)
    (ha : |((c * a ^ (2 * k) : ℤ) : ℝ)| ≤ H)
    (hb : |((c * b ^ (2 * k) : ℤ) : ℝ)| ≤ H) :
    |((c * (a * b) ^ k : ℤ) : ℝ)| ≤ H := by
  simp only [Int.cast_mul, Int.cast_pow, abs_mul, abs_pow] at ha hb ⊢
  rw [mul_pow]
  by_cases hab : |(a : ℝ)| ≤ |(b : ℝ)|
  · calc
      |(c : ℝ)| * (|(a : ℝ)| ^ k * |(b : ℝ)| ^ k) ≤
          |(c : ℝ)| * (|(b : ℝ)| ^ k * |(b : ℝ)| ^ k) :=
        mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_right
            (pow_le_pow_left₀ (abs_nonneg _) hab k) (by positivity)) (abs_nonneg _)
      _ = |(c : ℝ)| * |(b : ℝ)| ^ (2 * k) := by
        rw [show 2 * k = k + k by omega, pow_add]
      _ ≤ H := hb
  · have hba : |(b : ℝ)| ≤ |(a : ℝ)| := le_of_not_ge hab
    calc
      |(c : ℝ)| * (|(a : ℝ)| ^ k * |(b : ℝ)| ^ k) ≤
          |(c : ℝ)| * (|(a : ℝ)| ^ k * |(a : ℝ)| ^ k) :=
        mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_left
            (pow_le_pow_left₀ (abs_nonneg _) hba k) (by positivity)) (abs_nonneg _)
      _ = |(c : ℝ)| * |(a : ℝ)| ^ (2 * k) := by
        rw [show 2 * k = k + k by omega, pow_add]
      _ ≤ H := ha

private theorem normal_coefficient_height
    (k : ℕ) (a b c B01 K0 : ℤ) (H : ℝ)
    (hK0 : K0 = B01 + ((2 * k - 1).choose k : ℤ) * c * (a * b) ^ k)
    (hB : |(B01 : ℝ)| ≤ H)
    (ha : |((c * a ^ (2 * k) : ℤ) : ℝ)| ≤ H)
    (hb : |((c * b ^ (2 * k) : ℤ) : ℝ)| ≤ H) :
    |(K0 : ℝ)| ≤ (1 + ((2 * k - 1).choose k : ℝ)) * H := by
  have hm := mixed_even_power_height k a b c H ha hb
  rw [hK0, Int.cast_add]
  calc
    |(B01 : ℝ) + ((((2 * k - 1).choose k : ℤ) * c * (a * b) ^ k : ℤ) : ℝ)| ≤
        |(B01 : ℝ)| + |(((((2 * k - 1).choose k : ℤ) * c * (a * b) ^ k) : ℤ) : ℝ)| :=
      abs_add_le _ _
    _ ≤ H + ((2 * k - 1).choose k : ℝ) * H := by
      apply add_le_add hB
      have he :
          |(((((2 * k - 1).choose k : ℤ) * c * (a * b) ^ k) : ℤ) : ℝ)| =
            ((2 * k - 1).choose k : ℝ) * |((c * (a * b) ^ k : ℤ) : ℝ)| := by
        push_cast
        simp only [abs_mul]
        rw [abs_of_nonneg (Nat.cast_nonneg _ : (0 : ℝ) ≤ ((2 * k - 1).choose k : ℝ))]
        ring
      rw [he]
      exact mul_le_mul_of_nonneg_left hm (Nat.cast_nonneg _)
    _ = _ := by ring

private theorem binary_eval_zero_one
    {R : Type*} [CommRing R] {F : MvPolynomial (Fin 2) R} {n : ℕ}
    (hF : F.IsHomogeneous n) :
    MvPolynomial.eval ![0,1] F = F.coeff (C01.PcCurves.ex 0 n) := by
  classical
  conv_lhs => rw [C01.PcCurves.hom_repr hF]
  rw [map_sum, Finset.sum_eq_single 0]
  · simp
  · intro i hi hi0
    simp [zero_pow hi0]
  · intro hnot
    exact (hnot (Finset.mem_range.mpr (by omega))).elim

private theorem normal_coefficient_formula
    (k : ℕ) (hk : 1 ≤ k) (B : MvPolynomial (Fin 2) ℤ)
    (a b c K0 : ℤ)
    (hB : B = MvPolynomial.C K0 * MvPolynomial.X 1 ^ k -
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 + MvPolynomial.C b * MvPolynomial.X 1) *
        MvPolynomial.C (a ^ k) *
        tailR k (MvPolynomial.C a * MvPolynomial.X 0) (MvPolynomial.C b * MvPolynomial.X 1)) :
    K0 = MvPolynomial.eval ![0,1] B +
      ((2 * k - 1).choose k : ℤ) * c * (a * b) ^ k := by
  have he := congrArg (MvPolynomial.eval ![(0 : ℤ),1]) hB
  simp only [map_sub, map_add, map_mul, map_pow, tailR_map, MvPolynomial.eval_C,
    MvPolynomial.eval_X, Matrix.cons_val_zero, Matrix.cons_val_one,
    mul_zero, mul_one, zero_add, one_pow] at he
  rw [tailR_zero_left k hk] at he
  have hbpow : b * b ^ (k - 1) = b ^ k := by
    rw [← pow_succ', show k - 1 + 1 = k by omega]
  have hpart :
      c * b * a ^ k * (((2 * k - 1).choose k : ℤ) * b ^ (k - 1)) =
        ((2 * k - 1).choose k : ℤ) * c * (a * b) ^ k := by
    rw [mul_pow]
    calc
      c * b * a ^ k * (((2 * k - 1).choose k : ℤ) * b ^ (k - 1)) =
          ((2 * k - 1).choose k : ℤ) * c * a ^ k * (b * b ^ (k - 1)) := by ring
      _ = _ := by rw [hbpow]; ring
  rw [hpart] at he
  linear_combination -he

private theorem even_pure_endpoint_heights
    (k : ℕ) (hk : 1 ≤ k) (A B : MvPolynomial (Fin 2) ℤ)
    (hA : A.IsHomogeneous k) (hB : B.IsHomogeneous k)
    (a b c : ℤ) (H : ℝ)
    (hAc : ∀ m, |((A.coeff m : ℤ) : ℝ)| ≤ H)
    (hBc : ∀ m, |((B.coeff m : ℤ) : ℝ)| ≤ H)
    (hres : MvPolynomial.X (1 : Fin 2) ^ k * A -
      MvPolynomial.X (0 : Fin 2) ^ k * B =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ (2 * k)) :
    |((c * a ^ (2 * k) : ℤ) : ℝ)| ≤ H ∧
      |((c * b ^ (2 * k) : ℤ) : ℝ)| ≤ H := by
  have hk0 : k ≠ 0 := by omega
  have h10 := congrArg (MvPolynomial.eval ![(1 : ℤ),0]) hres
  have h01 := congrArg (MvPolynomial.eval ![(0 : ℤ),1]) hres
  have h10' : -MvPolynomial.eval ![(1 : ℤ),0] B = c * a ^ (2 * k) := by
    simpa [zero_pow hk0] using h10
  have h01' : MvPolynomial.eval ![(0 : ℤ),1] A = c * b ^ (2 * k) := by
    simpa [zero_pow hk0] using h01
  constructor
  · rw [← h10', Int.cast_neg, abs_neg, C01.PcCurves.eval_one_zero hB]
    exact hBc _
  · rw [← h01', binary_eval_zero_one hA]
    exact hAc _

private theorem normal_form_K0_height
    (k : ℕ) (hk : 1 ≤ k) (A B : MvPolynomial (Fin 2) ℤ)
    (hA : A.IsHomogeneous k) (hB : B.IsHomogeneous k)
    (a b c K0 : ℤ) (H : ℝ)
    (hAc : ∀ m, |((A.coeff m : ℤ) : ℝ)| ≤ H)
    (hBc : ∀ m, |((B.coeff m : ℤ) : ℝ)| ≤ H)
    (hres : MvPolynomial.X (1 : Fin 2) ^ k * A -
      MvPolynomial.X (0 : Fin 2) ^ k * B =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ (2 * k))
    (hBform : B = MvPolynomial.C K0 * MvPolynomial.X 1 ^ k -
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 + MvPolynomial.C b * MvPolynomial.X 1) *
        MvPolynomial.C (a ^ k) *
        tailR k (MvPolynomial.C a * MvPolynomial.X 0) (MvPolynomial.C b * MvPolynomial.X 1)) :
    |(K0 : ℝ)| ≤ (1 + ((2 * k - 1).choose k : ℝ)) * H := by
  have hend := even_pure_endpoint_heights k hk A B hA hB a b c H hAc hBc hres
  apply normal_coefficient_height k a b c (MvPolynomial.eval ![0,1] B) K0 H
    (normal_coefficient_formula k hk B a b c K0 hBform)
  · rw [binary_eval_zero_one hB]
    exact hBc _
  · exact hend.1
  · exact hend.2

private theorem normal_form_K0_nonzero
    (k : ℕ) (A B : MvPolynomial (Fin 2) ℤ)
    (a b c K0 : ℤ) (hab : a ≠ 0 ∨ b ≠ 0)
    (hno : ∀ d e : ℤ, d ≠ 0 ∨ e ≠ 0 →
      MvPolynomial.eval ![d,e] A = 0 →
      MvPolynomial.eval ![d,e] B = 0 → False)
    (hAform : A = MvPolynomial.C K0 * MvPolynomial.X 0 ^ k +
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 + MvPolynomial.C b * MvPolynomial.X 1) *
        MvPolynomial.C (b ^ k) *
        tailR k (MvPolynomial.C b * MvPolynomial.X 1) (MvPolynomial.C a * MvPolynomial.X 0))
    (hBform : B = MvPolynomial.C K0 * MvPolynomial.X 1 ^ k -
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 + MvPolynomial.C b * MvPolynomial.X 1) *
        MvPolynomial.C (a ^ k) *
        tailR k (MvPolynomial.C a * MvPolynomial.X 0) (MvPolynomial.C b * MvPolynomial.X 1)) :
    K0 ≠ 0 := by
  intro hK
  have hL : a * (-b) + b * a = 0 := by ring
  have hA0 : MvPolynomial.eval ![-b,a] A = 0 := by
    rw [hAform]
    simp only [map_add, map_mul, map_pow, MvPolynomial.eval_C,
      MvPolynomial.eval_X, Matrix.cons_val_zero, Matrix.cons_val_one,
      hK, hL, zero_mul, mul_zero, zero_add]
  have hB0 : MvPolynomial.eval ![-b,a] B = 0 := by
    rw [hBform]
    simp only [map_sub, map_add, map_mul, map_pow, MvPolynomial.eval_C,
      MvPolynomial.eval_X, Matrix.cons_val_zero, Matrix.cons_val_one,
      hK, hL, zero_mul, mul_zero, sub_zero]
  have hw : -b ≠ 0 ∨ a ≠ 0 := by
    rcases hab with ha | hb
    · exact Or.inr ha
    · exact Or.inl (neg_ne_zero.mpr hb)
  exact hno (-b) a hw hA0 hB0

open Polynomial
open FormalAB.S1e7cf533.A5ProgressionAlgebraProbe

private theorem primitive_polynomial_fixed_depth_cover :
∀ (p k γ : ℕ) (F : Polynomial ℤ),
  p.Prime → 0 < k → F.natDegree ≤ k →
  Polynomial.map (Int.castRingHom (ZMod p)) F ≠ 0 →
  ∃ R : Finset ℤ, R.card ≤ k ∧
    ∀ t : ℤ, (p : ℤ) ^ (k * γ) ∣ F.eval t →
      ∃ r ∈ R, (p : ℤ) ^ γ ∣ t - r := by
  classical
  intro p k γ F hp hk hdeg hF
  by_cases hγ : γ = 0
  · subst γ
    refine ⟨{0}, by simp only [Finset.card_singleton]; omega, ?_⟩
    intro t ht
    exact ⟨0, Finset.mem_singleton_self _, by simp⟩
  have hγpos : 0 < γ := Nat.pos_of_ne_zero hγ
  let : Fact p.Prime := ⟨hp⟩
  have hpz : (p : ℤ) ≠ 0 := by exact_mod_cast hp.ne_zero
  obtain ⟨S,hSc,hSg,hSv⟩ := primitive_cover p (k * γ) (Nat.mul_pos hk hγpos) F hF
  have hexponent (s : ℤ × ℕ) (hs : s ∈ S) : γ ≤ s.2 := by
    let j : ℕ := rootMultiplicity (s.1 : ZMod p)
      (Polynomial.map (Int.castRingHom (ZMod p)) F)
    have hunit : ¬ (p : ℤ) ∣ ((taylor s.1) F).coeff j := by
      exact root_taylor_unit p F s.1 hF
    have hcj : ((taylor s.1) F).coeff j ≠ 0 := by
      intro hz
      apply hunit
      rw [hz]
      exact dvd_zero _
    have hj : j ≤ k := by
      have hh := Polynomial.le_natDegree_of_ne_zero hcj
      rw [Polynomial.natDegree_taylor] at hh
      exact hh.trans hdeg
    have hcoeff : (p : ℤ) ^ (k * γ) ∣
        (p : ℤ) ^ (s.2 * j) * ((taylor s.1) F).coeff j := by
      have hh := (Polynomial.C_dvd_iff_dvd_coeff _ _).mp (hSg s hs).2 j
      change (p : ℤ) ^ (k * γ) ∣
        (F.comp (C s.1 + C ((p : ℤ) ^ s.2) * X)).coeff j at hh
      rw [coeff_affine, ← pow_mul] at hh
      exact hh
    have hN : k * γ ≤ s.2 * j := by
      by_contra hn
      have hlt : s.2 * j + 1 ≤ k * γ := by omega
      have hd : (p : ℤ) ^ (s.2 * j + 1) ∣
          (p : ℤ) ^ (s.2 * j) * ((taylor s.1) F).coeff j :=
        (pow_dvd_pow (p : ℤ) hlt).trans hcoeff
      exact hunit ((power_cancel (p : ℤ) hpz (s.2 * j) _).mp hd)
    have hprod : γ * k ≤ s.2 * k := by
      calc
        γ * k = k * γ := Nat.mul_comm _ _
        _ ≤ s.2 * j := hN
        _ ≤ s.2 * k := Nat.mul_le_mul_left s.2 hj
    exact Nat.le_of_mul_le_mul_right hprod hk
  refine ⟨S.image Prod.fst, ?_, ?_⟩
  · exact Finset.card_image_le.trans
      (hSc.trans (Polynomial.natDegree_map_le.trans hdeg))
  · intro t ht
    obtain ⟨s,hs,z,hz⟩ := hSv t ht
    refine ⟨s.1,Finset.mem_image.mpr ⟨s,hs,rfl⟩,?_⟩
    have hd : (p : ℤ) ^ γ ∣ (p : ℤ) ^ s.2 :=
      pow_dvd_pow (p : ℤ) (hexponent s hs)
    rw [hz]
    simpa only [add_sub_cancel_left] using dvd_mul_of_dvd_left hd z

private theorem refine_cover (p gamma mu : ℕ) (hp : 0<p) (hgm : gamma ≤ mu)
    (Pred : ℤ→Prop) (U : Finset ℤ)
    (hU : ∀ r : ℤ,Pred r → ∃ u∈U,(p:ℤ)^gamma∣r-u) :
    ∃ T : Finset ℤ,T.card≤U.card*p^(mu-gamma) ∧
      ∀ r : ℤ,Pred r → ∃ t∈T,(p:ℤ)^mu∣r-t := by
  classical
  let L : ℕ := p^(mu-gamma)
  let f : ℤ×ℕ→ℤ := fun z => z.1+(p:ℤ)^gamma*(z.2:ℤ)
  let T := (U ×ˢ Finset.range L).image f
  refine ⟨T,?_,?_⟩
  · exact Finset.card_image_le.trans (by simp [L])
  · intro r hr
    obtain ⟨u,hu,z,hz⟩ := hU r hr
    have hL : 0<(L:ℤ) := by exact_mod_cast (pow_pos hp (mu-gamma))
    let j : ℕ := (z%(L:ℤ)).toNat
    have hjcast : (j:ℤ)=z%(L:ℤ) :=
      Int.toNat_of_nonneg (Int.emod_nonneg _ (ne_of_gt hL))
    have hjlt : j<L := by
      have hh : (j:ℤ)<(L:ℤ) := by
        rw [hjcast]
        exact Int.emod_lt_of_pos _ hL
      exact_mod_cast hh
    have hmod : Int.ModEq (L:ℤ) z (j:ℤ) := by
      change z%(L:ℤ)=(j:ℤ)%(L:ℤ)
      rw [hjcast]
      simp
    have hzj : (L:ℤ)∣z-(j:ℤ) := Int.modEq_iff_dvd.mp hmod.symm
    obtain ⟨w,hw⟩ := hzj
    refine ⟨f (u,j),Finset.mem_image.mpr
      ⟨(u,j),Finset.mem_product.mpr ⟨hu,Finset.mem_range.mpr hjlt⟩,rfl⟩,
      w,?_⟩
    have hpw : (p:ℤ)^mu=(p:ℤ)^gamma*(L:ℤ) := by
      dsimp [L]
      rw [← pow_add,Nat.add_sub_of_le hgm]
    dsimp [f]
    have hz' : r=u+(p:ℤ)^gamma*z := by linarith only [hz]
    rw [hz',hpw]
    linear_combination (p:ℤ)^gamma*hw

private theorem coarse_prime_cover
    (p k α c i : ℕ) (F : Polynomial ℤ)
    (hp : p.Prime) (hk : 1 ≤ k)
    (hdeg : F.natDegree ≤ k)
    (hcrit : ¬ (p : ℤ) ^ ((k - 1) * α + c + 1) ∣ F.coeff i) :
    ∃ T : Finset ℤ, T.card ≤ k * p ^ c ∧
      ∀ z : ℤ, (p : ℤ) ^ ((2 * k - 1) * α) ∣ F.eval z →
        ∃ r ∈ T, (p : ℤ) ^ α ∣ z - r := by
  classical
  let : Fact p.Prime := ⟨hp⟩
  have hp0 : (p : ℤ) ≠ 0 := by exact_mod_cast hp.ne_zero
  by_cases hac : α ≤ c
  · obtain ⟨T, hTc, hTv⟩ := refine_cover p 0 α hp.pos (by omega)
      (fun z : ℤ => (p : ℤ) ^ ((2 * k - 1) * α) ∣ F.eval z)
      ({0} : Finset ℤ) (by intro z hz; exact ⟨0, by simp, by simp⟩)
    refine ⟨T, ?_, hTv⟩
    have hpαc : p ^ α ≤ p ^ c :=
      pow_le_pow_right₀ (by omega : 1 ≤ p) hac
    have hpk : p ^ c ≤ k * p ^ c := by
      simpa only [one_mul] using Nat.mul_le_mul_right (p ^ c) hk
    have hTc' : T.card ≤ p ^ α := by simpa only [Finset.card_singleton, Nat.sub_zero, one_mul] using hTc
    exact hTc'.trans (hpαc.trans hpk)
  · have hca : c ≤ α := by omega
    have hα : 1 ≤ α := by omega
    rcases extract_content p ((k - 1) * α + c + 1) F with
      hAll | ⟨v, hv, H, heq, hH⟩
    · exact (hcrit ((Polynomial.C_dvd_iff_dvd_coeff _ _).mp hAll i)).elim
    have hvb : v ≤ (k - 1) * α + c := by omega
    have hrid : (2 * k - 1) * α = (k - 1) * α + k * α := by
      rw [show 2 * k - 1 = (k - 1) + k by omega, Nat.add_mul]
    have hkid : k * (α - c) + k * c = k * α := by
      rw [← Nat.mul_add, Nat.sub_add_cancel hca]
    have hck : c ≤ k * c := by
      simpa only [one_mul] using Nat.mul_le_mul_right c hk
    have hvle : v ≤ (2 * k - 1) * α := by
      rw [hrid]
      omega
    have hprec : k * (α - c) ≤ (2 * k - 1) * α - v := by
      omega
    have hdegH : H.natDegree ≤ k := by
      apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
      intro j hj
      have hzF : F.coeff j = 0 :=
        Polynomial.coeff_eq_zero_of_natDegree_lt (lt_of_le_of_lt hdeg hj)
      rw [heq, Polynomial.coeff_C_mul] at hzF
      exact (mul_eq_zero.mp hzF).resolve_left (pow_ne_zero v hp0)
    obtain ⟨U, hUc, hUv⟩ := primitive_polynomial_fixed_depth_cover
      p k (α - c) H hp (by omega) hdegH hH
    have hU :
        ∀ z : ℤ, (p : ℤ) ^ ((2 * k - 1) * α) ∣ F.eval z →
          ∃ r ∈ U, (p : ℤ) ^ (α - c) ∣ z - r := by
      intro z hz
      have heval : F.eval z = (p : ℤ) ^ v * H.eval z := by rw [heq]; simp
      have hrest : (p : ℤ) ^ ((2 * k - 1) * α - v) ∣ H.eval z :=
        (cancel_pow_div (p : ℤ) hp0 v ((2 * k - 1) * α) hvle (H.eval z)).mp
          (by simpa only [heval] using hz)
      exact hUv z ((pow_dvd_pow (p : ℤ) hprec).trans hrest)
    obtain ⟨T, hTc, hTv⟩ := refine_cover p (α - c) α hp.pos (by omega)
      (fun z : ℤ => (p : ℤ) ^ ((2 * k - 1) * α) ∣ F.eval z) U hU
    refine ⟨T, ?_, hTv⟩
    have he : α - (α - c) = c := by omega
    rw [he] at hTc
    exact hTc.trans (Nat.mul_le_mul_right (p ^ c) hUc)

private theorem graph_transfer_integer
    (k : ℕ) (A B d e u v : ℤ)
    (hg : A * u = B * v) (hs : e ^ k * v - d ^ k * u = 1) :
    (e ^ k * A - d ^ k * B) * u = B ∧
      (e ^ k * A - d ^ k * B) * v = A := by
  constructor
  · linear_combination e ^ k * hg + B * hs
  · linear_combination d ^ k * hg + A * hs

private theorem signed_level_inverse
    (k : ℕ) (hk : 1 ≤ k)
    (A B a b c K0 m d e u v D1 D2 : ℤ)
    (hc : c ≠ 0) (hK0 : K0 ≠ 0)
    (hAF : A = K0 * d ^ k + c * m * b ^ k * D2)
    (hBF : B = K0 * e ^ k - c * m * a ^ k * D1)
    (hg : A * u = B * v)
    (hs : e ^ k * v - d ^ k * u = 1)
    (hR : e ^ k * A - d ^ k * B = c * m ^ (2 * k)) :
    m ≠ 0 ∧ ∃ q : ℤ, q ≠ 0 ∧ c * m * q = K0 ∧
      m ^ (2 * k - 1) * u = q * e ^ k - a ^ k * D1 ∧
      m ^ (2 * k - 1) * v = q * d ^ k + b ^ k * D2 := by
  let q : ℤ := a ^ k * D1 * v + b ^ k * D2 * u
  have hq : c * m * q = K0 := by
    dsimp [q]
    rw [hAF, hBF] at hg
    linear_combination hg + K0 * hs
  have hm : m ≠ 0 := by
    intro hz
    apply hK0
    rw [hz] at hq
    simpa using hq.symm
  have hq0 : q ≠ 0 := by
    intro hz
    apply hK0
    rw [hz] at hq
    simpa using hq.symm
  have hcm : c * m ≠ 0 := mul_ne_zero hc hm
  have hmp : m ^ (2 * k) = m * m ^ (2 * k - 1) := by
    rw [← pow_succ', show 2 * k - 1 + 1 = 2 * k by omega]
  have ht := graph_transfer_integer k A B d e u v hg hs
  refine ⟨hm, q, hq0, hq, ?_, ?_⟩
  · apply mul_left_cancel₀ hcm
    rw [hR, hBF, ← hq, hmp] at ht
    linear_combination ht.1
  · apply mul_left_cancel₀ hcm
    rw [hR, hAF, ← hq, hmp] at ht
    linear_combination ht.2

private theorem level_parameter (a b d₀ e₀ m d e : ℤ)
    (hbase : a*d₀+b*e₀=1) (hlevel : a*d+b*e=m) :
    ∃ r : ℤ, d=m*d₀+b*r ∧ e=m*e₀-a*r := by
  refine ⟨e₀*d-d₀*e,?_,?_⟩
  · linear_combination -d*hbase+d₀*hlevel
  · linear_combination -e*hbase+e₀*hlevel

private theorem parameter_unique (a b d₀ e₀ m d e r s : ℤ)
    (hbase : a*d₀+b*e₀=1)
    (hdr : d=m*d₀+b*r) (her : e=m*e₀-a*r)
    (hds : d=m*d₀+b*s) (hes : e=m*e₀-a*s) : r=s := by
  linear_combination -e₀*(hdr-hds)+d₀*(her-hes)-(r-s)*hbase

private theorem quotient_unique (c m K₀ q r : ℤ)
    (hc : c ≠ 0) (hm : m ≠ 0)
    (hq : K₀=c*m*q) (hr : K₀=c*m*r) : q=r := by
  apply mul_left_cancel₀ (mul_ne_zero hc hm)
  exact hq.symm.trans hr

private theorem level_divisor (K₀ c m q : ℤ) (h : K₀=c*m*q) :
    m.natAbs ∣ K₀.natAbs := by
  refine ⟨(c*q).natAbs,?_⟩
  rw [← Int.natAbs_mul]
  congr 1
  rw [h]
  ring

private theorem height_numerator
    (k : ℕ) (a d e m q u D : ℤ)
    (hu : m ^ (2 * k - 1) * u = q * e ^ k - a ^ k * D) :
    m ^ (2 * k - 1) * (d ^ k * u) =
      q * (d * e) ^ k - (a * d) ^ k * D := by
  rw [mul_pow, mul_pow]
  linear_combination d ^ k * hu

private theorem choose_mul_index
    (n j : ℕ) (hn : 1 ≤ n) (hj : 1 ≤ j) :
    n.choose j * j = n * (n - 1).choose (j - 1) := by
  have h1 := Nat.choose_succ_right_eq n (j - 1)
  have h2 := Nat.choose_mul_succ_eq (n - 1) (j - 1)
  have hn' : n - 1 + 1 = n := by omega
  have hj' : j - 1 + 1 = j := by omega
  rw [hj'] at h1
  rw [hn'] at h2
  calc
    n.choose j * j = n.choose (j - 1) * (n - (j - 1)) := h1
    _ = (n - 1).choose (j - 1) * n := h2.symm
    _ = n * (n - 1).choose (j - 1) := Nat.mul_comm _ _

private theorem choose_mul_complement
    (n j : ℕ) (hn : 1 ≤ n) :
    n.choose j * (n - j) = n * (n - 1).choose j := by
  have h := Nat.choose_mul_succ_eq (n - 1) j
  have hn' : n - 1 + 1 = n := by omega
  rw [hn'] at h
  exact h.symm.trans (Nat.mul_comm _ _)

private def weightedBasis (U V : Polynomial ℝ) (n j : ℕ) : Polynomial ℝ :=
  Polynomial.C (n.choose j : ℝ) * U ^ j * V ^ (n - j)

private def weightedFlux (U V : Polynomial ℝ) (g : ℝ) (n j : ℕ) : Polynomial ℝ :=
  Polynomial.C (g * (n : ℝ) * ((n - 1).choose (j - 1) : ℝ)) *
    U ^ (j - 1) * V ^ (n - j)

private theorem derivative_weightedBasis
    (U V : Polynomial ℝ) (g : ℝ)
    (hU : Polynomial.derivative U = Polynomial.C g)
    (hV : Polynomial.derivative V = -Polynomial.C g)
    (n j : ℕ) (hn : 1 ≤ n) (hj : 1 ≤ j) (_hjn : j ≤ n) :
    Polynomial.derivative (weightedBasis U V n j) =
      weightedFlux U V g n j - weightedFlux U V g n (j + 1) := by
  have hleft : (n.choose j : ℝ) * (j : ℝ) =
      (n : ℝ) * ((n - 1).choose (j - 1) : ℝ) := by
    exact_mod_cast choose_mul_index n j hn hj
  have hright : (n.choose j : ℝ) * ((n - j : ℕ) : ℝ) =
      (n : ℝ) * ((n - 1).choose j : ℝ) := by
    exact_mod_cast choose_mul_complement n j hn
  have he : n - (j + 1) = n - j - 1 := by omega
  simp only [weightedBasis, weightedFlux, Polynomial.derivative_mul,
    Polynomial.derivative_pow, Polynomial.derivative_C, hU, hV,
    zero_mul, zero_add, Nat.add_sub_cancel, he]
  have hl : Polynomial.C (n.choose j : ℝ) * Polynomial.C (j : ℝ) =
      Polynomial.C ((n : ℝ) * ((n - 1).choose (j - 1) : ℝ)) := by
    rw [← map_mul, hleft]
  have hr : Polynomial.C (n.choose j : ℝ) * Polynomial.C ((n - j : ℕ) : ℝ) =
      Polynomial.C ((n : ℝ) * ((n - 1).choose j : ℝ)) := by
    rw [← map_mul, hright]
  simp only [map_mul] at hl hr ⊢
  linear_combination
    Polynomial.C g * U ^ (j - 1) * V ^ (n - j) * hl -
    Polynomial.C g * U ^ j * V ^ (n - j - 1) * hr

private theorem weighted_upper_tail
    (k : ℕ) (_hk : 1 ≤ k) (U V : Polynomial ℝ) :
    U ^ k * tailR k U V =
      ∑ i ∈ Finset.range k, weightedBasis U V (2 * k - 1) (k + i) := by
  unfold tailR
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  have he : 2 * k - 1 - (k + i) = k - 1 - i := by omega
  simp only [weightedBasis, he, pow_add, map_natCast]
  ring

private theorem derivative_weighted_upper_tail
    (k : ℕ) (hk : 1 ≤ k) (U V : Polynomial ℝ) (g : ℝ)
    (hU : Polynomial.derivative U = Polynomial.C g)
    (hV : Polynomial.derivative V = -Polynomial.C g) :
    Polynomial.derivative (U ^ k * tailR k U V) =
      Polynomial.C (g * ((2 * k - 1 : ℕ) : ℝ) *
        ((2 * k - 2).choose (k - 1) : ℝ)) * (U * V) ^ (k - 1) := by
  rw [weighted_upper_tail k hk, Polynomial.derivative_sum]
  have heach : (∑ i ∈ Finset.range k,
      Polynomial.derivative (weightedBasis U V (2 * k - 1) (k + i))) =
      ∑ i ∈ Finset.range k,
        (weightedFlux U V g (2 * k - 1) (k + i) -
          weightedFlux U V g (2 * k - 1) (k + (i + 1))) := by
    apply Finset.sum_congr rfl
    intro i hi
    have hik : i < k := Finset.mem_range.mp hi
    simpa only [Nat.add_assoc] using
      derivative_weightedBasis U V g hU hV (2 * k - 1) (k + i)
        (by omega) (by omega) (by omega)
  rw [heach, sum_range_difference]
  have hz : (2 * k - 1 - 1).choose (k + k - 1) = 0 :=
    Nat.choose_eq_zero_of_lt (by omega)
  have h1 : 2 * k - 1 - 1 = 2 * k - 2 := by omega
  have h2 : 2 * k - 1 - k = k - 1 := by omega
  rw [h1] at hz
  simp only [weightedFlux, Nat.add_zero, hz, Nat.cast_zero, mul_zero,
    Polynomial.C_0, zero_mul, sub_zero, h1, h2]
  rw [mul_pow]
  ring

private theorem derivative_affine_product
    (a b m d₀ e₀ : ℝ) :
    let d : Polynomial ℝ := Polynomial.C (m*d₀) + Polynomial.C b * Polynomial.X
    let e : Polynomial ℝ := Polynomial.C (m*e₀) - Polynomial.C a * Polynomial.X
    Polynomial.derivative (d*e) =
      Polynomial.C b * e - Polynomial.C a * d := by
  dsimp
  simp only [Polynomial.derivative_mul, Polynomial.derivative_add,
    Polynomial.derivative_sub, Polynomial.derivative_C, Polynomial.derivative_X,
    zero_mul, zero_add, mul_one]
  ring

private theorem derivative_height_numerator_of_data
    (k : ℕ) (hk : 1 ≤ k) (a b q : ℝ)
    (d e : Polynomial ℝ)
    (hd : Polynomial.derivative d=Polynomial.C b)
    (he : Polynomial.derivative e= -Polynomial.C a) :
    Polynomial.derivative
      (Polynomial.C q*(d*e)^k -
        (Polynomial.C a*d)^k*tailR k (Polynomial.C a*d) (Polynomial.C b*e)) =
      (d*e)^(k-1) *
        (Polynomial.C ((k:ℝ)*q) * (Polynomial.C b*e-Polynomial.C a*d) -
          Polynomial.C (((2*k-1:ℕ):ℝ) *
            ((2*k-2).choose (k-1):ℝ) * (a*b)^k)) := by
  have hU : Polynomial.derivative (Polynomial.C a*d) = Polynomial.C (a*b) := by
    simp only [Polynomial.derivative_mul, Polynomial.derivative_C, hd, zero_mul, zero_add]
    rw [map_mul]
  have hV : Polynomial.derivative (Polynomial.C b*e) = -Polynomial.C (a*b) := by
    simp only [Polynomial.derivative_mul, Polynomial.derivative_C, he, zero_mul, zero_add]
    rw [map_mul]
    ring
  have hfirst : Polynomial.derivative (Polynomial.C q*(d*e)^k) =
      Polynomial.C ((k:ℝ)*q)*(d*e)^(k-1)*
        (Polynomial.C b*e-Polynomial.C a*d) := by
    simp only [Polynomial.derivative_mul, Polynomial.derivative_C,
      Polynomial.derivative_pow, hd, he, zero_mul, zero_add, map_mul]
    ring
  have ht := derivative_weighted_upper_tail k hk (Polynomial.C a*d) (Polynomial.C b*e)
    (a*b) hU hV
  have huv : (Polynomial.C a*d)*(Polynomial.C b*e) =
      Polynomial.C (a*b)*(d*e) := by rw [map_mul]; ring
  have habpow : (a*b)*(a*b)^(k-1) = (a*b)^k := by
    rw [← pow_succ', show k-1+1=k by omega]
  have hs :
      (a*b)*((2*k-1:ℕ):ℝ)*((2*k-2).choose (k-1):ℝ)*(a*b)^(k-1) =
        ((2*k-1:ℕ):ℝ)*((2*k-2).choose (k-1):ℝ)*(a*b)^k := by
    calc
      _ = (((2*k-1:ℕ):ℝ)*((2*k-2).choose (k-1):ℝ)) *
          ((a*b)*(a*b)^(k-1)) := by ring
      _ = _ := by rw [habpow]
  have hc :
      Polynomial.C ((a*b)*((2*k-1:ℕ):ℝ)*((2*k-2).choose (k-1):ℝ)) *
          ((Polynomial.C a*d)*(Polynomial.C b*e))^(k-1) =
        Polynomial.C (((2*k-1:ℕ):ℝ)*((2*k-2).choose (k-1):ℝ)*(a*b)^k) *
          (d*e)^(k-1) := by
    rw [huv, mul_pow]
    calc
      _ = Polynomial.C
          ((a*b)*((2*k-1:ℕ):ℝ)*((2*k-2).choose (k-1):ℝ)*(a*b)^(k-1)) *
            (d*e)^(k-1) := by
        simp only [map_mul, map_pow]
        ring
      _ = _ := by rw [hs]
  rw [Polynomial.derivative_sub, hfirst, ht, hc]
  ring

private theorem derivative_height_numerator
    (k : ℕ) (hk : 1 ≤ k) (a b m d₀ e₀ q : ℝ) :
    let d : Polynomial ℝ := Polynomial.C (m*d₀) + Polynomial.C b * Polynomial.X
    let e : Polynomial ℝ := Polynomial.C (m*e₀) - Polynomial.C a * Polynomial.X
    let U := Polynomial.C a*d
    let V := Polynomial.C b*e
    Polynomial.derivative
      (Polynomial.C q*(d*e)^k - U^k*tailR k U V) =
      (d*e)^(k-1) *
        (Polynomial.C ((k:ℝ)*q) * (V-U) -
          Polynomial.C (((2*k-1:ℕ):ℝ) *
            ((2*k-2).choose (k-1):ℝ) * (a*b)^k)) := by
  dsimp only
  apply derivative_height_numerator_of_data k hk a b q
  · simp only [Polynomial.derivative_add, Polynomial.derivative_mul,
      Polynomial.derivative_C, Polynomial.derivative_X, zero_add, zero_mul, mul_one]
  · simp only [Polynomial.derivative_sub, Polynomial.derivative_mul,
      Polynomial.derivative_C, Polynomial.derivative_X, zero_sub, zero_mul, zero_add, mul_one]

private theorem binary_eval_cast {R S : Type*} [CommRing R] [CommRing S]
    (f : R →+* S) (H : MvPolynomial (Fin 2) R) (d e : R) :
    MvPolynomial.eval ![f d, f e] (MvPolynomial.map f H) =
      f (MvPolynomial.eval ![d, e] H) := by
  have hh :
      (MvPolynomial.eval ![f d, f e]).comp (MvPolynomial.map f) =
        f.comp (MvPolynomial.eval ![d, e]) := by
    apply MvPolynomial.ringHom_ext
    · intro r
      simp
    · intro i
      fin_cases i <;> simp
  exact RingHom.congr_fun hh H

private theorem graph_values_integer
    (G : MvPolynomial (Fin 4) ℤ) (a : ℕ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = a ∧ m 2 + m 3 = 1)
    (d e u v : ℤ) (hz : MvPolynomial.eval ![d,e,u,v] G = 0) :
    MvPolynomial.eval ![d,e] (C01.PcParam.PP G) * u =
      MvPolynomial.eval ![d,e] (-C01.PcParam.QQ G) * v := by
  rw [C01.PcParam.lin_eval G a hG d e u v] at hz
  simp only [map_neg]
  linear_combination hz

private theorem canonical_no_common_integer
    (G : MvPolynomial (Fin 4) ℤ) (α : ℕ)
    (hG : ∀ z ∈ G.support, z 0+z 1=α ∧ z 2+z 3=1)
    (hi : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G)) :
    ∀ d e : ℤ, d ≠ 0 ∨ e ≠ 0 →
      MvPolynomial.eval ![d,e] (C01.PcParam.PP G)=0 →
      MvPolynomial.eval ![d,e] (-C01.PcParam.QQ G)=0 → False := by
  intro d e hde hp hq
  have hP := C01.PcParam.PP_hom G α hG
  have hQ := C01.PcParam.QQ_hom G α hG
  have hw : ![(d:ℂ),(e:ℂ)] ≠ (0 : Fin 2 → ℂ) := by
    intro hz
    have hd0 : (d:ℂ)=0 := by simpa using congrFun hz 0
    have he0 : (e:ℂ)=0 := by simpa using congrFun hz 1
    have hd : d=0 := by exact_mod_cast hd0
    have he : e=0 := by exact_mod_cast he0
    rcases hde with h | h
    · exact h hd
    · exact h he
  have hpC : MvPolynomial.eval ![(d:ℂ),(e:ℂ)]
      (MvPolynomial.map (Int.castRingHom ℂ) (C01.PcParam.PP G))=0 := by
    simpa [hp] using binary_eval_cast (Int.castRingHom ℂ) (C01.PcParam.PP G) d e
  have hq' : MvPolynomial.eval ![d,e] (C01.PcParam.QQ G)=0 := by
    simpa only [map_neg, neg_eq_zero] using hq
  have hqC : MvPolynomial.eval ![(d:ℂ),(e:ℂ)]
      (MvPolynomial.map (Int.castRingHom ℂ) (C01.PcParam.QQ G))=0 := by
    simpa [hq'] using binary_eval_cast (Int.castRingHom ℂ) (C01.PcParam.QQ G) d e
  exact C01.PcCurves.no_common_zero (hP.map (Int.castRingHom ℂ))
    (hQ.map (Int.castRingHom ℂ))
    (C01.PcParam.relprime_core G α hG hi) hw hpC hqC

private theorem original_residual_nonzero
    (k α : ℕ) (G : MvPolynomial (Fin 4) ℤ)
    (hG : ∀ z ∈ G.support, z 0+z 1=α ∧ z 2+z 3=1)
    (hi : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G))
    (d e u v : ℤ) (hd : d ≠ 0)
    (hs : e^k*v-d^k*u=1)
    (hz : MvPolynomial.eval ![d,e,u,v] G=0) :
    MvPolynomial.X 1^k*C01.PcParam.PP G -
      MvPolynomial.X 0^k*(-C01.PcParam.QQ G) ≠ 0 := by
  intro hzero
  have hg := graph_values_integer G α hG d e u v hz
  have hv := congrArg (MvPolynomial.eval ![d,e]) hzero
  simp only [map_sub, map_mul, map_pow, MvPolynomial.eval_X,
    Matrix.cons_val_zero, Matrix.cons_val_one, map_zero] at hv
  have ht := graph_transfer_integer k
    (MvPolynomial.eval ![d,e] (C01.PcParam.PP G))
    (MvPolynomial.eval ![d,e] (-C01.PcParam.QQ G))
    d e u v hg hs
  have hp : MvPolynomial.eval ![d,e] (C01.PcParam.PP G)=0 := by
    have h := ht.2
    rw [hv, zero_mul] at h
    exact h.symm
  have hq : MvPolynomial.eval ![d,e] (-C01.PcParam.QQ G)=0 := by
    have h := ht.1
    rw [hv, zero_mul] at h
    exact h.symm
  exact canonical_no_common_integer G α hG hi d e (Or.inl hd) hp hq

private theorem tailR_zero_right {R : Type*} [CommRing R]
    (k : ℕ) (hk : 1 ≤ k) (A : R) :
    tailR k A 0 = A^(k-1) := by
  classical
  unfold tailR
  rw [Finset.sum_eq_single (k-1)]
  · have he : k+(k-1)=2*k-1 := by omega
    simp [he]
  · intro i hi hi0
    have hik : i < k := Finset.mem_range.mp hi
    have hn : k-1-i ≠ 0 := by omega
    simp [zero_pow hn]
  · intro hnot
    exact (hnot (Finset.mem_range.mpr (by omega))).elim

private theorem binary_eval_one_zero
    {R : Type*} [CommRing R] {F : MvPolynomial (Fin 2) R} {n : ℕ}
    (hF : F.IsHomogeneous n) :
    MvPolynomial.eval ![1,0] F = F.coeff (C01.PcCurves.ex n 0) := by
  classical
  conv_lhs => rw [C01.PcCurves.hom_repr hF]
  rw [map_sum, Finset.sum_eq_single n]
  · simp
  · intro i hi hin
    have hn : n-i ≠ 0 := by
      have hi' : i < n+1 := Finset.mem_range.mp hi
      omega
    simp [zero_pow hn]
  · intro hnot
    exact (hnot (Finset.mem_range.mpr (by omega))).elim

private def translatedTailBinary (k : ℕ) (m b : ℤ) : MvPolynomial (Fin 2) ℤ :=
  tailR k (MvPolynomial.C m*MvPolynomial.X 1 -
    MvPolynomial.C b*MvPolynomial.X 0) (MvPolynomial.C b*MvPolynomial.X 0)

private theorem translatedTailBinary_homogeneous
    (k : ℕ) (hk : 1 ≤ k) (m b : ℤ) :
    (translatedTailBinary k m b).IsHomogeneous (k-1) := by
  have hx : ∀ j : Fin 2, ∀ c : ℤ,
      (MvPolynomial.C c*MvPolynomial.X j).IsHomogeneous 1 := by
    intro j c
    simpa only [zero_add] using (MvPolynomial.isHomogeneous_C (Fin 2) c).mul
      (MvPolynomial.isHomogeneous_X ℤ j)
  exact tailR_homogeneous k hk _ _ ((hx 1 m).sub (hx 0 b)) (hx 0 b)

private theorem translatedTailBinary_eval_zero_one
    (k : ℕ) (hk : 1 ≤ k) (m b : ℤ) :
    MvPolynomial.eval ![(0:ℤ),1] (translatedTailBinary k m b) = m^(k-1) := by
  unfold translatedTailBinary
  rw [tailR_map]
  simp only [map_sub, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X,
    Matrix.cons_val_zero, Matrix.cons_val_one, mul_zero, mul_one, sub_zero]
  exact tailR_zero_right k hk m

private theorem translatedTailBinary_eval_one_zero
    (k : ℕ) (hk : 1 ≤ k) (m b : ℤ) :
    MvPolynomial.eval ![(1:ℤ),0] (translatedTailBinary k m b) =
      ((2*k-2).choose (k-1):ℤ)*b^(k-1) := by
  unfold translatedTailBinary
  rw [tailR_map]
  simp only [map_sub, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X,
    Matrix.cons_val_zero, Matrix.cons_val_one, mul_zero, mul_one, zero_sub]
  exact tailR_opposite k hk b

private theorem translatedTail_coefficients
    (k : ℕ) (hk : 1 ≤ k) (m b : ℤ) :
    let T := C01.PcCurves.dehom (translatedTailBinary k m b)
    T.natDegree ≤ k-1 ∧ T.coeff 0=m^(k-1) ∧
      T.coeff (k-1)=((2*k-2).choose (k-1):ℤ)*b^(k-1) := by
  dsimp
  have hH := translatedTailBinary_homogeneous k hk m b
  refine ⟨C01.PcCurves.dehom_natDegree_le hH, ?_, ?_⟩
  · rw [C01.PcCurves.dehom_coeff hH, if_pos (Nat.zero_le _), Nat.sub_zero,
      ← binary_eval_zero_one hH]
    exact translatedTailBinary_eval_zero_one k hk m b
  · rw [C01.PcCurves.dehom_coeff hH, if_pos le_rfl, Nat.sub_self,
      ← binary_eval_one_zero hH]
    exact translatedTailBinary_eval_one_zero k hk m b

private noncomputable def crtRep (A B : ℕ) (hcop : A.Coprime B) (r s : ℤ) : ℤ :=
  (((ZMod.chineseRemainder hcop).symm ((r : ZMod A), (s : ZMod B))).val : ℤ)

private theorem crtRep_congr
    (A B : ℕ) (hA : 0 < A) (hB : 0 < B) (hcop : A.Coprime B)
    (r s : ℤ) :
    (A : ℤ) ∣ crtRep A B hcop r s - r ∧
    (B : ℤ) ∣ crtRep A B hcop r s - s := by
  let : NeZero (A * B) := ⟨mul_ne_zero (Nat.ne_of_gt hA) (Nat.ne_of_gt hB)⟩
  let z := (ZMod.chineseRemainder hcop).symm ((r : ZMod A), (s : ZMod B))
  have hz : (z.val : ZMod (A * B)) = z := ZMod.natCast_zmod_val z
  have hp : ((z.val : ZMod A), (z.val : ZMod B)) =
      ((r : ZMod A), (s : ZMod B)) := by
    calc
      _ = (ZMod.chineseRemainder hcop) (z.val : ZMod (A * B)) :=
        (map_natCast (ZMod.chineseRemainder hcop) z.val).symm
      _ = _ := by rw [hz]; exact (ZMod.chineseRemainder hcop).apply_symm_apply _
  constructor
  · apply (ZMod.intCast_zmod_eq_zero_iff_dvd _ A).mp
    push_cast
    have ht := congrArg Prod.fst hp
    simpa [crtRep, z] using sub_eq_zero.mpr ht
  · apply (ZMod.intCast_zmod_eq_zero_iff_dvd _ B).mp
    push_cast
    have ht := congrArg Prod.snd hp
    simpa [crtRep, z] using sub_eq_zero.mpr ht

private theorem combine_cover
    (A B : ℕ) (hA : 0 < A) (hB : 0 < B) (hcop : A.Coprime B)
    (R S : Finset ℤ) (Pred : ℤ → Prop)
    (hR : ∀ x, Pred x → ∃ r ∈ R, (A : ℤ) ∣ x - r)
    (hS : ∀ x, Pred x → ∃ s ∈ S, (B : ℤ) ∣ x - s) :
    ∃ T : Finset ℤ, T.card ≤ R.card * S.card ∧
      ∀ x, Pred x → ∃ t ∈ T, ((A * B : ℕ) : ℤ) ∣ x - t := by
  classical
  let T := (R ×ˢ S).image (fun rs => crtRep A B hcop rs.1 rs.2)
  refine ⟨T, ?_, ?_⟩
  · exact (Finset.card_image_le).trans (by rw [Finset.card_product])
  · intro x hx
    obtain ⟨r, hr, hxr⟩ := hR x hx
    obtain ⟨s, hs, hxs⟩ := hS x hx
    let t := crtRep A B hcop r s
    refine ⟨t, Finset.mem_image.mpr ⟨(r,s), Finset.mem_product.mpr ⟨hr,hs⟩, rfl⟩, ?_⟩
    have ht := crtRep_congr A B hA hB hcop r s
    have hAt : (A : ℤ) ∣ x - t := by
      simpa only [sub_sub_sub_cancel_right] using dvd_sub hxr ht.1
    have hBt : (B : ℤ) ∣ x - t := by
      simpa only [sub_sub_sub_cancel_right] using dvd_sub hxs ht.2
    have hco : (A : ℤ).natAbs.Coprime (B : ℤ).natAbs := by simpa using hcop
    have hmod : Int.ModEq ((A : ℤ) * (B : ℤ)) t x :=
      (Int.modEq_and_modEq_iff_modEq_mul hco).mp
        ⟨Int.modEq_iff_dvd.mpr hAt, Int.modEq_iff_dvd.mpr hBt⟩
    simpa only [Nat.cast_mul] using Int.modEq_iff_dvd.mp hmod

private theorem finite_cover {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (Q L : ι → ℕ) (Pred : ℤ → Prop)
    (hpos : ∀ i ∈ s, 0 < Q i)
    (hpair : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → (Q i).Coprime (Q j))
    (hloc : ∀ i ∈ s, ∃ R : Finset ℤ, R.card ≤ L i ∧
      ∀ z, Pred z → ∃ a ∈ R, (Q i : ℤ) ∣ z - a) :
    ∃ T : Finset ℤ, T.card ≤ ∏ i ∈ s, L i ∧
      ∀ z, Pred z → ∃ a ∈ T, ((∏ i ∈ s, Q i : ℕ) : ℤ) ∣ z - a := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    refine ⟨{0}, by simp, ?_⟩
    intro z hz
    refine ⟨0, Finset.mem_singleton_self _, ?_⟩
    simp
  | @insert i s hi ih =>
    obtain ⟨R, hRc, hRv⟩ := hloc i (Finset.mem_insert_self _ _)
    have hposS : ∀ j ∈ s, 0 < Q j :=
      fun j hj => hpos j (Finset.mem_insert_of_mem hj)
    have hpairS : ∀ j ∈ s, ∀ k ∈ s, j ≠ k → (Q j).Coprime (Q k) :=
      fun j hj k hk hne => hpair j (Finset.mem_insert_of_mem hj)
        k (Finset.mem_insert_of_mem hk) hne
    have hlocS : ∀ j ∈ s, ∃ R : Finset ℤ, R.card ≤ L j ∧
        ∀ z, Pred z → ∃ a ∈ R, (Q j : ℤ) ∣ z - a :=
      fun j hj => hloc j (Finset.mem_insert_of_mem hj)
    obtain ⟨S, hSc, hSv⟩ := ih hposS hpairS hlocS
    have hcop : (Q i).Coprime (∏ j ∈ s, Q j) := by
      apply Nat.Coprime.prod_right
      intro j hj
      exact hpair i (Finset.mem_insert_self _ _)
        j (Finset.mem_insert_of_mem hj) (by intro hij; subst j; exact hi hj)
    have hprodpos : 0 < ∏ j ∈ s, Q j := Finset.prod_pos hposS
    obtain ⟨T, hTc, hTv⟩ := combine_cover (Q i) (∏ j ∈ s, Q j)
      (hpos i (Finset.mem_insert_self _ _)) hprodpos hcop R S Pred hRv hSv
    refine ⟨T, ?_, ?_⟩
    · rw [Finset.prod_insert hi]
      exact hTc.trans (Nat.mul_le_mul hRc hSc)
    · simpa only [Finset.prod_insert hi] using hTv

private theorem prime_valuation_self (p : ℕ) [Fact p.Prime] :
    padicValNat p p=1 := by
  have hp : p.Prime := Fact.out
  have hlow : 1≤padicValNat p p :=
    (padicValNat_dvd_iff_le hp.ne_zero).mp (by simp)
  have hupp : padicValNat p p≤1 := by
    by_contra hh
    have hd : p^2∣p := (padicValNat_dvd_iff_le hp.ne_zero).mpr (by omega)
    have hle := Nat.le_of_dvd hp.pos hd
    have hp2 := hp.two_le
    nlinarith
  omega

private theorem prime_valuation_other (p t : ℕ) [Fact p.Prime]
    (ht : t.Prime) (hne : p≠t) : padicValNat p t=0 := by
  have hp : p.Prime := Fact.out
  have hcop : p.Coprime t := (Nat.coprime_primes hp ht).mpr hne
  apply padicValNat.eq_zero_of_not_dvd
  intro hd
  have hg : p∣Nat.gcd p t := Nat.dvd_gcd dvd_rfl hd
  have hgone : Nat.gcd p t=1 := hcop
  rw [hgone] at hg
  exact hp.ne_one (Nat.dvd_one.mp hg)

private theorem prime_product_positive (s : Finset ℕ) (f : ℕ→ℕ)
    (hprime : ∀ p∈s,p.Prime) :
    0<∏ p∈s,p^f p := by
  exact Finset.prod_pos (fun p hp => pow_pos (hprime p hp).pos _)

private theorem prime_product_valuation (s : Finset ℕ) (f : ℕ→ℕ)
    (hprime : ∀ t∈s,t.Prime) (p : ℕ) [Fact p.Prime] :
    padicValNat p (∏ t∈s,t^f t)=if p∈s then f p else 0 := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert t s ht ih =>
    have htp : t.Prime := hprime t (Finset.mem_insert_self _ _)
    have hsp : ∀ t∈s,t.Prime := fun t h => hprime t (Finset.mem_insert_of_mem h)
    have hprod0 : (∏ t∈s,t^f t)≠0 := Nat.ne_of_gt (prime_product_positive s f hsp)
    rw [Finset.prod_insert ht,padicValNat.mul (pow_ne_zero _ htp.ne_zero) hprod0,
      padicValNat.pow,ih hsp]
    by_cases hpt : p=t
    · subst t
      rw [prime_valuation_self p]
      simp [ht]
    · rw [prime_valuation_other p t htp hpt]
      simp [hpt]

private theorem nat_eq_of_prime_valuations (n N : ℕ) (hn : n≠0) (hN : N≠0)
    (hval : ∀ p : ℕ,p.Prime → padicValNat p n=padicValNat p N) :
    n=N := by
  have hdiv (a b : ℕ) (ha : a≠0) (hb : b≠0)
      (hv : ∀ p : ℕ,p.Prime → padicValNat p a≤padicValNat p b) : a∣b := by
    apply (Nat.factorization_le_iff_dvd ha hb).mp
    change ∀ p : ℕ,a.factorization p≤b.factorization p
    intro p
    by_cases hp : p.Prime
    · rw [Nat.factorization_def a hp,Nat.factorization_def b hp]
      exact hv p hp
    · rw [Nat.factorization_eq_zero_of_not_prime a hp]
      exact Nat.zero_le _
  exact Nat.dvd_antisymm (hdiv n N hn hN (fun p hp => (hval p hp).le))
    (hdiv N n hN hn (fun p hp => (hval p hp).symm.le))
private theorem prime_part_divides (s : Finset ℕ) (N : ℕ) (hN : N≠0)
    (hsp : ∀ p∈s,p.Prime) :
    (∏ p∈s,p^(padicValNat p N))∣N := by
  have hprod0 : (∏ p∈s,p^(padicValNat p N))≠0 :=
    Nat.ne_of_gt (prime_product_positive s _ hsp)
  apply (Nat.factorization_le_iff_dvd hprod0 hN).mp
  change ∀ p : ℕ,(∏ p∈s,p^(padicValNat p N)).factorization p≤N.factorization p
  intro p
  by_cases hp : p.Prime
  · let : Fact p.Prime := ⟨hp⟩
    rw [Nat.factorization_def _ hp,Nat.factorization_def _ hp,
      prime_product_valuation s _ hsp p]
    split_ifs <;> omega
  · rw [Nat.factorization_eq_zero_of_not_prime _ hp]
    exact Nat.zero_le _

private theorem coarse_modulus_identity (n : ℕ) (hn : n≠0) :
    (∏ p∈n.primeFactors,p^padicValNat p n)=n := by
  have hsp : ∀ p∈n.primeFactors,p.Prime :=
    fun p hp => (Nat.mem_primeFactors.mp hp).1
  apply nat_eq_of_prime_valuations _ _
    (Nat.ne_of_gt (prime_product_positive _ _ hsp)) hn
  intro p hp
  let : Fact p.Prime := ⟨hp⟩
  rw [prime_product_valuation _ _ hsp p]
  by_cases hmem : p∈n.primeFactors
  · rw [if_pos hmem]
  · rw [if_neg hmem]
    symm
    apply padicValNat.eq_zero_of_not_dvd
    intro hd
    exact hmem (Nat.mem_primeFactors.mpr ⟨hp,hd,hn⟩)

private theorem coarse_global_cover
    (k n N : ℕ) (hn : n≠0) (hN : N≠0) (Pred : ℤ→Prop)
    (hloc : ∀ p∈n.primeFactors, ∃ R : Finset ℤ,
      R.card ≤ k*p^(padicValNat p N) ∧
        ∀ z,Pred z → ∃ a∈R,(p:ℤ)^(padicValNat p n)∣z-a) :
    ∃ T : Finset ℤ,T.card ≤ k^n.primeFactors.card*N ∧
      ∀ z,Pred z → ∃ a∈T,(n:ℤ)∣z-a := by
  classical
  have hsp : ∀ p∈n.primeFactors,p.Prime :=
    fun p hp => (Nat.mem_primeFactors.mp hp).1
  have hpos : ∀ p∈n.primeFactors,0<p^padicValNat p n :=
    fun p hp => pow_pos (hsp p hp).pos _
  have hpair : ∀ p∈n.primeFactors,∀ t∈n.primeFactors,p≠t →
      (p^padicValNat p n).Coprime (t^padicValNat t n) := by
    intro p hp t ht hpt
    exact ((Nat.coprime_primes (hsp p hp) (hsp t ht)).mpr hpt).pow _ _
  have hloc' : ∀ p∈n.primeFactors, ∃ R : Finset ℤ,
      R.card ≤ k*p^(padicValNat p N) ∧
        ∀ z,Pred z → ∃ a∈R,((p^padicValNat p n:ℕ):ℤ)∣z-a := by
    simpa only [Nat.cast_pow] using hloc
  obtain ⟨T,hTc,hTv⟩ := finite_cover n.primeFactors
    (fun p => p^padicValNat p n) (fun p => k*p^padicValNat p N)
    Pred hpos hpair hloc'
  refine ⟨T,?_,?_⟩
  · have hpart : (∏ p∈n.primeFactors,p^padicValNat p N) ≤ N :=
      Nat.le_of_dvd (Nat.pos_of_ne_zero hN) (prime_part_divides _ N hN hsp)
    rw [Finset.prod_mul_distrib] at hTc
    simp only [Finset.prod_const] at hTc
    exact hTc.trans (Nat.mul_le_mul_left _ hpart)
  · simpa only [coarse_modulus_identity n hn] using hTv

private theorem translatedTail_eval
    (k : ℕ) (hk : 1 ≤ k) (m b e : ℤ) :
    Polynomial.eval e (C01.PcCurves.dehom (translatedTailBinary k m b)) =
      tailR k (m-b*e) (b*e) := by
  rw [C01.PcCurves.dehom_eval (translatedTailBinary_homogeneous k hk m b)]
  unfold translatedTailBinary
  rw [tailR_map]
  simp only [map_sub, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X,
    Matrix.cons_val_zero, Matrix.cons_val_one, mul_one]

private def coarseNumerator (k : ℕ) (q a m b : ℤ) : Polynomial ℤ :=
  Polynomial.C q*Polynomial.X^k -
    Polynomial.C (a^k)*C01.PcCurves.dehom (translatedTailBinary k m b)

private theorem coarseNumerator_eval
    (k : ℕ) (hk : 1 ≤ k) (q a m b e : ℤ) :
    Polynomial.eval e (coarseNumerator k q a m b) =
      q*e^k-a^k*tailR k (m-b*e) (b*e) := by
  unfold coarseNumerator
  simp only [Polynomial.eval_sub, Polynomial.eval_mul, Polynomial.eval_C,
    Polynomial.eval_pow, Polynomial.eval_X, translatedTail_eval k hk]

private theorem coarseNumerator_coeff_zero
    (k : ℕ) (hk : 1 ≤ k) (q a m b : ℤ) :
    (coarseNumerator k q a m b).coeff 0 = -a^k*m^(k-1) := by
  have hT := (translatedTail_coefficients k hk m b).2.1
  unfold coarseNumerator
  rw [Polynomial.coeff_sub,Polynomial.coeff_C_mul_X_pow,
    if_neg (show (0:ℕ)≠k by omega),Polynomial.coeff_C_mul,hT]
  ring

private theorem coarseNumerator_coeff_critical
    (k : ℕ) (hk : 1 ≤ k) (q a m b : ℤ) :
    (coarseNumerator k q a m b).coeff (k-1) =
      -a^k*((2*k-2).choose (k-1):ℤ)*b^(k-1) := by
  have hT := (translatedTail_coefficients k hk m b).2.2
  unfold coarseNumerator
  rw [Polynomial.coeff_sub,Polynomial.coeff_C_mul_X_pow,
    if_neg (show k-1≠k by omega),Polynomial.coeff_C_mul,hT]
  ring

private theorem coarseNumerator_degree
    (k : ℕ) (hk : 1 ≤ k) (q a m b : ℤ) :
    (coarseNumerator k q a m b).natDegree ≤ k := by
  let B : MvPolynomial (Fin 2) ℤ :=
    MvPolynomial.C q*MvPolynomial.X 0^k -
      MvPolynomial.C (a^k)*MvPolynomial.X 1*translatedTailBinary k m b
  have hfirst : (MvPolynomial.C q*MvPolynomial.X (0:Fin 2)^k).IsHomogeneous k := by
    simpa only [zero_add, one_mul] using
      (MvPolynomial.isHomogeneous_C (Fin 2) q).mul
        ((MvPolynomial.isHomogeneous_X ℤ (0:Fin 2)).pow k)
  have hsecond :
      (MvPolynomial.C (a^k)*MvPolynomial.X 1*translatedTailBinary k m b).IsHomogeneous k := by
    have hh := ((MvPolynomial.isHomogeneous_C (Fin 2) (a^k)).mul
      (MvPolynomial.isHomogeneous_X ℤ (1:Fin 2))).mul
        (translatedTailBinary_homogeneous k hk m b)
    simpa only [zero_add, show 1+(k-1)=k by omega] using hh
  have hB : B.IsHomogeneous k := hfirst.sub hsecond
  have hbridge : C01.PcCurves.dehom B = coarseNumerator k q a m b := by
    simp [B, coarseNumerator, C01.PcCurves.dehom, map_sub, map_mul, map_pow]
  rw [← hbridge]
  exact C01.PcCurves.dehom_natDegree_le hB

private theorem original_coarseNumerator_congruence
    (k : ℕ) (hk : 1 ≤ k) (a b d e m q u D : ℤ)
    (hlevel : a*d+b*e=m)
    (hD : D=tailR k (a*d) (b*e))
    (hinv : m^(2*k-1)*u=q*e^k-a^k*D) :
    m^(2*k-1) ∣ (coarseNumerator k q a m b).eval e := by
  rw [coarseNumerator_eval k hk]
  have ha : m-b*e=a*d := by linear_combination -hlevel
  rw [ha, ← hD, ← hinv]
  exact dvd_mul_right _ _

private theorem integer_valuation_factor_owned (p : ℕ) [Fact p.Prime]
    (z : ℤ) (hz : z≠0) :
    ∃ Z : ℤ,z=(p:ℤ)^(padicValNat p z.natAbs)*Z ∧ ¬ (p:ℤ)∣Z := by
  let v := padicValNat p z.natAbs
  have hz0 : z.natAbs≠0 := Nat.ne_of_gt (Int.natAbs_pos.mpr hz)
  have hdN : p^v∣z.natAbs := (padicValNat_dvd_iff_le hz0).mpr le_rfl
  have hdZ : (p:ℤ)^v∣z :=
    (Int.natAbs_dvd_natAbs).mp (by simpa using hdN)
  obtain ⟨Z,hZ⟩ := hdZ
  refine ⟨Z,hZ,?_⟩
  rintro ⟨w,hw⟩
  have hnext : (p:ℤ)^(v+1)∣z := by
    refine ⟨w,?_⟩
    rw [hZ,hw,pow_succ]
    ring
  have hnextN : p^(v+1)∣z.natAbs := by
    have hh := (Int.natAbs_dvd_natAbs).mpr hnext
    simpa using hh
  have hle := (padicValNat_dvd_iff_le hz0).mp hnextN
  dsimp [v] at hle
  omega

private theorem coarseNumerator_constant_valuation
    (p k : ℕ) (hp : p.Prime) (hk : 1 ≤ k)
    (q a m b : ℤ) (hm : m≠0) (ha : ¬(p:ℤ)∣a) :
    ¬ (p:ℤ)^((k-1)*padicValNat p m.natAbs+1) ∣
      (coarseNumerator k q a m b).coeff 0 := by
  let : Fact p.Prime := ⟨hp⟩
  have hp0 : (p:ℤ)≠0 := by exact_mod_cast hp.ne_zero
  obtain ⟨M,hM,hMu⟩ := integer_valuation_factor_owned p m hm
  have ha0 : (a:ZMod p)≠0 :=
    fun h => ha ((ZMod.intCast_zmod_eq_zero_iff_dvd a p).mp h)
  have hM0 : (M:ZMod p)≠0 :=
    fun h => hMu ((ZMod.intCast_zmod_eq_zero_iff_dvd M p).mp h)
  have hunit : ¬ (p:ℤ) ∣ -a^k*M^(k-1) := by
    intro hd
    have hz := (ZMod.intCast_zmod_eq_zero_iff_dvd (-a^k*M^(k-1)) p).mpr hd
    push_cast at hz
    exact (mul_ne_zero (neg_ne_zero.mpr (pow_ne_zero k ha0))
      (pow_ne_zero (k-1) hM0)) hz
  have hpow : m^(k-1) =
      (p:ℤ)^((k-1)*padicValNat p m.natAbs)*M^(k-1) := by
    calc
      m^(k-1) = ((p:ℤ)^(padicValNat p m.natAbs)*M)^(k-1) :=
        congrArg (fun z : ℤ => z^(k-1)) hM
      _ = _ := by rw [mul_pow, ← pow_mul, Nat.mul_comm (padicValNat p m.natAbs) (k-1)]
  have heq : (coarseNumerator k q a m b).coeff 0 =
      (p:ℤ)^((k-1)*padicValNat p m.natAbs)*(-a^k*M^(k-1)) := by
    rw [coarseNumerator_coeff_zero k hk, hpow]
    ring
  intro hd
  rw [heq] at hd
  exact hunit ((power_cancel (p:ℤ) hp0
    ((k-1)*padicValNat p m.natAbs) _).mp hd)

private theorem oriented_coarse_prime_cover
    (p k : ℕ) (hp : p.Prime) (hk : 1 ≤ k)
    (q a m b : ℤ) (hm : m≠0) (ha : ¬(p:ℤ)∣a) :
    ∃ T : Finset ℤ,T.card ≤ k ∧
      ∀ e : ℤ,(p:ℤ)^((2*k-1)*padicValNat p m.natAbs) ∣
        (coarseNumerator k q a m b).eval e →
      ∃ r∈T,(p:ℤ)^(padicValNat p m.natAbs)∣e-r := by
  have hc := coarseNumerator_constant_valuation p k hp hk q a m b hm ha
  obtain ⟨T,hTc,hTv⟩ := coarse_prime_cover p k (padicValNat p m.natAbs) 0 0
    (coarseNumerator k q a m b) hp hk (coarseNumerator_degree k hk q a m b)
    (by simpa only [Nat.add_zero] using hc)
  exact ⟨T,by simpa only [pow_zero,mul_one] using hTc,hTv⟩

private theorem coefficient_orientation (p : ℕ) [Fact p.Prime]
    (a b d0 e0 : ℤ) (hbase : a*d0+b*e0=1) :
    ¬ (p:ℤ)∣a ∨ ¬ (p:ℤ)∣b := by
  by_cases ha : (p:ℤ)∣a
  · right
    intro hb
    have ha0 : (a : ZMod p)=0 :=
      (ZMod.intCast_zmod_eq_zero_iff_dvd a p).mpr ha
    have hb0 : (b : ZMod p)=0 :=
      (ZMod.intCast_zmod_eq_zero_iff_dvd b p).mpr hb
    have h := congrArg (fun z : ℤ => (z : ZMod p)) hbase
    push_cast at h
    simp [ha0,hb0] at h
  · exact Or.inl ha

private theorem cancel_unit_power (p : ℕ) [Fact p.Prime] (n : ℕ) (u : ℤ)
    (hu : ¬ (p:ℤ)∣u) :
    ∀ v : ℤ,(p:ℤ)^n∣v*u → (p:ℤ)^n∣v := by
  have hp : (p:ℤ)≠0 := by exact_mod_cast (Fact.out : p.Prime).ne_zero
  induction n with
  | zero => intro v hv; simp
  | succ n ih =>
    intro v hv
    have hdiv : (p:ℤ)∣v*u := by
      simpa only [pow_one] using
        (pow_dvd_pow (p:ℤ) (by omega : 1≤n+1)).trans hv
    have hu0 : (u : ZMod p)≠0 :=
      fun h => hu ((ZMod.intCast_zmod_eq_zero_iff_dvd u p).mp h)
    have hz : (v : ZMod p)*(u : ZMod p)=0 := by
      have h := (ZMod.intCast_zmod_eq_zero_iff_dvd (v*u) p).mpr hdiv
      simpa only [Int.cast_mul] using h
    have hv0 : (v : ZMod p)=0 := (mul_eq_zero.mp hz).resolve_right hu0
    obtain ⟨w,hw⟩ := (ZMod.intCast_zmod_eq_zero_iff_dvd v p).mp hv0
    obtain ⟨t,ht⟩ := hv
    have hrest : w*u=(p:ℤ)^n*t := by
      apply mul_left_cancel₀ hp
      calc
        (p:ℤ)*(w*u)=v*u := by rw [hw];ring
        _ = (p:ℤ)^(n+1)*t := ht
        _ = (p:ℤ)*((p:ℤ)^n*t) := by rw [pow_succ];ring
    obtain ⟨s,hs⟩ := ih w ⟨t,hrest⟩
    refine ⟨s,?_⟩
    rw [hw,hs,pow_succ]
    ring
private theorem pullback_cover (p n : ℕ) [Fact p.Prime]
    (a c : ℤ) (ha : ¬ (p:ℤ)∣a) (Pred : ℤ→Prop) (U : Finset ℤ)
    (hU : ∀ r : ℤ,Pred r → ∃ u∈U,(p:ℤ)^n∣(c+a*r)-u) :
    ∃ T : Finset ℤ,T.card≤U.card ∧
      ∀ r : ℤ,Pred r → ∃ t∈T,(p:ℤ)^n∣r-t := by
  classical
  let pick : ℤ→ℤ := fun u =>
    if h : ∃ r : ℤ,Pred r ∧ (p:ℤ)^n∣(c+a*r)-u then Classical.choose h else 0
  refine ⟨U.image pick,Finset.card_image_le,?_⟩
  intro r hr
  obtain ⟨u,hu,hru⟩ := hU r hr
  have hex : ∃ t : ℤ,Pred t ∧ (p:ℤ)^n∣(c+a*t)-u := ⟨r,hr,hru⟩
  have hpr : Pred (pick u) ∧ (p:ℤ)^n∣(c+a*pick u)-u := by
    dsimp only [pick]
    rw [dif_pos hex]
    exact Classical.choose_spec hex
  refine ⟨pick u,Finset.mem_image.mpr ⟨u,hu,rfl⟩,?_⟩
  have hh := dvd_sub hru hpr.2
  have hdiff : ((c+a*r)-u)-((c+a*pick u)-u)=(r-pick u)*a := by ring
  have hh' : (p:ℤ)^n∣(r-pick u)*a := by
    rwa [hdiff] at hh
  exact cancel_unit_power p n a ha (r-pick u) hh'

private def levelCongruences (k : ℕ) (a b d₀ e₀ m q r : ℤ) : Prop :=
  m^(2*k-1) ∣ (coarseNumerator k q a m b).eval (m*e₀-a*r) ∧
  m^(2*k-1) ∣ (coarseNumerator k (-q) b m a).eval (m*d₀+b*r)

private theorem levelCongruences_prime_cover
    (p k : ℕ) (hp : p.Prime) (hk : 1 ≤ k)
    (a b d₀ e₀ m q : ℤ) (hm : m≠0)
    (hbase : a*d₀+b*e₀=1) :
    ∃ T : Finset ℤ,T.card ≤ k ∧
      ∀ r,levelCongruences k a b d₀ e₀ m q r →
        ∃ t∈T,(p:ℤ)^(padicValNat p m.natAbs)∣r-t := by
  let : Fact p.Prime := ⟨hp⟩
  obtain ⟨M,hM,hMu⟩ := integer_valuation_factor_owned p m hm
  have hpow : (p:ℤ)^((2*k-1)*padicValNat p m.natAbs) ∣ m^(2*k-1) := by
    refine ⟨M^(2*k-1),?_⟩
    calc
      m^(2*k-1)=((p:ℤ)^padicValNat p m.natAbs*M)^(2*k-1) :=
        congrArg (fun z : ℤ => z^(2*k-1)) hM
      _ = _ := by
        rw [mul_pow, ← pow_mul, Nat.mul_comm (padicValNat p m.natAbs) (2*k-1)]
  rcases coefficient_orientation p a b d₀ e₀ hbase with ha | hb
  · obtain ⟨U,hUc,hUv⟩ := oriented_coarse_prime_cover p k hp hk q a m b hm ha
    have hna : ¬(p:ℤ)∣(-a) := by simpa only [dvd_neg] using ha
    obtain ⟨T,hTc,hTv⟩ := pullback_cover p (padicValNat p m.natAbs)
      (-a) (m*e₀) hna (levelCongruences k a b d₀ e₀ m q) U
      (by
        intro r hr
        obtain ⟨u,hu,hru⟩ := hUv (m*e₀-a*r) (hpow.trans hr.1)
        exact ⟨u,hu,by simpa only [neg_mul,sub_eq_add_neg] using hru⟩)
    exact ⟨T,hTc.trans hUc,hTv⟩
  · obtain ⟨U,hUc,hUv⟩ := oriented_coarse_prime_cover p k hp hk (-q) b m a hm hb
    obtain ⟨T,hTc,hTv⟩ := pullback_cover p (padicValNat p m.natAbs)
      b (m*d₀) hb (levelCongruences k a b d₀ e₀ m q) U
      (by
        intro r hr
        exact hUv (m*d₀+b*r) (hpow.trans hr.2))
    exact ⟨T,hTc.trans hUc,hTv⟩

private theorem levelCongruences_global_cover
    (k : ℕ) (hk : 1 ≤ k) (a b d₀ e₀ m q : ℤ)
    (hm : m≠0) (hbase : a*d₀+b*e₀=1) :
    ∃ T : Finset ℤ,T.card ≤ k^m.natAbs.primeFactors.card ∧
      ∀ r,levelCongruences k a b d₀ e₀ m q r →
        ∃ t∈T,(m.natAbs:ℤ)∣r-t := by
  have hn : m.natAbs≠0 := Nat.ne_of_gt (Int.natAbs_pos.mpr hm)
  have hloc : ∀ p∈m.natAbs.primeFactors, ∃ T : Finset ℤ,
      T.card ≤ k*p^(padicValNat p 1) ∧
      ∀ r,levelCongruences k a b d₀ e₀ m q r →
        ∃ t∈T,(p:ℤ)^padicValNat p m.natAbs∣r-t := by
    intro p hp
    have hprime := (Nat.mem_primeFactors.mp hp).1
    simpa using levelCongruences_prime_cover p k hprime hk a b d₀ e₀ m q hm hbase
  obtain ⟨T,hTc,hTv⟩ := coarse_global_cover k m.natAbs 1 hn (by omega)
    (levelCongruences k a b d₀ e₀ m q) hloc
  exact ⟨T,by simpa only [mul_one] using hTc,hTv⟩

private theorem original_levelCongruences
    (k : ℕ) (hk : 1 ≤ k) (a b d₀ e₀ m q d e r u v : ℤ)
    (hlevel : a*d+b*e=m)
    (hd : d=m*d₀+b*r) (he : e=m*e₀-a*r)
    (hu : m^(2*k-1)*u=q*e^k-a^k*tailR k (a*d) (b*e))
    (hv : m^(2*k-1)*v=q*d^k+b^k*tailR k (b*e) (a*d)) :
    levelCongruences k a b d₀ e₀ m q r := by
  have hfirst := original_coarseNumerator_congruence k hk a b d e m q u
    (tailR k (a*d) (b*e)) hlevel rfl hu
  have hlevel' : b*e+a*d=m := by linear_combination hlevel
  have hv' : m^(2*k-1)*(-v)=(-q)*d^k-b^k*tailR k (b*e) (a*d) := by
    linear_combination -hv
  have hsecond := original_coarseNumerator_congruence k hk b a e d m (-q) (-v)
    (tailR k (b*e) (a*d)) hlevel' rfl hv'
  exact ⟨by simpa only [he] using hfirst,by simpa only [hd] using hsecond⟩

private theorem ratio_cell_determinant
    (d e d' e' ρ M E D : ℝ)
    (he : 0 < e) (he' : 0 < e') (hM : 0 < M)
    (hE : 0 < E) (hD : 0 < D) (hρ : 0 ≤ ρ)
    (hρD : ρ ≤ 2*D/E)
    (heE : e ≤ E) (he'E : e' ≤ E)
    (hlo : ρ*e ≤ d) (hhi : d ≤ ρ*(1+1/M)*e)
    (hlo' : ρ*e' ≤ d') (hhi' : d' ≤ ρ*(1+1/M)*e') :
    |d*e'-d'*e| ≤ 2*D*E/M := by
  have hraw : |d*e'-d'*e| ≤ ρ*e*e'/M := by
    apply abs_le.mpr
    constructor
    · have hh :
          d'*e-d*e' ≤ ρ*e*e'/M := by
        calc
          d'*e-d*e' ≤ (ρ*(1+1/M)*e')*e-(ρ*e)*e' :=
            sub_le_sub (mul_le_mul_of_nonneg_right hhi' he.le)
              (mul_le_mul_of_nonneg_right hlo he'.le)
          _ = _ := by ring
      linarith
    · calc
        d*e'-d'*e ≤ (ρ*(1+1/M)*e)*e'-(ρ*e')*e :=
          sub_le_sub (mul_le_mul_of_nonneg_right hhi he'.le)
            (mul_le_mul_of_nonneg_right hlo' he.le)
        _ = _ := by ring
  have hprod : e*e' ≤ E*E :=
    mul_le_mul heE he'E he'.le hE.le
  have hrhoEE : ρ*(E*E) ≤ 2*D*E := by
    have hh := mul_le_mul_of_nonneg_right hρD (mul_self_nonneg E)
    have hden : (2*D/E)*(E*E)=2*D*E := by field_simp [ne_of_gt hE]
    simpa only [hden] using hh
  calc
    |d*e'-d'*e| ≤ ρ*e*e'/M := hraw
    _ ≤ ρ*(E*E)/M := by
      apply div_le_div_of_nonneg_right _ hM.le
      simpa only [mul_assoc] using mul_le_mul_of_nonneg_left hprod hρ
    _ ≤ 2*D*E/M := div_le_div_of_nonneg_right hrhoEE hM.le

private theorem level_parameter_determinant
    (a b d₀ e₀ m r r' : ℝ) (hbase : a*d₀+b*e₀=1) :
    (m*d₀+b*r)*(m*e₀-a*r') -
        (m*d₀+b*r')*(m*e₀-a*r) = m*(r-r') := by
  linear_combination m*(r-r')*hbase

private theorem parameter_cell_width
    (a b d₀ e₀ m r r' _ρ M E D : ℝ)
    (hbase : a*d₀+b*e₀=1) (hm : m ≠ 0)
    (hdet : |(m*d₀+b*r)*(m*e₀-a*r') -
      (m*d₀+b*r')*(m*e₀-a*r)| ≤ 2*D*E/M) :
    |r-r'| ≤ 2*D*E/(M*|m|) := by
  rw [level_parameter_determinant a b d₀ e₀ m r r' hbase, abs_mul] at hdet
  rw [← div_div]
  apply (le_div_iff₀ (abs_pos.mpr hm)).mpr
  simpa only [mul_comm] using hdet

open Polynomial
open FormalAB.S5a5b0bd5
open FormalAB.S5a5b0bd5.ConsecutiveCountingA5PureCubicRange

private theorem colored_integer_diameter_count {n : ℕ}
    (T : Finset ℤ) (color : ℤ→Fin n) (L : ℝ) (_hL : 0≤L)
    (hdiam : ∀ s∈T,∀ t∈T,color s=color t → s≤t → ((t-s:ℤ):ℝ)≤L) :
    T.card≤n*(2*Nat.ceil L+1) := by
  classical
  let q : ℕ := Nat.ceil L
  let anchor : Fin n→ℤ := fun i =>
    if h : ∃ z : ℤ,z∈T ∧ color z=i then Classical.choose h else 0
  have hspan : ∀ z∈T,-(q:ℤ)≤z-anchor (color z) ∧ z-anchor (color z)≤(q:ℤ) := by
    intro z hz
    have hex : ∃ w : ℤ,w∈T ∧ color w=color z := ⟨z,hz,rfl⟩
    have ha : anchor (color z)∈T ∧ color (anchor (color z))=color z := by
      dsimp only [anchor]
      rw [dif_pos hex]
      exact Classical.choose_spec hex
    have hceil : L≤(q:ℝ) := Nat.le_ceil L
    by_cases ho : z≤anchor (color z)
    · have hh := (hdiam z hz (anchor (color z)) ha.1 ha.2.symm ho).trans hceil
      have hhZ : anchor (color z)-z≤(q:ℤ) := by exact_mod_cast hh
      constructor <;> omega
    · have ho' : anchor (color z)≤z := by omega
      have hh := (hdiam (anchor (color z)) ha.1 z hz ha.2 ho').trans hceil
      have hhZ : z-anchor (color z)≤(q:ℤ) := by exact_mod_cast hh
      constructor <;> omega
  let encode : (z : ℤ) → z∈T → Fin n×Fin (2*q+1) := fun z hz =>
    (color z,⟨(z-anchor (color z)+(q:ℤ)).toNat,by
      have hh := hspan z hz
      omega⟩)
  let f : {z : ℤ // z∈T} → Fin n×Fin (2*q+1) :=
    fun z => encode z.1 z.2
  have hf : Function.Injective f := by
    intro z w hzw
    have hc : color z.1=color w.1 := congrArg Prod.fst hzw
    have hi := congrArg (fun p : Fin n×Fin (2*q+1) => p.2.val) hzw
    change (z.1-anchor (color z.1)+(q:ℤ)).toNat =
      (w.1-anchor (color w.1)+(q:ℤ)).toNat at hi
    have hz := hspan z.1 z.2
    have hw := hspan w.1 w.2
    rw [hc] at hi
    rw [hc] at hz
    apply Subtype.ext
    omega
  have hc := Fintype.card_le_of_injective f hf
  simpa only [Fintype.card_coe, Fintype.card_prod,Fintype.card_fin] using hc

private theorem polynomial_boundary_count
    (n : ℕ) (B : Finset (Polynomial ℝ)) (T : Finset ℤ) (A F : ℝ)
    (hA : 1 ≤ A) (hF : 1 ≤ F)
    (hR : (B.biUnion fun P => P.roots.toFinset).card ≤ n)
    (hvalid : ∀ z ∈ T, ∀ P ∈ B, 0 ≤ P.eval (z : ℝ))
    (hdiam : ∀ s ∈ T, ∀ t ∈ T, s ≤ t →
      (∀ P ∈ B, ∀ z ∈ Set.Icc (s : ℝ) (t : ℝ), 0 ≤ P.eval z) →
      ((t-s : ℤ) : ℝ) ≤ A*F) :
    T.card ≤ (n+1)*(2*Nat.ceil (A*F)+1)+1 := by
  classical
  let R : Finset ℝ := B.biUnion fun P => P.roots.toFinset
  let color : ℤ → Fin (n+1) := fun z =>
    ⟨(R.filter fun r => r ≤ (z : ℝ)).card, by
      have hh := (Finset.card_filter_le R (fun r => r ≤ (z : ℝ))).trans hR
      omega⟩
  have hcard := colored_integer_diameter_count T color (A*F)
    (by positivity) (by
      intro s hs t ht hcolor hst
      apply hdiam s hs t ht hst
      intro P hp z hz
      by_cases hsame : s = t
      · subst t
        have hz' : z = (s : ℝ) := by rcases hz with ⟨h1,h2⟩; linarith
        simpa [hz'] using hvalid s hs P hp
      by_cases hp0 : P = 0
      · simp [hp0]
      have hstR : (s : ℝ) < (t : ℝ) := by
        exact_mod_cast (show s < t by omega)
      have hrank : (R.filter fun r => r ≤ (s : ℝ)).card =
          (R.filter fun r => r ≤ (t : ℝ)).card := by
        exact congrArg Fin.val hcolor
      exact nonneg_on_equal_rank_interval P R (s : ℝ) (t : ℝ) hstR
        (fun w hw => root_mem_biUnion_of_member B P hp hp0 w hw)
        hrank (hvalid s hs P hp) (hvalid t ht P hp) z hz)
  omega

private theorem polynomial_height_derivative_length
    (N : Polynomial ℝ) (s t x L : ℝ) (hst : s<t)
    (hv : ∀ z : ℝ,s≤z → z≤t → 0≤N.eval z ∧ N.eval z≤x)
    (hd : ∀ z : ℝ,s<z → z<t → L≤|N.derivative.eval z|) :
    (t-s)*L≤x := by
  exact FormalAB.Se059a44d.A5AcceptedIntervalProof.derivative_length_bound
    N s t x L hst hv hd

private theorem min_le_rpow_product
    (A B θ : ℝ) (hA : 0<A) (hB : 0<B) (hθ : 0≤θ) (hθ1 : θ≤1) :
    min A B ≤ A^θ*B^(1-θ) := by
  have hη : 0≤1-θ := by linarith
  by_cases hab : A≤B
  · rw [min_eq_left hab]
    calc
      A = A^θ*A^(1-θ) := by
        rw [← Real.rpow_add hA]
        rw [show θ+(1-θ)=(1:ℝ) by ring,Real.rpow_one]
      _ ≤ A^θ*B^(1-θ) := mul_le_mul_of_nonneg_left
        (Real.rpow_le_rpow hA.le hab hη) (Real.rpow_nonneg hA.le _)
  · have hba : B≤A := le_of_lt (lt_of_not_ge hab)
    rw [min_eq_right hba]
    calc
      B = B^θ*B^(1-θ) := by
        rw [← Real.rpow_add hB]
        rw [show θ+(1-θ)=(1:ℝ) by ring,Real.rpow_one]
      _ ≤ A^θ*B^(1-θ) := mul_le_mul_of_nonneg_right
        (Real.rpow_le_rpow hB.le hba hθ) (Real.rpow_nonneg hB.le _)

private theorem min_le_k_geometric_mean
    (k : ℕ) (hk : 1≤k) (A B : ℝ) (hA : 0<A) (hB : 0<B) :
    min A B ≤ A^(((k:ℝ)-1)/(k:ℝ))*B^((1:ℝ)/(k:ℝ)) := by
  have hkpos : 0<(k:ℝ) := by exact_mod_cast (by omega : 0<k)
  have hk1 : (1:ℝ)≤(k:ℝ) := by exact_mod_cast hk
  have hθ : 0≤((k:ℝ)-1)/(k:ℝ) := div_nonneg (sub_nonneg.mpr hk1) hkpos.le
  have hθ1 : ((k:ℝ)-1)/(k:ℝ)≤1 := by
    apply (div_le_iff₀ hkpos).mpr
    linarith
  have hη : 1-((k:ℝ)-1)/(k:ℝ)=(1:ℝ)/(k:ℝ) := by field_simp ; ring
  simpa only [hη] using min_le_rpow_product A B
    (((k:ℝ)-1)/(k:ℝ)) hA hB hθ hθ1

private theorem nat_le_two_pow (n : ℕ) : n ≤ 2^n := by
  induction n with
  | zero => norm_num
  | succ n ih =>
    have hp : 0<(2:ℕ)^n := pow_pos (by norm_num) n
    rw [pow_succ]
    omega
private theorem uniform_divisor_fee (p : ℕ) (D H a : ℝ)
    (hD : 0 ≤ D) (hH : 0<H) (ha : 0 ≤ a) (ε : ℝ) (hε : 0<ε) :
    ∃ C : ℝ, 0<C ∧ ∀ x : ℝ, 2 ≤ x → ∀ M : ℤ, M ≠ 0 →
      |(M:ℝ)| ≤ H*x^a →
      D*(M.natAbs.divisors.card:ℝ)^p ≤ C*x^ε := by
  let δ : ℝ := ε/(a*(p:ℝ)+1)
  have hp0 : 0 ≤ (p:ℝ) := Nat.cast_nonneg _
  have hden : 0<a*(p:ℝ)+1 := by positivity
  have hδ : 0<δ := div_pos hε hden
  have hδeq : δ*(a*(p:ℝ)+1)=ε := div_mul_cancel₀ ε (ne_of_gt hden)
  have hexp : a*((p:ℝ)*δ) ≤ ε := by nlinarith
  obtain ⟨Cd,hCd,hdb⟩ := C01.PcLowdegRed.divisor_bound δ hδ
  have hCd0 : 0 ≤ Cd := by linarith
  let C : ℝ := D*Cd^p*H^((p:ℝ)*δ)+1
  refine ⟨C,by dsimp [C]; positivity,?_⟩
  intro x hx M hM hMb
  have hx0 : 0<x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hcast : (M.natAbs:ℝ)=|(M:ℝ)| := by
    rw [←Int.cast_natCast,Int.natCast_natAbs,Int.cast_abs]
  have hdiv : (M.natAbs.divisors.card:ℝ) ≤ Cd*|(M:ℝ)|^δ := by
    have ht := hdb M.natAbs (Int.natAbs_ne_zero.mpr hM)
    rwa [hcast] at ht
  have hDp : (M.natAbs.divisors.card:ℝ)^p ≤ Cd^p*|(M:ℝ)|^((p:ℝ)*δ) := by
    calc
      (M.natAbs.divisors.card:ℝ)^p ≤ (Cd*|(M:ℝ)|^δ)^p :=
        pow_le_pow_left₀ (Nat.cast_nonneg _) hdiv _
      _ = Cd^p*|(M:ℝ)|^((p:ℝ)*δ) := by
        rw [mul_pow]
        congr 1
        rw [←Real.rpow_natCast,←Real.rpow_mul (abs_nonneg _)]
        congr 1
        ring
  have hMeta : |(M:ℝ)|^((p:ℝ)*δ) ≤ H^((p:ℝ)*δ)*x^ε := by
    calc
      |(M:ℝ)|^((p:ℝ)*δ) ≤ (H*x^a)^((p:ℝ)*δ) :=
        Real.rpow_le_rpow (abs_nonneg _) hMb (by positivity)
      _ = H^((p:ℝ)*δ)*(x^a)^((p:ℝ)*δ) :=
        Real.mul_rpow hH.le (Real.rpow_nonneg hx0.le _)
      _ = H^((p:ℝ)*δ)*x^(a*((p:ℝ)*δ)) := by rw [←Real.rpow_mul hx0.le]
      _ ≤ H^((p:ℝ)*δ)*x^ε :=
        mul_le_mul_of_nonneg_left
          (Real.rpow_le_rpow_of_exponent_le hx1 hexp) (Real.rpow_nonneg hH.le _)
  calc
    D*(M.natAbs.divisors.card:ℝ)^p ≤ D*(Cd^p*|(M:ℝ)|^((p:ℝ)*δ)) :=
      mul_le_mul_of_nonneg_left hDp hD
    _ ≤ D*(Cd^p*(H^((p:ℝ)*δ)*x^ε)) :=
      mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left hMeta (pow_nonneg hCd0 _)) hD
    _ =(D*Cd^p*H^((p:ℝ)*δ))*x^ε := by ring
    _ ≤ C*x^ε := by
      apply mul_le_mul_of_nonneg_right _ (Real.rpow_nonneg hx0.le _)
      dsimp [C]
      linarith

private theorem weighted_divisor_sum_bound
    (k n : ℕ) (hk : 1≤k) (hn : n≠0) :
    (∑ μ∈n.divisors,k^μ.primeFactors.card) ≤ n.divisors.card^(k+1) := by
  have hweight : ∀ μ∈n.divisors,k^μ.primeFactors.card≤n.divisors.card^k := by
    intro μ hμ
    have hdiv : μ∣n := (Nat.mem_divisors.mp hμ).1
    have hsubset : μ.primeFactors⊆n.primeFactors := by
      intro p hp
      obtain ⟨hprime,hpd,hμ0⟩ := Nat.mem_primeFactors.mp hp
      exact Nat.mem_primeFactors.mpr ⟨hprime,hpd.trans hdiv,hn⟩
    have hcard := Finset.card_le_card hsubset
    have hω : 2^n.primeFactors.card≤n.divisors.card :=
      C01.PcLowdegRed.two_pow_card_primeFactors_le n hn
    calc
      k^μ.primeFactors.card ≤ k^n.primeFactors.card :=
        Nat.pow_le_pow_right hk hcard
      _ ≤ (2^k)^n.primeFactors.card :=
        Nat.pow_le_pow_left (nat_le_two_pow k) _
      _ = (2^n.primeFactors.card)^k := by
        rw [←pow_mul,←pow_mul,Nat.mul_comm k n.primeFactors.card]
      _ ≤ n.divisors.card^k := Nat.pow_le_pow_left hω k
  have hs := Finset.sum_le_sum hweight
  simpa [pow_succ,mul_comm] using hs

private theorem uniform_signed_level_fee
    (k : ℕ) (hk : 1≤k) (H K ε : ℝ)
    (hH : 0<H) (hK : 0≤K) (hε : 0<ε) :
    ∃ C : ℝ,0<C ∧ ∀ x : ℝ,2≤x → ∀ K₀ : ℤ,K₀≠0 →
      |(K₀:ℝ)|≤H*x^K →
      2*(∑ μ∈K₀.natAbs.divisors,(k:ℝ)^μ.primeFactors.card) ≤ C*x^ε := by
  obtain ⟨C,hC,hfee⟩ := uniform_divisor_fee (k+1) 2 H K
    (by norm_num) hH hK ε hε
  refine ⟨C,hC,?_⟩
  intro x hx K₀ hK₀ hheight
  have hn : K₀.natAbs≠0 := Nat.ne_of_gt (Int.natAbs_pos.mpr hK₀)
  have hsum : (∑ μ∈K₀.natAbs.divisors,(k:ℝ)^μ.primeFactors.card) ≤
      (K₀.natAbs.divisors.card:ℝ)^(k+1) := by
    exact_mod_cast weighted_divisor_sum_bound k K₀.natAbs hk hn
  exact (mul_le_mul_of_nonneg_left hsum (by norm_num : (0:ℝ)≤2)).trans
    (hfee x hx K₀ hK₀ hheight)

private theorem cancellation_ratio_near
    (η δ W T p A B m : ℝ) (hη : 0<η) (hδ : 0<δ)
    (hδb : δ≤1/16) (hδc : δ≤η^2/16)
    (hW : 0<W) (hT : 0<T) (hpW : W/4≤p)
    (hlev : A+B=m) (hAB : A*B= -T*p) (hsmall : m^2≤δ*T*W) :
    |B/A+1|<η := by
  have hp : 0<p := by linarith
  have hA : A≠0 := by intro hz; rw [hz,zero_mul] at hAB; nlinarith
  have hB : B≠0 := by intro hz; rw [hz,mul_zero] at hAB; nlinarith
  have hA2 : 0<A^2 := sq_pos_of_ne_zero hA
  let t : ℝ := B/A
  let r : ℝ := -t
  have hrA : r*A^2=T*p := by
    dsimp [r,t]
    field_simp [hA]
    nlinarith only [hAB]
  have hr : 0<r := by
    have hprod : 0<r*A^2 := by rw [hrA]; positivity
    by_contra hh
    have hnon := mul_nonpos_of_nonpos_of_nonneg (le_of_not_gt hh) hA2.le
    linarith
  have hm2 : m^2=A^2*(1-r)^2 := by
    rw [←hlev]
    dsimp [r,t]
    field_simp [hA]
    ring
  have hquad : (1-r)^2≤4*δ*r := by
    apply (mul_le_mul_iff_left₀ hA2).mp
    have hWp : W≤4*p := by linarith
    have hh := mul_le_mul_of_nonneg_left hWp (by positivity : 0≤δ*T)
    rw [hm2] at hsmall
    calc
      (1-r)^2*A^2 = A^2*(1-r)^2 := by ring
      _ ≤ δ*T*W := hsmall
      _ ≤ δ*T*(4*p) := hh
      _ = 4*δ*r*A^2 := by
        calc
          _ = 4*δ*(T*p) := by ring
          _ = _ := by rw [←hrA]; ring
  have hquad' : (1-r)^2≤r/4 := by
    have hh := mul_le_mul_of_nonneg_right hδb (by positivity : 0≤4*r)
    nlinarith only [hquad,hh]
  have hrlo : (1/2:ℝ)≤r := by
    by_contra hh
    have hh' : r<1/2 := lt_of_not_ge hh
    nlinarith [sq_nonneg (r-1/2)]
  have hrhi : r≤2 := by
    by_contra hh
    have hh' : 2<r := lt_of_not_ge hh
    nlinarith [sq_nonneg (r-2)]
  have hnear : |t+1|<η := by
    have hh := mul_le_mul_of_nonneg_left hrhi (by positivity : 0≤4*δ)
    have hh' : (1-r)^2≤η^2/2 := by nlinarith only [hquad,hh,hδc]
    have hab : |t+1|^2=(1-r)^2 := by rw [sq_abs]; dsimp [r]; ring
    nlinarith [abs_nonneg (t+1)]

  exact hnear

private def pureSlopeRatio (k : ℕ) (t : ℝ) : ℝ :=
  (k:ℝ)*(t-1)*tailR k 1 t/t^k

private theorem pureSlopeRatio_neg_one
    (k : ℕ) (hk : 1≤k) :
    pureSlopeRatio k (-1) =
      2*(k:ℝ)*((2*k-2).choose (k-1):ℝ) := by
  have ht : tailR k (1:ℝ) (-1) =
      ((2*k-2).choose (k-1):ℝ)*(-1:ℝ)^(k-1) := by
    simpa only [neg_neg] using tailR_opposite k hk (-1:ℝ)
  have hp : (-1:ℝ)^k=(-1:ℝ)^(k-1)*(-1) := by
    rw [←pow_succ,show k-1+1=k by omega]
  unfold pureSlopeRatio
  rw [ht,hp]
  field_simp [pow_ne_zero (k-1) (by norm_num : (-1:ℝ)≠0)] ; ring

private theorem pureSlopeRatio_continuous_neg_one (k : ℕ) :
    ContinuousAt (pureSlopeRatio k) (-1) := by
  unfold pureSlopeRatio tailR
  fun_prop (disch := norm_num)

private theorem choose_ratio_delta
    (k : ℕ) (hk : 1≤k) :
    ∃ δ : ℝ,0<δ ∧ δ≤1/16 ∧
      ∀ W T p A B m : ℝ,0<W → 0<T → W/4≤p →
        A+B=m → A*B= -T*p → m^2≤δ*T*W →
        |pureSlopeRatio k (B/A) -
          2*(k:ℝ)*((2*k-2).choose (k-1):ℝ)| <
          ((2*k-2).choose (k-1):ℝ)/4 := by
  let N : ℝ := ((2*k-2).choose (k-1):ℝ)
  have hN : 0<N := by
    dsimp [N]
    exact_mod_cast Nat.choose_pos (show k-1≤2*k-2 by omega)
  obtain ⟨η,hη,hcont⟩ := Metric.continuousAt_iff.mp
    (pureSlopeRatio_continuous_neg_one k) (N/4) (by positivity)
  let δ : ℝ := min (1/16) (η^2/16)
  have hδ : 0<δ := by dsimp [δ]; positivity
  have hδb : δ≤1/16 := min_le_left _ _
  have hδc : δ≤η^2/16 := min_le_right _ _
  refine ⟨δ,hδ,hδb,?_⟩
  intro W T p A B m hW hT hp hlev hAB hsmall
  have hnear := cancellation_ratio_near η δ W T p A B m hη hδ hδb hδc
    hW hT hp hlev hAB hsmall
  have hc := hcont (by simpa only [Real.dist_eq,sub_neg_eq_add] using hnear)
  rw [pureSlopeRatio_neg_one k hk] at hc
  simpa only [Real.dist_eq,N] using hc

private theorem tailR_scale {R : Type*} [CommRing R]
    (k : ℕ) (hk : 1≤k) (c A B : R) :
    tailR k (c*A) (c*B)=c^(k-1)*tailR k A B := by
  unfold tailR
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  have hik : i≤k-1 := by have := Finset.mem_range.mp hi; omega
  have hp : c^i*c^(k-1-i)=c^(k-1) := by
    rw [←pow_add, Nat.add_sub_of_le hik]
  rw [mul_pow,mul_pow]
  calc
    ((2*k-1).choose (k+i):R)*(c^i*A^i)*(c^(k-1-i)*B^(k-1-i)) =
        ((2*k-1).choose (k+i):R)*(c^i*c^(k-1-i))*A^i*B^(k-1-i) := by ring
    _ = _ := by rw [hp]; ring

private def pureHeight (k : ℕ) (A B : ℝ) : ℝ :=
  A^k*tailR k A B

private theorem pureHeight_normalized
    (k : ℕ) (hk : 1≤k) (A B : ℝ) (hA : A≠0) :
    pureHeight k A B=A^(2*k-1)*tailR k 1 (B/A) := by
  have hb : A*(B/A)=B := by field_simp [hA]
  have ht := tailR_scale k hk A 1 (B/A)
  rw [mul_one,hb] at ht
  unfold pureHeight
  rw [ht,←mul_assoc,←pow_add,show k+(k-1)=2*k-1 by omega]

private theorem pureSlopeRatio_scale
    (k : ℕ) (hk : 1≤k) (A B : ℝ) (hA : A≠0) (hB : B≠0) :
    pureSlopeRatio k (B/A)*(A*B)^k =
      (k:ℝ)*(B-A)*pureHeight k A B := by
  let t : ℝ := B/A
  have ht : t≠0 := div_ne_zero hB hA
  have hBA : B-A=A*(t-1) := by dsimp [t]; field_simp [hA]
  have hAB : A*B=A^2*t := by dsimp [t]; field_simp [hA]
  have hp : (A*B)^k=A^(2*k)*t^k := by rw [hAB,mul_pow,←pow_mul]
  have hH := pureHeight_normalized k hk A B hA
  have hApow : A^(2*k)=A^(2*k-1)*A := by
    rw [←pow_succ,show 2*k-1+1=2*k by omega]
  change pureSlopeRatio k t*(A*B)^k=_
  unfold pureSlopeRatio
  rw [hp]
  calc
    (k:ℝ)*(t-1)*tailR k 1 t/t^k*(A^(2*k)*t^k) =
        (k:ℝ)*(t-1)*tailR k 1 t*A^(2*k) := by
      field_simp [pow_ne_zero k ht]
    _ = _ := by
      rw [hBA,hH,hApow]
      change (k:ℝ)*(t-1)*tailR k 1 t*(A^(2*k-1)*A) =
        (k:ℝ)*(A*(t-1))*(A^(2*k-1)*tailR k 1 t)
      ring

private theorem derivative_bracket_normalization
    (k : ℕ) (hk : 1≤k) (A B ab Pi q m n : ℝ)
    (hA : A≠0) (hB : B≠0) (hPi : Pi≠0)
    (hAB : A*B=ab*Pi) (hH : pureHeight k A B≠0)
    (hnum : q*Pi^k=pureHeight k A B+m^(2*k-1)*n) :
    ab^k*(pureSlopeRatio k (B/A)*(1+m^(2*k-1)*n/pureHeight k A B) -
      ((2*k-1:ℕ):ℝ)*((2*k-2).choose (k-1):ℝ)) =
      (k:ℝ)*q*(B-A) -
        ((2*k-1:ℕ):ℝ)*((2*k-2).choose (k-1):ℝ)*ab^k := by
  let c : ℝ := ((2*k-1:ℕ):ℝ)*((2*k-2).choose (k-1):ℝ)
  change ab^k*(pureSlopeRatio k (B/A)*
      (1+m^(2*k-1)*n/pureHeight k A B)-c) =
    (k:ℝ)*q*(B-A)-c*ab^k
  apply mul_right_cancel₀ (pow_ne_zero k hPi)
  calc
    (ab^k*(pureSlopeRatio k (B/A)*
      (1+m^(2*k-1)*n/pureHeight k A B)-c))*Pi^k =
        (pureSlopeRatio k (B/A)*(A*B)^k)*
          (1+m^(2*k-1)*n/pureHeight k A B)-c*(ab*Pi)^k := by
      rw [hAB,mul_pow]
      ring
    _ = (k:ℝ)*(B-A)*pureHeight k A B*
        (1+m^(2*k-1)*n/pureHeight k A B)-c*(ab*Pi)^k := by
      rw [pureSlopeRatio_scale k hk A B hA hB]
    _ = (k:ℝ)*(B-A)*(pureHeight k A B+m^(2*k-1)*n)-c*(ab*Pi)^k := by
      field_simp [hH]
    _ = ((k:ℝ)*q*(B-A)-c*ab^k)*Pi^k := by rw [←hnum,mul_pow]; ring

private theorem derivative_margin_from_ratio
    (k N R θ : ℝ) (hk : 1≤k) (hN : 0<N)
    (hR : |R-2*k*N|≤N/4)
    (hθ : |θ|≤1/(4*(2*k+1))) :
    N/2≤R*(1+θ)-(2*k-1)*N := by
  have hden : 0<4*(2*k+1) := by linarith
  have hkN : N≤k*N := by nlinarith [mul_nonneg (sub_nonneg.mpr hk) hN.le]
  have hRlo : 0≤R := by
    have hh := (abs_le.mp hR).1
    nlinarith
  have hRhi : R≤(2*k+1)*N := by
    have hh := (abs_le.mp hR).2
    nlinarith
  have hprod : |R*θ|≤N/4 := by
    rw [abs_mul,abs_of_nonneg hRlo]
    calc
      R*|θ|≤((2*k+1)*N)*(1/(4*(2*k+1))) :=
        mul_le_mul hRhi hθ (abs_nonneg _) (by positivity)
      _ = N/4 := by field_simp [show 2*k+1≠0 by linarith]
  have hθlo := (abs_le.mp hprod).1
  have hlo := (abs_le.mp hR).1
  nlinarith

private theorem relative_height_error
    (k : ℕ) (x W Pi m n q H δ η : ℝ)
    (_hx : 0<x) (hW : 0<W) (hPiW : W/4≤Pi)
    (hδ : 0≤δ) (hη : 0≤η) (hηhalf : η≤1/2)
    (hδscale : δ≤η/(4:ℝ)^k)
    (hq : 1≤|q|) (hn : |n|≤x)
    (hnum : q*Pi^k=H+m^(2*k-1)*n)
    (hdeep : |m|^(2*k-1)*x≤δ*W^k) :
    Pi^k/2≤|H| ∧ H≠0 ∧ |m^(2*k-1)*n/H|≤2*η := by
  have hPi : 0<Pi := by linarith
  have hPik : 0<Pi^k := pow_pos hPi k
  have h4 : 0<(4:ℝ)^k := pow_pos (by norm_num) k
  have hWpow : W^k≤(4:ℝ)^k*Pi^k := by
    simpa only [mul_pow] using
      pow_le_pow_left₀ hW.le (show W≤4*Pi by linarith) k
  have hδ4 : δ*(4:ℝ)^k≤η := (le_div_iff₀ h4).mp hδscale
  have herr : |m^(2*k-1)*n|≤η*Pi^k := by
    calc
      |m^(2*k-1)*n| = |m|^(2*k-1)*|n| := by rw [abs_mul,abs_pow]
      _≤|m|^(2*k-1)*x := mul_le_mul_of_nonneg_left hn (by positivity)
      _≤δ*W^k := hdeep
      _≤δ*((4:ℝ)^k*Pi^k) := mul_le_mul_of_nonneg_left hWpow hδ
      _≤η*Pi^k := by
        simpa only [mul_assoc] using mul_le_mul_of_nonneg_right hδ4 hPik.le
  have hqprod : Pi^k≤|q*Pi^k| := by
    rw [abs_mul,abs_of_pos hPik]
    simpa only [one_mul] using mul_le_mul_of_nonneg_right hq hPik.le
  have htri : |q*Pi^k|≤|H|+|m^(2*k-1)*n| := by
    rw [hnum]
    exact abs_add_le _ _
  have hηPi : η*Pi^k≤Pi^k/2 := by
    have hh := mul_le_mul_of_nonneg_right hηhalf hPik.le
    linarith
  have hHlo : Pi^k/2≤|H| := by linarith
  have hH : H≠0 := by
    intro hz
    rw [hz,abs_zero] at hHlo
    linarith
  refine ⟨hHlo,hH,?_⟩
  rw [abs_div]
  apply (div_le_iff₀ (abs_pos.mpr hH)).mpr
  have hh := mul_le_mul_of_nonneg_left hHlo hη
  nlinarith

private theorem choose_derivative_margin_delta
    (k : ℕ) (hk : 1≤k) :
    ∃ δ : ℝ,0<δ ∧ δ≤1/16 ∧
      ∀ x W m T Pi A B q n : ℝ,
        0<x → 0<W → 0<T → W/4≤Pi →
        A+B=m → A*B= -T*Pi → 1≤|q| → |n|≤x →
        q*Pi^k=pureHeight k A B+m^(2*k-1)*n →
        |m|^(2*k-1)*x≤δ*W^k → m^2≤δ*T*W →
        Pi^k/2≤|pureHeight k A B| ∧
        (((2*k-2).choose (k-1):ℝ)/2)*T^k ≤
          |(k:ℝ)*q*(B-A) -
            ((2*k-1:ℕ):ℝ)*((2*k-2).choose (k-1):ℝ)*(-T)^k| := by
  obtain ⟨δ₀,hδ₀,hδ₀small,hclose⟩ := choose_ratio_delta k hk
  let η : ℝ := 1/(8*(2*(k:ℝ)+1))
  have hkr : (1:ℝ)≤(k:ℝ) := by exact_mod_cast hk
  have hden : 0<8*(2*(k:ℝ)+1) := by linarith
  have hη : 0<η := by dsimp [η]; exact div_pos (by norm_num) hden
  have hηhalf : η≤1/2 := by
    dsimp [η]
    apply (div_le_iff₀ hden).mpr
    linarith
  let δ : ℝ := min δ₀ (η/(4:ℝ)^k)
  have hδ : 0<δ := by dsimp [δ]; positivity
  have hδ₀le : δ≤δ₀ := min_le_left _ _
  have hδscale : δ≤η/(4:ℝ)^k := min_le_right _ _
  refine ⟨δ,hδ,hδ₀le.trans hδ₀small,?_⟩
  intro x W m T Pi A B q n hx hW hT hPiW hlev hAB hq hn hnum hdeep hsmall
  have hPi : 0<Pi := by linarith
  have hA : A≠0 := by intro hz; rw [hz,zero_mul] at hAB; nlinarith
  have hB : B≠0 := by intro hz; rw [hz,mul_zero] at hAB; nlinarith
  have hsmall₀ : m^2≤δ₀*T*W := by
    have hh := mul_le_mul_of_nonneg_right hδ₀le (mul_nonneg hT.le hW.le)
    exact hsmall.trans (by nlinarith only [hh])
  have hclose' := hclose W T Pi A B m hW hT hPiW hlev hAB hsmall₀
  obtain ⟨hHlo,hH,hθ⟩ := relative_height_error k x W Pi m n q
    (pureHeight k A B) δ η hx hW hPiW hδ.le hη.le hηhalf hδscale hq hn hnum hdeep
  refine ⟨hHlo,?_⟩
  let N : ℝ := ((2*k-2).choose (k-1):ℝ)
  let R : ℝ := pureSlopeRatio k (B/A)
  let θ : ℝ := m^(2*k-1)*n/pureHeight k A B
  have hN : 0<N := by
    dsimp [N]
    exact_mod_cast Nat.choose_pos (show k-1≤2*k-2 by omega)
  have hηtwice : 2*η=1/(4*(2*(k:ℝ)+1)) := by
    dsimp [η]
    field_simp [show 2*(k:ℝ)+1≠0 by linarith] ; ring
  have hθ' : |θ|≤1/(4*(2*(k:ℝ)+1)) := by
    rw [←hηtwice]
    exact hθ
  have hmargin := derivative_margin_from_ratio (k:ℝ) N R θ hkr hN
    hclose'.le hθ'
  have hpcast : ((2*k-1:ℕ):ℝ)=2*(k:ℝ)-1 := by
    rw [Nat.cast_sub (by omega : 1≤2*k)]
    push_cast
    ring
  have hmargin' : N/2≤R*(1+θ)-((2*k-1:ℕ):ℝ)*N := by
    rw [hpcast]
    exact hmargin
  have hnormnonneg : 0≤R*(1+θ)-((2*k-1:ℕ):ℝ)*N := by linarith
  have hid := derivative_bracket_normalization k hk A B (-T) Pi q m n
    hA hB hPi.ne' hAB hH hnum
  change (-T)^k*(R*(1+θ)-((2*k-1:ℕ):ℝ)*N) =
    (k:ℝ)*q*(B-A)-((2*k-1:ℕ):ℝ)*N*(-T)^k at hid
  change (N/2)*T^k≤|(k:ℝ)*q*(B-A)-((2*k-1:ℕ):ℝ)*N*(-T)^k|
  rw [←hid,abs_mul,abs_pow,abs_neg,abs_of_pos hT,abs_of_nonneg hnormnonneg]
  calc
    (N/2)*T^k≤(R*(1+θ)-((2*k-1:ℕ):ℝ)*N)*T^k :=
      mul_le_mul_of_nonneg_right hmargin' (pow_nonneg hT.le k)
    _ = T^k*(R*(1+θ)-((2*k-1:ℕ):ℝ)*N) := mul_comm _ _

private def tailBudget (k : ℕ) : ℝ :=
  ∑ i∈Finset.range k,((2*k-1).choose (k+i):ℝ)*2^(k-1-i)

private theorem tailBudget_ge_one (k : ℕ) (hk : 1≤k) :
    1≤tailBudget k := by
  have hi : k-1∈Finset.range k := Finset.mem_range.mpr (by omega)
  have hs := Finset.single_le_sum
    (fun i (_ : i∈Finset.range k) =>
      show (0:ℝ)≤((2*k-1).choose (k+i):ℝ)*2^(k-1-i) by positivity) hi
  have he : k+(k-1)=2*k-1 := by omega
  simpa only [he,Nat.choose_self,Nat.cast_one,Nat.sub_self,pow_zero,mul_one,tailBudget] using hs

private theorem tailR_unit_bound (k : ℕ) (t : ℝ) (ht : |t|≤2) :
    |tailR k 1 t|≤tailBudget k := by
  unfold tailR tailBudget
  calc
    |∑ i∈Finset.range k,((2*k-1).choose (k+i):ℝ)*1^i*t^(k-1-i)| ≤
        ∑ i∈Finset.range k,|((2*k-1).choose (k+i):ℝ)*1^i*t^(k-1-i)| :=
      Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ i∈Finset.range k,((2*k-1).choose (k+i):ℝ)*2^(k-1-i) := by
      apply Finset.sum_le_sum
      intro i hi
      have hc : (0:ℝ)≤((2*k-1).choose (k+i):ℝ) := Nat.cast_nonneg _
      simp only [one_pow,mul_one,abs_mul,abs_pow,abs_of_nonneg hc]
      exact mul_le_mul_of_nonneg_left
        (pow_le_pow_left₀ (abs_nonneg t) ht _) hc

private theorem cancellation_ratio_bounds
    (δ W T p A B m : ℝ) (hδ : 0<δ) (hδb : δ≤1/16)
    (hW : 0<W) (hT : 0<T) (hpW : W/4≤p)
    (hlev : A+B=m) (hAB : A*B= -T*p) (hsmall : m^2≤δ*T*W) :
    A^2≤2*T*p ∧ |B/A|≤2 := by
  have hp : 0<p := by linarith
  have hA : A≠0 := by intro hz; rw [hz,zero_mul] at hAB; nlinarith
  have hB : B≠0 := by intro hz; rw [hz,mul_zero] at hAB; nlinarith
  have hA2 : 0<A^2 := sq_pos_of_ne_zero hA
  let t : ℝ := B/A
  let r : ℝ := -t
  have hrA : r*A^2=T*p := by
    dsimp [r,t]
    field_simp [hA]
    nlinarith only [hAB]
  have hr : 0<r := by
    have hprod : 0<r*A^2 := by rw [hrA]; positivity
    by_contra hh
    have hnon := mul_nonpos_of_nonpos_of_nonneg (le_of_not_gt hh) hA2.le
    linarith
  have hm2 : m^2=A^2*(1-r)^2 := by
    rw [←hlev]
    dsimp [r,t]
    field_simp [hA]
    ring
  have hquad : (1-r)^2≤4*δ*r := by
    apply (mul_le_mul_iff_left₀ hA2).mp
    have hWp : W≤4*p := by linarith
    have hh := mul_le_mul_of_nonneg_left hWp (by positivity : 0≤δ*T)
    rw [hm2] at hsmall
    calc
      (1-r)^2*A^2 = A^2*(1-r)^2 := by ring
      _ ≤ δ*T*W := hsmall
      _ ≤ δ*T*(4*p) := hh
      _ = 4*δ*r*A^2 := by
        calc
          _ = 4*δ*(T*p) := by ring
          _ = _ := by rw [←hrA]; ring
  have hquad' : (1-r)^2≤r/4 := by
    have hh := mul_le_mul_of_nonneg_right hδb (by positivity : 0≤4*r)
    nlinarith only [hquad,hh]
  have hrlo : (1/2:ℝ)≤r := by
    by_contra hh
    have hh' : r<1/2 := lt_of_not_ge hh
    nlinarith [sq_nonneg (r-1/2)]
  have hrhi : r≤2 := by
    by_contra hh
    have hh' : 2<r := lt_of_not_ge hh
    nlinarith [sq_nonneg (r-2)]

  constructor
  · nlinarith [mul_le_mul_of_nonneg_right hrlo hA2.le]
  · have htneg : t<0 := by dsimp [r] at hr; linarith
    change |t|≤2
    rw [abs_of_neg htneg]
    exact hrhi

private theorem cancellation_height_scale
    (k : ℕ) (hk : 1≤k) (δ W T Pi A B m : ℝ)
    (hδ : 0<δ) (hδsmall : δ≤1/16) (hW : 0<W) (hT : 0<T)
    (hPiW : W/4≤Pi) (hlev : A+B=m) (hAB : A*B= -T*Pi)
    (hsmall : m^2≤δ*T*W)
    (hHlo : Pi^k/2≤|pureHeight k A B|) :
    W≤(16*(2:ℝ)^(2*k-1)*(tailBudget k)^2)*T^(2*k-1) := by
  have hPi : 0<Pi := by linarith
  have hA : A≠0 := by intro hz; rw [hz,zero_mul] at hAB; nlinarith
  obtain ⟨hAupper,ht⟩ := cancellation_ratio_bounds δ W T Pi A B m
    hδ hδsmall hW hT hPiW hlev hAB hsmall
  have hF := tailR_unit_bound k (B/A) ht
  have hBudget : 0≤tailBudget k := by have hh := tailBudget_ge_one k hk; linarith
  have hFsq : (tailR k 1 (B/A))^2≤(tailBudget k)^2 := by
    have hh := pow_le_pow_left₀ (abs_nonneg _) hF 2
    simpa only [sq_abs] using hh
  have hAp : A^(2*(2*k-1))≤(2*T*Pi)^(2*k-1) := by
    have hh := pow_le_pow_left₀ (sq_nonneg A) hAupper (2*k-1)
    simpa only [←pow_mul] using hh
  have hHsq : (pureHeight k A B)^2≤
      (2:ℝ)^(2*k-1)*T^(2*k-1)*Pi^(2*k-1)*(tailBudget k)^2 := by
    rw [pureHeight_normalized k hk A B hA,mul_pow,←pow_mul]
    have hAp' : A^((2*k-1)*2)≤(2*T*Pi)^(2*k-1) := by
      simpa only [Nat.mul_comm (2*k-1) 2] using hAp
    have hh := mul_le_mul hAp' hFsq (sq_nonneg _)
      (pow_nonneg (by positivity : 0≤2*T*Pi) _)
    simpa only [mul_pow,mul_assoc] using hh
  have hHsqlo : Pi^(2*k)≤4*(pureHeight k A B)^2 := by
    have hh := pow_le_pow_left₀ (by positivity : 0≤Pi^k/2) hHlo 2
    rw [sq_abs,div_pow,←pow_mul] at hh
    rw [Nat.mul_comm k 2] at hh
    norm_num at hh
    linarith
  have hbound : Pi*Pi^(2*k-1) ≤
      (4*(2:ℝ)^(2*k-1)*(tailBudget k)^2*T^(2*k-1))*Pi^(2*k-1) := by
    have hp : Pi^(2*k)=Pi*Pi^(2*k-1) := by
      rw [←pow_succ',show 2*k-1+1=2*k by omega]
    have hh := hHsqlo.trans (mul_le_mul_of_nonneg_left hHsq (by norm_num : (0:ℝ)≤4))
    rw [hp] at hh
    calc
      Pi*Pi^(2*k-1) ≤
          4*((2:ℝ)^(2*k-1)*T^(2*k-1)*Pi^(2*k-1)*(tailBudget k)^2) := hh
      _ = (4*(2:ℝ)^(2*k-1)*(tailBudget k)^2*T^(2*k-1))*Pi^(2*k-1) := by ring
  have hPibound : Pi≤4*(2:ℝ)^(2*k-1)*(tailBudget k)^2*T^(2*k-1) := by
    by_contra hn
    have hh := mul_lt_mul_of_pos_right (lt_of_not_ge hn) (pow_pos hPi (2*k-1))
    exact (not_lt_of_ge hbound) hh
  have hWPi : W≤4*Pi := by linarith
  calc
    W≤4*Pi := hWPi
    _≤4*(4*(2:ℝ)^(2*k-1)*(tailBudget k)^2*T^(2*k-1)) :=
      mul_le_mul_of_nonneg_left hPibound (by norm_num)
    _ = _ := by ring

private theorem positive_mul_cancel (a b c : ℝ) (hc : 0<c) (h : a*c≤b*c) :
    a≤b := (mul_le_mul_iff_left₀ hc).mp h

private theorem large_powered_length
    (k : ℕ) (hk : 1≤k) (C c δ x M W μ l : ℝ)
    (_hC : 0<C) (hc : 0<c) (hδ : 0<δ) (hx : 0<x)
    (hM : 0<M) (hW : 0<W) (hμ : 0<μ) (hl : 0≤l)
    (hfloor : c^(2*k-1)*x≤M^(2*k-1))
    (hcell : l*μ^2*M≤C*W)
    (hlarge : δ*W^k≤μ^(2*k-1)*x) :
    l^(k*(2*k-1))*M^((k-1)*(2*k-1))*W^k ≤
      (C^(k*(2*k-1))/(δ^(2*k)*c^(2*k-1)))*x^(2*k-1) := by
  let p := 2*k-1
  have hp : p+1=2*k := by dsimp [p]; omega
  have hcellP := pow_le_pow_left₀ (by positivity : 0≤l*μ^2*M) hcell p
  have hlarge2 := pow_le_pow_left₀ (by positivity : 0≤δ*W^k) hlarge 2
  have haux : δ^2*l^p*M^p*W≤C^p*x^2 := by
    apply positive_mul_cancel _ _ (W^p) (pow_pos hW p)
    calc
      (δ^2*l^p*M^p*W)*W^p = (l^p*M^p)*(δ^2*W^(2*k)) := by
        rw [show 2*k=p+1 by omega,pow_succ]
        ring
      _ ≤ (l^p*M^p)*(μ^(p*2)*x^2) := by
        have hh : δ^2*W^(2*k)≤μ^(p*2)*x^2 := by
          simpa only [mul_pow,←pow_mul,Nat.mul_comm k 2] using hlarge2
        exact mul_le_mul_of_nonneg_left hh (by positivity)
      _ = (l*μ^2*M)^p*x^2 := by
        simp only [mul_pow,←pow_mul]
        rw [Nat.mul_comm p 2]
        ring
      _ ≤ (C*W)^p*x^2 := mul_le_mul_of_nonneg_right hcellP (sq_nonneg x)
      _ = (C^p*x^2)*W^p := by rw [mul_pow]; ring
  have hauxK := pow_le_pow_left₀ (by positivity : 0≤δ^2*l^p*M^p*W) haux k
  have hkp : k*p=(k-1)*p+p := by
    calc
      k*p=((k-1)+1)*p := congrArg (fun j : ℕ => j*p) (by omega : k=(k-1)+1)
      _ = _ := by ring
  have hMp : M^(k*p)=M^((k-1)*p)*M^p := by rw [hkp,pow_add]
  have hR : 0≤δ^(2*k)*l^(k*p)*M^((k-1)*p)*W^k := by positivity
  have hlast :
      δ^(2*k)*c^p*(l^(k*p)*M^((k-1)*p)*W^k) ≤ C^(k*p)*x^p := by
    apply positive_mul_cancel _ _ x hx
    calc
      (δ^(2*k)*c^p*(l^(k*p)*M^((k-1)*p)*W^k))*x =
          (δ^(2*k)*l^(k*p)*M^((k-1)*p)*W^k)*(c^p*x) := by ring
      _ ≤ (δ^(2*k)*l^(k*p)*M^((k-1)*p)*W^k)*M^p :=
        mul_le_mul_of_nonneg_left hfloor hR
      _ = (δ^2*l^p*M^p*W)^k := by
        simp only [mul_pow,←pow_mul]
        rw [Nat.mul_comm p k,hMp]
        ring
      _ ≤ (C^p*x^2)^k := hauxK
      _ = (C^(k*p)*x^p)*x := by
        simp only [mul_pow,←pow_mul]
        rw [Nat.mul_comm p k,show 2*k=p+1 by omega,pow_succ]
        ring
  have hden : 0<δ^(2*k)*c^p := by positivity
  have hh := (le_div_iff₀ hden).mpr
    (show (l^(k*p)*M^((k-1)*p)*W^k)*(δ^(2*k)*c^p) ≤ C^(k*p)*x^p by
      nlinarith only [hlast])
  change l^(k*p)*M^((k-1)*p)*W^k ≤ (C^(k*p)/(δ^(2*k)*c^p))*x^p
  calc
    l^(k*p)*M^((k-1)*p)*W^k ≤ (C^(k*p)*x^p)/(δ^(2*k)*c^p) := hh
    _ = (C^(k*p)/(δ^(2*k)*c^p))*x^p := by ring

private theorem near_powered_length
    (k : ℕ) (hk : 1≤k) (C H S x M W μ J T l : ℝ)
    (hC : 0<C) (_hH : 0<H) (hS : 0<S) (_hx : 0<x)
    (hM : 0<M) (hW : 0<W) (hμ : 0<μ) (hJ : μ≤J)
    (hT : 0<T) (hl : 0≤l)
    (hcell : l*μ*J*M≤C*W)
    (hheight : l*J*W^(k-1)*T^k≤H*x*μ^(2*k-1))
    (hscale : W≤S*T^(2*k-1)) :
    l^(k*(2*k-1))*M^((k-1)*(2*k-1))*W^k ≤
      (S^k*(H*C^(k-1))^(2*k-1))*x^(2*k-1) := by
  let p := 2*k-1
  have hJpos : 0<J := hμ.trans_le hJ
  have hcellK := pow_le_pow_left₀ (by positivity : 0≤l*μ*J*M) hcell (k-1)
  have hmul := mul_le_mul hcellK hheight (by positivity) (by positivity)
  have hJk := pow_le_pow_left₀ hμ.le hJ k
  have hbase : l^k*M^(k-1)*T^k≤H*C^(k-1)*x := by
    apply positive_mul_cancel _ _ (μ^p*W^(k-1)) (by positivity)
    have hleft : (l^k*M^(k-1)*T^k)*(μ^p*W^(k-1)) ≤
        (l*μ*J*M)^(k-1)*(l*J*W^(k-1)*T^k) := by
      have hkadd : (k-1)+k=p := by dsimp [p]; omega
      have hlpow : l^k=l^(k-1)*l := by rw [←pow_succ,show k-1+1=k by omega]
      have hJpow : J^k=J^(k-1)*J := by rw [←pow_succ,show k-1+1=k by omega]
      have hμpow : μ^p=μ^(k-1)*μ^k := by rw [←pow_add,hkadd]
      calc
        (l^k*M^(k-1)*T^k)*(μ^p*W^(k-1)) =
            (l^k*M^(k-1)*T^k*μ^(k-1)*W^(k-1))*μ^k := by rw [hμpow]; ring
        _ ≤ (l^k*M^(k-1)*T^k*μ^(k-1)*W^(k-1))*J^k :=
          mul_le_mul_of_nonneg_left hJk (by positivity)
        _ = (l*μ*J*M)^(k-1)*(l*J*W^(k-1)*T^k) := by
          rw [hlpow,hJpow]
          simp only [mul_pow]
          ring
    calc
      (l^k*M^(k-1)*T^k)*(μ^p*W^(k-1)) ≤
          (l*μ*J*M)^(k-1)*(l*J*W^(k-1)*T^k) := hleft
      _ ≤ (C*W)^(k-1)*(H*x*μ^p) := hmul
      _ = (H*C^(k-1)*x)*(μ^p*W^(k-1)) := by rw [mul_pow]; ring
  have hbaseP := pow_le_pow_left₀ (by positivity : 0≤l^k*M^(k-1)*T^k) hbase p
  have hscaleK := pow_le_pow_left₀ hW.le hscale k
  have hh := mul_le_mul_of_nonneg_left hscaleK
    (by positivity : 0≤l^(k*p)*M^((k-1)*p))
  calc
    l^(k*p)*M^((k-1)*p)*W^k ≤
        l^(k*p)*M^((k-1)*p)*(S*T^p)^k := hh
    _ = S^k*(l^k*M^(k-1)*T^k)^p := by
      simp only [mul_pow,←pow_mul]
      rw [Nat.mul_comm p k]
      ring
    _ ≤ S^k*(H*C^(k-1)*x)^p :=
      mul_le_mul_of_nonneg_left hbaseP (pow_nonneg hS.le k)
    _ = _ := by simp only [mul_pow]; ring

private theorem moderate_length
    (C c δ W μ J T M l : ℝ)
    (_hC : 0<C) (hc : 0<c) (hδ : 0<δ) (hW : 0<W)
    (hμ : 0<μ) (hJ : μ≤J) (hT : 1≤T) (hM : c≤M) (hl : 0≤l)
    (hcell : l*μ*J*M≤C*W) (hmoderate : δ*T*W≤μ^2) :
    l≤C/(δ*c) := by
  have hMpos : 0<M := hc.trans_le hM
  have hcell' : l*μ^2*M≤C*W := by
    have hh := mul_le_mul_of_nonneg_left hJ (by positivity : 0≤l*μ*M)
    nlinarith only [hh,hcell]
  have hδcell : l*δ*T*M≤C := by
    apply positive_mul_cancel _ _ W hW
    have hh := mul_le_mul_of_nonneg_left hmoderate (by positivity : 0≤l*M)
    nlinarith only [hh,hcell']
  have hTc : c≤T*M := by
    have hh := mul_le_mul_of_nonneg_right hT hMpos.le
    nlinarith only [hh,hM]
  have hh := mul_le_mul_of_nonneg_left hTc (by positivity : 0≤l*δ)
  apply (le_div_iff₀ (mul_pos hδ hc)).mpr
  nlinarith only [hh,hδcell]

private theorem zero_axis_large_height
    (k : ℕ) (hk : 1≤k) (a b : ℤ) (d e m x W δ : ℝ)
    (hprim : Int.gcd a b=1) (hab : a*b=0)
    (hd : 0<d) (he : 0<e) (hx : 0<x) (hW : 0<W)
    (hlev : (a:ℝ)*d+(b:ℝ)*e=m)
    (hprod : W≤4*d*e) (hdx : d^k≤x) (hex : e^k≤2*x)
    (hm : 1≤|m|) (hδ : 0≤δ) (hδsmall : δ≤1/(2*(4:ℝ)^k)) :
    δ*W^k≤|m|^(2*k-1)*x := by
  have hWk : W^k≤(4:ℝ)^k*d^k*e^k := by
    have hh := pow_le_pow_left₀ hW.le hprod k
    simpa only [mul_pow] using hh
  have hμk : |m|^k≤|m|^(2*k-1) :=
    pow_le_pow_right₀ hm (by omega)
  have haxis := FormalAB.S5a5b0bd5.A5CoarseOriginalPointRoot.primitive_zero_square
    a b d e m hprim hlev.symm hab
  have hWμ : W^k≤2*(4:ℝ)^k*|m|^k*x := by
    rcases haxis with hdm | hem
    · have hmd : |m|=d := by nlinarith [sq_abs m,abs_nonneg m]
      rw [hmd]
      have hh := mul_le_mul_of_nonneg_left hex (by positivity : 0≤(4:ℝ)^k*d^k)
      exact hWk.trans (by nlinarith only [hh])
    · have hme : |m|=e := by nlinarith [sq_abs m,abs_nonneg m]
      rw [hme]
      have hh := mul_le_mul_of_nonneg_right
        (hdx.trans (by linarith : x≤2*x)) (by positivity : 0≤(4:ℝ)^k*e^k)
      exact hWk.trans (by nlinarith only [hh])
  have hcoef : δ*(2*(4:ℝ)^k)≤1 :=
    (le_div_iff₀ (by positivity : 0<2*(4:ℝ)^k)).mp hδsmall
  calc
    δ*W^k≤δ*(2*(4:ℝ)^k*|m|^k*x) := mul_le_mul_of_nonneg_left hWμ hδ
    _≤|m|^k*x := by
      have hh := mul_le_mul_of_nonneg_right hcoef (by positivity : 0≤|m|^k*x)
      nlinarith only [hh]
    _≤|m|^(2*k-1)*x := mul_le_mul_of_nonneg_right hμk hx.le

private def normalizedHeight (k : ℕ) (d e : Polynomial ℝ)
    (a b m q : ℝ) : Polynomial ℝ :=
  Polynomial.C ((m^(2*k-1))⁻¹) *
    (Polynomial.C q*(d*e)^k -
      (Polynomial.C a*d)^k*tailR k (Polynomial.C a*d) (Polynomial.C b*e))

private theorem normalizedHeight_eval
    (k : ℕ) (d e : Polynomial ℝ) (a b m q z : ℝ) :
    (normalizedHeight k d e a b m q).eval z =
      (q*(d.eval z*e.eval z)^k-pureHeight k (a*d.eval z) (b*e.eval z)) /
        m^(2*k-1) := by
  have ht := tailR_map (Polynomial.evalRingHom z) k
    (Polynomial.C a*d) (Polynomial.C b*e)
  change (tailR k (Polynomial.C a*d) (Polynomial.C b*e)).eval z =
    tailR k ((Polynomial.C a*d).eval z) ((Polynomial.C b*e).eval z) at ht
  simp only [Polynomial.eval_mul,Polynomial.eval_C] at ht
  unfold normalizedHeight pureHeight
  simp only [Polynomial.eval_mul,Polynomial.eval_C,Polynomial.eval_sub,Polynomial.eval_pow]
  rw [ht]
  ring

private theorem normalizedHeight_original_value
    (k : ℕ) (d e : Polynomial ℝ) (a b m q z n : ℝ)
    (hm : m≠0)
    (hnum : m^(2*k-1)*n =
      q*(d.eval z*e.eval z)^k-pureHeight k (a*d.eval z) (b*e.eval z)) :
    (normalizedHeight k d e a b m q).eval z=n := by
  rw [normalizedHeight_eval,←hnum]
  exact mul_div_cancel_left₀ n (pow_ne_zero _ hm)

private theorem normalizedHeight_derivative
    (k : ℕ) (hk : 1≤k) (d e : Polynomial ℝ) (a b m q : ℝ)
    (hd : Polynomial.derivative d=Polynomial.C b)
    (he : Polynomial.derivative e= -Polynomial.C a) :
    Polynomial.derivative (normalizedHeight k d e a b m q) =
      Polynomial.C ((m^(2*k-1))⁻¹)*(d*e)^(k-1) *
        (Polynomial.C ((k:ℝ)*q)*(Polynomial.C b*e-Polynomial.C a*d) -
          Polynomial.C (((2*k-1:ℕ):ℝ)*
            ((2*k-2).choose (k-1):ℝ)*(a*b)^k)) := by
  unfold normalizedHeight
  rw [Polynomial.derivative_mul,Polynomial.derivative_C,zero_mul,zero_add,
    derivative_height_numerator_of_data k hk a b q d e hd he]
  ring

private theorem derivative_eval_affine_comp
    (P : Polynomial ℝ) (r₀ J z : ℝ) :
    (Polynomial.derivative (P.comp (Polynomial.C r₀+Polynomial.C J*Polynomial.X))).eval z =
      J*(Polynomial.derivative P).eval (r₀+J*z) := by
  rw [Polynomial.derivative_comp]
  simp only [Polynomial.derivative_add,Polynomial.derivative_mul,Polynomial.derivative_C,
    Polynomial.derivative_X,zero_add,zero_mul,mul_one,Polynomial.eval_mul,
    Polynomial.eval_C,Polynomial.eval_comp,Polynomial.eval_add,Polynomial.eval_X]

private theorem normalizedHeight_progression_derivative
    (k : ℕ) (hk : 1≤k) (d e : Polynomial ℝ) (a b m q r₀ J z : ℝ)
    (hd : Polynomial.derivative d=Polynomial.C b)
    (he : Polynomial.derivative e= -Polynomial.C a) :
    (Polynomial.derivative ((normalizedHeight k d e a b m q).comp
      (Polynomial.C r₀+Polynomial.C J*Polynomial.X))).eval z =
      J*(d.eval (r₀+J*z)*e.eval (r₀+J*z))^(k-1)/m^(2*k-1) *
        ((k:ℝ)*q*(b*e.eval (r₀+J*z)-a*d.eval (r₀+J*z)) -
          ((2*k-1:ℕ):ℝ)*((2*k-2).choose (k-1):ℝ)*(a*b)^k) := by
  rw [derivative_eval_affine_comp,normalizedHeight_derivative k hk d e a b m q hd he]
  simp only [Polynomial.eval_mul,Polynomial.eval_pow,Polynomial.eval_C,Polynomial.eval_sub]
  ring

private theorem affine_graph_values
    (a b m d₀ e₀ r₀ J z : ℝ) :
    (Polynomial.C (m*d₀)+Polynomial.C b*Polynomial.X).eval (r₀+J*z) =
        m*d₀+b*(r₀+J*z) ∧
      (Polynomial.C (m*e₀)-Polynomial.C a*Polynomial.X).eval (r₀+J*z) =
        m*e₀-a*(r₀+J*z) := by
  simp only [Polynomial.eval_add,Polynomial.eval_sub,Polynomial.eval_mul,
    Polynomial.eval_C,Polynomial.eval_X,and_self]

private theorem normalizedHeight_progression_original_value
    (k : ℕ) (d e : Polynomial ℝ) (a b m q r₀ J z n : ℝ)
    (hm : m≠0)
    (hnum : m^(2*k-1)*n =
      q*(d.eval (r₀+J*z)*e.eval (r₀+J*z))^k -
        pureHeight k (a*d.eval (r₀+J*z)) (b*e.eval (r₀+J*z))) :
    ((normalizedHeight k d e a b m q).comp
      (Polynomial.C r₀+Polynomial.C J*Polynomial.X)).eval z=n := by
  rw [Polynomial.eval_comp]
  simp only [Polynomial.eval_add,Polynomial.eval_mul,Polynomial.eval_C,Polynomial.eval_X]
  exact normalizedHeight_original_value k d e a b m q (r₀+J*z) n hm hnum

private def oldPriceZ (k : ℕ) (x M W : ℝ) : ℝ :=
  x^((1:ℝ)/(k:ℝ)) /
    (M^(((k:ℝ)-1)/(k:ℝ))*W^((1:ℝ)/((2*k-1:ℕ):ℝ)))

private theorem price_power_scale
    (k : ℕ) (hk : 1≤k) (x M W : ℝ) (hx : 0<x) (hM : 0<M) (hW : 0<W) :
    (oldPriceZ k x M W)^(k*(2*k-1))*M^((k-1)*(2*k-1))*W^k=x^(2*k-1) := by
  let p := 2*k-1
  have hkp : 0<(k:ℝ) := by exact_mod_cast (by omega : 0<k)
  have hpp : 0<(p:ℝ) := by exact_mod_cast (show 0<p by dsimp [p]; omega)
  have hkpred : ((k-1:ℕ):ℝ)=(k:ℝ)-1 := by
    rw [Nat.cast_sub hk]
    norm_num
  have hxQ : (x^((1:ℝ)/(k:ℝ)))^(k*p)=x^p := by
    rw [←Real.rpow_natCast,←Real.rpow_mul hx.le,←Real.rpow_natCast]
    congr 1
    push_cast
    field_simp [ne_of_gt hkp]
  have hMQ : (M^(((k:ℝ)-1)/(k:ℝ)))^(k*p)=M^((k-1)*p) := by
    rw [←Real.rpow_natCast,←Real.rpow_mul hM.le,←Real.rpow_natCast]
    congr 1
    simp only [Nat.cast_mul,hkpred]
    field_simp [ne_of_gt hkp]
  have hWQ : (W^((1:ℝ)/(p:ℝ)))^(k*p)=W^k := by
    rw [←Real.rpow_natCast,←Real.rpow_mul hW.le,←Real.rpow_natCast]
    congr 1
    push_cast
    field_simp [ne_of_gt hpp]
  change (x^((1:ℝ)/(k:ℝ)) /
    (M^(((k:ℝ)-1)/(k:ℝ))*W^((1:ℝ)/(p:ℝ))))^(k*p)*M^((k-1)*p)*W^k=x^p
  rw [div_pow,mul_pow,hxQ,hMQ,hWQ]
  field_simp [ne_of_gt hM,ne_of_gt hW]

private theorem powered_price
    (k : ℕ) (hk : 1≤k) (A K B x M W l : ℝ)
    (hA : 1≤A) (hKA : K≤A^(k*(2*k-1))) (hBA : B≤A)
    (hx : 0<x) (hM : 0<M) (hW : 0<W) (_hl : 0≤l)
    (hraw : l^(k*(2*k-1))*M^((k-1)*(2*k-1))*W^k≤K*x^(2*k-1) ∨ l≤B) :
    l≤A*(1+oldPriceZ k x M W) := by
  let p := 2*k-1
  let Z := oldPriceZ k x M W
  have hZ : 0≤Z := by dsimp [Z,oldPriceZ]; positivity
  have hAZ : 0≤A*Z := mul_nonneg (by linarith) hZ
  have hscale : Z^(k*p)*M^((k-1)*p)*W^k=x^p := price_power_scale k hk x M W hx hM hW
  have hQ : k*p≠0 := by
    apply Nat.ne_of_gt
    exact Nat.mul_pos (by omega) (by dsimp [p]; omega)
  rcases hraw with hraw | hraw
  · have hpow : l^(k*p)≤(A*Z)^(k*p) := by
      apply positive_mul_cancel _ _ (M^((k-1)*p)*W^k) (by positivity)
      calc
        l^(k*p)*(M^((k-1)*p)*W^k) ≤ K*x^p := by
          simpa only [mul_assoc] using hraw
        _≤A^(k*p)*x^p := mul_le_mul_of_nonneg_right hKA (pow_nonneg hx.le p)
        _=(A*Z)^(k*p)*(M^((k-1)*p)*W^k) := by
          rw [←hscale,mul_pow]
          ring
    have hroot := le_of_pow_le_pow_left₀ hQ hAZ hpow
    change l≤A*(1+Z)
    nlinarith only [hroot,hA]
  · change l≤A*(1+Z)
    nlinarith only [hraw,hBA,hAZ]

private theorem floor_power
    (k : ℕ) (hk : 1≤k) (c x M : ℝ) (hc : 0<c) (hx : 0<x)
    (hfloor : c*x^((1:ℝ)/((2*k-1:ℕ):ℝ))≤M) :
    c^(2*k-1)*x≤M^(2*k-1) := by
  have hp : (2*k-1:ℕ)≠0 := by omega
  have hpr : (((2*k-1:ℕ):ℝ))≠0 := by exact_mod_cast hp
  have hxroot : (x^((1:ℝ)/((2*k-1:ℕ):ℝ)))^(2*k-1)=x := by
    rw [←Real.rpow_natCast,←Real.rpow_mul hx.le]
    field_simp [hpr] ; simp only [Real.rpow_one]
  have hh := pow_le_pow_left₀
    (by positivity : 0≤c*x^((1:ℝ)/((2*k-1:ℕ):ℝ))) hfloor (2*k-1)
  simpa only [mul_pow,hxroot] using hh

private theorem oldPriceZ_le_frozenZ
    (k : ℕ) (hk : 1≤k) (x M W : ℝ) (hx : 0≤x) (hM : 0<M) (hW : 1≤W) :
    oldPriceZ k x M W ≤
      x^((1:ℝ)/(k:ℝ))*M^(-(((k:ℝ)-1)/(k:ℝ)))*
        W^(-((1:ℝ)/(2*(k:ℝ)+1))) := by
  have hWpos : 0<W := by linarith
  have hp : 0<((2*k-1:ℕ):ℝ) := by exact_mod_cast (by omega : 0<2*k-1)
  have hplus : 0<2*(k:ℝ)+1 := by positivity
  have hcast : ((2*k-1:ℕ):ℝ)=2*(k:ℝ)-1 := by
    rw [Nat.cast_sub (by omega : 1≤2*k)]
    push_cast
    ring
  have hexp : -((1:ℝ)/((2*k-1:ℕ):ℝ)) ≤ -((1:ℝ)/(2*(k:ℝ)+1)) := by
    rw [neg_le_neg_iff]
    apply (div_le_div_iff₀ hplus hp).mpr
    rw [hcast]
    linarith
  have hWpow := Real.rpow_le_rpow_of_exponent_le hW hexp
  calc
    oldPriceZ k x M W =
        x^((1:ℝ)/(k:ℝ))*M^(-(((k:ℝ)-1)/(k:ℝ)))*
          W^(-((1:ℝ)/((2*k-1:ℕ):ℝ))) := by
      unfold oldPriceZ
      rw [Real.rpow_neg hM.le,Real.rpow_neg hWpos.le]
      ring
    _≤_ := mul_le_mul_of_nonneg_left hWpow (by positivity)

private theorem near_interval_powered_bound
    (k : ℕ) (hk : 1≤k) :
    ∃ δ : ℝ,0<δ ∧ δ≤1/16 ∧
      ∀ C x M W a b m q J s t : ℝ,∀ d e N : Polynomial ℝ,
      0<C → 0<x → 0<M → 0<W → 0<J → m≠0 → a*b<0 →
      1≤|q| → |m|≤J → s<t →
      (t-s)*|m| *J*M≤C*W →
      |m|^(2*k-1)*x≤δ*W^k → m^2≤δ*|a*b| *W →
      (∀ z∈Set.Icc s t,
        0<d.eval z ∧ 0<e.eval z ∧ W/4≤d.eval z*e.eval z ∧
        d.eval z*e.eval z≤W ∧
        a*d.eval z+b*e.eval z=m ∧ 0≤N.eval z ∧ N.eval z≤x) →
      (∀ z : ℝ,q*(d.eval z*e.eval z)^k =
        pureHeight k (a*d.eval z) (b*e.eval z)+m^(2*k-1)*N.eval z) →
      (∀ z : ℝ,N.derivative.eval z =
        J*(d.eval z*e.eval z)^(k-1)/m^(2*k-1)*
          ((k:ℝ)*q*(b*e.eval z-a*d.eval z) -
            ((2*k-1:ℕ):ℝ)*((2*k-2).choose (k-1):ℝ)*(a*b)^k)) →
      (t-s)^(k*(2*k-1))*M^((k-1)*(2*k-1))*W^k ≤
        ((16*(2:ℝ)^(2*k-1)*(tailBudget k)^2)^k *
          ((2*(4:ℝ)^(k-1))*C^(k-1))^(2*k-1))*x^(2*k-1) := by
  obtain ⟨δ,hδ,hδsmall,hkernel⟩ := choose_derivative_margin_delta k hk
  refine ⟨δ,hδ,hδsmall,?_⟩
  intro C x M W a b m q J s t d e N hC hx hM hW hJ hm hab hq hstep hst
    hcell hdeep hsmall hdata hnum hder
  let T : ℝ := |a*b|
  let μ : ℝ := |m|
  let H : ℝ := 2*(4:ℝ)^(k-1)
  let S : ℝ := 16*(2:ℝ)^(2*k-1)*(tailBudget k)^2
  have hT : 0<T := abs_pos.mpr (ne_of_lt hab)
  have hμ : 0<μ := abs_pos.mpr hm
  have hH : 0<H := by dsimp [H]; positivity
  have hBudget := tailBudget_ge_one k hk
  have hS : 0<S := by dsimp [S]; positivity
  have hTab : a*b= -T := by dsimp [T]; rw [abs_of_neg hab]; ring
  have hNk : (1:ℝ)≤((2*k-2).choose (k-1):ℝ) := by
    exact_mod_cast Nat.succ_le_of_lt (Nat.choose_pos (show k-1≤2*k-2 by omega))
  have hnorm (z : ℝ) (hz : z∈Set.Icc s t) :
      (d.eval z*e.eval z)^k/2 ≤
        |pureHeight k (a*d.eval z) (b*e.eval z)| ∧
      T^k/2≤|(k:ℝ)*q*(b*e.eval z-a*d.eval z) -
        ((2*k-1:ℕ):ℝ)*((2*k-2).choose (k-1):ℝ)*(a*b)^k| := by
    obtain ⟨hd,he,hp,hpu,hlev,hn,hnx⟩ := hdata z hz
    have hAB : (a*d.eval z)*(b*e.eval z)= -T*(d.eval z*e.eval z) := by
      calc
        (a*d.eval z)*(b*e.eval z)=(a*b)*(d.eval z*e.eval z) := by ring
        _ = _ := by rw [hTab]
    have hnabs : |N.eval z|≤x := by rw [abs_of_nonneg hn]; exact hnx
    obtain ⟨hlo,hbr⟩ := hkernel x W m T (d.eval z*e.eval z)
      (a*d.eval z) (b*e.eval z) q (N.eval z)
      hx hW hT hp hlev hAB hq hnabs (hnum z) hdeep hsmall
    refine ⟨hlo,?_⟩
    rw [←hTab] at hbr
    have hh := mul_le_mul_of_nonneg_right hNk (pow_nonneg hT.le k)
    nlinarith only [hbr,hh]
  have hscale : W≤S*T^(2*k-1) := by
    obtain ⟨hd,he,hp,hpu,hlev,hn,hnx⟩ := hdata s ⟨le_rfl,hst.le⟩
    apply cancellation_height_scale k hk δ W T (d.eval s*e.eval s)
      (a*d.eval s) (b*e.eval s) m hδ hδsmall hW hT hp hlev _ hsmall
      (hnorm s ⟨le_rfl,hst.le⟩).1
    calc
      (a*d.eval s)*(b*e.eval s)=(a*b)*(d.eval s*e.eval s) := by ring
      _ = _ := by rw [hTab]
  have hheight : (t-s)*J*W^(k-1)*T^k≤H*x*μ^(2*k-1) := by
    let L : ℝ := J*W^(k-1)*T^k/(H*μ^(2*k-1))
    have hD (z : ℝ) (hzs : s<z) (hzt : z<t) : L≤|N.derivative.eval z| := by
      obtain ⟨hd,he,hp,hpu,hlev,hn,hnx⟩ := hdata z ⟨hzs.le,hzt.le⟩
      have hProd := pow_le_pow_left₀ (by positivity : 0≤W/4) hp (k-1)
      have hBr := (hnorm z ⟨hzs.le,hzt.le⟩).2
      have hmul := mul_le_mul hProd hBr (by positivity) (by positivity)
      calc
        L = (J/μ^(2*k-1))*((W/4)^(k-1)*(T^k/2)) := by
          dsimp [L,H]
          rw [div_pow]
          field_simp [ne_of_gt hμ]
        _ ≤ (J/μ^(2*k-1))*((d.eval z*e.eval z)^(k-1)*
            |(k:ℝ)*q*(b*e.eval z-a*d.eval z) -
              ((2*k-1:ℕ):ℝ)*((2*k-2).choose (k-1):ℝ)*(a*b)^k|) :=
          mul_le_mul_of_nonneg_left hmul (by positivity)
        _ = |N.derivative.eval z| := by
          rw [hder z,abs_mul,abs_div,abs_mul,abs_of_pos hJ,
            abs_pow,abs_of_pos (mul_pos hd he),abs_pow]
          change _ = (J*(d.eval z*e.eval z)^(k-1)/μ^(2*k-1))*
            |(k:ℝ)*q*(b*e.eval z-a*d.eval z) -
              ((2*k-1:ℕ):ℝ)*((2*k-2).choose (k-1):ℝ)*(a*b)^k|
          ring
    have hv (z : ℝ) (hzs : s≤z) (hzt : z≤t) : 0≤N.eval z ∧ N.eval z≤x :=
      ⟨(hdata z ⟨hzs,hzt⟩).2.2.2.2.2.1,(hdata z ⟨hzs,hzt⟩).2.2.2.2.2.2⟩
    have hlen := polynomial_height_derivative_length N s t x L hst hv hD
    have hh : (t-s)*(J*W^(k-1)*T^k)≤x*(H*μ^(2*k-1)) := by
      apply (div_le_iff₀ (by positivity : 0<H*μ^(2*k-1))).mp
      simpa only [L,mul_div_assoc] using hlen
    nlinarith only [hh]
  exact near_powered_length k hk C H S x M W μ J T (t-s)
    hC hH hS hx hM hW hμ hstep hT (sub_nonneg.mpr hst.le) hcell hheight hscale

private theorem interval_powered_bound
    (k : ℕ) (hk : 1≤k) :
    ∃ δ : ℝ,0<δ ∧ δ≤1/16 ∧
      ∀ C c x M W : ℝ,∀ a b m q J : ℤ,∀ d e N : Polynomial ℝ,∀ s t : ℝ,
      0<C → 0<c → 2≤x → 0<M → 0<W →
      c*x^((1:ℝ)/((2*k-1:ℕ):ℝ))≤M →
      Int.gcd a b=1 → m≠0 → q≠0 → 0<J → |(m:ℝ)|≤(J:ℝ) → s<t →
      (t-s)*|(m:ℝ)| *(J:ℝ)*M≤C*W →
      (d.eval s)^k≤x → (e.eval s)^k≤2*x →
      (∀ z∈Set.Icc s t,0<d.eval z ∧ 0<e.eval z ∧
        W/4≤d.eval z*e.eval z ∧ d.eval z*e.eval z≤W ∧
        (a:ℝ)*d.eval z+(b:ℝ)*e.eval z=(m:ℝ) ∧ 0≤N.eval z ∧ N.eval z≤x) →
      (∀ z : ℝ,(q:ℝ)*(d.eval z*e.eval z)^k =
        pureHeight k ((a:ℝ)*d.eval z) ((b:ℝ)*e.eval z)+(m:ℝ)^(2*k-1)*N.eval z) →
      (∀ z : ℝ,N.derivative.eval z =
        (J:ℝ)*(d.eval z*e.eval z)^(k-1)/(m:ℝ)^(2*k-1)*
          ((k:ℝ)*(q:ℝ)*((b:ℝ)*e.eval z-(a:ℝ)*d.eval z) -
            ((2*k-1:ℕ):ℝ)*((2*k-2).choose (k-1):ℝ)*((a:ℝ)*(b:ℝ))^k)) →
      (t-s)^(k*(2*k-1))*M^((k-1)*(2*k-1))*W^k ≤
        (C^(k*(2*k-1))/(δ^(2*k)*c^(2*k-1))+
          (16*(2:ℝ)^(2*k-1)*(tailBudget k)^2)^k*
            ((2*(4:ℝ)^(k-1))*C^(k-1))^(2*k-1))*x^(2*k-1) ∨
        t-s≤C/(δ*c) := by
  obtain ⟨δ₀,hδ₀,hδ₀small,hNear⟩ := near_interval_powered_bound k hk
  let δ : ℝ := min δ₀ (1/(2*(4:ℝ)^k))
  have hδ : 0<δ := by dsimp [δ]; positivity
  have hδle : δ≤δ₀ := min_le_left _ _
  have hδaxis : δ≤1/(2*(4:ℝ)^k) := min_le_right _ _
  have hδsmall : δ≤1/16 := hδle.trans hδ₀small
  refine ⟨δ,hδ,hδsmall,?_⟩
  intro C c x M W a b m q J d e N s t hC hc hx hM hW hfloor
    hprim hm hq hJ hstep hst hcell hds hes hdata hnum hder
  let μ : ℝ := |(m:ℝ)|
  let T : ℝ := |((a*b:ℤ):ℝ)|
  let K₁ : ℝ := C^(k*(2*k-1))/(δ^(2*k)*c^(2*k-1))
  let K₂ : ℝ := (16*(2:ℝ)^(2*k-1)*(tailBudget k)^2)^k*
    ((2*(4:ℝ)^(k-1))*C^(k-1))^(2*k-1)
  have hx0 : 0<x := by linarith
  have hmR : (m:ℝ)≠0 := by exact_mod_cast hm
  have hμ : 0<μ := abs_pos.mpr hmR
  have hμ1 : 1≤μ := by dsimp [μ]; exact_mod_cast Int.one_le_abs hm
  have hJR : 0<(J:ℝ) := by exact_mod_cast hJ
  have hl : 0≤t-s := sub_nonneg.mpr hst.le
  have hK₁ : 0≤K₁ := by dsimp [K₁]; positivity
  have hK₂ : 0≤K₂ := by dsimp [K₂]; positivity
  have hcell2 : (t-s)*μ^2*M≤C*W := by
    have hh := mul_le_mul_of_nonneg_left hstep (by positivity : 0≤(t-s)*μ*M)
    nlinarith only [hh,hcell]
  have hfloorP := floor_power k hk c x M hc hx0 hfloor
  have hlargeout (hlarge : δ*W^k≤μ^(2*k-1)*x) :
      (t-s)^(k*(2*k-1))*M^((k-1)*(2*k-1))*W^k≤(K₁+K₂)*x^(2*k-1) ∨
        t-s≤C/(δ*c) := by
    have hh := large_powered_length k hk C c δ x M W μ (t-s)
      hC hc hδ hx0 hM hW hμ hl hfloorP hcell2 hlarge
    left
    exact hh.trans (by nlinarith only [mul_nonneg hK₂ (pow_nonneg hx0.le (2*k-1))])
  by_cases hlarge : δ*W^k≤μ^(2*k-1)*x
  · exact hlargeout hlarge
  obtain ⟨hds0,hes0,hps,hpsup,hlevs,hns,hnsx⟩ := hdata s ⟨le_rfl,hst.le⟩
  by_cases hab0 : a*b=0
  · have hprod : W≤4*d.eval s*e.eval s := by linarith
    have hh := zero_axis_large_height k hk a b (d.eval s) (e.eval s) (m:ℝ) x W δ
      hprim hab0 hds0 hes0 hx0 hW hlevs hprod hds hes hμ1 hδ.le hδaxis
    exact False.elim (hlarge hh)
  have hT1 : 1≤T := by dsimp [T]; exact_mod_cast Int.one_le_abs hab0
  have hT : 0<T := by linarith
  have hcM : c≤M := by
    have hh : 1≤x^((1:ℝ)/((2*k-1:ℕ):ℝ)) :=
      Real.one_le_rpow (by linarith) (by positivity)
    have hh' : c≤c*x^((1:ℝ)/((2*k-1:ℕ):ℝ)) := by
      simpa only [mul_one] using mul_le_mul_of_nonneg_left hh hc.le
    exact hh'.trans hfloor
  by_cases hmoderate : δ*T*W≤μ^2
  · right
    exact moderate_length C c δ W μ (J:ℝ) T M (t-s)
      hC hc hδ hW hμ hstep hT1 hcM hl hcell hmoderate
  have habneg : ((a*b:ℤ):ℝ)<0 := by
    by_contra hh
    have habpos : 0≤((a*b:ℤ):ℝ) := le_of_not_gt hh
    have hTeq : T=((a*b:ℤ):ℝ) := abs_of_nonneg habpos
    have hsquare : (m:ℝ)^2=
      ((a:ℝ)*d.eval s-(b:ℝ)*e.eval s)^2+
        4*((a*b:ℤ):ℝ)*(d.eval s*e.eval s) := by rw [←hlevs]; push_cast; ring
    have hWsmall : T*W≤μ^2 := by
      have hh' := mul_le_mul_of_nonneg_left hps (by positivity : 0≤4*T)
      have hsq := sq_nonneg ((a:ℝ)*d.eval s-(b:ℝ)*e.eval s)
      rw [hTeq] at hh'
      rw [hTeq]
      dsimp [μ]
      rw [sq_abs]
      nlinarith only [hh',hsquare,hsq]
    have hh' := mul_le_mul_of_nonneg_right hδsmall (by positivity : 0≤T*W)
    exact hmoderate (by nlinarith only [hWsmall,hh',mul_nonneg hT.le hW.le])
  have habneg' : (a:ℝ)*(b:ℝ)<0 := by simpa only [Int.cast_mul] using habneg
  have hdeep : μ^(2*k-1)*x≤δ₀*W^k := by
    have hh := le_of_lt (lt_of_not_ge hlarge)
    exact hh.trans (mul_le_mul_of_nonneg_right hδle (pow_nonneg hW.le k))
  have hsmall : (m:ℝ)^2≤δ₀*|(a:ℝ)*(b:ℝ)| *W := by
    have hh : μ^2≤δ*T*W := le_of_lt (lt_of_not_ge hmoderate)
    have hh' : δ*T*W≤δ₀*T*W := by nlinarith [mul_le_mul_of_nonneg_right hδle (mul_nonneg hT.le hW.le)]
    have hr : (m:ℝ)^2≤δ₀*T*W := by simpa only [μ,sq_abs] using hh.trans hh'
    simpa only [T,Int.cast_mul] using hr
  have hqabs : 1≤|(q:ℝ)| := by exact_mod_cast Int.one_le_abs hq
  have hnear := hNear C x M W (a:ℝ) (b:ℝ) (m:ℝ) (q:ℝ) (J:ℝ) s t d e N
    hC hx0 hM hW hJR hmR habneg' hqabs hstep hst hcell hdeep hsmall hdata hnum hder
  left
  exact hnear.trans (by nlinarith only [mul_nonneg hK₁ (pow_nonneg hx0.le (2*k-1))])

private theorem polynomial_sum_degree_bound {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (f : ι→Polynomial ℝ) (D : ℕ)
    (hf : ∀ i∈s,(f i).natDegree≤D) :
    (∑ i∈s,f i).natDegree≤D := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih =>
    rw [Finset.sum_insert hi]
    exact a5deg_add _ _ D (hf i (Finset.mem_insert_self _ _))
      (ih (fun j hj => hf j (Finset.mem_insert_of_mem hj)))

private theorem tailR_polynomial_degree
    (k : ℕ) (hk : 1≤k) (A B : Polynomial ℝ)
    (hA : A.natDegree≤1) (hB : B.natDegree≤1) :
    (tailR k A B).natDegree≤k-1 := by
  unfold tailR
  apply polynomial_sum_degree_bound
  intro i hi
  have hik : i≤k-1 := by have := Finset.mem_range.mp hi; omega
  have hAp := a5deg_affine_power A hA i
  have hBp := a5deg_affine_power B hB (k-1-i)
  have hProd := a5deg_mul _ _ i (k-1-i) hAp hBp
  have hProd' : (A^i*B^(k-1-i)).natDegree≤k-1 := by
    simpa only [Nat.add_sub_of_le hik] using hProd
  have hh := a5deg_cmul (((2*k-1).choose (k+i):ℝ)) _ (k-1) hProd'
  simpa only [map_natCast,mul_assoc] using hh

private theorem normalizedHeight_degree
    (k : ℕ) (hk : 1≤k) (d e : Polynomial ℝ) (a b m q : ℝ)
    (hd : d.natDegree≤1) (he : e.natDegree≤1) :
    (normalizedHeight k d e a b m q).natDegree≤2*k := by
  have hA : (Polynomial.C a*d).natDegree≤1 := a5deg_cmul a d 1 hd
  have hB : (Polynomial.C b*e).natDegree≤1 := a5deg_cmul b e 1 he
  have hAk := a5deg_affine_power (Polynomial.C a*d) hA k
  have htail := tailR_polynomial_degree k hk _ _ hA hB
  have hHP := a5deg_mul _ _ k (k-1) hAk htail
  have hHP' :
      ((Polynomial.C a*d)^k*tailR k (Polynomial.C a*d) (Polynomial.C b*e)).natDegree≤2*k := by
    exact hHP.trans (by omega)
  have hde : ((d*e)^k).natDegree≤2*k := by
    rw [mul_pow]
    have hh := a5deg_mul _ _ k k (a5deg_affine_power d hd k) (a5deg_affine_power e he k)
    simpa only [two_mul] using hh
  unfold normalizedHeight
  exact a5deg_cmul _ _ (2*k)
    (a5deg_sub _ _ (2*k) (a5deg_cmul q _ (2*k) hde) hHP')

private theorem affine_polynomial_degree (α β : ℝ) :
    (Polynomial.C α+Polynomial.C β*Polynomial.X).natDegree≤1 :=
  a5deg_add _ _ 1 (a5deg_const α 1) (a5deg_cmul β _ 1 (by simp))

private theorem affine_comp_degree
    (P : Polynomial ℝ) (D : ℕ) (hP : P.natDegree≤D) (α β : ℝ) :
    (P.comp (Polynomial.C α+Polynomial.C β*Polynomial.X)).natDegree≤D := by
  calc
    _≤P.natDegree*(Polynomial.C α+Polynomial.C β*Polynomial.X).natDegree :=
      Polynomial.natDegree_comp_le
    _≤D*1 := Nat.mul_le_mul hP (affine_polynomial_degree α β)
    _=D := Nat.mul_one D

private theorem polynomial_boundary_price
    (n : ℕ) (B : Finset (Polynomial ℝ)) (T : Finset ℤ) (A F : ℝ)
    (hA : 1≤A) (hF : 1≤F)
    (hR : (B.biUnion fun P => P.roots.toFinset).card≤n)
    (hvalid : ∀ z∈T,∀ P∈B,0≤P.eval (z:ℝ))
    (hdiam : ∀ s∈T,∀ t∈T,s≤t →
      (∀ P∈B,∀ z∈Set.Icc (s:ℝ) (t:ℝ),0≤P.eval z) →
      ((t-s:ℤ):ℝ)≤A*F) :
    (T.card:ℝ)≤(2*((n:ℝ)+1)*A+3*((n:ℝ)+1)+1)*F := by
  have hnat := polynomial_boundary_count n B T A F hA hF hR hvalid hdiam
  have hcast : (T.card:ℝ)≤((n:ℝ)+1)*(2*(Nat.ceil (A*F):ℝ)+1)+1 := by
    exact_mod_cast hnat
  have hAF : 0≤A*F := by positivity
  have hceil : (Nat.ceil (A*F):ℝ)≤A*F+1 := (Nat.ceil_lt_add_one hAF).le
  have hmul := mul_le_mul_of_nonneg_left hceil (by positivity : 0≤2*((n:ℝ)+1))
  have hFmul := mul_nonneg
    (by positivity : 0≤3*((n:ℝ)+1)+1) (sub_nonneg.mpr hF)
  nlinarith only [hcast,hmul,hFmul]

private def parameterD (b m d₀ r₀ J : ℤ) : Polynomial ℝ :=
  Polynomial.C (((m*d₀+b*r₀:ℤ):ℝ))+
    Polynomial.C (((b*J:ℤ):ℝ))*Polynomial.X

private def parameterE (a m e₀ r₀ J : ℤ) : Polynomial ℝ :=
  Polynomial.C (((m*e₀-a*r₀:ℤ):ℝ))-
    Polynomial.C (((a*J:ℤ):ℝ))*Polynomial.X

private def parameterN (k : ℕ) (a b m d₀ e₀ r₀ q J : ℤ) : Polynomial ℝ :=
  (normalizedHeight k
    (Polynomial.C (((m*d₀:ℤ):ℝ))+Polynomial.C (b:ℝ)*Polynomial.X)
    (Polynomial.C (((m*e₀:ℤ):ℝ))-Polynomial.C (a:ℝ)*Polynomial.X)
    (a:ℝ) (b:ℝ) (m:ℝ) (q:ℝ)).comp
      (Polynomial.C (r₀:ℝ)+Polynomial.C (J:ℝ)*Polynomial.X)

private theorem parameter_count
    (k : ℕ) (hk : 1≤k) (c : ℝ) (hc : 0<c) :
    ∃ C : ℝ,1≤C ∧ ∀ x D E M ρ : ℝ,
      2≤x → 0<D → 0<E → 0<M → 0≤ρ → ρ≤2*D/E →
      c*x^((1:ℝ)/((2*k-1:ℕ):ℝ))≤M →
      ∀ a b m d₀ e₀ r₀ q J : ℤ,
        Int.gcd a b=1 → m≠0 → q≠0 → 0<J →
        a*d₀+b*e₀=1 → |(m:ℝ)|≤(J:ℝ) →
        let d := parameterD b m d₀ r₀ J
        let e := parameterE a m e₀ r₀ J
        let N := parameterN k a b m d₀ e₀ r₀ q J
        ∀ T : Finset ℤ,
          (∀ z∈T,D/2<d.eval (z:ℝ) ∧ d.eval (z:ℝ)≤D ∧
            E/2<e.eval (z:ℝ) ∧ e.eval (z:ℝ)≤E ∧
            (d.eval (z:ℝ))^k≤x ∧ (e.eval (z:ℝ))^k≤2*x ∧
            0≤N.eval (z:ℝ) ∧ N.eval (z:ℝ)≤x ∧
            ρ<d.eval (z:ℝ)/e.eval (z:ℝ) ∧
              d.eval (z:ℝ)/e.eval (z:ℝ)≤ρ*(1+1/M)) →
          (T.card:ℝ)≤C*(1+oldPriceZ k x M (D*E)) := by
  classical
  obtain ⟨δ,hδ,hδsmall,hInterval⟩ := interval_powered_bound k hk
  let K₁ : ℝ := (2:ℝ)^(k*(2*k-1))/(δ^(2*k)*c^(2*k-1))
  let K₂ : ℝ := (16*(2:ℝ)^(2*k-1)*(tailBudget k)^2)^k*
    ((2*(4:ℝ)^(k-1))*(2:ℝ)^(k-1))^(2*k-1)
  let K : ℝ := K₁+K₂
  let B₀ : ℝ := 2/(δ*c)
  let A : ℝ := 1+K+B₀
  have hK₁ : 0≤K₁ := by dsimp [K₁]; positivity
  have hK₂ : 0≤K₂ := by dsimp [K₂]; positivity
  have hK : 0≤K := add_nonneg hK₁ hK₂
  have hB₀ : 0≤B₀ := by dsimp [B₀]; positivity
  have hA : 1≤A := by dsimp [A]; linarith
  have hBA : B₀≤A := by dsimp [A]; linarith
  have hQ : 1≤k*(2*k-1) := Nat.one_le_iff_ne_zero.mpr
    (Nat.mul_ne_zero (by omega) (by omega))
  have hKA : K≤A^(k*(2*k-1)) := by
    have hh : A≤A^(k*(2*k-1)) := by
      simpa only [pow_one] using pow_le_pow_right₀ hA hQ
    have hKle : K≤A := by dsimp [A]; linarith
    exact hKle.trans hh
  let C : ℝ := 2*(((12*k:ℕ):ℝ)+1)*A+3*(((12*k:ℕ):ℝ)+1)+1
  have hCprice : 1≤C := by
    have hA0 : 0≤A := by linarith
    have hh : 0≤2*(((12*k:ℕ):ℝ)+1)*A+3*(((12*k:ℕ):ℝ)+1) := by positivity
    dsimp [C]
    linarith
  refine ⟨C,hCprice,?_⟩
  intro x D E M ρ hx hD hE hM hρ hρD hfloor
    a b m d₀ e₀ r₀ q J hprim hm hq hJ hbez hstep d e N T hT
  let W : ℝ := D*E
  let F : ℝ := 1+oldPriceZ k x M W
  have hx0 : 0<x := by linarith
  have hW : 0<W := mul_pos hD hE
  have hJR : 0<(J:ℝ) := by exact_mod_cast hJ
  have hmR : (m:ℝ)≠0 := by exact_mod_cast hm
  have hbezR : (a:ℝ)*(d₀:ℝ)+(b:ℝ)*(e₀:ℝ)=1 := by exact_mod_cast hbez
  have hF : 1≤F := by
    have hh : 0≤oldPriceZ k x M W := by unfold oldPriceZ; positivity
    dsimp [F]
    linarith
  have hvalues (z : ℝ) :
      d.eval z=(m:ℝ)*(d₀:ℝ)+(b:ℝ)*((r₀:ℝ)+(J:ℝ)*z) ∧
      e.eval z=(m:ℝ)*(e₀:ℝ)-(a:ℝ)*((r₀:ℝ)+(J:ℝ)*z) := by
    dsimp [d,e,parameterD,parameterE]
    simp only [Polynomial.eval_add,Polynomial.eval_sub,Polynomial.eval_mul,
      Polynomial.eval_C,Polynomial.eval_X]
    push_cast
    constructor <;> ring
  have hlevelz (z : ℝ) : (a:ℝ)*d.eval z+(b:ℝ)*e.eval z=(m:ℝ) := by
    rw [(hvalues z).1,(hvalues z).2]
    linear_combination (m:ℝ)*hbezR
  have hdegd : d.natDegree≤1 := a5deg_originalD b m d₀ r₀ J
  have hdege : e.natDegree≤1 := a5deg_originalE a m e₀ r₀ J
  let db : Polynomial ℝ := Polynomial.C (((m*d₀:ℤ):ℝ))+Polynomial.C (b:ℝ)*Polynomial.X
  let eb : Polynomial ℝ := Polynomial.C (((m*e₀:ℤ):ℝ))-Polynomial.C (a:ℝ)*Polynomial.X
  have hdbDeg : db.natDegree≤1 := affine_polynomial_degree _ _
  have hebDeg : eb.natDegree≤1 := by
    simpa only [eb,map_neg,neg_mul,sub_eq_add_neg] using
      affine_polynomial_degree (((m*e₀:ℤ):ℝ)) (-(a:ℝ))
  have hdegN : N.natDegree≤2*k := by
    exact affine_comp_degree _ (2*k)
      (normalizedHeight_degree k hk db eb (a:ℝ) (b:ℝ) (m:ℝ) (q:ℝ) hdbDeg hebDeg)
      (r₀:ℝ) (J:ℝ)
  have hdb : db.derivative=Polynomial.C (b:ℝ) := by simp [db]
  have heb : eb.derivative= -Polynomial.C (a:ℝ) := by simp [eb]
  have hnum (z : ℝ) : (q:ℝ)*(d.eval z*e.eval z)^k =
      pureHeight k ((a:ℝ)*d.eval z) ((b:ℝ)*e.eval z)+(m:ℝ)^(2*k-1)*N.eval z := by
    have hh := normalizedHeight_eval k db eb (a:ℝ) (b:ℝ) (m:ℝ) (q:ℝ)
      ((r₀:ℝ)+(J:ℝ)*z)
    have hNb : N.eval z=(normalizedHeight k db eb (a:ℝ) (b:ℝ) (m:ℝ) (q:ℝ)).eval
        ((r₀:ℝ)+(J:ℝ)*z) := by
      simp only [N,parameterN,db,eb,Polynomial.eval_comp,Polynomial.eval_add,
        Polynomial.eval_mul,Polynomial.eval_C,Polynomial.eval_X]
    rw [←hNb] at hh
    have hdbe : db.eval ((r₀:ℝ)+(J:ℝ)*z)=d.eval z := by
      rw [(hvalues z).1]; simp [db]
    have hebe : eb.eval ((r₀:ℝ)+(J:ℝ)*z)=e.eval z := by
      rw [(hvalues z).2]; simp [eb]
    rw [hdbe,hebe] at hh
    have hp := (eq_div_iff (pow_ne_zero (2*k-1) hmR)).mp hh
    linarith
  have hder (z : ℝ) : N.derivative.eval z =
      (J:ℝ)*(d.eval z*e.eval z)^(k-1)/(m:ℝ)^(2*k-1)*
        ((k:ℝ)*(q:ℝ)*((b:ℝ)*e.eval z-(a:ℝ)*d.eval z) -
          ((2*k-1:ℕ):ℝ)*((2*k-2).choose (k-1):ℝ)*((a:ℝ)*(b:ℝ))^k) := by
    have hh := normalizedHeight_progression_derivative k hk db eb
      (a:ℝ) (b:ℝ) (m:ℝ) (q:ℝ) (r₀:ℝ) (J:ℝ) z hdb heb
    change N.derivative.eval z=_ at hh
    have hdbe : db.eval ((r₀:ℝ)+(J:ℝ)*z)=d.eval z := by
      rw [(hvalues z).1]; simp [db]
    have hebe : eb.eval ((r₀:ℝ)+(J:ℝ)*z)=e.eval z := by
      rw [(hvalues z).2]; simp [eb]
    simpa only [hdbe,hebe] using hh
  let Ls : List (Polynomial ℝ) :=
    [d-Polynomial.C (D/2),Polynomial.C D-d,e-Polynomial.C (E/2),Polynomial.C E-e,N,Polynomial.C x-N]
  let Bs := Ls.toFinset
  have hBcard : Bs.card≤6 := by
    have hh := boundary_list_card_le_length Ls
    simpa only [Ls,List.length_cons,List.length_nil] using hh
  have hBdeg : ∀ P∈Bs,P.natDegree≤2*k := by
    intro P hp
    simp only [Bs,Ls,List.mem_toFinset,List.mem_cons,List.not_mem_nil,or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl | rfl | rfl
    · exact a5deg_sub _ _ (2*k) (hdegd.trans (by omega)) (a5deg_const _ (2*k))
    · exact a5deg_sub _ _ (2*k) (a5deg_const _ (2*k)) (hdegd.trans (by omega))
    · exact a5deg_sub _ _ (2*k) (hdege.trans (by omega)) (a5deg_const _ (2*k))
    · exact a5deg_sub _ _ (2*k) (a5deg_const _ (2*k)) (hdege.trans (by omega))
    · exact hdegN
    · exact a5deg_sub _ _ (2*k) (a5deg_const _ (2*k)) hdegN
  have hR : (Bs.biUnion fun P => P.roots.toFinset).card≤12*k := by
    have hh := (family_root_card_le_degrees Bs).trans (Finset.sum_le_sum hBdeg)
    have hh' : (Bs.biUnion fun P => P.roots.toFinset).card≤Bs.card*(2*k) := by simpa using hh
    have hmul := Nat.mul_le_mul_right (2*k) hBcard
    nlinarith only [hh',hmul]
  change (T.card:ℝ)≤C*F
  apply polynomial_boundary_price (12*k) Bs T A F hA hF hR
  · intro z hz P hp
    obtain ⟨hdlo,hdup,helo,heup,hdx,hex,hn0,hnx,hrlo,hrup⟩ := hT z hz
    simp only [Bs,Ls,List.mem_toFinset,List.mem_cons,List.not_mem_nil,or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl | rfl | rfl
    · simp only [Polynomial.eval_sub,Polynomial.eval_C]; linarith
    · simp only [Polynomial.eval_sub,Polynomial.eval_C]; linarith
    · simp only [Polynomial.eval_sub,Polynomial.eval_C]; linarith
    · simp only [Polynomial.eval_sub,Polynomial.eval_C]; linarith
    · exact hn0
    · simp only [Polynomial.eval_sub,Polynomial.eval_C]; linarith
  · intro s hs t ht hst hclosed
    by_cases heq : s=t
    · subst t; simp only [sub_self,Int.cast_zero]; positivity
    have hstR : (s:ℝ)<(t:ℝ) := by exact_mod_cast (show s<t by omega)
    obtain ⟨hds,hDs,hes,hEs,hds2,hes2,hns0,hnsx,hrs,hrS⟩ := hT s hs
    obtain ⟨hdt,hDt,het,hEt,hdt2,het2,hnt0,hntx,hrt,hrT⟩ := hT t ht
    have hes0 : 0<e.eval (s:ℝ) := by linarith
    have het0 : 0<e.eval (t:ℝ) := by linarith
    have hdet := ratio_cell_determinant (d.eval (s:ℝ)) (e.eval (s:ℝ))
      (d.eval (t:ℝ)) (e.eval (t:ℝ)) ρ M E D hes0 het0 hM hE hD hρ hρD hEs hEt
      ((lt_div_iff₀ hes0).mp hrs).le ((div_le_iff₀ hes0).mp hrS)
      ((lt_div_iff₀ het0).mp hrt).le ((div_le_iff₀ het0).mp hrT)
    have hdetEq : d.eval (s:ℝ)*e.eval (t:ℝ)-d.eval (t:ℝ)*e.eval (s:ℝ) =
        (m:ℝ)*(J:ℝ)*((s:ℝ)-(t:ℝ)) := by
      rw [(hvalues (s:ℝ)).1,(hvalues (s:ℝ)).2,(hvalues (t:ℝ)).1,(hvalues (t:ℝ)).2,
        level_parameter_determinant (a:ℝ) (b:ℝ) (d₀:ℝ) (e₀:ℝ) (m:ℝ)
          ((r₀:ℝ)+(J:ℝ)*(s:ℝ)) ((r₀:ℝ)+(J:ℝ)*(t:ℝ)) hbezR]
      ring
    rw [hdetEq,abs_mul,abs_mul,abs_of_pos hJR,abs_of_nonpos (sub_nonpos.mpr hstR.le)] at hdet
    have hcell : ((t:ℝ)-(s:ℝ))*|(m:ℝ)| *(J:ℝ)*M≤2*W := by
      have hh := (le_div_iff₀ hM).mp hdet
      dsimp [W]
      nlinarith only [hh]
    have hdata (z : ℝ) (hz : z∈Set.Icc (s:ℝ) (t:ℝ)) :
        0<d.eval z ∧ 0<e.eval z ∧ W/4≤d.eval z*e.eval z ∧
          d.eval z*e.eval z≤W ∧ (a:ℝ)*d.eval z+(b:ℝ)*e.eval z=(m:ℝ) ∧
            0≤N.eval z ∧ N.eval z≤x := by
      have h1 := hclosed (d-Polynomial.C (D/2)) (by simp [Bs,Ls]) z hz
      have h2 := hclosed (Polynomial.C D-d) (by simp [Bs,Ls]) z hz
      have h3 := hclosed (e-Polynomial.C (E/2)) (by simp [Bs,Ls]) z hz
      have h4 := hclosed (Polynomial.C E-e) (by simp [Bs,Ls]) z hz
      have h5 := hclosed N (by simp [Bs,Ls]) z hz
      have h6 := hclosed (Polynomial.C x-N) (by simp [Bs,Ls]) z hz
      simp only [Polynomial.eval_sub,Polynomial.eval_C] at h1 h2 h3 h4 h6
      have hdz : 0<d.eval z := by linarith
      have hez : 0<e.eval z := by linarith
      have hlo := mul_le_mul (show D/2≤d.eval z by linarith)
        (show E/2≤e.eval z by linarith) (by positivity : 0≤E/2) hdz.le
      have hup := mul_le_mul (show d.eval z≤D by linarith)
        (show e.eval z≤E by linarith) hez.le hD.le
      refine ⟨hdz,hez,?_,hup,hlevelz z,h5,by linarith⟩
      dsimp [W]
      nlinarith only [hlo]
    have hraw := hInterval 2 c x M W a b m q J d e N (s:ℝ) (t:ℝ)
      (by norm_num) hc hx hM hW hfloor hprim hm hq hJ hstep hstR hcell hds2 hes2 hdata hnum hder
    change ((t:ℝ)-(s:ℝ))^(k*(2*k-1))*M^((k-1)*(2*k-1))*W^k≤K*x^(2*k-1) ∨
      (t:ℝ)-(s:ℝ)≤B₀ at hraw
    have hh := powered_price k hk A K B₀ x M W ((t:ℝ)-(s:ℝ))
      hA hKA hBA hx0 hM hW (sub_nonneg.mpr hstR.le) hraw
    simpa only [Int.cast_sub] using hh

private theorem fixed_level_count
    (k : ℕ) (hk : 1≤k) (c : ℝ) (hc : 0<c) :
    ∃ C : ℝ,1≤C ∧ ∀ x D E M ρ : ℝ,
      2≤x → 0<D → 0<E → 0<M → 0≤ρ → ρ≤2*D/E →
      c*x^((1:ℝ)/((2*k-1:ℕ):ℝ))≤M →
      ∀ a b m q : ℤ,Int.gcd a b=1 → m≠0 → q≠0 →
      ∀ T : Finset (Fin 4→ℤ),
      (∀ p∈T,(∀ i,0<p i) ∧ (((p 0)^k*p 2:ℤ):ℝ)≤x ∧
        D/2<(p 0:ℝ) ∧ (p 0:ℝ)≤D ∧ E/2<(p 1:ℝ) ∧ (p 1:ℝ)≤E ∧
        ρ<(p 0:ℝ)/(p 1:ℝ) ∧ (p 0:ℝ)/(p 1:ℝ)≤ρ*(1+1/M) ∧
        (p 1)^k*p 3=(p 0)^k*p 2+1 ∧
        a*p 0+b*p 1=m ∧
        m^(2*k-1)*p 2=q*(p 1)^k-a^k*tailR k (a*p 0) (b*p 1) ∧
        m^(2*k-1)*p 3=q*(p 0)^k+b^k*tailR k (b*p 1) (a*p 0)) →
      (T.card:ℝ)≤C*(k:ℝ)^m.natAbs.primeFactors.card*
        (1+oldPriceZ k x M (D*E)) := by
  classical
  obtain ⟨C,hC,hcount⟩ := parameter_count k hk c hc
  refine ⟨C,hC,?_⟩
  intro x D E M ρ hx hD hE hM hρ hρD hfloor a b m q hprim hm hq T hT
  obtain ⟨d₀,e₀,hbez'⟩ := Int.isCoprime_iff_gcd_eq_one.mpr hprim
  have hbez : a*d₀+b*e₀=1 := by nlinarith only [hbez']
  obtain ⟨S,hSc,hSv⟩ := levelCongruences_global_cover k hk a b d₀ e₀ m q hm hbez
  let J : ℤ := m.natAbs
  have hJ : 0<J := by dsimp [J]; exact_mod_cast Int.natAbs_pos.mpr hm
  have hJsize : |(m:ℝ)|≤(J:ℝ) := by
    have hJI : |m|=J := by
      dsimp [J]
      exact (Int.natCast_natAbs m).symm
    have hh := congrArg (fun z : ℤ => (z:ℝ)) hJI
    simpa only [Int.cast_abs] using hh.le
  let r : (Fin 4→ℤ)→ℤ := fun p => e₀*p 0-d₀*p 1
  have hcoords (p : Fin 4→ℤ) (hp : p∈T) :
      p 0=m*d₀+b*r p ∧ p 1=m*e₀-a*r p := by
    obtain ⟨hpos,hnx,hdlo,hdhi,helo,hehi,hrlo,hrhi,hs,hl,hu,hv⟩ := hT p hp
    constructor
    · dsimp [r]; linear_combination -p 0*hbez+d₀*hl
    · dsimp [r]; linear_combination -p 1*hbez+e₀*hl
  have hcovers (p : {p : Fin 4→ℤ // p∈T}) :
      ∃ s∈S,∃ z : ℤ,r p.val=s+J*z := by
    obtain ⟨hd,he⟩ := hcoords p.val p.property
    obtain ⟨hpos,hnx,hdlo,hdhi,helo,hehi,hrlo,hrhi,hs,hl,hu,hv⟩ := hT p.val p.property
    obtain ⟨s,hs,z,hz⟩ := hSv (r p.val)
      (original_levelCongruences k hk a b d₀ e₀ m q
        (p.val 0) (p.val 1) (r p.val) (p.val 2) (p.val 3) hl hd he hu hv)
    exact ⟨s,hs,z,by change r p.val=s+(m.natAbs:ℤ)*z; linear_combination hz⟩
  choose sf hsf tf htf using hcovers
  let Tf : ℤ→Finset {p : Fin 4→ℤ // p∈T} :=
    fun s => T.attach.filter (fun p => sf p=s)
  let Zf : ℤ→Finset ℤ := fun s => (Tf s).image tf
  let Price : ℝ := 1+oldPriceZ k x M (D*E)
  have hPrice : 0≤Price := by dsimp [Price,oldPriceZ]; positivity
  have hfiber (s : ℤ) (hs : s∈S) : ((Tf s).card:ℝ)≤C*Price := by
    have hparam : ((Zf s).card:ℝ)≤C*Price := by
      apply hcount x D E M ρ hx hD hE hM hρ hρD hfloor
        a b m d₀ e₀ s q J hprim hm hq hJ hbez hJsize (Zf s)
      intro z hz
      obtain ⟨p,hp,rfl⟩ := Finset.mem_image.mp hz
      have hsP : sf p=s := (Finset.mem_filter.mp hp).2
      have hrepr : r p.val=s+J*tf p := by simpa only [hsP] using htf p
      obtain ⟨hd,he⟩ := hcoords p.val p.property
      obtain ⟨hpos,hnx,hdlo,hdhi,helo,hehi,hrlo,hrhi,hshift,hlevel,hu,hv⟩ :=
        hT p.val p.property
      have hdInt : p.val 0=m*d₀+b*s+(b*J)*tf p := by rw [hd,hrepr]; ring
      have heInt : p.val 1=m*e₀-a*s-(a*J)*tf p := by rw [he,hrepr]; ring
      have hdval : (parameterD b m d₀ s J).eval (tf p:ℝ)=(p.val 0:ℝ) := by
        simp only [parameterD,Polynomial.eval_add,Polynomial.eval_mul,
          Polynomial.eval_C,Polynomial.eval_X]
        exact_mod_cast hdInt.symm
      have heval : (parameterE a m e₀ s J).eval (tf p:ℝ)=(p.val 1:ℝ) := by
        simp only [parameterE,Polynomial.eval_sub,Polynomial.eval_mul,
          Polynomial.eval_C,Polynomial.eval_X]
        exact_mod_cast heInt.symm
      have hN : (parameterN k a b m d₀ e₀ s q J).eval (tf p:ℝ)=
          (((p.val 0)^k*p.val 2:ℤ):ℝ) := by
        let db : Polynomial ℝ := Polynomial.C (((m*d₀:ℤ):ℝ))+
          Polynomial.C (b:ℝ)*Polynomial.X
        let eb : Polynomial ℝ := Polynomial.C (((m*e₀:ℤ):ℝ))-
          Polynomial.C (a:ℝ)*Polynomial.X
        have hdbe : db.eval ((s:ℝ)+(J:ℝ)*(tf p:ℝ))=(p.val 0:ℝ) := by
          dsimp [db]
          simp only [Polynomial.eval_add,Polynomial.eval_mul,Polynomial.eval_C,Polynomial.eval_X]
          have hh := congrArg (fun z : ℤ => (z:ℝ)) hdInt
          push_cast at hh ⊢
          nlinarith only [hh]
        have hebe : eb.eval ((s:ℝ)+(J:ℝ)*(tf p:ℝ))=(p.val 1:ℝ) := by
          dsimp [eb]
          simp only [Polynomial.eval_sub,Polynomial.eval_mul,Polynomial.eval_C,Polynomial.eval_X]
          have hh := congrArg (fun z : ℤ => (z:ℝ)) heInt
          push_cast at hh ⊢
          nlinarith only [hh]
        have hnum := height_numerator k a (p.val 0) (p.val 1) m q (p.val 2)
          (tailR k (a*p.val 0) (b*p.val 1)) hu
        have hnumR := congrArg (fun z : ℤ => (z:ℝ)) hnum
        have htail := tailR_map (Int.castRingHom ℝ) k (a*p.val 0) (b*p.val 1)
        change ((tailR k (a*p.val 0) (b*p.val 1):ℤ):ℝ)=
          tailR k (((a*p.val 0:ℤ):ℝ)) (((b*p.val 1:ℤ):ℝ)) at htail
        push_cast at hnumR htail
        have hh : (m:ℝ)^(2*k-1)*(((p.val 0)^k*p.val 2:ℤ):ℝ)=
            (q:ℝ)*(db.eval ((s:ℝ)+(J:ℝ)*(tf p:ℝ))*
              eb.eval ((s:ℝ)+(J:ℝ)*(tf p:ℝ)))^k-
            pureHeight k ((a:ℝ)*db.eval ((s:ℝ)+(J:ℝ)*(tf p:ℝ)))
              ((b:ℝ)*eb.eval ((s:ℝ)+(J:ℝ)*(tf p:ℝ))) := by
          rw [hdbe,hebe]
          simp only [pureHeight]
          push_cast
          rw [←htail]
          exact hnumR
        exact normalizedHeight_progression_original_value k db eb
          (a:ℝ) (b:ℝ) (m:ℝ) (q:ℝ) (s:ℝ) (J:ℝ) (tf p:ℝ)
          (((p.val 0)^k*p.val 2:ℤ):ℝ) (by exact_mod_cast hm) hh
      have hnR : (p.val 0:ℝ)^k*(p.val 2:ℝ)≤x := by exact_mod_cast hnx
      have hu1 : (1:ℝ)≤(p.val 2:ℝ) := by exact_mod_cast (show 1≤p.val 2 by have := hpos 2; omega)
      have hv1 : (1:ℝ)≤(p.val 3:ℝ) := by exact_mod_cast (show 1≤p.val 3 by have := hpos 3; omega)
      have hd0 : 0≤(p.val 0:ℝ) := by exact_mod_cast (hpos 0).le
      have he0 : 0≤(p.val 1:ℝ) := by exact_mod_cast (hpos 1).le
      have hdx : (p.val 0:ℝ)^k≤x := by
        have hh := mul_le_mul_of_nonneg_left hu1 (pow_nonneg hd0 k)
        nlinarith only [hh,hnR]
      have hex : (p.val 1:ℝ)^k≤2*x := by
        have hh := mul_le_mul_of_nonneg_left hv1 (pow_nonneg he0 k)
        have hshiftR : (p.val 1:ℝ)^k*(p.val 3:ℝ)=
            (p.val 0:ℝ)^k*(p.val 2:ℝ)+1 := by exact_mod_cast hshift
        nlinarith only [hh,hshiftR,hnR,hx]
      have hn0 : (0:ℝ)≤(((p.val 0)^k*p.val 2:ℤ):ℝ) := by
        push_cast
        exact mul_nonneg (pow_nonneg hd0 k) (by exact_mod_cast (hpos 2).le)
      rw [hdval,heval,hN]
      exact ⟨hdlo,hdhi,helo,hehi,hdx,hex,hn0,hnx,hrlo,hrhi⟩
    have hinj : Set.InjOn tf ↑(Tf s) := by
      intro p hp p' hp' hsame
      have hs1 : sf p=s := (Finset.mem_filter.mp hp).2
      have hs2 : sf p'=s := (Finset.mem_filter.mp hp').2
      have hr : r p.val=r p'.val := by rw [htf p,htf p',hs1,hs2,hsame]
      obtain ⟨hd1,he1⟩ := hcoords p.val p.property
      obtain ⟨hd2,he2⟩ := hcoords p'.val p'.property
      have hd : p.val 0=p'.val 0 := by rw [hd1,hd2,hr]
      have he : p.val 1=p'.val 1 := by rw [he1,he2,hr]
      obtain ⟨hpos,hnx,hdlo,hdhi,helo,hehi,hrlo,hrhi,hshift,hlevel,hu,hv⟩ :=
        hT p.val p.property
      obtain ⟨hpos',hnx',hdlo',hdhi',helo',hehi',hrlo',hrhi',hshift',hlevel',hu',hv'⟩ :=
        hT p'.val p'.property
      have huEq : p.val 2=p'.val 2 := by
        apply mul_left_cancel₀ (pow_ne_zero (2*k-1) hm)
        rw [hu,hu',hd,he]
      have hvEq : p.val 3=p'.val 3 := by
        apply mul_left_cancel₀ (pow_ne_zero (2*k-1) hm)
        rw [hv,hv',hd,he]
      apply Subtype.ext
      funext i
      fin_cases i <;> assumption
    have himage : (Zf s).card=(Tf s).card := Finset.card_image_iff.mpr hinj
    rw [←himage]
    exact hparam
  have hcard : T.card=∑ s∈S,(Tf s).card := by
    have hh := Finset.card_eq_sum_card_fiberwise (f:=sf) (s:=T.attach) (t:=S)
      (by intro p hp; exact hsf p)
    simpa only [Finset.card_attach,Tf] using hh
  have hScR : (S.card:ℝ)≤(k:ℝ)^m.natAbs.primeFactors.card := by exact_mod_cast hSc
  calc
    (T.card:ℝ)=∑ s∈S,((Tf s).card:ℝ) := by exact_mod_cast hcard
    _≤∑ s∈S,C*Price := Finset.sum_le_sum hfiber
    _=(S.card:ℝ)*(C*Price) := by simp
    _≤(k:ℝ)^m.natAbs.primeFactors.card*(C*Price) :=
      mul_le_mul_of_nonneg_right hScR (mul_nonneg (by linarith) hPrice)
    _=C*(k:ℝ)^m.natAbs.primeFactors.card*Price := by ring

private theorem signed_points_count
    (k : ℕ) (hk : 1≤k) (cM H K ε : ℝ)
    (hcM : 0<cM) (hH : 0<H) (hK : 0≤K) (hε : 0<ε) :
    ∃ C : ℝ,0<C ∧ ∀ x D E M ρ : ℝ,
      2≤x → 0<D → 0<E → 0<M → 0≤ρ → ρ≤2*D/E →
      cM*x^((1:ℝ)/((2*k-1:ℕ):ℝ))≤M →
      ∀ a b c K₀ : ℤ,Int.gcd a b=1 → c≠0 → K₀≠0 →
      |(K₀:ℝ)|≤H*x^K →
      ∀ T : Finset (Fin 4→ℤ),
      (∀ p∈T,(∀ i,0<p i) ∧ (((p 0)^k*p 2:ℤ):ℝ)≤x ∧
        D/2<(p 0:ℝ) ∧ (p 0:ℝ)≤D ∧ E/2<(p 1:ℝ) ∧ (p 1:ℝ)≤E ∧
        ρ<(p 0:ℝ)/(p 1:ℝ) ∧ (p 0:ℝ)/(p 1:ℝ)≤ρ*(1+1/M) ∧
        (p 1)^k*p 3=(p 0)^k*p 2+1 ∧
        a*p 0+b*p 1≠0 ∧
        ∃ q : ℤ,c*(a*p 0+b*p 1)*q=K₀ ∧
          (a*p 0+b*p 1)^(2*k-1)*p 2=
            q*(p 1)^k-a^k*tailR k (a*p 0) (b*p 1) ∧
          (a*p 0+b*p 1)^(2*k-1)*p 3=
            q*(p 0)^k+b^k*tailR k (b*p 1) (a*p 0)) →
      (T.card:ℝ)≤C*x^ε*(1+oldPriceZ k x M (D*E)) := by
  classical
  obtain ⟨CL,hCL,hlevel⟩ := fixed_level_count k hk cM hcM
  obtain ⟨CB,hCB,hbudget⟩ := uniform_signed_level_fee k hk H K ε hH hK hε
  refine ⟨CL*CB,mul_pos (by linarith) hCB,?_⟩
  intro x D E M ρ hx hD hE hM hρ hρD hfloor a b c K₀ hprim hc hK₀ hheight T hT
  have hbudgetK := hbudget x hx K₀ hK₀ hheight
  let mp : (Fin 4→ℤ)→ℤ := fun p => a*p 0+b*p 1
  have hpoints (p : Fin 4→ℤ) (hp : p∈T) :
      mp p≠0 ∧ ∃ q : ℤ,K₀=c*mp p*q ∧
        (mp p)^(2*k-1)*p 2=q*(p 1)^k-a^k*tailR k (a*p 0) (b*p 1) ∧
        (mp p)^(2*k-1)*p 3=q*(p 0)^k+b^k*tailR k (b*p 1) (a*p 0) := by
    obtain ⟨hpos,hnx,hdlo,hdhi,helo,hehi,hrlo,hrhi,hshift,hm,q,hq,hu,hv⟩ := hT p hp
    exact ⟨hm,q,hq.symm,hu,hv⟩
  let I : Finset ℕ := K₀.natAbs.divisors
  let Labels : Finset (Fin 2×ℕ) := Finset.univ.product I
  let label : (Fin 4→ℤ)→Fin 2×ℕ := fun p =>
    (if 0 ≤ mp p then (0:Fin 2) else 1,(mp p).natAbs)
  let signed : (Fin 2×ℕ)→ℤ := fun s => if s.1=0 then (s.2:ℤ) else -(s.2:ℤ)
  have reconstruct (p : Fin 4→ℤ) : signed (label p)=mp p := by
    by_cases hp : 0 ≤ mp p
    · simp only [signed,label,if_pos hp,if_pos rfl,
        Int.natCast_natAbs,abs_of_nonneg hp]
    · have hfin : (1:Fin 2)≠0 := by decide
      simp only [signed,label,if_neg hp,if_neg hfin,
        Int.natCast_natAbs,abs_of_neg (lt_of_not_ge hp),neg_neg]
  have hlabels (p : Fin 4→ℤ) (hp : p∈T) : label p∈Labels := by
    obtain ⟨hm,q,hkq,hu,hv⟩ := hpoints p hp
    have hmd : mp p∣K₀ := by
      refine ⟨c*q,?_⟩
      rw [hkq]
      ring
    have hn : (mp p).natAbs∈K₀.natAbs.divisors :=
      Nat.mem_divisors.mpr ⟨Int.natAbs_dvd_natAbs.mpr hmd,Int.natAbs_ne_zero.mpr hK₀⟩
    exact Finset.mem_product.mpr ⟨Finset.mem_univ _,hn⟩
  let Tf : (Fin 2×ℕ)→Finset (Fin 4→ℤ) := fun s => T.filter (fun p => label p=s)
  let Price : ℝ := 1+oldPriceZ k x M (D*E)
  have hPrice : 0≤Price := by dsimp [Price,oldPriceZ]; positivity
  have hfiber (s : Fin 2×ℕ) (hs : s∈Labels) :
      ((Tf s).card:ℝ)≤CL*(k:ℝ)^s.2.primeFactors.card*Price := by
    by_cases hempty : Tf s=∅
    · rw [hempty,Finset.card_empty,Nat.cast_zero]; positivity
    obtain ⟨p₀,hp₀⟩ := Finset.nonempty_iff_ne_empty.mpr hempty
    have hp₀T : p₀∈T := (Finset.mem_filter.mp hp₀).1
    have hl₀ : label p₀=s := (Finset.mem_filter.mp hp₀).2
    obtain ⟨hm₀,q₀,hk₀,hu₀,hv₀⟩ := hpoints p₀ hp₀T
    have hq₀ : q₀≠0 := by
      intro hz
      apply hK₀
      simpa only [hz,mul_zero] using hk₀
    have habs : (mp p₀).natAbs=s.2 := congrArg Prod.snd hl₀
    have hfixed := hlevel x D E M ρ hx hD hE hM hρ hρD hfloor
      a b (mp p₀) q₀ hprim hm₀ hq₀ (Tf s) (by
        intro p hp
        have hpT : p∈T := (Finset.mem_filter.mp hp).1
        have hl : label p=s := (Finset.mem_filter.mp hp).2
        have hmp : mp p=mp p₀ := by
          rw [←reconstruct p,←reconstruct p₀,hl,hl₀]
        obtain ⟨hm,q,hkq,hu,hv⟩ := hpoints p hpT
        have hqq : q=q₀ := by
          apply mul_left_cancel₀ (mul_ne_zero hc hm₀)
          simpa only [hmp] using hkq.symm.trans hk₀
        rw [hmp,hqq] at hu hv
        obtain ⟨hpos,hnx,hdlo,hdhi,helo,hehi,hrlo,hrhi,hshift,hrest⟩ := hT p hpT
        exact ⟨hpos,hnx,hdlo,hdhi,helo,hehi,hrlo,hrhi,hshift,hmp,hu,hv⟩)
    simpa only [habs] using hfixed
  have hcard : T.card=∑ s∈Labels,(Tf s).card :=
    Finset.card_eq_sum_card_fiberwise (f:=label) (s:=T) (t:=Labels) hlabels
  have hweights : (∑ s∈Labels,(k:ℝ)^s.2.primeFactors.card)=
      2*(∑ n∈I,(k:ℝ)^n.primeFactors.card) := by
    simp [Labels,Finset.sum_product]
  have hsum : (∑ s∈Labels,CL*(k:ℝ)^s.2.primeFactors.card*Price)=
      CL*(2*(∑ n∈I,(k:ℝ)^n.primeFactors.card))*Price := by
    rw [←Finset.sum_mul,←Finset.mul_sum,hweights]
  calc
    (T.card:ℝ)=∑ s∈Labels,((Tf s).card:ℝ) := by exact_mod_cast hcard
    _≤∑ s∈Labels,CL*(k:ℝ)^s.2.primeFactors.card*Price := Finset.sum_le_sum hfiber
    _=CL*(2*(∑ n∈I,(k:ℝ)^n.primeFactors.card))*Price := hsum
    _≤CL*(CB*x^ε)*Price :=
      mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left hbudgetK (by linarith)) hPrice
    _=(CL*CB)*x^ε*Price := by ring

private theorem integral_pure_graph_count
    (k : ℕ) (hk : 1≤k) (cM K ε : ℝ)
    (hcM : 0<cM) (hK : 0≤K) (hε : 0<ε) :
    ∃ C : ℝ,0<C ∧ ∀ x D E M ρ : ℝ,
      2≤x → 0<D → 0<E → 0<M → 0≤ρ → ρ≤2*D/E →
      cM*x^((1:ℝ)/((2*k-1:ℕ):ℝ))≤M →
      ∀ A B : MvPolynomial (Fin 2) ℤ,
      A.IsHomogeneous k → B.IsHomogeneous k →
      (∀ z,|((A.coeff z:ℤ):ℝ)|≤x^K) →
      (∀ z,|((B.coeff z:ℤ):ℝ)|≤x^K) →
      (∀ d e : ℤ,d≠0 ∨ e≠0 →
        MvPolynomial.eval ![d,e] A=0 → MvPolynomial.eval ![d,e] B=0 → False) →
      ∀ a b c : ℤ,Int.gcd a b=1 → c≠0 →
      MvPolynomial.X (1:Fin 2)^k*A-MvPolynomial.X (0:Fin 2)^k*B=
        MvPolynomial.C c*
          (MvPolynomial.C a*MvPolynomial.X 0+MvPolynomial.C b*MvPolynomial.X 1)^(2*k) →
      ∀ T : Finset (Fin 4→ℤ),
      (∀ p∈T,(∀ i,0<p i) ∧ (((p 0)^k*p 2:ℤ):ℝ)≤x ∧
        D/2<(p 0:ℝ) ∧ (p 0:ℝ)≤D ∧ E/2<(p 1:ℝ) ∧ (p 1:ℝ)≤E ∧
        ρ<(p 0:ℝ)/(p 1:ℝ) ∧ (p 0:ℝ)/(p 1:ℝ)≤ρ*(1+1/M) ∧
        (p 1)^k*p 3=(p 0)^k*p 2+1 ∧
        MvPolynomial.eval ![p 0,p 1] A*p 2=
          MvPolynomial.eval ![p 0,p 1] B*p 3) →
      (T.card:ℝ)≤C*x^ε*(1+oldPriceZ k x M (D*E)) := by
  classical
  let H : ℝ := 1+((2*k-1).choose k:ℝ)
  have hH : 0<H := by dsimp [H]; positivity
  obtain ⟨C,hC,hcount⟩ := signed_points_count k hk cM H K ε hcM hH hK hε
  refine ⟨C,hC,?_⟩
  intro x D E M ρ hx hD hE hM hρ hρD hfloor A B hA hB hAc hBc hno a b c hprim hc hres T hT
  obtain ⟨K₀,hAF,hBF⟩ := integral_even_pure_normal_form k hk A B hA hB a b c hres
  have hab : a≠0 ∨ b≠0 := by
    by_contra hh
    push Not at hh
    rcases hh with ⟨ha,hb⟩
    simp [ha,hb] at hprim
  have hK₀ : K₀≠0 := normal_form_K0_nonzero k A B a b c K₀ hab hno hAF hBF
  have hheight : |(K₀:ℝ)|≤H*x^K :=
    normal_form_K0_height k hk A B hA hB a b c K₀ (x^K) hAc hBc hres hBF
  apply hcount x D E M ρ hx hD hE hM hρ hρD hfloor
    a b c K₀ hprim hc hK₀ hheight T
  intro p hp
  obtain ⟨hpos,hnx,hdlo,hdhi,helo,hehi,hrlo,hrhi,hshift,hgraph⟩ := hT p hp
  let m : ℤ := a*p 0+b*p 1
  let A₀ : ℤ := MvPolynomial.eval ![p 0,p 1] A
  let B₀ : ℤ := MvPolynomial.eval ![p 0,p 1] B
  have hAFv : A₀=K₀*(p 0)^k+c*m*b^k*tailR k (b*p 1) (a*p 0) := by
    have hh := congrArg (MvPolynomial.eval ![p 0,p 1]) hAF
    have ht := tailR_map (MvPolynomial.eval ![p 0,p 1]) k
      (MvPolynomial.C b*MvPolynomial.X 1) (MvPolynomial.C a*MvPolynomial.X 0)
    simp only [map_mul,MvPolynomial.eval_C,MvPolynomial.eval_X,
      Matrix.cons_val_zero,Matrix.cons_val_one] at ht
    simpa only [A₀,m,map_add,map_mul,map_pow,MvPolynomial.eval_C,MvPolynomial.eval_X,
      Matrix.cons_val_zero,Matrix.cons_val_one,ht] using hh
  have hBFv : B₀=K₀*(p 1)^k-c*m*a^k*tailR k (a*p 0) (b*p 1) := by
    have hh := congrArg (MvPolynomial.eval ![p 0,p 1]) hBF
    have ht := tailR_map (MvPolynomial.eval ![p 0,p 1]) k
      (MvPolynomial.C a*MvPolynomial.X 0) (MvPolynomial.C b*MvPolynomial.X 1)
    simp only [map_mul,MvPolynomial.eval_C,MvPolynomial.eval_X,
      Matrix.cons_val_zero,Matrix.cons_val_one] at ht
    simpa only [B₀,m,map_sub,map_add,map_mul,map_pow,MvPolynomial.eval_C,MvPolynomial.eval_X,
      Matrix.cons_val_zero,Matrix.cons_val_one,ht] using hh
  have hRv : (p 1)^k*A₀-(p 0)^k*B₀=c*m^(2*k) := by
    have hh := congrArg (MvPolynomial.eval ![p 0,p 1]) hres
    simpa only [A₀,B₀,m,map_sub,map_mul,map_add,map_pow,MvPolynomial.eval_C,
      MvPolynomial.eval_X,Matrix.cons_val_zero,Matrix.cons_val_one] using hh
  have hshift' : (p 1)^k*p 3-(p 0)^k*p 2=1 := by linear_combination hshift
  obtain ⟨hm,q,hq,hqK,hu,hv⟩ := signed_level_inverse k hk A₀ B₀ a b c K₀ m
    (p 0) (p 1) (p 2) (p 3) (tailR k (a*p 0) (b*p 1))
    (tailR k (b*p 1) (a*p 0)) hc hK₀ hAFv hBFv hgraph hshift' hRv
  exact ⟨hpos,hnx,hdlo,hdhi,helo,hehi,hrlo,hrhi,hshift,hm,q,hqK,hu,hv⟩
private theorem rational_pure_descent_nonaxis
    (n : ℕ) (hn : 1 ≤ n) (p : Polynomial ℚ)
    (γ a b : ℂ) (hγ : γ ≠ 0) (ha : a ≠ 0)
    (hp : p.map (Rat.castHom ℂ) =
      Polynomial.C γ * (Polynomial.C a * Polynomial.X + Polynomial.C b) ^ n) :
    ∃ κ β : ℚ, κ ≠ 0 ∧
      p = Polynomial.C κ * (Polynomial.X + Polynomial.C β) ^ n := by
  have hfac : (Polynomial.C a * Polynomial.X + Polynomial.C b : Polynomial ℂ) =
      Polynomial.C a * (Polynomial.X + Polynomial.C (b / a)) := by
    rw [mul_add, ← Polynomial.C_mul, mul_div_cancel₀ b ha]
  have hn0 : (n : ℂ) ≠ 0 := by exact_mod_cast (by omega : n ≠ 0)
  have htop : (p.coeff n : ℂ) = γ * a ^ n := by
    have h := congrArg (fun f : Polynomial ℂ => f.coeff n) hp
    rw [Polynomial.coeff_map, hfac, mul_pow, ← Polynomial.C_pow,
      ← mul_assoc, ← Polynomial.C_mul,
      Polynomial.coeff_C_mul, Polynomial.coeff_X_add_C_pow] at h
    simpa using h
  have hchoose : n.choose (n - 1) = n := by
    have h := Nat.choose_symm (show n - 1 ≤ n by omega)
    have he : n - (n - 1) = 1 := by omega
    rw [he] at h
    simpa using h.symm
  have hnext : (p.coeff (n - 1) : ℂ) = γ * a ^ n * (b / a) * (n : ℂ) := by
    have h := congrArg (fun f : Polynomial ℂ => f.coeff (n - 1)) hp
    rw [Polynomial.coeff_map, hfac, mul_pow, ← Polynomial.C_pow,
      ← mul_assoc, ← Polynomial.C_mul,
      Polynomial.coeff_C_mul, Polynomial.coeff_X_add_C_pow] at h
    have he : n - (n - 1) = 1 := by omega
    rw [he, pow_one, hchoose] at h
    simpa [mul_assoc] using h
  let κ : ℚ := p.coeff n
  let β : ℚ := p.coeff (n - 1) / ((n : ℚ) * p.coeff n)
  have hκ : κ ≠ 0 := by
    intro hz
    have hzC : (p.coeff n : ℂ) = 0 := by exact_mod_cast hz
    rw [htop] at hzC
    exact (mul_ne_zero hγ (pow_ne_zero n ha)) hzC
  have hβ : (β : ℂ) = b / a := by
    dsimp [β]
    push_cast
    rw [htop, hnext]
    field_simp [hγ, ha, hn0]
  refine ⟨κ, β, hκ, ?_⟩
  have hmaps :
      p.map (Rat.castHom ℂ) =
      (Polynomial.C κ * (Polynomial.X + Polynomial.C β) ^ n).map
        (Rat.castHom ℂ) := by
    rw [hp, hfac, mul_pow, ← Polynomial.C_pow, ← mul_assoc, ← Polynomial.C_mul]
    simp only [Polynomial.map_mul, Polynomial.map_pow, Polynomial.map_add,
      Polynomial.map_C, Polynomial.map_X]
    change Polynomial.C (γ * a ^ n) * (Polynomial.X + Polynomial.C (b / a)) ^ n =
      Polynomial.C (κ : ℂ) * (Polynomial.X + Polynomial.C (β : ℂ)) ^ n
    rw [hβ]
    have hκC : (κ : ℂ) = γ * a ^ n := htop
    rw [hκC]
  apply Polynomial.ext
  intro i
  have h := congrArg (fun f : Polynomial ℂ => f.coeff i) hmaps
  simp only [Polynomial.coeff_map] at h
  exact (Rat.castHom ℂ).injective h

private theorem binary_dehom_map {R S : Type*} [CommRing R] [CommRing S]
    (f : R →+* S) (H : MvPolynomial (Fin 2) R) :
    C01.PcCurves.dehom (MvPolynomial.map f H) =
      (C01.PcCurves.dehom H).map f := by
  let l : MvPolynomial (Fin 2) R →+* Polynomial S :=
    (MvPolynomial.eval₂Hom Polynomial.C ![Polynomial.X, 1]).comp (MvPolynomial.map f)
  let r : MvPolynomial (Fin 2) R →+* Polynomial S :=
    (Polynomial.mapRingHom f).comp
      (MvPolynomial.eval₂Hom Polynomial.C ![Polynomial.X, 1])
  have hlr : l = r := by
    apply MvPolynomial.ringHom_ext
    · intro a
      simp [l, r]
    · intro i
      fin_cases i <;> simp [l, r]
  change l H = r H
  exact RingHom.congr_fun hlr H

private theorem binary_normalized_pure_of_dehom
    (n : ℕ) (H : MvPolynomial (Fin 2) ℚ) (hH : H.IsHomogeneous n)
    (κ β : ℚ)
    (hd : C01.PcCurves.dehom H =
      Polynomial.C κ * (Polynomial.X + Polynomial.C β) ^ n) :
    H = MvPolynomial.C κ *
      (MvPolynomial.X (0 : Fin 2) + MvPolynomial.C β * MvPolynomial.X 1) ^ n := by
  let L : MvPolynomial (Fin 2) ℚ :=
    MvPolynomial.X 0 + MvPolynomial.C β * MvPolynomial.X 1
  have hL : L.IsHomogeneous 1 := by
    have hsecond : (MvPolynomial.C β * MvPolynomial.X (1 : Fin 2)).IsHomogeneous 1 := by
      simpa only [zero_add] using
        ((MvPolynomial.isHomogeneous_C (Fin 2) β).mul
          (MvPolynomial.isHomogeneous_X ℚ (1 : Fin 2)))
    exact (MvPolynomial.isHomogeneous_X ℚ (0 : Fin 2)).add hsecond
  have hB : (MvPolynomial.C κ * L ^ n).IsHomogeneous n := by
    simpa using (MvPolynomial.isHomogeneous_C (Fin 2) κ).mul (hL.pow n)
  have he : C01.PcCurves.dehom (H - MvPolynomial.C κ * L ^ n) = 0 := by
    simp only [C01.PcCurves.dehom_sub]
    have hright : C01.PcCurves.dehom (MvPolynomial.C κ * L ^ n) =
        Polynomial.C κ * (Polynomial.X + Polynomial.C β) ^ n := by
      simp [L, C01.PcCurves.dehom, map_mul, map_pow, map_add,
        MvPolynomial.aeval_X,  Polynomial.algebraMap_eq]
    rw [hd, hright, sub_self]
  exact sub_eq_zero.mp (C01.PcCurves.eq_zero_of_dehom (hH.sub hB) he)

private theorem binary_eval_map_nat (A : MvPolynomial (Fin 2) ℤ) (a b : ℕ) :
    MvPolynomial.eval ![(a : ℚ), (b : ℚ)] (MvPolynomial.map (Int.castRingHom ℚ) A) =
      ((MvPolynomial.eval ![(a : ℤ), (b : ℤ)] A : ℤ) : ℚ) := by
  rw [MvPolynomial.eval_map]
  induction A using MvPolynomial.induction_on
  next c =>
    rw [MvPolynomial.eval₂_C, MvPolynomial.eval_C]
    rfl
  next p q hp hq => rw [MvPolynomial.eval₂_add, map_add, Int.cast_add, hp, hq]
  next p i hp =>
    rw [MvPolynomial.eval₂_mul, map_mul, Int.cast_mul, hp, MvPolynomial.eval₂_X,
      MvPolynomial.eval_X]
    fin_cases i <;> simp

private theorem primitive_integral_pure (R : MvPolynomial (Fin 2) ℤ) (n : ℕ) (κ a b : ℚ) (hκ : κ ≠ 0)
    (hab : a ≠ 0 ∨ b ≠ 0)
    (hR : MvPolynomial.map (Int.castRingHom ℚ) R = MvPolynomial.C κ *
      (MvPolynomial.C a * MvPolynomial.X 0 + MvPolynomial.C b * MvPolynomial.X 1) ^ n) :
    ∃ a' b' c' : ℤ, Int.gcd a' b' = 1 ∧ c' ≠ 0 ∧
      R = MvPolynomial.C c' * (MvPolynomial.C a' * MvPolynomial.X 0 +
        MvPolynomial.C b' * MvPolynomial.X 1) ^ n := by
  have hq : ∀ q : ℚ, (q.num : ℚ) = q * q.den := by
    intro q
    first
    | exact (Rat.mul_den_eq_num q).symm
  have haden : (0 : ℚ) < (a.den : ℚ) := by positivity
  have hbden : (0 : ℚ) < (b.den : ℚ) := by positivity
  have hden0 : (0 : ℚ) < (a.den : ℚ) * (b.den : ℚ) := mul_pos haden hbden
  obtain ⟨a1, ha1⟩ : ∃ a1 : ℤ, a1 = a.num * b.den := ⟨_, rfl⟩
  obtain ⟨b1, hb1⟩ : ∃ b1 : ℤ, b1 = b.num * a.den := ⟨_, rfl⟩
  have ha1q : (a1 : ℚ) = a * ((a.den : ℚ) * (b.den : ℚ)) := by
    rw [ha1]
    push_cast
    rw [hq a]
    ring
  have hb1q : (b1 : ℚ) = b * ((a.den : ℚ) * (b.den : ℚ)) := by
    rw [hb1]
    push_cast
    rw [hq b]
    ring
  have hab1 : a1 ≠ 0 ∨ b1 ≠ 0 := by
    rcases hab with h | h
    · left
      intro h0
      have h2 : (a1 : ℚ) = 0 := by rw [h0]; simp
      rw [ha1q] at h2
      exact h ((mul_eq_zero.mp h2).resolve_right hden0.ne')
    · right
      intro h0
      have h2 : (b1 : ℚ) = 0 := by rw [h0]; simp
      rw [hb1q] at h2
      exact h ((mul_eq_zero.mp h2).resolve_right hden0.ne')
  have hg : 0 < Int.gcd a1 b1 := Int.gcd_pos_iff.mpr hab1
  obtain ⟨a', ha'⟩ : ∃ a' : ℤ, a' = a1 / (Int.gcd a1 b1 : ℤ) := ⟨_, rfl⟩
  obtain ⟨b', hb'⟩ : ∃ b' : ℤ, b' = b1 / (Int.gcd a1 b1 : ℤ) := ⟨_, rfl⟩
  have hcop : Int.gcd a' b' = 1 := by
    rw [ha', hb']
    exact Int.gcd_div_gcd_div_gcd hg
  have ha1g : a' * (Int.gcd a1 b1 : ℤ) = a1 := by
    rw [ha']
    exact Int.ediv_mul_cancel (Int.gcd_dvd_left ..)
  have hb1g : b' * (Int.gcd a1 b1 : ℤ) = b1 := by
    rw [hb']
    exact Int.ediv_mul_cancel (Int.gcd_dvd_right ..)
  have hgq : (0 : ℚ) < ((Int.gcd a1 b1 : ℕ) : ℚ) := by exact_mod_cast hg
  obtain ⟨lam, hlam⟩ : ∃ lam : ℚ, lam = ((Int.gcd a1 b1 : ℕ) : ℚ) / ((a.den : ℚ) * (b.den : ℚ)) :=
    ⟨_, rfl⟩
  have hlam0 : lam ≠ 0 := by
    rw [hlam]
    exact div_ne_zero hgq.ne' hden0.ne'
  have haq : a = (a' : ℚ) * lam := by
    have h1 : ((a' * (Int.gcd a1 b1 : ℤ) : ℤ) : ℚ) = (a1 : ℚ) := by rw [ha1g]
    push_cast at h1
    rw [ha1q] at h1
    rw [hlam]
    field_simp
    linarith
  have hbq : b = (b' : ℚ) * lam := by
    have h1 : ((b' * (Int.gcd a1 b1 : ℤ) : ℤ) : ℚ) = (b1 : ℚ) := by rw [hb1g]
    push_cast at h1
    rw [hb1q] at h1
    rw [hlam]
    field_simp
    linarith
  have hL : (MvPolynomial.C a * MvPolynomial.X 0 + MvPolynomial.C b * MvPolynomial.X 1 :
      MvPolynomial (Fin 2) ℚ) = MvPolynomial.C lam * (MvPolynomial.C (a' : ℚ) * MvPolynomial.X 0 +
        MvPolynomial.C (b' : ℚ) * MvPolynomial.X 1) := by
    rw [haq, hbq, MvPolynomial.C_mul, MvPolynomial.C_mul]
    ring
  have hR2 : MvPolynomial.map (Int.castRingHom ℚ) R = MvPolynomial.C (κ * lam ^ n) *
      (MvPolynomial.C (a' : ℚ) * MvPolynomial.X 0 + MvPolynomial.C (b' : ℚ) * MvPolynomial.X 1) ^ n := by
    rw [hR, hL, mul_pow, ← MvPolynomial.C_pow, MvPolynomial.C_mul]
    ring
  have hcp : IsCoprime (a' ^ n) (b' ^ n) := by
    have h0 : IsCoprime a' b' := Int.isCoprime_iff_gcd_eq_one.mpr hcop
    exact h0.pow
  obtain ⟨s, t, hst⟩ := hcp
  have hE10 := congrArg (MvPolynomial.eval ![((1 : ℕ) : ℚ), ((0 : ℕ) : ℚ)]) hR2
  have hE01 := congrArg (MvPolynomial.eval ![((0 : ℕ) : ℚ), ((1 : ℕ) : ℚ)]) hR2
  rw [binary_eval_map_nat R 1 0] at hE10
  rw [binary_eval_map_nat R 0 1] at hE01
  simp only [map_mul, map_pow, map_add, MvPolynomial.eval_C, MvPolynomial.eval_X,
    Matrix.cons_val_zero, Matrix.cons_val_one,  Nat.cast_one, Nat.cast_zero,
    mul_one, mul_zero, add_zero, zero_add] at hE10 hE01
  obtain ⟨c', hc'⟩ : ∃ c' : ℤ, c' = s * MvPolynomial.eval ![(1 : ℤ), 0] R +
      t * MvPolynomial.eval ![(0 : ℤ), 1] R := ⟨_, rfl⟩
  have hc'q : (c' : ℚ) = κ * lam ^ n := by
    have hstq : (s : ℚ) * (a' : ℚ) ^ n + (t : ℚ) * (b' : ℚ) ^ n = 1 := by exact_mod_cast hst
    rw [hc']
    push_cast
    rw [hE10, hE01]
    linear_combination (κ * lam ^ n) * hstq
  have hc'0 : c' ≠ 0 := by
    intro h0
    have h2 : (c' : ℚ) = 0 := by rw [h0]; simp
    rw [hc'q] at h2
    exact (mul_ne_zero hκ (pow_ne_zero n hlam0)) h2
  refine ⟨a', b', c', hcop, hc'0, ?_⟩
  apply MvPolynomial.map_injective (Int.castRingHom ℚ) Int.cast_injective
  rw [hR2]
  have e1 : MvPolynomial.map (Int.castRingHom ℚ) (MvPolynomial.C c' * (MvPolynomial.C a' *
      MvPolynomial.X 0 + MvPolynomial.C b' * MvPolynomial.X 1) ^ n : MvPolynomial (Fin 2) ℤ) =
      MvPolynomial.C (c' : ℚ) * (MvPolynomial.C (a' : ℚ) * MvPolynomial.X 0 +
        MvPolynomial.C (b' : ℚ) * MvPolynomial.X 1) ^ n := by
    simp only [map_mul, map_pow, map_add, MvPolynomial.map_C, MvPolynomial.map_X]
    try rfl
  rw [e1, hc'q]

private theorem complex_pure_integral
    (n : ℕ) (hn : 1≤n) (R : MvPolynomial (Fin 2) ℤ)
    (hR : R.IsHomogeneous n)
    (γ a b : ℂ) (hγ : γ≠0) (hab : a≠0 ∨ b≠0)
    (hp : MvPolynomial.map (Int.castRingHom ℂ) R=
      MvPolynomial.C γ*(MvPolynomial.C a*MvPolynomial.X 0+
        MvPolynomial.C b*MvPolynomial.X 1)^n) :
    ∃ a' b' c' : ℤ,Int.gcd a' b'=1 ∧ c'≠0 ∧
      R=MvPolynomial.C c'*(MvPolynomial.C a'*MvPolynomial.X 0+
        MvPolynomial.C b'*MvPolynomial.X 1)^n := by
  classical
  have hcastInt (z : ℤ) : (Int.castRingHom ℂ) z=(z:ℂ) := by
    solve | simp
  by_cases ha : a=0
  · have hb : b≠0 := by
      rcases hab with ha' | hb
      · exact False.elim (ha' ha)
      · exact hb
    let c : ℤ := MvPolynomial.eval ![0,1] R
    have hcC : (c:ℂ)=γ*b^n := by
      have hh := congrArg (MvPolynomial.eval ![(0:ℂ),1]) hp
      have hcast : MvPolynomial.eval ![(0:ℂ),1]
          (MvPolynomial.map (Int.castRingHom ℂ) R)=(c:ℂ) := by
        simpa only [hcastInt,Int.cast_zero,Int.cast_one,c] using
          binary_eval_cast (Int.castRingHom ℂ) R 0 1
      rw [hcast] at hh
      simpa only [c,map_mul,map_pow,map_add,MvPolynomial.eval_C,MvPolynomial.eval_X,
        Matrix.cons_val_zero,Matrix.cons_val_one,mul_zero,mul_one,zero_add] using hh
    have hc : c≠0 := by
      intro hz
      have hh : (c:ℂ)=0 := by rw [hz]; simp
      rw [hcC] at hh
      exact mul_ne_zero hγ (pow_ne_zero n hb) hh
    refine ⟨0,1,c,by simp,hc,?_⟩
    apply MvPolynomial.map_injective (Int.castRingHom ℂ) Int.cast_injective
    rw [hp]
    simp only [MvPolynomial.map_C,MvPolynomial.map_X,map_mul,map_pow,
      ha,map_zero,map_one,zero_mul,one_mul,zero_add,hcastInt]
    rw [mul_pow,←MvPolynomial.C_pow,←mul_assoc,←MvPolynomial.C_mul,←hcC]
  · let f : Polynomial ℚ := (C01.PcCurves.dehom R).map (Int.castRingHom ℚ)
    have hcomp : (Rat.castHom ℂ).comp (Int.castRingHom ℚ)=Int.castRingHom ℂ := by
      ext z
      simp
    have hf : f.map (Rat.castHom ℂ)=
        Polynomial.C γ*(Polynomial.C a*Polynomial.X+Polynomial.C b)^n := by
      dsimp [f]
      rw [Polynomial.map_map,hcomp,←binary_dehom_map (Int.castRingHom ℂ) R]
      have hh := congrArg C01.PcCurves.dehom hp
      simpa [C01.PcCurves.dehom,map_mul,map_pow,map_add,
        MvPolynomial.aeval_X,MvPolynomial.aeval_C,Polynomial.algebraMap_eq] using hh
    obtain ⟨κ,β,hκ,hf⟩ := rational_pure_descent_nonaxis n hn f γ a b hγ ha hf
    have hd : C01.PcCurves.dehom (MvPolynomial.map (Int.castRingHom ℚ) R)=
        Polynomial.C κ*(Polynomial.X+Polynomial.C β)^n := by
      rw [binary_dehom_map]
      exact hf
    have hRQ := binary_normalized_pure_of_dehom n
      (MvPolynomial.map (Int.castRingHom ℚ) R) (hR.map _) κ β hd
    apply primitive_integral_pure R n κ 1 β hκ (Or.inl one_ne_zero)
    simpa only [map_one,one_mul] using hRQ

private theorem complex_pure_graph_count
    (k : ℕ) (hk : 1≤k) (cM K ε : ℝ)
    (hcM : 0<cM) (hK : 0≤K) (hε : 0<ε) :
    ∃ C : ℝ,0<C ∧ ∀ x D E M ρ : ℝ,
      2≤x → 0<D → 0<E → 0<M → 0≤ρ → ρ≤2*D/E →
      cM*x^((1:ℝ)/((2*k-1:ℕ):ℝ))≤M →
      ∀ G : MvPolynomial (Fin 4) ℤ,
      (∀ z∈G.support,z 0+z 1=k ∧ z 2+z 3=1) →
      Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G) →
      (∀ z,|((G.coeff z:ℤ):ℝ)|≤x^K) →
      (∃ γ a b : ℂ,γ≠0 ∧ (a≠0 ∨ b≠0) ∧
        MvPolynomial.map (Int.castRingHom ℂ)
          (MvPolynomial.X (1:Fin 2)^k*C01.PcParam.PP G-
            MvPolynomial.X (0:Fin 2)^k*(-C01.PcParam.QQ G))=
          MvPolynomial.C γ*
            (MvPolynomial.C a*MvPolynomial.X 0+MvPolynomial.C b*MvPolynomial.X 1)^(2*k)) →
      ∀ T : Finset (Fin 4→ℤ),
      (∀ p∈T,(∀ i,0<p i) ∧ (((p 0)^k*p 2:ℤ):ℝ)≤x ∧
        D/2<(p 0:ℝ) ∧ (p 0:ℝ)≤D ∧ E/2<(p 1:ℝ) ∧ (p 1:ℝ)≤E ∧
        ρ<(p 0:ℝ)/(p 1:ℝ) ∧ (p 0:ℝ)/(p 1:ℝ)≤ρ*(1+1/M) ∧
        (p 1)^k*p 3=(p 0)^k*p 2+1 ∧ MvPolynomial.eval ![p 0,p 1,p 2,p 3] G=0) →
      (T.card:ℝ)≤C*x^ε*(1+oldPriceZ k x M (D*E)) := by
  obtain ⟨C,hC,hcount⟩ := integral_pure_graph_count k hk cM K ε hcM hK hε
  refine ⟨C,hC,?_⟩
  intro x D E M ρ hx hD hE hM hρ hρD hfloor G hG hi hGc hpure T hT
  let A := C01.PcParam.PP G
  let B := -C01.PcParam.QQ G
  have hA : A.IsHomogeneous k := C01.PcParam.PP_hom G k hG
  have hB : B.IsHomogeneous k := (C01.PcParam.QQ_hom G k hG).neg
  have hAc : ∀ z,|((A.coeff z:ℤ):ℝ)|≤x^K :=
    C01.PcParam.PP_coeff G k hG (x^K) (by positivity) hGc
  have hBc : ∀ z,|((B.coeff z:ℤ):ℝ)|≤x^K := by
    intro z
    simpa only [B,MvPolynomial.coeff_neg,Int.cast_neg,abs_neg] using
      C01.PcParam.QQ_coeff G k hG (x^K) (by positivity) hGc z
  let R : MvPolynomial (Fin 2) ℤ :=
    MvPolynomial.X (1:Fin 2)^k*A-MvPolynomial.X (0:Fin 2)^k*B
  have hR : R.IsHomogeneous (2*k) := by
    have hh := (((MvPolynomial.isHomogeneous_X ℤ (1:Fin 2)).pow k).mul hA).sub
      (((MvPolynomial.isHomogeneous_X ℤ (0:Fin 2)).pow k).mul hB)
    simpa only [R,one_mul,mul_one,two_mul] using hh
  obtain ⟨γ,a,b,hγ,hab,hp⟩ := hpure
  obtain ⟨a',b',c',hprim,hc',hres⟩ :=
    complex_pure_integral (2*k) (by omega) R hR γ a b hγ hab hp
  apply hcount x D E M ρ hx hD hE hM hρ hρD hfloor A B hA hB hAc hBc
    (canonical_no_common_integer G k hG hi) a' b' c' hprim hc' hres T
  intro p hpT
  obtain ⟨hpos,hnx,hdlo,hdhi,helo,hehi,hrlo,hrhi,hshift,hz⟩ := hT p hpT
  exact ⟨hpos,hnx,hdlo,hdhi,helo,hehi,hrlo,hrhi,hshift,
    graph_values_integer G k hG (p 0) (p 1) (p 2) (p 3) hz⟩

private def originalIntegerCell
    (k : ℕ) (x D E M ρ : ℝ) (G : MvPolynomial (Fin 4) ℤ) :
    Set (Fin 4→ℤ) := {p | (∀ i,0<p i) ∧ (((p 0)^k*p 2:ℤ):ℝ)≤x ∧
      D/2<(p 0:ℝ) ∧ (p 0:ℝ)≤D ∧ E/2<(p 1:ℝ) ∧ (p 1:ℝ)≤E ∧
      ρ<(p 0:ℝ)/(p 1:ℝ) ∧ (p 0:ℝ)/(p 1:ℝ)≤ρ*(1+1/M) ∧
      (p 1)^k*p 3=(p 0)^k*p 2+1 ∧ MvPolynomial.eval ![p 0,p 1,p 2,p 3] G=0}

private theorem originalIntegerCell_finite
    (k : ℕ) (hk : 1≤k) (x D E M ρ : ℝ) (hx : 2≤x)
    (G : MvPolynomial (Fin 4) ℤ) :
    (originalIntegerCell k x D E M ρ G).Finite := by
  apply (Set.finite_Icc (fun _ : Fin 4 => (1:ℤ))
    (fun _ : Fin 4 => Int.ceil (2*x))).subset
  intro p hp
  obtain ⟨hpos,hnx,hdlo,hdhi,helo,hehi,hrlo,hrhi,hshift,hz⟩ := hp
  have hd1 : (1:ℝ)≤(p 0:ℝ) := by exact_mod_cast (show 1≤p 0 by have := hpos 0; omega)
  have he1 : (1:ℝ)≤(p 1:ℝ) := by exact_mod_cast (show 1≤p 1 by have := hpos 1; omega)
  have hu1 : (1:ℝ)≤(p 2:ℝ) := by exact_mod_cast (show 1≤p 2 by have := hpos 2; omega)
  have hv1 : (1:ℝ)≤(p 3:ℝ) := by exact_mod_cast (show 1≤p 3 by have := hpos 3; omega)
  have hdPow : (p 0:ℝ)≤(p 0:ℝ)^k := by
    simpa only [pow_one] using pow_le_pow_right₀ hd1 hk
  have hePow : (p 1:ℝ)≤(p 1:ℝ)^k := by
    simpa only [pow_one] using pow_le_pow_right₀ he1 hk
  have hdPow1 : (1:ℝ)≤(p 0:ℝ)^k := one_le_pow₀ hd1
  have hePow1 : (1:ℝ)≤(p 1:ℝ)^k := one_le_pow₀ he1
  have hnR : (p 0:ℝ)^k*(p 2:ℝ)≤x := by exact_mod_cast hnx
  have hsR : (p 1:ℝ)^k*(p 3:ℝ)=(p 0:ℝ)^k*(p 2:ℝ)+1 := by exact_mod_cast hshift
  have hdU : (p 0:ℝ)≤2*x := by
    have hh := mul_le_mul_of_nonneg_left hu1 (by positivity : 0≤(p 0:ℝ)^k)
    nlinarith only [hh,hnR,hdPow,hx]
  have heU : (p 1:ℝ)≤2*x := by
    have hh := mul_le_mul_of_nonneg_left hv1 (by positivity : 0≤(p 1:ℝ)^k)
    nlinarith only [hh,hsR,hnR,hePow,hx]
  have huU : (p 2:ℝ)≤2*x := by
    have hh := mul_le_mul_of_nonneg_right hdPow1 (by linarith : 0≤(p 2:ℝ))
    nlinarith only [hh,hnR,hx]
  have hvU : (p 3:ℝ)≤2*x := by
    have hh := mul_le_mul_of_nonneg_right hePow1 (by linarith : 0≤(p 3:ℝ))
    nlinarith only [hh,hsR,hnR,hx]
  refine ⟨?_,?_⟩
  · intro i
    have := hpos i
    change 1≤p i
    omega
  · intro i
    have hReal : (p i:ℝ)≤2*x := by fin_cases i <;> assumption
    have hh := hReal.trans (Int.le_ceil (2*x))
    change p i≤Int.ceil (2*x)
    exact_mod_cast hh

private theorem complex_pure_original_count
    (k : ℕ) (hk : 1≤k) (cM K ε : ℝ)
    (hcM : 0<cM) (hK : 0≤K) (hε : 0<ε) :
    ∃ C : ℝ,0<C ∧ ∀ x D E M ρ : ℝ,
      2≤x → 0<D → 0<E → 0<M → 0≤ρ → ρ≤2*D/E →
      cM*x^((1:ℝ)/((2*k-1:ℕ):ℝ))≤M →
      ∀ G : MvPolynomial (Fin 4) ℤ,
      (∀ z∈G.support,z 0+z 1=k ∧ z 2+z 3=1) →
      Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G) →
      (∀ z,|((G.coeff z:ℤ):ℝ)|≤x^K) →
      (∃ γ a b : ℂ,γ≠0 ∧ (a≠0 ∨ b≠0) ∧
        MvPolynomial.map (Int.castRingHom ℂ)
          (MvPolynomial.X (1:Fin 2)^k*C01.PcParam.PP G-
            MvPolynomial.X (0:Fin 2)^k*(-C01.PcParam.QQ G))=
          MvPolynomial.C γ*
            (MvPolynomial.C a*MvPolynomial.X 0+MvPolynomial.C b*MvPolynomial.X 1)^(2*k)) →
      (originalIntegerCell k x D E M ρ G).Finite ∧
      ((originalIntegerCell k x D E M ρ G).ncard:ℝ)≤
        C*x^ε*(1+oldPriceZ k x M (D*E)) := by
  classical
  obtain ⟨C,hC,hcount⟩ := complex_pure_graph_count k hk cM K ε hcM hK hε
  refine ⟨C,hC,?_⟩
  intro x D E M ρ hx hD hE hM hρ hρD hfloor G hG hi hGc hpure
  have hfin := originalIntegerCell_finite k hk x D E M ρ hx G
  refine ⟨hfin,?_⟩
  have hh := hcount x D E M ρ hx hD hE hM hρ hρD hfloor G hG hi hGc hpure
    hfin.toFinset (by intro p hp; exact hfin.mem_toFinset.mp hp)
  simpa only [Set.ncard_eq_toFinset_card _ hfin] using hh

private def integerPoint (z : (ℕ×ℕ)×(ℕ×ℕ)) : Fin 4→ℤ :=
  ![(z.1.1:ℤ),(z.1.2:ℤ),(z.2.1:ℤ),(z.2.2:ℤ)]

private theorem integerPoint_injective : Function.Injective integerPoint := by
  intro z w hh
  have hd : z.1.1=w.1.1 := by
    have h := congrFun hh 0
    change (z.1.1:ℤ)=(w.1.1:ℤ) at h
    exact_mod_cast h
  have he : z.1.2=w.1.2 := by
    have h := congrFun hh 1
    change (z.1.2:ℤ)=(w.1.2:ℤ) at h
    exact_mod_cast h
  have hu : z.2.1=w.2.1 := by
    have h := congrFun hh 2
    change (z.2.1:ℤ)=(w.2.1:ℤ) at h
    exact_mod_cast h
  have hv : z.2.2=w.2.2 := by
    have h := congrFun hh 3
    change (z.2.2:ℤ)=(w.2.2:ℤ) at h
    exact_mod_cast h
  exact Prod.ext (Prod.ext hd he) (Prod.ext hu hv)

private def originalNaturalCell
    (k : ℕ) (x D E M ρ : ℝ) (G : MvPolynomial (Fin 4) ℤ) :
    Set ((ℕ×ℕ)×(ℕ×ℕ)) := {z |
      1 ≤ z.1.1 ∧ 1 ≤ z.1.2 ∧ 1 ≤ z.2.1 ∧ 1 ≤ z.2.2 ∧
      (z.1.1:ℝ)^k*(z.2.1:ℝ) ≤ x ∧
      D/2 < (z.1.1:ℝ) ∧ (z.1.1:ℝ) ≤ D ∧ E/2 < (z.1.2:ℝ) ∧ (z.1.2:ℝ) ≤ E ∧
      ρ < (z.1.1:ℝ)/(z.1.2:ℝ) ∧ (z.1.1:ℝ)/(z.1.2:ℝ) ≤ ρ*(1+1/M) ∧
      z.1.2^k*z.2.2=z.1.1^k*z.2.1+1 ∧ MvPolynomial.eval (integerPoint z) G=0}

private theorem originalNaturalCell_maps
    (k : ℕ) (x D E M ρ : ℝ) (G : MvPolynomial (Fin 4) ℤ) :
    Set.MapsTo integerPoint (originalNaturalCell k x D E M ρ G)
      (originalIntegerCell k x D E M ρ G) := by
  intro z hz
  obtain ⟨hd,he,hu,hv,hnx,hdlo,hdhi,helo,hehi,hrlo,hrhi,hshift,hzG⟩ := hz
  have hpos : ∀ i,0 < integerPoint z i := by
    intro i
    fin_cases i
    · simpa [integerPoint] using (show (0:ℤ) < (z.1.1:ℤ) by omega)
    · simpa [integerPoint] using (show (0:ℤ) < (z.1.2:ℤ) by omega)
    · simpa [integerPoint] using (show (0:ℤ) < (z.2.1:ℤ) by omega)
    · simpa [integerPoint] using (show (0:ℤ) < (z.2.2:ℤ) by omega)
  change (∀ i,0 < integerPoint z i) ∧ _
  refine ⟨hpos,?_,?_,?_,?_,?_,?_,?_,?_,?_⟩
  · simpa [integerPoint] using hnx
  · simpa [integerPoint] using hdlo
  · simpa [integerPoint] using hdhi
  · simpa [integerPoint] using helo
  · simpa [integerPoint] using hehi
  · simpa [integerPoint] using hrlo
  · simpa [integerPoint] using hrhi
  · change (z.1.2:ℤ)^k*(z.2.2:ℤ)=(z.1.1:ℤ)^k*(z.2.1:ℤ)+1
    exact_mod_cast hshift
  · change MvPolynomial.eval (integerPoint z) G=0
    exact hzG

private theorem complex_pure_natural_count
    (k : ℕ) (hk : 1 ≤ k) (cM K ε : ℝ)
    (hcM : 0 < cM) (hK : 0 ≤ K) (hε : 0 < ε) :
    ∃ C : ℝ,0 < C ∧ ∀ x D E M ρ : ℝ,
      2 ≤ x → 0 < D → 0 < E → 0 < M → 0 ≤ ρ → ρ ≤ 2*D/E →
      cM*x^((1:ℝ)/((2*k-1:ℕ):ℝ)) ≤ M →
      ∀ G : MvPolynomial (Fin 4) ℤ,
      (∀ z ∈ G.support,z 0+z 1=k ∧ z 2+z 3=1) →
      Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G) →
      (∀ z,|((G.coeff z:ℤ):ℝ)| ≤ x^K) →
      (∃ γ a b : ℂ,γ ≠ 0 ∧ (a ≠ 0 ∨ b ≠ 0) ∧
        MvPolynomial.map (Int.castRingHom ℂ)
          (MvPolynomial.X (1:Fin 2)^k*C01.PcParam.PP G-
            MvPolynomial.X (0:Fin 2)^k*(-C01.PcParam.QQ G))=
          MvPolynomial.C γ*
            (MvPolynomial.C a*MvPolynomial.X 0+MvPolynomial.C b*MvPolynomial.X 1)^(2*k)) →
      (originalNaturalCell k x D E M ρ G).Finite ∧
      ((originalNaturalCell k x D E M ρ G).ncard:ℝ) ≤ 
        C*x^ε*(1+oldPriceZ k x M (D*E)) := by
  obtain ⟨C,hC,hcount⟩ := complex_pure_original_count k hk cM K ε hcM hK hε
  refine ⟨C,hC,?_⟩
  intro x D E M ρ hx hD hE hM hρ hρD hfloor G hG hi hGc hpure
  obtain ⟨hI,hcard⟩ := hcount x D E M ρ hx hD hE hM hρ hρD hfloor G hG hi hGc hpure
  have hmap := originalNaturalCell_maps k x D E M ρ G
  have hfin := Set.Finite.of_injOn hmap integerPoint_injective.injOn hI
  have hnat := Set.ncard_le_ncard_of_injOn integerPoint hmap integerPoint_injective.injOn hI
  have hR : ((originalNaturalCell k x D E M ρ G).ncard:ℝ) ≤ 
      ((originalIntegerCell k x D E M ρ G).ncard:ℝ) := by exact_mod_cast hnat
  exact ⟨hfin,hR.trans hcard⟩

private def sK (k : ℕ) : ℝ :=
  (2*(k:ℝ)-3+Real.sqrt (580*(k:ℝ)^2+276*(k:ℝ)+9))/
    (9*(k:ℝ)*(2*(k:ℝ)+1))

private def m0K (k : ℕ) (s : ℝ) : ℝ :=
  (9:ℝ)/8*s*(2-(k:ℝ)*s)

private theorem sK_lower (k : ℕ) (hk : 5 ≤ k) : 1/(k:ℝ) ≤ sK k := by
  have hkr : (5:ℝ) ≤ (k:ℝ) := by exact_mod_cast hk
  have hk0 : 0 < (k:ℝ) := by linarith
  have hrad : 0 ≤ 580*(k:ℝ)^2+276*(k:ℝ)+9 := by positivity
  have hs0 := Real.sqrt_nonneg (580*(k:ℝ)^2+276*(k:ℝ)+9)
  have hsq := Real.sq_sqrt hrad
  have hs : 16*(k:ℝ)+12 ≤ Real.sqrt (580*(k:ℝ)^2+276*(k:ℝ)+9) := by
    nlinarith [sq_nonneg ((k:ℝ)-5)]
  unfold sK
  apply (le_div_iff₀ (by positivity : 0 < 9*(k:ℝ)*(2*(k:ℝ)+1))).mpr
  have hcancel : (1/(k:ℝ))*(9*(k:ℝ)*(2*(k:ℝ)+1))=
      9*(2*(k:ℝ)+1) := by field_simp [ne_of_gt hk0]
  rw [hcancel]
  linarith

private theorem band_exponent_floor
    (k : ℕ) (hk : 5 ≤ k) (s δ : ℝ)
    (hs : sK k ≤ s) (hsup : s ≤ 14/(9*(k:ℝ))) (hδ : 0 ≤ δ) :
    1/((2*k-1:ℕ):ℝ) ≤  m0K k s+δ := by
  have hkr : (5:ℝ) ≤ (k:ℝ) := by exact_mod_cast hk
  have hk0 : 0 < (k:ℝ) := by linarith
  have hp : 0 < (2*(k:ℝ)-1) := by linarith
  have hpred : ((2*k-1:ℕ):ℝ)=2*(k:ℝ)-1 := by
    rw [Nat.cast_sub (by omega : 1 ≤ 2*k)]
    push_cast
    ring
  have hslo := (sK_lower k hk).trans hs
  have htlo : 1 ≤ (k:ℝ)*s := by
    have hh := mul_le_mul_of_nonneg_left hslo hk0.le
    have hcancel : (k:ℝ)*(1/(k:ℝ))=1 := by field_simp
    simpa only [hcancel] using hh
  have hthi : (k:ℝ)*s ≤ 14/9 := by
    have hh := mul_le_mul_of_nonneg_left hsup hk0.le
    have hcancel : (k:ℝ)*(14/(9*(k:ℝ)))=14/9 := by field_simp [ne_of_gt hk0]
    simpa only [hcancel] using hh
  have hprod := mul_nonneg (show 0 ≤ (k:ℝ)*s-4/9 by linarith)
    (show 0 ≤ 14/9-(k:ℝ)*s by linarith)
  have hmid : (7:ℝ)/9 ≤ (9:ℝ)/8*((k:ℝ)*s)*(2-(k:ℝ)*s) := by
    nlinarith only [hprod]
  have hm : 7/(9*(k:ℝ)) ≤  m0K k s := by
    apply (mul_le_mul_iff_right₀ hk0).mp
    have hcancel : (k:ℝ)*(7/(9*(k:ℝ)))=7/9 := by field_simp [ne_of_gt hk0]
    rw [hcancel]
    unfold m0K
    nlinarith only [hmid]
  have hfrac : 1/(2*(k:ℝ)-1) ≤ 7/(9*(k:ℝ)) := by
    apply (div_le_div_iff₀ hp (by positivity : 0 < 9*(k:ℝ))).mpr
    nlinarith only [hkr]
  rw [hpred]
  linarith

private theorem actual_ceiling_floor
    (k : ℕ) (hk : 5 ≤ k) (x s δ : ℝ)
    (hx : 2 ≤ x) (hs : sK k ≤ s) (hsup : s ≤ 14/(9*(k:ℝ))) (hδ : 0 ≤ δ) :
    0 < (Nat.ceil (x^(m0K k s+δ)):ℝ) ∧
      x^((1:ℝ)/((2*k-1:ℕ):ℝ)) ≤ (Nat.ceil (x^(m0K k s+δ)):ℝ) := by
  have hx0 : 0 < x := by linarith
  have hM := (Real.rpow_le_rpow_of_exponent_le (by linarith : 1 ≤ x)
    (band_exponent_floor k hk s δ hs hsup hδ)).trans (Nat.le_ceil _)
  exact ⟨lt_of_lt_of_le (Real.rpow_pos_of_pos hx0 _) hM,hM⟩

private theorem product_at_least_one
    (k : ℕ) (hk : 5 ≤ k) (x s D E : ℝ)
    (hx : 2 ≤ x) (hs : sK k ≤ s) (hDE : D*E=x^s) :
    1 ≤ D*E := by
  have hk0 : 0 < (k:ℝ) := by exact_mod_cast (show 0 < k by omega)
  have hs0 : 0 ≤ s := by
    have hh := (sK_lower k hk).trans hs
    have hpos : 0 < 1/(k:ℝ) := by positivity
    linarith
  rw [hDE]
  exact Real.one_le_rpow (by linarith) hs0

private theorem complex_pure_ceiling_count
    (k : ℕ) (hk : 5 ≤ k) (K ε : ℝ) (hK : 0 ≤ K) (hε : 0 < ε) :
    ∃ C : ℝ,0 < C ∧ ∀ x s δ D E ρ : ℝ,
      2 ≤ x → sK k ≤ s → s ≤ 14/(9*(k:ℝ)) → 0 ≤ δ →
      0 < D → 0 < E → D*E=x^s → 0 ≤ ρ → ρ ≤ 2*D/E →
      let M : ℕ := Nat.ceil (x^(m0K k s+δ))
      ∀ G : MvPolynomial (Fin 4) ℤ,
      (∀ z ∈ G.support,z 0+z 1=k ∧ z 2+z 3=1) →
      Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G) →
      (∀ z,|((G.coeff z:ℤ):ℝ)| ≤ x^K) →
      (∃ γ a b : ℂ,γ ≠ 0 ∧ (a ≠ 0 ∨ b ≠ 0) ∧
        MvPolynomial.map (Int.castRingHom ℂ)
          (MvPolynomial.X (1:Fin 2)^k*C01.PcParam.PP G-
            MvPolynomial.X (0:Fin 2)^k*(-C01.PcParam.QQ G))=
          MvPolynomial.C γ*
            (MvPolynomial.C a*MvPolynomial.X 0+MvPolynomial.C b*MvPolynomial.X 1)^(2*k)) →
      (originalNaturalCell k x D E (M:ℝ) ρ G).Finite ∧
      ((originalNaturalCell k x D E (M:ℝ) ρ G).ncard:ℝ) ≤ 
        C*x^ε*(1+x^((1:ℝ)/(k:ℝ))*(M:ℝ)^(-(((k:ℝ)-1)/(k:ℝ)))*
          (D*E)^(-((1:ℝ)/(2*(k:ℝ)+1)))) := by
  have hk1 : 1 ≤ k := by omega
  obtain ⟨C,hC,hcount⟩ := complex_pure_natural_count k hk1 1 K ε (by norm_num) hK hε
  refine ⟨C,hC,?_⟩
  intro x s δ D E ρ hx hs hsup hδ hD hE hDE hρ hρD M G hG hi hGc hpure
  obtain ⟨hM,hfloor⟩ := actual_ceiling_floor k hk x s δ hx hs hsup hδ
  have hfloor' : 1*x^((1:ℝ)/((2*k-1:ℕ):ℝ)) ≤ (M:ℝ) := by simpa only [one_mul] using hfloor
  obtain ⟨hfin,hcard⟩ := hcount x D E (M:ℝ) ρ hx hD hE hM hρ hρD hfloor' G hG hi hGc hpure
  have hDE1 := product_at_least_one k hk x s D E hx hs hDE
  have hZ := oldPriceZ_le_frozenZ k hk1 x (M:ℝ) (D*E) (by linarith) hM hDE1
  refine ⟨hfin,hcard.trans ?_⟩
  have hZ' : 1+oldPriceZ k x (M:ℝ) (D*E) ≤
      1+x^((1:ℝ)/(k:ℝ))*(M:ℝ)^(-(((k:ℝ)-1)/(k:ℝ)))*
        (D*E)^(-((1:ℝ)/(2*(k:ℝ)+1))) := by linarith only [hZ]
  exact mul_le_mul_of_nonneg_left hZ' (by positivity)

private def rhoK (D E : ℝ) (M j : ℕ) : ℝ :=
  D/(2*E)*(1+1/(M:ℝ))^j
private def cellsK (D E : ℝ) (M : ℕ) : Finset ℕ :=
  @Finset.filter ℕ (fun j => D/(2*E) ≤ rhoK D E M j ∧ rhoK D E M j ≤ 2*D/E)
    (Classical.decPred _) (Finset.range (3*M+1))
private def originalBoxK (k : ℕ) (x D E : ℝ) : Set ((ℕ×ℕ)×(ℕ×ℕ)) :=
  {z | 1 ≤ z.1.1 ∧ 1 ≤ z.1.2 ∧ 1 ≤ z.2.1 ∧ 1 ≤ z.2.2 ∧
    z.1.2^k*z.2.2=z.1.1^k*z.2.1+1 ∧
    x/2 < (z.1.1:ℝ)^k*(z.2.1:ℝ) ∧ (z.1.1:ℝ)^k*(z.2.1:ℝ) ≤ x ∧
    D/2 < (z.1.1:ℝ) ∧ (z.1.1:ℝ) ≤ D ∧ E/2 < (z.1.2:ℝ) ∧ (z.1.2:ℝ) ≤ E}
private def cellK (k : ℕ) (x D E : ℝ) (M j : ℕ) : Set ((ℕ×ℕ)×(ℕ×ℕ)) :=
  {z | z ∈ originalBoxK k x D E ∧ rhoK D E M j < (z.1.1:ℝ)/(z.1.2:ℝ) ∧
    (z.1.1:ℝ)/(z.1.2:ℝ) ≤ rhoK D E M j*(1+1/(M:ℝ))}

private theorem pure_k_cell_count
    (k : ℕ) (hk : 5 ≤ k) (K ε : ℝ) (hK : 0 ≤ K) (hε : 0 < ε) :
    ∃ C : ℝ,0 < C ∧ ∀ x s δ D E : ℝ,
      2 ≤ x → sK k ≤ s → s ≤ 14/(9*(k:ℝ)) → 0 ≤ δ →
      0 < D → 0 < E → D*E=x^s →
      let M : ℕ := Nat.ceil (x^(m0K k s+δ))
      ∀ j ∈ cellsK D E M,∀ G : MvPolynomial (Fin 4) ℤ,
      (∀ z ∈ G.support,z 0+z 1=k ∧ z 2+z 3=1) →
      Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G) →
      (∀ z,|((G.coeff z:ℤ):ℝ)| ≤ x^K) →
      (∃ γ a b : ℂ,γ ≠ 0 ∧ (a ≠ 0 ∨ b ≠ 0) ∧
        MvPolynomial.map (Int.castRingHom ℂ)
          (MvPolynomial.X (1:Fin 2)^k*C01.PcParam.PP G-
            MvPolynomial.X (0:Fin 2)^k*(-C01.PcParam.QQ G))=
          MvPolynomial.C γ*
            (MvPolynomial.C a*MvPolynomial.X 0+MvPolynomial.C b*MvPolynomial.X 1)^(2*k)) →
      let S := {z | z ∈ cellK k x D E M j ∧ MvPolynomial.eval (integerPoint z) G=0}
      S.Finite ∧ (S.ncard:ℝ) ≤ 
        C*x^ε*(1+x^((1:ℝ)/(k:ℝ))*(M:ℝ)^(-(((k:ℝ)-1)/(k:ℝ)))*
          (D*E)^(-((1:ℝ)/(2*(k:ℝ)+1)))) := by
  classical
  obtain ⟨C,hC,hcount⟩ := complex_pure_ceiling_count k hk K ε hK hε
  refine ⟨C,hC,?_⟩
  intro x s δ D E hx hs hsup hδ hD hE hDE M j hj G hG hi hGc hpure S
  have hj' : D/(2*E) ≤ rhoK D E M j ∧ rhoK D E M j ≤ 2*D/E := by
    have hmem := hj
    simp only [cellsK,Finset.mem_filter] at hmem
    exact hmem.2
  have hρ : 0 ≤ rhoK D E M j :=
    (by positivity : 0 ≤ D/(2*E)).trans hj'.1
  obtain ⟨hfin,hcard⟩ := hcount x s δ D E (rhoK D E M j)
    hx hs hsup hδ hD hE hDE hρ hj'.2 G hG hi hGc hpure
  have hsub : S ⊆ originalNaturalCell k x D E (M:ℝ) (rhoK D E M j) G := by
    intro z hz
    obtain ⟨hzcell,hzG⟩ := hz
    obtain ⟨hzbox,hrlo,hrhi⟩ := hzcell
    obtain ⟨hd,he,hu,hv,hshift,hnlo,hnx,hdlo,hdhi,helo,hehi⟩ := hzbox
    exact ⟨hd,he,hu,hv,hnx,hdlo,hdhi,helo,hehi,hrlo,hrhi,hshift,hzG⟩
  refine ⟨hfin.subset hsub,?_⟩
  have hh := Set.ncard_le_ncard hsub hfin
  have hR : (S.ncard:ℝ) ≤ 
      ((originalNaturalCell k x D E (M:ℝ) (rhoK D E M j) G).ncard:ℝ) := by exact_mod_cast hh
  exact hR.trans hcard

private abbrev Point := (ℕ×ℕ)×(ℕ×ℕ)
private theorem box_shift_int {k : ℕ} {x D E : ℝ} {z : Point}
    (hz : z ∈ originalBoxK k x D E) :
    (z.1.2:ℤ)^k*(z.2.2:ℤ)-(z.1.1:ℤ)^k*(z.2.1:ℤ)=1 := by
  have hh : (z.1.2:ℤ)^k*(z.2.2:ℤ)=(z.1.1:ℤ)^k*(z.2.1:ℤ)+1 := by
    exact_mod_cast hz.2.2.2.2.1
  linear_combination hh
private theorem unit_shift_primitive_k (k : ℕ) (hk : 1  ≤  k) (d e u v h : ℤ)
    (hs : h = 1 ∨ h = -1) (hshift : e ^ k * v - d ^ k * u = h) :
    Int.gcd d e = 1 ∧ Int.gcd u v = 1 := by
  constructor
  · apply Int.gcd_eq_one_iff.mpr
    intro c hcd hce
    have hch : c ∣ h := by
      rw [← hshift]
      exact dvd_sub (dvd_mul_of_dvd_left (dvd_pow hce (by omega)) v)
        (dvd_mul_of_dvd_left (dvd_pow hcd (by omega)) u)
    have hc1 : c ∣ (1 : ℤ) := by
      rcases hs with hs | hs
      · simpa only [hs] using hch
      · simpa only [hs, dvd_neg, neg_neg] using hch
    exact hc1
  · apply Int.gcd_eq_one_iff.mpr
    intro c hcu hcv
    have hch : c ∣ h := by
      rw [← hshift]
      exact dvd_sub (dvd_mul_of_dvd_right hcv (e ^ k))
        (dvd_mul_of_dvd_right hcu (d ^ k))
    have hc1 : c ∣ (1 : ℤ) := by
      rcases hs with hs | hs
      · simpa only [hs] using hch
      · simpa only [hs, dvd_neg, neg_neg] using hch
    exact hc1

private theorem positive_linear_pair_unique
    (p r : ℤ) (hpr : (p,r) ≠ (0,0))
    (d e d' e' : ℕ) (hd : 1 ≤ d) (he : 1 ≤ e) (hd' : 1 ≤ d') (he' : 1 ≤ e')
    (hc : Int.gcd (d:ℤ) (e:ℤ)=1) (hc' : Int.gcd (d':ℤ) (e':ℤ)=1)
    (hl : p*(d:ℤ)+r*(e:ℤ)=0)
    (hl' : p*(d':ℤ)+r*(e':ℤ)=0) :
    d=d' ∧ e=e' := by
  have hpr' : ¬(-r=0 ∧ p=0) := by
    rintro ⟨hr,hp⟩
    apply hpr
    have hr0 : r=0 := neg_eq_zero.mp hr
    exact Prod.ext hp hr0
  have hlin : (d:ℤ)*p=(e:ℤ)*(-r) := by linear_combination hl
  have hlin' : (d':ℤ)*p=(e':ℤ)*(-r) := by linear_combination hl'
  have hpar :=
    FormalAB.Sdd81c7c9.A1QuadraticComponents.same_line_parallel
      (-r) p (d:ℤ) (e:ℤ) (d':ℤ) (e':ℤ) hpr' hlin hlin'
  obtain ⟨k,hk,hdk,hek⟩ :=
    JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C03.PcLemP.prim_parallel
      (d:ℤ) (e:ℤ) (d':ℤ) (e':ℤ) hc hc' hpar
  rcases hk with rfl | rfl
  · constructor
    · have hz : (d':ℤ)=(d:ℤ) := by simpa using hdk
      exact_mod_cast hz.symm
    · have hz : (e':ℤ)=(e:ℤ) := by simpa using hek
      exact_mod_cast hz.symm
  · have hdZ : (1:ℤ) ≤ (d:ℤ) := by exact_mod_cast hd
    have hdZ' : (1:ℤ) ≤ (d':ℤ) := by exact_mod_cast hd'
    norm_num at hdk
    omega

private theorem cofactor_same_bucket_le_k (k : ℕ)
    (d e u₁ v₁ u₂ v₂ : ℕ) (he : 1 ≤ e) (hc : d.Coprime e)
    (hEq : e^k*v₂+d^k*u₁=e^k*v₁+d^k*u₂)
    (hq : u₁/(e^k)=u₂/(e^k)) (hule : u₁ ≤ u₂) :
    u₁=u₂ := by
  by_contra hne
  have hult : u₁ < u₂ := by omega
  have hdprod : d^k*u₁ ≤ d^k*u₂ := Nat.mul_le_mul_left _ hule
  have hvprod : e^k*v₁ ≤ e^k*v₂ := by omega
  have hepos : 0 < e^k := pow_pos (by omega : 0 < e) k
  have hvle : v₁ ≤ v₂ := by
    by_contra hn
    have hvl : v₂ < v₁ := by omega
    have hmul := Nat.mul_lt_mul_of_pos_left hvl hepos
    omega
  have hdiff : d^k*(u₂-u₁)=e^k*(v₂-v₁) := by
    rw [Nat.mul_sub_left_distrib,Nat.mul_sub_left_distrib]
    omega
  have hdvd₀ : e^k∣d^k*(u₂-u₁) := ⟨v₂-v₁,hdiff⟩
  have hdvd : e^k∣u₂-u₁ := (hc.symm.pow k k).dvd_of_dvd_mul_left hdvd₀
  have hgap : e^k ≤ u₂-u₁ := Nat.le_of_dvd (by omega) hdvd
  have hmod₂ := Nat.mod_lt u₂ hepos
  have hqmul : e^k*(u₂/(e^k)) ≤ u₁ := by
    rw [← hq]
    simpa only [Nat.mul_comm] using Nat.div_mul_le_self u₁ (e^k)
  have hlt : u₂ < e^k+u₁ := by
    calc
      u₂=u₂%(e^k)+e^k*(u₂/(e^k)) := (Nat.mod_add_div u₂ (e^k)).symm
      _  <  e^k+e^k*(u₂/(e^k)) := Nat.add_lt_add_right hmod₂ _
      _  ≤  e^k+u₁ := Nat.add_le_add_left hqmul _
  omega

private theorem cofactor_same_bucket_k (k : ℕ)
    (d e u₁ v₁ u₂ v₂ : ℕ) (h : ℤ)
    (he : 1 ≤ e) (hc : d.Coprime e)
    (hs₁ : (e:ℤ)^k*(v₁:ℤ)-(d:ℤ)^k*(u₁:ℤ)=h)
    (hs₂ : (e:ℤ)^k*(v₂:ℤ)-(d:ℤ)^k*(u₂:ℤ)=h)
    (hq : u₁/(e^k)=u₂/(e^k)) :
    u₁=u₂ ∧ v₁=v₂ := by
  have hEqZ : (e:ℤ)^k*(v₂:ℤ)+(d:ℤ)^k*(u₁:ℤ)=
      (e:ℤ)^k*(v₁:ℤ)+(d:ℤ)^k*(u₂:ℤ) := by
    linear_combination hs₂-hs₁
  have hEq : e^k*v₂+d^k*u₁=e^k*v₁+d^k*u₂ := by exact_mod_cast hEqZ
  have hu : u₁=u₂ := by
    rcases le_total u₁ u₂ with hle | hle
    · exact cofactor_same_bucket_le_k k d e u₁ v₁ u₂ v₂ he hc hEq hq hle
    · exact (cofactor_same_bucket_le_k k d e u₂ v₂ u₁ v₁ he hc
        hEq.symm hq.symm hle).symm
  have hv : v₁=v₂ := by
    apply Nat.mul_left_cancel (pow_pos (by omega : 0 < e) k)
    rw [hu] at hEq
    exact Nat.add_right_cancel hEq.symm
  exact ⟨hu,hv⟩

private theorem original_fixed_pair_count_k (k : ℕ)
    (x : ℝ) (d e : ℕ) (h : ℤ)
    (hd : 1 ≤ d) (he : 1 ≤ e) (hc : d.Coprime e)
    (hprod : x ≤ (4:ℝ)^k*(((d*e : ℕ):ℝ)^k)) :
    let S : Set (ℕ×ℕ) :=
      {uv | 1 ≤ uv.1 ∧ 1 ≤ uv.2 ∧
        (e:ℤ)^k*(uv.2:ℤ)-(d:ℤ)^k*(uv.1:ℤ)=h ∧
        (((d^k*uv.1 : ℕ):ℝ)) ≤ x}
    S.Finite ∧ S.ncard ≤ 4^k+1 := by
  classical
  dsimp only
  let S : Set (ℕ×ℕ) :=
    {uv | 1 ≤ uv.1 ∧ 1 ≤ uv.2 ∧
      (e:ℤ)^k*(uv.2:ℤ)-(d:ℤ)^k*(uv.1:ℤ)=h ∧
      (((d^k*uv.1 : ℕ):ℝ)) ≤ x}
  let f : (ℕ×ℕ) → ℕ := fun uv => uv.1/(e^k)
  have hde0 : (0:ℝ)  <  (((d*e : ℕ):ℝ)^k) := by
    have hpos : 0  <  d*e := Nat.mul_pos (by omega) (by omega)
    have hposR : (0:ℝ)  <  ((d*e : ℕ):ℝ) := by exact_mod_cast hpos
    positivity
  have hmap : Set.MapsTo f S (↑(Finset.range (4^k+1)) : Set ℕ) := by
    intro uv huv
    have hqmul : (uv.1/(e^k))*(e^k) ≤ uv.1 :=
      Nat.div_mul_le_self uv.1 (e^k)
    have hmul : d^k*((uv.1/(e^k))*(e^k)) ≤ d^k*uv.1 :=
      Nat.mul_le_mul_left (d^k) hqmul
    have hmulR : (((d*e : ℕ):ℝ)^k)*(f uv : ℝ) ≤ x := by
      calc
        (((d*e : ℕ):ℝ)^k)*(f uv : ℝ)=
            ((d^k*((uv.1/(e^k))*(e^k)) : ℕ):ℝ) := by
          simp only [f,Nat.cast_mul,Nat.cast_pow]
          ring
        _  ≤  ((d^k*uv.1 : ℕ):ℝ) := by exact_mod_cast hmul
        _  ≤  x := huv.2.2.2
    have hqR : (f uv : ℝ) ≤ (4:ℝ)^k := by
      have h1 : (((d*e : ℕ):ℝ)^k)*(f uv : ℝ) ≤ (((d*e : ℕ):ℝ)^k)*(4:ℝ)^k := by
        calc _  ≤  x := hmulR
          _  ≤  (4:ℝ)^k*(((d*e : ℕ):ℝ)^k) := hprod
          _ = _ := by ring
      exact le_of_mul_le_mul_left h1 hde0
    have hq : f uv ≤ 4^k := by exact_mod_cast hqR
    change f uv ∈ Finset.range (4^k+1)
    exact Finset.mem_range.mpr (by omega)
  have hinj : Set.InjOn f S := by
    intro uv huv uv' huv' hf
    obtain ⟨hu,hv⟩ := cofactor_same_bucket_k k d e uv.1 uv.2 uv'.1 uv'.2
      h he hc huv.2.2.1 huv'.2.2.1 hf
    exact Prod.ext hu hv
  have hT : (↑(Finset.range (4^k+1)) : Set ℕ).Finite := Finset.finite_toSet _
  have hfin : S.Finite := Set.Finite.of_injOn hmap hinj hT
  refine ⟨hfin,?_⟩
  have hh := Set.ncard_le_ncard_of_injOn f hmap hinj hT
  simpa only [Set.ncard_coe_finset,Finset.card_range] using hh

private theorem first_linear_axis_count (k : ℕ) (hk : 1  ≤  k)
    (x D E : ℝ) (M j : ℕ) (p r : ℤ)
    (hD : 0 < D) (hE : 0 < E)
    (hpr : (p,r) ≠ (0,0))
    (hprod : x ≤ (D*E)^k) :
    let S : Set Point :=
      {z | z ∈ cellK k x D E M j ∧
        p*(z.1.1:ℤ)+r*(z.1.2:ℤ)=0}
    S.Finite ∧ S.ncard ≤ 4^k+1 := by
  classical
  dsimp only
  let S : Set Point :=
    {z | z ∈ cellK k x D E M j ∧
      p*(z.1.1:ℤ)+r*(z.1.2:ℤ)=0}
  by_cases hne : S.Nonempty
  · obtain ⟨z₀,hz₀⟩ := hne
    have hp₀ := hz₀.1.1
    have hsub₀ := box_shift_int hp₀
    rcases hp₀ with ⟨hd₀,he₀,hu₀,hv₀,hshift₀,hm₀,hm₁,hdD₀,hdD₁,heE₀,heE₁⟩
    have hprim₀ := unit_shift_primitive_k k hk
      (z₀.1.1:ℤ) (z₀.1.2:ℤ) (z₀.2.1:ℤ) (z₀.2.2:ℤ) 1 (Or.inl rfl) hsub₀
    have hfix : ∀ z ∈ S, z.1=z₀.1 := by
      intro z hz
      have hsub := box_shift_int hz.1.1
      rcases hz.1.1 with ⟨hd,he,hu,hv,hshift,hm0,hm1,hdD0,hdD1,heE0,heE1⟩
      have hprim := unit_shift_primitive_k k hk
        (z.1.1:ℤ) (z.1.2:ℤ) (z.2.1:ℤ) (z.2.2:ℤ) 1 (Or.inl rfl) hsub
      obtain ⟨hdq,heq⟩ := positive_linear_pair_unique p r hpr
        z.1.1 z.1.2 z₀.1.1 z₀.1.2 hd he hd₀ he₀ hprim.1 hprim₀.1
        hz.2 hz₀.2
      exact Prod.ext hdq heq
    have hcop : Nat.Coprime z₀.1.1 z₀.1.2 := by
      have hg : Int.gcd ((z₀.1.1 : ℕ) : ℤ) ((z₀.1.2 : ℕ) : ℤ) = 1 := hprim₀.1
      rw [Int.gcd_natCast_natCast] at hg
      exact hg
    have hprod₀ : x ≤ (4:ℝ)^k*(((z₀.1.1*z₀.1.2:ℕ):ℝ)^k) := by
      have hd2 : D ≤ 2*(z₀.1.1:ℝ) := by linarith
      have he2 : E ≤ 2*(z₀.1.2:ℝ) := by linarith
      have hDE : D*E ≤ (2*(z₀.1.1:ℝ))*(2*(z₀.1.2:ℝ)) :=
        mul_le_mul hd2 he2 hE.le (by positivity)
      have hsq : (D*E)^k ≤ ((2*(z₀.1.1:ℝ))*(2*(z₀.1.2:ℝ)))^k :=
        pow_le_pow_left₀ (mul_pos hD hE).le hDE k
      calc x  ≤  (D*E)^k := hprod
        _  ≤  ((2*(z₀.1.1:ℝ))*(2*(z₀.1.2:ℝ)))^k := hsq
        _ = (4:ℝ)^k*(((z₀.1.1*z₀.1.2:ℕ):ℝ)^k) := by
          push_cast
          rw [← mul_pow]
          ring
    let T : Set (ℕ×ℕ) :=
      {uv | 1 ≤ uv.1 ∧ 1 ≤ uv.2 ∧
        (z₀.1.2:ℤ)^k*(uv.2:ℤ)-(z₀.1.1:ℤ)^k*(uv.1:ℤ)=1 ∧
        (((z₀.1.1^k*uv.1:ℕ):ℝ)) ≤ x}
    have hT : T.Finite ∧ T.ncard ≤ 4^k+1 :=
      original_fixed_pair_count_k k x z₀.1.1 z₀.1.2 1 hd₀ he₀ hcop hprod₀
    have hmap : Set.MapsTo (fun z : Point => z.2) S T := by
      intro z hz
      have hq := hfix z hz
      have hq₀ : z.1.1=z₀.1.1 := congrArg Prod.fst hq
      have hq₁ : z.1.2=z₀.1.2 := congrArg Prod.snd hq
      have hsub := box_shift_int hz.1.1
      rcases hz.1.1 with ⟨hd,he,hu,hv,hshift,hm0,hm1,hdD0,hdD1,heE0,heE1⟩
      refine ⟨hu,hv,?_,?_⟩
      · rw [← hq₀, ← hq₁]
        exact hsub
      · rw [← hq₀]
        simpa only [Nat.cast_mul,Nat.cast_pow] using hm1
    have hinj : Set.InjOn (fun z : Point => z.2) S := by
      intro z hz z' hz' hzz
      exact Prod.ext ((hfix z hz).trans (hfix z' hz').symm) hzz
    have hfin : S.Finite := Set.Finite.of_injOn hmap hinj hT.1
    refine ⟨hfin,?_⟩
    exact (Set.ncard_le_ncard_of_injOn (fun z : Point => z.2) hmap hinj hT.1).trans hT.2
  · have hS : S=∅ := Set.not_nonempty_iff_eq_empty.mp hne
    change S.Finite ∧ S.ncard ≤ 4^k+1
    rw [hS]
    exact ⟨Set.finite_empty,by simp⟩

private def StewartHyp : Prop := ∀ q : ℕ, 3  ≤  q → ∀ a : Fin (q + 1) → ℤ, Finset.univ.gcd a = 1 → Squarefree (∑ i : Fin (q + 1), MvPolynomial.C (a i : ℚ) * MvPolynomial.X (0 : Fin 2) ^ (i : ℕ) * MvPolynomial.X (1 : Fin 2) ^ (q - (i : ℕ))) → ∀ m : ℤ, m  ≠  0 → {rs : ℤ × ℤ | Int.gcd rs.1 rs.2 = 1 ∧ ∑ i : Fin (q + 1), a i * rs.1 ^ (i : ℕ) * rs.2 ^ (q - (i : ℕ)) = m}.encard  ≤  ((2800 * q ^ (1 + m.natAbs.primeFactors.card) : ℕ) : ℕ∞)

private def Qk : ℕ → ℚ → ℚ := fun k t => 1 / 2 + (1 / (2 * ∑ i  ∈  Finset.range k, (-1 : ℚ) ^ i * ((k - 1).choose i : ℚ) / (2 * (i : ℚ) + 1))) * ∑ i  ∈  Finset.range k, (-1 : ℚ) ^ i * ((k - 1).choose i : ℚ) * t ^ (2 * i + 1) / (2 * (i : ℚ) + 1)

private def SQ : ℕ → Set ((ℕ×ℕ)×(ℕ×ℕ)) := fun k => {z | (∃ t : ℚ, ((z.1.1 ^ k * z.2.1 : ℕ) : ℚ) = -Qk k t) ∨ (∃ t : ℚ, ((z.1.1 ^ k * z.2.1 + 1 : ℕ) : ℚ) = Qk k t)}

namespace Canonical
open MvPolynomial
open JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure
private abbrev idx (i j k l : ℕ) : Fin 4 →₀ ℕ :=
  Finsupp.single 0 i + Finsupp.single 1 j + Finsupp.single 2 k + Finsupp.single 3 l

private theorem block_coeff (G : MvPolynomial (Fin 4) ℤ) (a i j : ℕ)
    (hG : ∀ m  ∈  G.support, m 0+m 1=a ∧ m 2+m 3=1) :
    (C01.PcParam.PP G).coeff (C01.PcCurves.ex i j) = G.coeff (idx i j 1 0) ∧
    (C01.PcParam.QQ G).coeff (C01.PcCurves.ex i j) = G.coeff (idx i j 0 1) := by
  classical
  constructor
  · unfold C01.PcParam.PP
    simp only [MvPolynomial.coeff_sum, C01.PcCurves.monomial_ex, MvPolynomial.coeff_monomial]
    rw [Finset.sum_eq_single (idx i j 1 0)]
    · simp [idx, C01.PcCurves.ex]
    · intro m hm hne
      rw [if_neg]
      intro he
      have h0 : m 0=i := by simpa using congrArg (fun f => f 0) he
      have h1 : m 1=j := by simpa using congrArg (fun f => f 1) he
      obtain ⟨hmS,hm2⟩ := Finset.mem_filter.mp hm
      have hm3 : m 3=0 := by have ht := (hG m hmS).2; omega
      apply hne
      ext t
      fin_cases t <;> simp [idx] <;> omega
    · intro hn
      have hc : G.coeff (idx i j 1 0)=0 := by
        by_contra hc
        apply hn
        exact Finset.mem_filter.mpr ⟨mem_support_iff.mpr hc,by simp [idx]⟩
      simp [hc]
  · unfold C01.PcParam.QQ
    simp only [MvPolynomial.coeff_sum, C01.PcCurves.monomial_ex, MvPolynomial.coeff_monomial]
    rw [Finset.sum_eq_single (idx i j 0 1)]
    · simp [idx, C01.PcCurves.ex]
    · intro m hm hne
      rw [if_neg]
      intro he
      have h0 : m 0=i := by simpa using congrArg (fun f => f 0) he
      have h1 : m 1=j := by simpa using congrArg (fun f => f 1) he
      obtain ⟨hmS,hm2⟩ := Finset.mem_filter.mp hm
      have hm20 : m 2=0 := by have ht := (hG m hmS).2; omega
      have hm3 : m 3=1 := by have ht := (hG m hmS).2; omega
      apply hne
      ext t
      fin_cases t <;> simp [idx] <;> omega
    · intro hn
      have hc : G.coeff (idx i j 0 1)=0 := by
        by_contra hc
        apply hn
        exact Finset.mem_filter.mpr ⟨mem_support_iff.mpr hc,by simp [idx]⟩
      simp [hc]

private def canonicalP (G : MvPolynomial (Fin 4) ℤ) (a : ℕ) : MvPolynomial (Fin 2) ℤ :=
  ∑ i  ∈  Finset.range (a+1), MvPolynomial.C (G.coeff (idx i (a-i) 1 0))*MvPolynomial.X 0^i*MvPolynomial.X 1^(a-i)

private def canonicalQ (G : MvPolynomial (Fin 4) ℤ) (a : ℕ) : MvPolynomial (Fin 2) ℤ :=
  ∑ i  ∈  Finset.range (a+1), MvPolynomial.C (-G.coeff (idx i (a-i) 0 1))*MvPolynomial.X 0^i*MvPolynomial.X 1^(a-i)

private theorem canonical_blocks (G : MvPolynomial (Fin 4) ℤ) (a : ℕ)
    (hG : ∀ m  ∈  G.support, m 0+m 1=a ∧ m 2+m 3=1) :
    canonicalP G a=C01.PcParam.PP G ∧ canonicalQ G a= -C01.PcParam.QQ G := by
  constructor
  · rw [C01.PcCurves.hom_repr (C01.PcParam.PP_hom G a hG)]
    unfold canonicalP
    apply Finset.sum_congr rfl
    intro i hi
    rw [(block_coeff G a i (a-i) hG).1]
  · rw [C01.PcCurves.hom_repr (C01.PcParam.QQ_hom G a hG),←Finset.sum_neg_distrib]
    unfold canonicalQ
    apply Finset.sum_congr rfl
    intro i hi
    rw [(block_coeff G a i (a-i) hG).2]
    simp
end Canonical

private def residualLow (k α : ℕ) (G : MvPolynomial (Fin 4) ℤ) :
    MvPolynomial (Fin 2) ℤ :=
  MvPolynomial.X 1^k*Canonical.canonicalP G α-
    MvPolynomial.X 0^k*Canonical.canonicalQ G α
private def pureLow (n : ℕ) (R : MvPolynomial (Fin 2) ℤ) : Prop :=
  ∃ γ a b : ℂ,γ ≠ 0 ∧ (a ≠ 0 ∨ b ≠ 0) ∧
    MvPolynomial.map (Int.castRingHom ℂ) R=MvPolynomial.C γ*
      (MvPolynomial.C a*MvPolynomial.X 0+MvPolynomial.C b*MvPolynomial.X 1)^n
private def frozenZ (k : ℕ) (x D E M : ℝ) : ℝ :=
  x^((1:ℝ)/(k:ℝ))*M^(-(((k:ℝ)-1)/(k:ℝ)))*(D*E)^(-((1:ℝ)/(2*(k:ℝ)+1)))
private def lowCurve (k : ℕ) (x D E : ℝ) (M j : ℕ)
    (G : MvPolynomial (Fin 4) ℤ) : Set ((ℕ×ℕ)×(ℕ×ℕ)) :=
  {z | z ∈ cellK k x D E M j ∧ z ∉ SQ k ∧ MvPolynomial.eval (integerPoint z) G=0}
private def globalPopulation (k : ℕ) (x : ℝ) (G : MvPolynomial (Fin 4) ℤ) :
    Set ((ℕ×ℕ)×(ℕ×ℕ)) :=
  {z | 1 ≤ z.1.1 ∧ 1 ≤ z.1.2 ∧ 1 ≤ z.2.1 ∧ 1 ≤ z.2.2 ∧
    z.1.2^k*z.2.2=z.1.1^k*z.2.1+1 ∧ ((z.1.1^k*z.2.1:ℕ):ℝ) ≤ x ∧
    MvPolynomial.eval (integerPoint z) G=0}

private theorem set_empty_of_not_mem {α : Type*} {S : Set α}
    (h : ∀ z,z∈S → False) : S=∅ := by
  apply Set.ext
  intro z
  change (z∈S ↔ False)
  exact ⟨h z,False.elim⟩

private theorem positive_low_count
    (hSt : StewartHyp) (k : ℕ) (hk : 5 ≤ k) (hk123 : k ≤ 123)
    (K ε : ℝ) (hK : 0 ≤ K) (hε : 0 < ε) :
    ∃ C : ℝ,0 < C ∧ ∀ x s δ D E : ℝ,
      2 ≤ x → sK k ≤ s → s ≤ 14/(9*(k:ℝ)) → 0 ≤ δ →
      0 < D → 0 < E → D*E=x^s →
      let M : ℕ := Nat.ceil (x^(m0K k s+δ))
      ∀ j ∈ cellsK D E M,∀ α : ℕ,1 ≤ α → α ≤ k →
      ∀ G : MvPolynomial (Fin 4) ℤ,G ≠ 0 →
      (∀ z ∈ G.support,z 0+z 1=α ∧ z 2+z 3=1) →
      Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G) →
      (∀ z,|((G.coeff z:ℤ):ℝ)| ≤ x^K) →
      (lowCurve k x D E M j G).Finite ∧
      ((lowCurve k x D E M j G).ncard:ℝ) ≤ C*x^ε*(1+frozenZ k x D E (M:ℝ)) := by
  classical
  obtain ⟨CN,hCN,hNonpure⟩ :=
    A8WholeLowOldNPInputs.JocelynClaims.claim_83d1f526f09b5e9ed2c252961bbfd8a750fdde6aeef9306790bc5f9a14426147
      hSt k hk hk123 K hK ε hε
  obtain ⟨CP,hCP,hPure⟩ := pure_k_cell_count k hk K ε hK hε
  let C : ℝ := CN+CP+1
  have hC : 0 < C := by dsimp [C]; positivity
  have hNC : CN ≤ C := by dsimp [C]; linarith only [hCP]
  have hPC : CP ≤ C := by dsimp [C]; linarith only [hCN]
  refine ⟨C,hC,?_⟩
  intro x s δ D E hx hs hsup hδ hD hE hDE M j hj α hα hαk G hG0 hG hi hGc
  have hPrice : 1 ≤ 1+frozenZ k x D E (M:ℝ) := by
    have hz : 0 ≤ frozenZ k x D E (M:ℝ) := by unfold frozenZ; positivity
    linarith only [hz]
  by_cases hpure : pureLow (α+k) (residualLow k α G)
  · by_cases hαeq : α=k
    · subst α
      have hcan := Canonical.canonical_blocks G k hG
      have hpure' : ∃ γ a b : ℂ,γ ≠ 0 ∧ (a ≠ 0 ∨ b ≠ 0) ∧
          MvPolynomial.map (Int.castRingHom ℂ)
            (MvPolynomial.X (1:Fin 2)^k*C01.PcParam.PP G-
              MvPolynomial.X (0:Fin 2)^k*(-C01.PcParam.QQ G))=
            MvPolynomial.C γ*
              (MvPolynomial.C a*MvPolynomial.X 0+MvPolynomial.C b*MvPolynomial.X 1)^(2*k) := by
        rcases hpure with ⟨γ,a,b,hγ,hab,hres⟩
        refine ⟨γ,a,b,hγ,hab,?_⟩
        unfold residualLow at hres
        rw [hcan.1,hcan.2] at hres
        simpa only [two_mul] using hres
      obtain ⟨hfin,hbound⟩ := hPure x s δ D E hx hs hsup hδ hD hE hDE j hj G hG hi hGc hpure'
      have hsub : lowCurve k x D E M j G ⊆ 
          {z | z ∈ cellK k x D E M j ∧ MvPolynomial.eval (integerPoint z) G=0} :=
        fun z hz => ⟨hz.1,hz.2.2⟩
      have hcard := Set.ncard_le_ncard hsub hfin
      refine ⟨hfin.subset hsub,?_⟩
      have hR : ((lowCurve k x D E M j G).ncard:ℝ) ≤ 
          (({z | z ∈ cellK k x D E M j ∧ MvPolynomial.eval (integerPoint z) G=0} :
            Set ((ℕ×ℕ)×(ℕ×ℕ))).ncard:ℝ) := by exact_mod_cast hcard
      exact (hR.trans hbound).trans
        (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hPC (by positivity)) (show 0 ≤ 1+frozenZ k x D E (M:ℝ) from (by norm_num : (0:ℝ) ≤ 1).trans hPrice))
    · by_cases hαsq : α=k-1
      · subst α
        have hpure' : pureLow (2*k-1) (residualLow k (k-1) G) := by
          simpa only [show k-1+k=2*k-1 by omega] using hpure
        have hSQ := A8WholeLowOldSQInputs.JocelynClaims.claim_0ba0027d1d1c4918b820e531ddc15feae06c216fcdc783d6368daf4c82031076
          k hk hk123 G hG0 hG hi hpure'
        have hempty : lowCurve k x D E M j G=∅ := by
          apply set_empty_of_not_mem
          intro z hz
          obtain ⟨hzcell,hzSQ,hzG⟩ := hz
          obtain ⟨hzbox,hrlo,hrhi⟩ := hzcell
          obtain ⟨hd,he,hu,hv,hshift,hnlo,hnhi,hdlo,hdhi,helo,hehi⟩ := hzbox
          exact hzSQ (hSQ z hd he hu hv hshift hzG)
        rw [hempty]
        refine ⟨Set.finite_empty,?_⟩
        simp only [Set.ncard_empty,Nat.cast_zero]
        positivity
      · have hsmall : α+2 ≤ k := by omega
        rcases hpure with ⟨γ,a,b,hγ,hab,hres⟩
        exact False.elim
          (A8WholeLowOldPureSmallInputs.JocelynClaims.claim_8613e9be61d0ff423aa521e272650e4145c0dbee2088aa567aca7b7204945999
            k hk hk123 α hα hsmall G hG0 hG hi γ a b hγ hab hres)
  · have hh := hNonpure x hx α hα hαk G hG0 hG hi hGc hpure
    change (globalPopulation k x G).Finite ∧
      ((globalPopulation k x G).ncard:ℝ) ≤ CN*x^ε at hh
    obtain ⟨hfin,hbound⟩ := hh
    have hsub : lowCurve k x D E M j G ⊆ globalPopulation k x G := by
      intro z hz
      obtain ⟨hzcell,hzSQ,hzG⟩ := hz
      obtain ⟨hzbox,hrlo,hrhi⟩ := hzcell
      obtain ⟨hd,he,hu,hv,hshift,hnlo,hnhi,hdlo,hdhi,helo,hehi⟩ := hzbox
      exact ⟨hd,he,hu,hv,hshift,by simpa only [Nat.cast_mul,Nat.cast_pow] using hnhi,hzG⟩
    have hn := Set.ncard_le_ncard hsub hfin
    have hR : ((lowCurve k x D E M j G).ncard:ℝ) ≤ 
        ((globalPopulation k x G).ncard:ℝ) := by exact_mod_cast hn
    refine ⟨hfin.subset hsub,?_⟩
    calc
      _ ≤ CN*x^ε := hR.trans hbound
      _ ≤ CN*x^ε*(1+frozenZ k x D E (M:ℝ)) :=
        le_mul_of_one_le_right (by positivity) hPrice
      _ ≤ C*x^ε*(1+frozenZ k x D E (M:ℝ)) :=
        mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hNC (by positivity)) (show 0 ≤ 1+frozenZ k x D E (M:ℝ) from (by norm_num : (0:ℝ) ≤ 1).trans hPrice)

private def Bihom (G : MvPolynomial (Fin 4) ℤ) (a b : ℕ) : Prop :=
  ∀ m ∈ G.support,m 0+m 1=a ∧ m 2+m 3=b
private def HighFactor (k : ℕ) (F G : MvPolynomial (Fin 4) ℤ) : Prop :=
  G∣F ∧ G ≠ 0 ∧ Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G) ∧
    ∃ α β : ℕ,1 ≤ α ∧ 1 ≤ β ∧ 2*k+1 ≤ α+k*β ∧ Bihom G α β
private def HighUnion (k : ℕ) (x D E : ℝ) (M j : ℕ)
    (F : MvPolynomial (Fin 4) ℤ) : Set Point :=
  {z | z ∈ cellK k x D E M j ∧ ∃ G,HighFactor k F G ∧ MvPolynomial.eval (integerPoint z) G=0}
private def lowRemainder (k : ℕ) (x D E : ℝ) (M j : ℕ)
    (F : MvPolynomial (Fin 4) ℤ) : Set Point :=
  {z | z ∈ cellK k x D E M j ∧ z ∉ SQ k ∧ z ∉ HighUnion k x D E M j F}

private theorem cell_finite (k : ℕ) (hk : 1 ≤ k) (x D E : ℝ)
    (M j : ℕ) (hx : 2 ≤ x) : (cellK k x D E M j).Finite := by
  have hInt := originalIntegerCell_finite k hk x D E (M:ℝ) (rhoK D E M j) hx 0
  have hNat := Set.Finite.of_injOn
    (originalNaturalCell_maps k x D E (M:ℝ) (rhoK D E M j) 0)
    integerPoint_injective.injOn hInt
  apply hNat.subset
  intro z hz
  obtain ⟨hzbox,hrlo,hrhi⟩ := hz
  obtain ⟨hd,he,hu,hv,hshift,hnlo,hnhi,hdlo,hdhi,helo,hehi⟩ := hzbox
  exact ⟨hd,he,hu,hv,hnhi,hdlo,hdhi,helo,hehi,hrlo,hrhi,hshift,by simp⟩

private theorem low_band_product_power
    (k : ℕ) (hk : 5 ≤ k) (x s D E : ℝ)
    (hx : 2 ≤ x) (hs : sK k ≤ s) (hDE : D*E=x^s) :
    x ≤ (D*E)^k := by
  have hk0 : 0 < (k:ℝ) := by exact_mod_cast (show 0 < k by omega)
  have hs' := (sK_lower k hk).trans hs
  have hsk : 1 ≤ s*(k:ℝ) := by
    have hh := mul_le_mul_of_nonneg_right hs' hk0.le
    have hc : (1/(k:ℝ))*(k:ℝ)=1 := by field_simp [ne_of_gt hk0]
    simpa only [hc] using hh
  rw [hDE,←Real.rpow_natCast,←Real.rpow_mul (by linarith : 0 ≤ x)]
  simpa only [Real.rpow_one] using Real.rpow_le_rpow_of_exponent_le (by linarith : 1 ≤ x) hsk

private theorem subset_real_count {S T : Set Point} {B : ℝ}
    (hsub : S ⊆ T) (hfin : T.Finite) (hcard : (T.ncard:ℝ) ≤ B) :
    S.Finite ∧ (S.ncard:ℝ) ≤ B := by
  have hn := Set.ncard_le_ncard hsub hfin
  have hR : (S.ncard:ℝ) ≤ (T.ncard:ℝ) := by exact_mod_cast hn
  exact ⟨hfin.subset hsub,hR.trans hcard⟩

private theorem empty_real_count {S : Set Point} {B : ℝ}
    (hS : S=∅) (hB : 0 ≤ B) : S.Finite ∧ (S.ncard:ℝ) ≤ B := by
  rw [hS]
  exact ⟨Set.finite_empty,by simpa only [Set.ncard_empty,Nat.cast_zero] using hB⟩

private theorem low_factor_empty_of_high
    (k : ℕ) (x D E : ℝ) (M j : ℕ) (F G : MvPolynomial (Fin 4) ℤ)
    (α β : ℕ) (hdvd : G∣F) (hG0 : G ≠ 0)
    (hi : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G))
    (hα : 1 ≤ α) (hβ : 1 ≤ β) (hhigh : 2*k+1 ≤ α+k*β)
    (hbi : Bihom G α β) :
    {z | z ∈ lowRemainder k x D E M j F ∧ MvPolynomial.eval (integerPoint z) G=0}=∅ := by
  apply set_empty_of_not_mem
  intro z hz
  exact hz.1.2.2 ⟨hz.1.1,G,⟨hdvd,hG0,hi,α,β,hα,hβ,hhigh,hbi⟩,hz.2⟩

private def globalNongeom (k : ℕ) (G : MvPolynomial (Fin 4) ℤ) : Set Point :=
  {z | 1 ≤ z.1.1 ∧ 1 ≤ z.1.2 ∧ 1 ≤ z.2.1 ∧ 1 ≤ z.2.2 ∧
    ((z.1.2^k*z.2.2:ℕ):ℤ)=((z.1.1^k*z.2.1:ℕ):ℤ)+1 ∧
    MvPolynomial.eval (integerPoint z) G=0}

private theorem whole_low_old_count
    (hSt : StewartHyp) (k : ℕ) (hk : 5 ≤ k) (hk123 : k ≤ 123)
    (N : ℕ) (K ε : ℝ) (hK : 0 ≤ K) (hε : 0 < ε) :
    ∃ C X₁ : ℝ,0 < C ∧ ∀ x s δ D E : ℝ,
      X₁ ≤ x → sK k ≤ s → s ≤ 14/(9*(k:ℝ)) → 0 ≤ δ →
      0 < D → 0 < E → D*E=x^s →
      let M : ℕ := Nat.ceil (x^(m0K k s+δ))
      ∀ j ∈ cellsK D E M,∀ (F : MvPolynomial (Fin 4) ℤ) (a b : ℕ),
      F ≠ 0 → Bihom F a b → a+b ≤ N →
      (∀ m,|((F.coeff m:ℤ):ℝ)| ≤ x^K) →
      (∀ z ∈ cellK k x D E M j,MvPolynomial.eval (integerPoint z) F=0) →
      (lowRemainder k x D E M j F).Finite ∧
      ((lowRemainder k x D E M j F).ncard:ℝ) ≤ C*x^ε*(1+frozenZ k x D E (M:ℝ)) := by
  classical
  have hk1 : 1 ≤ k := by omega
  have hK' : 0 ≤ K+1 := by linarith
  obtain ⟨CH,hCH,hFactor⟩ := A8LowOldFactorJoin.integral_factor_cover N
  obtain ⟨CP,hCP,hPositive⟩ := positive_low_count hSt k hk hk123 (K+1) ε hK' hε
  obtain ⟨CN,hCN,hNongeom⟩ :=
    A8WholeLowOldNGInputs.JocelynClaims.claim_0f26f8412cd1d858f8b04b66815b88506964c0e1dc06d76e4bb136ed5c5c0394
      k hk1 (max 1 N) (le_max_left _ _)
  let A₁ : ℝ := ((4^k+1:ℕ):ℝ)
  let A₂ : ℝ := ((2800*k:ℕ):ℝ)
  let CB : ℝ := 1+CP+CN+A₁+A₂
  let C : ℝ := ((N:ℝ)+1)*CB
  have hA₁0 : 0 ≤ A₁ := by dsimp [A₁]; positivity
  have hA₂0 : 0 ≤ A₂ := by dsimp [A₂]; positivity
  have hCB : 0 < CB := by dsimp [CB]; linarith
  have hC : 0 < C := by dsimp [C]; positivity
  have hCPB : CP ≤ CB := by dsimp [CB]; linarith
  have hCNB : CN ≤ CB := by dsimp [CB]; linarith
  have hA₁B : A₁ ≤ CB := by dsimp [CB]; linarith
  have hA₂B : A₂ ≤ CB := by dsimp [CB]; linarith
  refine ⟨C,max 2 CH,hC,?_⟩
  intro x s δ D E hx hs hsup hδ hD hE hDE M j hj F a b hF0 hFbi hFab hFc hvanish
  have hx2 : 2 ≤ x := (le_max_left 2 CH).trans hx
  have hxCH : CH ≤ x := (le_max_right 2 CH).trans hx
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hxε : 1 ≤ x^ε := Real.one_le_rpow hx1 hε.le
  have hH : 1 ≤ x^K := Real.one_le_rpow hx1 hK
  have hPrice : 1 ≤ 1+frozenZ k x D E (M:ℝ) := by
    have hz : 0 ≤ frozenZ k x D E (M:ℝ) := by unfold frozenZ; positivity
    linarith
  have hBudget : 0 ≤ CB*x^ε*(1+frozenZ k x D E (M:ℝ)) := by positivity
  have hconstant (A : ℝ) (hAB : A ≤ CB) :
      A ≤ CB*x^ε*(1+frozenZ k x D E (M:ℝ)) := by
    calc
      A ≤ CB := hAB
      _ ≤ CB*x^ε := le_mul_of_one_le_right hCB.le hxε
      _ ≤ CB*x^ε*(1+frozenZ k x D E (M:ℝ)) :=
        le_mul_of_one_le_right (by positivity) hPrice
  have hprod := low_band_product_power k hk x s D E hx2 hs hDE
  obtain ⟨n,Gs,dg,hn,hdiv,hirr,hbih,hdeg,hcover,hheight,hclass⟩ :=
    hFactor (x^K) F a b hH hF0 hFab hFbi hFc
  have hHeights (i : Fin n) (m : Fin 4→₀ℕ) :
      |(((Gs i).coeff m:ℤ):ℝ)| ≤ x^(K+1) :=
    (hheight i m).trans (A8LowOldFactorJoin.absorb_factor_height CH x K hCH hxCH hx2)
  let L := lowRemainder k x D E M j F
  let T : Fin n→Set Point := fun i => {z | z ∈ L ∧ MvPolynomial.eval (integerPoint z) (Gs i)=0}
  have hcellfin := cell_finite k hk1 x D E M j hx2
  have hLfin : L.Finite := hcellfin.subset (fun z hz => hz.1)
  have hTfin (i : Fin n) : (T i).Finite := hLfin.subset (fun z hz => hz.1)
  have hsumdeg (i : Fin n) : (dg i).1+(dg i).2 ≤  max 1 N :=
    ((Nat.add_le_add (hdeg i).1 (hdeg i).2).trans hFab).trans (le_max_right _ _)
  have hpositive (i : Fin n) (hα : 1 ≤ (dg i).1) (hβ : 1 ≤ (dg i).2) :
      (T i).Finite ∧ ((T i).ncard:ℝ) ≤ CB*x^ε*(1+frozenZ k x D E (M:ℝ)) := by
    by_cases hi : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) (Gs i))
    · by_cases hhigh : 2*k+1 ≤ (dg i).1+k*(dg i).2
      · exact empty_real_count
          (low_factor_empty_of_high k x D E M j F (Gs i) (dg i).1 (dg i).2
            (hdiv i) (hirr i).ne_zero hi hα hβ hhigh (hbih i)) hBudget
      · have hbelow : (dg i).1+k*(dg i).2 < 2*k+1 := lt_of_not_ge hhigh
        obtain ⟨hβone,hαk⟩ :=
          A8LowOldFactorJoin.low_positive_degree k (dg i).1 (dg i).2 hk1 hα hβ hbelow
        have hbi1 : Bihom (Gs i) (dg i).1 1 := by simpa only [Bihom,hβone] using hbih i
        obtain ⟨hfin,hbound⟩ := hPositive x s δ D E hx2 hs hsup hδ hD hE hDE j hj
          (dg i).1 hα hαk (Gs i) (hirr i).ne_zero hbi1 hi (hHeights i)
        have hsub : T i ⊆ lowCurve k x D E M j (Gs i) :=
          fun z hz => ⟨hz.1.1,hz.1.2.1,hz.2⟩
        have hh := subset_real_count hsub hfin hbound
        exact ⟨hh.1,hh.2.trans
          (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hCPB (by positivity)) (by linarith))⟩
    · have hh := hNongeom (dg i).1 (dg i).2 (by omega) (hsumdeg i) (Gs i) (hbih i)
        (hirr i) hi 1 (Or.inl rfl)
      change (globalNongeom k (Gs i)).Finite ∧ ((globalNongeom k (Gs i)).ncard:ℝ) ≤ CN at hh
      have hsub : T i ⊆ globalNongeom k (Gs i) := by
        intro z hz
        obtain ⟨hzL,hzG⟩ := hz
        obtain ⟨hzcell,hzSQ,hzHigh⟩ := hzL
