def gG (k:ℕ):wC:=X 1^k*X 3-X 0^k*X 2
def b4 (k:ℕ) (p:wG) (M:ℕ):wC:= ∑ m∈ p.support,C (coeff m p)*X 0^(m 0)*X 1^(m 1)*(gG k)^(m 2)*X 3^(M-m 2)
lemma pm (k:ℕ) (p:wG) (M:ℕ):
    dehom (b4 k p M)=sub k p:=by
  classical
  unfold b4
  rw [map_sum]
  conv_rhs=> rw [p.as_sum,map_sum]
  apply u4 rfl
  intro m hm
  have hs:sub k (monomial m (coeff m p))= C (coeff m p)*X 0^(m 0)*X 1^(m 1)*(X 1^k-X 0^k*X 2)^(m 2):=by
    change eval₂ C ![X 0,X 1,X 1^k-X 0^k*X 2] (monomial m (coeff m p))=_
    rw [eval₂_monomial]
    simp [bg,Fin.prod_univ_succ,aG]
  rw [hs]
  simp [dehom,gG,aG]
variable {K:Type*} [Field K] [Algebra ℚ K]
def wR (d e u v:K):wC→ₐ[ℚ] K:=aeval ![d,e,u,v]
lemma pn (k:ℕ) (p:wG) (M:ℕ)
    (hM:∀ m∈ p.support,m 2≤ M)
    (d e u v:K) (hv:v ≠ 0):
    wR d e u v (b4 k p M)= v^M*ao.eta d e ((e^k*v-d^k*u)/v) p:=by
  classical
  unfold b4
  rw [map_sum]
  conv_rhs=> rw [p.as_sum,map_sum,cD]
  apply u4 rfl
  intro m hm
  have hmc:=hM m hm
  have hpow:v^M=v^(m 2)*v^(M-m 2):=by
    rw [←pow_add,Nat.add_sub_of_le hmc]
  simp [wR,ao.eta,gG,aeval_def,eval₂_monomial,bg,Fin.prod_univ_succ,div_pow]
  rw [hpow]
  have jv:v^(m 2)*(v^(m 2))⁻¹=1:= mul_inv_cancel₀ (u5 _ hv)
  field_simp [hv]
end
