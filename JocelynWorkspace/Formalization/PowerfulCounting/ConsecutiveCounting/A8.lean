theorem original_integer_affine_height_value
    (k : ℕ) (hk : 2≤k) (P Q : MvPolynomial (Fin 2) ℤ)
    (hP : P.IsHomogeneous (k+1)) (hQ : Q.IsHomogeneous (k+1))
    (a b c d0 e0 h ell : ℤ) (ha : a≠0) (hb : b≠0) (hc : c≠0) (hell : ell≠0)
    (hno : ∀ w : Fin 2 → ℂ,w≠0 →
      MvPolynomial.eval w (P.map (Int.castRingHom ℂ))=0 →
      MvPolynomial.eval w (Q.map (Int.castRingHom ℂ))=0 → False)
    (hres : MvPolynomial.X (1:Fin 2)^k*P-MvPolynomial.X (0:Fin 2)^k*Q =
      MvPolynomial.C c*(MvPolynomial.C a*MvPolynomial.X (0:Fin 2)+
        MvPolynomial.C b*MvPolynomial.X (1:Fin 2))^(2*k+1))
    (hlevel : a*d0+b*e0=ell) :
    let Qr := Q.map (Int.castRingHom ℝ)
    let dp : Polynomial ℝ := C ((ell:ℝ)/(a:ℝ))*X
    let ep : Polynomial ℝ := C ((ell:ℝ)/(b:ℝ))*(1-X)
    let phi := MvPolynomial.eval₂Hom Polynomial.C ![dp,ep]
    let F : Polynomial ℝ := C (1/((c:ℝ)*(ell:ℝ)^(2*k+1)))*(dp^k*phi Qr)
    let z0 : ℝ := (a:ℝ)*(d0:ℝ)/(ell:ℝ)
    let gamma : ℝ := (a:ℝ)*(b:ℝ)*(h:ℝ)/(ell:ℝ)
    let N := F.comp (C z0+C gamma*X)
    ∀ d e u v y : ℤ,
      d=d0+b*h*y → e=e0-a*h*y →
      e^k*v-d^k*u=1 →
      MvPolynomial.eval ![d,e] P*u=MvPolynomial.eval ![d,e] Q*v →
      N.eval (y:ℝ)=(d:ℝ)^k*(u:ℝ) := by
  intro Qr dp ep phi F z0 gamma N d e u v y hd he hunit hgraph
  have hellR : (ell:ℝ)≠0 := by exact_mod_cast hell
  obtain ⟨hK,hdeg,htop,hlam,hpoint,haffine⟩ :=
    integer_pure_height_physical_data k hk P Q hP hQ a b c (ell:ℝ)
      ha hb hc hellR hno hres
  have hlevelR : (a:ℝ)*(d:ℝ)+(b:ℝ)*(e:ℝ)=(ell:ℝ) := by
    have hh : a*d+b*e=ell := by rw [hd,he];linear_combination hlevel
    exact_mod_cast hh
  have hunitR : (e:ℝ)^k*(v:ℝ)-(d:ℝ)^k*(u:ℝ)=1 := by exact_mod_cast hunit
  have hgraphR :
      MvPolynomial.eval ![(d:ℝ),(e:ℝ)] (P.map (Int.castRingHom ℝ))*(u:ℝ)=
      MvPolynomial.eval ![(d:ℝ),(e:ℝ)] Qr*(v:ℝ) := by
    have hpmap :
        MvPolynomial.eval ![(d:ℝ),(e:ℝ)] (P.map (Int.castRingHom ℝ))=
          (MvPolynomial.eval ![d,e] P:ℝ) := by
      simpa using eval_int_map (Int.castRingHom ℝ) d e P
    have hqmap :
        MvPolynomial.eval ![(d:ℝ),(e:ℝ)] Qr=
          (MvPolynomial.eval ![d,e] Q:ℝ) := by
      simpa [Qr] using eval_int_map (Int.castRingHom ℝ) d e Q
    rw [hpmap,hqmap]
    exact_mod_cast hgraph
  have hvalue := hpoint (d:ℝ) (e:ℝ) (u:ℝ) (v:ℝ) hlevelR hunitR hgraphR
  change F.eval ((a:ℝ)*(d:ℝ)/(ell:ℝ))=(d:ℝ)^k*(u:ℝ) at hvalue
  have hz : z0+gamma*(y:ℝ)=(a:ℝ)*(d:ℝ)/(ell:ℝ) := by
    rw [hd]
    dsimp only [z0,gamma]
    push_cast
    ring
  simpa only [N,Polynomial.eval_comp,Polynomial.eval_add,Polynomial.eval_C,
    Polynomial.eval_mul,Polynomial.eval_X,hz] using hvalue

end
end A8FloorExt

