    apply Ideal.span_le.mpr
    intro a ha
    simp only [Set.mem_insert_iff,Set.mem_singleton_iff] at ha
    rcases ha with rfl | rfl
    · have h:=congrArg (fun h:wC→+*Loc g f=> h g) (gA g f)
      change phi g f (wM g)=0
      simp only [RingHom.comp_apply] at h
      rw [h]
      change algebraMap (wD g) (Loc g f) (wE g g)=0
      have hg0:wE g g=0:=Ideal.Quotient.eq_zero_iff_mem.mpr
        (Ideal.subset_span (by simp))
      rw [hg0,map_zero]
    · change phi g f (X 4*wM f-1)=0
      have hf:=congrArg (fun h:wC→+*Loc g f=> h f) (gA g f)
      simp only [RingHom.comp_apply] at hf
      rw [map_sub,map_mul,map_one,hf]
      simp [phi]
      have hh:=IsLocalization.Away.mul_invSelf (S:=Loc g f) (wE g f)
      simpa only [b2,RingHom.comp_apply,mul_comm,sub_eq_zero] using hh)
lemma oM (g f:wC):uX (wN g f):=by
  have hinv:∀ a:Inc g f,back g f (wN g f a)=a:=by
    intro a
    refine Quotient.inductionOn a ?_
    intro p
    exact congrArg (fun h:Five→+*Inc g f=> h p) (oL g f)
  intro a b h
  have hh:=congrArg (back g f) h
  simpa only [hinv] using hh
lemma oN (g f:wC) (hg:uZ g) (hf:¬g∣f):
    IsDomain (Inc g f):=by
  let:(dI g).IsPrime:= (Ideal.span_singleton_prime hg.ne_zero).mpr hg.prime
  let:IsDomain (wD g):=inferInstance
  have hf0:wE g f ≠ 0:=by
    intro h
    exact hf (Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp h))
  let:IsDomain (Loc g f):=by
    apply IsLocalization.isDomain_of_le_nonZeroDivisors (R:=wD g)
      (M:=Submonoid.powers (wE g f)) (Loc g f)
    intro r hr
    obtain ⟨n,rfl⟩:=hr
    exact mem_nonZeroDivisors_iff_ne_zero.mpr (u5 n hf0)
  exact Function.Injective.isDomain (wN g f) (oM g f)
