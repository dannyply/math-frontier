namespace A8FloorExt

theorem compact_physical_switch
    (k : ℕ) (hk : 2≤k) (c1 c2 C1 : ℝ)
    (hc1 : 0<c1) (hc2 : 0<c2) (hC1 : 0<C1)
    (T : Set (ℝ×ℝ×ℝ)) (hT : IsCompact T)
    (hmargin : ∀ w∈T,
      0<floor_sigma k w ∧ 0<floor_tau k w ∧ 0<floor_omega k w ∧
      0≤((k:ℝ)+2)*w.2.2+((k:ℝ)+1)*w.2.1-w.1-1) :
    ∃ CI CII X0 : ℝ,0<CI ∧ 0<CII ∧ 2≤X0 ∧
    ∀ x : ℝ,X0≤x →
    ∀ s m b : ℝ,(s,m,b)∈T →
    ∀ A Z M L H Q G J : ℝ,
      0<A → 0<Z → 0<M → 1≤L → 1≤H → 1≤Q →
      Z=x^s → M=x^m → G=A*H/L → J=Q/(H*A^(k+1)) →
    let R := Real.sqrt (A*Z)/(4*L)
    Z/(M*L*H)≤x^b ∨
    (x≤c2*R^(2*k-1) ∧
      Real.sqrt (x/(c2*G^2*R^(2*k-3)))≤CII*x^b) ∨
    (Z/M*Q^(1/((k+1:ℕ):ℝ))*H^(-(1/((k+1:ℕ):ℝ)))*
      L^(-(((3*k+2:ℕ):ℝ)/((k+1:ℕ):ℝ)))≤x^b) ∨
    (C1≤J*R^2 ∧ C1*x≤J*R^(2*k+1) ∧
      x/(c1*J*G*R^(2*k))≤CI*x^b) := by
  obtain ⟨delta,hd,hdelta⟩ := compact_forcing_margin k T hT
    (fun w hw => ⟨(hmargin w hw).1,(hmargin w hw).2.1,(hmargin w hw).2.2.1⟩)
  let t : ℝ := (k:ℝ)
  let cost1 := Real.log C1+2*Real.log 4
  let cost2 := Real.log C1+(2*t+1)*Real.log 4
  let costII := (2*t-1)*Real.log 4-Real.log c2
  let cost := max cost1 (max cost2 costII)
  obtain ⟨X0,hX0,hthreshold⟩ := uniform_log_threshold delta cost hd
  let KI := 2*t*Real.log 4-Real.log c1
  let KII := (2*t-3)/2*Real.log 4-Real.log c2/2
  refine ⟨Real.exp KI,Real.exp KII,X0,Real.exp_pos _,Real.exp_pos _,hX0,?_⟩
  intro x hx s m b hw A Z M L H Q G J hA hZ hM hL1 hH1 hQ1 hZeq hMeq hG hJ R
  have hx2 : 2≤x := hX0.trans hx
  have hx1 : 1<x := by linarith
  have hxp : 0<x := by linarith
  have hX : 0<Real.log x := Real.log_pos hx1
  have hL : 0<L := by linarith
  have hH : 0<H := by linarith
  have hQ : 0<Q := by linarith
  let alpha := Real.log A/Real.log x
  let ell := Real.log L/Real.log x
  let eta := Real.log H/Real.log x
  let q := Real.log Q/Real.log x
  have hlogA : Real.log A=alpha*Real.log x := by
    dsimp [alpha]
    rw [div_mul_cancel₀ _ hX.ne']
  have hlogL : Real.log L=ell*Real.log x := by
    dsimp [ell]
    rw [div_mul_cancel₀ _ hX.ne']
  have hlogH : Real.log H=eta*Real.log x := by
    dsimp [eta]
    rw [div_mul_cancel₀ _ hX.ne']
  have hlogQ : Real.log Q=q*Real.log x := by
    dsimp [q]
    rw [div_mul_cancel₀ _ hX.ne']
  have hlogZ : Real.log Z=s*Real.log x := by
    rw [hZeq,floor_log_rpow_pos x s hxp]
  have hlogM : Real.log M=m*Real.log x := by
    rw [hMeq,floor_log_rpow_pos x m hxp]
  have hell : 0≤ell := div_nonneg (Real.log_nonneg hL1) hX.le
  have heta : 0≤eta := div_nonneg (Real.log_nonneg hH1) hX.le
  have hq : 0≤q := div_nonneg (Real.log_nonneg hQ1) hX.le
  have hbound := hthreshold x hx
  have hcost1 : Real.log C1+2*Real.log 4≤delta*Real.log x :=
    (le_max_left cost1 (max cost2 costII)).trans hbound
  have hcost2 : Real.log C1+(2*(k:ℝ)+1)*Real.log 4≤delta*Real.log x :=
    ((le_max_left cost2 costII).trans (le_max_right cost1 (max cost2 costII))).trans hbound
  have hcostII : (2*(k:ℝ)-1)*Real.log 4-Real.log c2≤delta*Real.log x :=
    ((le_max_right cost2 costII).trans (le_max_right cost1 (max cost2 costII))).trans hbound
  have htransport := physical_log_branch_transport k hk x A Z L H Q c1 c2 C1 G J s b
    alpha ell eta q delta hx1 hA hZ hL hH hQ hc1 hc2 hC1 hG hJ
    hlogA hlogZ hlogL hlogH hlogQ hcost1 hcost2 hcostII
  obtain ⟨hds,hdt,hdo⟩ := hdelta (s,m,b) hw
  have ht : 2≤t := by dsimp [t];exact_mod_cast hk
  have ht1 : 0<t+1 := by linarith
  have hlogB : Real.log (x^b)=b*Real.log x := floor_log_rpow_pos x b hxp
  have hswitch := free_exponent_switch t s m b alpha ell eta q ht hell heta hq
  rcases hswitch with hgeom | hII | hroot | hI
  · left
    have hloggeom : Real.log (Z/(M*L*H))=
        (s-m-ell-eta)*Real.log x := by
      rw [Real.log_div (ne_of_gt hZ) (by positivity : M*L*H≠0),
        Real.log_mul (by positivity : M*L≠0) (ne_of_gt hH),
        Real.log_mul (ne_of_gt hM) (ne_of_gt hL),hlogZ,hlogM,hlogL,hlogH]
      ring
    have hp : s-m-ell-eta≤b := by linarith only [hgeom]
    apply floor_le_of_log_le _ _ (by positivity) (by positivity)
    rw [hloggeom,hlogB]
    exact mul_le_mul_of_nonneg_right hp hX.le
  · right;left
    exact htransport.2 (lt_of_le_of_lt hdo hII.1) hII.2
  · right;right;left
    let rr : ℝ := 1/((k+1:ℕ):ℝ)
    let ww : ℝ := ((3*k+2:ℕ):ℝ)/((k+1:ℕ):ℝ)
    have hcast1 : ((k+1:ℕ):ℝ)=t+1 := by dsimp [t];push_cast;ring
    have hcast3 : ((3*k+2:ℕ):ℝ)=3*t+2 := by dsimp [t];push_cast;ring
    have hlogroot :
        Real.log (Z/M*Q^rr*H^(-rr)*L^(-ww))=
        (s-m+(q-eta-(3*t+2)*ell)/(t+1))*Real.log x := by
      rw [Real.log_mul (by positivity : Z/M*Q^rr*H^(-rr)≠0) (by positivity : L^(-ww)≠0),
        Real.log_mul (by positivity : Z/M*Q^rr≠0) (by positivity : H^(-rr)≠0),
        Real.log_mul (by positivity : Z/M≠0) (by positivity : Q^rr≠0),
        Real.log_div (ne_of_gt hZ) (ne_of_gt hM),
        floor_log_rpow_pos Q rr hQ,floor_log_rpow_pos H (-rr) hH,
        floor_log_rpow_pos L (-ww) hL,hlogZ,hlogM,hlogQ,hlogH,hlogL]
      dsimp only [rr,ww]
      rw [hcast1,hcast3]
      ring
    have hp : s-m+(q-eta-(3*t+2)*ell)/(t+1)≤b := by
      have hh : (q-eta-(3*t+2)*ell)/(t+1)≤b-s+m := by
        apply (div_le_iff₀ ht1).2
        nlinarith only [hroot]
      linarith only [hh]
    apply floor_le_of_log_le _ _ (by positivity) (by positivity)
    rw [hlogroot,hlogB]
    exact mul_le_mul_of_nonneg_right hp hX.le
  · right;right;right
    have hp : 1+(2*t+1)*ell-q-t*s≤b := by
      have hn := (hmargin (s,m,b) hw).2.2.2
      have hh := hI.2.2
      linarith only [hh,hn]
    exact htransport.1 (lt_of_le_of_lt hds hI.1) (lt_of_le_of_lt hdt hI.2.1) hp

end A8FloorExt

