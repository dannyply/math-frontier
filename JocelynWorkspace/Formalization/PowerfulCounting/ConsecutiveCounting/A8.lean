theorem original_positive_population_finite (k : ℕ) (hk : 1≤k) (x : ℝ) :
    ({z : (ℕ×ℕ)×(ℕ×ℕ) |
      1≤z.1.1 ∧ 1≤z.1.2 ∧ 1≤z.2.1 ∧ 1≤z.2.2 ∧
      z.1.2^k*z.2.2=z.1.1^k*z.2.1+1 ∧
      ((z.1.1^k*z.2.1:ℕ):ℝ)≤x} : Set ((ℕ×ℕ)×(ℕ×ℕ))).Finite := by
  obtain ⟨B,hB⟩ := exists_nat_gt (x+1)
  apply (Set.finite_Iic (((B,B),(B,B)) : (ℕ×ℕ)×(ℕ×ℕ))).subset
  rintro ⟨⟨d,e⟩,⟨u,v⟩⟩ ⟨hd,he,hu,hv,hshift,hupper⟩
  change 1≤d at hd
  change 1≤e at he
  change 1≤u at hu
  change 1≤v at hv
  change e^k*v=d^k*u+1 at hshift
  change ((d^k*u:ℕ):ℝ)≤x at hupper
  push_cast at hupper
  have hdk : 1≤d^k := by
    have hh := pow_pos (by omega : 0<d) k
    omega
  have hek : 1≤e^k := by
    have hh := pow_pos (by omega : 0<e) k
    omega
  have hdn : d≤d^k*u := by
    have hd' := Nat.le_self_pow (by omega : k≠0) d
    nlinarith
  have hun : u≤d^k*u := by nlinarith
  have hen : e≤e^k*v := by
    have he' := Nat.le_self_pow (by omega : k≠0) e
    nlinarith
  have hvn : v≤e^k*v := by nlinarith
  have hebound : ((e^k*v:ℕ):ℝ)≤x+1 := by
    rw [hshift]
    push_cast
    linarith
  have hbound : ∀ n : ℕ, ((n:ℝ)≤x+1) → n≤B := by
    intro n hn
    have hh : (n:ℝ)<B := hn.trans_lt hB
    exact (by exact_mod_cast hh : n<B).le
  change (d≤B ∧ e≤B) ∧ (u≤B ∧ v≤B)
  refine ⟨⟨hbound d ?_,hbound e ?_⟩,⟨hbound u ?_,hbound v ?_⟩⟩
  · have hh : (d:ℝ)≤((d^k*u:ℕ):ℝ) := by exact_mod_cast hdn
    push_cast at hh
    linarith
  · have hh : (e:ℝ)≤((e^k*v:ℕ):ℝ) := by exact_mod_cast hen
    exact hh.trans hebound
  · have hh : (u:ℝ)≤((d^k*u:ℕ):ℝ) := by exact_mod_cast hun
    push_cast at hh
    linarith
  · have hh : (v:ℝ)≤((e^k*v:ℕ):ℝ) := by exact_mod_cast hvn
    exact hh.trans hebound

end
