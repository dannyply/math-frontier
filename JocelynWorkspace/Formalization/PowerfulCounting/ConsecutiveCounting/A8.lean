    resultant_of_no_common_zero (k+1) (by omega) P Q hP hQ hno (x^K) hH hcoeff
  have hpow : (x^K)^(4*(k+1)) = x^L := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul hx0.le]
    congr 1
    dsimp [L]
    push_cast
    ring
  have hBcap : |(Bres : ℝ)| ≤ F*x^L := by
    simpa only [F,hpow] using hBbound
  have hvalue : ∀ d e : ℤ,
      eval ![d,e] (residual k G)=e^k*eval ![d,e] P-d^k*eval ![d,e] Q := by
    intro d e
    simp [residual,P,Q]
  have hinfo : ∀ z ∈ S,z.1.1.Coprime z.1.2 ∧
      eval ![(z.1.1 : ℤ),(z.1.2 : ℤ)] (residual k G) ≠ 0 ∧
