    rw [hb0,Polynomial.C_0,add_zero,mul_pow,←Polynomial.C_pow,
      ←mul_assoc,←Polynomial.C_mul,Polynomial.coeff_C_mul_X_pow,
      if_neg (by omega : ¬ k=α+k),Polynomial.coeff_add,hAk,zero_add,
      Polynomial.coeff_X_pow_mul',if_pos le_rfl,Nat.sub_self] at hcoeff
    have hB01 : MvPolynomial.eval ![(0:ℂ),1] B=0 := by
      rw [←C01.PcCurves.dehom_eval hB,←Polynomial.coeff_zero_eq_eval_zero]
      exact hcoeff
    have hw : (![(0:ℂ),1] : Fin 2 → ℂ) ≠ 0 := by
      intro hz
      have ht := congrFun hz 1
      simp at ht
    exact hno _ hw hA01 hB01

