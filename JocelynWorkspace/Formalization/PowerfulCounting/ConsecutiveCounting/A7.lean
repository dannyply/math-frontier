  · change |((v*a^4:ℤ):ℝ)|≤_
    simp only [Int.cast_mul,Int.cast_pow,abs_mul,abs_pow,abs_of_nonneg hvR]
    calc
      (v:ℝ) * |(a:ℝ)|^4≤V*L^4 := by gcongr
      _=L^4*V := by ring
  · change |((v*a^3*b:ℤ):ℝ)|≤_
    simp only [Int.cast_mul,Int.cast_pow,abs_mul,abs_pow,abs_of_nonneg hvR]
    calc
      (v:ℝ) * |(a:ℝ)|^3 * |(b:ℝ)|≤V*L^3*L := by gcongr
      _=L^4*V := by ring
  · change |((v*a^2*b^2:ℤ):ℝ)|≤_
    simp only [Int.cast_mul,Int.cast_pow,abs_mul,abs_pow,abs_of_nonneg hvR]
    calc
      (v:ℝ) * |(a:ℝ)|^2 * |(b:ℝ)|^2≤V*L^2*L^2 := by gcongr
      _=L^4*V := by ring
  · change |((v*a*b^3:ℤ):ℝ)|≤_
    simp only [Int.cast_mul,Int.cast_pow,abs_mul,abs_pow,abs_of_nonneg hvR]
    calc
      (v:ℝ) * |(a:ℝ)| * |(b:ℝ)|^3≤V*L*L^3 := by gcongr
      _=L^4*V := by ring
  · change |((v*b^4:ℤ):ℝ)|≤_
    simp only [Int.cast_mul,Int.cast_pow,abs_mul,abs_pow,abs_of_nonneg hvR]
    calc
      (v:ℝ) * |(b:ℝ)|^4≤V*L^4 := by gcongr
      _=L^4*V := by ring
lemma pointMap_height (A : Mat) (h : ℤ) (hsign : h=1 ∨ h= -1)
    (z : Fin 4 → ℤ) (hzv : 0≤z 3) (L V : ℝ) (hL : 0≤L)
    (hV : (z 3:ℝ)≤V) (hlambda : ∀ i : Fin 2,|((coords A z i:ℤ):ℝ)|≤L)
    (i : Fin 5) : |((pointMap A h z i:ℤ):ℝ)|≤L^4*V := by
  have h := scaledQuartic_height (z 3) (coords A z 0) (coords A z 1)
    L V hzv hL hV (hlambda 0) (hlambda 1) i
  rcases hsign with rfl|rfl <;> simpa [pointMap] using h
lemma component_degree_bound (N alpha : ℕ) (F G : FourZ)
    (hF : F≠0) (hFN : F.totalDegree≤N) (hGF : G∣F)
    (hdeg : ∀ m∈G.support,m 0+m 1=alpha ∧ m 2+m 3=2)
    (hirr : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G)) :
    alpha+2≤N := by
  have hG : G≠0 := by
    intro hz
    rw [hz,map_zero] at hirr
    exact hirr.ne_zero rfl
  obtain ⟨Q,hQ⟩ := hGF
  have hQ0 : Q≠0 := by
    intro h
    rw [h,mul_zero] at hQ
    exact hF hQ
  have hGle : G.totalDegree≤N := by
    have heq := MvPolynomial.totalDegree_mul_of_isDomain hG hQ0
    rw [←hQ] at heq
    omega
  obtain ⟨m,hm⟩ := MvPolynomial.ne_zero_iff.mp hG
  have hms : m∈G.support := MvPolynomial.mem_support_iff.mpr hm
  have htotal := MvPolynomial.le_totalDegree hms
  have hbi := hdeg m hms
  rw [Finsupp.sum_fintype _ _ (by intro i;rfl),Fin.sum_univ_four] at htotal
  omega
