private theorem height_algebra :
∀ A B c R S m z : ℝ,
  A ≠ 0 → B ≠ 0 → c ≠ 0 → m ≠ 0 →
  let d : ℝ := m * z / A
  let e : ℝ := m * (1 - z) / B
  let Qbar : ℝ :=
    e ^ 4 * ((S * d + R * e) / c) -
    126 * A ^ 4 * B ^ 5 * e ^ 5 -
    126 * A ^ 5 * B ^ 4 * d * e ^ 4 -
    84 * A ^ 6 * B ^ 3 * d ^ 2 * e ^ 3 -
    36 * A ^ 7 * B ^ 2 * d ^ 3 * e ^ 2 -
    9 * A ^ 8 * B * d ^ 4 * e -
    A ^ 9 * d ^ 5
  let K0 : ℝ := B * S - A * R + 56 * c * A ^ 5 * B ^ 5
  let kappa : ℝ := R / (c * A ^ 4 * B ^ 5) - 91
  let lambda : ℝ := K0 / (c * A ^ 5 * B ^ 5)
  d ^ 4 * Qbar / m ^ 9 =
    z ^ 4 * (-35 + 84 * z - 70 * z ^ 2 + 20 * z ^ 3) +
    z ^ 4 * (1 - z) ^ 4 * (kappa + lambda * z) := by
  intro A B c R S m z hA hB hc hm
  dsimp
  field_simp [hA, hB, hc, hm]
  ring

private theorem original_signed_point_height_formula
    (P Q : MvPolynomial (Fin 2) ℤ) (a b c A B d e u v : ℤ)
    (hP : ∀ μ ∈ P.support, μ 0 + μ 1 = 5)
    (hQ : ∀ μ ∈ Q.support, μ 0 + μ 1 = 5)
    (hc : c ≠ 0) (hab : A * a + B * b = 1)
    (hcop : ∀ R : MvPolynomial (Fin 2) ℚ,
      R ∣ MvPolynomial.map (Int.castRingHom ℚ) P →
      R ∣ MvPolynomial.map (Int.castRingHom ℚ) Q → IsUnit R)
    (hpure : MvPolynomial.X (1 : Fin 2) ^ 4 * P -
      MvPolynomial.X (0 : Fin 2) ^ 4 * Q =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ 9)
    (hunit : e ^ 4 * v - d ^ 4 * u = 1)
    (hgraph : MvPolynomial.eval ![d,e] P * u =
      MvPolynomial.eval ![d,e] Q * v)
    (ha : a ≠ 0) (hb : b ≠ 0) :
    let R : ℤ := P.coeff m41
    let S : ℤ := P.coeff m50
    let K0 : ℤ := b * S - a * R + 56 * c * a ^ 5 * b ^ 5
    let m : ℤ := a * d + b * e
    let z : ℝ := (a : ℝ) * (d : ℝ) / (m : ℝ)
    let kappa : ℝ := (R : ℝ) / ((c : ℝ) * (a : ℝ) ^ 4 * (b : ℝ) ^ 5) - 91
    let lambda : ℝ := (K0 : ℝ) / ((c : ℝ) * (a : ℝ) ^ 5 * (b : ℝ) ^ 5)
    (d : ℝ) ^ 4 * (u : ℝ) =
      z ^ 4 * (-35 + 84 * z - 70 * z ^ 2 + 20 * z ^ 3) +
      z ^ 4 * (1 - z) ^ 4 * (kappa + lambda * z) := by
  let R : ℤ := P.coeff m41
  let S : ℤ := P.coeff m50
  let K0 : ℤ := b * S - a * R + 56 * c * a ^ 5 * b ^ 5
  let m : ℤ := a * d + b * e
  let z : ℝ := (a : ℝ) * (d : ℝ) / (m : ℝ)
  let kappa : ℝ := (R : ℝ) / ((c : ℝ) * (a : ℝ) ^ 4 * (b : ℝ) ^ 5) - 91
  let lambda : ℝ := (K0 : ℝ) / ((c : ℝ) * (a : ℝ) ^ 5 * (b : ℝ) ^ 5)
  change (d : ℝ) ^ 4 * (u : ℝ) =
      z ^ 4 * (-35 + 84 * z - 70 * z ^ 2 + 20 * z ^ 3) +
      z ^ 4 * (1 - z) ^ 4 * (kappa + lambda * z)
  have hmI : m ≠ 0 := by
    simpa only [m] using
      (a7_original_signed_progression P Q a b c A B d e u v
        hP hQ hc hab hcop hpure hunit hgraph).2.1
  have hmR : (m : ℝ) ≠ 0 := by exact_mod_cast hmI
  have haR : (a : ℝ) ≠ 0 := by exact_mod_cast ha
  have hbR : (b : ℝ) ≠ 0 := by exact_mod_cast hb
  have hcR : (c : ℝ) ≠ 0 := by exact_mod_cast hc
  obtain ⟨hformP,hformQ⟩ :=
    evaluated_quintic_normal_form_from_public_support
      P Q a b c hP hQ hpure d e
  have hgraphNF : pNF a b c R S d e * u =
      qNF a b c R S d e * v := by
    simpa only [R,S,hformP,hformQ] using hgraph
  have hpureNF : e ^ 4 * pNF a b c R S d e -
      d ^ 4 * qNF a b c R S d e = c * m ^ 9 := by
    dsimp [pNF, qNF, eval5, m]
    ring
  have hqInt : qNF a b c R S d e = c * m ^ 9 * u :=
    (original_graph_values a b c d e u v
      (pNF a b c R S d e) (qNF a b c R S d e)
      hpureNF hgraphNF hunit).2
  let Qbar : ℝ :=
    (e : ℝ) ^ 4 * (((S : ℝ) * (d : ℝ) + (R : ℝ) * (e : ℝ)) / (c : ℝ)) -
    126 * (a : ℝ) ^ 4 * (b : ℝ) ^ 5 * (e : ℝ) ^ 5 -
    126 * (a : ℝ) ^ 5 * (b : ℝ) ^ 4 * (d : ℝ) * (e : ℝ) ^ 4 -
    84 * (a : ℝ) ^ 6 * (b : ℝ) ^ 3 * (d : ℝ) ^ 2 * (e : ℝ) ^ 3 -
    36 * (a : ℝ) ^ 7 * (b : ℝ) ^ 2 * (d : ℝ) ^ 3 * (e : ℝ) ^ 2 -
    9 * (a : ℝ) ^ 8 * (b : ℝ) * (d : ℝ) ^ 4 * (e : ℝ) -
    (a : ℝ) ^ 9 * (d : ℝ) ^ 5
  have hqbar : (qNF a b c R S d e : ℝ) = (c : ℝ) * Qbar := by
    dsimp [Qbar, qNF, eval5]
    push_cast
    field_simp [hcR]
    ring
  have hqR : (qNF a b c R S d e : ℝ) =
      (c : ℝ) * (m : ℝ) ^ 9 * (u : ℝ) := by
    exact_mod_cast hqInt
  have hmu : (m : ℝ) ^ 9 * (u : ℝ) = Qbar := by
    apply mul_left_cancel₀ hcR
    calc
      (c : ℝ) * ((m : ℝ) ^ 9 * (u : ℝ)) =
          (qNF a b c R S d e : ℝ) := by nlinarith [hqR]
      _ = (c : ℝ) * Qbar := hqbar
  have hu : (u : ℝ) = Qbar / (m : ℝ) ^ 9 := by
    apply (eq_div_iff (pow_ne_zero 9 hmR)).2
    nlinarith [hmu]
  have hdExpr : (d : ℝ) = (m : ℝ) * z / (a : ℝ) := by
    dsimp [z]
    field_simp [haR, hmR]
  have hmEq : (m : ℝ) = (a : ℝ) * (d : ℝ) + (b : ℝ) * (e : ℝ) := by
    dsimp [m]
    push_cast
    ring
  have heExpr : (e : ℝ) = (m : ℝ) * (1 - z) / (b : ℝ) := by
    dsimp [z]
    field_simp [hbR, hmR]
    nlinarith [hmEq]
  have hAlg := height_algebra (a : ℝ) (b : ℝ) (c : ℝ)
    (R : ℝ) (S : ℝ) (m : ℝ) z haR hbR hcR hmR
  dsimp only at hAlg
  rw [←hdExpr, ←heExpr] at hAlg
  have hKcast : (K0 : ℝ) =
      (b : ℝ) * (S : ℝ) - (a : ℝ) * (R : ℝ) +
        56 * (c : ℝ) * (a : ℝ) ^ 5 * (b : ℝ) ^ 5 := by
    dsimp [K0]
    push_cast
    ring
  have hAlg' : (d : ℝ) ^ 4 * Qbar / (m : ℝ) ^ 9 =
      z ^ 4 * (-35 + 84 * z - 70 * z ^ 2 + 20 * z ^ 3) +
      z ^ 4 * (1 - z) ^ 4 * (kappa + lambda * z) := by
    simpa only [Qbar, kappa, lambda, hKcast] using hAlg
  calc
    (d : ℝ) ^ 4 * (u : ℝ) =
        (d : ℝ) ^ 4 * (Qbar / (m : ℝ) ^ 9) := by rw [hu]
    _ = (d : ℝ) ^ 4 * Qbar / (m : ℝ) ^ 9 := by ring
    _ = _ := hAlg'

private theorem original_nat_point_height_formula
    (P Q : MvPolynomial (Fin 2) ℤ) (a b c A B : ℤ)
    (p : A7PureNineOriginalCount.Point)
    (x D E M rho Ccell : ℝ)
    (hP : ∀ μ ∈ P.support, μ 0 + μ 1 = 5)
    (hQ : ∀ μ ∈ Q.support, μ 0 + μ 1 = 5)
    (hc : c ≠ 0) (hab : A * a + B * b = 1)
    (hcop : ∀ R : MvPolynomial (Fin 2) ℚ,
      R ∣ MvPolynomial.map (Int.castRingHom ℚ) P →
      R ∣ MvPolynomial.map (Int.castRingHom ℚ) Q → IsUnit R)
    (hpure : MvPolynomial.X (1 : Fin 2) ^ 4 * P -
      MvPolynomial.X (0 : Fin 2) ^ 4 * Q =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ 9)
    (hp : A7PureNineOriginalCount.OriginalCellPoint
      P Q x D E M rho Ccell p)
    (ha : a ≠ 0) (hb : b ≠ 0) :
    let R : ℤ := P.coeff m41
    let S : ℤ := P.coeff m50
    let K0 : ℤ := b * S - a * R + 56 * c * a ^ 5 * b ^ 5
    let m : ℤ := a * (p.1.1 : ℤ) + b * (p.1.2 : ℤ)
    let z : ℝ := (a : ℝ) * (p.1.1 : ℝ) / (m : ℝ)
    let kappa : ℝ := (R : ℝ) / ((c : ℝ) * (a : ℝ) ^ 4 * (b : ℝ) ^ 5) - 91
    let lambda : ℝ := (K0 : ℝ) / ((c : ℝ) * (a : ℝ) ^ 5 * (b : ℝ) ^ 5)
    (p.1.1 : ℝ) ^ 4 * (p.2.1 : ℝ) =
      z ^ 4 * (-35 + 84 * z - 70 * z ^ 2 + 20 * z ^ 3) +
      z ^ 4 * (1 - z) ^ 4 * (kappa + lambda * z) := by
  rcases hp with ⟨_,_,_,_,_,_,_,_,_,_,hunit,hgraph,_⟩
  change (p.1.2 : ℤ) ^ 4 * (p.2.2 : ℤ) -
      (p.1.1 : ℤ) ^ 4 * (p.2.1 : ℤ) = 1 at hunit
  change MvPolynomial.eval ![(p.1.1 : ℤ),(p.1.2 : ℤ)] P *
      (p.2.1 : ℤ) =
    MvPolynomial.eval ![(p.1.1 : ℤ),(p.1.2 : ℤ)] Q *
      (p.2.2 : ℤ) at hgraph
  simpa only [Int.cast_natCast] using
    (original_signed_point_height_formula
      P Q a b c A B
      (p.1.1 : ℤ) (p.1.2 : ℤ) (p.2.1 : ℤ) (p.2.2 : ℤ)
      hP hQ hc hab hcop hpure hunit hgraph ha hb)

private theorem private_height_ode :
∀ z kappa lambda : ℝ,
  let U : ℝ := -35 + 84 * z - 70 * z ^ 2 + 20 * z ^ 3
  let U1 : ℝ := 84 - 140 * z + 60 * z ^ 2
  let U2 : ℝ := -140 + 120 * z
  let G : ℝ := z ^ 4 * (1 - z) ^ 4
  let G1 : ℝ := 4 * z ^ 3 * (1 - z) ^ 3 * (1 - 2 * z)
  let G2 : ℝ :=
    12 * z ^ 2 * (1 - z) ^ 3 * (1 - 2 * z) -
    12 * z ^ 3 * (1 - z) ^ 2 * (1 - 2 * z) -
    8 * z ^ 3 * (1 - z) ^ 3
  let F : ℝ := z ^ 4 * U + (kappa + lambda * z) * G
  let F1 : ℝ := 4 * z ^ 3 * U + z ^ 4 * U1 +
    lambda * G + (kappa + lambda * z) * G1
  let F2 : ℝ := 12 * z ^ 2 * U + 8 * z ^ 3 * U1 + z ^ 4 * U2 +
    2 * lambda * G1 + (kappa + lambda * z) * G2
  let g : ℝ := 4 / z - 4 / (1 - z)
  let g1 : ℝ := -4 / z ^ 2 - 4 / (1 - z) ^ 2
  let r1 : ℝ := (U1 * (1 - z) + 4 * U) / (1 - z) ^ 5
  let r2 : ℝ := (U2 * (1 - z) ^ 2 + 8 * U1 * (1 - z) + 20 * U) / (1 - z) ^ 6
  z ≠ 0 → z ≠ 1 →
  F1 = g * F + G * (lambda + r1) ∧
  F2 - 2 * g * F1 + (g ^ 2 - g1) * F = G * r2 := by
  intro z kappa lambda
  dsimp
  intro hz0 hz1
  have h1 : 1 - z ≠ 0 := sub_ne_zero.mpr (Ne.symm hz1)
  constructor
  · field_simp [hz0, h1]
    ring
  · field_simp [hz0, h1]
    ring

private theorem private_height_F_deriv (kappa lambda z : ℝ) :
    deriv (fun t : ℝ =>
      t ^ 4 * (-35 + 84 * t - 70 * t ^ 2 + 20 * t ^ 3) +
      (kappa + lambda * t) * (t ^ 4 * (1 - t) ^ 4)) z =
    4 * z ^ 3 * (-35 + 84 * z - 70 * z ^ 2 + 20 * z ^ 3) +
    z ^ 4 * (84 - 140 * z + 60 * z ^ 2) +
    lambda * (z ^ 4 * (1 - z) ^ 4) +
    (kappa + lambda * z) * (4 * z ^ 3 * (1 - z) ^ 3 * (1 - 2 * z)) := by
  have hid : HasDerivAt (fun t : ℝ => t) 1 z := hasDerivAt_id z
  have h2 : HasDerivAt (fun t : ℝ => t ^ 2) (2 * z) z := by
    convert hid.pow 2 using 1 <;> first | rfl | (funext t; simp only [Pi.add_apply, Pi.mul_apply, Pi.sub_apply, Pi.neg_apply]; ring) | ring
  have h3 : HasDerivAt (fun t : ℝ => t ^ 3) (3 * z ^ 2) z := by
    convert hid.pow 3 using 1 <;> first | rfl | (funext t; simp only [Pi.add_apply, Pi.neg_apply]; ring) | ring
  have h4 : HasDerivAt (fun t : ℝ => t ^ 4) (4 * z ^ 3) z := by
    convert hid.pow 4 using 1 <;> first | rfl | (funext t; simp only [Pi.add_apply, Pi.neg_apply]; ring) | ring
  have hminus : HasDerivAt (fun t : ℝ => 1 - t) (-1) z := by
    convert (hasDerivAt_const z (1 : ℝ)).sub hid using 1 <;> first | rfl | (funext t; simp only [Pi.add_apply, Pi.neg_apply]; ring) | ring
  have hminus4 : HasDerivAt (fun t : ℝ => (1 - t) ^ 4)
      (-4 * (1 - z) ^ 3) z := by
    convert hminus.pow 4 using 1 <;> first | rfl | (funext t; simp only [Pi.add_apply, Pi.neg_apply]; ring) | ring
  have hG : HasDerivAt (fun t : ℝ => t ^ 4 * (1 - t) ^ 4)
      (4 * z ^ 3 * (1 - z) ^ 3 * (1 - 2 * z)) z := by
    convert h4.mul hminus4 using 1 <;> first | rfl | (funext t; simp only [Pi.add_apply, Pi.neg_apply]; ring) | ring
  have hU : HasDerivAt
      (fun t : ℝ => -35 + 84 * t - 70 * t ^ 2 + 20 * t ^ 3)
      (84 - 140 * z + 60 * z ^ 2) z := by
    convert (((hasDerivAt_const z (-35 : ℝ)).add
      (hid.const_mul 84)).add (h2.const_mul (-70))).add
      (h3.const_mul 20) using 1 <;> first | rfl | (funext t; simp only [Pi.add_apply, Pi.neg_apply]; ring) | ring
  have hAff : HasDerivAt (fun t : ℝ => kappa + lambda * t)
      lambda z := by
    convert (hasDerivAt_const z kappa).add
      (hid.const_mul lambda) using 1 <;> first | rfl | (funext t; simp only [Pi.add_apply, Pi.neg_apply]; ring) | ring
  have h : HasDerivAt
      (fun t : ℝ =>
        t ^ 4 * (-35 + 84 * t - 70 * t ^ 2 + 20 * t ^ 3) +
        (kappa + lambda * t) * (t ^ 4 * (1 - t) ^ 4))
      (4 * z ^ 3 * (-35 + 84 * z - 70 * z ^ 2 + 20 * z ^ 3) +
       z ^ 4 * (84 - 140 * z + 60 * z ^ 2) +
       lambda * (z ^ 4 * (1 - z) ^ 4) +
       (kappa + lambda * z) *
         (4 * z ^ 3 * (1 - z) ^ 3 * (1 - 2 * z))) z := by
    convert (h4.mul hU).add (hAff.mul hG) using 1 <;> first | rfl | (funext t; simp only [Pi.add_apply, Pi.neg_apply]; ring) | ring
  exact h.deriv

end A7PureNineSignedLevel

