    intro j hj
    have hjn:j ≤ n := by have := Finset.mem_range.mp hj; omega
    have hjR:(j:ℝ) ≤ n := by exact_mod_cast hjn
    have hnonneg:0 ≤ (h - (j:ℝ))/mu :=
      div_nonneg (by linarith) hmu.le
    have hf:(⌊(h - (j:ℝ))/mu⌋₊ : ℝ) ≤ (h - (j:ℝ))/mu :=
      Nat.floor_le hnonneg
    linarith
  have hsum :
      (∑ j ∈ Finset.range (n+1),((h - (j:ℝ))/mu+1)) =
        (((n:ℝ)+1)*h - (n:ℝ)*((n:ℝ)+1)/2)/mu +
          ((n:ℝ)+1) := by
    calc
      (∑ j ∈ Finset.range (n+1),((h - (j:ℝ))/mu+1)) =
          ∑ j ∈ Finset.range (n+1),(h/mu - (j:ℝ)/mu+1) := by
            apply Finset.sum_congr rfl
            intro j hj
            ring
      _ = (((n:ℝ)+1)*(h/mu) -
            (∑ j ∈ Finset.range (n+1),(j:ℝ))/mu)+((n:ℝ)+1) := by
            rw [Finset.sum_add_distrib,Finset.sum_sub_distrib]
            simp only [Finset.sum_div,Finset.sum_const,Finset.card_range,nsmul_eq_mul,
              Nat.cast_add,Nat.cast_one] ; ring
      _ = _ := by
            rw [sum_range_natCast]
            ring
  have hlast :
      (((n:ℝ)+1)*h - (n:ℝ)*((n:ℝ)+1)/2)/mu +
          ((n:ℝ)+1) ≤ h^2/(2*mu)+(1+1/mu)*h+1 := by
    have hdiff0:0 ≤
        ((h - (n:ℝ))^2+(n:ℝ))/(2*mu)+(h - (n:ℝ)) := by
      exact add_nonneg
        (div_nonneg (add_nonneg (sq_nonneg _) hn0) (by positivity))
        (sub_nonneg.mpr hn)
    have hdiff :
        h^2/(2*mu)+(1+1/mu)*h+1 -
          ((((n:ℝ)+1)*h - (n:ℝ)*((n:ℝ)+1)/2)/mu +
            ((n:ℝ)+1)) =
        ((h - (n:ℝ))^2+(n:ℝ))/(2*mu)+(h - (n:ℝ)) := by
      field_simp [ne_of_gt hmu]
      ring
    linarith
  exact hcast.trans (hrows.trans (hsum.le.trans hlast))
end A1FiniteQuantitative
namespace A1OriginalDeterminant
theorem weighted_det {I:Type*} [Fintype I] [DecidableEq I]
    (Q:Matrix I I ℝ) (w:I → ℝ)
    (hw : ∀ i,0 < w i) (hQ : ∀ i j,|Q i j| ≤ w i) :
    |Q.det| ≤ ((Fintype.card I).factorial:ℝ) * ∏ i,w i := by
  let B:Matrix I I ℝ := fun i j => Q i j/w i
  have hB : ∀ i j,|B i j| ≤ (1:ℝ) := by
    intro i j
    dsimp [B]
    rw [abs_div,abs_of_pos (hw i)]
    exact (div_le_one (hw i)).mpr (hQ i j)
  have hBd : |B.det| ≤ ((Fintype.card I).factorial:ℝ) := by
    simpa [nsmul_eq_mul] using
      (Matrix.det_le (abv := AbsoluteValue.abs) hB)
  have hmat:(Matrix.of fun i j => w i*B i j) = Q := by
    ext i j
    dsimp [B]
    field_simp [ne_of_gt (hw i)]
  have hd:Q.det = (∏ i,w i)*B.det := by
    rw [← hmat]
    exact Matrix.det_mul_column w B
  have hwprod:0 < ∏ i,w i :=
    Finset.prod_pos (fun i _ => hw i)
  rw [hd,abs_mul,abs_of_pos hwprod]
  calc
    _ ≤ (∏ i,w i)*((Fintype.card I).factorial:ℝ) :=
      mul_le_mul_of_nonneg_left hBd (le_of_lt hwprod)
    _ = _ := by ring
theorem det_expansion
    {I K:Type*} [Fintype I] [Fintype K]
    [DecidableEq I] [DecidableEq K]
    (V:Matrix I K ℝ) (C:Matrix K I ℝ) :
    (V*C).det =
      ∑ σ:I → K,
        (∏ i,V i (σ i)) *
          (Matrix.of fun i j => C (σ i) j).det := by
  have he :=
    (Matrix.detRowAlternating (n := I) (R := ℝ)).toMultilinearMap.map_sum
      (fun (i:I) (k:K) => (V i k:ℝ) • (fun j:I => C k j))
  have hrows :
      (fun i:I => ∑ k:K,
        (V i k:ℝ) • (fun j:I => C k j)) =
      (fun (i:I) (j:I) => ∑ k:K,V i k*C k j) := by
    funext i j
    simp only [Finset.sum_apply,Pi.smul_apply,smul_eq_mul]
  rw [hrows] at he
  change (Matrix.of fun i j => ∑ k,V i k*C k j).det =
    ∑ σ:I → K,
      (Matrix.of fun i j => V i (σ i)*C (σ i) j).det at he
  have hmul:V*C =
      Matrix.of (fun i j => ∑ k,V i k*C k j) := by
    ext i j
    exact Matrix.mul_apply
  rw [hmul,he]
  apply Finset.sum_congr rfl
  intro σ hσ
  exact Matrix.det_mul_column (fun i => V i (σ i))
    (Matrix.of fun i j => C (σ i) j)
theorem weighted_matrix_det
    {I K:Type*} [Fintype I] [Fintype K]
    [DecidableEq I] [DecidableEq K]
    (V:Matrix I K ℝ) (C:Matrix K I ℝ)
    (w:K → ℝ) (C₀ R:ℝ)
    (hC₀:0 < C₀) (hR:0 ≤ R)
    (hw : ∀ k,0 ≤ w k)
    (hV : ∀ i k,|V i k| ≤ w k)
    (hC : ∀ k j,|C k j| ≤ C₀)
    (hminor : ∀ σ:I → K,
      (Matrix.of fun i j => C (σ i) j).det ≠ 0 →
      (∏ i,w (σ i)) ≤ R) :
    |(V*C).det| ≤
      (Fintype.card K:ℝ) ^ (Fintype.card I) *
        ((Fintype.card I).factorial:ℝ)*C₀ ^ (Fintype.card I)*R := by
  rw [det_expansion V C]
  let H:ℝ := ((Fintype.card I).factorial:ℝ)*C₀ ^ (Fintype.card I)
  have hH:0 ≤ H := by dsimp [H]; positivity
  calc
    |∑ σ:I → K,(∏ i,V i (σ i)) *
        (Matrix.of fun i j => C (σ i) j).det|
      ≤ ∑ σ:I → K,
          |(∏ i,V i (σ i)) *
            (Matrix.of fun i j => C (σ i) j).det| :=
        Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ σ:I → K,H*R := by
      apply Finset.sum_le_sum
      intro σ hσ
      by_cases hz:(Matrix.of fun i j => C (σ i) j).det = 0
      · simpa only [hz,mul_zero,abs_zero] using (mul_nonneg hH hR)
      · have hprod :
            |∏ i,V i (σ i)| ≤ ∏ i,w (σ i) := by
          rw [Finset.abs_prod]
          exact Finset.prod_le_prod
            (fun i hi => abs_nonneg _)
            (fun i hi => hV i (σ i))
        have hdet :
            |(Matrix.of fun i j => C (σ i) j).det| ≤ H := by
          have hh := weighted_det
            (Matrix.of fun i j => C (σ i) j)
            (fun _:I => C₀)
            (fun _ => hC₀)
            (fun i j => hC (σ i) j)
          simpa [H] using hh
        rw [abs_mul]
        calc
          |∏ i,V i (σ i)| *
              |(Matrix.of fun i j => C (σ i) j).det|
            ≤ (∏ i,w (σ i))*H :=
                mul_le_mul hprod hdet (abs_nonneg _)
                  (Finset.prod_nonneg (fun i _ => hw (σ i)))
          _ ≤ R*H :=
                mul_le_mul_of_nonneg_right (hminor σ hz) hH
          _ = H*R := by ring
    _ = (Fintype.card K:ℝ) ^ (Fintype.card I) *
        ((Fintype.card I).factorial:ℝ)*C₀ ^ (Fintype.card I)*R := by
      simp [H,nsmul_eq_mul]
      ring
theorem rpow_finset_sum
    {I:Type*} [DecidableEq I]
    (s:Finset I) (X:ℝ) (hX:0 < X) (g:I → ℝ) :
    (∏ i ∈ s,X ^ g i) = X ^ (∑ i ∈ s,g i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih =>
      simp [hi,ih,Real.rpow_add hX]
theorem jet_value_bound
    (μ X Cu Cv:ℝ) (a b:ℕ)
    (hX:1 ≤ X) (hCu:0 ≤ Cu) (_hCv:0 ≤ Cv)
    (u v:ℝ)
    (hu : |u| ≤ Cu*X ^ (-μ))
    (hv : |v| ≤ Cv*X ^ (-(1:ℝ))) :
    |u ^ a*v ^ b| ≤
      Cu ^ a*Cv ^ b *
        X ^ (-(μ*(a:ℝ)+(b:ℝ))) := by
  have hXp:0 < X := lt_of_lt_of_le zero_lt_one hX
  calc
    |u ^ a*v ^ b| = |u| ^ a * |v| ^ b := by rw [abs_mul,abs_pow,abs_pow]
    _ ≤ (Cu*X ^ (-μ)) ^ a*(Cv*X ^ (-(1:ℝ))) ^ b := by
      gcongr
    _ = Cu ^ a*Cv ^ b *
        X ^ (-(μ*(a:ℝ)+(b:ℝ))) := by
      rw [mul_pow,mul_pow]
      have hU:(X ^ (-μ)) ^ a = X ^ (-(μ*(a:ℝ))) := by
        rw [← Real.rpow_natCast,← Real.rpow_mul (le_of_lt hXp)]
        congr 1
        ring
      have hV:(X ^ (-(1:ℝ))) ^ b = X ^ (-(b:ℝ)) := by
        rw [← Real.rpow_natCast,← Real.rpow_mul (le_of_lt hXp)]
        congr 1
        ring
      rw [hU,hV]
      calc
        Cu ^ a*X ^ (-(μ*(a:ℝ))) *
            (Cv ^ b*X ^ (-(b:ℝ))) =
          Cu ^ a*Cv ^ b *
            (X ^ (-(μ*(a:ℝ)))*X ^ (-(b:ℝ))) := by ring
        _ = Cu ^ a*Cv ^ b *
            X ^ (-(μ*(a:ℝ)+(b:ℝ))) := by
          rw [← Real.rpow_add hXp]
          congr 1
          ring
theorem finite_weighted_det
    {I K:Type*} [Fintype I] [Fintype K]
    [DecidableEq I] [DecidableEq K]
    (V:Matrix I K ℝ) (C:Matrix K I ℝ)
    (g c:K → ℝ) (T C₀ X:ℝ)
    (hX:1 ≤ X) (hC₀:0 < C₀)
    (hc : ∀ k,0 ≤ c k)
    (hV : ∀ i k,|V i k| ≤ c k*X ^ (-g k))
    (hC : ∀ k j,|C k j| ≤ C₀)
    (hminor : ∀ σ:I → K,
      (Matrix.of fun i j => C (σ i) j).det ≠ 0 →
      T ≤ ∑ i:I,g (σ i)) :
    |(V*C).det| ≤
      (Fintype.card K:ℝ) ^ (Fintype.card I) *
        ((Fintype.card I).factorial:ℝ)*C₀ ^ (Fintype.card I) *
        (∑ σ:I → K,∏ i:I,c (σ i))*X ^ (-T) := by
  let w:K → ℝ := fun k => c k*X ^ (-g k)
  let Ksum:ℝ := ∑ σ:I → K,∏ i:I,c (σ i)
  have hXp:0 < X := lt_of_lt_of_le zero_lt_one hX
  have hw : ∀ k,0 ≤ w k := by
    intro k
    dsimp [w]
    have hck := hc k
    positivity
  have hKterm : ∀ σ:I → K,0 ≤ ∏ i:I,c (σ i) := by
    intro σ
    exact Finset.prod_nonneg (fun i hi => hc (σ i))
  have hKsum:0 ≤ Ksum := by
    dsimp [Ksum]
    exact Finset.sum_nonneg (fun σ hσ => hKterm σ)
  have hR:0 ≤ Ksum*X ^ (-T) := by positivity
  have hprod (σ:I → K)
      (hσ:(Matrix.of fun i j => C (σ i) j).det ≠ 0) :
      (∏ i,w (σ i)) ≤ Ksum*X ^ (-T) := by
    have hweight := hminor σ hσ
    have hpow:X ^ (-(∑ i:I,g (σ i))) ≤ X ^ (-T) := by
      gcongr
    have hsingle:(∏ i:I,c (σ i)) ≤ Ksum := by
      dsimp [Ksum]
      exact Finset.single_le_sum
        (fun τ hτ => hKterm τ) (Finset.mem_univ σ)
    have hfactor :
        (∏ i,w (σ i)) =
          (∏ i:I,c (σ i)) *
            X ^ (-(∑ i:I,g (σ i))) := by
      simp only [w,Finset.prod_mul_distrib]
      rw [rpow_finset_sum (Finset.univ:Finset I) X hXp
        (fun i => -g (σ i))]
      congr 1
      simp
    rw [hfactor]
    exact mul_le_mul hsingle hpow (by positivity) hKsum
  have hh := weighted_matrix_det V C w C₀
    (Ksum*X ^ (-T)) hC₀ hR hw
    (by simpa only [w] using hV) hC hprod
  simpa [Ksum,mul_assoc] using hh
end A1OriginalDeterminant

namespace A1UniformTaylor
def normalizedGraph (F:Polynomial ℝ) (α β:ℝ) (a b:ℕ) :
    MvPolynomial (Fin 2) ℝ :=
  (MvPolynomial.C α+MvPolynomial.C β*MvPolynomial.X (0:Fin 2)) ^ a *
    (Polynomial.aeval (MvPolynomial.X (0:Fin 2):MvPolynomial (Fin 2) ℝ) F +
      MvPolynomial.X (1:Fin 2)) ^ b
def coefficientPolynomial (L:ℕ) (c:Fin (L+1) → ℝ):Polynomial ℝ :=
  ∑ n:Fin (L+1),Polynomial.monomial (n:ℕ) (c n)
theorem degreeOf_sum_le {ι:Type*} [DecidableEq ι] (s:Finset ι)
    (P:ι → MvPolynomial (Fin 2) ℝ) (i:Fin 2) (D:ℕ)
    (hP : ∀ n ∈ s,MvPolynomial.degreeOf i (P n) ≤ D) :
    MvPolynomial.degreeOf i (∑ n ∈ s,P n) ≤ D := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert n s hn ih =>
    rw [Finset.sum_insert hn]
    apply (MvPolynomial.degreeOf_add_le i _ _).trans
    exact max_le (hP n (Finset.mem_insert_self _ _))
      (ih (fun k hk => hP k (Finset.mem_insert_of_mem hk)))
theorem monomial_subst_degree (n:ℕ) (c:ℝ) :
    MvPolynomial.degreeOf (0:Fin 2)
      (Polynomial.aeval (MvPolynomial.X (0:Fin 2):MvPolynomial (Fin 2) ℝ)
        (Polynomial.monomial n c)) ≤ n ∧
    MvPolynomial.degreeOf (1:Fin 2)
      (Polynomial.aeval (MvPolynomial.X (0:Fin 2):MvPolynomial (Fin 2) ℝ)
        (Polynomial.monomial n c)) ≤ 0 := by
  rw [← Polynomial.C_mul_X_pow_eq_monomial]
  simp only [map_mul,map_pow,Polynomial.aeval_C,Polynomial.aeval_X]
  constructor
  · have hm := MvPolynomial.degreeOf_mul_le (0:Fin 2)
      (MvPolynomial.C c) (MvPolynomial.X (0:Fin 2) ^ n)
    have hp := MvPolynomial.degreeOf_pow_le (0:Fin 2)
      (MvPolynomial.X (0:Fin 2):MvPolynomial (Fin 2) ℝ) n
    exact hm.trans (by simp)
  · have hm := MvPolynomial.degreeOf_mul_le (1:Fin 2)
      (MvPolynomial.C c) (MvPolynomial.X (0:Fin 2) ^ n)
    have hp := MvPolynomial.degreeOf_pow_le (1:Fin 2)
      (MvPolynomial.X (0:Fin 2):MvPolynomial (Fin 2) ℝ) n
    have hx:MvPolynomial.degreeOf (1:Fin 2)
        (MvPolynomial.X (0:Fin 2):MvPolynomial (Fin 2) ℝ) = 0 := by
      simp [MvPolynomial.degreeOf_X]
    rw [hx,Nat.mul_zero] at hp
    exact hm.trans (by simpa using hp)
theorem coefficientPolynomial_subst_degree (L:ℕ) (c:Fin (L+1) → ℝ) :
    MvPolynomial.degreeOf (0:Fin 2)
      (Polynomial.aeval (MvPolynomial.X (0:Fin 2):MvPolynomial (Fin 2) ℝ) (coefficientPolynomial L c)) ≤ L ∧
    MvPolynomial.degreeOf (1:Fin 2)
      (Polynomial.aeval (MvPolynomial.X (0:Fin 2):MvPolynomial (Fin 2) ℝ) (coefficientPolynomial L c)) ≤ 0 := by
  classical
  simp only [coefficientPolynomial,map_sum]
  constructor
  · apply degreeOf_sum_le
    intro n hn
    exact (monomial_subst_degree n (c n)).1.trans (Nat.le_of_lt_succ n.isLt)
  · apply degreeOf_sum_le
    intro n hn
    exact (monomial_subst_degree n (c n)).2
theorem normalizedGraph_support (L:ℕ) (c:Fin (L+1) → ℝ)
    (α β:ℝ) (a b:ℕ) :
    ∀ d ∈ (normalizedGraph (coefficientPolynomial L c) α β a b).support,
      d (0:Fin 2) ≤ a+b*L ∧ d (1:Fin 2) ≤ b := by
  let F := Polynomial.aeval (MvPolynomial.X (0:Fin 2):MvPolynomial (Fin 2) ℝ) (coefficientPolynomial L c)
  let Q:MvPolynomial (Fin 2) ℝ :=
    MvPolynomial.C α+MvPolynomial.C β*MvPolynomial.X (0:Fin 2)
  have hF := coefficientPolynomial_subst_degree L c
  have hQ0:MvPolynomial.degreeOf (0:Fin 2) Q ≤ 1 := by
    apply (MvPolynomial.degreeOf_add_le _ _ _).trans
    apply max_le (by simp)
    exact (MvPolynomial.degreeOf_mul_le _ _ _).trans (by simp)
  have hQ1:MvPolynomial.degreeOf (1:Fin 2) Q ≤ 0 := by
    apply (MvPolynomial.degreeOf_add_le _ _ _).trans
    apply max_le (by simp)
    exact (MvPolynomial.degreeOf_mul_le _ _ _).trans
      (by simp [MvPolynomial.degreeOf_X])
  have hG0:MvPolynomial.degreeOf (0:Fin 2)
      (F+MvPolynomial.X (1:Fin 2)) ≤ L :=
    (MvPolynomial.degreeOf_add_le _ _ _).trans
      (max_le hF.1 (by simp [MvPolynomial.degreeOf_X]))
  have hG1:MvPolynomial.degreeOf (1:Fin 2)
      (F+MvPolynomial.X (1:Fin 2)) ≤ 1 :=
    (MvPolynomial.degreeOf_add_le _ _ _).trans (max_le (hF.2.trans (by omega)) (by simp))
  have hP0:MvPolynomial.degreeOf (0:Fin 2)
      (normalizedGraph (coefficientPolynomial L c) α β a b) ≤ a+b*L := by
    change MvPolynomial.degreeOf (0:Fin 2) (Q ^ a*(F+MvPolynomial.X 1) ^ b) ≤ _
    apply (MvPolynomial.degreeOf_mul_le _ _ _).trans
    have hqa := (MvPolynomial.degreeOf_pow_le (0:Fin 2) Q a).trans
      (Nat.mul_le_mul_left a hQ0)
    have hgb := (MvPolynomial.degreeOf_pow_le (0:Fin 2) (F+MvPolynomial.X 1) b).trans
      (Nat.mul_le_mul_left b hG0)
    simpa using Nat.add_le_add hqa hgb
  have hP1:MvPolynomial.degreeOf (1:Fin 2)
      (normalizedGraph (coefficientPolynomial L c) α β a b) ≤ b := by
    change MvPolynomial.degreeOf (1:Fin 2) (Q ^ a*(F+MvPolynomial.X 1) ^ b) ≤ _
    apply (MvPolynomial.degreeOf_mul_le _ _ _).trans
    have hqa := (MvPolynomial.degreeOf_pow_le (1:Fin 2) Q a).trans
      (Nat.mul_le_mul_left a hQ1)
    have hgb := (MvPolynomial.degreeOf_pow_le (1:Fin 2) (F+MvPolynomial.X 1) b).trans
      (Nat.mul_le_mul_left b hG1)
    simpa using Nat.add_le_add hqa hgb
  intro d hd
  exact ⟨MvPolynomial.degreeOf_le_iff.mp hP0 d hd,
    MvPolynomial.degreeOf_le_iff.mp hP1 d hd⟩
def CoeffContinuous {T:Type*} [TopologicalSpace T]
    (P:T → MvPolynomial (Fin 2) ℝ):Prop :=
  ∀ d,Continuous (fun x => MvPolynomial.coeff d (P x))
theorem coeffContinuous_const {T:Type*} [TopologicalSpace T]
    (P:MvPolynomial (Fin 2) ℝ):CoeffContinuous (fun _:T => P) := by
  intro d
  exact continuous_const
theorem coeffContinuous_C {T:Type*} [TopologicalSpace T]
    {f:T → ℝ} (hf:Continuous f) :
    CoeffContinuous (fun x => MvPolynomial.C (f x)) := by
  intro d
  classical
  by_cases hd:d = 0
  · subst d
    simpa using hf
  · simpa [MvPolynomial.coeff_C,hd,Ne.symm hd] using
      (continuous_const:Continuous (fun _:T => (0:ℝ)))
theorem coeffContinuous_add {T:Type*} [TopologicalSpace T]
    {P Q:T → MvPolynomial (Fin 2) ℝ}
    (hP:CoeffContinuous P) (hQ:CoeffContinuous Q) :
    CoeffContinuous (fun x => P x+Q x) := by
  intro d
  change Continuous (fun x => MvPolynomial.coeff d (P x+Q x))
  convert (hP d).add (hQ d) using 1
  funext x
  simp only [MvPolynomial.coeff_add,Pi.add_apply]
theorem coeffContinuous_mul {T:Type*} [TopologicalSpace T]
    {P Q:T → MvPolynomial (Fin 2) ℝ}
    (hP:CoeffContinuous P) (hQ:CoeffContinuous Q) :
    CoeffContinuous (fun x => P x*Q x) := by
  classical
  intro d
  simp_rw [MvPolynomial.coeff_mul]
  apply continuous_finsetSum
  intro p hp
  exact (hP p.1).mul (hQ p.2)
theorem coeffContinuous_pow {T:Type*} [TopologicalSpace T]
    {P:T → MvPolynomial (Fin 2) ℝ} (hP:CoeffContinuous P) (n:ℕ) :
    CoeffContinuous (fun x => P x ^ n) := by
  induction n with
  | zero => simpa using coeffContinuous_const (1:MvPolynomial (Fin 2) ℝ)
  | succ n ih =>
    simpa only [pow_succ] using coeffContinuous_mul ih hP
abbrev Parameters (L:ℕ) := ℝ × ℝ × (Fin (L+1) → ℝ)
def parameterGraph (L:ℕ) (a b:ℕ) (z:Parameters L) :
    MvPolynomial (Fin 2) ℝ :=
  normalizedGraph (coefficientPolynomial L z.2.2) z.1 z.2.1 a b
theorem parameterGraph_continuous (L a b:ℕ) :
    CoeffContinuous (parameterGraph L a b) := by
  classical
  have hα:Continuous (fun z:Parameters L => z.1) := continuous_fst
  have hβ:Continuous (fun z:Parameters L => z.2.1) :=
    continuous_fst.comp continuous_snd
  have hc (n:Fin (L+1)):Continuous (fun z:Parameters L => z.2.2 n) :=
    (continuous_apply n).comp (continuous_snd.comp continuous_snd)
  have hpoly:CoeffContinuous (fun z:Parameters L =>
      Polynomial.aeval (MvPolynomial.X (0:Fin 2):MvPolynomial (Fin 2) ℝ) (coefficientPolynomial L z.2.2)) := by
    intro d
    simp only [coefficientPolynomial,map_sum,MvPolynomial.coeff_sum]
    apply continuous_finsetSum
    intro n hn
    have hh:CoeffContinuous (fun z:Parameters L =>
        MvPolynomial.C (z.2.2 n)*MvPolynomial.X (0:Fin 2) ^ (n:ℕ)) :=
      coeffContinuous_mul (coeffContinuous_C (hc n))
        (coeffContinuous_const _)
    have heval (z:Parameters L) :
        Polynomial.aeval (MvPolynomial.X (0:Fin 2):MvPolynomial (Fin 2) ℝ)
          (Polynomial.monomial (n:ℕ) (z.2.2 n)) =
        MvPolynomial.C (z.2.2 n)*MvPolynomial.X (0:Fin 2) ^ (n:ℕ) := by
      rw [← Polynomial.C_mul_X_pow_eq_monomial,map_mul,map_pow,
        Polynomial.aeval_C,Polynomial.aeval_X]
      rfl
    simpa only [heval] using hh d
  exact coeffContinuous_mul
    (coeffContinuous_pow
      (coeffContinuous_add (coeffContinuous_C hα)
        (coeffContinuous_mul (coeffContinuous_C hβ) (coeffContinuous_const _))) a)
    (coeffContinuous_pow (coeffContinuous_add hpoly (coeffContinuous_const _)) b)
def pairExponent (i j:ℕ):Fin 2 →₀ ℕ :=
  Finsupp.single (0:Fin 2) i+Finsupp.single (1:Fin 2) j
theorem pairExponent_coordinates (d:Fin 2 →₀ ℕ) :
    d = pairExponent (d 0) (d 1) := by
  ext s
  fin_cases s <;> simp [pairExponent]
def parameterMass (L A B:ℕ) (z:Parameters L):ℝ :=
  1 + ∑ a ∈ Finset.range (A+1),∑ b ∈ Finset.range (B+1),
    ∑ i ∈ Finset.range (A+B*L+1),∑ j ∈ Finset.range (B+1),
      |MvPolynomial.coeff (pairExponent i j) (parameterGraph L a b z)|
theorem parameterMass_continuous (L A B:ℕ) :
    Continuous (parameterMass L A B) := by
  classical
  apply continuous_const.add
  apply continuous_finsetSum
  intro a ha
  apply continuous_finsetSum
  intro b hb
  apply continuous_finsetSum
  intro i hi
  apply continuous_finsetSum
  intro j hj
  exact ((parameterGraph_continuous L a b) (pairExponent i j)).abs
theorem parameterMass_pos (L A B:ℕ) (z:Parameters L) :
    0 < parameterMass L A B z := by
  unfold parameterMass
  have hs:0 ≤ ∑ a ∈ Finset.range (A+1),∑ b ∈ Finset.range (B+1),
      ∑ i ∈ Finset.range (A+B*L+1),∑ j ∈ Finset.range (B+1),
        |MvPolynomial.coeff (pairExponent i j) (parameterGraph L a b z)| :=
    Finset.sum_nonneg (fun a ha => Finset.sum_nonneg (fun b hb =>
      Finset.sum_nonneg (fun i hi => Finset.sum_nonneg (fun j hj => abs_nonneg _))))
  exact add_pos_of_pos_of_nonneg zero_lt_one hs
theorem coefficient_le_parameterMass (L A B:ℕ) (z:Parameters L)
    (a b:ℕ) (ha:a ≤ A) (hb:b ≤ B) (d:Fin 2 →₀ ℕ) :
    |MvPolynomial.coeff d (parameterGraph L a b z)| ≤ parameterMass L A B z := by
  classical
  by_cases hd:MvPolynomial.coeff d (parameterGraph L a b z) = 0
  · rw [hd,abs_zero]
    exact le_of_lt (parameterMass_pos L A B z)
  have hs := normalizedGraph_support L z.2.2 z.1 z.2.1 a b d
    (MvPolynomial.mem_support_iff.mpr hd)
  have hdi:d (0:Fin 2) ≤ A+B*L :=
    hs.1.trans (Nat.add_le_add ha (Nat.mul_le_mul_right L hb))
  have hdj:d (1:Fin 2) ≤ B := hs.2.trans hb
  have hj := Finset.single_le_sum
    (f := fun j => |MvPolynomial.coeff (pairExponent (d 0) j)
      (parameterGraph L a b z)|)
    (fun j hj => abs_nonneg _) (Finset.mem_range.mpr (show d 1 < B+1 by omega))
  have hi := Finset.single_le_sum
    (f := fun i => ∑ j ∈ Finset.range (B+1),
      |MvPolynomial.coeff (pairExponent i j) (parameterGraph L a b z)|)
    (fun i hi => Finset.sum_nonneg (fun j hj => abs_nonneg _))
    (Finset.mem_range.mpr (show d 0 < A+B*L+1 by omega))
  have hbb := Finset.single_le_sum
    (f := fun b => ∑ i ∈ Finset.range (A+B*L+1),
      ∑ j ∈ Finset.range (B+1),
        |MvPolynomial.coeff (pairExponent i j) (parameterGraph L a b z)|)
    (fun b hb => Finset.sum_nonneg (fun i hi =>
      Finset.sum_nonneg (fun j hj => abs_nonneg _)))
    (Finset.mem_range.mpr (show b < B+1 by omega))
  have haa := Finset.single_le_sum
    (f := fun a => ∑ b ∈ Finset.range (B+1),
      ∑ i ∈ Finset.range (A+B*L+1),∑ j ∈ Finset.range (B+1),
        |MvPolynomial.coeff (pairExponent i j) (parameterGraph L a b z)|)
    (fun a ha => Finset.sum_nonneg (fun b hb =>
      Finset.sum_nonneg (fun i hi => Finset.sum_nonneg (fun j hj => abs_nonneg _))))
    (Finset.mem_range.mpr (show a < A+1 by omega))
  rw [← pairExponent_coordinates d] at hj
  exact (hj.trans hi).trans ((hbb.trans haa).trans (by
    unfold parameterMass
    exact le_add_of_nonneg_left zero_le_one))
theorem uniform_coefficient_graph_bound (L A B:ℕ) (M D:ℝ)
    (hM:0 ≤ M) (hD:0 ≤ D) :
    ∃ K:ℝ,0 < K ∧
      ∀ (c:Fin (L+1) → ℝ),(∀ n,|c n| ≤ M) →
      ∀ (α β:ℝ),|α| ≤ D → |β| ≤ D →
      ∀ (a b:ℕ),a ≤ A → b ≤ B →
      ∀ d:Fin 2 →₀ ℕ,
        |MvPolynomial.coeff d (normalizedGraph (coefficientPolynomial L c) α β a b)| ≤ K := by
  classical
  let S:Set (Parameters L) :=
    Set.Icc (-D) D ×ˢ (Set.Icc (-D) D ×ˢ
      Set.Icc (fun _:Fin (L+1) => -M) (fun _ => M))
  have hS:IsCompact S := isCompact_Icc.prod (isCompact_Icc.prod isCompact_Icc)
  have hne:S.Nonempty := by
    refine ⟨(0,0,0),?_⟩
    change (-D ≤ 0 ∧ 0 ≤ D) ∧ (-D ≤ 0 ∧ 0 ≤ D) ∧
      ((fun _:Fin (L+1) => -M) ≤ 0 ∧ 0 ≤ (fun _ => M))
    exact ⟨⟨neg_nonpos.mpr hD,hD⟩,
      ⟨neg_nonpos.mpr hD,hD⟩,
      ⟨fun _ => neg_nonpos.mpr hM,fun _ => hM⟩⟩
  obtain ⟨z,hz,hmax⟩ := hS.exists_isMaxOn hne
    (parameterMass_continuous L A B).continuousOn
  refine ⟨parameterMass L A B z,?_,?_⟩
  · exact parameterMass_pos L A B z
  · intro c hc α β hα hβ a b ha hb d
    have hp:(α,β,c) ∈ S := by
      change (-D ≤ α ∧ α ≤ D) ∧ (-D ≤ β ∧ β ≤ D) ∧
        ((fun _:Fin (L+1) => -M) ≤ c ∧ c ≤ (fun _ => M))
      exact ⟨abs_le.mp hα,abs_le.mp hβ,
        ⟨fun n => (abs_le.mp (hc n)).1,fun n => (abs_le.mp (hc n)).2⟩⟩
    exact (coefficient_le_parameterMass L A B (α,β,c) a b ha hb d).trans (hmax hp)

end A1UniformTaylor
end A7Inherited

namespace A7QuarticCore
open A7Inherited
private def jetExp (p : ℕ × ℕ) : Fin 2 →₀ ℕ :=
  Finsupp.equivFunOnFinite.symm ![p.1,p.2]
private def pairWeight (m : ℝ) (p : ℕ × ℕ) : ℝ :=
  m * (p.1 : ℝ) + (p.2 : ℝ)
private theorem jetExp_injective : Function.Injective jetExp := by
  intro p q hp
  apply Prod.ext
  · simpa [jetExp] using congrArg (fun f : Fin 2 →₀ ℕ => f 0) hp
  · simpa [jetExp] using congrArg (fun f : Fin 2 →₀ ℕ => f 1) hp

private theorem pairWeight_nonneg (m : ℝ) (hm : 0 ≤ m) (p : ℕ × ℕ) :
    0 ≤ pairWeight m p := by
  dsimp [pairWeight]
  positivity

private theorem jet_count_from_max (m : ℝ) (hm : 0 < m)
    (s : Finset (ℕ × ℕ)) (w : ℝ) (hw : 0 ≤ w)
    (hmax : ∀ p ∈ s, pairWeight m p ≤ w) :
    (s.card : ℝ) ≤ (A1WeightedJet.jetCount m (w+1) : ℝ) := by
  classical
  let E : Set (Fin 2 →₀ ℕ) := {e | A1WeightedJet.weight m e < w+1}
  have hE : E.Finite := A1WeightedJet.lowJets_finite m (w+1) hm
  have hsub : s.image jetExp ⊆ hE.toFinset := by
    intro e he
    obtain ⟨p,hp,rfl⟩ := Finset.mem_image.mp he
    apply hE.mem_toFinset.mpr
    change A1WeightedJet.weight m (jetExp p) < w+1
    have hh := hmax p hp
    simpa [A1WeightedJet.weight,jetExp,pairWeight] using
      (lt_of_le_of_lt hh (by linarith : w < w+1))
  have hc : s.card ≤ hE.toFinset.card := by
    have hh := Finset.card_le_card hsub
    simpa only [Finset.card_image_of_injective s jetExp_injective] using hh
  have heq : A1WeightedJet.jetCount m (w+1) = hE.toFinset.card :=
    Set.ncard_eq_toFinset_card E hE
  rw [heq]
  exact_mod_cast hc

private theorem max_weight_lower (m : ℝ) (hm : 0 < m) (hm1 : m ≤ 1)
    (s : Finset (ℕ × ℕ)) (a : ℕ × ℕ) (ha : a ∈ s)
    (hmax : ∀ p ∈ s, pairWeight m p ≤ pairWeight m a) :
    Real.sqrt (2*m*(s.card : ℝ)) - 5 ≤ pairWeight m a := by
  let w := pairWeight m a
  have hw : 0 ≤ w := pairWeight_nonneg m hm.le a
  have hc := jet_count_from_max m hm s w hw hmax
  have ht := A1FiniteQuantitative.jetTriangleBound m (w+1) hm (by linarith)
  have hpoly :
      (w+1)^2/(2*m)+(1+1/m)*(w+1)+1 ≤ (w+5)^2/(2*m) := by
    have heq : (w+1)^2/(2*m)+(1+1/m)*(w+1)+1 =
        ((w+1)^2+2*(m+1)*(w+1)+2*m)/(2*m) := by
      field_simp [ne_of_gt hm] <;> ring
    rw [heq]
    gcongr
    nlinarith [mul_le_mul_of_nonneg_right hm1 hw]
  have hcsq : 2*m*(s.card : ℝ) ≤ (w+5)^2 := by
    have hh := hc.trans (ht.trans hpoly)
    have hh' := (le_div_iff₀ (by positivity : 0 < 2*m)).mp hh
    nlinarith
  have hrs := Real.sq_sqrt (by positivity : 0 ≤ 2*m*(s.card : ℝ))
  have hr0 := Real.sqrt_nonneg (2*m*(s.card : ℝ))
  change Real.sqrt (2*m*(s.card : ℝ)) - 5 ≤ w
  by_contra hn
  have hlt : w+5 < Real.sqrt (2*m*(s.card : ℝ)) := by linarith
  nlinarith

private theorem sqrt_cost_step (n : ℕ) (hn : 1 ≤ n) :
    (2/3 : ℝ)*(n : ℝ)*Real.sqrt (n : ℝ) ≤
      (2/3 : ℝ)*((n-1 : ℕ) : ℝ)*Real.sqrt ((n-1 : ℕ) : ℝ)
        + Real.sqrt (n : ℝ) := by
  by_cases hn1 : n = 1
  · subst n
    norm_num
  have hn2 : 2 ≤ n := by omega
  have hnR : (2 : ℝ) ≤ n := by exact_mod_cast hn2
  have hcast : ((n-1 : ℕ) : ℝ) = (n : ℝ)-1 := by
    rw [Nat.cast_sub hn,Nat.cast_one]
  rw [hcast]
  let L : ℝ := (2*(n : ℝ)-3)*Real.sqrt (n : ℝ)
  let R : ℝ := 2*((n : ℝ)-1)*Real.sqrt ((n : ℝ)-1)
  have hL0 : 0 ≤ L := by
    dsimp [L]
    exact mul_nonneg (by linarith) (Real.sqrt_nonneg _)
  have hR0 : 0 ≤ R := by
    dsimp [R]
    exact mul_nonneg (mul_nonneg (by norm_num) (by linarith)) (Real.sqrt_nonneg _)
  have hsq : L^2 ≤ R^2 := by
    dsimp [L,R]
    rw [mul_pow,mul_pow,Real.sq_sqrt (by positivity : 0 ≤ (n : ℝ)),
      Real.sq_sqrt (by linarith : 0 ≤ (n : ℝ)-1)]
    nlinarith
  have hLR : L ≤ R := by
    by_contra h
    have hgt : R < L := lt_of_not_ge h
    nlinarith
  dsimp [L,R] at hLR
  linarith

private theorem finite_jet_weight (m : ℝ) (hm : 0 < m) (hm1 : m ≤ 1)
    (s : Finset (ℕ × ℕ)) :
    (2*Real.sqrt (2*m)/3)*(s.card : ℝ)*Real.sqrt (s.card : ℝ)
      - 5*(s.card : ℝ) ≤ ∑ p ∈ s, pairWeight m p := by
  classical
  have aux : ∀ n : ℕ, ∀ t : Finset (ℕ × ℕ), t.card = n →
      (2*Real.sqrt (2*m)/3)*(n : ℝ)*Real.sqrt (n : ℝ)
        - 5*(n : ℝ) ≤ ∑ p ∈ t, pairWeight m p := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro t ht
      by_cases hn0 : n = 0
      · have ht0 : t = ∅ := Finset.card_eq_zero.mp (ht.trans hn0)
        simp [ht0,hn0]
      have hn : 1 ≤ n := by omega
      have hne : t.Nonempty := Finset.card_pos.mp (by omega)
      obtain ⟨a,ha,hmax⟩ := Finset.exists_max_image t (pairWeight m) hne
      have herase : (t.erase a).card = n-1 := by
        rw [Finset.card_erase_of_mem ha,ht]
      have hrec := ih (n-1) (by omega) (t.erase a) herase
      have hmaxb := max_weight_lower m hm hm1 t a ha hmax
      rw [ht] at hmaxb
      have hstep := sqrt_cost_step n hn
      have hstep' := mul_le_mul_of_nonneg_left hstep (Real.sqrt_nonneg (2*m))
      have hroot :
          Real.sqrt (2*m*(n : ℝ)) =
            Real.sqrt (2*m)*Real.sqrt (n : ℝ) :=
        Real.sqrt_mul (by positivity : 0 ≤ 2*m) (n : ℝ)
      rw [hroot] at hmaxb
      have hcast : ((n-1 : ℕ) : ℝ) = (n : ℝ)-1 := by
        rw [Nat.cast_sub hn,Nat.cast_one]
      rw [hcast] at hrec hstep'
      have hsum := Finset.sum_erase_add t (pairWeight m) ha
      nlinarith
  exact aux s.card s rfl

private theorem injective_jet_weight {I : Type*} [Fintype I] [DecidableEq I]
    (m : ℝ) (hm : 0 < m) (hm1 : m ≤ 1)
    (f : I → ℕ × ℕ) (hf : Function.Injective f) :
    (2*Real.sqrt (2*m)/3)*(Fintype.card I : ℝ)*
      Real.sqrt (Fintype.card I : ℝ)-5*(Fintype.card I : ℝ)
      ≤ ∑ i : I, pairWeight m (f i) := by
  classical
  have hh := finite_jet_weight m hm hm1 (Finset.univ.image f)
  rw [Finset.card_image_of_injective Finset.univ hf,Finset.card_univ] at hh
  rw [Finset.sum_image (fun a _ b _ hab => hf hab)] at hh
  exact hh

private theorem nonzero_rows_injective {I K : Type*}
    [Fintype I] [DecidableEq I]
    (C : K → I → ℝ) (f : I → K)
    (hdet : Matrix.det (fun i j : I => C (f i) j) ≠ 0) :
    Function.Injective f := by
  intro i j hij
  by_contra hne
  apply hdet
  exact Matrix.det_zero_of_row_eq hne (by funext k; rw [hij])

private theorem jet_evaluation_det_bound
    {I K : Type*} [Fintype I] [Fintype K]
    [DecidableEq I] [DecidableEq K]
    (V : Matrix I K ℝ) (C : Matrix K I ℝ)
    (e : K → ℕ × ℕ) (he : Function.Injective e)
    (m X C0 : ℝ) (hm : 0 < m) (hm1 : m ≤ 1)
    (hX : 1 ≤ X) (hC0 : 0 < C0)
    (hV : ∀ i k, |V i k| ≤
      (2 : ℝ)^(e k).1 * (32 : ℝ)^(e k).2 *
        X^(-pairWeight m (e k)))
    (hC : ∀ k j, |C k j| ≤ C0) :
    |(V*C).det| ≤
      (Fintype.card K : ℝ)^(Fintype.card I) *
      ((Fintype.card I).factorial : ℝ) * C0^(Fintype.card I) *
      (∑ f : I → K, ∏ i : I, (2 : ℝ)^(e (f i)).1 *
        (32 : ℝ)^(e (f i)).2) *
      X^(-((2*Real.sqrt (2*m)/3)*(Fintype.card I : ℝ)*
        Real.sqrt (Fintype.card I : ℝ)-5*(Fintype.card I : ℝ))) := by
  apply A1OriginalDeterminant.finite_weighted_det V C
    (fun k => pairWeight m (e k))
    (fun k => (2 : ℝ)^(e k).1 * (32 : ℝ)^(e k).2)
    _ C0 X hX hC0
  · intro k
    positivity
  · exact hV
  · exact hC
  · intro f hf
    have hfi := nonzero_rows_injective C f hf
    exact injective_jet_weight m hm hm1 (e ∘ f) (he.comp hfi)

private theorem quartic_normalized_unit_error
    (x D E d e u v h : ℝ)
    (hx : 0 < x) (hD : 0 < D) (hE : 0 < E)
    (hd : 0 < d) (he : 0 < e) (hu : 0 < u)
    (hunit : e^4*v=d^4*u+h) (hh : |h| ≤ 1)
    (hband : x/2 < d^4*u)
    (hS : |(E/D)*(d/e)| ≤ 2) :
    |(E/D)^4*(v/u)-((E/D)*(d/e))^4| ≤ 32/x := by
  have hsmall : v/u-(d/e)^4 = h/(e^4*u) := by
    field_simp [ne_of_gt he,ne_of_gt hu]
    nlinarith [hunit]
  have hid :
      (E/D)^4*(v/u)-((E/D)*(d/e))^4 =
        h*((E/D)*(d/e))^4/(d^4*u) := by
    calc
      _ = (E/D)^4*(v/u-(d/e)^4) := by rw [mul_pow]; ring
      _ = (E/D)^4*(h/(e^4*u)) := by rw [hsmall]
      _ = _ := by
        field_simp [ne_of_gt hD,ne_of_gt hd,ne_of_gt he,ne_of_gt hu] <;> ring
  have hden : 0 < d^4*u := mul_pos (pow_pos hd _) hu
  have hnum : |h| * |(E/D)*(d/e)| ^4 ≤ 16 := by
    calc
      _ ≤ (1 : ℝ)*2^4 := by gcongr
      _ = 16 := by norm_num
  rw [hid,abs_div,abs_mul,abs_pow,abs_of_pos hden]
  calc
    _ ≤ 16/(x/2) := by
      apply (div_le_div_iff₀ hden (by positivity : 0 < x/2)).mpr
      nlinarith [mul_le_mul_of_nonneg_right hnum (by positivity : 0 ≤ x/2)]
    _ = 32/x := by field_simp <;> ring

private theorem physical_entry_row_factor
    (A B : ℕ) (d e u v : ℝ)
    (he : e ≠ 0) (hu : u ≠ 0)
    (i : Fin (A+1)) (j : Fin (B+1)) :
    d^(i : ℕ)*e^(A-(i : ℕ))*v^(j : ℕ)*u^(B-(j : ℕ)) =
      e^A*u^B*((d/e)^(i : ℕ)*(v/u)^(j : ℕ)) := by
  have hi : (i : ℕ) ≤ A := Nat.lt_succ_iff.mp i.isLt
  have hj : (j : ℕ) ≤ B := Nat.lt_succ_iff.mp j.isLt
  have hpE : e^A=e^(A-(i : ℕ))*e^(i : ℕ) := by
    rw [← pow_add,Nat.sub_add_cancel hi]
  have hpU : u^B=u^(B-(j : ℕ))*u^(j : ℕ) := by
    rw [← pow_add,Nat.sub_add_cancel hj]
  rw [hpE,hpU,div_pow,div_pow]
  field_simp [he,hu] <;> ring

end A7QuarticCore

namespace A7QuarticCore
private def quarticCoeffs (c : ℝ) : Fin 5 → ℝ :=
  ![c^4,4*c^3,6*c^2,4*c,1]
private def graphPoly (c : ℝ) (i j : ℕ) : MvPolynomial (Fin 2) ℝ :=
  (MvPolynomial.C c+MvPolynomial.X 0)^i *
    ((MvPolynomial.C c+MvPolynomial.X 0)^4+MvPolynomial.X 1)^j

private theorem coefficientPolynomial_quartic (c : ℝ) :
    A7Inherited.A1UniformTaylor.coefficientPolynomial 4 (quarticCoeffs c) =
      (Polynomial.C c+Polynomial.X)^4 := by
  have diagnostic_V8_coefficientPolynomial_quartic : True := trivial
  have hC4 : Polynomial.C (4 : ℝ) = (4 : Polynomial ℝ) :=
    map_natCast (Polynomial.C : ℝ →+* Polynomial ℝ) 4
  have hC6 : Polynomial.C (6 : ℝ) = (6 : Polynomial ℝ) :=
    map_natCast (Polynomial.C : ℝ →+* Polynomial ℝ) 6
  norm_num [A7Inherited.A1UniformTaylor.coefficientPolynomial,
    quarticCoeffs,Fin.sum_univ_succ,← Polynomial.C_mul_X_pow_eq_monomial,
    map_mul,map_pow,hC4,hC6] <;> ring

private theorem graphPoly_normalized (c : ℝ) (i j : ℕ) :
    graphPoly c i j =
      A7Inherited.A1UniformTaylor.normalizedGraph
        (A7Inherited.A1UniformTaylor.coefficientPolynomial 4 (quarticCoeffs c))
        c 1 i j := by
  rw [coefficientPolynomial_quartic]
  simp [graphPoly,A7Inherited.A1UniformTaylor.normalizedGraph,
    map_pow,map_add]

private theorem graphPoly_support (c : ℝ) (i j : ℕ)
    (d : Fin 2 →₀ ℕ) (hd : d ∈ (graphPoly c i j).support) :
    d 0 ≤ i+4*j ∧ d 1 ≤ j := by
  rw [graphPoly_normalized] at hd
  have hh := A7Inherited.A1UniformTaylor.normalizedGraph_support
    4 (quarticCoeffs c) c 1 i j d hd
  simpa [Nat.mul_comm] using hh

private theorem quarticCoeffs_bound (c : ℝ) (hc0 : 0 ≤ c) (hc2 : c ≤ 2) :
    ∀ n, |quarticCoeffs c n| ≤ (100 : ℝ) := by
  have ha : |c| ≤ 2 := (abs_of_nonneg hc0).le.trans hc2
  have h2 : |c|^2 ≤ (4 : ℝ) := by
    calc
      _ ≤ (2 : ℝ)^2 := by gcongr
      _ = _ := by norm_num
  have h3 : |c|^3 ≤ (8 : ℝ) := by
    calc
      _ ≤ (2 : ℝ)^3 := by gcongr
      _ = _ := by norm_num
  have h4 : |c|^4 ≤ (16 : ℝ) := by
    calc
      _ ≤ (2 : ℝ)^4 := by gcongr
      _ = _ := by norm_num
  intro n
  fin_cases n <;> simp [quarticCoeffs,abs_mul,abs_pow] <;> nlinarith

private theorem graphPoly_uniform_coefficients (A B : ℕ) :
    ∃ K : ℝ, 0 < K ∧
      ∀ c : ℝ, 0 ≤ c → c ≤ 2 →
      ∀ i j : ℕ, i ≤ A → j ≤ B →
      ∀ d : Fin 2 →₀ ℕ, |MvPolynomial.coeff d (graphPoly c i j)| ≤ K := by
  obtain ⟨K,hK,hbound⟩ :=
    A7Inherited.A1UniformTaylor.uniform_coefficient_graph_bound
      4 A B 100 2 (by norm_num) (by norm_num)
  refine ⟨K,hK,?_⟩
  intro c hc0 hc2 i j hi hj d
  rw [graphPoly_normalized]
  exact hbound (quarticCoeffs c) (quarticCoeffs_bound c hc0 hc2)
    c 1 (by rwa [abs_of_nonneg hc0]) (by norm_num) i j hi hj d

private theorem graphPoly_eval (c a b : ℝ) (i j : ℕ) :
    MvPolynomial.eval (fun t : Fin 2 => if t = 0 then a else b)
      (graphPoly c i j) = (c+a)^i*((c+a)^4+b)^j := by
  simp [graphPoly]

end A7QuarticCore

namespace A7QuarticCore
open A7Inherited
private abbrev Cols (A B : ℕ) := Fin (A+1) × Fin (B+1)
private def jetBox (A B : ℕ) : Finset (ℕ × ℕ) :=
  (Finset.range (A+4*B+1)).product (Finset.range (B+1))
private def exponentPair (d : Fin 2 →₀ ℕ) : ℕ × ℕ := (d 0,d 1)
private theorem exponentPair_injective : Function.Injective exponentPair := by
  intro d e h
  have h0 := congrArg Prod.fst h
  have h1 := congrArg Prod.snd h
  ext i
  fin_cases i
  · exact h0
  · exact h1
private theorem jetExp_pair (d : Fin 2 →₀ ℕ) :
    jetExp (exponentPair d) = d := by
  ext i
  fin_cases i <;> simp [jetExp,exponentPair]
private theorem pair_jetExp (p : ℕ × ℕ) :
    exponentPair (jetExp p) = p := by
  ext <;> simp [jetExp,exponentPair]

private theorem polynomial_evaluation_box (A B : ℕ)
    (P : MvPolynomial (Fin 2) ℝ) (a b : ℝ)
    (hsupport : ∀ d ∈ P.support, d 0 ≤ A+4*B ∧ d 1 ≤ B) :
    MvPolynomial.eval (fun i : Fin 2 => if i = 0 then a else b) P =
      ∑ p : {p : ℕ × ℕ // p ∈ jetBox A B},
        a^p.val.1*b^p.val.2*MvPolynomial.coeff (jetExp p.val) P := by
  classical
  let S := P.support.image exponentPair
  let term : ℕ × ℕ → ℝ := fun p =>
    MvPolynomial.coeff (jetExp p) P*a^p.1*b^p.2
  have heval :
      MvPolynomial.eval (fun i : Fin 2 => if i = 0 then a else b) P =
        ∑ d ∈ P.support, MvPolynomial.coeff d P*a^(d 0)*b^(d 1) := by
    rw [MvPolynomial.eval_eq']
    apply Finset.sum_congr rfl
    intro d hd
    simp [Fin.prod_univ_two,mul_assoc]
  have hS : S ⊆ jetBox A B := by
    intro p hp
    obtain ⟨d,hd,rfl⟩ := Finset.mem_image.mp hp
    have hh := hsupport d hd
    exact Finset.mem_product.mpr
      ⟨Finset.mem_range.mpr (by simpa [exponentPair] using Nat.lt_succ_of_le hh.1),
       Finset.mem_range.mpr (by simpa [exponentPair] using Nat.lt_succ_of_le hh.2)⟩
  have hsumS :
      MvPolynomial.eval (fun i : Fin 2 => if i = 0 then a else b) P =
        ∑ p ∈ S, term p := by
    rw [heval]
    dsimp [S]
    rw [Finset.sum_image]
    · apply Finset.sum_congr rfl
      intro d hd
      change MvPolynomial.coeff d P*a^(d 0)*b^(d 1) =
        MvPolynomial.coeff (jetExp (exponentPair d)) P*a^(d 0)*b^(d 1)
      rw [jetExp_pair]
    · intro d hd e he hde
      exact exponentPair_injective hde
  have hext : (∑ p ∈ S,term p) = ∑ p ∈ jetBox A B,term p := by
    apply Finset.sum_subset hS
    intro p hp hnot
    have hz : MvPolynomial.coeff (jetExp p) P = 0 := by
      by_contra h
      apply hnot
      exact Finset.mem_image.mpr
        ⟨jetExp p,MvPolynomial.mem_support_iff.mpr h,pair_jetExp p⟩
    simp [term,hz]
  rw [hsumS,hext]
  have hh := Finset.sum_coe_sort (jetBox A B) term
  first
  | simpa only [term,mul_comm,mul_left_comm,mul_assoc] using hh
  | simpa only [term,mul_comm,mul_left_comm,mul_assoc] using hh.symm

private theorem normalized_quartic_determinant (A B : ℕ) :
    ∃ C : ℝ, 0 < C ∧
      ∀ c m X : ℝ, 0 ≤ c → c ≤ 2 → 0 < m → m ≤ 1 → 1 ≤ X →
      ∀ S T : Cols A B → ℝ,
        (∀ r, |S r-c| ≤ 2*X^(-m)) →
        (∀ r, |T r-(S r)^4| ≤ 32*X^(-(1 : ℝ))) →
        |Matrix.det (fun r col : Cols A B => (S r)^(col.1 : ℕ)*(T r)^(col.2 : ℕ))|
          ≤ C*X^(-((2*Real.sqrt (2*m)/3)*
            ((A+1)*(B+1) : ℕ)*Real.sqrt ((A+1)*(B+1) : ℕ)
              -5*((A+1)*(B+1) : ℕ))) := by
  classical
  let I := Cols A B
  let K := {p : ℕ × ℕ // p ∈ jetBox A B}
  obtain ⟨C0,hC0,hcoeff⟩ := graphPoly_uniform_coefficients A B
  let Ctotal : ℝ :=
    (Fintype.card K : ℝ)^(Fintype.card I) *
    ((Fintype.card I).factorial : ℝ)*C0^(Fintype.card I) *
    (∑ f : I → K, ∏ i : I, (2 : ℝ)^(f i).val.1*(32 : ℝ)^(f i).val.2)
  have hCtotal : 0 ≤ Ctotal := by
    dsimp [Ctotal]
    positivity
  refine ⟨1+Ctotal,by positivity,?_⟩
  intro c m X hc0 hc2 hm hm1 hX S T ha hb
  let V : Matrix I K ℝ := fun r p => (S r-c)^p.val.1*(T r-(S r)^4)^p.val.2
  let Cmat : Matrix K I ℝ := fun p col =>
    MvPolynomial.coeff (jetExp p.val) (graphPoly c (col.1 : ℕ) (col.2 : ℕ))
  have hC : ∀ p col, |Cmat p col| ≤ C0 := by
    intro p col
    exact hcoeff c hc0 hc2 (col.1 : ℕ) (col.2 : ℕ)
      (Nat.lt_succ_iff.mp col.1.isLt) (Nat.lt_succ_iff.mp col.2.isLt) _
  have hV : ∀ r p, |V r p| ≤
      (2 : ℝ)^p.val.1*(32 : ℝ)^p.val.2*X^(-pairWeight m p.val) := by
    intro r p
    exact A1OriginalDeterminant.jet_value_bound m X 2 32 p.val.1 p.val.2
      hX (by norm_num) (by norm_num) _ _ (ha r) (hb r)
  have hmat : V*Cmat =
      (fun r col : Cols A B => (S r)^(col.1 : ℕ)*(T r)^(col.2 : ℕ)) := by
    ext r col
    rw [Matrix.mul_apply]
    have hs : ∀ d ∈ (graphPoly c (col.1 : ℕ) (col.2 : ℕ)).support,
        d 0 ≤ A+4*B ∧ d 1 ≤ B := by
      intro d hd
      have hh := graphPoly_support c (col.1 : ℕ) (col.2 : ℕ) d hd
      exact ⟨hh.1.trans (Nat.add_le_add (Nat.lt_succ_iff.mp col.1.isLt)
        (Nat.mul_le_mul_left 4 (Nat.lt_succ_iff.mp col.2.isLt))),
        hh.2.trans (Nat.lt_succ_iff.mp col.2.isLt)⟩
    have heval := polynomial_evaluation_box A B
      (graphPoly c (col.1 : ℕ) (col.2 : ℕ)) (S r-c) (T r-(S r)^4) hs
    change (∑ p : K, (S r-c)^p.val.1*(T r-(S r)^4)^p.val.2*
      MvPolynomial.coeff (jetExp p.val) (graphPoly c (col.1 : ℕ) (col.2 : ℕ))) = _
    rw [← heval,graphPoly_eval]
    have h1 : c+(S r-c)=S r := by ring
    rw [h1]
    have h2 : (S r)^4+(T r-(S r)^4)=T r := by ring
    rw [h2]
  have hbnd := jet_evaluation_det_bound V Cmat
    (fun p : K => p.val) Subtype.val_injective
    m X C0 hm hm1 hX hC0 hV hC
  rw [hmat] at hbnd
  have hcard : Fintype.card I = (A+1)*(B+1) := by simp [I,Cols]
  simp only [hcard] at hbnd
  calc
    _ ≤ Ctotal*X^(-((2*Real.sqrt (2*m)/3)*
        ((A+1)*(B+1) : ℕ)*Real.sqrt ((A+1)*(B+1) : ℕ)
          -5*((A+1)*(B+1) : ℕ))) := by
      simpa only [Ctotal,hcard] using hbnd
    _ ≤ _ := by gcongr; linarith

end A7QuarticCore

namespace A7QuarticCore
private def mBase (s : ℝ) : ℝ :=
  (9 : ℝ)/8*s*(2-4*s)
private def chosenB (Q : ℕ) (s : ℝ) : ℕ :=
  ⌊(Q : ℝ)*s/(2-4*s)⌋₊

private theorem quartic_menu_margin
    (δ : ℝ) (hδ : 0 < δ) (hδu : δ < (1/4000 : ℝ))
    (Q : ℕ) (hQ4 : 4 ≤ Q) (hQδ : 60/δ ≤ (Q : ℝ))
    (s : ℝ) (hslo : (1/4 : ℝ) ≤ s) (hshi : s ≤ (329/1000 : ℝ)) :
    let B := chosenB Q s
    let H : ℝ := ((Q+1)*(B+1) : ℕ)
    let m := mBase s+δ
    1 ≤ B ∧ B ≤ Q ∧ 0 < m ∧ m ≤ 1 ∧
      H*((Q : ℝ)*s+(B : ℝ)*(2-4*s))/2 -
        (2*Real.sqrt (2*m)/3)*H*Real.sqrt H+5*H ≤ -2*H := by
  dsimp
  let z := 2-4*s
  let B := chosenB Q s
  let H : ℝ := ((Q+1)*(B+1) : ℕ)
  let m := mBase s+δ
  have hs0 : 0 < s := by linarith
  have hs1 : s ≤ (1/2 : ℝ) := by linarith
  have hz0 : 0 < z := by dsimp [z]; linarith
  have hz1 : z ≤ 1 := by dsimp [z]; linarith
  have hzs : z ≤ 4*s := by dsimp [z]; linarith
  have hsz : s < z := by dsimp [z]; linarith
  have hQR : (4 : ℝ) ≤ Q := by exact_mod_cast hQ4
  have hQ0 : (0 : ℝ) < Q := by linarith
  have ht0 : 0 ≤ (Q : ℝ)*s/z := div_nonneg (mul_nonneg hQ0.le hs0.le) hz0.le
  have hBfloor : (B : ℝ) ≤ (Q : ℝ)*s/z := Nat.floor_le ht0
  have hBfloor' : (Q : ℝ)*s/z < (B : ℝ)+1 := Nat.lt_floor_add_one _
  have hBz : (B : ℝ)*z ≤ (Q : ℝ)*s := (le_div_iff₀ hz0).mp hBfloor
  have hBup : (Q : ℝ)*s < ((B : ℝ)+1)*z := (div_lt_iff₀ hz0).mp hBfloor'
  have hB1 : 1 ≤ B := by
    apply (Nat.le_floor_iff ht0).mpr
    have hqs := mul_le_mul_of_nonneg_right hQR hs0.le
    apply (le_div_iff₀ hz0).mpr
    norm_num
    nlinarith
  have hBQ : B ≤ Q := by
    have hh : (B : ℝ) < Q := hBfloor.trans_lt
      ((div_lt_iff₀ hz0).mpr (mul_lt_mul_of_pos_left hsz hQ0))
    exact_mod_cast hh.le
  have hH : H = ((Q : ℝ)+1)*((B : ℝ)+1) := by simp [H]
  have hH0 : 0 < H := by dsimp [H]; positivity
  have hHpos := Real.sqrt_nonneg H
  have hHsq := Real.sq_sqrt hH0.le
  have hQHz : (Q : ℝ)^2*s ≤ H*z := by
    have hh := mul_lt_mul_of_pos_left hBup hQ0
    have hb : 0 ≤ ((B : ℝ)+1)*z := by positivity
    rw [hH]
    nlinarith
  have hH3 : (Q : ℝ)^2 ≤ 4*H := by
    have hh := mul_le_mul_of_nonneg_left hzs hH0.le
    have hprod : s*(Q : ℝ)^2 ≤ s*(4*H) := by nlinarith
    by_contra hn
    have hg : 4*H < (Q : ℝ)^2 := lt_of_not_ge hn
    have hmul := mul_lt_mul_of_pos_left hg hs0
    linarith only [hprod,hmul]
  have hHquarter : ((Q : ℝ)/2)^2 ≤ H := by nlinarith [sq_nonneg (Q : ℝ)]
  have hQsqrt : (Q : ℝ)/2 ≤ Real.sqrt H := by
    nlinarith
  have hsqprod : ((Q : ℝ)*s)^2 ≤ H*(s*z) := by
    have hh := mul_le_mul_of_nonneg_right hQHz hs0.le
    nlinarith
  have hsz0 : 0 ≤ s*z := mul_nonneg hs0.le hz0.le
  have hsz1 : s*z ≤ 1 := by
    have hh := mul_le_mul_of_nonneg_right (show s ≤ (1 : ℝ) by linarith) hz0.le
    linarith
  have hsqrtSz0 := Real.sqrt_nonneg (s*z)
  have hsqrtSzSq := Real.sq_sqrt hsz0
  have hprod0 : 0 ≤ Real.sqrt H*Real.sqrt (s*z) := mul_nonneg hHpos hsqrtSz0
  have hprodSq : (Real.sqrt H*Real.sqrt (s*z))^2 = H*(s*z) := by
    rw [mul_pow,hHsq,hsqrtSzSq]
  have hrootAspect : (Q : ℝ)*s ≤ Real.sqrt H*Real.sqrt (s*z) := by
    nlinarith
  have hAs : ((Q : ℝ)*s+(B : ℝ)*z)/2 ≤ Real.sqrt H*Real.sqrt (s*z) := by
    linarith
  have hheight := mul_le_mul_of_nonneg_left hAs hH0.le
  have hm0 : 0 < m := by
    dsimp [m,mBase]
    have hh : 0 < (9 : ℝ)/8*s*(2-4*s) :=
      mul_pos (mul_pos (by norm_num) hs0) (by linarith)
    linarith
  have hmlo : (9 : ℝ)/8*s*z+δ ≤ m := by
    have hh : (9 : ℝ)/8*s*(2-4*s) ≤ mBase s := le_refl _
    change (9 : ℝ)/8*s*(2-4*s)+δ ≤ mBase s+δ
    linarith only [hh]
  have hszhalf : s*z ≤ (1/2 : ℝ) := by
    have hh := mul_le_mul_of_nonneg_left hz1 hs0.le
    linarith
  have hbase : mBase s ≤ (9/16 : ℝ) := by
    change (9 : ℝ)/8*s*z ≤ 9/16
    nlinarith
  have hm1 : m ≤ 1 := by
    dsimp [m]
    linarith
  let c : ℝ := 2*Real.sqrt (2*m)/3
  let t : ℝ := Real.sqrt (s*z)
  have hc0 : 0 ≤ c := by dsimp [c]; positivity
  have ht0' : 0 ≤ t := hsqrtSz0
  have hcSq : c^2 = 8*m/9 := by
    dsimp [c]
    have hh := Real.sq_sqrt (by positivity : 0 ≤ 2*m)
    nlinarith only [hh]
  have htSq : t^2 = s*z := hsqrtSzSq
  have hc1 : c ≤ 1 := by nlinarith only [hcSq,hm1,hc0]
  have ht1 : t ≤ 1 := by nlinarith only [htSq,hsz1,ht0']
  have hdiff : 8*δ/9 ≤ c^2-t^2 := by nlinarith only [hcSq,htSq,hmlo]
  have hct : t ≤ c := by nlinarith only [hdiff,hδ,hc0,ht0']
  have hfactor : (c-t)*(c+t) ≤ 2*(c-t) := by
    calc
      (c-t)*(c+t) ≤ (c-t)*2 :=
        mul_le_mul_of_nonneg_left (by linarith only [hc1,ht1] : c+t ≤ 2)
          (by linarith only [hct] : 0 ≤ c-t)
      _ = 2*(c-t) := mul_comm _ _
  have hgap : δ/3 ≤ c-t := by
    nlinarith only [hfactor,hdiff,hδ]
  have hδQ : (60 : ℝ) ≤ (Q : ℝ)*δ := (div_le_iff₀ hδ).mp hQδ
  have hbudget : (10 : ℝ) ≤ δ/3*Real.sqrt H := by
    have hh := mul_le_mul_of_nonneg_left hQsqrt (by positivity : 0 ≤ δ/3)
    nlinarith only [hh,hδQ]
  have hgapProd := mul_le_mul_of_nonneg_right hgap
    (mul_nonneg hH0.le hHpos)
  have hbudgetH := mul_le_mul_of_nonneg_left hbudget hH0.le
  refine ⟨hB1,hBQ,hm0,hm1,?_⟩
  change H*((Q : ℝ)*s+(B : ℝ)*z)/2-c*H*Real.sqrt H+5*H ≤ -2*H
  change H*(((Q : ℝ)*s+(B : ℝ)*z)/2) ≤
    H*(Real.sqrt H*Real.sqrt (s*z)) at hheight
  dsimp [t] at hgapProd
  nlinarith only [hheight,hgapProd,hbudgetH,hH0.le]
end A7QuarticCore

namespace A7QuarticCore
private theorem normalized_slope_bounds
    (D E d e ρ M : ℝ)
    (hD : 0 < D) (hE : 0 < E) (hd : 0 < d) (he : 0 < e)
    (hdlo : D/2 < d) (hdhi : d ≤ D)
    (helo : E/2 < e) (hehi : e ≤ E)
    (hM : 0 < M)
    (hρlo : D/(2*E) ≤ ρ) (hρhi : ρ ≤ 2*D/E)
    (hlo : ρ < d/e) (hhi : d/e ≤ ρ*(1+1/M)) :
    0 ≤ (E/D)*ρ ∧ (E/D)*ρ ≤ 2 ∧
      |(E/D)*(d/e)| ≤ 2 ∧
      |(E/D)*(d/e)-(E/D)*ρ| ≤ 2/M := by
  have hk : 0 < E/D := div_pos hE hD
  have hρ0 : 0 ≤ ρ := le_trans (by positivity : 0 ≤ D/(2*E)) hρlo
  have hc0 : 0 ≤ (E/D)*ρ := mul_nonneg hk.le hρ0
  have hc2 : (E/D)*ρ ≤ 2 := by
    have hh := mul_le_mul_of_nonneg_left hρhi hk.le
    have heq : (E/D)*(2*D/E)=2 := by
      field_simp [ne_of_gt hD,ne_of_gt hE] <;> ring
    rwa [heq] at hh
  have hS0 : 0 ≤ (E/D)*(d/e) := by positivity
  have hS2 : (E/D)*(d/e) ≤ 2 := by
    have hh : E*d ≤ 2*D*e := by
      have h1 := mul_le_mul_of_nonneg_left hdhi hE.le
      have h2 := mul_lt_mul_of_pos_left helo hD
      nlinarith
    have heq : (E/D)*(d/e) = E*d/(D*e) := by
      field_simp <;> ring
    rw [heq]
    apply (div_le_iff₀ (mul_pos hD he)).mpr
    nlinarith
  have hdiff0 : 0 ≤ (E/D)*(d/e)-(E/D)*ρ := by
    have hh := mul_lt_mul_of_pos_left hlo hk
    linarith
  have hdiff : (E/D)*(d/e)-(E/D)*ρ ≤ 2/M := by
    have hh := mul_le_mul_of_nonneg_left hhi hk.le
    have hcM : (E/D)*ρ/M ≤ 2/M := div_le_div_of_nonneg_right hc2 hM.le
    have heq : (E/D)*(ρ*(1+1/M)) = (E/D)*ρ+((E/D)*ρ)/M := by ring
    rw [heq] at hh
    linarith only [hh,hcM]
  exact ⟨hc0,hc2,(abs_of_nonneg hS0).le.trans hS2,
    (abs_of_nonneg hdiff0).le.trans hdiff⟩

private theorem reciprocal_cell_width
    (x m : ℝ) (M : ℕ) (hx : 0 < x)
    (hM : x^m ≤ (M : ℝ)) :
    0 < (M : ℝ) ∧ 2/(M : ℝ) ≤ 2*x^(-m) := by
  have hp : 0 < x^m := Real.rpow_pos_of_pos hx m
  have hMp : 0 < (M : ℝ) := lt_of_lt_of_le hp hM
  refine ⟨hMp,?_⟩
  have hh : 2/(M : ℝ) ≤ 2/(x^m) :=
    div_le_div_of_nonneg_left (by norm_num) hp hM
  calc
    _ ≤ 2/(x^m) := hh
    _ = 2*x^(-m) := by rw [Real.rpow_neg hx.le]; ring

private theorem original_cofactor_upper
    (x D d u : ℝ) (hx : 0 < x) (hD : 0 < D)
    (hd : D/2 < d) (hu : 0 < u) (hprod : d^4*u ≤ x) :
    u ≤ 16*(x/D^4) := by
  have hd0 : 0 < d := by linarith
  have hdpow : (D/2)^4 ≤ d^4 := by gcongr
  have hprod' := mul_le_mul_of_nonneg_right hdpow hu.le
  rw [show 16*(x/D^4)=16*x/D^4 by ring]
  apply (le_div_iff₀ (pow_pos hD 4)).mpr
  norm_num [div_pow] at hprod'
  nlinarith only [hprod',hprod]

private theorem integer_minor_vanishes
    {I : Type*} [Fintype I] [DecidableEq I]
    (P : Matrix I I ℤ) (h : |((P.det : ℤ) : ℝ)| < 1) :
    P.det = 0 := by
  have hi : |P.det| < (1 : ℤ) := by exact_mod_cast h
  have hh := abs_lt.mp hi
  omega

private theorem final_integer_threshold
    (C x H : ℝ) (hC : 0 ≤ C) (hx : 8 ≤ x)
    (hCx : 2*C ≤ x) (hH : 1 ≤ H) :
    C*x^(-2*H) < 1 := by
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  calc
    C*x^(-2*H) ≤ C*x^(-(1 : ℝ)) := by gcongr; linarith
    _ = C/x := by rw [Real.rpow_neg_one]; ring
    _ ≤ (1/2 : ℝ) := by
      apply (div_le_iff₀ hx0).mpr
      linarith
    _ < 1 := by norm_num
end A7QuarticCore

namespace A7QuarticCore
open FormalAB.Sb868eaea.A5AffineFiniteGate
open FormalAB.Sb868eaea.A5AffineFiniteGate.Internal

private theorem rectangular_degree_halves (A B : ℕ) :
    (xDegreeSum A B : ℝ) = (A : ℝ)*((A+1)*(B+1) : ℕ)/2 ∧
    (yDegreeSum A B : ℝ) = (B : ℝ)*((A+1)*(B+1) : ℕ)/2 := by
  have hi : 2*xDegreeSum A B = (A+1)*(B+1)*A := by
    calc
      _ = (∑ c : Cols A B, (c.1 : ℕ))+
          (∑ c : Cols A B, (A-(c.1 : ℕ))) := by
        rw [FormalAB.Sb868eaea.A5AffineFiniteGate.Internal.gap_sum_first]
        change 2*(∑ c : Cols A B, (c.1 : ℕ)) =
          (∑ c : Cols A B, (c.1 : ℕ))+(∑ c : Cols A B, (c.1 : ℕ))
        omega
      _ = ∑ c : Cols A B, ((c.1 : ℕ)+(A-(c.1 : ℕ))) := by
        rw [Finset.sum_add_distrib]
      _ = ∑ c : Cols A B, A := by
        apply Finset.sum_congr rfl
        intro c hc
        exact Nat.add_sub_of_le (Nat.lt_succ_iff.mp c.1.isLt)
      _ = _ := by simp [Cols]
  have hj : 2*yDegreeSum A B = (A+1)*(B+1)*B := by
    calc
      _ = (∑ c : Cols A B, (c.2 : ℕ))+
          (∑ c : Cols A B, (B-(c.2 : ℕ))) := by
        rw [FormalAB.Sb868eaea.A5AffineFiniteGate.Internal.gap_sum_second]
        change 2*(∑ c : Cols A B, (c.2 : ℕ)) =
          (∑ c : Cols A B, (c.2 : ℕ))+(∑ c : Cols A B, (c.2 : ℕ))
        omega
      _ = ∑ c : Cols A B, ((c.2 : ℕ)+(B-(c.2 : ℕ))) := by
        rw [Finset.sum_add_distrib]
      _ = ∑ c : Cols A B, B := by
        apply Finset.sum_congr rfl
        intro c hc
        exact Nat.add_sub_of_le (Nat.lt_succ_iff.mp c.2.isLt)
      _ = _ := by simp [Cols]
  have hiR : (2 : ℝ)*(xDegreeSum A B : ℝ) =
      ((A+1)*(B+1) : ℕ)*(A : ℝ) := by exact_mod_cast hi
  have hjR : (2 : ℝ)*(yDegreeSum A B : ℝ) =
      ((A+1)*(B+1) : ℕ)*(B : ℝ) := by exact_mod_cast hj
  constructor <;> nlinarith

private theorem quartic_physical_scale
    (A B : ℕ) (x s D E : ℝ)
    (hx : 0 < x) (hD : 0 < D) (hE : 0 < E) (hDE : D*E=x^s) :
    (D*E)^xDegreeSum A B*
        ((2*x/D^4)*(2*x/E^4))^yDegreeSum A B =
      (4 : ℝ)^yDegreeSum A B*
        x^((((A+1)*(B+1) : ℕ)*
          ((A : ℝ)*s+(B : ℝ)*(2-4*s)))/2) := by
  let U := x/D^4
  let V := x/E^4
  have hUV : U*V=x^(2-4*s) := by
    calc
      U*V=x^2/(D*E)^4 := by dsimp [U,V]; field_simp <;> ring
      _ = x^(2 : ℝ)/(x^s)^4 := by rw [hDE]; norm_num [Real.rpow_natCast]
      _ = _ := by
        rw [← Real.rpow_natCast (x^s) 4,← Real.rpow_mul hx.le,
          ← Real.rpow_sub hx]
        congr 1
        ring
  have hi : (D*E)^xDegreeSum A B = x^(s*(xDegreeSum A B : ℝ)) := by
    rw [hDE,Real.rpow_mul hx.le,Real.rpow_natCast]
  have hj : (U*V)^yDegreeSum A B =
      x^((2-4*s)*(yDegreeSum A B : ℝ)) := by
    rw [hUV,Real.rpow_mul hx.le,Real.rpow_natCast]
  have hUVg : (2*x/D^4)*(2*x/E^4)=4*(U*V) := by dsimp [U,V]; ring
  have hh := rectangular_degree_halves A B
  rw [hUVg,mul_pow (4 : ℝ) (U*V) (yDegreeSum A B),hi,hj]
  calc
    _ = (4 : ℝ)^yDegreeSum A B*
      (x^(s*(xDegreeSum A B : ℝ))*x^((2-4*s)*(yDegreeSum A B : ℝ))) := by ring
    _ = _ := by
      rw [← Real.rpow_add hx]
      congr 2
      rw [hh.1,hh.2]
      ring
end A7QuarticCore

namespace A7QuarticCore
private abbrev Point := (ℕ × ℕ) × (ℕ × ℕ)
private def rho (D E : ℝ) (M j : ℕ) : ℝ :=
  D/(2*E)*(1+1/(M : ℝ))^j
private def cells (D E : ℝ) (M : ℕ) : Finset ℕ :=
  @Finset.filter ℕ
    (fun j => D/(2*E) ≤ rho D E M j ∧ rho D E M j ≤ 2*D/E)
    (Classical.decPred _) (Finset.range (3*M+1))
private def originalCell (x D E : ℝ) (M j : ℕ) (h : ℤ) : Set Point :=
  {z | 1 ≤ z.1.1 ∧ 1 ≤ z.1.2 ∧ 1 ≤ z.2.1 ∧ 1 ≤ z.2.2 ∧
    ((z.1.2^4*z.2.2 : ℕ) : ℤ)=((z.1.1^4*z.2.1 : ℕ) : ℤ)+h ∧
    x/2 < ((z.1.1^4*z.2.1 : ℕ) : ℝ) ∧
    ((z.1.1^4*z.2.1 : ℕ) : ℝ) ≤ x ∧
    D/2 < (z.1.1 : ℝ) ∧ (z.1.1 : ℝ) ≤ D ∧
    E/2 < (z.1.2 : ℝ) ∧ (z.1.2 : ℝ) ≤ E ∧
    rho D E M j < (z.1.1 : ℝ)/(z.1.2 : ℝ) ∧
    (z.1.1 : ℝ)/(z.1.2 : ℝ) ≤ rho D E M j*(1+1/(M : ℝ))}
private def entry (A B : ℕ) (z : Point) (c : Cols A B) : ℤ :=
  (z.1.1 : ℤ)^(c.1 : ℕ)*(z.1.2 : ℤ)^(A-(c.1 : ℕ))*
    (z.2.2 : ℤ)^(c.2 : ℕ)*(z.2.1 : ℤ)^(B-(c.2 : ℕ))
end A7QuarticCore

namespace A7QuarticCore
open FormalAB.Sb868eaea.A5AffineFiniteGate
open FormalAB.Sb868eaea.A5AffineFiniteGate.Internal

private theorem actual_cell_decay (A B : ℕ) :
    ∃ C : ℝ, 0 < C ∧
      ∀ x s D E m : ℝ, 8 ≤ x → 0 < D → 0 < E → D*E=x^s →
        0 < m → m ≤ 1 →
      ∀ M : ℕ, x^m ≤ (M : ℝ) →
      ∀ j : ℕ, j ∈ cells D E M →
      ∀ h : ℤ, (h=1 ∨ h=-1) →
      ∀ z : Cols A B → Point, (∀ r, z r ∈ originalCell x D E M j h) →
        |((Matrix.det (fun r col : Cols A B => entry A B (z r) col) : ℤ) : ℝ)|
          ≤ C*x^((((A+1)*(B+1) : ℕ)*
              ((A : ℝ)*s+(B : ℝ)*(2-4*s)))/2 -
            (2*Real.sqrt (2*m)/3)*((A+1)*(B+1) : ℕ)*
              Real.sqrt ((A+1)*(B+1) : ℕ)+5*((A+1)*(B+1) : ℕ)) := by
  classical
  obtain ⟨CN,hCN,hgate⟩ := normalized_quartic_determinant A B
  let H : ℕ := (A+1)*(B+1)
  let R : ℝ := ((2 : ℝ)^A*(8 : ℝ)^B)^H
  let C : ℝ := R*(4 : ℝ)^yDegreeSum A B*CN
  have hC : 0 < C := by dsimp [C,R]; positivity
  refine ⟨C,hC,?_⟩
  intro x s D E m hx hD hE hDE hm hm1 M hM j hj h hh z hz
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  let U : ℝ := 2*x/D^4
  let V : ℝ := 2*x/E^4
  have hU : 0 < U := by dsimp [U]; positivity
  have hV : 0 < V := by dsimp [V]; positivity
  let d : Cols A B → ℕ := fun r => (z r).1.1
  let e : Cols A B → ℕ := fun r => (z r).1.2
  let u : Cols A B → ℕ := fun r => (z r).2.1
  let v : Cols A B → ℕ := fun r => (z r).2.2
  let S : Cols A B → ℝ := fun r => (E/D)*((d r : ℝ)/(e r : ℝ))
  let T : Cols A B → ℝ := fun r => (E/D)^4*((v r : ℝ)/(u r : ℝ))
  let c : ℝ := (E/D)*rho D E M j
  have hcut : D/(2*E) ≤ rho D E M j ∧ rho D E M j ≤ 2*D/E := by
    have hmem := hj
    simp only [cells,Finset.mem_filter] at hmem
    exact hmem.2
  have hwidth := reciprocal_cell_width x m M hx0 hM
  have hpos (r : Cols A B) :
      0 < d r ∧ 0 < e r ∧ 0 < u r ∧ 0 < v r := by
    rcases hz r with ⟨hd,he,hu,hv,hunit,hprodlo,hprodhi,hdlo,hdhi,helo,hehi,hlo,hhi⟩
    dsimp [d,e,u,v]
    exact ⟨by omega,by omega,by omega,by omega⟩
  have hposR (r : Cols A B) :
      0 < (d r : ℝ) ∧ 0 < (e r : ℝ) ∧ 0 < (u r : ℝ) ∧ 0 < (v r : ℝ) := by
    exact_mod_cast hpos r
  have hnorm (r : Cols A B) :
      0 ≤ c ∧ c ≤ 2 ∧ |S r| ≤ 2 ∧ |S r-c| ≤ 2*x^(-m) := by
    rcases hz r with ⟨hd,he,hu,hv,hunit,hprodlo,hprodhi,hdlo,hdhi,helo,hehi,hlo,hhi⟩
    have hr := hposR r
    have hn := normalized_slope_bounds D E (d r : ℝ) (e r : ℝ)
      (rho D E M j) (M : ℝ) hD hE hr.1 hr.2.1
      hdlo hdhi helo hehi hwidth.1 hcut.1 hcut.2 hlo hhi
    exact ⟨hn.1,hn.2.1,hn.2.2.1,hn.2.2.2.trans hwidth.2⟩
  have herror (r : Cols A B) : |T r-(S r)^4| ≤ 32*x^(-(1 : ℝ)) := by
    rcases hz r with ⟨hd,he,hu,hv,hunit,hprodlo,hprodhi,hdlo,hdhi,helo,hehi,hlo,hhi⟩
    have hr := hposR r
    have hunitR : (e r : ℝ)^4*(v r : ℝ) =
        (d r : ℝ)^4*(u r : ℝ)+(h : ℝ) := by exact_mod_cast hunit
    have hband : x/2 < (d r : ℝ)^4*(u r : ℝ) := by exact_mod_cast hprodlo
    have hshift : |(h : ℝ)| ≤ 1 := by
      rcases hh with rfl|rfl <;> norm_num
    have heR := quartic_normalized_unit_error x D E (d r : ℝ) (e r : ℝ)
      (u r : ℝ) (v r : ℝ) (h : ℝ) hx0 hD hE hr.1 hr.2.1 hr.2.2.1
      hunitR hshift hband (hnorm r).2.2.1
    simpa only [S,T,Real.rpow_neg_one,div_eq_mul_inv] using heR
  have hecap (r : Cols A B) : (e r : ℝ) ≤ 2*E := by
    rcases hz r with ⟨hd,he,hu,hv,hunit,hprodlo,hprodhi,hdlo,hdhi,helo,hehi,hlo,hhi⟩
    change (e r : ℝ) ≤ E at hehi
    linarith
  have hucap (r : Cols A B) : (u r : ℝ) ≤ 8*U := by
    rcases hz r with ⟨hd,he,hu,hv,hunit,hprodlo,hprodhi,hdlo,hdhi,helo,hehi,hlo,hhi⟩
    have hprod : (d r : ℝ)^4*(u r : ℝ) ≤ x := by exact_mod_cast hprodhi
    have hco := original_cofactor_upper x D (d r : ℝ) (u r : ℝ)
      hx0 hD hdlo (hposR r).2.2.1 hprod
    convert hco using 1 <;> dsimp [U] <;> ring
  have hdetN := hgate c m x (hnorm (0,0)).1 (hnorm (0,0)).2.1 hm hm1 hx1
    S T (fun r => (hnorm r).2.2.2) herror
  have hsfun :
      (fun r => ((d r : ℝ)/(e r : ℝ))/(D/E)) = S := by
    funext r
    dsimp [S]
    field_simp [ne_of_gt hD,ne_of_gt hE,ne_of_gt (hposR r).2.1] <;> ring
  have htfun :
      (fun r => ((v r : ℝ)/(u r : ℝ))/(V/U)) = T := by
    funext r
    dsimp [T,U,V]
    field_simp [ne_of_gt hx0,ne_of_gt hD,ne_of_gt hE,
      ne_of_gt (hposR r).2.2.1] <;> ring
  have hp := FormalAB.Sb868eaea.A5AffineFiniteGate.Internal.original_cleared_det_bound
    A B D E U V hD hE hU hV d e u v
    (fun r => (hpos r).2.1) (fun r => (hpos r).2.2.1) hecap hucap
  rw [hsfun,htfun] at hp
  have hscale := quartic_physical_scale A B x s D E hx0 hD hE hDE
  let height : ℝ := (H : ℝ)*((A : ℝ)*s+(B : ℝ)*(2-4*s))/2
  let cost : ℝ := (2*Real.sqrt (2*m)/3)*(H : ℝ)*Real.sqrt (H : ℝ)-5*(H : ℝ)
  have hbound :
      |((Matrix.det (fun r col : Cols A B => entry A B (z r) col) : ℤ) : ℝ)|
        ≤ C*x^(height-cost) := by
    calc
      _ ≤ R*((D*E)^xDegreeSum A B*(U*V)^yDegreeSum A B)*
          |Matrix.det (fun r col : Cols A B => (S r)^(col.1 : ℕ)*(T r)^(col.2 : ℕ))| := by
        have diagnostic_V9_actual_physical_matrix_identification : True := trivial
        simp only [FormalAB.Sb868eaea.A5AffineFiniteGate.Internal.Rect,
          Fintype.card_prod,Fintype.card_fin] at hp
        change
          |((Matrix.det (fun r col : Cols A B => entry A B (z r) col) : ℤ) : ℝ)| ≤
            ((2 : ℝ)^A*(8 : ℝ)^B)^((A+1)*(B+1))*
              (D*E)^xDegreeSum A B*(U*V)^yDegreeSum A B*
              |Matrix.det (fun r col : Cols A B =>
                (S r)^(col.1 : ℕ)*(T r)^(col.2 : ℕ))| at hp
        simpa only [R,H,mul_assoc] using hp
      _ ≤ R*((D*E)^xDegreeSum A B*(U*V)^yDegreeSum A B)*(CN*x^(-cost)) := by
        exact mul_le_mul_of_nonneg_left hdetN (by dsimp [R]; positivity)
      _ = C*(x^height*x^(-cost)) := by
        have hscl : (D*E)^xDegreeSum A B*(U*V)^yDegreeSum A B =
            (4 : ℝ)^yDegreeSum A B*x^height := by
          simpa only [U,V,height,H] using hscale
        rw [hscl]
        dsimp [C]
        ring
      _ = _ := by
        rw [← Real.rpow_add hx0] <;> congr 1 <;> ring
  have h_exponent_rearrangement : height-cost =
      (H : ℝ)*((A : ℝ)*s+(B : ℝ)*(2-4*s))/2-
        (2*Real.sqrt (2*m)/3)*(H : ℝ)*Real.sqrt (H : ℝ)+5*(H : ℝ) := by
    dsimp [height,cost]
    ring
  rw [h_exponent_rearrangement] at hbound
  simpa only [H] using hbound
end A7QuarticCore

namespace A7QuarticCore
private theorem actual_minors :
    ∀ δ : ℝ, 0 < δ → δ < (1/4000 : ℝ) →
      ∃ menu : Finset (ℕ × ℕ),
        menu.Nonempty ∧ (∀ ab ∈ menu, 1 ≤ ab.1 ∧ 1 ≤ ab.2) ∧
        ∃ X0 : ℝ, 8 ≤ X0 ∧
          ∀ x : ℝ, X0 ≤ x →
          ∀ s : ℝ, (1/4 : ℝ) ≤ s → s ≤ (329/1000 : ℝ) →
          ∀ D E : ℝ, 0 < D → 0 < E → D*E=x^s →
          let M : ℕ := ⌈x^(mBase s+δ)⌉₊
          ∃ ab ∈ menu,
            ∀ j : ℕ, j ∈ cells D E M →
            ∀ h : ℤ, (h=1 ∨ h=-1) →
            ∀ z : Cols ab.1 ab.2 → Point,
              (∀ r, z r ∈ originalCell x D E M j h) →
              Matrix.det (fun r col : Cols ab.1 ab.2 =>
                entry ab.1 ab.2 (z r) col)=0 := by
  classical
  intro δ hδ hδu
  let Q : ℕ := ⌈60/δ⌉₊+4
  have hQ4 : 4 ≤ Q := by dsimp [Q]; omega
  have hQδ : 60/δ ≤ (Q : ℝ) := by
    have hh := Nat.le_ceil (60/δ)
    dsimp [Q]
    push_cast
    linarith only [hh]
  choose C hCpos hgate using (fun B : ℕ => actual_cell_decay Q B)
  let F : Finset ℕ := Finset.Icc 1 Q
  have hF : F.Nonempty := by
    refine ⟨1,?_⟩
    exact Finset.mem_Icc.mpr ⟨by omega,by omega⟩
  obtain ⟨B0,hB0,hmax⟩ := Finset.exists_max_image F C hF
  let menu : Finset (ℕ × ℕ) := F.image (fun B => (Q,B))
  have hmenu : menu.Nonempty := hF.image _
  refine ⟨menu,hmenu,?_,?_⟩
  · intro ab hab
    obtain ⟨B,hB,rfl⟩ := Finset.mem_image.mp hab
    exact ⟨by omega,(Finset.mem_Icc.mp hB).1⟩
  let X0 : ℝ := max 8 (2*C B0)
  refine ⟨X0,le_max_left _ _,?_⟩
  intro x hx s hslo hshi D E hD hE hDE
  have hx8 : 8 ≤ x := (le_max_left _ _).trans hx
  have hxC0 : 2*C B0 ≤ x := (le_max_right _ _).trans hx
  let B : ℕ := chosenB Q s
  let m : ℝ := mBase s+δ
  let M : ℕ := ⌈x^m⌉₊
  let H : ℕ := (Q+1)*(B+1)
  have hmarg := quartic_menu_margin δ hδ hδu Q hQ4 hQδ s hslo hshi
  change 1 ≤ B ∧ B ≤ Q ∧ 0 < m ∧ m ≤ 1 ∧
      (H : ℝ)*((Q : ℝ)*s+(B : ℝ)*(2-4*s))/2-
        (2*Real.sqrt (2*m)/3)*(H : ℝ)*Real.sqrt (H : ℝ)+5*(H : ℝ)
          ≤ -2*(H : ℝ) at hmarg
  have hBF : B ∈ F := Finset.mem_Icc.mpr ⟨hmarg.1,hmarg.2.1⟩
  refine ⟨(Q,B),Finset.mem_image.mpr ⟨B,hBF,rfl⟩,?_⟩
  intro j hj h hh z hz
  have hM : x^m ≤ (M : ℝ) := Nat.le_ceil _
  have hdec := hgate B x s D E m hx8 hD hE hDE
    hmarg.2.2.1 hmarg.2.2.2.1 M hM j hj h hh z hz
  have hx1 : 1 ≤ x := by linarith only [hx8]
  have hpow := Real.rpow_le_rpow_of_exponent_le hx1 hmarg.2.2.2.2
  have hdec' :
      |((Matrix.det (fun r col : Cols Q B => entry Q B (z r) col) : ℤ) : ℝ)|
        ≤ C B*x^(-2*(H : ℝ)) := by
    exact hdec.trans (mul_le_mul_of_nonneg_left hpow (hCpos B).le)
  have hH0 : 0 < H := by dsimp [H]; positivity
  have hH1 : 1 ≤ (H : ℝ) := by exact_mod_cast (show 1 ≤ H by omega)
  have hCm : C B ≤ C B0 := hmax B hBF
  have hxCB : 2*C B ≤ x := by linarith only [hCm,hxC0]
  have hsmall := final_integer_threshold (C B) x (H : ℝ)
    (hCpos B).le hx8 hxCB hH1
  exact integer_minor_vanishes _ (hdec'.trans_lt hsmall)
end A7QuarticCore

namespace A7QuarticCore
private theorem quartic_cell_coordinate_bounds
    (x D E : ℝ) (M j : ℕ) (h : ℤ)
    (hx : 8 ≤ x) (hh : h = 1 ∨ h = -1) (z : Point)
    (hz : z ∈ originalCell x D E M j h) :
    (z.1.1 : ℝ) ≤ 2*x ∧ (z.1.2 : ℝ) ≤ 2*x ∧
      (z.2.1 : ℝ) ≤ 2*x ∧ (z.2.2 : ℝ) ≤ 2*x := by
  rcases hz with ⟨hd,he,hu,hv,hshift,-,hn,-⟩
  have hd1 : (1 : ℝ) ≤ (z.1.1 : ℝ) := by exact_mod_cast hd
  have he1 : (1 : ℝ) ≤ (z.1.2 : ℝ) := by exact_mod_cast he
  have hu1 : (1 : ℝ) ≤ (z.2.1 : ℝ) := by exact_mod_cast hu
  have hv1 : (1 : ℝ) ≤ (z.2.2 : ℝ) := by exact_mod_cast hv
  have hnR : (z.1.1 : ℝ)^4*(z.2.1 : ℝ) ≤ x := by exact_mod_cast hn
  have hshiftR : (z.1.2 : ℝ)^4*(z.2.2 : ℝ) =
      (z.1.1 : ℝ)^4*(z.2.1 : ℝ)+(h : ℝ) := by exact_mod_cast hshift
  have hhr : (h : ℝ) ≤ 1 := by rcases hh with rfl|rfl <;> norm_num
  have hprodE : (z.1.2 : ℝ)^4*(z.2.2 : ℝ) ≤ 2*x := by
    linarith only [hnR,hshiftR,hhr,hx]
  have hd4 : (z.1.1 : ℝ) ≤ (z.1.1 : ℝ)^4 := by
    have hp := pow_le_pow_right₀ hd1 (show (1 : ℕ) ≤ 4 by omega)
    simpa only [pow_one] using hp
  have he4 : (z.1.2 : ℝ) ≤ (z.1.2 : ℝ)^4 := by
    have hp := pow_le_pow_right₀ he1 (show (1 : ℕ) ≤ 4 by omega)
    simpa only [pow_one] using hp
  have hd41 : (1 : ℝ) ≤ (z.1.1 : ℝ)^4 := one_le_pow₀ hd1
  have he41 : (1 : ℝ) ≤ (z.1.2 : ℝ)^4 := one_le_pow₀ he1
  have hdprod : (z.1.1 : ℝ)^4 ≤ (z.1.1 : ℝ)^4*(z.2.1 : ℝ) := by
    simpa using mul_le_mul_of_nonneg_left hu1 (pow_nonneg (Nat.cast_nonneg _) 4)
  have heprod : (z.1.2 : ℝ)^4 ≤ (z.1.2 : ℝ)^4*(z.2.2 : ℝ) := by
    simpa using mul_le_mul_of_nonneg_left hv1 (pow_nonneg (Nat.cast_nonneg _) 4)
  have huprod : (z.2.1 : ℝ) ≤ (z.1.1 : ℝ)^4*(z.2.1 : ℝ) := by
    simpa using mul_le_mul_of_nonneg_right hd41
      (Nat.cast_nonneg z.2.1 : (0 : ℝ) ≤ z.2.1)
  have hvprod : (z.2.2 : ℝ) ≤ (z.1.2 : ℝ)^4*(z.2.2 : ℝ) := by
    simpa using mul_le_mul_of_nonneg_right he41
      (Nat.cast_nonneg z.2.2 : (0 : ℝ) ≤ z.2.2)
  have hdx : (z.1.1 : ℝ) ≤ x := hd4.trans (hdprod.trans hnR)
  have hux : (z.2.1 : ℝ) ≤ x := huprod.trans hnR
  exact ⟨by linarith only [hdx,hx],he4.trans (heprod.trans hprodE),
    by linarith only [hux,hx],hvprod.trans hprodE⟩

private theorem quartic_cell_entry_height
    (A B : ℕ) (hB : B ≤ A)
    (x D E : ℝ) (M j : ℕ) (h : ℤ) (hx : 8 ≤ x)
    (hh : h = 1 ∨ h = -1) (z : Point)
    (hz : z ∈ originalCell x D E M j h) (c : Cols A B) :
    |(entry A B z c : ℝ)| ≤ (2 : ℝ)^(2*A)*x^(2*A) := by
  have hp := quartic_cell_coordinate_bounds x D E M j h hx hh z hz
  have heq :
      |(entry A B z c : ℝ)| =
        (z.1.1 : ℝ)^(c.1 : ℕ)*(z.1.2 : ℝ)^(A-(c.1 : ℕ))*
        (z.2.2 : ℝ)^(c.2 : ℕ)*(z.2.1 : ℝ)^(B-(c.2 : ℕ)) := by
