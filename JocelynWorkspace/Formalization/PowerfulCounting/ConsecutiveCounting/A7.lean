  have hHpos : 0 < |H A B| := abs_pos.mpr hH
  have heps : |m^7*n/H A B|≤1/100 := by
    rw [abs_div]
    apply (div_le_iff₀ hHpos).mpr
    linarith
  have hRscale : R t*T^4*p^4=4*(B-A)*H A B := by
    calc
      R t*T^4*p^4=R t*(A*B)^4 := by rw [hAB]; ring
      _ = _ := by
        dsimp [R,F,H,t]
        field_simp [hA,hB]
        <;> ring
  have hid : T^4*(R t*(1+m^7*n/H A B)-140)=4*q*(B-A)-140*T^4 := by
    apply mul_right_cancel₀ (ne_of_gt hp4)
    calc
      (T^4*(R t*(1+m^7*n/H A B)-140))*p^4 =
          (R t*T^4*p^4)*(1+m^7*n/H A B)-140*T^4*p^4 := by ring
      _ = 4*(B-A)*H A B*(1+m^7*n/H A B)-140*T^4*p^4 := by rw [hRscale]
      _ = 4*(B-A)*(H A B+m^7*n)-140*T^4*p^4 := by field_simp [hH] <;> ring
      _ = (4*q*(B-A)-140*T^4)*p^4 := by rw [←hnum]; ring
  have hb : 10*T^4≤4*q*(B-A)-140*T^4 := by
    rw [←hid]
    have he : 99/100≤1+m^7*n/H A B := by
      have hh := (abs_le.mp heps).1
      linarith
    have hpdt := mul_le_mul hRlo he (by norm_num : (0:ℝ)≤99/100) (by linarith : 0≤R t)
    have hmargin : 10≤R t*(1+m^7*n/H A B)-140 := by linarith only [hpdt]
    nlinarith only [mul_le_mul_of_nonneg_left hmargin (by positivity : 0≤T^4)]
  have hnorm : H A B=A^7*F t := by
    dsimp [H,F,t]
    field_simp [hA]
    <;> ring
  have hF : |F t|≤400 := by
    have hr2 : r^2≤4 := by nlinarith [sq_nonneg (r-2)]
    have hr3 : r^3≤8 := by
      have hh := pow_le_pow_left₀ hr.le hrhi 3
      norm_num at hh
      exact hh
    have hFt : F t=1-7*r+21*r^2-35*r^3 := by dsimp [F,r]; ring
    have h1 : |1-7*r|≤1+7*r := by
      have hh := abs_sub (1:ℝ) (7*r)
      simpa only [abs_one,abs_mul,show |(7:ℝ)|=7 by norm_num,abs_of_pos hr] using hh
    have h2 := abs_add_le (1-7*r) (21*r^2)
    have h3 := abs_sub (1-7*r+21*r^2) (35*r^3)
    rw [hFt]
    rw [abs_of_nonneg (by positivity : 0≤21*r^2)] at h2
    rw [abs_of_nonneg (by positivity : 0≤35*r^3)] at h3
    linarith
  have hAupper : A^2≤2*T*p := by nlinarith [mul_le_mul_of_nonneg_right hrlo hA2.le]
  have hA14 : A^14≤128*T^7*p^7 := by
    have hh := pow_le_pow_left₀ hA2.le hAupper 7
    nlinarith only [hh]
  have hFsq : (F t)^2≤160000 := by
    have hh := pow_le_pow_left₀ (abs_nonneg (F t)) hF 2
    norm_num only [sq_abs] at hh
    exact hh
  have hHsq : (H A B)^2≤20480000*T^7*p^7 := by
    have hh := mul_le_mul hA14 hFsq (sq_nonneg (F t)) (by positivity : 0≤128*T^7*p^7)
    rw [hnorm]
    nlinarith only [hh]
  have hHsqlo : p^8≤4*(H A B)^2 := by
    have hh := pow_le_pow_left₀ (by positivity : 0≤p^4/2) hHlo 2
    rw [sq_abs] at hh
    nlinarith only [hh]
  have hpbound : p≤81920000*T^7 := by
    apply (mul_le_mul_iff_left₀ (pow_pos hp 7)).mp
    nlinarith only [hHsq,hHsqlo]
  constructor
  · exact hb.trans (le_abs_self _)
  · linarith

end A7P4Analytic
namespace A7P4GraphAssembly
noncomputable section
open Polynomial
def RZ (A B : ℤ) : ℤ := A^3+7*A^2*B+21*A*B^2+35*B^3
set_option maxHeartbeats 7000000
set_option maxRecDepth 6000

theorem fixed_level_count
    (δ : ℝ) (hδ:0 < δ) (hδsmall:δ ≤ 1/51200) (hδspec:A7P4Analytic.DeltaSpec δ)
    (C₀ c_M : ℝ) (hC:0 < C₀) (hc:0 < c_M) :
    ∃ C:ℝ, 1 ≤ C ∧
    ∀ x D E M s₀:ℝ,
      2 ≤ x → 0 < D → 0 < E → 0 < M → c_M*x^((1:ℝ)/7) ≤ M →
    ∀ a b m q:ℤ, Int.gcd a b=1 → m≠0 → q≠0 →
    ∀ T:Finset (Fin 4→ℤ),
      (∀p∈T,
        (∀i,0 < p i) ∧ 1 ≤ (p 0)^4*p 2 ∧ (((p 0)^4*p 2:ℤ):ℝ) ≤ x ∧
        D/2 < (p 0:ℝ) ∧ (p 0:ℝ) ≤ D ∧ E/2 < (p 1:ℝ) ∧ (p 1:ℝ) ≤ E ∧
        |(p 0:ℝ)/(p 1:ℝ)-s₀|  ≤ C₀*D/(E*M) ∧
        (p 1)^4*p 3=(p 0)^4*p 2+1 ∧ m=a*p 0+b*p 1 ∧
        m^7*p 2=q*(p 1)^4-a^4*(RZ (a*p 0) (b*p 1)) ∧
        m^7*p 3=q*(p 0)^4+b^4*(RZ (b*p 1) (a*p 0))) →
      (T.card:ℝ) ≤ C*(4:ℝ)^m.natAbs.primeFactors.card*
        (1+x^((1:ℝ)/4)/(M^((3:ℝ)/4)*(D*E)^((1:ℝ)/7))) := by
  obtain ⟨C,hC1,hcount⟩ :=
    A7P4Parameter.parameter_count δ hδ hδsmall hδspec
      (3*C₀) c_M (by positivity) hc
  refine ⟨C*20^8,by nlinarith only [hC1],?_⟩
  intro x D E M s₀ hx hD hE hM hfloor a b m q hprim hm hq T hT
  classical
  obtain ⟨d₀,e₀,hbez'⟩ := Int.isCoprime_iff_gcd_eq_one.mpr hprim
  have hbez : a*d₀+b*e₀=1 := by nlinarith only [hbez']
  obtain ⟨L,hL,hmod,U,hUc,hUv⟩ :=
    JocelynClaims.claim_e5f1e8861883455bfd3387f1d724014b28d93037b055adb5ebbef8e68a817560
      a b d₀ e₀ m q hprim hbez hm hq
  let S : Finset (ℤ×ℕ) := U.image (fun r => (r,L))
  have hSc : S.card ≤ 4^m.natAbs.primeFactors.card*20^8 :=
    Finset.card_image_le.trans hUc
  have hGle : Int.gcd m (a*b) ≤ m.natAbs :=
    Nat.le_of_dvd (Int.natAbs_pos.mpr hm) (Nat.gcd_dvd_left _ _)
  have hsizeL : m.natAbs ≤ L := by
    by_contra hh
    have hlt : L < m.natAbs := lt_of_not_ge hh
    have hpow := Nat.pow_le_pow_left hGle 6
    have h1 := Nat.mul_le_mul_left L hpow
    have h2 := Nat.mul_lt_mul_of_pos_right hlt (pow_pos (Int.natAbs_pos.mpr hm) 6)
    have heq : m.natAbs*m.natAbs^6=m.natAbs^7 := by ring
    nlinarith only [h1,h2,hmod,heq]
  have hSg (s:ℤ×ℕ) (hs:s∈S) : 0 < s.2 ∧ m.natAbs ≤ s.2 := by
    obtain ⟨r,hr,rfl⟩ := Finset.mem_image.mp hs
    exact ⟨hL,hsizeL⟩
  let r : (Fin 4→ℤ)→ℤ := fun p=>e₀*p 0-d₀*p 1
  have hcoords (p:Fin 4→ℤ) (hp:p∈T) :
      p 0=m*d₀+b*r p ∧ p 1=m*e₀-a*r p := by
    have hmlev := (hT p hp).2.2.2.2.2.2.2.2.2.1
    constructor
    · calc
        p 0=(a*d₀+b*e₀)*p 0 := by rw [hbez]; ring
        _=m*d₀+b*r p := by rw [hmlev]; dsimp [r]; ring
    · calc
        p 1=(a*d₀+b*e₀)*p 1 := by rw [hbez]; ring
        _=m*e₀-a*r p := by rw [hmlev]; dsimp [r]; ring
  have hmR:(m:ℝ)≠0 := by exact_mod_cast hm
  have hcovers (p:{p:Fin 4→ℤ // p∈T}) :
      ∃ s∈S,∃t:ℤ,r p.val=s.1+(s.2:ℤ)*t := by
    obtain ⟨hdp,hep⟩ := hcoords p.val p.property
    obtain ⟨hpos,hn1,hnx,hdlo,hdhi,helo,hehi,hratio,hshift,hmlev,hu,hv⟩ := hT p.val p.property
    have h1 : m^7 ∣ q*(m*e₀-a*r p.val)^4-a^4*
        RZ (a*(m*d₀+b*r p.val)) (b*(m*e₀-a*r p.val)) := by
      rw [←hdp,←hep]
      exact ⟨p.val 2,hu.symm⟩
    have h2 : m^7 ∣ q*(m*d₀+b*r p.val)^4+b^4*
        RZ (b*(m*e₀-a*r p.val)) (a*(m*d₀+b*r p.val)) := by
      rw [←hdp,←hep]
      exact ⟨p.val 3,hv.symm⟩
    obtain ⟨r₀,hr₀,z,hz⟩ := hUv (r p.val) h1 h2
    refine ⟨(r₀,L),Finset.mem_image.mpr ⟨r₀,hr₀,rfl⟩,z,?_⟩
    linarith only [hz]
  choose sf hsf tf htf using hcovers
  let Tf : (ℤ×ℕ)→Finset {p:Fin 4→ℤ // p∈T} :=
    fun s=>T.attach.filter (fun p=>sf p=s)
  let Zf : (ℤ×ℕ)→Finset ℤ := fun s=>(Tf s).image tf
  let Price:ℝ:=1+x^((1:ℝ)/4)/(M^((3:ℝ)/4)*(D*E)^((1:ℝ)/7))
  have hPrice:0 ≤ Price := by dsimp [Price]; positivity
  have hfiber (s:ℤ×ℕ) (hs:s∈S) : ((Tf s).card:ℝ) ≤ C*Price := by
    obtain ⟨hJ,hsize⟩:=hSg s hs
    have hJZ:0 < (s.2:ℤ) := by exact_mod_cast hJ
    have hsizeZ:m.natAbs ≤ (s.2:ℤ).natAbs := by simpa only [Int.natAbs_natCast] using hsize
    let dR:Polynomial ℝ:=
      Polynomial.C (((m*d₀+b*s.1:ℤ):ℝ))+
        Polynomial.C (((b*(s.2:ℤ):ℤ):ℝ))*Polynomial.X
    let eR:Polynomial ℝ:=
      Polynomial.C (((m*e₀-a*s.1:ℤ):ℝ))-
        Polynomial.C (((a*(s.2:ℤ):ℤ):ℝ))*Polynomial.X
    let NR:Polynomial ℝ := A7P4Analytic.NP dR eR a b m q
    let R:ℝ:=C₀*D/(E*M)
    have hR:0 < R := by dsimp [R]; positivity
    have hparam:((Zf s).card:ℝ) ≤ C*Price := by
      apply hcount x D E M (s₀-2*R) hx hD hE hM hfloor
        a b m d₀ e₀ s.1 q (s.2:ℤ) hprim hm hq hJZ hbez hsizeZ (Zf s)
      change ∀z∈Zf s,
        D/2 < dR.eval (z:ℝ) ∧ dR.eval (z:ℝ) ≤ D ∧
        E/2 < eR.eval (z:ℝ) ∧ eR.eval (z:ℝ) ≤ E ∧
        (dR.eval (z:ℝ))^4 ≤ x ∧ (eR.eval (z:ℝ))^4 ≤ 2*x ∧
        0 ≤ NR.eval (z:ℝ) ∧ NR.eval (z:ℝ) ≤ x ∧
        s₀-2*R < dR.eval (z:ℝ)/eR.eval (z:ℝ) ∧
        dR.eval (z:ℝ)/eR.eval (z:ℝ) ≤  s₀-2*R+(3*C₀)*D/(E*M)
      intro z hz
      obtain ⟨p,hp,rfl⟩:=Finset.mem_image.mp hz
      have hpS:sf p=s := (Finset.mem_filter.mp hp).2
      have hrepr:r p.val=s.1+(s.2:ℤ)*tf p := by simpa only [hpS] using htf p
      obtain ⟨hpos,hn1,hnx,hdlo,hdhi,helo,hehi,hratio,hshift,hmlev,hu,hv⟩:=hT p.val p.property
      obtain ⟨hdp,hep⟩:=hcoords p.val p.property
      have hdInt:p.val 0=m*d₀+b*s.1+(b*(s.2:ℤ))*tf p := by rw [hdp,hrepr]; ring
      have heInt:p.val 1=m*e₀-a*s.1-(a*(s.2:ℤ))*tf p := by rw [hep,hrepr]; ring
      have hdval:dR.eval (tf p:ℝ)=(p.val 0:ℝ) := by
        simp only [dR,eval_add,eval_mul,eval_C,eval_X]
        exact_mod_cast hdInt.symm
      have heval:eR.eval (tf p:ℝ)=(p.val 1:ℝ) := by
        simp only [eR,eval_sub,eval_mul,eval_C,eval_X]
        exact_mod_cast heInt.symm
      have huR:(m:ℝ)^7*(p.val 2:ℝ)=(q:ℝ)*(p.val 1:ℝ)^4-
          (a:ℝ)^4*((a:ℝ)*(p.val 0:ℝ))^3-
          (a:ℝ)^4*(7*((a:ℝ)*(p.val 0:ℝ))^2*((b:ℝ)*(p.val 1:ℝ))+
            21*((a:ℝ)*(p.val 0:ℝ))*((b:ℝ)*(p.val 1:ℝ))^2+
            35*((b:ℝ)*(p.val 1:ℝ))^3) := by
        have hh := congrArg (fun z:ℤ => (z:ℝ)) hu
        dsimp [RZ] at hh
        push_cast at hh
        nlinarith only [hh]
      have hN:NR.eval (tf p:ℝ)=(((p.val 0)^4*p.val 2:ℤ):ℝ) := by
        apply mul_left_cancel₀ (pow_ne_zero 7 hmR)
        have hh := A7P4Analytic.NP_eval dR eR a b m q hm (tf p:ℝ)
        change (m:ℝ)^7*NR.eval (tf p:ℝ)=_ at hh
        rw [hdval,heval] at hh
        push_cast
        dsimp [A7P4Analytic.H] at hh
        linear_combination hh-(p.val 0:ℝ)^4*huR
      have hnxR:(p.val 0:ℝ)^4*(p.val 2:ℝ) ≤ x := by exact_mod_cast hnx
      have hu1:(1:ℝ) ≤ (p.val 2:ℝ) := by exact_mod_cast (show 1 ≤ p.val 2 by have:=hpos 2; omega)
      have hv1:(1:ℝ) ≤ (p.val 3:ℝ) := by exact_mod_cast (show 1 ≤ p.val 3 by have:=hpos 3; omega)
      have hd2:(p.val 0:ℝ)^4 ≤ x := by
        have hh:=mul_le_mul_of_nonneg_left hu1 (by positivity : 0 ≤ (p.val 0:ℝ)^4)
        nlinarith only [hh,hnxR]
      have he2:(p.val 1:ℝ)^4 ≤ 2*x := by
        have hh:=mul_le_mul_of_nonneg_left hv1 (by positivity : 0 ≤ (p.val 1:ℝ)^4)
        have heq:(p.val 1:ℝ)^4*(p.val 3:ℝ)=(p.val 0:ℝ)^4*(p.val 2:ℝ)+1 := by exact_mod_cast hshift
        nlinarith only [hh,heq,hnxR,hx]
      have hn0:(0:ℝ) ≤ (((p.val 0)^4*p.val 2:ℤ):ℝ) := by
        exact_mod_cast (show 0 ≤ (p.val 0)^4*p.val 2 by omega)
      have hr:=abs_le.mp hratio
      have h3:(3*C₀)*D/(E*M)=3*R := by dsimp [R]; ring
      rw [hdval,heval,hN,h3]
      exact ⟨hdlo,hdhi,helo,hehi,hd2,he2,hn0,hnx,
        by change s₀-2*R < (p.val 0:ℝ)/(p.val 1:ℝ); dsimp [R] at hR; linarith [hr.1],
        by change (p.val 0:ℝ)/(p.val 1:ℝ) ≤  s₀-2*R+3*R; linarith [hr.2]⟩
    have hinj:Set.InjOn tf ↑(Tf s) := by
      intro p hp p' hp' hsame
      have hs1:sf p=s := (Finset.mem_filter.mp hp).2
      have hs2:sf p'=s := (Finset.mem_filter.mp hp').2
      have hr:r p.val=r p'.val := by rw [htf p,htf p',hs1,hs2,hsame]
      obtain ⟨hd1,he1⟩:=hcoords p.val p.property
      obtain ⟨hd2,he2⟩:=hcoords p'.val p'.property
      have hd:p.val 0=p'.val 0 := by rw [hd1,hd2,hr]
      have he:p.val 1=p'.val 1 := by rw [he1,he2,hr]
      have hu1: m^7*p.val 2=q*(p.val 1)^4-a^4*(RZ (a*p.val 0) (b*p.val 1)) :=
        (hT p.val p.property).2.2.2.2.2.2.2.2.2.2.1
      have hv1: m^7*p.val 3=q*(p.val 0)^4+b^4*(RZ (b*p.val 1) (a*p.val 0)) :=
        (hT p.val p.property).2.2.2.2.2.2.2.2.2.2.2
      have hu2: m^7*p'.val 2=q*(p'.val 1)^4-a^4*(RZ (a*p'.val 0) (b*p'.val 1)) :=
        (hT p'.val p'.property).2.2.2.2.2.2.2.2.2.2.1
      have hv2: m^7*p'.val 3=q*(p'.val 0)^4+b^4*(RZ (b*p'.val 1) (a*p'.val 0)) :=
        (hT p'.val p'.property).2.2.2.2.2.2.2.2.2.2.2
      have hu:p.val 2=p'.val 2 := by
        apply mul_left_cancel₀ (pow_ne_zero 7 hm)
        rw [hu1,hu2,hd,he]
      have hv:p.val 3=p'.val 3 := by
        apply mul_left_cancel₀ (pow_ne_zero 7 hm)
        rw [hv1,hv2,hd,he]
      apply Subtype.ext
      funext i
      fin_cases i <;> assumption
    have himage:(Zf s).card=(Tf s).card := Finset.card_image_iff.mpr hinj
    rw [←himage]
    exact hparam
  have hcard:T.card=∑s∈S,(Tf s).card := by
    have hh:=Finset.card_eq_sum_card_fiberwise (f:=sf) (s:=T.attach) (t:=S)
      (by intro p hp; exact hsf p)
    simpa only [Finset.card_attach,Tf] using hh
  have hScR:(S.card:ℝ) ≤ (4:ℝ)^m.natAbs.primeFactors.card*20^8 := by exact_mod_cast hSc
  calc
    (T.card:ℝ)=∑s∈S,((Tf s).card:ℝ) := by exact_mod_cast hcard
    _ ≤ ∑s∈S,C*Price := Finset.sum_le_sum hfiber
    _=(S.card:ℝ)*(C*Price) := by simp
    _ ≤ ((4:ℝ)^m.natAbs.primeFactors.card*20^8)*(C*Price) :=
      mul_le_mul_of_nonneg_right hScR (mul_nonneg (by linarith) hPrice)
    _=(C*20^8)*(4:ℝ)^m.natAbs.primeFactors.card*Price := by ring

end
