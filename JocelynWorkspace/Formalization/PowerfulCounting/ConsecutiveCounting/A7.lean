          (2*cofactorB x D E M j) (col (qf j).P 0)≤x^2
        nlinarith only [ht.2,hAcap j,hBcap j,hp]
      have hraw := hmom x hxXm s hs hs' D E hD1 hE1 hDx hEx hDE
        (fun j => col (p j).P 0) (fun j => col (qf j).P 0)
        (fun j _ => (p j).hcol) (fun j _ => (qf j).hcol)
      change (∑ j∈quarticCells D E M, (L j)^2)≤Cm*x^η*RD ∧
        (∑ j∈quarticCells D E M,
          (A7QuarticMoments.length ((M : ℝ)/(128*scaleA D E U V M j))
            ((quarticRho D E M j)^4)
            (2*scaleB D E U V M j) (col (qf j).P 0))^2)≤Cm*x^η*RU at hraw

      let A : ℝ := (1+256*Cm)*x^η
      have hA : 1 ≤ A := by
        have hp := mul_le_mul_of_nonneg_left hηx
