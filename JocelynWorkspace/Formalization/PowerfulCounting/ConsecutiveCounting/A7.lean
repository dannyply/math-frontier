      (z.1.1 : ℝ) / (z.1.2 : ℝ) ≤ D / (2 * E) * (1 + 1 / (M : ℝ)) ^ j * (1 + 1 / (M : ℝ)) := by
  obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11⟩ := hz
