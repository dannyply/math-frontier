            |(z 0 : ℝ) / (z 1 : ℝ) - rho D E M j| ≤
              2 * D / (E * (M : ℝ))) ∧
          (∀ j ∈ J, 0 < L j ∧ 0 < T j) ∧
          (∃ Pd Ad Pt At : ℕ → IntegerMatrix,
            (∀ j : ℕ,
              Ad j * Pd j = 1 ∧ Pd j * Ad j = 1 ∧
              At j * Pt j = 1 ∧ Pt j * At j = 1) ∧
            (∀ j ∈ J, (sourceCell x D E M j).Nonempty →
              matrixBound (Pd j) (Cphys * (M : ℝ) * max D E) ∧
              matrixBound (Ad j) (Cphys * (M : ℝ) * max D E) ∧
              matrixBound (Pt j) (Cphys * (M : ℝ) * max (U D x) (V E x)) ∧
              matrixBound (At j) (Cphys * (M : ℝ) * max (U D x) (V E x)) ∧
              matrixBound (Pd j) (Cphys * x ^ (4 * K + 4)) ∧
              matrixBound (Ad j) (Cphys * x ^ (4 * K + 4)) ∧
              matrixBound (Pt j) (Cphys * x ^ (4 * K + 4)) ∧
              matrixBound (At j) (Cphys * x ^ (4 * K + 4))) ∧
            (∀ j ∈ J, ∀ z ∈ sourceCell x D E M j,
              (∀ i : Fin 2,
                |((Ad j).mulVec ![(z 0 : ℤ), (z 1 : ℤ)] i : ℝ)| ≤ L j) ∧
              (∀ i : Fin 2,
                |((At j).mulVec ![(z 3 : ℤ), (z 2 : ℤ)] i : ℝ)| ≤ T j))) ∧
          (∑ᶠ j ∈ J, (L j) ^ 2) ≤
            C * x ^ eps * (D * E + (D ^ 2 + E ^ 2) / (M : ℝ)) ∧
