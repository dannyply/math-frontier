private theorem divisor_fee (K : ℝ) (hK : 0 ≤ K)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ C : ℝ, 0 < C ∧ ∀ x : ℝ, 2 ≤ x →
      ∀ B : ℤ, B ≠ 0 →
        |(B : ℝ)| ≤ 1625702400 * x ^ (16 * K) →
        (44800 : ℝ) * (B.natAbs.divisors.card : ℝ) ^ 9 ≤ C * x ^ ε := by
  let δ : ℝ := ε / (144 * K + 1)
  have hden : 0 < 144 * K + 1 := by nlinarith
  have hδ : 0 < δ := div_pos hε hden
  have hδeq : δ * (144 * K + 1) = ε :=
    div_mul_cancel₀ ε (ne_of_gt hden)
  have hexp : (16 * K) * (9 * δ) ≤ ε := by nlinarith
  obtain ⟨Cd, hCd, hdb⟩ := C01.PcLowdegRed.divisor_bound δ hδ
  let C : ℝ := 44800 * Cd ^ 9 * (1625702400 : ℝ) ^ (9 * δ) + 1
  refine ⟨C, by dsimp [C]; positivity, ?_⟩
  intro x hx B hB hBb
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hcast : (B.natAbs : ℝ) = |(B : ℝ)| := by
    rw [← Int.cast_natCast, Int.natCast_natAbs, Int.cast_abs]
  have hD : (B.natAbs.divisors.card : ℝ) ≤ Cd * |(B : ℝ)| ^ δ := by
    have ht := hdb B.natAbs (Int.natAbs_ne_zero.mpr hB)
    rwa [hcast] at ht
  have hD8 : (B.natAbs.divisors.card : ℝ) ^ 9 ≤
      Cd ^ 9 * |(B : ℝ)| ^ (9 * δ) := by
    calc
      (B.natAbs.divisors.card : ℝ) ^ 9 ≤
          (Cd * |(B : ℝ)| ^ δ) ^ 9 :=
        pow_le_pow_left₀ (Nat.cast_nonneg _) hD _
      _ = Cd ^ 9 * |(B : ℝ)| ^ (9 * δ) := by
        rw [mul_pow]
        congr 1
        rw [← Real.rpow_natCast, ← Real.rpow_mul (abs_nonneg _)]
        congr 1
        push_cast
        ring
  have hMeta : |(B : ℝ)| ^ (9 * δ) ≤
      (1625702400 : ℝ) ^ (9 * δ) * x ^ ε := by
    calc
      |(B : ℝ)| ^ (9 * δ) ≤ (1625702400 * x ^ (16 * K)) ^ (9 * δ) :=
        Real.rpow_le_rpow (abs_nonneg _) hBb (by positivity)
      _ = (1625702400 : ℝ) ^ (9 * δ) * (x ^ (16 * K)) ^ (9 * δ) :=
        Real.mul_rpow (by norm_num) (Real.rpow_nonneg hx0.le _)
      _ = (1625702400 : ℝ) ^ (9 * δ) * x ^ ((16 * K) * (9 * δ)) := by
        rw [← Real.rpow_mul hx0.le]
      _ ≤ (1625702400 : ℝ) ^ (9 * δ) * x ^ ε :=
        mul_le_mul_of_nonneg_left
          (Real.rpow_le_rpow_of_exponent_le hx1 hexp)
          (Real.rpow_nonneg (by norm_num) _)
  calc
    (44800 : ℝ) * (B.natAbs.divisors.card : ℝ) ^ 9 ≤
        44800 * (Cd ^ 9 * |(B : ℝ)| ^ (9 * δ)) :=
      mul_le_mul_of_nonneg_left hD8 (by norm_num)
    _ ≤ 44800 * (Cd ^ 9 * ((1625702400 : ℝ) ^ (9 * δ) * x ^ ε)) :=
      mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left hMeta
          (pow_nonneg (by linarith : 0 ≤ Cd) _)) (by norm_num)
    _ = (44800 * Cd ^ 9 * (1625702400 : ℝ) ^ (9 * δ)) * x ^ ε := by ring
    _ ≤ C * x ^ ε := by
      apply mul_le_mul_of_nonneg_right _ (Real.rpow_nonneg hx0.le _)
      dsimp [C]
      linarith

private theorem primitive_norm_cover (Delta : ℕ) (h : ℤ) (Z : ℕ)
    (hDelta : 0<Delta) (hh : h≠0) :
    let K : ℕ := (Delta+1)*Z^2+1;
    ∃T : Finset (ℤ×ℤ),
      (∀X Y:ℤ,X.natAbs≤Z → Y.natAbs≤Z → Int.gcd X Y=1 →
        X^2-(Delta:ℤ)*Y^2=h → (X,Y)∈T) ∧
      (T.card:ℝ)≤8*(h.natAbs.divisors.card:ℝ)*
        (4*(Real.log K/Real.log 2)+2) := by
  classical
  let K : ℕ := (Delta+1)*Z^2+1
  let S := FormalAB.Sab87e3d4.A2InheritedPell.solSet 1 Delta h Z
  let phi : (Bool×Bool)×(ℕ×ℕ) → ℤ×ℤ := fun z =>
    (signedNat z.2.2 z.1.1,signedNat z.2.1 z.1.2)
  let T := ((Finset.univ : Finset (Bool×Bool)) ×ˢ S).image phi
  have hK1 : 1≤K := by dsimp [K]; omega
  have hKbox : ((1:ℤ)*Delta+1)*(Z:ℤ)^2≤(K:ℤ) := by
    dsimp [K]
    nlinarith
  have hprim := FormalAB.Sab87e3d4.A2InheritedPell.prim_count h.natAbs 1 Delta h le_rfl
    (by norm_num) hDelta (by simp) hh Z K hKbox hK1
  refine ⟨T,?_,?_⟩
  · intro X Y hX hY hcop hnorm
    have hx2 : (X.natAbs:ℤ)^2=X^2 := by
      rw [Int.natCast_natAbs]
      by_cases hx : 0≤X
      · rw [abs_of_nonneg hx]
      · rw [abs_of_nonpos (by omega : X≤0),neg_sq]
    have hy2 : (Y.natAbs:ℤ)^2=Y^2 := by
      rw [Int.natCast_natAbs]
      by_cases hy : 0≤Y
      · rw [abs_of_nonneg hy]
      · rw [abs_of_nonpos (by omega : Y≤0),neg_sq]
    have hcop' : Nat.gcd Y.natAbs X.natAbs=1 := by
      change Nat.gcd X.natAbs Y.natAbs=1 at hcop
      simpa only [Nat.gcd_comm] using hcop
    have hS : (Y.natAbs,X.natAbs)∈S := by
      apply FormalAB.Sab87e3d4.A2InheritedPell.mem_solSet.mpr
      refine ⟨hY,hX,hcop',?_⟩
      simpa only [Nat.cast_one,one_mul,hx2,hy2] using hnorm
    apply Finset.mem_image.mpr
    refine ⟨((decide (0≤X),decide (0≤Y)),(Y.natAbs,X.natAbs)),
      Finset.mem_product.mpr ⟨Finset.mem_univ _,hS⟩,?_⟩
    exact Prod.ext (signed_natAbs X) (signed_natAbs Y)
  · have hcard : T.card≤4*S.card := by
      calc
        T.card≤((Finset.univ : Finset (Bool×Bool)) ×ˢ S).card := Finset.card_image_le
        _ = 4*S.card := by simp
    have hcardR : (T.card:ℝ)≤4*(S.card:ℝ) := by exact_mod_cast hcard
    calc
      (T.card:ℝ)≤4*(S.card:ℝ) := hcardR
      _ ≤4*(2*(h.natAbs.divisors.card:ℝ)*(4*(Real.log K/Real.log 2)+2)) :=
        mul_le_mul_of_nonneg_left hprim (by norm_num)
      _ = _ := by ring

private lemma signedNat_natAbs (n : ℕ) (s : Bool) : (signedNat n s).natAbs=n := by
  cases s <;> simp [signedNat]

private lemma signedNat_sq (n : ℕ) (s : Bool) : (signedNat n s)^2=(n:ℤ)^2 := by
  cases s <;> simp [signedNat]

private lemma signedNat_mul (g n : ℕ) (s : Bool) :
    (g:ℤ)*signedNat n s=signedNat (g*n) s := by
  cases s <;> simp [signedNat,Nat.cast_mul]

private theorem norm_gcd_normalization (Delta : ℕ) (h : ℤ) (hh : h≠0)
    (Z : ℕ) (X Y : ℤ) (hX : X.natAbs≤Z) (hY : Y.natAbs≤Z)
    (hnorm : X^2-(Delta:ℤ)*Y^2=h) :
    ∃g:ℕ,∃h0 X0 Y0:ℤ,
      g≠0 ∧ (g:ℤ)^2∣h ∧ h0≠0 ∧ h0∣h ∧
      (g:ℤ)*X0=X ∧ (g:ℤ)*Y0=Y ∧ Int.gcd X0 Y0=1 ∧
      X0.natAbs≤Z ∧ Y0.natAbs≤Z ∧ X0^2-(Delta:ℤ)*Y0^2=h0 := by
  let g := Nat.gcd X.natAbs Y.natAbs
  let nx := X.natAbs/g
  let ny := Y.natAbs/g
  have hxnat : g*nx=X.natAbs := by
    dsimp [g,nx]
    rw [Nat.mul_comm]
    exact Nat.div_mul_cancel (Nat.gcd_dvd_left _ _)
  have hynat : g*ny=Y.natAbs := by
    dsimp [g,ny]
    rw [Nat.mul_comm]
    exact Nat.div_mul_cancel (Nat.gcd_dvd_right _ _)
  have hg : g≠0 := by
    intro hg0
    have hx0 : X=0 := Int.natAbs_eq_zero.mp (by rw [hg0,zero_mul] at hxnat; omega)
    have hy0 : Y=0 := Int.natAbs_eq_zero.mp (by rw [hg0,zero_mul] at hynat; omega)
    exact hh (by simpa [hx0,hy0] using hnorm.symm)
  have hgpos : 0<g := Nat.pos_of_ne_zero hg
  have hprim : Nat.Coprime nx ny :=
    Nat.coprime_div_gcd_div_gcd (m:=X.natAbs) (n:=Y.natAbs) hgpos
  let X0 := signedNat nx (decide (0≤X))
  let Y0 := signedNat ny (decide (0≤Y))
  let h0 : ℤ := (nx:ℤ)^2-(Delta:ℤ)*(ny:ℤ)^2
  have hxscale : (g:ℤ)*X0=X := by
    dsimp [X0]
    rw [signedNat_mul,hxnat]
    exact signed_natAbs X
  have hyscale : (g:ℤ)*Y0=Y := by
    dsimp [Y0]
    rw [signedNat_mul,hynat]
    exact signed_natAbs Y
  have hnorm0 : X0^2-(Delta:ℤ)*Y0^2=h0 := by
    dsimp [X0,Y0,h0]
    rw [signedNat_sq,signedNat_sq]
  have hscale : h=(g:ℤ)^2*h0 := by
    calc
      h=X^2-(Delta:ℤ)*Y^2 := hnorm.symm
      _=((g:ℤ)*X0)^2-(Delta:ℤ)*((g:ℤ)*Y0)^2 := by rw [hxscale,hyscale]
      _=(g:ℤ)^2*(X0^2-(Delta:ℤ)*Y0^2) := by ring
      _=(g:ℤ)^2*h0 := by rw [hnorm0]
  have hh0 : h0≠0 := by
    intro hz
    apply hh
    rw [hscale,hz,mul_zero]
  have hgdiv : (g:ℤ)^2∣h := ⟨h0,hscale⟩
  have hh0div : h0∣h := ⟨(g:ℤ)^2,by rw [hscale,mul_comm]⟩
  refine ⟨g,h0,X0,Y0,hg,hgdiv,hh0,hh0div,hxscale,hyscale,?_,?_,?_,hnorm0⟩
  · change Nat.gcd X0.natAbs Y0.natAbs=1
    dsimp [X0,Y0]
    rw [signedNat_natAbs,signedNat_natAbs]
    exact hprim.gcd_eq_one
  · dsimp [X0]
    rw [signedNat_natAbs]
    exact (Nat.div_le_self _ _).trans hX
  · dsimp [Y0]
    rw [signedNat_natAbs]
    exact (Nat.div_le_self _ _).trans hY

private lemma divisor_card_mono_int (a h : ℤ) (hh : h≠0) (had : a∣h) :
    a.natAbs.divisors.card≤h.natAbs.divisors.card := by
  have hnat : a.natAbs∣h.natAbs := by
    obtain ⟨c,hc⟩ := had
    refine ⟨c.natAbs,?_⟩
    simpa only [Int.natAbs_mul] using congrArg Int.natAbs hc
  apply Finset.card_le_card
  intro n hn
  exact Nat.mem_divisors.mpr ⟨(Nat.mem_divisors.mp hn).1.trans hnat,
    Int.natAbs_ne_zero.mpr hh⟩

private theorem all_norm_cover (Delta : ℕ) (h : ℤ) (Z : ℕ)
    (hDelta : 0<Delta) (hh : h≠0) :
    let K : ℕ := (Delta+1)*Z^2+1;
    ∃T : Finset (ℤ×ℤ),
      (∀X Y:ℤ,X.natAbs≤Z → Y.natAbs≤Z →
        X^2-(Delta:ℤ)*Y^2=h → (X,Y)∈T) ∧
