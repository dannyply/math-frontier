open Polynomial

private theorem bandCuts_contains_root
    (κ lam z₀ γ x H s : ℝ) (hγ : γ ≠ 0)
    (hroot :
      bandF κ lam (z₀ + γ * s) = x / 2 ∨
      bandF κ lam (z₀ + γ * s) = x ∨
      deriv (fun t : ℝ => bandF κ lam (z₀ + γ * t)) s = H ∨
      deriv (fun t : ℝ => bandF κ lam (z₀ + γ * t)) s = -H) :
    s ∈ bandCuts κ lam z₀ γ x H := by
  classical
  obtain ⟨hN0, hN10⟩ :=
    band_cut_polys_nonzero κ lam z₀ γ x H hγ
  rcases hroot with hlow | hhigh | hplus | hminus
  · have hp : (bandNpoly κ lam z₀ γ - C (x / 2)).eval s = 0 := by
      rw [eval_sub, eval_C, bandNpoly_eval]
      linarith
    simp only [bandCuts, Finset.mem_union]
    left; left
    simpa only [Multiset.mem_toFinset] using
      (Polynomial.mem_roots (hN0 (x / 2))).2 hp
  · have hp : (bandNpoly κ lam z₀ γ - C x).eval s = 0 := by
      rw [eval_sub, eval_C, bandNpoly_eval]
      linarith
    simp only [bandCuts, Finset.mem_union]
    left; right
    simpa only [Multiset.mem_toFinset] using
      (Polynomial.mem_roots (hN0 x)).2 hp
  · have hp : (bandN1poly κ lam z₀ γ - C H).eval s = 0 := by
      rw [eval_sub, eval_C, bandN1poly_eval]
      linarith
    simp only [bandCuts, Finset.mem_union]
    right; left
    simpa [sub_eq_add_neg] using
      (Polynomial.mem_roots (hN10 (-H))).2
        (by simpa [sub_eq_add_neg] using hp)
  · have hp : (bandN1poly κ lam z₀ γ + C H).eval s = 0 := by
      rw [eval_add, eval_C, bandN1poly_eval]
      linarith
    simp only [bandCuts, Finset.mem_union]
    right; right
    simpa only [Multiset.mem_toFinset] using
      (Polynomial.mem_roots (hN10 H)).2 hp

end A7PureNineSignedLevel

