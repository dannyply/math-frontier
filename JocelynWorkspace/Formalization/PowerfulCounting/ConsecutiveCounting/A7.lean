      rcases FormalAB.S5a5b0bd5.A5CoarseOriginalPointRoot.primitive_zero_square
        a b (d.eval s) (e.eval s) (m:ℝ) hprim hlevs.symm hab0 with hd|he
      · have hd4 : (m:ℝ)^4=(d.eval s)^4 := by nlinarith only [congrArg (fun z:ℝ=>z^2) hd]
        rw [←hd4] at hW4
        have hh := mul_le_mul_of_nonneg_left hleft.2 (by positivity : 0≤256*(m:ℝ)^4)
        nlinarith only [hW4,hh]
