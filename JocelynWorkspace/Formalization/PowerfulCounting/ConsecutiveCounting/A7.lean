private lemma mixed_unit_bound (p q : ℝ) (hp : 0 ≤ p) (hq : 0 ≤ q) :
    (p^4*q)^((1 : ℝ)/10) ≤ 1+p^2+q^2 := by
  let w : ℝ := 1+p^2+q^2
  have hw1 : 1 ≤ w := by dsimp [w]; nlinarith only [sq_nonneg p,sq_nonneg q]
  have hw0 : 0 < w := by linarith only [hw1]
  have hpw : p^2 ≤ w := by dsimp [w]; nlinarith only [sq_nonneg q]
  have hqw : q^2 ≤ w := by dsimp [w]; nlinarith only [sq_nonneg p]
  have hpPow : (p^4)^((1 : ℝ)/10) = (p^2)^((1 : ℝ)/5) := by
    rw [powers p hp 4,powers p hp 2]
    norm_num
  have hqPow : q^((1 : ℝ)/10) = (q^2)^((1 : ℝ)/20) := by
    rw [powers q hq 2]
    norm_num
  calc
    (p^4*q)^((1 : ℝ)/10) =
        (p^2)^((1 : ℝ)/5)*(q^2)^((1 : ℝ)/20) := by
      rw [Real.mul_rpow (by positivity) hq,hpPow,hqPow]
    _ ≤ w^((1 : ℝ)/5)*w^((1 : ℝ)/20) :=
      mul_le_mul
        (Real.rpow_le_rpow (sq_nonneg p) hpw (by norm_num))
        (Real.rpow_le_rpow (sq_nonneg q) hqw (by norm_num))
        (Real.rpow_nonneg (sq_nonneg q) _) (Real.rpow_nonneg hw0.le _)
    _ = w^((1 : ℝ)/4) := by
      rw [←Real.rpow_add hw0]
      norm_num
    _ ≤ w^(1 : ℝ) := Real.rpow_le_rpow_of_exponent_le hw1 (by norm_num)
    _ = 1+p^2+q^2 := by rw [Real.rpow_one]

private lemma scaled_mixed_bound (l t r v : ℝ)
    (hl : 0 ≤ l) (ht : 0 ≤ t) (hr : 0 < r) (hv : 0 < v) :
    (l^4*t)^((1 : ℝ)/10) ≤
      (r^4*v)^((1 : ℝ)/10)*(1+(l/r)^2+(t/v)^2) := by
  have hid : l^4*t=(r^4*v)*((l/r)^4*(t/v)) := by
    field_simp [hr.ne',hv.ne']
    <;> ring
  calc
    (l^4*t)^((1 : ℝ)/10) =
        (r^4*v)^((1 : ℝ)/10)*((l/r)^4*(t/v))^((1 : ℝ)/10) := by
      rw [hid,Real.mul_rpow (by positivity) (by positivity)]
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (mixed_unit_bound (l/r) (t/v) (div_nonneg hl hr.le) (div_nonneg ht hv.le))
      (Real.rpow_nonneg (by positivity) _)

private theorem mixed_raw_sum10 (J : Finset ℕ) (m R S A : ℝ) (L T : ℕ → ℝ)
    (hm : 0 < m) (hR : 0 < R) (hS : 0 < S) (hA : 1 ≤ A)
    (hcard : (J.card : ℝ) ≤ 4*m)
    (hL : ∀ j ∈ J, 0 ≤ L j) (hT : ∀ j ∈ J, 0 ≤ T j)
    (hLm : (∑ j ∈ J, (L j)^2) ≤ A*R)
    (hTm : (∑ j ∈ J, (T j)^2) ≤ A*S) :
    (∑ j ∈ J, (1+((L j)^4*T j)^((1 : ℝ)/10))) ≤
      10*A*(m+m^((3 : ℝ)/4)*R^((1 : ℝ)/5)*S^((1 : ℝ)/20)) := by
  let r : ℝ := (R/m)^((1 : ℝ)/2)
  let v : ℝ := (S/m)^((1 : ℝ)/2)
  have hr : 0 < r := Real.rpow_pos_of_pos (by positivity) _
  have hv : 0 < v := Real.rpow_pos_of_pos (by positivity) _
  have hr2 : r^2 = R/m := by
    dsimp [r]
    rw [←Real.rpow_natCast,←Real.rpow_mul (by positivity : 0 ≤ R/m)]
    norm_num
  have hv2 : v^2 = S/m := by
    dsimp [v]
    rw [←Real.rpow_natCast,←Real.rpow_mul (by positivity : 0 ≤ S/m)]
    norm_num
  have hLratio : (∑ j ∈ J, (L j/r)^2) ≤ A*m := by
    calc
      (∑ j ∈ J, (L j/r)^2) = (∑ j ∈ J, (L j)^2)/r^2 := by
        simp only [div_pow,Finset.sum_div]
      _ ≤ (A*R)/r^2 := div_le_div_of_nonneg_right hLm (sq_nonneg r)
      _ = A*m := by rw [hr2]; field_simp [hR.ne',hm.ne']
  have hTratio : (∑ j ∈ J, (T j/v)^2) ≤ A*m := by
    calc
      (∑ j ∈ J, (T j/v)^2) = (∑ j ∈ J, (T j)^2)/v^2 := by
        simp only [div_pow,Finset.sum_div]
      _ ≤ (A*S)/v^2 := div_le_div_of_nonneg_right hTm (sq_nonneg v)
      _ = A*m := by rw [hv2]; field_simp [hS.ne',hm.ne']
  have hcardA : (J.card : ℝ) ≤ 4*A*m := by
    have ht := mul_le_mul_of_nonneg_right hA (show 0 ≤ 4*m by positivity)
    nlinarith only [hcard,ht]
  have hnorm : (∑ j ∈ J, (1+(L j/r)^2+(T j/v)^2)) ≤ 6*A*m := by
    simp only [Finset.sum_add_distrib,Finset.sum_const,nsmul_eq_mul,mul_one]
    linarith only [hcardA,hLratio,hTratio]
  have hfactor :
      (r^4*v)^((1 : ℝ)/10)*m =
        m^((3 : ℝ)/4)*R^((1 : ℝ)/5)*S^((1 : ℝ)/20) := by
    rw [Real.mul_rpow (by positivity : 0 ≤ r^4) hv.le,powers r hr.le 4]
    dsimp only [r,v]
    rw [←Real.rpow_mul (by positivity : 0 ≤ R/m),
      ←Real.rpow_mul (by positivity : 0 ≤ S/m)]
    norm_num
    rw [Real.div_rpow hR.le hm.le,Real.div_rpow hS.le hm.le]
    have he : m^((1 : ℝ)/5)*m^((1 : ℝ)/20)=m^((1 : ℝ)/4) := by
      rw [←Real.rpow_add hm]
      norm_num
    have he' : m/m^((1 : ℝ)/4)=m^((3 : ℝ)/4) := by
      calc
        m/m^((1 : ℝ)/4) = m^(1 : ℝ)/m^((1 : ℝ)/4) := by rw [Real.rpow_one]
        _ = m^((1 : ℝ)-(1 : ℝ)/4) := (Real.rpow_sub hm _ _).symm
        _ = m^((3 : ℝ)/4) := by norm_num
    calc
      R^((1 : ℝ)/5)/m^((1 : ℝ)/5)*
          (S^((1 : ℝ)/20)/m^((1 : ℝ)/20))*m =
        (m/(m^((1 : ℝ)/5)*m^((1 : ℝ)/20)))*
          R^((1 : ℝ)/5)*S^((1 : ℝ)/20) := by ring
      _ = _ := by rw [he,he']
  have hmix : (∑ j ∈ J, ((L j)^4*T j)^((1 : ℝ)/10)) ≤
      6*A*(m^((3 : ℝ)/4)*R^((1 : ℝ)/5)*S^((1 : ℝ)/20)) := by
    calc
      (∑ j ∈ J, ((L j)^4*T j)^((1 : ℝ)/10)) ≤
          ∑ j ∈ J, (r^4*v)^((1 : ℝ)/10)*(1+(L j/r)^2+(T j/v)^2) :=
        Finset.sum_le_sum (fun j hj => scaled_mixed_bound (L j) (T j) r v
          (hL j hj) (hT j hj) hr hv)
      _ = (r^4*v)^((1 : ℝ)/10)*
          (∑ j ∈ J, (1+(L j/r)^2+(T j/v)^2)) := by rw [Finset.mul_sum]
      _ ≤ (r^4*v)^((1 : ℝ)/10)*(6*A*m) :=
        mul_le_mul_of_nonneg_left hnorm (by positivity)
      _ = _ := by rw [show (r^4*v)^((1 : ℝ)/10)*(6*A*m)=
          6*A*((r^4*v)^((1 : ℝ)/10)*m) by ring,hfactor]
  have hRpow : 0 ≤ m^((3 : ℝ)/4)*R^((1 : ℝ)/5)*S^((1 : ℝ)/20) := by positivity
  have hA0 : 0 ≤ A := by linarith only [hA]
  simp only [Finset.sum_add_distrib,Finset.sum_const,nsmul_eq_mul,mul_one]
  nlinarith only [hcardA,hmix,mul_nonneg hA0 hm.le,mul_nonneg hA0 hRpow]

private lemma cofactor_side_nominal4 (M : ℕ) (U V r : ℝ)
