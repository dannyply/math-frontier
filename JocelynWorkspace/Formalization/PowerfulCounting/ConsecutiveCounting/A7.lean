    have hcard : T.card≤∑j:E,(F j).card := by
      calc
        T.card≤((Finset.univ : Finset E).sigma F).card := Finset.card_image_le
        _ = ∑j:E,(F j).card := Finset.card_sigma _ _
    have hcardR : (T.card:ℝ)≤∑j:E,((F j).card:ℝ) := by exact_mod_cast hcard
