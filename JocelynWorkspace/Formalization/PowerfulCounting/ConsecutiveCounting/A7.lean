private def quarticOriginalPositiveTransportStatement : Prop :=
  ∀ c : ℝ,
    (∀ δ : ℕ, 1 ≤ δ →
      ∀ I : Ideal (MvPolynomial (Fin 10) ℚ), I.IsPrime →
        ringKrullDim (MvPolynomial (Fin 10) ℚ ⧸ I) = 1 →
        (∃ e : ℤ, ∃ s₀ : ℕ, ∀ s : ℕ, s₀ ≤ s →
          (Module.finrank ℚ
            (Submodule.map (Ideal.Quotient.mkₐ ℚ I).toLinearMap
              (MvPolynomial.restrictTotalDegree (Fin 10) ℚ s)) : ℤ) =
                (δ : ℤ) * (s : ℤ) + e) →
        ∀ H : ℝ, 1 ≤ H →
          (({P : Fin 10 → ℤ |
            (∀ f ∈ I, MvPolynomial.eval (fun i => (P i : ℚ)) f = 0) ∧
            ∀ i, |(P i : ℝ)| ≤ H} : Set (Fin 10 → ℤ)).ncard : ℝ) ≤
              c * (δ : ℝ) ^ 3 * H ^ (1 / (δ : ℝ)) *
                (Real.log H + (δ : ℝ))) →
    ∀ α β : ℕ, 8 ≤ α + 4 * β →
      ∀ G : MvPolynomial (Fin 4) ℤ,
        G ≠ 0 →
        (∀ m ∈ G.support, m 0 + m 1 = α ∧ m 2 + m 3 = β) →
        Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G) →
        ∀ A B : Matrix (Fin 2) (Fin 2) ℤ,
          (A.det = 1 ∨ A.det = -1) →
          (B.det = 1 ∨ B.det = -1) →
          ∀ L₁ L₂ T₁ T₂ : ℝ,
            L₂ ≤ L₁ → 0 < L₂ → T₂ ≤ T₁ → 0 < T₂ →
            ∀ h : ℤ, (h = 1 ∨ h = -1) →
              let δ : ℝ := (α + 4 * β : ℕ)
              let H : ℝ := max 1 (L₁ ^ 4 * T₁)
              let S : Set ((ℕ × ℕ) × (ℕ × ℕ)) :=
                {q | 1 ≤ q.1.1 ∧ 1 ≤ q.1.2 ∧ 1 ≤ q.2.1 ∧ 1 ≤ q.2.2 ∧
                  ((q.1.2 ^ 4 * q.2.2 : ℕ) : ℤ) =
                    ((q.1.1 ^ 4 * q.2.1 : ℕ) : ℤ) + h ∧
                  |((A.mulVec ![(q.1.1 : ℤ), (q.1.2 : ℤ)]) 0 : ℝ)| ≤ L₁ ∧
                  |((A.mulVec ![(q.1.1 : ℤ), (q.1.2 : ℤ)]) 1 : ℝ)| ≤ L₂ ∧
                  |((B.mulVec ![(q.2.2 : ℤ), (q.2.1 : ℤ)]) 0 : ℝ)| ≤ T₁ ∧
                  |((B.mulVec ![(q.2.2 : ℤ), (q.2.1 : ℤ)]) 1 : ℝ)| ≤ T₂ ∧
                  MvPolynomial.eval
                    ![(q.1.1 : ℤ), (q.1.2 : ℤ), (q.2.1 : ℤ), (q.2.2 : ℤ)] G = 0}
              S.Finite ∧
                (S.ncard : ℝ) ≤ 2 * |c| * δ ^ 3 * H ^ (1 / δ) *
                  (Real.log H + δ)

open FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry

private abbrev Poly := MvPolynomial (Fin 4) ℤ
private abbrev Point := ((ℕ × ℕ) × (ℕ × ℕ))

private def Bihom (G : Poly) (a b : ℕ) : Prop :=
  ∀ m ∈ G.support, m 0 + m 1 = a ∧ m 2 + m 3 = b

private def Primitive (G : Poly) : Prop :=
  ∀ z : ℤ, (∀ m : Fin 4 →₀ ℕ, z ∣ G.coeff m) → IsUnit z

private def HighFactor (F G : Poly) : Prop :=
  G ∣ F ∧ G ≠ 0 ∧ Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G) ∧
    ∃ a b : ℕ, 1 ≤ a ∧ 1 ≤ b ∧ 8 ≤ a + 4*b ∧ Bihom G a b

private def HighCell (x D E : ℝ) (M j : ℕ) (h : ℤ) (G : Poly) : Set Point :=
  {z | z ∈ quartCell x D E M j h ∧
    MvPolynomial.eval ![(z.1.1 : ℤ),(z.1.2 : ℤ),(z.2.1 : ℤ),(z.2.2 : ℤ)] G = 0}

private def HighUnion (x D E : ℝ) (M j : ℕ) (h : ℤ) (F : Poly) : Set Point :=
  {z | z ∈ quartCell x D E M j h ∧ ∃ G : Poly, HighFactor F G ∧
    MvPolynomial.eval ![(z.1.1 : ℤ),(z.1.2 : ℤ),(z.2.1 : ℤ),(z.2.2 : ℤ)] G = 0}

namespace FactorAlgebra
namespace A5FactorDegreeTrial
open MvPolynomial

private theorem totalDegree_prod_eq_sum
    (s : Multiset (MvPolynomial (Fin 4) ℤ))
    (hs : ∀ p ∈ s, p ≠ 0) :
    s.prod ≠ 0 ∧
      s.prod.totalDegree = (s.map MvPolynomial.totalDegree).sum := by
  induction s using Multiset.induction_on with
  | empty => simp
  | @cons p t ih =>
      have hp : p ≠ 0 := hs p (by simp)
      have ht : ∀ q ∈ t, q ≠ 0 := by
        intro q hq
        exact hs q (by simp [hq])
      obtain ⟨ht0, htd⟩ := ih ht
      constructor
      · simpa using mul_ne_zero hp ht0
      · simp only [Multiset.prod_cons, Multiset.map_cons, Multiset.sum_cons]
        rw [MvPolynomial.totalDegree_mul_of_isDomain hp ht0, htd]

private theorem degree_le_of_dvd (a b : MvPolynomial (Fin 4) ℤ)
    (ha : a ≠ 0) (hb : b ≠ 0) (hab : a ∣ b) :
    a.totalDegree ≤ b.totalDegree := by
  obtain ⟨c, rfl⟩ := hab
  have hc : c ≠ 0 := by
    intro hc
    simp [hc] at hb
  rw [MvPolynomial.totalDegree_mul_of_isDomain ha hc]
  omega

private theorem degree_eq_of_associated (a b : MvPolynomial (Fin 4) ℤ)
    (ha : a ≠ 0) (hb : b ≠ 0) (hab : Associated a b) :
    a.totalDegree = b.totalDegree := by
  exact le_antisymm (degree_le_of_dvd a b ha hb hab.dvd)
    (degree_le_of_dvd b a hb ha hab.symm.dvd)

private theorem exists_prime_factors_degree (F : MvPolynomial (Fin 4) ℤ)
    (hF : F ≠ 0) :
    ∃ s : Multiset (MvPolynomial (Fin 4) ℤ),
      (∀ p ∈ s, Prime p) ∧
        Associated s.prod F ∧
          (s.map MvPolynomial.totalDegree).sum = F.totalDegree := by
  obtain ⟨s, hprime, hassoc⟩ :=
    UniqueFactorizationMonoid.exists_prime_factors F hF
  have hs : ∀ p ∈ s, p ≠ 0 := by
    intro p hp
    exact (hprime p hp).ne_zero
  obtain ⟨hs0, hdeg⟩ := totalDegree_prod_eq_sum s hs
  refine ⟨s, hprime, hassoc, ?_⟩
  rw [← hdeg]
  exact degree_eq_of_associated s.prod F hs0 hF hassoc

private theorem card_positive_degree_le_sum
    (s : Multiset (MvPolynomial (Fin 4) ℤ)) :
    (s.filter (fun p => 0 < p.totalDegree)).card ≤
      (s.map MvPolynomial.totalDegree).sum := by
  induction s using Multiset.induction_on with
  | empty => simp
  | @cons p t ih =>
      by_cases hp : 0 < p.totalDegree
      · simp only [Multiset.filter_cons, if_pos hp, Multiset.card_add,
          Multiset.card_singleton, Multiset.map_cons, Multiset.sum_cons]
        omega
      · simp only [Multiset.filter_cons, if_neg hp, zero_add,
          Multiset.map_cons, Multiset.sum_cons]
        omega

private theorem exists_bounded_prime_family (F : MvPolynomial (Fin 4) ℤ)
    (hF : F ≠ 0) (D : ℕ) (hdeg : F.totalDegree ≤ D) :
    ∃ S : Finset (MvPolynomial (Fin 4) ℤ),
      S.card ≤ D ∧
        ∀ p ∈ S, Prime p ∧ 0 < p.totalDegree ∧ p ∣ F := by
  obtain ⟨s, hprime, hassoc, hsum⟩ := exists_prime_factors_degree F hF
  classical
  let S : Finset (MvPolynomial (Fin 4) ℤ) :=
    (s.filter (fun p => 0 < p.totalDegree)).toFinset
  refine ⟨S, ?_, ?_⟩
  · have h1 := Multiset.toFinset_card_le
      (s.filter (fun p => 0 < p.totalDegree))
    have h2 := card_positive_degree_le_sum s
    dsimp [S]
    omega
  · intro p hp
    have hp' : p ∈ s.filter (fun p => 0 < p.totalDegree) :=
      (Multiset.mem_toFinset).mp hp
    obtain ⟨hps, hpos⟩ := Multiset.mem_filter.mp hp'
    have hpd : p ∣ s.prod := Multiset.dvd_prod hps
    exact ⟨hprime p hps, hpos, hpd.trans hassoc.dvd⟩

end A5FactorDegreeTrial

namespace A5PrimitiveNormalizationTrial

private def PrimitiveIntegral (G : MvPolynomial (Fin 4) ℤ) : Prop :=
  ∀ z : ℤ,
    (∀ m : Fin 4 →₀ ℕ, z ∣ MvPolynomial.coeff m G) →
      IsUnit z

private theorem primitive_of_irreducibles
    (p : MvPolynomial (Fin 4) ℤ)
    (hp : Irreducible p)
    (hpC : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) p)) :
    PrimitiveIntegral p := by
  intro z hz
  have hd : MvPolynomial.C z ∣ p :=
    (MvPolynomial.C_dvd_iff_dvd_coeff z p).mpr hz
  have hz0 : z ≠ 0 := by
    intro hz0
    subst z
    obtain ⟨q, hq⟩ := hd
    have hp0 : p = 0 := by simpa using hq
    exact hp.ne_zero hp0
  rcases (hp.dvd_iff).mp hd with hu | ha
  · let ev : MvPolynomial (Fin 4) ℤ →+* ℤ :=
      MvPolynomial.eval₂Hom (RingHom.id ℤ) (fun _ => 0)
    have he : IsUnit (ev (MvPolynomial.C z)) := hu.map ev
    simpa [ev] using he
  · have hpz : p ∣ MvPolynomial.C z := ha.dvd
    obtain ⟨b, hbz, hpb⟩ := (MvPolynomial.dvd_C_iff_exists hz0).mp hpz
    have hb0 : b ≠ 0 := by
      intro hb0
      have hp0 : p = 0 := by simpa [hb0] using hpb
      exact hp.ne_zero hp0
    have hbC : (b : ℂ) ≠ 0 := by exact_mod_cast hb0
    have huC : IsUnit (MvPolynomial.C (b : ℂ) : MvPolynomial (Fin 4) ℂ) :=
      ((isUnit_iff_ne_zero).mpr hbC).map (MvPolynomial.C : ℂ →+* MvPolynomial (Fin 4) ℂ)
    have hmap : MvPolynomial.map (Int.castRingHom ℂ) p =
        MvPolynomial.C (b : ℂ) := by solve | simp [hpb]
    exact False.elim (hpC.not_isUnit (hmap.symm ▸ huC))

end A5PrimitiveNormalizationTrial

