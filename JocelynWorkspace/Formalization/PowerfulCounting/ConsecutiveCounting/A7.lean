def Q4 (t : ℚ) : ℚ := (16 + 35 * t - 35 * t ^ 3 + 21 * t ^ 5 - 5 * t ^ 7) / 32

def excT (x : ℝ) : Set ((ℕ × ℕ) × (ℕ × ℕ)) :=
  {z | 1 ≤ z.1.1 ∧ 1 ≤ z.1.2 ∧ 1 ≤ z.2.1 ∧ 1 ≤ z.2.2 ∧ z.1.2 ^ 4 * z.2.2 = z.1.1 ^ 4 * z.2.1 + 1 ∧
