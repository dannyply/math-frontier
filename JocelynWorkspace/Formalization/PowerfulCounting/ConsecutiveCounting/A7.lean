            Finset.sum_le_sum (fun G hGS => hprices j hj G hGS)
          _ = ((S j).card : ℝ)*(Ccell*x^η*(1+((L j)^4*T j)^((1 : ℝ)/10))) := by
            simp only [Finset.sum_const,nsmul_eq_mul]
          _ ≤ (N : ℝ)*(Ccell*x^η*(1+((L j)^4*T j)^((1 : ℝ)/10))) :=
            mul_le_mul_of_nonneg_right hcR
              (mul_nonneg (mul_nonneg hCcell hηx0)
                (add_nonneg (by norm_num)
                  (Real.rpow_nonneg
                    (mul_nonneg (pow_nonneg (hLpos j).le 4) (hTpos j).le) _)))
          _ = _ := by ring
      have htotal :
          (∑ j ∈ quarticCells D E M, ∑ G ∈ S j,
              ((HighCell x D E M j h G).ncard : ℝ)) ≤
            ((N : ℝ)*Ccell*x^η)*
              (∑ j ∈ quarticCells D E M, (1+((L j)^4*T j)^((1 : ℝ)/10))) := by
        calc
          _ ≤ ∑ j ∈ quarticCells D E M,
              (N : ℝ)*Ccell*x^η*(1+((L j)^4*T j)^((1 : ℝ)/10)) :=
            Finset.sum_le_sum hlocal
          _ = _ := by rw [Finset.mul_sum]
      have hdouble : η+η=ε := by dsimp [η]; ring
      have hCbound : 10*(N : ℝ)*Ccell*(1+256*Cm) ≤ C := by dsimp [C]; linarith
      calc
        (∑ j ∈ quarticCells D E M, ∑ G ∈ S j,
            ((HighCell x D E M j h G).ncard : ℝ)) ≤
            ((N : ℝ)*Ccell*x^η)*
              (10*A*((M : ℝ)+(M : ℝ)^((3 : ℝ)/4)*RD^((1 : ℝ)/5)*RU^((1 : ℝ)/20))) :=
          htotal.trans (mul_le_mul_of_nonneg_left hsum (by positivity))
        _ = (10*(N : ℝ)*Ccell*(1+256*Cm))*(x^η*x^η)*
            ((M : ℝ)+(M : ℝ)^((3 : ℝ)/4)*RD^((1 : ℝ)/5)*RU^((1 : ℝ)/20)) := by
          dsimp [A]
          ring
        _ = (10*(N : ℝ)*Ccell*(1+256*Cm))*x^ε*
            ((M : ℝ)+(M : ℝ)^((3 : ℝ)/4)*RD^((1 : ℝ)/5)*RU^((1 : ℝ)/20)) := by
