      calc
        T.card≤((Finset.univ : Finset (Bool×Bool)) ×ˢ S).card := Finset.card_image_le
        _ = 4*S.card := by simp
    have hcardR : (T.card:ℝ)≤4*(S.card:ℝ) := by exact_mod_cast hcard
    calc
      (T.card:ℝ)≤4*(S.card:ℝ) := hcardR
      _ ≤4*(2*(h.natAbs.divisors.card:ℝ)*(4*(Real.log K/Real.log 2)+2)) :=
        mul_le_mul_of_nonneg_left hprim (by norm_num)
      _ = _ := by ring

