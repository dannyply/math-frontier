let IntegerPoint := Fin 2 → ℤ;
let IntegerMatrix := Matrix (Fin 2) (Fin 2) ℤ;
let OriginalPoint := Fin 4 → ℕ;
let U : ℝ → ℝ → ℝ := fun D x => x / D ^ (3 : ℕ);
let V : ℝ → ℝ → ℝ := fun E x => x / E ^ (3 : ℕ);
let rho : ℝ → ℝ → ℕ → ℕ → ℝ :=
  fun D E M j => D / (2 * E) * (1 + 1 / (M : ℝ)) ^ j;
let indices : ℝ → ℝ → ℕ → Set ℕ :=
  fun D E M => {j | D / (2 * E) ≤ rho D E M j ∧ rho D E M j ≤ 2 * D / E};
let reciprocalShortestNorm : ℝ → ℝ → ℝ → ℝ → ℝ :=
  fun A B m s =>
    1 / sInf {r : ℝ | ∃ z : IntegerPoint, z ≠ 0 ∧
      Real.sqrt (((m / A) * ((z 0 : ℝ) - s * (z 1 : ℝ))) ^ 2 +
        ((z 1 : ℝ) / B) ^ 2) = r};
let matrixBound : IntegerMatrix → ℝ → Prop :=
  fun P H => ∀ i j : Fin 2, |(P i j : ℝ)| ≤ H;
let originalPopulation : ℝ → ℝ → ℝ → Set OriginalPoint :=
  fun x D E =>
    {z |
      (∀ i : Fin 4, 0 < z i) ∧
      D / 2 < (z 0 : ℝ) ∧ (z 0 : ℝ) ≤ D ∧
      E / 2 < (z 1 : ℝ) ∧ (z 1 : ℝ) ≤ E ∧
      x / 2 < (z 0 : ℝ) ^ 3 * (z 2 : ℝ) ∧
      (z 0 : ℝ) ^ 3 * (z 2 : ℝ) ≤ x ∧
      (z 1 : ℤ) ^ 3 * (z 3 : ℤ) -
        (z 0 : ℤ) ^ 3 * (z 2 : ℤ) = 1};
let sourceCell : ℝ → ℝ → ℝ → ℕ → ℕ → Set OriginalPoint :=
  fun x D E M j =>
    {z | z ∈ originalPopulation x D E ∧
      rho D E M j < (z 0 : ℝ) / (z 1 : ℝ) ∧
      (z 0 : ℝ) / (z 1 : ℝ) ≤
        rho D E M j * (1 + 1 / (M : ℝ))};
∃ Cphys : ℝ, 0 < Cphys ∧
  ∀ K eps : ℝ, 0 < K → 0 < eps →
    ∃ C : ℝ, 0 < C ∧
      ∀ x D E : ℝ, 2 ≤ x →
        1 / 2 ≤ D → D ≤ x ^ K →
        1 / 2 ≤ E → E ≤ x ^ K →
        ∀ M : ℕ, 1 ≤ M → (M : ℝ) ≤ x → (M : ℝ) ≤ x ^ K →
          let J := indices D E M;
