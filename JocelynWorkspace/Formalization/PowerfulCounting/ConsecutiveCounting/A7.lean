@[simp] lemma ex_zero (k l : ℕ) : ex k l 0 = k := by simp [ex]
@[simp] lemma ex_one (k l : ℕ) : ex k l 1 = l := by simp [ex]

lemma ex_eq_iff (k l : ℕ) (m : Fin 2 →₀ ℕ) : ex k l = m ↔ m 0 = k ∧ m 1 = l := by
  constructor
  · rintro rfl; simp
  · rintro ⟨h0, h1⟩; ext i; fin_cases i <;> simp [h0, h1]

