    dsimp [g,nx]
    rw [Nat.mul_comm]
    exact Nat.div_mul_cancel (Nat.gcd_dvd_left _ _)
  have hynat : g*ny=Y.natAbs := by
    dsimp [g,ny]
    rw [Nat.mul_comm]
    exact Nat.div_mul_cancel (Nat.gcd_dvd_right _ _)
  have hg : g≠0 := by
    intro hg0
    have hx0 : X=0 := Int.natAbs_eq_zero.mp (by rw [hg0,zero_mul] at hxnat; omega)
    have hy0 : Y=0 := Int.natAbs_eq_zero.mp (by rw [hg0,zero_mul] at hynat; omega)
    exact hh (by simpa [hx0,hy0] using hnorm.symm)
  have hgpos : 0<g := Nat.pos_of_ne_zero hg
  have hprim : Nat.Coprime nx ny :=
    Nat.coprime_div_gcd_div_gcd (m:=X.natAbs) (n:=Y.natAbs) hgpos
