  for i in [0:8] do
    let nib := ((x >>> (UInt32.ofNat (4 * (7 - i)))) &&& 15).toNat
    s := s.push (hexDigits.getD nib '?')
  return s

def sha256 (msg : ByteArray) : String := Id.run do
