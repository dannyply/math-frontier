  ring

private theorem bandN1poly_eval (κ lam z₀ γ s : ℝ) :
    (bandN1poly κ lam z₀ γ).eval s =
      deriv (fun t : ℝ => bandF κ lam (z₀ + γ * t)) s := by
  rw [bandN_deriv]
  simp [bandN1poly, bandZpoly, bandF1, bandU, bandG] <;> ring_nf <;> simp

end A7PureNineSignedLevel

