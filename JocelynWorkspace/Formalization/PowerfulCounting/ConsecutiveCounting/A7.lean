    (htop : ∀ s : ℤ × ℕ,
      (F.comp (classAffine p s)).coeff t =
        (p : ℤ) ^ (t * s.2) * F.coeff t)
    (hcert : C ((p : ℤ) ^ r) ∣ F.comp (classAffine p s)) :
    k ≤ s.2 := by
  by_contra hnot
  have hj : s.2 ≤ k - 1 := by omega
  have h5j : t * s.2 ≤ r := by
    have hm := Nat.mul_le_mul_left t hj
    omega
  have hcoeff :
      (p : ℤ) ^ r ∣ (F.comp (classAffine p s)).coeff t :=
    ((Polynomial.C_dvd_iff_dvd_coeff
      ((p : ℤ) ^ r) (F.comp (classAffine p s))).mp hcert) t
  rw [htop s] at hcoeff
  have hp0 : (p : ℤ) ≠ 0 := by exact_mod_cast hp.ne_zero
  have hpow :
      (p : ℤ) ^ (r - t * s.2) ∣ F.coeff t :=
    (cancel_pow_div (p : ℤ) hp0 (t * s.2) r h5j (F.coeff t)).mp hcoeff
  have hle : r - t * (k - 1) ≤ r - t * s.2 := by
    have hm := Nat.mul_le_mul_left t hj
    omega
  exact hcrit ((pow_dvd_pow (p : ℤ) hle).trans hpow)

private theorem covered_centers_at_fixed_depth
    (p r k t : ℕ) (F : Polynomial ℤ) (S : Finset (ℤ × ℕ))
    (hcard : S.card ≤ t)
    (hdepth : ∀ s ∈ S, k ≤ s.2)
    (hcover : ∀ z : ℤ, (p : ℤ) ^ r ∣ F.eval z →
      ∃ s ∈ S, ∃ t : ℤ, z = s.1 + (p : ℤ) ^ s.2 * t) :
    ∃ T : Finset ℤ, T.card ≤ t ∧
      ∀ z : ℤ, (p : ℤ) ^ r ∣ F.eval z →
        ∃ a ∈ T, (p : ℤ) ^ k ∣ z - a := by
  classical
  refine ⟨S.image Prod.fst, (Finset.card_image_le).trans hcard, ?_⟩
  intro z hz
  obtain ⟨s, hs, t, ht⟩ := hcover z hz
  refine ⟨s.1, Finset.mem_image.mpr ⟨s, hs, rfl⟩, ?_⟩
  rw [ht]
  have hpow : (p : ℤ) ^ k ∣ (p : ℤ) ^ s.2 :=
    pow_dvd_pow (p : ℤ) (hdepth s hs)
  simpa only [add_sub_cancel_left] using dvd_mul_of_dvd_left hpow t

private theorem fixed_depth_general_from_generic_cover
    (p r k t : ℕ) [Fact p.Prime] (F : Polynomial ℤ)
    (hdeg : F.natDegree = t)
    (hr : 0 < r) (hk : 0 < k)
    (hrange : t * (k - 1) ≤ r)
    (hcrit : ¬ ((p : ℤ) ^ (r - t * (k - 1)) ∣ F.coeff t))
    (htop : ∀ s : ℤ × ℕ,
      (F.comp (classAffine p s)).coeff t =
        (p : ℤ) ^ (t * s.2) * F.coeff t) :
    ∃ T : Finset ℤ, T.card ≤ t ∧
      ∀ z : ℤ, (p : ℤ) ^ r ∣ F.eval z →
        ∃ a ∈ T, (p : ℤ) ^ k ∣ z - a := by
  classical
  let hp : p.Prime := Fact.out
  have hp0 : (p : ℤ) ≠ 0 := by exact_mod_cast hp.ne_zero
  rcases extract_content p r F with hAll | ⟨v, hv, H, heq, hH⟩
  · have hcoef : (p : ℤ) ^ r ∣ F.coeff t :=
      ((Polynomial.C_dvd_iff_dvd_coeff
        ((p : ℤ) ^ r) F).mp hAll) t
    have hpow : (p : ℤ) ^ (r - t * (k - 1)) ∣
        (p : ℤ) ^ r :=
      pow_dvd_pow (p : ℤ) (by omega)
    exact False.elim (hcrit (hpow.trans hcoef))
  · have hvle : v ≤ r := by omega
    have hHdeg : H.natDegree ≤ t := by
      apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
      intro j hj
      have hFdeg : F.natDegree ≤ t := by omega
      have hzF : F.coeff j = 0 :=
        (Polynomial.natDegree_le_iff_coeff_eq_zero.mp hFdeg) j hj
      rw [heq, Polynomial.coeff_C_mul] at hzF
      apply mul_left_cancel₀ (pow_ne_zero v hp0)
      simpa only [mul_zero] using hzF
    have hmapdeg :
        (Polynomial.map (Int.castRingHom (ZMod p)) H).natDegree ≤ t := by
      apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
      intro j hj
      rw [Polynomial.coeff_map]
      rw [(Polynomial.natDegree_le_iff_coeff_eq_zero.mp hHdeg) j hj]
      simp
    obtain ⟨S, hSc, hSg, hSv⟩ :=
      primitive_cover p (r - v) (by omega) H hH
    have hdepth : ∀ s ∈ S, k ≤ s.2 := by
      intro s hs
      have hcert : C ((p : ℤ) ^ r) ∣
          F.comp (classAffine p s) :=
        restore_content p r v hvle F H (classAffine p s)
          heq (hSg s hs).2
      exact certified_depth_ge_general p r k t F s hp hk hrange
        hcrit htop hcert
    have hcover : ∀ z : ℤ, (p : ℤ) ^ r ∣ F.eval z →
        ∃ s ∈ S, ∃ t : ℤ,
          z = s.1 + (p : ℤ) ^ s.2 * t := by
      intro z hz
      have heval : F.eval z = (p : ℤ) ^ v * H.eval z := by
        rw [heq]
        simp
      have hzH : (p : ℤ) ^ (r - v) ∣ H.eval z :=
        (cancel_pow_div (p : ℤ) hp0 v r hvle (H.eval z)).mp
          (by simpa only [heval] using hz)
      exact hSv z hzH
    exact covered_centers_at_fixed_depth p r k t F S
      (hSc.trans hmapdeg) hdepth hcover

private theorem fixed_depth_general_complete
    (p r k t : ℕ) [Fact p.Prime] (F : Polynomial ℤ)
    (hdeg : F.natDegree = t)
    (hr : 0 < r) (hk : 0 < k)
    (hrange : t * (k - 1) ≤ r)
    (hcrit : ¬ ((p : ℤ) ^ (r - t * (k - 1)) ∣ F.coeff t)) :
    ∃ T : Finset ℤ, T.card ≤ t ∧
      ∀ z : ℤ, (p : ℤ) ^ r ∣ F.eval z →
        ∃ a ∈ T, (p : ℤ) ^ k ∣ z - a := by
  apply fixed_depth_general_from_generic_cover p r k t F
    hdeg hr hk hrange hcrit
  intro s
  simpa only [classAffine, ← pow_mul, Nat.mul_comm s.2 t] using
    affine_top_coeff_general t F hdeg s.1 ((p : ℤ) ^ s.2)

private theorem prime_coordinate_choice
    (p : ℕ) (hp : p.Prime)
    (a b A B : ℤ) (hab : A * a + B * b = 1) :
    ¬ (p : ℤ) ∣ b ∨ ¬ (p : ℤ) ∣ a := by
  by_cases hb : (p : ℤ) ∣ b
  · right
    intro ha
    have hpa : (p : ℤ) ∣ A * a := by
      simpa only [mul_comm] using dvd_mul_of_dvd_right ha A
    have hpb : (p : ℤ) ∣ B * b := by
      simpa only [mul_comm] using dvd_mul_of_dvd_right hb B
    have hpone : (p : ℤ) ∣ (1 : ℤ) := by
      rw [← hab]
      exact dvd_add hpa hpb
    have hpN : p ∣ (1 : ℕ) := by
      have h := (Int.natAbs_dvd_natAbs).2 hpone
      simpa using h
    exact hp.ne_one (Nat.dvd_one.mp hpN)
  · exact Or.inl hb

private theorem original_selected_local_cover
    (k p r delta : ℕ) [Fact p.Prime]
    (a b A B q h m : ℤ) (f g : Polynomial ℤ)
    (hab : A * a + B * b = 1)
    (hq0 : q ≠ 0) (hh0 : h ≠ 0)
    (hfdeg : f.natDegree ≤ k + 1)
    (hgdeg : g.natDegree ≤ k + 1)
    (hftop : f.coeff (k + 1) = q * h ^ k * b ^ k)
    (hgtop : g.coeff (k + 1) =
      (-1 : ℤ) ^ k * q * h ^ k * a ^ k)
    (hr : 0 < r) (hdelta : 0 < delta)
    (hrange : (k + 1) * (delta - 1) ≤ r)
    (hmdiv : (p : ℤ) ^ r ∣ m ^ (2 * k + 1))
    (hcrit : ¬ ((p : ℤ) ^
      (r - (k + 1) * (delta - 1)) ∣
      if (p : ℤ) ∣ b then
        (-1 : ℤ) ^ k * q * h ^ k * a ^ k
      else q * h ^ k * b ^ k)) :
    ∃ T : Finset ℤ, T.card ≤ k + 1 ∧
      ∀ z u v : ℤ,
        f.eval z = m ^ (2 * k + 1) * v →
        g.eval z = m ^ (2 * k + 1) * u →
        ∃ center ∈ T, (p : ℤ) ^ delta ∣ z - center := by
  classical
  let F : Polynomial ℤ := if (p : ℤ) ∣ b then g else f
  have hdegree : F.natDegree = k + 1 := by
    by_cases hb : (p : ℤ) ∣ b
    · have hna : ¬ (p : ℤ) ∣ a :=
        (prime_coordinate_choice p Fact.out a b A B hab).resolve_left
          (not_not.mpr hb)
      have ha0 : a ≠ 0 := by
        intro ha
        exact hna (by simp [ha])
      apply le_antisymm (by simpa [F, hb] using hgdeg)
      apply Polynomial.le_natDegree_of_ne_zero
      simp only [F, if_pos hb, hgtop]
      exact mul_ne_zero
        (mul_ne_zero
          (mul_ne_zero (pow_ne_zero k (by norm_num)) hq0)
          (pow_ne_zero k hh0))
        (pow_ne_zero k ha0)
    · have hb0 : b ≠ 0 := by
        intro hz
        exact hb (by simp [hz])
      apply le_antisymm (by simpa [F, hb] using hfdeg)
      apply Polynomial.le_natDegree_of_ne_zero
      simp only [F, if_neg hb, hftop]
      exact mul_ne_zero
        (mul_ne_zero hq0 (pow_ne_zero k hh0))
        (pow_ne_zero k hb0)
  have hcoeff : F.coeff (k + 1) =
      if (p : ℤ) ∣ b then
        (-1 : ℤ) ^ k * q * h ^ k * a ^ k
      else q * h ^ k * b ^ k := by
    by_cases hb : (p : ℤ) ∣ b
    · simp [F, hb, hgtop]
    · simp [F, hb, hftop]
  have hcritF : ¬ ((p : ℤ) ^
      (r - (k + 1) * (delta - 1)) ∣ F.coeff (k + 1)) := by
    rw [hcoeff]
    exact hcrit
  obtain ⟨T, hTc, hTcover⟩ :=
    fixed_depth_general_complete p r delta (k + 1) F
      hdegree hr hdelta hrange hcritF
  refine ⟨T, hTc, ?_⟩
  intro z u v hf hg
  have hFval : F.eval z =
      m ^ (2 * k + 1) * (if (p : ℤ) ∣ b then u else v) := by
    by_cases hb : (p : ℤ) ∣ b
    · simpa [F, hb] using hg
    · simpa [F, hb] using hf
  have hpval : (p : ℤ) ^ r ∣ F.eval z := by
    rw [hFval]
    exact dvd_mul_of_dvd_left hmdiv _
  exact hTcover z hpval

theorem padic_unit_general
    (p k : ℕ) [Fact p.Prime] (N s : ℤ)
    (hN : N ≠ 0) (hsunit : ¬ (p : ℤ) ∣ s) :
    padicValNat p ((N * s ^ k).natAbs) =
      padicValNat p N.natAbs := by
  have hs0 : s ≠ 0 := by
    intro hzero
    exact hsunit (by simp [hzero])
  have hNabs0 : N.natAbs ≠ 0 :=
    Nat.ne_of_gt (Int.natAbs_pos.mpr hN)
  have hsabs0 : s.natAbs ≠ 0 :=
    Nat.ne_of_gt (Int.natAbs_pos.mpr hs0)
  have hsnot : ¬ p ∣ s.natAbs := by
    intro h
    exact hsunit ((Int.natAbs_dvd_natAbs).1 (by simpa using h))
  have hsval0 : padicValNat p s.natAbs = 0 := by
    by_contra hn
    have hvalpos : 1 ≤ padicValNat p s.natAbs := by omega
    have hdiv : p ^ 1 ∣ s.natAbs :=
      (padicValNat_dvd_iff_le hsabs0).2 hvalpos
    exact hsnot (by simpa using hdiv)
  calc
    padicValNat p ((N * s ^ k).natAbs) =
        padicValNat p (N.natAbs * s.natAbs ^ k) := by
          simp [Int.natAbs_mul, Int.natAbs_pow]
    _ = padicValNat p N.natAbs +
        padicValNat p (s.natAbs ^ k) := by
          exact padicValNat.mul hNabs0 (pow_ne_zero k hsabs0)
    _ = padicValNat p N.natAbs := by
          rw [padicValNat.pow, hsval0]
          omega

theorem padic_noncritical_general
    (p k : ℕ) [Fact p.Prime] (N s : ℤ)
    (hN : N ≠ 0) (hsunit : ¬ (p : ℤ) ∣ s)
    (t : ℕ) (ht : padicValNat p N.natAbs < t) :
    ¬ ((p : ℤ) ^ t ∣ N * s ^ k) := by
  intro hdiv
  have hNat : p ^ t ∣ (N * s ^ k).natAbs := by
    have h := (Int.natAbs_dvd_natAbs).2 hdiv
    simpa using h
  have hprod0 : (N * s ^ k).natAbs ≠ 0 := by
    have hs0 : s ≠ 0 := by
      intro hz
      exact hsunit (by simp [hz])
    exact Nat.ne_of_gt (Int.natAbs_pos.mpr
      (mul_ne_zero hN (pow_ne_zero k hs0)))
  have hle : t ≤ padicValNat p ((N * s ^ k).natAbs) :=
    (padicValNat_dvd_iff_le hprod0).1 hNat
  rw [padic_unit_general p k N s hN hsunit] at hle
  omega

private def originalDepth (k r w : ℕ) : ℕ :=
  if r ≤ w then 0 else (r - w - 1) / (k + 1) + 1

private theorem originalDepth_budget (k r w : ℕ) :
    (k + 1) * originalDepth k r w + w ≥ r := by
  unfold originalDepth
  by_cases h : r ≤ w
  · simp only [if_pos h]
    omega
  · simp only [if_neg h]
    let z : ℕ := r - w - 1
    have hz : r = w + z + 1 := by
      dsimp [z]
      omega
    have ht : 0 < k + 1 := by omega
    have hdiv : z % (k + 1) + (k + 1) * (z / (k + 1)) = z :=
      Nat.mod_add_div z (k + 1)
    have hmod : z % (k + 1) < k + 1 :=
      Nat.mod_lt z ht
    have hmul :
        (k + 1) * (z / (k + 1) + 1) =
          (k + 1) * (z / (k + 1)) + (k + 1) := by ring
    change (k + 1) * (z / (k + 1) + 1) + w ≥ r
    omega

private theorem originalDepth_critical (k r w : ℕ)
    (hwr : w < r) :
    0 < originalDepth k r w ∧
    (k + 1) * (originalDepth k r w - 1) ≤ r ∧
    w < r - (k + 1) * (originalDepth k r w - 1) := by
  have hnot : ¬ r ≤ w := by omega
  unfold originalDepth
  simp only [if_neg hnot]
  let z : ℕ := r - w - 1
  have hz : r = w + z + 1 := by
    dsimp [z]
    omega
  have hdiv : z % (k + 1) + (k + 1) * (z / (k + 1)) = z :=
    Nat.mod_add_div z (k + 1)
  have hq : z / (k + 1) + 1 - 1 = z / (k + 1) := by simp
  change 0 < z / (k + 1) + 1 ∧
    (k + 1) * (z / (k + 1) + 1 - 1) ≤ r ∧
    w < r - (k + 1) * (z / (k + 1) + 1 - 1)
  rw [hq]
  omega

private theorem originalDepth_padic_bridge
    (k p : ℕ) [Fact p.Prime]
    (a b A B m N : ℤ)
    (hab : A * a + B * b = 1)
    (hm0 : m ≠ 0) (hN0 : N ≠ 0) :
    let r := padicValNat p (m ^ (2 * k + 1)).natAbs
    let w := padicValNat p N.natAbs
    let delta := originalDepth k r w
    (k + 1) * delta + w ≥ r ∧
    (0 < delta →
      0 < r ∧
      (k + 1) * (delta - 1) ≤ r ∧
      (p : ℤ) ^ r ∣ m ^ (2 * k + 1) ∧
      ¬ ((p : ℤ) ^ (r - (k + 1) * (delta - 1)) ∣
        if (p : ℤ) ∣ b then
          (-1 : ℤ) ^ k * N * a ^ k
        else N * b ^ k)) := by
  let n : ℕ := (m ^ (2 * k + 1)).natAbs
  let r : ℕ := padicValNat p n
  let w : ℕ := padicValNat p N.natAbs
  let delta : ℕ := originalDepth k r w
  change (k + 1) * delta + w ≥ r ∧
    (0 < delta →
      0 < r ∧
      (k + 1) * (delta - 1) ≤ r ∧
      (p : ℤ) ^ r ∣ m ^ (2 * k + 1) ∧
      ¬ ((p : ℤ) ^ (r - (k + 1) * (delta - 1)) ∣
        if (p : ℤ) ∣ b then
          (-1 : ℤ) ^ k * N * a ^ k
        else N * b ^ k))
  constructor
  · exact originalDepth_budget k r w
  · intro hdelta
    have hwr : w < r := by
      by_contra hn
      have hle : r ≤ w := by omega
      have hzero : delta = 0 := by
        simp [delta, originalDepth, hle]
      omega
    obtain ⟨_, hrange, hcrit⟩ := originalDepth_critical k r w hwr
    have hrpos : 0 < r := by omega
    have hmexp0 : m ^ (2 * k + 1) ≠ 0 :=
      pow_ne_zero _ hm0
    have hn0 : n ≠ 0 := Nat.ne_of_gt (Int.natAbs_pos.mpr hmexp0)
    have hnat : p ^ r ∣ n :=
      (padicValNat_dvd_iff_le hn0).2 (le_refl r)
    have hint : (p : ℤ) ^ r ∣ m ^ (2 * k + 1) :=
      (Int.natAbs_dvd_natAbs).1 (by simpa [n] using hnat)
    refine ⟨hrpos, hrange, hint, ?_⟩
    have hchoice := prime_coordinate_choice p Fact.out a b A B hab
    by_cases hb : (p : ℤ) ∣ b
    · have haunit : ¬ (p : ℤ) ∣ a :=
        hchoice.resolve_left (not_not.mpr hb)
      have hsignAbs :
          (((-1 : ℤ) ^ k * N).natAbs) = N.natAbs := by
        simp [Int.natAbs_mul, Int.natAbs_pow]
      have hsign0 : (-1 : ℤ) ^ k * N ≠ 0 :=
        mul_ne_zero (pow_ne_zero _ (by norm_num)) hN0
      have hw' :
          padicValNat p (((-1 : ℤ) ^ k * N).natAbs) = w := by
        rw [hsignAbs]
      have hnon :=
        padic_noncritical_general p k ((-1 : ℤ) ^ k * N) a
          hsign0 haunit (r - (k + 1) * (delta - 1))
          (by rw [hw']; exact hcrit)
      simpa only [if_pos hb, mul_assoc] using hnon
    · have hbunit : ¬ (p : ℤ) ∣ b := hb
      have hnon :=
        padic_noncritical_general p k N b hN0 hbunit
          (r - (k + 1) * (delta - 1)) hcrit
      simpa only [if_neg hb] using hnon

private theorem original_selected_local_cover_padic
    (k p : ℕ) [Fact p.Prime]
    (a b A B q h m : ℤ) (f g : Polynomial ℤ)
    (hab : A * a + B * b = 1)
    (hm0 : m ≠ 0) (hq0 : q ≠ 0) (hh0 : h ≠ 0)
    (hfdeg : f.natDegree ≤ k + 1)
    (hgdeg : g.natDegree ≤ k + 1)
    (hftop : f.coeff (k + 1) = q * h ^ k * b ^ k)
    (hgtop : g.coeff (k + 1) =
      (-1 : ℤ) ^ k * q * h ^ k * a ^ k) :
    let N : ℤ := q * h ^ k
    let r := padicValNat p (m ^ (2 * k + 1)).natAbs
    let w := padicValNat p N.natAbs
    let delta := originalDepth k r w
    0 < delta →
      ∃ T : Finset ℤ, T.card ≤ k + 1 ∧
        ∀ z u v : ℤ,
          f.eval z = m ^ (2 * k + 1) * v →
          g.eval z = m ^ (2 * k + 1) * u →
          ∃ center ∈ T, (p : ℤ) ^ delta ∣ z - center := by
  let N : ℤ := q * h ^ k
  let r := padicValNat p (m ^ (2 * k + 1)).natAbs
  let w := padicValNat p N.natAbs
  let delta := originalDepth k r w
  change 0 < delta →
    ∃ T : Finset ℤ, T.card ≤ k + 1 ∧
      ∀ z u v : ℤ,
        f.eval z = m ^ (2 * k + 1) * v →
        g.eval z = m ^ (2 * k + 1) * u →
        ∃ center ∈ T, (p : ℤ) ^ delta ∣ z - center
  intro hdelta
  have hN0 : N ≠ 0 := mul_ne_zero hq0 (pow_ne_zero k hh0)
  have hbridge := originalDepth_padic_bridge k p a b A B m N
    hab hm0 hN0
  change (k + 1) * delta + w ≥ r ∧
    (0 < delta →
      0 < r ∧
      (k + 1) * (delta - 1) ≤ r ∧
      (p : ℤ) ^ r ∣ m ^ (2 * k + 1) ∧
      ¬ ((p : ℤ) ^ (r - (k + 1) * (delta - 1)) ∣
        if (p : ℤ) ∣ b then
          (-1 : ℤ) ^ k * N * a ^ k
        else N * b ^ k)) at hbridge
  obtain ⟨hrpos, hrange, hmdiv, hcrit⟩ := hbridge.2 hdelta
  have hcrit' :
      ¬ ((p : ℤ) ^ (r - (k + 1) * (delta - 1)) ∣
        if (p : ℤ) ∣ b then
          (-1 : ℤ) ^ k * q * h ^ k * a ^ k
        else q * h ^ k * b ^ k) := by
    simpa only [N, mul_assoc] using hcrit
  exact original_selected_local_cover k p r delta
    a b A B q h m f g hab hq0 hh0
    hfdeg hgdeg hftop hgtop
    hrpos hdelta hrange hmdiv hcrit'

private theorem originalModulus_budget
    (k n N : ℕ) (hn : n ≠ 0) (hN : N ≠ 0) :
    let s := n.primeFactors
    let delta : ℕ → ℕ := fun p =>
      originalDepth k (padicValNat p n) (padicValNat p N)
    let W := ∏ p ∈ s, p ^ delta p
    0 < W ∧ n ∣ W ^ (k + 1) * N := by
  let s := n.primeFactors
  let delta : ℕ → ℕ := fun p =>
    originalDepth k (padicValNat p n) (padicValNat p N)
  let W := ∏ p ∈ s, p ^ delta p
  change 0 < W ∧ n ∣ W ^ (k + 1) * N
  have hsprime : ∀ p ∈ s, p.Prime := by
    intro p hp
    exact (Nat.mem_primeFactors.mp hp).1
  have hWpos : 0 < W := by
    dsimp [W]
    apply Finset.prod_pos
    intro p hp
    exact pow_pos (hsprime p hp).pos _
  have hW0 : W ≠ 0 := Nat.ne_of_gt hWpos
  have htarget0 : W ^ (k + 1) * N ≠ 0 :=
    mul_ne_zero (pow_ne_zero (k + 1) hW0) hN
  refine ⟨hWpos, ?_⟩
  apply (Nat.factorization_le_iff_dvd hn htarget0).mp
  change ∀ p : ℕ,
    n.factorization p ≤ (W ^ (k + 1) * N).factorization p
  intro p
  by_cases hp : p.Prime
  · letI : Fact p.Prime := ⟨hp⟩
    rw [Nat.factorization_def n hp,
      Nat.factorization_def (W ^ (k + 1) * N) hp]
    by_cases hmem : p ∈ s
    · have hdiv : p ^ delta p ∣ W := by
        dsimp [W]
        exact Finset.dvd_prod_of_mem
          (fun q => q ^ delta q) hmem
      have hkw : delta p ≤ padicValNat p W :=
        (padicValNat_dvd_iff_le hW0).1 hdiv
      have hbudget :=
        originalDepth_budget k (padicValNat p n)
          (padicValNat p N)
      have hvaltarget :
          padicValNat p (W ^ (k + 1) * N) =
            (k + 1) * padicValNat p W +
              padicValNat p N := by
        rw [padicValNat.mul (pow_ne_zero (k + 1) hW0) hN,
          padicValNat.pow]
      have hmul := Nat.mul_le_mul_left (k + 1) hkw
      dsimp [delta] at hkw hbudget hmul
      rw [hvaltarget]
      omega
    · have hnotdvd : ¬ p ∣ n := by
        intro hdiv
        exact hmem ((Nat.mem_primeFactors).2 ⟨hp, hdiv, hn⟩)
      rw [padicValNat.eq_zero_of_not_dvd hnotdvd]
      omega
  · rw [Nat.factorization_eq_zero_of_not_prime n hp]
    omega

private noncomputable def crtRep (A B : ℕ) (hcop : A.Coprime B) (r s : ℤ) : ℤ :=
  (((ZMod.chineseRemainder hcop).symm ((r : ZMod A), (s : ZMod B))).val : ℤ)

private theorem crtRep_congr
    (A B : ℕ) (hA : 0 < A) (hB : 0 < B) (hcop : A.Coprime B)
    (r s : ℤ) :
    (A : ℤ) ∣ crtRep A B hcop r s - r ∧
    (B : ℤ) ∣ crtRep A B hcop r s - s := by
  let : NeZero (A * B) := ⟨mul_ne_zero (Nat.ne_of_gt hA) (Nat.ne_of_gt hB)⟩
  let z := (ZMod.chineseRemainder hcop).symm ((r : ZMod A), (s : ZMod B))
  have hz : (z.val : ZMod (A * B)) = z := ZMod.natCast_zmod_val z
  have hp : ((z.val : ZMod A), (z.val : ZMod B)) =
      ((r : ZMod A), (s : ZMod B)) := by
    calc
      _ = (ZMod.chineseRemainder hcop) (z.val : ZMod (A * B)) :=
        (map_natCast (ZMod.chineseRemainder hcop) z.val).symm
      _ = _ := by rw [hz]; exact (ZMod.chineseRemainder hcop).apply_symm_apply _
  constructor
  · apply (ZMod.intCast_zmod_eq_zero_iff_dvd _ A).mp
    push_cast
    have ht := congrArg Prod.fst hp
    simpa [crtRep, z] using sub_eq_zero.mpr ht
  · apply (ZMod.intCast_zmod_eq_zero_iff_dvd _ B).mp
    push_cast
    have ht := congrArg Prod.snd hp
    simpa [crtRep, z] using sub_eq_zero.mpr ht

private theorem combine_cover
    (A B : ℕ) (hA : 0 < A) (hB : 0 < B) (hcop : A.Coprime B)
    (R S : Finset ℤ) (Pred : ℤ → Prop)
    (hR : ∀ x, Pred x → ∃ r ∈ R, (A : ℤ) ∣ x - r)
    (hS : ∀ x, Pred x → ∃ s ∈ S, (B : ℤ) ∣ x - s) :
    ∃ T : Finset ℤ, T.card ≤ R.card * S.card ∧
      ∀ x, Pred x → ∃ t ∈ T, ((A * B : ℕ) : ℤ) ∣ x - t := by
  classical
  let T := (R ×ˢ S).image (fun rs => crtRep A B hcop rs.1 rs.2)
  refine ⟨T, ?_, ?_⟩
  · exact (Finset.card_image_le).trans (by rw [Finset.card_product])
  · intro x hx
    obtain ⟨r, hr, hxr⟩ := hR x hx
    obtain ⟨s, hs, hxs⟩ := hS x hx
    let t := crtRep A B hcop r s
    refine ⟨t, Finset.mem_image.mpr ⟨(r,s), Finset.mem_product.mpr ⟨hr,hs⟩, rfl⟩, ?_⟩
    have ht := crtRep_congr A B hA hB hcop r s
    have hAt : (A : ℤ) ∣ x - t := by
      simpa only [sub_sub_sub_cancel_right] using dvd_sub hxr ht.1
    have hBt : (B : ℤ) ∣ x - t := by
      simpa only [sub_sub_sub_cancel_right] using dvd_sub hxs ht.2
    have hco : (A : ℤ).natAbs.Coprime (B : ℤ).natAbs := by simpa using hcop
    have hmod : Int.ModEq ((A : ℤ) * (B : ℤ)) t x :=
      (Int.modEq_and_modEq_iff_modEq_mul hco).mp
        ⟨Int.modEq_iff_dvd.mpr hAt, Int.modEq_iff_dvd.mpr hBt⟩
    simpa only [Nat.cast_mul] using Int.modEq_iff_dvd.mp hmod

private theorem finite_cover {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (Q L : ι → ℕ) (Pred : ℤ → Prop)
    (hpos : ∀ i ∈ s, 0 < Q i)
    (hpair : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → (Q i).Coprime (Q j))
    (hloc : ∀ i ∈ s, ∃ R : Finset ℤ, R.card ≤ L i ∧
      ∀ z, Pred z → ∃ a ∈ R, (Q i : ℤ) ∣ z - a) :
    ∃ T : Finset ℤ, T.card ≤ ∏ i ∈ s, L i ∧
      ∀ z, Pred z → ∃ a ∈ T, ((∏ i ∈ s, Q i : ℕ) : ℤ) ∣ z - a := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    refine ⟨{0}, by simp, ?_⟩
    intro z hz
    refine ⟨0, Finset.mem_singleton_self _, ?_⟩
    simp
  | @insert i s hi ih =>
    obtain ⟨R, hRc, hRv⟩ := hloc i (Finset.mem_insert_self _ _)
    have hposS : ∀ j ∈ s, 0 < Q j :=
      fun j hj => hpos j (Finset.mem_insert_of_mem hj)
    have hpairS : ∀ j ∈ s, ∀ k ∈ s, j ≠ k → (Q j).Coprime (Q k) :=
      fun j hj k hk hne => hpair j (Finset.mem_insert_of_mem hj)
        k (Finset.mem_insert_of_mem hk) hne
    have hlocS : ∀ j ∈ s, ∃ R : Finset ℤ, R.card ≤ L j ∧
        ∀ z, Pred z → ∃ a ∈ R, (Q j : ℤ) ∣ z - a :=
      fun j hj => hloc j (Finset.mem_insert_of_mem hj)
    obtain ⟨S, hSc, hSv⟩ := ih hposS hpairS hlocS
    have hcop : (Q i).Coprime (∏ j ∈ s, Q j) := by
      apply Nat.Coprime.prod_right
      intro j hj
      exact hpair i (Finset.mem_insert_self _ _)
        j (Finset.mem_insert_of_mem hj) (by intro hij; subst j; exact hi hj)
    have hprodpos : 0 < ∏ j ∈ s, Q j := Finset.prod_pos hposS
    obtain ⟨T, hTc, hTv⟩ := combine_cover (Q i) (∏ j ∈ s, Q j)
      (hpos i (Finset.mem_insert_self _ _)) hprodpos hcop R S Pred hRv hSv
    refine ⟨T, ?_, ?_⟩
    · rw [Finset.prod_insert hi]
      exact hTc.trans (Nat.mul_le_mul hRc hSc)
    · simpa only [Finset.prod_insert hi] using hTv

private theorem original_finite_prime_cover
    (k : ℕ) (a b A B q h m : ℤ)
    (f g : Polynomial ℤ)
    (hab : A * a + B * b = 1)
    (hm0 : m ≠ 0) (hq0 : q ≠ 0) (hh0 : h ≠ 0)
    (hfdeg : f.natDegree ≤ k + 1)
    (hgdeg : g.natDegree ≤ k + 1)
    (hftop : f.coeff (k + 1) = q * h ^ k * b ^ k)
    (hgtop : g.coeff (k + 1) =
      (-1 : ℤ) ^ k * q * h ^ k * a ^ k)
    (s : Finset ℕ) (hsprime : ∀ p ∈ s, p.Prime) :
    let delta : ℕ → ℕ := fun p =>
      originalDepth k
        (padicValNat p (m ^ (2 * k + 1)).natAbs)
        (padicValNat p (q * h ^ k).natAbs)
    ∃ T : Finset ℤ,
      T.card ≤ (k + 1) ^ s.card ∧
      ∀ z u v : ℤ,
        f.eval z = m ^ (2 * k + 1) * v →
        g.eval z = m ^ (2 * k + 1) * u →
        ∃ center ∈ T,
          ((∏ p ∈ s, p ^ delta p : ℕ) : ℤ) ∣ z - center := by
  classical
  let delta : ℕ → ℕ := fun p =>
    originalDepth k
      (padicValNat p (m ^ (2 * k + 1)).natAbs)
      (padicValNat p (q * h ^ k).natAbs)
  let Q : ℕ → ℕ := fun p => p ^ delta p
  let L : ℕ → ℕ := fun _ => k + 1
  let Pred : ℤ → Prop := fun z =>
    ∃ u v : ℤ,
      f.eval z = m ^ (2 * k + 1) * v ∧
      g.eval z = m ^ (2 * k + 1) * u
  change ∃ T : Finset ℤ,
    T.card ≤ (k + 1) ^ s.card ∧
    ∀ z u v : ℤ,
      f.eval z = m ^ (2 * k + 1) * v →
      g.eval z = m ^ (2 * k + 1) * u →
      ∃ center ∈ T,
        ((∏ p ∈ s, Q p : ℕ) : ℤ) ∣ z - center
  have hpos : ∀ p ∈ s, 0 < Q p := by
    intro p hp
    exact pow_pos (hsprime p hp).pos _
  have hpairQ : ∀ p ∈ s, ∀ t ∈ s, p ≠ t →
      (Q p).Coprime (Q t) := by
    intro p hp t ht hne
    have hcop : p.Coprime t :=
      (Nat.coprime_primes (hsprime p hp) (hsprime t ht)).2 hne
    exact Nat.Coprime.pow (delta p) (delta t) hcop
  have hloc : ∀ p ∈ s, ∃ T : Finset ℤ,
      T.card ≤ L p ∧
      ∀ z, Pred z → ∃ center ∈ T, (Q p : ℤ) ∣ z - center := by
    intro p hp
    by_cases hd : delta p = 0
    · refine ⟨{0}, ?_, ?_⟩
      · simp [L]
      · intro z _
        refine ⟨0, by simp, ?_⟩
        simp [Q, hd]
    · letI : Fact p.Prime := ⟨hsprime p hp⟩
      have hdpos : 0 < delta p := Nat.pos_of_ne_zero hd
      have hlocal := original_selected_local_cover_padic k p
        a b A B q h m f g hab hm0 hq0 hh0
        hfdeg hgdeg hftop hgtop
      change 0 < delta p →
        ∃ T : Finset ℤ, T.card ≤ k + 1 ∧
          ∀ z u v : ℤ,
            f.eval z = m ^ (2 * k + 1) * v →
            g.eval z = m ^ (2 * k + 1) * u →
            ∃ center ∈ T, (p : ℤ) ^ delta p ∣ z - center at hlocal
      obtain ⟨T, hTc, hTv⟩ := hlocal hdpos
      refine ⟨T, by simpa [L] using hTc, ?_⟩
      intro z hz
      obtain ⟨u, v, hf, hg⟩ := hz
      simpa [Q] using hTv z u v hf hg
  obtain ⟨T, hTc, hTv⟩ :=
    finite_cover s Q L Pred hpos hpairQ hloc
  refine ⟨T, ?_, ?_⟩
  · simpa [L] using hTc
  · intro z u v hf hg
    exact hTv z ⟨u, v, hf, hg⟩

private theorem original_allprime_cover_and_modulus
    (k : ℕ) (a b A B q h m : ℤ)
    (f g : Polynomial ℤ)
    (hab : A * a + B * b = 1)
    (hm0 : m ≠ 0) (hq0 : q ≠ 0) (hh0 : h ≠ 0)
    (hfdeg : f.natDegree ≤ k + 1)
    (hgdeg : g.natDegree ≤ k + 1)
    (hftop : f.coeff (k + 1) = q * h ^ k * b ^ k)
    (hgtop : g.coeff (k + 1) =
      (-1 : ℤ) ^ k * q * h ^ k * a ^ k) :
    let n : ℕ := (m ^ (2 * k + 1)).natAbs
    let N : ℕ := (q * h ^ k).natAbs
    let s := n.primeFactors
    let delta : ℕ → ℕ := fun p =>
      originalDepth k (padicValNat p n) (padicValNat p N)
    let W := ∏ p ∈ s, p ^ delta p
    0 < W ∧ n ∣ W ^ (k + 1) * N ∧
      ∃ T : Finset ℤ,
        T.card ≤ (k + 1) ^ s.card ∧
        ∀ z u v : ℤ,
          f.eval z = m ^ (2 * k + 1) * v →
          g.eval z = m ^ (2 * k + 1) * u →
          ∃ center ∈ T, (W : ℤ) ∣ z - center := by
  let n : ℕ := (m ^ (2 * k + 1)).natAbs
  let N : ℕ := (q * h ^ k).natAbs
  let s := n.primeFactors
  let delta : ℕ → ℕ := fun p =>
    originalDepth k (padicValNat p n) (padicValNat p N)
  let W := ∏ p ∈ s, p ^ delta p
  change 0 < W ∧ n ∣ W ^ (k + 1) * N ∧
    ∃ T : Finset ℤ,
      T.card ≤ (k + 1) ^ s.card ∧
      ∀ z u v : ℤ,
        f.eval z = m ^ (2 * k + 1) * v →
        g.eval z = m ^ (2 * k + 1) * u →
        ∃ center ∈ T, (W : ℤ) ∣ z - center
  have hn0 : n ≠ 0 :=
    Nat.ne_of_gt (Int.natAbs_pos.mpr
      (pow_ne_zero (2 * k + 1) hm0))
  have hNint : q * h ^ k ≠ 0 :=
    mul_ne_zero hq0 (pow_ne_zero k hh0)
  have hN0 : N ≠ 0 :=
    Nat.ne_of_gt (Int.natAbs_pos.mpr hNint)
  obtain ⟨hWpos, hmod⟩ :=
    originalModulus_budget k n N hn0 hN0
  have hsprime : ∀ p ∈ s, p.Prime := by
    intro p hp
    exact (Nat.mem_primeFactors.mp hp).1
  have hcov := original_finite_prime_cover k
    a b A B q h m f g hab hm0 hq0 hh0
    hfdeg hgdeg hftop hgtop s hsprime
  change ∃ T : Finset ℤ,
      T.card ≤ (k + 1) ^ s.card ∧
      ∀ z u v : ℤ,
        f.eval z = m ^ (2 * k + 1) * v →
        g.eval z = m ^ (2 * k + 1) * u →
        ∃ center ∈ T, (W : ℤ) ∣ z - center at hcov
  exact ⟨hWpos, hmod, hcov⟩

private theorem signed_progression_det
    (a b A B m t₀ h z z' : ℤ)
    (hab : A * a + B * b = 1) :
    (A * m + b * (t₀ + h * z)) *
        (B * m - a * (t₀ + h * z')) -
      (A * m + b * (t₀ + h * z')) *
        (B * m - a * (t₀ + h * z)) =
      m * h * (z - z') := by
  linear_combination m * h * (z - z') * hab

theorem original_relative_cell_diameter
    (a b A B m t₀ h z z' d e d' e' : ℤ)
    (D E M C : ℝ)
    (hab : A * a + B * b = 1)
    (hd : d = A * m + b * (t₀ + h * z))
    (he : e = B * m - a * (t₀ + h * z))
    (hd' : d' = A * m + b * (t₀ + h * z'))
    (he' : e' = B * m - a * (t₀ + h * z'))
    (hepos : 0 < (e : ℝ)) (he'pos : 0 < (e' : ℝ))
    (heE : (e : ℝ) ≤ E) (he'E : (e' : ℝ) ≤ E)
    (hE : 0 < E) (hM : 0 < M)
    (hD : 0 ≤ D) (hC : 0 ≤ C)
    (hcell : |(d : ℝ) / (e : ℝ) - (d' : ℝ) / (e' : ℝ)| ≤
      2 * C * D / (E * M)) :
    M * |((m * h : ℤ) : ℝ)| * |((z - z' : ℤ) : ℝ)| ≤ 2 * C * D * E := by
  have hdetI : d * e' - d' * e = m * h * (z - z') := by
    rw [hd, he, hd', he']
    exact signed_progression_det a b A B m t₀ h z z' hab
  have hdet : (d : ℝ) * (e' : ℝ) - (d' : ℝ) * (e : ℝ) =
      ((m * h : ℤ) : ℝ) * ((z - z' : ℤ) : ℝ) := by
    exact_mod_cast hdetI
  have he0 : (e : ℝ) ≠ 0 := ne_of_gt hepos
  have he'0 : (e' : ℝ) ≠ 0 := ne_of_gt he'pos
  have hratio : (d : ℝ) * (e' : ℝ) - (d' : ℝ) * (e : ℝ) =
      (e : ℝ) * (e' : ℝ) *
        ((d : ℝ) / (e : ℝ) - (d' : ℝ) / (e' : ℝ)) := by
    field_simp
  have hbound : |(d : ℝ) * (e' : ℝ) - (d' : ℝ) * (e : ℝ)| ≤
      E * E * (2 * C * D / (E * M)) := by
    rw [hratio, abs_mul, abs_mul, abs_of_pos hepos, abs_of_pos he'pos]
    calc
      (e : ℝ) * (e' : ℝ) *
          |(d : ℝ) / (e : ℝ) - (d' : ℝ) / (e' : ℝ)| ≤
        E * E * |(d : ℝ) / (e : ℝ) - (d' : ℝ) / (e' : ℝ)| := by
          gcongr
      _ ≤ E * E * (2 * C * D / (E * M)) := by
          gcongr
  have hEM : E * M ≠ 0 := mul_ne_zero (ne_of_gt hE) (ne_of_gt hM)
  calc
    M * |((m * h : ℤ) : ℝ)| * |((z - z' : ℤ) : ℝ)| =
        M * |(d : ℝ) * (e' : ℝ) - (d' : ℝ) * (e : ℝ)| := by
          rw [hdet, abs_mul]
          ring
    _ ≤ M * (E * E * (2 * C * D / (E * M))) := by
          gcongr
    _ = 2 * C * D * E := by
          field_simp

private theorem integer_residue_fiber_diameter_card
    (S : Finset ℤ) (t W : ℤ) (L : ℝ)
    (hW : 0 < W) (hL : 0 ≤ L)
    (hcong : ∀ z ∈ S, W ∣ z - t)
    (hdiam : ∀ z ∈ S, ∀ z' ∈ S,
      |(((z - z' : ℤ) : ℝ))| ≤ L) :
    (S.card : ℝ) ≤ 1 + L / (W : ℝ) := by
  classical
  let q : {z // z ∈ S} → ℤ := fun z => (z.1 - t) / W
  have hrepr (z : {z // z ∈ S}) : z.1 = t + W * q z := by
    have hmod : (z.1 - t) % W = 0 :=
      Int.emod_eq_zero_of_dvd (hcong z.1 z.2)
    have hrec := Int.ediv_mul_add_emod (z.1 - t) W
    dsimp [q]
    rw [hmod] at hrec
    nlinarith [hrec]
  have hqi : Function.Injective q := by
    intro z z' heq
    apply Subtype.ext
    have hz := hrepr z
    have hz' := hrepr z'
    rw [heq] at hz
    omega
  let Q : Finset ℤ := S.attach.image q
  have hcard : Q.card = S.card := by
    simpa [Q] using Finset.card_image_of_injective S.attach hqi
  have hWr : (0 : ℝ) < (W : ℝ) := by exact_mod_cast hW
  have hQdiam : ∀ r ∈ Q, ∀ r' ∈ Q,
      |(r : ℝ) - (r' : ℝ)| ≤ L / (W : ℝ) := by
    intro r hr r' hr'
    obtain ⟨z, hz, rfl⟩ := Finset.mem_image.mp hr
    obtain ⟨z', hz', rfl⟩ := Finset.mem_image.mp hr'
    have hdif : (z.1 - z'.1 : ℤ) = W * (q z - q z') := by
      have h1 := hrepr z
      have h2 := hrepr z'
      linear_combination h1 - h2
    have hbound := hdiam z.1 z.2 z'.1 z'.2
    have hcast : |(((z.1 - z'.1 : ℤ) : ℝ))| =
        (W : ℝ) * |(((q z - q z' : ℤ) : ℝ))| := by
      rw [hdif, Int.cast_mul, abs_mul, abs_of_pos hWr]
    have hqbound : |(((q z - q z' : ℤ) : ℝ))| ≤
        L / (W : ℝ) :=
      (le_div_iff₀ hWr).2 (by
        calc
          |(((q z - q z' : ℤ) : ℝ))| * (W : ℝ) =
              (W : ℝ) * |(((q z - q z' : ℤ) : ℝ))| := by ring
          _ = |(((z.1 - z'.1 : ℤ) : ℝ))| := hcast.symm
          _ ≤ L := hbound)
    simpa only [Int.cast_sub] using hqbound
  have hLdiv : 0 ≤ L / (W : ℝ) :=
    div_nonneg hL (le_of_lt hWr)
  have hcount := integer_real_diameter_card Q
    (L / (W : ℝ)) hLdiv hQdiam
  simpa only [hcard] using hcount

private theorem integer_residue_cover_diameter_card
    (S T : Finset ℤ) (W : ℤ) (L : ℝ)
    (hW : 0 < W) (hL : 0 ≤ L)
    (hdiam : ∀ z ∈ S, ∀ z' ∈ S,
      |(((z - z' : ℤ) : ℝ))| ≤ L)
    (hcover : ∀ z ∈ S, ∃ t ∈ T, W ∣ z - t) :
    (S.card : ℝ) ≤ (T.card : ℝ) *
      (2 + L / (W : ℝ)) := by
  classical
  let fiber : ℤ → Finset ℤ :=
    fun t => S.filter (fun z => W ∣ z - t)
  have hfiber (t : ℤ) (ht : t ∈ T) :
      ((fiber t).card : ℝ) ≤ 1 + L / (W : ℝ) := by
    apply integer_residue_fiber_diameter_card
      (fiber t) t W L hW hL
    · intro z hz
      exact (Finset.mem_filter.mp hz).2
    · intro z hz z' hz'
      exact hdiam z (Finset.mem_filter.mp hz).1
        z' (Finset.mem_filter.mp hz').1
  have hsub : S ⊆ T.biUnion fiber := by
    intro z hz
    obtain ⟨t, ht, hcong⟩ := hcover z hz
    exact Finset.mem_biUnion.mpr
      ⟨t, ht, Finset.mem_filter.mpr ⟨hz, hcong⟩⟩
  have hunion (U : Finset ℤ) :
      (U.biUnion fiber).card ≤
        ∑ t ∈ U, (fiber t).card := by
    induction U using Finset.induction_on with
    | empty => simp
    | @insert t U ht ih =>
        rw [Finset.biUnion_insert, Finset.sum_insert ht]
        exact (Finset.card_union_le _ _).trans
          (Nat.add_le_add_left ih _)
  have hcard : (S.card : ℝ) ≤
