private def Q2 {K : Type*} [CommRing K] (A B C r s : K) : K :=
  A * r ^ 2 + B * r * s + C * s ^ 2

private def quad {K : Type*} [CommRing K] (A B C : K) : Polynomial K :=
  Polynomial.C A + Polynomial.C B * Polynomial.X +
    Polynomial.C C * Polynomial.X ^ 2

private theorem pure_next
    (k : ℕ) (D₀ D₁ D₂ E₀ E₁ E₂ γ α β : ℂ)
    (hp : ∀ r s : ℂ,
      s * Q2 E₀ E₁ E₂ r s ^ k - r * Q2 D₀ D₁ D₂ r s ^ k =
        γ * (α * r + β * s) ^ (2 * k + 1)) :
    E₀ ^ k - (k : ℂ) * D₀ ^ (k - 1) * D₁ =
      ((2 * k + 1 : ℕ) : ℂ) * γ * α ^ (2 * k) * β := by
  have hid : Polynomial.X * (quad E₀ E₁ E₂) ^ k -
      (quad D₀ D₁ D₂) ^ k =
      Polynomial.C γ * (Polynomial.C α + Polynomial.C β * Polynomial.X) ^
        (2 * k + 1) := by
    apply Polynomial.funext
    intro z
    simpa [quad, Q2] using hp 1 z
