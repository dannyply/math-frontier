  let B : Polynomial ℝ := C (b:ℝ)*e
  have ha : A.natDegree≤1 := a5deg_cmul (a:ℝ) d 1 hd
  have hb : B.natDegree≤1 := a5deg_cmul (b:ℝ) e 1 he
  have ha2 : (A^2).natDegree≤2 := a5deg_affine_power A ha 2
  have ha3 : (A^3).natDegree≤3 := a5deg_affine_power A ha 3
  have ha4 : (A^4).natDegree≤4 := a5deg_affine_power A ha 4
  have hb2 : (B^2).natDegree≤2 := a5deg_affine_power B hb 2
  have hb3 : (B^3).natDegree≤3 := a5deg_affine_power B hb 3
  have hab1 : (A^2*B).natDegree≤3 := a5deg_mul _ _ 2 1 ha2 hb
  have hab2 : (A*B^2).natDegree≤3 := a5deg_mul _ _ 1 2 ha hb2
  have h7 : (C (7:ℝ)*(A^2*B)).natDegree≤3 := a5deg_cmul 7 _ 3 hab1
  have h21 : (C (21:ℝ)*(A*B^2)).natDegree≤3 := a5deg_cmul 21 _ 3 hab2
  have h35 : (C (35:ℝ)*B^3).natDegree≤3 := a5deg_cmul 35 _ 3 hb3
  have hsum : (A^3+C (7:ℝ)*(A^2*B)+C (21:ℝ)*(A*B^2)+C (35:ℝ)*B^3).natDegree≤3 :=
    a5deg_add _ _ 3 (a5deg_add _ _ 3 (a5deg_add _ _ 3 ha3 h7) h21) h35
