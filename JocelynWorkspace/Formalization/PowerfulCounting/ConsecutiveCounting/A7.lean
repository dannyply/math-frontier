private theorem original_z_lower_from_d
    (a m : ℤ) (D Zmin dreal : ℝ)
    (hm : m ≠ 0) (hD : 0 < D) (hZ : 0 ≤ Zmin)
    (hd : D / 2 ≤ dreal)
    (hsize : 2 * Zmin * |(m : ℝ)| ≤ |(a : ℝ)| * D) :
    Zmin ≤ |(a : ℝ) * dreal / (m : ℝ)| := by
  have hmR : (m : ℝ) ≠ 0 := by exact_mod_cast hm
  have hmabs : 0 < |(m : ℝ)| := abs_pos.mpr hmR
  have hdnonneg : 0 ≤ dreal := by linarith
  have hprod :
      Zmin * |(m : ℝ)| ≤ |(a : ℝ)| * dreal := by
    have hmul := mul_le_mul_of_nonneg_left hd
      (abs_nonneg (a : ℝ))
    nlinarith [hmul, hsize]
  calc
    Zmin ≤ |(a : ℝ)| * dreal / |(m : ℝ)| :=
      (le_div_iff₀ hmabs).2 hprod
    _ = |(a : ℝ) * dreal / (m : ℝ)| := by
      rw [abs_div, abs_mul, abs_of_nonneg hdnonneg]

private theorem original_rich_z_every_real
    (a b A B m t₀ h : ℤ) (D E Zmin s t r : ℝ)
    (hm : m ≠ 0) (hD : 0 < D)
    (hZ : 0 ≤ Zmin)
    (hst : s ≤ t) (hr : r ∈ Set.Icc s t)
    (hds : D / 2 ≤ ((A * m + b * t₀ : ℤ) : ℝ) +
        ((b * h : ℤ) : ℝ) * s ∧
      ((A * m + b * t₀ : ℤ) : ℝ) +
        ((b * h : ℤ) : ℝ) * s ≤ D)
    (hdt : D / 2 ≤ ((A * m + b * t₀ : ℤ) : ℝ) +
        ((b * h : ℤ) : ℝ) * t ∧
      ((A * m + b * t₀ : ℤ) : ℝ) +
        ((b * h : ℤ) : ℝ) * t ≤ D)
    (hes : E / 2 ≤ ((B * m - a * t₀ : ℤ) : ℝ) -
        ((a * h : ℤ) : ℝ) * s ∧
      ((B * m - a * t₀ : ℤ) : ℝ) -
        ((a * h : ℤ) : ℝ) * s ≤ E)
    (het : E / 2 ≤ ((B * m - a * t₀ : ℤ) : ℝ) -
        ((a * h : ℤ) : ℝ) * t ∧
      ((B * m - a * t₀ : ℤ) : ℝ) -
        ((a * h : ℤ) : ℝ) * t ≤ E)
    (hsize : 2 * Zmin * |(m : ℝ)| ≤ |(a : ℝ)| * D) :
    Zmin ≤
      |((a : ℝ) * ((A * m + b * t₀ : ℤ) : ℝ) / (m : ℝ)) +
        ((a : ℝ) * (b : ℝ) * (h : ℝ) / (m : ℝ)) * r| := by
  have hd := (original_signed_halfboxes_convex
    a b A B m t₀ h D E s t r hst hr hds hdt hes het).1.1
  have hzed :
      ((a : ℝ) * ((A * m + b * t₀ : ℤ) : ℝ) / (m : ℝ)) +
        ((a : ℝ) * (b : ℝ) * (h : ℝ) / (m : ℝ)) * r =
      (a : ℝ) *
        (((A * m + b * t₀ : ℤ) : ℝ) +
          ((b * h : ℤ) : ℝ) * r) / (m : ℝ) := by
    have hmR : (m : ℝ) ≠ 0 := by exact_mod_cast hm
    push_cast
    field_simp [hmR] <;> ring
  rw [hzed]
  exact original_z_lower_from_d a m D Zmin
    (((A * m + b * t₀ : ℤ) : ℝ) +
      ((b * h : ℤ) : ℝ) * r)
    hm hD hZ hd hsize

