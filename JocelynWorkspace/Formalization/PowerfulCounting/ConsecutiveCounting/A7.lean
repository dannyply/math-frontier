    2 / Real.sqrt (nsq ((M : ℝ) / (4 * D)) (rho D E M j) (2 * E) b)
  calc
    _ ≤ 1 / Real.sqrt (nsq ((M : ℝ) / (4 * D)) (rho D E M j) (2 * E) b) :=
      one_div_le_one_div_of_le holdpos hnle
    _ ≤ _ := by gcongr <;> norm_num

lemma threshold_absorption (D E : ℝ) (M : ℕ) (hD : 0 < D) (hE : 0 < E)
    (hM : (0 : ℝ) < M) :
    max ((D * E / (M : ℝ)) ^ ((1 : ℝ) / 2)) (32 * (D + E) / (M : ℝ)) ≤
      64 * ((D * E + (D ^ 2 + E ^ 2) / (M : ℝ)) / (M : ℝ)) ^ ((1 : ℝ) / 2) := by
  let B : ℝ := D * E + (D ^ 2 + E ^ 2) / (M : ℝ)
  let Z : ℝ := (B / (M : ℝ)) ^ ((1 : ℝ) / 2)
  have hB : 0 < B := by dsimp [B]; positivity
  have hZ : 0 < Z := Real.rpow_pos_of_pos (by positivity) _
  have hZsq : Z ^ 2 = B / (M : ℝ) :=
    JocelynWorkspace.Formalization.PowerfulCounting.LatticeMoments.JocelynMoments.sq_rpow_half _ (by positivity)
  have hQ : D * E / (M : ℝ) ≤ B / (M : ℝ) := by
    apply div_le_div_of_nonneg_right _ hM.le
    dsimp [B]
    have : 0 ≤ (D ^ 2 + E ^ 2) / (M : ℝ) := by positivity
    linarith
  have hfirst : (D * E / (M : ℝ)) ^ ((1 : ℝ) / 2) ≤ Z :=
    Real.rpow_le_rpow (by positivity) hQ (by norm_num)
  have haxis : ((D + E) / (M : ℝ)) ^ 2 ≤ 4 * Z ^ 2 := by
    rw [hZsq]
    have hsq : (D + E) ^ 2 ≤ 2 * (D ^ 2 + E ^ 2) := by nlinarith [sq_nonneg (D - E)]
    have hBaxis : D ^ 2 + E ^ 2 ≤ (M : ℝ) * B := by
      dsimp [B]
      have e : (M : ℝ) * (D * E + (D ^ 2 + E ^ 2) / (M : ℝ)) =
          (M : ℝ) * D * E + D ^ 2 + E ^ 2 := by field_simp [hM.ne']; ring
      rw [e]
      have : 0 ≤ (M : ℝ) * D * E := by positivity
      linarith
    have htop : (D + E) ^ 2 ≤ 4 * (M : ℝ) * B := by nlinarith
    have hdiv := (div_le_div_of_nonneg_right htop (sq_nonneg (M : ℝ)))
    calc
      ((D + E) / (M : ℝ)) ^ 2 = (D + E) ^ 2 / (M : ℝ) ^ 2 := by ring
      _ ≤ (4 * (M : ℝ) * B) / (M : ℝ) ^ 2 := hdiv
      _ = 4 * (B / (M : ℝ)) := by field_simp [hM.ne']
  have haxis' : (D + E) / (M : ℝ) ≤ 2 * Z := by
    nlinarith
  have hsecond : 32 * (D + E) / (M : ℝ) ≤ 64 * Z := by
    calc
      _ = 32 * ((D + E) / (M : ℝ)) := by ring
      _ ≤ 32 * (2 * Z) := mul_le_mul_of_nonneg_left haxis' (by norm_num)
      _ = _ := by ring
  change max _ _ ≤ 64 * Z
  exact max_le (by nlinarith [hfirst]) hsecond

lemma scale_identity (theta D E : ℝ) (M : ℕ)
    (hD : 0 < D) (hE : 0 < E) (hM : (0 : ℝ) < M) :
    (M : ℝ) * (64 * ((D * E + (D ^ 2 + E ^ 2) / (M : ℝ)) / (M : ℝ)) ^
      ((1 : ℝ) / 2)) ^ theta =
      64 ^ theta * (M : ℝ) ^ (1 - theta / 2) *
        (D * E + (D ^ 2 + E ^ 2) / (M : ℝ)) ^ (theta / 2) := by
  let B : ℝ := D * E + (D ^ 2 + E ^ 2) / (M : ℝ)
  have hB : 0 < B := by dsimp [B]; positivity
  change (M : ℝ) * (64 * (B / (M : ℝ)) ^ ((1 : ℝ) / 2)) ^ theta =
    64 ^ theta * (M : ℝ) ^ (1 - theta / 2) * B ^ (theta / 2)
  rw [Real.mul_rpow (by norm_num) (by positivity),
    ← Real.rpow_mul (by positivity)]
  have e : (1 : ℝ) / 2 * theta = theta / 2 := by ring
  rw [e, Real.div_rpow hB.le hM.le, Real.rpow_sub hM]
  rw [Real.rpow_one]
  ring

theorem main :
    ∀ theta : ℝ, 0 < theta → theta < 2 →
      ∃ C : ℝ, 0 < C ∧
        ∀ D E : ℝ, 1 ≤ D → 1 ≤ E →
          ∀ M : ℕ, 1 ≤ M →
            (indices D E M).Finite ∧
            ((indices D E M).ncard : ℝ) ≤ 3 * (M : ℝ) + 1 ∧
            (∀ j ∈ indices D E M, 0 < ell D E M j) ∧
            (∑ᶠ j ∈ indices D E M, (ell D E M j) ^ theta) ≤
              C * (M : ℝ) ^ (1 - theta / 2) *
                (D * E + (D ^ 2 + E ^ 2) / (M : ℝ)) ^ (theta / 2) := by
  intro theta htheta0 htheta2
  obtain ⟨C0, hC0, hmoment⟩ :=
    JocelynWorkspace.Formalization.PowerfulCounting.LatticeMoments.JocelynClaims.claim_de91d4e3bef4d0cbba6edddabc77ad8eded6df2ba7fc0116292af012ccd3b48a
      theta htheta0 htheta2
  refine ⟨C0 * 64 ^ theta, by positivity, ?_⟩
  intro D E hD hE M hM
  classical
  have hD0 : 0 < D := by linarith
  have hE0 : 0 < E := by linarith
  have hM1 : (1 : ℝ) ≤ M := by exact_mod_cast hM
  have hM0 : (0 : ℝ) < M := by linarith
  have htail :=
    JocelynWorkspace.Formalization.PowerfulCounting.LatticeTails.JocelynClaims.claim_d31e9b77d0f9dd7614934ea632cc8dcd6919398027eb82ef33c69bc75aa5c7c7
      D E 2 (by linarith) (by linarith) (by norm_num) M hM
  obtain ⟨-, hfin, hcard, -, -⟩ := htail
  have hfin' : (indices D E M).Finite := hfin
  have hcard' : ((indices D E M).ncard : ℝ) ≤ 3 * (M : ℝ) + 1 := hcard
  have hbridge := fun j => minimum_bridge D E M j hD0 hE0 hM0
  choose b hb hcompare using fun j => (hbridge j).2
  have hb' : ∀ j ∈ indices D E M, b j ≠ 0 := fun j _ => hb j
  have hold := (hmoment D E 2 (by linarith) (by linarith) (by norm_num) M hM).1 b hb'
  have hold' :
      (∑ᶠ j ∈ indices D E M, oldHeight D E M j (b j) ^ theta) ≤
        C0 * (M : ℝ) *
          (max ((D * E / (M : ℝ)) ^ ((1 : ℝ) / 2)) (32 * (D + E) / (M : ℝ))) ^ theta := hold
  refine ⟨hfin', hcard', fun j _ => (hbridge j).1, ?_⟩
  have hsum :
      (∑ᶠ j ∈ indices D E M, ell D E M j ^ theta) ≤
        ∑ᶠ j ∈ indices D E M, oldHeight D E M j (b j) ^ theta := by
    rw [finsum_mem_eq_finite_toFinset_sum _ hfin',
      finsum_mem_eq_finite_toFinset_sum _ hfin']
    apply Finset.sum_le_sum
    intro j hj
    exact Real.rpow_le_rpow (hbridge j).1.le (hcompare j) htheta0.le
  have hscale := threshold_absorption D E M hD0 hE0 hM0
  have hpow :
      (max ((D * E / (M : ℝ)) ^ ((1 : ℝ) / 2)) (32 * (D + E) / (M : ℝ))) ^ theta ≤
        (64 * ((D * E + (D ^ 2 + E ^ 2) / (M : ℝ)) / (M : ℝ)) ^
          ((1 : ℝ) / 2)) ^ theta :=
    Real.rpow_le_rpow (le_trans (by positivity) (le_max_left _ _)) hscale htheta0.le
  calc
    _ ≤ _ := le_trans hsum hold'
    _ ≤ C0 * (M : ℝ) * (64 * ((D * E + (D ^ 2 + E ^ 2) / (M : ℝ)) / (M : ℝ)) ^
        ((1 : ℝ) / 2)) ^ theta :=
      mul_le_mul_of_nonneg_left hpow (by positivity)
    _ = _ := by rw [mul_assoc, scale_identity theta D E M hD0 hE0 hM0]; ring

end ActualMoments

theorem JocelynClaims.claim_b0df9f9d701b76ce2d198f86252d56e1ed22acd81961babfaf5b37bb56cec163 :
let rho : ℝ → ℝ → ℕ → ℕ → ℝ :=
  fun D E M j => D / (2 * E) * (1 + 1 / (M : ℝ)) ^ j;
let indices : ℝ → ℝ → ℕ → Set ℕ :=
  fun D E M => {j | D / (2 * E) ≤ rho D E M j ∧ rho D E M j ≤ 2 * D / E};
let nonzeroNorms : ℝ → ℝ → ℕ → ℝ → Set ℝ :=
  fun D E M s => {r | ∃ p q : ℤ, (p ≠ 0 ∨ q ≠ 0) ∧
    Real.sqrt (((M : ℝ) / D * ((p : ℝ) - s * (q : ℝ))) ^ 2 +
      ((q : ℝ) / E) ^ 2) = r};
let ell : ℝ → ℝ → ℕ → ℕ → ℝ :=
  fun D E M j => 1 / sInf (nonzeroNorms D E M (rho D E M j));
∀ theta : ℝ, 0 < theta → theta < 2 →
  ∃ C : ℝ, 0 < C ∧
    ∀ D E : ℝ, 1 ≤ D → 1 ≤ E →
      ∀ M : ℕ, 1 ≤ M →
        (indices D E M).Finite ∧
        ((indices D E M).ncard : ℝ) ≤ 3 * (M : ℝ) + 1 ∧
        (∀ j ∈ indices D E M, 0 < ell D E M j) ∧
        (∑ᶠ j ∈ indices D E M, (ell D E M j) ^ theta) ≤
          C * (M : ℝ) ^ (1 - theta / 2) *
            (D * E + (D ^ 2 + E ^ 2) / (M : ℝ)) ^ (theta / 2) := by
  exact ActualMoments.main

