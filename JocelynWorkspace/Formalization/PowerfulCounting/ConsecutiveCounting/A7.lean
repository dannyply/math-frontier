    (d e N : Polynomial ℝ) (s t : ℝ) (hst:s≤t)
    (hcell:(t-s)*|(m:ℝ)| *(J:ℝ)*M≤C0*W)
    (hleft:(d.eval s)^4≤x ∧ (e.eval s)^4≤2*x)
    (hdata:∀ z∈Set.Icc s t,
      0<d.eval z ∧ 0<e.eval z ∧ W/4≤d.eval z*e.eval z ∧ d.eval z*e.eval z≤W ∧
      (a:ℝ)*d.eval z+(b:ℝ)*e.eval z=(m:ℝ) ∧ 0≤N.eval z ∧ N.eval z≤x)
    (q:ℤ) (hq:q≠0)
    (hnum:∀ z:ℝ,(q:ℝ)*(d.eval z*e.eval z)^4=
      H ((a:ℝ)*d.eval z) ((b:ℝ)*e.eval z)+(m:ℝ)^7*N.eval z)
    (hder:∀ z:ℝ,N.derivative.eval z=
      (J:ℝ)*(d.eval z*e.eval z)^3/(m:ℝ)^7*
        (4*(q:ℝ)*((b:ℝ)*e.eval z-(a:ℝ)*d.eval z)-140*((a:ℝ)*(b:ℝ))^4)) :
    (t-s)^28*M^21*W^4≤
      (C0^28/(δ^8*cM^7)+(327680000:ℝ)^4*(8*C0^3)^7)*x^7 ∨
    t-s≤C0/(δ*cM) := by
  let μ : ℝ := |(m:ℝ)|
  let T : ℝ := |((a*b:ℤ):ℝ)|
  have hmR : (m:ℝ)≠0 := by exact_mod_cast hm
