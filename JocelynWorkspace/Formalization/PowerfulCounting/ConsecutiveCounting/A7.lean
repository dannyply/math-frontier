          dsimp [K]; linarith))
      have hgood : ∀ G ∈ S, Primitive G ∧ HighFactor F G ∧
          ∀ m : Fin 4 →₀ ℕ, |((G.coeff m : ℤ) : ℝ)| ≤ x^K := by
        intro G hGS
        obtain ⟨hprim,hGE⟩ := hSgood G hGS
        refine ⟨hprim,hGE,?_⟩
        intro m
        calc
          |((G.coeff m : ℤ) : ℝ)| ≤ Ch*x^K0 :=
            hHeight (x^K0) F G hheight0 hF hFDN hGE.1 hcoeff m
          _ ≤ x*x^K0 := mul_le_mul_of_nonneg_right hxCh (by positivity)
          _ = x^K := by
            dsimp [K]
            rw [Real.rpow_add hx0,Real.rpow_one]
            ring
      refine ⟨F,S,fun _ => ⟨hF,hBi,hFD,hcoeffK,hvan,hScard,hgood,?_⟩⟩
      intro z
      constructor
      · rintro ⟨hz,G,hGE,hzero⟩
        obtain ⟨G',hG'S,hiff⟩ := hScover G hGE
        exact ⟨hz,G',hG'S,(hiff _).mp hzero⟩
      · rintro ⟨hz,G,hGS,hzero⟩
        exact ⟨hz,G,(hSgood G hGS).2,hzero⟩
    · exact ⟨0,∅,fun hj' => (hj hj').elim⟩
  choose F S hData using hchoose
  refine ⟨F,S,?_,?_⟩
  · intro j hj
    rcases hData j hj with ⟨hF,hBi,hFD,hcoeff,hvan,hScard,hgood,hcover⟩
    have hf := original_cell_finite x D E M j h hx8 hsign
    exact ⟨hF,hBi,hFD,hcoeff,hvan,hScard,hgood,hcover,
      hf.subset (by intro z hz; exact hz.1),
      fun G _ => hf.subset (by intro z hz; exact hz.1)⟩

  · by_cases hOcc : ∃ j∈quarticCells D E M, ∃ z : Point, z∈quarticCell x D E M j h
    · obtain ⟨j0,hj0,z0,hz0⟩ := hOcc
      obtain ⟨hD1,hE1,hDx,hEx⟩ := occupied_scale_bounds x D E M j0 h hx8 hsign z0 hz0
      have hUcap : U≤x := by
        have hp : (1 : ℝ)≤D^4 := one_le_pow₀ hD1
        dsimp [U]
        apply (div_le_iff₀ (pow_pos hD 4)).mpr
        simpa only [mul_one] using mul_le_mul_of_nonneg_left hp hx0.le
      have hVcap : V≤x := by
        have hp : (1 : ℝ)≤E^4 := one_le_pow₀ hE1
        dsimp [V]
        apply (div_le_iff₀ (pow_pos hE 4)).mpr
        simpa only [mul_one] using mul_le_mul_of_nonneg_left hp hx0.le
      have hsc (j : ℕ) := A7QuarticMoments.scale_bounds D E U V M j hU hV
      have hApos (j : ℕ) : 0<cofactorA x D E M j := hV.trans_le (hsc j).1
      have hBpos (j : ℕ) : 0<cofactorB x D E M j := hU.trans_le (hsc j).2.2.1
      have hAcap (j : ℕ) : cofactorA x D E M j≤2*x :=
        (hsc j).2.1.trans (by linarith only [hVcap])
      have hBcap (j : ℕ) : cofactorB x D E M j≤2*x :=
        (hsc j).2.2.2.trans (by linarith only [hUcap])
      let p : (j : ℕ) → EllipseData ((M : ℝ)/(4*D)) (quarticRho D E M j) (2*E) :=
        fun j => Classical.choice (ellipse_basis _ _ _ (by positivity) (by positivity))
      let qf : (j : ℕ) →
          EllipseData ((M : ℝ)/(2048*cofactorA x D E M j))
