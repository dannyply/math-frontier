private def integerSupNorm {σ : Type*} (G : MvPolynomial σ ℤ) : ℕ :=
  G.support.sup (fun m => (G.coeff m).natAbs)

private def ActualHB2 : Prop :=
  ∀ a b : ℕ, 1≤a → 1≤b →
    ∀ η : ℝ, 0<η → ∃ C : ℝ,
      ∀ G : MvPolynomial (Fin 4) ℤ,
        (∀ m∈G.support, m 0+m 1=a ∧ m 2+m 3=b) →
        Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G) →
        ∀ B : ℝ, 1≤B →
          let T : Set (Fin 4 → ℤ) :=
            {w | Int.gcd (w 0) (w 1)=1 ∧ Int.gcd (w 2) (w 3)=1 ∧
              MvPolynomial.eval w G=0 ∧ |(w 0:ℝ)|≤B ∧ |(w 1:ℝ)|≤B};
          T.Finite ∧ (T.ncard:ℝ)≤C*B^(2/(b:ℝ)+η)*(integerSupNorm G:ℝ)^η

private theorem integerSupNorm_le
    (G : MvPolynomial (Fin 4) ℤ) (H : ℝ) (hH : 0≤H)
    (hcoeff : ∀ m : Fin 4 →₀ ℕ, |((G.coeff m:ℤ):ℝ)|≤H) :
    (integerSupNorm G:ℝ)≤H := by
  have hn : integerSupNorm G≤⌊H⌋₊ := by
    apply Finset.sup_le
    intro m hm
    apply Nat.le_floor
    have habs : ((G.coeff m).natAbs:ℝ)=|((G.coeff m:ℤ):ℝ)| := by
      rw [← Int.cast_natCast,Int.natCast_natAbs,Int.cast_abs]
    rw [habs]
    exact hcoeff m
  exact (show (integerSupNorm G:ℝ)≤(⌊H⌋₊:ℝ) by exact_mod_cast hn).trans
    (Nat.floor_le hH)

private def firstPairLift (Q : Matrix (Fin 2) (Fin 2) ℤ) (q : Point) : Fin 4 → ℤ :=
  ![(Q.mulVec ![(q.1.1:ℤ),(q.1.2:ℤ)]) 0,
    (Q.mulVec ![(q.1.1:ℤ),(q.1.2:ℤ)]) 1,(q.2.1:ℤ),(q.2.2:ℤ)]

private theorem firstPairLift_injective
    (P Q : Matrix (Fin 2) (Fin 2) ℤ) (hPQ : P*Q=1) :
    Function.Injective (firstPairLift Q) := by
  intro q q' heq
  have hl : Q.mulVec ![(q.1.1:ℤ),(q.1.2:ℤ)]=
      Q.mulVec ![(q'.1.1:ℤ),(q'.1.2:ℤ)] := by
    funext i
    fin_cases i
    · exact congrFun heq 0
    · exact congrFun heq 1
  have hdv : ![(q.1.1:ℤ),(q.1.2:ℤ)]=![(q'.1.1:ℤ),(q'.1.2:ℤ)] := by
    calc
      _ = P.mulVec (Q.mulVec ![(q.1.1:ℤ),(q.1.2:ℤ)]) :=
        (matrix_left_inverse_mulVec P Q hPQ _).symm
      _ = P.mulVec (Q.mulVec ![(q'.1.1:ℤ),(q'.1.2:ℤ)]) := congrArg P.mulVec hl
      _ = _ := matrix_left_inverse_mulVec P Q hPQ _
  have hdZ : (q.1.1:ℤ)=(q'.1.1:ℤ) := congrFun hdv 0
  have heZ : (q.1.2:ℤ)=(q'.1.2:ℤ) := congrFun hdv 1
  have huZ : (q.2.1:ℤ)=(q'.2.1:ℤ) := congrFun heq 2
  have hvZ : (q.2.2:ℤ)=(q'.2.2:ℤ) := congrFun heq 3
  have hdN : q.1.1=q'.1.1 := by exact_mod_cast hdZ
  have heN : q.1.2=q'.1.2 := by exact_mod_cast heZ
  have huN : q.2.1=q'.2.1 := by exact_mod_cast huZ
  have hvN : q.2.2=q'.2.2 := by exact_mod_cast hvZ
  exact Prod.ext (Prod.ext hdN heN) (Prod.ext huN hvN)

private def firstBasisRadius (D E r : ℝ) (M : ℕ) : ℝ :=
