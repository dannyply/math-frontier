  let F : Finset (ℕ × ℕ) := A.biUnion (fun a =>
    (Finset.Icc ⌈lo a⌉₊ ⌊lo a + len⌋₊).image (fun b => (a, b)))
  have hsub : S ⊆ (↑F : Set (ℕ × ℕ)) := by
    intro p hp
    obtain ⟨hA, h1, h2⟩ := hS p hp
    have hmem : p ∈ F := Finset.mem_biUnion.mpr ⟨p.1, hA, Finset.mem_image.mpr
      ⟨p.2, Finset.mem_Icc.mpr ⟨Nat.ceil_le.mpr h1, Nat.le_floor h2⟩, rfl⟩⟩
    exact Finset.mem_coe.mpr hmem
  have hfin : S.Finite := (Finset.finite_toSet F).subset hsub
  refine ⟨hfin, ?_⟩
  have hcardS : S.ncard ≤ F.card := by
    calc
      S.ncard ≤ (↑F : Set (ℕ × ℕ)).ncard := Set.ncard_le_ncard hsub (Finset.finite_toSet F)
      _ = F.card := Set.ncard_coe_finset F
  have hcardF : F.card ≤ ∑ a ∈ A,
      ((Finset.Icc ⌈lo a⌉₊ ⌊lo a + len⌋₊).image (fun b => (a, b))).card :=
    Finset.card_biUnion_le
  have hterm : ∀ a ∈ A,
      ((((Finset.Icc ⌈lo a⌉₊ ⌊lo a + len⌋₊).image (fun b => (a, b))).card : ℕ) : ℝ) ≤
        len + 1 := by
    intro a _
    have h1 : ((Finset.Icc ⌈lo a⌉₊ ⌊lo a + len⌋₊).image (fun b => (a, b))).card ≤
        (Finset.Icc ⌈lo a⌉₊ ⌊lo a + len⌋₊).card := Finset.card_image_le
    have h1' : ((((Finset.Icc ⌈lo a⌉₊ ⌊lo a + len⌋₊).image (fun b => (a, b))).card : ℕ) : ℝ) ≤
        (((Finset.Icc ⌈lo a⌉₊ ⌊lo a + len⌋₊).card : ℕ) : ℝ) := by exact_mod_cast h1
    exact h1'.trans (np_icc_card_real (lo a) len hlen)
  have hsum : (∑ a ∈ A,
      ((((Finset.Icc ⌈lo a⌉₊ ⌊lo a + len⌋₊).image (fun b => (a, b))).card : ℕ) : ℝ)) ≤
      ∑ _a ∈ A, (len + 1) := Finset.sum_le_sum hterm
  rw [Finset.sum_const, nsmul_eq_mul] at hsum
  have hcast : (S.ncard : ℝ) ≤ (∑ a ∈ A,
      ((((Finset.Icc ⌈lo a⌉₊ ⌊lo a + len⌋₊).image (fun b => (a, b))).card : ℕ) : ℝ)) := by
    have h := hcardS.trans hcardF
    exact_mod_cast h
  exact hcast.trans hsum

private theorem np_int_monomial_of_rat (R : MvPolynomial (Fin 2) ℤ) (j : Fin 2) (n : ℕ) (κ : ℚ)
    (h : MvPolynomial.map (Int.castRingHom ℚ) R = C κ * X j ^ n) :
    ∃ c : ℤ, R = C c * X j ^ n := by
  have hκ : ((R.coeff (Finsupp.single j n) : ℤ) : ℚ) = κ := by
    have h1 := congrArg (MvPolynomial.coeff (Finsupp.single j n)) h
    simpa [MvPolynomial.coeff_map, MvPolynomial.coeff_C_mul, MvPolynomial.coeff_X_pow] using h1
  refine ⟨R.coeff (Finsupp.single j n), ?_⟩
  apply MvPolynomial.map_injective (Int.castRingHom ℚ) (RingHom.injective_int _)
  rw [h, ← hκ]
  simp

private theorem np_divisor_fee_gen
    (F L : ℝ) (hF : 0 ≤ F) (hL : 0 ≤ L) (e : ℕ) (D : ℝ) (hD : 0 ≤ D)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ C : ℝ, 0 < C ∧ ∀ x : ℝ, 2 ≤ x →
      ∀ B : ℤ, B ≠ 0 →
        |(B : ℝ)| ≤ F * x ^ L →
        D * (B.natAbs.divisors.card : ℝ) ^ e ≤ C * x ^ ε := by
  let δ : ℝ := ε / (L * e + 1)
  have hden : 0 < L * e + 1 := by positivity
  have hδ : 0 < δ := div_pos hε hden
  have hδeq : δ * (L * e + 1) = ε := div_mul_cancel₀ ε (ne_of_gt hden)
  have hexp : L * ((e:ℝ) * δ) ≤ ε := by nlinarith
  obtain ⟨Cd, hCd, hdb⟩ := C01.PcLowdegRed.divisor_bound δ hδ
  have hFd : 0 ≤ F ^ ((e:ℝ) * δ) := Real.rpow_nonneg hF _
  have hCd0 : 0 ≤ Cd := by linarith
  have h0 : 0 ≤ D * Cd ^ e * F ^ ((e:ℝ) * δ) :=
    mul_nonneg (mul_nonneg hD (pow_nonneg hCd0 e)) hFd
  refine ⟨D * Cd ^ e * F ^ ((e:ℝ) * δ) + 1, by linarith, ?_⟩
  intro x hx B hB hBb
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hcast : (B.natAbs : ℝ) = |(B : ℝ)| := by
    rw [← Int.cast_natCast, Int.natCast_natAbs, Int.cast_abs]
  have hD1 : (B.natAbs.divisors.card : ℝ) ≤ Cd * |(B : ℝ)| ^ δ := by
    have ht := hdb B.natAbs (Int.natAbs_ne_zero.mpr hB)
    rwa [hcast] at ht
  have hDe : (B.natAbs.divisors.card : ℝ) ^ e ≤ Cd ^ e * |(B : ℝ)| ^ ((e:ℝ) * δ) := by
    calc
      (B.natAbs.divisors.card : ℝ) ^ e ≤ (Cd * |(B : ℝ)| ^ δ) ^ e :=
        pow_le_pow_left₀ (Nat.cast_nonneg _) hD1 _
      _ = Cd ^ e * |(B : ℝ)| ^ ((e:ℝ) * δ) := by
        rw [mul_pow]
        congr 1
        rw [← Real.rpow_natCast, ← Real.rpow_mul (abs_nonneg _)]
        congr 1
        ring
  have hMeta : |(B : ℝ)| ^ ((e:ℝ) * δ) ≤ F ^ ((e:ℝ) * δ) * x ^ ε := by
    calc
      |(B : ℝ)| ^ ((e:ℝ) * δ) ≤ (F * x ^ L) ^ ((e:ℝ) * δ) :=
        Real.rpow_le_rpow (abs_nonneg _) hBb (by positivity)
      _ = F ^ ((e:ℝ) * δ) * (x ^ L) ^ ((e:ℝ) * δ) :=
        Real.mul_rpow hF (Real.rpow_nonneg hx0.le _)
      _ = F ^ ((e:ℝ) * δ) * x ^ (L * ((e:ℝ) * δ)) := by
        rw [← Real.rpow_mul hx0.le]
      _ ≤ F ^ ((e:ℝ) * δ) * x ^ ε :=
        mul_le_mul_of_nonneg_left
          (Real.rpow_le_rpow_of_exponent_le hx1 hexp) hFd
  calc
    D * (B.natAbs.divisors.card : ℝ) ^ e ≤ D * (Cd ^ e * |(B : ℝ)| ^ ((e:ℝ) * δ)) :=
      mul_le_mul_of_nonneg_left hDe hD
    _ ≤ D * (Cd ^ e * (F ^ ((e:ℝ) * δ) * x ^ ε)) :=
      mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left hMeta (pow_nonneg hCd0 _)) hD
    _ = (D * Cd ^ e * F ^ ((e:ℝ) * δ)) * x ^ ε := by ring
    _ ≤ (D * Cd ^ e * F ^ ((e:ℝ) * δ) + 1) * x ^ ε := by
      apply mul_le_mul_of_nonneg_right _ (Real.rpow_nonneg hx0.le _)
      linarith

private theorem np_window_x0 (d e : ℕ) (ρ M E : ℝ) (hρ0 : 0 < ρ) (hM : 1 ≤ M)
    (he0 : (0:ℝ) < (e:ℝ)) (heE : (e:ℝ) ≤ E)
    (hρl : ρ < (d:ℝ) / (e:ℝ)) (hρu : (d:ℝ) / (e:ℝ) ≤ ρ * (1 + 1 / M)) :
    (d:ℝ) / ρ - E / M ≤ (e:ℝ) ∧ (e:ℝ) ≤ (d:ℝ) / ρ - E / M + E / M := by
  have hM0 : 0 < M := by linarith
  have hρe : ρ * (e:ℝ) < (d:ℝ) := (lt_div_iff₀ he0).mp hρl
  have hd' : (d:ℝ) ≤ ρ * (1 + 1 / M) * (e:ℝ) := (div_le_iff₀ he0).mp hρu
  have key : ρ * (1 / M) * (e:ℝ) ≤ ρ * (1 / M) * E :=
    mul_le_mul_of_nonneg_left heE (by positivity)
  constructor
  · have h1 : (d:ℝ) ≤ ((e:ℝ) + E / M) * ρ := by
      have hEM : E / M = E * (1 / M) := by ring
      rw [hEM]
      nlinarith [key, hd']
    have h2 : (d:ℝ) / ρ ≤ (e:ℝ) + E / M := (div_le_iff₀ hρ0).mpr h1
    linarith
  · have h3 : (e:ℝ) ≤ (d:ℝ) / ρ := by
      rw [le_div_iff₀ hρ0]
      linarith
    linarith

private theorem np_window_x1 (d e : ℕ) (ρ M D : ℝ) (hM : 1 ≤ M)
    (he0 : (0:ℝ) < (e:ℝ)) (hdD : (d:ℝ) ≤ D)
    (hρl : ρ < (d:ℝ) / (e:ℝ)) (hρu : (d:ℝ) / (e:ℝ) ≤ ρ * (1 + 1 / M)) :
    ρ * (e:ℝ) ≤ (d:ℝ) ∧ (d:ℝ) ≤ ρ * (e:ℝ) + D / M := by
  have hM0 : 0 < M := by linarith
  have hρe : ρ * (e:ℝ) < (d:ℝ) := (lt_div_iff₀ he0).mp hρl
  have hd' : (d:ℝ) ≤ ρ * (1 + 1 / M) * (e:ℝ) := (div_le_iff₀ he0).mp hρu
  have key : ρ * (e:ℝ) * (1 / M) ≤ D * (1 / M) :=
    mul_le_mul_of_nonneg_right (by linarith) (by positivity)
  constructor
  · linarith
  · have hDM : D / M = D * (1 / M) := by ring
    rw [hDM]
    nlinarith [key, hd']

private theorem np_hpow (x K : ℝ) (hx : 2 ≤ x) (hK : 0 ≤ K) (α N : ℕ) (hαN : α ≤ N) :
    (x ^ K) ^ (4 * α) ≤ x ^ (4 * (N:ℝ) * K) := by
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hH : 1 ≤ x ^ K := Real.one_le_rpow hx1 hK
  calc
    (x ^ K) ^ (4 * α) ≤ (x ^ K) ^ (4 * N) := pow_le_pow_right₀ hH (by omega)
    _ = x ^ (4 * (N:ℝ) * K) := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul hx0.le]
      congr 1
      push_cast
      ring

private theorem coord_internal (N : ℕ) (K : ℝ) (hK : 0 ≤ K) (ε : ℝ) (hε : 0 < ε) :
    ∃ C1 : ℝ, 0 < C1 ∧ ∀ x : ℝ, 2 ≤ x → ∀ D E M ρ : ℝ, 0 < D → 0 < E → 1 ≤ M →
      D / (2 * E) ≤ ρ → ρ ≤ 2 * D / E →
      ∀ α : ℕ, 1 ≤ α → α ≤ N → ∀ G : MvPolynomial (Fin 4) ℤ, G ≠ 0 →
      (∀ m ∈ G.support, m 0 + m 1 = α ∧ m 2 + m 3 = 1) →
      Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G) →
      (∀ m : Fin 4 →₀ ℕ, |((G.coeff m : ℤ) : ℝ)| ≤ x ^ K) →
      (∃ c : ℤ, residual G = C c * X 0 ^ (α + 4) ∨ residual G = C c * X 1 ^ (α + 4)) →
      let T : Set ((ℕ × ℕ) × (ℕ × ℕ)) := {z | 1 ≤ z.1.1 ∧ 1 ≤ z.1.2 ∧ 1 ≤ z.2.1 ∧
        1 ≤ z.2.2 ∧ z.1.2 ^ 4 * z.2.2 = z.1.1 ^ 4 * z.2.1 + 1 ∧
        ((z.1.1 ^ 4 * z.2.1 : ℕ) : ℝ) ≤ x ∧
        D / 2 < (z.1.1 : ℝ) ∧ (z.1.1 : ℝ) ≤ D ∧ E / 2 < (z.1.2 : ℝ) ∧ (z.1.2 : ℝ) ≤ E ∧
        ρ < (z.1.1 : ℝ) / (z.1.2 : ℝ) ∧ (z.1.1 : ℝ) / (z.1.2 : ℝ) ≤ ρ * (1 + 1 / M) ∧
        MvPolynomial.eval ![(z.1.1 : ℤ), (z.1.2 : ℤ), (z.2.1 : ℤ), (z.2.2 : ℤ)] G = 0};
      T.Finite ∧ (T.ncard : ℝ) ≤ C1 * x ^ ε * (1 + max D E / M) := by
  classical
  obtain ⟨C1, hC1, hfee⟩ := np_divisor_fee_gen (((2 * N).factorial : ℝ) ^ 2) (4 * (N:ℝ) * K)
    (by positivity) (by positivity) 1 1 (by norm_num) ε hε
  refine ⟨C1, hC1, ?_⟩
  intro x hx D E M ρ hD hE hM hρ1 hρ2 α hα1 hαN G hG0 hbi hi hheight hmono
  let T : Set ((ℕ × ℕ) × (ℕ × ℕ)) := {z | 1 ≤ z.1.1 ∧ 1 ≤ z.1.2 ∧ 1 ≤ z.2.1 ∧
    1 ≤ z.2.2 ∧ z.1.2 ^ 4 * z.2.2 = z.1.1 ^ 4 * z.2.1 + 1 ∧
    ((z.1.1 ^ 4 * z.2.1 : ℕ) : ℝ) ≤ x ∧
    D / 2 < (z.1.1 : ℝ) ∧ (z.1.1 : ℝ) ≤ D ∧ E / 2 < (z.1.2 : ℝ) ∧ (z.1.2 : ℝ) ≤ E ∧
    ρ < (z.1.1 : ℝ) / (z.1.2 : ℝ) ∧ (z.1.1 : ℝ) / (z.1.2 : ℝ) ≤ ρ * (1 + 1 / M) ∧
    MvPolynomial.eval ![(z.1.1 : ℤ), (z.1.2 : ℤ), (z.2.1 : ℤ), (z.2.2 : ℤ)] G = 0}
  change T.Finite ∧ (T.ncard : ℝ) ≤ C1 * x ^ ε * (1 + max D E / M)
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hH : 1 ≤ x ^ K := Real.one_le_rpow hx1 hK
  have hM0 : 0 < M := by linarith
  have hρ0 : 0 < ρ := lt_of_lt_of_le (by positivity) hρ1
  let P := C01.PcParam.PP G
  let Q := -C01.PcParam.QQ G
  obtain ⟨hP, hQ, hcoeff, hno⟩ := generic_graph_data G α hbi hi (x ^ K) (by linarith) hheight
  have hgraph := graph_eval G α hbi
  obtain ⟨Bres, hBres, hBbound, hBdiv⟩ :=
    resultant_of_no_common_zero α hα1 P Q hP hQ hno (x ^ K) hH hcoeff
  have hfac : (((2 * α).factorial : ℝ) ^ 2) ≤ ((2 * N).factorial : ℝ) ^ 2 := by
    have h1 : (2 * α).factorial ≤ (2 * N).factorial := Nat.factorial_le (by omega)
    have h2 : ((2 * α).factorial : ℝ) ≤ ((2 * N).factorial : ℝ) := by exact_mod_cast h1
    exact pow_le_pow_left₀ (Nat.cast_nonneg _) h2 2
  have hpow : (x ^ K) ^ (4 * α) ≤ x ^ (4 * (N:ℝ) * K) := np_hpow x K hx hK α N hαN
  have hBcap : |(Bres : ℝ)| ≤ ((2 * N).factorial : ℝ) ^ 2 * x ^ (4 * (N:ℝ) * K) :=
    hBbound.trans (mul_le_mul hfac hpow (by positivity) (by positivity))
  have htau0 := hfee x hx Bres hBres hBcap
  have htau : (Bres.natAbs.divisors.card : ℝ) ≤ C1 * x ^ ε := by simpa using htau0
  have hvalue : ∀ d e : ℤ,
      eval ![d, e] (residual G) = e ^ 4 * eval ![d, e] P - d ^ 4 * eval ![d, e] Q := by
    intro d e
    simp [residual, P, Q]
  have hinfo : ∀ z ∈ T, z.1.1.Coprime z.1.2 ∧
      eval ![(z.1.1 : ℤ), (z.1.2 : ℤ)] (residual G) ≠ 0 ∧
      eval ![(z.1.1 : ℤ), (z.1.2 : ℤ)] (residual G) ∣ Bres := by
    rintro ⟨⟨d, e⟩, ⟨u, v⟩⟩ hz
    rcases hz with ⟨hd, he, hu, hv, hunit, hcut, hDl, hDu, hEl, hEu, hρl, hρu, hG⟩
    have hshift : ((e ^ 4 * v : ℕ) : ℤ) = ((d ^ 4 * u : ℕ) : ℤ) + 1 := by exact_mod_cast hunit
    have hcop := (both_coprime4 d e u v 1 (Or.inl rfl) hshift).1
    have hcopZ : Int.gcd (d : ℤ) (e : ℤ) = 1 := by simpa using hcop.gcd_eq_one
    have hg := hgraph d e u v hG
    have hs := shift_int d e u v 1 hshift
    have hres : (Int.gcd (eval ![(d : ℤ), (e : ℤ)] Q)
        (eval ![(d : ℤ), (e : ℤ)] P) : ℤ) ∣ Bres := by
      simpa only [Int.gcd_comm] using hBdiv d e hcopZ
    obtain ⟨hn, hdvd⟩ := graph_value_divides_resultant
      (eval ![(d : ℤ), (e : ℤ)] P) (eval ![(d : ℤ), (e : ℤ)] Q)
      d e u v 1 Bres (Or.inl rfl) hg hs hres hBres
    exact ⟨hcop, by simpa only [hvalue] using hn, by simpa only [hvalue] using hdvd⟩
  have hfiber : ∀ z ∈ T, ∀ z' ∈ T, z.1.1 = z'.1.1 → z.1.2 = z'.1.2 → z = z' := by
    rintro ⟨⟨d, e⟩, ⟨u, v⟩⟩ hz ⟨⟨d', e'⟩, ⟨u', v'⟩⟩ hz' hdd hee
    have hd : d = d' := hdd
    have he : e = e' := hee
    subst d'
    subst e'
    have hRn := (hinfo ((d, e), (u, v)) hz).2.1
    rw [hvalue] at hRn
    rcases hz with ⟨hdp, hep, hup, hvp, hunit, hcut, _, _, _, _, _, _, hGat⟩
    rcases hz' with ⟨hdp', hep', hup', hvp', hunit', hcut', _, _, _, _, _, _, hGat'⟩
    have hs : (e : ℤ) ^ 4 * (v : ℤ) - (d : ℤ) ^ 4 * (u : ℤ) = 1 := by
      have ht : ((e ^ 4 * v : ℕ) : ℤ) = ((d ^ 4 * u : ℕ) : ℤ) + 1 := by exact_mod_cast hunit
      exact shift_int d e u v 1 ht
    have hs' : (e : ℤ) ^ 4 * (v' : ℤ) - (d : ℤ) ^ 4 * (u' : ℤ) = 1 := by
      have ht : ((e ^ 4 * v' : ℕ) : ℤ) = ((d ^ 4 * u' : ℕ) : ℤ) + 1 := by exact_mod_cast hunit'
      exact shift_int d e u' v' 1 ht
    obtain ⟨huv, hvv⟩ := second_pair_unique
      (eval ![(d : ℤ), (e : ℤ)] P) (eval ![(d : ℤ), (e : ℤ)] Q)
      d e u v u' v' 1 hRn (hgraph d e u v hGat) hs (hgraph d e u' v' hGat') hs'
    have hu : u = u' := by exact_mod_cast huv
    have hv : v = v' := by exact_mod_cast hvv
    subst u'
    subst v'
    rfl
  have hEM : 0 ≤ E / M := by positivity
  have hDM : 0 ≤ D / M := by positivity
  have hEmax : E / M ≤ max D E / M := by
    gcongr
    exact le_max_right D E
  have hDmax : D / M ≤ max D E / M := by
    gcongr
    exact le_max_left D E
  have hCx : 0 ≤ C1 * x ^ ε := by positivity
  obtain ⟨c, hc⟩ := hmono
  rcases hc with hc0 | hc1
  · let S : Set (ℕ × ℕ) := (fun z : (ℕ × ℕ) × (ℕ × ℕ) => (z.1.1, z.1.2)) '' T
    have hS : ∀ p ∈ S, p.1 ∈ Bres.natAbs.divisors ∧ ((p.1 : ℝ) / ρ - E / M) ≤ (p.2 : ℝ) ∧
        (p.2 : ℝ) ≤ ((p.1 : ℝ) / ρ - E / M) + E / M := by
      rintro p ⟨⟨⟨d, e⟩, ⟨u, v⟩⟩, hz, rfl⟩
      have hzi := hinfo _ hz
      rcases hz with ⟨hd, he, hu, hv, hunit, hcut, hDl, hDu, hEl, hEu, hρl, hρu, hG⟩
      have he1 : 1 ≤ e := he
      have he0 : (0:ℝ) < (e:ℝ) := by exact_mod_cast he1
      have hEu' : (e:ℝ) ≤ E := hEu
      have hρl' : ρ < (d:ℝ) / (e:ℝ) := hρl
      have hρu' : (d:ℝ) / (e:ℝ) ≤ ρ * (1 + 1 / M) := hρu
      have hdiv : eval ![(d : ℤ), (e : ℤ)] (residual G) ∣ Bres := hzi.2.2
      have hev : eval ![(d : ℤ), (e : ℤ)] (residual G) = c * (d : ℤ) ^ (α + 4) := by
        rw [hc0]
        simp
      have hdB : (d : ℤ) ∣ Bres := by
        rw [hev] at hdiv
        exact (Dvd.dvd.mul_left (dvd_pow_self (d : ℤ) (by omega : α + 4 ≠ 0)) c).trans hdiv
      have hdN : d ∣ Bres.natAbs := by simpa using (Int.natAbs_dvd_natAbs.mpr hdB)
      have hmem : d ∈ Bres.natAbs.divisors :=
        Nat.mem_divisors.mpr ⟨hdN, Int.natAbs_ne_zero.mpr hBres⟩
      obtain ⟨hw1, hw2⟩ := np_window_x0 d e ρ M E hρ0 hM he0 hEu' hρl' hρu'
      exact ⟨hmem, hw1, hw2⟩
    obtain ⟨hSfin, hScard⟩ := np_window_cover Bres.natAbs.divisors
      (fun d => (d : ℝ) / ρ - E / M) (E / M) hEM S hS
    have hinj : Set.InjOn (fun z : (ℕ × ℕ) × (ℕ × ℕ) => (z.1.1, z.1.2)) T := by
      intro z hz z' hz' hp
      have h1 : z.1.1 = z'.1.1 := congrArg Prod.fst hp
      have h2 : z.1.2 = z'.1.2 := congrArg Prod.snd hp
      exact hfiber z hz z' hz' h1 h2
    have hTfin : T.Finite := Set.Finite.of_finite_image hSfin hinj
    have hTS : T.ncard = S.ncard := (Set.ncard_image_of_injOn hinj).symm
    refine ⟨hTfin, ?_⟩
    rw [hTS]
    calc (S.ncard : ℝ) ≤ (Bres.natAbs.divisors.card : ℝ) * (E / M + 1) := hScard
      _ ≤ (C1 * x ^ ε) * (1 + max D E / M) :=
        mul_le_mul htau (by linarith) (by positivity) hCx
      _ = C1 * x ^ ε * (1 + max D E / M) := by ring
  · let S : Set (ℕ × ℕ) := (fun z : (ℕ × ℕ) × (ℕ × ℕ) => (z.1.2, z.1.1)) '' T
