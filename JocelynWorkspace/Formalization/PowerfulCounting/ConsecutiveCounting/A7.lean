      ((c : ℝ) * (a : ℝ) ^ 4 * (b : ℝ) ^ 5) - 91
    let lam : ℝ := (K0 : ℝ) /
      ((c : ℝ) * (a : ℝ) ^ 5 * (b : ℝ) ^ 5)
