  refine ⟨j, hj, h1, h2, h3, h4, ?_, ?_, ?_, h8, h9, h10, h11, hlo, hhi⟩
  · exact_mod_cast h5
  · push_cast
    exact h6
  · push_cast
    exact h7

theorem card_biUnion_le {ι P : Type*} [DecidableEq ι] (f : ι → Set P) (s : Finset ι)
    (hf : ∀ i ∈ s, (f i).Finite) :
    (⋃ i ∈ s, f i).Finite ∧
      (((⋃ i ∈ s, f i).ncard : ℕ) : ℝ) ≤ ∑ i ∈ s, (((f i).ncard : ℕ) : ℝ) := by
  induction s using Finset.induction_on with
  | empty => simp
  | @insert a s ha ih =>
    have hfa : (f a).Finite := hf a (Finset.mem_insert_self a s)
    obtain ⟨hfin, hcard⟩ := ih (fun i hi => hf i (Finset.mem_insert_of_mem hi))
    have hU : (⋃ i ∈ insert a s, f i) = f a ∪ ⋃ i ∈ s, f i := by
      ext z
      simp only [Set.mem_iUnion, Set.mem_union, Finset.mem_insert, exists_prop]
      constructor
      · rintro ⟨i, hi | hi, hz⟩
        · rw [hi] at hz
          exact Or.inl hz
        · exact Or.inr ⟨i, hi, hz⟩
      · rintro (hz | ⟨i, hi, hz⟩)
        · exact ⟨a, Or.inl rfl, hz⟩
        · exact ⟨i, Or.inr hi, hz⟩
    rw [hU, Finset.sum_insert ha]
    refine ⟨hfa.union hfin, ?_⟩
    have h1 : (((f a ∪ ⋃ i ∈ s, f i).ncard : ℕ) : ℝ) ≤
        (((f a).ncard : ℕ) : ℝ) + (((⋃ i ∈ s, f i).ncard : ℕ) : ℝ) := by
      exact_mod_cast Set.ncard_union_le (f a) (⋃ i ∈ s, f i)
    linarith

theorem card_cells (p : ℕ → Prop) (inst : DecidablePred p) (M : ℕ) :
    (((@Finset.filter ℕ p inst (Finset.range (3 * M + 1))).card : ℕ) : ℝ) ≤ 3 * (M : ℝ) + 1 := by
  have h := Finset.card_filter_le (Finset.range (3 * M + 1)) p
  rw [Finset.card_range] at h
  have h2 : (((@Finset.filter ℕ p inst (Finset.range (3 * M + 1))).card : ℕ) : ℝ) ≤
      ((3 * M + 1 : ℕ) : ℝ) := by
    exact_mod_cast h
  push_cast at h2
  linarith

theorem assembly_final8 {P : Type*} (Box Exc : Set P) (cs : Finset ℕ) (Cell HU : ℕ → Set P)
    (𝓖 : ℕ → Finset (MvPolynomial (Fin 4) ℤ)) (ev : MvPolynomial (Fin 4) ℤ → P → Prop)
    (C₁ C₂ xe Mr T : ℝ)
    (hcover : ∀ z ∈ Box, z ∉ Exc → ∃ j ∈ cs, z ∈ Cell j)
    (hiff : ∀ j ∈ cs, ∀ z, z ∈ HU j ↔ z ∈ Cell j ∧ ∃ G ∈ 𝓖 j, ev G z)
    (hHC : ∀ j ∈ cs, ∀ G ∈ 𝓖 j, {z | z ∈ Cell j ∧ ev G z}.Finite)
    (hL : ∀ j ∈ cs, {z | z ∈ Cell j ∧ z ∉ Exc ∧ z ∉ HU j}.Finite ∧
        (({z | z ∈ Cell j ∧ z ∉ Exc ∧ z ∉ HU j}.ncard : ℕ) : ℝ) ≤ C₁ * xe)
    (hsum : (∑ j ∈ cs, ∑ G ∈ 𝓖 j, (({z | z ∈ Cell j ∧ ev G z}.ncard : ℕ) : ℝ)) ≤
        C₂ * xe * (Mr + T))
    (hcard : ((cs.card : ℕ) : ℝ) ≤ 3 * Mr + 1)
    (hxe : 0 ≤ xe) (hMr : 1 ≤ Mr) (hT : 0 ≤ T) (hC₁ : 0 < C₁) (hC₂ : 0 < C₂) :
    (Box \ Exc).Finite ∧
      (((Box \ Exc).ncard : ℕ) : ℝ) ≤ (C₂ + 4 * C₁) * xe * (Mr + T) := by
  classical
  have hsub : Box \ Exc ⊆ ⋃ j ∈ cs, ((⋃ G ∈ 𝓖 j, {z | z ∈ Cell j ∧ ev G z}) ∪
      {z | z ∈ Cell j ∧ z ∉ Exc ∧ z ∉ HU j}) := by
    intro z hz
    obtain ⟨j, hj, hzc⟩ := hcover z hz.1 hz.2
    rw [Set.mem_iUnion₂]
    refine ⟨j, hj, ?_⟩
    by_cases hh : z ∈ HU j
    · apply Set.mem_union_left
      obtain ⟨-, G, hG, hev⟩ := (hiff j hj z).mp hh
      rw [Set.mem_iUnion₂]
      exact ⟨G, hG, hzc, hev⟩
    · apply Set.mem_union_right
      exact ⟨hzc, hz.2, hh⟩
  have hU : ∀ j ∈ cs, ((⋃ G ∈ 𝓖 j, {z | z ∈ Cell j ∧ ev G z}) ∪
      {z | z ∈ Cell j ∧ z ∉ Exc ∧ z ∉ HU j}).Finite ∧
      ((((⋃ G ∈ 𝓖 j, {z | z ∈ Cell j ∧ ev G z}) ∪
      {z | z ∈ Cell j ∧ z ∉ Exc ∧ z ∉ HU j}).ncard : ℕ) : ℝ) ≤
      (∑ G ∈ 𝓖 j, (({z | z ∈ Cell j ∧ ev G z}.ncard : ℕ) : ℝ)) + C₁ * xe := by
    intro j hj
    obtain ⟨hf1, hc1⟩ := card_biUnion_le (fun G => {z | z ∈ Cell j ∧ ev G z}) (𝓖 j)
      (fun G hG => hHC j hj G hG)
    obtain ⟨hf2, hc2⟩ := hL j hj
    refine ⟨hf1.union hf2, ?_⟩
    have h3 : ((((⋃ G ∈ 𝓖 j, {z | z ∈ Cell j ∧ ev G z}) ∪
        {z | z ∈ Cell j ∧ z ∉ Exc ∧ z ∉ HU j}).ncard : ℕ) : ℝ) ≤
        (((⋃ G ∈ 𝓖 j, {z | z ∈ Cell j ∧ ev G z}).ncard : ℕ) : ℝ) +
        (({z | z ∈ Cell j ∧ z ∉ Exc ∧ z ∉ HU j}.ncard : ℕ) : ℝ) := by
      exact_mod_cast Set.ncard_union_le _ _
    linarith
  obtain ⟨hfinU, hcardU⟩ := card_biUnion_le
    (fun j => (⋃ G ∈ 𝓖 j, {z | z ∈ Cell j ∧ ev G z}) ∪
      {z | z ∈ Cell j ∧ z ∉ Exc ∧ z ∉ HU j}) cs (fun j hj => (hU j hj).1)
  refine ⟨hfinU.subset hsub, ?_⟩
  have hB1 : (((Box \ Exc).ncard : ℕ) : ℝ) ≤ (((⋃ j ∈ cs, ((⋃ G ∈ 𝓖 j, {z | z ∈ Cell j ∧ ev G z}) ∪
      {z | z ∈ Cell j ∧ z ∉ Exc ∧ z ∉ HU j})).ncard : ℕ) : ℝ) := by
    exact_mod_cast Set.ncard_le_ncard hsub hfinU
  have hB2 := Finset.sum_le_sum (fun j hj => (hU j hj).2)
  rw [Finset.sum_add_distrib, Finset.sum_const, nsmul_eq_mul] at hB2
  have hL4 : ((cs.card : ℕ) : ℝ) * (C₁ * xe) ≤ (3 * Mr + 1) * (C₁ * xe) :=
    mul_le_mul_of_nonneg_right hcard (by positivity)
  have h4 : (3 * Mr + 1) * (C₁ * xe) ≤ 4 * C₁ * xe * Mr := by
    have hA : 0 ≤ C₁ * xe := by positivity
    have h31 : 3 * Mr + 1 ≤ 4 * Mr := by linarith
    calc (3 * Mr + 1) * (C₁ * xe) ≤ 4 * Mr * (C₁ * xe) :=
          mul_le_mul_of_nonneg_right h31 hA
      _ = 4 * C₁ * xe * Mr := by ring
  have h6 : 0 ≤ 4 * C₁ * xe * T := by positivity
  have hfin : (((Box \ Exc).ncard : ℕ) : ℝ) ≤
      C₂ * xe * (Mr + T) + 4 * C₁ * xe * Mr := by
    linarith
  nlinarith

