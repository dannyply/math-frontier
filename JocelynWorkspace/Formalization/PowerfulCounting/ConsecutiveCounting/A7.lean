  obtain ⟨hw0,hw1⟩ := recover P A hPA w
  rcases hcases with ⟨h0,h1⟩|⟨h0,h1⟩
  · have hd : z 0=w 0 := by rw [h0,h1] at hz0;exact hz0.symm.trans hw0
    have he : z 1=w 1 := by rw [h0,h1] at hz1;exact hz1.symm.trans hw1
    have hu : z 2=w 2 := by
      have hp : (z 0)^4*(z 2-w 2)=0 := by
        rw [←hd,←he,←hv] at hwF
        linear_combination hwF-hzF
      have hd0 : z 0≠0 := (hzpos 0).ne'
      exact sub_eq_zero.mp ((mul_eq_zero.mp hp).resolve_left (pow_ne_zero 4 hd0))
    funext i
    fin_cases i
    · exact hd
    · exact he
    · exact hu
    · exact hv
  · exfalso
    rw [h0,h1] at hw0
    have hneg : w 0= -z 0 := by
      linear_combination -hw0-hz0
    have hz0pos := hzpos 0
    have hw0pos := hwpos 0
    omega
lemma scaledQuartic_height (v a b : ℤ) (L V : ℝ) (hv : 0≤v)
    (hL : 0≤L) (hV : (v:ℝ)≤V)
    (ha : |(a:ℝ)|≤L) (hb : |(b:ℝ)|≤L) (i : Fin 5) :
    |((scaledQuartic v a b i:ℤ):ℝ)|≤L^4*V := by
  have hvR : (0:ℝ)≤v := by exact_mod_cast hv
  have hVR : 0≤V := hvR.trans hV
