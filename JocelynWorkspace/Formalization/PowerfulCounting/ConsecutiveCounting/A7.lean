    S.card ≤ ab.1+ab.2 ∧
    (∀ G ∈ S, Primitive G ∧ HighFactor F G ∧
      ∀ m : Fin 4 →₀ ℕ, |((G.coeff m : ℤ) : ℝ)| ≤ x^K) ∧
    (∀ z : Point, z ∈ HighUnion x D E M j h F ↔
      z ∈ quarticCell x D E M j h ∧ ∃ G ∈ S,
        MvPolynomial.eval ![(z.1.1 : ℤ),(z.1.2 : ℤ),(z.2.1 : ℤ),(z.2.2 : ℤ)] G=0)
  have hchoose : ∀ j : ℕ, ∃ F : Poly, ∃ S : Finset Poly,
      j ∈ quarticCells D E M → Data j F S := by
    intro j
    by_cases hj : j ∈ quarticCells D E M
    · obtain ⟨F,hF,hBi,hFD,hcoeff,hvan⟩ := (hXaData j hj h hsign).2
      have hFDN : F.totalDegree ≤ N := hFD.trans habN
      obtain ⟨S,hScard,hSgood,hScover⟩ := finite_primitive_high_cover F hF (ab.1+ab.2) hFD
      have hheight0 : 1 ≤ x^K0 := Real.one_le_rpow hx1 hK0.le
      have hcoeffK : ∀ m : Fin 4 →₀ ℕ, |((F.coeff m : ℤ) : ℝ)| ≤ x^K := by
        intro m
