    apply Finset.mem_image.mpr
    refine ⟨⟨j,(X0,Y0)⟩,Finset.mem_sigma.mpr ⟨Finset.mem_univ _,hmem⟩,?_⟩
    exact Prod.ext hxs hys
  · have hJ : J.card≤2*h.natAbs.divisors.card^2 := by
      calc
        J.card=(h.natAbs.divisors.filter (fun g=>g≠0)).card*
            ((signedDivisors h).filter (fun h0=>h0≠0 ∧ h0∣h)).card :=
          Finset.card_product _ _
        _ ≤h.natAbs.divisors.card*(signedDivisors h).card :=
          Nat.mul_le_mul (Finset.card_filter_le _ _) (Finset.card_filter_le _ _)
        _ ≤h.natAbs.divisors.card*(2*h.natAbs.divisors.card) :=
          Nat.mul_le_mul_left _ (signedDivisors_card h)
