  have hdN : z.1.1 ≤ ⌈D⌉₊ := by
    have hh : (z.1.1 : ℝ) ≤ (⌈D⌉₊ : ℝ) := hdDu.trans (Nat.le_ceil D)
    exact_mod_cast hh
  have heN : z.1.2 ≤ ⌈E⌉₊ := by
    have hh : (z.1.2 : ℝ) ≤ (⌈E⌉₊ : ℝ) := heEu.trans (Nat.le_ceil E)
    exact_mod_cast hh
  have hnN : z.1.1 ^ k * z.2.1 ≤ ⌈x⌉₊ := by
    have hh : ((z.1.1 ^ k * z.2.1 : ℕ) : ℝ) ≤ (⌈x⌉₊ : ℝ) := hx1.trans (Nat.le_ceil x)
    exact_mod_cast hh
  have hdk : 1 ≤ z.1.1 ^ k := Nat.one_le_pow _ _ (by omega)
  have hek : 1 ≤ z.1.2 ^ k := Nat.one_le_pow _ _ (by omega)
  have huN : z.2.1 ≤ ⌈x⌉₊ :=
    le_trans (le_mul_of_one_le_left (Nat.zero_le _) hdk) hnN
  have hmN : z.1.2 ^ k * z.2.2 ≤ ⌈x⌉₊ + 1 := by
    have hh : ((z.1.2 ^ k * z.2.2 : ℕ) : ℤ) ≤ ((⌈x⌉₊ + 1 : ℕ) : ℤ) := by
      have hn' : ((z.1.1 ^ k * z.2.1 : ℕ) : ℤ) ≤ ((⌈x⌉₊ : ℕ) : ℤ) := by
        exact_mod_cast hnN
      have hh1 : h ≤ 1 := by rcases hs with hs | hs <;> rw [hs] ; norm_num
      rw [hshift]
      have hc1 : ((⌈x⌉₊ + 1 : ℕ) : ℤ) = ((⌈x⌉₊ : ℕ) : ℤ) + 1 := by push_cast; ring
      rw [hc1]
      linarith
    exact_mod_cast hh
  have hvN : z.2.2 ≤ ⌈x⌉₊ + 1 :=
    le_trans (le_mul_of_one_le_left (Nat.zero_le _) hek) hmN
  have hmem : z ∈ ((Finset.range (N+1) ×ˢ Finset.range (N+1)) ×ˢ
      (Finset.range (N+1) ×ˢ Finset.range (N+1)) : Finset Point) := by
    rw [Finset.mem_product, Finset.mem_product, Finset.mem_product,
      Finset.mem_range, Finset.mem_range, Finset.mem_range, Finset.mem_range]
    dsimp only [N]
    omega
  exact Finset.mem_coe.mpr hmem

theorem cell_cover_k (k : ℕ) (x D E : ℝ) (M : ℕ) (h : ℤ)
    (hD : 0 < D) (hE : 0 < E) (hM : 1 ≤ M)
    (z : Point) (hz : z ∈ boxK k x D E h) :
    ∃ j ∈ cells D E M, z ∈ cellK k x D E M j h := by
  have hz' := hz
  rcases hz' with ⟨hd,he,hu,hv,hshift,hx0,hx1,hdD,hdDu,heE,heEu⟩
  have he0 : (0 : ℝ) < (z.1.2 : ℝ) := by exact_mod_cast (show 0 < z.1.2 by omega)
  have hd0 : (0 : ℝ) < (z.1.1 : ℝ) := by exact_mod_cast (show 0 < z.1.1 by omega)
  have ht0 : D/(2*E) < (z.1.1 : ℝ)/(z.1.2 : ℝ) := by
    apply (div_lt_div_iff₀ (by positivity) he0).mpr
    have h1 := mul_le_mul_of_nonneg_left heEu hD.le
    have h2 := mul_lt_mul_of_pos_right (show D < 2*(z.1.1 : ℝ) by linarith) hE
    nlinarith
  have ht1 : (z.1.1 : ℝ)/(z.1.2 : ℝ) ≤ 2*D/E := by
    apply (div_le_div_iff₀ he0 hE).mpr
    have h1 := mul_le_mul_of_nonneg_right hdDu hE.le
    have h2 := mul_lt_mul_of_pos_left (show E < 2*(z.1.2 : ℝ) by linarith) hD
    nlinarith
  obtain ⟨j,hj,hlo,hhi⟩ :=
    FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.grid_cover
      D E M hD hE hM ((z.1.1 : ℝ)/(z.1.2 : ℝ)) ht0 ht1
  change j ∈ cells D E M at hj
  exact ⟨j,hj,hz,hlo,hhi⟩

theorem first_ellipse_k (k : ℕ) (x D E : ℝ) (M j : ℕ) (h : ℤ)
    (hD : 0 < D) (hE : 0 < E) (hM : 1 ≤ M)
    (hj : j ∈ cells D E M) (z : Point)
    (hz : z ∈ cellK k x D E M j h) :
    FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.nsq
      ((M : ℝ)/(8*D)) (rho D E M j) (4*E)
      ((z.1.1 : ℤ),(z.1.2 : ℤ)) ≤ 1 := by
  have hM0 : (0 : ℝ) < M := by exact_mod_cast (show 0 < M by omega)
  have hc := (Finset.mem_filter.mp hj).2
  let r : ℝ := rho D E M j
  change D/(2*E) ≤ r ∧ r ≤ 2*D/E at hc
  have hr0 : 0 ≤ r := le_trans (by positivity) hc.1
  rcases hz with ⟨hp,ht0,ht1⟩
  rcases hp with ⟨hd,he,hu,hv,-,-,-,hdD,hdDu,heE,heEu⟩
  have he0 : (0 : ℝ) < (z.1.2 : ℝ) := by exact_mod_cast (show 0 < z.1.2 by omega)
  change r < (z.1.1 : ℝ)/(z.1.2 : ℝ) at ht0
  change (z.1.1 : ℝ)/(z.1.2 : ℝ) ≤ r*(1+1/(M : ℝ)) at ht1
  have hdif0 : 0 ≤ (z.1.1 : ℝ)-r*(z.1.2 : ℝ) := by
    have hh := (lt_div_iff₀ he0).mp ht0
    linarith
  have hrE : r*E ≤ 2*D := (le_div_iff₀ hE).mp hc.2
  have hre : r*(z.1.2 : ℝ) ≤ 4*D := by
    have hh := mul_le_mul_of_nonneg_left heEu hr0
    nlinarith
  have hdif : (z.1.1 : ℝ)-r*(z.1.2 : ℝ) ≤ 4*D/(M : ℝ) := by
    have hh := (div_le_iff₀ he0).mp ht1
    have hid :
        r*(1+1/(M : ℝ))*(z.1.2 : ℝ) =
          r*(z.1.2 : ℝ)+(r*(z.1.2 : ℝ))/(M : ℝ) := by ring
    rw [hid] at hh
    have hh' := div_le_div_of_nonneg_right hre hM0.le
    linarith
  have hα : 0 ≤ (M : ℝ)/(8*D) := by positivity
  have hw0 : 0 ≤ ((M : ℝ)/(8*D))*((z.1.1 : ℝ)-r*(z.1.2 : ℝ)) :=
    mul_nonneg hα hdif0
  have hw1 : ((M : ℝ)/(8*D))*((z.1.1 : ℝ)-r*(z.1.2 : ℝ)) ≤ (1/2 : ℝ) := by
    have hh := mul_le_mul_of_nonneg_left hdif hα
    have heq : ((M : ℝ)/(8*D))*(4*D/(M : ℝ))=(1/2 : ℝ) := by
      field_simp [hD.ne',hM0.ne'] ; ring
    rwa [heq] at hh
  have heq0 : 0 ≤ (z.1.2 : ℝ)/(4*E) := by positivity
  have heq1 : (z.1.2 : ℝ)/(4*E) ≤ (1/2 : ℝ) := by
    apply (div_le_iff₀ (by positivity : 0 < 4*E)).mpr
    linarith
  change (((M : ℝ)/(8*D))*(((z.1.1 : ℤ) : ℝ)-
      r*((z.1.2 : ℤ) : ℝ)))^2+(((z.1.2 : ℤ) : ℝ)/(4*E))^2 ≤ 1
  simp only [Int.cast_natCast]
  nlinarith

theorem matrix_left_inverse_mulVec_k
    (P A : Matrix (Fin 2) (Fin 2) ℤ) (hPA : P*A=1) (w : Fin 2 → ℤ) :
    P.mulVec (A.mulVec w)=w := by
  calc
    P.mulVec (A.mulVec w)=(P*A).mulVec w := by
      first
      | rw [Matrix.mulVec_mulVec]
    _ = w := by rw [hPA,Matrix.one_mulVec]

