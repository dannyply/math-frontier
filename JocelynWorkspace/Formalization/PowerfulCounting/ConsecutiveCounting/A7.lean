    rw [Polynomial.eval₂_finsetSum, ← hsum0]
    refine Finset.sum_congr rfl (fun ij _ => ?_)
    simp only [Polynomial.eval₂_monomial, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
