  obtain ⟨Ch,hCh,hHeight⟩ :=
    FormalAB.S877de5f3.A5FixedDegreeFactorHeight.fixed_degree_factor_height N
  let K : ℝ := K0+1
  let X0 : ℝ := max Xa (max 8 Ch)
