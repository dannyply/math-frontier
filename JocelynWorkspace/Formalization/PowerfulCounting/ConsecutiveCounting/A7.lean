theorem large_length (C c δ x M W μ J l : ℝ)
    (hC:0<C) (hc:0<c) (hδ:0<δ) (hx:0<x) (hM:0<M) (hW:0<W)
    (hμ:0<μ) (hJ:μ≤J) (hl:0≤l)
    (hfloor:c*x^((1:ℝ)/7)≤M)
    (hcell:l*μ*J*M≤C*W) (hlarge:δ*W^4≤μ^7*x) :
    l^28*M^21*W^4≤(C^28/(δ^8*c^7))*x^7 := by
  have hroot : (x^((1:ℝ)/7))^7=x := by
    rw [← Real.rpow_natCast,← Real.rpow_mul hx.le]; norm_num
  have hM7 : c^7*x≤M^7 := by
    have hh := pow_le_pow_left₀ (by positivity : 0≤c*x^((1:ℝ)/7)) hfloor 7
    simpa only [mul_pow,hroot] using hh
  have hcell' : l*μ^2*M≤C*W := by
    have hh := mul_le_mul_of_nonneg_left hJ (by positivity : 0≤l*μ*M)
    nlinarith only [hh,hcell]
  have hcell7 := pow_le_pow_left₀ (by positivity : 0≤l*μ^2*M) hcell' 7
  have hlarge2 := pow_le_pow_left₀ (by positivity : 0≤δ*W^4) hlarge 2
  have haux : δ^2*l^7*M^7*W≤C^7*x^2 := by
    apply cancel _ _ (W^7) (by positivity)
    calc
      (δ^2*l^7*M^7*W)*W^7 = (l^7*M^7)*(δ^2*W^8) := by ring
      _ ≤ (l^7*M^7)*(μ^14*x^2) := by
        exact mul_le_mul_of_nonneg_left (by nlinarith only [hlarge2]) (by positivity)
      _ ≤ (C^7*x^2)*W^7 := by
        have hh := mul_le_mul_of_nonneg_right hcell7 (by positivity : 0≤x^2)
        nlinarith only [hh]
  have haux4 := pow_le_pow_left₀ (by positivity : 0≤δ^2*l^7*M^7*W) haux 4
  have hlast : δ^8*c^7*(l^28*M^21*W^4)≤C^28*x^7 := by
    apply cancel _ _ x hx
    have hh := mul_le_mul_of_nonneg_left hM7
      (by positivity : 0≤δ^8*l^28*M^21*W^4)
    nlinarith only [hh,haux4]
  have hh : l^28*M^21*W^4≤(C^28*x^7)/(δ^8*c^7) :=
    (le_div_iff₀ (by positivity : 0<δ^8*c^7)).mpr (by nlinarith only [hlast])
  convert hh using 1 <;> ring

theorem near_length (C x M W μ J T l : ℝ)
    (hC:0<C) (hx:0<x) (hM:0<M) (hW:0<W)
    (hμ:0<μ) (hJ:μ≤J) (hT:0<T) (hl:0≤l)
    (hcell:l*μ*J*M≤C*W)
    (hheight:l*J*W^3*T^4≤8*x*μ^7)
    (hscale:W≤327680000*T^7) :
    l^28*M^21*W^4≤((327680000:ℝ)^4*(8*C^3)^7)*x^7 := by
  have hJpos : 0<J := hμ.trans_le hJ
  have hcell3 := pow_le_pow_left₀ (by positivity : 0≤l*μ*J*M) hcell 3
  have hmul := mul_le_mul hcell3 hheight (by positivity) (by positivity)
  have h4 : l^4*M^3*T^4≤8*C^3*x := by
    apply cancel _ _ (μ^3*W^3*J^4) (by positivity)
    have hμ4 := pow_le_pow_left₀ hμ.le hJ 4
    have hh := mul_le_mul_of_nonneg_left hμ4
      (by positivity : 0≤8*C^3*x*μ^3*W^3)
    nlinarith only [hmul,hh]
  have h47 := pow_le_pow_left₀ (by positivity : 0≤l^4*M^3*T^4) h4 7
  have hscale4 := pow_le_pow_left₀ hW.le hscale 4
  have hh := mul_le_mul_of_nonneg_left hscale4
    (by positivity : 0≤l^28*M^21)
  nlinarith only [h47,hh]

theorem scale28 (x M W : ℝ) (hx:0<x) (hM:0<M) (hW:0<W) :
    (x^((1:ℝ)/4)/(M^((3:ℝ)/4)*W^((1:ℝ)/7)))^28*M^21*W^4=x^7 := by
  have hx28 : (x^((1:ℝ)/4))^28=x^7 := by
    rw [←Real.rpow_natCast,←Real.rpow_mul hx.le]; norm_num
  have hM28 : (M^((3:ℝ)/4))^28=M^21 := by
    rw [←Real.rpow_natCast,←Real.rpow_mul hM.le]; norm_num
  have hW28 : (W^((1:ℝ)/7))^28=W^4 := by
    rw [←Real.rpow_natCast,←Real.rpow_mul hW.le]; norm_num
  rw [div_pow,mul_pow,hx28,hM28,hW28]
  field_simp

theorem powered_price (A K B x M W l : ℝ)
    (hA:1≤A) (hKA:K≤A^28) (hBA:B≤A)
    (hx:0<x) (hM:0<M) (hW:0<W) (hl:0≤l)
    (hraw:l^28*M^21*W^4≤K*x^7 ∨ l≤B) :
    l≤A*(1+x^((1:ℝ)/4)/(M^((3:ℝ)/4)*W^((1:ℝ)/7))) := by
  let Z : ℝ := x^((1:ℝ)/4)/(M^((3:ℝ)/4)*W^((1:ℝ)/7))
  have hZ : 0≤Z := by dsimp [Z]; positivity
  have hAZ : 0≤A*Z := mul_nonneg (by linarith) hZ
  have hscale : Z^28*M^21*W^4=x^7 := scale28 x M W hx hM hW
  rcases hraw with hraw|hraw
  · have hh : l^28≤(A*Z)^28 := by
      apply cancel _ _ (M^21*W^4) (by positivity)
      calc
        l^28*(M^21*W^4) ≤ K*x^7 := by nlinarith only [hraw]
        _ ≤ A^28*x^7 := mul_le_mul_of_nonneg_right hKA (by positivity)
        _ = (A*Z)^28*(M^21*W^4) := by rw [←hscale]; ring
    have hh' := le_of_pow_le_pow_left₀ (by norm_num : (28:ℕ)≠0) hAZ hh
    change l≤A*(1+Z)
    nlinarith only [hh',hA]
  · change l≤A*(1+Z)
    nlinarith only [hraw,hBA,hAZ]
