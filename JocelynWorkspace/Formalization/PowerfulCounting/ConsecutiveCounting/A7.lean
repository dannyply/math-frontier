        ((M:ℝ)/(8*D)) (rho D E M j) (4*E) ed.P 0≤128*x := by
    nlinarith
  have hx1 : 1≤x := by linarith
  have hx7 : (128:ℝ)≤x^7 := by
    calc
      (128:ℝ)=(2:ℝ)^7 := by norm_num
      _ ≤ x^7 := pow_le_pow_left₀ (by norm_num) hx 7
  apply max_le (one_le_pow₀ hx1)
  exact hL.trans (by
    calc
      128*x≤x^7*x := mul_le_mul_of_nonneg_right hx7 (by linarith)
      _ = x^8 := by ring)

theorem hb2_cell_subpower_k (hHB2 : ActualHB2) (k : ℕ) (hk : 1 ≤ k)
    (a b K : ℕ) (ha : 1≤a) (hb : 2≤b) (hK : 1≤K) :
    ∀ ε : ℝ, 0<ε →
      ∃ C : ℝ, 0<C ∧
        ∀ (x D E : ℝ), 2≤x →
          (1/2:ℝ)≤D → (1/2:ℝ)≤E → D≤4*x → E≤4*x →
          ∀ G : MvPolynomial (Fin 4) ℤ,
            (∀ m∈G.support, m 0+m 1=a ∧ m 2+m 3=b) →
            Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G) →
            (∀ m : Fin 4 →₀ ℕ, |((G.coeff m:ℤ):ℝ)|≤x^K) →
            ∀ M j : ℕ, 1≤M → (M:ℝ)≤2*x → j∈cells D E M →
              ∀ h : ℤ, (h=1 ∨ h=-1) →
                ∀ ed :
                  FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.EllipseData
                    ((M:ℝ)/(8*D)) (rho D E M j) (4*E),
                let L : ℝ :=
                  FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.sideLength
                    ((M:ℝ)/(8*D)) (rho D E M j) (4*E) ed.P 0;
                let S : Set Point :=
                  {q | q∈cellK k x D E M j h ∧
                    MvPolynomial.eval ![(q.1.1:ℤ),(q.1.2:ℤ),
                      (q.2.1:ℤ),(q.2.2:ℤ)] G=0};
                S.Finite ∧ (S.ncard:ℝ)≤C*x^ε*(1+L) := by
  intro ε hε
  let d : ℕ := K+12*(a+b)
  let η : ℝ := ε/(8+(d:ℝ))
  have hden : (0:ℝ)<8+(d:ℝ) := by positivity
  have hη : 0<η := div_pos hε hden
  obtain ⟨C,hC,hraw⟩ := hb2_cell_bound_k hHB2 k hk a b ha hb η hη
  let Q : ℝ := FormalAB.Sbfeb2b3e.A1AuxTransport.coefficientConstant a b
  have hQ : 0<Q := by
    dsimp only [Q,FormalAB.Sbfeb2b3e.A1AuxTransport.coefficientConstant]
    positivity
  refine ⟨C*Q^η,mul_pos (by linarith) (Real.rpow_pos_of_pos hQ _),?_⟩
  intro x D E hx hD hE hD2 hE2 G hG hirr hcoeff M j hM hMup hj h hs ed
  dsimp only
  have hx0 : 0<x := by linarith
  have hx1 : 1≤x := by linarith
  have hD0 : 0<D := by linarith
  have hE0 : 0<E := by linarith
  let L : ℝ := FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.sideLength
    ((M:ℝ)/(8*D)) (rho D E M j) (4*E) ed.P 0
  let B : ℝ := max 1 L
  let R : ℝ := firstBasisRadius D E (rho D E M j) M
  let H' : ℝ := Q*x^K*R^(a+b)
  let S : Set Point :=
    {q | q∈cellK k x D E M j h ∧
      MvPolynomial.eval ![(q.1.1:ℤ),(q.1.2:ℤ),(q.2.1:ℤ),(q.2.2:ℤ)] G=0}
  have hL : 0<L := ed.hpos.trans_le ed.horder
  have hB1 : 1≤B := le_max_left _ _
  have hB0 : 0<B := by linarith
  have hR0 : 0≤R := by
    dsimp only [R,firstBasisRadius]
    positivity
  have hRcap : R≤x^12 := first_radius_polynomial_k x D E M j
    hx hD hE hD2 hE2 hM hMup hj
  have hBcap : B≤x^8 := first_length_polynomial_k x D E M j
    hx hD hE hD2 hE2 hM ed
  have hHcap : H'≤Q*x^d := by
    calc
      H'≤Q*x^K*(x^12)^(a+b) :=
        mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hR0 hRcap _)
          (mul_nonneg hQ.le (pow_nonneg hx0.le K))
      _ = Q*x^d := by
        rw [← pow_mul,mul_assoc,← pow_add]
  have hH0 : 0≤H' := by dsimp only [H']; positivity
  have hBp :
      B^(2/(b:ℝ)+η)≤B*x^(8*η) := by
    have hbR : (2:ℝ)≤b := by exact_mod_cast hb
    have hb0 : (0:ℝ)<b := by linarith
    have hf : 2/(b:ℝ)≤1 := (div_le_iff₀ hb0).mpr (by simpa using hbR)
    calc
      B^(2/(b:ℝ)+η)≤B^(1+η) :=
        Real.rpow_le_rpow_of_exponent_le hB1 (by linarith)
      _ = B*B^η := by rw [Real.rpow_add hB0,Real.rpow_one]
      _ ≤ B*(x^8)^η :=
        mul_le_mul_of_nonneg_left (Real.rpow_le_rpow hB0.le hBcap hη.le) hB0.le
      _ = B*x^(8*η) := by
        rw [← Real.rpow_natCast x 8,← Real.rpow_mul hx0.le]
        norm_num
  have hHp : H'^η≤Q^η*x^((d:ℝ)*η) := by
    calc
      H'^η≤(Q*x^d)^η := Real.rpow_le_rpow hH0 hHcap hη.le
      _ = Q^η*(x^d)^η := Real.mul_rpow hQ.le (pow_nonneg hx0.le d)
      _ = Q^η*x^((d:ℝ)*η) := by
        rw [← Real.rpow_natCast x d,← Real.rpow_mul hx0.le]
  have hηeq : 8*η+(d:ℝ)*η=ε := by
    dsimp only [η]
    field_simp [hden.ne']

  have hxpow : x^(8*η)*x^((d:ℝ)*η)=x^ε := by
    rw [← Real.rpow_add hx0,hηeq]
  have hbnd := hraw x D E (x^K) hD0 hE0 (one_le_pow₀ hx1)
    G hG hirr hcoeff M j hM hj h hs ed
  refine ⟨hbnd.1,?_⟩
  calc
    (S.ncard:ℝ)≤C*B^(2/(b:ℝ)+η)*H'^η := hbnd.2
    _ ≤ C*(B*x^(8*η))*(Q^η*x^((d:ℝ)*η)) := by
      apply mul_le_mul
      · exact mul_le_mul_of_nonneg_left hBp (by linarith)
      · exact hHp
      · exact Real.rpow_nonneg hH0 _
      · positivity
    _ = (C*Q^η)*x^ε*B := by
      calc
        _ = (C*Q^η)*B*(x^(8*η)*x^((d:ℝ)*η)) := by ring
        _ = _ := by rw [hxpow]; ring
    _ ≤ (C*Q^η)*x^ε*(1+L) := by
      apply mul_le_mul_of_nonneg_left
      · exact max_le (by linarith) (by linarith)
      · positivity

def geometricCellEstimateK (k a b K : ℕ) (ε C : ℝ) : Prop :=
  ∀ (x D E : ℝ), 2≤x →
    (1/2:ℝ)≤D → (1/2:ℝ)≤E → D≤4*x → E≤4*x →
    ∀ G : MvPolynomial (Fin 4) ℤ,
      (∀ m∈G.support, m 0+m 1=a ∧ m 2+m 3=b) →
      Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G) →
      (∀ m : Fin 4 →₀ ℕ, |((G.coeff m:ℤ):ℝ)|≤x^K) →
      ∀ M j : ℕ, 1≤M → (M:ℝ)≤2*x → j∈cells D E M →
        ∀ h : ℤ, (h=1 ∨ h=-1) →
          ∀ ed :
            FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.EllipseData
              ((M:ℝ)/(8*D)) (rho D E M j) (4*E),
            let S : Set Point :=
              {q | q∈cellK k x D E M j h ∧
                MvPolynomial.eval ![(q.1.1:ℤ),(q.1.2:ℤ),
                  (q.2.1:ℤ),(q.2.2:ℤ)] G=0};
            S.Finite ∧ (S.ncard:ℝ)≤C*x^ε*
              (1+FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.sideLength
                ((M:ℝ)/(8*D)) (rho D E M j) (4*E) ed.P 0)

theorem geometric_uniform_k (hHB2 : ActualHB2) (k : ℕ) (hk : 1 ≤ k) (Q : ℕ)
    (K : ℕ) (hK : 1≤K) (ε : ℝ) (hε : 0<ε) :
    ∃ C : ℝ, 0<C ∧
      ∀ a b : ℕ, 1≤a → a≤Q → 1≤b → b≤Q →
        geometricCellEstimateK k a b K ε C := by
  classical
  have hex : ∀ ab : Fin (Q+1) × Fin (Q+1), ∃ C : ℝ, 0<C ∧
      (1≤ab.1.val → 1≤ab.2.val →
        geometricCellEstimateK k ab.1.val ab.2.val K ε C) := by
    intro ab
    by_cases ha : 1≤ab.1.val
    · by_cases hb : 1≤ab.2.val
      · by_cases hb1 : ab.2.val=1
        · obtain ⟨C,hC,hbound⟩ :=
            beta_one_cell_subpower_k k hk ab.1.val K ha hK ε hε
          refine ⟨C,hC,?_⟩
          intro _ _ x D E hx hD hE hD2 hE2 G hG hirr hcoeff
            M j hM hMup hj h hs ed
          have hG' : ∀ m∈G.support,
              m 0+m 1=ab.1.val ∧ m 2+m 3=1 := by
            simpa only [hb1] using hG
          exact hbound x hx G hG' hirr hcoeff D E
            (by linarith) (by linarith) M j hM hj h hs ed
        · have hb2 : 2≤ab.2.val := by omega
          obtain ⟨C,hC,hbound⟩ :=
            hb2_cell_subpower_k hHB2 k hk ab.1.val ab.2.val K ha hb2 hK ε hε
          exact ⟨C,hC,fun _ _ => hbound⟩
      · exact ⟨1,by norm_num,fun _ hb' => False.elim (hb hb')⟩
    · exact ⟨1,by norm_num,fun ha' _ => False.elim (ha ha')⟩
  choose Cs hCs hbound using hex
  let C : ℝ := 1+∑ ab : Fin (Q+1) × Fin (Q+1), Cs ab
  have hsum : 0≤∑ ab : Fin (Q+1) × Fin (Q+1), Cs ab :=
    Finset.sum_nonneg (fun ab _ => (hCs ab).le)
  refine ⟨C,by dsimp only [C]; linarith,?_⟩
  intro a b ha ha96 hb hb96
  let ab : Fin (Q+1) × Fin (Q+1) := (⟨a,by omega⟩,⟨b,by omega⟩)
  have hsmall : Cs ab≤C := by
    have hh : Cs ab≤∑ cd : Fin (Q+1) × Fin (Q+1), Cs cd :=
      Finset.single_le_sum (fun cd _ => (hCs cd).le) (Finset.mem_univ ab)
    dsimp only [C]
    linarith
  have hlocal := hbound ab ha hb
  intro x D E hx hD hE hD2 hE2 G hG hirr hcoeff M j hM hMup hj h hs ed
  obtain ⟨hfin,hcard⟩ :=
    hlocal x D E hx hD hE hD2 hE2 G hG hirr hcoeff M j hM hMup hj h hs ed
  refine ⟨hfin,hcard.trans ?_⟩
  have hL : 0<
      FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.sideLength
        ((M:ℝ)/(8*D)) (rho D E M j) (4*E) ed.P 0 :=
    ed.hpos.trans_le ed.horder
  exact mul_le_mul_of_nonneg_right
    (mul_le_mul_of_nonneg_right hsmall (Real.rpow_nonneg (by linarith) ε))
    (by linarith)

end OSKPrivate

namespace OSKPrivate
open scoped BigOperators

def factorPointsK (k : ℕ) (x D E : ℝ) (M j : ℕ) (h : ℤ)
    (G : MvPolynomial (Fin 4) ℤ) : Set Point :=
  {q | q∈cellK k x D E M j h ∧
    MvPolynomial.eval ![(q.1.1:ℤ),(q.1.2:ℤ),(q.2.1:ℤ),(q.2.2:ℤ)] G=0}

theorem factor_points_finite_k (k : ℕ) (hk : 1 ≤ k) (x D E : ℝ)
    (M j : ℕ) (h : ℤ) (hs : h=1 ∨ h=-1)
    (G : MvPolynomial (Fin 4) ℤ) :
    (factorPointsK k x D E M j h G).Finite :=
  (box_finite_k k hk x D E h hs).subset (fun _ hq => hq.1.1)

def badFactorCostK (k : ℕ) (x D E : ℝ) (M j : ℕ) (h : ℤ)
    (G : MvPolynomial (Fin 4) ℤ) (a b : ℕ) : ℝ := by
  classical
  exact if 2≤a ∧ 2≤b ∧ ¬Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G)
  then ((factorPointsK k x D E M j h G).ncard:ℝ) else 0

theorem bad_factor_cost_nonneg_k (k : ℕ) (x D E : ℝ)
    (M j : ℕ) (h : ℤ) (G : MvPolynomial (Fin 4) ℤ) (a b : ℕ) :
    0≤badFactorCostK k x D E M j h G a b := by
  classical
  unfold badFactorCostK
  split_ifs <;> positivity

theorem all_factor_cases_bound_k (hHB2 : ActualHB2) (k : ℕ) (hk : 1 ≤ k) (Q : ℕ)
    (K : ℕ) (hK : 1≤K) (ε : ℝ) (hε : 0<ε) :
    ∃ C : ℝ, 0<C ∧
      ∀ (x D E : ℝ), 2≤x →
        (1/2:ℝ)≤D → (1/2:ℝ)≤E → D≤4*x → E≤4*x →
        x≤(D*E)^k →
        ∀ G : MvPolynomial (Fin 4) ℤ, ∀ a b : ℕ,
          a≤Q → b≤Q →
          (∀ m∈G.support, m 0+m 1=a ∧ m 2+m 3=b) →
          (∀ m : Fin 4 →₀ ℕ, |((G.coeff m:ℤ):ℝ)|≤x^K) →
          ActualFactorClass G a b →
          ∀ M j : ℕ, 1≤M → (M:ℝ)≤2*x → j∈cells D E M →
            ∀ h : ℤ, (h=1 ∨ h=-1) →
              ∀ ed :
                FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.EllipseData
                  ((M:ℝ)/(8*D)) (rho D E M j) (4*E),
                ((factorPointsK k x D E M j h G).ncard:ℝ)≤
                  C*x^ε*
                    (1+FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.sideLength
                      ((M:ℝ)/(8*D)) (rho D E M j) (4*E) ed.P 0)+
                  badFactorCostK k x D E M j h G a b := by
  classical
  obtain ⟨Cg,hCg,hgeom⟩ := geometric_uniform_k hHB2 k hk Q K hK ε hε
  let C : ℝ := ((4^k+1 : ℕ):ℝ)+Cg+6*(k:ℝ)
  have hC : 0<C := by dsimp only [C]; positivity
  refine ⟨C,hC,?_⟩
  intro x D E hx hD hE hD2 hE2 hprod G a b haQ hbQ hG hcoeff hclass
    M j hM hMup hj h hs ed
  let L : ℝ := FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.sideLength
    ((M:ℝ)/(8*D)) (rho D E M j) (4*E) ed.P 0
  let B : ℝ := C*x^ε*(1+L)
  have hx0 : 0<x := by linarith
  have hx1 : 1≤x := by linarith
  have hxpow : 1≤x^ε := Real.one_le_rpow hx1 hε.le
  have hL : 0<L := ed.hpos.trans_le ed.horder
  have hB : 0≤B := by dsimp only [B]; positivity
  have hbad := bad_factor_cost_nonneg_k k x D E M j h G a b
  have hD0 : 0<D := by linarith
  have hE0 : 0<E := by linarith
  have h4n : (0:ℝ)≤((4^k+1 : ℕ):ℝ) := Nat.cast_nonneg _
  have h6n : (0:ℝ)≤6*(k:ℝ) := by positivity
  have hcg : Cg≤C := by
    dsimp only [C]
    linarith
  have hCB : C*(1+L)≤B := by
    have hh := mul_le_mul_of_nonneg_left hxpow (by positivity : 0≤C*(1+L))
    dsimp only [B]
    nlinarith
  have h4k : ((4^k+1 : ℕ):ℝ)≤B := by
    have h1 : ((4^k+1 : ℕ):ℝ)≤C := by
      dsimp only [C]
      linarith
    have h2 : C≤C*(1+L) := by nlinarith
    linarith
  have h6k : 6*(k:ℝ)*(1+L)≤B := by
    have h1 : 6*(k:ℝ)≤C := by
      dsimp only [C]
      linarith
    have h2 : 6*(k:ℝ)*(1+L)≤C*(1+L) := mul_le_mul_of_nonneg_right h1 (by linarith)
    linarith
  have hgeomcase (ha : 1≤a) (hb : 1≤b)
      (hirr : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G)) :
      ((factorPointsK k x D E M j h G).ncard:ℝ)≤B := by
    have hh := (hgeom a b ha haQ hb hbQ)
      x D E hx hD hE hD2 hE2 G hG hirr hcoeff M j hM hMup hj h hs ed
    exact hh.2.trans (mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_right hcg (Real.rpow_nonneg hx0.le ε)) (by linarith))
  rcases hclass with hzero | hzero | hline | hline | hgeo | hrational
  · obtain ⟨hb,ha,hvan⟩ := hzero
    have hempty : factorPointsK k x D E M j h G=∅ := by
      ext q
      constructor
      · intro hq
        have hz := hvan ![(q.1.1:ℤ),(q.1.2:ℤ),(q.2.1:ℤ),(q.2.2:ℤ)] hq.2
        have hd0 : (q.1.1:ℤ)=0 := by simpa using hz.1
        have hd : 1≤q.1.1 := hq.1.1.1
        have : q.1.1=0 := by exact_mod_cast hd0
        omega
      · intro hq
        exact False.elim hq
    rw [hempty]
    simp only [Set.ncard_empty,Nat.cast_zero]
    exact add_nonneg hB hbad
  · obtain ⟨ha,hb,hvan⟩ := hzero
    have hempty : factorPointsK k x D E M j h G=∅ := by
      ext q
      constructor
      · intro hq
        have hz := hvan ![(q.1.1:ℤ),(q.1.2:ℤ),(q.2.1:ℤ),(q.2.2:ℤ)] hq.2
        have hu0 : (q.2.1:ℤ)=0 := by simpa using hz.1
        have hu : 1≤q.2.1 := hq.1.1.2.2.1
        have : q.2.1=0 := by exact_mod_cast hu0
        omega
      · intro hq
        exact False.elim hq
    rw [hempty]
    simp only [Set.ncard_empty,Nat.cast_zero]
    exact add_nonneg hB hbad
  · obtain ⟨hab,p,r,hpr,hline⟩ := hline
    have heq : factorPointsK k x D E M j h G=
        {q : Point | q∈cellK k x D E M j h ∧
          p*(q.1.1:ℤ)+r*(q.1.2:ℤ)=0} := by
      ext q
      simp [factorPointsK,hline]
    have hcount := first_linear_axis_count_k k hk
      x D E M j h p r hD0 hE0 hs hpr hprod
    rw [heq]
    have hh : (({q : Point | q∈cellK k x D E M j h ∧
        p*(q.1.1:ℤ)+r*(q.1.2:ℤ)=0}).ncard:ℝ)≤((4^k+1 : ℕ):ℝ) := by
      exact_mod_cast hcount.2
    exact hh.trans (h4k.trans (le_add_of_nonneg_right hbad))
  · obtain ⟨hab,p,r,hpr,hline⟩ := hline
    have heq : factorPointsK k x D E M j h G=
        {q : Point | q∈cellK k x D E M j h ∧
          p*(q.2.1:ℤ)+r*(q.2.2:ℤ)=0} := by
      ext q
      simp [factorPointsK,hline]
    have hh := (second_linear_axis_count_k k hk x D E M j h p r hD0 hE0 hM hj hs hpr ed).2
    rw [heq]
    exact hh.trans (h6k.trans (le_add_of_nonneg_right hbad))
  · exact (hgeomcase hgeo.1 hgeo.2.1 hgeo.2.2.2).trans
      (le_add_of_nonneg_right hbad)
  · by_cases hirr : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G)
    · exact (hgeomcase (by omega) (by omega) hirr).trans
        (le_add_of_nonneg_right hbad)
    · have htest : 2≤a ∧ 2≤b ∧
          ¬Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G) :=
        ⟨hrational.1,hrational.2.1,hirr⟩
      simp only [badFactorCostK,if_pos htest]
      exact le_add_of_nonneg_left hB

def NGKStmt : Prop := ∀ k : ℕ, 1 ≤ k → ∀ D : ℕ, 1 ≤ D → ∃ C_D : ℝ, 1 ≤ C_D ∧ ∀ α β : ℕ, 1 ≤ α + β → α + β ≤ D → ∀ G : MvPolynomial (Fin 4) ℤ, (∀ m ∈ G.support, m 0 + m 1 = α ∧ m 2 + m 3 = β) → Irreducible G → ¬ Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G) → ∀ h : ℤ, (h = 1 ∨ h = -1) → let S : Set ((ℕ × ℕ) × (ℕ × ℕ)) := {z | 1 ≤ z.1.1 ∧ 1 ≤ z.1.2 ∧ 1 ≤ z.2.1 ∧ 1 ≤ z.2.2 ∧ ((z.1.2 ^ k * z.2.2 : ℕ) : ℤ) = ((z.1.1 ^ k * z.2.1 : ℕ) : ℤ) + h ∧ MvPolynomial.eval ![(z.1.1 : ℤ), (z.1.2 : ℤ), (z.2.1 : ℤ), (z.2.2 : ℤ)] G = 0}; S.Finite ∧ (S.ncard : ℝ) ≤ C_D

def nongeometricOriginalPopulationK (k : ℕ) (G : MvPolynomial (Fin 4) ℤ)
    (h : ℤ) : Set Point :=
  {q | 1≤q.1.1 ∧ 1≤q.1.2 ∧ 1≤q.2.1 ∧ 1≤q.2.2 ∧
    ((q.1.2^k*q.2.2:ℕ):ℤ)=((q.1.1^k*q.2.1:ℕ):ℤ)+h ∧
    MvPolynomial.eval ![(q.1.1:ℤ),(q.1.2:ℤ),(q.2.1:ℤ),(q.2.2:ℤ)] G=0}

theorem factor_original_incidence_k (k : ℕ) (x D E : ℝ)
    (M j : ℕ) (h : ℤ) (G : MvPolynomial (Fin 4) ℤ) :
    factorPointsK k x D E M j h G⊆nongeometricOriginalPopulationK k G h := by
  intro q hq
  rcases hq.1.1 with ⟨hd,he,hu,hv,hshift,-,-,-,-,-,-⟩
  exact ⟨hd,he,hu,hv,hshift,hq.2⟩

theorem nongeometric_factor_uniform_k (hNG : NGKStmt) (k : ℕ) (hk : 1 ≤ k) (Q : ℕ) (hQ : 1 ≤ Q) :
    ∃ C : ℝ, 1≤C ∧
      ∀ a b : ℕ, 1≤a+b → a+b≤Q →
        ∀ G : MvPolynomial (Fin 4) ℤ,
          (∀ m∈G.support, m 0+m 1=a ∧ m 2+m 3=b) →
          Irreducible G →
          ¬Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G) →
          ∀ (x D E : ℝ) (M j : ℕ) (h : ℤ), (h=1 ∨ h=-1) →
            ((factorPointsK k x D E M j h G).ncard:ℝ)≤C := by
  obtain ⟨C,hC,hcount⟩ := hNG k hk Q hQ
  refine ⟨C,hC,?_⟩
  intro a b hab habQ G hG hirr hnongeom x D E M j h hs
  have hb := hcount a b hab habQ G hG hirr hnongeom h hs
  change (nongeometricOriginalPopulationK k G h).Finite ∧
    ((nongeometricOriginalPopulationK k G h).ncard:ℝ)≤C at hb
  exact (show ((factorPointsK k x D E M j h G).ncard:ℝ)≤
      ((nongeometricOriginalPopulationK k G h).ncard:ℝ) by
    exact_mod_cast Set.ncard_le_ncard
      (factor_original_incidence_k k x D E M j h G) hb.1).trans hb.2

theorem occupied_length_k (k : ℕ) (x D E : ℝ) (M j : ℕ) (h : ℤ)
    (hD : 0<D) (hE : 0<E) (hM : 1≤M) (hj : j∈cells D E M)
    (ed : FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.EllipseData
      ((M:ℝ)/(8*D)) (rho D E M j) (4*E))
    (hne : (cellK k x D E M j h).Nonempty) :
    1≤FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.sideLength
      ((M:ℝ)/(8*D)) (rho D E M j) (4*E) ed.P 0 := by
  obtain ⟨q,hq⟩ := hne
  let v : Fin 2 → ℤ := ![(q.1.1:ℤ),(q.1.2:ℤ)]
  let w : Fin 2 → ℤ := ed.A.mulVec v
  have hcover := ed.hcover ((q.1.1:ℤ),(q.1.2:ℤ))
    (first_ellipse_k k x D E M j h hD hE hM hj q hq)
  have hrecover : ed.P.mulVec w=v :=
    matrix_left_inverse_mulVec ed.P ed.A ed.hPA v
  have hw : w 0≠0 ∨ w 1≠0 := by
    by_contra hn
    push Not at hn
    have hwzero : w=0 := by
      funext i
      fin_cases i
      · exact hn.1
      · exact hn.2
    have hvzero : v=0 := by
      rw [hwzero,Matrix.mulVec_zero] at hrecover
      exact hrecover.symm
    have hd0 : (q.1.1:ℤ)=0 := by
      simpa only [v,Matrix.cons_val_zero,Pi.zero_apply] using congrFun hvzero 0
    have hd : 1≤q.1.1 := hq.1.1
    have : q.1.1=0 := by exact_mod_cast hd0
    omega
  have habsone (z : ℤ) (hz : z≠0) : (1:ℝ)≤|(z:ℝ)| := by
    have hn : 1≤z.natAbs := Nat.one_le_iff_ne_zero.mpr (Int.natAbs_ne_zero.mpr hz)
    have hh : (1:ℝ)≤(z.natAbs:ℝ) := by exact_mod_cast hn
    rwa [← Int.cast_natCast,Int.natCast_natAbs,Int.cast_abs] at hh
  rcases hw with hw | hw
