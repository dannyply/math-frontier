    have hgNat : g∣h.natAbs := Int.natCast_dvd.mp hgd
    have hgj : g∈h.natAbs.divisors.filter (fun g=>g≠0) :=
      Finset.mem_filter.mpr ⟨Nat.mem_divisors.mpr ⟨hgNat,Int.natAbs_ne_zero.mpr hh⟩,hg⟩
    have hhj : h0∈(signedDivisors h).filter (fun h0=>h0≠0 ∧ h0∣h) :=
      Finset.mem_filter.mpr ⟨mem_signedDivisors h h0 hh hh0d,hh0,hh0d⟩
