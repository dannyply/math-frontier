private theorem norm_cover_subpower (A L : ℝ) (hA : 1≤A) (hL : 0≤L)
    (epsilon : ℝ) (hepsilon : 0<epsilon) :
    ∃C:ℝ,0<C ∧ ∀x:ℝ,2≤x → ∀Delta:ℕ,0<Delta → ∀h:ℤ,h≠0 →
      ∀Z:ℕ,1≤Z → |(h:ℝ)|≤A*x^L →
      (((Delta+1:ℕ):ℝ)*(Z:ℝ))≤A*x^L →
      ∃T:Finset (ℤ×ℤ),
        (∀X Y:ℤ,X.natAbs≤Z → Y.natAbs≤Z →
          X^2-(Delta:ℤ)*Y^2=h → (X,Y)∈T) ∧ (T.card:ℝ)≤C*x^epsilon := by
  let delta : ℝ := epsilon/(4*L+1)
  have hden : 0<4*L+1 := by linarith
  have hd : 0<delta := div_pos hepsilon hden
  have hdeq : delta*(4*L+1)=epsilon := div_mul_cancel₀ _ (ne_of_gt hden)
  have hexp : 4*L*delta≤epsilon := by nlinarith
  obtain ⟨Cd,hCd,hdivisor⟩ := C01.PcLowdegRed.divisor_bound delta hd
  let C : ℝ := 16*Cd^3*(6+24/delta)*A^(4*delta)+1
  have hA0 : 0<A := by linarith
  have hfee : 0<6+24/delta := by positivity
  refine ⟨C,by dsimp [C]; positivity,?_⟩
  intro x hx Delta hDelta h hh Z hZ hhbound hYbound
