theorem claim_4c2b196a016c52b852dda99410f77a1ab6639d07014101098ac67ee864b1837e :
∀ (p n : ℕ) (F : Polynomial ℤ) (x y : ℤ),
  p.Prime →
  (p : ℤ) ∣ x - y →
  ¬ (p : ℤ) ∣ F.derivative.eval x →
  (p : ℤ) ^ n ∣ F.eval x - F.eval y →
  (p : ℤ) ^ n ∣ x - y := by
  classical
  intro p n F x y hp hxy hder hval
  have hdivF :
      (Polynomial.X - Polynomial.C x : Polynomial ℤ) ∣
        F - Polynomial.C (F.eval x) := by
    apply Polynomial.dvd_iff_isRoot.mpr
    simp [Polynomial.IsRoot]
  obtain ⟨Q, hfactor⟩ := hdivF
  have hQx : Q.eval x = F.derivative.eval x := by
    have hd := congrArg
      (fun G : Polynomial ℤ => G.derivative.eval x) hfactor
    simpa [Polynomial.derivative_sub, Polynomial.derivative_mul] using hd.symm
  have hyfactor :
      F.eval y - F.eval x = (y - x) * Q.eval y := by
    simpa using congrArg (Polynomial.eval y) hfactor
  have hdivQ :
      (Polynomial.X - Polynomial.C x : Polynomial ℤ) ∣
        Q - Polynomial.C (Q.eval x) := by
    apply Polynomial.dvd_iff_isRoot.mpr
    simp [Polynomial.IsRoot]
  obtain ⟨R, hfactorQ⟩ := hdivQ
  have hyfactorQ :
      Q.eval y - Q.eval x = (y - x) * R.eval y := by
    simpa using congrArg (Polynomial.eval y) hfactorQ
  have hdivdiff : (p : ℤ) ∣ Q.eval y - Q.eval x := by
    obtain ⟨t, ht⟩ := hxy
    refine ⟨-t * R.eval y, ?_⟩
    rw [hyfactorQ, show y - x = -(x - y) by ring, ht]
    ring
  have hunit : ¬ (p : ℤ) ∣ Q.eval y := by
    intro hU
    apply hder
    rw [← hQx]
    have hsub := dvd_sub hU hdivdiff
    have heq : Q.eval y - (Q.eval y - Q.eval x) = Q.eval x := by ring
    rw [heq] at hsub
    exact hsub
  have hnum :
      F.eval x - F.eval y = (x - y) * Q.eval y := by
    calc
      F.eval x - F.eval y = -(F.eval y - F.eval x) := by ring
      _ = -((y - x) * Q.eval y) := by rw [hyfactor]
      _ = (x - y) * Q.eval y := by ring
  rw [hnum] at hval
  have hnoNat : ¬ p ∣ (Q.eval y).natAbs := by
    intro hd
    apply hunit
    apply (Int.natAbs_dvd_natAbs).1
    simpa using hd
  have hcop0 : Nat.Coprime p (Q.eval y).natAbs :=
    (Nat.Prime.coprime_iff_not_dvd hp).mpr hnoNat
  have hcop : Nat.Coprime (p ^ n) (Q.eval y).natAbs := by
    simpa using Nat.Coprime.pow n 1 hcop0
  have hnat :
      p ^ n ∣ (Q.eval y).natAbs * (x - y).natAbs := by
    have hd := (Int.natAbs_dvd_natAbs).2 hval
    simpa [Int.natAbs_mul, Int.natAbs_pow, Nat.mul_comm] using hd
  have hfinal : p ^ n ∣ (x - y).natAbs :=
    hcop.dvd_of_dvd_mul_left hnat
  apply (Int.natAbs_dvd_natAbs).1
  simpa using hfinal

end JocelynClaims

