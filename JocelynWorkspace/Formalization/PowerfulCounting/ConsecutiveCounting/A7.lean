noncomputable def rho (D E : ℝ) (M j : ℕ) : ℝ :=
  D / (2 * E) * (1 + 1 / (M : ℝ)) ^ j

def indices (D E : ℝ) (M : ℕ) : Set ℕ :=
  {j | D / (2 * E) ≤ rho D E M j ∧ rho D E M j ≤ 2 * D / E}

def relativeCell (D E : ℝ) (M j : ℕ) : Set ℝ :=
  Set.Ioc (rho D E M j) (rho D E M j * (1 + 1 / (M : ℝ)))

lemma unique_interval (a r s : ℝ) (ha : 0 < a) (hr : 1 < r) (has : a < s) :
    ∃! j : ℕ, a * r ^ j < s ∧ s ≤ a * r ^ (j + 1) := by
  have hex : ∃ k : ℕ, s ≤ a * r ^ k := by
    obtain ⟨k, hk⟩ := pow_unbounded_of_one_lt (s / a) hr
    refine ⟨k, ?_⟩
    have hh := (div_lt_iff₀ ha).mp hk
    exact (by simpa [mul_comm] using hh.le)
  let k := Nat.find hex
  have hk : s ≤ a * r ^ k := Nat.find_spec hex
  have hkpos : 0 < k := by
    by_contra hn
    have hkzero : k = 0 := by omega
    rw [hkzero, pow_zero, mul_one] at hk
    exact (not_le_of_gt has) hk
  have hlow : a * r ^ (k - 1) < s := by
    have hh := Nat.find_min hex (show k - 1 < Nat.find hex by dsimp [k] at *; omega)
    exact lt_of_not_ge hh
  have hupp : s ≤ a * r ^ (k - 1 + 1) := by
    simpa [Nat.sub_add_cancel hkpos] using hk
  refine ⟨k - 1, ⟨hlow, hupp⟩, ?_⟩
  intro j hj
  rcases lt_trichotomy j (k - 1) with hlt | heq | hgt
  · have hle : j + 1 ≤ k - 1 := by omega
    have hh := mul_le_mul_of_nonneg_left (pow_le_pow_right₀ hr.le hle) ha.le
    exact False.elim ((not_lt_of_ge (hj.2.trans hh)) hlow)
  · exact heq
  · have hle : k - 1 + 1 ≤ j := by omega
    have hh := mul_le_mul_of_nonneg_left (pow_le_pow_right₀ hr.le hle) ha.le
    exact False.elim ((not_lt_of_ge (hupp.trans hh)) hj.1)

theorem main :
  ∀ D E : ℝ, 0 < D → 0 < E →
    ∀ M : ℕ, 1 ≤ M →
      (∀ s : ℝ, D / (2 * E) < s → s < 2 * D / E →
        ∃! j : ℕ, j ∈ indices D E M ∧ s ∈ relativeCell D E M j) ∧
      (∀ j ∈ indices D E M, ∀ s ∈ relativeCell D E M j,
        |s - rho D E M j| ≤ 2 * D / (E * (M : ℝ))) := by
  intro D E hD hE M hM
  have hM0 : (0 : ℝ) < M := by exact_mod_cast (show 0 < M by omega)
  let a : ℝ := D / (2 * E)
  let r : ℝ := 1 + 1 / (M : ℝ)
  have ha : 0 < a := by dsimp [a]; positivity
  have hr : 1 < r := by
    dsimp [r]
    have hh : (0 : ℝ) < 1 / (M : ℝ) := by positivity
    linarith
  refine ⟨?_, ?_⟩
  · intro s hslo hshi
    obtain ⟨j, hj, hunique⟩ := unique_interval a r s ha hr hslo
    have hjJ : j ∈ indices D E M := by
      change a ≤ a * r ^ j ∧ a * r ^ j ≤ 2 * D / E
      constructor
      · simpa using mul_le_mul_of_nonneg_left (one_le_pow₀ hr.le) ha.le
      · exact hj.1.le.trans hshi.le
    have hjcell : s ∈ relativeCell D E M j := by
      change a * r ^ j < s ∧ s ≤ a * r ^ j * r
      simpa [pow_succ, mul_assoc] using hj
    refine ⟨j, ⟨hjJ, hjcell⟩, ?_⟩
    intro l hl
    apply hunique l
    have hh := hl.2
    change a * r ^ l < s ∧ s ≤ a * r ^ l * r at hh
    simpa [pow_succ, mul_assoc] using hh
  · intro j hj s hs
    have hcenter : rho D E M j ≤ 2 * D / E := hj.2
    have hslow : rho D E M j < s := hs.1
    have hsupp : s ≤ rho D E M j * (1 + 1 / (M : ℝ)) := hs.2
    rw [abs_of_pos (sub_pos.mpr hslow)]
    calc
      s - rho D E M j ≤ rho D E M j / (M : ℝ) := by
        rw [mul_add, mul_one, mul_one_div] at hsupp
        linarith
      _ ≤ (2 * D / E) / (M : ℝ) := div_le_div_of_nonneg_right hcenter hM0.le
      _ = 2 * D / (E * (M : ℝ)) := by rw [div_div]

