    linear_combination (-1) * hm4 + (6) * hm3 + (-14) * hm2 + (14) * hm1 + (-14) * h1 + (14) * h2 + (-6) * h3 + (1) * h4
  have hc8 : 40320 * ((q04) - (c*b^8)) = 0 := by
    linear_combination (1) * hm4 + (-8) * hm3 + (28) * hm2 + (-56) * hm1 + (70) * h0 + (-56) * h1 + (28) * h2 + (-8) * h3 + (1) * h4
  constructor
  · nlinarith only [hc0]
  constructor
  · nlinarith only [hc1]
  constructor
  · nlinarith only [hc2]
  constructor
  · nlinarith only [hc3]
