namespace A7PureNineSignedLevel

private noncomputable def bandU (z : ℝ) : ℝ :=
  -35 + 84 * z - 70 * z ^ 2 + 20 * z ^ 3

private noncomputable def bandG (z : ℝ) : ℝ := z ^ 4 * (1 - z) ^ 4

private noncomputable def bandF (κ lam z : ℝ) : ℝ :=
  z ^ 4 * bandU z + (κ + lam * z) * bandG z

private noncomputable def bandF1 (κ lam z : ℝ) : ℝ :=
  4 * z ^ 3 * bandU z +
  z ^ 4 * (84 - 140 * z + 60 * z ^ 2) +
  lam * bandG z +
  (κ + lam * z) * (4 * z ^ 3 * (1 - z) ^ 3 * (1 - 2 * z))

private noncomputable def bandF2 (κ lam z : ℝ) : ℝ :=
  12 * z ^ 2 * bandU z +
  8 * z ^ 3 * (84 - 140 * z + 60 * z ^ 2) +
  z ^ 4 * (-140 + 120 * z) +
  2 * lam * (4 * z ^ 3 * (1 - z) ^ 3 * (1 - 2 * z)) +
  (κ + lam * z) *
    (12 * z ^ 2 * (1 - z) ^ 3 * (1 - 2 * z) -
     12 * z ^ 3 * (1 - z) ^ 2 * (1 - 2 * z) -
     8 * z ^ 3 * (1 - z) ^ 3)

private noncomputable def bandg (z : ℝ) : ℝ := 4 / z - 4 / (1 - z)
private noncomputable def bandg1 (z : ℝ) : ℝ := -4 / z ^ 2 - 4 / (1 - z) ^ 2
private noncomputable def bandr1 (z : ℝ) : ℝ :=
  (-56 + 112 * z - 80 * z ^ 2 + 20 * z ^ 3) / (1 - z) ^ 5
private noncomputable def bandr2 (z : ℝ) : ℝ :=
  (-168 + 288 * z - 180 * z ^ 2 + 40 * z ^ 3) / (1 - z) ^ 6

private theorem band_F1_is_deriv (κ lam z : ℝ) :
    deriv (bandF κ lam) z = bandF1 κ lam z := by
  change deriv (fun t : ℝ =>
    t ^ 4 * (-35 + 84 * t - 70 * t ^ 2 + 20 * t ^ 3) +
      (κ + lam * t) * (t ^ 4 * (1 - t) ^ 4)) z = bandF1 κ lam z
  simpa only [bandF1, bandU, bandG] using private_height_F_deriv κ lam z

private theorem band_ODE (κ lam z : ℝ) (hz0 : z ≠ 0) (hz1 : z ≠ 1) :
    bandF1 κ lam z =
      bandg z * bandF κ lam z +
        bandG z * (lam + bandr1 z) ∧
    bandF2 κ lam z -
        2 * bandg z * bandF1 κ lam z +
          ((bandg z) ^ 2 - bandg1 z) * bandF κ lam z =
      bandG z * bandr2 z := by
  have hr1 :
      ((84 - 140 * z + 60 * z ^ 2) * (1 - z) +
          4 * (-35 + 84 * z - 70 * z ^ 2 + 20 * z ^ 3)) /
        (1 - z) ^ 5 = bandr1 z := by
    unfold bandr1
    congr 1
    ring
  have hr2 :
      ((-140 + 120 * z) * (1 - z) ^ 2 +
          8 * (84 - 140 * z + 60 * z ^ 2) * (1 - z) +
          20 * (-35 + 84 * z - 70 * z ^ 2 + 20 * z ^ 3)) /
        (1 - z) ^ 6 = bandr2 z := by
    unfold bandr2
    congr 1
    ring
  simpa only [bandF, bandF1, bandF2, bandU, bandG,
    bandg, bandg1, hr1, hr2] using
    private_height_ode z κ lam hz0 hz1

private theorem band_first_scalar
    (F F1 G g r lam x Z : ℝ)
    (hZ : 0 < Z)
    (hODE : F1 = g * F + G * (lam + r))
    (hGlo : (24 / 25 : ℝ) * Z ^ 8 ≤ |G|)
    (hE1 : |g * F| ≤ (9 / 100 : ℝ) * |lam| * Z ^ 8)
    (hE2 : |G * r| ≤ (253 / 1000 : ℝ) * |lam| * Z ^ 8) :
    (3 / 5 : ℝ) * |lam| * Z ^ 8 ≤ |F1| := by
  have htri : |G * lam| ≤ |F1| + |g * F| + |G * r| := by
    have he : G * lam = F1 + (-(g * F)) + (-(G * r)) := by
      rw [hODE]
      ring
    rw [he]
    calc
      |F1 + -(g * F) + -(G * r)| ≤
          |F1 + -(g * F)| + |-(G * r)| := abs_add_le _ _
      _ ≤ |F1| + |-(g * F)| + |-(G * r)| := by
        linarith [abs_add_le F1 (-(g * F))]
      _ = |F1| + |g * F| + |G * r| := by rw [abs_neg, abs_neg]
  have hprod : (24 / 25 : ℝ) * |lam| * Z ^ 8 ≤ |G * lam| := by
    rw [abs_mul]
    nlinarith [mul_nonneg (sub_nonneg.mpr hGlo) (abs_nonneg lam),
      pow_nonneg (le_of_lt hZ) 8, abs_nonneg lam]
  nlinarith [htri, hE1, hE2, hprod,
    mul_nonneg (abs_nonneg lam) (pow_nonneg (le_of_lt hZ) 8)]

private theorem band_second_scalar
    (F F1 F2 G g g1 r2 Z : ℝ)
    (hZ : 0 < Z)
    (hODE : F2 - 2 * g * F1 + (g ^ 2 - g1) * F = G * r2)
    (hMain : (33 : ℝ) * Z ^ 5 ≤ |G * r2|)
    (hHeight : |(g ^ 2 - g1) * F| ≤ Z ^ 5)
    (hSlope : |2 * g * F1| ≤ 2 * Z ^ 5) :
    (30 : ℝ) * Z ^ 5 ≤ |F2| := by
  have htri : |G * r2| ≤ |F2| + |2 * g * F1| +
      |(g ^ 2 - g1) * F| := by
    rw [← hODE]
    calc
      |F2 - 2 * g * F1 + (g ^ 2 - g1) * F| ≤
          |F2 - 2 * g * F1| + |(g ^ 2 - g1) * F| :=
        abs_add_le _ _
      _ ≤ |F2| + |2 * g * F1| + |(g ^ 2 - g1) * F| := by
        linarith [abs_sub F2 (2 * g * F1)]
  nlinarith [htri, hMain, hHeight, hSlope,
    pow_nonneg (le_of_lt hZ) 5]

private theorem source_real_envelope (z : ℝ) (hz : (100 : ℝ) ≤ |z|) :
    (24 / 25 : ℝ) * |z| ^ 8 ≤ |bandG z| ∧
    |bandG z| ≤ (11 / 10 : ℝ) * |z| ^ 8 ∧
    |bandg z| * |z| ≤ 9 ∧
    |(bandg z) ^ 2 - bandg1 z| * |z| ^ 2 ≤ 90 ∧
    |bandr1 z| * |z| ^ 2 ≤ 23 ∧
    (33 : ℝ) * |z| ^ 5 ≤ |bandG z * bandr2 z| := by
  let Z : ℝ := |z|
  let W : ℝ := |1 - z|
  have hZ : 0 < Z := by dsimp [Z]; linarith
  have hZ100 : (100 : ℝ) ≤ Z := hz
  have hlow0 : Z ≤ W + 1 := by
    dsimp [Z, W]
    simpa [sub_add_cancel, abs_sub_comm] using
      (abs_add_le (z - 1) (1 : ℝ))
  have hhigh0 : W ≤ 1 + Z := by
    dsimp [Z, W]
    simpa [sub_eq_add_neg] using (abs_add_le (1 : ℝ) (-z))
  have hlow : (99 / 100 : ℝ) * Z ≤ W := by nlinarith
  have hhigh : W ≤ (101 / 100 : ℝ) * Z := by nlinarith
  have hW : 0 < W := by nlinarith
  have hz0 : z ≠ 0 := by
    intro he; subst z; norm_num [Z] at hZ100
  have hz1 : 1 - z ≠ 0 := by
    intro he
    have : W = 0 := by simpa [W, he]
    linarith
  have hW4lo : ((99 / 100 : ℝ) * Z) ^ 4 ≤ W ^ 4 :=
    pow_le_pow_left₀ (by positivity) hlow 4
  have hW4hi : W ^ 4 ≤ ((101 / 100 : ℝ) * Z) ^ 4 :=
    pow_le_pow_left₀ (le_of_lt hW) hhigh 4
  have hW2hi : W ^ 2 ≤ ((101 / 100 : ℝ) * Z) ^ 2 :=
    pow_le_pow_left₀ (le_of_lt hW) hhigh 2
  have hW5lo : ((99 / 100 : ℝ) * Z) ^ 5 ≤ W ^ 5 :=
    pow_le_pow_left₀ (by positivity) hlow 5
  have hGabs : |bandG z| = Z ^ 4 * W ^ 4 := by
    simp [bandG, Z, W, abs_mul, abs_pow]
  have hGlo : (24 / 25 : ℝ) * Z ^ 8 ≤ |bandG z| := by
    rw [hGabs]
    have hcoef : (24 / 25 : ℝ) * Z ^ 8 ≤
        Z ^ 4 * (((99 / 100 : ℝ) * Z) ^ 4) := by
      nlinarith [pow_nonneg (le_of_lt hZ) 8]
    exact le_trans hcoef
      (mul_le_mul_of_nonneg_left hW4lo (pow_nonneg (le_of_lt hZ) 4))
  have hGhi : |bandG z| ≤ (11 / 10 : ℝ) * Z ^ 8 := by
    rw [hGabs]
    have hcoef : Z ^ 4 * (((101 / 100 : ℝ) * Z) ^ 4) ≤
        (11 / 10 : ℝ) * Z ^ 8 := by
      nlinarith [pow_nonneg (le_of_lt hZ) 8]
    exact le_trans
      (mul_le_mul_of_nonneg_left hW4hi (pow_nonneg (le_of_lt hZ) 4))
      hcoef
  have hZW : Z / W ≤ (100 / 99 : ℝ) := by
    apply (div_le_iff₀ hW).2
    nlinarith [hlow]
  have hga : |bandg z| ≤ 4 / Z + 4 / W := by
    unfold bandg
    calc
      |4 / z - 4 / (1 - z)| ≤ |4 / z| + |4 / (1 - z)| := abs_sub _ _
      _ = 4 / Z + 4 / W := by simp [Z, W, abs_div]
  have hgb : |bandg z| * Z ≤ 9 := by
    have hmul := mul_le_mul_of_nonneg_right hga (le_of_lt hZ)
    have heq : (4 / Z + 4 / W) * Z = 4 + 4 * (Z / W) := by
      field_simp [ne_of_gt hZ, ne_of_gt hW]
    rw [heq] at hmul
    linarith [hZW]
  have hg1a : |bandg1 z| ≤ 4 / Z ^ 2 + 4 / W ^ 2 := by
    unfold bandg1
    calc
      |-4 / z ^ 2 - 4 / (1 - z) ^ 2| ≤
          |-4 / z ^ 2| + |4 / (1 - z) ^ 2| := abs_sub _ _
      _ = 4 / Z ^ 2 + 4 / W ^ 2 := by
        simp [Z, W, abs_div, abs_pow]
  have hZW2 : (Z / W) ^ 2 ≤ (100 / 99 : ℝ) ^ 2 :=
    pow_le_pow_left₀ (div_nonneg (le_of_lt hZ) (le_of_lt hW)) hZW 2
  have hg1b : |bandg1 z| * Z ^ 2 ≤ 9 := by
    have hmul := mul_le_mul_of_nonneg_right hg1a (pow_nonneg (le_of_lt hZ) 2)
    have heq : (4 / Z ^ 2 + 4 / W ^ 2) * Z ^ 2 =
        4 + 4 * (Z / W) ^ 2 := by
      field_simp [ne_of_gt hZ, ne_of_gt hW]
    rw [heq] at hmul
    nlinarith [hZW2]
  have hgg1 : |(bandg z) ^ 2 - bandg1 z| * Z ^ 2 ≤ 90 := by
    have htri := mul_le_mul_of_nonneg_right
      (abs_sub ((bandg z) ^ 2) (bandg1 z))
      (pow_nonneg (le_of_lt hZ) 2)
    have hsq : (|bandg z| * Z) ^ 2 ≤ (9 : ℝ) ^ 2 :=
      pow_le_pow_left₀ (mul_nonneg (abs_nonneg _) (le_of_lt hZ)) hgb 2
    rw [abs_pow] at htri
    nlinarith [htri, hsq, hg1b]
  have hz2 : (100 : ℝ) * Z ≤ Z ^ 2 := by
    nlinarith [mul_nonneg (sub_nonneg.mpr hZ100) (le_of_lt hZ)]
  have hz3 : (100 : ℝ) * Z ^ 2 ≤ Z ^ 3 := by
    nlinarith [mul_nonneg (sub_nonneg.mpr hZ100) (sq_nonneg Z)]
  have hp1size : (56 : ℝ) + 112 * Z + 80 * Z ^ 2 + 20 * Z ^ 3 ≤
      21 * Z ^ 3 := by
    linarith [hz2, hz3, hZ100]
  have hp2size : (168 : ℝ) + 288 * Z + 180 * Z ^ 2 ≤
      2 * Z ^ 3 := by
    linarith [hz2, hz3, hZ100]
  have hp1raw :
      |(-56 : ℝ) + 112 * z - 80 * z ^ 2 + 20 * z ^ 3| ≤
      56 + 112 * Z + 80 * Z ^ 2 + 20 * Z ^ 3 := by
    have h1 := abs_add_le ((-56 : ℝ) + 112 * z - 80 * z ^ 2) (20 * z ^ 3)
    have h2 := abs_sub ((-56 : ℝ) + 112 * z) (80 * z ^ 2)
    have h3 := abs_add_le (-56 : ℝ) (112 * z)
    have h20 : |(20 : ℝ) * z ^ 3| = 20 * Z ^ 3 := by
      simp [Z, abs_mul, abs_pow]
    have h80 : |(80 : ℝ) * z ^ 2| = 80 * Z ^ 2 := by
      simp [Z, abs_mul, abs_pow]
    have h112 : |(112 : ℝ) * z| = 112 * Z := by
      simp [Z, abs_mul]
    rw [h20] at h1
    rw [h80] at h2
    rw [h112] at h3
    norm_num at h3
    linarith
  have hp1 : |(-56 : ℝ) + 112 * z - 80 * z ^ 2 + 20 * z ^ 3| ≤
      21 * Z ^ 3 := le_trans hp1raw hp1size
  have hW5coef : (21 : ℝ) * Z ^ 5 ≤ 23 * W ^ 5 := by
    have hcoef : (21 : ℝ) * Z ^ 5 ≤
        23 * (((99 / 100 : ℝ) * Z) ^ 5) := by
      nlinarith [pow_nonneg (le_of_lt hZ) 5]
    exact le_trans hcoef
      (mul_le_mul_of_nonneg_left hW5lo (by norm_num))
  have hr1 : |bandr1 z| * Z ^ 2 ≤ 23 := by
    have heq : |bandr1 z| =
        |(-56 : ℝ) + 112 * z - 80 * z ^ 2 + 20 * z ^ 3| / W ^ 5 := by
      simp [bandr1, W, abs_div, abs_pow]
    rw [heq, div_mul_eq_mul_div]
    apply (div_le_iff₀ (pow_pos hW 5)).2
    have hmul := mul_le_mul_of_nonneg_right hp1 (pow_nonneg (le_of_lt hZ) 2)
    calc
      |(-56 : ℝ) + 112 * z - 80 * z ^ 2 + 20 * z ^ 3| * Z ^ 2 ≤
          (21 * Z ^ 3) * Z ^ 2 := hmul
      _ = 21 * Z ^ 5 := by ring
      _ ≤ 23 * W ^ 5 := hW5coef
  have hqraw :
      |(-168 : ℝ) + 288 * z - 180 * z ^ 2| ≤
      168 + 288 * Z + 180 * Z ^ 2 := by
    have h1 := abs_sub ((-168 : ℝ) + 288 * z) (180 * z ^ 2)
    have h2 := abs_add_le (-168 : ℝ) (288 * z)
    have h180 : |(180 : ℝ) * z ^ 2| = 180 * Z ^ 2 := by
      simp [Z, abs_mul, abs_pow]
    have h288 : |(288 : ℝ) * z| = 288 * Z := by
      simp [Z, abs_mul]
    rw [h180] at h1
    rw [h288] at h2
    norm_num at h2
    linarith
  have hp2raw :
      (40 : ℝ) * Z ^ 3 ≤
        |(-168 : ℝ) + 288 * z - 180 * z ^ 2 + 40 * z ^ 3| +
        168 + 288 * Z + 180 * Z ^ 2 := by
    have heq : (40 : ℝ) * z ^ 3 =
        (-168 + 288 * z - 180 * z ^ 2 + 40 * z ^ 3) -
        (-168 + 288 * z - 180 * z ^ 2) := by ring
    have htri := abs_sub
      ((-168 : ℝ) + 288 * z - 180 * z ^ 2 + 40 * z ^ 3)
      ((-168 : ℝ) + 288 * z - 180 * z ^ 2)
    rw [← heq] at htri
    have h40 : |(40 : ℝ) * z ^ 3| = 40 * Z ^ 3 := by
      simp [Z, abs_mul, abs_pow]
    rw [h40] at htri
    linarith [hqraw]
  have hp2 : (38 : ℝ) * Z ^ 3 ≤
      |(-168 : ℝ) + 288 * z - 180 * z ^ 2 + 40 * z ^ 3| := by
    linarith [hp2raw, hp2size]
  have hmainabs : |bandG z * bandr2 z| =
      Z ^ 4 * |(-168 : ℝ) + 288 * z - 180 * z ^ 2 + 40 * z ^ 3| /
        W ^ 2 := by
    simp [bandG, bandr2, Z, W, abs_mul, abs_div, abs_pow]
    field_simp [ne_of_gt hW]
