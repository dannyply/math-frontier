    ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → Point → Prop := fun P Q x D E M rho Ccell p =>
  0 < d p ∧ 0 < e p ∧ 0 < u p ∧ 0 < v p ∧
  D / 2 < (d p : ℝ) ∧ (d p : ℝ) ≤ D ∧
  E / 2 < (e p : ℝ) ∧ (e p : ℝ) ≤ E ∧
  x / 2 < (d p : ℝ) ^ 4 * (u p : ℝ) ∧
  (d p : ℝ) ^ 4 * (u p : ℝ) ≤ x ∧
  (e p : ℤ) ^ 4 * (v p : ℤ) -
    (d p : ℤ) ^ 4 * (u p : ℤ) = 1 ∧
  MvPolynomial.eval ![(d p : ℤ), (e p : ℤ)] P * (u p : ℤ) =
    MvPolynomial.eval ![(d p : ℤ), (e p : ℤ)] Q * (v p : ℤ) ∧
  |(d p : ℝ) / (e p : ℝ) - rho| ≤ Ccell * D / (E * M);
let m50 : Fin 2 →₀ ℕ := Finsupp.single 0 5;
let m41 : Fin 2 →₀ ℕ := Finsupp.single 0 4 + Finsupp.single 1 1;
∀
    (Ppoly Qpoly : MvPolynomial (Fin 2) ℤ)
    (a b c A Bbez : ℤ)
    (p₀ : Point)
    (x D E M rho Ccell cM : ℝ)
    (Spts : Finset Point)
    (hPpoly : ∀ μ ∈ Ppoly.support, μ 0 + μ 1 = 5)
    (hQpoly : ∀ μ ∈ Qpoly.support, μ 0 + μ 1 = 5)
    (hc : c ≠ 0) (hab : A * a + Bbez * b = 1)
    (hcop : ∀ R : MvPolynomial (Fin 2) ℚ,
      R ∣ MvPolynomial.map (Int.castRingHom ℚ) Ppoly →
      R ∣ MvPolynomial.map (Int.castRingHom ℚ) Qpoly → IsUnit R)
    (hpure : MvPolynomial.X (1 : Fin 2) ^ 4 * Ppoly -
      MvPolynomial.X (0 : Fin 2) ^ 4 * Qpoly =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ 9)
    (hbase : OriginalCellPoint
      Ppoly Qpoly x D E M rho Ccell p₀)
    (hS : ∀ p ∈ Spts,
      OriginalCellPoint
        Ppoly Qpoly x D E M rho Ccell p ∧
      a * (p.1.1 : ℤ) + b * (p.1.2 : ℤ) =
        a * (p₀.1.1 : ℤ) + b * (p₀.1.2 : ℤ))
    (hx : 2 ≤ x) (hD : 1 ≤ D) (hE : 1 ≤ E)
    (hZlo : x ^ (329 / 1000 : ℝ) ≤ D * E)
    (hZhi : D * E ≤ x ^ (17 / 50 : ℝ))
    (hcM : 0 < cM) (hC : 0 ≤ Ccell)
    (hMlo : cM * x ^ (1 / 4 : ℝ) ≤ M)
    (hMhi : M ≤ x ^ (51 / 200 : ℝ))
    (hXfloor : (max 1 cM⁻¹) ^ (1000 : ℕ) ≤ x)
    (hXcut : (26214400 : ℝ) ^ (100 : ℕ) ≤ x),
    let K0 : ℤ := b * Ppoly.coeff m50 -
      a * Ppoly.coeff m41 + 56 * c * a ^ 5 * b ^ 5
    let m : ℤ := a * (p₀.1.1 : ℤ) + b * (p₀.1.2 : ℤ)
    let h : ℤ := (c.natAbs / c.natAbs.gcd K0.natAbs : ℕ)
    let n : ℕ := (m ^ 9).natAbs
    let s : Finset ℕ := n.primeFactors
    let Z : ℝ := D * E
    let ell : ℝ := |(m : ℝ)|
    let K : ℝ := |(a : ℝ) * (b : ℝ)|
    let Pphys : ℝ := |(a : ℝ)| * D / (2 * ell)
    let gamma : ℝ := (a : ℝ) * (b : ℝ) * (h : ℝ) / (m : ℝ)
    let lam : ℝ := (K0 : ℝ) /
      ((c : ℝ) * (a : ℝ) ^ 5 * (b : ℝ) ^ 5)
    let Btar : ℝ := x ^ (1 / 4 : ℝ) *
      M ^ (-(3 / 4 : ℝ)) * Z ^ (-(1 / 9 : ℝ))
    let Clevel : ℝ :=
      2000000 + 1000 * Ccell / cM + 2 * Ccell
    (Spts.card : ℝ) ≤
      Clevel * ((5 ^ s.card : ℕ) : ℝ) *
        (1 + Btar) := by
  dsimp only
  intro Ppoly Qpoly a b c A Bbez p₀ x D E M rho Ccell cM Spts hPpoly hQpoly hc hab hcop hpure hbase hS hx hD hE hZlo hZhi hcM hC hMlo hMhi hXfloor hXcut
  classical
  let K0 : ℤ := b * Ppoly.coeff m50 -
      a * Ppoly.coeff m41 + 56 * c * a ^ 5 * b ^ 5
  let m : ℤ := a * (p₀.1.1 : ℤ) + b * (p₀.1.2 : ℤ)
  let t₀ : ℤ := Bbez * (p₀.1.1 : ℤ) - A * (p₀.1.2 : ℤ)
  let h : ℤ := (c.natAbs / c.natAbs.gcd K0.natAbs : ℕ)
  let n : ℕ := (m ^ 9).natAbs
  let s : Finset ℕ := n.primeFactors
  let Z : ℝ := D * E
  let ell : ℝ := |(m : ℝ)|
  let K : ℝ := |(a : ℝ) * (b : ℝ)|
  let Pphys : ℝ := |(a : ℝ)| * D / (2 * ell)
  let gamma : ℝ := (a : ℝ) * (b : ℝ) * (h : ℝ) / (m : ℝ)
  let lam : ℝ := (K0 : ℝ) /
      ((c : ℝ) * (a : ℝ) ^ 5 * (b : ℝ) ^ 5)
  let Btar : ℝ := x ^ (1 / 4 : ℝ) *
      M ^ (-(3 / 4 : ℝ)) * Z ^ (-(1 / 9 : ℝ))
  let Clevel : ℝ :=
      2000000 + 1000 * Ccell / cM + 2 * Ccell
  try dsimp only
  have hxpos : 0 < x := by linarith
  have hDpos : 0 < D := by linarith
  have hEpos : 0 < E := by linarith
  have hMpos : 0 < M := by
    have ht : 0 < cM * x ^ (1 / 4 : ℝ) := by positivity
    exact lt_of_lt_of_le ht hMlo
  obtain ⟨_, _, huNat, hvNat, hdlo, hdhi, helo, hehi,
    _, hnhi, hunit₀, hgraph₀, _⟩ := hbase
  have hanchor := a7_original_signed_progression
    Ppoly Qpoly a b c A Bbez
    (p₀.1.1 : ℤ) (p₀.1.2 : ℤ)
    (p₀.2.1 : ℤ) (p₀.2.2 : ℤ)
    hPpoly hQpoly hc hab hcop hpure hunit₀ hgraph₀
  obtain ⟨_, hm0, _, _, hhpos,
    q, j₀, j₁, hq0, hcq, _, hJ₀, hJ₁, hprog⟩ := hanchor
  let f : Polynomial ℤ := fProg a b A Bbez m t₀ h j₀ j₁
  let g : Polynomial ℤ := gProg a b A Bbez m t₀ h j₀ j₁
  have htop := actual_fProg_gProg_top_coeff_bounded
    a b c (Ppoly.coeff m41) (Ppoly.coeff m50)
    A Bbez m t₀ h j₀ j₁ q hc hJ₁.symm hcq
  have hfdeg : f.natDegree ≤ 4 + 1 := by
    simpa only [f, Nat.reduceAdd] using
      fProg_natDegree_le_five a b A Bbez m t₀ h j₀ j₁
  have hgdeg : g.natDegree ≤ 4 + 1 := by
    simpa only [g, Nat.reduceAdd] using
      gProg_natDegree_le_five a b A Bbez m t₀ h j₀ j₁
  have hftop : f.coeff (4 + 1) = q * h ^ 4 * b ^ 4 := by
    simpa only [f, Nat.reduceAdd] using htop.1
  have hgtop :
      g.coeff (4 + 1) =
        (-1 : ℤ) ^ 4 * q * h ^ 4 * a ^ 4 := by
    simpa [g] using htop.2
  let N : ℕ := (q * h ^ 4).natAbs
  let W : ℕ := ∏ p ∈ s,
    p ^ originalDepth 4 (padicValNat p n) (padicValNat p N)
  have hcrt : 0 < W ∧ n ∣ W ^ 5 * N ∧
      ∃ centers : Finset ℤ, centers.card ≤ 5 ^ s.card ∧
        ∀ y u v : ℤ,
          f.eval y = m ^ 9 * v →
          g.eval y = m ^ 9 * u →
          ∃ center ∈ centers, (W : ℤ) ∣ y - center := by
    simpa only [W, s, n, N, Nat.reduceMul, Nat.reduceAdd] using
      original_allprime_cover_and_modulus
        4 a b A Bbez q h m f g hab hm0 hq0
        (ne_of_gt hhpos) hfdeg hgdeg hftop hgtop
  obtain ⟨hW, hmod, centers, hcenters, hcover⟩ := hcrt
  have hcert : ∀ p ∈ Spts, ∃ y : ℤ,
      (p.1.1 : ℤ) = A * m + b * (t₀ + h * y) ∧
      (p.1.2 : ℤ) = Bbez * m - a * (t₀ + h * y) ∧
      f.eval y = m ^ 9 * (p.2.2 : ℤ) ∧
      g.eval y = m ^ 9 * (p.2.1 : ℤ) := by
    intro p hp
    obtain ⟨hpoint, hlevel⟩ := hS p hp
    obtain ⟨_, _, _, _, _, _, _, _, _, _, hunit, hgraph, _⟩ :=
      hpoint
    obtain ⟨y, hd, he, hf, hg⟩ := hprog
      (p.1.1 : ℤ) (p.1.2 : ℤ)
      (p.2.1 : ℤ) (p.2.2 : ℤ)
      hlevel hunit hgraph
    exact ⟨y, hd, he, by simpa only [f] using hf,
      by simpa only [g] using hg⟩
  obtain ⟨T, hcard, hsample⟩ :=
    original_shared_signed_parameter_image
      Spts a b A Bbez m t₀ h f g hm0 hcert
  have hSonly : ∀ p ∈ Spts,
      A7PureNineOriginalCount.OriginalCellPoint
        Ppoly Qpoly x D E M rho Ccell p := by
    intro p hp
    exact (hS p hp).1
  have hphys :
      (Spts.card : ℝ) ≤ (centers.card : ℝ) *
        (2 + 2 * Ccell * D * E /
          (M * |((m * h : ℤ) : ℝ)| * (W : ℝ))) := by
    classical
    have hmh : m * h ≠ 0 := mul_ne_zero hm0 (ne_of_gt hhpos)
    have hmhR : ((m * h : ℤ) : ℝ) ≠ 0 := by exact_mod_cast hmh
    have hden : 0 < M * |((m * h : ℤ) : ℝ)| :=
      mul_pos hMpos (abs_pos.mpr hmhR)
    let L : ℝ := (2 * Ccell * D * E) /
      (M * |((m * h : ℤ) : ℝ)|)
    have hL : 0 ≤ L := by
      dsimp [L]
      exact div_nonneg (by positivity) (le_of_lt hden)
    have hdiam : ∀ y ∈ T, ∀ y' ∈ T,
        |(((y - y' : ℤ) : ℝ))| ≤ L := by
      intro y hy y' hy'
      obtain ⟨p, hp, hd, he, _, _⟩ := hsample y hy
      obtain ⟨p', hp', hd', he', _, _⟩ := hsample y' hy'
      obtain ⟨_, hepos, _, _, _, _, _, heE, _, _, _, _, hcell⟩ :=
        hSonly p hp
      obtain ⟨_, hepos', _, _, _, _, _, heE', _, _, _, _, hcell'⟩ :=
        hSonly p' hp'
      have heposR : (0 : ℝ) < (p.1.2 : ℝ) := by
        exact_mod_cast hepos
      have heposR' : (0 : ℝ) < (p'.1.2 : ℝ) := by
        exact_mod_cast hepos'
      have hcellpair :
          |(p.1.1 : ℝ) / (p.1.2 : ℝ) -
            (p'.1.1 : ℝ) / (p'.1.2 : ℝ)| ≤
            2 * Ccell * D / (E * M) := by
        calc
          _ = |((p.1.1 : ℝ) / (p.1.2 : ℝ) - rho) -
            ((p'.1.1 : ℝ) / (p'.1.2 : ℝ) - rho)| := by
              congr 1 <;> ring
          _ ≤ |(p.1.1 : ℝ) / (p.1.2 : ℝ) - rho| +
            |(p'.1.1 : ℝ) / (p'.1.2 : ℝ) - rho| := by
              simpa only [sub_zero, zero_sub, abs_neg] using
                (abs_sub_le
                  ((p.1.1 : ℝ) / (p.1.2 : ℝ) - rho)
                  0
                  ((p'.1.1 : ℝ) / (p'.1.2 : ℝ) - rho))
          _ ≤ 2 * Ccell * D / (E * M) := by
              have heq : 2 * (Ccell * D / (E * M)) =
                  2 * Ccell * D / (E * M) := by ring
              rw [← heq]
              change |(p.1.1 : ℝ) / (p.1.2 : ℝ) - rho| ≤
                Ccell * D / (E * M) at hcell
              change |(p'.1.1 : ℝ) / (p'.1.2 : ℝ) - rho| ≤
                Ccell * D / (E * M) at hcell'
              linarith only [hcell, hcell']
      have hdet := original_relative_cell_diameter
        a b A Bbez m t₀ h y y'
        (p.1.1 : ℤ) (p.1.2 : ℤ)
        (p'.1.1 : ℤ) (p'.1.2 : ℤ)
        D E M Ccell hab hd he hd' he'
        heposR heposR' heE heE' hEpos hMpos (le_of_lt hDpos) hC hcellpair
      dsimp [L]
      apply (le_div_iff₀ hden).2
      calc
        |(((y - y' : ℤ) : ℝ))| *
            (M * |((m * h : ℤ) : ℝ)|) =
          M * |((m * h : ℤ) : ℝ)| *
            |(((y - y' : ℤ) : ℝ))| := by ring
        _ ≤ 2 * Ccell * D * E := hdet
    have hcoverT : ∀ y ∈ T,
        ∃ center ∈ centers, (W : ℤ) ∣ y - center := by
      intro y hy
      obtain ⟨p, _, _, _, hf, hg⟩ := hsample y hy
      exact hcover y (p.2.1 : ℤ) (p.2.2 : ℤ) hf hg
    have hWint : (0 : ℤ) < (W : ℤ) := by exact_mod_cast hW
    have hcount := integer_residue_cover_diameter_card
      T centers (W : ℤ) L hWint hL hdiam hcoverT
    have hfrac :
        L / (W : ℝ) =
          2 * Ccell * D * E /
            (M * |((m * h : ℤ) : ℝ)| * (W : ℝ)) := by
      dsimp [L]
      field_simp
    have hcastW : ((W : ℤ) : ℝ) = (W : ℝ) := by norm_cast
    rw [hcastW, hfrac] at hcount
    simpa only [hcard] using hcount
  have hprice : 0 ≤ 2 + 2 * Ccell * D * E /
      (M * |((m * h : ℤ) : ℝ)| * (W : ℝ)) := by
    positivity
  have hcentersR :
      (centers.card : ℝ) ≤ ((5 ^ s.card : ℕ) : ℝ) := by
    exact_mod_cast hcenters
  have hphysraw :
      (Spts.card : ℝ) ≤ ((5 ^ s.card : ℕ) : ℝ) *
        (2 + 2 * Ccell * D * E /
          (M * |((m * h : ℤ) : ℝ)| * (W : ℝ))) :=
    hphys.trans (mul_le_mul_of_nonneg_right hcentersR hprice)
  let width : ℝ :=
    2 * Ccell * D * E /
      (M * |((m * h : ℤ) : ℝ)| * (W : ℝ))
  change (Spts.card : ℝ) ≤ ((5 ^ s.card : ℕ) : ℝ) *
    (2 + width) at hphysraw
  have hmR : (m : ℝ) ≠ 0 := by exact_mod_cast hm0
  have hell : 0 < ell := abs_pos.mpr hmR
  have hhR : (0 : ℝ) < (h : ℝ) := by
    have ht : (0 : ℤ) < h := by simpa only [h] using hhpos
    exact_mod_cast ht
  have hhI : (1 : ℤ) ≤ h := by
    have ht : (0 : ℤ) < h := by simpa only [h] using hhpos
    have one_le_pos : ∀ z : ℤ, 0 < z → 1 ≤ z := by
      intro z hz
      omega
    exact one_le_pos h ht
  have hh1 : (1 : ℝ) ≤ (h : ℝ) := by exact_mod_cast hhI
  have hWI : 1 ≤ W := by omega
  have hW1 : (1 : ℝ) ≤ (W : ℝ) := by exact_mod_cast hWI
  have hWpos : (0 : ℝ) < (W : ℝ) := by exact_mod_cast hW
  have hZpos : 0 < Z := mul_pos hDpos hEpos
  have hBpos : 0 < Btar := by
    dsimp [Btar]
    positivity
  have hdenbase : 0 < M * ell * (h : ℝ) := by positivity
  have habsmh :
      |(((m * h : ℤ) : ℝ))| = ell * (h : ℝ) := by
    change |((m * h : ℤ) : ℝ)| = |(m : ℝ)| * (h : ℝ)
    rw [Int.cast_mul, abs_mul, abs_of_pos hhR]
  have hraw_le_base :
      width ≤ 2 * Ccell * Z / (M * ell * (h : ℝ)) := by
    dsimp [width, Z]
    rw [habsmh]
    have hdenW : 0 < (M * ell * (h : ℝ)) * (W : ℝ) := by
      positivity
    have hdenle :
        M * ell * (h : ℝ) ≤
          (M * ell * (h : ℝ)) * (W : ℝ) :=
      le_mul_of_one_le_right (le_of_lt hdenbase) hW1
    have hnum : 0 ≤ 2 * Ccell * D * E := by positivity
    have ht := mul_le_mul_of_nonneg_left hdenle hnum
    have hdiv :
        2 * Ccell * D * E /
          (M * ell * (h : ℝ) * (W : ℝ)) ≤
        2 * Ccell * D * E / (M * ell * (h : ℝ)) :=
      (div_le_div_iff₀ hdenW hdenbase).2
        (by nlinarith only [ht])
    simpa only [mul_assoc] using hdiv
  have hraw_le_plain :
      width ≤ 2 * Ccell * Z / (M * ell) := by
    refine hraw_le_base.trans ?_
    have hdenplain : 0 < M * ell := by positivity
    have hdenle :
        M * ell ≤ M * ell * (h : ℝ) :=
      le_mul_of_one_le_right (le_of_lt hdenplain) hh1
    have hnum : 0 ≤ 2 * Ccell * Z := by positivity
    have ht := mul_le_mul_of_nonneg_left hdenle hnum
    apply (div_le_div_iff₀ hdenbase hdenplain).2
    nlinarith only [ht]
  have hfinishPhysical
      (hbudget : width ≤ 1000 * Ccell / cM +
        2 * Ccell * Btar) :
      (Spts.card : ℝ) ≤ Clevel *
        ((5 ^ s.card : ℕ) : ℝ) * (1 + Btar) := by
    have hcpart : 0 ≤ 1000 * Ccell / cM := by positivity
    have hfac : 0 ≤ ((5 ^ s.card : ℕ) : ℝ) := by positivity
    have hclevel : 0 ≤ Clevel := by
      dsimp [Clevel]
      positivity
    have hslot :
        2 + width ≤ Clevel * (1 + Btar) := by
      have hremain :
          0 ≤ ((2000000 : ℝ) + 1000 * Ccell / cM) *
            Btar := by positivity
      dsimp [Clevel]
      nlinarith only [hbudget, hcpart, hC, le_of_lt hBpos,
        hremain]
    have ht := mul_le_mul_of_nonneg_left hslot hfac
    calc
      (Spts.card : ℝ) ≤
        ((5 ^ s.card : ℕ) : ℝ) * (2 + width) := hphysraw
      _ ≤ ((5 ^ s.card : ℕ) : ℝ) *
          (Clevel * (1 + Btar)) := ht
      _ = Clevel * ((5 ^ s.card : ℕ) : ℝ) *
          (1 + Btar) := by ring
  have int_abs_one (k : ℤ) (hk : k ≠ 0) :
      (1 : ℝ) ≤ |(k : ℝ)| := by
    have hki : (1 : ℤ) ≤ |k| := by
      have hkp : (0 : ℤ) < |k| := abs_pos.mpr hk
      omega
    exact_mod_cast hki
  have haxis_budget (haxis : a = 0 ∨ b = 0) :
      width ≤ 1000 * Ccell / cM + 2 * Ccell * Btar := by
    have hu1 : (1 : ℝ) ≤ (p₀.2.1 : ℝ) := by
      exact_mod_cast huNat
    have hv1 : (1 : ℝ) ≤ (p₀.2.2 : ℝ) := by
      exact_mod_cast hvNat
    have hunitR :
        (p₀.1.2 : ℝ) ^ 4 * (p₀.2.2 : ℝ) -
          (p₀.1.1 : ℝ) ^ 4 * (p₀.2.1 : ℝ) = 1 := by
      exact_mod_cast hunit₀
    have hcaps := a7_original_axis_height_caps
      x D E (p₀.1.1 : ℝ) (p₀.1.2 : ℝ)
      (p₀.2.1 : ℝ) (p₀.2.2 : ℝ)
      hx (by positivity) (by positivity)
      hu1 hv1 hdlo hdhi helo hehi hnhi hunitR
    have haxisgeom : E / 2 ≤ ell ∨ D / 2 ≤ ell := by
      rcases haxis with ha0 | hb0
      · left
        have hb0 : b ≠ 0 := by
          intro hzero
          simp [ha0, hzero] at hab
        have hbR1 := int_abs_one b hb0
        have he0 : 0 ≤ (p₀.1.2 : ℝ) := by positivity
        have hmul := mul_le_mul_of_nonneg_right hbR1 he0
        have hmcast :
            (m : ℝ) = (b : ℝ) * (p₀.1.2 : ℝ) := by
          dsimp [m]
          simp [ha0]
        dsimp [ell]
        rw [hmcast, abs_mul, abs_of_nonneg he0]
        linarith only [helo, hmul]
      · right
        have ha0 : a ≠ 0 := by
          intro hzero
          simp [hzero, hb0] at hab
        have haR1 := int_abs_one a ha0
        have hd0 : 0 ≤ (p₀.1.1 : ℝ) := by positivity
        have hmul := mul_le_mul_of_nonneg_right haR1 hd0
        have hmcast :
            (m : ℝ) = (a : ℝ) * (p₀.1.1 : ℝ) := by
          dsimp [m]
          simp [hb0]
        dsimp [ell]
        rw [hmcast, abs_mul, abs_of_nonneg hd0]
        linarith only [hdlo, hmul]
    have hscalar := a7_axis_crt_width_scalar
      x D E M cM Ccell ell 1
      hx hcM hC hDpos hEpos hell (by norm_num)
      hcaps.1 hcaps.2 haxisgeom hMlo
    have hbound : width ≤ 16 * Ccell / cM := by
      exact hraw_le_plain.trans
        (by simpa only [Z, mul_one, mul_assoc] using hscalar)
    have hBterm : 0 ≤ 2 * Ccell * Btar := by positivity
    have haxisBound :
        16 * Ccell / cM ≤ 1000 * Ccell / cM := by
      apply (div_le_div_iff₀ hcM hcM).2
      nlinarith only [mul_nonneg hC (le_of_lt hcM)]
    exact hbound.trans
      (haxisBound.trans (le_add_of_nonneg_right hBterm))
  by_cases ha0 : a = 0
  case pos =>
    exact hfinishPhysical (haxis_budget (Or.inl ha0))
  by_cases hb0 : b = 0
