theorem gcd_de (d e u v : ℕ) (h : e ^ 4 * v = d ^ 4 * u + 1) : Nat.gcd d e = 1 := by
  have h1 : Nat.gcd d e ∣ d ^ 4 * u :=
    Dvd.dvd.mul_right (dvd_pow (Nat.gcd_dvd_left d e) (by norm_num)) u
  have h2 : Nat.gcd d e ∣ d ^ 4 * u + 1 := by
    rw [← h]
    exact Dvd.dvd.mul_right (dvd_pow (Nat.gcd_dvd_right d e) (by norm_num)) v
  exact Nat.dvd_one.mp ((Nat.dvd_add_right h1).mp h2)

theorem gcd_uv (d e u v : ℕ) (h : e ^ 4 * v = d ^ 4 * u + 1) : Nat.gcd u v = 1 := by
  have h1 : Nat.gcd u v ∣ d ^ 4 * u := Dvd.dvd.mul_left (Nat.gcd_dvd_left u v) _
  have h2 : Nat.gcd u v ∣ d ^ 4 * u + 1 := by
    rw [← h]
    exact Dvd.dvd.mul_left (Nat.gcd_dvd_right u v) _
  exact Nat.dvd_one.mp ((Nat.dvd_add_right h1).mp h2)

theorem proportional_eq (a b a' b' : ℕ) (ha : 0 < a) (ha' : 0 < a')
