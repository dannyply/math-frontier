theorem JocelynClaims.claim_4e8b1f0f73f825b71f74838d349ca0a8ed43f17b4c27ab0204d227a00cd51fa9 :
let IntegerPoint := Fin 2 → ℤ;
let RealPoint := Fin 2 → ℝ;
let IntegerMatrix := Matrix (Fin 2) (Fin 2) ℤ;
let RealMatrix := Matrix (Fin 2) (Fin 2) ℝ;
let integerEmbedding : IntegerPoint → RealPoint := fun z i => (z i : ℝ);
let triangularMatrix : ℝ → ℝ → ℝ → ℝ → RealMatrix :=
  fun D E M s => ![![M / D, -M * s / D], ![0, 1 / E]];
let triangularInverse : ℝ → ℝ → ℝ → ℝ → RealMatrix :=
  fun D E M s => ![![D / M, s * E], ![0, E]];
let transformedPoint : ℝ → ℝ → ℝ → ℝ → IntegerPoint → RealPoint :=
  fun D E M s z => (triangularMatrix D E M s).mulVec (integerEmbedding z);
let euclideanNorm : RealPoint → ℝ :=
  fun v => Real.sqrt (v 0 ^ 2 + v 1 ^ 2);
let nonzeroLatticeNorms : ℝ → ℝ → ℝ → ℝ → Set ℝ :=
  fun D E M s => {r | ∃ z : IntegerPoint, z ≠ 0 ∧
    euclideanNorm (transformedPoint D E M s z) = r};
let shortestNorm : ℝ → ℝ → ℝ → ℝ → ℝ :=
  fun D E M s => sInf (nonzeroLatticeNorms D E M s);
let reciprocalShortestNorm : ℝ → ℝ → ℝ → ℝ → ℝ :=
  fun D E M s => 1 / shortestNorm D E M s;
let integerMatrixBound : IntegerMatrix → ℝ → Prop :=
  fun P H => ∀ i j : Fin 2, |((P i j : ℤ) : ℝ)| ≤ H;
let physicalCell : ℝ → ℝ → ℝ → ℝ → ℝ → Set IntegerPoint :=
  fun c0 D E M s => {z |
    |((z 0 : ℤ) : ℝ) - s * ((z 1 : ℤ) : ℝ)| ≤ c0 * D / M ∧
    |((z 1 : ℤ) : ℝ)| ≤ c0 * E};
let integerCoordinates : IntegerMatrix → IntegerPoint → IntegerPoint :=
  fun A z => A.mulVec z;
∀ c0 : ℝ, 1 ≤ c0 →
  ∃ C : ℝ, 0 < C ∧
    ∀ D E M s : ℝ,
      1 ≤ D → 1 ≤ E → 1 ≤ M → |s| ≤ c0 * D / E →
        0 < shortestNorm D E M s ∧
        0 < reciprocalShortestNorm D E M s ∧
        reciprocalShortestNorm D E M s ≤ C * max D E ∧
        ∃ P A : IntegerMatrix,
          A * P = 1 ∧ P * A = 1 ∧
          integerMatrixBound P (C * M * max D E) ∧
          integerMatrixBound A (C * M * max D E) ∧
          ∀ z : IntegerPoint, z ∈ physicalCell c0 D E M s →
            ∀ i : Fin 2,
              |((integerCoordinates A z i : ℤ) : ℝ)| ≤
                C * reciprocalShortestNorm D E M s

 := by
  change A6ActualTriangularLatticeFrameStatement.wholeStatement
  exact A6ActualTriangularLatticeFrameStatement.frame_main

