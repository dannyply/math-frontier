open Lean Elab Command in
def a7getStr (n : Name) : CommandElabM String := do
  let n := (← getCurrNamespace) ++ n
  match (← getEnv).find? n with
  | some (ConstantInfo.defnInfo d) =>
    match d.value with
    | .lit (.strVal s) => pure s
    | _ => throwError "a7stmt: {n} is not a string-literal definition"
  | _ => throwError "a7stmt: unknown source {n}"

open Lean Elab Command in
@[command_elab a7stmtCmd] def elabA7stmt : CommandElab := fun stx => do
  match stx with
  | `(a7stmt $sid:ident $tid:ident $sh:str [$parts,*]) =>
    let mut acc : String := ""
    for p in parts.getElems do
      match p with
      | `(a7part| $s:str) => acc := acc ++ s.getString
      | `(a7part| $src:ident $o:num $l:num) =>
        let base ← if src.getId == `self then pure acc else a7getStr src.getId
        let piece := A7Meta.slice base o.getNat l.getNat
        if piece.length != l.getNat then
          throwError "a7stmt: reference out of range"
        acc := acc ++ piece
      | _ => throwError "a7stmt: bad part"
    let got := A7Meta.sha256 acc.toUTF8
    if got == sh.getString then
      logInfo m!"{sid.getId}: sha256 {got} matches registered ({acc.utf8ByteSize} bytes)"
    else
      logError m!"{sid.getId}: sha256 MISMATCH expected {sh.getString} got {got} ({acc.utf8ByteSize} bytes)"
    let lit := Syntax.mkStrLit acc
    elabCommand (← `(command| def $tid : String := $lit:str))
    match Parser.runParserCategory (← getEnv) `term acc with
    | .error e => logError m!"{sid.getId}: parse error: {e}"
    | .ok t =>
      let t' : TSyntax `term := ⟨t⟩
      elabCommand (← `(command| def $sid : Prop := $t'))
  | _ => throwUnsupportedSyntax

