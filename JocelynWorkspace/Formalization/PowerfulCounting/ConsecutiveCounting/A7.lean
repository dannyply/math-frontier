    a = a' ∧ b = b' := by
  have h1 : a ∣ b * a' := by
    rw [h]
    exact dvd_mul_left a b'
  have h2 : a' ∣ b' * a := by
    rw [← h]
    exact dvd_mul_left a' b
  have h3 : a ∣ a' := by
    first
    | exact Nat.Coprime.dvd_of_dvd_mul_left hc h1
    | exact Nat.Coprime.dvd_of_dvd_mul_right hc (by rwa [mul_comm] at h1)
  have h4 : a' ∣ a := by
    first
    | exact Nat.Coprime.dvd_of_dvd_mul_left hc' h2
    | exact Nat.Coprime.dvd_of_dvd_mul_right hc' (by rwa [mul_comm] at h2)
  have hae : a = a' := Nat.dvd_antisymm h3 h4
  refine ⟨hae, ?_⟩
  subst hae
  exact Nat.eq_of_mul_eq_mul_right ha h

