private theorem both_coprime4 (d e u v : ℕ) (h : ℤ)
    (hsign : h = 1 ∨ h = -1)
    (hshift : ((e ^ 4 * v : ℕ) : ℤ) = ((d ^ 4 * u : ℕ) : ℤ) + h) :
    d.Coprime e ∧ u.Coprime v := by
  have hn := (unit_coprime (e ^ 4 * v) (d ^ 4 * u) h hsign hshift).symm
  have hdvd : d ∣ d ^ 4 * u := ⟨d ^ 3 * u, by ring⟩
  have hevd : e ∣ e ^ 4 * v := ⟨e ^ 3 * v, by ring⟩
  have huvd : u ∣ d ^ 4 * u := ⟨d ^ 4, by ring⟩
  have hvvd : v ∣ e ^ 4 * v := ⟨e ^ 4, by ring⟩
  exact ⟨hn.of_dvd hdvd hevd, hn.of_dvd huvd hvvd⟩

private theorem graph_shift_transfer
    (C E d e u v h : ℤ)
    (hgraph : C * u = E * v)
    (hshift : e ^ 4 * v - d ^ 4 * u = h) :
    let R := e ^ 4 * C - d ^ 4 * E
    R * u = h * E ∧ R * v = h * C := by
  dsimp
  constructor
  · linear_combination e ^ 4 * hgraph + E * hshift
  · linear_combination d ^ 4 * hgraph + C * hshift

private theorem graph_value_divides_resultant
    (C E d e u v h B : ℤ)
    (hsign : h = 1 ∨ h = -1)
    (hgraph : C * u = E * v)
    (hshift : e ^ 4 * v - d ^ 4 * u = h)
    (hres : (Int.gcd E C : ℤ) ∣ B)
    (hB : B ≠ 0) :
    let R := e ^ 4 * C - d ^ 4 * E
    R ≠ 0 ∧ R ∣ B := by
  dsimp
  let R : ℤ := e ^ 4 * C - d ^ 4 * E
  have htrans : R * u = h * E ∧ R * v = h * C :=
    graph_shift_transfer C E d e u v h hgraph hshift
  have hRC : R ∣ C := by
    rcases hsign with rfl | rfl
    · refine ⟨v, ?_⟩
      simpa only [one_mul] using htrans.2.symm
    · refine ⟨-v, ?_⟩
      nlinarith [htrans.2]
  have hRE : R ∣ E := by
    rcases hsign with rfl | rfl
    · refine ⟨u, ?_⟩
      simpa only [one_mul] using htrans.1.symm
    · refine ⟨-u, ?_⟩
      nlinarith [htrans.1]
  have hRgcd : R ∣ (Int.gcd E C : ℤ) := by
    first | exact Int.dvd_gcd hRE hRC | exact Int.dvd_coe_gcd hRE hRC
  have hRB : R ∣ B := hRgcd.trans hres
  have hR0 : R ≠ 0 := by
    intro hz
    rw [hz, zero_dvd_iff] at hRB
    exact hB hRB
  exact ⟨hR0, hRB⟩

private theorem second_pair_unique
    (C E d e u v u' v' h : ℤ)
    (hR0 : e ^ 4 * C - d ^ 4 * E ≠ 0)
    (hg : C * u = E * v)
    (hs : e ^ 4 * v - d ^ 4 * u = h)
    (hg' : C * u' = E * v')
    (hs' : e ^ 4 * v' - d ^ 4 * u' = h) :
    u = u' ∧ v = v' := by
