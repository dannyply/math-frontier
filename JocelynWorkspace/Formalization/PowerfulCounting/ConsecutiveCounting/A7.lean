def collarPopulation (k : ℕ) (h : ℤ) (x D E : ℝ) : Set ((ℕ × ℕ) × (ℕ × ℕ)) :=
  {q | 1 ≤ q.1.1 ∧ 1 ≤ q.1.2 ∧ 1 ≤ q.2.1 ∧ 1 ≤ q.2.2 ∧ D / 2 < (q.1.1 : ℝ) ∧ (q.1.1 : ℝ) ≤ D ∧
