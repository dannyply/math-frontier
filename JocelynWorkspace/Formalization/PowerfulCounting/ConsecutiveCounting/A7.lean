private theorem a7_nonnegative_fourth_root_bound
    (y x : ℝ) (hy : 0 ≤ y) (hpow : y ^ 4 ≤ x) :
    y ≤ x ^ (1 / 4 : ℝ) := by
  have hr := Real.rpow_le_rpow
    (by positivity : 0 ≤ y ^ (4 : ℕ)) hpow
    (by norm_num : (0 : ℝ) ≤ 1 / 4)
  have heq : (y ^ (4 : ℕ)) ^ (1 / 4 : ℝ) = y := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul hy]
    norm_num
  simpa only [heq] using hr

private theorem a7_original_axis_height_caps
    (x D E d e u v : ℝ)
