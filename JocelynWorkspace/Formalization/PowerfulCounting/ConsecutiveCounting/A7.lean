namespace A7SignedLevelMultiplicity

private def levels (J : ℤ) : Finset ℤ :=
  (J.natAbs.divisors.image (fun n : ℕ => (n : ℤ))) ∪
    (J.natAbs.divisors.image (fun n : ℕ => -((n : ℤ))))

private theorem levels_card (J : ℤ) :
    (levels J).card ≤ 2 * J.natAbs.divisors.card := by
  classical
  unfold levels
