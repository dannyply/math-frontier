  have h2 := graph_shift_transfer C E d e u' v' h hg' hs'
  constructor
  · exact mul_left_cancel₀ hR0 (h1.1.trans h2.1.symm)
  · exact mul_left_cancel₀ hR0 (h1.2.trans h2.2.symm)

private theorem divisor_fee (K : ℝ) (hK : 0 ≤ K)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ C : ℝ, 0 < C ∧ ∀ x : ℝ, 2 ≤ x →
      ∀ B : ℤ, B ≠ 0 →
        |(B : ℝ)| ≤ 13168189440000 * x ^ (20 * K) →
        (50400 : ℝ) * (B.natAbs.divisors.card : ℝ) ^ 10 ≤ C * x ^ ε := by
  let δ : ℝ := ε / (200 * K + 1)
  have hden : 0 < 200 * K + 1 := by nlinarith
  have hδ : 0 < δ := div_pos hε hden
  have hδeq : δ * (200 * K + 1) = ε :=
    div_mul_cancel₀ ε (ne_of_gt hden)
  have hexp : (20 * K) * (10 * δ) ≤ ε := by nlinarith
  obtain ⟨Cd, hCd, hdb⟩ := C01.PcLowdegRed.divisor_bound δ hδ
  let C : ℝ := 50400 * Cd ^ 10 * (13168189440000 : ℝ) ^ (10 * δ) + 1
  refine ⟨C, by dsimp [C]; positivity, ?_⟩
  intro x hx B hB hBb
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hcast : (B.natAbs : ℝ) = |(B : ℝ)| := by
    rw [← Int.cast_natCast, Int.natCast_natAbs, Int.cast_abs]
  have hD : (B.natAbs.divisors.card : ℝ) ≤ Cd * |(B : ℝ)| ^ δ := by
    have ht := hdb B.natAbs (Int.natAbs_ne_zero.mpr hB)
    rwa [hcast] at ht
  have hD8 : (B.natAbs.divisors.card : ℝ) ^ 10 ≤
      Cd ^ 10 * |(B : ℝ)| ^ (10 * δ) := by
    calc
      (B.natAbs.divisors.card : ℝ) ^ 10 ≤
          (Cd * |(B : ℝ)| ^ δ) ^ 10 :=
        pow_le_pow_left₀ (Nat.cast_nonneg _) hD _
      _ = Cd ^ 10 * |(B : ℝ)| ^ (10 * δ) := by
        rw [mul_pow]
        congr 1
        rw [← Real.rpow_natCast, ← Real.rpow_mul (abs_nonneg _)]
        congr 1
        push_cast
        ring
  have hMeta : |(B : ℝ)| ^ (10 * δ) ≤
      (13168189440000 : ℝ) ^ (10 * δ) * x ^ ε := by
    calc
      |(B : ℝ)| ^ (10 * δ) ≤ (13168189440000 * x ^ (20 * K)) ^ (10 * δ) :=
        Real.rpow_le_rpow (abs_nonneg _) hBb (by positivity)
      _ = (13168189440000 : ℝ) ^ (10 * δ) * (x ^ (20 * K)) ^ (10 * δ) :=
        Real.mul_rpow (by norm_num) (Real.rpow_nonneg hx0.le _)
      _ = (13168189440000 : ℝ) ^ (10 * δ) * x ^ ((20 * K) * (10 * δ)) := by
        rw [← Real.rpow_mul hx0.le]
      _ ≤ (13168189440000 : ℝ) ^ (10 * δ) * x ^ ε :=
        mul_le_mul_of_nonneg_left
          (Real.rpow_le_rpow_of_exponent_le hx1 hexp)
          (Real.rpow_nonneg (by norm_num) _)
  calc
    (50400 : ℝ) * (B.natAbs.divisors.card : ℝ) ^ 10 ≤
        50400 * (Cd ^ 10 * |(B : ℝ)| ^ (10 * δ)) :=
      mul_le_mul_of_nonneg_left hD8 (by norm_num)
    _ ≤ 50400 * (Cd ^ 10 * ((13168189440000 : ℝ) ^ (10 * δ) * x ^ ε)) :=
      mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left hMeta
          (pow_nonneg (by linarith : 0 ≤ Cd) _)) (by norm_num)
    _ = (50400 * Cd ^ 10 * (13168189440000 : ℝ) ^ (10 * δ)) * x ^ ε := by ring
    _ ≤ C * x ^ ε := by
      apply mul_le_mul_of_nonneg_right _ (Real.rpow_nonneg hx0.le _)
      dsimp [C]
      linarith

private theorem shift_int
    (d e u v : ℕ) (h : ℤ)
    (hs : ((e ^ 4 * v : ℕ) : ℤ) = ((d ^ 4 * u : ℕ) : ℤ) + h) :
    (e : ℤ) ^ 4 * (v : ℤ) - (d : ℤ) ^ 4 * (u : ℤ) = h := by
  push_cast at hs
  linear_combination hs

private lemma three_root_divisor_cover (hSt : StewartHyp)
    (n : ℕ) (hn9 : n ≤ 9)
    (R : MvPolynomial (Fin 2) ℤ) (hRh : R.IsHomogeneous n)
    (hR0 : R ≠ 0) (hroots : ThreeProjectiveZeros R)
    (M : ℤ) (hM : M ≠ 0) :
    ∃ T : Finset (ℤ×ℤ),
      (∀ rs : ℤ×ℤ, Int.gcd rs.1 rs.2=1 →
        eval ![rs.1,rs.2] R ∣ M → rs ∈ T) ∧
      T.card ≤ 50400*M.natAbs.divisors.card^10 := by
  classical
  obtain ⟨q,a,hq3,hqn,hcontent,hsqf,hkernel⟩ :=
    C01.PcKer.p_kernel n R hRh hR0 hroots
  have hq9 : q ≤ 9 := hqn.trans hn9
  let F : ℤ×ℤ → ℤ := fun rs =>
    ∑ i : Fin (q+1), a i*rs.1^(i:ℕ)*rs.2^(q-(i:ℕ))
  obtain ⟨T,hTmem,hTcard⟩ := C01.PcLowdegRed.count_T F q (by omega)
    (hSt q hq3 a hcontent hsqf) M hM
  refine ⟨T,?_,?_⟩
  · intro rs hp hdvd
    exact hTmem rs hp ((hkernel rs.1 rs.2).trans hdvd)
  · have hn0 : M.natAbs ≠ 0 := Int.natAbs_ne_zero.mpr hM
    have hω : 2^M.natAbs.primeFactors.card ≤ M.natAbs.divisors.card :=
      C01.PcLowdegRed.two_pow_card_primeFactors_le _ hn0
    have hqpow : q^(1+M.natAbs.primeFactors.card) ≤
        9*M.natAbs.divisors.card^9 := by
      calc
        q^(1+M.natAbs.primeFactors.card) ≤ 9^(1+M.natAbs.primeFactors.card) :=
          Nat.pow_le_pow_left hq9 _
        _ = 9*9^M.natAbs.primeFactors.card := by rw [pow_add,pow_one]
        _ ≤ 9*(2^9)^M.natAbs.primeFactors.card :=
          Nat.mul_le_mul le_rfl (Nat.pow_le_pow_left (by norm_num : 9≤2^9) _)
        _ = 9*(2^M.natAbs.primeFactors.card)^9 := by
          rw [←pow_mul,←pow_mul,Nat.mul_comm 9 M.natAbs.primeFactors.card]
        _ ≤ 9*M.natAbs.divisors.card^9 :=
          Nat.mul_le_mul le_rfl (Nat.pow_le_pow_left hω _)
    calc
      T.card ≤ M.natAbs.divisors.card*
          (2*(2800*q^(1+M.natAbs.primeFactors.card))) := hTcard
      _ ≤ M.natAbs.divisors.card*(2*(2800*(9*M.natAbs.divisors.card^9))) :=
        Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ hqpow))
      _ = 50400*M.natAbs.divisors.card^10 := by ring

private def RationalPurePower (n : ℕ) (R : MvPolynomial (Fin 2) ℤ) : Prop :=
  ∃ kappa a b : ℚ,kappa≠0 ∧ (a≠0 ∨ b≠0) ∧ ∀r s:ℚ,
    eval ![r,s] (MvPolynomial.map (Int.castRingHom ℚ) R)=kappa*(a*r+b*s)^n

private def IntegralTwoLines (n : ℕ) (R : MvPolynomial (Fin 2) ℤ) : Prop :=
  ∃c a b a' b':ℤ,∃j:ℕ,c≠0 ∧ a*b'-a'*b≠0 ∧ 1≤j ∧ j<n ∧
    R=C c*(C a*X 0+C b*X 1)^j*(C a'*X 0+C b'*X 1)^(n-j)

private theorem dehom_splits_of_not_three_odd (n : ℕ) (hnodd : Odd n) (R : MvPolynomial (Fin 2) ℤ)
    (hR : R.IsHomogeneous n) (hR0 : R ≠ 0)
    (hthree : ¬ HasThreeProjectiveZeros R) :
    ((C01.PcCurves.dehom R).map (Int.castRingHom ℚ)).Splits := by
  classical
  let f0 : Polynomial ℤ := C01.PcCurves.dehom R
  let f : Polynomial ℚ := f0.map (Int.castRingHom ℚ)
  let RC : MvPolynomial (Fin 2) ℂ := R.map (Int.castRingHom ℂ)
  have hRC : RC.IsHomogeneous n := hR.map (Int.castRingHom ℂ)
  have hf0 : f0 ≠ 0 := fun h => hR0 (C01.PcCurves.eq_zero_of_dehom hR h)
  have hinj : Function.Injective (Int.castRingHom ℚ) := RingHom.injective_int _
  have hf : f ≠ 0 := (Polynomial.map_ne_zero_iff hinj).mpr hf0
  have hdeg : f.natDegree = f0.natDegree :=
    Polynomial.natDegree_map_eq_of_injective hinj f0
  have hcomp : (algebraMap ℚ ℂ).comp (Int.castRingHom ℚ) =
      Int.castRingHom ℂ := by
    ext n ; simp
  have hvec : ∀ z : ℂ, Polynomial.eval₂ (algebraMap ℚ ℂ) z f = 0 →
      MvPolynomial.eval (pointVector (some z)) RC = 0 := by
    intro z hz
    have hz' : Polynomial.eval₂ (Int.castRingHom ℂ) z f0 = 0 := by
      simpa only [f, Polynomial.eval₂_map, hcomp] using hz
    change MvPolynomial.eval ![z, 1] RC = 0
    rw [← C01.PcCurves.dehom_eval hRC, C01.PcRes.dehom_map hR,
      Polynomial.eval_map]
    exact hz'
  have hrep : ∀ z : ℂ, Polynomial.eval₂ (algebraMap ℚ ℂ) z f = 0 →
      MvPolynomial.eval (projectivePoint (some z)).rep RC = 0 := by
    intro z hz
    exact eval_projectivePoint_rep_zero RC n hRC (some z) (hvec z hz)
  have htwo : AtMostTwoRoots f := by
    intro z₁ z₂ z₃ hz₁ hz₂ hz₃
    by_contra hn
    have h12 : z₁ ≠ z₂ := by intro h; exact hn (Or.inl h)
    have h13 : z₁ ≠ z₃ := by intro h; exact hn (Or.inr (Or.inl h))
    have h23 : z₂ ≠ z₃ := by intro h; exact hn (Or.inr (Or.inr h))
    apply hthree
    refine ⟨projectivePoint (some z₁), projectivePoint (some z₂),
      projectivePoint (some z₃), ?_, ?_, ?_, hrep z₁ hz₁, hrep z₂ hz₂, hrep z₃ hz₃⟩
    · intro h
      exact h12 (Option.some.inj (projectivePoint_injective h))
    · intro h
      exact h13 (Option.some.inj (projectivePoint_injective h))
    · intro h
      exact h23 (Option.some.inj (projectivePoint_injective h))
  by_cases h7 : f0.natDegree = n
  · have hodd : Odd f.natDegree := by
      rw [hdeg, h7]
      exact hnodd
    exact odd_two_root_splits f hf hodd htwo
  · have hle : f0.natDegree ≤ n := C01.PcCurves.dehom_natDegree_le hR
    have hlt : f0.natDegree < n := by omega
    have hc7 : f0.coeff n = R.coeff (C01.PcCurves.ex n 0) := by
      simpa only [f0, Nat.sub_self, if_pos (le_refl n)] using
        (C01.PcCurves.dehom_coeff hR n)
    have hc0 : R.coeff (C01.PcCurves.ex n 0) = 0 := by
      rw [← hc7]
      exact Polynomial.coeff_eq_zero_of_natDegree_lt hlt
    have hinf : MvPolynomial.eval (pointVector none) RC = 0 := by
      change MvPolynomial.eval ![1, 0] RC = 0
      rw [C01.PcCurves.eval_one_zero hRC, MvPolynomial.coeff_map]
      simp only [hc0, map_zero]
    have hinfrep : MvPolynomial.eval (projectivePoint none).rep RC = 0 :=
      eval_projectivePoint_rep_zero RC n hRC none hinf
    have hone : ∀ z w : ℂ,
        Polynomial.eval₂ (algebraMap ℚ ℂ) z f = 0 →
        Polynomial.eval₂ (algebraMap ℚ ℂ) w f = 0 → z = w := by
      intro z w hz hw
      by_contra hzw
      apply hthree
      refine ⟨projectivePoint none, projectivePoint (some z),
        projectivePoint (some w), ?_, ?_, ?_, hinfrep, hrep z hz, hrep w hw⟩
      · intro h
        have h' := projectivePoint_injective h
        simp at h'
      · intro h
        have h' := projectivePoint_injective h
        simp at h'
      · intro h
        exact hzw (Option.some.inj (projectivePoint_injective h))
    exact one_root_splits f hf hone

private theorem binary_integer_linear_factorization
    (n : ℕ) (R : MvPolynomial (Fin 2) ℤ) (hR : R.IsHomogeneous n) (hR0 : R ≠ 0)
    (hsplit : ((C01.PcCurves.dehom R).map (Int.castRingHom ℚ)).Splits) :
    ∃ c : ℤ, c ≠ 0 ∧ ∃ s : Multiset (Option ℚ),
      s.card = n ∧ R = MvPolynomial.C c * (s.map labelLine).prod := by
  classical
  let f : Polynomial ℤ := C01.PcCurves.dehom R
  have hf : f ≠ 0 := fun h => hR0 (C01.PcCurves.eq_zero_of_dehom hR h)
  obtain ⟨c, hc, roots, hcard, hfac, hroots⟩ :=
    integer_linear_factorization f hf hsplit
  let s : Multiset (Option ℚ) :=
    roots.map some + Multiset.replicate (n - f.natDegree) none
  have hle : f.natDegree ≤ n := C01.PcCurves.dehom_natDegree_le hR
  have hs : s.card = n := by
    simp only [s, Multiset.card_add, Multiset.card_map, Multiset.card_replicate,
      hcard]
    omega
  have hdehomprod : (s.map labelPoly).prod = (roots.map rationalLinear).prod := by
    simp [s, Multiset.map_add, Multiset.prod_add, Multiset.map_map,
      Function.comp_def, labelPoly]
  let B : MvPolynomial (Fin 2) ℤ := MvPolynomial.C c * (s.map labelLine).prod
  have hB : B.IsHomogeneous n := by
    simpa only [B, hs, zero_add] using
      (MvPolynomial.isHomogeneous_C (Fin 2) c).mul (label_product_homogeneous s)
  have hdehom : C01.PcCurves.dehom B = f := by
    rw [show C01.PcCurves.dehom B =
      C01.PcCurves.dehom (MvPolynomial.C c) *
        C01.PcCurves.dehom ((s.map labelLine).prod) from
      C01.PcCurves.dehom_mul _ _]
    rw [label_product_dehom, hdehomprod]
    have hconst : C01.PcCurves.dehom (MvPolynomial.C c : MvPolynomial (Fin 2) ℤ) =
        Polynomial.C c := by simp [C01.PcCurves.dehom]
    rw [hconst]
    exact hfac.symm
  have hsub : C01.PcCurves.dehom (R - B) = 0 := by
    rw [C01.PcCurves.dehom_sub, hdehom]
    exact sub_self f
  have heq : R = B := sub_eq_zero.mp
    (C01.PcCurves.eq_zero_of_dehom (hR.sub hB) hsub)
  exact ⟨c, hc, s, hs, heq⟩

private theorem factored_label_projective_zero
    (n : ℕ) (R : MvPolynomial (Fin 2) ℤ) (hR : R.IsHomogeneous n)
    (c : ℤ) (s : Multiset (Option ℚ))
    (hfac : R = MvPolynomial.C c * (s.map labelLine).prod)
    (z : Option ℚ) (hz : z ∈ s) :
    MvPolynomial.eval (projectivePoint (labelToComplex z)).rep
      (R.map (Int.castRingHom ℂ)) = 0 := by
  apply eval_projectivePoint_rep_zero _ n (hR.map (Int.castRingHom ℂ))
  rw [hfac, map_mul, MvPolynomial.eval_mul,
    label_product_root s z hz, mul_zero]

private theorem twoSupportProduct {M : Type*} [CommMonoid M] (n : ℕ) (s : Multiset (Option ℚ)) (a b : Option ℚ) (hcard : s.card = n)
    (ha : a ∈ s) (hb : b ∈ s) (hne : a ≠ b)
    (hcover : ∀ x ∈ s, x = a ∨ x = b) :
    ∃ j : ℕ, 1 ≤ j ∧ j < n ∧
      ∀ f : Option ℚ → M, (s.map f).prod = f a ^ j * f b ^ (n - j) := by
  obtain ⟨j, hj, haj, hbj, hprod⟩ :=
    binarySupportProduct (M := M) a b hne s hcover
  refine ⟨j, ?_, ?_, ?_⟩
  · exact haj ha
  · have hlt := hbj hb
    omega
  · intro f
    simpa only [hcard] using hprod f

private theorem split_binary_classification
    (n : ℕ) (hn : 1 ≤ n) (R : MvPolynomial (Fin 2) ℤ)
    (hR : R.IsHomogeneous n) (hR0 : R ≠ 0)
    (hthree : ¬ HasThreeProjectiveZeros R)
    (hsplit : ((C01.PcCurves.dehom R).map (Int.castRingHom ℚ)).Splits) :
    RationalPurePower n R ∨ IntegralTwoLines n R := by
  classical
  obtain ⟨c, hc, labels, hcard, hfac⟩ :=
    binary_integer_linear_factorization n R hR hR0 hsplit
  obtain ⟨a, ha⟩ := FormalAB.S84900580.A5PrivateOddRoot.multiset_has_member labels (by omega)
  by_cases hone : ∀ z ∈ labels, z = a
  · have hp : R = MvPolynomial.C c * FormalAB.S84900580.A5PrivateOddRoot.labelLine a ^ n := by
      rw [hfac, FormalAB.S84900580.A5PrivateOddRoot.label_product_eq_pow labels a hone, hcard]
    left
    refine ⟨(c : ℚ), (FormalAB.S84900580.A5PrivateOddRoot.lineCoeffA a : ℚ),
      (FormalAB.S84900580.A5PrivateOddRoot.lineCoeffB a : ℚ), ?_, ?_, ?_⟩
    · exact_mod_cast hc
    · rcases FormalAB.S84900580.A5PrivateOddRoot.label_coeff_nonzero a with ha' | hb'
      · left; exact_mod_cast ha'
      · right; exact_mod_cast hb'
    · intro r s
      rw [hp]
      simp [FormalAB.S84900580.A5PrivateOddRoot.labelLine]
  · push Not at hone
    obtain ⟨b, hb, hba⟩ := hone
    have hab : a ≠ b := Ne.symm hba
    have hproj : Function.Injective (fun z : Option ℚ =>
        FormalAB.S84900580.A5PrivateOddRoot.projectivePoint (FormalAB.S84900580.A5PrivateOddRoot.labelToComplex z)) :=
      FormalAB.S84900580.A5PrivateOddRoot.projectivePoint_injective.comp
        FormalAB.S84900580.A5PrivateOddRoot.labelToComplex_injective
    have hzero : ∀ z ∈ labels,
        MvPolynomial.eval
          (FormalAB.S84900580.A5PrivateOddRoot.projectivePoint
            (FormalAB.S84900580.A5PrivateOddRoot.labelToComplex z)).rep
          (R.map (Int.castRingHom ℂ)) = 0 :=
      factored_label_projective_zero n R hR c labels hfac
    have hcover : ∀ z ∈ labels, z = a ∨ z = b := by
      intro z hz
      by_cases hza : z = a
      · exact Or.inl hza
      by_cases hzb : z = b
      · exact Or.inr hzb
      exfalso
      apply hthree
      refine ⟨FormalAB.S84900580.A5PrivateOddRoot.projectivePoint (FormalAB.S84900580.A5PrivateOddRoot.labelToComplex a),
        FormalAB.S84900580.A5PrivateOddRoot.projectivePoint (FormalAB.S84900580.A5PrivateOddRoot.labelToComplex b),
        FormalAB.S84900580.A5PrivateOddRoot.projectivePoint (FormalAB.S84900580.A5PrivateOddRoot.labelToComplex z),
        ?_, ?_, ?_, hzero a ha, hzero b hb, hzero z hz⟩
      · exact fun he => hab (hproj he)
      · exact fun he => hza (hproj he).symm
      · exact fun he => hzb (hproj he).symm
    obtain ⟨j, hj, hj6, hprod⟩ :=
      twoSupportProduct (M := MvPolynomial (Fin 2) ℤ)
        n labels a b hcard ha hb hab hcover
    right
    refine ⟨c, FormalAB.S84900580.A5PrivateOddRoot.lineCoeffA a, FormalAB.S84900580.A5PrivateOddRoot.lineCoeffB a,
      FormalAB.S84900580.A5PrivateOddRoot.lineCoeffA b, FormalAB.S84900580.A5PrivateOddRoot.lineCoeffB b,
      j, hc, FormalAB.S84900580.A5PrivateOddRoot.label_coeff_independent a b hab,
      hj, hj6, ?_⟩
    rw [hfac, hprod FormalAB.S84900580.A5PrivateOddRoot.labelLine]
    simp only [FormalAB.S84900580.A5PrivateOddRoot.labelLine, mul_assoc]

private theorem odd_binary_classification (n : ℕ) (hn : 1≤n) (hnodd : Odd n)
    (R : MvPolynomial (Fin 2) ℤ) (hR : R.IsHomogeneous n) (hR0 : R≠0) :
    ThreeProjectiveZeros R ∨ RationalPurePower n R ∨ IntegralTwoLines n R := by
  classical
  by_cases ht : HasThreeProjectiveZeros R
  · exact Or.inl ht
  · exact Or.inr (split_binary_classification n hn R hR hR0 ht
      (dehom_splits_of_not_three_odd n hnodd R hR hR0 ht))
private lemma two_linear_divisor_cover (n : ℕ) (R : MvPolynomial (Fin 2) ℤ)
    (hR : IntegralTwoLines n R) (M : ℤ) (hM : M ≠ 0) :
    ∃ T : Finset (ℤ×ℤ),
      (∀ rs : ℤ×ℤ, Int.gcd rs.1 rs.2=1 →
        eval ![rs.1,rs.2] R ∣ M → rs ∈ T) ∧
      T.card ≤ 4*M.natAbs.divisors.card^2 := by
  classical
  obtain ⟨c,a,b,a',b',j,hc,hdet,hj,hjn,hfac⟩ := hR
  let φ : ℤ×ℤ → ℤ×ℤ := fun rs => (a*rs.1+b*rs.2,a'*rs.1+b'*rs.2)
  let S : Set (ℤ×ℤ) :=
    {rs | Int.gcd rs.1 rs.2=1 ∧ eval ![rs.1,rs.2] R ∣ M}
  let U := (signedDivisors M) ×ˢ (signedDivisors M)
  have hφ := linear_pair_injective a b a' b' hdet
  have hmap : ∀ rs ∈ S, φ rs ∈ (↑U : Set (ℤ×ℤ)) := by
    intro rs hrs
    have heval : eval ![rs.1,rs.2] R =
        c*(a*rs.1+b*rs.2)^j*(a'*rs.1+b'*rs.2)^(n-j) := by
      rw [hfac]
      simp []
    have h1 : a*rs.1+b*rs.2 ∣ eval ![rs.1,rs.2] R := by
      rw [heval]
      exact dvd_mul_of_dvd_left
        (dvd_mul_of_dvd_right (dvd_pow_self _ (by omega : j ≠ 0)) c) _
    have h2 : a'*rs.1+b'*rs.2 ∣ eval ![rs.1,rs.2] R := by
      rw [heval]
      exact dvd_mul_of_dvd_right
        (dvd_pow_self _ (by omega : n-j ≠ 0)) _
    exact Finset.mem_product.mpr
      ⟨mem_signedDivisors M _ hM (h1.trans hrs.2),
       mem_signedDivisors M _ hM (h2.trans hrs.2)⟩
  have himg : (φ '' S).Finite :=
    (Finset.finite_toSet U).subset (by rintro _ ⟨rs,hrs,rfl⟩; exact hmap rs hrs)
  have hfin : S.Finite := Set.Finite.of_finite_image himg hφ.injOn
  refine ⟨hfin.toFinset,?_,?_⟩
  · intro rs hp hdvd
    exact hfin.mem_toFinset.mpr ⟨hp,hdvd⟩
  · have hs : S.ncard ≤ U.card := by
      calc
        S.ncard ≤ (↑U : Set (ℤ×ℤ)).ncard :=
          Set.ncard_le_ncard_of_injOn φ hmap hφ.injOn (Finset.finite_toSet U)
        _ = U.card := Set.ncard_coe_finset U
    rw [← Set.ncard_eq_toFinset_card S hfin]
    calc
      S.ncard ≤ U.card := hs
      _ = (signedDivisors M).card*(signedDivisors M).card := Finset.card_product _ _
      _ ≤ (2*M.natAbs.divisors.card)*(2*M.natAbs.divisors.card) :=
        Nat.mul_le_mul (signedDivisors_card M) (signedDivisors_card M)
      _ = 4*M.natAbs.divisors.card^2 := by ring

private lemma three_or_two_cover (hSt : StewartHyp) (n:ℕ) (hn:n≤9)
    (R:MvPolynomial (Fin 2) ℤ) (hRh:R.IsHomogeneous n) (hR0:R≠0)
    (halt:ThreeProjectiveZeros R ∨ IntegralTwoLines n R) (B:ℤ) (hB:B≠0) :
    ∃T:Finset (ℤ×ℤ),(∀rs:ℤ×ℤ,Int.gcd rs.1 rs.2=1 →
      eval ![rs.1,rs.2] R∣B → rs∈T) ∧ T.card≤50400*B.natAbs.divisors.card^10 := by
  rcases halt with hthree|htwo
  · exact three_root_divisor_cover hSt n hn R hRh hR0 hthree B hB
  · obtain ⟨T,hT,hcard⟩ := two_linear_divisor_cover n R htwo B hB
    refine ⟨T,hT,?_⟩
    have h1 : 1≤B.natAbs.divisors.card :=
      Nat.one_le_iff_ne_zero.mpr (by
        intro hz
        have hm := Nat.one_mem_divisors.mpr (Int.natAbs_ne_zero.mpr hB)
        have he : B.natAbs.divisors=∅ := Finset.card_eq_zero.mp hz
        simpa [he] using hm)
    have hp : B.natAbs.divisors.card^2≤B.natAbs.divisors.card^10 :=
      Nat.pow_le_pow_right h1 (by omega)
    exact hcard.trans (by nlinarith)

private abbrev idx (i j k l : ℕ) : Fin 4 →₀ ℕ :=
  Finsupp.single 0 i + Finsupp.single 1 j + Finsupp.single 2 k + Finsupp.single 3 l

private theorem block_coeff (G : MvPolynomial (Fin 4) ℤ) (a i j : ℕ)
    (hG : ∀ m ∈ G.support, m 0+m 1=a ∧ m 2+m 3=1) :
    (C01.PcParam.PP G).coeff (C01.PcCurves.ex i j) = G.coeff (idx i j 1 0) ∧
    (C01.PcParam.QQ G).coeff (C01.PcCurves.ex i j) = G.coeff (idx i j 0 1) := by
  classical
  constructor
  · unfold C01.PcParam.PP
    simp only [coeff_sum, C01.PcCurves.monomial_ex, coeff_monomial]
    rw [Finset.sum_eq_single (idx i j 1 0)]
    · simp [idx, C01.PcCurves.ex]
    · intro m hm hne
      rw [if_neg]
      intro he
      have h0 : m 0=i := by simpa using congrArg (fun f => f 0) he
      have h1 : m 1=j := by simpa using congrArg (fun f => f 1) he
      obtain ⟨hmS,hm2⟩ := Finset.mem_filter.mp hm
      have hm3 : m 3=0 := by have ht := (hG m hmS).2; omega
      apply hne
      ext t
      fin_cases t <;> simp [idx] <;> omega
    · intro hn
      have hc : G.coeff (idx i j 1 0)=0 := by
        by_contra hc
        apply hn
        exact Finset.mem_filter.mpr ⟨mem_support_iff.mpr hc,by simp [idx]⟩
      simp [hc]
  · unfold C01.PcParam.QQ
    simp only [coeff_sum, C01.PcCurves.monomial_ex, coeff_monomial]
    rw [Finset.sum_eq_single (idx i j 0 1)]
    · simp [idx, C01.PcCurves.ex]
    · intro m hm hne
      rw [if_neg]
      intro he
      have h0 : m 0=i := by simpa using congrArg (fun f => f 0) he
      have h1 : m 1=j := by simpa using congrArg (fun f => f 1) he
      obtain ⟨hmS,hm2⟩ := Finset.mem_filter.mp hm
      have hm20 : m 2=0 := by have ht := (hG m hmS).2; omega
      have hm3 : m 3=1 := by have ht := (hG m hmS).2; omega
      apply hne
      ext t
      fin_cases t <;> simp [idx] <;> omega
    · intro hn
      have hc : G.coeff (idx i j 0 1)=0 := by
        by_contra hc
        apply hn
        exact Finset.mem_filter.mpr ⟨mem_support_iff.mpr hc,by simp [idx]⟩
      simp [hc]

private def canonicalP (G : MvPolynomial (Fin 4) ℤ) (a : ℕ) : MvPolynomial (Fin 2) ℤ :=
  ∑ i ∈ Finset.range (a+1), C (G.coeff (idx i (a-i) 1 0))*X 0^i*X 1^(a-i)

private def canonicalQ (G : MvPolynomial (Fin 4) ℤ) (a : ℕ) : MvPolynomial (Fin 2) ℤ :=
  ∑ i ∈ Finset.range (a+1), C (-G.coeff (idx i (a-i) 0 1))*X 0^i*X 1^(a-i)

private theorem canonical_blocks (G : MvPolynomial (Fin 4) ℤ) (a : ℕ)
    (hG : ∀ m ∈ G.support, m 0+m 1=a ∧ m 2+m 3=1) :
    canonicalP G a=C01.PcParam.PP G ∧ canonicalQ G a= -C01.PcParam.QQ G := by
  constructor
  · rw [C01.PcCurves.hom_repr (C01.PcParam.PP_hom G a hG)]
    unfold canonicalP
    apply Finset.sum_congr rfl
    intro i hi
    rw [(block_coeff G a i (a-i) hG).1]
  · rw [C01.PcCurves.hom_repr (C01.PcParam.QQ_hom G a hG),←Finset.sum_neg_distrib]
    unfold canonicalQ
    apply Finset.sum_congr rfl
    intro i hi
    rw [(block_coeff G a i (a-i) hG).2]
    simp

private def residual (G : MvPolynomial (Fin 4) ℤ) : MvPolynomial (Fin 2) ℤ :=
  X 1^4*C01.PcParam.PP G+X 0^4*C01.PcParam.QQ G

private theorem generic_graph_data (G : MvPolynomial (Fin 4) ℤ) (a : ℕ)
    (hG : ∀ m ∈ G.support, m 0+m 1=a ∧ m 2+m 3=1)
    (hi : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G))
    (H : ℝ) (hH : 0≤H)
    (hc : ∀m : Fin 4 →₀ ℕ,|((G.coeff m:ℤ):ℝ)|≤H) :
    (C01.PcParam.PP G).IsHomogeneous a ∧
    (-C01.PcParam.QQ G).IsHomogeneous a ∧
    (∀m : Fin 2 →₀ ℕ, |(((C01.PcParam.PP G).coeff m:ℤ):ℝ)|≤H ∧
      |(((-C01.PcParam.QQ G).coeff m:ℤ):ℝ)|≤H) ∧
    (∀w : Fin 2 → ℂ,w≠0 →
      eval w (MvPolynomial.map (Int.castRingHom ℂ) (C01.PcParam.PP G))=0 →
      eval w (MvPolynomial.map (Int.castRingHom ℂ) (-C01.PcParam.QQ G))=0 → False) := by
  have hP := C01.PcParam.PP_hom G a hG
  have hQ := C01.PcParam.QQ_hom G a hG
  refine ⟨hP,hQ.neg,?_,?_⟩
  · intro m
    refine ⟨C01.PcParam.PP_coeff G a hG H hH hc m,?_⟩
    simpa using C01.PcParam.QQ_coeff G a hG H hH hc m
  · intro w hw hp hq
    have hq' : eval w (MvPolynomial.map (Int.castRingHom ℂ) (C01.PcParam.QQ G))=0 := by
      simpa using hq
    exact C01.PcCurves.no_common_zero (hP.map (Int.castRingHom ℂ))
      (hQ.map (Int.castRingHom ℂ)) (C01.PcParam.relprime_core G a hG hi) hw hp hq'

private theorem graph_eval (G : MvPolynomial (Fin 4) ℤ) (a : ℕ)
    (hG : ∀m∈G.support,m 0+m 1=a ∧ m 2+m 3=1) (d e u v : ℤ)
    (hz : eval ![d,e,u,v] G=0) :
    eval ![d,e] (C01.PcParam.PP G)*u =
      eval ![d,e] (-C01.PcParam.QQ G)*v := by
  rw [C01.PcParam.lin_eval G a hG d e u v] at hz
  simp only [map_neg]
  linear_combination hz

private theorem residual_homogeneous (G : MvPolynomial (Fin 4) ℤ) (a : ℕ)
    (hG : ∀m∈G.support,m 0+m 1=a ∧ m 2+m 3=1) :
    (residual G).IsHomogeneous (a+4) := by
  have hP := (isHomogeneous_X ℤ (1:Fin 2)).pow 4
  have hQ := (isHomogeneous_X ℤ (0:Fin 2)).pow 4
  have ht := (hP.mul (C01.PcParam.PP_hom G a hG)).add
    (hQ.mul (C01.PcParam.QQ_hom G a hG))
  simpa [residual,Nat.add_comm] using ht

private theorem sum_single_bound (N : ℕ) (f : ℕ → Fin 2 →₀ ℕ)
    (hf : Function.Injective f) (a : ℕ → ℤ) (H : ℝ) (hH : 0≤H)
    (ha : ∀i∈Finset.range N,|((a i:ℤ):ℝ)|≤H) (m : Fin 2 →₀ ℕ) :
    |((∑i∈Finset.range N,if f i=m then a i else 0 : ℤ):ℝ)|≤H := by
  classical
  by_cases hex : ∃i∈Finset.range N,f i=m
  · obtain ⟨i,hi,him⟩ := hex
    rw [Finset.sum_eq_single i]
    · simpa [him] using ha i hi
    · intro j hj hji
      rw [if_neg (fun h => hji (hf (h.trans him.symm)))]
    · exact fun h => (h hi).elim
  · have he : (∑i∈Finset.range N,if f i=m then a i else 0 : ℤ) = 0 := by
      apply Finset.sum_eq_zero
      intro i hi
      exact if_neg (fun h => hex ⟨i,hi,h⟩)
    rw [he,Int.cast_zero,abs_zero]
    exact hH

private theorem shifted_coeff_bound (F : MvPolynomial (Fin 2) ℤ) (n : ℕ)
    (hF : F.IsHomogeneous n) (j : Fin 2) (H : ℝ) (hH : 0≤H)
    (hc : ∀m : Fin 2 →₀ ℕ,|((F.coeff m:ℤ):ℝ)|≤H) :
    ∀m : Fin 2 →₀ ℕ,|((((X j^4*F).coeff m:ℤ):ℝ))|≤H := by
  classical
  intro m
  rw [C01.PcCurves.hom_repr hF,Finset.mul_sum]
  let f : ℕ → Fin 2 →₀ ℕ := fun i =>
    Finsupp.single j 4+C01.PcCurves.ex i (n-i)
  have hf : Function.Injective f := by
    intro i k he
    have h0 := congrArg (fun t : Fin 2 →₀ ℕ => t 0) he
    simp only [f,Finsupp.add_apply,C01.PcCurves.ex_zero] at h0
    omega
  have he : ∀i:ℕ,
      X j^4*(C (F.coeff (C01.PcCurves.ex i (n-i)))*X 0^i*X 1^(n-i)) =
        monomial (f i) (F.coeff (C01.PcCurves.ex i (n-i))) := by
    intro i
    rw [C01.PcCurves.monomial_ex,X_pow_eq_monomial,monomial_mul]
    simp only [one_mul]
    rfl
  simp_rw [he]
  simp only [coeff_sum,coeff_monomial]
  exact sum_single_bound (n+1) f hf
    (fun i => F.coeff (C01.PcCurves.ex i (n-i))) H hH (fun i hi => hc _) m

private theorem residual_coeff_bound (G : MvPolynomial (Fin 4) ℤ) (a : ℕ)
    (hG : ∀m∈G.support,m 0+m 1=a ∧ m 2+m 3=1)
    (H : ℝ) (hH : 0≤H)
    (hc : ∀m : Fin 4 →₀ ℕ,|((G.coeff m:ℤ):ℝ)|≤H) :
    ∀m : Fin 2 →₀ ℕ,|(((residual G).coeff m:ℤ):ℝ)|≤2*H := by
  intro m
  have hp := shifted_coeff_bound _ a (C01.PcParam.PP_hom G a hG) 1 H hH
    (C01.PcParam.PP_coeff G a hG H hH hc) m
  have hq := shifted_coeff_bound _ a (C01.PcParam.QQ_hom G a hG) 0 H hH
    (C01.PcParam.QQ_coeff G a hG H hH hc) m
  dsimp only [residual]
  rw [coeff_add,Int.cast_add]
  have hpabs := abs_le.mp (le_refl |((((X (1:Fin 2)^4*C01.PcParam.PP G).coeff m:ℤ):ℝ))|)
  have hqabs := abs_le.mp (le_refl |((((X (0:Fin 2)^4*C01.PcParam.QQ G).coeff m:ℤ):ℝ))|)
  apply abs_le.mpr
  constructor <;> linarith

private def rationalP (a : ℕ) (G : MvPolynomial (Fin 4) ℤ) : MvPolynomial (Fin 2) ℚ :=
  ∑ i : Fin (a+1), C (((G.coeff (idx (i:ℕ) (a-(i:ℕ)) 1 0)) : ℤ) : ℚ) *
    X 0^(i:ℕ)*X 1^(a-(i:ℕ))

private def rationalQ (a : ℕ) (G : MvPolynomial (Fin 4) ℤ) : MvPolynomial (Fin 2) ℚ :=
  -(∑ i : Fin (a+1), C (((G.coeff (idx (i:ℕ) (a-(i:ℕ)) 0 1)) : ℤ) : ℚ) *
    X 0^(i:ℕ)*X 1^(a-(i:ℕ)))

private def rationalResidual (a : ℕ) (G : MvPolynomial (Fin 4) ℤ) :
    MvPolynomial (Fin 2) ℚ :=
  X 1^4*rationalP a G-X 0^4*rationalQ a G

private theorem rational_blocks_map (G : MvPolynomial (Fin 4) ℤ) (a : ℕ)
    (ha : a=1 ∨ a=3 ∨ a=5)
    (hG : ∀m∈G.support,m 0+m 1=a ∧ m 2+m 3=1) :
    rationalP a G=MvPolynomial.map (Int.castRingHom ℚ) (C01.PcParam.PP G) ∧
    rationalQ a G=MvPolynomial.map (Int.castRingHom ℚ) (-C01.PcParam.QQ G) := by
  have hb := canonical_blocks G a hG
  constructor
  · rw [←hb.1]
    rcases ha with rfl|rfl|rfl <;>
      simp [rationalP,canonicalP,Fin.sum_univ_succ,Finset.sum_range_succ] <;> ring
  · rw [←hb.2]
    rcases ha with rfl|rfl|rfl <;>
      simp [rationalQ,canonicalQ,Fin.sum_univ_succ,Finset.sum_range_succ] <;> ring

private theorem rational_residual_map (G : MvPolynomial (Fin 4) ℤ) (a : ℕ)
    (ha : a=1 ∨ a=3 ∨ a=5)
    (hG : ∀m∈G.support,m 0+m 1=a ∧ m 2+m 3=1) :
    rationalResidual a G=MvPolynomial.map (Int.castRingHom ℚ) (residual G) := by
  obtain ⟨hp,hq⟩ := rational_blocks_map G a ha hG
  dsimp only [rationalResidual]
  rw [hp,hq]
  simp [residual]

private theorem complete_internal_count (hSt : StewartHyp)
    (K : ℝ) (hK : 0≤K) (epsilon : ℝ) (hepsilon : 0<epsilon) :
    ∃C:ℝ,0<C ∧ ∀x:ℝ,2≤x → ∀alpha:ℕ,(alpha=1 ∨ alpha=3 ∨ alpha=5) →
      ∀G:MvPolynomial (Fin 4) ℤ,G≠0 →
      (∀m∈G.support,m 0+m 1=alpha ∧ m 2+m 3=1) →
      Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G) →
      (∀m:Fin 4 →₀ ℕ,|((G.coeff m:ℤ):ℝ)|≤x^K) →
      residual G≠0 → ¬ RationalPurePower (alpha+4) (residual G) →
      let S:Set ((ℕ×ℕ)×(ℕ×ℕ)) :=
        {z|1≤z.1.1 ∧ 1≤z.1.2 ∧ 1≤z.2.1 ∧ 1≤z.2.2 ∧
          z.1.2^4*z.2.2=z.1.1^4*z.2.1+1 ∧
          ((z.1.1^4*z.2.1:ℕ):ℝ)≤x ∧
          eval ![(z.1.1:ℤ),(z.1.2:ℤ),(z.2.1:ℤ),(z.2.2:ℤ)] G=0};
      S.Finite ∧ (S.ncard:ℝ)≤C*x^epsilon := by
  classical
  obtain ⟨C,hC,hfee⟩ := divisor_fee K hK epsilon hepsilon
  refine ⟨C,hC,?_⟩
  intro x hx alpha halpha G hG0 hbi hi hheight hR0 hnpure
  let S:Set ((ℕ×ℕ)×(ℕ×ℕ)) :=
    {z|1≤z.1.1 ∧ 1≤z.1.2 ∧ 1≤z.2.1 ∧ 1≤z.2.2 ∧
      z.1.2^4*z.2.2=z.1.1^4*z.2.1+1 ∧
      ((z.1.1^4*z.2.1:ℕ):ℝ)≤x ∧
      eval ![(z.1.1:ℤ),(z.1.2:ℤ),(z.2.1:ℤ),(z.2.2:ℤ)] G=0}
  change S.Finite ∧ (S.ncard:ℝ)≤C*x^epsilon
  have hx0 : 0<x := by linarith
  have hx1 : 1≤x := by linarith
  have hH : 1≤x^K := Real.one_le_rpow hx1 hK
  have halpha1 : 1≤alpha := by rcases halpha with h|h|h <;> omega
  let P := C01.PcParam.PP G
  let Q := -C01.PcParam.QQ G
  obtain ⟨hP,hQ,hcoeff,hno⟩ := generic_graph_data G alpha hbi hi (x^K)
    (by linarith) hheight
  have hgraph := graph_eval G alpha hbi
  obtain ⟨Bres,hBres,hBbound,hBdiv⟩ :=
    resultant_of_no_common_zero alpha halpha1 P Q hP hQ hno (x^K) hH hcoeff
  have hfac : (((2*alpha).factorial:ℝ)^2)≤13168189440000 := by
    rcases halpha with h|h|h <;> subst alpha <;> norm_num
  have hpow : (x^K)^(4*alpha)≤x^(20*K) := by
    have hn : 4*alpha≤20 := by rcases halpha with h|h|h <;> omega
    calc
      (x^K)^(4*alpha)≤(x^K)^20 := pow_le_pow_right₀ hH hn
      _ = x^(20*K) := by
        rw [←Real.rpow_natCast,←Real.rpow_mul hx0.le]
        congr 1
        push_cast
        ring
  have hBcap : |(Bres:ℝ)|≤13168189440000*x^(20*K) :=
    hBbound.trans (mul_le_mul hfac hpow (by positivity) (by norm_num))
  let R := residual G
  have hRh : R.IsHomogeneous (alpha+4) := residual_homogeneous G alpha hbi
  have hvalue : ∀ d e : ℤ,
      eval ![d,e] R=e^4*eval ![d,e] P-d^4*eval ![d,e] Q := by
    intro d e
    simp [R, residual, P, Q]
  have hinfo : ∀ z ∈ S, z.1.1.Coprime z.1.2 ∧
      eval ![(z.1.1:ℤ),(z.1.2:ℤ)] R ≠ 0 ∧
      eval ![(z.1.1:ℤ),(z.1.2:ℤ)] R ∣ Bres := by
    rintro ⟨⟨d,e⟩,⟨u,v⟩⟩ hz
    rcases hz with ⟨hd,he,hu,hv,hunit,hcut,hG⟩
    have hshift : ((e^4*v:ℕ):ℤ)=((d^4*u:ℕ):ℤ)+1 := by exact_mod_cast hunit
    have hcop := (both_coprime4 d e u v 1 (Or.inl rfl) hshift).1
    have hcopZ : Int.gcd (d:ℤ) (e:ℤ)=1 := by simpa using hcop.gcd_eq_one
    have hg := hgraph d e u v hG
    have hs := shift_int d e u v 1 hshift
    have hres : (Int.gcd (eval ![(d:ℤ),(e:ℤ)] Q)
        (eval ![(d:ℤ),(e:ℤ)] P):ℤ) ∣ Bres := by
      simpa only [Int.gcd_comm] using hBdiv d e hcopZ
    obtain ⟨hn,hdvd⟩ := graph_value_divides_resultant
      (eval ![(d:ℤ),(e:ℤ)] P) (eval ![(d:ℤ),(e:ℤ)] Q)
      d e u v 1 Bres (Or.inl rfl) hg hs hres hBres
    exact ⟨hcop, by simpa only [hvalue] using hn, by simpa only [hvalue] using hdvd⟩
  have hOdd : Odd (alpha+4) := by
    rcases halpha with rfl|rfl|rfl <;> norm_num
  have hAlt : ThreeProjectiveZeros R ∨ IntegralTwoLines (alpha+4) R := by
    rcases odd_binary_classification (alpha+4) (by omega) hOdd R hRh hR0 with
      hthree|hpure|htwo
    · exact Or.inl hthree
    · exact (hnpure hpure).elim
    · exact Or.inr htwo
  obtain ⟨T,hT,hcard⟩ := three_or_two_cover hSt (alpha+4)
    (by rcases halpha with h|h|h <;> omega) R hRh hR0 hAlt Bres hBres
  have hTmap : ∀ z ∈ S, ((z.1.1:ℤ),(z.1.2:ℤ)) ∈ T := by
    intro z hz
    exact hT _ (by simpa using (hinfo z hz).1.gcd_eq_one) (hinfo z hz).2.2
  have hTcard : (T.card:ℝ)≤C*x^epsilon := by
    have hcR : (T.card:ℝ)≤50400*(Bres.natAbs.divisors.card:ℝ)^10 := by
      exact_mod_cast hcard
    exact hcR.trans (hfee x hx Bres hBres hBcap)
  let param : ((ℕ × ℕ) × (ℕ × ℕ)) → ℤ × ℤ :=
    fun z => ((z.1.1:ℤ),(z.1.2:ℤ))
  have hinj : Set.InjOn param S := by
    rintro ⟨⟨d,e⟩,⟨u,v⟩⟩ hz ⟨⟨d',e'⟩,⟨u',v'⟩⟩ hz' hp
    change ((d:ℤ),(e:ℤ))=((d':ℤ),(e':ℤ)) at hp
    have hd : d=d' := by
      have ht := congrArg Prod.fst hp
      change (d:ℤ)=(d':ℤ) at ht
      exact_mod_cast ht
    have he : e=e' := by
      have ht := congrArg Prod.snd hp
      change (e:ℤ)=(e':ℤ) at ht
      exact_mod_cast ht
    subst d'
    subst e'
    have hRn := (hinfo ((d,e),(u,v)) hz).2.1
    rw [hvalue] at hRn
    rcases hz with ⟨hdp,hep,hup,hvp,hunit,hcut,hGat⟩
