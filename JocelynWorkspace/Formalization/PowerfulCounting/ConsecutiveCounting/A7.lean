  obtain ⟨C2, h2⟩ := htail ε hε
  refine ⟨C1 + C2, fun x hx => ?_⟩
  have hb : |(kFreePairs k x : ℝ) - x * pairDensity k| ≤
      C1 * x ^ ((1 : ℝ) / (k : ℝ) + ε) + (tailCount k x : ℝ) := (h1 x hx).2
  have hx1 : (1 : ℝ) ≤ x := by linarith
