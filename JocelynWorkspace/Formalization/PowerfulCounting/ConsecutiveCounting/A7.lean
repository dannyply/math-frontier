private lemma cofactor_norm_fixed32 (α r c : ℝ) (hc : c ≠ 0) (b : ℤ × ℤ) :
    A7QuarticMoments.nsq (α / 32) r (32 * c) b = A7QuarticMoments.nsq α r c b / 1024 := by
  unfold A7QuarticMoments.nsq
  field_simp [hc]
  <;> ring

private lemma cofactor_length_fixed32 (α r c : ℝ) (hc : c ≠ 0) (b : ℤ × ℤ) :
    2 / Real.sqrt (A7QuarticMoments.nsq (α / 32) r (32 * c) b) =
      32 * (2 / Real.sqrt (A7QuarticMoments.nsq α r c b)) := by
  have hN : 0 ≤ A7QuarticMoments.nsq α r c b := by unfold A7QuarticMoments.nsq; positivity
  have hN' : 0 ≤ A7QuarticMoments.nsq (α / 32) r (32 * c) b := by
    unfold A7QuarticMoments.nsq; positivity
  have hs : Real.sqrt (A7QuarticMoments.nsq (α / 32) r (32 * c) b) =
      Real.sqrt (A7QuarticMoments.nsq α r c b) / 32 := by
    have h1 := Real.sqrt_nonneg (A7QuarticMoments.nsq (α / 32) r (32 * c) b)
    have h2 := Real.sqrt_nonneg (A7QuarticMoments.nsq α r c b)
    have h3 := Real.sq_sqrt hN'
    have h4 := Real.sq_sqrt hN
    rw [cofactor_norm_fixed32 α r c hc b] at h3
    rw [cofactor_norm_fixed32 α r c hc b] at h1 ⊢
    nlinarith only [h1, h2, h3, h4]
  rw [hs]
  by_cases hzero : Real.sqrt (A7QuarticMoments.nsq α r c b) = 0
  · simp [hzero]
  · field_simp [hzero]
    <;> ring

