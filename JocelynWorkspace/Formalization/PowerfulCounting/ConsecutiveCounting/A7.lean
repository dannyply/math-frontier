        let M : ℕ := ⌈x ^ (mBase s + δ)⌉₊;
        let U : ℝ := x / D ^ 4;
        let V : ℝ := x / E ^ 4;
        let R_D : ℝ := D * E + (D ^ 2 + E ^ 2) / (M : ℝ);
        let R_U : ℝ := U * V + (U ^ 2 + V ^ 2) / (M : ℝ);
        ∃ ab ∈ menu,
          1 ≤ M ∧ (M : ℝ) ≤ x ∧
          ∀ h : ℤ, (h = 1 ∨ h = -1) →
          ∃ F : ℕ → MvPolynomial (Fin 4) ℤ,
          ∃ 𝓖 : ℕ → Finset (MvPolynomial (Fin 4) ℤ),
            (∀ j ∈ cells D E M,
              F j ≠ 0 ∧
              Bihom (F j) ab.1 ab.2 ∧
              (F j).totalDegree ≤ ab.1 + ab.2 ∧
              (∀ m : Fin 4 →₀ ℕ,
                |(((F j).coeff m : ℤ) : ℝ)| ≤ x ^ K) ∧
              (∀ z ∈ originalCell x D E M j h,
                MvPolynomial.eval
                  ![(z.1.1 : ℤ), (z.1.2 : ℤ),
                    (z.2.1 : ℤ), (z.2.2 : ℤ)] (F j) = 0) ∧
              (𝓖 j).card ≤ ab.1 + ab.2 ∧
              (∀ G ∈ 𝓖 j, Primitive G ∧ HighFactor (F j) G ∧
                ∀ m : Fin 4 →₀ ℕ,
                  |((G.coeff m : ℤ) : ℝ)| ≤ x ^ K) ∧
              (∀ z : Point,
                z ∈ HighUnion x D E M j h (F j) ↔
                  z ∈ originalCell x D E M j h ∧
                  ∃ G ∈ 𝓖 j,
                    MvPolynomial.eval
                      ![(z.1.1 : ℤ), (z.1.2 : ℤ),
                        (z.2.1 : ℤ), (z.2.2 : ℤ)] G = 0) ∧
              (HighUnion x D E M j h (F j)).Finite ∧
              ∀ G ∈ 𝓖 j, (HighCell x D E M j h G).Finite) ∧
            (∑ j ∈ cells D E M, ∑ G ∈ 𝓖 j,
                ((HighCell x D E M j h G).ncard : ℝ)) ≤
              C * x ^ ε *
                ((M : ℝ) +
                  (M : ℝ) ^ ((3 : ℝ) / 4) *
                    R_D ^ ((1 : ℝ) / 5) *
                    R_U ^ ((1 : ℝ) / 20)))

private theorem full_high : FullHighStatement := by
  classical
  dsimp only [FullHighStatement]
  intro hCCall δ hδ hδmax
  obtain ⟨c,hCC⟩ := hCCall 10 (by norm_num)
  change FormalAB.S1a1f3383.ConsecutiveCountingTargetsAB.CCDNAt 10 c at hCC
  obtain ⟨menu,hmenune,hmenu,K0,Xa,hK0,hXa,haux⟩ :=
