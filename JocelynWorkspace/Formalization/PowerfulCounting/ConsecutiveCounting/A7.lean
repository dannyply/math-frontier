private def cofactorA (x D E : ℝ) (M j : ℕ) : ℝ :=
  scaleA D E (x/D^4) (x/E^4) M j

private def cofactorB (x D E : ℝ) (M j : ℕ) : ℝ :=
  scaleB D E (x/D^4) (x/E^4) M j

private def realNormSq (α r c p q : ℝ) : ℝ :=
  (α * (p - r * q)) ^ 2 + (q / c) ^ 2

private lemma norm_from_halves (p q : ℝ)
    (hp : |p|  ≤  (1 / 2 : ℝ)) (hq : |q|  ≤  (1 / 2 : ℝ)) :
    p ^ 2 + q ^ 2  ≤  1 := by
  have hp2 := pow_le_pow_left₀ (abs_nonneg p) hp 2
  have hq2 := pow_le_pow_left₀ (abs_nonneg q) hq 2
  rw [sq_abs] at hp2 hq2
  nlinarith only [hp2, hq2]

private lemma tuple_ellipse_containment (x D E : ℝ) (M j : ℕ) (h : ℤ)
    (hx : 8 ≤ x) (hD : 0<D) (hE : 0<E)
    (hM : 1 ≤ M) (hMx : (M : ℝ) ≤ x)
    (hj : j ∈ quarticCells D E M) (hh : h=1  ∨  h=-1)
    (z : OriginalPoint) (hz : z ∈ quarticCell x D E M j h) :
    let U : ℝ := x/D^4;
    let V : ℝ := x/E^4;
    nsq ((M : ℝ)/(4*D)) (quarticRho D E M j) (2*E)
      ((z.1.1 : ℤ),(z.1.2 : ℤ)) ≤ 1  ∧ 
    nsq ((M : ℝ)/(2048*scaleA D E U V M j))
      ((quarticRho D E M j)^4) (32*scaleB D E U V M j)
      ((z.2.2 : ℤ),(z.2.1 : ℤ)) ≤ 1 := by
  classical
  let U : ℝ := x/D^4
  let V : ℝ := x/E^4
  let r : ℝ := quarticRho D E M j
  let d : ℝ := (z.1.1 : ℝ)
  let e : ℝ := (z.1.2 : ℝ)
  let u : ℝ := (z.2.1 : ℝ)
  let v : ℝ := (z.2.2 : ℝ)
  let t : ℝ := d/e
  let a : ℝ := scaleA D E U V M j
  let b : ℝ := scaleB D E U V M j
  rcases hz with ⟨hdn,hen,hun,hvn,hshift,hnlo,hnhi,hdlo,hdhi,
    helo,hehi,htlo,hthi⟩
  have hx0 : 0<x := by linarith only [hx]
  have hM1 : (1 : ℝ) ≤ M := by exact_mod_cast hM
  have hM0 : (0 : ℝ)<M := by linarith only [hM1]
  have hd1 : 1 ≤ d := by dsimp [d]; exact_mod_cast hdn
  have he1 : 1 ≤ e := by dsimp [e]; exact_mod_cast hen
  have hu1 : 1 ≤ u := by dsimp [u]; exact_mod_cast hun
  have hv1 : 1 ≤ v := by dsimp [v]; exact_mod_cast hvn
  have hd0 : 0<d := by linarith only [hd1]
  have he0 : 0<e := by linarith only [he1]
  have hu0 : 0 ≤ u := by linarith only [hu1]
  have hU : 0<U := by dsimp [U]; positivity
  have hV : 0<V := by dsimp [V]; positivity
  have hsc := A7QuarticMoments.scale_bounds D E U V M j hU hV
  have hVa : V ≤ a := hsc.1
  have hUb : U ≤ b := hsc.2.2.1
  have ha : 0<a := hV.trans_le hVa
  have hb : 0<b := hU.trans_le hUb
  have hn : d^4*u ≤ x := by
    dsimp [d,u]
    exact_mod_cast hnhi
  have hD4 : D^4 ≤ 16*d^4 := by
    have hp := pow_le_pow_left₀ hD.le (show D ≤ 2*d by linarith only [hdlo]) 4
    nlinarith only [hp]
  have huCap : u ≤ 16*U := by
    dsimp [U]
    rw [←mul_div_assoc]
    apply (le_div_iff₀ (pow_pos hD 4)).mpr
    have hp := mul_le_mul_of_nonneg_right hD4 hu0
    nlinarith only [hp,hn]
  have heCap : e ≤ E := hehi
  have heLow : E/2<e := helo
  change r<t at htlo
  change t ≤ r*(1+1/(M : ℝ)) at hthi
  have hrange := ((A7QuarticMoments.mem_cells D E M j).mp hj).2
  change D/(2*E) ≤ r  ∧  r ≤ 2*D/E at hrange
  have hr0 : 0<r := (by positivity : 0<D/(2*E)).trans_le hrange.1
  have ht0 : 0<t := hr0.trans htlo
  have hshiftR : e^4*v=d^4*u+(h : ℝ) := by
    dsimp [d,e,u,v]
    exact_mod_cast hshift
  have hhabs : |(h : ℝ)|=1 := by
    rcases hh with rfl|rfl <;> norm_num

  have hde0 : 0  ≤  d - r * e := by
    have hp := (lt_div_iff₀ he0).mp htlo
    linarith only [hp]
  have hre : r * e  ≤  2 * D := by
    have hp := mul_le_mul_of_nonneg_left heCap hr0.le
    have hrE : r * E  ≤  2 * D := (le_div_iff₀ hE).mp hrange.2
    exact hp.trans hrE
  have hde : |d - r * e|  ≤  2 * D / (M : ℝ) := by
    rw [abs_of_nonneg hde0]
    apply (le_div_iff₀ hM0).mpr
    have hp : d  ≤  r * (1 + 1 / (M : ℝ)) * e :=
      (div_le_iff₀ he0).mp hthi
    have hm := mul_le_mul_of_nonneg_right hp hM0.le
    have hid : (r * (1 + 1 / (M : ℝ)) * e) * (M : ℝ) =
        r * e * (M : ℝ) + r * e := by
      field_simp [hM0.ne']
      <;> ring
    rw [hid] at hm
    nlinarith only [hm, hre]
  have hfirstX :
      |((M : ℝ) / (4 * D)) * (d - r * e)|  ≤  (1 / 2 : ℝ) := by
    rw [abs_mul, abs_of_pos (by positivity : 0 < (M : ℝ) / (4 * D))]
    calc
      (M : ℝ) / (4 * D) * |d - r * e|  ≤ 
          (M : ℝ) / (4 * D) * (2 * D / (M : ℝ)) :=
        mul_le_mul_of_nonneg_left hde (by positivity)
      _ = (1 / 2 : ℝ) := by
        field_simp [hM0.ne', hD.ne']
        <;> ring
  have hfirstY : |e / (2 * E)|  ≤  (1 / 2 : ℝ) := by
    rw [abs_of_nonneg (by positivity : 0  ≤  e / (2 * E))]
    apply (div_le_iff₀ (by positivity : 0 < 2 * E)).mpr
    nlinarith only [heCap]
  have hfirst := norm_from_halves _ _ hfirstX hfirstY

  let q : ℝ := 1/(M : ℝ)
  have hq0 : 0 ≤ q := by dsimp [q]; positivity
  have hq1 : q ≤ 1 := by
    dsimp [q]
    apply (div_le_iff₀ hM0).mpr
    simpa only [one_mul] using hM1
  have hq2 : q^2 ≤ q := by nlinarith only [mul_nonneg hq0 (sub_nonneg.mpr hq1)]
  have hq3 : q^3 ≤ q^2 := by
    have hp := mul_le_mul_of_nonneg_left hq1 (sq_nonneg q)
    nlinarith only [hp]
  have hq4 : q^4 ≤ q^3 := by
    have hp := mul_le_mul_of_nonneg_left hq1 (pow_nonneg hq0 3)
    nlinarith only [hp]
  have hbin : (1+q)^4-1 ≤ 15*q := by
    nlinarith only [hq0,hq2,hq3,hq4]
  have hdiff40 : 0 ≤ t^4-r^4 := by
    have hp := pow_le_pow_left₀ hr0.le htlo.le 4
    linarith only [hp]
  have hdiff4 : t^4-r^4 ≤ 15*r^4/(M : ℝ) := by
    have hp := pow_le_pow_left₀ ht0.le hthi 4
    change t^4 ≤ (r*(1+q))^4 at hp
    rw [mul_pow] at hp
    calc
      t^4-r^4 ≤ r^4*((1+q)^4-1) := by nlinarith only [hp]
      _  ≤  r^4*(15*q) := mul_le_mul_of_nonneg_left hbin (pow_nonneg hr0.le 4)
      _ = 15*r^4/(M : ℝ) := by dsimp [q]; ring
  have hE4 : E^4 ≤ 16*e^4 := by
    have hp := pow_le_pow_left₀ hE.le (show E ≤ 2*e by linarith only [heLow]) 4
    nlinarith only [hp]
  have hsurface : |v-t^4*u| ≤ 16*V/(M : ℝ) := by
    have hid : v-t^4*u=(h : ℝ)/e^4 := by
      dsimp [t]
      field_simp [he0.ne']
      <;> nlinarith only [hshiftR]
    rw [hid,abs_div,hhabs,abs_of_pos (pow_pos he0 4)]
    calc
      1/e^4 ≤ 16/E^4 := by
        apply (div_le_div_iff₀ (pow_pos he0 4) (pow_pos hE 4)).mpr
        simpa only [one_mul] using hE4
      _ = 16*V/x := by
        dsimp [V]
        field_simp [hx0.ne',hE.ne']
        <;> ring
      _  ≤  16*V/(M : ℝ) :=
        div_le_div_of_nonneg_left (by positivity) hM0 hMx
  have hru : r^4*u ≤ 16*V := by
    calc
      r^4*u ≤ t^4*u := mul_le_mul_of_nonneg_right
        (pow_le_pow_left₀ hr0.le htlo.le 4) hu0
      _ = d^4*u/e^4 := by dsimp [t]; field_simp [he0.ne'] <;> ring
      _  ≤  x/e^4 := div_le_div_of_nonneg_right hn (pow_nonneg he0.le 4)
      _  ≤  16*x/E^4 := by
        apply (div_le_div_iff₀ (pow_pos he0 4) (pow_pos hE 4)).mpr
        have hp := mul_le_mul_of_nonneg_left hE4 hx0.le
        nlinarith only [hp]
      _ = 16*V := by dsimp [V]; ring
  have hcenter : (t^4-r^4)*u ≤ 240*V/(M : ℝ) := by
    calc
      (t^4-r^4)*u ≤ (15*r^4/(M : ℝ))*u :=
        mul_le_mul_of_nonneg_right hdiff4 hu0
      _ = (15/(M : ℝ))*(r^4*u) := by ring
      _  ≤  (15/(M : ℝ))*(16*V) :=
        mul_le_mul_of_nonneg_left hru (by positivity)
      _ = 240*V/(M : ℝ) := by ring
  have hcofactor : |v-r^4*u| ≤ 256*V/(M : ℝ) := by
    calc
      |v-r^4*u|=|(v-t^4*u)+(t^4-r^4)*u| := by congr 1 <;> ring
      _  ≤  |v-t^4*u|+|(t^4-r^4)*u| := abs_add_le _ _
      _ = |v-t^4*u|+(t^4-r^4)*u := by
        rw [abs_of_nonneg (mul_nonneg hdiff40 hu0)]
      _  ≤  16*V/(M : ℝ)+240*V/(M : ℝ) :=
        add_le_add hsurface hcenter
      _ = 256*V/(M : ℝ) := by ring
  have hsecondX :
      |((M : ℝ)/(2048*a))*(v-r^4*u)| ≤ (1/2 : ℝ) := by
    rw [abs_mul,abs_of_pos (by positivity : 0<(M : ℝ)/(2048*a))]
    calc
      (M : ℝ)/(2048*a)*|v-r^4*u| ≤ 
          (M : ℝ)/(2048*a)*(256*V/(M : ℝ)) :=
        mul_le_mul_of_nonneg_left hcofactor (by positivity)
      _ = V/(8*a) := by
        field_simp [hM0.ne',ha.ne']
        <;> ring
      _  ≤  (1/2 : ℝ) := by
        apply (div_le_iff₀ (by positivity : 0<8*a)).mpr
        linarith only [hVa,ha]
  have hsecondY : |u/(32*b)| ≤ (1/2 : ℝ) := by
    rw [abs_of_nonneg (by positivity : 0 ≤ u/(32*b))]
    apply (div_le_iff₀ (by positivity : 0<32*b)).mpr
    nlinarith only [huCap,hUb]
  have hsecond := norm_from_halves _ _ hsecondX hsecondY
  constructor
  · simpa only [nsq,Int.cast_natCast] using hfirst
  · simpa only [nsq,Int.cast_natCast] using hsecond

private lemma cofactor_norm_fixed16 (α r c : ℝ) (hc : c  ≠  0) (b : ℤ  ×  ℤ) :
    nsq (α / 16) r (16 * c) b = nsq α r c b / 256 := by
  unfold nsq
  field_simp [hc]
  <;> ring

private lemma cofactor_length_fixed16 (α r c : ℝ) (hc : c  ≠  0) (b : ℤ  ×  ℤ) :
    2 / Real.sqrt (nsq (α / 16) r (16 * c) b) =
      16 * (2 / Real.sqrt (nsq α r c b)) := by
  have hN : 0  ≤  nsq α r c b := by unfold nsq; positivity
  have hN' : 0  ≤  nsq (α / 16) r (16 * c) b := by unfold nsq; positivity
  have hs : Real.sqrt (nsq (α / 16) r (16 * c) b) =
      Real.sqrt (nsq α r c b) / 16 := by
    have h1 := Real.sqrt_nonneg (nsq (α / 16) r (16 * c) b)
    have h2 := Real.sqrt_nonneg (nsq α r c b)
    have h3 := Real.sq_sqrt hN'
    have h4 := Real.sq_sqrt hN
    rw [cofactor_norm_fixed16 α r c hc b] at h3
    rw [cofactor_norm_fixed16 α r c hc b] at h1 ⊢
    nlinarith only [h1, h2, h3, h4]
  rw [hs]
  by_cases hzero : Real.sqrt (nsq α r c b) = 0
  · simp [hzero]
  · field_simp [hzero]
    <;> ring

