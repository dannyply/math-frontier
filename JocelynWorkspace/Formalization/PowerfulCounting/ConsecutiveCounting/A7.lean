            (N : ℝ)*Ccell*x^η*(1+((L j)^4*T j)^((1 : ℝ)/10)) := by
        have hcNat : (S j).card ≤ N := by
          rcases hData j hj with ⟨_,_,_,_,_,hScard,_⟩
          exact hScard.trans habN
        have hcR : ((S j).card : ℝ) ≤ N := by exact_mod_cast hcNat
        calc
          (∑ G ∈ S j, ((HighCell x D E M j h G).ncard : ℝ)) ≤
