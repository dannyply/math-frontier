private theorem a7_cast_natAbs_real (z : ℤ) :
    ((z.natAbs : ℕ) : ℝ) = |(z : ℝ)| := by
  cases z with
  | ofNat n => simp
  | negSucc n =>
      have hnonpos : (-1 : ℝ) + -(n : ℝ) ≤ 0 := by
        have hn : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg _
        linarith
      simp [Int.natAbs] <;>
        (rw [abs_of_nonpos hnonpos] <;> ring)

private theorem a7_crt_nat_budget_real_bridge
    (m q h : ℤ) (W : ℕ)
    (hm : m ≠ 0) (hq : q ≠ 0)
    (hh : 0 < h) (hW : 0 < W)
    (hmod : (m ^ 9).natAbs ∣
      W ^ 5 * (q * h ^ 4).natAbs) :
    |(m : ℝ)| ^ 9 ≤
      (W : ℝ) ^ 5 * |(q : ℝ)| * (h : ℝ) ^ 4 := by
  have hNpos : 0 < (q * h ^ 4).natAbs := by
    apply Int.natAbs_pos.mpr
    exact mul_ne_zero hq (pow_ne_zero 4 (ne_of_gt hh))
  have hprod : 0 < W ^ 5 * (q * h ^ 4).natAbs := by
    positivity
  have hle : (m ^ 9).natAbs ≤
      W ^ 5 * (q * h ^ 4).natAbs :=
    Nat.le_of_dvd hprod hmod
  have hreal :
      (((m ^ 9).natAbs : ℕ) : ℝ) ≤
        (W : ℝ) ^ 5 *
          (((q * h ^ 4).natAbs : ℕ) : ℝ) := by
    exact_mod_cast hle
  have hhR : (0 : ℝ) < (h : ℝ) := by exact_mod_cast hh
  simpa only [Int.natAbs_pow, Int.natAbs_mul,
    Nat.cast_pow, Nat.cast_mul, a7_cast_natAbs_real,
    abs_mul, abs_pow, abs_of_pos hhR, mul_assoc] using hreal

private theorem a7_regime_II_second_term_le_first
    (γ x P H : ℝ)
    (hγ : γ ≠ 0) (hx : 0 < x) (hP : 0 < P)
    (hH : H = |γ| * Real.sqrt (x * P ^ 5)) :
    2 * H / (30 * γ ^ 2 * P ^ 5) ≤ x / (2 * H) := by
  have hHpos : 0 < H := by
    rw [hH]
    positivity
  have hden : 0 < 30 * γ ^ 2 * P ^ 5 := by positivity
  have hden2 : 0 < 2 * H := by positivity
  have hsq : H ^ 2 = γ ^ 2 * x * P ^ 5 := by
    rw [hH, mul_pow, sq_abs, Real.sq_sqrt (by positivity : 0 ≤ x * P ^ 5)]
    ring
  apply (div_le_div_iff₀ hden hden2).2
  nlinarith [hsq, mul_pos (sq_pos_of_ne_zero hγ) (mul_pos hx (pow_pos hP 5))]

private theorem a7_crt_modulus_log_width
    (Z M ell h q W : ℝ)
    (hZ : 0 < Z) (hM : 0 < M) (hell : 0 < ell)
    (hh : 0 < h) (hq : 0 < q) (hW : 0 < W)
    (hmod : ell ^ 9 ≤ W ^ 5 * q * h ^ 4) :
    Real.log (Z / (M * ell * h * W)) ≤
      Real.log Z - Real.log M + Real.log q / 5 -
        Real.log h / 5 - 14 * Real.log ell / 5 := by
  have hlogmod : 9 * Real.log ell ≤
      5 * Real.log W + Real.log q + 4 * Real.log h := by
    have ht := Real.log_le_log (by positivity : 0 < ell ^ 9) hmod
    have hL : Real.log (ell ^ 9) = 9 * Real.log ell := by
      rw [Real.log_pow]
      all_goals ring
    have hR : Real.log (W ^ 5 * q * h ^ 4) =
        5 * Real.log W + Real.log q + 4 * Real.log h := by
      rw [Real.log_mul (by positivity : W ^ 5 * q ≠ 0)
        (by positivity : h ^ 4 ≠ 0)]
      rw [Real.log_mul (by positivity : W ^ 5 ≠ 0)
        (ne_of_gt hq)]
      rw [Real.log_pow, Real.log_pow]
      all_goals ring
    rw [hL, hR] at ht
    exact ht
  have hden : 0 < M * ell * h * W := by positivity
  have hlogden : Real.log (M * ell * h * W) =
      Real.log M + Real.log ell + Real.log h + Real.log W := by
    rw [Real.log_mul (by positivity : M * ell * h ≠ 0) (ne_of_gt hW)]
    rw [Real.log_mul (by positivity : M * ell ≠ 0) (ne_of_gt hh)]
    rw [Real.log_mul (ne_of_gt hM) (ne_of_gt hell)]
    all_goals ring
  rw [Real.log_div (ne_of_gt hZ) (ne_of_gt hden), hlogden]
  linarith

private theorem a7_crt_modulus_width_le
    (Z M ell h q W B : ℝ)
    (hZ : 0 < Z) (hM : 0 < M) (hell : 0 < ell)
    (hh : 0 < h) (hq : 0 < q) (hW : 0 < W)
    (hB : 0 < B)
    (hmod : ell ^ 9 ≤ W ^ 5 * q * h ^ 4)
    (hbudget :
      Real.log Z - Real.log M + Real.log q / 5 -
        Real.log h / 5 - 14 * Real.log ell / 5 ≤ Real.log B) :
    Z / (M * ell * h * W) ≤ B := by
  have hwidth : 0 < Z / (M * ell * h * W) := by positivity
  have hlog := (a7_crt_modulus_log_width
    Z M ell h q W hZ hM hell hh hq hW hmod).trans hbudget
  have he := Real.exp_le_exp.mpr hlog
  simpa only [Real.exp_log hwidth, Real.exp_log hB] using he

private theorem a7_actual_lambda_gamma_abs_bridge
    (a b c K0 q h m : ℝ)
    (ha : a ≠ 0) (hb : b ≠ 0) (hc : c ≠ 0)
    (hh : 0 < h) (hm : m ≠ 0)
    (hcq : c * q = K0 * h) :
    |a * b * h / m| = |a * b| * h / |m| ∧
      |K0 / (c * a ^ 5 * b ^ 5)| =
        |q| / (h * |a * b| ^ 5) := by
  have hab : a * b ≠ 0 := mul_ne_zero ha hb
  have hden1 : c * a ^ 5 * b ^ 5 ≠ 0 := by
    exact mul_ne_zero
      (mul_ne_zero hc (pow_ne_zero 5 ha)) (pow_ne_zero 5 hb)
  have hden2 : h * (a * b) ^ 5 ≠ 0 :=
    mul_ne_zero (ne_of_gt hh) (pow_ne_zero 5 hab)
  have hratio :
      K0 / (c * a ^ 5 * b ^ 5) =
        q / (h * (a * b) ^ 5) := by
    apply (div_eq_div_iff hden1 hden2).2
    calc
      K0 * (h * (a * b) ^ 5) =
          (K0 * h) * (a * b) ^ 5 := by ring
