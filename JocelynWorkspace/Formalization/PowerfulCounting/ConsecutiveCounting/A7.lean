    dsimp [X0]
    rw [signedNat_mul,hxnat]
    exact signed_natAbs X
  have hyscale : (g:ℤ)*Y0=Y := by
    dsimp [Y0]
    rw [signedNat_mul,hynat]
    exact signed_natAbs Y
  have hnorm0 : X0^2-(Delta:ℤ)*Y0^2=h0 := by
    dsimp [X0,Y0,h0]
    rw [signedNat_sq,signedNat_sq]
  have hscale : h=(g:ℤ)^2*h0 := by
    calc
      h=X^2-(Delta:ℤ)*Y^2 := hnorm.symm
      _=((g:ℤ)*X0)^2-(Delta:ℤ)*((g:ℤ)*Y0)^2 := by rw [hxscale,hyscale]
      _=(g:ℤ)^2*(X0^2-(Delta:ℤ)*Y0^2) := by ring
      _=(g:ℤ)^2*h0 := by rw [hnorm0]
  have hh0 : h0≠0 := by
    intro hz
    apply hh
    rw [hscale,hz,mul_zero]
  have hgdiv : (g:ℤ)^2∣h := ⟨h0,hscale⟩
  have hh0div : h0∣h := ⟨(g:ℤ)^2,by rw [hscale,mul_comm]⟩
  refine ⟨g,h0,X0,Y0,hg,hgdiv,hh0,hh0div,hxscale,hyscale,?_,?_,?_,hnorm0⟩
  · change Nat.gcd X0.natAbs Y0.natAbs=1
    dsimp [X0,Y0]
    rw [signedNat_natAbs,signedNat_natAbs]
    exact hprim.gcd_eq_one
  · dsimp [X0]
    rw [signedNat_natAbs]
    exact (Nat.div_le_self _ _).trans hX
  · dsimp [Y0]
    rw [signedNat_natAbs]
    exact (Nat.div_le_self _ _).trans hY

private lemma divisor_card_mono_int (a h : ℤ) (hh : h≠0) (had : a∣h) :
