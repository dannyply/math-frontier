    rw [Finset.mem_Icc] at hn2
    have hn1 : (1:ℝ) ≤ n2 := by exact_mod_cast hn2.1
    have hnN : (n2:ℝ) ≤ N := by exact_mod_cast hn2.2
    have hpos : (0:ℝ) < n2 := by linarith
    have hfl : (⌊fmax * n2 + A⌋₊ : ℝ) ≤ fmax * n2 + A := Nat.floor_le (by positivity)
    have hnn : 0 ≤ 1 + 2 * (A / n2) / g := by positivity
    calc (⌊fmax * n2 + A⌋₊ : ℝ) * (1 + 2 * (A / n2) / g)
        ≤ (fmax * n2 + A) * (1 + 2 * (A / n2) / g) := mul_le_mul_of_nonneg_right hfl hnn
      _ = fmax * n2 + A + 2 * A * fmax / g + 2 * A ^ 2 / g * (1 / n2) := by
          field_simp
          ring
      _ ≤ fmax * N + A + 2 * A * fmax / g + 2 * A ^ 2 / g * 1 := by
          have h1 : fmax * n2 ≤ fmax * N := mul_le_mul_of_nonneg_left hnN hf
          have h2 : 1 / (n2:ℝ) ≤ 1 := by rw [div_le_one hpos]; exact hn1
          have h3 : 0 ≤ 2 * A ^ 2 / g := by positivity
          have h4 := mul_le_mul_of_nonneg_left h2 h3
          linarith
      _ = fmax * N + A + 2 * A * fmax / g + 2 * A ^ 2 / g := by ring
  calc ∑ n2 ∈ Finset.Icc 1 N, (⌊fmax * n2 + A⌋₊ : ℝ) * (1 + 2 * (A / n2) / g)
      ≤ (Finset.Icc 1 N).card • (fmax * N + A + 2 * A * fmax / g + 2 * A ^ 2 / g) :=
        Finset.sum_le_card_nsmul _ _ _ hterm
    _ = N * (fmax * N + A + 2 * A * fmax / g + 2 * A ^ 2 / g) := by
        rw [Nat.card_Icc, nsmul_eq_mul]
        simp

private lemma tail_abstract (f : ℕ → ℝ) (g fmin fmax A B : ℝ) (hg : 0 < g)
    (hsp : ∀ i j : ℕ, i ≤ j → ((j : ℝ) - i) * g ≤ f j - f i)
    (S : Finset ℕ) (hfmin : ∀ j ∈ S, fmin ≤ f j) (hfmax : ∀ j ∈ S, f j ≤ fmax)
    (hA0 : 0 ≤ A) (hA1 : A < 1) (hAf : A < fmin)
    (P : Finset ℕ) (hPS : P ⊆ S)
    (hP : ∀ j ∈ P, ∃ x1 x2 : ℤ, (x1, x2) ≠ (0 : ℤ × ℤ) ∧
      |(x1 : ℝ) - f j * x2| ≤ A ∧ |(x2 : ℝ)| ≤ B) :
    (P.card : ℝ) ≤ ∑ n2 ∈ Finset.Icc 1 ⌊B⌋₊,
        (⌊fmax * n2 + A⌋₊ : ℝ) * (1 + 2 * (A / n2) / g) := by
  classical
  have hwit : ∀ j ∈ P, ∃ n2 ∈ Finset.Icc 1 ⌊B⌋₊, ∃ n1 ∈ Finset.Icc 1 ⌊fmax * n2 + A⌋₊,
      |(n1 : ℝ) - f j * n2| ≤ A := by
    intro j hj
    obtain ⟨x1, x2, hne, h1, h2⟩ := hP j hj
    have hjS := hPS hj
    have hfj : fmin ≤ f j := hfmin j hjS
    have hfj' : f j ≤ fmax := hfmax j hjS
    have key : ∃ y1 y2 : ℤ, 0 < y2 ∧ |(y1 : ℝ) - f j * y2| ≤ A ∧ |(y2 : ℝ)| ≤ B := by
      rcases lt_trichotomy x2 0 with hx2 | hx2 | hx2
      · refine ⟨-x1, -x2, by omega, ?_, ?_⟩
        · push_cast
          have e : (-(x1:ℝ) - f j * -(x2:ℝ)) = -((x1:ℝ) - f j * x2) := by ring
          rw [e, abs_neg]; exact h1
        · push_cast; rw [abs_neg]; exact h2
      · exfalso
        subst hx2
        apply hne
        have h3 : |(x1 : ℝ)| ≤ A := by simpa using h1
        have hlt : |(x1 : ℝ)| < 1 := lt_of_le_of_lt h3 hA1
        have h4 : |x1| < 1 := by exact_mod_cast hlt
        have h5 : x1 = 0 := by rw [abs_lt] at h4; omega
        simp [h5]
      · exact ⟨x1, x2, hx2, h1, h2⟩
    obtain ⟨y1, y2, hy2, h1, h2⟩ := key
    have hy2R : (1 : ℝ) ≤ y2 := by exact_mod_cast hy2
    have hfpos : 0 < f j := by linarith
    have hy1 : 0 < y1 := by
      by_contra hc
      push Not at hc
      have hy1R : (y1 : ℝ) ≤ 0 := by exact_mod_cast hc
      have h5 : f j ≤ f j * y2 := by nlinarith
      have habs := (abs_le.mp h1).1
      linarith
    obtain ⟨n1, rfl⟩ := Int.eq_ofNat_of_zero_le hy1.le
    obtain ⟨n2, rfl⟩ := Int.eq_ofNat_of_zero_le hy2.le
    have e1 : ((n1 : ℤ) : ℝ) = (n1 : ℝ) := Int.cast_natCast n1
    have e2 : ((n2 : ℤ) : ℝ) = (n2 : ℝ) := Int.cast_natCast n2
    rw [e1, e2] at h1
    rw [e2] at h2 hy2R
    have hn1pos : 1 ≤ n1 := by omega
    have hn2pos : 1 ≤ n2 := by omega
    have hn1up : (n1 : ℝ) ≤ fmax * n2 + A := by
      have h6 := (abs_le.mp h1).2
      have h7 : f j * n2 ≤ fmax * n2 := by nlinarith
      linarith
    have hn2up : (n2 : ℝ) ≤ B := le_trans (le_abs_self _) h2
    refine ⟨n2, ?_, n1, ?_, h1⟩
    · rw [Finset.mem_Icc]
      exact ⟨hn2pos, Nat.le_floor hn2up⟩
    · rw [Finset.mem_Icc]
      exact ⟨hn1pos, Nat.le_floor hn1up⟩
  have hsub : P ⊆ (Finset.Icc 1 ⌊B⌋₊).biUnion (fun n2 =>
      (Finset.Icc 1 ⌊fmax * n2 + A⌋₊).biUnion (fun n1 =>
        S.filter (fun j => |(n1 : ℝ) - f j * n2| ≤ A))) := by
    intro j hj
    obtain ⟨n2, hn2, n1, hn1, h⟩ := hwit j hj
    rw [Finset.mem_biUnion]
    refine ⟨n2, hn2, ?_⟩
    rw [Finset.mem_biUnion]
    refine ⟨n1, hn1, ?_⟩
    rw [Finset.mem_filter]
    exact ⟨hPS hj, h⟩
  calc (P.card : ℝ)
      ≤ (((Finset.Icc 1 ⌊B⌋₊).biUnion (fun n2 =>
          (Finset.Icc 1 ⌊fmax * n2 + A⌋₊).biUnion (fun n1 =>
            S.filter (fun j => |(n1 : ℝ) - f j * n2| ≤ A)))).card : ℝ) := by
        exact_mod_cast Finset.card_le_card hsub
    _ ≤ ∑ n2 ∈ Finset.Icc 1 ⌊B⌋₊, (((Finset.Icc 1 ⌊fmax * n2 + A⌋₊).biUnion (fun n1 =>
            S.filter (fun j => |(n1 : ℝ) - f j * n2| ≤ A))).card : ℝ) := by
        exact_mod_cast Finset.card_biUnion_le
    _ ≤ ∑ n2 ∈ Finset.Icc 1 ⌊B⌋₊, ∑ n1 ∈ Finset.Icc 1 ⌊fmax * n2 + A⌋₊,
          ((S.filter (fun j => |(n1 : ℝ) - f j * n2| ≤ A)).card : ℝ) := by
        apply Finset.sum_le_sum
        intro n2 _
        exact_mod_cast Finset.card_biUnion_le
    _ ≤ ∑ n2 ∈ Finset.Icc 1 ⌊B⌋₊, ∑ n1 ∈ Finset.Icc 1 ⌊fmax * n2 + A⌋₊,
          (1 + 2 * (A / n2) / g) := by
        apply Finset.sum_le_sum
        intro n2 hn2
        apply Finset.sum_le_sum
        intro n1 _
        have hn2pos : (0:ℝ) < n2 := by
          have := (Finset.mem_Icc.mp hn2).1
          exact_mod_cast this
        apply count_window f g hg hsp _ ((n1:ℝ) / n2) (A / n2) (by positivity)
        intro j hj
        rw [Finset.mem_filter] at hj
        have e : f j - (n1:ℝ) / n2 = -((n1:ℝ) - f j * n2) / n2 := by
          field_simp
          ring
        rw [e, abs_div, abs_neg, abs_of_pos hn2pos]
        exact div_le_div_of_nonneg_right hj.2 hn2pos.le
    _ = ∑ n2 ∈ Finset.Icc 1 ⌊B⌋₊, (⌊fmax * n2 + A⌋₊ : ℝ) * (1 + 2 * (A / n2) / g) := by
        apply Finset.sum_congr rfl
        intro n2 _
        rw [Finset.sum_const, Nat.card_Icc, nsmul_eq_mul]
        simp

private lemma coords_of_inv_norm (L p q : ℝ) (hL : 0 < L) (h : L ≤ 2 / Real.sqrt (p ^ 2 + q ^ 2)) :
    |p| ≤ 2 / L ∧ |q| ≤ 2 / L := by
  have hs0 : 0 ≤ Real.sqrt (p ^ 2 + q ^ 2) := Real.sqrt_nonneg _
  have hs : 0 < Real.sqrt (p ^ 2 + q ^ 2) := by
    rcases hs0.lt_or_eq with h' | h'
    · exact h'
    · rw [← h', div_zero] at h; linarith
  have hsL : Real.sqrt (p ^ 2 + q ^ 2) ≤ 2 / L := by
    rw [le_div_iff₀ hL]
    rw [le_div_iff₀ hs] at h
    linarith
  constructor
  · exact le_trans (Real.abs_le_sqrt (by nlinarith [sq_nonneg q])) hsL
  · exact le_trans (Real.abs_le_sqrt (by nlinarith [sq_nonneg p])) hsL

private lemma scaled_abs (k y r : ℝ) (hk : 0 < k) (h : |k * y| ≤ r) : |y| ≤ r / k := by
  rw [abs_mul, abs_of_pos hk] at h
  rw [le_div_iff₀ hk]
  linarith

private lemma div_abs_le (y c r : ℝ) (hc : 0 < c) (h : |y / c| ≤ r) : |y| ≤ r * c := by
  rw [abs_div, abs_of_pos hc, div_le_iff₀ hc] at h
  exact h

private lemma pointwise_shell (ℓ Ls θ : ℝ) (K : ℕ) (hLs : 0 < Ls) (hℓ0 : 0 ≤ ℓ) (hθ : 0 ≤ θ)
    (hK : ℓ ≤ 2 ^ K * Ls) :
    ℓ ^ θ ≤ Ls ^ θ + ∑ k ∈ Finset.range K,
      (if 2 ^ k * Ls ≤ ℓ then ((2:ℝ) ^ (k + 1) * Ls) ^ θ else 0) := by
  have hnn : ∀ k ∈ Finset.range K,
      0 ≤ (if 2 ^ k * Ls ≤ ℓ then ((2:ℝ) ^ (k + 1) * Ls) ^ θ else 0) := by
    intro k _
    split_ifs
    · positivity
    · exact le_refl 0
  have hsum0 := Finset.sum_nonneg hnn
  by_cases h1 : ℓ ≤ Ls
  · have h2 : ℓ ^ θ ≤ Ls ^ θ := Real.rpow_le_rpow hℓ0 h1 hθ
    linarith
  · push Not at h1
    have hex : ∃ k : ℕ, ℓ ≤ 2 ^ k * Ls := ⟨K, hK⟩
    have hk0 : ℓ ≤ 2 ^ (Nat.find hex) * Ls := Nat.find_spec hex
    have hk0pos : 0 < Nat.find hex := by
      by_contra h
      have h0 : Nat.find hex = 0 := by omega
      rw [h0, pow_zero, one_mul] at hk0
      linarith
    have hk0K : Nat.find hex ≤ K := Nat.find_min' hex hK
    have hlow : 2 ^ (Nat.find hex - 1) * Ls < ℓ := by
      have h3 := Nat.find_min hex (show Nat.find hex - 1 < Nat.find hex by omega)
      push Not at h3
      exact h3
    have hmem : Nat.find hex - 1 ∈ Finset.range K := by rw [Finset.mem_range]; omega
    have hterm : ℓ ^ θ ≤ (if 2 ^ (Nat.find hex - 1) * Ls ≤ ℓ
        then ((2:ℝ) ^ (Nat.find hex - 1 + 1) * Ls) ^ θ else 0) := by
      rw [if_pos hlow.le, Nat.sub_add_cancel hk0pos]
      exact Real.rpow_le_rpow hℓ0 hk0 hθ
    have hsingle := Finset.single_le_sum hnn hmem
    have h4 : 0 ≤ Ls ^ θ := by positivity
    linarith

private lemma geom_le (r : ℝ) (hr0 : 0 ≤ r) (hr1 : r < 1) (K : ℕ) :
    ∑ k ∈ Finset.range K, r ^ k ≤ 1 / (1 - r) := by
  have h1 : 0 < 1 - r := by linarith
  have hrK : 0 ≤ r ^ K := pow_nonneg hr0 K
  rw [geom_sum_eq (ne_of_lt hr1) K]
  have e : (r ^ K - 1) / (r - 1) = (1 - r ^ K) / (1 - r) := by
    rw [div_eq_div_iff (ne_of_lt (by linarith)) h1.ne']
    ring
  rw [e]
  apply div_le_div_of_nonneg_right _ h1.le
  linarith

private lemma moment_from_tails (θ : ℝ) (hθ0 : 0 < θ) (r : ℝ) (hr : r = (2:ℝ) ^ θ / 4) (hr1 : r < 1)
    (S : Finset ℕ) (ℓ : ℕ → ℝ) (hℓ0 : ∀ j ∈ S, 0 ≤ ℓ j)
    (Ls Mr K0 Q : ℝ) (hLs : 0 < Ls) (hMr : 1 ≤ Mr) (hQ0 : 0 ≤ Q) (hQ : Q ≤ Mr * Ls ^ 2)
    (hK0 : 0 ≤ K0)
    (hcard : (S.card : ℝ) ≤ 3 * Mr + 1)
    (htail : ∀ L : ℝ, Ls ≤ L → ((S.filter (fun j => L ≤ ℓ j)).card : ℝ) ≤ K0 * Q / L ^ 2) :
    ∑ j ∈ S, ℓ j ^ θ ≤ (4 + K0 * 2 ^ θ / (1 - r)) * Mr * Ls ^ θ := by
  classical
  have h2θ : 0 < (2:ℝ) ^ θ := Real.rpow_pos_of_pos (by norm_num) θ
  have hr0 : 0 ≤ r := by rw [hr]; positivity
  have h1r : 0 < 1 - r := by linarith
  have hLsθ : 0 ≤ Ls ^ θ := by positivity
  obtain ⟨K, hKb⟩ : ∃ K : ℕ, ∀ j ∈ S, ℓ j ≤ 2 ^ K * Ls := by
    refine ⟨S.sup (fun j => ⌈ℓ j / Ls⌉₊), ?_⟩
    intro j hj
    have h1 : ℓ j / Ls ≤ (⌈ℓ j / Ls⌉₊ : ℝ) := Nat.le_ceil _
    have h2 : ⌈ℓ j / Ls⌉₊ ≤ S.sup (fun j => ⌈ℓ j / Ls⌉₊) :=
      Finset.le_sup (f := fun j => ⌈ℓ j / Ls⌉₊) hj
    have h3 : S.sup (fun j => ⌈ℓ j / Ls⌉₊) < 2 ^ (S.sup (fun j => ⌈ℓ j / Ls⌉₊)) :=
      Nat.lt_two_pow_self
    have h4 : (⌈ℓ j / Ls⌉₊ : ℝ) ≤ ((2 ^ (S.sup (fun j => ⌈ℓ j / Ls⌉₊)) : ℕ) : ℝ) := by
      exact_mod_cast (le_trans h2 h3.le)
    push_cast at h4
    have h5 : ℓ j / Ls ≤ 2 ^ (S.sup (fun j => ⌈ℓ j / Ls⌉₊)) := le_trans h1 h4
    rwa [div_le_iff₀ hLs] at h5
  have hpt : ∀ j ∈ S, ℓ j ^ θ ≤ Ls ^ θ + ∑ k ∈ Finset.range K,
      (if 2 ^ k * Ls ≤ ℓ j then ((2:ℝ) ^ (k + 1) * Ls) ^ θ else 0) :=
    fun j hj => pointwise_shell (ℓ j) Ls θ K hLs (hℓ0 j hj) hθ0.le (hKb j hj)
  have hshell : ∀ k ∈ Finset.range K, ∑ j ∈ S,
      (if 2 ^ k * Ls ≤ ℓ j then ((2:ℝ) ^ (k + 1) * Ls) ^ θ else 0)
        ≤ K0 * 2 ^ θ * Mr * Ls ^ θ * r ^ k := by
    intro k _
    rw [Finset.sum_ite, Finset.sum_const_zero, add_zero, Finset.sum_const, nsmul_eq_mul]
    have h2k : (1:ℝ) ≤ 2 ^ k := one_le_pow₀ (by norm_num)
    have hL : Ls ≤ 2 ^ k * Ls := by nlinarith
    have hcnt := htail (2 ^ k * Ls) hL
    have hw : ((2:ℝ) ^ (k + 1) * Ls) ^ θ = 2 ^ θ * ((2:ℝ) ^ θ) ^ k * Ls ^ θ := by
      rw [Real.mul_rpow (by positivity) hLs.le, ← Real.rpow_natCast_mul (by norm_num),
        mul_comm ((k + 1 : ℕ) : ℝ) θ, Real.rpow_mul_natCast (by norm_num), pow_succ]
      ring
    rw [hw]
    have hwnn : 0 ≤ 2 ^ θ * ((2:ℝ) ^ θ) ^ k * Ls ^ θ := by positivity
    calc ((S.filter (fun j => 2 ^ k * Ls ≤ ℓ j)).card : ℝ) * (2 ^ θ * ((2:ℝ) ^ θ) ^ k * Ls ^ θ)
        ≤ K0 * Q / (2 ^ k * Ls) ^ 2 * (2 ^ θ * ((2:ℝ) ^ θ) ^ k * Ls ^ θ) :=
          mul_le_mul_of_nonneg_right hcnt hwnn
      _ ≤ K0 * (Mr * Ls ^ 2) / (2 ^ k * Ls) ^ 2 * (2 ^ θ * ((2:ℝ) ^ θ) ^ k * Ls ^ θ) := by
          gcongr
      _ = K0 * 2 ^ θ * Mr * Ls ^ θ * r ^ k := by
          have h4k : (4:ℝ) ^ k = ((2:ℝ) ^ k) ^ 2 := by
            rw [← pow_mul, mul_comm k 2, pow_mul]
            norm_num
          have hLs' : Ls ≠ 0 := hLs.ne'
          rw [hr, div_pow, h4k]
          field_simp
  have hgeom := geom_le r hr0 hr1 K
  have hA : (S.card : ℝ) * Ls ^ θ ≤ (3 * Mr + 1) * Ls ^ θ :=
    mul_le_mul_of_nonneg_right hcard hLsθ
  have hB : ∑ k ∈ Finset.range K, ∑ j ∈ S,
      (if 2 ^ k * Ls ≤ ℓ j then ((2:ℝ) ^ (k + 1) * Ls) ^ θ else 0)
        ≤ K0 * 2 ^ θ * Mr * Ls ^ θ * (1 / (1 - r)) := by
    calc ∑ k ∈ Finset.range K, ∑ j ∈ S,
          (if 2 ^ k * Ls ≤ ℓ j then ((2:ℝ) ^ (k + 1) * Ls) ^ θ else 0)
        ≤ ∑ k ∈ Finset.range K, K0 * 2 ^ θ * Mr * Ls ^ θ * r ^ k := Finset.sum_le_sum hshell
      _ = K0 * 2 ^ θ * Mr * Ls ^ θ * ∑ k ∈ Finset.range K, r ^ k := by rw [Finset.mul_sum]
      _ ≤ K0 * 2 ^ θ * Mr * Ls ^ θ * (1 / (1 - r)) := by
          apply mul_le_mul_of_nonneg_left hgeom
          have : (0:ℝ) ≤ Mr := by linarith
          positivity
  have hC : (3 * Mr + 1) * Ls ^ θ ≤ 4 * Mr * Ls ^ θ := by nlinarith
  have e : K0 * 2 ^ θ * Mr * Ls ^ θ * (1 / (1 - r)) = K0 * 2 ^ θ / (1 - r) * Mr * Ls ^ θ := by
    ring
  calc ∑ j ∈ S, ℓ j ^ θ
      ≤ ∑ j ∈ S, (Ls ^ θ + ∑ k ∈ Finset.range K,
          (if 2 ^ k * Ls ≤ ℓ j then ((2:ℝ) ^ (k + 1) * Ls) ^ θ else 0)) := Finset.sum_le_sum hpt
    _ = (S.card : ℝ) * Ls ^ θ + ∑ k ∈ Finset.range K, ∑ j ∈ S,
          (if 2 ^ k * Ls ≤ ℓ j then ((2:ℝ) ^ (k + 1) * Ls) ^ θ else 0) := by
        rw [Finset.sum_add_distrib, Finset.sum_const, nsmul_eq_mul, Finset.sum_comm]
    _ ≤ 4 * Mr * Ls ^ θ + K0 * 2 ^ θ / (1 - r) * Mr * Ls ^ θ := by
        rw [← e]
        linarith
    _ = (4 + K0 * 2 ^ θ / (1 - r)) * Mr * Ls ^ θ := by ring

end QuarticPaid.Source
namespace QuarticPaid

open scoped BigOperators

private abbrev rho := ActualSourceGrid.rho
private def cells (D E : ℝ) (M : ℕ) : Finset ℕ :=
  @Finset.filter ℕ
    (fun j => D/(2*E) ≤ rho D E M j ∧ rho D E M j ≤ 2*D/E)
    (Classical.decPred _) (Finset.range (3*M+1))

private def nsq (α r c : ℝ) (v : ℤ × ℤ) : ℝ :=
  (α * ((v.1 : ℝ) - r * (v.2 : ℝ))) ^ 2 + ((v.2 : ℝ) / c) ^ 2

private def length (α r c : ℝ) (v : ℤ × ℤ) : ℝ := 2 / Real.sqrt (nsq α r c v)

private lemma int_abs_one (n : ℤ) (hn : n ≠ 0) :
    (1 : ℝ) ≤ |(n : ℝ)| := by
  have h : (1 : ℤ) ≤ |n| := by
    by_cases hneg : n < 0
    · rw [abs_of_neg hneg]
      omega
    · rw [abs_of_nonneg (by omega : 0 ≤ n)]
      omega
  exact_mod_cast h

private lemma sqrt_two_squares_left (p q : ℝ) :
    |p| ≤ Real.sqrt (p ^ 2 + q ^ 2) :=
  Real.abs_le_sqrt (by nlinarith [sq_nonneg q])

private lemma sqrt_two_squares_right (p q : ℝ) :
    |q| ≤ Real.sqrt (p ^ 2 + q ^ 2) :=
  Real.abs_le_sqrt (by nlinarith [sq_nonneg p])

private lemma length_pos_cap (κ a b : ℝ) (M : ℕ) (r : ℝ)
    (hκ : 1 ≤ κ) (ha : 0 < a) (hb : 0 < b) (hM : 1 ≤ M)
    (v : ℤ × ℤ) (hv : v ≠ 0) :
    0 < length ((M : ℝ) / (κ * a)) r (2 * b) v ∧
      length ((M : ℝ) / (κ * a)) r (2 * b) v ≤ 2 * κ * a + 4 * b := by
  have hκ0 : 0 < κ := by linarith
  have hM1 : (1 : ℝ) ≤ M := by exact_mod_cast hM
  have hM0 : (0 : ℝ) < M := by linarith
  let α : ℝ := (M : ℝ) / (κ * a)
  let p : ℝ := α * ((v.1 : ℝ) - r * (v.2 : ℝ))
  let q : ℝ := (v.2 : ℝ) / (2 * b)
  have hα : 0 < α := by dsimp [α]; positivity
  have hleft := sqrt_two_squares_left p q
  have hright := sqrt_two_squares_right p q
  by_cases hv2 : v.2 = 0
  · have hv1 : v.1 ≠ 0 := by
      intro hh
      apply hv
      exact Prod.ext hh hv2
    have hp : α ≤ |p| := by
      have hz := int_abs_one v.1 hv1
      dsimp [p]
      rw [hv2, Int.cast_zero, mul_zero, sub_zero, abs_mul, abs_of_pos hα]
      nlinarith only [hz, hα]
    have hn : 0 < Real.sqrt (p ^ 2 + q ^ 2) := hα.trans_le (hp.trans hleft)
    have hcap : 2 / Real.sqrt (p ^ 2 + q ^ 2) ≤ 2 / α :=
      div_le_div_of_nonneg_left (by norm_num) hα (hp.trans hleft)
    have hcancel : 2 / α = 2 * κ * a / (M : ℝ) := by
      dsimp [α]
      field_simp [hM0.ne', hκ0.ne', ha.ne']

    have hfinal : 2 * κ * a / (M : ℝ) ≤ 2 * κ * a := by
      apply (div_le_iff₀ hM0).mpr
      nlinarith only [mul_le_mul_of_nonneg_left hM1
        (show 0 ≤ 2 * κ * a by positivity)]
    change 0 < 2 / Real.sqrt (p ^ 2 + q ^ 2) ∧
      2 / Real.sqrt (p ^ 2 + q ^ 2) ≤ 2 * κ * a + 4 * b
    exact ⟨div_pos (by norm_num) hn, by rw [hcancel] at hcap; linarith⟩
  · have hz := int_abs_one v.2 hv2
    have hq : 1 / (2 * b) ≤ |q| := by
      dsimp [q]
      rw [abs_div, abs_of_pos (by positivity : 0 < 2 * b)]
      exact div_le_div_of_nonneg_right hz (by positivity)
    have hn : 0 < Real.sqrt (p ^ 2 + q ^ 2) :=
      (by positivity : 0 < 1 / (2 * b)).trans_le (hq.trans hright)
    have hcap : 2 / Real.sqrt (p ^ 2 + q ^ 2) ≤ 2 / (1 / (2 * b)) :=
      div_le_div_of_nonneg_left (by norm_num) (by positivity) (hq.trans hright)
    have hid : 2 / (1 / (2 * b)) = 4 * b := by field_simp ; ring
    change 0 < 2 / Real.sqrt (p ^ 2 + q ^ 2) ∧
      2 / Real.sqrt (p ^ 2 + q ^ 2) ≤ 2 * κ * a + 4 * b
    exact ⟨div_pos (by norm_num) hn, by rw [hid] at hcap; nlinarith [mul_pos hκ0 ha]⟩

private theorem grid_tail (κ a b : ℝ) (M : ℕ)
    (hκ : 1 ≤ κ) (ha : 0 < a) (hb : 0 < b) (hM : 1 ≤ M)
    (S : Finset ℕ) (f : ℕ → ℝ)
    (hsp : ∀ i j : ℕ, i ≤ j →
      ((j : ℝ) - i) * (a / (8 * b * (M : ℝ))) ≤ f j - f i)
    (hf : ∀ j ∈ S, a / (8 * b) ≤ f j ∧ f j ≤ 8 * a / b)
    (v : ℕ → ℤ × ℤ) (hv : ∀ j ∈ S, v j ≠ 0)
    (L : ℝ) (hcut : 64 * κ * (a + b) / (M : ℝ) ≤ L) :
    ((S.filter (fun j => L ≤ length ((M : ℝ) / (κ * a)) (f j) (2 * b) (v j))).card : ℝ) ≤
      (4096 * κ) * (a * b) / L ^ 2 := by
  classical
  have hκ0 : 0 < κ := by linarith
  have hM1 : (1 : ℝ) ≤ M := by exact_mod_cast hM
  have hM0 : (0 : ℝ) < M := by linarith
  have hcut0 : 0 < 64 * κ * (a + b) / (M : ℝ) := by positivity
  have hL : 0 < L := hcut0.trans_le hcut
  have hLM : 64 * κ * (a + b) ≤ (M : ℝ) * L := by
    have ht := (div_le_iff₀ hM0).mp hcut
    nlinarith only [ht]
  let err : ℝ := 2 * κ * a / ((M : ℝ) * L)
  let den : ℝ := 4 * b / L
  let g : ℝ := a / (8 * b * (M : ℝ))
  let fmax : ℝ := 8 * a / b
  let P : Finset ℕ :=
    S.filter (fun j => L ≤ length ((M : ℝ) / (κ * a)) (f j) (2 * b) (v j))
  have he0 : 0 ≤ err := by dsimp [err]; positivity
  have hd0 : 0 ≤ den := by dsimp [den]; positivity
  have hg : 0 < g := by dsimp [g]; positivity
  have hfm : 0 ≤ fmax := by dsimp [fmax]; positivity
  have herr1 : err < 1 := by
    apply (div_lt_one (by positivity : 0 < (M : ℝ) * L)).mpr
    have hp : 0 < κ * (62 * a + 64 * b) := by positivity
    nlinarith only [hLM, hp]
  have herrf : err < a / (8 * b) := by
    apply (div_lt_div_iff₀ (by positivity : 0 < (M : ℝ) * L)
      (by positivity : 0 < 8 * b)).mpr
    have ht := mul_le_mul_of_nonneg_left hLM ha.le
    have hp : 0 < κ * a * (64 * a + 48 * b) := by positivity
    nlinarith only [ht, hp]
  have hPsub : P ⊆ S := Finset.filter_subset _ _
  have hWitness : ∀ j ∈ P, ∃ z1 z2 : ℤ, (z1, z2) ≠ (0 : ℤ × ℤ) ∧
      |(z1 : ℝ) - f j * z2| ≤ err ∧ |(z2 : ℝ)| ≤ den := by
    intro j hj
    have hjS := hPsub hj
    have hjL := (Finset.mem_filter.mp hj).2
    have hp := Source.coords_of_inv_norm L
      ((M : ℝ) / (κ * a) * (((v j).1 : ℝ) - f j * ((v j).2 : ℝ)))
      (((v j).2 : ℝ) / (2 * b)) hL hjL
    have he := Source.scaled_abs ((M : ℝ) / (κ * a))
      (((v j).1 : ℝ) - f j * ((v j).2 : ℝ)) (2 / L) (by positivity) hp.1
    have hd := Source.div_abs_le ((v j).2 : ℝ) (2 * b) (2 / L) (by positivity) hp.2
    have heq : (2 / L) / ((M : ℝ) / (κ * a)) = err := by
      dsimp [err]
      field_simp [hL.ne', hM0.ne', hκ0.ne', ha.ne']
      <;> ring
    have hdq : (2 / L) * (2 * b) = den := by dsimp [den]; ring
    rw [heq] at he
    rw [hdq] at hd
    exact ⟨(v j).1, (v j).2, hv j hjS, he, hd⟩
  have hCard := Source.tail_abstract f g (a / (8 * b)) fmax err den hg hsp
    S (fun j hj => (hf j hj).1) (fun j hj => (hf j hj).2)
    he0 herr1 herrf P hPsub hWitness
  let N : ℕ := ⌊den⌋₊
  have hN : (N : ℝ) ≤ den := Nat.floor_le hd0
  have hSum := Source.sum_bound fmax err g N hfm he0 hg
  have hminmax : a / (8 * b) ≤ fmax := by
    dsimp [fmax]
    apply (div_le_div_iff₀ (by positivity : 0 < 8 * b) hb).mpr
    nlinarith [mul_pos ha hb]
  have hemax : err ≤ fmax := herrf.le.trans hminmax
  have hesq : err ^ 2 ≤ err * fmax := by nlinarith [mul_le_mul_of_nonneg_left hemax he0]
  have ht : fmax * (N : ℝ) + err + 2 * err * fmax / g + 2 * err ^ 2 / g ≤
      fmax * den + err + 4 * err * fmax / g := by
    have hn := mul_le_mul_of_nonneg_left hN hfm
    have he := div_le_div_of_nonneg_right
      (mul_le_mul_of_nonneg_left hesq (by norm_num : (0 : ℝ) ≤ 2)) hg.le
    have he' : 2 * err ^ 2 / g ≤ 2 * err * fmax / g := by
      simpa only [mul_assoc] using he
    calc
      fmax * (N : ℝ) + err + 2 * err * fmax / g + 2 * err ^ 2 / g ≤
          fmax * den + err + 2 * err * fmax / g + 2 * err * fmax / g :=
        by
          simpa only [add_comm, add_left_comm, add_assoc] using
            (add_le_add
              (add_le_add_right (add_le_add_right hn err) (2 * err * fmax / g)) he')
      _ = fmax * den + err + 4 * err * fmax / g := by
        field_simp [hg.ne']
        <;> ring
  have hval0 : 0 ≤ fmax * den + err + 4 * err * fmax / g := by positivity
  have hid : den * (fmax * den + err + 4 * err * fmax / g) =
      (128 + 2048 * κ) * (a * b) / L ^ 2 +
        8 * κ * (a * b) / ((M : ℝ) * L ^ 2) := by
    dsimp [den, fmax, err, g]
    field_simp [ha.ne', hb.ne', hM0.ne', hL.ne']
    <;> ring
  have hMterm : 8 * κ * (a * b) / ((M : ℝ) * L ^ 2) ≤
      8 * κ * (a * b) / L ^ 2 := by
    apply div_le_div_of_nonneg_left (by positivity) (by positivity : 0 < L ^ 2)
    nlinarith only [mul_le_mul_of_nonneg_right hM1 (sq_nonneg L)]
  change (P.card : ℝ) ≤ _
  calc
    (P.card : ℝ) ≤
        (N : ℝ) * (fmax * (N : ℝ) + err + 2 * err * fmax / g + 2 * err ^ 2 / g) :=
      hCard.trans hSum
    _ ≤ (N : ℝ) * (fmax * den + err + 4 * err * fmax / g) :=
      mul_le_mul_of_nonneg_left ht (Nat.cast_nonneg N)
    _ ≤ den * (fmax * den + err + 4 * err * fmax / g) :=
      mul_le_mul_of_nonneg_right hN hval0
    _ = (128 + 2048 * κ) * (a * b) / L ^ 2 +
        8 * κ * (a * b) / ((M : ℝ) * L ^ 2) := hid
    _ ≤ (128 + 2056 * κ) * (a * b) / L ^ 2 := by
      calc
        (128 + 2048 * κ) * (a * b) / L ^ 2 +
            8 * κ * (a * b) / ((M : ℝ) * L ^ 2) ≤
            (128 + 2048 * κ) * (a * b) / L ^ 2 + 8 * κ * (a * b) / L ^ 2 :=
          by
            simpa only [add_comm, add_left_comm, add_assoc] using
              (add_le_add_left hMterm ((128 + 2048 * κ) * (a * b) / L ^ 2))
        _ = (128 + 2056 * κ) * (a * b) / L ^ 2 := by
          field_simp [hL.ne']
          <;> ring
    _ ≤ (4096 * κ) * (a * b) / L ^ 2 := by
      apply div_le_div_of_nonneg_right _ (sq_nonneg L)
      exact mul_le_mul_of_nonneg_right (by linarith : 128 + 2056 * κ ≤ 4096 * κ)
        (mul_nonneg ha.le hb.le)
private lemma mem_cells (D E : ℝ) (M j : ℕ) :
    j  ∈  cells D E M ↔ j  ∈  Finset.range (3*M+1)  ∧ 
      D/(2*E)  ≤  rho D E M j  ∧  rho D E M j  ≤  2*D/E := by
  simp only [cells,cells,Finset.mem_filter]

private lemma cell_card (D E : ℝ) (M : ℕ) :
    ((cells D E M).card : ℝ)  ≤  3 * (M : ℝ) + 1 := by
  classical
  have hsub : cells D E M  ⊆  Finset.range (3*M+1) := by
    intro j hj
    exact ((mem_cells D E M j).mp hj).1
  have hc : (cells D E M).card  ≤  3*M+1 :=
    (Finset.card_le_card hsub).trans_eq (Finset.card_range _)
  exact_mod_cast hc

private lemma rho_lower (D E : ℝ) (M : ℕ)
    (hD : 0 < D) (hE : 0 < E) (hM : 1  ≤  M) (j : ℕ) :
    D / (2 * E)  ≤  rho D E M j := by
  have hM0 : (0 : ℝ) < M := by exact_mod_cast (show 0 < M by omega)
  have hbase : (1 : ℝ)  ≤  1 + 1 / (M : ℝ) := by
    have hi : 0  ≤  1 / (M : ℝ) := by positivity
    linarith only [hi]
  have hp : (1 : ℝ)  ≤  (1 + 1 / (M : ℝ)) ^ j := one_le_pow₀ hbase
  change D / (2 * E)  ≤  D / (2 * E) * (1 + 1 / (M : ℝ)) ^ j
  nlinarith only [mul_le_mul_of_nonneg_left hp (show 0  ≤  D / (2 * E) by positivity)]

private lemma rho_step (D E : ℝ) (M j : ℕ) :
    rho D E M (j + 1) = rho D E M j * (1 + 1 / (M : ℝ)) := by
  change D / (2 * E) * (1 + 1 / (M : ℝ)) ^ (j + 1) =
    (D / (2 * E) * (1 + 1 / (M : ℝ)) ^ j) * (1 + 1 / (M : ℝ))
  rw [pow_succ, mul_assoc]

private lemma linear_grid (D E : ℝ) (M : ℕ)
    (hD : 0 < D) (hE : 0 < E) (hM : 1  ≤  M) :
    (∀ i j : ℕ, i  ≤  j  → 
      ((j : ℝ) - i) * (D / (8 * E * (M : ℝ)))  ≤ 
        rho D E M j - rho D E M i)  ∧ 
    (∀ j  ∈  cells D E M, D / (8 * E)  ≤  rho D E M j  ∧ 
      rho D E M j  ≤  8 * D / E) := by
  classical
  have hM0 : (0 : ℝ) < M := by exact_mod_cast (show 0 < M by omega)
  refine ⟨Source.spacing_of_step _ _ ?_, ?_⟩
  · intro j
    rw [rho_step]
    have hlo := rho_lower D E M hD hE hM j
    have hm := mul_le_mul_of_nonneg_right hlo
      (show 0  ≤  1 / (M : ℝ) by positivity)
    have heq : D / (2 * E) * (1 / (M : ℝ)) =
        D / (2 * E * (M : ℝ)) := by
      field_simp [hE.ne', hM0.ne']
      <;> ring
    have hrat : D / (8 * E * (M : ℝ))  ≤  D / (2 * E * (M : ℝ)) := by
      apply (div_le_div_iff₀ (by positivity : 0 < 8 * E * (M : ℝ))
        (by positivity : 0 < 2 * E * (M : ℝ))).mpr
      nlinarith only [mul_pos hD (mul_pos hE hM0)]
    rw [heq] at hm
    nlinarith only [hm, hrat]
  · intro j hj
    have hc := ((mem_cells D E M j).mp hj).2
    have heq1 : D / (8 * E) = (D / E) / 8 := by field_simp [hE.ne'] <;> ring
    have heq2 : D / (2 * E) = (D / E) / 2 := by field_simp [hE.ne'] <;> ring
    have heq3 : 2 * D / E = 2 * (D / E) := by ring
    have heq4 : 8 * D / E = 8 * (D / E) := by ring
    change D / (2 * E)  ≤  rho D E M j  ∧  rho D E M j  ≤  2 * D / E at hc
    rw [heq1, heq4]
    rw [heq2, heq3] at hc
    have hpos : 0 < D / E := div_pos hD hE
    constructor <;> linarith only [hc.1, hc.2, hpos]

private def scaleA (D E U V : ℝ) (M j : ℕ) : ℝ :=
  if rho D E M j  ≤  D/E then V else 2*V

private def scaleB (D E U V : ℝ) (M j : ℕ) : ℝ :=
  if rho D E M j  ≤  D/E then 2*U else U

private lemma scale_bounds (D E U V : ℝ) (M j : ℕ)
    (hU : 0<U) (hV : 0<V) :
    V  ≤  scaleA D E U V M j  ∧  scaleA D E U V M j  ≤  2*V  ∧ 
    U  ≤  scaleB D E U V M j  ∧  scaleB D E U V M j  ≤  2*U := by
  by_cases hcut : rho D E M j  ≤  D/E
  · simp only [scaleA,scaleB,if_pos hcut]
    exact ⟨le_rfl,by linarith only [hV],by linarith only [hU],le_rfl⟩
  · simp only [scaleA,scaleB,if_neg hcut]
    exact ⟨by linarith only [hV],le_rfl,le_rfl,by linarith only [hU]⟩

private lemma quartic_grid (D E U V : ℝ) (M : ℕ)
    (hD : 0<D) (hE : 0<E) (hU : 0<U) (hV : 0<V)
    (hM : 1 ≤ M) (hscale : (D/E)^4=V/U) :
    (∀ i j : ℕ, i ≤ j  → 
      ((j : ℝ)-i)*(V/(4*U*(M : ℝ)))  ≤ 
        (rho D E M j)^4-(rho D E M i)^4)  ∧ 
    (∀ j ∈ cells D E M, V/(16*U)  ≤  (rho D E M j)^4  ∧ 
      (rho D E M j)^4  ≤  16*V/U) := by
  have hM0 : (0 : ℝ)<M := by exact_mod_cast (show 0<M by omega)
  have hw : 0  ≤  1/(M : ℝ) := by positivity
  have hbinomial : 4/(M : ℝ)  ≤  (1+1/(M : ℝ))^4-1 := by
    have hid : (1+1/(M : ℝ))^4-1-4/(M : ℝ) =
        (1/(M : ℝ))^2*((1/(M : ℝ))^2+4*(1/(M : ℝ))+6) := by
      field_simp [hM0.ne']
      <;> ring
    apply sub_nonneg.mp
    rw [hid]
    positivity
  have hlow : ∀ j, V/(16*U)  ≤  (rho D E M j)^4 := by
    intro j
    have ht := pow_le_pow_left₀ (by positivity : 0 ≤ D/(2*E))
      (rho_lower D E M hD hE hM j) 4
    have heq : (D/(2*E))^4=V/(16*U) := by
      calc
        (D/(2*E))^4=(D/E)^4/16 := by field_simp [hE.ne'] <;> ring
        _ = V/(16*U) := by rw [hscale]; ring
    rwa [heq] at ht
  refine ⟨Source.spacing_of_step _ _ ?_, ?_⟩
  · intro j
    have h1 := mul_le_mul_of_nonneg_left hbinomial
      ((by positivity : 0<V/(16*U)).le.trans (hlow j))
    have h2 := mul_le_mul_of_nonneg_right (hlow j)
      (show 0 ≤ 4/(M : ℝ) by positivity)
    have heq : (rho D E M (j+1))^4-(rho D E M j)^4 =
        (rho D E M j)^4*((1+1/(M : ℝ))^4-1) := by
      rw [rho_step, mul_pow]
      ring
    have heq' : V/(16*U)*(4/(M : ℝ))=V/(4*U*(M : ℝ)) := by ring
    rw [heq]
    nlinarith only [h1,h2,heq']
  · intro j hj
    refine ⟨hlow j, ?_⟩
    have hc := ((mem_cells D E M j).mp hj).2
    have hr0 : 0 ≤ rho D E M j := (by positivity : 0<D/(2*E)).le.trans hc.1
    have ht := pow_le_pow_left₀ hr0 hc.2 4
    have heq : (2*D/E)^4=16*V/U := by
      calc
        (2*D/E)^4=16*(D/E)^4 := by field_simp [hE.ne'] <;> ring
        _ = 16*V/U := by rw [hscale]; ring
    rwa [heq] at ht

private lemma quartic_windows (D E U V : ℝ) (M : ℕ)
    (hD : 0<D) (hE : 0<E) (hU : 0<U) (hV : 0<V)
    (hM : 1 ≤ M) (hscale : (D/E)^4=V/U) :
    (∀ j ∈ cells D E M, rho D E M j  ≤  D/E  → 
      V/(8*(2*U))  ≤  (rho D E M j)^4  ∧ 
      (rho D E M j)^4  ≤  8*V/(2*U))  ∧ 
    (∀ j ∈ cells D E M, ¬ rho D E M j  ≤  D/E  → 
      (2*V)/(8*U)  ≤  (rho D E M j)^4  ∧ 
      (rho D E M j)^4  ≤  8*(2*V)/U) := by
  have hg := (quartic_grid D E U V M hD hE hU hV hM hscale).2
  constructor
  · intro j hj hcut
    have hc := ((mem_cells D E M j).mp hj).2
    have hr0 : 0 ≤ rho D E M j := (by positivity : 0<D/(2*E)).le.trans hc.1
    have hup := pow_le_pow_left₀ hr0 hcut 4
    rw [hscale] at hup
    constructor
    · convert (hg j hj).1 using 1 <;> ring
    · have hp : 0 ≤ V/U := by positivity
      have heq : 8*V/(2*U)=4*(V/U) := by ring
      rw [heq]
      linarith only [hup,hp]
  · intro j hj hcut
    have hl := pow_le_pow_left₀ (by positivity : 0 ≤ D/E)
      (le_of_lt (lt_of_not_ge hcut)) 4
    rw [hscale] at hl
    constructor
    · have hp : 0 ≤ V/U := by positivity
      have heq : (2*V)/(8*U)=(V/U)/4 := by ring
      rw [heq]
      linarith only [hl,hp]
    · convert (hg j hj).2 using 1 <;> ring

open FormalAB.S5ecab545.JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C09.PcPellRed
set_option maxHeartbeats 2000000

private lemma cells_eq_indices (D E : ℝ) (M : ℕ)
    (hD : 0<D) (hE : 0<E) (hM : 1≤M) :
    ∀ j, j ∈ cells D E M ↔ j ∈ ActualSourceGrid.indices D E M := by
  have hM0 : (0:ℝ)<M := by exact_mod_cast (show 0<M by omega)
  intro j
  rw [mem_cells]
  change (j ∈ Finset.range (3*M+1) ∧
    D/(2*E)≤rho D E M j ∧ rho D E M j≤2*D/E) ↔
    (D/(2*E)≤rho D E M j ∧ rho D E M j≤2*D/E)
  constructor
  · exact fun h => h.2
  · intro hj
    have hc0 : 0<D/(2*E) := by positivity
    have hqj : (1+1/(M:ℝ))^j≤4 := by
      have h3 : D/(2*E)*(1+1/(M:ℝ))^j≤D/(2*E)*4 := by
        calc
          _ ≤ 2*D/E := hj.2
          _ = _ := by field_simp; ring
      exact le_of_mul_le_mul_left h3 hc0
    have hber := one_add_mul_le_pow (a:=1/(M:ℝ)) (by
      have hh : 0≤1/(M:ℝ) := by positivity
      linarith) j
    have h4 : (j:ℝ)*(1/(M:ℝ))≤3 := by linarith
    have h5 : (j:ℝ)≤3*(M:ℝ) := by
      rw [mul_one_div,div_le_iff₀ hM0] at h4
      linarith
    have hjn : j≤3*M := by exact_mod_cast h5
    exact ⟨Finset.mem_range.mpr (by omega),hj⟩

lemma full_grid_finite (D E : ℝ) (M : ℕ)
    (hD : 0<D) (hE : 0<E) (hM : 1≤M) :
    (ActualSourceGrid.indices D E M).Finite ∧
    ((ActualSourceGrid.indices D E M).ncard:ℝ)≤3*(M:ℝ)+1 := by
  have heq : ActualSourceGrid.indices D E M = (cells D E M : Set ℕ) := by
    ext j
    exact (cells_eq_indices D E M hD hE hM j).symm
  rw [heq]
  exact ⟨Finset.finite_toSet _,by simpa only [Set.ncard_coe_finset] using cell_card D E M⟩

private lemma minimal_length_compare (U V : ℝ) (M : ℕ) (s : ℝ)
    (hU : 0<U) (hV : 0<V) (hM : (0:ℝ)<M) :
    ∃ b : ℤ×ℤ, b≠0 ∧
      JointSecondMoments.ell V U M s ≤ length ((M:ℝ)/V) s (2*(2*U)) b ∧
      JointSecondMoments.ell V U M s ≤ length ((M:ℝ)/(2*V)) s (2*U) b := by
  obtain ⟨b,hb,heq,hpos⟩ := CofactorCubic.minimumAt U V M s hU hV hM
  have hp : 0<Real.sqrt (nsq ((M:ℝ)/V) s U b) := by
    change 0<Real.sqrt (FormalAB.S5ecab545.JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C09.PcPellRed.nsq ((M:ℝ)/V) s U b)
    rw [←heq]
    exact hpos
  have hell : JointSecondMoments.ell V U M s =
      1/Real.sqrt (nsq ((M:ℝ)/V) s U b) := by
    change 1/CofactorCubic.lambdaAt U V M s=_
    rw [heq]
    rfl
  have hnorm (a c : ℝ) (ha : a=(M:ℝ)/V ∨ a=(M:ℝ)/(2*V))
      (hc : c=4*U ∨ c=2*U) :
      Real.sqrt (nsq a s c b)≤Real.sqrt (nsq ((M:ℝ)/V) s U b) := by
    apply Real.sqrt_le_sqrt
    rcases ha with rfl|rfl <;> rcases hc with rfl|rfl
    all_goals
      unfold nsq
      have e1 : (M:ℝ)/(2*V)*((b.1:ℝ)-s*(b.2:ℝ)) =
          ((M:ℝ)/V*((b.1:ℝ)-s*(b.2:ℝ)))/2 := by field_simp <;> ring
      have e2 : (b.2:ℝ)/(4*U)=((b.2:ℝ)/U)/4 := by field_simp <;> ring
      have e3 : (b.2:ℝ)/(2*U)=((b.2:ℝ)/U)/2 := by field_simp <;> ring
      simp only [e1,e2,e3]
      nlinarith [sq_nonneg ((M:ℝ)/V*((b.1:ℝ)-s*(b.2:ℝ))),sq_nonneg ((b.2:ℝ)/U)]
  have hnpos (a c : ℝ) (ha:0<a) (hc:0<c) :
      0<Real.sqrt (nsq a s c b) := by
    change 0<Real.sqrt (FormalAB.S5ecab545.JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C09.PcPellRed.nsq a s c b)
    exact Real.sqrt_pos.mpr (nsq_pos a s c ha hc b hb)
  refine ⟨b,hb,?_,?_⟩
  · rw [hell]
    unfold length
    have hn := hnorm ((M:ℝ)/V) (2*(2*U)) (Or.inl rfl) (Or.inl (by ring))
    calc
      _ ≤ 1/Real.sqrt (nsq ((M:ℝ)/V) s (2*(2*U)) b) :=
        one_div_le_one_div_of_le (hnpos _ _ (by positivity) (by positivity)) hn
      _ ≤ _ := by gcongr <;> norm_num
  · rw [hell]
    unfold length
    have hn := hnorm ((M:ℝ)/(2*V)) (2*U) (Or.inr rfl) (Or.inr rfl)
    calc
      _ ≤ 1/Real.sqrt (nsq ((M:ℝ)/(2*V)) s (2*U) b) :=
        one_div_le_one_div_of_le (hnpos _ _ (by positivity) (by positivity)) hn
      _ ≤ _ := by gcongr <;> norm_num

lemma actual_quartic_tail (D E U V : ℝ) (M : ℕ)
    (hD : 0<D) (hE : 0<E) (hU : 0<U) (hV : 0<V)
    (hM : 1≤M) (hscale : (D/E)^4=V/U)
    (S : Finset ℕ)
    (hS : ∀ j∈S, j∈ActualSourceGrid.indices D E M)
    (H : ℝ) (hH : 128*(U+V)/(M:ℝ)≤H) :
    ((S.filter (fun j => H≤JointSecondMoments.ell V U M ((rho D E M j)^4))).card:ℝ)
      ≤16384*U*V/H^2 := by
  classical
  have hM0 : (0:ℝ)<M := by exact_mod_cast (show 0<M by omega)
  have hH0 : 0<H := (by positivity : 0<128*(U+V)/(M:ℝ)).trans_le hH
  choose b hb hlo hhi using
    fun j => minimal_length_compare U V M ((rho D E M j)^4) hU hV hM0
  let Sl := S.filter (fun j => rho D E M j≤D/E)
  let Sh := S.filter (fun j => ¬rho D E M j≤D/E)
  have hsp := (quartic_grid D E U V M hD hE hU hV hM hscale).1
  have hw := quartic_windows D E U V M hD hE hU hV hM hscale
  have hcl : ∀ j∈S,j∈cells D E M := by
    intro j hj
    exact (cells_eq_indices D E M hD hE hM j).mpr (hS j hj)
  have lowsp : ∀ i j:ℕ,i≤j →
      ((j:ℝ)-i)*(V/(8*(2*U)*(M:ℝ)))≤(rho D E M j)^4-(rho D E M i)^4 := by
    intro i j hij
    have hd : 0≤(j:ℝ)-i := sub_nonneg.mpr (by exact_mod_cast hij)
    have hs : V/(8*(2*U)*(M:ℝ))≤V/(4*U*(M:ℝ)) := by
      apply div_le_div_of_nonneg_left hV.le (by positivity)
      nlinarith
    exact (mul_le_mul_of_nonneg_left hs hd).trans (hsp i j hij)
  have hiwsp : ∀ i j:ℕ,i≤j →
      ((j:ℝ)-i)*((2*V)/(8*U*(M:ℝ)))≤(rho D E M j)^4-(rho D E M i)^4 := by
    intro i j hij
    convert hsp i j hij using 1 <;> ring
  have hcutl : 64*(1:ℝ)*(V+2*U)/(M:ℝ)≤H := by
    apply le_trans _ hH
    apply div_le_div_of_nonneg_right _ hM0.le
    linarith
  have hcuth : 64*(1:ℝ)*(2*V+U)/(M:ℝ)≤H := by
    apply le_trans _ hH
    apply div_le_div_of_nonneg_right _ hM0.le
    linarith
  have tl := grid_tail 1 V (2*U) M
    (by norm_num) hV (by positivity) hM Sl (fun j => (rho D E M j)^4) lowsp
    (fun j hj => hw.1 j (hcl j (Finset.mem_filter.mp hj).1) (Finset.mem_filter.mp hj).2)
    b (fun j _ => hb j) H hcutl
  have th := grid_tail 1 (2*V) U M
    (by norm_num) (by positivity) hU hM Sh (fun j => (rho D E M j)^4) hiwsp
    (fun j hj => hw.2 j (hcl j (Finset.mem_filter.mp hj).1) (Finset.mem_filter.mp hj).2)
    b (fun j _ => hb j) H hcuth
  let Pl := Sl.filter (fun j => H≤length ((M:ℝ)/(1*V)) ((rho D E M j)^4) (2*(2*U)) (b j))
  let Ph := Sh.filter (fun j => H≤length ((M:ℝ)/(1*(2*V))) ((rho D E M j)^4) (2*U) (b j))
  have hsub : S.filter (fun j => H≤JointSecondMoments.ell V U M ((rho D E M j)^4)) ⊆ Pl∪Ph := by
    intro j hj
    obtain ⟨hjS,hjH⟩ := Finset.mem_filter.mp hj
    by_cases hc : rho D E M j≤D/E
    · apply Finset.mem_union.mpr
      left
      exact Finset.mem_filter.mpr ⟨Finset.mem_filter.mpr ⟨hjS,hc⟩,by simpa only [one_mul] using hjH.trans (hlo j)⟩
    · apply Finset.mem_union.mpr
      right
      exact Finset.mem_filter.mpr ⟨Finset.mem_filter.mpr ⟨hjS,hc⟩,by simpa only [one_mul] using hjH.trans (hhi j)⟩
  have hcnt : ((S.filter (fun j => H≤JointSecondMoments.ell V U M ((rho D E M j)^4))).card:ℝ)
      ≤(Pl.card:ℝ)+(Ph.card:ℝ) := by
    exact_mod_cast (Finset.card_le_card hsub).trans (Finset.card_union_le _ _)
  calc
    _ ≤ (Pl.card:ℝ)+(Ph.card:ℝ) := hcnt
    _ ≤ (4096*1)*(V*(2*U))/H^2+(4096*1)*((2*V)*U)/H^2 := add_le_add tl th
    _ = _ := by ring

end QuarticPaid
