  have hl : 0≤t-s := sub_nonneg.mpr hst
  have hK1 : 0≤C0^28/(δ^8*cM^7) := by positivity
  have hK2 : 0≤(327680000:ℝ)^4*(8*C0^3)^7 := by positivity
  have hlargeout (hh:δ*W^4≤μ^7*x) :
      (t-s)^28*M^21*W^4≤(C0^28/(δ^8*cM^7)+(327680000:ℝ)^4*(8*C0^3)^7)*x^7 ∨ t-s≤C0/(δ*cM) := by
    have hh' := large_length C0 cM δ x M W μ (J:ℝ) (t-s)
