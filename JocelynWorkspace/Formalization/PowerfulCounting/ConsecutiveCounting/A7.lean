    (hu1 : 1 ≤ u) (hv1 : 1 ≤ v)
    (hdlo : D / 2 < d) (hdhi : d ≤ D)
    (helo : E / 2 < e) (hehi : e ≤ E)
    (hn : d ^ 4 * u ≤ x)
    (hunit : e ^ 4 * v - d ^ 4 * u = 1) :
