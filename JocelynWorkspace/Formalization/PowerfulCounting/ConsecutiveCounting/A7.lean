        dsimp [A]
        linarith only [hp,hCm]
      have hLm : (∑ j ∈ quarticCells D E M, (L j)^2) ≤ A*RD :=
        hraw.1.trans (by
          dsimp [A]
          exact mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_right (by linarith only [hCm] : Cm ≤ 1+256*Cm) hηx0) hRD.le)
      have hTm : (∑ j ∈ quarticCells D E M, (T j)^2) ≤ A*RU := by
        calc
          (∑ j ∈ quarticCells D E M, (T j)^2) =
              256*(∑ j ∈ quarticCells D E M,
                (A7QuarticMoments.length ((M : ℝ)/(128*scaleA D E U V M j)) ((quarticRho D E M j)^4)
                  (2*scaleB D E U V M j) (col (qf j).P 0))^2) := by
            simp_rw [hTscale]
            simp only [mul_pow]
            norm_num
            all_goals rw [Finset.mul_sum]
          _ ≤ 256*(Cm*x^η*RU) := mul_le_mul_of_nonneg_left hraw.2 (by norm_num)
          _ = (256*Cm)*x^η*RU := by ring
          _ ≤ A*RU := by
            dsimp [A]
            exact mul_le_mul_of_nonneg_right
              (mul_le_mul_of_nonneg_right (by linarith : 256*Cm ≤ 1+256*Cm) hηx0) hRU.le
      have hcard : ((quarticCells D E M).card : ℝ) ≤ 4*(M : ℝ) := by
        have ht := A7QuarticMoments.cell_card D E M
        change ((quarticCells D E M).card : ℝ) ≤ 3*(M : ℝ)+1 at ht
        linarith only [ht,hM1]
      have hsum := mixed_raw_sum (quarticCells D E M) (M : ℝ) RD RU A L T
        hM0 hRD hRU hA hcard (fun j _ => (hLpos j).le)
          (fun j _ => (hTpos j).le) hLm hTm
      have hprices (j : ℕ) (hj : j ∈ quarticCells D E M) (G : Poly) (hGS : G ∈ S j) :
          ((HighCell x D E M j h G).ncard : ℝ) ≤
            Ccell*x^η*(1+((L j)^4*T j)^((1 : ℝ)/10)) := by
        rcases hData j hj with ⟨hF,hBi,hFD,hcoeff,hvan,hScard,hgood,hcover⟩
        have hc : ∀ z ∈ quarticCell x D E M j h,
            |(((p j).A.mulVec ![(z.1.1 : ℤ),(z.1.2 : ℤ)]) 0 : ℝ)| ≤ L j ∧
            |(((p j).A.mulVec ![(z.1.1 : ℤ),(z.1.2 : ℤ)]) 1 : ℝ)| ≤
              sideLength ((M : ℝ)/(4*D)) (quarticRho D E M j) (2*E) (p j).P 1 ∧
            |(((qf j).A.mulVec ![(z.2.2 : ℤ),(z.2.1 : ℤ)]) 0 : ℝ)| ≤ T j ∧
            |(((qf j).A.mulVec ![(z.2.2 : ℤ),(z.2.1 : ℤ)]) 1 : ℝ)| ≤
              sideLength ((M : ℝ)/(2048*cofactorA x D E M j)) ((quarticRho D E M j)^4) (32*cofactorB x D E M j) (qf j).P 1 := by
          intro z hz
          have hn := tuple_ellipse_containment x D E M j h hx8 hD hE hM hMx hj hsign z hz
          have hp := (p j).hcover ((z.1.1 : ℤ),(z.1.2 : ℤ)) hn.1
          have hqf := (qf j).hcover ((z.2.2 : ℤ),(z.2.1 : ℤ)) hn.2
          exact ⟨hp.1,hp.2,hqf.1,hqf.2⟩
        have ht := highCell_price c η x D E N M j h hCC hη hxgt hsign
          (F j) G hF (hFD.trans habN) (hgood G hGS).2.1
          (p j) (qf j) hc (hLcap j) (hTcap j)
        exact ht.2
      have hlocal (j : ℕ) (hj : j ∈ quarticCells D E M) :
