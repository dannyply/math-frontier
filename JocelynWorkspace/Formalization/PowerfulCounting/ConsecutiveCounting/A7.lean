  have hde : (d*e).natDegree≤2 := a5deg_mul _ _ 1 1 hd he
  have hde2 : ((d*e)^2).natDegree≤4 := by
    simpa only [pow_two] using a5deg_mul (d*e) (d*e) 2 2 hde hde
  have hde4 : ((d*e)^4).natDegree≤8 := by
    have hh := a5deg_mul ((d*e)^2) ((d*e)^2) 4 4 hde2 hde2
    simpa only [←pow_add] using hh
  exact a5deg_mulc _ _ 8 (a5deg_sub _ _ 8
    (a5deg_cmul (q:ℝ) _ 8 hde4) (hR.trans (by omega)))

