theorem unit_thue_fiber4 (hS : H_Stewart) (u v : ℕ) (hu : 0 < u) (hv : 0 < v)
    (F : Finset (ℕ × ℕ)) (hF : ∀ de ∈ F, de.2 ^ 4 * v = de.1 ^ 4 * u + 1) :
    F.card ≤ 11200 := by
  classical
  rcases F.eq_empty_or_nonempty with hFE | ⟨de0, hde0⟩
  · simp [hFE]
  have heq0 : ((de0.2 : ℤ) ^ 4 * (v : ℤ)) = (de0.1 : ℤ) ^ 4 * (u : ℤ) + 1 := by
    exact_mod_cast hF de0 hde0
  have hcopZ : IsCoprime (v : ℤ) (u : ℤ) :=
    ⟨(de0.2 : ℤ) ^ 4, -((de0.1 : ℤ) ^ 4), by linear_combination heq0⟩
  have hgcd : Int.gcd (v : ℤ) (u : ℤ) = 1 := Int.isCoprime_iff_gcd_eq_one.mp hcopZ
  have hv0 : (v : ℤ) ≠ 0 := by exact_mod_cast hv.ne'
  have hu0 : (u : ℤ) ≠ 0 := by exact_mod_cast hu.ne'
  have hbound := primitive_diagonal_count4 hS (v : ℤ) (u : ℤ) 1 hv0 hu0 hgcd one_ne_zero
  let μ : ℕ × ℕ → ℤ × ℤ := fun de => ((de.2 : ℤ), (de.1 : ℤ))
  have hmaps : Set.MapsTo μ (F : Set (ℕ × ℕ))
      {rs : ℤ × ℤ | Int.gcd rs.1 rs.2 = 1 ∧ (v : ℤ) * rs.1 ^ 4 - (u : ℤ) * rs.2 ^ 4 = 1} := by
    intro de hde
    have hZ : ((de.2 : ℤ) ^ 4 * (v : ℤ)) = (de.1 : ℤ) ^ 4 * (u : ℤ) + 1 := by
      exact_mod_cast hF de (Finset.mem_coe.mp hde)
    have hc : IsCoprime (de.2 : ℤ) (de.1 : ℤ) :=
      ⟨(de.2 : ℤ) ^ 3 * (v : ℤ), -((de.1 : ℤ) ^ 3 * (u : ℤ)), by linear_combination hZ⟩
    refine ⟨Int.isCoprime_iff_gcd_eq_one.mp hc, ?_⟩
    show (v : ℤ) * (de.2 : ℤ) ^ 4 - (u : ℤ) * (de.1 : ℤ) ^ 4 = 1
    linear_combination hZ
  have hinj : Set.InjOn μ (F : Set (ℕ × ℕ)) := by
    intro de _ de' _ h
    have h1 : (de.2 : ℤ) = (de'.2 : ℤ) := congrArg Prod.fst h
    have h2 : (de.1 : ℤ) = (de'.1 : ℤ) := congrArg Prod.snd h
    exact Prod.ext (by exact_mod_cast h2) (by exact_mod_cast h1)
  have hcard : F.card ≤ 2800 * 4 ^ (1 + (1 : ℤ).natAbs.primeFactors.card) := by
    apply ENat.natCast_le_natCast.mp
    rw [← Set.encard_coe_eq_coe_finsetCard]
    exact (Set.encard_le_encard_of_injOn hmaps hinj).trans hbound
  have h11200 : 2800 * 4 ^ (1 + (1 : ℤ).natAbs.primeFactors.card) = 11200 := by
    simp
  omega

def box4 (y D E : ℝ) : Set ((ℕ × ℕ) × (ℕ × ℕ)) :=
  {z | 1 ≤ z.1.1 ∧ 1 ≤ z.1.2 ∧ 1 ≤ z.2.1 ∧ 1 ≤ z.2.2 ∧ z.1.2 ^ 4 * z.2.2 = z.1.1 ^ 4 * z.2.1 + 1 ∧
    y / 2 < (z.1.1 : ℝ) ^ 4 * (z.2.1 : ℝ) ∧ (z.1.1 : ℝ) ^ 4 * (z.2.1 : ℝ) ≤ y ∧
    D / 2 < (z.1.1 : ℝ) ∧ (z.1.1 : ℝ) ≤ D ∧ E / 2 < (z.1.2 : ℝ) ∧ (z.1.2 : ℝ) ≤ E}

lemma box4_bounds {y D E : ℝ} (hD : 0 < D) (hE : 0 < E) {z : (ℕ × ℕ) × (ℕ × ℕ)}
    (hz : z ∈ box4 y D E) :
    1 ≤ z.1.1 ∧ z.1.1 ≤ ⌊D⌋₊ ∧ 1 ≤ z.1.2 ∧ z.1.2 ≤ ⌊E⌋₊ ∧
    1 ≤ z.2.1 ∧ z.2.1 ≤ ⌊16 * y / D ^ 4⌋₊ ∧ 1 ≤ z.2.2 ∧ z.2.2 ≤ ⌊16 * (y + 1) / E ^ 4⌋₊ ∧
    z.1.2 ^ 4 * z.2.2 = z.1.1 ^ 4 * z.2.1 + 1 := by
  obtain ⟨h1, h2, h3, h4, heq, _hlo, hhi, hDlo, hDhi, hElo, hEhi⟩ := hz
  have hD4 : 0 < D ^ 4 := pow_pos hD 4
  have hE4 : 0 < E ^ 4 := pow_pos hE 4
  refine ⟨h1, Nat.le_floor hDhi, h2, Nat.le_floor hEhi, h3, ?_, h4, ?_, heq⟩
  · apply Nat.le_floor
    rw [le_div_iff₀ hD4]
    have hd : D ≤ 2 * (z.1.1 : ℝ) := by linarith
    have hd4 : D ^ 4 ≤ (2 * (z.1.1 : ℝ)) ^ 4 := pow_le_pow_left₀ hD.le hd 4
    have hu0 : (0 : ℝ) ≤ (z.2.1 : ℝ) := Nat.cast_nonneg _
    calc (z.2.1 : ℝ) * D ^ 4 ≤ (z.2.1 : ℝ) * (2 * (z.1.1 : ℝ)) ^ 4 :=
          mul_le_mul_of_nonneg_left hd4 hu0
      _ = 16 * ((z.1.1 : ℝ) ^ 4 * (z.2.1 : ℝ)) := by ring
      _ ≤ 16 * y := by linarith
  · apply Nat.le_floor
    rw [le_div_iff₀ hE4]
    have he : E ≤ 2 * (z.1.2 : ℝ) := by linarith
    have he4 : E ^ 4 ≤ (2 * (z.1.2 : ℝ)) ^ 4 := pow_le_pow_left₀ hE.le he 4
    have hv0 : (0 : ℝ) ≤ (z.2.2 : ℝ) := Nat.cast_nonneg _
    have heqR : (z.1.2 : ℝ) ^ 4 * (z.2.2 : ℝ) = (z.1.1 : ℝ) ^ 4 * (z.2.1 : ℝ) + 1 := by
      exact_mod_cast heq
    calc (z.2.2 : ℝ) * E ^ 4 ≤ (z.2.2 : ℝ) * (2 * (z.1.2 : ℝ)) ^ 4 :=
          mul_le_mul_of_nonneg_left he4 hv0
      _ = 16 * ((z.1.2 : ℝ) ^ 4 * (z.2.2 : ℝ)) := by ring
      _ ≤ 16 * (y + 1) := by rw [heqR]; linarith

theorem box4_count (hS : H_Stewart) (y D E : ℝ) (hy : 0 ≤ y) (hD : 0 < D) (hE : 0 < E) :
    (box4 y D E).Finite ∧
      ((box4 y D E).ncard : ℝ) ≤ 11200 * ((16 * y / D ^ 4) * (16 * (y + 1) / E ^ 4)) := by
  classical
  obtain ⟨Un, hUn⟩ : ∃ n : ℕ, n = ⌊16 * y / D ^ 4⌋₊ := ⟨_, rfl⟩
  obtain ⟨Vn, hVn⟩ : ∃ n : ℕ, n = ⌊16 * (y + 1) / E ^ 4⌋₊ := ⟨_, rfl⟩
  let T : Finset (ℕ × ℕ) := Finset.Icc 1 Un ×ˢ Finset.Icc 1 Vn
  let G : Finset ((ℕ × ℕ) × (ℕ × ℕ)) := (Finset.Icc 1 ⌊D⌋₊ ×ˢ Finset.Icc 1 ⌊E⌋₊) ×ˢ T
  have hsub : box4 y D E ⊆ (G : Set ((ℕ × ℕ) × (ℕ × ℕ))) := by
    intro z hz
    obtain ⟨h1, h1', h2, h2', h3, h3', h4, h4', -⟩ := box4_bounds hD hE hz
    rw [← hUn] at h3'
    rw [← hVn] at h4'
    rw [Finset.mem_coe]
    exact Finset.mem_product.mpr ⟨Finset.mem_product.mpr ⟨Finset.mem_Icc.mpr ⟨h1, h1'⟩,
      Finset.mem_Icc.mpr ⟨h2, h2'⟩⟩, Finset.mem_product.mpr ⟨Finset.mem_Icc.mpr ⟨h3, h3'⟩,
      Finset.mem_Icc.mpr ⟨h4, h4'⟩⟩⟩
  have hfin : (box4 y D E).Finite := G.finite_toSet.subset hsub
  refine ⟨hfin, ?_⟩
  have hncard : (box4 y D E).ncard = hfin.toFinset.card := Set.ncard_eq_toFinset_card _ hfin
  have hmapsT : ∀ z ∈ hfin.toFinset, (fun z : (ℕ × ℕ) × (ℕ × ℕ) => z.2) z ∈ T := by
    intro z hz
    have hz' : z ∈ box4 y D E := hfin.mem_toFinset.mp hz
    obtain ⟨-, -, -, -, h3, h3', h4, h4', -⟩ := box4_bounds hD hE hz'
    rw [← hUn] at h3'
    rw [← hVn] at h4'
    exact Finset.mem_product.mpr ⟨Finset.mem_Icc.mpr ⟨h3, h3'⟩, Finset.mem_Icc.mpr ⟨h4, h4'⟩⟩
  have hfib : ∀ uv ∈ T, (hfin.toFinset.filter
      (fun z : (ℕ × ℕ) × (ℕ × ℕ) => (fun z : (ℕ × ℕ) × (ℕ × ℕ) => z.2) z = uv)).card ≤ 11200 := by
    intro uv huv
    obtain ⟨hu1, hv1⟩ := Finset.mem_product.mp huv
    have hu : 0 < uv.1 := (Finset.mem_Icc.mp hu1).1
    have hv : 0 < uv.2 := (Finset.mem_Icc.mp hv1).1
    have hinj : Set.InjOn (fun z : (ℕ × ℕ) × (ℕ × ℕ) => z.1)
        ((hfin.toFinset.filter (fun z : (ℕ × ℕ) × (ℕ × ℕ) =>
          (fun z : (ℕ × ℕ) × (ℕ × ℕ) => z.2) z = uv) : Finset _) : Set _) := by
      intro z hz z' hz' h
      have e1 : z.2 = uv := (Finset.mem_filter.mp (Finset.mem_coe.mp hz)).2
      have e2 : z'.2 = uv := (Finset.mem_filter.mp (Finset.mem_coe.mp hz')).2
      exact Prod.ext h (e1.trans e2.symm)
    have himg := unit_thue_fiber4 hS uv.1 uv.2 hu hv
      ((hfin.toFinset.filter (fun z : (ℕ × ℕ) × (ℕ × ℕ) =>
        (fun z : (ℕ × ℕ) × (ℕ × ℕ) => z.2) z = uv)).image (fun z => z.1)) (by
      intro de hde
      obtain ⟨z, hz, rfl⟩ := Finset.mem_image.mp hde
      obtain ⟨hzS, hz2⟩ := Finset.mem_filter.mp hz
      have hz' : z ∈ box4 y D E := hfin.mem_toFinset.mp hzS
      obtain ⟨-, -, -, -, -, -, -, -, heq⟩ := box4_bounds hD hE hz'
      have hz2' : z.2 = uv := hz2
      rw [← hz2']
      exact heq)
    rw [Finset.card_image_of_injOn hinj] at himg
    exact himg
  have hcardS : hfin.toFinset.card ≤ 11200 * T.card :=
    Finset.card_le_mul_card_image_of_maps_to hmapsT 11200 hfib
  have hT : T.card = Un * Vn := by
    simp [T, Finset.card_product, Nat.card_Icc]
  have hUle : (Un : ℝ) ≤ 16 * y / D ^ 4 := by
    rw [hUn]; exact Nat.floor_le (div_nonneg (by linarith) (pow_pos hD 4).le)
  have hVle : (Vn : ℝ) ≤ 16 * (y + 1) / E ^ 4 := by
    rw [hVn]; exact Nat.floor_le (div_nonneg (by linarith) (pow_pos hE 4).le)
  have hnat : hfin.toFinset.card ≤ 11200 * (Un * Vn) := by rw [← hT]; exact hcardS
  rw [hncard]
  calc (hfin.toFinset.card : ℝ) ≤ 11200 * ((Un : ℝ) * (Vn : ℝ)) := by exact_mod_cast hnat
    _ ≤ 11200 * ((16 * y / D ^ 4) * (16 * (y + 1) / E ^ 4)) := by
        apply mul_le_mul_of_nonneg_left _ (by norm_num)
        exact mul_le_mul hUle hVle (Nat.cast_nonneg _)
          (div_nonneg (by linarith) (pow_pos hD 4).le)

theorem thue_box4_rpow (hS : H_Stewart) (y s D E δ : ℝ) (hy : 1 ≤ y) (hs : 65 / 152 ≤ s)
    (hδ : 0 < δ) (hD : 0 < D) (hE : 0 < E) (hDE : D * E = y ^ s) :
    (box4 y D E).Finite ∧ ((box4 y D E).ncard : ℝ) ≤ 5734400 * y ^ (11 / 38 + δ) := by
  have hy0 : 0 < y := by linarith
  obtain ⟨hfin, hcard⟩ := box4_count hS y D E hy0.le hD hE
  refine ⟨hfin, hcard.trans ?_⟩
  have hD4 : 0 < D ^ 4 := pow_pos hD 4
  have hE4 : 0 < E ^ 4 := pow_pos hE 4
  have hprod : (16 * y / D ^ 4) * (16 * (y + 1) / E ^ 4) = 256 * (y * (y + 1)) / (D * E) ^ 4 := by
    rw [mul_pow]
    field_simp
    ring
  have hquart : (D * E) ^ 4 = y ^ (s * 4) := by
    rw [hDE, ← Real.rpow_natCast, ← Real.rpow_mul hy0.le]
    norm_num
  have hys : 0 < y ^ (s * 4) := Real.rpow_pos_of_pos hy0 _
  have hsq : y * (y + 1) ≤ 2 * y ^ (2 : ℝ) := by
    rw [Real.rpow_two]
    nlinarith
  have hexp : y ^ (2 : ℝ) / y ^ (s * 4) = y ^ (2 - s * 4) := (Real.rpow_sub hy0 2 (s * 4)).symm
  have hle_exp : y ^ (2 - s * 4) ≤ y ^ (11 / 38 + δ) :=
    Real.rpow_le_rpow_of_exponent_le hy (by linarith)
  have hstep : 256 * (y * (y + 1)) / y ^ (s * 4) ≤ 256 * (2 * y ^ (2 : ℝ)) / y ^ (s * 4) := by
    rw [div_le_div_iff_of_pos_right hys]
    linarith
  calc 11200 * ((16 * y / D ^ 4) * (16 * (y + 1) / E ^ 4))
      = 11200 * (256 * (y * (y + 1)) / y ^ (s * 4)) := by rw [hprod, hquart]
    _ ≤ 11200 * (256 * (2 * y ^ (2 : ℝ)) / y ^ (s * 4)) :=
        mul_le_mul_of_nonneg_left hstep (by norm_num)
    _ = 5734400 * (y ^ (2 : ℝ) / y ^ (s * 4)) := by ring
    _ = 5734400 * y ^ (2 - s * 4) := by rw [hexp]
    _ ≤ 5734400 * y ^ (11 / 38 + δ) := mul_le_mul_of_nonneg_left hle_exp (by norm_num)

