noncomputable section
open Polynomial
set_option maxHeartbeats 7000000
set_option maxRecDepth 6000
theorem full_graph_count (δ : ℝ) (hδ:0 < δ) (hδsmall:δ ≤ 1/51200) (hδspec:A7P4Analytic.DeltaSpec δ) :
∀ K C_ratio c_M ε : ℝ,
  0  <  K → 0  <  C_ratio → 0  <  c_M → 0  <  ε →
  ∃ C : ℝ, 1  ≤  C ∧
    ∀ x D E M s₀ : ℝ, 2  ≤  x → 0  <  D → 0  <  E → 0  <  M →
      c_M*x^((1:ℝ)/7)  ≤  M →
    ∀ (P Q : MvPolynomial (Fin 2) ℤ) (a b c : ℤ),
      P.IsHomogeneous 4 → Q.IsHomogeneous 4 →
      IsRelPrime (MvPolynomial.map (Int.castRingHom ℚ) P)
        (MvPolynomial.map (Int.castRingHom ℚ) Q) →
      Int.gcd a b = 1 → c ≠ 0 →
      (∀ i, |((P.coeff i : ℤ) : ℝ)|  ≤  x^K) →
      (∀ i, |((Q.coeff i : ℤ) : ℝ)|  ≤  x^K) →
      let X₀ : MvPolynomial (Fin 2) ℤ := MvPolynomial.X 0;
      let X₁ : MvPolynomial (Fin 2) ℤ := MvPolynomial.X 1;
      let L := MvPolynomial.C a*X₀+MvPolynomial.C b*X₁;
      X₁^4*Q-X₀^4*P = MvPolynomial.C c*L^8 →
      ∀ T : Finset (Fin 4 → ℤ),
        (∀ p ∈ T,
          (∀ i, 0  <  p i) ∧
          1  ≤  (p 0)^4*(p 2) ∧
          (((p 0)^4*(p 2) : ℤ) : ℝ)  ≤  x ∧
          D/2  <  (p 0 : ℝ) ∧ (p 0 : ℝ)  ≤  D ∧
          E/2  <  (p 1 : ℝ) ∧ (p 1 : ℝ)  ≤  E ∧
          |(p 0 : ℝ)/(p 1 : ℝ)-s₀|  ≤  C_ratio*D/(E*M) ∧
          (p 1)^4*(p 3) = (p 0)^4*(p 2)+1 ∧
          p 2*MvPolynomial.eval ![p 0,p 1] Q =
            p 3*MvPolynomial.eval ![p 0,p 1] P) →
        (T.card : ℝ)  ≤  C*x^ε*
          (1+x^((1:ℝ)/4)/(M^((3:ℝ)/4)*(D*E)^((1:ℝ)/7))) := by
  classical
  intro K C₀ c_M ε hK hC hc hε
  obtain ⟨CL,hCL,hlevel⟩:=A7P4GraphAssembly.fixed_level_count δ hδ hδsmall hδspec C₀ c_M hC hc
  let η:ℝ:=ε/K
  have hη:0 < η := div_pos hε hK
  obtain ⟨CB,hCB,hbudget⟩:=
    FormalAB.S2b84589f.JocelynClaims.claim_e20043e877cc7f6fa915f18cc7590809a6d647a0fe0e66aac9caa124288a4f2a
      η hη
  refine ⟨CL*CB,by nlinarith,?_⟩
  intro x D E M s₀ hx hD hE hM hfloor P Q a b c hP hQ hcop hprim hc0 hPH hQH X₀ X₁ L hpure T hT
  obtain ⟨K₀,hK₀,hheight,hpoints⟩ :=
    JocelynClaims.claim_01d9aea1b538f4590283516b20933d0c843e439ffea75c0274b8615a992030f6
      P Q a b c (x^K) hP hQ hcop hc0 (fun i=>⟨hPH i,hQH i⟩) hpure
  have hx0:0 < x := by linarith
  have hH:1 ≤ x^K := Real.one_le_rpow (by linarith) hK.le
  have hH8:x^K ≤ 20*(x^K)^8 := by
    have hh:=mul_le_mul_of_nonneg_left (one_le_pow₀ hH:1 ≤ (x^K)^7)
      (by positivity:0 ≤ x^K)
