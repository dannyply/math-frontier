  constructor <;> linarith

private theorem a7_axis_crt_width_scalar
    (x D E M cM C ell hW : ℝ)
    (hx : 2 ≤ x)
    (hcM : 0 < cM) (hC : 0 ≤ C)
    (hDpos : 0 < D) (hEpos : 0 < E)
    (hell : 0 < ell) (hhW : 1 ≤ hW)
    (hDcap : D ≤ 2 * x ^ (1 / 4 : ℝ))
    (hEcap : E ≤ 4 * x ^ (1 / 4 : ℝ))
    (haxis : E / 2 ≤ ell ∨ D / 2 ≤ ell)
    (hM : cM * x ^ (1 / 4 : ℝ) ≤ M) :
    (2 * C * D * E) / (M * ell * hW) ≤ 16 * C / cM := by
  have hxpos : 0 < x := by linarith
  have hroot : 0 < x ^ (1 / 4 : ℝ) := by positivity
  have hMpos : 0 < M := lt_of_lt_of_le (mul_pos hcM hroot) hM
  have hhWpos : 0 < hW := by linarith
  have hZ : D * E ≤ 8 * x ^ (1 / 4 : ℝ) * ell := by
    rcases haxis with heaxis | hdaxis
    · have hE2 : E ≤ 2 * ell := by linarith
      have h1 := mul_le_mul_of_nonneg_left hE2 (le_of_lt hDpos)
      have h2 := mul_le_mul_of_nonneg_right hDcap (by linarith : 0 ≤ 2 * ell)
      nlinarith
    · have hD2 : D ≤ 2 * ell := by linarith
      have h1 := mul_le_mul_of_nonneg_right hD2 (le_of_lt hEpos)
      have h2 := mul_le_mul_of_nonneg_left hEcap (by linarith : 0 ≤ 2 * ell)
      nlinarith
  have hden : 0 < M * ell * hW := by positivity
  apply (div_le_div_iff₀ hden hcM).2
  have hMhw : M ≤ M * hW := by
    nlinarith [mul_nonneg (le_of_lt hMpos) (sub_nonneg.mpr hhW)]
  calc
    (2 * C * D * E) * cM =
        (2 * C * cM) * (D * E) := by ring
    _ ≤ (2 * C * cM) *
          (8 * x ^ (1 / 4 : ℝ) * ell) :=
      mul_le_mul_of_nonneg_left hZ (by positivity)
    _ = (16 * C * ell) *
          (cM * x ^ (1 / 4 : ℝ)) := by ring
    _ ≤ (16 * C * ell) * M :=
      mul_le_mul_of_nonneg_left hM (by positivity)
    _ ≤ (16 * C * ell) * (M * hW) :=
      mul_le_mul_of_nonneg_left hMhw (by positivity)
    _ = (16 * C) * (M * ell * hW) := by ring

private theorem a7_exact_thin_width_scalar
    (x Z M cM C ell K h : ℝ)
    (hx : 2 ≤ x) (hZ : 0 ≤ Z)
    (hZcap : Z ≤ x ^ (17 / 50 : ℝ))
    (hcM : 0 < cM) (hM : cM * x ^ (1 / 4 : ℝ) ≤ M)
    (hC : 0 ≤ C) (hell : 0 < ell) (hK : 1 ≤ K)
    (hh : 1 ≤ h)
    (hthin : Real.sqrt (K * Z) < 500 * ell) :
    2 * C * Z / (M * ell * h) ≤ 1000 * C / cM := by
  have hx0 : 0 ≤ x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hXq : 0 < x ^ (1 / 4 : ℝ) :=
    Real.rpow_pos_of_pos (by linarith : 0 < x) _
  have hMpos : 0 < M := lt_of_lt_of_le (mul_pos hcM hXq) hM
  have hden : 0 < M * ell * h := by positivity
  have hKZ : Z ≤ K * Z := by
    nlinarith [mul_nonneg (sub_nonneg.mpr hK) hZ]
  have hroot : Real.sqrt Z < 500 * ell :=
    lt_of_le_of_lt (Real.sqrt_le_sqrt hKZ) hthin
  have hrootcap : Real.sqrt Z ≤ x ^ (1 / 4 : ℝ) := by
    calc
      _ ≤ Real.sqrt (x ^ (17 / 50 : ℝ)) :=
        Real.sqrt_le_sqrt hZcap
      _ = x ^ (17 / 100 : ℝ) := by
        rw [Real.sqrt_eq_rpow, ← Real.rpow_mul hx0]
        norm_num
      _ ≤ x ^ (1 / 4 : ℝ) :=
        Real.rpow_le_rpow_of_exponent_le hx1 (by norm_num)
  have hZlin : Z ≤ 500 * ell * x ^ (1 / 4 : ℝ) := by
    calc
      Z = Real.sqrt Z * Real.sqrt Z := by
        nlinarith [Real.sq_sqrt hZ]
      _ ≤ (500 * ell) * Real.sqrt Z :=
        mul_le_mul_of_nonneg_right (le_of_lt hroot)
          (Real.sqrt_nonneg Z)
      _ ≤ (500 * ell) * x ^ (1 / 4 : ℝ) :=
        mul_le_mul_of_nonneg_left hrootcap (by positivity)
  apply (div_le_div_iff₀ hden hcM).2
  calc
    (2 * C * Z) * cM = (2 * C * cM) * Z := by ring
    _ ≤ (2 * C * cM) * (500 * ell * x ^ (1 / 4 : ℝ)) :=
      mul_le_mul_of_nonneg_left hZlin (by positivity)
    _ = (1000 * C * ell) * (cM * x ^ (1 / 4 : ℝ)) := by ring
    _ ≤ (1000 * C * ell) * M :=
      mul_le_mul_of_nonneg_left hM (by positivity)
    _ ≤ (1000 * C * ell) * (M * h) := by
      have hMh : M ≤ M * h := by
        nlinarith [mul_nonneg (le_of_lt hMpos) (sub_nonneg.mpr hh)]
      exact mul_le_mul_of_nonneg_left hMh (by positivity)
    _ = (1000 * C) * (M * ell * h) := by ring

