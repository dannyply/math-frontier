private theorem actual_common_first_sum :
    ∃ C : ℝ, 0<C ∧
      ∀ D E : ℝ, 0<D → 0<E → ∀ M : ℕ, 1≤M →
        ∀ ed : (j : ℕ) →
          FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.EllipseData
            ((M:ℝ)/(8*D)) (rho D E M j) (4*E),
        ∑ j∈cells D E M,
          FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.sideLength
            ((M:ℝ)/(8*D)) (rho D E M j) (4*E) (ed j).P 0≤
          C*(Real.sqrt (D*E*(M:ℝ))*Real.sqrt (1+Real.log (M:ℝ))+D+E) := by
  classical
  obtain ⟨C,hC,hmoment⟩ := actual_common_first_moment
  refine ⟨4*Real.sqrt C,by positivity,?_⟩
  intro D E hD hE M hM ed
  let I : Finset ℕ := cells D E M
  let f : ℕ → ℝ := fun j =>
    FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.sideLength
      ((M:ℝ)/(8*D)) (rho D E M j) (4*E) (ed j).P 0
  let S : ℝ := ∑ j∈I, f j
  let Q : ℝ := ∑ j∈I, (f j)^2
  have hS : 0≤S :=
    Finset.sum_nonneg (fun j _ => ((ed j).hpos.trans_le (ed j).horder).le)
  have hQ : 0≤Q := Finset.sum_nonneg (fun j _ => sq_nonneg (f j))
  have hMr : (1:ℝ)≤M := by exact_mod_cast hM
  have hM0 : (0:ℝ)<M := by linarith
  have hlog : 0≤Real.log (M:ℝ) := Real.log_nonneg hMr
  have hcard : (I.card:ℝ)≤4*(M:ℝ) := by
    exact FormalAB.S75c3b853.ConsecutiveCountingA5SecondMoments.cells_card_bound D E M hM
  have hsq : S^2≤16*C*(D*E*(M:ℝ)*(1+Real.log (M:ℝ))+D^2+E^2) := by
    calc
      S^2≤(I.card:ℝ)*Q := finite_sum_square_le I f
      _ ≤ (4*(M:ℝ))*Q := mul_le_mul_of_nonneg_right hcard hQ
      _ ≤ (4*(M:ℝ))*
          (C*(D*E*(1+Real.log (M:ℝ))+(D^2+E^2)/(M:ℝ))) :=
        mul_le_mul_of_nonneg_left (hmoment D E hD hE M hM ed) (by positivity)
      _ = 4*C*(D*E*(M:ℝ)*(1+Real.log (M:ℝ))+D^2+E^2) := by
        field_simp [hM0.ne']; ring
      _ ≤ 16*C*(D*E*(M:ℝ)*(1+Real.log (M:ℝ))+D^2+E^2) := by
        apply mul_le_mul_of_nonneg_right
        · nlinarith
        · positivity
  let A : ℝ := Real.sqrt (D*E*(M:ℝ))*Real.sqrt (1+Real.log (M:ℝ))
  have hA : 0≤A := by dsimp only [A]; positivity
  have hA2 : A^2=D*E*(M:ℝ)*(1+Real.log (M:ℝ)) := by
    dsimp only [A]
    rw [mul_pow,Real.sq_sqrt (by positivity),Real.sq_sqrt (by positivity)]
  have hcsq : (Real.sqrt C)^2=C := Real.sq_sqrt hC.le
  have hsum : D*E*(M:ℝ)*(1+Real.log (M:ℝ))+D^2+E^2≤(A+D+E)^2 := by
    rw [← hA2]
    nlinarith
  have htarget : S^2≤(4*Real.sqrt C*(A+D+E))^2 := by
    have hh := mul_le_mul_of_nonneg_left hsum (by positivity : 0≤16*C)
    have heq : (4*Real.sqrt C*(A+D+E))^2=16*C*(A+D+E)^2 := by
      calc
        _ = 16*(Real.sqrt C)^2*(A+D+E)^2 := by ring
        _ = _ := by rw [hcsq]
    rw [heq]
    exact hsq.trans hh
  have htarget0 : 0≤4*Real.sqrt C*(A+D+E) := by positivity
  change S≤4*Real.sqrt C*(A+D+E)
  nlinarith

private theorem actual_log_sqrt_subpower (γ : ℝ) (hγ : 0<γ) :
    ∃ C : ℝ, 0<C ∧
      ∀ x : ℝ, 2≤x → ∀ M : ℕ, 1≤M → (M:ℝ)≤2*x →
        Real.sqrt (1+Real.log (M:ℝ))≤C*x^γ := by
  let K : ℝ := 1+Real.log 2+1/(2*γ)
  have hlog2 : 0≤Real.log 2 := Real.log_nonneg (by norm_num)
  have hK : 0<K := by dsimp only [K]; positivity
  refine ⟨Real.sqrt K,Real.sqrt_pos.mpr hK,?_⟩
  intro x hx M hM hMup
  have hx0 : 0<x := by linarith
  have hx1 : 1≤x := by linarith
  have hMr : (1:ℝ)≤M := by exact_mod_cast hM
  have hM0 : (0:ℝ)<M := by linarith
  have hlogM : 0≤Real.log (M:ℝ) := Real.log_nonneg hMr
  have hlogcap : Real.log (M:ℝ)≤Real.log 2+Real.log x := by
    calc
      Real.log (M:ℝ)≤Real.log (2*x) := Real.log_le_log hM0 hMup
      _ = Real.log 2+Real.log x := Real.log_mul (by norm_num) hx0.ne'
  let Y : ℝ := x^(2*γ)
  have hY : 1≤Y := Real.one_le_rpow hx1 (by positivity)
  have hlogx : Real.log x≤(Y-1)/(2*γ) := by
    have hh := Real.log_le_sub_one_of_pos (Real.rpow_pos_of_pos hx0 (2*γ))
    rw [Real.log_rpow hx0] at hh
    apply (le_div_iff₀ (by positivity : 0<2*γ)).mpr
    dsimp only [Y]
    nlinarith
  have hbase : 1+Real.log 2≤(1+Real.log 2)*Y := by nlinarith
  have htail : (Y-1)/(2*γ)≤Y/(2*γ) :=
    div_le_div_of_nonneg_right (by linarith) (by positivity)
  have hcap : 1+Real.log (M:ℝ)≤K*Y := by
    calc
      1+Real.log (M:ℝ)≤(1+Real.log 2)+(Y-1)/(2*γ) := by linarith
      _ ≤ (1+Real.log 2)*Y+Y/(2*γ) := add_le_add hbase htail
      _ = K*Y := by dsimp only [K]; field_simp
  have hpow : (x^γ)^2=Y := by
    dsimp only [Y]
    rw [← Real.rpow_natCast (x^γ) 2,← Real.rpow_mul hx0.le]
    congr 1
    ring
  have hsq :
      (Real.sqrt (1+Real.log (M:ℝ)))^2≤(Real.sqrt K*x^γ)^2 := by
    rw [Real.sq_sqrt (by linarith),mul_pow,Real.sq_sqrt hK.le,hpow]
    exact hcap
  have hl0 : 0≤Real.sqrt (1+Real.log (M:ℝ)) := Real.sqrt_nonneg _
  have hr0 : 0≤Real.sqrt K*x^γ := by positivity
  nlinarith

private theorem actual_common_first_sum_subpower (ε : ℝ) (hε : 0<ε) :
    ∃ C : ℝ, 0<C ∧
      ∀ (x D E : ℝ), 2≤x → 0<D → 0<E →
        ∀ M : ℕ, 1≤M → (M:ℝ)≤2*x →
          ∀ ed : (j : ℕ) →
            FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.EllipseData
              ((M:ℝ)/(8*D)) (rho D E M j) (4*E),
          ∑ j∈cells D E M,
            FormalAB.S93d0e676.A5OriginalTwoLatticeGeometry.sideLength
              ((M:ℝ)/(8*D)) (rho D E M j) (4*E) (ed j).P 0≤
            C*x^ε*(Real.sqrt (D*E*(M:ℝ))+D+E) := by
  obtain ⟨Cm,hCm,hmoment⟩ := actual_common_first_sum
  obtain ⟨Cl,hCl,hlog⟩ := actual_log_sqrt_subpower ε hε
  let R : ℝ := max 1 Cl
  have hR1 : 1≤R := le_max_left _ _
  have hR : 0<R := by linarith
  refine ⟨Cm*R,mul_pos hCm hR,?_⟩
  intro x D E hx hD hE M hM hMup ed
  have hx0 : 0<x := by linarith
  have hxpow : 1≤x^ε := Real.one_le_rpow (by linarith) hε.le
  have hprod : 1≤R*x^ε := by
    nlinarith [mul_nonneg (by linarith : 0≤R-1) (by linarith : 0≤x^ε-1)]
  let A : ℝ := Real.sqrt (D*E*(M:ℝ))
  have hA : 0≤A := Real.sqrt_nonneg _
  have hlogcap : Real.sqrt (1+Real.log (M:ℝ))≤R*x^ε :=
    (hlog x hx M hM hMup).trans
      (mul_le_mul_of_nonneg_right (le_max_right _ _) (Real.rpow_nonneg hx0.le ε))
  have hscaled :
      A*Real.sqrt (1+Real.log (M:ℝ))+D+E≤
        R*x^ε*(A+D+E) := by
    have hmain := mul_le_mul_of_nonneg_left hlogcap hA
    have hD' : D≤R*x^ε*D := by nlinarith
    have hE' : E≤R*x^ε*E := by nlinarith
    nlinarith
  calc
    _ ≤ Cm*(A*Real.sqrt (1+Real.log (M:ℝ))+D+E) := hmoment D E hD hE M hM ed
    _ ≤ Cm*(R*x^ε*(A+D+E)) := mul_le_mul_of_nonneg_left hscaled hCm.le
    _ = (Cm*R)*x^ε*(A+D+E) := by ring

end OSKPrivate

namespace OSKPrivate
open scoped BigOperators

def betaOnePhiK (k : ℕ) (A B : MvPolynomial (Fin 2) ℤ) :
    MvPolynomial (Fin 2) ℤ :=
  MvPolynomial.X 1^k*B-MvPolynomial.X 0^k*A

theorem betaOnePhiK_homogeneous (k a : ℕ)
    (A B : MvPolynomial (Fin 2) ℤ)
    (hA : A.IsHomogeneous a) (hB : B.IsHomogeneous a) :
    (betaOnePhiK k A B).IsHomogeneous (a+k) := by
  have h2 (i : Fin 2) :
      ((MvPolynomial.X i : MvPolynomial (Fin 2) ℤ)^k).IsHomogeneous k := by
    simpa using (MvPolynomial.isHomogeneous_X ℤ i).pow k
  simpa only [betaOnePhiK, Nat.add_comm k a] using
    ((h2 1).mul hB).sub ((h2 0).mul hA)

theorem betaOnePhiK_eval (k : ℕ) (A B : MvPolynomial (Fin 2) ℤ) (d e : ℤ) :
    MvPolynomial.eval ![d,e] (betaOnePhiK k A B)=
      e^k*MvPolynomial.eval ![d,e] B-d^k*MvPolynomial.eval ![d,e] A := by
  simp only [betaOnePhiK, map_sub, map_mul, map_pow, MvPolynomial.eval_X,
    Matrix.cons_val_zero, Matrix.cons_val_one]

theorem beta_one_resultant_k (k : ℕ) (hk : 1 ≤ k)
    (a : ℕ) (ha : 1≤a) (H : ℝ) (hH : 1≤H)
    (G : MvPolynomial (Fin 4) ℤ)
    (hG : ∀ m∈G.support, m 0+m 1=a ∧ m 2+m 3=1)
    (hirr : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G))
    (hcoef : ∀ m : Fin 4 →₀ ℕ, |((G.coeff m : ℤ) : ℝ)|≤H) :
    ∃ A B : MvPolynomial (Fin 2) ℤ, ∃ R : ℤ,
      A.IsHomogeneous a ∧ B.IsHomogeneous a ∧
      (∀ m : Fin 2 →₀ ℕ,
        |((A.coeff m : ℤ) : ℝ)|≤H ∧ |((B.coeff m : ℤ) : ℝ)|≤H) ∧
      R≠0 ∧ |(R : ℝ)|≤((2*a).factorial : ℝ)^2*H^(4*a) ∧
      ∀ d e u v h : ℤ, (h=1 ∨ h=-1) →
        e^k*v-d^k*u=h →
        MvPolynomial.eval ![d,e,u,v] G=0 →
        let κ := MvPolynomial.eval ![d,e] (betaOnePhiK k A B)
        κ≠0 ∧ κ∣R ∧ κ*u=h*MvPolynomial.eval ![d,e] A ∧
          κ*v=h*MvPolynomial.eval ![d,e] B := by
  obtain ⟨A₀,B₀,A,B,hA₀,hB₀,hA,hB,hrel₀,hrel,hheight,hrep⟩ :=
    FormalAB.Sdd81c7c9.A1QuadraticComponents.graph_linear_data
      a ha H hH G hG hirr hcoef
  obtain ⟨R,hR,hRbound,hRdiv⟩ :=
    JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C01.PcRes.p_res2
      a ha A B hA hB hrel H hH
      (fun m => ⟨(hheight m).2.2.1,(hheight m).2.2.2⟩)
  refine ⟨A,B,R,hA,hB,(fun m => ⟨(hheight m).2.2.1,
    (hheight m).2.2.2⟩),hR,hRbound,?_⟩
  intro d e u v h hs hshift hzero
  dsimp only
  obtain ⟨hde,huv⟩ := unit_shift_primitive_k k hk d e u v h hs hshift
  have hz :
      ((d,e),(u,v)) ∈
        FormalAB.Sdd81c7c9.A1QuadraticComponents.signedGraphCarrier G :=
    ⟨hde,huv,hzero⟩
  have hlin : u*MvPolynomial.eval ![d,e] B=
      v*MvPolynomial.eval ![d,e] A := by
    simpa only [FormalAB.Sdd81c7c9.A1QuadraticComponents.signedGraphParameter,
      ite_true] using (hrep ((d,e),(u,v)) hz).2.2
  let κ := MvPolynomial.eval ![d,e] (betaOnePhiK k A B)
  have hu : κ*u=h*MvPolynomial.eval ![d,e] A := by
    dsimp only [κ]
    rw [betaOnePhiK_eval]
    linear_combination (MvPolynomial.eval ![d,e] A)*hshift+e^k*hlin
  have hv : κ*v=h*MvPolynomial.eval ![d,e] B := by
    dsimp only [κ]
    rw [betaOnePhiK_eval]
    linear_combination (MvPolynomial.eval ![d,e] B)*hshift+d^k*hlin
  have hdA : κ ∣ MvPolynomial.eval ![d,e] A := by
    rcases hs with hs | hs
    · refine ⟨u,?_⟩
      simpa only [hs, one_mul] using hu.symm
    · refine ⟨-u,?_⟩
      rw [hs] at hu
      linear_combination hu
  have hdB : κ ∣ MvPolynomial.eval ![d,e] B := by
    rcases hs with hs | hs
    · refine ⟨v,?_⟩
      simpa only [hs, one_mul] using hv.symm
    · refine ⟨-v,?_⟩
      rw [hs] at hv
      linear_combination hv
  have hdg : κ ∣ (Int.gcd (MvPolynomial.eval ![d,e] A)
      (MvPolynomial.eval ![d,e] B) : ℤ) := by
    first
    | exact Int.dvd_gcd hdA hdB
    | exact Int.dvd_coe_gcd hdA hdB
  have hdR : κ∣R := hdg.trans (hRdiv d e hde)
  have hk0 : κ≠0 := by
    intro hk0
    rw [hk0,zero_dvd_iff] at hdR
    exact hR hdR
  exact ⟨hk0,hdR,hu,hv⟩

theorem cofactor_same_bucket_le_k (k : ℕ)
    (d e u₁ v₁ u₂ v₂ : ℕ) (he : 1≤e) (hc : d.Coprime e)
    (hEq : e^k*v₂+d^k*u₁=e^k*v₁+d^k*u₂)
    (hq : u₁/(e^k)=u₂/(e^k)) (hule : u₁≤u₂) :
    u₁=u₂ := by
  by_contra hne
  have hult : u₁<u₂ := by omega
  have hdprod : d^k*u₁≤d^k*u₂ := Nat.mul_le_mul_left _ hule
  have hvprod : e^k*v₁≤e^k*v₂ := by omega
  have hepos : 0<e^k := pow_pos (by omega : 0<e) k
  have hvle : v₁≤v₂ := by
    by_contra hn
    have hvl : v₂<v₁ := by omega
    have hmul := Nat.mul_lt_mul_of_pos_left hvl hepos
    omega
  have hdiff : d^k*(u₂-u₁)=e^k*(v₂-v₁) := by
    rw [Nat.mul_sub_left_distrib,Nat.mul_sub_left_distrib]
    omega
  have hdvd₀ : e^k∣d^k*(u₂-u₁) := ⟨v₂-v₁,hdiff⟩
  have hdvd : e^k∣u₂-u₁ := (hc.symm.pow k k).dvd_of_dvd_mul_left hdvd₀
  have hgap : e^k≤u₂-u₁ := Nat.le_of_dvd (by omega) hdvd
  have hmod₂ := Nat.mod_lt u₂ hepos
  have hqmul : e^k*(u₂/(e^k))≤u₁ := by
    rw [← hq]
    simpa only [Nat.mul_comm] using Nat.div_mul_le_self u₁ (e^k)
  have hlt : u₂<e^k+u₁ := by
    calc
      u₂=u₂%(e^k)+e^k*(u₂/(e^k)) := (Nat.mod_add_div u₂ (e^k)).symm
      _ < e^k+e^k*(u₂/(e^k)) := Nat.add_lt_add_right hmod₂ _
      _ ≤ e^k+u₁ := Nat.add_le_add_left hqmul _
  omega

theorem cofactor_same_bucket_k (k : ℕ)
    (d e u₁ v₁ u₂ v₂ : ℕ) (h : ℤ)
    (he : 1≤e) (hc : d.Coprime e)
    (hs₁ : (e:ℤ)^k*(v₁:ℤ)-(d:ℤ)^k*(u₁:ℤ)=h)
    (hs₂ : (e:ℤ)^k*(v₂:ℤ)-(d:ℤ)^k*(u₂:ℤ)=h)
    (hq : u₁/(e^k)=u₂/(e^k)) :
    u₁=u₂ ∧ v₁=v₂ := by
  have hEqZ : (e:ℤ)^k*(v₂:ℤ)+(d:ℤ)^k*(u₁:ℤ)=
      (e:ℤ)^k*(v₁:ℤ)+(d:ℤ)^k*(u₂:ℤ) := by
    linear_combination hs₂-hs₁
  have hEq : e^k*v₂+d^k*u₁=e^k*v₁+d^k*u₂ := by exact_mod_cast hEqZ
  have hu : u₁=u₂ := by
    rcases le_total u₁ u₂ with hle | hle
    · exact cofactor_same_bucket_le_k k d e u₁ v₁ u₂ v₂ he hc hEq hq hle
    · exact (cofactor_same_bucket_le_k k d e u₂ v₂ u₁ v₁ he hc
        hEq.symm hq.symm hle).symm
  have hv : v₁=v₂ := by
    apply Nat.mul_left_cancel (pow_pos (by omega : 0<e) k)
    rw [hu] at hEq
    exact Nat.add_right_cancel hEq.symm
  exact ⟨hu,hv⟩

theorem original_fixed_pair_count_k (k : ℕ)
    (x : ℝ) (d e : ℕ) (h : ℤ)
    (hd : 1≤d) (he : 1≤e) (hc : d.Coprime e)
    (hprod : x≤(4:ℝ)^k*(((d*e : ℕ):ℝ)^k)) :
    let S : Set (ℕ×ℕ) :=
      {uv | 1≤uv.1 ∧ 1≤uv.2 ∧
        (e:ℤ)^k*(uv.2:ℤ)-(d:ℤ)^k*(uv.1:ℤ)=h ∧
        (((d^k*uv.1 : ℕ):ℝ))≤x}
    S.Finite ∧ S.ncard≤4^k+1 := by
  classical
  dsimp only
  let S : Set (ℕ×ℕ) :=
    {uv | 1≤uv.1 ∧ 1≤uv.2 ∧
      (e:ℤ)^k*(uv.2:ℤ)-(d:ℤ)^k*(uv.1:ℤ)=h ∧
      (((d^k*uv.1 : ℕ):ℝ))≤x}
  let f : (ℕ×ℕ) → ℕ := fun uv => uv.1/(e^k)
  have hde0 : (0:ℝ) < (((d*e : ℕ):ℝ)^k) := by
    have hpos : 0 < d*e := Nat.mul_pos (by omega) (by omega)
    have hposR : (0:ℝ) < ((d*e : ℕ):ℝ) := by exact_mod_cast hpos
    positivity
  have hmap : Set.MapsTo f S (↑(Finset.range (4^k+1)) : Set ℕ) := by
    intro uv huv
    have hqmul : (uv.1/(e^k))*(e^k)≤uv.1 :=
      Nat.div_mul_le_self uv.1 (e^k)
    have hmul : d^k*((uv.1/(e^k))*(e^k))≤d^k*uv.1 :=
      Nat.mul_le_mul_left (d^k) hqmul
    have hmulR : (((d*e : ℕ):ℝ)^k)*(f uv : ℝ)≤x := by
      calc
        (((d*e : ℕ):ℝ)^k)*(f uv : ℝ)=
            ((d^k*((uv.1/(e^k))*(e^k)) : ℕ):ℝ) := by
          simp only [f,Nat.cast_mul,Nat.cast_pow]
          ring
        _ ≤ ((d^k*uv.1 : ℕ):ℝ) := by exact_mod_cast hmul
        _ ≤ x := huv.2.2.2
    have hqR : (f uv : ℝ)≤(4:ℝ)^k := by
      have h1 : (((d*e : ℕ):ℝ)^k)*(f uv : ℝ)≤(((d*e : ℕ):ℝ)^k)*(4:ℝ)^k := by
        calc _ ≤ x := hmulR
          _ ≤ (4:ℝ)^k*(((d*e : ℕ):ℝ)^k) := hprod
          _ = _ := by ring
      exact le_of_mul_le_mul_left h1 hde0
    have hq : f uv≤4^k := by exact_mod_cast hqR
    change f uv∈Finset.range (4^k+1)
    exact Finset.mem_range.mpr (by omega)
  have hinj : Set.InjOn f S := by
    intro uv huv uv' huv' hf
    obtain ⟨hu,hv⟩ := cofactor_same_bucket_k k d e uv.1 uv.2 uv'.1 uv'.2
      h he hc huv.2.2.1 huv'.2.2.1 hf
    exact Prod.ext hu hv
  have hT : (↑(Finset.range (4^k+1)) : Set ℕ).Finite := Finset.finite_toSet _
  have hfin : S.Finite := Set.Finite.of_injOn hmap hinj hT
  refine ⟨hfin,?_⟩
  have hh := Set.ncard_le_ncard_of_injOn f hmap hinj hT
  simpa only [Set.ncard_coe_finset,Finset.card_range] using hh

theorem first_linear_axis_count_k (k : ℕ) (hk : 1 ≤ k)
    (x D E : ℝ) (M j : ℕ) (h p r : ℤ)
    (hD : 0<D) (hE : 0<E)
    (hs : h=1 ∨ h=-1) (hpr : (p,r)≠(0,0))
    (hprod : x≤(D*E)^k) :
    let S : Set Point :=
      {z | z∈cellK k x D E M j h ∧
        p*(z.1.1:ℤ)+r*(z.1.2:ℤ)=0}
    S.Finite ∧ S.ncard≤4^k+1 := by
  classical
  dsimp only
  let S : Set Point :=
    {z | z∈cellK k x D E M j h ∧
      p*(z.1.1:ℤ)+r*(z.1.2:ℤ)=0}
  by_cases hne : S.Nonempty
  · obtain ⟨z₀,hz₀⟩ := hne
    have hp₀ := hz₀.1.1
    have hsub₀ := box_shift_int hp₀
    rcases hp₀ with ⟨hd₀,he₀,hu₀,hv₀,hshift₀,hm₀,hm₁,hdD₀,hdD₁,heE₀,heE₁⟩
    have hprim₀ := unit_shift_primitive_k k hk
      (z₀.1.1:ℤ) (z₀.1.2:ℤ) (z₀.2.1:ℤ) (z₀.2.2:ℤ) h hs hsub₀
    have hfix : ∀ z∈S, z.1=z₀.1 := by
      intro z hz
      have hsub := box_shift_int hz.1.1
      rcases hz.1.1 with ⟨hd,he,hu,hv,hshift,hm0,hm1,hdD0,hdD1,heE0,heE1⟩
      have hprim := unit_shift_primitive_k k hk
        (z.1.1:ℤ) (z.1.2:ℤ) (z.2.1:ℤ) (z.2.2:ℤ) h hs hsub
      obtain ⟨hdq,heq⟩ := positive_linear_pair_unique p r hpr
        z.1.1 z.1.2 z₀.1.1 z₀.1.2 hd he hd₀ he₀ hprim.1 hprim₀.1
        hz.2 hz₀.2
      exact Prod.ext hdq heq
    have hcop : Nat.Coprime z₀.1.1 z₀.1.2 := by
      have hg : Int.gcd ((z₀.1.1 : ℕ) : ℤ) ((z₀.1.2 : ℕ) : ℤ) = 1 := hprim₀.1
      rw [Int.gcd_natCast_natCast] at hg
      exact hg
    have hprod₀ : x≤(4:ℝ)^k*(((z₀.1.1*z₀.1.2:ℕ):ℝ)^k) := by
      have hd2 : D≤2*(z₀.1.1:ℝ) := by linarith
      have he2 : E≤2*(z₀.1.2:ℝ) := by linarith
      have hDE : D*E≤(2*(z₀.1.1:ℝ))*(2*(z₀.1.2:ℝ)) :=
        mul_le_mul hd2 he2 hE.le (by positivity)
      have hsq : (D*E)^k≤((2*(z₀.1.1:ℝ))*(2*(z₀.1.2:ℝ)))^k :=
        pow_le_pow_left₀ (mul_pos hD hE).le hDE k
      calc x ≤ (D*E)^k := hprod
        _ ≤ ((2*(z₀.1.1:ℝ))*(2*(z₀.1.2:ℝ)))^k := hsq
        _ = (4:ℝ)^k*(((z₀.1.1*z₀.1.2:ℕ):ℝ)^k) := by
          push_cast
          rw [← mul_pow]
          ring
    let T : Set (ℕ×ℕ) :=
      {uv | 1≤uv.1 ∧ 1≤uv.2 ∧
        (z₀.1.2:ℤ)^k*(uv.2:ℤ)-(z₀.1.1:ℤ)^k*(uv.1:ℤ)=h ∧
        (((z₀.1.1^k*uv.1:ℕ):ℝ))≤x}
    have hT : T.Finite ∧ T.ncard≤4^k+1 :=
      original_fixed_pair_count_k k x z₀.1.1 z₀.1.2 h hd₀ he₀ hcop hprod₀
    have hmap : Set.MapsTo (fun z : Point => z.2) S T := by
      intro z hz
      have hq := hfix z hz
      have hq₀ : z.1.1=z₀.1.1 := congrArg Prod.fst hq
      have hq₁ : z.1.2=z₀.1.2 := congrArg Prod.snd hq
      have hsub := box_shift_int hz.1.1
      rcases hz.1.1 with ⟨hd,he,hu,hv,hshift,hm0,hm1,hdD0,hdD1,heE0,heE1⟩
      refine ⟨hu,hv,?_,?_⟩
      · rw [← hq₀, ← hq₁]
        exact hsub
      · rw [← hq₀]
        exact hm1
    have hinj : Set.InjOn (fun z : Point => z.2) S := by
      intro z hz z' hz' hzz
      exact Prod.ext ((hfix z hz).trans (hfix z' hz').symm) hzz
    have hfin : S.Finite := Set.Finite.of_injOn hmap hinj hT.1
    refine ⟨hfin,?_⟩
    exact (Set.ncard_le_ncard_of_injOn (fun z : Point => z.2) hmap hinj hT.1).trans hT.2
  · have hS : S=∅ := Set.not_nonempty_iff_eq_empty.mp hne
    change S.Finite ∧ S.ncard≤4^k+1
    rw [hS]
    exact ⟨Set.finite_empty,by simp⟩

def axisPhiK (k : ℕ) (u0 v0 : ℤ) : MvPolynomial (Fin 2) ℤ :=
  MvPolynomial.C v0*MvPolynomial.X 1^k-MvPolynomial.C u0*MvPolynomial.X 0^k

theorem axisPhiK_homogeneous (k : ℕ) (u0 v0 : ℤ) :
    (axisPhiK k u0 v0).IsHomogeneous k := by
  have hx1 : ((MvPolynomial.X 1 : MvPolynomial (Fin 2) ℤ)^k).IsHomogeneous k := by
    simpa using (MvPolynomial.isHomogeneous_X ℤ (1:Fin 2)).pow k
  have hx0 : ((MvPolynomial.X 0 : MvPolynomial (Fin 2) ℤ)^k).IsHomogeneous k := by
    simpa using (MvPolynomial.isHomogeneous_X ℤ (0:Fin 2)).pow k
  have h1 := (MvPolynomial.isHomogeneous_C (Fin 2) v0).mul hx1
  have h0 := (MvPolynomial.isHomogeneous_C (Fin 2) u0).mul hx0
  have hh := h1.sub h0
  rw [Nat.zero_add] at hh
  exact hh

theorem axisPhiK_eval (k : ℕ) (u0 v0 d e : ℤ) :
    MvPolynomial.eval ![d,e] (axisPhiK k u0 v0)=v0*e^k-u0*d^k := by
  simp only [axisPhiK, map_sub, map_mul, map_pow, MvPolynomial.eval_X,
    MvPolynomial.eval_C, Matrix.cons_val_zero, Matrix.cons_val_one]

