      le_self_pow₀ (by exact_mod_cast hp.one_lt.le) (by omega)
    exact hbpow.trans (Real.rpow_le_rpow (by positivity) hppow heps.le)
  have hout := hb (fun _ _ => hk0.le) hsmall hlarge
  simpa only [Finset.prod_const] using hout

private theorem primeFactors_power (e k : ℕ) (he : 0 < e) (hk : 0 < k) :
    (e ^ k).primeFactors = e.primeFactors := by
  ext p
  constructor
  · intro hp
    obtain ⟨hpp, hpe, _⟩ := Nat.mem_primeFactors.mp hp
    exact Nat.mem_primeFactors.mpr ⟨hpp, hpp.dvd_of_dvd_pow hpe, he.ne'⟩
  · intro hp
    obtain ⟨hpp, hpe, _⟩ := Nat.mem_primeFactors.mp hp
    exact Nat.mem_primeFactors.mpr
      ⟨hpp, hpe.trans (dvd_pow_self e hk.ne'), pow_ne_zero _ he.ne'⟩

private def population (k : ℕ) (h : ℤ) (x D E : ℝ) :
    Set ((ℕ × ℕ) × (ℕ × ℕ)) := {q |
  1 ≤ q.1.1 ∧ 1 ≤ q.1.2 ∧ 1 ≤ q.2.1 ∧ 1 ≤ q.2.2 ∧
  D / 2 < (q.1.1 : ℝ) ∧ (q.1.1 : ℝ) ≤ D ∧
  E / 2 < (q.1.2 : ℝ) ∧ (q.1.2 : ℝ) ≤ E ∧
  ((q.1.1 ^ k * q.2.1 : ℕ) : ℝ) ≤ x ∧
  ((q.1.2 ^ k * q.2.2 : ℕ) : ℤ) =
    ((q.1.1 ^ k * q.2.1 : ℕ) : ℤ) + h}

private theorem positive_power_bounds (d u k : ℕ)
    (hd : 1 ≤ d) (hu : 1 ≤ u) (hk : 0 < k) :
    d ≤ d ^ k * u ∧ u ≤ d ^ k * u := by
  have hpow0 : 1 ≤ d ^ (k - 1) := one_le_pow₀ hd
  have hpow : d * d ^ (k - 1) = d ^ k := by
    rw [← pow_succ']
    congr 1
    omega
  have hdk : d ≤ d ^ k := by nlinarith
  have hdk1 : 1 ≤ d ^ k := one_le_pow₀ hd
  constructor <;> nlinarith

private theorem point_bounds (k : ℕ) (hk : 0 < k) (h : ℤ)
    (hh : h = 1 ∨ h = -1) (x D E : ℝ) (_hx : 2 ≤ x)
    (q : (ℕ × ℕ) × (ℕ × ℕ)) (hq : q ∈ population k h x D E) :
    (q.1.1 : ℝ) ≤ x ∧ (q.2.1 : ℝ) ≤ x ∧
    (q.1.2 : ℝ) ≤ x + 1 ∧ (q.2.2 : ℝ) ≤ x + 1 ∧
    ((q.1.2 ^ k * q.2.2 : ℕ) : ℝ) ≤ x + 1 := by
  rcases hq with ⟨hd, he, hu, hv, hDl, hDu, hEl, hEu, hn, heq⟩
  have hdb := positive_power_bounds q.1.1 q.2.1 k hd hu hk
  have heb := positive_power_bounds q.1.2 q.2.2 k he hv hk
  have hhr : (h : ℝ) ≤ 1 := by rcases hh with rfl | rfl <;> norm_num
  have heqR :
      ((q.1.2 ^ k * q.2.2 : ℕ) : ℝ) =
        ((q.1.1 ^ k * q.2.1 : ℕ) : ℝ) + (h : ℝ) := by exact_mod_cast heq
  have hright : ((q.1.2 ^ k * q.2.2 : ℕ) : ℝ) ≤ x + 1 := by linarith
  have hdR : (q.1.1 : ℝ) ≤ ((q.1.1 ^ k * q.2.1 : ℕ) : ℝ) := by exact_mod_cast hdb.1
  have huR : (q.2.1 : ℝ) ≤ ((q.1.1 ^ k * q.2.1 : ℕ) : ℝ) := by exact_mod_cast hdb.2
  have heR : (q.1.2 : ℝ) ≤ ((q.1.2 ^ k * q.2.2 : ℕ) : ℝ) := by exact_mod_cast heb.1
  have hvR : (q.2.2 : ℝ) ≤ ((q.1.2 ^ k * q.2.2 : ℕ) : ℝ) := by exact_mod_cast heb.2
  exact ⟨hdR.trans hn, huR.trans hn, heR.trans hright, hvR.trans hright, hright⟩

private theorem population_finite (k : ℕ) (hk : 0 < k) (h : ℤ)
    (hh : h = 1 ∨ h = -1) (x D E : ℝ) (hx : 2 ≤ x) :
    (population k h x D E).Finite := by
  let A := Finset.Icc 1 ⌊x + 1⌋₊
  let B := (A.product A).product (A.product A)
  apply B.finite_toSet.subset
  intro q hq
  have hb := point_bounds k hk h hh x D E hx q hq
  rcases hq with ⟨hd, he, hu, hv, _⟩
  exact Finset.mem_coe.mpr (Finset.mem_product.mpr
    ⟨Finset.mem_product.mpr
      ⟨Finset.mem_Icc.mpr ⟨hd, Nat.le_floor (by linarith [hb.1])⟩,
       Finset.mem_Icc.mpr ⟨he, Nat.le_floor hb.2.2.1⟩⟩,
     Finset.mem_product.mpr
      ⟨Finset.mem_Icc.mpr ⟨hu, Nat.le_floor (by linarith [hb.2.1])⟩,
       Finset.mem_Icc.mpr ⟨hv, Nat.le_floor hb.2.2.2.1⟩⟩⟩)

private theorem cofactor_upper (k : ℕ) (D x : ℝ) (hD : 0 < D)
    (d u : ℕ) (hd : D / 2 < (d : ℝ))
    (hx : ((d ^ k * u : ℕ) : ℝ) ≤ x) :
    (u : ℝ) ≤ (2 : ℝ) ^ k * x / D ^ k := by
  have hDle : D ≤ 2 * (d : ℝ) := by linarith
  have hp := pow_le_pow_left₀ hD.le hDle k
  have hmul : (u : ℝ) * D ^ k ≤ (2 : ℝ) ^ k * x := by
    calc
      _ ≤ (u : ℝ) * (2 * (d : ℝ)) ^ k :=
        mul_le_mul_of_nonneg_left hp (Nat.cast_nonneg _)
      _ = (2 : ℝ) ^ k * ((d : ℝ) ^ k * (u : ℝ)) := by rw [mul_pow]; ring
      _ ≤ (2 : ℝ) ^ k * x := by exact mul_le_mul_of_nonneg_left (by exact_mod_cast hx) (by positivity)
  exact (le_div_iff₀ (pow_pos hD _)).mpr hmul

private theorem fiber_injective (k : ℕ) (h : ℤ) (x D E : ℝ)
    (q r : (ℕ × ℕ) × (ℕ × ℕ))
    (hq : q ∈ population k h x D E) (hr : r ∈ population k h x D E)
    (heu : (q.1.2, q.2.1) = (r.1.2, r.2.1))
    (hd : q.1.1 = r.1.1) : q = r := by
  rcases q with ⟨⟨d, e⟩, ⟨u, v⟩⟩
  rcases r with ⟨⟨d', e'⟩, ⟨u', v'⟩⟩
  simp only [Prod.mk.injEq] at heu
  dsimp only at hd
  obtain rfl := hd
  obtain ⟨rfl, rfl⟩ := heu
  dsimp only [population] at hq hr
  rcases hq with ⟨hd, he, hu, hv, hDl, hDu, hEl, hEu, hn, heq⟩
  rcases hr with ⟨hd', he', hu', hv', hDl', hDu', hEl', hEu', hn', heq'⟩
  change 1 ≤ e at he
  have he0 : e ≠ 0 := by omega
  have hmul : e ^ k * v = e ^ k * v' := by
    exact_mod_cast (show ((e ^ k * v : ℕ) : ℤ) =
      ((e ^ k * v' : ℕ) : ℤ) by linarith [heq, heq'])
  have hvv : v = v' := mul_left_cancel₀ (pow_ne_zero _ he0) hmul
  subst v'
  rfl

private theorem scale_algebra (k : ℕ) (hk : 0 < k) (x D E : ℝ)
    (hD : 0 < D) (hE : 0 < E) :
    E * ((2 : ℝ) ^ k * x / D ^ k) *
      ((k : ℝ) * D * (2 : ℝ) ^ k / E ^ k + 1) =
      ((k : ℝ) * (2 : ℝ) ^ k * (2 : ℝ) ^ k) *
        (x / (D * E) ^ (k - 1)) +
      (2 : ℝ) ^ k * (E * (x / D ^ k)) := by
  have hDk : D ^ k = D ^ (k - 1) * D := by
    rw [← pow_succ]
    congr 1
    omega
  have hEk : E ^ k = E ^ (k - 1) * E := by
    rw [← pow_succ]
    congr 1
    omega
  rw [hDk, hEk, mul_pow]
  field_simp [hD.ne', hE.ne']


private theorem one_sided (k : ℕ) (hk : 2 ≤ k) (epsilon : ℝ) (heps : 0 < epsilon) :
    ∃ C : ℝ, 0 < C ∧ ∀ x : ℝ, 2 ≤ x →
      ∀ D E : ℝ, 0 < D → 0 < E → ∀ h : ℤ, (h = 1 ∨ h = -1) →
        (population k h x D E).Finite ∧
        ((population k h x D E).ncard : ℝ) ≤
          C * x ^ epsilon *
            (x / (D * E) ^ (k - 1) + E * (x / D ^ k)) := by
  have hk0 : 0 < k := by omega
  obtain ⟨W, hW, hweight⟩ := prime_weight_subpower k (by omega) epsilon heps
  let A : ℝ := W * (3 / 2 : ℝ) ^ epsilon
  let B : ℝ := (k : ℝ) * (2 : ℝ) ^ k * (2 : ℝ) ^ k + (2 : ℝ) ^ k + 1
  have hA : 0 < A := by dsimp [A]; positivity
  have hB : 0 < B := by dsimp [B]; positivity
  refine ⟨A * B, mul_pos hA hB, ?_⟩
  intro x hx D E hD hE h hh
  have hx0 : 0 < x := by linarith
  have hfinite := population_finite k hk0 h hh x D E hx
  refine ⟨hfinite, ?_⟩
  let S := hfinite.toFinset
  let Ucap : ℝ := (2 : ℝ) ^ k * x / D ^ k
  let P : Finset (ℕ × ℕ) :=
    (Finset.Icc 1 ⌊E⌋₊).product (Finset.Icc 1 ⌊Ucap⌋₊)
  have hUcap : 0 < Ucap := by dsimp [Ucap]; positivity
  have hmem : ∀ q ∈ S, q ∈ population k h x D E := by
    intro q hq
    simpa [S] using hq
  have hmaps : ∀ q ∈ S, (q.1.2, q.2.1) ∈ P := by
    intro q hq
    have hqp := hmem q hq
    rcases hqp with ⟨hd, he, hu, hv, hDl, hDu, hEl, hEu, hn, heq⟩
    have hucap := cofactor_upper k D x hD q.1.1 q.2.1 hDl hn
    exact Finset.mem_product.mpr
      ⟨Finset.mem_Icc.mpr ⟨he, Nat.le_floor hEu⟩,
       Finset.mem_Icc.mpr ⟨hu, Nat.le_floor hucap⟩⟩
  let H : ℝ := A * x ^ epsilon *
    ((k : ℝ) * D * (2 : ℝ) ^ k / E ^ k + 1)
  have hH : 0 ≤ H := by dsimp [H]; positivity
  have hfiber : ∀ z ∈ P,
      ((S.filter (fun q => (q.1.2, q.2.1) = z)).card : ℝ) ≤ H := by
    intro z hz
    let G := S.filter (fun q => (q.1.2, q.2.1) = z)
    rcases G.eq_empty_or_nonempty with hG | ⟨q0, hq0⟩
    · change (G.card : ℝ) ≤ H
      rw [hG]
      simpa using hH
    have hq0S := (Finset.mem_filter.mp hq0).1
    have hq0p := hmem q0 hq0S
    have hpair0 := (Finset.mem_filter.mp hq0).2
    have he0 : q0.1.2 = z.1 := congrArg Prod.fst hpair0
    have hu0 : q0.2.1 = z.2 := congrArg Prod.snd hpair0
    have hpoint := point_bounds k hk0 h hh x D E hx q0 hq0p
    rcases hq0p with ⟨hd0, hep0, hup0, hv0, hDl0, hDu0, hEl0, hEu0, hn0, heq0⟩
    have hepos : 0 < z.1 := by omega
    have heR : (0 : ℝ) < z.1 := by exact_mod_cast hepos
    have heX : (z.1 : ℝ) ≤ (3 / 2 : ℝ) * x := by
      rw [he0] at hpoint
      linarith [hpoint.2.2.1]
    have heps : (z.1 : ℝ) ^ epsilon ≤ (3 / 2 : ℝ) ^ epsilon * x ^ epsilon := by
      calc
        _ ≤ ((3 / 2 : ℝ) * x) ^ epsilon :=
          Real.rpow_le_rpow heR.le heX heps.le
        _ = _ := Real.mul_rpow (by norm_num) hx0.le
    have hw : (k : ℝ) ^ z.1.primeFactors.card ≤ A * x ^ epsilon := by
      calc
        _ ≤ W * (z.1 : ℝ) ^ epsilon := hweight z.1 hepos
        _ ≤ W * ((3 / 2 : ℝ) ^ epsilon * x ^ epsilon) :=
          mul_le_mul_of_nonneg_left heps hW.le
        _ = _ := by dsimp [A]; ring
    have hEpow : E ^ k ≤ (2 : ℝ) ^ k * (z.1 : ℝ) ^ k := by
      have hle : E ≤ 2 * (z.1 : ℝ) := by rw [he0] at hEl0; linarith
      simpa [mul_pow] using pow_le_pow_left₀ hE.le hle k
    have hquot :
        (k : ℝ) * D / (z.1 : ℝ) ^ k ≤
          (k : ℝ) * D * (2 : ℝ) ^ k / E ^ k := by
      apply (div_le_div_iff₀ (pow_pos heR _) (pow_pos hE _)).mpr
      nlinarith [mul_le_mul_of_nonneg_left hEpow (show 0 ≤ (k : ℝ) * D by positivity)]
    let R := roots (z.1 ^ k) k (z.2 : ℤ) h D
    have hmapR : ∀ q ∈ G, q.1.1 ∈ R := by
      intro q hq
      have hs := (Finset.mem_filter.mp hq).1
      have hp := hmem q hs
      have hpair := (Finset.mem_filter.mp hq).2
      have he : q.1.2 = z.1 := congrArg Prod.fst hpair
      have hu : q.2.1 = z.2 := congrArg Prod.snd hpair
      rcases hp with ⟨hd, hep, hup, hv, hDl, hDu, hEl, hEu, hn, heq⟩
      apply Finset.mem_filter.mpr
      refine ⟨Finset.mem_Icc.mpr ⟨hd, Nat.le_floor hDu⟩, ?_⟩
      refine ⟨(q.2.2 : ℤ), ?_⟩
      push_cast at heq ⊢
      simpa [he, hu, mul_comm] using heq.symm
    have hcard : G.card ≤ R.card := by
      apply Finset.card_le_card_of_injOn
        (fun q : (ℕ × ℕ) × (ℕ × ℕ) => q.1.1) hmapR
      intro q hq r hr hd
      apply fiber_injective k h x D E q r
        (hmem q (Finset.mem_filter.mp hq).1)
        (hmem r (Finset.mem_filter.mp hr).1) _ hd
      exact (Finset.mem_filter.mp hq).2.trans (Finset.mem_filter.mp hr).2.symm
    have hrbound := roots_upper (z.1 ^ k) k (pow_pos hepos _) hk0
      (z.2 : ℤ) h hh D hD
    have hprime := primeFactors_power z.1 k hepos hk0
    rw [hprime] at hrbound
    have hRbound : (R.card : ℝ) ≤
        (k : ℝ) ^ z.1.primeFactors.card *
          ((k : ℝ) * D / (z.1 : ℝ) ^ k + 1) := by
      simpa only [Nat.cast_pow] using hrbound
    calc
      (G.card : ℝ) ≤ (R.card : ℝ) := by exact_mod_cast hcard
      _ ≤ (k : ℝ) ^ z.1.primeFactors.card *
          ((k : ℝ) * D / (z.1 : ℝ) ^ k + 1) := hRbound
      _ ≤ A * x ^ epsilon *
          ((k : ℝ) * D * (2 : ℝ) ^ k / E ^ k + 1) :=
        mul_le_mul hw (by linarith) (by positivity) (by positivity)
      _ = H := rfl
  have hpartition : S.card =
      ∑ z ∈ P, (S.filter (fun q => (q.1.2, q.2.1) = z)).card :=
    Finset.card_eq_sum_card_fiberwise hmaps
  have hScard : (S.card : ℝ) ≤ (P.card : ℝ) * H := by
    calc
      _ = ∑ z ∈ P, ((S.filter (fun q => (q.1.2, q.2.1) = z)).card : ℝ) := by
        exact_mod_cast hpartition
      _ ≤ ∑ _z ∈ P, H := Finset.sum_le_sum hfiber
      _ = _ := by simp
  have hPcard : (P.card : ℝ) ≤ E * Ucap := by
    have hPc : P.card =
        (Finset.Icc 1 ⌊E⌋₊).card * (Finset.Icc 1 ⌊Ucap⌋₊).card := by
      exact Finset.card_product _ _
    rw [hPc]
    simp only [Nat.card_Icc, Nat.add_sub_cancel]
    push_cast
    exact mul_le_mul (Nat.floor_le hE.le) (Nat.floor_le hUcap.le)
      (Nat.cast_nonneg _) hE.le
  have harea : 0 ≤ x / (D * E) ^ (k - 1) := by positivity
  have hEU : 0 ≤ E * (x / D ^ k) := by positivity
  have hB1 : (k : ℝ) * (2 : ℝ) ^ k * (2 : ℝ) ^ k ≤ B := by
    dsimp [B]
    nlinarith [show 0 ≤ (2 : ℝ) ^ k by positivity]
  have hB2 : (2 : ℝ) ^ k ≤ B := by
    dsimp [B]
    nlinarith [show 0 ≤ (k : ℝ) * (2 : ℝ) ^ k * (2 : ℝ) ^ k by positivity]
  have hcoeff :
      ((k : ℝ) * (2 : ℝ) ^ k * (2 : ℝ) ^ k) *
        (x / (D * E) ^ (k - 1)) +
      (2 : ℝ) ^ k * (E * (x / D ^ k)) ≤
      B * (x / (D * E) ^ (k - 1) + E * (x / D ^ k)) := by
    nlinarith [mul_le_mul_of_nonneg_right hB1 harea,
      mul_le_mul_of_nonneg_right hB2 hEU]
  have hfinal :
      (S.card : ℝ) ≤ (A * B) * x ^ epsilon *
        (x / (D * E) ^ (k - 1) + E * (x / D ^ k)) := by
    calc
      _ ≤ (E * Ucap) * H := hScard.trans (mul_le_mul_of_nonneg_right hPcard hH)
      _ = A * x ^ epsilon *
          (E * ((2 : ℝ) ^ k * x / D ^ k) *
            ((k : ℝ) * D * (2 : ℝ) ^ k / E ^ k + 1)) := by dsimp [Ucap, H]; ring
      _ = A * x ^ epsilon *
          (((k : ℝ) * (2 : ℝ) ^ k * (2 : ℝ) ^ k) *
              (x / (D * E) ^ (k - 1)) +
            (2 : ℝ) ^ k * (E * (x / D ^ k))) := by
        rw [scale_algebra k hk0 x D E hD hE]
      _ ≤ A * x ^ epsilon *
          (B * (x / (D * E) ^ (k - 1) + E * (x / D ^ k))) :=
        mul_le_mul_of_nonneg_left hcoeff (by positivity)
      _ = _ := by ring
  simpa [S, ← Set.ncard_eq_toFinset_card (population k h x D E) hfinite] using hfinal

private def flip (q : (ℕ × ℕ) × (ℕ × ℕ)) : (ℕ × ℕ) × (ℕ × ℕ) :=
  ((q.1.2, q.1.1), (q.2.2, q.2.1))

private theorem flip_mem (k : ℕ) (hk : 0 < k) (h : ℤ)
    (hh : h = 1 ∨ h = -1) (x D E : ℝ) (hx : 2 ≤ x)
    (q : (ℕ × ℕ) × (ℕ × ℕ)) (hq : q ∈ population k h x D E) :
    flip q ∈ population k (-h) (x + 1) E D := by
  have hb := point_bounds k hk h hh x D E hx q hq
  rcases hq with ⟨hd, he, hu, hv, hDl, hDu, hEl, hEu, hn, heq⟩
  refine ⟨he, hd, hv, hu, hEl, hEu, hDl, hDu, hb.2.2.2.2, ?_⟩
  dsimp [flip]
  push_cast at heq ⊢
  linarith

private theorem whole (k : ℕ) (hk : 2 ≤ k) (epsilon : ℝ) (heps : 0 < epsilon) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ, 2 ≤ x →
      ∀ D E : ℝ, 0 < D → 0 < E → ∀ h : ℤ, (h = 1 ∨ h = -1) →
        (population k h x D E).Finite ∧
        ((population k h x D E).ncard : ℝ) ≤ C * x ^ epsilon *
          (x / (D * E) ^ (k - 1) +
            min (E * (x / D ^ k)) (D * (x / E ^ k))) := by
  obtain ⟨C0, hC0, hside⟩ := one_sided k hk epsilon heps
  let b : ℝ := (3 / 2 : ℝ) ^ epsilon
  have hb : 1 ≤ b := Real.one_le_rpow (by norm_num) heps.le
  have hb0 : 0 < b := by dsimp [b]; positivity
  let C : ℝ := 2 * C0 * b
  have hC : 0 ≤ C := by dsimp [C]; positivity
  refine ⟨C, hC, ?_⟩
  intro x hx D E hD hE h hh
  have hx0 : 0 < x := by linarith
  have hforward := hside x hx D E hD hE h hh
  have hhneg : -h = 1 ∨ -h = -1 := by
    rcases hh with rfl | rfl <;> simp
  have hreverse := hside (x + 1) (by linarith) E D hE hD (-h) hhneg
  have hncard :
      (population k h x D E).ncard ≤
        (population k (-h) (x + 1) E D).ncard := by
    rw [Set.ncard_eq_toFinset_card _ hforward.1,
      Set.ncard_eq_toFinset_card _ hreverse.1]
    apply Finset.card_le_card_of_injOn flip
    · intro q hq
      simpa using flip_mem k (by omega) h hh x D E hx q (by simpa using hq)
    · intro q hq r hr heq
      have heq' := congrArg flip heq
      simpa [flip] using heq'
  have hpow : (x + 1) ^ epsilon ≤ b * x ^ epsilon := by
    calc
      _ ≤ ((3 / 2 : ℝ) * x) ^ epsilon :=
        Real.rpow_le_rpow (by positivity) (by linarith) heps.le
      _ = _ := Real.mul_rpow (by norm_num) hx0.le
  have hlinear :
      (x + 1) / (E * D) ^ (k - 1) +
        D * ((x + 1) / E ^ k) ≤
      (3 / 2 : ℝ) *
        (x / (D * E) ^ (k - 1) + D * (x / E ^ k)) := by
    have hc : 0 ≤ 1 / (D * E) ^ (k - 1) + D / E ^ k := by positivity
    calc
      _ = (x + 1) * (1 / (D * E) ^ (k - 1) + D / E ^ k) := by
        rw [mul_comm E D]
        simp only [div_eq_mul_inv]
        ring
      _ ≤ ((3 / 2 : ℝ) * x) * (1 / (D * E) ^ (k - 1) + D / E ^ k) :=
        mul_le_mul_of_nonneg_right (by linarith) hc
      _ = _ := by simp only [div_eq_mul_inv]; ring
  have hrev :
      ((population k h x D E).ncard : ℝ) ≤
        C * x ^ epsilon *
          (x / (D * E) ^ (k - 1) + D * (x / E ^ k)) := by
    calc
      _ ≤ ((population k (-h) (x + 1) E D).ncard : ℝ) := by exact_mod_cast hncard
      _ ≤ C0 * (x + 1) ^ epsilon *
