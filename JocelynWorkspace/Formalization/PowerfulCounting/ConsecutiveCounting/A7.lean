  have ha1 : (1 : ℝ) / 4 ≤ max ((9 : ℝ) / 8 * s * (2 - 4 * s)) ((1 : ℝ) / 4) + δ := by linarith
  have ha2 : max ((9 : ℝ) / 8 * s * (2 - 4 * s)) ((1 : ℝ) / 4) + δ ≤ 51 / 200 - 1 / 1000 := by
