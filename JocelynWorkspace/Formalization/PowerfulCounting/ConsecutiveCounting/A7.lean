 theorem claim_9bc8f16ed70906d9191a24f104c96cc2b7d2168274e2a2cbcbd1de0846a14c5b :
(let kFree : ℕ → ℕ → Prop := fun k n => ∀ p : ℕ, p.Prime → ¬ p ^ k ∣ n;
let pairDensity : ℕ → ℝ := fun k => tprod (fun p : Nat.Primes => (1 - 2 / ((p : ℕ) : ℝ) ^ k));
let kFreePairs : ℕ → ℝ → ℕ := fun k x => (by classical exact
  ((Finset.Icc 1 ⌊x⌋₊).filter (fun n => kFree k n ∧ kFree k (n + 1))).card);
∀ k : ℕ, 2 ≤ k → ∀ ε : ℝ, 0 < ε →
  ∃ C : ℝ, 0 ≤ C ∧ ∀ x : ℝ, 2 ≤ x →
    let S : Set ((ℕ × ℕ) × (ℕ × ℕ)) :=
      {q | 1 ≤ q.1.1 ∧ 1 ≤ q.1.2 ∧ 1 ≤ q.2.1 ∧ 1 ≤ q.2.2 ∧
        ((q.1.1 ^ k * q.2.1 : ℕ) : ℝ) ≤ x ∧
        q.1.2 ^ k * q.2.2 = q.1.1 ^ k * q.2.1 + 1 ∧
        x ^ ((1 : ℝ) / (k : ℝ)) < ((q.1.1 * q.1.2 : ℕ) : ℝ)};
    S.Finite ∧ |(kFreePairs k x : ℝ) - x * pairDensity k| ≤
      C * x ^ ((1 : ℝ) / (k : ℝ) + ε) + (S.ncard : ℝ)) := by
  dsimp only
  intro k hk ε hε
  obtain ⟨C,hC,hshort⟩ := GenericKFreeAnalytic.short_pair_root_local k hk ε hε
  refine ⟨C,hC,?_⟩
  intro x hx
  let y : ℝ := x^((1 : ℝ)/(k : ℝ))
  have hx1 : 1 ≤ x := by linarith
  have hkpos : 0 < (k : ℝ) := by exact_mod_cast (show 0<k by omega)
  have hy : 1 ≤ y := Real.one_le_rpow hx1 (one_div_nonneg.mpr hkpos.le)
  change (GenericKFreeCore.largeDivisorTail k x y).Finite ∧
    |(GenericKFreeCore.kFreePairs k x : ℝ) -
      x*(∏' p : Nat.Primes,(1-2/((p : ℕ) : ℝ)^k))| ≤
      C*x^((1 : ℝ)/(k : ℝ)+ε) +
        ((GenericKFreeCore.largeDivisorTail k x y).ncard : ℝ)
  obtain ⟨hf,ht⟩ := GenericKFreeCore.finite_truncation k (by omega) x y hx hy
  refine ⟨hf,?_⟩
  calc
    _ = |((GenericKFreeCore.kFreePairs k x : ℝ)-GenericKFreeCore.shortPairSum k x y) +
          (GenericKFreeCore.shortPairSum k x y -
            x*(∏' p : Nat.Primes,(1-2/((p : ℕ) : ℝ)^k)))| := by congr 1;ring
    _ ≤ |(GenericKFreeCore.kFreePairs k x : ℝ)-GenericKFreeCore.shortPairSum k x y| +
          |GenericKFreeCore.shortPairSum k x y -
            x*(∏' p : Nat.Primes,(1-2/((p : ℕ) : ℝ)^k))| := abs_add_le _ _
    _ ≤ ((GenericKFreeCore.largeDivisorTail k x y).ncard : ℝ) +
            C*x^((1 : ℝ)/(k : ℝ)+ε) := add_le_add ht (hshort x hx)
    _ = _ := add_comm _ _
end JocelynClaims

