noncomputable def U (D x : ℝ) : ℝ := x * D ^ (-(3 : ℝ))
noncomputable def V (E x : ℝ) : ℝ := x * E ^ (-(3 : ℝ))
noncomputable def rho (D E : ℝ) (M j : ℕ) : ℝ :=
  D / (2 * E) * (1 + 1 / (M : ℝ)) ^ j
def indices (D E : ℝ) (M : ℕ) : Set ℕ :=
  {j | D / (2 * E) ≤ rho D E M j ∧ rho D E M j ≤ 2 * D / E}
noncomputable def omega (D E : ℝ) (M j : ℕ) : ℝ := (rho D E M j) ^ (3 : ℕ)

def normsAt (A B : ℝ) (M : ℕ) (s : ℝ) : Set ℝ :=
  {r | ∃ p q : ℤ, (p ≠ 0 ∨ q ≠ 0) ∧
    Real.sqrt (((M : ℝ) / B * ((p : ℝ) - s * (q : ℝ))) ^ 2 +
      ((q : ℝ) / A) ^ 2) = r}
noncomputable def lambdaAt (A B : ℝ) (M : ℕ) (s : ℝ) : ℝ := sInf (normsAt A B M s)
noncomputable def heightAt (A B : ℝ) (M : ℕ) (s : ℝ) : ℝ := 1 / lambdaAt A B M s

lemma pair_nonzero {b : ℤ × ℤ} (hb : b ≠ 0) : b.1 ≠ 0 ∨ b.2 ≠ 0 := by
  by_contra h
  push Not at h
  exact hb (Prod.ext h.1 h.2)

lemma pair_nonzero' {p q : ℤ} (h : p ≠ 0 ∨ q ≠ 0) : (p, q) ≠ (0 : ℤ × ℤ) := by
  intro he
  have hp : p = 0 := congrArg Prod.fst he
  have hq : q = 0 := congrArg Prod.snd he
  rcases h with h | h
  · exact h hp
  · exact h hq

lemma minimumAt (A B : ℝ) (M : ℕ) (s : ℝ)
    (hA : 0 < A) (hB : 0 < B) (hM : (0 : ℝ) < M) :
    ∃ b : ℤ × ℤ, b ≠ 0 ∧
      lambdaAt A B M s = Real.sqrt (nsq ((M : ℝ) / B) s A b) ∧
      0 < lambdaAt A B M s := by
  classical
  obtain ⟨b, hb, hmin⟩ := exists_shortest ((M : ℝ) / B) s A (by positivity) hA
  have hspos : 0 < Real.sqrt (nsq ((M : ℝ) / B) s A b) :=
    Real.sqrt_pos.mpr (nsq_pos _ _ _ (by positivity) hA b hb)
  have hmember : Real.sqrt (nsq ((M : ℝ) / B) s A b) ∈ normsAt A B M s := by
    exact ⟨b.1, b.2, pair_nonzero hb, rfl⟩
  have hnonempty : (normsAt A B M s).Nonempty := ⟨_, hmember⟩
  have hlower : ∀ r ∈ normsAt A B M s,
      Real.sqrt (nsq ((M : ℝ) / B) s A b) ≤ r := by
    rintro r ⟨p, q, hpq, rfl⟩
    exact Real.sqrt_le_sqrt (hmin (p, q) (pair_nonzero' hpq))
  have hbounded : BddBelow (normsAt A B M s) := by
    refine ⟨0, ?_⟩
    rintro r ⟨p, q, hpq, rfl⟩
    exact Real.sqrt_nonneg _
  have hinf : lambdaAt A B M s = Real.sqrt (nsq ((M : ℝ) / B) s A b) :=
    le_antisymm (csInf_le hbounded hmember) (le_csInf hnonempty hlower)
  exact ⟨b, hb, hinf, by rw [hinf]; exact hspos⟩

lemma positiveAt (A B : ℝ) (M : ℕ) (s : ℝ)
    (hA : 0 < A) (hB : 0 < B) (hM : (0 : ℝ) < M) :
    0 < lambdaAt A B M s ∧ 0 < heightAt A B M s := by
  obtain ⟨b, hb, heq, hp⟩ := minimumAt A B M s hA hB hM
  exact ⟨hp, one_div_pos.mpr hp⟩

lemma tail_from_spacing (A B : ℝ) (M : ℕ) (f : ℕ → ℝ) (S : Finset ℕ)
    (hA : 0 < A) (hB : 0 < B) (hM1 : (1 : ℝ) ≤ M)
    (hsp : ∀ i j : ℕ, i ≤ j →
      ((j : ℝ) - i) * (B / (8 * A * (M : ℝ))) ≤ f j - f i)
    (hfmin : ∀ j ∈ S, B / (8 * A) ≤ f j)
    (hfmax : ∀ j ∈ S, f j ≤ 8 * B / A)
    (L : ℝ) (hL : 32 * (A + B) / (M : ℝ) ≤ L) :
    ((S.filter (fun j => L ≤ heightAt A B M (f j))).card : ℝ) ≤
      200 * (A * B) / L ^ 2 := by
  classical
  have hM : (0 : ℝ) < M := by linarith
  have hML : 32 * (A + B) ≤ L * (M : ℝ) := by
    rwa [div_le_iff₀ hM] at hL
  have hL0 : 0 < L := by
    have : 0 < 32 * (A + B) / (M : ℝ) := by positivity
    exact lt_of_lt_of_le this hL
  let P := S.filter (fun j => L ≤ heightAt A B M (f j))
  have hPwit : ∀ j ∈ P, ∃ p q : ℤ, (p, q) ≠ (0 : ℤ × ℤ) ∧
      |(p : ℝ) - f j * (q : ℝ)| ≤ B / ((M : ℝ) * L) ∧
      |(q : ℝ)| ≤ A / L := by
    intro j hj
    obtain ⟨hjS, hjL⟩ := Finset.mem_filter.mp hj
    obtain ⟨b, hb, hmin, hpos⟩ := minimumAt A B M (f j) hA hB hM
    have hspos : 0 < Real.sqrt (nsq ((M : ℝ) / B) (f j) A b) := by
      rw [← hmin]; exact hpos
    have hjL' : L ≤ 1 / Real.sqrt (nsq ((M : ℝ) / B) (f j) A b) := by
      simpa only [heightAt, hmin] using hjL
    have hnorm : Real.sqrt (nsq ((M : ℝ) / B) (f j) A b) ≤ 1 / L := by
      rw [le_div_iff₀ hL0]
      rw [le_div_iff₀ hspos] at hjL'
      nlinarith
    have hc1 : |(M : ℝ) / B * ((b.1 : ℝ) - f j * (b.2 : ℝ))| ≤ 1 / L := by
      apply le_trans _ hnorm
      exact Real.abs_le_sqrt (by
        unfold nsq
        nlinarith [sq_nonneg ((b.2 : ℝ) / A)])
    have hc2 : |(b.2 : ℝ) / A| ≤ 1 / L := by
      apply le_trans _ hnorm
      exact Real.abs_le_sqrt (by
        unfold nsq
        nlinarith [sq_nonneg ((M : ℝ) / B * ((b.1 : ℝ) - f j * (b.2 : ℝ)))])
    refine ⟨b.1, b.2, hb, ?_, ?_⟩
    · have h := JocelynWorkspace.Formalization.PowerfulCounting.LatticeTails.JocelynTails.scaled_abs
        ((M : ℝ) / B) _ _ (by positivity) hc1
      have e : (1 / L) / ((M : ℝ) / B) = B / ((M : ℝ) * L) := by
        field_simp
        <;> ring
      rwa [e] at h
    · have h := JocelynWorkspace.Formalization.PowerfulCounting.LatticeTails.JocelynTails.div_abs_le
        _ A _ hA hc2
      have e : 1 / L * A = A / L := by ring
      rwa [e] at h
  have hA1 : B / ((M : ℝ) * L) < 1 := by
    rw [div_lt_one (by positivity)]
    nlinarith
  have hAf : B / ((M : ℝ) * L) < B / (8 * A) := by
    apply div_lt_div_of_pos_left hB (by positivity)
    nlinarith
  have hcnt := JocelynWorkspace.Formalization.PowerfulCounting.LatticeTails.JocelynTails.tail_abstract
    f (B / (8 * A * (M : ℝ))) (B / (8 * A)) (8 * B / A)
    (B / ((M : ℝ) * L)) (A / L) (by positivity) hsp S hfmin hfmax
    (by positivity) hA1 hAf P (Finset.filter_subset _ _) hPwit
  have hsum := JocelynWorkspace.Formalization.PowerfulCounting.LatticeTails.JocelynTails.sum_bound
    (8 * B / A) (B / ((M : ℝ) * L)) (B / (8 * A * (M : ℝ)))
    ⌊A / L⌋₊ (by positivity) (by positivity) (by positivity)
  have hN0 : (0 : ℝ) ≤ (⌊A / L⌋₊ : ℝ) := Nat.cast_nonneg _
  have hN1 : (⌊A / L⌋₊ : ℝ) ≤ A / L := Nat.floor_le (by positivity)
  have hN2 : (⌊A / L⌋₊ : ℝ) ≤ (M : ℝ) / 32 := by
    refine le_trans hN1 ?_
    rw [div_le_div_iff₀ hL0 (by norm_num)]
    nlinarith
  set N : ℝ := (⌊A / L⌋₊ : ℝ) with hNdef
  have e1 : 2 * (B / ((M : ℝ) * L)) * (8 * B / A) /
      (B / (8 * A * (M : ℝ))) = 128 * B / L := by field_simp <;> ring
  have e2 : 2 * (B / ((M : ℝ) * L)) ^ 2 /
      (B / (8 * A * (M : ℝ))) = 16 * A * B / ((M : ℝ) * L ^ 2) := by field_simp <;> ring
  have t1 : N * (8 * B / A * N) ≤ 8 * A * B / L ^ 2 := by
    calc
      _ = 8 * B / A * N ^ 2 := by ring
      _ ≤ 8 * B / A * (A / L) ^ 2 := by gcongr
      _ = _ := by field_simp <;> ring
  have t2 : N * (B / ((M : ℝ) * L)) ≤ A * B / L ^ 2 := by
    calc
      _ ≤ (A / L) * (B / ((M : ℝ) * L)) := by gcongr
      _ = A * B / ((M : ℝ) * L ^ 2) := by field_simp <;> ring
      _ ≤ A * B / L ^ 2 := by
        apply div_le_div_of_nonneg_left (by positivity) (by positivity)
        nlinarith [sq_nonneg L, pow_pos hL0 2]
  have t3 : N * (128 * B / L) ≤ 128 * A * B / L ^ 2 := by
    calc
      _ ≤ (A / L) * (128 * B / L) := by gcongr
      _ = _ := by field_simp <;> ring
  have t4 : N * (16 * A * B / ((M : ℝ) * L ^ 2)) ≤ A * B / L ^ 2 := by
    calc
      _ ≤ ((M : ℝ) / 32) * (16 * A * B / ((M : ℝ) * L ^ 2)) := by gcongr
      _ = (1 / 2 : ℝ) * (A * B / L ^ 2) := by field_simp <;> ring
      _ ≤ A * B / L ^ 2 := by
        have : 0 ≤ A * B / L ^ 2 := by positivity
        linarith
  calc
    _ ≤ _ := hcnt
    _ ≤ _ := hsum
    _ = N * (8 * B / A * N) + N * (B / ((M : ℝ) * L)) +
        N * (128 * B / L) + N * (16 * A * B / ((M : ℝ) * L ^ 2)) := by
      rw [e1, e2]
      ring
    _ ≤ 200 * (A * B) / L ^ 2 := by
      have hk : 0 ≤ A * B / L ^ 2 := by positivity
      have r1 : 8 * A * B / L ^ 2 = 8 * (A * B / L ^ 2) := by ring
      have r2 : 128 * A * B / L ^ 2 = 128 * (A * B / L ^ 2) := by ring
      have r3 : 200 * (A * B) / L ^ 2 = 200 * (A * B / L ^ 2) := by ring
      rw [r1] at t1
      rw [r2] at t3
      rw [r3]
      linarith

lemma cube_geometry (D E x : ℝ) (M : ℕ)
    (hD : 0 < D) (hE : 0 < E) (hx : 0 < x) (hM : (0 : ℝ) < M) :
    (∀ j, V E x / (8 * U D x) ≤ omega D E M j) ∧
    (∀ j ∈ indices D E M, omega D E M j ≤ 8 * V E x / U D x) ∧
    (∀ j, V E x / (8 * U D x * (M : ℝ)) ≤
      omega D E M (j + 1) - omega D E M j) := by
  have hU : 0 < U D x := by unfold U; positivity
  have hV : 0 < V E x := by unfold V; positivity
  have hUeq : U D x = x / D ^ 3 := by
    unfold U
    rw [Real.rpow_neg hD.le]
    norm_num
    ring
  have hVeq : V E x = x / E ^ 3 := by
    unfold V
    rw [Real.rpow_neg hE.le]
    norm_num
    ring
  have hloeq : (D / (2 * E)) ^ 3 = V E x / (8 * U D x) := by
    rw [hUeq, hVeq]
    field_simp
    <;> ring
  have huppeq : (2 * D / E) ^ 3 = 8 * V E x / U D x := by
    rw [hUeq, hVeq]
    field_simp
    <;> ring
  have hq : (1 : ℝ) ≤ 1 + 1 / (M : ℝ) := by
    have : 0 ≤ 1 / (M : ℝ) := by positivity
    linarith
  have hlow : ∀ j, D / (2 * E) ≤ rho D E M j := by
    intro j
    unfold rho
    have hh : (1 : ℝ) ≤ (1 + 1 / (M : ℝ)) ^ j := one_le_pow₀ hq
    have : 0 < D / (2 * E) := by positivity
    nlinarith
  have hlow' : ∀ j, V E x / (8 * U D x) ≤ omega D E M j := by
    intro j
    rw [← hloeq]
    exact pow_le_pow_left₀ (by positivity) (hlow j) 3
  have hupp : ∀ j ∈ indices D E M, omega D E M j ≤ 8 * V E x / U D x := by
    intro j hj
    rw [← huppeq]
    exact pow_le_pow_left₀ (by unfold rho; positivity) hj.2 3
  have hstep : ∀ j, V E x / (8 * U D x * (M : ℝ)) ≤
      omega D E M (j + 1) - omega D E M j := by
    intro j
    have hsucc : rho D E M (j + 1) = rho D E M j * (1 + 1 / (M : ℝ)) := by
      unfold rho
      rw [pow_succ]
      ring
    have hsucc' : omega D E M (j + 1) =
        omega D E M j * (1 + 1 / (M : ℝ)) ^ 3 := by
      unfold omega
      rw [hsucc, mul_pow]
    have hi : 0 ≤ 1 / (M : ℝ) := by positivity
    have hber : 1 + 1 / (M : ℝ) ≤ (1 + 1 / (M : ℝ)) ^ 3 := by
      nlinarith [sq_nonneg (1 / (M : ℝ)), pow_nonneg hi 3]
    have hω0 : 0 ≤ omega D E M j := by unfold omega rho; positivity
    have h1 := mul_le_mul_of_nonneg_left hber hω0
    have h2 := mul_le_mul_of_nonneg_right (hlow' j) hi
    have e : V E x / (8 * U D x) * (1 / (M : ℝ)) =
        V E x / (8 * U D x * (M : ℝ)) := by ring
    rw [e] at h2
    rw [hsucc']
    nlinarith
  exact ⟨hlow', hupp, hstep⟩

lemma threshold_absorption (D E : ℝ) (M : ℕ) (hD : 0 < D) (hE : 0 < E)
    (hM : (0 : ℝ) < M) :
    max ((D * E / (M : ℝ)) ^ ((1 : ℝ) / 2)) (32 * (D + E) / (M : ℝ)) ≤
      64 * ((D * E + (D ^ 2 + E ^ 2) / (M : ℝ)) / (M : ℝ)) ^ ((1 : ℝ) / 2) := by
  let B : ℝ := D * E + (D ^ 2 + E ^ 2) / (M : ℝ)
  let Z : ℝ := (B / (M : ℝ)) ^ ((1 : ℝ) / 2)
  have hB : 0 < B := by dsimp [B]; positivity
  have hZ : 0 < Z := Real.rpow_pos_of_pos (by positivity) _
  have hZsq : Z ^ 2 = B / (M : ℝ) :=
    JocelynWorkspace.Formalization.PowerfulCounting.LatticeMoments.JocelynMoments.sq_rpow_half _ (by positivity)
  have hQ : D * E / (M : ℝ) ≤ B / (M : ℝ) := by
    apply div_le_div_of_nonneg_right _ hM.le
    dsimp [B]
    have : 0 ≤ (D ^ 2 + E ^ 2) / (M : ℝ) := by positivity
    linarith
  have hfirst : (D * E / (M : ℝ)) ^ ((1 : ℝ) / 2) ≤ Z :=
    Real.rpow_le_rpow (by positivity) hQ (by norm_num)
  have haxis : ((D + E) / (M : ℝ)) ^ 2 ≤ 4 * Z ^ 2 := by
    rw [hZsq]
    have hsq : (D + E) ^ 2 ≤ 2 * (D ^ 2 + E ^ 2) := by nlinarith [sq_nonneg (D - E)]
    have hBaxis : D ^ 2 + E ^ 2 ≤ (M : ℝ) * B := by
      dsimp [B]
      have e : (M : ℝ) * (D * E + (D ^ 2 + E ^ 2) / (M : ℝ)) =
          (M : ℝ) * D * E + D ^ 2 + E ^ 2 := by field_simp [hM.ne']; ring
      rw [e]
      have : 0 ≤ (M : ℝ) * D * E := by positivity
      linarith
    have htop : (D + E) ^ 2 ≤ 4 * (M : ℝ) * B := by nlinarith
    have hdiv := (div_le_div_of_nonneg_right htop (sq_nonneg (M : ℝ)))
    calc
      ((D + E) / (M : ℝ)) ^ 2 = (D + E) ^ 2 / (M : ℝ) ^ 2 := by ring
      _ ≤ (4 * (M : ℝ) * B) / (M : ℝ) ^ 2 := hdiv
      _ = 4 * (B / (M : ℝ)) := by field_simp [hM.ne']
  have haxis' : (D + E) / (M : ℝ) ≤ 2 * Z := by
    nlinarith
  have hsecond : 32 * (D + E) / (M : ℝ) ≤ 64 * Z := by
    calc
      _ = 32 * ((D + E) / (M : ℝ)) := by ring
      _ ≤ 32 * (2 * Z) := mul_le_mul_of_nonneg_left haxis' (by norm_num)
      _ = _ := by ring
  change max _ _ ≤ 64 * Z
  exact max_le (by nlinarith [hfirst]) hsecond

lemma scale_identity (theta D E : ℝ) (M : ℕ)
    (hD : 0 < D) (hE : 0 < E) (hM : (0 : ℝ) < M) :
    (M : ℝ) * (64 * ((D * E + (D ^ 2 + E ^ 2) / (M : ℝ)) / (M : ℝ)) ^
      ((1 : ℝ) / 2)) ^ theta =
      64 ^ theta * (M : ℝ) ^ (1 - theta / 2) *
        (D * E + (D ^ 2 + E ^ 2) / (M : ℝ)) ^ (theta / 2) := by
  let B : ℝ := D * E + (D ^ 2 + E ^ 2) / (M : ℝ)
  have hB : 0 < B := by dsimp [B]; positivity
  change (M : ℝ) * (64 * (B / (M : ℝ)) ^ ((1 : ℝ) / 2)) ^ theta =
    64 ^ theta * (M : ℝ) ^ (1 - theta / 2) * B ^ (theta / 2)
  rw [Real.mul_rpow (by norm_num) (by positivity),
    ← Real.rpow_mul (by positivity)]
  have e : (1 : ℝ) / 2 * theta = theta / 2 := by ring
  rw [e, Real.div_rpow hB.le hM.le, Real.rpow_sub hM]
  rw [Real.rpow_one]
  ring

theorem main :
    ∀ theta : ℝ, 0 < theta → theta < 2 →
      ∃ C : ℝ, 0 < C ∧
        ∀ D E x : ℝ, 1 / 2 ≤ D → 1 / 2 ≤ E → 1 < x →
          ∀ M : ℕ, 1 ≤ M →
            (indices D E M).Finite ∧
            ((indices D E M).ncard : ℝ) ≤ 3 * (M : ℝ) + 1 ∧
            (∀ j ∈ indices D E M,
              0 < lambdaAt (U D x) (V E x) M (omega D E M j) ∧
              0 < heightAt (U D x) (V E x) M (omega D E M j)) ∧
            (∑ᶠ j ∈ indices D E M, (heightAt (U D x) (V E x) M (omega D E M j)) ^ theta) ≤
              C * (M : ℝ) ^ (1 - theta / 2) *
                (U D x * V E x +
                  ((U D x) ^ 2 + (V E x) ^ 2) / (M : ℝ)) ^ (theta / 2) := by
  intro theta htheta0 htheta2
  have h2theta : (2 : ℝ) ^ theta < 4 := by
    have h := Real.rpow_lt_rpow_of_exponent_lt (by norm_num : (1 : ℝ) < 2) htheta2
    norm_num at h ⊢
    exact h
  set r : ℝ := (2 : ℝ) ^ theta / 4 with hr
  have hr1 : r < 1 := by
    rw [hr, div_lt_one (by norm_num)]
    exact h2theta
  have h1r : 0 < 1 - r := by linarith
  let C0 : ℝ := 4 + 200 * 2 ^ theta / (1 - r)
  have hC0 : 0 < C0 := by dsimp [C0]; positivity
  refine ⟨C0 * 64 ^ theta, by positivity, ?_⟩
  intro D E x hD hE hx M hM
  classical
  have hD0 : 0 < D := by linarith
  have hE0 : 0 < E := by linarith
  have hx0 : 0 < x := by linarith
  have hM1 : (1 : ℝ) ≤ M := by exact_mod_cast hM
  have hM0 : (0 : ℝ) < M := by linarith
  have hU : 0 < U D x := by unfold U; positivity
  have hV : 0 < V E x := by unfold V; positivity
  have hgeom :=
    JocelynWorkspace.Formalization.PowerfulCounting.LatticeTails.JocelynClaims.claim_d31e9b77d0f9dd7614934ea632cc8dcd6919398027eb82ef33c69bc75aa5c7c7
      D E x hD hE hx M hM
  obtain ⟨-, hfin0, hcard0, -, -⟩ := hgeom
  have hfin : (indices D E M).Finite := hfin0
  have hcard : ((indices D E M).ncard : ℝ) ≤ 3 * (M : ℝ) + 1 := hcard0
  let S : Finset ℕ := hfin.toFinset
  have hSmem : ∀ j, j ∈ S ↔ j ∈ indices D E M := fun j => Set.Finite.mem_toFinset hfin
  have hScard : (S.card : ℝ) ≤ 3 * (M : ℝ) + 1 := by
    rw [Set.ncard_eq_toFinset_card _ hfin] at hcard
    exact hcard
  obtain ⟨hlow, hupp, hstep⟩ := cube_geometry D E x M hD0 hE0 hx0 hM0
  have hsp := JocelynWorkspace.Formalization.PowerfulCounting.LatticeTails.JocelynTails.spacing_of_step
    (omega D E M) (V E x / (8 * U D x * (M : ℝ))) hstep
  let B : ℝ := U D x * V E x + ((U D x) ^ 2 + (V E x) ^ 2) / (M : ℝ)
  let Ls : ℝ := 64 * (B / (M : ℝ)) ^ ((1 : ℝ) / 2)
  have hB : 0 < B := by dsimp [B]; positivity
  have hLs : 0 < Ls := by dsimp [Ls]; positivity
  have habsorb := threshold_absorption (U D x) (V E x) M hU hV hM0
  have hLsthreshold : 32 * (U D x + V E x) / (M : ℝ) ≤ Ls :=
    (le_max_right _ _).trans habsorb
  have hLsbase : (U D x * V E x / (M : ℝ)) ^ ((1 : ℝ) / 2) ≤ Ls :=
    (le_max_left _ _).trans habsorb
  have hQ : U D x * V E x ≤ (M : ℝ) * Ls ^ 2 := by
    have hsq := pow_le_pow_left₀ (by positivity : 0 ≤ (U D x * V E x / (M : ℝ)) ^ ((1 : ℝ) / 2)) hLsbase 2
    rw [JocelynWorkspace.Formalization.PowerfulCounting.LatticeMoments.JocelynMoments.sq_rpow_half _ (by positivity)] at hsq
    rw [div_le_iff₀ hM0] at hsq
    linarith
  have htail : ∀ L : ℝ, Ls ≤ L →
      ((S.filter (fun j => L ≤ heightAt (U D x) (V E x) M (omega D E M j))).card : ℝ) ≤
        200 * (U D x * V E x) / L ^ 2 := by
    intro L hL
    exact tail_from_spacing (U D x) (V E x) M (omega D E M) S hU hV hM1 hsp
      (fun j _ => hlow j)
      (fun j hj => hupp j ((hSmem j).mp hj))
      L (hLsthreshold.trans hL)
  have hpos : ∀ j, 0 < lambdaAt (U D x) (V E x) M (omega D E M j) ∧
      0 < heightAt (U D x) (V E x) M (omega D E M j) :=
    fun j => positiveAt (U D x) (V E x) M (omega D E M j) hU hV hM0
  have hmain :=
    JocelynWorkspace.Formalization.PowerfulCounting.LatticeMoments.JocelynMoments.moment_from_tails
      theta htheta0 r hr hr1 S
      (fun j => heightAt (U D x) (V E x) M (omega D E M j))
      (fun j _ => (hpos j).2.le) Ls (M : ℝ) 200 (U D x * V E x)
      hLs hM1 (by positivity) hQ (by norm_num) hScard htail
  refine ⟨hfin, hcard, fun j _ => hpos j, ?_⟩
  rw [finsum_mem_eq_finite_toFinset_sum _ hfin]
  calc
    _ ≤ C0 * (M : ℝ) * Ls ^ theta := hmain
    _ = _ := by
      dsimp only [Ls, B]
      rw [mul_assoc, scale_identity theta (U D x) (V E x) M hU hV hM0]
      ring

end CofactorCubic

theorem JocelynClaims.claim_7e54798ea025c68b1e48539610a91c4cf9e238603d6b930c8479287108b8d48c :
let U : ℝ → ℝ → ℝ :=
  fun D x => x * D ^ (-(3 : ℝ));
let V : ℝ → ℝ → ℝ :=
  fun E x => x * E ^ (-(3 : ℝ));
let rho : ℝ → ℝ → ℕ → ℕ → ℝ :=
  fun D E M j => D / (2 * E) * (1 + 1 / (M : ℝ)) ^ j;
let indices : ℝ → ℝ → ℕ → Set ℕ :=
  fun D E M => {j | D / (2 * E) ≤ rho D E M j ∧ rho D E M j ≤ 2 * D / E};
let omega : ℝ → ℝ → ℕ → ℕ → ℝ :=
  fun D E M j => (rho D E M j) ^ (3 : ℕ);
let nonzeroNorms : ℝ → ℝ → ℝ → ℕ → ℕ → Set ℝ :=
  fun D E x M j => {r | ∃ p q : ℤ, (p ≠ 0 ∨ q ≠ 0) ∧
    Real.sqrt (((M : ℝ) / V E x *
      ((p : ℝ) - omega D E M j * (q : ℝ))) ^ 2 +
      ((q : ℝ) / U D x) ^ 2) = r};
let lambda : ℝ → ℝ → ℝ → ℕ → ℕ → ℝ :=
  fun D E x M j => sInf (nonzeroNorms D E x M j);
let ell : ℝ → ℝ → ℝ → ℕ → ℕ → ℝ :=
  fun D E x M j => 1 / lambda D E x M j;
∀ theta : ℝ, 0 < theta → theta < 2 →
  ∃ C : ℝ, 0 < C ∧
    ∀ D E x : ℝ, 1 / 2 ≤ D → 1 / 2 ≤ E → 1 < x →
      ∀ M : ℕ, 1 ≤ M →
        (indices D E M).Finite ∧
        ((indices D E M).ncard : ℝ) ≤ 3 * (M : ℝ) + 1 ∧
        (∀ j ∈ indices D E M,
          0 < lambda D E x M j ∧ 0 < ell D E x M j) ∧
        (∑ᶠ j ∈ indices D E M, (ell D E x M j) ^ theta) ≤
          C * (M : ℝ) ^ (1 - theta / 2) *
            (U D x * V E x +
              ((U D x) ^ 2 + (V E x) ^ 2) / (M : ℝ)) ^ (theta / 2) := by
  exact CofactorCubic.main

