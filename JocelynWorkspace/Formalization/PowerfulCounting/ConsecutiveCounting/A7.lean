private theorem original_cut_rank_branch_counts
    (T : Finset ℤ) (κ lam z₀ γ x Zmin H : ℝ)
    (hx : 0 < x) (hγ : γ ≠ 0)
    (hheight : ∀ s ∈ T,
      x / 2 ≤ bandF κ lam (z₀ + γ * (s : ℝ)) ∧
      bandF κ lam (z₀ + γ * (s : ℝ)) ≤ x)
    (hphysical : ∀ s ∈ T, ∀ t ∈ T,
      (s : ℝ) < (t : ℝ) →
      cutRank (bandCuts κ lam z₀ γ x H) s =
        cutRank (bandCuts κ lam z₀ γ x H) t →
      (s : ℝ) ∉ bandCuts κ lam z₀ γ x H →
      (t : ℝ) ∉ bandCuts κ lam z₀ γ x H →
      ∀ r ∈ Set.Icc (s : ℝ) (t : ℝ),
        Zmin ≤ |z₀ + γ * r|) :
    (H = (3 / 5 : ℝ) * |γ * lam| * Zmin ^ 8 →
      lam ≠ 0 → (100 : ℝ) ≤ Zmin →
      (100 : ℝ) ≤ |lam| * Zmin ^ 2 →
      (100 : ℝ) * x ≤ |lam| * Zmin ^ 9 →
      (T.card : ℝ) ≤
        34 + 35 * (1 + x / (2 * H))) ∧
    (H = |γ| * Real.sqrt (x * Zmin ^ 5) →
      (100 : ℝ) ≤ Zmin →
      (90 : ℝ) * x ≤ Zmin ^ 7 →
      (T.card : ℝ) ≤
        34 + 35 * (1 +
          max (x / (2 * H))
            (2 * H / (30 * γ ^ 2 * Zmin ^ 5)))) := by
  classical
  let cuts : Finset ℝ := bandCuts κ lam z₀ γ x H
  let Tbad : Finset ℤ := T.filter (fun s : ℤ => (s : ℝ) ∈ cuts)
  let Tgood : Finset ℤ := T.filter (fun s : ℤ => (s : ℝ) ∉ cuts)
  have hcuts : cuts.card ≤ 34 :=
    bandCuts_card_all κ lam z₀ γ x H hγ
  have hbad : Tbad.card ≤ 34 := by
    have hinj : Function.Injective (fun s : ℤ => (s : ℝ)) := by
      intro s t hst
      change (s : ℝ) = (t : ℝ) at hst
      exact_mod_cast hst
    have hsub :
        Tbad.image (fun s : ℤ => (s : ℝ)) ⊆ cuts := by
      intro r hr
      obtain ⟨s, hs, rfl⟩ := Finset.mem_image.mp hr
      exact (Finset.mem_filter.mp hs).2
    calc
      Tbad.card = (Tbad.image (fun s : ℤ => (s : ℝ))).card :=
        (Finset.card_image_of_injective _ hinj).symm
      _ ≤ cuts.card := Finset.card_le_card hsub
      _ ≤ 34 := hcuts
  have hpartition : T.card = Tbad.card + Tgood.card := by
    have hjoin : Tbad ∪ Tgood = T := by
      ext s
      constructor
      · intro hs
        rcases Finset.mem_union.mp hs with hb | hg
        · exact (Finset.mem_filter.mp hb).1
        · exact (Finset.mem_filter.mp hg).1
      · intro hs
        by_cases hsc : (s : ℝ) ∈ cuts
        · exact Finset.mem_union.mpr
            (Or.inl (Finset.mem_filter.mpr ⟨hs, hsc⟩))
        · exact Finset.mem_union.mpr
            (Or.inr (Finset.mem_filter.mpr ⟨hs, hsc⟩))
    have hmeet : Tbad ∩ Tgood = ∅ := by
      ext s
      constructor
      · intro hs
        obtain ⟨hb, hg⟩ := Finset.mem_inter.mp hs
        exact False.elim
          ((Finset.mem_filter.mp hg).2 (Finset.mem_filter.mp hb).2)
      · simp
    have hc := Finset.card_union_add_card_inter Tbad Tgood
    rw [hjoin, hmeet] at hc
    simp at hc
    omega
  have count_of_diameter (L : ℝ) (hL : 0 ≤ L)
      (hdiam : ∀ s ∈ Tgood, ∀ t ∈ Tgood,
        cutRank cuts s = cutRank cuts t →
        |(s : ℝ) - (t : ℝ)| ≤ L) :
      (T.card : ℝ) ≤ 34 + 35 * (1 + L) := by
    have hgood := cutRank_integer_count
      Tgood cuts L hL hdiam
    have hmul :
        (((cuts.card + 1 : ℕ) : ℝ) * (1 + L)) ≤
          35 * (1 + L) := by
      have hfactor : ((cuts.card + 1 : ℕ) : ℝ) ≤ 35 := by
        exact_mod_cast (by omega : cuts.card + 1 ≤ 35)
      exact mul_le_mul_of_nonneg_right hfactor (by linarith)
    have hbadR : (Tbad.card : ℝ) ≤ 34 := by exact_mod_cast hbad
    have hpartR :
        (T.card : ℝ) =
          (Tbad.card : ℝ) + (Tgood.card : ℝ) := by
      exact_mod_cast hpartition
    linarith
  have branch_diameter
      (L : ℝ) (hL : 0 ≤ L)
      (hforward : ∀ s ∈ Tgood, ∀ t ∈ Tgood,
        (s : ℝ) < (t : ℝ) →
        cutRank cuts s = cutRank cuts t →
        (t : ℝ) - (s : ℝ) ≤ L) :
      (T.card : ℝ) ≤ 34 + 35 * (1 + L) := by
    apply count_of_diameter L hL
    intro s hs t ht hrank
    rcases lt_trichotomy (s : ℝ) (t : ℝ) with hst | hst | hst
    · have hlen := hforward s hs t ht hst hrank
      rw [abs_of_nonpos (by linarith : (s : ℝ) - (t : ℝ) ≤ 0)]
      linarith
    · simpa [hst] using hL
    · have hlen := hforward t ht s hs hst hrank.symm
      rw [abs_of_nonneg (by linarith : (s : ℝ) - (t : ℝ) ≥ 0)]
      exact hlen
  constructor
  · intro hH hlam hZmin hlarge1 hlarge2
    have hHpos : 0 < H := by
      rw [hH]
      have hZpos : 0 < Zmin := by linarith
      have hgamlam : γ * lam ≠ 0 := mul_ne_zero hγ hlam
      have habs : 0 < |γ * lam| := abs_pos.mpr hgamlam
      positivity
    have hL : 0 ≤ x / (2 * H) := by positivity
    apply branch_diameter (x / (2 * H)) hL
    intro s hs t ht hst hrank
    obtain ⟨hsT, hsnc⟩ := Finset.mem_filter.mp hs
    obtain ⟨htT, htnc⟩ := Finset.mem_filter.mp ht
    have hZreal := hphysical s hsT t htT hst hrank hsnc htnc
    have hlen := original_regime_I_real_diameter
      κ lam z₀ γ x Zmin s t hx hγ hlam
      hZmin hlarge1 hlarge2 hst
      (by simpa only [cuts, hH] using hrank)
      (by simpa only [cuts, hH] using hsnc)
      (by simpa only [cuts, hH] using htnc)
      (hheight s hsT) (hheight t htT) hZreal
    simpa only [hH] using hlen
  · intro hH hZmin hlarge
    have hHpos : 0 < H := by
      rw [hH]
      have hZpos : 0 < Zmin := by linarith
      positivity
    have hL : 0 ≤
        max (x / (2 * H))
          (2 * H / (30 * γ ^ 2 * Zmin ^ 5)) := by
      exact le_trans (by positivity : 0 ≤ x / (2 * H))
        (le_max_left _ _)
    apply branch_diameter
      (max (x / (2 * H))
        (2 * H / (30 * γ ^ 2 * Zmin ^ 5))) hL
    intro s hs t ht hst hrank
    obtain ⟨hsT, hsnc⟩ := Finset.mem_filter.mp hs
    obtain ⟨htT, htnc⟩ := Finset.mem_filter.mp ht
    have hZreal := hphysical s hsT t htT hst hrank hsnc htnc
    have hlen := original_regime_II_real_diameter
      κ lam z₀ γ x H Zmin s t hx hγ
      hZmin hlarge hH hst
      hrank hsnc htnc
      (hheight s hsT) (hheight t htT) hZreal
    exact hlen

end A7PureNineSignedLevel

