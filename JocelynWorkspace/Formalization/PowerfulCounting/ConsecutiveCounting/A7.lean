def originalPopulation (x D E : ℝ) : Set OriginalPoint :=
  {z | (∀ i : Fin 4, 0 < z i) ∧
    D / 2 < (z 0 : ℝ) ∧ (z 0 : ℝ) ≤ D ∧
    E / 2 < (z 1 : ℝ) ∧ (z 1 : ℝ) ≤ E ∧
    x / 2 < (z 0 : ℝ) ^ 3 * (z 2 : ℝ) ∧
    (z 0 : ℝ) ^ 3 * (z 2 : ℝ) ≤ x ∧
    (z 1 : ℤ) ^ 3 * (z 3 : ℤ) - (z 0 : ℤ) ^ 3 * (z 2 : ℤ) = 1}

def sourceCell (x D E : ℝ) (M j : ℕ) : Set OriginalPoint :=
  {z | z ∈ originalPopulation x D E ∧
    rho D E M j < (z 0 : ℝ) / (z 1 : ℝ) ∧
    (z 0 : ℝ) / (z 1 : ℝ) ≤ rho D E M j * (1 + 1 / (M : ℝ))}

lemma norm_agree (A B : ℝ) (M : ℕ) (s : ℝ) :
    reciprocalShortestNorm A B (M : ℝ) s = JointSecondMoments.ell A B M s := by
  change (1 / sInf {r : ℝ | ∃ z : Fin 2 → ℤ, z ≠ 0 ∧
    Real.sqrt ((((M : ℝ) / A) * ((z 0 : ℝ) - s * (z 1 : ℝ))) ^ 2 +
      ((z 1 : ℝ) / B) ^ 2) = r}) =
    1 / sInf {r : ℝ | ∃ p q : ℤ, (p ≠ 0 ∨ q ≠ 0) ∧
      Real.sqrt ((((M : ℝ) / A) * ((p : ℝ) - s * (q : ℝ))) ^ 2 +
        ((q : ℝ) / B) ^ 2) = r}
  congr 2
  ext r
  constructor
  · rintro ⟨z, hz, hzr⟩
    refine ⟨z 0, z 1, ?_, hzr⟩
    by_cases h0 : z 0 = 0
    · right
      intro h1
      apply hz
      funext i
      fin_cases i <;> simp [h0, h1]
    · exact Or.inl h0
  · rintro ⟨p, q, hpq, hpqr⟩
    refine ⟨![p,q], ?_, ?_⟩
    · intro hz
      rcases hpq with hp | hq
      · apply hp
        have hh := congrArg (fun z : Fin 2 → ℤ => z 0) hz
        simpa using hh
      · apply hq
        have hh := congrArg (fun z : Fin 2 → ℤ => z 1) hz
        simpa using hh
    · simpa using hpqr

lemma U_agree (A x : ℝ) (hA : 0 < A) :
    JointSecondMoments.U A x = U A x := by
  change x * A ^ (-(3 : ℝ)) = x / A ^ (3 : ℕ)
  rw [Real.rpow_neg hA.le]
  norm_num
  ring

lemma V_agree (A x : ℝ) (hA : 0 < A) :
    JointSecondMoments.V A x = V A x := by
  exact U_agree A x hA

lemma ratio_bounds (x D E : ℝ) (hD : 0 < D) (hE : 0 < E)
    (z : OriginalPoint) (hz : z ∈ originalPopulation x D E) :
    D / (2 * E) < (z 0 : ℝ) / (z 1 : ℝ) ∧
      (z 0 : ℝ) / (z 1 : ℝ) < 2 * D / E := by
  obtain ⟨hp, hdlo, hdhi, helo, hehi, hnlo, hnhi, hunit⟩ := hz
  have he : (0 : ℝ) < z 1 := by exact_mod_cast hp 1
  constructor
  · apply (div_lt_div_iff₀ (by positivity : 0 < 2 * E) he).2
    calc
      D * (z 1 : ℝ) ≤ D * E := mul_le_mul_of_nonneg_left hehi hD.le
      _ < (2 * (z 0 : ℝ)) * E :=
        mul_lt_mul_of_pos_right (by linarith) hE
      _ = (z 0 : ℝ) * (2 * E) := by ring
  · apply (div_lt_div_iff₀ he hE).2
    calc
      (z 0 : ℝ) * E ≤ D * E := mul_le_mul_of_nonneg_right hdhi hE.le
      _ < D * (2 * (z 1 : ℝ)) :=
        mul_lt_mul_of_pos_left (by linarith) hD
      _ = (2 * D) * (z 1 : ℝ) := by ring

lemma matrixBound_mono (P : IntegerMatrix) {H H' : ℝ}
    (hP : matrixBound P H) (hH : H ≤ H') : matrixBound P H' := by
  intro i j
  exact (hP i j).trans hH

