private theorem original_shared_signed_parameter_image
    (Spts : Finset A7PureNineOriginalCount.Point)
    (a b A B m t₀ h : ℤ) (f g : Polynomial ℤ)
    (hm : m ≠ 0)
    (hcert : ∀ p ∈ Spts, ∃ y : ℤ,
      (p.1.1 : ℤ) = A * m + b * (t₀ + h * y) ∧
      (p.1.2 : ℤ) = B * m - a * (t₀ + h * y) ∧
      f.eval y = m ^ 9 * (p.2.2 : ℤ) ∧
      g.eval y = m ^ 9 * (p.2.1 : ℤ)) :
    ∃ T : Finset ℤ, T.card = Spts.card ∧
      ∀ y ∈ T, ∃ p ∈ Spts,
        (p.1.1 : ℤ) = A * m + b * (t₀ + h * y) ∧
        (p.1.2 : ℤ) = B * m - a * (t₀ + h * y) ∧
        f.eval y = m ^ 9 * (p.2.2 : ℤ) ∧
        g.eval y = m ^ 9 * (p.2.1 : ℤ) := by
  classical
  let cert (p : {q // q ∈ Spts}) : ∃ y : ℤ,
      (p.1.1.1 : ℤ) = A * m + b * (t₀ + h * y) ∧
      (p.1.1.2 : ℤ) = B * m - a * (t₀ + h * y) ∧
      f.eval y = m ^ 9 * (p.1.2.2 : ℤ) ∧
      g.eval y = m ^ 9 * (p.1.2.1 : ℤ) :=
    hcert p.1 p.2
  let param (p : {q // q ∈ Spts}) : ℤ := Classical.choose (cert p)
  have hparam_cert (p : {q // q ∈ Spts}) :
      (p.1.1.1 : ℤ) = A * m + b * (t₀ + h * param p) ∧
      (p.1.1.2 : ℤ) = B * m - a * (t₀ + h * param p) ∧
      f.eval (param p) = m ^ 9 * (p.1.2.2 : ℤ) ∧
      g.eval (param p) = m ^ 9 * (p.1.2.1 : ℤ) :=
    Classical.choose_spec (cert p)
  have hparam : Function.Injective param := by
    intro p p' heq
    obtain ⟨hdp, hep, hfp, hgp⟩ := hparam_cert p
    obtain ⟨hdp', hep', hfp', hgp'⟩ := hparam_cert p'
    have hdd : (p.1.1.1 : ℤ) = (p'.1.1.1 : ℤ) := by
      rw [hdp, hdp', heq]
    have hee : (p.1.1.2 : ℤ) = (p'.1.1.2 : ℤ) := by
      rw [hep, hep', heq]
    have huu : (p.1.2.1 : ℤ) = (p'.1.2.1 : ℤ) := by
      apply mul_left_cancel₀ (pow_ne_zero 9 hm)
      calc
        m ^ 9 * (p.1.2.1 : ℤ) =
          g.eval (param p) := hgp.symm
        _ = g.eval (param p') := by rw [heq]
        _ = m ^ 9 * (p'.1.2.1 : ℤ) := hgp'
    have hvv : (p.1.2.2 : ℤ) = (p'.1.2.2 : ℤ) := by
      apply mul_left_cancel₀ (pow_ne_zero 9 hm)
      calc
        m ^ 9 * (p.1.2.2 : ℤ) =
          f.eval (param p) := hfp.symm
        _ = f.eval (param p') := by rw [heq]
        _ = m ^ 9 * (p'.1.2.2 : ℤ) := hfp'
    apply Subtype.ext
    apply Prod.ext
    · apply Prod.ext
      · exact_mod_cast hdd
      · exact_mod_cast hee
    · apply Prod.ext
      · exact_mod_cast huu
      · exact_mod_cast hvv
  let T : Finset ℤ := Spts.attach.image param
  have hcard : T.card = Spts.card := by
    simpa [T] using Finset.card_image_of_injective Spts.attach hparam
  refine ⟨T, hcard, ?_⟩
  intro y hy
  obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hy
  obtain ⟨hd, he, hf, hg⟩ := hparam_cert p
  exact ⟨p.1, p.2, hd, he, hf, hg⟩

