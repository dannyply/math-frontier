  have hX0 : 8≤X0 := (le_max_left 8 Ch).trans (le_max_right Xa (max 8 Ch))
  refine ⟨menu,hmenune,hmenu,K,X0,hK,hX0,?_⟩
  intro ε hε
  let η : ℝ := ε/2
  have hη : 0<η := by dsimp [η]; linarith only [hε]
  obtain ⟨Cm,Xm,hCm,hXm,hmom⟩ := A7QuarticMoments.main δ hδ hδmax η hη
  let Ccell : ℝ := 2 * |c| * (4*(N : ℝ))^3*(10/η+4*(N : ℝ))
  let C : ℝ := 1+10*(N : ℝ)*Ccell*(1+256*Cm)
  let X1 : ℝ := max X0 (max Xm ((2 : ℝ)^(100 : ℕ)))
  have hCcell : 0≤Ccell := by dsimp [Ccell]; positivity
  have hC : 0<C := by dsimp [C]; positivity
  refine ⟨C,X1,hC,le_max_left _ _,?_⟩
  intro x hx s hs hs' D E hD hE hDE
  let M : ℕ := ⌈x^(A7QuarticCore.mBase s+δ)⌉₊
  let U : ℝ := x/D^4
  let V : ℝ := x/E^4
  let RD : ℝ := D*E+(D^2+E^2)/(M : ℝ)
  let RU : ℝ := U*V+(U^2+V^2)/(M : ℝ)
  have hxX0 : X0≤x := (le_max_left X0 (max Xm ((2 : ℝ)^(100 : ℕ)))).trans hx
  have hxXa : Xa≤x := (le_max_left Xa (max 8 Ch)).trans hxX0
  have hxCh : Ch≤x := (le_max_right 8 Ch).trans
    ((le_max_right Xa (max 8 Ch)).trans hxX0)
  have hxXm : Xm≤x := (le_max_left Xm ((2 : ℝ)^(100 : ℕ))).trans
    ((le_max_right X0 (max Xm ((2 : ℝ)^(100 : ℕ)))).trans hx)
  have hxLarge : (2 : ℝ)^(100 : ℕ)≤x :=
    (le_max_right Xm ((2 : ℝ)^(100 : ℕ))).trans
      ((le_max_right X0 (max Xm ((2 : ℝ)^(100 : ℕ)))).trans hx)
  have hx16384 : (16384 : ℝ)≤x :=
    (by norm_num : (16384 : ℝ)≤(2 : ℝ)^(100 : ℕ)).trans hxLarge
  have hx8 : 8≤x := by linarith only [hx16384]
  have hx0 : 0<x := by linarith only [hx8]
  have hx1 : 1≤x := by linarith only [hx8]
  have hxgt : 1<x := by linarith only [hx8]
  have hηx : 1≤x^η := Real.one_le_rpow hx1 hη.le
  have hηx0 : 0≤x^η := Real.rpow_nonneg hx0.le _
  obtain ⟨ab,hab,hXaData⟩ := haux x hxXa s hs hs' D E hD hE hDE
  have habN : ab.1+ab.2≤N := hmenuN ab hab
  obtain ⟨hM,hMpow,hMD,hMV⟩ :=
    A7QuarticMoments.mesh_area_bounds δ x s D E hδ hδmax hxLarge hs hs' hD hE hDE
  change 1≤M at hM
  change (M : ℝ)≤x^((7 : ℝ)/25) at hMpow
  have hM1 : (1 : ℝ)≤M := by exact_mod_cast hM
  have hM0 : (0 : ℝ)<M := by linarith only [hM1]
  have hMx : (M : ℝ)≤x := hMpow.trans (by
    have ht := Real.rpow_le_rpow_of_exponent_le hx1 (by norm_num : (7/25 : ℝ)≤1)
