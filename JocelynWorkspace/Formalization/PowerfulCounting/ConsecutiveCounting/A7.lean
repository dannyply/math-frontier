    E / 2 < (z 1 : ℝ) ∧ (z 1 : ℝ) ≤ E ∧
    x / 2 < (z 0 : ℝ) ^ 3 * (z 2 : ℝ) ∧
    (z 0 : ℝ) ^ 3 * (z 2 : ℝ) ≤ x ∧
    (z 1 : ℤ) ^ 3 * (z 3 : ℤ) -
      (z 0 : ℤ) ^ 3 * (z 2 : ℤ) = 1 ∧
    |(z 0 : ℝ) / (z 1 : ℝ) - rho| ≤
      Ccell * D / (E * (M : ℝ))}

def wholeStatement : Prop :=
  ∀ Ccell : ℝ, 0 < Ccell →
    ∃ C : ℝ, 0 < C ∧
      ∀ x D E : ℝ, ∀ M : ℕ, ∀ rho : ℝ,
        2 ≤ x → 0 < D → 0 < E → 1 ≤ M → (M : ℝ) ≤ x →
        D / (2 * E) ≤ rho → rho ≤ 2 * D / E →
        let U : ℝ := x / D ^ 3
        let V : ℝ := x / E ^ 3
        let S := originalCell Ccell x D E M rho
        let ellD := reciprocalShortestNorm D E (M : ℝ) rho
        let ellT := reciprocalShortestNorm V U (M : ℝ) (rho ^ 3)
        S.Nonempty →
          ∃ Pd Ad Pt At : IntegerMatrix,
            Ad * Pd = 1 ∧ Pd * Ad = 1 ∧
            At * Pt = 1 ∧ Pt * At = 1 ∧
            matrixBound Pd (C * (M : ℝ) * max D E) ∧
            matrixBound Ad (C * (M : ℝ) * max D E) ∧
            matrixBound Pt (C * (M : ℝ) * max U V) ∧
            matrixBound At (C * (M : ℝ) * max U V) ∧
            ∀ z : OriginalPoint, z ∈ S →
              (∀ i : Fin 2,
                |((Ad.mulVec ![(z 0 : ℤ), (z 1 : ℤ)] i : ℤ) : ℝ)| ≤
                  C * ellD) ∧
              (∀ i : Fin 2,
                |((At.mulVec ![(z 3 : ℤ), (z 2 : ℤ)] i : ℤ) : ℝ)| ≤
                  C * ellT)

end
end A6PhysicalFrameDraftV1

namespace A6PhysicalFrameProofV1
open A6PhysicalFrameDraftV1

set_option maxHeartbeats 200000

private lemma cube_lipschitz (a b R : ℝ)
    (ha : 0 ≤ a) (hb : 0 ≤ b) (haR : a ≤ R) (hbR : b ≤ R) :
    |a ^ 3 - b ^ 3| ≤ 3 * R ^ 2 * |a - b| := by
  have hR : 0 ≤ R := ha.trans haR
  have ha2 : a ^ 2 ≤ R ^ 2 := pow_le_pow_left₀ ha haR 2
  have hb2 : b ^ 2 ≤ R ^ 2 := pow_le_pow_left₀ hb hbR 2
  have hab : a * b ≤ R ^ 2 := by
    simpa [pow_two] using mul_le_mul haR hbR hb hR
  have hq : 0 ≤ a ^ 2 + a * b + b ^ 2 := by positivity
  have hqR : a ^ 2 + a * b + b ^ 2 ≤ 3 * R ^ 2 := by
    linarith only [ha2,hb2,hab]
  rw [show a ^ 3 - b ^ 3 = (a ^ 2 + a * b + b ^ 2) * (a-b) by ring,
    abs_mul, abs_of_nonneg hq]
  exact mul_le_mul_of_nonneg_right hqR (abs_nonneg _)

private lemma uv_bounds (x D E d e u v : ℝ)
    (hx : 2 ≤ x) (hD : 0 < D) (hE : 0 < E)
    (hd : 0 < d) (he : 0 < e) (hu : 0 ≤ u) (hv : 0 ≤ v)
    (hdlow : D/2 < d) (helow : E/2 < e)
    (hn : d^3*u ≤ x) (hunit : e^3*v-d^3*u=1) :
    u ≤ 8*(x/D^3) ∧ v ≤ 12*(x/E^3) := by
  have hD3 : 0 < D^3 := pow_pos hD 3
  have hE3 : 0 < E^3 := pow_pos hE 3
  have hdc : D^3 ≤ 8*d^3 := by
    have hh : D ≤ 2*d := by linarith only [hdlow]
    have hp := pow_le_pow_left₀ hD.le hh 3
    nlinarith only [hp]
  have hec : E^3 ≤ 8*e^3 := by
    have hh : E ≤ 2*e := by linarith only [helow]
    have hp := pow_le_pow_left₀ hE.le hh 3
    nlinarith only [hp]
  constructor
  · rw [show 8*(x/D^3)=(8*x)/D^3 by ring]
    apply (le_div_iff₀ hD3).2
    calc
      u*D^3 ≤ u*(8*d^3) := mul_le_mul_of_nonneg_left hdc hu
      _ ≤ 8*x := by nlinarith only [hn]
  · rw [show 12*(x/E^3)=(12*x)/E^3 by ring]
    apply (le_div_iff₀ hE3).2
    calc
      v*E^3 ≤ v*(8*e^3) := mul_le_mul_of_nonneg_left hec hv
      _ ≤ 12*x := by nlinarith only [hn,hunit,hx]

private lemma divisor_strip (Ccell D E m rho d e : ℝ)
    (hC : 0 < Ccell) (hD : 0 < D) (hE : 0 < E)
    (hm : 0 < m) (he : 0 < e) (heup : e ≤ E)
    (hcell : |d/e-rho| ≤ Ccell*D/(E*m)) :
    |d-rho*e| ≤ Ccell*D/m := by
  have heq : |d-rho*e| = |d/e-rho| *e := by
    have hs : d-rho*e = (d/e-rho)*e := by
      field_simp [he.ne'] <;> ring
    rw [hs,abs_mul,abs_of_pos he]
  calc
    |d-rho*e| = |d/e-rho| *e := heq
    _ ≤ (Ccell*D/(E*m))*e :=
      mul_le_mul_of_nonneg_right hcell he.le
    _ ≤ (Ccell*D/(E*m))*E :=
      mul_le_mul_of_nonneg_left heup (by positivity)
    _ = Ccell*D/m := by field_simp [hE.ne',hm.ne'] <;> ring

private lemma cofactor_strip (Ccell x D E m rho d e u v : ℝ)
    (hC : 0 < Ccell) (hx : 2 ≤ x) (hD : 0 < D) (hE : 0 < E)
    (hm : 0 < m) (hMx : m ≤ x) (hd : 0 < d) (he : 0 < e)
    (hu : 0 ≤ u) (hdup : d ≤ D) (helow : E/2 < e)
    (hrho0 : 0 ≤ rho) (hrho : rho ≤ 2*D/E)
    (hub : u ≤ 8*(x/D^3))
    (hunit : e^3*v-d^3*u=1)
    (hcell : |d/e-rho| ≤ Ccell*D/(E*m)) :
    |v-rho^3*u| ≤ (96*Ccell+8)*(x/E^3)/m := by
  have hx0 : 0 < x := by linarith only [hx]
  have hE3 : 0 < E^3 := pow_pos hE 3
  have he3 : 0 < e^3 := pow_pos he 3
  have hD3 : 0 < D^3 := pow_pos hD 3
  have hratio : d/e ≤ 2*D/E := by
    apply (div_le_div_iff₀ he hE).2
    have hh : E ≤ 2*e := by linarith only [helow]
    calc
      d*E ≤ D*E := mul_le_mul_of_nonneg_right hdup hE.le
      _ ≤ D*(2*e) := mul_le_mul_of_nonneg_left hh hD.le
      _ = (2*D)*e := by ring
  have hcubic := cube_lipschitz (d/e) rho (2*D/E)
    (div_pos hd he).le hrho0 hratio hrho
  have hcurve : |(d/e)^3-rho^3| ≤ 12*Ccell*D^3/(E^3*m) := by
    calc
      _ ≤ (3*(2*D/E)^2)*|d/e-rho| := hcubic
      _ ≤ (3*(2*D/E)^2)*(Ccell*D/(E*m)) :=
        mul_le_mul_of_nonneg_left hcell (by positivity)
      _ = _ := by field_simp [hE.ne',hm.ne']; ring
  have hid : v-rho^3*u = ((d/e)^3-rho^3)*u+1/e^3 := by
    field_simp [he.ne']
    nlinarith only [hunit]
  have hfirst : |(d/e)^3-rho^3| *u ≤ 96*Ccell*(x/E^3)/m := by
    calc
      _ ≤ (12*Ccell*D^3/(E^3*m))*u :=
        mul_le_mul_of_nonneg_right hcurve hu
      _ ≤ (12*Ccell*D^3/(E^3*m))*(8*(x/D^3)) :=
        mul_le_mul_of_nonneg_left hub (by positivity)
      _ = _ := by field_simp [hD.ne',hE.ne',hm.ne']; ring
  have hec : E^3 ≤ 8*e^3 := by
    have hh : E ≤ 2*e := by linarith only [helow]
    have hp := pow_le_pow_left₀ hE.le hh 3
    nlinarith only [hp]
  have herr : 1/e^3 ≤ 8*(x/E^3)/m := by
    rw [show 8*(x/E^3)/m=(8*x)/(E^3*m) by ring]
    apply (div_le_div_iff₀ he3 (mul_pos hE3 hm)).2
    calc
      1*(E^3*m) = m*E^3 := by ring
      _ ≤ x*E^3 := mul_le_mul_of_nonneg_right hMx hE3.le
      _ ≤ x*(8*e^3) := mul_le_mul_of_nonneg_left hec hx0.le
      _ = (8*x)*e^3 := by ring
  calc
    |v-rho^3*u| = |((d/e)^3-rho^3)*u+1/e^3| := by rw [hid]
    _ ≤ |((d/e)^3-rho^3)*u|+|1/e^3| := abs_add_le _ _
    _ = |(d/e)^3-rho^3| *u+1/e^3 := by
      rw [abs_mul,abs_of_nonneg hu,abs_of_pos (one_div_pos.mpr he3)]
    _ ≤ 96*Ccell*(x/E^3)/m+8*(x/E^3)/m := add_le_add hfirst herr
    _ = _ := by ring

private lemma generic_norm_eq (D E m s : ℝ)
    (z : A6ActualTriangularLatticeFrameStatement.IntegerPoint) :
    A6ActualTriangularLatticeFrameStatement.euclideanNorm
      (A6ActualTriangularLatticeFrameStatement.transformedPoint D E m s z) =
      Real.sqrt (((m/D)*((z 0:ℝ)-s*(z 1:ℝ)))^2+((z 1:ℝ)/E)^2) := by
  unfold A6ActualTriangularLatticeFrameStatement.euclideanNorm
    A6ActualTriangularLatticeFrameStatement.transformedPoint
    A6ActualTriangularLatticeFrameStatement.triangularMatrix
    A6ActualTriangularLatticeFrameStatement.integerEmbedding
  congr 1
  simp only [Matrix.mulVec,dotProduct,Fin.sum_univ_two,
    Matrix.cons_val_zero,Matrix.cons_val_one,zero_mul,zero_add]
  ring

private lemma ell_agree (D E m s : ℝ) :
    reciprocalShortestNorm D E m s =
      A6ActualTriangularLatticeFrameStatement.reciprocalShortestNorm D E m s := by
  unfold reciprocalShortestNorm
    A6ActualTriangularLatticeFrameStatement.reciprocalShortestNorm
    A6ActualTriangularLatticeFrameStatement.shortestNorm
    A6ActualTriangularLatticeFrameStatement.nonzeroLatticeNorms
  congr 2
  ext r
  constructor
  · rintro ⟨z,hz,hr⟩
    exact ⟨z,hz,(generic_norm_eq D E m s z).trans hr⟩
  · rintro ⟨z,hz,hr⟩
    exact ⟨z,hz,(generic_norm_eq D E m s z).symm.trans hr⟩

private lemma norm_scale (D E m s : ℝ) (hD : 0 < D) (hE : 0 < E)
    (z : A6ActualTriangularLatticeFrameStatement.IntegerPoint) :
    A6ActualTriangularLatticeFrameStatement.euclideanNorm
      (A6ActualTriangularLatticeFrameStatement.transformedPoint (12*D) (12*E) m s z) =
    A6ActualTriangularLatticeFrameStatement.euclideanNorm
      (A6ActualTriangularLatticeFrameStatement.transformedPoint D E m s z)/12 := by
  rw [generic_norm_eq,generic_norm_eq]
  have he : ((m/(12*D))*((z 0:ℝ)-s*(z 1:ℝ)))^2+((z 1:ℝ)/(12*E))^2 =
      (((m/D)*((z 0:ℝ)-s*(z 1:ℝ)))^2+((z 1:ℝ)/E)^2)/(12:ℝ)^2 := by
    field_simp [hD.ne',hE.ne'] <;> ring
  rw [he,Real.sqrt_div (by positivity)]
  norm_num

private lemma ell_scale (D E m s : ℝ) (hD : 0 < D) (hE : 0 < E) :
    reciprocalShortestNorm (12*D) (12*E) m s =
      12*reciprocalShortestNorm D E m s := by
  rw [ell_agree,ell_agree]
  let N := A6ActualTriangularLatticeFrameStatement.nonzeroLatticeNorms D E m s
  let Ns := A6ActualTriangularLatticeFrameStatement.nonzeroLatticeNorms (12*D) (12*E) m s
  have hne (A B : ℝ) :
      (A6ActualTriangularLatticeFrameStatement.nonzeroLatticeNorms A B m s).Nonempty := by
    refine ⟨_,![1,0],?_,rfl⟩
    intro hh
    have hh0 := congrArg (fun z : Fin 2 → ℤ => z 0) hh
    norm_num at hh0
  have hbd (A B : ℝ) :
      BddBelow (A6ActualTriangularLatticeFrameStatement.nonzeroLatticeNorms A B m s) := by
    refine ⟨0,?_⟩
    rintro r ⟨z,hz,rfl⟩
    exact Real.sqrt_nonneg _
  have h1 : 12*sInf Ns ≤ sInf N := by
    apply le_csInf (hne D E)
    rintro r ⟨z,hz,rfl⟩
    have hh := csInf_le (hbd (12*D) (12*E)) ⟨z,hz,rfl⟩
    rw [norm_scale D E m s hD hE] at hh
    linarith only [hh]
  have h2 : sInf N/12 ≤ sInf Ns := by
    apply le_csInf (hne (12*D) (12*E))
    rintro r ⟨z,hz,rfl⟩
    have hh := csInf_le (hbd D E) ⟨z,hz,rfl⟩
    rw [norm_scale D E m s hD hE]
    linarith only [hh]
  have hs : sInf Ns = sInf N/12 := by linarith only [h1,h2]
  change 1/sInf Ns = 12*(1/sInf N)
  rw [hs,div_div_eq_mul_div]
  ring

theorem main : A6PhysicalFrameDraftV1.wholeStatement := by
  intro Ccell hCcell
  let c0 : ℝ := 12+96*Ccell
  have hc0 : 1 ≤ c0 := by dsimp [c0]; linarith only [hCcell]
  obtain ⟨Cf,hCf,hframe⟩ :=
    A6ActualTriangularLatticeFrameStatement.frame_main c0 hc0
  refine ⟨12*Cf,by positivity,?_⟩
  intro x D E M rho hx hD hE hM hMx hrhol hrhou
  dsimp only
  intro hS
  have hm1 : (1:ℝ) ≤ M := by exact_mod_cast hM
  have hm : 0 < (M:ℝ) := by linarith only [hm1]
  have hx0 : 0 < x := by linarith only [hx]
  have hU : 0 < x/D^3 := div_pos hx0 (pow_pos hD 3)
  have hV : 0 < x/E^3 := div_pos hx0 (pow_pos hE 3)
  have hrho : 0 < rho := lt_of_lt_of_le (div_pos hD (by positivity)) hrhol
  have unpack (z : OriginalPoint) (hz : z ∈ originalCell Ccell x D E M rho) :
      1 ≤ D ∧ 1 ≤ E ∧
      (z 2:ℝ) ≤ 8*(x/D^3) ∧ (z 3:ℝ) ≤ 12*(x/E^3) ∧
      |(z 0:ℝ)-rho*(z 1:ℝ)| ≤ Ccell*D/(M:ℝ) ∧
      |(z 3:ℝ)-rho^3*(z 2:ℝ)| ≤ (96*Ccell+8)*(x/E^3)/(M:ℝ) := by
    obtain ⟨hpos,hdlo,hdhi,helo,hehi,hnlo,hnhi,hunit,hcell⟩ := hz
    have hp (i : Fin 4) : 0 < (z i:ℝ) := by exact_mod_cast hpos i
    have hp1 (i : Fin 4) : (1:ℝ) ≤ z i := by
      have hh : 1 ≤ z i := hpos i
      exact_mod_cast hh
    have hunitR : (z 1:ℝ)^3*(z 3:ℝ)-(z 0:ℝ)^3*(z 2:ℝ)=1 := by
      exact_mod_cast hunit
    obtain ⟨hub,hvb⟩ := uv_bounds x D E (z 0) (z 1) (z 2) (z 3)
      hx hD hE (hp 0) (hp 1) (hp 2).le (hp 3).le hdlo helo hnhi hunitR
    refine ⟨(hp1 0).trans hdhi,(hp1 1).trans hehi,hub,hvb,?_,?_⟩
    · exact divisor_strip Ccell D E M rho (z 0) (z 1)
        hCcell hD hE hm (hp 1) hehi hcell
    · exact cofactor_strip Ccell x D E M rho (z 0) (z 1) (z 2) (z 3)
        hCcell hx hD hE hm hMx (hp 0) (hp 1) (hp 2).le hdhi helo
        hrho.le hrhou hub hunitR hcell
  obtain ⟨z0,hz0⟩ := hS
  obtain ⟨hD1,hE1,hu0,hv0,_,_⟩ := unpack z0 hz0
  have hp01 (i : Fin 4) : (1:ℝ) ≤ z0 i := by
    have hh : 1 ≤ z0 i := hz0.1 i
    exact_mod_cast hh
  have h12U : 1 ≤ 12*(x/D^3) := by
    have hh := hp01 2
    nlinarith only [hu0,hh,hU]
  have h12V : 1 ≤ 12*(x/E^3) := (hp01 3).trans hv0
  have hsD : |rho| ≤ c0*D/E := by
    rw [abs_of_pos hrho]
    calc
      rho ≤ 2*D/E := hrhou
      _ ≤ c0*D/E := by
        apply div_le_div_of_nonneg_right _ hE.le
        exact mul_le_mul_of_nonneg_right (by dsimp [c0]; linarith only [hCcell]) hD.le
  have hsT : |rho^3| ≤ c0*(12*(x/E^3))/(12*(x/D^3)) := by
    rw [abs_of_nonneg (pow_nonneg hrho.le 3)]
    have hp := pow_le_pow_left₀ hrho.le hrhou 3
    have heq : c0*(12*(x/E^3))/(12*(x/D^3)) = c0*D^3/E^3 := by
      field_simp [hD.ne',hE.ne',hx0.ne'] <;> ring
    rw [heq]
    calc
      rho^3 ≤ (2*D/E)^3 := hp
      _ = 8*D^3/E^3 := by ring
      _ ≤ c0*D^3/E^3 := by
        apply div_le_div_of_nonneg_right _ (pow_nonneg hE.le 3)
        exact mul_le_mul_of_nonneg_right (by dsimp [c0]; linarith only [hCcell])
          (pow_nonneg hD.le 3)
  obtain ⟨_,hellD,_,Pd,Ad,hAPd,hPAd,hPd,hAd,hcoordD⟩ :=
    hframe D E M rho hD1 hE1 hm1 hsD
  obtain ⟨_,hellT,_,Pt,At,hAPt,hPAt,hPt,hAt,hcoordT⟩ :=
    hframe (12*(x/E^3)) (12*(x/D^3)) M (rho^3) h12V h12U hm1 hsT
  have hmax : max (12*(x/E^3)) (12*(x/D^3)) = 12*max (x/D^3) (x/E^3) := by
    rw [← mul_max_of_nonneg _ _ (by norm_num : (0:ℝ) ≤ 12),max_comm]
  have hCff : Cf ≤ 12*Cf := by linarith only [hCf]
  have hboundD (P : IntegerMatrix)
      (hP : A6ActualTriangularLatticeFrameStatement.integerMatrixBound P (Cf*M*max D E)) :
      matrixBound P (12*Cf*M*max D E) := by
    intro i j
    exact (hP i j).trans (mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_right hCff hm.le) (le_max_of_le_left hD.le))
  have hboundT (P : IntegerMatrix)
      (hP : A6ActualTriangularLatticeFrameStatement.integerMatrixBound P
        (Cf*M*max (12*(x/E^3)) (12*(x/D^3)))) :
      matrixBound P (12*Cf*M*max (x/D^3) (x/E^3)) := by
    intro i j
    have hh := hP i j
    rw [hmax] at hh
    convert hh using 1 <;> ring
  refine ⟨Pd,Ad,Pt,At,hAPd,hPAd,hAPt,hPAt,
    hboundD Pd hPd,hboundD Ad hAd,hboundT Pt hPt,hboundT At hAt,?_⟩
  intro z hz
  obtain ⟨_,_,hub,hvb,hstripD,hstripT⟩ := unpack z hz
  have hDcell :
      (![(z 0:ℤ),(z 1:ℤ)] : Fin 2 → ℤ) ∈
        A6ActualTriangularLatticeFrameStatement.physicalCell c0 D E M rho := by
    obtain ⟨hpos,hdlo,hdhi,helo,hehi,hnlo,hnhi,hunit,hcell⟩ := hz
    constructor
    · change |(z 0:ℝ)-rho*(z 1:ℝ)| ≤ c0*D/(M:ℝ)
      exact hstripD.trans (div_le_div_of_nonneg_right
        (mul_le_mul_of_nonneg_right (by dsimp [c0]; linarith only [hCcell]) hD.le) hm.le)
    · change |(z 1:ℝ)| ≤ c0*E
      rw [abs_of_nonneg (Nat.cast_nonneg _)]
      exact hehi.trans (by nlinarith only [hc0,hE])
  have hTcell :
      (![(z 3:ℤ),(z 2:ℤ)] : Fin 2 → ℤ) ∈
        A6ActualTriangularLatticeFrameStatement.physicalCell c0
          (12*(x/E^3)) (12*(x/D^3)) M (rho^3) := by
    constructor
    · change |(z 3:ℝ)-rho^3*(z 2:ℝ)| ≤ c0*(12*(x/E^3))/(M:ℝ)
      apply hstripT.trans
      apply div_le_div_of_nonneg_right _ hm.le
      have hh : 96*Ccell+8 ≤ c0*12 := by dsimp [c0]; linarith only [hCcell]
      nlinarith only [mul_le_mul_of_nonneg_right hh hV.le]
    · change |(z 2:ℝ)| ≤ c0*(12*(x/D^3))
      rw [abs_of_nonneg (Nat.cast_nonneg _)]
      apply hub.trans
      have hh : 8 ≤ c0*12 := by linarith only [hc0]
      nlinarith only [mul_le_mul_of_nonneg_right hh hU.le]
  constructor
  · intro i
    have hh := hcoordD ![(z 0:ℤ),(z 1:ℤ)] hDcell i
    change |((Ad.mulVec ![(z 0:ℤ),(z 1:ℤ)] i : ℤ):ℝ)| ≤ _
    rw [← ell_agree] at hh hellD
    exact hh.trans (mul_le_mul_of_nonneg_right hCff hellD.le)
  · intro i
    have hh := hcoordT ![(z 3:ℤ),(z 2:ℤ)] hTcell i
    change |((At.mulVec ![(z 3:ℤ),(z 2:ℤ)] i : ℤ):ℝ)| ≤ _
    rw [← ell_agree,ell_scale (x/E^3) (x/D^3) M (rho^3) hV hU] at hh
    have heq : Cf*(12*reciprocalShortestNorm (x/E^3) (x/D^3) M (rho^3)) =
        12*Cf*reciprocalShortestNorm (x/E^3) (x/D^3) M (rho^3) := by ring
    rw [heq] at hh
    exact hh

end A6PhysicalFrameProofV1

theorem JocelynClaims.claim_240a96e0e17ca7d4ab97e33418e0ad87e70101d68a2175015a2e45a10f31ccd5 :
let IntegerPoint := Fin 2 → ℤ;
let IntegerMatrix := Matrix (Fin 2) (Fin 2) ℤ;
let OriginalPoint := Fin 4 → ℕ;
let reciprocalShortestNorm : ℝ → ℝ → ℝ → ℝ → ℝ :=
  fun A B m s =>
    1 / sInf {r : ℝ | ∃ z : IntegerPoint, z ≠ 0 ∧
      Real.sqrt (((m / A) * ((z 0 : ℝ) - s * (z 1 : ℝ))) ^ 2 +
        ((z 1 : ℝ) / B) ^ 2) = r};
let matrixBound : IntegerMatrix → ℝ → Prop :=
  fun P H => ∀ i j : Fin 2, |(P i j : ℝ)| ≤ H;
let originalCell : ℝ → ℝ → ℝ → ℝ → ℕ → ℝ → Set OriginalPoint :=
  fun Ccell x D E M rho =>
    {z |
      (∀ i : Fin 4, 0 < z i) ∧
      D / 2 < (z 0 : ℝ) ∧ (z 0 : ℝ) ≤ D ∧
      E / 2 < (z 1 : ℝ) ∧ (z 1 : ℝ) ≤ E ∧
      x / 2 < (z 0 : ℝ) ^ 3 * (z 2 : ℝ) ∧
      (z 0 : ℝ) ^ 3 * (z 2 : ℝ) ≤ x ∧
      (z 1 : ℤ) ^ 3 * (z 3 : ℤ) -
