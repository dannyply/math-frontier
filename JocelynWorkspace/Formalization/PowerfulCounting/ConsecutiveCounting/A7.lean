  have hnorm (z:ℝ) (hz:z∈Set.Icc s t) :
      10*T^4≤ |4*(q:ℝ)*((b:ℝ)*e.eval z-(a:ℝ)*d.eval z)-140*T^4| ∧
      W≤327680000*T^7 := by
    obtain ⟨hd,he,hp,hp',hlev,hn,hnx⟩ := hdata z hz
    apply hδspec x W (m:ℝ) T (d.eval z*e.eval z)
      ((a:ℝ)*d.eval z) ((b:ℝ)*e.eval z) (q:ℝ) (N.eval z)
      hx0 hW hmR hT hp hp' hlev
    · rw [hTeq]; ring
