theorem window_of_cell (x D E : ℝ) (M j : ℕ) (hD : 0 < D) (hE : 0 < E) (hM : 1 ≤ M)
    (hj : D / (2 * E) * (1 + 1 / (M : ℝ)) ^ j ≤ 2 * D / E)
    (z : (ℕ × ℕ) × (ℕ × ℕ))
    (hz : 1 ≤ z.1.1 ∧ 1 ≤ z.1.2 ∧ 1 ≤ z.2.1 ∧ 1 ≤ z.2.2 ∧
      ((z.1.2 ^ 4 * z.2.2 : ℕ) : ℤ) = ((z.1.1 ^ 4 * z.2.1 : ℕ) : ℤ) + 1 ∧
      x / 2 < ((z.1.1 ^ 4 * z.2.1 : ℕ) : ℝ) ∧ ((z.1.1 ^ 4 * z.2.1 : ℕ) : ℝ) ≤ x ∧
      D / 2 < (z.1.1 : ℝ) ∧ (z.1.1 : ℝ) ≤ D ∧ E / 2 < (z.1.2 : ℝ) ∧ (z.1.2 : ℝ) ≤ E ∧
      D / (2 * E) * (1 + 1 / (M : ℝ)) ^ j < (z.1.1 : ℝ) / (z.1.2 : ℝ) ∧
      (z.1.1 : ℝ) / (z.1.2 : ℝ) ≤ D / (2 * E) * (1 + 1 / (M : ℝ)) ^ j * (1 + 1 / (M : ℝ))) :
    1 ≤ z.1.1 ∧ 1 ≤ z.1.2 ∧ 1 ≤ z.2.1 ∧ 1 ≤ z.2.2 ∧ z.1.2 ^ 4 * z.2.2 = z.1.1 ^ 4 * z.2.1 + 1 ∧
      x / 2 < (z.1.1 : ℝ) ^ 4 * (z.2.1 : ℝ) ∧ (z.1.1 : ℝ) ^ 4 * (z.2.1 : ℝ) ≤ x ∧
      D / 2 < (z.1.1 : ℝ) ∧ (z.1.1 : ℝ) ≤ D ∧ E / 2 < (z.1.2 : ℝ) ∧ (z.1.2 : ℝ) ≤ E ∧
      |(z.1.1 : ℝ) / (z.1.2 : ℝ) - D / (2 * E) * (1 + 1 / (M : ℝ)) ^ j| ≤
        2 * D / (E * (M : ℝ)) := by
  obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13⟩ := hz
  refine ⟨h1, h2, h3, h4, ?_, ?_, ?_, h8, h9, h10, h11, ?_⟩
  · exact_mod_cast h5
  · have h6' := h6
    push_cast at h6'
    exact h6'
  · have h7' := h7
    push_cast at h7'
    exact h7'
  · have hMr : (1 : ℝ) ≤ (M : ℝ) := by exact_mod_cast hM
    have hM0 : (0 : ℝ) < (M : ℝ) := by linarith
    have hinv : 0 ≤ 1 / (M : ℝ) := by positivity
    have hA : (z.1.1 : ℝ) / (z.1.2 : ℝ) - D / (2 * E) * (1 + 1 / (M : ℝ)) ^ j ≤
        D / (2 * E) * (1 + 1 / (M : ℝ)) ^ j * (1 / (M : ℝ)) := by
      have e0 : D / (2 * E) * (1 + 1 / (M : ℝ)) ^ j * (1 + 1 / (M : ℝ)) =
          D / (2 * E) * (1 + 1 / (M : ℝ)) ^ j +
            D / (2 * E) * (1 + 1 / (M : ℝ)) ^ j * (1 / (M : ℝ)) := by ring
      linarith
    have hB : D / (2 * E) * (1 + 1 / (M : ℝ)) ^ j * (1 / (M : ℝ)) ≤ 2 * D / E * (1 / (M : ℝ)) :=
      mul_le_mul_of_nonneg_right hj hinv
    have hC : 2 * D / E * (1 / (M : ℝ)) = 2 * D / (E * (M : ℝ)) := by
      rw [div_mul_div_comm, mul_one]
    have hpos : 0 ≤ 2 * D / (E * (M : ℝ)) := by positivity
    rw [abs_le]
    constructor
    · linarith
    · linarith

theorem cover_count {P : Type*} (L : Set P) (k : ℕ) (ev : Fin k → P → Prop) (N : ℕ)
    (Cc xe W : ℝ) (hk : k ≤ N) (hcov : ∀ z ∈ L, ∃ i, ev i z)
    (hT : ∀ i, {z | z ∈ L ∧ ev i z}.Finite ∧
      (({z | z ∈ L ∧ ev i z}.ncard : ℕ) : ℝ) ≤ Cc * xe * W)
    (hB : 0 ≤ Cc * xe * W) :
    L.Finite ∧ ((L.ncard : ℕ) : ℝ) ≤ ((N : ℝ) + 1) * Cc * xe * W := by
  classical
  have hsub : L ⊆ ⋃ i ∈ (Finset.univ : Finset (Fin k)), {z | z ∈ L ∧ ev i z} := by
    intro z hz
    obtain ⟨i, hi⟩ := hcov z hz
    rw [Set.mem_iUnion₂]
    exact ⟨i, Finset.mem_univ i, hz, hi⟩
  obtain ⟨hfin, hcard⟩ := card_biUnion_le (fun i => {z | z ∈ L ∧ ev i z})
    (Finset.univ : Finset (Fin k)) (fun i _ => (hT i).1)
  refine ⟨hfin.subset hsub, ?_⟩
  have h1 : ((L.ncard : ℕ) : ℝ) ≤
      (((⋃ i ∈ (Finset.univ : Finset (Fin k)), {z | z ∈ L ∧ ev i z}).ncard : ℕ) : ℝ) := by
    exact_mod_cast Set.ncard_le_ncard hsub hfin
  have h2 : (∑ i ∈ (Finset.univ : Finset (Fin k)), (({z | z ∈ L ∧ ev i z}.ncard : ℕ) : ℝ)) ≤
      ∑ i ∈ (Finset.univ : Finset (Fin k)), Cc * xe * W :=
    Finset.sum_le_sum (fun i _ => (hT i).2)
  rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul] at h2
  have h3 : (k : ℝ) ≤ (N : ℝ) + 1 := by
    have : (k : ℝ) ≤ (N : ℝ) := by exact_mod_cast hk
    linarith
  have h4 : (k : ℝ) * (Cc * xe * W) ≤ ((N : ℝ) + 1) * (Cc * xe * W) :=
    mul_le_mul_of_nonneg_right h3 hB
  have h5 : ((N : ℝ) + 1) * (Cc * xe * W) = ((N : ℝ) + 1) * Cc * xe * W := by ring
  linarith

theorem empty_bound {P : Type*} (S : Set P) (Cc xe W : ℝ) (hCc : 0 ≤ Cc) (hxe : 0 ≤ xe)
    (hW : 1 ≤ W) (h : ∀ z ∈ S, False) : S.Finite ∧ ((S.ncard : ℕ) : ℝ) ≤ Cc * xe * W := by
  have hS : S = ∅ := Set.subset_empty_iff.mp (fun z hz => (h z hz).elim)
  rw [hS]
  refine ⟨Set.finite_empty, ?_⟩
  rw [Set.ncard_empty, Nat.cast_zero]
  have hW0 : 0 ≤ W := by linarith
  positivity

theorem sub_bound {P : Type*} (S : Set P) (Cc xe W : ℝ) (hCc : 1 ≤ Cc) (hxe : 1 ≤ xe)
    (hW : 1 ≤ W) (h : ∀ z ∈ S, ∀ z' ∈ S, z = z') :
    S.Finite ∧ ((S.ncard : ℕ) : ℝ) ≤ Cc * xe * W := by
  have hone : (1 : ℝ) ≤ Cc * xe * W := by
    have h1 : 1 ≤ Cc * xe := one_le_mul_of_one_le_of_one_le hCc hxe
    exact one_le_mul_of_one_le_of_one_le h1 hW
  by_cases hne : S.Nonempty
  · obtain ⟨a, ha⟩ := hne
    have hS : S = {a} := Set.eq_singleton_iff_unique_mem.mpr ⟨ha, fun z hz => h z hz a ha⟩
    rw [hS]
    refine ⟨Set.finite_singleton a, ?_⟩
    rw [Set.ncard_singleton]
    push_cast
    exact hone
  · have hS : S = ∅ := Set.not_nonempty_iff_eq_empty.mp hne
    rw [hS]
    refine ⟨Set.finite_empty, ?_⟩
    rw [Set.ncard_empty, Nat.cast_zero]
    linarith

theorem mono_bound {P : Type*} (S T : Set P) (b Cc xe W : ℝ) (hsub : S ⊆ T) (hT : T.Finite)
    (hTb : ((T.ncard : ℕ) : ℝ) ≤ b) (hbB : b ≤ Cc * xe * W) :
    S.Finite ∧ ((S.ncard : ℕ) : ℝ) ≤ Cc * xe * W := by
  refine ⟨hT.subset hsub, ?_⟩
  have h1 : ((S.ncard : ℕ) : ℝ) ≤ ((T.ncard : ℕ) : ℝ) := by
    exact_mod_cast Set.ncard_le_ncard hsub hT
  linarith

theorem bnd_const (Cc c xe W : ℝ) (hc : c ≤ Cc) (hCc : 0 ≤ Cc) (hxe : 1 ≤ xe) (hW : 1 ≤ W) :
    c ≤ Cc * xe * W := by
  have h1 : 1 ≤ xe * W := one_le_mul_of_one_le_of_one_le hxe hW
  have h2 : Cc ≤ Cc * (xe * W) := le_mul_of_one_le_right hCc h1
  calc c ≤ Cc := hc
    _ ≤ Cc * (xe * W) := h2
    _ = Cc * xe * W := by ring

theorem bnd_xe (Cc c xe W : ℝ) (hc : c ≤ Cc) (hc0 : 0 ≤ c) (hxe : 1 ≤ xe) (hW : 1 ≤ W) :
    c * xe ≤ Cc * xe * W := by
  have hxe0 : 0 ≤ xe := by linarith
  have h1 : c * xe ≤ Cc * xe := mul_le_mul_of_nonneg_right hc hxe0
  have h2 : Cc * xe ≤ Cc * xe * W :=
    le_mul_of_one_le_right (mul_nonneg (le_trans hc0 hc) hxe0) hW
  linarith

theorem bnd_full (Cc c xe W : ℝ) (hc : c ≤ Cc) (hxe : 0 ≤ xe) (hW : 0 ≤ W) :
    c * xe * W ≤ Cc * xe * W := by
  have h := mul_nonneg hxe hW
  have h2 : c * (xe * W) ≤ Cc * (xe * W) := mul_le_mul_of_nonneg_right hc h
  calc c * xe * W = c * (xe * W) := by ring
    _ ≤ Cc * (xe * W) := h2
    _ = Cc * xe * W := by ring

theorem min_one (a b : ℕ) (h : min a b = 1) : a = 1 ∨ b = 1 := by
  rcases le_total a b with hab | hab
  · left
    rw [min_eq_left hab] at h
    exact h
  · right
    rw [min_eq_right hab] at h
    exact h

