  convert heval using 1 ; ring

private theorem quad_degree_le (A B C : ℚ) :
    (quad A B C).natDegree ≤ 2 := by
  have h₁ := Polynomial.natDegree_mul_le
    (p := Polynomial.C B) (q := (Polynomial.X : Polynomial ℚ))
  have h₂ := Polynomial.natDegree_mul_le
    (p := Polynomial.C C) (q := (Polynomial.X : Polynomial ℚ) ^ 2)
  have h₃ := Polynomial.natDegree_add_le
    (Polynomial.C A) (Polynomial.C B * Polynomial.X)
  have h₄ := Polynomial.natDegree_add_le
    (Polynomial.C A + Polynomial.C B * Polynomial.X)
    (Polynomial.C C * Polynomial.X ^ 2)
  simp only [Polynomial.natDegree_C, Polynomial.natDegree_X,
    Polynomial.natDegree_pow] at h₁ h₂ h₃ h₄
  dsimp [quad]
  omega

private theorem quad_degree_eq (A B C : ℚ) (hC : C ≠ 0) :
    (quad A B C).natDegree = 2 := by
  apply le_antisymm (quad_degree_le A B C)
  apply Polynomial.le_natDegree_of_ne_zero
  simpa [quad, Polynomial.coeff_add, Polynomial.coeff_C_mul] using hC

private theorem affine_degree (A B : ℚ) (hB : B ≠ 0) :
    (Polynomial.C A + Polynomial.C B * Polynomial.X).natDegree = 1 := by
  apply le_antisymm
  · have h₁ := Polynomial.natDegree_mul_le
      (p := Polynomial.C B) (q := (Polynomial.X : Polynomial ℚ))
    have h₂ := Polynomial.natDegree_add_le
      (Polynomial.C A) (Polynomial.C B * Polynomial.X)
    simp only [Polynomial.natDegree_C, Polynomial.natDegree_X] at h₁ h₂
    omega
  · apply Polynomial.le_natDegree_of_ne_zero
    simpa [Polynomial.coeff_add, Polynomial.coeff_C_mul] using hB

