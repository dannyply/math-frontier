    have hh' := mul_le_mul_of_nonneg_left hMlow (by positivity : 0≤(t-s)*δ*T)
    have hh'' := mul_le_mul_of_nonneg_left hT1 (by positivity : 0≤(t-s)*δ*cM)
    apply (le_div_iff₀ (by positivity : 0<δ*cM)).mpr
    apply cancel _ _ W hW
    have hcombined : (t-s)*δ*cM≤(t-s)*δ*T*M := by nlinarith only [hh',hh'']
