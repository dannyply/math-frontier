      | exact (Algebra.IsIntegral.isField_iff_isField (R := ℚ)
          (S := (MvPolynomial (Fin n) ℚ ⧸ I) ⧸ p) (algebraMap ℚ _).injective).mp (Field.toIsField ℚ)
      | exact isField_of_isIntegral_of_isField' (R := ℚ)
          (S := (MvPolynomial (Fin n) ℚ ⧸ I) ⧸ p) (Field.toIsField ℚ)
  exact Ideal.Quotient.maximal_of_isField p hfield

theorem not_isField (d : ℕ) (hd : 1 ≤ d) (e : ℤ) (s₀ : ℕ)
    (hHF : ∀ s : ℕ, s₀ ≤ s → (Module.finrank ℚ (V I s) : ℤ) = (d : ℤ) * (s : ℤ) + e) :
    ¬ IsField (MvPolynomial (Fin n) ℚ ⧸ I) := by
  intro hF
  letI := hF.toField
  haveI : Algebra.FiniteType ℚ (MvPolynomial (Fin n) ℚ ⧸ I) := by
    first
      | exact Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ ℚ I) (Ideal.Quotient.mkₐ_surjective ℚ I)
      | infer_instance
  haveI : Module.Finite ℚ (MvPolynomial (Fin n) ℚ ⧸ I) :=
    finite_of_finite_type_of_isJacobsonRing ℚ _
  set N := Module.finrank ℚ (MvPolynomial (Fin n) ℚ ⧸ I)
  set s := s₀ + N + e.natAbs + 1 with hs
  have h1 := hHF s (by omega)
  have h2 : Module.finrank ℚ (V I s) ≤ N := Submodule.finrank_le _
  have h3 : ((Module.finrank ℚ (V I s) : ℕ) : ℤ) ≤ (N : ℤ) := by exact_mod_cast h2
  rw [h1] at h3
  have he : -(e.natAbs : ℤ) ≤ e := by omega
  have hs' : (s : ℤ) = s₀ + N + e.natAbs + 1 := by rw [hs]; push_cast; ring
  have hd' : (1 : ℤ) ≤ d := by exact_mod_cast hd
  have hs0 : (0 : ℤ) ≤ s := by positivity
  have hds : (s : ℤ) ≤ d * s := by nlinarith
  have hN0 : (0 : ℤ) ≤ s₀ := by positivity
  linarith

lemma enat_eq_one {y : ℕ∞} (h1 : y ≤ 1) (h0 : ¬ y ≤ 0) : y = 1 := by
  induction y using ENat.recTopCoe with
  | top =>
    exfalso
    first
      | exact absurd h1 (by simp)
      | simp at h1
      | exact absurd h1 (not_le.mpr (WithTop.coe_lt_top 1))
  | coe m =>
    have h1' : m ≤ 1 := by exact_mod_cast h1
    have h0' : ¬ m ≤ 0 := fun h => h0 (by exact_mod_cast h)
    have hm : m = 1 := by omega
    subst hm
    first
      | rfl
      | exact Nat.cast_one
      | simp

theorem krullDim_eq_one_of_affineHilbert (n : ℕ) (I : Ideal (MvPolynomial (Fin n) ℚ)) (hI : I.IsPrime)
    (d : ℕ) (hd : 1 ≤ d) (e : ℤ) (s₀ : ℕ)
    (hHF : ∀ s : ℕ, s₀ ≤ s →
      (Module.finrank ℚ (Submodule.map (Ideal.Quotient.mkₐ ℚ I).toLinearMap
        (MvPolynomial.restrictTotalDegree (Fin n) ℚ s)) : ℤ) = (d : ℤ) * (s : ℤ) + e) :
    ringKrullDim (MvPolynomial (Fin n) ℚ ⧸ I) = 1 := by
  haveI := hI
  have hle : Ring.KrullDimLE 1 (MvPolynomial (Fin n) ℚ ⧸ I) := by
    apply Ring.KrullDimLE.mk₁
    intro p hp
    by_cases hp0 : p = ⊥
    · left
      rw [hp0]
      exact ⟨⟨Ideal.bot_prime, le_rfl⟩, fun _ _ _ => bot_le⟩
    · right
      exact prime_maximal I d hd e s₀ hHF p hp hp0
  have hnf := not_isField I d hd e s₀ hHF
  have h1 : ringKrullDim (MvPolynomial (Fin n) ℚ ⧸ I) ≤ 1 := Ring.krullDimLE_iff.mp hle
  have h0 : ¬ ringKrullDim (MvPolynomial (Fin n) ℚ ⧸ I) ≤ 0 := by
    intro h
    haveI : Ring.KrullDimLE 0 (MvPolynomial (Fin n) ℚ ⧸ I) := Ring.krullDimLE_iff.mpr h
    exact hnf (Ring.KrullDimLE.isField_of_isDomain)
  have hne : ringKrullDim (MvPolynomial (Fin n) ℚ ⧸ I) ≠ ⊥ := by
    intro hb; apply h0; rw [hb]; exact bot_le
  obtain ⟨y, hy⟩ := WithBot.ne_bot_iff_exists.mp hne
  rw [← hy] at h1 h0 ⊢
  have h1' : y ≤ 1 := by exact_mod_cast h1
  have h0' : ¬ y ≤ 0 := fun h => h0 (by exact_mod_cast h)
  have : y = 1 := enat_eq_one h1' h0'
  rw [this]; rfl

end DimOne

namespace LemP

lemma prim_ne (a b : ℤ) (h : Int.gcd a b = 1) : ¬ (a = 0 ∧ b = 0) := by
  rintro ⟨ha, hb⟩; rw [ha, hb] at h; simp at h

lemma prim_parallel (a b a' b' : ℤ) (h : Int.gcd a b = 1) (h' : Int.gcd a' b' = 1)
    (hD : a * b' = a' * b) : ∃ k : ℤ, (k = 1 ∨ k = -1) ∧ a' = k * a ∧ b' = k * b := by
  have e1 : (1:ℤ) = a * Int.gcdA a b + b * Int.gcdB a b := by
    have := Int.gcd_eq_gcd_ab a b; rw [h] at this; exact_mod_cast this
  have e2 : (1:ℤ) = a' * Int.gcdA a' b' + b' * Int.gcdB a' b' := by
    have := Int.gcd_eq_gcd_ab a' b'; rw [h'] at this; exact_mod_cast this
  have hD' : a' * b = a * b' := hD.symm
  have ha' : a' = (a' * Int.gcdA a b + b' * Int.gcdB a b) * a := by
    linear_combination a' * e1 - (Int.gcdB a b) * hD
  have hb' : b' = (a' * Int.gcdA a b + b' * Int.gcdB a b) * b := by
    linear_combination b' * e1 + (Int.gcdA a b) * hD
  have ha : a = (a * Int.gcdA a' b' + b * Int.gcdB a' b') * a' := by
    linear_combination a * e2 - (Int.gcdB a' b') * hD'
  have hb : b = (a * Int.gcdA a' b' + b * Int.gcdB a' b') * b' := by
    linear_combination b * e2 + (Int.gcdA a' b') * hD'
  set k := a' * Int.gcdA a b + b' * Int.gcdB a b with hk
  set k' := a * Int.gcdA a' b' + b * Int.gcdB a' b' with hk'
  have hkk : k' * k = 1 := by
    by_cases ha0 : a = 0
    · have hb0 : b ≠ 0 := fun hb0 => prim_ne a b h ⟨ha0, hb0⟩
      have h1 : (k' * k) * b = 1 * b := by
        calc (k' * k) * b = k' * (k * b) := by ring
          _ = k' * b' := by rw [← hb']
          _ = b := hb.symm
          _ = 1 * b := by ring
      exact mul_right_cancel₀ hb0 h1
    · have h1 : (k' * k) * a = 1 * a := by
        calc (k' * k) * a = k' * (k * a) := by ring
          _ = k' * a' := by rw [← ha']
          _ = a := ha.symm
          _ = 1 * a := by ring
      exact mul_right_cancel₀ ha0 h1
  have hkk' : k * k' = 1 := by rw [mul_comm]; exact hkk
  have hu : k = 1 ∨ k = -1 := by
    first
      | exact Int.isUnit_iff.mp ⟨⟨k, k', hkk', hkk⟩, rfl⟩
      | exact Int.eq_one_or_neg_one_of_mul_eq_one hkk'
      | exact Int.isUnit_iff.mp (isUnit_of_mul_eq_one k k' hkk')
  exact ⟨k, hu, ha', hb'⟩

end LemP

namespace A6GenericWeightedPrivate
open MvPolynomial
open Strict540Q.Classify
variable {R σ : Type*} [CommRing R] [IsDomain R]
lemma homogeneous_not_dvd_low (w : σ→ℕ) (g p : MvPolynomial σ R) (u v : ℕ)
    (hg : g≠0) (hp : p≠0) (hhom : IsWeightedHomogeneous w g u)
    (hpHom : IsWeightedHomogeneous w p v) (hvu : v<u) : ¬g∣p := by
  rintro ⟨q,hq⟩
  have hgp : IsWeightedHomogeneous w (g*q) v := by rw [←hq];exact hpHom
  have hgp0 : g*q≠0 := by rw [←hq];exact hp
  obtain ⟨a,b,hab,hga,_⟩ := wh_split hgp hgp0
  have hua : u=a := IsWeightedHomogeneous.inj_right hg hhom hga
  omega
lemma quot_homog (w : σ→ℕ) (H q : MvPolynomial σ R) (L n : ℕ)
    (hH : IsWeightedHomogeneous w H L) (hH0 : H≠0)
    (hp : IsWeightedHomogeneous w (H*q) n) :
    IsWeightedHomogeneous w q (n-L) := by
  by_cases hq : q=0
  · subst q
    intro m hm
    simp at hm
  obtain ⟨a,b,hab,hHa,hqb⟩ := wh_split hp (mul_ne_zero hH0 hq)
  have hLa : L=a := IsWeightedHomogeneous.inj_right hH0 hH hHa
  have hb : b=n-L := by omega
  simpa only [hb] using hqb
end A6GenericWeightedPrivate

namespace A6PrincipalRankPrivate
open MvPolynomial
noncomputable section
theorem principal_rank_add {A : Type*} [CommRing A] [IsDomain A] [Algebra ℚ A]
    (H : A) (hH : H≠0) (U W : Submodule ℚ A) [FiniteDimensional ℚ U]
    (hmem : ∀q:A,q∈W ↔ H*q∈U) :
    Module.finrank ℚ (Submodule.map
      (Ideal.Quotient.mkₐ ℚ (Ideal.span ({H}:Set A))).toLinearMap U)+
      Module.finrank ℚ W=Module.finrank ℚ U := by
  let I := Ideal.span ({H}:Set A)
  let f : U→ₗ[ℚ] A⧸I := (Ideal.Quotient.mkₐ ℚ I).toLinearMap.comp U.subtype
  let mulH : W→ₗ[ℚ] U :=
    { toFun := fun q=>⟨H*q,(hmem q).mp q.2⟩
      map_add' := by intro x y;apply Subtype.ext;simp [mul_add]
      map_smul' := by intro c x;apply Subtype.ext;simp [mul_smul_comm] }
  have hinj : Function.Injective mulH := by
    intro x y he
    exact Subtype.ext (mul_left_cancel₀ hH (congrArg Subtype.val he))
  have hker : LinearMap.ker f=LinearMap.range mulH := by
    ext p
    simp only [LinearMap.mem_ker,LinearMap.mem_range]
    constructor
    · intro hp
      have hp' : (p:A)∈I := Ideal.Quotient.eq_zero_iff_mem.mp hp
      rw [Ideal.mem_span_singleton] at hp'
      obtain ⟨q,hq⟩ := hp'
      refine ⟨⟨q,(hmem q).mpr (hq ▸ p.2)⟩,?_⟩
      exact Subtype.ext hq.symm
    · rintro ⟨q,rfl⟩
      change Ideal.Quotient.mk I (H*(q:A))=0
      rw [Ideal.Quotient.eq_zero_iff_mem,Ideal.mem_span_singleton]
      exact dvd_mul_right H q
  have hrange : LinearMap.range f=
      Submodule.map (Ideal.Quotient.mkₐ ℚ I).toLinearMap U := by
    rw [LinearMap.range_comp,Submodule.range_subtype]
  have hr := LinearMap.finrank_range_add_finrank_ker f
  rw [hker,LinearMap.finrank_range_of_inj hinj,hrange] at hr
  exact hr
end
end A6PrincipalRankPrivate

namespace A6CountRealPrivate
noncomputable section
lemma ccdn_price_bound (D d k : ℕ) (hk0 : 0<k) (hk : k≤d) (hdD : d≤D)
    (c x B E eps : ℝ) (hx : 2≤x) (hE : 0<E) (heps : 0<eps)
    (hB : 0≤B) (hXX : B≤x^E) :
    c*(d:ℝ)^3*(max 1 B)^((1:ℝ)/(d:ℝ))*
      (Real.log (max 1 B)+(d:ℝ)) ≤
    ((|c|+1)*(D:ℝ)^3*(E/eps+(D:ℝ)))*
      x^eps*(1+B^((1:ℝ)/(k:ℝ))) := by
  have hD : 0<D := lt_of_lt_of_le (lt_of_lt_of_le hk0 hk) hdD
  have hx0 : 0<x := by linarith
  have hx1 : 1≤x := by linarith
  have hDpos : (0:ℝ)<(D:ℝ) := by exact_mod_cast hD
  have hdpos : (0:ℝ)<(d:ℝ) := by exact_mod_cast (by omega : 0<d)
  have hkR : (k:ℝ)≤(d:ℝ) := by exact_mod_cast hk
  have hdDR : (d:ℝ)≤(D:ℝ) := by exact_mod_cast hdD
  have hX : 0≤B := hB
  have hH : 1 ≤ max 1 B := le_max_left _ _
  have hH0 : 0 < max 1 B := by linarith
  have hHX : max 1 B≤x^(E) :=
    max_le (Real.one_le_rpow hx1 (by positivity)) hXX
  have hlog : 0≤Real.log (max 1 B) := Real.log_nonneg hH
  have hlogX : Real.log (max 1 B)≤E*Real.log x := by
    calc
      _≤Real.log (x^(E)) := Real.log_le_log hH0 hHX
      _=E*Real.log x := Real.log_rpow hx0 _
  have hlx : Real.log x≤x^eps/eps := Real.log_le_rpow_div hx0.le heps
  have hxeps : 1≤x^eps := Real.one_le_rpow hx1 heps.le
  have hlogfinal :
      Real.log (max 1 B)+(d:ℝ)≤
        (E/eps+(D:ℝ))*x^eps := by
    have hh := hlogX.trans (mul_le_mul_of_nonneg_left hlx (by positivity))
    have hhD := mul_le_mul_of_nonneg_left hxeps hDpos.le
    calc
      _≤E*(x^eps/eps)+(D:ℝ)*x^eps := by nlinarith
      _=_ := by ring
  have hpow :
      (max 1 B)^((1:ℝ)/(d:ℝ))≤1+B^((1:ℝ)/(k:ℝ)) := by
    rcases le_total B 1 with hlo|hhi
    · rw [max_eq_left hlo,Real.one_rpow]
      exact le_add_of_nonneg_right (Real.rpow_nonneg hX _)
    · rw [max_eq_right hhi]
      have he : (1:ℝ)/(d:ℝ)≤1/(k:ℝ) := one_div_le_one_div_of_le (by exact_mod_cast hk0) hkR
      have hh := Real.rpow_le_rpow_of_exponent_le hhi he
      linarith
  have hcube : (d:ℝ)^3≤(D:ℝ)^3 := by gcongr
  have hc : c≤|c|+1 := by linarith [le_abs_self c]
  have hfirst :
      c*(d:ℝ)^3*(max 1 B)^((1:ℝ)/(d:ℝ))*
        (Real.log (max 1 B)+(d:ℝ))≤
      (|c|+1)*(d:ℝ)^3*(max 1 B)^((1:ℝ)/(d:ℝ))*
        (Real.log (max 1 B)+(d:ℝ)) := by
    apply mul_le_mul_of_nonneg_right
    · apply mul_le_mul_of_nonneg_right
      · exact mul_le_mul_of_nonneg_right hc (by positivity)
      · exact Real.rpow_nonneg hH0.le _
    · positivity
  have hprod1 := mul_le_mul_of_nonneg_left hcube (by positivity : 0≤|c|+1)
  have hprod2 := mul_le_mul hprod1 hpow
    (Real.rpow_nonneg hH0.le _) (by positivity : 0≤(|c|+1)*(D:ℝ)^3)
  have hprod3 := mul_le_mul hprod2 hlogfinal
    (by positivity : 0≤Real.log (max 1 B)+(d:ℝ))
    (by positivity : 0≤(|c|+1)*(D:ℝ)^3*(1+B^((1:ℝ)/(k:ℝ))))
  exact hfirst.trans (by nlinarith [hprod3])

lemma ccdn_price_ninth (N d : ℕ) (hd9 : 9≤d) (hdN : d≤N+8)
    (c x L V Cexp eps : ℝ) (hx : 2≤x) (hC : 0<Cexp) (heps : 0<eps)
    (hL : 0≤L) (hLX : L≤x^Cexp) (hV : 0≤V) (hVX : V≤x^Cexp) :
    c*(d:ℝ)^3*(max 1 (L^4*V))^((1:ℝ)/(d:ℝ))*
      (Real.log (max 1 (L^4*V))+(d:ℝ)) ≤
    ((|c|+1)*((N+8:ℕ):ℝ)^3*(5*Cexp/eps+((N+8:ℕ):ℝ)))*
      x^eps*(1+(L^4*V)^((1:ℝ)/9)) := by
  have hx0 : 0<x := by linarith
  have hXX : L^4*V≤x^(5*Cexp) := by
    calc
      L^4*V≤(x^Cexp)^4*x^Cexp := by gcongr
      _=x^(5*Cexp) := by
        rw [←Real.rpow_natCast,←Real.rpow_mul hx0.le,←Real.rpow_add hx0]
        congr 1
        ring
  exact ccdn_price_bound (N+8) d 9 (by omega) hd9 hdN c x (L^4*V)
    (5*Cexp) eps hx (by positivity) heps (by positivity) hXX

lemma ninth_constant_positive (N : ℕ) (c Cexp eps : ℝ)
    (hC : 0<Cexp) (heps : 0<eps) :
    0<(|c|+1)*((N+8:ℕ):ℝ)^3*(5*Cexp/eps+((N+8:ℕ):ℝ)) := by
  positivity
end
end A6CountRealPrivate

namespace A6PlaneCountPrivate
open MvPolynomial
noncomputable section
def CCDNAt : ℕ → ℝ → Prop := fun N c =>
  ∀ d : ℕ, 1 ≤ d → ∀ I : Ideal (MvPolynomial (Fin N) ℚ), I.IsPrime →
    ringKrullDim (MvPolynomial (Fin N) ℚ ⧸ I) = 1 →
    (∃ e : ℤ, ∃ s0 : ℕ, ∀ s : ℕ, s0 ≤ s →
      (Module.finrank ℚ (Submodule.map (Ideal.Quotient.mkₐ ℚ I).toLinearMap
        (MvPolynomial.restrictTotalDegree (Fin N) ℚ s)) : ℤ) =
          (d : ℤ) * (s : ℤ) + e) →
    ∀ H : ℝ, 1 ≤ H →
      ((({p : Fin N → ℤ |
        (∀ f ∈ I, MvPolynomial.eval (fun i => (p i : ℚ)) f = 0) ∧
        ∀ i, |(p i : ℝ)| ≤ H} : Set (Fin N → ℤ)).ncard : ℕ) : ℝ) ≤
        c * (d : ℝ) ^ 3 * H ^ ((1 : ℝ) / (d : ℝ)) *
          (Real.log H + (d : ℝ))
lemma bounded_points_finite (n : ℕ) (H : ℝ) :
    ({p : Fin n → ℤ | ∀ i,|(p i:ℝ)|≤H} : Set (Fin n → ℤ)).Finite := by
  apply Set.Finite.subset (Set.Finite.pi
    (t:=fun _ : Fin n=>Set.Icc (-⌈H⌉) ⌈H⌉) (fun _=>Set.finite_Icc _ _))
  intro p hp
  rw [Set.mem_univ_pi]
  intro i
  have hi := (abs_le.mp (hp i))
  have hceil := Int.le_ceil H
  constructor
  · have hh : (-(⌈H⌉:ℝ))≤(p i:ℝ) := by linarith [hi.1]
    exact_mod_cast hh
  · have hh : (p i:ℝ)≤(⌈H⌉:ℝ) := by linarith [hi.2]
    exact_mod_cast hh
end
end A6PlaneCountPrivate

namespace A6ActualIncidencePrivate
open MvPolynomial
noncomputable section
abbrev Four := MvPolynomial (Fin 4) ℚ
abbrev Five := MvPolynomial (Fin 5) ℚ
abbrev Tgt := MvPolynomial (Fin 5) ℚ
def embed : Four →+* Five := (MvPolynomial.rename Fin.castSucc).toRingHom
def ideal (g f : Four) : Ideal Five :=
  Ideal.span {embed g, X 4 * embed f - 1}
abbrev Inc (g f : Four) := Five ⧸ ideal g f
def q (g f : Four) : Five →+* Inc g f := Ideal.Quotient.mk (ideal g f)
def baseIdeal (g : Four) : Ideal Four := Ideal.span {g}
abbrev Base (g : Four) := Four ⧸ baseIdeal g
def baseQ (g : Four) : Four →+* Base g := Ideal.Quotient.mk (baseIdeal g)
abbrev Loc (g f : Four) := Localization.Away (baseQ g f)
def intoLoc (g f : Four) : Four →+* Loc g f :=
  (algebraMap (Base g) (Loc g f)).comp (baseQ g)
def phi (g f : Four) : Five →+* Loc g f :=
  MvPolynomial.eval₂Hom ((intoLoc g f).comp MvPolynomial.C)
    ![intoLoc g f (X 0), intoLoc g f (X 1),
      intoLoc g f (X 2), intoLoc g f (X 3),
      IsLocalization.Away.invSelf (baseQ g f)]

lemma phi_embed (g f : Four) : (phi g f).comp embed = intoLoc g f := by
  apply MvPolynomial.ringHom_ext
  · intro r
    simp [phi,embed]
  · intro i
    fin_cases i <;> simp [phi,embed]

lemma q_g (g f : Four) : q g f (embed g) = 0 := by
  exact Ideal.Quotient.eq_zero_iff_mem.mpr
    (Ideal.subset_span (by simp))

lemma q_relation (g f : Four) :
    q g f (embed f) * q g f (X 4) = 1 := by
  have h : q g f (X 4 * embed f - 1)=0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))
  simpa only [map_sub,map_mul,map_one,sub_eq_zero,mul_comm] using h

def baseIntoInc (g f : Four) : Base g →+* Inc g f :=
  Ideal.Quotient.lift (baseIdeal g) ((q g f).comp embed) (by
    change baseIdeal g ≤ RingHom.ker ((q g f).comp embed)
    unfold baseIdeal
    apply Ideal.span_le.mpr
    intro a ha
    have : a=g := by simpa using ha
    subst a
    exact q_g g f)

def back (g f : Four) : Loc g f →+* Inc g f :=
  IsLocalization.Away.lift (baseQ g f)
    (g:=baseIntoInc g f)
    (by
      refine ⟨⟨q g f (embed f),q g f (X 4),q_relation g f,?_⟩,rfl⟩
      simpa only [mul_comm] using q_relation g f)

lemma back_coeff (g f r : Four) :
    back g f (intoLoc g f r)=q g f (embed r) := by
  exact IsLocalization.Away.lift_eq _ _ _

lemma back_inv (g f : Four) :
    back g f (IsLocalization.Away.invSelf (baseQ g f))=q g f (X 4) := by
  have h := congrArg (back g f)
    (IsLocalization.Away.mul_invSelf (S:=Loc g f) (baseQ g f))
  simp only [map_mul,map_one] at h
  have hc : back g f (algebraMap (Base g) (Loc g f) (baseQ g f)) =
      q g f (embed f) := back_coeff g f f
  rw [hc] at h
  calc
    _ = back g f (IsLocalization.Away.invSelf (baseQ g f)) *
        (q g f (embed f) * q g f (X 4)) := by rw [q_relation]; ring
    _ = (q g f (embed f) *
        back g f (IsLocalization.Away.invSelf (baseQ g f))) * q g f (X 4) := by ring
    _ = _ := by rw [h]; ring

lemma back_phi (g f : Four) : (back g f).comp (phi g f)=q g f := by
  apply MvPolynomial.ringHom_ext
  · intro r
    simpa [phi,embed] using back_coeff g f (C r)
  · intro i
    fin_cases i <;> simp [phi,embed,back_coeff,back_inv]

def toLoc (g f : Four) : Inc g f →+* Loc g f :=
  Ideal.Quotient.lift (ideal g f) (phi g f) (by
    change ideal g f ≤ RingHom.ker (phi g f)
    unfold ideal
    apply Ideal.span_le.mpr
    intro a ha
    simp only [Set.mem_insert_iff,Set.mem_singleton_iff] at ha
    rcases ha with rfl | rfl
    · have h := congrArg (fun h : Four →+* Loc g f => h g) (phi_embed g f)
      change phi g f (embed g)=0
      simp only [RingHom.comp_apply] at h
      rw [h]
      change algebraMap (Base g) (Loc g f) (baseQ g g)=0
      have hg0 : baseQ g g=0 := Ideal.Quotient.eq_zero_iff_mem.mpr
        (Ideal.subset_span (by simp))
      rw [hg0,map_zero]
    · change phi g f (X 4 * embed f - 1)=0
      have hf := congrArg (fun h : Four →+* Loc g f => h f) (phi_embed g f)
      simp only [RingHom.comp_apply] at hf
      rw [map_sub,map_mul,map_one,hf]
      simp [phi]
      have hh := IsLocalization.Away.mul_invSelf (S:=Loc g f) (baseQ g f)
      simpa only [intoLoc,RingHom.comp_apply,mul_comm,sub_eq_zero] using hh)

lemma toLoc_injective (g f : Four) : Function.Injective (toLoc g f) := by
  have hinv : ∀ a : Inc g f, back g f (toLoc g f a)=a := by
    intro a
    refine Quotient.inductionOn a ?_
    intro p
    exact congrArg (fun h : Five →+* Inc g f => h p) (back_phi g f)
  intro a b h
  have hh := congrArg (back g f) h
  simpa only [hinv] using hh

lemma incidence_isDomain (g f : Four) (hg : Irreducible g) (hf : ¬g∣f) :
    IsDomain (Inc g f) := by
  letI : (baseIdeal g).IsPrime :=
    (Ideal.span_singleton_prime hg.ne_zero).mpr hg.prime
  letI : IsDomain (Base g) := inferInstance
  have hf0 : baseQ g f ≠ 0 := by
    intro h
    exact hf (Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp h))
  letI : IsDomain (Loc g f) := by
    apply IsLocalization.isDomain_of_le_nonZeroDivisors (R:=Base g)
      (M:=Submonoid.powers (baseQ g f)) (Loc g f)
    intro r hr
    obtain ⟨n,rfl⟩ := hr
    exact mem_nonZeroDivisors_iff_ne_zero.mpr (pow_ne_zero n hf0)
  exact Function.Injective.isDomain (toLoc g f) (toLoc_injective g f)

end
end A6ActualIncidencePrivate

namespace A6ActualBiformPrivate
open MvPolynomial
noncomputable section
abbrev Four := MvPolynomial (Fin 4) ℚ
def uvWeight : Fin 4 → ℕ := ![0,0,1,1]

lemma uvWeight_apply (m : Fin 4 →₀ ℕ) :
    Finsupp.weight uvWeight m=m 2+m 3 := by
  simp [Finsupp.weight_apply,Finsupp.sum_fintype,Fin.sum_univ_succ,uvWeight]

def surface : Four := X 1^4*X 3-X 0^4*X 2

lemma surface_homogeneous : IsWeightedHomogeneous uvWeight surface 1 := by
  have he : IsWeightedHomogeneous uvWeight (X 1^4*X 3 : Four) 1 := by
    convert ((isWeightedHomogeneous_X ℚ uvWeight (1:Fin 4)).pow 4).mul
      (isWeightedHomogeneous_X ℚ uvWeight (3:Fin 4)) using 1 <;> norm_num [uvWeight] <;> decide
  have hd : IsWeightedHomogeneous uvWeight (X 0^4*X 2 : Four) 1 := by
    convert ((isWeightedHomogeneous_X ℚ uvWeight (0:Fin 4)).pow 4).mul
      (isWeightedHomogeneous_X ℚ uvWeight (2:Fin 4)) using 1 <;> norm_num [uvWeight] <;> decide
  exact he.sub hd

lemma surface_ne_zero : surface ≠ 0 := by
  intro h
  have hh := congrArg (MvPolynomial.eval (![0,1,0,1] : Fin 4 → ℚ)) h
  norm_num [surface] at hh
  change (1:ℚ)=0 at hh
  norm_num at hh

lemma homogeneous_not_dvd_surface (g : Four) (hg : g≠0)
    (hhom : IsWeightedHomogeneous uvWeight g 2) : ¬g∣surface :=
  A6GenericWeightedPrivate.homogeneous_not_dvd_low uvWeight g surface 2 1
    hg surface_ne_zero hhom surface_homogeneous (by omega)
lemma isUnit_of_map {L : Type*} [Field L] (f : ℚ →+* L) (p : Four)
    (hp : IsUnit (MvPolynomial.map f p)) : IsUnit p := by
  have h1 : (MvPolynomial.map f p).totalDegree = 0 := by
    obtain ⟨u,hu⟩ := hp
    have hmul := u.mul_inv
    have hne : (u : MvPolynomial (Fin 4) L) ≠ 0 := u.ne_zero
    have hne' : ((u⁻¹ : (MvPolynomial (Fin 4) L)ˣ) : MvPolynomial (Fin 4) L) ≠ 0 := (u⁻¹).ne_zero
    have := congrArg totalDegree hmul
    rw [totalDegree_mul_of_isDomain hne hne',totalDegree_one] at this
    rw [←hu]
    omega
  have h2 : p.totalDegree=0 := by
    have hs : (MvPolynomial.map f p).support=p.support := support_map_of_injective p f.injective
    unfold totalDegree at h1 ⊢
    rwa [hs] at h1
  rw [totalDegree_eq_zero_iff_eq_C] at h2
  have hc : coeff 0 p ≠ 0 := by
    intro h0
    rw [h2,h0,C_0,map_zero] at hp
    exact not_isUnit_zero hp
  rw [h2]
  exact (Ne.isUnit hc).map C

lemma irreducible_of_map {L : Type*} [Field L] (f : ℚ →+* L) (g : Four)
    (hg : Irreducible (MvPolynomial.map f g)) : Irreducible g := by
  refine ⟨fun hu => hg.not_isUnit (hu.map (MvPolynomial.map f)),?_⟩
  intro a b hab
  have hh := hg.isUnit_or_isUnit (show MvPolynomial.map f g =
      MvPolynomial.map f a*MvPolynomial.map f b by rw [hab,map_mul])
  rcases hh with ha | hb
  · exact Or.inl (isUnit_of_map f a ha)
  · exact Or.inr (isUnit_of_map f b hb)

def rationalG (g : MvPolynomial (Fin 4) ℤ) : Four :=
  MvPolynomial.map (Int.castRingHom ℚ) g

lemma rationalG_irreducible (g : MvPolynomial (Fin 4) ℤ)
    (hg : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) g)) :
    Irreducible (rationalG g) := by
  have hcomp : (algebraMap ℚ ℂ).comp (Int.castRingHom ℚ)=Int.castRingHom ℂ := by
    ext n
    simp
  apply irreducible_of_map (algebraMap ℚ ℂ)
  simpa only [rationalG,MvPolynomial.map_map,hcomp] using hg

lemma rationalG_homogeneous (alpha : ℕ) (g : MvPolynomial (Fin 4) ℤ)
    (hdeg : ∀ m ∈ g.support,m 0+m 1=alpha ∧ m 2+m 3=2) :
    IsWeightedHomogeneous uvWeight (rationalG g) 2 := by
  intro m hm
  have hmZ : coeff m g ≠ 0 := by
    intro hz
    apply hm
    rw [rationalG,coeff_map,hz,map_zero]
  rw [uvWeight_apply]
  exact (hdeg m (mem_support_iff.mpr hmZ)).2

lemma rationalG_not_dvd_surface (alpha : ℕ) (g : MvPolynomial (Fin 4) ℤ)
    (hdeg : ∀ m ∈ g.support,m 0+m 1=alpha ∧ m 2+m 3=2)
    (hg : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) g)) :
    ¬rationalG g∣surface :=
  homogeneous_not_dvd_surface _ (rationalG_irreducible g hg).ne_zero
    (rationalG_homogeneous alpha g hdeg)
end
end A6ActualBiformPrivate

namespace A6ActualIncidencePrivate
open MvPolynomial
noncomputable section
abbrev FourZ := MvPolynomial (Fin 4) ℤ
def originalG5 (G : FourZ) : Five :=
  MvPolynomial.eval₂Hom (Int.castRingHom Five) ![X 0,X 1,X 2,X 3] G
def originalF5 : Five := X 1^4*X 3-X 0^4*X 2
def originalIdeal (G : FourZ) : Ideal Five :=
  Ideal.span {originalG5 G,X 4*originalF5-1}

lemma originalG5_eq (G : FourZ) :
    originalG5 G=embed (A6ActualBiformPrivate.rationalG G) := by
  have heq :
      MvPolynomial.eval₂Hom (Int.castRingHom Five) ![X 0,X 1,X 2,X 3] =
      embed.comp (MvPolynomial.map (Int.castRingHom ℚ)) := by
    apply MvPolynomial.ringHom_ext
    · intro n
      simp [embed]
    · intro i
      fin_cases i <;> simp [embed]
  exact congrArg (fun h : FourZ →+* Five => h G) heq

lemma originalF5_eq :
    originalF5=embed A6ActualBiformPrivate.surface := by
  simp [originalF5,embed,A6ActualBiformPrivate.surface]

lemma originalIdeal_eq (G : FourZ) :
    originalIdeal G=ideal (A6ActualBiformPrivate.rationalG G)
      A6ActualBiformPrivate.surface := by
  simp only [originalIdeal,ideal,originalG5_eq,originalF5_eq]

lemma original_incidence_isDomain (alpha : ℕ) (G : FourZ)
    (hdeg : ∀ m ∈ G.support,m 0+m 1=alpha ∧ m 2+m 3=2)
    (hg : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G)) :
    IsDomain (Five ⧸ originalIdeal G) := by
  rw [originalIdeal_eq]
  exact incidence_isDomain _
    _ (A6ActualBiformPrivate.rationalG_irreducible G hg)
    (A6ActualBiformPrivate.rationalG_not_dvd_surface alpha G hdeg hg)

def originalPsi (G : FourZ) (A : Matrix (Fin 2) (Fin 2) ℤ) :
    Tgt →ₐ[ℚ] (Five ⧸ originalIdeal G) :=
  let q := Ideal.Quotient.mkₐ ℚ (originalIdeal G)
  let L0 : Five := C (A 0 0 : ℚ)*X 0+C (A 0 1 : ℚ)*X 1
  let L1 : Five := C (A 1 0 : ℚ)*X 0+C (A 1 1 : ℚ)*X 1
  MvPolynomial.aeval
    ![q (X 4*X 3*L0^4),q (X 4*X 3*L0^3*L1),
      q (X 4*X 3*L0^2*L1^2),q (X 4*X 3*L0*L1^3),q (X 4*X 3*L1^4)]

lemma original_kernel_isPrime (alpha : ℕ) (G : FourZ)
    (hdeg : ∀ m ∈ G.support,m 0+m 1=alpha ∧ m 2+m 3=2)
    (hg : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G))
    (A : Matrix (Fin 2) (Fin 2) ℤ) :
    (RingHom.ker (originalPsi G A).toRingHom).IsPrime := by
  letI := original_incidence_isDomain alpha G hdeg hg
  exact RingHom.ker_isPrime (originalPsi G A).toRingHom

end
end A6ActualIncidencePrivate

namespace A6ActualBiformPrivate
open MvPolynomial
noncomputable section
lemma homogeneous_not_dvd_low (g p : Four) (u v : ℕ) (hg : g≠0) (hp : p≠0)
    (hhom : IsWeightedHomogeneous uvWeight g u)
    (hpHom : IsWeightedHomogeneous uvWeight p v) (hvu : v<u) : ¬g∣p :=
  A6GenericWeightedPrivate.homogeneous_not_dvd_low uvWeight g p u v hg hp hhom hpHom hvu
lemma rationalG_not_dvd_X (alpha : ℕ) (g : MvPolynomial (Fin 4) ℤ)
    (hdeg : ∀ m ∈ g.support,m 0+m 1=alpha ∧ m 2+m 3=2)
    (hg : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) g)) (i : Fin 4) :
    ¬rationalG g∣X i := by
  apply homogeneous_not_dvd_low _ _ 2 (uvWeight i)
    (rationalG_irreducible g hg).ne_zero (X_ne_zero i)
    (rationalG_homogeneous alpha g hdeg)
    (isWeightedHomogeneous_X ℚ uvWeight i)
  fin_cases i <;> decide

end
end A6ActualBiformPrivate

namespace A6ActualIncidencePrivate
open MvPolynomial
noncomputable section

lemma toLoc_q_embed (g f r : Four) :
    toLoc g f (q g f (embed r))=intoLoc g f r := by
  change phi g f (embed r)=intoLoc g f r
  exact congrArg (fun h : Four →+* Loc g f => h r) (phi_embed g f)

lemma q_embed_ne_zero (g f r : Four) (hg : Irreducible g)
    (hf : ¬g∣f) (hr : ¬g∣r) : q g f (embed r)≠0 := by
  letI : (baseIdeal g).IsPrime :=
    (Ideal.span_singleton_prime hg.ne_zero).mpr hg.prime
  letI : IsDomain (Base g) := inferInstance
  have hf0 : baseQ g f≠0 := by
    intro h
    exact hf (Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp h))
  have hM : Submonoid.powers (baseQ g f) ≤ nonZeroDivisors (Base g) := by
    intro a ha
    obtain ⟨n,rfl⟩ := ha
    exact mem_nonZeroDivisors_iff_ne_zero.mpr (pow_ne_zero n hf0)
  have hinj := IsLocalization.injective (Loc g f) hM
  have hr0 : baseQ g r≠0 := by
    intro h
    exact hr (Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp h))
  intro h
  have hzero : intoLoc g f r=0 := by rw [←toLoc_q_embed,h,map_zero]
  apply hr0
  apply hinj
  simpa only [intoLoc,RingHom.comp_apply,map_zero] using hzero

lemma original_generic_coordinate_ne_zero (alpha : ℕ) (G : FourZ)
    (hdeg : ∀ m ∈ G.support,m 0+m 1=alpha ∧ m 2+m 3=2)
    (hg : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G)) (i : Fin 4) :
    q (A6ActualBiformPrivate.rationalG G) A6ActualBiformPrivate.surface
      (embed (X i))≠0 :=
  q_embed_ne_zero _ _ _ (A6ActualBiformPrivate.rationalG_irreducible G hg)
    (A6ActualBiformPrivate.rationalG_not_dvd_surface alpha G hdeg hg)
    (A6ActualBiformPrivate.rationalG_not_dvd_X alpha G hdeg hg i)

end
end A6ActualIncidencePrivate

namespace A6WeightedImagePrivate
open MvPolynomial
noncomputable section
abbrev WTgt := MvPolynomial (Fin 5) ℚ
abbrev Tri := MvPolynomial (Fin 3) ℚ
def wt : Fin 3 → ℕ := ![1,1,4]
def deg5 (n : Fin 5 →₀ ℕ) := n 0+n 1+n 2+n 3+n 4
lemma wt_apply (n : Fin 3 →₀ ℕ) :
    Finsupp.weight wt n=n 0+n 1+4*n 2 := by
  simp [Finsupp.weight_apply,Finsupp.sum_fintype,Fin.sum_univ_succ,wt]
  omega
lemma factor_nat (j a b : ℕ) (h : a+b=4*j) :
    ∃ n0 n1 n2 n3 n4 : ℕ,n0+n1+n2+n3+n4=j ∧
      4*n0+3*n1+2*n2+n3=a ∧ n1+2*n2+3*n3+4*n4=b := by
  induction j generalizing a b with
  | zero =>
    refine ⟨0,0,0,0,0,?_,?_,?_⟩ <;> omega
  | succ j ih =>
    by_cases ha : 4≤a
    · obtain ⟨n0,n1,n2,n3,n4,hn,ha',hb'⟩ := ih (a-4) b (by omega)
      refine ⟨n0+1,n1,n2,n3,n4,?_,?_,?_⟩ <;> omega
    · interval_cases a
      · exact ⟨0,0,0,0,j+1,by omega,by omega,by omega⟩
      · exact ⟨0,0,0,1,j,by omega,by omega,by omega⟩
      · exact ⟨0,0,1,0,j,by omega,by omega,by omega⟩
      · exact ⟨0,1,0,0,j,by omega,by omega,by omega⟩
lemma factor (j a b : ℕ) (h : a+b=4*j) :
    ∃ n : Fin 5 →₀ ℕ,deg5 n=j ∧
      4*n 0+3*n 1+2*n 2+n 3=a ∧ n 1+2*n 2+3*n 3+4*n 4=b := by
  obtain ⟨n0,n1,n2,n3,n4,hn,ha,hb⟩ := factor_nat j a b h
  refine ⟨Finsupp.equivFunOnFinite.symm ![n0,n1,n2,n3,n4],?_,?_,?_⟩
  · simpa [deg5] using hn
  · simpa using ha
  · simpa using hb
variable {K : Type*} [Field K] [Algebra ℚ K]
def quartic (d e t : K) : WTgt →ₐ[ℚ] K :=
  aeval ![d^4*t⁻¹,d^3*e*t⁻¹,d^2*e^2*t⁻¹,d*e^3*t⁻¹,e^4*t⁻¹]
def eta (d e t : K) : Tri →ₐ[ℚ] K := aeval ![d,e,t]
def theta (d e t : K) (m : ℕ) : Tri →ₗ[ℚ] K :=
  (LinearMap.mulRight ℚ (t⁻¹^m)).comp (eta d e t).toLinearMap
lemma quartic_monomial (d e t : K) (n : Fin 5 →₀ ℕ) (c : ℚ) :
    quartic d e t (monomial n c) =
      algebraMap ℚ K c*d^(4*n 0+3*n 1+2*n 2+n 3)*
        e^(n 1+2*n 2+3*n 3+4*n 4)*t⁻¹^(deg5 n) := by
  simp [quartic,aeval_def,eval₂_monomial,Finsupp.prod_fintype,Fin.prod_univ_succ,
    deg5,pow_add,pow_mul,mul_pow]
  ring
lemma theta_monomial (d e t : K) (m : ℕ) (n : Fin 3 →₀ ℕ) (c : ℚ) :
    theta d e t m (monomial n c) =
      algebraMap ℚ K c*d^(n 0)*e^(n 1)*t^(n 2)*t⁻¹^m := by
  change eta d e t (monomial n c)*t⁻¹^m=_
  have he : eta d e t (monomial n c)=
      algebraMap ℚ K c*(d^(n 0)*e^(n 1)*t^(n 2)) := by
    simp [eta,aeval_def,eval₂_monomial,Finsupp.prod_fintype,
      Fin.prod_univ_succ,mul_assoc]
  rw [he]
  ring
lemma cancel_powers (t : K) (ht : t≠0) (a b : ℕ) :
    t^a*t⁻¹^(a+b)=t⁻¹^b := by
  rw [pow_add,←mul_assoc,←mul_pow,mul_inv_cancel₀ ht,one_pow,one_mul]
lemma weighted_monomial_lift (d e t : K) (ht : t≠0)
    (m : ℕ) (n : Fin 3 →₀ ℕ) (hw : Finsupp.weight wt n=4*m) (c : ℚ) :
    ∃ p ∈ restrictTotalDegree (Fin 5) ℚ m,
      quartic d e t p=theta d e t m (monomial n c) := by
  rw [wt_apply] at hw
  have hnm : n 2 ≤ m := by omega
  obtain ⟨a,ha,hd,he⟩ := factor (m-n 2) (n 0) (n 1) (by omega)
  refine ⟨monomial a c,?_,?_⟩
  · rw [mem_restrictTotalDegree]
    apply le_trans (totalDegree_monomial_le _ _)
    change (a.sum (fun _ k => k)) ≤ m
    have hs : a.sum (fun _ k => k)=deg5 a := by
      simp [Finsupp.sum_fintype,Fin.sum_univ_succ,deg5,Nat.add_assoc]
    rw [hs,ha]
    omega
  · rw [quartic_monomial,theta_monomial,ha,hd,he]
    have hm : m=n 2+(m-n 2) := by omega
    have ht' : t^(n 2)*t⁻¹^m=t⁻¹^(m-n 2) := by
      nth_rw 1 [hm]
      exact cancel_powers t ht (n 2) (m-n 2)
    calc
      _=algebraMap ℚ K c*d^(n 0)*e^(n 1)*(t^(n 2)*t⁻¹^m) := by
        rw [ht']
      _=_ := by ring

lemma deg5_eq_sum (a : Fin 5 →₀ ℕ) :
    deg5 a=a.sum (fun _ k => k) := by
  simp [Finsupp.sum_fintype,Fin.sum_univ_succ,deg5,Nat.add_assoc]
lemma quartic_monomial_lift (d e t : K) (ht : t≠0)
    (m : ℕ) (a : Fin 5 →₀ ℕ) (ha : deg5 a ≤ m) (c : ℚ) :
    ∃ p ∈ weightedHomogeneousSubmodule ℚ wt (4*m),
      theta d e t m p=quartic d e t (monomial a c) := by
  let n : Fin 3 →₀ ℕ := Finsupp.equivFunOnFinite.symm
    ![4*a 0+3*a 1+2*a 2+a 3,a 1+2*a 2+3*a 3+4*a 4,m-deg5 a]
  have hn0 : n 0=4*a 0+3*a 1+2*a 2+a 3 := by simp [n]
  have hn1 : n 1=a 1+2*a 2+3*a 3+4*a 4 := by simp [n]
  have hn2 : n 2=m-deg5 a := by simp [n]
  have hw : Finsupp.weight wt n=4*m := by
    rw [wt_apply,hn0,hn1,hn2]
    dsimp [deg5] at ha ⊢
    omega
  refine ⟨monomial n c,?_,?_⟩
  · rw [mem_weightedHomogeneousSubmodule]
    exact isWeightedHomogeneous_monomial wt n c hw
  · rw [theta_monomial,quartic_monomial,hn0,hn1,hn2]
    have hm : m=(m-deg5 a)+deg5 a := by omega
    calc
      _=(algebraMap ℚ K c*d^(4*a 0+3*a 1+2*a 2+a 3)*e^(a 1+2*a 2+3*a 3+4*a 4))*
        (t^(m-deg5 a)*t⁻¹^m) := by ring
      _=_ := by
        have hc := cancel_powers t ht (m-deg5 a) (deg5 a)
        rw [←hm] at hc
        rw [hc]

theorem filtered_image_eq (d e t : K) (ht : t≠0) (m : ℕ) :
    Submodule.map (quartic d e t).toLinearMap (restrictTotalDegree (Fin 5) ℚ m)=
      Submodule.map (theta d e t m) (weightedHomogeneousSubmodule ℚ wt (4*m)) := by
  classical
  apply le_antisymm
  · rw [Submodule.map_le_iff_le_comap]
    intro f hf
    rw [Submodule.mem_comap]
    rw [mem_restrictTotalDegree] at hf
    rw [f.as_sum,map_sum]
    apply Submodule.sum_mem
    intro a ha
    have had : deg5 a ≤ m := by
      rw [deg5_eq_sum]
      exact (le_totalDegree ha).trans hf
    obtain ⟨p,hp,heq⟩ := quartic_monomial_lift d e t ht m a had (coeff a f)
    exact Submodule.mem_map.mpr ⟨p,hp,heq⟩
  · rw [Submodule.map_le_iff_le_comap]
    intro f hf
    rw [Submodule.mem_comap]
    have hfw : IsWeightedHomogeneous wt f (4*m) :=
      (mem_weightedHomogeneousSubmodule ℚ wt (4*m) f).mp hf
    rw [f.as_sum,map_sum]
    apply Submodule.sum_mem
    intro a ha
    have haw : Finsupp.weight wt a=4*m :=
      hfw (mem_support_iff.mp ha)
    obtain ⟨p,hp,heq⟩ := weighted_monomial_lift d e t ht m a haw (coeff a f)
    exact Submodule.mem_map.mpr ⟨p,hp,heq⟩

end
end A6WeightedImagePrivate

namespace A6ActualHilbertTransportPrivate
open MvPolynomial
noncomputable section
lemma finrank_map_mk_ker {A B : Type*} [CommRing A] [CommRing B]
    [Algebra ℚ A] [Algebra ℚ B] (f : A →ₐ[ℚ] B) (W : Submodule ℚ A) :
    Module.finrank ℚ (W.map (Ideal.Quotient.mkₐ ℚ (RingHom.ker f)).toLinearMap)=
      Module.finrank ℚ (W.map f.toLinearMap) := by
  have hf : f.toLinearMap=(Ideal.kerLiftAlg f).toLinearMap.comp
      (Ideal.Quotient.mkₐ ℚ (RingHom.ker f)).toLinearMap := by
    apply LinearMap.ext
    intro x
    exact (Ideal.kerLiftAlg_mk f x).symm
  have hinj : Function.Injective (Ideal.kerLiftAlg f).toLinearMap := by
    intro x y hxy
    exact Ideal.kerLiftAlg_injective f hxy
  rw [hf,Submodule.map_comp]
  exact LinearEquiv.finrank_eq
    (Submodule.equivMapOfInjective (Ideal.kerLiftAlg f).toLinearMap hinj _)

end
end A6ActualHilbertTransportPrivate

namespace A6KernelContractionPrivate
lemma cancel_prime_power {R : Type*} [CommRing R] [IsDomain R]
    (d H p : R) (hd : Prime d) (hH : ¬d∣H) (n : ℕ)
    (h : H∣d^n*p) : H∣p := by
  induction n with
  | zero => simpa using h
  | succ n ih =>
    obtain ⟨q,hq⟩ := h
    have hdq : d∣H*q := by
      rw [←hq,pow_succ]
      exact ⟨d^n*p,by ring⟩
    have hq' : d∣q := (hd.dvd_or_dvd hdq).resolve_left hH
    obtain ⟨q',rfl⟩ := hq'
    apply ih
    refine ⟨q',?_⟩
    apply mul_left_cancel₀ hd.ne_zero
    calc
      d*(d^n*p)=d^(n+1)*p := by ring
      _=H*(d*q') := hq
      _=d*(H*q') := by ring
end A6KernelContractionPrivate

namespace A6KernelContractionPrivate
noncomputable section
lemma away_dvd_contract {R : Type*} [CommRing R] [IsDomain R]
    (d H p : R) (hd : Prime d) (hH : ¬d∣H)
    (h : algebraMap R (Localization.Away d) H ∣
      algebraMap R (Localization.Away d) p) : H∣p := by
  obtain ⟨q,hq⟩ := h
  obtain ⟨⟨r,s⟩,hs⟩ := IsLocalization.surj (Submonoid.powers d) q
  obtain ⟨n,hn⟩ := s.property
  have hi : Function.Injective (algebraMap R (Localization.Away d)) :=
    IsLocalization.injective (Localization.Away d)
      (powers_le_nonZeroDivisors_of_noZeroDivisors hd.ne_zero)
  have hdiv : H∣d^n*p := by
    refine ⟨r,hi ?_⟩
    simp only [map_mul,map_pow]
    rw [hq]
    have hs' : q*(algebraMap R (Localization.Away d) d)^n=
      algebraMap R (Localization.Away d) r := by
      simpa only [←hn,map_pow] using hs
    calc
      _=algebraMap R (Localization.Away d) H*
        (q*(algebraMap R (Localization.Away d) d)^n) := by ring
      _=_ := by rw [hs']
  exact cancel_prime_power d H p hd hH n hdiv
open MvPolynomial
abbrev Tri := MvPolynomial (Fin 3) ℚ
abbrev Away := Localization.Away (X (0:Fin 3) : Tri)
def am : Tri →+* Away := algebraMap Tri Away
def x (i : Fin 3) : Away := am (X i)
def di : Away := IsLocalization.Away.invSelf (X (0:Fin 3) : Tri)
def sub : Tri →+* Tri := eval₂Hom C ![X 0,X 1,X 1^4-X 0^4*X 2]
def down : Tri →+* Away :=
  eval₂Hom (am.comp C) ![x 0,x 1,(x 1^4-x 2)*di^4]
lemma x_di : x 0*di=1 :=
  IsLocalization.Away.mul_invSelf (X (0:Fin 3) : Tri)
lemma down_sub : down.comp sub=am := by
  apply MvPolynomial.ringHom_ext
  · intro c
    have heq : (down.comp sub).comp C=am.comp C := Subsingleton.elim _ _
    exact congrArg (fun f : ℚ →+* Away => f c) heq
  · intro i
    fin_cases i
    · simp [down,sub,x]
    · simp [down,sub,x]
    · simp [RingHom.comp_apply,sub,down]
      change x 1^4-x 0^4*((x 1^4-x 2)*di^4)=x 2
      calc
        _=x 1^4-(x 1^4-x 2)*(x 0*di)^4 := by ring
        _=_ := by rw [x_di]; ring
abbrev Four := MvPolynomial (Fin 4) ℚ
def dehom : Four →+* Tri := eval₂Hom C ![X 0,X 1,X 2,1]
def clearH : Four →+* Tri := eval₂Hom C ![X 0,X 1,X 1^4-X 2,X 0^4]
def hdMap : Four →+* Away :=
  eval₂Hom (am.comp C) ![x 0,x 1,x 1^4-x 2,x 0^4]
def gdMap : Four →+* Away :=
  eval₂Hom (am.comp C) ![x 0,x 1,(x 1^4-x 2)*di^4,1]
lemma am_clearH : am.comp clearH=hdMap := by
  apply MvPolynomial.ringHom_ext
  · intro c
    have heq : (am.comp clearH).comp C=hdMap.comp C := Subsingleton.elim _ _
    exact congrArg (fun f : ℚ →+* Away => f c) heq
  · intro i
    fin_cases i <;> simp [clearH,hdMap,x]
lemma down_dehom : down.comp dehom=gdMap := by
  apply MvPolynomial.ringHom_ext
  · intro c
    have heq : (down.comp dehom).comp C=gdMap.comp C := Subsingleton.elim _ _
    exact congrArg (fun f : ℚ →+* Away => f c) heq
  · intro i
    fin_cases i <;> simp [dehom,gdMap,down]
lemma eval_scale {R : Type*} [CommRing R] (p : MvPolynomial (Fin 4) R)
    (alpha beta : ℕ)
    (hp : ∀ m ∈ p.support,m 0+m 1=alpha ∧ m 2+m 3=beta)
    (a b c d g h : R) :
    eval ![g*a,g*b,h*c,h*d] p=
      g^alpha*h^beta*eval ![a,b,c,d] p := by
  rw [eval_eq',eval_eq',Finset.mul_sum]
  refine Finset.sum_congr rfl (fun m hm => ?_)
  obtain ⟨h1,h2⟩ := hp m hm
  rw [Fin.prod_univ_four,Fin.prod_univ_four]
  show coeff m p*((g*a)^m 0*(g*b)^m 1*(h*c)^m 2*(h*d)^m 3)=
    g^alpha*h^beta*(coeff m p*(a^m 0*b^m 1*c^m 2*d^m 3))
  rw [←h1,←h2]
  ring
lemma clearH_down (g : Four) (alpha : ℕ)
    (hg : ∀ m ∈ g.support,m 0+m 1=alpha ∧ m 2+m 3=2) :
    am (clearH g)=x 0^8*down (dehom g) := by
  have hmap : ∀ m ∈ (MvPolynomial.map (am.comp C) g).support,
      m 0+m 1=alpha ∧ m 2+m 3=2 := by
    intro m hm
    exact hg m (support_map_subset _ _ hm)
  have hs := eval_scale (MvPolynomial.map (am.comp C) g) alpha 2 hmap
    (x 0) (x 1) ((x 1^4-x 2)*di^4) 1 1 (x 0^4)
  have hprod : x 0^4*((x 1^4-x 2)*di^4)=x 1^4-x 2 := by
    calc
      _=(x 1^4-x 2)*(x 0*di)^4 := by ring
      _=_ := by rw [x_di]; ring
  simp only [one_mul,one_pow,mul_one,hprod] at hs
  have hh : am (clearH g)=hdMap g := congrArg (fun f : Four →+* Away => f g) am_clearH
  have hd : down (dehom g)=gdMap g := congrArg (fun f : Four →+* Away => f g) down_dehom
  rw [hh,hd]
  change eval₂ (am.comp C) ![x 0,x 1,x 1^4-x 2,x 0^4] g=
    x 0^8*eval₂ (am.comp C) ![x 0,x 1,(x 1^4-x 2)*di^4,1] g
  rw [←pow_mul] at hs
  norm_num only at hs
  change eval₂ (RingHom.id Away) _ (MvPolynomial.map (am.comp C) g)=
    x 0^8*eval₂ (RingHom.id Away) _ (MvPolynomial.map (am.comp C) g) at hs
  simpa only [eval₂_map,RingHom.id_comp] using hs

lemma triangular_contraction (g : Four) (alpha : ℕ)
    (hg : ∀ m ∈ g.support,m 0+m 1=alpha ∧ m 2+m 3=2)
    (p H0 : Tri) (nu : ℕ) (hH : clearH g=X 0^nu*H0)
    (hcontent : ¬(X (0:Fin 3) : Tri)∣H0)
    (hdiv : dehom g∣sub p) : H0∣p := by
  apply away_dvd_contract (X (0:Fin 3) : Tri) H0 p X_prime hcontent
  have hdp : down (dehom g)∣am p := by
    have hm := map_dvd down hdiv
    have heq := congrArg (fun f : Tri →+* Away => f p) down_sub
    change down (dehom g)∣down (sub p) at hm
    change down (sub p)=am p at heq
    rw [heq] at hm
    exact hm
  have heq : down (dehom g)=am (clearH g)*di^8 := by
    rw [clearH_down g alpha hg]
    calc
      down (dehom g)=down (dehom g)*(x 0*di)^8 := by rw [x_di]; ring
      _=_ := by ring
  have hdH' : am (clearH g)∣am p := by
    rw [heq] at hdp
    exact (dvd_mul_right _ _).trans hdp
  rw [hH,map_mul,map_pow] at hdH'
  exact (dvd_mul_left _ _).trans hdH'

def surface : Four := X 1^4*X 3-X 0^4*X 2
def clearDenom (p : Tri) (M : ℕ) : Four :=
  ∑ m ∈ p.support,
    C (coeff m p)*X 0^(m 0)*X 1^(m 1)*surface^(m 2)*X 3^(M-m 2)
lemma dehom_clearDenom (p : Tri) (M : ℕ) :
    dehom (clearDenom p M)=sub p := by
  classical
  unfold clearDenom
  rw [map_sum]
  conv_rhs => rw [p.as_sum,map_sum]
  apply Finset.sum_congr rfl
  intro m hm
  have hs : sub (monomial m (coeff m p))=
      C (coeff m p)*X 0^(m 0)*X 1^(m 1)*(X 1^4-X 0^4*X 2)^(m 2) := by
    change eval₂ C ![X 0,X 1,X 1^4-X 0^4*X 2] (monomial m (coeff m p))=_
    rw [eval₂_monomial]
    simp [Finsupp.prod_fintype,Fin.prod_univ_succ,mul_assoc]
  rw [hs]
  simp [dehom,surface,mul_assoc]
variable {K : Type*} [Field K] [Algebra ℚ K]
def eval4 (d e u v : K) : Four →ₐ[ℚ] K := aeval ![d,e,u,v]
def eta (d e t : K) : Tri →ₐ[ℚ] K := aeval ![d,e,t]
lemma clearDenom_eval (p : Tri) (M : ℕ) (hM : ∀ m ∈ p.support,m 2≤M)
    (d e u v : K) (hv : v≠0) :
    eval4 d e u v (clearDenom p M)=
      v^M*eta d e ((e^4*v-d^4*u)/v) p := by
  classical
  unfold clearDenom
  rw [map_sum]
  conv_rhs => rw [p.as_sum,map_sum,Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro m hm
  have hmc := hM m hm
  have hpow : v^M=v^(m 2)*v^(M-m 2) := by rw [←pow_add,Nat.add_sub_of_le hmc]
  simp [eval4,eta,surface,aeval_def,eval₂_monomial,
    Finsupp.prod_fintype,Fin.prod_univ_succ,div_pow,mul_pow]
  rw [hpow]
  have hcancel : v^(m 2)*(v^(m 2))⁻¹=1 :=
    mul_inv_cancel₀ (pow_ne_zero _ hv)
  field_simp [hv] <;> ring

lemma eta_clearH (g : Four) (d e t : K) :
    (eta d e t).toRingHom.comp clearH=
      eval₂Hom (algebraMap ℚ K) ![d,e,e^4-t,d^4] := by
  apply MvPolynomial.ringHom_ext
  · intro c
    have heq : ((eta d e t).toRingHom.comp clearH).comp C=
        (eval₂Hom (algebraMap ℚ K) ![d,e,e^4-t,d^4]).comp C :=
      Subsingleton.elim _ _
    exact congrArg (fun f : ℚ →+* K => f c) heq
  · intro i
    fin_cases i <;> simp [eta,clearH,aeval_def]
lemma eta_clearH_zero (g : Four) (alpha : ℕ)
    (hg : ∀ m ∈ g.support,m 0+m 1=alpha ∧ m 2+m 3=2)
    (d e u v : K) (hv : v≠0) (hzero : eval4 d e u v g=0) :
    eta d e ((e^4*v-d^4*u)/v) (clearH g)=0 := by
  let t := (e^4*v-d^4*u)/v
  have hmap : ∀ m ∈ (MvPolynomial.map (algebraMap ℚ K) g).support,
      m 0+m 1=alpha ∧ m 2+m 3=2 := by
    intro m hm
    exact hg m (support_map_subset _ _ hm)
  have hs := eval_scale (MvPolynomial.map (algebraMap ℚ K) g) alpha 2 hmap
    d e u v 1 (d^4/v)
  have hvv : d^4/v*v=d^4 := div_mul_cancel₀ _ hv
  have htu : d^4/v*u=e^4-t := by dsimp [t]; field_simp [hv] <;> ring
  simp only [one_mul,one_pow,mul_one,hvv,htu] at hs
  change eval₂ (RingHom.id K) _ (MvPolynomial.map (algebraMap ℚ K) g)=
    (d^4/v)^2*eval₂ (RingHom.id K) _ (MvPolynomial.map (algebraMap ℚ K) g) at hs
  simp only [eval₂_map,RingHom.id_comp] at hs
  have hzero' : eval₂ (algebraMap ℚ K) ![d,e,u,v] g=0 := hzero
  rw [hzero',mul_zero] at hs
  have heq := congrArg (fun f : Four →+* K => f g) (eta_clearH g d e t)
  change eta d e t (clearH g)=eval₂ (algebraMap ℚ K) ![d,e,e^4-t,d^4] g at heq
  exact heq.trans hs

lemma eta_factor_zero (g : Four) (alpha : ℕ)
    (hg : ∀ m ∈ g.support,m 0+m 1=alpha ∧ m 2+m 3=2)
    (H0 : Tri) (nu : ℕ) (hH : clearH g=X 0^nu*H0)
    (d e u v : K) (hd : d≠0) (hv : v≠0) (hzero : eval4 d e u v g=0) :
    eta d e ((e^4*v-d^4*u)/v) H0=0 := by
  have hz := eta_clearH_zero g alpha hg d e u v hv hzero
  rw [hH,map_mul,map_pow] at hz
  have hx : eta d e ((e^4*v-d^4*u)/v) (X 0)=d := by simp [eta]
  rw [hx] at hz
  exact (mul_eq_zero.mp hz).resolve_left (pow_ne_zero _ hd)

end
end A6KernelContractionPrivate

namespace A6ProjectionPrivate
open MvPolynomial
noncomputable section
abbrev Four := MvPolynomial (Fin 4) ℚ
abbrev Tri := MvPolynomial (Fin 3) ℚ
def projExp (m : Fin 4 →₀ ℕ) : Fin 3 →₀ ℕ :=
  Finsupp.equivFunOnFinite.symm ![m 0+4*m 3,m 1,m 2]
def projectHom : Four →+* Tri := eval₂Hom C ![X 0,X 1,X 2,X 0^4]
def flip : Tri →+* Tri := eval₂Hom C ![X 0,X 1,X 1^4-X 2]
lemma flip_clearHom : flip.comp A6KernelContractionPrivate.clearH=projectHom := by
  apply MvPolynomial.ringHom_ext
  · intro c
    have heq : (flip.comp A6KernelContractionPrivate.clearH).comp C=projectHom.comp C := Subsingleton.elim _ _
    exact congrArg (fun f : ℚ →+* Tri => f c) heq
  · intro i
    fin_cases i <;> simp [flip,A6KernelContractionPrivate.clearH,projectHom] <;> ring
lemma project_monomial (m : Fin 4 →₀ ℕ) (c : ℚ) :
    projectHom (monomial m c)=monomial (projExp m) c := by
  have hl : projectHom (monomial m c)=
      C c*X 0^(m 0)*X 1^(m 1)*X 2^(m 2)*(X 0^4)^(m 3) := by
    change eval₂ C ![X 0,X 1,X 2,X 0^4] (monomial m c)=_
    rw [eval₂_monomial]
    simp [Finsupp.prod_fintype,Fin.prod_univ_succ,mul_assoc]
  have hr : monomial (projExp m) c=
      C c*X 0^(m 0+4*m 3)*X 1^(m 1)*X 2^(m 2) := by
    rw [monomial_eq]
    simp [Finsupp.prod_fintype,Fin.prod_univ_succ,projExp,mul_assoc]
  rw [hl,hr]
  simp only [pow_add,pow_mul]
  ring
lemma projExp_inj (m r : Fin 4 →₀ ℕ)
    (hm : m 2+m 3=2) (hr : r 2+r 3=2) (h : projExp m=projExp r) : m=r := by
  have h0 := congrArg (fun f : Fin 3 →₀ ℕ => f 0) h
  have h1 := congrArg (fun f : Fin 3 →₀ ℕ => f 1) h
  have h2 := congrArg (fun f : Fin 3 →₀ ℕ => f 2) h
  simp [projExp] at h0 h1 h2
  ext i
  fin_cases i <;> simp <;> omega
lemma project_coeff (g : Four)
    (hg : ∀ m ∈ g.support,m 2+m 3=2)
    (m : Fin 4 →₀ ℕ) (hm : m∈g.support) :
    coeff (projExp m) (projectHom g)=coeff m g := by
  classical
  conv_lhs => rw [g.as_sum,map_sum,coeff_sum]
  rw [Finset.sum_eq_single m]
  · simp [project_monomial]
  · intro r hr hrm
    rw [project_monomial,coeff_monomial,if_neg]
    intro heq
    exact hrm (projExp_inj r m (hg r hr) (hg m hm) heq)
  · intro hnot
    exact False.elim (hnot hm)

end
end A6ProjectionPrivate

namespace A6KernelContractionPrivate
open MvPolynomial
noncomputable section
lemma clearH_ne_zero (g : Four) (alpha : ℕ)
    (hg : ∀ m ∈ g.support,m 0+m 1=alpha ∧ m 2+m 3=2)
    (hg0 : g≠0) : clearH g≠0 := by
  intro hz
  obtain ⟨m,hm⟩ := MvPolynomial.ne_zero_iff.mp hg0
  have heq := congrArg (fun f : Four →+* Tri=>f g) A6ProjectionPrivate.flip_clearHom
  have hp : A6ProjectionPrivate.projectHom g=0 := by
    change A6ProjectionPrivate.flip (clearH g)=A6ProjectionPrivate.projectHom g at heq
    rw [hz,map_zero] at heq
    exact heq.symm
  have hc := A6ProjectionPrivate.project_coeff g (fun r hr=>(hg r hr).2)
    m (mem_support_iff.mpr hm)
  rw [hp,coeff_zero] at hc
  exact hm hc.symm
lemma X_power_bound (H : Tri) (hH0 : H≠0) (n : ℕ) (hn : (X (0:Fin 3) : Tri)^n∣H) :
    n≤H.totalDegree := by
  obtain ⟨q,hq⟩ := hn
  have hq0 : q≠0 := by intro hz; apply hH0; rw [hq,hz,mul_zero]
  have hx0 : (X (0:Fin 3) : Tri)≠0 := by simp
  have hd : H.totalDegree=n+q.totalDegree := by
    rw [hq,totalDegree_mul_of_isDomain (pow_ne_zero n hx0) hq0,totalDegree_X_pow]
  omega
lemma exists_content (H : Tri) (hH0 : H≠0) :
    ∃ nu : ℕ, ∃ H0 : Tri,H=X 0^nu*H0 ∧
      ¬(X (0:Fin 3) : Tri)∣H0 ∧
      ∀ n : ℕ,(X (0:Fin 3) : Tri)^n∣H → n≤nu := by
  classical
  let S := (Finset.range (H.totalDegree+1)).filter
    (fun n => (X (0:Fin 3) : Tri)^n∣H)
  have h0 : 0∈S := by simp [S]
  have hne : S.Nonempty := ⟨0,h0⟩
  let nu := S.max' hne
  have hnu : nu∈S := Finset.max'_mem S hne
  have hn : (X (0:Fin 3) : Tri)^nu∣H := (Finset.mem_filter.mp hnu).2
  have hmax : ∀ n : ℕ,(X (0:Fin 3) : Tri)^n∣H → n≤nu := by
    intro n hn
    apply Finset.le_max' S n
    exact Finset.mem_filter.mpr
      ⟨Finset.mem_range.mpr (by have hh := X_power_bound H hH0 n hn; omega),hn⟩
  obtain ⟨H0,hfactor⟩ := hn
  refine ⟨nu,H0,hfactor,?_,hmax⟩
  rintro ⟨q,hq⟩
  have hnext : (X (0:Fin 3) : Tri)^(nu+1)∣H := by
    refine ⟨q,?_⟩
    rw [hfactor,hq,pow_succ]
    ring
  have hh := hmax (nu+1) hnext
  omega

end
end A6KernelContractionPrivate

namespace A6ActualKernelPrivate
open MvPolynomial A6ActualIncidencePrivate A6KernelContractionPrivate
noncomputable section
variable {K : Type*} [Field K] [Algebra ℚ K]
lemma eval4_incidence (g : A6ActualIncidencePrivate.Four)
    (h : Inc g A6ActualBiformPrivate.surface →+* K) :
    (eval4 (h (q g A6ActualBiformPrivate.surface (X 0)))
      (h (q g A6ActualBiformPrivate.surface (X 1)))
      (h (q g A6ActualBiformPrivate.surface (X 2)))
      (h (q g A6ActualBiformPrivate.surface (X 3)))).toRingHom=
      h.comp ((q g A6ActualBiformPrivate.surface).comp embed) := by
  apply MvPolynomial.ringHom_ext
  · intro c
    have hh :
        ((eval4 (h (q g A6ActualBiformPrivate.surface (X 0)))
          (h (q g A6ActualBiformPrivate.surface (X 1)))
          (h (q g A6ActualBiformPrivate.surface (X 2)))
          (h (q g A6ActualBiformPrivate.surface (X 3)))).toRingHom).comp C=
        (h.comp ((q g A6ActualBiformPrivate.surface).comp embed)).comp C :=
      Subsingleton.elim _ _
    exact congrArg (fun f : ℚ →+* K => f c) hh
  · intro i
    fin_cases i <;> simp [eval4,aeval_def,embed]

lemma actual_zero_dvd_clear (alpha : ℕ) (G : FourZ)
    (hdeg : ∀ m ∈ G.support,m 0+m 1=alpha ∧ m 2+m 3=2)
    (hirr : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G))
    (h : Inc (A6ActualBiformPrivate.rationalG G) A6ActualBiformPrivate.surface →+* K)
    (hi : Function.Injective h)
    (p : A6KernelContractionPrivate.Tri)
    (hp :
      eta (h (q (A6ActualBiformPrivate.rationalG G) A6ActualBiformPrivate.surface (X 0)))
        (h (q (A6ActualBiformPrivate.rationalG G) A6ActualBiformPrivate.surface (X 1)))
        (((h (q (A6ActualBiformPrivate.rationalG G) A6ActualBiformPrivate.surface (X 1)))^4*
            h (q (A6ActualBiformPrivate.rationalG G) A6ActualBiformPrivate.surface (X 3))-
          (h (q (A6ActualBiformPrivate.rationalG G) A6ActualBiformPrivate.surface (X 0)))^4*
            h (q (A6ActualBiformPrivate.rationalG G) A6ActualBiformPrivate.surface (X 2)))/
          h (q (A6ActualBiformPrivate.rationalG G) A6ActualBiformPrivate.surface (X 3))) p=0) :
    A6ActualBiformPrivate.rationalG G∣clearDenom p p.totalDegree := by
  let g := A6ActualBiformPrivate.rationalG G
  let f := A6ActualBiformPrivate.surface
  let d := h (q g f (X 0))
  let e := h (q g f (X 1))
  let u := h (q g f (X 2))
  let v := h (q g f (X 3))
  have hv : v≠0 := by
    intro hv0
    apply original_generic_coordinate_ne_zero alpha G hdeg hirr (3:Fin 4)
    apply hi
    simpa [v,f,g,embed] using hv0
  have hM : ∀ m ∈ p.support,m 2≤p.totalDegree := by
    intro m hm
    have ht := le_totalDegree hm
    change (m.sum (fun _ k => k))≤p.totalDegree at ht
    have hs : m.sum (fun _ k => k)=m 0+m 1+m 2 := by
      simp [Finsupp.sum_fintype,Fin.sum_univ_succ,Nat.add_assoc]
    rw [hs] at ht
    omega
  have hce := clearDenom_eval p p.totalDegree hM d e u v hv
  have heq := congrArg
    (fun f : A6ActualIncidencePrivate.Four →+* K => f (clearDenom p p.totalDegree))
    (eval4_incidence g h)
  change eval4 d e u v (clearDenom p p.totalDegree)=
    h (q g f (embed (clearDenom p p.totalDegree))) at heq
  have hz : h (q g f (embed (clearDenom p p.totalDegree)))=0 := by
    rw [←heq,hce]
    change v^p.totalDegree*eta d e ((e^4*v-d^4*u)/v) p=0
    rw [show eta d e ((e^4*v-d^4*u)/v) p=0 from hp,mul_zero]
  have hq : q g f (embed (clearDenom p p.totalDegree))=0 := by
    apply hi
    simpa only [map_zero] using hz
  by_contra hg
  exact q_embed_ne_zero g f (clearDenom p p.totalDegree)
    (A6ActualBiformPrivate.rationalG_irreducible G hirr)
    (A6ActualBiformPrivate.rationalG_not_dvd_surface alpha G hdeg hirr) hg hq
def actualEta (g : A6ActualIncidencePrivate.Four)
    (h : Inc g A6ActualBiformPrivate.surface →+* K) :
    A6KernelContractionPrivate.Tri →ₐ[ℚ] K :=
  eta (h (q g A6ActualBiformPrivate.surface (X 0)))
    (h (q g A6ActualBiformPrivate.surface (X 1)))
    (((h (q g A6ActualBiformPrivate.surface (X 1)))^4*
        h (q g A6ActualBiformPrivate.surface (X 3))-
      (h (q g A6ActualBiformPrivate.surface (X 0)))^4*
        h (q g A6ActualBiformPrivate.surface (X 2)))/
      h (q g A6ActualBiformPrivate.surface (X 3)))

theorem actual_kernel_of_content (alpha : ℕ) (G : FourZ)
    (hdeg : ∀ m ∈ G.support,m 0+m 1=alpha ∧ m 2+m 3=2)
    (hirr : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G))
    (h : Inc (A6ActualBiformPrivate.rationalG G) A6ActualBiformPrivate.surface →+* K)
    (hi : Function.Injective h)
    (H0 : A6KernelContractionPrivate.Tri) (nu : ℕ)
    (hH : clearH (A6ActualBiformPrivate.rationalG G)=X 0^nu*H0)
    (hcontent : ¬(X (0:Fin 3) : A6KernelContractionPrivate.Tri)∣H0) :
    RingHom.ker (actualEta (A6ActualBiformPrivate.rationalG G) h)=
      Ideal.span ({H0} : Set A6KernelContractionPrivate.Tri) := by
  let g := A6ActualBiformPrivate.rationalG G
  let f := A6ActualBiformPrivate.surface
  let d := h (q g f (X 0))
  let e := h (q g f (X 1))
  let u := h (q g f (X 2))
  let v := h (q g f (X 3))
  have hcoord (i : Fin 4) : h (q g f (X i.castSucc))≠0 := by
    intro hx
    apply original_generic_coordinate_ne_zero alpha G hdeg hirr i
    apply hi
    simpa [g,f,embed] using hx
  have hd : d≠0 := hcoord 0
  have hv : v≠0 := hcoord 3
  have hgdeg : ∀ m ∈ g.support,m 0+m 1=alpha ∧ m 2+m 3=2 := by
    intro m hm
    exact hdeg m (support_map_subset _ _ hm)
  have hzero : eval4 d e u v g=0 := by
    have heq := congrArg (fun f : A6ActualIncidencePrivate.Four →+* K => f g)
      (eval4_incidence g h)
    change eval4 d e u v g=h (q g f (embed g)) at heq
    rw [heq,q_g,map_zero]
  have hH0 : actualEta g h H0=0 :=
    eta_factor_zero g alpha hgdeg H0 nu hH d e u v hd hv hzero
  ext p
  rw [Ideal.mem_span_singleton]
  change actualEta g h p=0 ↔ H0∣p
  constructor
  · intro hp
    have hc : g∣clearDenom p p.totalDegree :=
      actual_zero_dvd_clear alpha G hdeg hirr h hi p hp
    have hde := map_dvd dehom hc
    rw [dehom_clearDenom] at hde
    exact triangular_contraction g alpha hgdeg p H0 nu hH hcontent hde
  · rintro ⟨r,rfl⟩
    rw [map_mul,hH0,zero_mul]

lemma clearH_literal (G : FourZ) :
    clearH (A6ActualBiformPrivate.rationalG G)=
      MvPolynomial.eval₂Hom (Int.castRingHom A6KernelContractionPrivate.Tri)
        ![X 0,X 1,X 1^4-X 2,X 0^4] G := by
  have heq :
      clearH.comp (MvPolynomial.map (Int.castRingHom ℚ))=
        MvPolynomial.eval₂Hom (Int.castRingHom A6KernelContractionPrivate.Tri)
          ![X 0,X 1,X 1^4-X 2,X 0^4] := by
    apply MvPolynomial.ringHom_ext
    · intro c
      simp [clearH]
    · intro i
      fin_cases i <;> simp [clearH]
  exact congrArg (fun f : FourZ →+* A6KernelContractionPrivate.Tri => f G) heq

def genericToOriginal (G : FourZ) :
    Inc (A6ActualBiformPrivate.rationalG G) A6ActualBiformPrivate.surface →+*
      (Five ⧸ originalIdeal G) :=
  Ideal.Quotient.lift
    (ideal (A6ActualBiformPrivate.rationalG G) A6ActualBiformPrivate.surface)
    (Ideal.Quotient.mk (originalIdeal G)) (by
      intro p hp
      apply Ideal.Quotient.eq_zero_iff_mem.mpr
      simpa only [originalIdeal_eq G] using hp)
lemma genericToOriginal_injective (G : FourZ) :
    Function.Injective (genericToOriginal G) := by
  intro a b
  refine Quotient.inductionOn₂ a b ?_
  intro p r hpr
  apply (Ideal.Quotient.mk_eq_mk_iff_sub_mem p r).mpr
  have hz : Ideal.Quotient.mk (originalIdeal G) (p-r)=0 := by
    change Ideal.Quotient.mk (originalIdeal G) p=
      Ideal.Quotient.mk (originalIdeal G) r at hpr
    rw [map_sub,hpr,sub_self]
  have hm := Ideal.Quotient.eq_zero_iff_mem.mp hz
  simpa only [originalIdeal_eq G] using hm

def originalEta (G : FourZ) (h : (Five ⧸ originalIdeal G) →+* K) :
    A6KernelContractionPrivate.Tri →ₐ[ℚ] K :=
  eta (h (Ideal.Quotient.mk (originalIdeal G) (X 0)))
    (h (Ideal.Quotient.mk (originalIdeal G) (X 1)))
    (((h (Ideal.Quotient.mk (originalIdeal G) (X 1)))^4*
        h (Ideal.Quotient.mk (originalIdeal G) (X 3))-
      (h (Ideal.Quotient.mk (originalIdeal G) (X 0)))^4*
        h (Ideal.Quotient.mk (originalIdeal G) (X 2)))/
      h (Ideal.Quotient.mk (originalIdeal G) (X 3)))

end
end A6ActualKernelPrivate

namespace A6ActualPrincipalHilbertPrivate
open MvPolynomial A6ActualIncidencePrivate A6ActualKernelPrivate
noncomputable section
variable {K : Type*} [Field K] [Algebra ℚ K]
lemma theta_finrank (d e t : K) (ht : t≠0) (m : ℕ) :
    Module.finrank ℚ
      (Submodule.map (A6WeightedImagePrivate.theta d e t m)
        (weightedHomogeneousSubmodule ℚ A6WeightedImagePrivate.wt (4*m)))=
    Module.finrank ℚ
      (Submodule.map (A6WeightedImagePrivate.eta d e t).toLinearMap
        (weightedHomogeneousSubmodule ℚ A6WeightedImagePrivate.wt (4*m))) := by
  unfold A6WeightedImagePrivate.theta
  rw [Submodule.map_comp]
  have hi : Function.Injective (LinearMap.mulRight ℚ (t⁻¹^m) : K →ₗ[ℚ] K) := by
    intro x y hxy
    change x*t⁻¹^m=y*t⁻¹^m at hxy
    exact mul_right_cancel₀ (pow_ne_zero m (inv_ne_zero ht)) hxy
  exact (LinearEquiv.finrank_eq
    (Submodule.equivMapOfInjective (LinearMap.mulRight ℚ (t⁻¹^m)) hi _)).symm

theorem original_hilbert_principal_weighted (alpha : ℕ) (G : FourZ)
    (hdeg : ∀ m ∈ G.support,m 0+m 1=alpha ∧ m 2+m 3=2)
    (hirr : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G)) :
    ∃ nu : ℕ, ∃ H0 : A6KernelContractionPrivate.Tri,
      A6KernelContractionPrivate.clearH (A6ActualBiformPrivate.rationalG G)=X 0^nu*H0 ∧
      ¬(X (0:Fin 3) : A6KernelContractionPrivate.Tri)∣H0 ∧
      (∀ n : ℕ,(X (0:Fin 3) : A6KernelContractionPrivate.Tri)^n∣
        A6KernelContractionPrivate.clearH (A6ActualBiformPrivate.rationalG G) → n≤nu) ∧
      ∀ m : ℕ,
        Module.finrank ℚ
          (Submodule.map
            (Ideal.Quotient.mkₐ ℚ
              (RingHom.ker (originalPsi G (1 : Matrix (Fin 2) (Fin 2) ℤ)))).toLinearMap
            (restrictTotalDegree (Fin 5) ℚ m))=
        Module.finrank ℚ
          (Submodule.map
            (Ideal.Quotient.mkₐ ℚ
              (Ideal.span ({H0} : Set A6KernelContractionPrivate.Tri))).toLinearMap
            (weightedHomogeneousSubmodule ℚ A6WeightedImagePrivate.wt (4*m))) := by
  let C := Five ⧸ originalIdeal G
  letI : IsDomain C := original_incidence_isDomain alpha G hdeg hirr
  obtain ⟨K,iK,h,hi⟩ :
      ∃ K : Type,∃ iK : Field K,letI := iK
        ∃ h : C→+*K,Function.Injective h := by
    refine ⟨FractionRing C,inferInstance,algebraMap C (FractionRing C),?_⟩
    exact IsLocalization.injective (M:=nonZeroDivisors C) (FractionRing C) le_rfl
  letI := iK
  let c : ℚ →+* K := h.comp (algebraMap ℚ C)
  letI : Algebra ℚ K := c.toAlgebra
  let hA : C →ₐ[ℚ] K := { h with commutes' := fun r=>rfl }
  let q := Ideal.Quotient.mk (originalIdeal G)
  let d := h (q (X 0))
  let e := h (q (X 1))
  let u := h (q (X 2))
  let v := h (q (X 3))
  let z := h (q (X 4))
  let t := (e^4*v-d^4*u)/v
  have hv : v≠0 := by
    intro hz
    have hq : q (X 3)≠0 := by
      change Ideal.Quotient.mk (originalIdeal G) (X (3:Fin 5))≠0
      rw [originalIdeal_eq]
      simpa [A6ActualIncidencePrivate.q,embed] using
        original_generic_coordinate_ne_zero alpha G hdeg hirr (3:Fin 4)
    apply hq
    apply hi
    simpa only [map_zero] using hz
  have hzF : z*(e^4*v-d^4*u)=1 := by
    have hr : q (X 4*originalF5-1)=0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp [originalIdeal]))
    have he := congrArg h hr
    simpa only [q,originalF5,map_sub,map_mul,map_pow,map_one,map_zero,
      sub_eq_zero] using he
  have hF : e^4*v-d^4*u≠0 := by intro hz;rw [hz,mul_zero] at hzF;exact zero_ne_one hzF
  have ht : t≠0 := div_ne_zero hF hv
  have htz : t*(z*v)=1 := by
    calc
      _=(t*v)*z := by ring
      _=(e^4*v-d^4*u)*z := by rw [show t*v=e^4*v-d^4*u from div_mul_cancel₀ _ hv]
      _=1 := by simpa only [mul_comm] using hzF
  have hzv : z*v=t⁻¹ := by
    apply mul_left_cancel₀ ht
    rw [htz,mul_inv_cancel₀ ht]
  have hzv' : h ((Ideal.Quotient.mk (originalIdeal G)) (X 4))*
      h ((Ideal.Quotient.mk (originalIdeal G)) (X 3))=t⁻¹ := hzv
  have hmap : hA.comp (originalPsi G (1:Matrix (Fin 2) (Fin 2) ℤ))=
      A6WeightedImagePrivate.quartic d e t := by
    apply MvPolynomial.algHom_ext
    intro i
    fin_cases i <;>
      simp [AlgHom.comp_apply,originalPsi,A6WeightedImagePrivate.quartic,
        aeval_def,hA,d,e,z,q,Matrix.one_apply,map_mul,map_pow,map_add,hzv'] <;> ring
  have hgdeg : ∀m∈(A6ActualBiformPrivate.rationalG G).support,
      m 0+m 1=alpha ∧ m 2+m 3=2 := by
    intro m hm
    exact hdeg m (support_map_subset _ _ hm)
  have hclear := A6KernelContractionPrivate.clearH_ne_zero
    (A6ActualBiformPrivate.rationalG G) alpha hgdeg
    (A6ActualBiformPrivate.rationalG_irreducible G hirr).ne_zero
  obtain ⟨nu,H0,hH,hcontent,hmax⟩ :=
    A6KernelContractionPrivate.exists_content _ hclear
  let hgen := h.comp (genericToOriginal G)
  have hker := actual_kernel_of_content alpha G hdeg hirr hgen
    (hi.comp (genericToOriginal_injective G)) H0 nu hH hcontent
  change RingHom.ker (originalEta G h)=Ideal.span {H0} at hker
  refine ⟨nu,H0,hH,hcontent,hmax,?_⟩
  intro m
  have heqEta : A6WeightedImagePrivate.eta d e t=originalEta G h := rfl
  rw [A6ActualHilbertTransportPrivate.finrank_map_mk_ker]
  have himage := A6WeightedImagePrivate.filtered_image_eq d e t ht m
  rw [←hmap,AlgHom.comp_toLinearMap,Submodule.map_comp] at himage
  calc
    _=Module.finrank ℚ
        (Submodule.map (A6WeightedImagePrivate.theta d e t m)
          (weightedHomogeneousSubmodule ℚ A6WeightedImagePrivate.wt (4*m))) := by
      rw [←himage]
      exact LinearEquiv.finrank_eq (Submodule.equivMapOfInjective hA.toLinearMap hi _)
    _=Module.finrank ℚ
        (Submodule.map (A6WeightedImagePrivate.eta d e t).toLinearMap
          (weightedHomogeneousSubmodule ℚ A6WeightedImagePrivate.wt (4*m))) :=
      theta_finrank d e t ht m
    _=Module.finrank ℚ
        (Submodule.map
          (Ideal.Quotient.mkₐ ℚ (RingHom.ker (A6WeightedImagePrivate.eta d e t))).toLinearMap
          (weightedHomogeneousSubmodule ℚ A6WeightedImagePrivate.wt (4*m))) :=
      (A6ActualHilbertTransportPrivate.finrank_map_mk_ker
        (A6WeightedImagePrivate.eta d e t) _).symm
    _=_ := by rw [heqEta,hker]
end
end A6ActualPrincipalHilbertPrivate

namespace A6WeightedHilbertPrivate
open MvPolynomial
noncomputable section
abbrev Tri := MvPolynomial (Fin 3) ℚ
def wt : Fin 3 → ℕ := ![1,1,4]
def piece (n : ℕ) : Submodule ℚ Tri := weightedHomogeneousSubmodule ℚ wt n
lemma wt_apply (m : Fin 3 →₀ ℕ) :
    Finsupp.weight wt m=m 0+m 1+4*m 2 := by
  simp [Finsupp.weight_apply,Finsupp.sum_fintype,Fin.sum_univ_succ,wt]
  omega
def degreeSet (n : ℕ) : Set (Fin 3 →₀ ℕ) := {m | Finsupp.weight wt m=n}
abbrev Index (n : ℕ) := (c : Fin (n/4+1)) × Fin (n-4*c.val+1)
def degreeEquiv (n : ℕ) : degreeSet n ≃ Index n where
  toFun m := ⟨⟨m.1 2,by have h:=m.2;simp only [degreeSet,Set.mem_ofPred_eq,wt_apply] at h;omega⟩,
    ⟨m.1 0,by
      change m.1 0<n-4*(m.1 2)+1
      have h:=m.2
      simp only [degreeSet,Set.mem_ofPred_eq,wt_apply] at h
      omega⟩⟩
  invFun ij := ⟨Finsupp.equivFunOnFinite.symm
    ![ij.2.val,n-4*ij.1.val-ij.2.val,ij.1.val],by
      simp only [degreeSet,Set.mem_ofPred_eq,wt_apply]
      have hc := ij.1.isLt
      have ha := ij.2.isLt
      simp
      omega⟩
  left_inv m := by
    obtain ⟨m,hm⟩ := m
    simp only [degreeSet,Set.mem_ofPred_eq,wt_apply] at hm
    apply Subtype.ext
    ext i
    fin_cases i <;> simp <;> omega
  right_inv ij := by
    obtain ⟨c,a⟩ := ij
    rfl
noncomputable instance degreeSetFintype (n : ℕ) : Fintype (degreeSet n) :=
  Fintype.ofEquiv (Index n) (degreeEquiv n).symm
def N (n : ℕ) : ℕ := ∑ c : Fin (n/4+1),(n-4*c.val+1)
lemma finrank_piece (n : ℕ) : Module.finrank ℚ (piece n)=N n := by
  have heq : piece n=restrictSupport ℚ (degreeSet n) :=
    weightedHomogeneousSubmodule_eq_finsupp_supported ℚ wt n
  rw [heq]
  have hr := Module.finrank_eq_card_basis (basisRestrictSupport ℚ (degreeSet n))
  rw [hr,Fintype.card_congr (degreeEquiv n)]
  simp [N,Fintype.card_sigma]
lemma N_recur (n : ℕ) : N (n+4)=N n+n+5 := by
  unfold N
  have hq : (n+4)/4+1=(n/4+1)+1 := by omega
  rw [hq,Fin.sum_univ_succ]
  simp only [Fin.val_zero,Nat.mul_zero,Nat.sub_zero,Fin.val_succ]
  have hs : (∑ i : Fin (n/4+1),(n+4-4*(i.val+1)+1))=
      ∑ i : Fin (n/4+1),(n-4*i.val+1) := by
    apply Finset.sum_congr rfl
    intro i hi
    omega
  rw [hs]
  omega
instance pieceFinite (n : ℕ) : Module.Finite ℚ (piece n) := by
  have heq : piece n=restrictSupport ℚ (degreeSet n) :=
    weightedHomogeneousSubmodule_eq_finsupp_supported ℚ wt n
  rw [heq]
  exact Module.Finite.of_basis (basisRestrictSupport ℚ (degreeSet n))
lemma quot_homog (H q : Tri) (L n : ℕ)
    (hH : IsWeightedHomogeneous wt H L) (hH0 : H≠0)
    (hp : IsWeightedHomogeneous wt (H*q) n) :
    IsWeightedHomogeneous wt q (n-L) :=
  A6GenericWeightedPrivate.quot_homog wt H q L n hH hH0 hp
def Qrank (H : Tri) (n : ℕ) : ℕ :=
  Module.finrank ℚ
    (Submodule.map (Ideal.Quotient.mkₐ ℚ (Ideal.span ({H} : Set Tri))).toLinearMap (piece n))
theorem rank_add (H : Tri) (L n : ℕ)
    (hH : IsWeightedHomogeneous wt H L) (hH0 : H≠0) (hLn : L ≤ n) :
    Qrank H n+N (n-L)=N n := by
  have hmem (q : Tri) : q∈piece (n-L) ↔ H*q∈piece n := by
    constructor
    · intro hq
      have hh := hH.mul ((mem_weightedHomogeneousSubmodule ℚ wt (n-L) q).mp hq)
      change IsWeightedHomogeneous wt (H*q) n
      convert hh using 1 <;> omega
    · intro hq
      exact quot_homog H q L n hH hH0
        ((mem_weightedHomogeneousSubmodule ℚ wt n (H*q)).mp hq)
  have hr := A6PrincipalRankPrivate.principal_rank_add H hH0
    (piece n) (piece (n-L)) hmem
  rw [finrank_piece,finrank_piece] at hr
  exact hr

theorem rank_recur (H : Tri) (L m : ℕ)
    (hH : IsWeightedHomogeneous wt H L) (hH0 : H≠0) (hLm : L≤4*m) :
    Qrank H (4*(m+1))=Qrank H (4*m)+L := by
  have h1 := rank_add H L (4*m) hH hH0 hLm
  have h2 := rank_add H L (4*(m+1)) hH hH0 (by omega)
  have hn : N (4*(m+1))=N (4*m)+4*m+5 := by
    simpa only [Nat.mul_add,Nat.mul_one] using N_recur (4*m)
  have hs : 4*(m+1)-L=(4*m-L)+4 := by omega
  rw [hn,hs,N_recur] at h2
  omega
theorem eventual_rank (H : Tri) (L : ℕ)
    (hH : IsWeightedHomogeneous wt H L) (hH0 : H≠0) :
    ∃ b : ℤ,∀ m : ℕ,L ≤ m →
      (Qrank H (4*m):ℤ)=(L:ℤ)*m+b := by
  refine ⟨(Qrank H (4*L):ℤ)-(L:ℤ)*L,?_⟩
  intro m hm
  induction m,hm using Nat.le_induction with
  | base => ring
  | succ m hm ih =>
    have hr := rank_recur H L m hH hH0 (by omega)
    rw [hr,Nat.cast_add,ih,Nat.cast_add,Nat.cast_one]
    ring

abbrev Four := MvPolynomial (Fin 4) ℚ
def clearHom : Four →+* Tri := eval₂Hom C ![X 0,X 1,X 1^4-X 2,X 0^4]
lemma clearHom_monomial (m : Fin 4 →₀ ℕ) (c : ℚ) :
    clearHom (monomial m c)=
      C c*X 0^(m 0)*X 1^(m 1)*(X 1^4-X 2)^(m 2)*(X 0^4)^(m 3) := by
  change eval₂ C ![X 0,X 1,X 1^4-X 2,X 0^4] (monomial m c)=_
  rw [eval₂_monomial]
  simp [Finsupp.prod_fintype,Fin.prod_univ_succ,mul_assoc]
lemma clearHom_weighted (g : Four) (alpha : ℕ)
    (hg : ∀ m ∈ g.support,m 0+m 1=alpha ∧ m 2+m 3=2) :
    IsWeightedHomogeneous wt (clearHom g) (alpha+8) := by
  classical
  have hd : IsWeightedHomogeneous wt (X (0:Fin 3) : Tri) 1 := by
    simpa [wt] using isWeightedHomogeneous_X ℚ wt (0:Fin 3)
  have he : IsWeightedHomogeneous wt (X (1:Fin 3) : Tri) 1 := by
    simpa [wt] using isWeightedHomogeneous_X ℚ wt (1:Fin 3)
  have hT : IsWeightedHomogeneous wt (X (2:Fin 3) : Tri) 4 := by
    simpa [wt] using isWeightedHomogeneous_X ℚ wt (2:Fin 3)
  have hE : IsWeightedHomogeneous wt (X 1^4-X 2 : Tri) 4 := (he.pow 4).sub hT
  apply (mem_weightedHomogeneousSubmodule ℚ wt (alpha+8) _).mp
  rw [g.as_sum,map_sum]
  apply Submodule.sum_mem
  intro m hm
  rw [mem_weightedHomogeneousSubmodule,clearHom_monomial]
  have hh := ((((isWeightedHomogeneous_C wt (coeff m g)).mul (hd.pow (m 0))).mul
    (he.pow (m 1))).mul (hE.pow (m 2))).mul ((hd.pow 4).pow (m 3))
  obtain ⟨h1,h2⟩ := hg m hm
  convert hh using 1 <;> simp [smul_eq_mul] <;> omega
lemma content_weighted (g : Four) (alpha nu : ℕ) (H0 : Tri)
    (hg : ∀ m ∈ g.support,m 0+m 1=alpha ∧ m 2+m 3=2)
    (hH : clearHom g=X 0^nu*H0) :
    IsWeightedHomogeneous wt H0 (alpha+8-nu) := by
  have hx : IsWeightedHomogeneous wt (X (0:Fin 3) : Tri) 1 := by
    simpa [wt] using isWeightedHomogeneous_X ℚ wt (0:Fin 3)
  have hp : IsWeightedHomogeneous wt (X (0:Fin 3)^nu : Tri) nu := by simpa using hx.pow nu
  have hh := clearHom_weighted g alpha hg
  rw [hH] at hh
  exact quot_homog (X 0^nu) H0 nu (alpha+8) hp (pow_ne_zero nu (by simp)) hh

lemma power_div_support_lower (p : Tri) (nu : ℕ)
    (hdiv : (X (0:Fin 3) : Tri)^nu∣p)
    (m : Fin 3 →₀ ℕ) (hm : m∈p.support) : nu ≤ m 0 := by
  classical
  obtain ⟨q,hq⟩ := hdiv
  have hc : coeff m p≠0 := mem_support_iff.mp hm
  have hxpow : (X (0:Fin 3) : Tri)^nu=monomial (Finsupp.single 0 nu) 1 := by
    simp [monomial_eq,Finsupp.prod_fintype,Fin.prod_univ_succ]
  by_contra hle
  apply hc
  rw [hq,coeff_mul]
  apply Finset.sum_eq_zero
  intro x hx
  have hs : x.1+x.2=m := Finset.HasAntidiagonal.mem_antidiagonal.mp hx
  have hn : Finsupp.single (0:Fin 3) nu≠x.1 := by
    intro heq
    have hh := congrArg (fun f : Fin 3 →₀ ℕ => f 0) hs
    rw [←heq] at hh
    simp at hh
    omega
  rw [hxpow,coeff_monomial,if_neg hn,zero_mul]
lemma X3_dvd_of_support (g : Four) (hg : ∀ m ∈ g.support,1 ≤ m 3) :
    (X (3:Fin 4) : Four)∣g := by
  classical
  rw [g.as_sum]
  apply Finset.dvd_sum
  intro m hm
  have hpos := hg m hm
  have hpow : (X (3:Fin 4) : Four)^(m 3-1)*X 3=X 3^(m 3) := by
    rw [←pow_succ]
    congr 1
    omega
  have hmono : monomial m (coeff m g)=C (coeff m g)*
      (X 0^(m 0)*X 1^(m 1)*X 2^(m 2)*X 3^(m 3)) := by
    rw [monomial_eq,Finsupp.prod_fintype _ _ (by intro i;simp)]
    simp [Fin.prod_univ_four,mul_assoc]
  rw [hmono]
  refine ⟨C (coeff m g)*X 0^(m 0)*X 1^(m 1)*X 2^(m 2)*X 3^(m 3-1),?_⟩
  calc
    (C (coeff m g):Four)*(X 0^(m 0)*X 1^(m 1)*X 2^(m 2)*X 3^(m 3))=
      (C (coeff m g)*X 0^(m 0)*X 1^(m 1)*X 2^(m 2))*
        (X 3^(m 3-1)*X 3) := by rw [hpow]; ring
    _=X 3*(C (coeff m g)*X 0^(m 0)*X 1^(m 1)*X 2^(m 2)*X 3^(m 3-1)) := by ring
open A6ProjectionPrivate

theorem content_bound (g : Four) (alpha nu : ℕ)
    (hg : ∀ m ∈ g.support,m 0+m 1=alpha ∧ m 2+m 3=2)
    (hirr : Irreducible g) (hnot : ¬g∣X (3:Fin 4))
    (hdiv : (X (0:Fin 3) : Tri)^nu∣clearHom g) : nu ≤ alpha := by
  have hvnot : ¬(X (3:Fin 4) : Four)∣g := by
    intro hv
    exact hnot ((X_prime : Prime (X (3:Fin 4) : Four)).irreducible.dvd_symm hirr hv)
  have hproj : (X (0:Fin 3) : Tri)^nu∣projectHom g := by
    have hh := map_dvd flip hdiv
    have heq := congrArg (fun f : Four →+* Tri => f g) flip_clearHom
    change flip (clearHom g)=projectHom g at heq
    rw [heq] at hh
    simpa [A6ProjectionPrivate.flip] using hh
  by_contra hnu
  apply hvnot
  apply X3_dvd_of_support g
  intro m hm
  have hc := project_coeff g (fun r hr => (hg r hr).2) m hm
  have hp : projExp m∈(projectHom g).support := by
    rw [mem_support_iff,hc]
    exact mem_support_iff.mp hm
  have hlow := power_div_support_lower (projectHom g) nu hproj (projExp m) hp
  simp [projExp] at hlow
  obtain ⟨h1,h2⟩ := hg m hm
  omega

end
end A6WeightedHilbertPrivate

namespace A6ActualSlopePrivate
open MvPolynomial A6ActualIncidencePrivate
noncomputable section
abbrev Tri := MvPolynomial (Fin 3) ℚ
def originalH (G : FourZ) : Tri :=
  MvPolynomial.eval₂Hom (Int.castRingHom Tri) ![X 0,X 1,X 1^4-X 2,X 0^4] G
def originalHilbert (G : FourZ) (A : Matrix (Fin 2) (Fin 2) ℤ) (m : ℕ) : ℕ :=
  Module.finrank ℚ
    (Submodule.map (Ideal.Quotient.mkₐ ℚ (RingHom.ker (originalPsi G A).toRingHom)).toLinearMap
      (restrictTotalDegree (Fin 5) ℚ m))
theorem original_identity_slope (alpha : ℕ) (hα : 1≤alpha) (G : FourZ)
    (hdeg : ∀ m ∈ G.support,m 0+m 1=alpha ∧ m 2+m 3=2)
    (hirr : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G)) :
    ∃ nu : ℕ,nu≤alpha ∧
      (X (0:Fin 3) : Tri)^nu∣originalH G ∧
      (∀ n : ℕ,(X (0:Fin 3) : Tri)^n∣originalH G → n≤nu) ∧
      (∃ b : ℤ,∃ m0 : ℕ,∀ m : ℕ,m0 ≤ m →
        (originalHilbert G 1 m:ℤ)=((alpha+8-nu:ℕ):ℤ)*(m:ℤ)+b) := by
  obtain ⟨nu,H0,hH,hcontent,hmax,hEq⟩ :=
    A6ActualPrincipalHilbertPrivate.original_hilbert_principal_weighted alpha G hdeg hirr
  let g := A6ActualBiformPrivate.rationalG G
  let L := alpha+8-nu
  have hgdeg : ∀ m ∈ g.support,m 0+m 1=alpha ∧ m 2+m 3=2 := by
    intro m hm
    exact hdeg m (support_map_subset _ _ hm)
  have hdiv : (X (0:Fin 3) : A6WeightedHilbertPrivate.Tri)^nu∣
      A6WeightedHilbertPrivate.clearHom g := ⟨H0,hH⟩
  have hnu : nu≤alpha :=
    A6WeightedHilbertPrivate.content_bound g alpha nu hgdeg
      (A6ActualBiformPrivate.rationalG_irreducible G hirr)
      (A6ActualBiformPrivate.rationalG_not_dvd_X alpha G hdeg hirr 3) hdiv
  have hWH : IsWeightedHomogeneous A6WeightedHilbertPrivate.wt H0 L :=
    A6WeightedHilbertPrivate.content_weighted g alpha nu H0 hgdeg hH
  have hH0 : H0≠0 := by
    intro hz
    apply hcontent
    rw [hz]
    exact dvd_zero _
  obtain ⟨b,hlin⟩ := A6WeightedHilbertPrivate.eventual_rank H0 L hWH hH0
  have hdim (m : ℕ) : originalHilbert G 1 m=A6WeightedHilbertPrivate.Qrank H0 (4*m) :=
    hEq m
  have hlinear : ∀ m : ℕ,L ≤ m →
      (originalHilbert G 1 m:ℤ)=(L:ℤ)*(m:ℤ)+b := by
    intro m hm
    rw [hdim]
    exact hlin m hm
  refine ⟨nu,hnu,⟨H0,?_⟩,?_,⟨b,L,?_⟩⟩
  · rw [originalH,←A6ActualKernelPrivate.clearH_literal G]
    exact hH
  · intro n hn
    apply hmax n
    simpa only [originalH,A6ActualKernelPrivate.clearH_literal G] using hn
  · exact hlinear

end
end A6ActualSlopePrivate

namespace A6QuarticFramePrivate
open MvPolynomial
noncomputable section
abbrev QTgt := MvPolynomial (Fin 5) ℚ
abbrev Mat := Matrix (Fin 2) (Fin 2) ℤ
def lin (a b c d e : ℚ) : QTgt := C a*X 0+C b*X 1+C c*X 2+C d*X 3+C e*X 4
def symMap (A : Mat) : QTgt →ₐ[ℚ] QTgt :=
  let a : ℚ := A 0 0
  let b : ℚ := A 0 1
  let c : ℚ := A 1 0
  let d : ℚ := A 1 1
  aeval ![
    lin (a^4) (4*a^3*b) (6*a^2*b^2) (4*a*b^3) (b^4),
    lin (a^3*c) (a^3*d+3*a^2*b*c) (3*a^2*b*d+3*a*b^2*c) (3*a*b^2*d+b^3*c) (b^3*d),
    lin (a^2*c^2) (2*a^2*c*d+2*a*b*c^2) (a^2*d^2+4*a*b*c*d+b^2*c^2)
      (2*a*b*d^2+2*b^2*c*d) (b^2*d^2),
    lin (a*c^3) (3*a*c^2*d+b*c^3) (3*a*c*d^2+3*b*c^2*d) (a*d^3+3*b*c*d^2) (b*d^3),
    lin (c^4) (4*c^3*d) (6*c^2*d^2) (4*c*d^3) (d^4)]
set_option maxHeartbeats 16000000 in
lemma symMap_comp (A B : Mat) :
    (symMap B).comp (symMap A)=symMap (A*B) := by
  have hC2 : (C (2:ℚ):QTgt)=2 := by
    calc
      C (2:ℚ)=C ((1:ℚ)+1) := by congr 1;norm_num
      _=C (1:ℚ)+C 1 := map_add _ _ _
      _=2 := by rw [map_one];norm_num
  have hC3 : (C (3:ℚ):QTgt)=3 := by
    calc
      C (3:ℚ)=C ((2:ℚ)+1) := by congr 1;norm_num
      _=C (2:ℚ)+C 1 := map_add _ _ _
      _=3 := by rw [hC2,map_one];norm_num
  have hC4 : (C (4:ℚ):QTgt)=4 := by
    calc
      C (4:ℚ)=C ((3:ℚ)+1) := by congr 1;norm_num
      _=C (3:ℚ)+C 1 := map_add _ _ _
      _=4 := by rw [hC3,map_one];norm_num
  have hC6 : (C (6:ℚ):QTgt)=6 := by
    calc
      C (6:ℚ)=C ((4:ℚ)+2) := by congr 1;norm_num
      _=C (4:ℚ)+C 2 := map_add _ _ _
      _=6 := by rw [hC4,hC2];norm_num
  apply MvPolynomial.algHom_ext
  intro i
  fin_cases i <;>
    simp [symMap,lin,aeval_def,Matrix.mul_apply,Fin.sum_univ_two] <;>
      (try simp only [hC2,hC3,hC4,hC6]) <;> ring
lemma symMap_one : symMap (1 : Mat)=AlgHom.id ℚ QTgt := by
  apply MvPolynomial.algHom_ext
  intro i
  fin_cases i <;> simp [symMap,lin,aeval_def,Matrix.one_apply]
lemma mul_degree_le (a b : QTgt) (n m : ℕ)
    (ha : a.totalDegree ≤ n) (hb : b.totalDegree ≤ m) :
    (a*b).totalDegree ≤ n+m :=
  (totalDegree_mul a b).trans (Nat.add_le_add ha hb)
lemma lin_mem_one (a b c d e : ℚ) :
    lin a b c d e∈restrictTotalDegree (Fin 5) ℚ 1 := by
  have hx (r : ℚ) (i : Fin 5) :
      C r*X i∈restrictTotalDegree (Fin 5) ℚ 1 := by
    rw [mem_restrictTotalDegree]
    simpa using totalDegree_mul (C r : QTgt) (X i)
  exact (restrictTotalDegree (Fin 5) ℚ 1).add_mem
    ((restrictTotalDegree (Fin 5) ℚ 1).add_mem
      ((restrictTotalDegree (Fin 5) ℚ 1).add_mem
        ((restrictTotalDegree (Fin 5) ℚ 1).add_mem (hx a 0) (hx b 1)) (hx c 2)) (hx d 3))
    (hx e 4)
lemma symMap_X_mem (A : Mat) (i : Fin 5) :
    symMap A (X i)∈restrictTotalDegree (Fin 5) ℚ 1 := by
  fin_cases i <;> simp [symMap,aeval_def] <;> exact lin_mem_one _ _ _ _ _
lemma monomial_eq_five (n : Fin 5 →₀ ℕ) (c : ℚ) :
    monomial n c=C c*(X 0^(n 0)*X 1^(n 1)*X 2^(n 2)*X 3^(n 3)*X 4^(n 4)) := by
  rw [monomial_eq,Finsupp.prod_fintype _ _ (by intro i;simp)]
  simp [Fin.prod_univ_five,mul_assoc]
def deg5 (n : Fin 5 →₀ ℕ) := n 0+n 1+n 2+n 3+n 4
lemma deg5_eq_sum (n : Fin 5 →₀ ℕ) : deg5 n=n.sum (fun _ k=>k) := by
  simp [deg5,Finsupp.sum_fintype,Fin.sum_univ_succ,Nat.add_assoc]
lemma filtered_map (f : QTgt →ₐ[ℚ] QTgt)
    (hX : ∀ i : Fin 5,f (X i)∈restrictTotalDegree (Fin 5) ℚ 1)
    (m : ℕ) (p : QTgt) (hp : p∈restrictTotalDegree (Fin 5) ℚ m) :
    f p∈restrictTotalDegree (Fin 5) ℚ m := by
  classical
  rw [mem_restrictTotalDegree] at hp
  rw [p.as_sum,map_sum]
  apply Submodule.sum_mem
  intro n hn
  have hpow (i : Fin 5) : ((f (X i))^(n i)).totalDegree ≤ n i := by
    have hx := (mem_restrictTotalDegree (Fin 5) 1 _).mp (hX i)
    exact (totalDegree_pow _ _).trans (by simpa using Nat.mul_le_mul_left (n i) hx)
  have hC (c : ℚ) : f (C c)=C c := f.commutes c
  rw [mem_restrictTotalDegree,monomial_eq_five,map_mul,map_mul,map_mul,map_mul,map_mul,
    map_pow,map_pow,map_pow,map_pow,map_pow,hC]
  have hprod := mul_degree_le _ _ _ _
    (mul_degree_le _ _ _ _
      (mul_degree_le _ _ _ _
        (mul_degree_le _ _ _ _ (hpow 0) (hpow 1)) (hpow 2)) (hpow 3)) (hpow 4)
  have htotal := mul_degree_le (C (coeff n p)) _ 0 (deg5 n) (by simp) hprod
  apply htotal.trans
  rw [deg5_eq_sum]
  simpa only [Nat.zero_add] using (le_totalDegree hn).trans hp
lemma symMap_restrict (A P : Mat) (hAP : A*P=1) (hPA : P*A=1) (m : ℕ) :
    Submodule.map (symMap A).toLinearMap (restrictTotalDegree (Fin 5) ℚ m)=
      restrictTotalDegree (Fin 5) ℚ m := by
  apply le_antisymm
  · rw [Submodule.map_le_iff_le_comap]
    intro p hp
    exact filtered_map (symMap A) (symMap_X_mem A) m p hp
  · intro p hp
    apply Submodule.mem_map.mpr
    refine ⟨symMap P p,filtered_map (symMap P) (symMap_X_mem P) m p hp,?_⟩
    have heq : (symMap A).comp (symMap P)=AlgHom.id ℚ QTgt := by
      rw [symMap_comp,hPA,symMap_one]
    exact congrArg (fun f : QTgt →ₐ[ℚ] QTgt => f p) heq
abbrev Tri := MvPolynomial (Fin 3) ℚ
abbrev FourZ := MvPolynomial (Fin 4) ℤ
def H (G : FourZ) : Tri :=
  eval₂Hom (Int.castRingHom Tri) ![X 0,X 1,X 1^4-X 2,X 0^4] G
end
end A6QuarticFramePrivate

namespace A6ActualFramePrivate
open MvPolynomial A6ActualIncidencePrivate A6ActualSlopePrivate A6QuarticFramePrivate
noncomputable section
set_option maxHeartbeats 16000000 in
lemma originalPsi_sym (G : A6ActualIncidencePrivate.FourZ) (A : Mat) :
    (originalPsi G (1:Mat)).comp (symMap A)=originalPsi G A := by
  have h2 : algebraMap ℚ (Five ⧸ originalIdeal G) (2:ℚ)=2 := by
    calc
      algebraMap ℚ (Five ⧸ originalIdeal G) (2:ℚ)=
          algebraMap ℚ (Five ⧸ originalIdeal G) ((1:ℚ)+1) := by congr 1 <;> norm_num
      _=algebraMap ℚ (Five ⧸ originalIdeal G) (1:ℚ)+
          algebraMap ℚ (Five ⧸ originalIdeal G) 1 := map_add _ _ _
      _=2 := by rw [map_one];norm_num
  have h3 : algebraMap ℚ (Five ⧸ originalIdeal G) (3:ℚ)=3 := by
    calc
      algebraMap ℚ (Five ⧸ originalIdeal G) (3:ℚ)=
          algebraMap ℚ (Five ⧸ originalIdeal G) ((2:ℚ)+1) := by congr 1 <;> norm_num
      _=algebraMap ℚ (Five ⧸ originalIdeal G) (2:ℚ)+
          algebraMap ℚ (Five ⧸ originalIdeal G) 1 := map_add _ _ _
      _=3 := by rw [h2,map_one];norm_num
  have h4 : algebraMap ℚ (Five ⧸ originalIdeal G) (4:ℚ)=4 := by
    calc
      algebraMap ℚ (Five ⧸ originalIdeal G) (4:ℚ)=
          algebraMap ℚ (Five ⧸ originalIdeal G) ((3:ℚ)+1) := by congr 1 <;> norm_num
      _=algebraMap ℚ (Five ⧸ originalIdeal G) (3:ℚ)+
          algebraMap ℚ (Five ⧸ originalIdeal G) 1 := map_add _ _ _
      _=4 := by rw [h3,map_one];norm_num
  have h6 : algebraMap ℚ (Five ⧸ originalIdeal G) (6:ℚ)=6 := by
    calc
      algebraMap ℚ (Five ⧸ originalIdeal G) (6:ℚ)=
          algebraMap ℚ (Five ⧸ originalIdeal G) ((4:ℚ)+2) := by congr 1 <;> norm_num
      _=algebraMap ℚ (Five ⧸ originalIdeal G) (4:ℚ)+
          algebraMap ℚ (Five ⧸ originalIdeal G) 2 := map_add _ _ _
      _=6 := by rw [h4,h2];norm_num
  apply MvPolynomial.algHom_ext
  intro i
  fin_cases i <;> simp [originalPsi,symMap,lin] <;> (try simp only [h2,h3,h4,h6]) <;> ring
lemma originalHilbert_frame (G : A6ActualIncidencePrivate.FourZ) (A P : Mat)
    (hAP : A*P=1) (hPA : P*A=1) (m : ℕ) :
    originalHilbert G A m=originalHilbert G 1 m := by
  unfold originalHilbert
  calc
    _=Module.finrank ℚ (Submodule.map (originalPsi G A).toLinearMap
        (restrictTotalDegree (Fin 5) ℚ m)) :=
      A6ActualHilbertTransportPrivate.finrank_map_mk_ker (originalPsi G A) _
    _=Module.finrank ℚ (Submodule.map (originalPsi G 1).toLinearMap
        (restrictTotalDegree (Fin 5) ℚ m)) := by
      rw [←originalPsi_sym G A,AlgHom.comp_toLinearMap,Submodule.map_comp,
        symMap_restrict A P hAP hPA m]
    _=_ := (A6ActualHilbertTransportPrivate.finrank_map_mk_ker (originalPsi G 1) _).symm
theorem original_frame_geometry (alpha : ℕ) (hα : 1≤alpha)
    (G : A6ActualIncidencePrivate.FourZ) (A P : Mat)
    (hdeg : ∀ m ∈ G.support,m 0+m 1=alpha ∧ m 2+m 3=2)
    (hirr : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G))
    (hAP : A*P=1) (hPA : P*A=1) :
    ∃ nu : ℕ,nu≤alpha ∧
      (X (0:Fin 3) : A6QuarticFramePrivate.Tri)^nu∣H G ∧
      (∀ n : ℕ,(X (0:Fin 3) : A6QuarticFramePrivate.Tri)^n∣H G → n≤nu) ∧
      (RingHom.ker (originalPsi G A).toRingHom).IsPrime ∧
      ringKrullDim (A6ActualIncidencePrivate.Tgt ⧸
        RingHom.ker (originalPsi G A).toRingHom)=1 ∧
      (∃ b : ℤ,∃ m0 : ℕ,∀ m : ℕ,m0 ≤ m →
        (originalHilbert G A m:ℤ)=((alpha+8-nu:ℕ):ℤ)*(m:ℤ)+b) := by
  obtain ⟨nu,hnu,hdiv,hmax,⟨b,m0,hHF⟩⟩ :=
    original_identity_slope alpha hα G hdeg hirr
  have hframe : ∀ m,originalHilbert G A m=originalHilbert G 1 m :=
    originalHilbert_frame G A P hAP hPA
  have hHF' : ∀ m : ℕ,m0 ≤ m →
      (originalHilbert G A m:ℤ)=((alpha+8-nu:ℕ):ℤ)*(m:ℤ)+b := by
    intro m hm
    rw [hframe]
    exact hHF m hm
  have hprime := original_kernel_isPrime alpha G hdeg hirr A
  have hdim : ringKrullDim (A6ActualIncidencePrivate.Tgt ⧸
      RingHom.ker (originalPsi G A).toRingHom)=1 := by
    apply Strict540Q.DimOne.krullDim_eq_one_of_affineHilbert 5 _ hprime
      (alpha+8-nu) (by omega) b m0
    exact hHF'
  refine ⟨nu,hnu,hdiv,hmax,hprime,hdim,⟨b,m0,hHF'⟩⟩

end
end A6ActualFramePrivate

namespace A6OriginalPointPrivate
open MvPolynomial A6ActualIncidencePrivate
noncomputable section
def pointEval (z : Fin 4 → ℤ) (h : ℤ) : Five →ₐ[ℚ] ℚ :=
  aeval ![(z 0:ℚ),(z 1:ℚ),(z 2:ℚ),(z 3:ℚ),(h:ℚ)]
lemma pointEval_G5 (G : FourZ) (z : Fin 4 → ℤ) (h : ℤ) :
    pointEval z h (originalG5 G)=(MvPolynomial.eval z G:ℤ) := by
  have heq :
      (pointEval z h).toRingHom.comp
        (eval₂Hom (Int.castRingHom Five) ![X 0,X 1,X 2,X 3])=
      (Int.castRingHom ℚ).comp (MvPolynomial.eval z) := by
    apply MvPolynomial.ringHom_ext
    · intro c
      have hh :
          ((pointEval z h).toRingHom.comp
            (eval₂Hom (Int.castRingHom Five) ![X 0,X 1,X 2,X 3])).comp C=
          ((Int.castRingHom ℚ).comp (MvPolynomial.eval z)).comp C :=
        Subsingleton.elim _ _
      exact congrArg (fun f : ℤ →+* ℚ => f c) hh
    · intro i
      fin_cases i <;> simp [pointEval]
  exact congrArg (fun f : FourZ →+* ℚ => f G) heq
lemma pointEval_ideal (G : FourZ) (z : Fin 4 → ℤ) (h : ℤ)
    (hsign : h=1 ∨ h= -1) (hG : MvPolynomial.eval z G=0)
    (hF : (z 1)^4*z 3-(z 0)^4*z 2=h) :
    originalIdeal G≤RingHom.ker (pointEval z h).toRingHom := by
  change Ideal.span ({originalG5 G,X 4*originalF5-1} : Set Five)≤_
  apply Ideal.span_le.mpr
  intro p hp
  simp only [Set.mem_insert_iff,Set.mem_singleton_iff] at hp
  rcases hp with rfl|rfl
  · change pointEval z h (originalG5 G)=0
    rw [pointEval_G5,hG]
    simp
  · change pointEval z h (X 4*originalF5-1)=0
    have hFQ : (z 1:ℚ)^4*(z 3:ℚ)-(z 0:ℚ)^4*(z 2:ℚ)=(h:ℚ) := by
      exact_mod_cast hF
    simp [pointEval,originalF5]
    rw [hFQ]
    rcases hsign with rfl|rfl <;> norm_num
def pointFactor (G : FourZ) (z : Fin 4 → ℤ) (h : ℤ)
    (hsign : h=1 ∨ h= -1) (hG : MvPolynomial.eval z G=0)
    (hF : (z 1)^4*z 3-(z 0)^4*z 2=h) :
    (Five ⧸ originalIdeal G) →+* ℚ :=
  Ideal.Quotient.lift (originalIdeal G) (pointEval z h).toRingHom
    (fun p hp => pointEval_ideal G z h hsign hG hF hp)
def originalPoint (A : Matrix (Fin 2) (Fin 2) ℤ) (z : Fin 4 → ℤ) (h : ℤ) :
    Fin 5 → ℚ :=
  let l0 := A 0 0*z 0+A 0 1*z 1
  let l1 := A 1 0*z 0+A 1 1*z 1
  fun i => ((![h*z 3*l0^4,h*z 3*l0^3*l1,h*z 3*l0^2*l1^2,h*z 3*l0*l1^3,h*z 3*l1^4] i : ℤ):ℚ)
lemma pointFactor_comp (G : FourZ) (A : Matrix (Fin 2) (Fin 2) ℤ)
    (z : Fin 4 → ℤ) (h : ℤ) (hsign : h=1 ∨ h= -1)
    (hG : MvPolynomial.eval z G=0) (hF : (z 1)^4*z 3-(z 0)^4*z 2=h) :
    (pointFactor G z h hsign hG hF).comp (originalPsi G A).toRingHom=
      MvPolynomial.eval (originalPoint A z h) := by
  apply MvPolynomial.ringHom_ext
  · intro c
    have hh :
        ((pointFactor G z h hsign hG hF).comp (originalPsi G A).toRingHom).comp C=
        (MvPolynomial.eval (originalPoint A z h)).comp C := Subsingleton.elim _ _
    exact congrArg (fun f : ℚ →+* ℚ => f c) hh
  · intro i
    fin_cases i <;>
      simp [originalPsi,pointFactor,pointEval,originalPoint] <;> ring
theorem original_point_vanish (G : FourZ) (A : Matrix (Fin 2) (Fin 2) ℤ)
    (z : Fin 4 → ℤ) (h : ℤ) (hsign : h=1 ∨ h= -1)
    (hG : MvPolynomial.eval z G=0) (hF : (z 1)^4*z 3-(z 0)^4*z 2=h)
    (f : Tgt) (hf : f∈RingHom.ker (originalPsi G A).toRingHom) :
    MvPolynomial.eval (originalPoint A z h) f=0 := by
  have hz : (originalPsi G A).toRingHom f=0 := hf
  have hh := congrArg (fun k : Tgt →+* ℚ => k f) (pointFactor_comp G A z h hsign hG hF)
  change pointFactor G z h hsign hG hF ((originalPsi G A).toRingHom f)=
    MvPolynomial.eval (originalPoint A z h) f at hh
  rw [hz,map_zero] at hh
  exact hh.symm
end
end A6OriginalPointPrivate

namespace A6ActualCountPrivate
open MvPolynomial
noncomputable section
abbrev FourZ := MvPolynomial (Fin 4) ℤ
abbrev Mat := Matrix (Fin 2) (Fin 2) ℤ
def coords (A : Mat) (z : Fin 4 → ℤ) : Fin 2 → ℤ :=
  ![A 0 0*z 0+A 0 1*z 1,A 1 0*z 0+A 1 1*z 1]
def scaledQuartic (v a b : ℤ) : Fin 5 → ℤ :=
  ![v*a^4,v*a^3*b,v*a^2*b^2,v*a*b^3,v*b^4]
def pointMap (A : Mat) (h : ℤ) (z : Fin 4 → ℤ) : Fin 5 → ℤ :=
  fun i => h*scaledQuartic (z 3) (coords A z 0) (coords A z 1) i
def unitPoints (h : ℤ) : Set (Fin 4 → ℤ) :=
  {z | (∀ i,0<z i) ∧ (z 1)^4*z 3-(z 0)^4*z 2=h}
lemma recover (P A : Mat) (hPA : P*A=1) (z : Fin 4 → ℤ) :
    P 0 0*coords A z 0+P 0 1*coords A z 1=z 0 ∧
    P 1 0*coords A z 0+P 1 1*coords A z 1=z 1 := by
  have h00 := congrArg (fun M : Mat=>M 0 0) hPA
  have h01 := congrArg (fun M : Mat=>M 0 1) hPA
  have h10 := congrArg (fun M : Mat=>M 1 0) hPA
  have h11 := congrArg (fun M : Mat=>M 1 1) hPA
  simp [Matrix.mul_apply,Fin.sum_univ_two] at h00 h01 h10 h11
  constructor
  · show P 0 0*(A 0 0*z 0+A 0 1*z 1)+P 0 1*(A 1 0*z 0+A 1 1*z 1)=z 0
    linear_combination z 0*h00+z 1*h01
  · show P 1 0*(A 0 0*z 0+A 0 1*z 1)+P 1 1*(A 1 0*z 0+A 1 1*z 1)=z 1
    linear_combination z 0*h10+z 1*h11

lemma original_coprime (h : ℤ) (hsign : h=1 ∨ h= -1) (z : Fin 4 → ℤ)
    (hz : (z 1)^4*z 3-(z 0)^4*z 2=h) : IsCoprime (z 0) (z 1) := by
  have hh : h*h=1 := by rcases hsign with rfl|rfl <;> norm_num
  refine ⟨-h*(z 0)^3*z 2,h*(z 1)^3*z 3,?_⟩
  linear_combination h*hz+hh
lemma coords_primitive (P A : Mat) (hPA : P*A=1) (h : ℤ)
    (hsign : h=1 ∨ h= -1) (z : Fin 4 → ℤ)
    (hz : (z 1)^4*z 3-(z 0)^4*z 2=h) :
    Int.gcd (coords A z 0) (coords A z 1)=1 := by
  rw [←Int.isCoprime_iff_gcd_eq_one]
  obtain ⟨r,s,hrs⟩ := original_coprime h hsign z hz
  obtain ⟨h0,h1⟩ := recover P A hPA z
  refine ⟨r*P 0 0+s*P 1 0,r*P 0 1+s*P 1 1,?_⟩
  linear_combination hrs+r*h0+s*h1
lemma prim_ne (a b : ℤ) (h : Int.gcd a b = 1) : ¬ (a = 0 ∧ b = 0) := by
  rintro ⟨ha, hb⟩; rw [ha, hb] at h; simp at h

lemma prim_parallel (a b a' b' : ℤ) (h : Int.gcd a b = 1) (h' : Int.gcd a' b' = 1)
    (hD : a * b' = a' * b) : ∃ k : ℤ, (k = 1 ∨ k = -1) ∧ a' = k * a ∧ b' = k * b :=
  Strict540Q.LemP.prim_parallel a b a' b' h h' hD
lemma scaled_parallel (v w a b c d : ℤ) (hv : v≠0) (hw : w≠0)
    (heq : scaledQuartic v a b=scaledQuartic w c d) : a*d=c*b := by
  have h0 : v*a^4=w*c^4 := by simpa [scaledQuartic] using congrFun heq 0
  have h1 : v*a^3*b=w*c^3*d := by simpa [scaledQuartic] using congrFun heq 1
  by_cases ha : a=0
  · have hc : c=0 := by
      by_contra hc
      have hn := mul_ne_zero hw (pow_ne_zero 4 hc)
      apply hn
      simpa [ha] using h0.symm
    simp [ha,hc]
  · have hc : c≠0 := by
      intro hc
      have hn := mul_ne_zero hv (pow_ne_zero 4 ha)
      apply hn
      simpa [hc] using h0
    have hp : v*a^3*(a*d-c*b)=0 := by
      linear_combination d*h0-c*h1
    have hcross : a*d-c*b=0 :=
      (mul_eq_zero.mp hp).resolve_left (mul_ne_zero hv (pow_ne_zero 3 ha))
    exact sub_eq_zero.mp hcross
lemma scaledQuartic_injective (v w a b c d : ℤ) (hv : 0<v) (hw : 0<w)
    (hab : Int.gcd a b=1) (hcd : Int.gcd c d=1)
    (heq : scaledQuartic v a b=scaledQuartic w c d) :
    v=w ∧ ((a=c ∧ b=d) ∨ (c= -a ∧ d= -b)) := by
  have h0 : v*a^4=w*c^4 := by simpa [scaledQuartic] using congrFun heq 0
  have h4 : v*b^4=w*d^4 := by simpa [scaledQuartic] using congrFun heq 4
  obtain ⟨k,hk,hc,hd⟩ :=
    prim_parallel a b c d hab hcd (scaled_parallel v w a b c d hv.ne' hw.ne' heq)
  have hk4 : k^4=1 := by rcases hk with rfl|rfl <;> norm_num
  have hvw : v=w := by
    by_cases ha : a=0
    · have hb : b≠0 := fun hb => prim_ne a b hab ⟨ha,hb⟩
      have h4' : v*b^4=w*b^4 := by
        rw [h4,hd]
        linear_combination (w*b^4)*hk4
      exact mul_right_cancel₀ (pow_ne_zero 4 hb) h4'
    · have h0' : v*a^4=w*a^4 := by
        rw [h0,hc]
        linear_combination (w*a^4)*hk4
      exact mul_right_cancel₀ (pow_ne_zero 4 ha) h0'
  refine ⟨hvw,?_⟩
  rcases hk with rfl|rfl
  · left
    constructor
    · rw [hc]; ring
    · rw [hd]; ring
  · right
    constructor
    · rw [hc]; ring
    · rw [hd]; ring
theorem pointMap_injOn (P A : Mat) (hPA : P*A=1) (h : ℤ)
