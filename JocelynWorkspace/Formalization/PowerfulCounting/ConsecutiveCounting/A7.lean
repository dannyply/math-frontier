        fun j => Classical.choice (ellipse_basis _ _ _
          (div_pos hM0 (mul_pos (by norm_num) (hApos j)))
          (mul_pos (by norm_num) (hBpos j)))
      let L : ℕ → ℝ := fun j =>
        sideLength ((M : ℝ)/(4*D)) (quarticRho D E M j) (2*E) (p j).P 0
      let T : ℕ → ℝ := fun j =>
        sideLength ((M : ℝ)/(2048*cofactorA x D E M j))
          ((quarticRho D E M j)^4) (32*cofactorB x D E M j) (qf j).P 0
      have hLpos (j : ℕ) : 0<L j := (p j).hpos.trans_le (p j).horder
      have hTpos (j : ℕ) : 0<T j := (qf j).hpos.trans_le (qf j).horder
      have hTscale (j : ℕ) :
          T j=16*A7QuarticMoments.length
            ((M : ℝ)/(128*scaleA D E U V M j))
            ((quarticRho D E M j)^4) (2*scaleB D E U V M j) (col (qf j).P 0) :=
        cofactor_side_nominal M (cofactorB x D E M j) (cofactorA x D E M j)
          ((quarticRho D E M j)^4) (hBpos j).ne' (qf j).P
      have hLcap (j : ℕ) : L j≤x^2 := by
        have ht := A7QuarticMoments.length_pos_cap 4 D E M (quarticRho D E M j)
          (by norm_num) hD hE hM (col (p j).P 0) (p j).hcol
