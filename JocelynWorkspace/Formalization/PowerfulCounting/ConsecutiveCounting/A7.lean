          ∑ i : Fin (q + 1), a i * rs.1 ^ (i : ℕ) * rs.2 ^ (q - (i : ℕ)) = m}.encard ≤
        ((2800 * q ^ (1 + m.natAbs.primeFactors.card) : ℕ) : ℕ∞)

theorem primitive_diagonal_count4 (hS : H_Stewart) (A B m : ℤ)
    (hA : A ≠ 0) (hB : B ≠ 0) (hcop : Int.gcd A B = 1) (hm : m ≠ 0) :
    {rs : ℤ × ℤ | Int.gcd rs.1 rs.2 = 1 ∧ A * rs.1 ^ 4 - B * rs.2 ^ 4 = m}.encard ≤
      ((2800 * 4 ^ (1 + m.natAbs.primeFactors.card) : ℕ) : ℕ∞) := by
  let a : Fin 5 → ℤ := ![-B, 0, 0, 0, A]
  have hcontent : Finset.univ.gcd a = 1 := by
    rw [show (Finset.univ : Finset (Fin 5)) = {0, 1, 2, 3, 4} by decide]
    simp [a, Finset.gcd_insert, Finset.gcd_singleton]
    rw [← Int.coe_gcd]
    norm_cast
    have hnorm : (normalize A).natAbs = A.natAbs :=
      Int.associated_iff_natAbs.mp (normalize_associated A)
    simpa only [Int.gcd_def, Int.natAbs_neg, hnorm,
      Nat.gcd_comm B.natAbs A.natAbs] using hcop
  have hpoly : (∑ i : Fin 5, C (a i : ℚ) * X (0 : Fin 2) ^ (i : ℕ) *
      X (1 : Fin 2) ^ (4 - (i : ℕ))) =
      C (A : ℚ) * X (0 : Fin 2) ^ 4 - C (B : ℚ) * X (1 : Fin 2) ^ 4 := by
    simp [a, Fin.sum_univ_succ]
    ring
  have hsf : Squarefree (∑ i : Fin 5, C (a i : ℚ) * X (0 : Fin 2) ^ (i : ℕ) *
      X (1 : Fin 2) ^ (4 - (i : ℕ))) := by
    rw [hpoly]
    exact Quartic.squarefree_diagonal_quartic (A : ℚ) (B : ℚ)
      (by exact_mod_cast hA) (by exact_mod_cast hB)
  have hbound := hS 4 (by norm_num) a hcontent hsf m hm
  have heval (r s : ℤ) :
      (∑ i : Fin 5, a i * r ^ (i : ℕ) * s ^ (4 - (i : ℕ))) =
      A * r ^ 4 - B * s ^ 4 := by
    simp [a, Fin.sum_univ_succ]
    ring
  simpa only [heval] using hbound

end StewartCount4

