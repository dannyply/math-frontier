theorem grid_cover (D E : ℝ) (M : ℕ) (hD : 0 < D) (hE : 0 < E) (hM : 1 ≤ M) (t : ℝ)
    (ht0 : D / (2 * E) < t) (ht1 : t ≤ 2 * D / E) :
    ∃ j ∈ @Finset.filter ℕ (fun j => D / (2 * E) ≤ D / (2 * E) * (1 + 1 / (M : ℝ)) ^ j ∧
        D / (2 * E) * (1 + 1 / (M : ℝ)) ^ j ≤ 2 * D / E) (Classical.decPred _)
        (Finset.range (3 * M + 1)),
      D / (2 * E) * (1 + 1 / (M : ℝ)) ^ j < t ∧
        t ≤ D / (2 * E) * (1 + 1 / (M : ℝ)) ^ j * (1 + 1 / (M : ℝ)) := by
  classical
  have hMr : (1 : ℝ) ≤ (M : ℝ) := by exact_mod_cast hM
  have hM0 : (0 : ℝ) < (M : ℝ) := by linarith
  have hMne : (M : ℝ) ≠ 0 := ne_of_gt hM0
  have hEne : E ≠ 0 := ne_of_gt hE
  have hinv : 0 < 1 / (M : ℝ) := by positivity
  have hb0 : 0 < D / (2 * E) := by positivity
  have hr1 : 1 < 1 + 1 / (M : ℝ) := by linarith
  have hb4 : 2 * D / E = 4 * (D / (2 * E)) := by
    first
    | ring
    | (field_simp; ring)
    | field_simp
  have hpow : (4 : ℝ) ≤ (1 + 1 / (M : ℝ)) ^ (3 * M) := by
    have hB := bern (1 / (M : ℝ)) hinv.le (3 * M)
    have h3 : ((3 * M : ℕ) : ℝ) * (1 / (M : ℝ)) = 3 := by
      first
      | (push_cast; rw [mul_one_div, mul_div_assoc, div_self hMne, mul_one])
      | (push_cast; field_simp)
    linarith
  have h3M : t ≤ D / (2 * E) * (1 + 1 / (M : ℝ)) ^ (3 * M) := by
    have h := mul_le_mul_of_nonneg_left hpow hb0.le
    linarith
  have hex : ∃ n : ℕ, t ≤ D / (2 * E) * (1 + 1 / (M : ℝ)) ^ n := ⟨3 * M, h3M⟩
  have hn : t ≤ D / (2 * E) * (1 + 1 / (M : ℝ)) ^ (Nat.find hex) := Nat.find_spec hex
  have hn0 : Nat.find hex ≠ 0 := by
    intro h0
    rw [h0, pow_zero, mul_one] at hn
    linarith
  have hlt : D / (2 * E) * (1 + 1 / (M : ℝ)) ^ (Nat.find hex - 1) < t := by
    have h := Nat.find_min hex (show Nat.find hex - 1 < Nat.find hex by omega)
    exact lt_of_not_ge h
  have hnle : Nat.find hex ≤ 3 * M := Nat.find_min' hex h3M
  have hsucc : (1 + 1 / (M : ℝ)) ^ (Nat.find hex - 1) * (1 + 1 / (M : ℝ)) =
      (1 + 1 / (M : ℝ)) ^ (Nat.find hex) := by
    rw [← pow_succ]
    congr 1
    omega
  refine ⟨Nat.find hex - 1, (mem_filter_gen _ _ _).mpr ⟨?_, ?_, ?_⟩, hlt, ?_⟩
  · rw [Finset.mem_range]
    omega
  · have h1 : (1 : ℝ) ≤ (1 + 1 / (M : ℝ)) ^ (Nat.find hex - 1) := one_le_pow₀ hr1.le
    nlinarith
  · linarith
  · rw [mul_assoc, hsucc]
    exact hn

theorem cell_mem (x D E : ℝ) (M : ℕ) (hD : 0 < D) (hE : 0 < E) (hM : 1 ≤ M)
