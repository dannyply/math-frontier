open A7N_848be07f.A7PureNineSignedLevel

private theorem original_cut_free_real_regime
    (κ lam z₀ γ x H : ℝ) (s t : ℤ)
    (hγ : γ ≠ 0) (hH : 0 < H)
    (hst : (s : ℝ) < (t : ℝ))
    (hrank : cutRank (bandCuts κ lam z₀ γ x H) s =
      cutRank (bandCuts κ lam z₀ γ x H) t)
    (hsnc : (s : ℝ) ∉ bandCuts κ lam z₀ γ x H)
    (htnc : (t : ℝ) ∉ bandCuts κ lam z₀ γ x H)
    (hsheight : x / 2 ≤ bandF κ lam (z₀ + γ * (s : ℝ)) ∧
      bandF κ lam (z₀ + γ * (s : ℝ)) ≤ x)
    (htheight : x / 2 ≤ bandF κ lam (z₀ + γ * (t : ℝ)) ∧
      bandF κ lam (z₀ + γ * (t : ℝ)) ≤ x) :
    (∀ r ∈ Set.Icc (s : ℝ) (t : ℝ),
      x / 2 < bandF κ lam (z₀ + γ * r) ∧
      bandF κ lam (z₀ + γ * r) < x) ∧
    ((∀ r ∈ Set.Icc (s : ℝ) (t : ℝ),
        H < deriv (fun u : ℝ => bandF κ lam (z₀ + γ * u)) r) ∨
     (∀ r ∈ Set.Icc (s : ℝ) (t : ℝ),
        deriv (fun u : ℝ => bandF κ lam (z₀ + γ * u)) r < -H) ∨
     (∀ r ∈ Set.Icc (s : ℝ) (t : ℝ),
        |deriv (fun u : ℝ => bandF κ lam (z₀ + γ * u)) r| < H)) := by
  let N : ℝ → ℝ := fun r => bandF κ lam (z₀ + γ * r)
  let N1 : ℝ → ℝ := fun r => deriv N r
  let cuts := bandCuts κ lam z₀ γ x H
  have hnocut : ∀ r ∈ Set.Icc (s : ℝ) (t : ℝ), r ∉ cuts :=
    equal_rank_no_cut_closed cuts s t hst hrank hsnc htnc
  have hnoroot : ∀ r ∈ Set.Icc (s : ℝ) (t : ℝ),
      N r ≠ x / 2 ∧ N r ≠ x ∧ N1 r ≠ H ∧ N1 r ≠ -H := by
    intro r hr
    have hnc := hnocut r hr
    constructor
    · intro heq
      exact hnc (bandCuts_contains_root κ lam z₀ γ x H r hγ
        (Or.inl (by simpa only [N] using heq)))
    constructor
    · intro heq
      exact hnc (bandCuts_contains_root κ lam z₀ γ x H r hγ
        (Or.inr (Or.inl (by simpa only [N] using heq))))
    constructor
    · intro heq
      exact hnc (bandCuts_contains_root κ lam z₀ γ x H r hγ
        (Or.inr (Or.inr (Or.inl (by simpa only [N1, N] using heq)))))
    · intro heq
      exact hnc (bandCuts_contains_root κ lam z₀ γ x H r hγ
        (Or.inr (Or.inr (Or.inr (by simpa only [N1, N] using heq)))))
  have hNcont : ContinuousOn N (Set.Icc (s : ℝ) (t : ℝ)) := by
    dsimp [N, bandF, bandU, bandG]
    fun_prop
  have hN1cont : ContinuousOn N1 (Set.Icc (s : ℝ) (t : ℝ)) := by
    have hfun : N1 = fun r : ℝ => γ * bandF1 κ lam (z₀ + γ * r) := by
      funext r
      exact bandN_deriv κ lam z₀ γ r
    rw [hfun]
    dsimp [bandF1, bandU, bandG]
    fun_prop
  have hab : (s : ℝ) ≤ (t : ℝ) := le_of_lt hst
  have hsmem : (s : ℝ) ∈ Set.Icc (s : ℝ) (t : ℝ) :=
    ⟨le_rfl, hab⟩
  have htm : (t : ℝ) ∈ Set.Icc (s : ℝ) (t : ℝ) :=
    ⟨hab, le_rfl⟩
  have hslow : x / 2 < N (s : ℝ) :=
    lt_of_le_of_ne hsheight.1
      (Ne.symm (hnoroot (s : ℝ) hsmem).1)
  have hshigh : N (s : ℝ) < x :=
    lt_of_le_of_ne hsheight.2
      (hnoroot (s : ℝ) hsmem).2.1
  have hheightLow :
      ∀ r ∈ Set.Icc (s : ℝ) (t : ℝ), x / 2 < N r := by
    have hpositive := continuous_positive_of_no_zero_Icc
      (fun r => N r - x / 2) (s : ℝ) (t : ℝ) hab
      (by fun_prop)
      (by
        intro r hr hzero
        exact (hnoroot r hr).1 (by linarith))
      (by linarith)
    intro r hr
    have := hpositive r hr
    linarith
  have hheightHigh :
      ∀ r ∈ Set.Icc (s : ℝ) (t : ℝ), N r < x := by
    have hpositive := continuous_positive_of_no_zero_Icc
      (fun r => x - N r) (s : ℝ) (t : ℝ) hab
      (by fun_prop)
      (by
        intro r hr hzero
        exact (hnoroot r hr).2.1 (by linarith))
      (by linarith)
    intro r hr
    have := hpositive r hr
    linarith
  constructor
  · intro r hr
    exact ⟨hheightLow r hr, hheightHigh r hr⟩
  have hsplus : N1 (s : ℝ) ≠ H := (hnoroot (s : ℝ) hsmem).2.2.1
  have hsminus : N1 (s : ℝ) ≠ -H := (hnoroot (s : ℝ) hsmem).2.2.2
  by_cases hlargePlus : H < N1 (s : ℝ)
  · left
    have hpositive := continuous_positive_of_no_zero_Icc
      (fun r => N1 r - H) (s : ℝ) (t : ℝ) hab
      (by fun_prop)
      (by
        intro r hr hzero
        exact (hnoroot r hr).2.2.1 (by linarith))
      (by linarith)
    intro r hr
    have := hpositive r hr
    linarith
  right
  by_cases hlargeMinus : N1 (s : ℝ) < -H
  · left
    have hpositive := continuous_positive_of_no_zero_Icc
      (fun r => -H - N1 r) (s : ℝ) (t : ℝ) hab
      (by fun_prop)
      (by
        intro r hr hzero
        exact (hnoroot r hr).2.2.2 (by linarith))
      (by linarith)
    intro r hr
    have := hpositive r hr
    linarith
  right
  have hsmallPlus : N1 (s : ℝ) < H := by
    have hle := le_of_not_gt hlargePlus
    exact lt_of_le_of_ne hle hsplus
  have hsmallMinus : -H < N1 (s : ℝ) := by
    have hle := le_of_not_gt hlargeMinus
    exact lt_of_le_of_ne hle (Ne.symm hsminus)
  have hp := continuous_positive_of_no_zero_Icc
    (fun r => H - N1 r) (s : ℝ) (t : ℝ) hab
    (by fun_prop)
    (by
      intro r hr hzero
      exact (hnoroot r hr).2.2.1 (by linarith))
    (by linarith)
  have hm := continuous_positive_of_no_zero_Icc
    (fun r => N1 r + H) (s : ℝ) (t : ℝ) hab
    (by fun_prop)
    (by
      intro r hr hzero
      exact (hnoroot r hr).2.2.2 (by linarith))
    (by linarith)
  intro r hr
  have hpr := hp r hr
  have hmr := hm r hr
  exact abs_lt.mpr ⟨by linarith, by linarith⟩

end A7PureNineSignedLevel

