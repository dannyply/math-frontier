  intro z hz w hw heq
  obtain ⟨hzpos,hzF⟩ := hz
  obtain ⟨hwpos,hwF⟩ := hw
  have hh : h≠0 := by rcases hsign with rfl|rfl <;> norm_num
  have hscaled : scaledQuartic (z 3) (coords A z 0) (coords A z 1)=
      scaledQuartic (w 3) (coords A w 0) (coords A w 1) := by
    funext i
    exact mul_left_cancel₀ hh (congrFun heq i)
