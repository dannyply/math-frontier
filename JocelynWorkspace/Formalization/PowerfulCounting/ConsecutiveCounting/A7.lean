theorem claim_01d9aea1b538f4590283516b20933d0c843e439ffea75c0274b8615a992030f6 :
(let Binary : Type := MvPolynomial (Fin 2) ℤ;
let R4 : ℤ → ℤ → ℤ := fun A B => A ^ 3 + 7 * A ^ 2 * B + 21 * A * B ^ 2 + 35 * B ^ 3;
∀ (P Q : Binary) (a b c : ℤ) (H : ℝ),
  P.IsHomogeneous 4 → Q.IsHomogeneous 4 →
  IsRelPrime (MvPolynomial.map (Int.castRingHom ℚ) P)
    (MvPolynomial.map (Int.castRingHom ℚ) Q) →
  c ≠ 0 →
  (∀ m : Fin 2 →₀ ℕ,
    |((P.coeff m : ℤ) : ℝ)| ≤ H ∧ |((Q.coeff m : ℤ) : ℝ)| ≤ H) →
  let X : Binary := MvPolynomial.X 0;
  let Y : Binary := MvPolynomial.X 1;
  Y ^ 4 * Q - X ^ 4 * P =
    MvPolynomial.C c * (MvPolynomial.C a * X + MvPolynomial.C b * Y) ^ 8 →
  ∃ K0 : ℤ, K0 ≠ 0 ∧ |(K0 : ℝ)| ≤ H ∧
    ∀ d e u v : ℤ, e ≠ 0 → e ^ 4 * v = d ^ 4 * u + 1 →
      u * MvPolynomial.eval ![d, e] Q = v * MvPolynomial.eval ![d, e] P →
      let m : ℤ := a * d + b * e;
      m ≠ 0 ∧ m.natAbs ∣ K0.natAbs ∧
        ∃ q : ℤ, q ≠ 0 ∧ K0 = c * m * q ∧
          m ^ 7 * u = q * e ^ 4 - a ^ 4 * R4 (a * d) (b * e) ∧
          m ^ 7 * v = q * d ^ 4 + b ^ 4 * R4 (b * e) (a * d)
) := by
  dsimp only
  intro P Q a b c H hP hQ hcop hc hheight hpure
  exact A7ActualP4Arithmetic.whole_original_arithmetic P Q a b c H hP hQ hcop hc hheight hpure
end JocelynClaims

