  have hU : 0<U := by dsimp [U]; positivity
  have hV : 0<V := by dsimp [V]; positivity
  have hRD : 0<RD := by dsimp [RD]; positivity
  have hRU : 0<RU := by dsimp [RU]; positivity
  refine ⟨ab,hab,hM,hMx,?_⟩
  intro h hsign

  let Data : ℕ → Poly → Finset Poly → Prop := fun j F S =>
    F ≠ 0 ∧ Bihom F ab.1 ab.2 ∧ F.totalDegree ≤ ab.1+ab.2 ∧
