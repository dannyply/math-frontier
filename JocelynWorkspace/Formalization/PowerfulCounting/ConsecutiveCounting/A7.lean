lemma scale_identity (theta D E : ℝ) (M : ℕ)
    (hD : 0 < D) (hE : 0 < E) (hM : (0 : ℝ) < M) :
    (M : ℝ) * (256 * ((D * E + (D ^ 2 + E ^ 2) / (M : ℝ)) / (M : ℝ)) ^
      ((1 : ℝ) / 2)) ^ theta =
      256 ^ theta * (M : ℝ) ^ (1 - theta / 2) *
        (D * E + (D ^ 2 + E ^ 2) / (M : ℝ)) ^ (theta / 2) := by
  let B : ℝ := D * E + (D ^ 2 + E ^ 2) / (M : ℝ)
  have hB : 0 < B := by dsimp [B]; positivity
  change (M : ℝ) * (256 * (B / (M : ℝ)) ^ ((1 : ℝ) / 2)) ^ theta =
    256 ^ theta * (M : ℝ) ^ (1 - theta / 2) * B ^ (theta / 2)
  rw [Real.mul_rpow (by norm_num) (by positivity),
    ← Real.rpow_mul (by positivity)]
  have e : (1 : ℝ) / 2 * theta = theta / 2 := by ring
  rw [e, Real.div_rpow hB.le hM.le, Real.rpow_sub hM]
  rw [Real.rpow_one]
  ring

theorem fractional (theta : ℝ) (ht0 : 0<theta) (ht2 : theta<2) :
    ∃ C:ℝ,0<C ∧ ∀ D E x:ℝ,1/2≤D → 1/2≤E → 1<x →
      ∀ M:ℕ,1≤M →
      (indices D E M).Finite ∧
      ((indices D E M).ncard:ℝ)≤3*(M:ℝ)+1 ∧
      (∀ j∈indices D E M,
        0<CofactorCubic.lambdaAt (U D x) (V E x) M ((rho D E M j)^4) ∧
        0<ell (V E x) (U D x) M ((rho D E M j)^4)) ∧
      (∑ᶠ j∈indices D E M,ell (V E x) (U D x) M ((rho D E M j)^4)^theta) ≤
        C*(M:ℝ)^(1-theta/2)*
          (U D x*V E x+((U D x)^2+(V E x)^2)/(M:ℝ))^(theta/2) := by
  classical
  have h2theta : (2:ℝ)^theta<4 := by
    have h := Real.rpow_lt_rpow_of_exponent_lt (by norm_num : (1:ℝ)<2) ht2
    norm_num at h ⊢
    exact h
  let r:ℝ := (2:ℝ)^theta/4
  have hr1 : r<1 := by dsimp [r]; rw [div_lt_one (by norm_num)]; exact h2theta
  let C0:ℝ := 4+16384*2^theta/(1-r)
  have hC0 : 0<C0 := by dsimp [C0]; positivity
  refine ⟨C0*256^theta,by positivity,?_⟩
  intro D E x hD hE hx M hM
  have hD0 : 0<D := by linarith
  have hE0 : 0<E := by linarith
  have hx0 : 0<x := by linarith
  have hU : 0<U D x := by unfold U; positivity
  have hV : 0<V E x := by unfold V; positivity
  have hM1 : (1:ℝ)≤M := by exact_mod_cast hM
  have hM0 : (0:ℝ)<M := by linarith
  have hscale : (D/E)^4=V E x/U D x := by
    unfold U V
    field_simp [hD0.ne',hE0.ne',hx0.ne'] <;> ring
  obtain ⟨hfin,hcard⟩ := QuarticPaid.full_grid_finite D E M hD0 hE0 hM
  let S:Finset ℕ := hfin.toFinset
  have hSmem : ∀j,j∈S ↔ j∈indices D E M := fun j => Set.Finite.mem_toFinset hfin
  have hScard : (S.card:ℝ)≤3*(M:ℝ)+1 := by
    rw [Set.ncard_eq_toFinset_card _ hfin] at hcard
    exact hcard
  let Q:ℝ := U D x*V E x+((U D x)^2+(V E x)^2)/(M:ℝ)
  let Ls:ℝ := 256*(Q/(M:ℝ))^((1:ℝ)/2)
  have hQ0 : 0<Q := by dsimp [Q]; positivity
  have hLs : 0<Ls := by dsimp [Ls]; positivity
  have hab := CofactorCubic.threshold_absorption (U D x) (V E x) M hU hV hM0
  have hth : 128*(U D x+V E x)/(M:ℝ)≤Ls := by
    have hh := (le_max_right _ _).trans hab
    calc
      128*(U D x+V E x)/(M:ℝ)=4*(32*(U D x+V E x)/(M:ℝ)) := by ring
      _ ≤ 4*(64*(Q/(M:ℝ))^((1:ℝ)/2)) :=
        mul_le_mul_of_nonneg_left hh (by norm_num)
      _ = Ls := by dsimp [Ls]; ring
  have hb : (U D x*V E x/(M:ℝ))^((1:ℝ)/2)≤Ls := by
    have hh := (le_max_left _ _).trans hab
    have hz : 0≤(Q/(M:ℝ))^((1:ℝ)/2) := by positivity
    dsimp only [Ls]
    change _≤64*(Q/(M:ℝ))^((1:ℝ)/2) at hh
    linarith
  have hQ : U D x*V E x≤(M:ℝ)*Ls^2 := by
    have hs := pow_le_pow_left₀ (by positivity : 0≤(U D x*V E x/(M:ℝ))^((1:ℝ)/2)) hb 2
    rw [JocelynWorkspace.Formalization.PowerfulCounting.LatticeMoments.JocelynMoments.sq_rpow_half _ (by positivity)] at hs
    rw [div_le_iff₀ hM0] at hs
    linarith
  have hpos : ∀j,0<CofactorCubic.lambdaAt (U D x) (V E x) M ((rho D E M j)^4) ∧
      0<ell (V E x) (U D x) M ((rho D E M j)^4) :=
    fun j => CofactorCubic.positiveAt (U D x) (V E x) M _ hU hV hM0
  have ht : ∀L:ℝ,Ls≤L →
      ((S.filter (fun j => L≤ell (V E x) (U D x) M ((rho D E M j)^4))).card:ℝ)
        ≤16384*(U D x*V E x)/L^2 := by
    intro L hL
    simpa only [mul_assoc] using
      QuarticPaid.actual_quartic_tail D E (U D x) (V E x) M hD0 hE0 hU hV hM
        hscale S (fun j hj => (hSmem j).mp hj) L (hth.trans hL)
  have hm := JocelynWorkspace.Formalization.PowerfulCounting.LatticeMoments.JocelynMoments.moment_from_tails
    theta ht0 r rfl hr1 S (fun j => ell (V E x) (U D x) M ((rho D E M j)^4))
    (fun j _ => (hpos j).2.le) Ls (M:ℝ) 16384 (U D x*V E x)
    hLs hM1 (by positivity) hQ (by norm_num) hScard ht
  refine ⟨hfin,hcard,fun j _=>hpos j,?_⟩
  rw [finsum_mem_eq_finite_toFinset_sum _ hfin]
  calc
    _ ≤ C0*(M:ℝ)*Ls^theta := hm
    _ = _ := by
      dsimp only [Ls,Q]
      rw [mul_assoc,scale_identity theta (U D x) (V E x) M hU hV hM0]
      ring

lemma scale_bounds (K x A : ℝ) (hK : 0 < K) (hx : 2 ≤ x)
    (hA : 1 / 2 ≤ A) (hAu : A ≤ x ^ K) :
    x ^ (-(4 * K + 5)) ≤ A ∧ A ≤ x ^ (4 * K + 5) ∧
      x ^ (-(4 * K + 5)) ≤ U A x ∧ U A x ≤ x ^ (4 * K + 5) := by
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hA0 : 0 < A := by linarith
  have hJ1 : 1 ≤ 4 * K + 5 := by linarith
  have hxJ : 2 ≤ x ^ (4 * K + 5) := by
    have hh := Real.rpow_le_rpow_of_exponent_le hx1 hJ1
    rw [Real.rpow_one] at hh
    exact hx.trans hh
  have hlowhalf : x ^ (-(4 * K + 5)) ≤ 1 / 2 := by
    calc
      _ = 1 / x ^ (4 * K + 5) := by rw [Real.rpow_neg hx0.le]; simp only [one_div]
      _ ≤ 1 / 2 := one_div_le_one_div_of_le (by norm_num) hxJ
  have hupper : A ≤ x ^ (4 * K + 5) :=
    hAu.trans (Real.rpow_le_rpow_of_exponent_le hx1 (by linarith))
  have hUeq : U A x = x / A ^ 4 := rfl
  have hcube : A ^ 4 ≤ x ^ (4 * K) := by
    calc
      _ ≤ (x ^ K) ^ 4 := pow_le_pow_left₀ hA0.le hAu 4
      _ = _ := by rw [← Real.rpow_mul_natCast hx0.le]; congr 1 <;> ring
  have hUlower : x ^ (-(4 * K + 5)) ≤ U A x := by
    rw [hUeq]
    calc
      _ ≤ x ^ (-(4 * K)) := Real.rpow_le_rpow_of_exponent_le hx1 (by linarith)
      _ = 1 / x ^ (4 * K) := by rw [Real.rpow_neg hx0.le]; simp only [one_div]
      _ ≤ 1 / A ^ 4 := one_div_le_one_div_of_le (pow_pos hA0 4) hcube
      _ ≤ x / A ^ 4 := div_le_div_of_nonneg_right hx1 (pow_nonneg hA0.le 4)
  have hUupper : U A x ≤ x ^ (4 * K + 5) := by
    rw [hUeq]
    have hcubelow : (1 / 2 : ℝ) ^ 4 ≤ A ^ 4 :=
      pow_le_pow_left₀ (by norm_num) hA 4
    have hxthree : (16 : ℝ) ≤ x ^ 4 := by
      have := pow_le_pow_left₀ (by norm_num : (0 : ℝ) ≤ 2) hx 4
      norm_num at this
      exact this
    calc
      _ ≤ x / (1 / 2 : ℝ) ^ 4 :=
        div_le_div_of_nonneg_left hx0.le (by norm_num) hcubelow
      _ = 16 * x := by ring
      _ ≤ x ^ 5 := by nlinarith [mul_le_mul_of_nonneg_right hxthree hx0.le]
      _ = x ^ (5 : ℝ) := by norm_num
      _ ≤ x ^ (4 * K + 5) := Real.rpow_le_rpow_of_exponent_le hx1 (by linarith)
  exact ⟨hlowhalf.trans hA, hupper, hUlower, hUupper⟩

theorem main :
    ∀ K eps : ℝ, 0 < K → 0 < eps →
      ∃ C : ℝ, 0 < C ∧
        ∀ x D E : ℝ, 2 ≤ x →
          1 / 2 ≤ D → D ≤ x ^ K →
          1 / 2 ≤ E → E ≤ x ^ K →
          ∀ M : ℕ, 1 ≤ M → (M : ℝ) ≤ x ^ K →
            (indices D E M).Finite ∧
            (∑ᶠ j ∈ indices D E M, (ell D E M (rho D E M j)) ^ 2) ≤
              C * x ^ eps * (D * E + (D ^ 2 + E ^ 2) / (M : ℝ)) ∧
            (∑ᶠ j ∈ indices D E M,
              (ell (V E x) (U D x) M ((rho D E M j) ^ (4 : ℕ))) ^ 2) ≤
              C * x ^ eps *
                (U D x * V E x + ((U D x) ^ 2 + (V E x) ^ 2) / (M : ℝ)) := by
  intro K eps hK heps
  let J : ℝ := 4 * K + 5
  have hJ : 0 < J := by dsimp [J]; linarith
  let delta : ℝ := eps / (3 * J + eps)
  have hd : 0 < delta := by dsimp [delta]; positivity
  have hd1 : delta < 1 := by
    dsimp [delta]
    rw [div_lt_one (by positivity)]
    linarith
  let theta : ℝ := 2 - delta
  have ht0 : 0 < theta := by dsimp [theta]; linarith
  have ht2 : theta < 2 := by dsimp [theta]; linarith
  have hdeq : delta * (3 * J + eps) = eps := by
    dsimp [delta]
    field_simp
  have hexp : 5 * J * delta / 2 ≤ eps := by
    have hh : 0 ≤ delta * eps := mul_nonneg hd.le heps.le
    have hjd : 0 ≤ J * delta := mul_nonneg hJ.le hd.le
    nlinarith
  obtain ⟨Cd, hCd, hdiv⟩ := JointSecondMoments.divisor_half_fractional theta ht0 ht2
  obtain ⟨Cc, hCc, hcof⟩ :=
    fractional theta ht0 ht2
  refine ⟨Cd + Cc, add_pos hCd hCc, ?_⟩
  intro x D E hx hD hDu hE hEu M hM hMu
  classical
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hD0 : 0 < D := by linarith
  have hE0 : 0 < E := by linarith
  have hM1 : (1 : ℝ) ≤ M := by exact_mod_cast hM
  have hM0 : (0 : ℝ) < M := by linarith
  have hU : 0 < U D x := by unfold U; positivity
  have hV : 0 < V E x := by unfold V; positivity
  obtain ⟨hDl, hDupper, hUl, hUupper⟩ := scale_bounds K x D hK hx hD hDu
  obtain ⟨hEl, hEupper, hVl, hVupper⟩ := scale_bounds K x E hK hx hE hEu
  have hMu' : (M : ℝ) ≤ x ^ J :=
    hMu.trans (Real.rpow_le_rpow_of_exponent_le hx1 (by dsimp [J]; linarith))
  obtain ⟨hfin, hfd⟩ := hdiv D E hD hE M hM
  change (indices D E M).Finite at hfin
  change (∑ᶠ j∈indices D E M,ell D E M (rho D E M j)^theta)≤
    Cd*(M:ℝ)^(1-theta/2)*(D*E+(D^2+E^2)/(M:ℝ))^(theta/2) at hfd
  obtain ⟨hfinC, hcard, hpos, hfc0⟩ := hcof D E x hD hE (by linarith) M hM
  have hfc : (∑ᶠ j ∈ indices D E M,
      ell (V E x) (U D x) M ((rho D E M j) ^ (4 : ℕ)) ^ theta) ≤
      Cc * (M : ℝ) ^ (1 - theta / 2) *
        (U D x * V E x + ((U D x) ^ 2 + (V E x) ^ 2) / (M : ℝ)) ^ (theta / 2) := hfc0
  let S : Finset ℕ := hfin.toFinset
  have hSmem : ∀ j, j ∈ S ↔ j ∈ indices D E M := fun j => Set.Finite.mem_toFinset hfin
  let Qd : ℝ := D * E + (D ^ 2 + E ^ 2) / (M : ℝ)
  let Qc : ℝ := U D x * V E x + ((U D x) ^ 2 + (V E x) ^ 2) / (M : ℝ)
  have hQd : 0 < Qd := by dsimp [Qd]; positivity
  have hQc : 0 < Qc := by dsimp [Qc]; positivity
  have hQdl : x ^ (-2 * J) ≤ Qd :=
    JointSecondMoments.budget_lower x J D E M hx0 hD0 hE0 hM0 hDl hEl
  have hQcl : x ^ (-2 * J) ≤ Qc :=
    JointSecondMoments.budget_lower x J (U D x) (V E x) M hx0 hU hV hM0 hUl hVl
  rw [finsum_mem_eq_finite_toFinset_sum _ hfin] at hfd hfc
  have hupD := JointSecondMoments.upgrade x J eps delta theta Cd Qd (M : ℝ) S
    (fun j => ell D E M (rho D E M j))
    hx hJ heps hd rfl hexp hCd hQd hQdl hM1 hMu'
    (fun j _ => JointSecondMoments.positive D E M _ hD0 hE0 hM0)
    (fun j _ => (JointSecondMoments.cap D E M _ hD0 hE0 hM1).trans (max_le hDupper hEupper))
    hfd
  have hupC := JointSecondMoments.upgrade x J eps delta theta Cc Qc (M : ℝ) S
    (fun j => ell (V E x) (U D x) M ((rho D E M j) ^ (4 : ℕ)))
    hx hJ heps hd rfl hexp hCc hQc hQcl hM1 hMu'
    (fun j _ => JointSecondMoments.positive (V E x) (U D x) M _ hV hU hM0)
    (fun j _ => (JointSecondMoments.cap (V E x) (U D x) M _ hV hU hM1).trans (max_le hVupper hUupper))
    hfc
  refine ⟨hfin, ?_, ?_⟩
  · rw [finsum_mem_eq_finite_toFinset_sum _ hfin]
    calc
      _ ≤ Cd * x ^ eps * Qd := hupD
      _ = Cd * (x ^ eps * Qd) := by ring
      _ ≤ (Cd + Cc) * (x ^ eps * Qd) :=
        mul_le_mul_of_nonneg_right (by linarith) (by positivity)
      _ = _ := by ring
  · rw [finsum_mem_eq_finite_toFinset_sum _ hfin]
    calc
      _ ≤ Cc * x ^ eps * Qc := hupC
      _ = Cc * (x ^ eps * Qc) := by ring
      _ ≤ (Cd + Cc) * (x ^ eps * Qc) :=
        mul_le_mul_of_nonneg_right (by linarith) (by positivity)
      _ = _ := by ring

end
end A7QuarticMomentsNew

namespace A6PhysicalFrameProofV1
open A6PhysicalFrameDraftV1
private lemma quartic_norm_scale (D E m s : ℝ) (hD : 0 < D) (hE : 0 < E)
    (z : A6ActualTriangularLatticeFrameStatement.IntegerPoint) :
    A6ActualTriangularLatticeFrameStatement.euclideanNorm
      (A6ActualTriangularLatticeFrameStatement.transformedPoint (32*D) (32*E) m s z) =
    A6ActualTriangularLatticeFrameStatement.euclideanNorm
      (A6ActualTriangularLatticeFrameStatement.transformedPoint D E m s z)/32 := by
  rw [generic_norm_eq,generic_norm_eq]
  have he : ((m/(32*D))*((z 0:ℝ)-s*(z 1:ℝ)))^2+((z 1:ℝ)/(32*E))^2 =
      (((m/D)*((z 0:ℝ)-s*(z 1:ℝ)))^2+((z 1:ℝ)/E)^2)/(32:ℝ)^2 := by
    field_simp [hD.ne',hE.ne'] <;> ring
  rw [he,Real.sqrt_div (by positivity)]
  norm_num

private lemma quartic_ell_scale (D E m s : ℝ) (hD : 0 < D) (hE : 0 < E) :
    reciprocalShortestNorm (32*D) (32*E) m s =
      32*reciprocalShortestNorm D E m s := by
  rw [ell_agree,ell_agree]
  let N := A6ActualTriangularLatticeFrameStatement.nonzeroLatticeNorms D E m s
  let Ns := A6ActualTriangularLatticeFrameStatement.nonzeroLatticeNorms (32*D) (32*E) m s
  have hne (A B : ℝ) :
      (A6ActualTriangularLatticeFrameStatement.nonzeroLatticeNorms A B m s).Nonempty := by
    refine ⟨_,![1,0],?_,rfl⟩
    intro hh
    have hh0 := congrArg (fun z : Fin 2 → ℤ => z 0) hh
    norm_num at hh0
  have hbd (A B : ℝ) :
      BddBelow (A6ActualTriangularLatticeFrameStatement.nonzeroLatticeNorms A B m s) := by
    refine ⟨0,?_⟩
    rintro r ⟨z,hz,rfl⟩
    exact Real.sqrt_nonneg _
  have h1 : 32*sInf Ns ≤ sInf N := by
    apply le_csInf (hne D E)
    rintro r ⟨z,hz,rfl⟩
    have hh := csInf_le (hbd (32*D) (32*E)) ⟨z,hz,rfl⟩
    rw [quartic_norm_scale D E m s hD hE] at hh
    linarith only [hh]
  have h2 : sInf N/32 ≤ sInf Ns := by
    apply le_csInf (hne (32*D) (32*E))
    rintro r ⟨z,hz,rfl⟩
    have hh := csInf_le (hbd D E) ⟨z,hz,rfl⟩
    rw [quartic_norm_scale D E m s hD hE]
    linarith only [hh]
  have hs : sInf Ns = sInf N/32 := by linarith only [h1,h2]
  change 1/sInf Ns = 32*(1/sInf N)
  rw [hs,div_div_eq_mul_div]
  ring

end A6PhysicalFrameProofV1

namespace A7OriginalPacket
noncomputable section
open scoped BigOperators
open FormalAB.S5ecab545.JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C09.PcPellRed
abbrev IntegerPoint := Fin 2 → ℤ
abbrev IntegerMatrix := Matrix (Fin 2) (Fin 2) ℤ
abbrev OriginalPoint := Fin 4 → ℕ
abbrev U := A7QuarticMomentsNew.U
abbrev V := A7QuarticMomentsNew.V
abbrev rho := ActualSourceGrid.rho
abbrev indices := ActualSourceGrid.indices
abbrev reciprocalShortestNorm := A6PhysicalFrameDraftV1.reciprocalShortestNorm
abbrev matrixBound := A6PhysicalFrameDraftV1.matrixBound
def originalPopulation (h:ℤ) (x D E:ℝ) : Set OriginalPoint :=
  {z | (∀i:Fin 4,0<z i) ∧ D/2<(z 0:ℝ) ∧ (z 0:ℝ)≤D ∧
    E/2<(z 1:ℝ) ∧ (z 1:ℝ)≤E ∧ x/2<(z 0:ℝ)^4*(z 2:ℝ) ∧
    (z 0:ℝ)^4*(z 2:ℝ)≤x ∧
    (z 1:ℤ)^4*(z 3:ℤ)-(z 0:ℤ)^4*(z 2:ℤ)=h}
def sourceCell (h:ℤ) (x D E:ℝ) (M j:ℕ) : Set OriginalPoint :=
  {z | z∈originalPopulation h x D E ∧ rho D E M j<(z 0:ℝ)/(z 1:ℝ) ∧
    (z 0:ℝ)/(z 1:ℝ)≤rho D E M j*(1+1/(M:ℝ))}
lemma norm_agree (A B:ℝ) (M:ℕ) (s:ℝ) :
    reciprocalShortestNorm A B (M:ℝ) s=JointSecondMoments.ell A B M s :=
  A6OriginalPacket.norm_agree A B M s
lemma matrixBound_mono (P:IntegerMatrix) {H H':ℝ}
    (hP:matrixBound P H) (hH:H≤H') : matrixBound P H' :=
  A6OriginalPacket.matrixBound_mono P hP hH
lemma sum_scaled (J:Set ℕ) (hJ:J.Finite) (f:ℕ→ℝ) (c:ℝ) :
    (∑ᶠ j∈J,(c*f j)^2)=c^2*(∑ᶠ j∈J,(f j)^2) :=
  A6OriginalPacket.sum_scaled J hJ f c

lemma ratio_bounds (h:ℤ) (x D E : ℝ) (hD : 0 < D) (hE : 0 < E)
    (z : OriginalPoint) (hz : z ∈ originalPopulation h x D E) :
    D / (2 * E) < (z 0 : ℝ) / (z 1 : ℝ) ∧
      (z 0 : ℝ) / (z 1 : ℝ) < 2 * D / E := by
  obtain ⟨hp, hdlo, hdhi, helo, hehi, hnlo, hnhi, hunit⟩ := hz
  have he : (0 : ℝ) < z 1 := by exact_mod_cast hp 1
  constructor
  · apply (div_lt_div_iff₀ (by positivity : 0 < 2 * E) he).2
    calc
      D * (z 1 : ℝ) ≤ D * E := mul_le_mul_of_nonneg_left hehi hD.le
      _ < (2 * (z 0 : ℝ)) * E :=
        mul_lt_mul_of_pos_right (by linarith) hE
      _ = (z 0 : ℝ) * (2 * E) := by ring
  · apply (div_lt_div_iff₀ he hE).2
    calc
      (z 0 : ℝ) * E ≤ D * E := mul_le_mul_of_nonneg_right hdhi hE.le
      _ < D * (2 * (z 1 : ℝ)) :=
        mul_lt_mul_of_pos_left (by linarith) hD
      _ = (2 * D) * (z 1 : ℝ) := by ring

lemma uv_bounds (x D E d e u v h:ℝ)
    (hx:2≤x) (hD:0<D) (hE:0<E) (hd:0<d) (he:0<e)
    (hu:0≤u) (hv:0≤v) (hdlo:D/2<d) (helo:E/2<e)
    (hn:d^4*u≤x) (hh:|h|≤1) (hunit:e^4*v-d^4*u=h) :
    u≤16*(x/D^4) ∧ v≤24*(x/E^4) := by
  have hD4 : 0<D^4 := pow_pos hD 4
  have hE4 : 0<E^4 := pow_pos hE 4
  have hdc : D^4≤16*d^4 := by
    have hp := pow_le_pow_left₀ hD.le (show D≤2*d by linarith) 4
    nlinarith only [hp]
  have hec : E^4≤16*e^4 := by
    have hp := pow_le_pow_left₀ hE.le (show E≤2*e by linarith) 4
    nlinarith only [hp]
  have hhle : h≤1 := (le_abs_self h).trans hh
  constructor
  · rw [show 16*(x/D^4)=16*x/D^4 by ring]
    apply (le_div_iff₀ hD4).mpr
    have hh := mul_le_mul_of_nonneg_left hdc hu
    nlinarith only [hh,hn]
  · rw [show 24*(x/E^4)=24*x/E^4 by ring]
    apply (le_div_iff₀ hE4).mpr
    have hh := mul_le_mul_of_nonneg_left hec hv
    nlinarith only [hh,hunit,hn,hhle,hx]

lemma cofactor_source_strip (x D E m r d e u v h:ℝ)
    (hx:2≤x) (hD:0<D) (hE:0<E) (hm : 1 ≤ m) (hMx : m ≤ x)
    (hd:0<d) (he:0<e) (hu:0≤u) (helo:E/2<e)
    (hn:d^4*u≤x) (hh:|h|≤1) (hunit:e^4*v-d^4*u=h)
    (hr:0<r) (hlo:r<d/e) (hhi:d/e≤r*(1+1/m)) :
    |v-r^4*u|≤256*(x/E^4)/m := by
  have hm0 : 0 < m := by linarith
  have hx0 : 0<x := by linarith
  have he4 : 0<e^4 := pow_pos he 4
  have hE4 : 0<E^4 := pow_pos hE 4
  let t:ℝ := d/e
  have ht : 0<t := div_pos hd he
  have hrt : 0≤t^4-r^4 := sub_nonneg.mpr (pow_le_pow_left₀ hr.le hlo.le 4)
  have hq1 : 1≤1+1/m := by
    have hh : 0≤1/m := by positivity
    linarith
  have hinv : 0≤1/m := by positivity
  have hinv1 : 1/m≤1 := (div_le_one hm0).mpr hm
  have hbin : (1+1/m)^4-1≤15/m := by
    have h2 : (1/m)^2≤1/m := by nlinarith [mul_nonneg hinv (sub_nonneg.mpr hinv1)]
    have h3 : (1/m)^3≤1/m := by
      calc
        _ = (1/m)^2*(1/m) := by ring
        _ ≤ (1/m)*(1/m) := mul_le_mul_of_nonneg_right h2 hinv
        _ = (1/m)^2 := by ring
        _ ≤ _ := h2
    have h4 : (1/m)^4≤1/m := by
      calc
        _ = (1/m)^3*(1/m) := by ring
        _ ≤ (1/m)*(1/m) := mul_le_mul_of_nonneg_right h3 hinv
        _ = (1/m)^2 := by ring
        _ ≤ _ := h2
    have hid : (1+1/m)^4-1=4*(1/m)+6*(1/m)^2+4*(1/m)^3+(1/m)^4 := by ring
    rw [hid,show 15/m=15*(1/m) by ring]
    nlinarith only [h2,h3,h4]
  have hqpow0 : 0≤(1+1/m)^4-1 := by
    have hh : (1:ℝ)≤(1+1/m)^4 := one_le_pow₀ hq1
    linarith
  have hdiff : t^4-r^4≤15*t^4/m := by
    have htq := pow_le_pow_left₀ ht.le hhi 4
    rw [mul_pow] at htq
    have hrp := pow_le_pow_left₀ hr.le hlo.le 4
    have hh1 : t^4-r^4≤r^4*((1+1/m)^4-1) := by nlinarith only [htq]
    calc
      _ ≤ r^4*((1+1/m)^4-1) := hh1
      _ ≤ t^4*((1+1/m)^4-1) := mul_le_mul_of_nonneg_right hrp hqpow0
      _ ≤ t^4*(15/m) := mul_le_mul_of_nonneg_left hbin (pow_nonneg ht.le 4)
      _ = _ := by ring
  have hec : E^4≤16*e^4 := by
    have hp := pow_le_pow_left₀ hE.le (show E≤2*e by linarith) 4
    nlinarith only [hp]
  have htu : t^4*u≤16*(x/E^4) := by
    have htueq : t^4*u=(d^4*u)/e^4 := by dsimp [t]; field_simp [he.ne'] <;> ring
    rw [htueq]
    calc
      _ ≤ x/e^4 := div_le_div_of_nonneg_right hn he4.le
      _ ≤ 16*(x/E^4) := by
        rw [show 16*(x/E^4)=16*x/E^4 by ring]
        apply (div_le_div_iff₀ he4 hE4).mpr
        nlinarith only [mul_le_mul_of_nonneg_left hec hx0.le]
  have herr : |h/e^4|≤16*(x/E^4)/m := by
    rw [abs_div,abs_of_pos he4]
    calc
      _ ≤ 1/e^4 := div_le_div_of_nonneg_right hh he4.le
      _ ≤ 16*(x/E^4)/m := by
        rw [show 16*(x/E^4)/m=16*x/(E^4*m) by ring]
        apply (div_le_div_iff₀ he4 (mul_pos hE4 hm0)).mpr
        have hh1 := mul_le_mul_of_nonneg_right hMx hE4.le
        have hh2 := mul_le_mul_of_nonneg_left hec hx0.le
        nlinarith only [hh1,hh2]
  have hid : v-r^4*u=(t^4-r^4)*u+h/e^4 := by
    dsimp [t]
    field_simp [he.ne']
    nlinarith only [hunit]
  calc
    _ = |(t^4-r^4)*u+h/e^4| := by rw [hid]
    _ ≤ |(t^4-r^4)*u|+|h/e^4| := abs_add_le _ _
    _ = (t^4-r^4)*u+|h/e^4| := by rw [abs_of_nonneg (mul_nonneg hrt hu)]
    _ ≤ (15*t^4/m)*u+16*(x/E^4)/m :=
      add_le_add (mul_le_mul_of_nonneg_right hdiff hu) herr
    _ = 15/m*(t^4*u)+16*(x/E^4)/m := by ring
    _ ≤ 15/m*(16*(x/E^4))+16*(x/E^4)/m :=
      add_le_add (mul_le_mul_of_nonneg_left htu (show (0:ℝ)≤15/m by positivity)) (le_refl _)
    _ = _ := by ring

theorem physical :
    ∃ Cp:ℝ,0<Cp ∧
    ∀ x D E:ℝ,∀ M j:ℕ,∀ h:ℤ,
      2≤x → 0<D → 0<E → 1≤M → (M:ℝ)≤x →
      (h=1 ∨ h= -1) → j∈indices D E M →
      (sourceCell h x D E M j).Nonempty →
      ∃ Pd Ad Pt At:IntegerMatrix,
        Ad*Pd=1 ∧ Pd*Ad=1 ∧ At*Pt=1 ∧ Pt*At=1 ∧
        matrixBound Pd (Cp*(M:ℝ)*max D E) ∧
        matrixBound Ad (Cp*(M:ℝ)*max D E) ∧
        matrixBound Pt (Cp*(M:ℝ)*max (U D x) (V E x)) ∧
        matrixBound At (Cp*(M:ℝ)*max (U D x) (V E x)) ∧
        ∀z∈sourceCell h x D E M j,
          (∀i:Fin 2,|(Ad.mulVec ![(z 0:ℤ),(z 1:ℤ)] i:ℝ)|≤
            Cp*reciprocalShortestNorm D E (M:ℝ) (rho D E M j)) ∧
          (∀i:Fin 2,|(At.mulVec ![(z 3:ℤ),(z 2:ℤ)] i:ℝ)|≤
            Cp*reciprocalShortestNorm (V E x) (U D x) (M:ℝ) ((rho D E M j)^4)) := by
  classical
  obtain ⟨Cf,hCf,hframe⟩ := A6ActualTriangularLatticeFrameStatement.frame_main 32 (by norm_num)
  refine ⟨32*Cf,by positivity,?_⟩
  intro x D E M j h hx hD hE hM hMx hh hj hocc
  have hm1 : (1:ℝ)≤M := by exact_mod_cast hM
  have hm : (0:ℝ)<M := by linarith
  have hx0 : 0<x := by linarith
  have hU : 0<U D x := by unfold U A7QuarticMomentsNew.U; positivity
  have hV : 0<V E x := by unfold V A7QuarticMomentsNew.V; positivity
  have hr : 0<rho D E M j := (by positivity : 0<D/(2*E)).trans_le hj.1
  have habsh : |(h:ℝ)|≤1 := by rcases hh with rfl|rfl <;> norm_num
  have width (z:OriginalPoint) (hz:z∈sourceCell h x D E M j) :
      |(z 0:ℝ)/(z 1:ℝ)-rho D E M j|≤2*D/(E*(M:ℝ)) :=
    (ActualSourceGrid.main D E hD hE M hM).2 j hj _ hz.2
  have unpack (z:OriginalPoint) (hz:z∈sourceCell h x D E M j) :
      1≤D ∧ 1≤E ∧ (z 2:ℝ)≤16*U D x ∧ (z 3:ℝ)≤24*V E x ∧
      |(z 0:ℝ)-rho D E M j*(z 1:ℝ)|≤2*D/(M:ℝ) ∧
      |(z 3:ℝ)-(rho D E M j)^4*(z 2:ℝ)|≤256*V E x/(M:ℝ) := by
    obtain ⟨hp,hdlo,hdhi,helo,hehi,hnlo,hnhi,hunit⟩ := hz.1
    have hp0 (i:Fin 4) : (0:ℝ)<z i := by exact_mod_cast hp i
    have hp1 (i:Fin 4) : (1:ℝ)≤z i := by exact_mod_cast (show 1≤z i from hp i)
    have hun : (z 1:ℝ)^4*(z 3:ℝ)-(z 0:ℝ)^4*(z 2:ℝ)=(h:ℝ) := by exact_mod_cast hunit
    obtain ⟨hub,hvb⟩ := uv_bounds x D E (z 0) (z 1) (z 2) (z 3) h
      hx hD hE (hp0 0) (hp0 1) (hp0 2).le (hp0 3).le hdlo helo hnhi habsh hun
    refine ⟨(hp1 0).trans hdhi,(hp1 1).trans hehi,hub,hvb,?_,?_⟩
    · exact A6PhysicalFrameProofV1.divisor_strip 2 D E M (rho D E M j) (z 0) (z 1)
        (by norm_num) hD hE hm (hp0 1) hehi (width z hz)
    · exact cofactor_source_strip x D E M (rho D E M j) (z 0) (z 1) (z 2) (z 3) h
        hx hD hE hm1 hMx (hp0 0) (hp0 1) (hp0 2).le helo hnhi habsh hun hr hz.2.1 hz.2.2
  obtain ⟨z0,hz0⟩ := hocc
  obtain ⟨hD1,hE1,hub0,hvb0,_,_⟩ := unpack z0 hz0
  have hp01 (i:Fin 4) : (1:ℝ)≤z0 i := by exact_mod_cast (show 1≤z0 i from hz0.1.1 i)
  have h32U : 1≤32*U D x := by nlinarith only [hp01 2,hub0,hU]
  have h32V : 1≤32*V E x := by nlinarith only [hp01 3,hvb0,hV]
  have hsD : |rho D E M j|≤32*D/E := by
    rw [abs_of_pos hr]
    exact hj.2.trans (by
      apply div_le_div_of_nonneg_right _ hE.le
      nlinarith only [hD])
  have hsT : |(rho D E M j)^4|≤32*(32*V E x)/(32*U D x) := by
    rw [abs_of_nonneg (pow_nonneg hr.le 4)]
    have hp := pow_le_pow_left₀ hr.le hj.2 4
    have heq : (2*D/E)^4=16*V E x/U D x := by
      unfold U V A7QuarticMomentsNew.U A7QuarticMomentsNew.V
      field_simp [hD.ne',hE.ne',hx0.ne'] <;> ring
    rw [heq] at hp
    apply hp.trans
    have heq2 : 32*(32*V E x)/(32*U D x)=32*V E x/U D x := by
      field_simp [hU.ne'] <;> ring
    rw [heq2]
    apply div_le_div_of_nonneg_right _ hU.le
    nlinarith only [hV]
  obtain ⟨_,hellD,_,Pd,Ad,hAPd,hPAd,hPd,hAd,hcoordD⟩ :=
    hframe D E M (rho D E M j) hD1 hE1 hm1 hsD
  obtain ⟨_,hellT,_,Pt,At,hAPt,hPAt,hPt,hAt,hcoordT⟩ :=
    hframe (32*V E x) (32*U D x) M ((rho D E M j)^4) h32V h32U hm1 hsT
  have hmax : max (32*V E x) (32*U D x)=32*max (U D x) (V E x) := by
    rw [←mul_max_of_nonneg _ _ (by norm_num : (0:ℝ)≤32),max_comm]
  have hCff : Cf≤32*Cf := by linarith only [hCf]
  have hboundD (P:IntegerMatrix)
      (hP:A6ActualTriangularLatticeFrameStatement.integerMatrixBound P (Cf*M*max D E)) :
      matrixBound P (32*Cf*M*max D E) := by
    intro i k
    exact (hP i k).trans (mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_right hCff hm.le) (le_max_of_le_left hD.le))
  have hboundT (P:IntegerMatrix)
      (hP:A6ActualTriangularLatticeFrameStatement.integerMatrixBound P
        (Cf*M*max (32*V E x) (32*U D x))) :
      matrixBound P (32*Cf*M*max (U D x) (V E x)) := by
    intro i k
    have hh := hP i k
    rw [hmax] at hh
    convert hh using 1 <;> ring
  refine ⟨Pd,Ad,Pt,At,hAPd,hPAd,hAPt,hPAt,
    hboundD Pd hPd,hboundD Ad hAd,hboundT Pt hPt,hboundT At hAt,?_⟩
  intro z hz
  obtain ⟨_,_,hub,hvb,hstripD,hstripT⟩ := unpack z hz
  have hDcell : (![(z 0:ℤ),(z 1:ℤ)]:IntegerPoint) ∈
      A6ActualTriangularLatticeFrameStatement.physicalCell 32 D E M (rho D E M j) := by
    constructor
    · change |(z 0:ℝ)-rho D E M j*(z 1:ℝ)|≤32*D/(M:ℝ)
      exact hstripD.trans (by apply div_le_div_of_nonneg_right _ hm.le; nlinarith only [hD])
    · change |(z 1:ℝ)|≤32*E
      rw [abs_of_nonneg (Nat.cast_nonneg _)]
      exact hz.1.2.2.2.2.1.trans (by nlinarith only [hE])
  have hTcell : (![(z 3:ℤ),(z 2:ℤ)]:IntegerPoint) ∈
      A6ActualTriangularLatticeFrameStatement.physicalCell 32 (32*V E x) (32*U D x) M ((rho D E M j)^4) := by
    constructor
    · change |(z 3:ℝ)-(rho D E M j)^4*(z 2:ℝ)|≤32*(32*V E x)/(M:ℝ)
      exact hstripT.trans (by apply div_le_div_of_nonneg_right _ hm.le; nlinarith only [hV])
    · change |(z 2:ℝ)|≤32*(32*U D x)
      rw [abs_of_nonneg (Nat.cast_nonneg _)]
      exact hub.trans (by nlinarith only [hU])
  constructor
  · intro i
    have ht := hcoordD ![(z 0:ℤ),(z 1:ℤ)] hDcell i
    change |(Ad.mulVec ![(z 0:ℤ),(z 1:ℤ)] i:ℝ)|≤_
    rw [←A6PhysicalFrameProofV1.ell_agree] at ht hellD
    exact ht.trans (mul_le_mul_of_nonneg_right hCff hellD.le)
  · intro i
    have ht := hcoordT ![(z 3:ℤ),(z 2:ℤ)] hTcell i
    change |(At.mulVec ![(z 3:ℤ),(z 2:ℤ)] i:ℝ)|≤_
    rw [←A6PhysicalFrameProofV1.ell_agree,
      A6PhysicalFrameProofV1.quartic_ell_scale (V E x) (U D x) M ((rho D E M j)^4) hV hU] at ht
    have heq : Cf*(32*reciprocalShortestNorm (V E x) (U D x) (M:ℝ) ((rho D E M j)^4)) =
        32*Cf*reciprocalShortestNorm (V E x) (U D x) (M:ℝ) ((rho D E M j)^4) := by ring
    rw [heq] at ht
    exact ht

theorem main :
∃ Cphys : ℝ, 0 < Cphys ∧
  ∀ K eps : ℝ, 0 < K → 0 < eps →
    ∃ C : ℝ, 0 < C ∧
      ∀ x D E : ℝ, 2 ≤ x →
        1 / 2 ≤ D → D ≤ x ^ K →
        1 / 2 ≤ E → E ≤ x ^ K →
        ∀ M : ℕ, 1 ≤ M → (M : ℝ) ≤ x → (M : ℝ) ≤ x ^ K →
          ∀ h : ℤ, (h=1 ∨ h= -1) →
          let J := indices D E M;
          let L : ℕ → ℝ := fun j =>
            Cphys * reciprocalShortestNorm D E (M : ℝ) (rho D E M j);
          let T : ℕ → ℝ := fun j =>
            Cphys * reciprocalShortestNorm (V E x) (U D x) (M : ℝ)
              ((rho D E M j) ^ (4 : ℕ));
          J.Finite ∧
          (∀ z : OriginalPoint, z ∈ originalPopulation h x D E ↔
            ∃! j : ℕ, j ∈ J ∧ z ∈ sourceCell h x D E M j) ∧
          (∀ j ∈ J, ∀ z ∈ sourceCell h x D E M j,
            |(z 0 : ℝ) / (z 1 : ℝ) - rho D E M j| ≤
              2 * D / (E * (M : ℝ))) ∧
          (∀ j ∈ J, 0 < L j ∧ 0 < T j) ∧
          (∃ Pd Ad Pt At : ℕ → IntegerMatrix,
            (∀ j : ℕ,
              Ad j * Pd j = 1 ∧ Pd j * Ad j = 1 ∧
              At j * Pt j = 1 ∧ Pt j * At j = 1) ∧
            (∀ j ∈ J, (sourceCell h x D E M j).Nonempty →
              matrixBound (Pd j) (Cphys * (M : ℝ) * max D E) ∧
              matrixBound (Ad j) (Cphys * (M : ℝ) * max D E) ∧
              matrixBound (Pt j) (Cphys * (M : ℝ) * max (U D x) (V E x)) ∧
              matrixBound (At j) (Cphys * (M : ℝ) * max (U D x) (V E x)) ∧
              matrixBound (Pd j) (Cphys * x ^ (5 * K + 5)) ∧
              matrixBound (Ad j) (Cphys * x ^ (5 * K + 5)) ∧
              matrixBound (Pt j) (Cphys * x ^ (5 * K + 5)) ∧
              matrixBound (At j) (Cphys * x ^ (5 * K + 5))) ∧
            (∀ j ∈ J, ∀ z ∈ sourceCell h x D E M j,
              (∀ i : Fin 2,
                |((Ad j).mulVec ![(z 0 : ℤ), (z 1 : ℤ)] i : ℝ)| ≤ L j) ∧
              (∀ i : Fin 2,
                |((At j).mulVec ![(z 3 : ℤ), (z 2 : ℤ)] i : ℝ)| ≤ T j))) ∧
          (∑ᶠ j ∈ J, (L j) ^ 2) ≤
            C * x ^ eps * (D * E + (D ^ 2 + E ^ 2) / (M : ℝ)) ∧
          (∑ᶠ j ∈ J, (T j) ^ 2) ≤
            C * x ^ eps *
              (U D x * V E x + ((U D x) ^ 2 + (V E x) ^ 2) / (M : ℝ)) := by
  classical
  obtain ⟨Cphys, hCphys, hphysical⟩ :=
    physical
  refine ⟨Cphys, hCphys, ?_⟩
  intro K eps hK heps
  obtain ⟨Cm, hCm, hmom⟩ :=
    A7QuarticMomentsNew.main
      K eps hK heps
  let C : ℝ := Cphys ^ 2 * Cm
  refine ⟨C, mul_pos (pow_pos hCphys 2) hCm, ?_⟩
  intro x D E hx hD hDu hE hEu M hM hMx hMu h hh
  dsimp only
  let J : Set ℕ := indices D E M
  let L : ℕ → ℝ := fun j =>
    Cphys * reciprocalShortestNorm D E (M : ℝ) (rho D E M j)
  let T : ℕ → ℝ := fun j =>
    Cphys * reciprocalShortestNorm (V E x) (U D x) (M : ℝ) ((rho D E M j)^4)
  change
          J.Finite ∧
          (∀ z : OriginalPoint, z ∈ originalPopulation h x D E ↔
            ∃! j : ℕ, j ∈ J ∧ z ∈ sourceCell h x D E M j) ∧
          (∀ j ∈ J, ∀ z ∈ sourceCell h x D E M j,
            |(z 0 : ℝ) / (z 1 : ℝ) - rho D E M j| ≤
              2 * D / (E * (M : ℝ))) ∧
          (∀ j ∈ J, 0 < L j ∧ 0 < T j) ∧
          (∃ Pd Ad Pt At : ℕ → IntegerMatrix,
            (∀ j : ℕ,
              Ad j * Pd j = 1 ∧ Pd j * Ad j = 1 ∧
              At j * Pt j = 1 ∧ Pt j * At j = 1) ∧
            (∀ j ∈ J, (sourceCell h x D E M j).Nonempty →
              matrixBound (Pd j) (Cphys * (M : ℝ) * max D E) ∧
              matrixBound (Ad j) (Cphys * (M : ℝ) * max D E) ∧
              matrixBound (Pt j) (Cphys * (M : ℝ) * max (U D x) (V E x)) ∧
              matrixBound (At j) (Cphys * (M : ℝ) * max (U D x) (V E x)) ∧
              matrixBound (Pd j) (Cphys * x ^ (5 * K + 5)) ∧
              matrixBound (Ad j) (Cphys * x ^ (5 * K + 5)) ∧
              matrixBound (Pt j) (Cphys * x ^ (5 * K + 5)) ∧
              matrixBound (At j) (Cphys * x ^ (5 * K + 5))) ∧
            (∀ j ∈ J, ∀ z ∈ sourceCell h x D E M j,
              (∀ i : Fin 2,
                |((Ad j).mulVec ![(z 0 : ℤ), (z 1 : ℤ)] i : ℝ)| ≤ L j) ∧
              (∀ i : Fin 2,
                |((At j).mulVec ![(z 3 : ℤ), (z 2 : ℤ)] i : ℝ)| ≤ T j))) ∧
          (∑ᶠ j ∈ J, (L j) ^ 2) ≤
            C * x ^ eps * (D * E + (D ^ 2 + E ^ 2) / (M : ℝ)) ∧
          (∑ᶠ j ∈ J, (T j) ^ 2) ≤
            C * x ^ eps *
              (U D x * V E x + ((U D x) ^ 2 + (V E x) ^ 2) / (M : ℝ))
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hD0 : 0 < D := by linarith
  have hE0 : 0 < E := by linarith
  have hM0 : (0 : ℝ) < M := by exact_mod_cast (show 0 < M by omega)
  have hU0 : 0 < U D x := by change 0<x/D^4; positivity
  have hV0 : 0 < V E x := by change 0<x/E^4; positivity
  have hUnom : A7QuarticMomentsNew.U D x=U D x := rfl
  have hVnom : A7QuarticMomentsNew.V E x=V E x := rfl
  obtain ⟨hfin, hmd, hmt⟩ := hmom x D E hx hD hDu hE hEu M hM hMu
  have hJ : J.Finite := hfin
  change (∑ᶠ j ∈ indices D E M,
      (JointSecondMoments.ell D E M (rho D E M j)) ^ 2) ≤
    Cm * x ^ eps * (D * E + (D ^ 2 + E ^ 2) / (M : ℝ)) at hmd
  change (∑ᶠ j ∈ indices D E M,
      (JointSecondMoments.ell (A7QuarticMomentsNew.V E x) (A7QuarticMomentsNew.U D x)
        M ((rho D E M j)^4)) ^ 2) ≤
    Cm * x ^ eps *
      (A7QuarticMomentsNew.U D x * A7QuarticMomentsNew.V E x +
       ((A7QuarticMomentsNew.U D x)^2 + (A7QuarticMomentsNew.V E x)^2) / (M : ℝ)) at hmt
  simp only [hUnom, hVnom] at hmt
  have hmd' : (∑ᶠ j ∈ J,
      (reciprocalShortestNorm D E (M : ℝ) (rho D E M j)) ^ 2) ≤
      Cm * x ^ eps * (D * E + (D ^ 2 + E ^ 2) / (M : ℝ)) := by
    simpa only [norm_agree] using hmd
  have hmt' : (∑ᶠ j ∈ J,
      (reciprocalShortestNorm (V E x) (U D x) (M : ℝ) ((rho D E M j)^4)) ^ 2) ≤
      Cm * x ^ eps * (U D x * V E x + ((U D x)^2 + (V E x)^2) / (M : ℝ)) := by
    simpa only [norm_agree] using hmt
  obtain ⟨hcover, hwidth⟩ :=
    JocelynClaims.claim_cc2f883a9907e9a69c17e2aafaf2bf1c2ee3b88fbdc296e7631d672b82006b0b
      D E hD0 hE0 M hM
  have partition (z : OriginalPoint) :
      z ∈ originalPopulation h x D E ↔
        ∃! j : ℕ, j ∈ J ∧ z ∈ sourceCell h x D E M j := by
    constructor
    · intro hz
      obtain ⟨hlo,hhi⟩ := ratio_bounds h x D E hD0 hE0 z hz
      obtain ⟨j,hj,hu⟩ := hcover ((z 0:ℝ)/(z 1:ℝ)) hlo hhi
      refine ⟨j, ⟨hj.1,hz,hj.2⟩, ?_⟩
      intro l hl
      exact hu l ⟨hl.1,hl.2.2⟩
    · rintro ⟨j,hj,_⟩
      exact hj.2.1
  have width (j : ℕ) (hj : j ∈ J) (z : OriginalPoint)
      (hz : z ∈ sourceCell h x D E M j) :
      |(z 0:ℝ)/(z 1:ℝ)-rho D E M j| ≤ 2*D/(E*(M:ℝ)) :=
    hwidth j hj _ hz.2
  have hpos : ∀ j ∈ J, 0 < L j ∧ 0 < T j := by
    intro j hj
    constructor
    · apply mul_pos hCphys
      rw [norm_agree]
      exact JointSecondMoments.positive D E M _ hD0 hE0 hM0
    · apply mul_pos hCphys
      rw [norm_agree]
      exact JointSecondMoments.positive (V E x) (U D x) M _ hV0 hU0 hM0
  obtain ⟨_,_,_,hUu⟩ := A7QuarticMomentsNew.scale_bounds K x D hK hx hD hDu
  obtain ⟨_,_,_,hVu⟩ := A7QuarticMomentsNew.scale_bounds K x E hK hx hE hEu
  have hUu' : U D x ≤ x^(4*K+5) := by
    rw [← hUnom]
    exact hUu
  have hVu' : V E x ≤ x^(4*K+5) := by
    change U E x ≤ x^(4*K+5)
    exact hVu
  have hDivPoly : (M:ℝ)*max D E ≤ x^(5*K+5) := by
    calc
      _ ≤ x^K*x^K :=
        mul_le_mul hMu (max_le hDu hEu) (le_max_of_le_left hD0.le)
          (Real.rpow_nonneg hx0.le _)
      _ = x^(2*K) := by rw [← Real.rpow_add hx0]; congr 1 <;> ring
      _ ≤ x^(5*K+5) := Real.rpow_le_rpow_of_exponent_le hx1 (by linarith)
  have hCofPoly : (M:ℝ)*max (U D x) (V E x) ≤ x^(5*K+5) := by
    calc
      _ ≤ x^K*x^(4*K+5) :=
