    _ = (k * x ^ 5) * B ^ 5 * P + (k * y ^ 5) * C ^ 5 * Q +
        k * N * A * T := by
      dsimp [P, Q, T, z, X, Y]
      linear_combination
        -k * (1 + (x * B + y * C) + (x * B + y * C) ^ 2 +
          (x * B + y * C) ^ 3 + (x * B + y * C) ^ 4 +
          (x * B + y * C) ^ 5 + (x * B + y * C) ^ 6 +
          (x * B + y * C) ^ 7 + (x * B + y * C) ^ 8) * hbez
    _ = N * (r * B ^ 5 * P + s * C ^ 5 * Q + k * A * T) := by
      rw [hr, hs]
      ring

private theorem normal_form_level_divides
    (a b c R S d e A B r s : ℤ)
    (hab : A * a + B * b = 1) (hde : r * d + s * e = 1)
    (hp : a * d + b * e ∣ pNF a b c R S d e)
    (hq : a * d + b * e ∣ qNF a b c R S d e) :
    a * d + b * e ∣ levelInteger a b c R S := by
  have hprem : a * d + b * e ∣
      b ^ 5 * pNF a b c R S d e -
        d ^ 5 * (b ^ 4 * levelInteger a b c R S) := by
    have h := quintic_direction_remainder S R
      (84 * c * a ^ 3 * b ^ 6)
      (36 * c * a ^ 2 * b ^ 7)
      (9 * c * a * b ^ 8) (c * b ^ 9) a b d e
    change a * d + b * e ∣
      b ^ 5 * pNF a b c R S d e -
        d ^ 5 * pNF a b c R S b (-a) at h
    rw [p_direction_value] at h
    exact h
  have hqrem : a * d + b * e ∣
      a ^ 5 * qNF a b c R S d e +
        e ^ 5 * (a ^ 4 * levelInteger a b c R S) := by
    have h := quintic_direction_remainder
      (R - 126 * c * a ^ 4 * b ^ 5)
      (S - 126 * c * a ^ 5 * b ^ 4)
      (-84 * c * a ^ 6 * b ^ 3)
      (-36 * c * a ^ 7 * b ^ 2)
      (-9 * c * a ^ 8 * b) (-c * a ^ 9)
      b a e d
    have hval :
      eval5 (R - 126 * c * a ^ 4 * b ^ 5)
        (S - 126 * c * a ^ 5 * b ^ 4)
        (-84 * c * a ^ 6 * b ^ 3)
        (-36 * c * a ^ 7 * b ^ 2)
        (-9 * c * a ^ 8 * b) (-c * a ^ 9)
        a (-b) = -(a ^ 4 * levelInteger a b c R S) := by
      dsimp [eval5, levelInteger]
      ring
    have hswap :
      eval5 (R - 126 * c * a ^ 4 * b ^ 5)
        (S - 126 * c * a ^ 5 * b ^ 4)
        (-84 * c * a ^ 6 * b ^ 3)
        (-36 * c * a ^ 7 * b ^ 2)
        (-9 * c * a ^ 8 * b) (-c * a ^ 9)
        e d = qNF a b c R S d e := by
      dsimp [eval5, qNF]
      ring
    rw [hswap, hval] at h
    have heq : a ^ 5 * qNF a b c R S d e -
        e ^ 5 * (-(a ^ 4 * levelInteger a b c R S)) =
      a ^ 5 * qNF a b c R S d e +
        e ^ 5 * (a ^ 4 * levelInteger a b c R S) := by ring
    rw [heq] at h
    have hcomm : b * e + a * d = a * d + b * e := by ring
    rw [hcomm] at h
    exact h
  have hpx : a * d + b * e ∣
      d ^ 5 * (b ^ 4 * levelInteger a b c R S) := by
    have h := dvd_sub (dvd_mul_of_dvd_right hp (b ^ 5)) hprem
    have heq : b ^ 5 * pNF a b c R S d e -
        (b ^ 5 * pNF a b c R S d e -
          d ^ 5 * (b ^ 4 * levelInteger a b c R S)) =
        d ^ 5 * (b ^ 4 * levelInteger a b c R S) := by ring
    rw [heq] at h
    exact h
  have hqy : a * d + b * e ∣
      e ^ 5 * (a ^ 4 * levelInteger a b c R S) := by
    have h := dvd_sub hqrem (dvd_mul_of_dvd_right hq (a ^ 5))
    have heq : (a ^ 5 * qNF a b c R S d e +
        e ^ 5 * (a ^ 4 * levelInteger a b c R S)) -
        a ^ 5 * qNF a b c R S d e =
        e ^ 5 * (a ^ 4 * levelInteger a b c R S) := by ring
    rw [heq] at h
    exact h
  have hx : a * d + b * e ∣ levelInteger a b c R S * (b * d) ^ 5 := by
    have h := dvd_mul_of_dvd_right hpx b
    obtain ⟨t, ht⟩ := h
    refine ⟨t, ?_⟩
    linear_combination ht
  have hy : a * d + b * e ∣ levelInteger a b c R S * (a * e) ^ 5 := by
    have h := dvd_mul_of_dvd_right hqy a
    obtain ⟨t, ht⟩ := h
    refine ⟨t, ?_⟩
    linear_combination ht
  obtain ⟨U, V, W, hbez⟩ :=
    original_cross_bezout a b d e A B r s hab hde
  exact fifth_power_divisibility_cancel
    (a * d + b * e) (levelInteger a b c R S)
    (b * d) (a * e) U V W hbez hx hy

private theorem original_graph_values
    (a b c d e u v P Q : ℤ)
    (hpure : e ^ 4 * P - d ^ 4 * Q = c * (a * d + b * e) ^ 9)
    (hgraph : P * u = Q * v)
    (hunit : e ^ 4 * v - d ^ 4 * u = 1) :
    P = c * (a * d + b * e) ^ 9 * v ∧
      Q = c * (a * d + b * e) ^ 9 * u := by
  constructor
  · linear_combination v * hpure - d ^ 4 * hgraph - P * hunit
  · linear_combination u * hpure - e ^ 4 * hgraph - Q * hunit

private theorem original_unit_bezout
    (d e u v : ℤ) (hunit : e ^ 4 * v - d ^ 4 * u = 1) :
    (-d ^ 3 * u) * d + (e ^ 3 * v) * e = 1 := by
  linear_combination hunit

private theorem actual_normal_form_level_divides
    (a b c R S d e u v A B : ℤ)
    (hab : A * a + B * b = 1)
    (hunit : e ^ 4 * v - d ^ 4 * u = 1)
    (hgraph : pNF a b c R S d e * u = qNF a b c R S d e * v) :
    a * d + b * e ∣ levelInteger a b c R S := by
  have hpure : e ^ 4 * pNF a b c R S d e -
      d ^ 4 * qNF a b c R S d e =
      c * (a * d + b * e) ^ 9 := by
    dsimp [pNF, qNF, eval5]
    ring
  obtain ⟨hP, hQ⟩ :=
    original_graph_values a b c d e u v
      (pNF a b c R S d e) (qNF a b c R S d e)
      hpure hgraph hunit
  have hp : a * d + b * e ∣ pNF a b c R S d e := by
    rw [hP]
    refine ⟨c * (a * d + b * e) ^ 8 * v, ?_⟩
    ring
  have hq : a * d + b * e ∣ qNF a b c R S d e := by
    rw [hQ]
    refine ⟨c * (a * d + b * e) ^ 8 * u, ?_⟩
    ring
  exact normal_form_level_divides a b c R S d e A B
    (-d ^ 3 * u) (e ^ 3 * v) hab
    (original_unit_bezout d e u v hunit) hp hq

private def pPart (a b d e : ℤ) : ℤ :=
  b ^ 9 * e ^ 5 + 9 * a * b ^ 8 * d * e ^ 4 +
    36 * a ^ 2 * b ^ 7 * d ^ 2 * e ^ 3 +
    84 * a ^ 3 * b ^ 6 * d ^ 3 * e ^ 2

private def qPart (a b d e : ℤ) : ℤ :=
  126 * a ^ 4 * b ^ 5 * e ^ 5 +
    126 * a ^ 5 * b ^ 4 * d * e ^ 4 +
    84 * a ^ 6 * b ^ 3 * d ^ 2 * e ^ 3 +
    36 * a ^ 7 * b ^ 2 * d ^ 3 * e ^ 2 +
    9 * a ^ 8 * b * d ^ 4 * e + a ^ 9 * d ^ 5

private theorem p_congruence (a b c R S d e : ℤ) :
    pNF a b c R S d e =
      c * pPart a b d e + d ^ 4 * (S * d + R * e) := by
  dsimp [pNF, pPart, eval5]
  ring

private theorem q_congruence (a b c R S d e : ℤ) :
    qNF a b c R S d e =
      e ^ 4 * (S * d + R * e) - c * qPart a b d e := by
  dsimp [qNF, qPart, eval5]
  ring

private theorem actual_normal_form_content_divides
    (a b c R S d e u v : ℤ)
    (hunit : e ^ 4 * v - d ^ 4 * u = 1)
    (hgraph : pNF a b c R S d e * u = qNF a b c R S d e * v) :
    c ∣ S * d + R * e := by
  let J : ℤ := S * d + R * e
  have hpure : e ^ 4 * pNF a b c R S d e -
      d ^ 4 * qNF a b c R S d e =
      c * (a * d + b * e) ^ 9 := by
    dsimp [pNF, qNF, eval5]
    ring
  obtain ⟨hP, hQ⟩ :=
    original_graph_values a b c d e u v
      (pNF a b c R S d e) (qNF a b c R S d e)
      hpure hgraph hunit
  have hp : c ∣ pNF a b c R S d e := by
    rw [hP]
    exact ⟨(a * d + b * e) ^ 9 * v, by ring⟩
  have hq : c ∣ qNF a b c R S d e := by
    rw [hQ]
    exact ⟨(a * d + b * e) ^ 9 * u, by ring⟩
  have hd : c ∣ d ^ 4 * J := by
    have h := dvd_sub hp (show c ∣ c * pPart a b d e from ⟨pPart a b d e, rfl⟩)
    have heq : pNF a b c R S d e - c * pPart a b d e =
      d ^ 4 * J := by rw [p_congruence]; ring
    rw [heq] at h
    exact h
  have he : c ∣ e ^ 4 * J := by
    have h := dvd_add hq (show c ∣ c * qPart a b d e from ⟨qPart a b d e, rfl⟩)
    have heq : qNF a b c R S d e + c * qPart a b d e =
      e ^ 4 * J := by rw [q_congruence]; ring
    rw [heq] at h
    exact h
  have hd5 : c ∣ J * d ^ 5 := by
    have h := dvd_mul_of_dvd_right hd d
    have heq : d * (d ^ 4 * J) = J * d ^ 5 := by ring
    rw [heq] at h
    exact h
  have he5 : c ∣ J * e ^ 5 := by
    have h := dvd_mul_of_dvd_right he e
    have heq : e * (e ^ 4 * J) = J * e ^ 5 := by ring
    rw [heq] at h
    exact h
  have hbez : c * 0 + d * (-d ^ 3 * u) + e * (e ^ 3 * v) = 1 := by
    linear_combination hunit
  exact fifth_power_divisibility_cancel c J d e 0
    (-d ^ 3 * u) (e ^ 3 * v) hbez hd5 he5

private theorem same_level_content_difference
    (a b c R S d₁ e₁ d₂ e₂ A B : ℤ)
    (hab : A * a + B * b = 1)
    (hlevel : a * d₁ + b * e₁ = a * d₂ + b * e₂)
    (hc₁ : c ∣ S * d₁ + R * e₁)
    (hc₂ : c ∣ S * d₂ + R * e₂) :
    c ∣ levelInteger a b c R S *
      ((B * d₁ - A * e₁) - (B * d₂ - A * e₂)) := by
  let Δt : ℤ := (B * d₁ - A * e₁) - (B * d₂ - A * e₂)
  let ΔJ : ℤ := (S * d₁ + R * e₁) - (S * d₂ + R * e₂)
  have hm : a * (d₁ - d₂) + b * (e₁ - e₂) = 0 := by
    linear_combination hlevel
  have hpoly :
      (A * a + B * b) * ΔJ =
        (S * A + R * B) *
          (a * (d₁ - d₂) + b * (e₁ - e₂)) +
        (b * S - a * R) * Δt := by
    dsimp [ΔJ, Δt]
    ring
  have hdiff : ΔJ = (b * S - a * R) * Δt := by
    rw [hab, hm] at hpoly
    simpa using hpoly
  have hJ : c ∣ (b * S - a * R) * Δt := by
    have h := dvd_sub hc₁ hc₂
    change c ∣ ΔJ at h
    rw [hdiff] at h
    exact h
  have hplus : c ∣ c * (56 * a ^ 5 * b ^ 5 * Δt) :=
    ⟨56 * a ^ 5 * b ^ 5 * Δt, rfl⟩
  have hsum := dvd_add hJ hplus
  have heq : (b * S - a * R) * Δt +
      c * (56 * a ^ 5 * b ^ 5 * Δt) =
      levelInteger a b c R S * Δt := by
    dsimp [levelInteger]
    ring
  rw [heq] at hsum
  exact hsum

private theorem support_five_isHomogeneous
    (P : MvPolynomial (Fin 2) ℤ)
    (h : ∀ m ∈ P.support, m 0 + m 1 = 5) :
    P.IsHomogeneous 5 := by
  intro m hm
  have hmem : m ∈ P.support := by simpa using hm
  first
  | simpa [Finsupp.weight, Finsupp.linearCombination,
      Finsupp.sum_fintype, Fin.sum_univ_two] using h m hmem
  | simpa [Finsupp.weight, Finsupp.linearCombination,
      Finsupp.sum, Fin.sum_univ_two] using h m hmem
  | simpa [Finsupp.weight, Finsupp.linearCombination_apply,
      Finsupp.sum_fintype, Fin.sum_univ_two] using h m hmem
  | change (∑ i : Fin 2, m i) = 5
    simpa [Fin.sum_univ_two] using h m hmem

private noncomputable abbrev m50 : Fin 2 →₀ ℕ := Finsupp.single 0 5
private noncomputable abbrev m41 : Fin 2 →₀ ℕ :=
  Finsupp.single 0 4 + Finsupp.single 1 1
private noncomputable abbrev m32 : Fin 2 →₀ ℕ :=
  Finsupp.single 0 3 + Finsupp.single 1 2
private noncomputable abbrev m23 : Fin 2 →₀ ℕ :=
  Finsupp.single 0 2 + Finsupp.single 1 3
private noncomputable abbrev m14 : Fin 2 →₀ ℕ :=
  Finsupp.single 0 1 + Finsupp.single 1 4
private noncomputable abbrev m05 : Fin 2 →₀ ℕ := Finsupp.single 1 5

private theorem quintic_index_six (t : Fin 2 →₀ ℕ)
    (ht : Finsupp.degree t = 5) :
    t = m50 ∨ t = m41 ∨ t = m32 ∨
      t = m23 ∨ t = m14 ∨ t = m05 := by
  have hs : t 0 + t 1 = 5 := by
    simpa [Finsupp.degree_eq_sum, Fin.sum_univ_two] using ht
  have hcase : t 0 = 0 ∨ t 0 = 1 ∨ t 0 = 2 ∨
      t 0 = 3 ∨ t 0 = 4 ∨ t 0 = 5 := by omega
  rcases hcase with h0 | h1 | h2 | h3 | h4 | h5
  · right; right; right; right; right
    ext i; fin_cases i <;>
      simp [m05, Finsupp.single_apply, Finsupp.add_apply] <;> omega
  · right; right; right; right; left
    ext i; fin_cases i <;>
      simp [m14, Finsupp.single_apply, Finsupp.add_apply] <;> omega
  · right; right; right; left
    ext i; fin_cases i <;>
      simp [m23, Finsupp.single_apply, Finsupp.add_apply] <;> omega
  · right; right; left
    ext i; fin_cases i <;>
      simp [m32, Finsupp.single_apply, Finsupp.add_apply] <;> omega
  · right; left
    ext i; fin_cases i <;>
      simp [m41, Finsupp.single_apply, Finsupp.add_apply] <;> omega
  · left
    ext i; fin_cases i <;>
      simp [m50, Finsupp.single_apply, Finsupp.add_apply] <;> omega

private theorem homogeneous_quintic_six (P : MvPolynomial (Fin 2) ℤ)
    (hP : P.IsHomogeneous 5) :
    P = MvPolynomial.monomial m50 (P.coeff m50) +
      MvPolynomial.monomial m41 (P.coeff m41) +
      MvPolynomial.monomial m32 (P.coeff m32) +
      MvPolynomial.monomial m23 (P.coeff m23) +
      MvPolynomial.monomial m14 (P.coeff m14) +
      MvPolynomial.monomial m05 (P.coeff m05) := by
  classical
  ext t
  simp only [MvPolynomial.coeff_add, MvPolynomial.coeff_monomial]
  have hdistinct :
      m50 ≠ m41 ∧ m50 ≠ m32 ∧ m50 ≠ m23 ∧
      m50 ≠ m14 ∧ m50 ≠ m05 ∧ m41 ≠ m32 ∧
      m41 ≠ m23 ∧ m41 ≠ m14 ∧ m41 ≠ m05 ∧
      m32 ≠ m23 ∧ m32 ≠ m14 ∧ m32 ≠ m05 ∧
      m23 ≠ m14 ∧ m23 ≠ m05 ∧ m14 ≠ m05 := by
    and_intros
    all_goals
      intro h
      have h0 := congrArg (fun z : Fin 2 →₀ ℕ => z 0) h
      norm_num [m50, m41, m32, m23, m14, m05,
        Finsupp.add_apply] at h0
  rcases hdistinct with
    ⟨hd01, hd02, hd03, hd04, hd05, hd12, hd13, hd14,
      hd15, hd23, hd24, hd25, hd34, hd35, hd45⟩
  by_cases h0 : m50 = t
  · subst t
    simp [hd01, Ne.symm hd01, hd02, Ne.symm hd02, hd03, Ne.symm hd03, hd04, Ne.symm hd04, hd05, Ne.symm hd05]
  by_cases h1 : m41 = t
  · subst t
    simp [hd01, Ne.symm hd01, hd12, Ne.symm hd12, hd13, Ne.symm hd13, hd14, Ne.symm hd14, hd15, Ne.symm hd15]
  by_cases h2 : m32 = t
  · subst t
    simp [hd02, Ne.symm hd02, hd12, Ne.symm hd12, hd23, Ne.symm hd23, hd24, Ne.symm hd24, hd25, Ne.symm hd25]
  by_cases h3 : m23 = t
  · subst t
    simp [hd03, Ne.symm hd03, hd13, Ne.symm hd13, hd23, Ne.symm hd23, hd34, Ne.symm hd34, hd35, Ne.symm hd35]
  by_cases h4 : m14 = t
  · subst t
    simp [hd04, Ne.symm hd04, hd14, Ne.symm hd14, hd24, Ne.symm hd24, hd34, Ne.symm hd34, hd45, Ne.symm hd45]
  by_cases h5 : m05 = t
  · subst t
    simp [hd05, Ne.symm hd05, hd15, Ne.symm hd15, hd25, Ne.symm hd25, hd35, Ne.symm hd35, hd45, Ne.symm hd45]
  have hz : P.coeff t = 0 := by
    by_contra hc
    have hdeg : Finsupp.degree t = 5 := by
      by_contra hneq
      exact hc (hP.coeff_eq_zero hneq)
    rcases quintic_index_six t hdeg with hh | hh | hh | hh | hh | hh
    · exact h0 hh.symm
    · exact h1 hh.symm
    · exact h2 hh.symm
    · exact h3 hh.symm
    · exact h4 hh.symm
    · exact h5 hh.symm
  simp [h0, h1, h2, h3, h4, h5, hz]

private theorem binary_monomial_mixed (r : ℤ) (i j : ℕ) :
    MvPolynomial.monomial
        (Finsupp.single (0 : Fin 2) i + Finsupp.single (1 : Fin 2) j) r =
      MvPolynomial.C r * (MvPolynomial.X (0 : Fin 2)) ^ i *
        (MvPolynomial.X (1 : Fin 2)) ^ j := by
  calc
    _ = MvPolynomial.monomial (Finsupp.single (0 : Fin 2) i) r *
        MvPolynomial.monomial (Finsupp.single (1 : Fin 2) j) (1 : ℤ) := by
      rw [MvPolynomial.monomial_mul]
      simp
    _ = _ := by
      rw [← MvPolynomial.C_mul_X_pow_eq_monomial,
        ← MvPolynomial.C_mul_X_pow_eq_monomial]
      simp [mul_assoc]

private theorem homogeneous_quintic_explicit
    (P : MvPolynomial (Fin 2) ℤ) (hP : P.IsHomogeneous 5) :
    P = MvPolynomial.C (P.coeff m50) * MvPolynomial.X (0 : Fin 2) ^ 5 +
      MvPolynomial.C (P.coeff m41) * MvPolynomial.X (0 : Fin 2) ^ 4 *
        MvPolynomial.X 1 +
      MvPolynomial.C (P.coeff m32) * MvPolynomial.X (0 : Fin 2) ^ 3 *
        MvPolynomial.X 1 ^ 2 +
      MvPolynomial.C (P.coeff m23) * MvPolynomial.X (0 : Fin 2) ^ 2 *
        MvPolynomial.X 1 ^ 3 +
      MvPolynomial.C (P.coeff m14) * MvPolynomial.X (0 : Fin 2) *
        MvPolynomial.X 1 ^ 4 +
      MvPolynomial.C (P.coeff m05) * MvPolynomial.X (1 : Fin 2) ^ 5 := by
  conv_lhs => rw [homogeneous_quintic_six P hP]
  rw [show m41 = Finsupp.single (0 : Fin 2) 4 +
      Finsupp.single 1 1 from rfl,
    show m32 = Finsupp.single (0 : Fin 2) 3 +
      Finsupp.single 1 2 from rfl,
    show m23 = Finsupp.single (0 : Fin 2) 2 +
      Finsupp.single 1 3 from rfl,
    show m14 = Finsupp.single (0 : Fin 2) 1 +
      Finsupp.single 1 4 from rfl]
  rw [binary_monomial_mixed, binary_monomial_mixed,
    binary_monomial_mixed, binary_monomial_mixed]
  rw [← MvPolynomial.C_mul_X_pow_eq_monomial,
    ← MvPolynomial.C_mul_X_pow_eq_monomial]
  ring

private theorem eval_quintic_six
    (P : MvPolynomial (Fin 2) ℤ) (hP : P.IsHomogeneous 5)
    (d e : ℤ) :
    MvPolynomial.eval ![d, e] P =
      P.coeff m50 * d ^ 5 + P.coeff m41 * d ^ 4 * e +
      P.coeff m32 * d ^ 3 * e ^ 2 +
      P.coeff m23 * d ^ 2 * e ^ 3 +
      P.coeff m14 * d * e ^ 4 + P.coeff m05 * e ^ 5 := by
  conv_lhs => rw [homogeneous_quintic_explicit P hP]
  simp

private theorem ten_eval_zero
    (r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 : ℤ)
    (h : ∀ t : ℤ,
      r0 + r1 * t + r2 * t ^ 2 + r3 * t ^ 3 + r4 * t ^ 4 +
        r5 * t ^ 5 + r6 * t ^ 6 + r7 * t ^ 7 +
        r8 * t ^ 8 + r9 * t ^ 9 = 0) :
    r0 = 0 ∧ r1 = 0 ∧ r2 = 0 ∧ r3 = 0 ∧ r4 = 0 ∧
      r5 = 0 ∧ r6 = 0 ∧ r7 = 0 ∧ r8 = 0 ∧ r9 = 0 := by
  have h0 := h 0
  have h1 := h 1
  have hm1 := h (-1)
  have h2 := h 2
  have hm2 := h (-2)
  have h3 := h 3
  have hm3 := h (-3)
  have h4 := h 4
  have hm4 := h (-4)
  have h5 := h 5
  norm_num at h0 h1 hm1 h2 hm2 h3 hm3 h4 hm4 h5
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
    linarith only [h0, h1, hm1, h2, hm2, h3, hm3, h4, hm4, h5]

private theorem ten_point_coefficients
    (p50 p41 p32 p23 p14 p05
     q50 q41 q32 q23 q14 q05 a b c : ℤ)
    (ht : ∀ t : ℤ,
      t ^ 4 * (p50 + p41 * t + p32 * t ^ 2 + p23 * t ^ 3 +
        p14 * t ^ 4 + p05 * t ^ 5) -
      (q50 + q41 * t + q32 * t ^ 2 + q23 * t ^ 3 +
        q14 * t ^ 4 + q05 * t ^ 5) =
        c * (a + b * t) ^ 9) :
    q50 = -c * a ^ 9 ∧
    q41 = -(9 * c * a ^ 8 * b) ∧
    q32 = -(36 * c * a ^ 7 * b ^ 2) ∧
    q23 = -(84 * c * a ^ 6 * b ^ 3) ∧
    q14 = p50 - 126 * c * a ^ 5 * b ^ 4 ∧
    q05 = p41 - 126 * c * a ^ 4 * b ^ 5 ∧
    p32 = 84 * c * a ^ 3 * b ^ 6 ∧
    p23 = 36 * c * a ^ 2 * b ^ 7 ∧
    p14 = 9 * c * a * b ^ 8 ∧
    p05 = c * b ^ 9 := by
  have hv : ∀ t : ℤ,
      (-q50 - c * a ^ 9) +
      (-q41 - 9 * c * a ^ 8 * b) * t +
      (-q32 - 36 * c * a ^ 7 * b ^ 2) * t ^ 2 +
      (-q23 - 84 * c * a ^ 6 * b ^ 3) * t ^ 3 +
      (p50 - q14 - 126 * c * a ^ 5 * b ^ 4) * t ^ 4 +
      (p41 - q05 - 126 * c * a ^ 4 * b ^ 5) * t ^ 5 +
      (p32 - 84 * c * a ^ 3 * b ^ 6) * t ^ 6 +
      (p23 - 36 * c * a ^ 2 * b ^ 7) * t ^ 7 +
      (p14 - 9 * c * a * b ^ 8) * t ^ 8 +
      (p05 - c * b ^ 9) * t ^ 9 = 0 := by
    intro t
    calc
      _ = t ^ 4 * (p50 + p41 * t + p32 * t ^ 2 +
          p23 * t ^ 3 + p14 * t ^ 4 + p05 * t ^ 5) -
          (q50 + q41 * t + q32 * t ^ 2 + q23 * t ^ 3 +
            q14 * t ^ 4 + q05 * t ^ 5) -
          c * (a + b * t) ^ 9 := by ring
      _ = 0 := by rw [ht t]; ring
  obtain ⟨h0, h1, h2, h3, h4, h5, h6, h7, h8, h9⟩ :=
    ten_eval_zero
      (-q50 - c * a ^ 9)
      (-q41 - 9 * c * a ^ 8 * b)
      (-q32 - 36 * c * a ^ 7 * b ^ 2)
      (-q23 - 84 * c * a ^ 6 * b ^ 3)
      (p50 - q14 - 126 * c * a ^ 5 * b ^ 4)
      (p41 - q05 - 126 * c * a ^ 4 * b ^ 5)
      (p32 - 84 * c * a ^ 3 * b ^ 6)
      (p23 - 36 * c * a ^ 2 * b ^ 7)
      (p14 - 9 * c * a * b ^ 8) (p05 - c * b ^ 9) hv
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
    nlinarith only [h0, h1, h2, h3, h4, h5, h6, h7, h8, h9]

private theorem pure_quintic_coefficients
    (P Q : MvPolynomial (Fin 2) ℤ) (a b c : ℤ)
    (hP : P.IsHomogeneous 5) (hQ : Q.IsHomogeneous 5)
    (hpure : MvPolynomial.X (1 : Fin 2) ^ 4 * P -
        MvPolynomial.X (0 : Fin 2) ^ 4 * Q =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ 9) :
    Q.coeff m50 = -c * a ^ 9 ∧
    Q.coeff m41 = -(9 * c * a ^ 8 * b) ∧
    Q.coeff m32 = -(36 * c * a ^ 7 * b ^ 2) ∧
    Q.coeff m23 = -(84 * c * a ^ 6 * b ^ 3) ∧
    Q.coeff m14 = P.coeff m50 - 126 * c * a ^ 5 * b ^ 4 ∧
    Q.coeff m05 = P.coeff m41 - 126 * c * a ^ 4 * b ^ 5 ∧
    P.coeff m32 = 84 * c * a ^ 3 * b ^ 6 ∧
    P.coeff m23 = 36 * c * a ^ 2 * b ^ 7 ∧
    P.coeff m14 = 9 * c * a * b ^ 8 ∧
    P.coeff m05 = c * b ^ 9 := by
  apply ten_point_coefficients
  intro t
  have hh := congrArg (MvPolynomial.eval ![(1 : ℤ), t]) hpure
  simp only [MvPolynomial.eval_sub, MvPolynomial.eval_mul,
    MvPolynomial.eval_pow, MvPolynomial.eval_add,
    MvPolynomial.eval_C, MvPolynomial.eval_X] at hh
  simp [eval_quintic_six P hP 1 t,
    eval_quintic_six Q hQ 1 t] at hh
  nlinarith [hh]

private theorem evaluated_quintic_normal_form
    (P Q : MvPolynomial (Fin 2) ℤ) (a b c : ℤ)
    (hP : P.IsHomogeneous 5) (hQ : Q.IsHomogeneous 5)
    (hpure : MvPolynomial.X (1 : Fin 2) ^ 4 * P -
        MvPolynomial.X (0 : Fin 2) ^ 4 * Q =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ 9) :
    ∀ d e : ℤ,
      MvPolynomial.eval ![d, e] P =
        pNF a b c (P.coeff m41) (P.coeff m50) d e ∧
      MvPolynomial.eval ![d, e] Q =
        qNF a b c (P.coeff m41) (P.coeff m50) d e := by
  obtain ⟨h0, h1, h2, h3, h4, h5, h6, h7, h8, h9⟩ :=
    pure_quintic_coefficients P Q a b c hP hQ hpure
  intro d e
  constructor
  · rw [eval_quintic_six P hP d e, h6, h7, h8, h9]
    dsimp [pNF, eval5] <;> ring
  · rw [eval_quintic_six Q hQ d e, h0, h1, h2, h3, h4, h5]
    dsimp [qNF, eval5] <;> ring

private theorem bezout_fifth_powers
    {T : Type*} [CommRing T]
    (a b A B : T) (hab : A * a + B * b = 1) :
    ∃ r s : T, r * a ^ 5 + s * b ^ 5 = 1 := by
  let X : T := A * a
  let Y : T := B * b
  let R : T := A ^ 5 *
    (X ^ 4 + 9 * X ^ 3 * Y + 36 * X ^ 2 * Y ^ 2 +
      84 * X * Y ^ 3 + 126 * Y ^ 4)
  let S : T := B ^ 5 *
    (126 * X ^ 4 + 84 * X ^ 3 * Y +
      36 * X ^ 2 * Y ^ 2 + 9 * X * Y ^ 3 + Y ^ 4)
  refine ⟨R, S, ?_⟩
  calc
    R * a ^ 5 + S * b ^ 5 = (A * a + B * b) ^ 9 := by
      dsimp [R, S, X, Y]
      ring
    _ = 1 := by rw [hab]; ring

private theorem linear_dvd_eval5_of_primitive_root
    {R : Type*} [CommRing R]
    (p₀ p₁ p₂ p₃ p₄ p₅ a b d e A B : R)
    (hab : A * a + B * b = 1)
    (hroot : eval5 p₀ p₁ p₂ p₃ p₄ p₅ b (-a) = 0) :
    a * d + b * e ∣ eval5 p₀ p₁ p₂ p₃ p₄ p₅ d e := by
  have hB := quintic_direction_remainder
    p₀ p₁ p₂ p₃ p₄ p₅ a b d e
  rw [hroot] at hB
  simp only [mul_zero, sub_zero] at hB
  have hA := quintic_direction_remainder
    p₅ p₄ p₃ p₂ p₁ p₀ b a e d
  have hswap :
      eval5 p₅ p₄ p₃ p₂ p₁ p₀ e d =
        eval5 p₀ p₁ p₂ p₃ p₄ p₅ d e := by
    dsimp [eval5]
    ring
  have hrootrev :
      eval5 p₅ p₄ p₃ p₂ p₁ p₀ a (-b) = 0 := by
    have heq : eval5 p₅ p₄ p₃ p₂ p₁ p₀ a (-b) =
        -(eval5 p₀ p₁ p₂ p₃ p₄ p₅ b (-a)) := by
      dsimp [eval5]
      ring
    rw [heq, hroot]
    ring
  rw [hswap, hrootrev] at hA
  simp only [mul_zero, sub_zero] at hA
  have hcomm : b * e + a * d = a * d + b * e := by ring
  rw [hcomm] at hA
  obtain ⟨r, s, hrs⟩ := bezout_fifth_powers a b A B hab
  rcases hA with ⟨u, hu⟩
  rcases hB with ⟨v, hv⟩
  refine ⟨r * u + s * v, ?_⟩
  calc
    eval5 p₀ p₁ p₂ p₃ p₄ p₅ d e =
        (r * a ^ 5 + s * b ^ 5) *
          eval5 p₀ p₁ p₂ p₃ p₄ p₅ d e := by rw [hrs]; ring
    _ = r * (a ^ 5 * eval5 p₀ p₁ p₂ p₃ p₄ p₅ d e) +
        s * (b ^ 5 * eval5 p₀ p₁ p₂ p₃ p₄ p₅ d e) := by ring
    _ = (a * d + b * e) * (r * u + s * v) := by
      rw [hu, hv]
      ring

private theorem polynomial_quintic_normal_form
    (P Q : MvPolynomial (Fin 2) ℤ) (a b c : ℤ)
    (hP : P.IsHomogeneous 5) (hQ : Q.IsHomogeneous 5)
    (hpure : MvPolynomial.X (1 : Fin 2) ^ 4 * P -
        MvPolynomial.X (0 : Fin 2) ^ 4 * Q =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ 9) :
    P = eval5
        (MvPolynomial.C (P.coeff m50))
        (MvPolynomial.C (P.coeff m41))
        (MvPolynomial.C (84 * c * a ^ 3 * b ^ 6))
        (MvPolynomial.C (36 * c * a ^ 2 * b ^ 7))
        (MvPolynomial.C (9 * c * a * b ^ 8))
        (MvPolynomial.C (c * b ^ 9))
        (MvPolynomial.X 0) (MvPolynomial.X 1) ∧
    Q = eval5
        (MvPolynomial.C (-c * a ^ 9))
        (MvPolynomial.C (-9 * c * a ^ 8 * b))
        (MvPolynomial.C (-36 * c * a ^ 7 * b ^ 2))
        (MvPolynomial.C (-84 * c * a ^ 6 * b ^ 3))
        (MvPolynomial.C (P.coeff m50 - 126 * c * a ^ 5 * b ^ 4))
        (MvPolynomial.C (P.coeff m41 - 126 * c * a ^ 4 * b ^ 5))
        (MvPolynomial.X 0) (MvPolynomial.X 1) := by
  obtain ⟨h0, h1, h2, h3, h4, h5, h6, h7, h8, h9⟩ :=
    pure_quintic_coefficients P Q a b c hP hQ hpure
  constructor
  · conv_lhs => rw [homogeneous_quintic_explicit P hP]
    rw [h6, h7, h8, h9]
    dsimp [eval5] <;> ring
  · conv_lhs => rw [homogeneous_quintic_explicit Q hQ]
    rw [h0, h1, h2, h3, h4, h5]
    dsimp [eval5] <;> ring

private theorem q_direct_value (a b c R S : ℤ) :
    qNF a b c R S b (-a) = a ^ 4 * levelInteger a b c R S := by
  dsimp [qNF, eval5, levelInteger]
  ring

private theorem eval5_C
    (p₀ p₁ p₂ p₃ p₄ p₅ d e : ℤ) :
    eval5
        (MvPolynomial.C p₀ : MvPolynomial (Fin 2) ℤ)
        (MvPolynomial.C p₁)
        (MvPolynomial.C p₂)
        (MvPolynomial.C p₃)
        (MvPolynomial.C p₄)
        (MvPolynomial.C p₅)
        (MvPolynomial.C d)
        (MvPolynomial.C e) =
      MvPolynomial.C (eval5 p₀ p₁ p₂ p₃ p₄ p₅ d e) := by
  simp [eval5, map_add, map_mul, map_pow]

private theorem actual_level_nonzero_from_rational_coprime
    (P Q : MvPolynomial (Fin 2) ℤ) (a b c A B : ℤ)
    (hP : P.IsHomogeneous 5) (hQ : Q.IsHomogeneous 5)
    (hab : A * a + B * b = 1)
    (hcoprime : ∀ R : MvPolynomial (Fin 2) ℚ,
      R ∣ MvPolynomial.map (Int.castRingHom ℚ) P →
      R ∣ MvPolynomial.map (Int.castRingHom ℚ) Q →
      IsUnit R)
    (hpure : MvPolynomial.X (1 : Fin 2) ^ 4 * P -
        MvPolynomial.X (0 : Fin 2) ^ 4 * Q =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ 9) :
    levelInteger a b c (P.coeff m41) (P.coeff m50) ≠ 0 := by
  intro hzero
  let R₀ : ℤ := P.coeff m41
  let S₀ : ℤ := P.coeff m50
  let L : MvPolynomial (Fin 2) ℤ :=
    MvPolynomial.C a * MvPolynomial.X 0 +
      MvPolynomial.C b * MvPolynomial.X 1
  have hpoly := polynomial_quintic_normal_form P Q a b c hP hQ hpure
  have hbez :
      (MvPolynomial.C A : MvPolynomial (Fin 2) ℤ) *
          MvPolynomial.C a +
        MvPolynomial.C B * MvPolynomial.C b = 1 := by
    calc
      _ = MvPolynomial.C (A * a + B * b) := by simp
      _ = 1 := by rw [hab]; simp
  have hp0 : pNF a b c R₀ S₀ b (-a) = 0 := by
    rw [p_direction_value]
    rw [show levelInteger a b c R₀ S₀ = 0 from hzero]
    ring
  have hq0 : qNF a b c R₀ S₀ b (-a) = 0 := by
    rw [q_direct_value]
    rw [show levelInteger a b c R₀ S₀ = 0 from hzero]
    ring
  have hrootP :
      eval5 (MvPolynomial.C S₀) (MvPolynomial.C R₀)
        (MvPolynomial.C (84 * c * a ^ 3 * b ^ 6))
        (MvPolynomial.C (36 * c * a ^ 2 * b ^ 7))
        (MvPolynomial.C (9 * c * a * b ^ 8))
        (MvPolynomial.C (c * b ^ 9))
        (MvPolynomial.C b : MvPolynomial (Fin 2) ℤ)
        (-(MvPolynomial.C a)) = 0 := by
    rw [← map_neg, eval5_C]
    change MvPolynomial.C (pNF a b c R₀ S₀ b (-a)) = 0
    rw [hp0]
    simp
  have hrootQ :
      eval5 (MvPolynomial.C (-c * a ^ 9))
        (MvPolynomial.C (-9 * c * a ^ 8 * b))
        (MvPolynomial.C (-36 * c * a ^ 7 * b ^ 2))
        (MvPolynomial.C (-84 * c * a ^ 6 * b ^ 3))
        (MvPolynomial.C (S₀ - 126 * c * a ^ 5 * b ^ 4))
        (MvPolynomial.C (R₀ - 126 * c * a ^ 4 * b ^ 5))
        (MvPolynomial.C b : MvPolynomial (Fin 2) ℤ)
        (-(MvPolynomial.C a)) = 0 := by
    rw [← map_neg, eval5_C]
    change MvPolynomial.C (qNF a b c R₀ S₀ b (-a)) = 0
    rw [hq0]
    simp
  have hdP : L ∣ P := by
    rw [hpoly.1]
    change MvPolynomial.C a * MvPolynomial.X 0 +
        MvPolynomial.C b * MvPolynomial.X 1 ∣ _
    exact linear_dvd_eval5_of_primitive_root
      (MvPolynomial.C S₀) (MvPolynomial.C R₀)
      (MvPolynomial.C (84 * c * a ^ 3 * b ^ 6))
      (MvPolynomial.C (36 * c * a ^ 2 * b ^ 7))
      (MvPolynomial.C (9 * c * a * b ^ 8))
      (MvPolynomial.C (c * b ^ 9))
      (MvPolynomial.C a) (MvPolynomial.C b)
      (MvPolynomial.X 0) (MvPolynomial.X 1)
      (MvPolynomial.C A) (MvPolynomial.C B)
      hbez hrootP
  have hdQ : L ∣ Q := by
    rw [hpoly.2]
    change MvPolynomial.C a * MvPolynomial.X 0 +
        MvPolynomial.C b * MvPolynomial.X 1 ∣ _
    exact linear_dvd_eval5_of_primitive_root
      (MvPolynomial.C (-c * a ^ 9))
      (MvPolynomial.C (-9 * c * a ^ 8 * b))
      (MvPolynomial.C (-36 * c * a ^ 7 * b ^ 2))
      (MvPolynomial.C (-84 * c * a ^ 6 * b ^ 3))
      (MvPolynomial.C (S₀ - 126 * c * a ^ 5 * b ^ 4))
      (MvPolynomial.C (R₀ - 126 * c * a ^ 4 * b ^ 5))
      (MvPolynomial.C a) (MvPolynomial.C b)
      (MvPolynomial.X 0) (MvPolynomial.X 1)
      (MvPolynomial.C A) (MvPolynomial.C B)
      hbez hrootQ
  let Lq : MvPolynomial (Fin 2) ℚ :=
    MvPolynomial.map (Int.castRingHom ℚ) L
  have hdPq : Lq ∣ MvPolynomial.map (Int.castRingHom ℚ) P := by
    rcases hdP with ⟨T, hT⟩
    refine ⟨MvPolynomial.map (Int.castRingHom ℚ) T, ?_⟩
    rw [hT]
    simp [Lq, map_mul]
  have hdQq : Lq ∣ MvPolynomial.map (Int.castRingHom ℚ) Q := by
    rcases hdQ with ⟨T, hT⟩
    refine ⟨MvPolynomial.map (Int.castRingHom ℚ) T, ?_⟩
    rw [hT]
    simp [Lq, map_mul]
  obtain ⟨unit, hunit⟩ := hcoprime Lq hdPq hdQq
  have hone : Lq * (↑(unit⁻¹) : MvPolynomial (Fin 2) ℚ) = 1 := by
    rw [← hunit]
    simp
  have heval := congrArg (MvPolynomial.eval ![(0 : ℚ), (0 : ℚ)]) hone
  have h01 : (0 : ℚ) = 1 := by
    simpa [Lq, L] using heval
  exact zero_ne_one h01

private theorem actual_polynomial_level_and_content
    (P Q : MvPolynomial (Fin 2) ℤ)
    (a b c d e u v A B : ℤ)
    (hP : P.IsHomogeneous 5) (hQ : Q.IsHomogeneous 5)
    (hab : A * a + B * b = 1)
    (hpure : MvPolynomial.X (1 : Fin 2) ^ 4 * P -
        MvPolynomial.X (0 : Fin 2) ^ 4 * Q =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ 9)
    (hunit : e ^ 4 * v - d ^ 4 * u = 1)
    (hgraph : MvPolynomial.eval ![d, e] P * u =
      MvPolynomial.eval ![d, e] Q * v) :
    a * d + b * e ∣
        levelInteger a b c (P.coeff m41) (P.coeff m50) ∧
      c ∣ P.coeff m50 * d + P.coeff m41 * e := by
  obtain ⟨hPE, hQE⟩ :=
    evaluated_quintic_normal_form P Q a b c hP hQ hpure d e
  have hgraphNF :
      pNF a b c (P.coeff m41) (P.coeff m50) d e * u =
        qNF a b c (P.coeff m41) (P.coeff m50) d e * v := by
    rw [← hPE, ← hQE]
    exact hgraph
  exact ⟨actual_normal_form_level_divides
      a b c (P.coeff m41) (P.coeff m50)
      d e u v A B hab hunit hgraphNF,
    actual_normal_form_content_divides
      a b c (P.coeff m41) (P.coeff m50)
      d e u v hunit hgraphNF⟩

private theorem signed_level_coordinates
    (a b A B d e m t : ℤ)
    (hab : A * a + B * b = 1)
    (hm : a * d + b * e = m)
    (ht : B * d - A * e = t) :
    d = A * m + b * t ∧ e = B * m - a * t := by
  constructor
  · linear_combination A * hm + b * ht - d * hab
  · linear_combination B * hm - a * ht - e * hab

private def pPartR {T : Type*} [CommRing T] (a b d e : T) : T :=
  b ^ 9 * e ^ 5 + 9 * a * b ^ 8 * d * e ^ 4 +
    36 * a ^ 2 * b ^ 7 * d ^ 2 * e ^ 3 +
    84 * a ^ 3 * b ^ 6 * d ^ 3 * e ^ 2

private def qPartR {T : Type*} [CommRing T] (a b d e : T) : T :=
  126 * a ^ 4 * b ^ 5 * e ^ 5 +
    126 * a ^ 5 * b ^ 4 * d * e ^ 4 +
    84 * a ^ 6 * b ^ 3 * d ^ 2 * e ^ 3 +
    36 * a ^ 7 * b ^ 2 * d ^ 3 * e ^ 2 +
    9 * a ^ 8 * b * d ^ 4 * e + a ^ 9 * d ^ 5

private noncomputable def dProg (A b m t₀ h : ℤ) : Polynomial ℤ :=
  Polynomial.C (A * m + b * t₀) +
    Polynomial.C (b * h) * Polynomial.X

private noncomputable def eProg (B a m t₀ h : ℤ) : Polynomial ℤ :=
  Polynomial.C (B * m - a * t₀) -
    Polynomial.C (a * h) * Polynomial.X

private noncomputable def jProg (j₀ j₁ : ℤ) : Polynomial ℤ :=
  Polynomial.C j₀ + Polynomial.C j₁ * Polynomial.X

private noncomputable def fProg (a b A B m t₀ h j₀ j₁ : ℤ) : Polynomial ℤ :=
  pPartR (Polynomial.C a) (Polynomial.C b)
      (dProg A b m t₀ h) (eProg B a m t₀ h) +
    (dProg A b m t₀ h) ^ 4 * jProg j₀ j₁

private noncomputable def gProg (a b A B m t₀ h j₀ j₁ : ℤ) : Polynomial ℤ :=
  (eProg B a m t₀ h) ^ 4 * jProg j₀ j₁ -
    qPartR (Polynomial.C a) (Polynomial.C b)
      (dProg A b m t₀ h) (eProg B a m t₀ h)

private theorem pPart_direction_value (a b : ℤ) :
    pPartR a b b (-a) = 56 * a ^ 5 * b ^ 9 := by
  dsimp [pPartR]
  ring

private theorem qPart_direction_value (a b : ℤ) :
    qPartR a b b (-a) = -(56 * a ^ 9 * b ^ 5) := by
  dsimp [qPartR]
  ring

private theorem progression_slope_to_q
    (a b c R S h j₁ q : ℤ)
    (hc : c ≠ 0)
    (hj : c * j₁ = (b * S - a * R) * h)
    (hq : c * q = levelInteger a b c R S * h) :
    j₁ + 56 * a ^ 5 * b ^ 5 * h = q := by
  apply mul_left_cancel₀ hc
  dsimp [levelInteger] at hq
  linear_combination hj - hq

private theorem progression_integral_values
    (a b c R S A B m t₀ h j₀ j₁ z : ℤ)
    (hJ₀ : S * (A * m + b * t₀) +
        R * (B * m - a * t₀) = c * j₀)
    (hJ₁ : (b * S - a * R) * h = c * j₁) :
    let d := A * m + b * (t₀ + h * z)
    let e := B * m - a * (t₀ + h * z)
    c * Polynomial.eval z (fProg a b A B m t₀ h j₀ j₁) =
        pNF a b c R S d e ∧
      c * Polynomial.eval z (gProg a b A B m t₀ h j₀ j₁) =
        qNF a b c R S d e := by
  dsimp
  let d : ℤ := A * m + b * (t₀ + h * z)
  let e : ℤ := B * m - a * (t₀ + h * z)
  have hJ : S * d + R * e = c * (j₀ + j₁ * z) := by
    dsimp [d, e]
    linear_combination hJ₀ + z * hJ₁
  have hf :
      Polynomial.eval z (fProg a b A B m t₀ h j₀ j₁) =
        pPart a b d e + d ^ 4 * (j₀ + j₁ * z) := by
    simp [fProg, pPartR, pPart, dProg, eProg, jProg,
      d, e, Polynomial.eval_add, Polynomial.eval_mul,
      Polynomial.eval_pow] <;> ring
  have hg :
      Polynomial.eval z (gProg a b A B m t₀ h j₀ j₁) =
        e ^ 4 * (j₀ + j₁ * z) - qPart a b d e := by
    simp [gProg, qPartR, qPart, dProg, eProg, jProg,
      d, e, Polynomial.eval_add, Polynomial.eval_mul,
      Polynomial.eval_pow] <;> ring
  constructor
  · rw [hf, p_congruence]
    rw [hJ]
    ring
  · rw [hg, q_congruence]
    rw [hJ]
    ring

private theorem evaluated_quintic_normal_form_from_public_support
    (P Q : MvPolynomial (Fin 2) ℤ) (a b c : ℤ)
    (hP : ∀ m ∈ P.support, m 0 + m 1 = 5)
    (hQ : ∀ m ∈ Q.support, m 0 + m 1 = 5)
    (hpure : MvPolynomial.X (1 : Fin 2) ^ 4 * P -
        MvPolynomial.X (0 : Fin 2) ^ 4 * Q =
      MvPolynomial.C c *
        (MvPolynomial.C a * MvPolynomial.X 0 +
          MvPolynomial.C b * MvPolynomial.X 1) ^ 9) :
    ∀ d e : ℤ,
      MvPolynomial.eval ![d, e] P =
        pNF a b c (P.coeff m41) (P.coeff m50) d e ∧
      MvPolynomial.eval ![d, e] Q =
        qNF a b c (P.coeff m41) (P.coeff m50) d e :=
  evaluated_quintic_normal_form P Q a b c
    (support_five_isHomogeneous P hP)
    (support_five_isHomogeneous Q hQ) hpure

private theorem original_progression_m9_values
    (a b c R S A B m t₀ h j₀ j₁ z u v : ℤ)
    (hc : c ≠ 0)
    (hab : A * a + B * b = 1)
    (hJ₀ : S * (A * m + b * t₀) +
        R * (B * m - a * t₀) = c * j₀)
    (hJ₁ : (b * S - a * R) * h = c * j₁)
    (hunit :
      (B * m - a * (t₀ + h * z)) ^ 4 * v -
      (A * m + b * (t₀ + h * z)) ^ 4 * u = 1)
    (hgraph :
      pNF a b c R S
          (A * m + b * (t₀ + h * z))
          (B * m - a * (t₀ + h * z)) * u =
      qNF a b c R S
          (A * m + b * (t₀ + h * z))
          (B * m - a * (t₀ + h * z)) * v) :
    Polynomial.eval z (fProg a b A B m t₀ h j₀ j₁) =
        m ^ 9 * v ∧
      Polynomial.eval z (gProg a b A B m t₀ h j₀ j₁) =
        m ^ 9 * u := by
  let d : ℤ := A * m + b * (t₀ + h * z)
  let e : ℤ := B * m - a * (t₀ + h * z)
  have hm : a * d + b * e = m := by
    dsimp [d, e]
    linear_combination m * hab
  have hpure : e ^ 4 * pNF a b c R S d e -
      d ^ 4 * qNF a b c R S d e =
      c * (a * d + b * e) ^ 9 := by
    dsimp [pNF, qNF, eval5]
    ring
  have hg : pNF a b c R S d e * u =
      qNF a b c R S d e * v := hgraph
  have hu : e ^ 4 * v - d ^ 4 * u = 1 := hunit
  obtain ⟨hp, hq⟩ :=
    original_graph_values a b c d e u v
      (pNF a b c R S d e) (qNF a b c R S d e)
      hpure hg hu
  have hprog := progression_integral_values
    a b c R S A B m t₀ h j₀ j₁ z hJ₀ hJ₁
  change
    c * Polynomial.eval z (fProg a b A B m t₀ h j₀ j₁) =
      pNF a b c R S d e ∧
    c * Polynomial.eval z (gProg a b A B m t₀ h j₀ j₁) =
      qNF a b c R S d e at hprog
  constructor
  · apply mul_left_cancel₀ hc
    calc
      c * Polynomial.eval z (fProg a b A B m t₀ h j₀ j₁) =
          pNF a b c R S d e := hprog.1
      _ = c * (a * d + b * e) ^ 9 * v := hp
      _ = c * (m ^ 9 * v) := by rw [hm]; ring
  · apply mul_left_cancel₀ hc
    calc
      c * Polynomial.eval z (gProg a b A B m t₀ h j₀ j₁) =
          qNF a b c R S d e := hprog.2
      _ = c * (a * d + b * e) ^ 9 * u := hq
      _ = c * (m ^ 9 * u) := by rw [hm]; ring

open Polynomial

private theorem coeff_mul_at_bounded_top
    (P Q : Polynomial ℤ) (r s : ℕ)
    (hP : P.natDegree ≤ r) (hQ : Q.natDegree ≤ s) :
    (P * Q).coeff (r + s) = P.coeff r * Q.coeff s := by
  classical
  rw [Polynomial.coeff_mul]
  refine Finset.sum_eq_single (r, s) ?_ ?_
  · rintro ⟨u, v⟩ huv hne
    have hsum : u + v = r + s := by simpa using huv
    by_cases hu : r < u
    · have hz : P.coeff u = 0 :=
        (Polynomial.natDegree_le_iff_coeff_eq_zero.mp hP) u hu
      simp [hz]
    · have hule : u ≤ r := by omega
      have hv : s < v := by
        by_contra hn
        have hvle : v ≤ s := by omega
        have hur : u = r := by omega
        have hvs : v = s := by omega
        exact hne (by simp [hur, hvs])
      have hz : Q.coeff v = 0 :=
        (Polynomial.natDegree_le_iff_coeff_eq_zero.mp hQ) v hv
      simp [hz]
  · intro hnot
    exact False.elim (hnot (by simp))

private theorem natDegree_pow_le_bound
    (P : Polynomial ℤ) (r n : ℕ)
    (hP : P.natDegree ≤ r) :
    (P ^ n).natDegree ≤ r * n := by
  induction n with
  | zero => simp
  | succ n ih =>
      calc
        (P ^ (n + 1)).natDegree =
            (P ^ n * P).natDegree := by rw [pow_succ]
        _ ≤ (P ^ n).natDegree + P.natDegree := by
          first
          | exact Polynomial.natDegree_mul_le _ _
          | exact Polynomial.natDegree_mul_le
        _ ≤ r * n + r := by omega
        _ = r * (n + 1) := by ring

private theorem coeff_pow_at_bounded_top
    (P : Polynomial ℤ) (r n : ℕ)
    (hP : P.natDegree ≤ r) :
    (P ^ n).coeff (r * n) = (P.coeff r) ^ n := by
  induction n with
  | zero => simp
  | succ n ih =>
      calc
        (P ^ (n + 1)).coeff (r * (n + 1)) =
            (P ^ n * P).coeff (r * n + r) := by
              simp [pow_succ, Nat.mul_succ]
        _ = (P ^ n).coeff (r * n) * P.coeff r :=
          coeff_mul_at_bounded_top (P ^ n) P (r * n) r
            (natDegree_pow_le_bound P r n hP) hP
        _ = (P.coeff r) ^ (n + 1) := by rw [ih, pow_succ]

private theorem natDegree_constant_le_zero (u : ℤ) :
    (C u : Polynomial ℤ).natDegree ≤ 0 := by
  simp

private theorem coeff_constant_pos_zero (u : ℤ) (n : ℕ) (hn : 0 < n) :
    (C u : Polynomial ℤ).coeff n = 0 := by
  exact (Polynomial.natDegree_le_iff_coeff_eq_zero.mp
    (natDegree_constant_le_zero u)) n hn

private theorem natDegree_affine_le_one (u v : ℤ) :
    (C u + C v * X).natDegree ≤ 1 := by
  apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
  intro n hn
  have hn1 : n ≠ 1 := by omega
  have hcu : (C u : Polynomial ℤ).coeff n = 0 :=
    coeff_constant_pos_zero u n (by omega)
  have hx : (X : Polynomial ℤ).coeff n = 0 := by
    have hpow : ((X : Polynomial ℤ) ^ 1).coeff n = 0 := by
      simp only [Polynomial.coeff_X_pow]
      split_ifs with h
      · omega
      · rfl
    simpa only [pow_one] using hpow
  simp only [Polynomial.coeff_add, Polynomial.coeff_C_mul, hcu, hx]
  ring

private theorem coeff_affine_one (u v : ℤ) :
    (C u + C v * X).coeff 1 = v := by
  have hcu : (C u : Polynomial ℤ).coeff 1 = 0 :=
    coeff_constant_pos_zero u 1 (by omega)
  simp only [Polynomial.coeff_add, Polynomial.coeff_C_mul, hcu]
  simp

private theorem coeff_affine_monomial
    (d₀ D e₀ E : ℤ) (i j : ℕ) :
    ((C d₀ + C D * X) ^ i *
      (C e₀ + C E * X) ^ j).coeff (i + j) =
        D ^ i * E ^ j := by
  let DP : Polynomial ℤ := C d₀ + C D * X
  let EP : Polynomial ℤ := C e₀ + C E * X
  change (DP ^ i * EP ^ j).coeff (i + j) = D ^ i * E ^ j
  have hD : DP.natDegree ≤ 1 :=
    natDegree_affine_le_one d₀ D
  have hE : EP.natDegree ≤ 1 :=
    natDegree_affine_le_one e₀ E
  have hDi : (DP ^ i).natDegree ≤ i := by
    simpa using natDegree_pow_le_bound DP 1 i hD
  have hEj : (EP ^ j).natDegree ≤ j := by
    simpa using natDegree_pow_le_bound EP 1 j hE
  have hDcoeff : DP.coeff 1 = D := by
    simpa only [DP] using coeff_affine_one d₀ D
  have hEcoeff : EP.coeff 1 = E := by
    simpa only [EP] using coeff_affine_one e₀ E
  have hDtop : (DP ^ i).coeff i = D ^ i := by
    simpa only [one_mul, hDcoeff] using
      coeff_pow_at_bounded_top DP 1 i hD
  have hEtop : (EP ^ j).coeff j = E ^ j := by
    simpa only [one_mul, hEcoeff] using
      coeff_pow_at_bounded_top EP 1 j hE
  rw [coeff_mul_at_bounded_top (DP ^ i) (EP ^ j) i j hDi hEj,
    hDtop, hEtop]

private theorem coeff_affine_monomial_scaled
    (c d₀ D e₀ E : ℤ) (i j : ℕ) :
    (C c * ((C d₀ + C D * X) ^ i *
      (C e₀ + C E * X) ^ j)).coeff (i + j) =
        c * D ^ i * E ^ j := by
  rw [Polynomial.coeff_C_mul,
    coeff_affine_monomial]
  ring

private theorem eval5_affine_top
    (p₀ p₁ p₂ p₃ p₄ p₅ d₀ D e₀ E : ℤ) :
    (eval5 (C p₀) (C p₁) (C p₂) (C p₃) (C p₄) (C p₅)
      (C d₀ + C D * X) (C e₀ + C E * X)).coeff 5 =
        eval5 p₀ p₁ p₂ p₃ p₄ p₅ D E := by
  let DP : Polynomial ℤ := C d₀ + C D * X
  let EP : Polynomial ℤ := C e₀ + C E * X
  change (eval5 (C p₀) (C p₁) (C p₂) (C p₃) (C p₄) (C p₅)
    DP EP).coeff 5 = eval5 p₀ p₁ p₂ p₃ p₄ p₅ D E
  have hform :
      eval5 (C p₀) (C p₁) (C p₂) (C p₃) (C p₄) (C p₅)
        DP EP =
      C p₀ * (DP ^ 5 * EP ^ 0) +
      C p₁ * (DP ^ 4 * EP ^ 1) +
      C p₂ * (DP ^ 3 * EP ^ 2) +
      C p₃ * (DP ^ 2 * EP ^ 3) +
      C p₄ * (DP ^ 1 * EP ^ 4) +
      C p₅ * (DP ^ 0 * EP ^ 5) := by
    dsimp [eval5]
    ring
  rw [hform]
  simp only [Polynomial.coeff_add]
  have h₀ :
      (C p₀ * (DP ^ 5 * EP ^ 0)).coeff 5 =
        p₀ * D ^ 5 * E ^ 0 := by
    simpa [DP, EP] using
      coeff_affine_monomial_scaled p₀ d₀ D e₀ E 5 0
  have h₁ :
      (C p₁ * (DP ^ 4 * EP ^ 1)).coeff 5 =
        p₁ * D ^ 4 * E ^ 1 := by
    simpa [DP, EP] using
      coeff_affine_monomial_scaled p₁ d₀ D e₀ E 4 1
  have h₂ :
      (C p₂ * (DP ^ 3 * EP ^ 2)).coeff 5 =
        p₂ * D ^ 3 * E ^ 2 := by
    simpa [DP, EP] using
      coeff_affine_monomial_scaled p₂ d₀ D e₀ E 3 2
  have h₃ :
      (C p₃ * (DP ^ 2 * EP ^ 3)).coeff 5 =
        p₃ * D ^ 2 * E ^ 3 := by
    simpa [DP, EP] using
      coeff_affine_monomial_scaled p₃ d₀ D e₀ E 2 3
  have h₄ :
      (C p₄ * (DP ^ 1 * EP ^ 4)).coeff 5 =
        p₄ * D ^ 1 * E ^ 4 := by
    simpa [DP, EP] using
      coeff_affine_monomial_scaled p₄ d₀ D e₀ E 1 4
  have h₅ :
      (C p₅ * (DP ^ 0 * EP ^ 5)).coeff 5 =
        p₅ * D ^ 0 * E ^ 5 := by
    simpa [DP, EP] using
      coeff_affine_monomial_scaled p₅ d₀ D e₀ E 0 5
  rw [h₀, h₁, h₂, h₃, h₄, h₅]
  dsimp [eval5]
  ring

private theorem pPartR_affine_top
    (a b d₀ D e₀ E : ℤ) :
    (pPartR (C a) (C b)
      (C d₀ + C D * X) (C e₀ + C E * X)).coeff 5 =
        pPartR a b D E := by
  have hpform :
      pPartR (C a) (C b)
        (C d₀ + C D * X) (C e₀ + C E * X) =
      eval5 (C 0) (C 0) (C (84 * a ^ 3 * b ^ 6))
        (C (36 * a ^ 2 * b ^ 7))
        (C (9 * a * b ^ 8)) (C (b ^ 9))
        (C d₀ + C D * X) (C e₀ + C E * X) := by
    simp [pPartR, eval5, Polynomial.C_mul, map_pow] <;> ring
  rw [hpform, eval5_affine_top]
  dsimp [eval5, pPartR]
  ring

private theorem qPartR_affine_top
    (a b d₀ D e₀ E : ℤ) :
    (qPartR (C a) (C b)
      (C d₀ + C D * X) (C e₀ + C E * X)).coeff 5 =
        qPartR a b D E := by
  have hqform :
      qPartR (C a) (C b)
        (C d₀ + C D * X) (C e₀ + C E * X) =
      eval5 (C (a ^ 9)) (C (9 * a ^ 8 * b))
        (C (36 * a ^ 7 * b ^ 2))
        (C (84 * a ^ 6 * b ^ 3))
        (C (126 * a ^ 5 * b ^ 4))
        (C (126 * a ^ 4 * b ^ 5))
        (C d₀ + C D * X) (C e₀ + C E * X) := by
    simp [qPartR, eval5, Polynomial.C_mul, map_pow] <;> ring
  rw [hqform, eval5_affine_top]
  dsimp [eval5, qPartR]
  ring

private theorem fProg_coeff_five_bounded
    (a b A B m t₀ h j₀ j₁ : ℤ) :
    (fProg a b A B m t₀ h j₀ j₁).coeff 5 =
      b ^ 4 * h ^ 4 *
        (j₁ + 56 * a ^ 5 * b ^ 5 * h) := by
  let d₀ : ℤ := A * m + b * t₀
  let e₀ : ℤ := B * m - a * t₀
  have hepoly :
      eProg B a m t₀ h = C e₀ + C (-a * h) * X := by
    dsimp [eProg, e₀]
    have hneg : C (-a * h) = -(C (a * h)) := by
      have hh : -a * h = -(a * h) := by ring
      rw [hh, map_neg]
    rw [hneg]
    ring
  have hp :
      (pPartR (C a) (C b)
        (dProg A b m t₀ h) (eProg B a m t₀ h)).coeff 5 =
        pPartR a b (b * h) (-a * h) := by
    rw [hepoly]
    simpa only [dProg, d₀] using
      pPartR_affine_top a b d₀ (b * h) e₀ (-a * h)
  have hj :
      ((dProg A b m t₀ h) ^ 4 * jProg j₀ j₁).coeff 5 =
        (b * h) ^ 4 * j₁ := by
    simpa only [dProg, jProg, d₀, pow_one, Nat.reduceAdd] using
      coeff_affine_monomial d₀ (b * h) j₀ j₁ 4 1
  have hs :
      pPartR a b (b * h) (-a * h) =
        h ^ 5 * pPartR a b b (-a) := by
    dsimp [pPartR]
    ring
  rw [fProg, Polynomial.coeff_add, hp, hj, hs,
    pPart_direction_value]
  ring

private theorem gProg_coeff_five_bounded
    (a b A B m t₀ h j₀ j₁ : ℤ) :
    (gProg a b A B m t₀ h j₀ j₁).coeff 5 =
      a ^ 4 * h ^ 4 *
        (j₁ + 56 * a ^ 5 * b ^ 5 * h) := by
  let d₀ : ℤ := A * m + b * t₀
  let e₀ : ℤ := B * m - a * t₀
  have hepoly :
      eProg B a m t₀ h = C e₀ + C (-a * h) * X := by
    dsimp [eProg, e₀]
    have hneg : C (-a * h) = -(C (a * h)) := by
      have hh : -a * h = -(a * h) := by ring
      rw [hh, map_neg]
    rw [hneg]
    ring
  have hq :
      (qPartR (C a) (C b)
        (dProg A b m t₀ h) (eProg B a m t₀ h)).coeff 5 =
        qPartR a b (b * h) (-a * h) := by
    rw [hepoly]
    simpa only [dProg, d₀] using
      qPartR_affine_top a b d₀ (b * h) e₀ (-a * h)
  have hj :
      ((eProg B a m t₀ h) ^ 4 * jProg j₀ j₁).coeff 5 =
        (-a * h) ^ 4 * j₁ := by
    rw [hepoly]
    simpa only [jProg, pow_one, Nat.reduceAdd] using
      coeff_affine_monomial e₀ (-a * h) j₀ j₁ 4 1
  have hs :
      qPartR a b (b * h) (-a * h) =
        h ^ 5 * qPartR a b b (-a) := by
    dsimp [qPartR]
    ring
  rw [gProg, Polynomial.coeff_sub, hj, hq, hs,
    qPart_direction_value]
  ring

private theorem actual_fProg_gProg_top_coeff_bounded
    (a b c R S A B m t₀ h j₀ j₁ q : ℤ)
    (hc : c ≠ 0)
    (hj : c * j₁ = (b * S - a * R) * h)
    (hq : c * q = levelInteger a b c R S * h) :
    (fProg a b A B m t₀ h j₀ j₁).coeff 5 =
        q * h ^ 4 * b ^ 4 ∧
      (gProg a b A B m t₀ h j₀ j₁).coeff 5 =
        q * h ^ 4 * a ^ 4 := by
  have hs := progression_slope_to_q a b c R S h j₁ q hc hj hq
  constructor
  · rw [fProg_coeff_five_bounded, hs]
    ring
  · rw [gProg_coeff_five_bounded, hs]
    ring

theorem a7_normalized_gcd (c K : ℤ) (hc : c ≠ 0) (hK : K ≠ 0) :
    let g : ℤ := (c.natAbs.gcd K.natAbs : ℕ)
    let h : ℤ := (c.natAbs / c.natAbs.gcd K.natAbs : ℕ)
    0 < g ∧ 0 < h ∧
      ∃ q : ℤ, q ≠ 0 ∧ c * q = K * h ∧
        Nat.Coprime h.natAbs q.natAbs := by
  let C : ℕ := c.natAbs
  let Kabs : ℕ := K.natAbs
  let gN : ℕ := C.gcd Kabs
  let hN : ℕ := C / gN
  let kN : ℕ := Kabs / gN
  have hCpos : 0 < C := Int.natAbs_pos.mpr hc
  have hKpos : 0 < Kabs := Int.natAbs_pos.mpr hK
  have hgNpos : 0 < gN := Nat.gcd_pos_of_pos_left Kabs hCpos
  have hgC : gN ∣ C := Nat.gcd_dvd_left C Kabs
  have hgK : gN ∣ Kabs := Nat.gcd_dvd_right C Kabs
  have hgCle : gN ≤ C := Nat.le_of_dvd hCpos hgC
  have hgKle : gN ≤ Kabs := Nat.le_of_dvd hKpos hgK
  have hhNpos : 0 < hN := Nat.div_pos hgCle hgNpos
  have hkNpos : 0 < kN := Nat.div_pos hgKle hgNpos
  have hCeq : gN * hN = C := Nat.mul_div_cancel' hgC
  have hKeq : gN * kN = Kabs := Nat.mul_div_cancel' hgK
  have hCcast : (C : ℤ) = (gN : ℤ) * (hN : ℤ) := by exact_mod_cast hCeq.symm
  have hKcast : (Kabs : ℤ) = (gN : ℤ) * (kN : ℤ) := by exact_mod_cast hKeq.symm
  have hcRep : c = c.sign * (C : ℤ) := (Int.sign_mul_natAbs c).symm
  have hKRep : K = K.sign * (Kabs : ℤ) := (Int.sign_mul_natAbs K).symm
  have hcSign : c.sign.natAbs = 1 := by
    rcases lt_trichotomy c 0 with hneg | hzero | hpos
    · rw [Int.sign_eq_neg_one_of_neg hneg]
      norm_num
    · exact False.elim (hc hzero)
    · rw [Int.sign_eq_one_of_pos hpos]
      norm_num
  have hKSign : K.sign.natAbs = 1 := by
    rcases lt_trichotomy K 0 with hneg | hzero | hpos
    · rw [Int.sign_eq_neg_one_of_neg hneg]
      norm_num
    · exact False.elim (hK hzero)
    · rw [Int.sign_eq_one_of_pos hpos]
      norm_num
  have hcSignSq : c.sign * c.sign = 1 := by
    rcases lt_trichotomy c 0 with hneg | hzero | hpos
    · rw [Int.sign_eq_neg_one_of_neg hneg]
      norm_num
    · exact False.elim (hc hzero)
    · rw [Int.sign_eq_one_of_pos hpos]
      norm_num
  let q : ℤ := c.sign * K.sign * (kN : ℤ)
  have hqabs : q.natAbs = kN := by
    simp [q, Int.natAbs_mul, hcSign, hKSign]
  have hq0 : q ≠ 0 := Int.natAbs_pos.mp (by rw [hqabs]; exact hkNpos)
  have hqeq : c * q = K * (hN : ℤ) := by
    calc
      c * q = (c.sign * (C : ℤ)) * q :=
        congrArg (fun z : ℤ => z * q) hcRep
      _ = (c.sign * (C : ℤ)) * (c.sign * K.sign * (kN : ℤ)) := rfl
      _ = (c.sign * c.sign) * ((C : ℤ) * K.sign * (kN : ℤ)) := by ring
      _ = (C : ℤ) * K.sign * (kN : ℤ) := by rw [hcSignSq]; ring
      _ = K * (hN : ℤ) := by
        calc
          (C : ℤ) * K.sign * (kN : ℤ) =
              ((gN : ℤ) * (hN : ℤ)) * K.sign * (kN : ℤ) := by rw [hCcast]
          _ = (K.sign * ((gN : ℤ) * (kN : ℤ))) * (hN : ℤ) := by ring
          _ = K * (hN : ℤ) := by rw [← hKcast, ← hKRep]
  have hcop : Nat.Coprime hN kN :=
    Nat.coprime_div_gcd_div_gcd hgNpos
  change 0 < (gN : ℤ) ∧ 0 < (hN : ℤ) ∧
    ∃ q : ℤ, q ≠ 0 ∧ c * q = K * (hN : ℤ) ∧
      Nat.Coprime (hN : ℤ).natAbs q.natAbs
  refine ⟨by exact_mod_cast hgNpos, by exact_mod_cast hhNpos, q, hq0, hqeq, ?_⟩
  simpa [hqabs] using hcop

theorem a7_gcd_progression_cancel
    (c K Δ : ℤ) (hc : c ≠ 0) (hK : K ≠ 0)
    (hdiv : c ∣ K * Δ) :
    ((c.natAbs / c.natAbs.gcd K.natAbs : ℕ) : ℤ) ∣ Δ := by
  let C : ℕ := c.natAbs
  let Kabs : ℕ := K.natAbs
  let gN : ℕ := C.gcd Kabs
  let hN : ℕ := C / gN
  let kN : ℕ := Kabs / gN
  have hCpos : 0 < C := Int.natAbs_pos.mpr hc
  have hgNpos : 0 < gN := Nat.gcd_pos_of_pos_left Kabs hCpos
  have hg0 : gN ≠ 0 := Nat.ne_of_gt hgNpos
  have hgC : gN ∣ C := Nat.gcd_dvd_left C Kabs
  have hgK : gN ∣ Kabs := Nat.gcd_dvd_right C Kabs
  have hCeq : gN * hN = C := Nat.mul_div_cancel' hgC
  have hKeq : gN * kN = Kabs := Nat.mul_div_cancel' hgK
  have hcop : Nat.Coprime hN kN := Nat.coprime_div_gcd_div_gcd hgNpos
  have hnat : C ∣ Kabs * Δ.natAbs := by
    have h := (Int.natAbs_dvd_natAbs).2 hdiv
    simpa [C, Kabs, Int.natAbs_mul] using h
  obtain ⟨z, hz⟩ := hnat
  have hkdiv : hN ∣ kN * Δ.natAbs := by
    refine ⟨z, ?_⟩
    apply mul_left_cancel₀ hg0
    calc
      gN * (kN * Δ.natAbs) = (gN * kN) * Δ.natAbs := by ring
      _ = Kabs * Δ.natAbs := by rw [hKeq]
      _ = C * z := hz
      _ = (gN * hN) * z := by rw [hCeq]
      _ = gN * (hN * z) := by ring
  have hfinal : hN ∣ Δ.natAbs := hcop.dvd_of_dvd_mul_left hkdiv
  change (hN : ℤ) ∣ Δ
  apply (Int.natAbs_dvd_natAbs).1
  simpa using hfinal

theorem a7_original_signed_progression
 (P Q : MvPolynomial (Fin 2) ℤ) (a b c A B d e u v : ℤ)
 (hP : ∀ μ ∈ P.support, μ 0 + μ 1 = 5)
 (hQ : ∀ μ ∈ Q.support, μ 0 + μ 1 = 5)
 (hc : c ≠ 0) (hab : A * a + B * b = 1)
 (hcop : ∀ R : MvPolynomial (Fin 2) ℚ,
   R ∣ MvPolynomial.map (Int.castRingHom ℚ) P →
   R ∣ MvPolynomial.map (Int.castRingHom ℚ) Q → IsUnit R)
 (hpure : MvPolynomial.X (1 : Fin 2) ^ 4 * P -
    MvPolynomial.X (0 : Fin 2) ^ 4 * Q =
    MvPolynomial.C c *
     (MvPolynomial.C a * MvPolynomial.X 0 +
      MvPolynomial.C b * MvPolynomial.X 1) ^ 9)
 (hunit : e ^ 4 * v - d ^ 4 * u = 1)
 (hgraph : MvPolynomial.eval ![d,e] P * u =
           MvPolynomial.eval ![d,e] Q * v) :
 let R := P.coeff (Finsupp.single 0 4 + Finsupp.single 1 1)
 let S := P.coeff (Finsupp.single 0 5)
 let K0 := b * S - a * R + 56 * c * a ^ 5 * b ^ 5
 let m := a * d + b * e
 let t₀ := B * d - A * e
 let g : ℤ := (c.natAbs.gcd K0.natAbs : ℕ)
 let h : ℤ := (c.natAbs / (c.natAbs.gcd K0.natAbs) : ℕ)
 K0 ≠ 0 ∧ m ≠ 0 ∧ m ∣ K0 ∧ 0 < g ∧ 0 < h ∧
 ∃ q j₀ j₁ : ℤ,
   q ≠ 0 ∧ c * q = K0 * h ∧
   Nat.Coprime h.natAbs q.natAbs ∧
   S * d + R * e = c * j₀ ∧
   (b * S - a * R) * h = c * j₁ ∧
   ∀ d' e' u' v' : ℤ,
    a * d' + b * e' = m → e' ^ 4 * v' - d' ^ 4 * u' = 1 →
    MvPolynomial.eval ![d',e'] P * u' =
      MvPolynomial.eval ![d',e'] Q * v' →
    ∃ z : ℤ,
      d' = A * m + b * (t₀ + h * z) ∧
      e' = B * m - a * (t₀ + h * z) ∧
      Polynomial.eval z (fProg a b A B m t₀ h j₀ j₁) = m ^ 9 * v' ∧
      Polynomial.eval z (gProg a b A B m t₀ h j₀ j₁) = m ^ 9 * u' := by
  let R : ℤ := P.coeff m41
  let S : ℤ := P.coeff m50
  let K0 : ℤ := b * S - a * R + 56 * c * a ^ 5 * b ^ 5
  let m : ℤ := a * d + b * e
  let t₀ : ℤ := B * d - A * e
  let g : ℤ := (c.natAbs.gcd K0.natAbs : ℕ)
  let h : ℤ := (c.natAbs / c.natAbs.gcd K0.natAbs : ℕ)
  change K0 ≠ 0 ∧ m ≠ 0 ∧ m ∣ K0 ∧ 0 < g ∧ 0 < h ∧
    ∃ q j₀ j₁ : ℤ,
      q ≠ 0 ∧ c * q = K0 * h ∧ Nat.Coprime h.natAbs q.natAbs ∧
      S * d + R * e = c * j₀ ∧
      (b * S - a * R) * h = c * j₁ ∧
      ∀ d' e' u' v' : ℤ,
        a * d' + b * e' = m → e' ^ 4 * v' - d' ^ 4 * u' = 1 →
        MvPolynomial.eval ![d',e'] P * u' =
          MvPolynomial.eval ![d',e'] Q * v' →
        ∃ z : ℤ,
          d' = A * m + b * (t₀ + h * z) ∧
          e' = B * m - a * (t₀ + h * z) ∧
          Polynomial.eval z (fProg a b A B m t₀ h j₀ j₁) = m ^ 9 * v' ∧
          Polynomial.eval z (gProg a b A B m t₀ h j₀ j₁) = m ^ 9 * u'
  have hPhom := support_five_isHomogeneous P hP
  have hQhom := support_five_isHomogeneous Q hQ
  have hK : K0 ≠ 0 := by
    change levelInteger a b c (P.coeff m41) (P.coeff m50) ≠ 0
    exact actual_level_nonzero_from_rational_coprime
      P Q a b c A B hPhom hQhom hab hcop hpure
  have hactual : m ∣ K0 ∧ c ∣ S * d + R * e := by
    change a * d + b * e ∣
      levelInteger a b c (P.coeff m41) (P.coeff m50) ∧
      c ∣ P.coeff m50 * d + P.coeff m41 * e
    exact actual_polynomial_level_and_content
      P Q a b c d e u v A B hPhom hQhom hab hpure hunit hgraph
  have hm0 : m ≠ 0 := by
    intro hmzero
    rcases hactual.1 with ⟨z, hz⟩
    rw [hmzero] at hz
    simp only [zero_mul] at hz
    exact hK hz
  have hnorm := a7_normalized_gcd c K0 hc hK
  change 0 < g ∧ 0 < h ∧
    ∃ q : ℤ, q ≠ 0 ∧ c * q = K0 * h ∧
      Nat.Coprime h.natAbs q.natAbs at hnorm
  obtain ⟨hg, hh, q, hq0, hq, hcopq⟩ := hnorm
  obtain ⟨j₀, hJ₀⟩ := hactual.2
  let j₁ : ℤ := q - 56 * a ^ 5 * b ^ 5 * h
  have hJ₁ : (b * S - a * R) * h = c * j₁ := by
    dsimp [j₁]
    calc
      (b * S - a * R) * h =
          K0 * h - c * (56 * a ^ 5 * b ^ 5 * h) := by
            dsimp [K0]
            ring
      _ = c * q - c * (56 * a ^ 5 * b ^ 5 * h) := by rw [← hq]
      _ = c * (q - 56 * a ^ 5 * b ^ 5 * h) := by ring
  have href := signed_level_coordinates a b A B d e m t₀ hab rfl rfl
  have hJ₀prog :
      S * (A * m + b * t₀) + R * (B * m - a * t₀) = c * j₀ := by
    rw [← href.1, ← href.2]
    exact hJ₀
  refine ⟨hK, hm0, hactual.1, hg, hh, q, j₀, j₁,
    hq0, hq, hcopq, hJ₀, hJ₁, ?_⟩
  intro d' e' u' v' hlevel hunit' hgraph'
  have hactual' : c ∣ S * d' + R * e' := by
    change c ∣ P.coeff m50 * d' + P.coeff m41 * e'
    exact (actual_polynomial_level_and_content
      P Q a b c d' e' u' v' A B hPhom hQhom hab hpure hunit' hgraph').2
  have hdiff :
      c ∣ K0 * ((B * d' - A * e') - (B * d - A * e)) := by
    change c ∣ levelInteger a b c R S *
      ((B * d' - A * e') - (B * d - A * e))
    exact same_level_content_difference
      a b c R S d' e' d e A B hab hlevel hactual' hactual.2
  have hstep : h ∣ (B * d' - A * e') - t₀ := by
    change ((c.natAbs / c.natAbs.gcd K0.natAbs : ℕ) : ℤ) ∣
      (B * d' - A * e') - t₀
    exact a7_gcd_progression_cancel c K0
      ((B * d' - A * e') - t₀) hc hK
      (by simpa only [t₀] using hdiff)
  obtain ⟨z, hz⟩ := hstep
  have ht' : B * d' - A * e' = t₀ + h * z := by
    linear_combination hz
  obtain ⟨hd', he'⟩ :=
    signed_level_coordinates a b A B d' e' m (t₀ + h * z)
      hab hlevel ht'
  obtain ⟨hPE, hQE⟩ :=
    evaluated_quintic_normal_form_from_public_support
      P Q a b c hP hQ hpure d' e'
  have hgraphNF :
      pNF a b c R S d' e' * u' =
        qNF a b c R S d' e' * v' := by
    change pNF a b c (P.coeff m41) (P.coeff m50) d' e' * u' =
      qNF a b c (P.coeff m41) (P.coeff m50) d' e' * v'
    rw [← hPE, ← hQE]
    exact hgraph'
  have hunitZ :
      (B * m - a * (t₀ + h * z)) ^ 4 * v' -
      (A * m + b * (t₀ + h * z)) ^ 4 * u' = 1 := by
    rw [← he', ← hd']
    exact hunit'
  have hgraphZ :
      pNF a b c R S
          (A * m + b * (t₀ + h * z))
          (B * m - a * (t₀ + h * z)) * u' =
      qNF a b c R S
          (A * m + b * (t₀ + h * z))
          (B * m - a * (t₀ + h * z)) * v' := by
    rw [← hd', ← he']
    exact hgraphNF
  obtain ⟨hf, hgval⟩ :=
    original_progression_m9_values
      a b c R S A B m t₀ h j₀ j₁ z u' v'
      hc hab hJ₀prog hJ₁ hunitZ hgraphZ
  exact ⟨z, hd', he', hf, hgval⟩

end A7PureNineSignedLevel

namespace A7PureNineOriginalCount

abbrev Point : Type := (ℕ × ℕ) × (ℕ × ℕ)

private def d (p : Point) : ℕ := p.1.1
private def e (p : Point) : ℕ := p.1.2
private def u (p : Point) : ℕ := p.2.1
private def v (p : Point) : ℕ := p.2.2

def OriginalCellPoint
    (P Q : MvPolynomial (Fin 2) ℤ)
    (x D E M rho Ccell : ℝ) (p : Point) : Prop :=
  0 < d p ∧ 0 < e p ∧ 0 < u p ∧ 0 < v p ∧
  D / 2 < (d p : ℝ) ∧ (d p : ℝ) ≤ D ∧
  E / 2 < (e p : ℝ) ∧ (e p : ℝ) ≤ E ∧
  x / 2 < (d p : ℝ) ^ 4 * (u p : ℝ) ∧
  (d p : ℝ) ^ 4 * (u p : ℝ) ≤ x ∧
  (e p : ℤ) ^ 4 * (v p : ℤ) -
    (d p : ℤ) ^ 4 * (u p : ℤ) = 1 ∧
  MvPolynomial.eval ![(d p : ℤ), (e p : ℤ)] P * (u p : ℤ) =
    MvPolynomial.eval ![(d p : ℤ), (e p : ℤ)] Q * (v p : ℤ) ∧
  |(d p : ℝ) / (e p : ℝ) - rho| ≤ Ccell * D / (E * M)

end A7PureNineOriginalCount

