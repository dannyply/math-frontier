    exact Or.inl (hh'.trans (by nlinarith only [mul_nonneg hK2 (pow_nonneg hx0.le 7)]))
  by_cases hlarge : δ*W^4≤μ^7*x
  · exact hlargeout hlarge
  obtain ⟨hds,hes,hps,hpsup,hlevs,hns,hnsx⟩ := hdata s ⟨le_rfl,hst⟩
