      ((signedDivisors h).filter (fun h0=>h0≠0 ∧ h0∣h))
  let E := {j : ℕ×ℤ // j∈J}
  have hfamily : ∀j:E,∃Tj:Finset (ℤ×ℤ),
      (∀X0 Y0:ℤ,X0.natAbs≤Z → Y0.natAbs≤Z → Int.gcd X0 Y0=1 →
        X0^2-(Delta:ℤ)*Y0^2=j.val.2 → (X0,Y0)∈Tj) ∧
