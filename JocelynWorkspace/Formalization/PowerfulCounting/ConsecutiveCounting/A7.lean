private theorem definite_norm_subpower (A L : ℝ) (hA : 1 ≤ A) (hL : 0 ≤ L)
    (epsilon : ℝ) (hepsilon : 0 < epsilon) :
    ∃ C : ℝ, 0 < C ∧ ∀ x : ℝ, 2 ≤ x →
      ∀ D M : ℕ, 0 < D → 0 < M → (M : ℝ) ≤ A*x^L →
      let S : Set (ℤ × ℤ) := {z | z.1^2+(D:ℤ)*z.2^2=M}
      S.Finite ∧ (S.ncard : ℝ) ≤ C*x^epsilon := by
  let delta : ℝ := epsilon/(2*L+1)
  have hden : 0 < 2*L+1 := by linarith
  have hd : 0 < delta := div_pos hepsilon hden
  have hdeq : delta*(2*L+1)=epsilon := div_mul_cancel₀ _ (ne_of_gt hden)
  have hexp : L*(2*delta) ≤ epsilon := by nlinarith
  obtain ⟨Cd,hCd,hdb⟩ :=
    JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C01.PcLowdegRed.divisor_bound delta hd
  let C : ℝ := 12*Cd^2*A^(2*delta)+1
  refine ⟨C, by dsimp [C]; positivity, ?_⟩
  intro x hx D M hD hM hMb
  let S : Set (ℤ × ℤ) := {z | z.1^2+(D:ℤ)*z.2^2=M}
  change S.Finite ∧ (S.ncard : ℝ) ≤ C*x^epsilon
  obtain ⟨hfin,hcard⟩ := all_signed_definite_count D M hD hM
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hA0 : 0 ≤ A := by linarith
  have hMtau : (M.divisors.card : ℝ) ≤ Cd*(M:ℝ)^delta := hdb M hM.ne'
  have hTau2 : (M.divisors.card : ℝ)^2 ≤ Cd^2*(M:ℝ)^(2*delta) := by
    calc
      (M.divisors.card : ℝ)^2 ≤ (Cd*(M:ℝ)^delta)^2 :=
        pow_le_pow_left₀ (Nat.cast_nonneg _) hMtau 2
      _ = Cd^2*(M:ℝ)^(2*delta) := by
        rw [mul_pow]
        congr 1
        rw [← Real.rpow_natCast, ← Real.rpow_mul (Nat.cast_nonneg M)]
        congr 1
        push_cast
        ring
  have hPower : (M:ℝ)^(2*delta) ≤ A^(2*delta)*x^epsilon := by
    calc
      (M:ℝ)^(2*delta) ≤ (A*x^L)^(2*delta) :=
        Real.rpow_le_rpow (Nat.cast_nonneg _) hMb (by positivity)
      _ = A^(2*delta)*x^(L*(2*delta)) := by
        rw [Real.mul_rpow hA0 (Real.rpow_nonneg hx0.le _), ← Real.rpow_mul hx0.le]
      _ ≤ A^(2*delta)*x^epsilon :=
        mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_le hx1 hexp)
          (Real.rpow_nonneg hA0 _)
  refine ⟨hfin, ?_⟩
  have hcardR : (S.ncard : ℝ) ≤ 12*(M.divisors.card : ℝ)^2 := by exact_mod_cast hcard
  calc
    (S.ncard : ℝ) ≤ 12*(M.divisors.card : ℝ)^2 := hcardR
    _ ≤ 12*(Cd^2*(M:ℝ)^(2*delta)) :=
      mul_le_mul_of_nonneg_left hTau2 (by norm_num)
    _ ≤ 12*(Cd^2*(A^(2*delta)*x^epsilon)) :=
      mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left hPower (sq_nonneg Cd)) (by norm_num)
    _ ≤ C*x^epsilon := by
      dsimp [C]
      nlinarith only [Real.rpow_nonneg hx0.le epsilon]

private theorem negative_quadratic_level_count (J : ℝ) (hJ : 0 ≤ J)
    (epsilon : ℝ) (hepsilon : 0 < epsilon) :
    ∃ C : ℝ, 0 < C ∧ ∀ x : ℝ, 2 ≤ x → ∀ A B C0 m : ℤ,
      A ≠ 0 → m ≠ 0 → B^2-4*A*C0 < 0 →
      |(A:ℝ)| ≤ x^J → |(B:ℝ)| ≤ x^J → |(C0:ℝ)| ≤ x^J → |(m:ℝ)| ≤ x^J →
      let S : Set (ℤ × ℤ) := {z |
        |(z.1:ℝ)| ≤ x^J ∧ |(z.2:ℝ)| ≤ x^J ∧
          A*z.1^2+B*z.1*z.2+C0*z.2^2=m}
