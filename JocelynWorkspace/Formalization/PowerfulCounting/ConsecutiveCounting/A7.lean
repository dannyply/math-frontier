private theorem normal_form
    (P Q : MvPolynomial (Fin 2) ℤ) (a b c : ℤ)
    (hP : P.IsHomogeneous 4) (hQ : Q.IsHomogeneous 4)
    (hcop : IsRelPrime (map (Int.castRingHom ℚ) P)
      (map (Int.castRingHom ℚ) Q))
    (hpure : X₁^4*Q-X₀^4*P =
      C c*(C a*X₀+C b*X₁)^8) :
    ∃ K₀ : ℤ, K₀ ≠ 0 ∧
      P = C K₀*X₁^4-C c*(C a*X₀+C b*X₁)*C (a^4)*
        R4 (C a*X₀) (C b*X₁) ∧
      Q = C K₀*X₀^4+C c*(C a*X₀+C b*X₁)*C (b^4)*
        R4 (C b*X₁) (C a*X₀) ∧
      2*K₀ = coeff m04 P+coeff m40 Q := by
  have hvals : ∀ t : ℤ,
      t^4*(coeff m40 Q+coeff m31 Q*t+coeff m22 Q*t^2+
        coeff m13 Q*t^3+coeff m04 Q*t^4) -
      (coeff m40 P+coeff m31 P*t+coeff m22 P*t^2+
        coeff m13 P*t^3+coeff m04 P*t^4) = c*(a+b*t)^8 := by
    intro t
    have hh := congrArg (eval ![(1:ℤ),t]) hpure
    simpa [X₀,X₁,eval_quartic P hP t,eval_quartic Q hQ t] using hh
  obtain ⟨hp40,hp31,hp22,hp13,hmid,hq31,hq22,hq13,hq04⟩ :=
    nine_coefficients
      (coeff m40 P) (coeff m31 P) (coeff m22 P) (coeff m13 P) (coeff m04 P)
      (coeff m40 Q) (coeff m31 Q) (coeff m22 Q) (coeff m13 Q) (coeff m04 Q)
      a b c hvals
  let K₀ := coeff m04 P+35*c*a^4*b^4
  have hq40 : coeff m40 Q = coeff m04 P+70*c*a^4*b^4 := by
    linarith only [hmid]
  have hPn : P = C K₀*X₁^4-C c*(C a*X₀+C b*X₁)*C (a^4)*
      R4 (C a*X₀) (C b*X₁) := by
    conv_lhs => rw [homogeneous_quartic_explicit P hP]
    dsimp [K₀,R4]
    rw [hp40,hp31,hp22,hp13]
    simp [map_add,map_mul,map_pow,map_neg] <;> push_cast <;> ring
  have hQn : Q = C K₀*X₀^4+C c*(C a*X₀+C b*X₁)*C (b^4)*
      R4 (C b*X₁) (C a*X₀) := by
    conv_lhs => rw [homogeneous_quartic_explicit Q hQ]
    dsimp [K₀,R4]
    rw [hq40,hq31,hq22,hq13,hq04]
    simp [map_add,map_mul,map_pow,map_neg] <;> push_cast <;> ring
  have hK : K₀ ≠ 0 := by
    intro hz
    let Lq : MvPolynomial (Fin 2) ℚ :=
      C (a:ℚ)*X 0+C (b:ℚ)*X 1
    have hpZ : (C a*X₀+C b*X₁) ∣ P := by
      refine ⟨-C c*C (a^4)*R4 (C a*X₀) (C b*X₁), ?_⟩
      rw [hPn,hz]
      simp only [map_zero,zero_mul,zero_sub]
      ring
    have hqZ : (C a*X₀+C b*X₁) ∣ Q := by
      refine ⟨C c*C (b^4)*R4 (C b*X₁) (C a*X₀), ?_⟩
      rw [hQn,hz]
      simp only [map_zero,zero_mul,zero_add]
      ring
    have hpL : Lq ∣ map (Int.castRingHom ℚ) P := by
      obtain ⟨T,hT⟩ := hpZ
      refine ⟨map (Int.castRingHom ℚ) T, ?_⟩
      have hh := congrArg (map (Int.castRingHom ℚ)) hT
      simpa [Lq,X₀,X₁,map_mul,map_add,map_C,map_X] using hh
    have hqL : Lq ∣ map (Int.castRingHom ℚ) Q := by
      obtain ⟨T,hT⟩ := hqZ
      refine ⟨map (Int.castRingHom ℚ) T, ?_⟩
      have hh := congrArg (map (Int.castRingHom ℚ)) hT
      simpa [Lq,X₀,X₁,map_mul,map_add,map_C,map_X] using hh
    have hunit : IsUnit Lq := hcop hpL hqL
    have hzunit : IsUnit (0:ℚ) := by
      simpa [Lq] using hunit.map (eval ![(0:ℚ),0])
    exact not_isUnit_zero hzunit
  refine ⟨K₀,hK,hPn,hQn,?_⟩
  dsimp [K₀]
  linarith only [hmid]

private theorem normal_coefficient_height
    (P Q : MvPolynomial (Fin 2) ℤ) (K₀ : ℤ) (H : ℝ)
    (hK : 2*K₀ = coeff m04 P+coeff m40 Q)
    (hheight : ∀ m : Fin 2 →₀ ℕ,
      |((coeff m P : ℤ):ℝ)| ≤ H ∧ |((coeff m Q : ℤ):ℝ)| ≤ H) :
    |(K₀:ℝ)| ≤ H := by
  have hp := hheight m04
  have hq := hheight m40
  have hr : 2*(K₀:ℝ)=((coeff m04 P:ℤ):ℝ)+((coeff m40 Q:ℤ):ℝ) := by
    exact_mod_cast hK
  rcases abs_le.mp hp.1 with ⟨hpl,hpu⟩
  rcases abs_le.mp hq.2 with ⟨hql,hqu⟩
  apply abs_le.mpr
  constructor <;> linarith only [hr,hpl,hpu,hql,hqu]

private theorem signed_level
    (d e u v pval qval a b c K₀ : ℤ)
    (he : e ≠ 0) (hc : c ≠ 0) (hK : K₀ ≠ 0)
    (hunit : e^4*v=d^4*u+1)
    (hparallel : u*qval=v*pval)
    (hpure : e^4*qval-d^4*pval=c*(a*d+b*e)^8)
    (hPn : pval=K₀*e^4-c*(a*d+b*e)*a^4*R4 (a*d) (b*e))
    (hQn : qval=K₀*d^4+c*(a*d+b*e)*b^4*R4 (b*e) (a*d)) :
    let m : ℤ := a*d+b*e;
    m ≠ 0 ∧ ∃ q : ℤ, q ≠ 0 ∧ K₀=c*m*q ∧
      m^7*u=q*e^4-a^4*R4 (a*d) (b*e) ∧
      m^7*v=q*d^4+b^4*R4 (b*e) (a*d) := by
  intro m
  have hPs : pval=c*m^8*u := by
    dsimp [m]
    linear_combination u*hpure-e^4*hparallel-pval*hunit
  have hQs : qval=c*m^8*v := by
    dsimp [m]
    linear_combination v*hpure-d^4*hparallel-qval*hunit
  change pval=K₀*e^4-c*m*a^4*R4 (a*d) (b*e) at hPn
  change qval=K₀*d^4+c*m*b^4*R4 (b*e) (a*d) at hQn
  have hm : m ≠ 0 := by
    intro hz
    have hpzero : pval=0 := by simpa [hz] using hPs
    have hprod : K₀*e^4=0 := by simpa [hz,hpzero] using hPn.symm
    exact (mul_ne_zero hK (pow_ne_zero 4 he)) hprod
  have hdvd_e : c*m ∣ K₀*e^4 := by
    refine ⟨m^7*u+a^4*R4 (a*d) (b*e),?_⟩
    linear_combination hPs-hPn
  have hdvd_d : c*m ∣ K₀*d^4 := by
    refine ⟨m^7*v-b^4*R4 (b*e) (a*d),?_⟩
    linear_combination hQs-hQn
  have hdvd : c*m ∣ K₀ := by
    obtain ⟨s,hs⟩ := hdvd_e
    obtain ⟨t,ht⟩ := hdvd_d
    refine ⟨v*s-u*t,?_⟩
    linear_combination -K₀*hunit+v*hs-u*ht
  obtain ⟨q,hq⟩ := hdvd
  have hq0 : q ≠ 0 := by
    intro hz
    apply hK
    simpa [hz] using hq
  refine ⟨hm,q,hq0,hq,?_,?_⟩
  · apply mul_left_cancel₀ (mul_ne_zero hc hm)
    calc
      c*m*(m^7*u)=c*m^8*u := by ring
      _ = pval := hPs.symm
      _ = c*m*(q*e^4-a^4*R4 (a*d) (b*e)) := by rw [hPn,hq]; ring
  · apply mul_left_cancel₀ (mul_ne_zero hc hm)
    calc
      c*m*(m^7*v)=c*m^8*v := by ring
      _ = qval := hQs.symm
      _ = c*m*(q*d^4+b^4*R4 (b*e) (a*d)) := by rw [hQn,hq]; ring

private theorem actual_signed_level
    (P Q : MvPolynomial (Fin 2) ℤ) (a b c K₀ : ℤ)
    (hc : c ≠ 0) (hK : K₀ ≠ 0)
    (hpure : X₁^4*Q-X₀^4*P=C c*(C a*X₀+C b*X₁)^8)
    (hPn : P=C K₀*X₁^4-C c*(C a*X₀+C b*X₁)*C (a^4)*R4 (C a*X₀) (C b*X₁))
    (hQn : Q=C K₀*X₀^4+C c*(C a*X₀+C b*X₁)*C (b^4)*R4 (C b*X₁) (C a*X₀))
    (d e u v : ℤ) (he : e ≠ 0)
    (hunit : e^4*v=d^4*u+1)
    (hparallel : u*eval ![d,e] Q=v*eval ![d,e] P) :
    let m : ℤ := a*d+b*e;
    m ≠ 0 ∧ ∃ q : ℤ, q ≠ 0 ∧ K₀=c*m*q ∧
      m^7*u=q*e^4-a^4*R4 (a*d) (b*e) ∧
      m^7*v=q*d^4+b^4*R4 (b*e) (a*d) := by
  have hpp := congrArg (eval ![d,e]) hpure
  have hp := congrArg (eval ![d,e]) hPn
  have hq := congrArg (eval ![d,e]) hQn
  simp [X₀,X₁,R4] at hpp hp hq ⊢
  exact signed_level d e u v (eval ![d,e] P) (eval ![d,e] Q)
    a b c K₀ he hc hK hunit hparallel hpp hp hq

private theorem level_parameter (a b d₀ e₀ m d e : ℤ)
    (hbase : a*d₀+b*e₀=1) (hlevel : a*d+b*e=m) :
    ∃ r : ℤ, d=m*d₀+b*r ∧ e=m*e₀-a*r := by
  refine ⟨e₀*d-d₀*e,?_,?_⟩
  · linear_combination -d*hbase+d₀*hlevel
  · linear_combination -e*hbase+e₀*hlevel

private theorem parameter_unique (a b d₀ e₀ m d e r s : ℤ)
    (hbase : a*d₀+b*e₀=1)
    (hdr : d=m*d₀+b*r) (her : e=m*e₀-a*r)
    (hds : d=m*d₀+b*s) (hes : e=m*e₀-a*s) : r=s := by
  linear_combination -e₀*(hdr-hds)+d₀*(her-hes)-(r-s)*hbase

private theorem quotient_unique (c m K₀ q r : ℤ)
    (hc : c ≠ 0) (hm : m ≠ 0)
    (hq : K₀=c*m*q) (hr : K₀=c*m*r) : q=r := by
  apply mul_left_cancel₀ (mul_ne_zero hc hm)
  exact hq.symm.trans hr

private theorem level_divisor (K₀ c m q : ℤ) (h : K₀=c*m*q) :
    m.natAbs ∣ K₀.natAbs := by
  refine ⟨(c*q).natAbs,?_⟩
  rw [← Int.natAbs_mul]
  congr 1
  rw [h]
  ring

private theorem height_numerator (a b d e m q u : ℤ)
    (hu : m^7*u=q*e^4-a^4*R4 (a*d) (b*e)) :
    m^7*(d^4*u)=q*(d*e)^4-H4 (a*d) (b*e) := by
  dsimp [H4]
  linear_combination d^4*hu

private theorem inverse_unit_shift (a b d e m q u v : ℤ)
    (hm : m ≠ 0) (hlevel : a*d+b*e=m)
    (hu : m^7*u=q*e^4-a^4*R4 (a*d) (b*e))
    (hv : m^7*v=q*d^4+b^4*R4 (b*e) (a*d)) :
    e^4*v=d^4*u+1 := by
  have hsum := complement (a*d) (b*e)
  rw [hlevel] at hsum
  have h : m^7*(e^4*v-d^4*u-1)=0 := by
    dsimp [H4] at hsum
    linear_combination e^4*hv-d^4*hu+hsum
  have hz : e^4*v-d^4*u-1=0 :=
    (mul_eq_zero.mp h).resolve_left (pow_ne_zero 7 hm)
  linarith only [hz]

private theorem whole_original_arithmetic
    (P Q : MvPolynomial (Fin 2) ℤ) (a b c : ℤ) (H : ℝ)
    (hP : P.IsHomogeneous 4) (hQ : Q.IsHomogeneous 4)
    (hcop : IsRelPrime (map (Int.castRingHom ℚ) P)
      (map (Int.castRingHom ℚ) Q))
    (hc : c ≠ 0)
    (hheight : ∀ m : Fin 2 →₀ ℕ,
      |((coeff m P:ℤ):ℝ)| ≤ H ∧ |((coeff m Q:ℤ):ℝ)| ≤ H)
    (hpure : X₁^4*Q-X₀^4*P=C c*(C a*X₀+C b*X₁)^8) :
    ∃ K₀ : ℤ, K₀ ≠ 0 ∧ |(K₀:ℝ)| ≤ H ∧
      ∀ d e u v : ℤ, e ≠ 0 → e^4*v=d^4*u+1 →
      u*eval ![d,e] Q=v*eval ![d,e] P →
      let m : ℤ := a*d+b*e;
      m ≠ 0 ∧ m.natAbs ∣ K₀.natAbs ∧
        ∃ q : ℤ, q ≠ 0 ∧ K₀=c*m*q ∧
          m^7*u=q*e^4-a^4*R4 (a*d) (b*e) ∧
          m^7*v=q*d^4+b^4*R4 (b*e) (a*d) := by
  obtain ⟨K₀,hK,hPn,hQn,hcenter⟩ := normal_form P Q a b c hP hQ hcop hpure
  refine ⟨K₀,hK,normal_coefficient_height P Q K₀ H hcenter hheight,?_⟩
  intro d e u v he hunit hgraph m
  obtain ⟨hm,q,hq0,hq,hu,hv⟩ :=
    actual_signed_level P Q a b c K₀ hc hK hpure hPn hQn d e u v he hunit hgraph
  exact ⟨hm,level_divisor K₀ c m q hq,q,hq0,hq,hu,hv⟩

end A7ActualP4Arithmetic
