        have := add_mem (Ideal.mul_mem_right (X i) _ hp)
          (Ideal.mul_mem_left _ (MvPolynomial.aeval
            (![C (w 0 / w 1) * X 1, X 1] : Fin 2 → MvPolynomial (Fin 2) K) p) hXi)
        convert this using 1; ring
    have hmem := hsub F
    have h2 : MvPolynomial.eval ![w 0 / w 1, 1] F = 0 := by
      have : (![w 0 / w 1, 1] : Fin 2 → K) = (w 1)⁻¹ • w := by
        ext i; fin_cases i <;> simp [div_eq_inv_mul, hw1]
      rw [this, eval_smul_hom hF, h, mul_zero]
    have h3 : MvPolynomial.aeval (![C (w 0 / w 1) * X 1, X 1] : Fin 2 → MvPolynomial (Fin 2) K) F
        = 0 := by
      rw [aeval_subst_hom hF, h2, map_zero, zero_mul]
    rw [h3, sub_zero] at hmem
    exact Ideal.mem_span_singleton.mp hmem

lemma lin_not_isUnit (w : Fin 2 → K) :
    ¬ IsUnit (C (w 1) * X 0 - C (w 0) * X 1 : MvPolynomial (Fin 2) K) := by
  intro hu
  have := hu.map (MvPolynomial.eval w)
  simp only [map_sub, map_mul, eval_C, eval_X] at this
  rw [show w 1 * w 0 - w 0 * w 1 = 0 by ring] at this
  exact not_isUnit_zero this

lemma no_common_zero {A B : MvPolynomial (Fin 2) K} {m n : ℕ} (hA : A.IsHomogeneous m)
    (hB : B.IsHomogeneous n) (hAB : IsRelPrime A B) {w : Fin 2 → K} (hw : w ≠ 0)
    (h1 : MvPolynomial.eval w A = 0) (h2 : MvPolynomial.eval w B = 0) : False :=
  lin_not_isUnit w (hAB (lin_dvd_of_eval_eq_zero hA hw h1) (lin_dvd_of_eval_eq_zero hB hw h2))

end Factor

section PcParamCopy
open MvPolynomial

noncomputable def PP (G : MvPolynomial (Fin 4) ℤ) : MvPolynomial (Fin 2) ℤ :=
  ∑ m ∈ G.support.filter (fun m => m 2 = 1), C (G.coeff m) * X 0 ^ (m 0) * X 1 ^ (m 1)

noncomputable def QQ (G : MvPolynomial (Fin 4) ℤ) : MvPolynomial (Fin 2) ℤ :=
  ∑ m ∈ G.support.filter (fun m => ¬ m 2 = 1), C (G.coeff m) * X 0 ^ (m 0) * X 1 ^ (m 1)

lemma lin_eval₂ {S : Type*} [CommSemiring S] (f : ℤ →+* S) (G : MvPolynomial (Fin 4) ℤ) (a : ℕ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = a ∧ m 2 + m 3 = 1) (g : Fin 4 → S) :
    eval₂ f g G = g 2 * eval₂ f ![g 0, g 1] (PP G) + g 3 * eval₂ f ![g 0, g 1] (QQ G) := by
  rw [eval₂_eq', ← Finset.sum_filter_add_sum_filter_not G.support (fun m => m 2 = 1)]
  unfold PP QQ
  simp only [eval₂_sum, eval₂_mul, eval₂_C, eval₂_pow, eval₂_X, Finset.mul_sum]
  congr 1
  · apply Finset.sum_congr rfl
    intro m hm
    rw [Finset.mem_filter] at hm
    have h3 : m 3 = 0 := by have := (hG m hm.1).2; omega
    rw [Fin.prod_univ_four, hm.2, h3]
    simp only [pow_one, pow_zero, mul_one, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.head_cons]
    ring
  · apply Finset.sum_congr rfl
    intro m hm
    rw [Finset.mem_filter] at hm
    have h2 : m 2 = 0 := by have := (hG m hm.1).2; omega
    have h3 : m 3 = 1 := by have := (hG m hm.1).2; omega
    rw [Fin.prod_univ_four, h2, h3]
    simp only [pow_one, pow_zero, mul_one, one_mul, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.head_cons]
    ring

lemma lin_eval (G : MvPolynomial (Fin 4) ℤ) (a : ℕ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = a ∧ m 2 + m 3 = 1) (p0 p1 p2 p3 : ℤ) :
    eval ![p0, p1, p2, p3] G = p2 * eval ![p0, p1] (PP G) + p3 * eval ![p0, p1] (QQ G) := by
  show eval₂ (RingHom.id ℤ) ![p0, p1, p2, p3] G =
    p2 * eval₂ (RingHom.id ℤ) ![p0, p1] (PP G) + p3 * eval₂ (RingHom.id ℤ) ![p0, p1] (QQ G)
  exact lin_eval₂ (RingHom.id ℤ) G a hG ![p0, p1, p2, p3]

lemma PP_hom (G : MvPolynomial (Fin 4) ℤ) (a : ℕ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = a ∧ m 2 + m 3 = 1) : (PP G).IsHomogeneous a := by
  unfold PP
  apply IsHomogeneous.sum
  intro m hm
  rw [Finset.mem_filter] at hm
  have h := ((isHomogeneous_C (Fin 2) (G.coeff m)).mul
    ((isHomogeneous_X ℤ (0 : Fin 2)).pow (m 0))).mul ((isHomogeneous_X ℤ (1 : Fin 2)).pow (m 1))
  have e : 0 + 1 * m 0 + 1 * m 1 = a := by have := (hG m hm.1).1; omega
  rw [e] at h
  exact h

lemma QQ_hom (G : MvPolynomial (Fin 4) ℤ) (a : ℕ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = a ∧ m 2 + m 3 = 1) : (QQ G).IsHomogeneous a := by
  unfold QQ
  apply IsHomogeneous.sum
  intro m hm
  rw [Finset.mem_filter] at hm
  have h := ((isHomogeneous_C (Fin 2) (G.coeff m)).mul
    ((isHomogeneous_X ℤ (0 : Fin 2)).pow (m 0))).mul ((isHomogeneous_X ℤ (1 : Fin 2)).pow (m 1))
  have e : 0 + 1 * m 0 + 1 * m 1 = a := by have := (hG m hm.1).1; omega
  rw [e] at h
  exact h

lemma sum_card_le_one_bound {T : Finset (Fin 4 →₀ ℕ)} (G : MvPolynomial (Fin 4) ℤ) (B : ℝ)
    (hB0 : 0 ≤ B) (hB : ∀ m, |((G.coeff m : ℤ) : ℝ)| ≤ B) (hT : ∀ m ∈ T, ∀ m' ∈ T, m = m') :
    |(((∑ m ∈ T, G.coeff m : ℤ)) : ℝ)| ≤ B := by
  have hcard : T.card ≤ 1 := Finset.card_le_one.mpr hT
  obtain ⟨m0, hsub⟩ := Finset.card_le_one_iff_subset_singleton.mp hcard
  rcases Finset.subset_singleton_iff.mp hsub with h | h
  · rw [h, Finset.sum_empty]; simpa using hB0
  · rw [h, Finset.sum_singleton]; exact hB m0

lemma fin4_ext {m m' : Fin 4 →₀ ℕ} (h0 : m 0 = m' 0) (h1 : m 1 = m' 1) (h2 : m 2 = m' 2)
    (h3 : m 3 = m' 3) : m = m' := by
  ext i
  rcases i with ⟨_ | _ | _ | _ | k, hk⟩
  · exact h0
  · exact h1
  · exact h2
  · exact h3
  · omega

lemma PP_coeff (G : MvPolynomial (Fin 4) ℤ) (a : ℕ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = a ∧ m 2 + m 3 = 1) (B : ℝ) (hB0 : 0 ≤ B)
    (hB : ∀ m, |((G.coeff m : ℤ) : ℝ)| ≤ B) (n : Fin 2 →₀ ℕ) :
    |(((PP G).coeff n : ℤ) : ℝ)| ≤ B := by
  classical
  have hcoef : (PP G).coeff n = ∑ m ∈ (G.support.filter (fun m => m 2 = 1)).filter
      (fun m : Fin 4 →₀ ℕ => ex (m 0) (m 1) = n), G.coeff m := by
    unfold PP
    rw [coeff_sum, Finset.sum_filter (fun m : Fin 4 →₀ ℕ => ex (m 0) (m 1) = n)]
    apply Finset.sum_congr rfl
    intro m _
    rw [monomial_ex, coeff_monomial]
    all_goals (by_cases hc : ex (m 0) (m 1) = n <;> simp [hc])
  rw [hcoef]
  apply sum_card_le_one_bound G B hB0 hB
  intro m hm m' hm'
  simp only [Finset.mem_filter] at hm hm'
  have e := hm.2.trans hm'.2.symm
  have h0 : m 0 = m' 0 := by
    have := congrArg (fun f => f 0) e; simpa using this
  have h1 : m 1 = m' 1 := by
    have := congrArg (fun f => f 1) e; simpa using this
  have g1 := (hG m hm.1.1).2
  have g2 := (hG m' hm'.1.1).2
  have i2 := hm.1.2
  have i2' := hm'.1.2
  exact fin4_ext h0 h1 (by omega) (by omega)

lemma QQ_coeff (G : MvPolynomial (Fin 4) ℤ) (a : ℕ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = a ∧ m 2 + m 3 = 1) (B : ℝ) (hB0 : 0 ≤ B)
    (hB : ∀ m, |((G.coeff m : ℤ) : ℝ)| ≤ B) (n : Fin 2 →₀ ℕ) :
    |(((QQ G).coeff n : ℤ) : ℝ)| ≤ B := by
  classical
  have hcoef : (QQ G).coeff n = ∑ m ∈ (G.support.filter (fun m => ¬ m 2 = 1)).filter
      (fun m : Fin 4 →₀ ℕ => ex (m 0) (m 1) = n), G.coeff m := by
    unfold QQ
    rw [coeff_sum, Finset.sum_filter (fun m : Fin 4 →₀ ℕ => ex (m 0) (m 1) = n)]
    apply Finset.sum_congr rfl
    intro m _
    rw [monomial_ex, coeff_monomial]
    all_goals (by_cases hc : ex (m 0) (m 1) = n <;> simp [hc])
  rw [hcoef]
  apply sum_card_le_one_bound G B hB0 hB
  intro m hm m' hm'
  simp only [Finset.mem_filter] at hm hm'
  have e := hm.2.trans hm'.2.symm
  have h0 : m 0 = m' 0 := by
    have := congrArg (fun f => f 0) e; simpa using this
  have h1 : m 1 = m' 1 := by
    have := congrArg (fun f => f 1) e; simpa using this
  have g1 := (hG m hm.1.1).2
  have g2 := (hG m' hm'.1.1).2
  have i2 := hm.1.2
  have i2' := hm'.1.2
  exact fin4_ext h0 h1 (by omega) (by omega)

lemma relprime_core (G : MvPolynomial (Fin 4) ℤ) (a : ℕ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = a ∧ m 2 + m 3 = 1)
    (hirr : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G)) :
    IsRelPrime (MvPolynomial.map (Int.castRingHom ℂ) (PP G))
      (MvPolynomial.map (Int.castRingHom ℂ) (QQ G)) := by
  haveI : Infinite ℂ := Infinite.of_injective (Nat.cast : ℕ → ℂ) Nat.cast_injective
  have hGc : MvPolynomial.map (Int.castRingHom ℂ) G =
      X 2 * rename ![(0 : Fin 4), 1] (MvPolynomial.map (Int.castRingHom ℂ) (PP G)) +
      X 3 * rename ![(0 : Fin 4), 1] (MvPolynomial.map (Int.castRingHom ℂ) (QQ G)) := by
    apply MvPolynomial.funext
    intro x
    simp only [eval_map, map_add, map_mul, eval_X, eval_rename]
    rw [lin_eval₂ (Int.castRingHom ℂ) G a hG x]
    have hx : x ∘ ![(0 : Fin 4), 1] = ![x 0, x 1] := by
      funext i; fin_cases i <;> rfl
    rw [hx]
  intro D hDP hDQ
  obtain ⟨P', hP'⟩ := hDP
  obtain ⟨Q', hQ'⟩ := hDQ
  have hfac : MvPolynomial.map (Int.castRingHom ℂ) G = rename ![(0 : Fin 4), 1] D *
      (X 2 * rename ![(0 : Fin 4), 1] P' + X 3 * rename ![(0 : Fin 4), 1] Q') := by
    rw [hGc, hP', hQ', map_mul, map_mul]; ring
  rcases hirr.isUnit_or_isUnit hfac with hu | hu
  · have h2 : rename ![(0 : Fin 2), 1, 0, 0] (rename ![(0 : Fin 4), 1] D) = D := by
      rw [rename_rename]
      have hρι : (![(0 : Fin 2), 1, 0, 0] : Fin 4 → Fin 2) ∘ ![(0 : Fin 4), 1] = id := by
        funext i; fin_cases i <;> rfl
      rw [hρι]
      simp
    have := hu.map (rename ![(0 : Fin 2), 1, 0, 0])
    rwa [h2] at this
  · exfalso
    have h0 := (hu.map (MvPolynomial.eval (0 : Fin 4 → ℂ))).ne_zero
    apply h0
    simp

end PcParamCopy

section F10BNew
open MvPolynomial

def idxL (i j k l : ℕ) : Fin 4 →₀ ℕ :=
  Finsupp.single (0 : Fin 4) i + Finsupp.single (1 : Fin 4) j + Finsupp.single (2 : Fin 4) k +
    Finsupp.single (3 : Fin 4) l

def Podd (α : ℕ) (G : MvPolynomial (Fin 4) ℤ) : MvPolynomial (Fin 2) ℚ :=
  ∑ i : Fin (α + 1), MvPolynomial.C (((G.coeff (idxL (i : ℕ) (α - (i : ℕ)) 1 0)) : ℤ) : ℚ) *
    MvPolynomial.X (0 : Fin 2) ^ (i : ℕ) * MvPolynomial.X (1 : Fin 2) ^ (α - (i : ℕ))

def Qodd (α : ℕ) (G : MvPolynomial (Fin 4) ℤ) : MvPolynomial (Fin 2) ℚ :=
  - (∑ i : Fin (α + 1), MvPolynomial.C (((G.coeff (idxL (i : ℕ) (α - (i : ℕ)) 0 1)) : ℤ) : ℚ) *
    MvPolynomial.X (0 : Fin 2) ^ (i : ℕ) * MvPolynomial.X (1 : Fin 2) ^ (α - (i : ℕ)))

def Rodd (α : ℕ) (G : MvPolynomial (Fin 4) ℤ) : MvPolynomial (Fin 2) ℚ :=
  MvPolynomial.X (1 : Fin 2) ^ 4 * Podd α G - MvPolynomial.X (0 : Fin 2) ^ 4 * Qodd α G

def Peven (α : ℕ) (G : MvPolynomial (Fin 4) ℤ) : MvPolynomial (Fin 2) ℤ :=
  ∑ i ∈ Finset.range (α + 1), MvPolynomial.C (G.coeff (Finsupp.single (0 : Fin 4) i +
    Finsupp.single (1 : Fin 4) (α - i) + Finsupp.single (2 : Fin 4) 1)) *
    MvPolynomial.X (0 : Fin 2) ^ i * MvPolynomial.X (1 : Fin 2) ^ (α - i)

def Qeven (α : ℕ) (G : MvPolynomial (Fin 4) ℤ) : MvPolynomial (Fin 2) ℤ :=
  ∑ i ∈ Finset.range (α + 1), MvPolynomial.C (-G.coeff (Finsupp.single (0 : Fin 4) i +
    Finsupp.single (1 : Fin 4) (α - i) + Finsupp.single (3 : Fin 4) 1)) *
    MvPolynomial.X (0 : Fin 2) ^ i * MvPolynomial.X (1 : Fin 2) ^ (α - i)

def Reven (α : ℕ) (G : MvPolynomial (Fin 4) ℤ) : MvPolynomial (Fin 2) ℤ :=
  MvPolynomial.X (1 : Fin 2) ^ 4 * Peven α G - MvPolynomial.X (0 : Fin 2) ^ 4 * Qeven α G

def blockP (G : MvPolynomial (Fin 4) ℤ) : MvPolynomial (Fin 2) ℚ :=
  Finset.sum (Finset.range 4) (fun i => MvPolynomial.monomial (Finsupp.single (0 : Fin 2) i +
    Finsupp.single 1 (3 - i)) ((G.coeff (Finsupp.single (0 : Fin 4) i + Finsupp.single 1 (3 - i) +
    Finsupp.single 2 1) : ℤ) : ℚ))

def blockQ (G : MvPolynomial (Fin 4) ℤ) : MvPolynomial (Fin 2) ℚ :=
  -(Finset.sum (Finset.range 4) (fun i => MvPolynomial.monomial (Finsupp.single (0 : Fin 2) i +
    Finsupp.single 1 (3 - i)) ((G.coeff (Finsupp.single (0 : Fin 4) i + Finsupp.single 1 (3 - i) +
    Finsupp.single 3 1) : ℤ) : ℚ)))

def Rz (G : MvPolynomial (Fin 4) ℤ) : MvPolynomial (Fin 2) ℤ :=
  MvPolynomial.X (1 : Fin 2) ^ 4 * PP G + MvPolynomial.X (0 : Fin 2) ^ 4 * QQ G

theorem b_ms2_val (k l : ℕ) :
    (Finsupp.single (0 : Fin 4) k + Finsupp.single (1 : Fin 4) l + Finsupp.single (2 : Fin 4) 1 : Fin 4 →₀ ℕ) 0 = k ∧
    (Finsupp.single (0 : Fin 4) k + Finsupp.single (1 : Fin 4) l + Finsupp.single (2 : Fin 4) 1 : Fin 4 →₀ ℕ) 1 = l ∧
    (Finsupp.single (0 : Fin 4) k + Finsupp.single (1 : Fin 4) l + Finsupp.single (2 : Fin 4) 1 : Fin 4 →₀ ℕ) 2 = 1 ∧
    (Finsupp.single (0 : Fin 4) k + Finsupp.single (1 : Fin 4) l + Finsupp.single (2 : Fin 4) 1 : Fin 4 →₀ ℕ) 3 = 0 := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;>
    first
    | simp [Finsupp.single_apply]
    | simp [Finsupp.single_apply, Fin.ext_iff]

theorem b_ms3_val (k l : ℕ) :
    (Finsupp.single (0 : Fin 4) k + Finsupp.single (1 : Fin 4) l + Finsupp.single (3 : Fin 4) 1 : Fin 4 →₀ ℕ) 0 = k ∧
    (Finsupp.single (0 : Fin 4) k + Finsupp.single (1 : Fin 4) l + Finsupp.single (3 : Fin 4) 1 : Fin 4 →₀ ℕ) 1 = l ∧
    (Finsupp.single (0 : Fin 4) k + Finsupp.single (1 : Fin 4) l + Finsupp.single (3 : Fin 4) 1 : Fin 4 →₀ ℕ) 2 = 0 ∧
    (Finsupp.single (0 : Fin 4) k + Finsupp.single (1 : Fin 4) l + Finsupp.single (3 : Fin 4) 1 : Fin 4 →₀ ℕ) 3 = 1 := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;>
    first
    | simp [Finsupp.single_apply]
    | simp [Finsupp.single_apply, Fin.ext_iff]

theorem b_PP_coeff_eq (G : MvPolynomial (Fin 4) ℤ) (α : ℕ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = α ∧ m 2 + m 3 = 1) (k l : ℕ) :
    (PP G).coeff (ex k l) =
      G.coeff (Finsupp.single (0 : Fin 4) k + Finsupp.single (1 : Fin 4) l +
        Finsupp.single (2 : Fin 4) 1) := by
  classical
  obtain ⟨v0, v1, v2, v3⟩ := b_ms2_val k l
  have key : ∀ m ∈ G.support.filter (fun m => m 2 = 1),
      MvPolynomial.coeff (ex k l) (MvPolynomial.C (G.coeff m) * MvPolynomial.X 0 ^ (m 0) *
        MvPolynomial.X 1 ^ (m 1) : MvPolynomial (Fin 2) ℤ) =
      if m = Finsupp.single (0 : Fin 4) k + Finsupp.single (1 : Fin 4) l +
          Finsupp.single (2 : Fin 4) 1 then G.coeff m else 0 := by
    intro m hm
    rw [Finset.mem_filter] at hm
    have h3 : m 3 = 0 := by have := (hG m hm.1).2; omega
    rw [monomial_ex, MvPolynomial.coeff_monomial]
    by_cases h : m = Finsupp.single (0 : Fin 4) k + Finsupp.single (1 : Fin 4) l +
        Finsupp.single (2 : Fin 4) 1
    · have e0 : m 0 = k := by rw [h]; exact v0
      have e1 : m 1 = l := by rw [h]; exact v1
      rw [if_pos h, e0, e1, if_pos rfl]
    · rw [if_neg h, if_neg]
      intro hex
      apply h
      rw [ex_eq_iff] at hex
      simp only [ex_zero, ex_one] at hex
      exact fin4_ext (by rw [v0]; omega) (by rw [v1]; omega) (by rw [v2]; exact hm.2)
        (by rw [v3]; exact h3)
  unfold PP
  rw [MvPolynomial.coeff_sum, Finset.sum_congr rfl key]
  first
  | rw [Finset.sum_ite_eq']
  | rw [Finset.sum_ite_eq]
  split_ifs with hin
  · rfl
  · symm
    by_contra hne
    apply hin
    rw [Finset.mem_filter]
    exact ⟨MvPolynomial.mem_support_iff.mpr hne, v2⟩

theorem b_QQ_coeff_eq (G : MvPolynomial (Fin 4) ℤ) (α : ℕ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = α ∧ m 2 + m 3 = 1) (k l : ℕ) :
    (QQ G).coeff (ex k l) =
      G.coeff (Finsupp.single (0 : Fin 4) k + Finsupp.single (1 : Fin 4) l +
        Finsupp.single (3 : Fin 4) 1) := by
  classical
  obtain ⟨v0, v1, v2, v3⟩ := b_ms3_val k l
  have key : ∀ m ∈ G.support.filter (fun m => ¬ m 2 = 1),
      MvPolynomial.coeff (ex k l) (MvPolynomial.C (G.coeff m) * MvPolynomial.X 0 ^ (m 0) *
        MvPolynomial.X 1 ^ (m 1) : MvPolynomial (Fin 2) ℤ) =
      if m = Finsupp.single (0 : Fin 4) k + Finsupp.single (1 : Fin 4) l +
          Finsupp.single (3 : Fin 4) 1 then G.coeff m else 0 := by
    intro m hm
    rw [Finset.mem_filter] at hm
    have h2 : m 2 = 0 := by have := (hG m hm.1).2; omega
    have h3 : m 3 = 1 := by have := (hG m hm.1).2; omega
    rw [monomial_ex, MvPolynomial.coeff_monomial]
    by_cases h : m = Finsupp.single (0 : Fin 4) k + Finsupp.single (1 : Fin 4) l +
        Finsupp.single (3 : Fin 4) 1
    · have e0 : m 0 = k := by rw [h]; exact v0
      have e1 : m 1 = l := by rw [h]; exact v1
      rw [if_pos h, e0, e1, if_pos rfl]
    · rw [if_neg h, if_neg]
      intro hex
      apply h
      rw [ex_eq_iff] at hex
      simp only [ex_zero, ex_one] at hex
      exact fin4_ext (by rw [v0]; omega) (by rw [v1]; omega) (by rw [v2]; exact h2)
        (by rw [v3]; exact h3)
  unfold QQ
  rw [MvPolynomial.coeff_sum, Finset.sum_congr rfl key]
  first
  | rw [Finset.sum_ite_eq']
  | rw [Finset.sum_ite_eq]
  split_ifs with hin
  · rfl
  · symm
    by_contra hne
    apply hin
    rw [Finset.mem_filter]
    refine ⟨MvPolynomial.mem_support_iff.mpr hne, ?_⟩
    intro h
    have h' := v2.symm.trans h
    omega

theorem b_PP_eq_range (G : MvPolynomial (Fin 4) ℤ) (α : ℕ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = α ∧ m 2 + m 3 = 1) :
    PP G = ∑ i ∈ Finset.range (α + 1), MvPolynomial.C (G.coeff (Finsupp.single (0 : Fin 4) i +
      Finsupp.single (1 : Fin 4) (α - i) + Finsupp.single (2 : Fin 4) 1)) *
      MvPolynomial.X (0 : Fin 2) ^ i * MvPolynomial.X (1 : Fin 2) ^ (α - i) := by
  conv_lhs => rw [hom_repr (PP_hom G α hG)]
  apply Finset.sum_congr rfl
  intro k _
  rw [b_PP_coeff_eq G α hG k (α - k)]

theorem b_QQ_eq_range (G : MvPolynomial (Fin 4) ℤ) (α : ℕ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = α ∧ m 2 + m 3 = 1) :
    QQ G = ∑ i ∈ Finset.range (α + 1), MvPolynomial.C (G.coeff (Finsupp.single (0 : Fin 4) i +
      Finsupp.single (1 : Fin 4) (α - i) + Finsupp.single (3 : Fin 4) 1)) *
      MvPolynomial.X (0 : Fin 2) ^ i * MvPolynomial.X (1 : Fin 2) ^ (α - i) := by
  conv_lhs => rw [hom_repr (QQ_hom G α hG)]
  apply Finset.sum_congr rfl
  intro k _
  rw [b_QQ_coeff_eq G α hG k (α - k)]

theorem b_Peven_eq (G : MvPolynomial (Fin 4) ℤ) (α : ℕ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = α ∧ m 2 + m 3 = 1) : Peven α G = PP G := by
  rw [b_PP_eq_range G α hG]
  rfl

theorem b_Qeven_eq (G : MvPolynomial (Fin 4) ℤ) (α : ℕ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = α ∧ m 2 + m 3 = 1) : Qeven α G = -(QQ G) := by
  rw [b_QQ_eq_range G α hG, ← Finset.sum_neg_distrib]
  unfold Qeven
  apply Finset.sum_congr rfl
  intro i _
  rw [map_neg, neg_mul, neg_mul]

theorem b_Reven_eq (G : MvPolynomial (Fin 4) ℤ) (α : ℕ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = α ∧ m 2 + m 3 = 1) : Reven α G = Rz G := by
  unfold Reven Rz
  rw [b_Peven_eq G α hG, b_Qeven_eq G α hG]
  ring

theorem b_Podd_eq (G : MvPolynomial (Fin 4) ℤ) (α : ℕ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = α ∧ m 2 + m 3 = 1) :
    Podd α G = MvPolynomial.map (Int.castRingHom ℚ) (PP G) := by
  rw [b_PP_eq_range G α hG, map_sum]
  unfold Podd
  refine (Fin.sum_univ_eq_sum_range (fun i => MvPolynomial.C (((G.coeff (idxL i (α - i) 1 0)) : ℤ) : ℚ) *
    MvPolynomial.X (0 : Fin 2) ^ i * MvPolynomial.X (1 : Fin 2) ^ (α - i)) (α + 1)).trans ?_
  apply Finset.sum_congr rfl
  intro i _
  simp [idxL]

theorem b_Qodd_eq (G : MvPolynomial (Fin 4) ℤ) (α : ℕ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = α ∧ m 2 + m 3 = 1) :
    Qodd α G = -(MvPolynomial.map (Int.castRingHom ℚ) (QQ G)) := by
  rw [b_QQ_eq_range G α hG, map_sum]
  unfold Qodd
  congr 1
  refine (Fin.sum_univ_eq_sum_range (fun i => MvPolynomial.C (((G.coeff (idxL i (α - i) 0 1)) : ℤ) : ℚ) *
    MvPolynomial.X (0 : Fin 2) ^ i * MvPolynomial.X (1 : Fin 2) ^ (α - i)) (α + 1)).trans ?_
  apply Finset.sum_congr rfl
  intro i _
  simp [idxL]

theorem b_Rodd_eq (G : MvPolynomial (Fin 4) ℤ) (α : ℕ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = α ∧ m 2 + m 3 = 1) :
    Rodd α G = MvPolynomial.map (Int.castRingHom ℚ) (Rz G) := by
  unfold Rodd Rz
  rw [b_Podd_eq G α hG, b_Qodd_eq G α hG]
  simp only [map_add, map_mul, map_pow, MvPolynomial.map_X]
  ring

theorem b_blockP_eq (G : MvPolynomial (Fin 4) ℤ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = 3 ∧ m 2 + m 3 = 1) :
    blockP G = MvPolynomial.map (Int.castRingHom ℚ) (PP G) := by
  rw [b_PP_eq_range G 3 hG, map_sum]
  unfold blockP
  apply Finset.sum_congr rfl
  intro i _
  have h1 := monomial_ex (((G.coeff (Finsupp.single (0 : Fin 4) i + Finsupp.single 1 (3 - i) +
    Finsupp.single 2 1) : ℤ) : ℚ)) i (3 - i)
  refine h1.symm.trans ?_
  simp

theorem b_blockQ_eq (G : MvPolynomial (Fin 4) ℤ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = 3 ∧ m 2 + m 3 = 1) :
    blockQ G = -(MvPolynomial.map (Int.castRingHom ℚ) (QQ G)) := by
  rw [b_QQ_eq_range G 3 hG, map_sum]
  unfold blockQ
  congr 1
  apply Finset.sum_congr rfl
  intro i _
  have h1 := monomial_ex (((G.coeff (Finsupp.single (0 : Fin 4) i + Finsupp.single 1 (3 - i) +
    Finsupp.single 3 1) : ℤ) : ℚ)) i (3 - i)
  refine h1.symm.trans ?_
  simp

theorem b_Rz_eval (G : MvPolynomial (Fin 4) ℤ) (d e : ℤ) :
    MvPolynomial.eval ![d, e] (Rz G) =
      e ^ 4 * MvPolynomial.eval ![d, e] (PP G) + d ^ 4 * MvPolynomial.eval ![d, e] (QQ G) := by
  unfold Rz
  simp only [map_add, map_mul, map_pow, MvPolynomial.eval_X, Matrix.cons_val_zero,
    Matrix.cons_val_one, Matrix.head_cons]

theorem b_eval_mapN (A : MvPolynomial (Fin 2) ℤ) (a b : ℕ) :
    MvPolynomial.eval ![(a : ℚ), (b : ℚ)] (MvPolynomial.map (Int.castRingHom ℚ) A) =
      ((MvPolynomial.eval ![(a : ℤ), (b : ℤ)] A : ℤ) : ℚ) := by
  rw [MvPolynomial.eval_map]
  induction A using MvPolynomial.induction_on
  next c =>
    rw [MvPolynomial.eval₂_C, MvPolynomial.eval_C]
    first | rfl | simp
  next p q hp hq => rw [MvPolynomial.eval₂_add, map_add, Int.cast_add, hp, hq]
  next p i hp =>
    rw [MvPolynomial.eval₂_mul, map_mul, Int.cast_mul, hp, MvPolynomial.eval₂_X,
      MvPolynomial.eval_X]
    fin_cases i <;> simp

theorem b_isUnit_of_map (D : MvPolynomial (Fin 2) ℚ)
    (h : IsUnit (MvPolynomial.map (algebraMap ℚ ℂ) D)) : IsUnit D := by
  obtain ⟨r, hr, hD⟩ := MvPolynomial.isUnit_iff_eq_C_of_isReduced.mp h
  have hcoef : ∀ m : Fin 2 →₀ ℕ, m ≠ 0 → D.coeff m = 0 := by
    intro m hm
    have h1 := congrArg (MvPolynomial.coeff m) hD
    rw [MvPolynomial.coeff_map, MvPolynomial.coeff_C, if_neg (Ne.symm hm)] at h1
    exact (algebraMap ℚ ℂ).injective (by rw [h1, map_zero])
  have hD' : D = MvPolynomial.C (D.coeff 0) := by
    ext m
    rw [MvPolynomial.coeff_C]
    split_ifs with hm
    · rw [hm]
    · exact hcoef m (Ne.symm hm)
  have h0 : D.coeff 0 ≠ 0 := by
    intro h0
    have h1 := congrArg (MvPolynomial.coeff 0) hD
    rw [MvPolynomial.coeff_map, MvPolynomial.coeff_C, if_pos rfl, h0, map_zero] at h1
    exact hr.ne_zero h1.symm
  rw [hD']
  exact (isUnit_iff_ne_zero.mpr h0).map MvPolynomial.C

theorem b_relprime_rat (G : MvPolynomial (Fin 4) ℤ) (α : ℕ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = α ∧ m 2 + m 3 = 1)
    (hirr : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G)) :
    IsRelPrime (MvPolynomial.map (Int.castRingHom ℚ) (PP G))
      (MvPolynomial.map (Int.castRingHom ℚ) (QQ G)) := by
  intro D hDP hDQ
  apply b_isUnit_of_map
  have e : ∀ F : MvPolynomial (Fin 2) ℤ, MvPolynomial.map (algebraMap ℚ ℂ)
      (MvPolynomial.map (Int.castRingHom ℚ) F) = MvPolynomial.map (Int.castRingHom ℂ) F := by
    intro F
    rw [MvPolynomial.map_map]
    congr 1
    try exact RingHom.ext_int _ _
  have hc := relprime_core G α hG hirr
  have h1 : MvPolynomial.map (algebraMap ℚ ℂ) D ∣ MvPolynomial.map (Int.castRingHom ℂ) (PP G) := by
    rw [← e]
    exact map_dvd (MvPolynomial.map (algebraMap ℚ ℂ)) hDP
  have h2 : MvPolynomial.map (algebraMap ℚ ℂ) D ∣ MvPolynomial.map (Int.castRingHom ℂ) (QQ G) := by
    rw [← e]
    exact map_dvd (MvPolynomial.map (algebraMap ℚ ℂ)) hDQ
  exact hc h1 h2

theorem b_no_point_R0 (G : MvPolynomial (Fin 4) ℤ) (α : ℕ)
    (hG : ∀ m ∈ G.support, m 0 + m 1 = α ∧ m 2 + m 3 = 1)
    (hrel : IsRelPrime (MvPolynomial.map (Int.castRingHom ℚ) (PP G))
      (MvPolynomial.map (Int.castRingHom ℚ) (QQ G)))
    (hR : Rz G = 0) (d e u v : ℕ) (hd : 1 ≤ d)
    (hrelN : e ^ 4 * v = d ^ 4 * u + 1)
    (hev : MvPolynomial.eval ![(d : ℤ), (e : ℤ), (u : ℤ), (v : ℤ)] G = 0) : False := by
  have hdec := lin_eval G α hG (d : ℤ) (e : ℤ) (u : ℤ) (v : ℤ)
  rw [hev] at hdec
  have hRe := b_Rz_eval G (d : ℤ) (e : ℤ)
  rw [hR, map_zero] at hRe
  have hZ : ((e : ℤ) ^ 4 * v) = (d : ℤ) ^ 4 * u + 1 := by exact_mod_cast hrelN
  have hp : MvPolynomial.eval ![(d : ℤ), (e : ℤ)] (PP G) = 0 := by
    linear_combination (d : ℤ) ^ 4 * hdec - (v : ℤ) * hRe -
      (MvPolynomial.eval ![(d : ℤ), (e : ℤ)] (PP G)) * hZ
  have hq : MvPolynomial.eval ![(d : ℤ), (e : ℤ)] (QQ G) = 0 := by
    linear_combination -(e : ℤ) ^ 4 * hdec + (u : ℤ) * hRe -
      (MvPolynomial.eval ![(d : ℤ), (e : ℤ)] (QQ G)) * hZ
  have hpQ : MvPolynomial.eval ![(d : ℚ), (e : ℚ)]
      (MvPolynomial.map (Int.castRingHom ℚ) (PP G)) = 0 := by
    rw [b_eval_mapN, hp, Int.cast_zero]
  have hqQ : MvPolynomial.eval ![(d : ℚ), (e : ℚ)]
      (MvPolynomial.map (Int.castRingHom ℚ) (QQ G)) = 0 := by
    rw [b_eval_mapN, hq, Int.cast_zero]
  have hw : (![(d : ℚ), (e : ℚ)] : Fin 2 → ℚ) ≠ 0 := by
    intro h
    have h0 := congrFun h 0
    simp at h0
    omega
  exact no_common_zero ((PP_hom G α hG).map _) ((QQ_hom G α hG).map _) hrel hw hpQ hqQ

theorem b_eval_zero_one {R : Type*} [CommSemiring R] {F : MvPolynomial (Fin 2) R} {n : ℕ}
    (hF : F.IsHomogeneous n) : MvPolynomial.eval ![0, 1] F = F.coeff (ex 0 n) := by
  rw [eval_eq_sum hF, Finset.sum_eq_single 0]
  · simp
  · intro k _ hk
    simp [zero_pow hk]
  · intro h
    simp at h

theorem b_pure_small_false (A B : MvPolynomial (Fin 2) ℚ) (α : ℕ) (hα1 : 1 ≤ α) (hα2 : α ≤ 2)
    (hA : A.IsHomogeneous α) (hB : B.IsHomogeneous α) (hAB : IsRelPrime A B)
    (κ a b : ℚ) (hκ : κ ≠ 0) (hab : a ≠ 0 ∨ b ≠ 0)
    (hR : MvPolynomial.X (1 : Fin 2) ^ 4 * A + MvPolynomial.X (0 : Fin 2) ^ 4 * B =
      MvPolynomial.C κ * (MvPolynomial.C a * MvPolynomial.X (0 : Fin 2) +
        MvPolynomial.C b * MvPolynomial.X (1 : Fin 2)) ^ (α + 4)) : False := by
  have hD : dehom A + Polynomial.X ^ 4 * dehom B =
      Polynomial.C κ * (Polynomial.C a * Polynomial.X + Polynomial.C b) ^ (α + 4) := by
    have h := congrArg dehom hR
    simpa [dehom, map_add, map_mul, map_pow, MvPolynomial.aeval_X, MvPolynomial.aeval_C,
      Polynomial.algebraMap_eq] using h
  have hdA : (dehom A).natDegree ≤ α := dehom_natDegree_le hA
  have hdB : (dehom B).natDegree ≤ α := dehom_natDegree_le hB
  have hab0 : a = 0 ∨ b = 0 := by
    by_cases ha : a = 0
    · exact Or.inl ha
    · right
      have h3 : (dehom A + Polynomial.X ^ 4 * dehom B).coeff 3 =
          (Polynomial.C κ * (Polynomial.C a * Polynomial.X + Polynomial.C b) ^ (α + 4)).coeff 3 := by
        rw [hD]
      have hA3 : (dehom A).coeff 3 = 0 := Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)
      have hL3 : (dehom A + Polynomial.X ^ 4 * dehom B).coeff 3 = 0 := by
        rw [Polynomial.coeff_add, hA3, Polynomial.coeff_X_pow_mul']
        simp
      have hfac : (Polynomial.C a * Polynomial.X + Polynomial.C b : Polynomial ℚ) =
          Polynomial.C a * (Polynomial.X + Polynomial.C (b / a)) := by
        rw [mul_add, ← Polynomial.C_mul, mul_div_cancel₀ b ha]
      have hR3 : (Polynomial.C κ * (Polynomial.C a * Polynomial.X + Polynomial.C b) ^ (α + 4)).coeff 3 =
          κ * a ^ (α + 4) * ((b / a) ^ (α + 4 - 3) * ((α + 4).choose 3 : ℚ)) := by
        rw [hfac, mul_pow, ← Polynomial.C_pow, ← mul_assoc, ← Polynomial.C_mul,
          Polynomial.coeff_C_mul, Polynomial.coeff_X_add_C_pow]
      rw [hL3, hR3] at h3
      have hch : ((α + 4).choose 3 : ℚ) ≠ 0 := by
        have : 0 < (α + 4).choose 3 := Nat.choose_pos (by omega)
        exact_mod_cast this.ne'
      have hka : κ * a ^ (α + 4) ≠ 0 := mul_ne_zero hκ (pow_ne_zero _ ha)
      have h4 : (b / a) ^ (α + 4 - 3) * ((α + 4).choose 3 : ℚ) = 0 :=
        (mul_eq_zero.mp h3.symm).resolve_left hka
      have h5 : (b / a) ^ (α + 4 - 3) = 0 := (mul_eq_zero.mp h4).resolve_right hch
      have h6 : b / a = 0 := pow_eq_zero_iff (by omega) |>.mp h5
      rcases div_eq_zero_iff.mp h6 with hb | hb
      · exact hb
      · exact absurd hb ha
  rcases hab0 with ha0 | hb0
  · have hB10 : MvPolynomial.eval ![(1 : ℚ), 0] B = 0 := by
      have h10 := congrArg (MvPolynomial.eval ![(1 : ℚ), 0]) hR
      simp only [map_add, map_mul, map_pow, MvPolynomial.eval_X, MvPolynomial.eval_C,
        Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons] at h10
      rw [ha0] at h10
      simpa using h10
    have hcA : (dehom A + Polynomial.X ^ 4 * dehom B).coeff α =
        (Polynomial.C κ * (Polynomial.C a * Polynomial.X + Polynomial.C b) ^ (α + 4)).coeff α := by
      rw [hD]
    rw [ha0, Polynomial.C_0, zero_mul, zero_add, ← Polynomial.C_pow, ← Polynomial.C_mul,
      Polynomial.coeff_C, if_neg (show ¬ (α = 0) by omega), Polynomial.coeff_add,
      Polynomial.coeff_X_pow_mul', if_neg (show ¬ (4 ≤ α) by omega), add_zero,
      dehom_coeff hA, if_pos le_rfl, Nat.sub_self] at hcA
    have hA10 : MvPolynomial.eval ![(1 : ℚ), 0] A = 0 := by
      rw [eval_one_zero hA]
      exact hcA
    have hw : (![(1 : ℚ), 0] : Fin 2 → ℚ) ≠ 0 := by
      intro h
      have h0 := congrFun h 0
      simp at h0
    exact no_common_zero hA hB hAB hw hA10 hB10
  · have hA01 : MvPolynomial.eval ![(0 : ℚ), 1] A = 0 := by
      have h01 := congrArg (MvPolynomial.eval ![(0 : ℚ), 1]) hR
      simp only [map_add, map_mul, map_pow, MvPolynomial.eval_X, MvPolynomial.eval_C,
        Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons] at h01
      rw [hb0] at h01
      simpa using h01
    have hc4 : (dehom A + Polynomial.X ^ 4 * dehom B).coeff 4 =
        (Polynomial.C κ * (Polynomial.C a * Polynomial.X + Polynomial.C b) ^ (α + 4)).coeff 4 := by
      rw [hD]
    have hA4 : (dehom A).coeff 4 = 0 := Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)
    rw [hb0, Polynomial.C_0, add_zero, mul_pow, ← Polynomial.C_pow, ← mul_assoc,
      ← Polynomial.C_mul, Polynomial.coeff_C_mul_X_pow, if_neg (show ¬ ((4 : ℕ) = α + 4) by omega),
      Polynomial.coeff_add, hA4, zero_add, Polynomial.coeff_X_pow_mul',
      if_pos (show (4 : ℕ) ≤ 4 by norm_num), Nat.sub_self] at hc4
    have hB01 : MvPolynomial.eval ![(0 : ℚ), 1] B = 0 := by
      rw [← dehom_eval hB, ← Polynomial.coeff_zero_eq_eval_zero]
      first
      | exact hc4
      | exact hc4.symm
    have hw : (![(0 : ℚ), 1] : Fin 2 → ℚ) ≠ 0 := by
      intro h
      have h0 := congrFun h 1
      simp at h0
    exact no_common_zero hA hB hAB hw hA01 hB01

theorem b_int_pure (R : MvPolynomial (Fin 2) ℤ) (n : ℕ) (κ a b : ℚ) (hκ : κ ≠ 0)
    (hab : a ≠ 0 ∨ b ≠ 0)
    (hR : MvPolynomial.map (Int.castRingHom ℚ) R = MvPolynomial.C κ *
      (MvPolynomial.C a * MvPolynomial.X 0 + MvPolynomial.C b * MvPolynomial.X 1) ^ n) :
    ∃ a' b' c' : ℤ, Int.gcd a' b' = 1 ∧ c' ≠ 0 ∧
      R = MvPolynomial.C c' * (MvPolynomial.C a' * MvPolynomial.X 0 +
        MvPolynomial.C b' * MvPolynomial.X 1) ^ n := by
  have hq : ∀ q : ℚ, (q.num : ℚ) = q * q.den := by
    intro q
    first
    | exact (Rat.mul_den_eq_num q).symm
    | exact (Rat.mul_den_eq_num (q := q)).symm
    | (have h := Rat.num_div_den q
       have hd : (q.den : ℚ) ≠ 0 := by positivity
       field_simp at h
       linarith)
  have haden : (0 : ℚ) < (a.den : ℚ) := by positivity
  have hbden : (0 : ℚ) < (b.den : ℚ) := by positivity
  have hden0 : (0 : ℚ) < (a.den : ℚ) * (b.den : ℚ) := mul_pos haden hbden
  obtain ⟨a1, ha1⟩ : ∃ a1 : ℤ, a1 = a.num * b.den := ⟨_, rfl⟩
  obtain ⟨b1, hb1⟩ : ∃ b1 : ℤ, b1 = b.num * a.den := ⟨_, rfl⟩
  have ha1q : (a1 : ℚ) = a * ((a.den : ℚ) * (b.den : ℚ)) := by
    rw [ha1]
    push_cast
    rw [hq a]
    ring
  have hb1q : (b1 : ℚ) = b * ((a.den : ℚ) * (b.den : ℚ)) := by
    rw [hb1]
    push_cast
    rw [hq b]
    ring
  have hab1 : a1 ≠ 0 ∨ b1 ≠ 0 := by
    rcases hab with h | h
    · left
      intro h0
      have h2 : (a1 : ℚ) = 0 := by rw [h0]; simp
      rw [ha1q] at h2
      exact h ((mul_eq_zero.mp h2).resolve_right hden0.ne')
    · right
      intro h0
      have h2 : (b1 : ℚ) = 0 := by rw [h0]; simp
      rw [hb1q] at h2
      exact h ((mul_eq_zero.mp h2).resolve_right hden0.ne')
  have hg : 0 < Int.gcd a1 b1 := Int.gcd_pos_iff.mpr hab1
  obtain ⟨a', ha'⟩ : ∃ a' : ℤ, a' = a1 / (Int.gcd a1 b1 : ℤ) := ⟨_, rfl⟩
  obtain ⟨b', hb'⟩ : ∃ b' : ℤ, b' = b1 / (Int.gcd a1 b1 : ℤ) := ⟨_, rfl⟩
  have hcop : Int.gcd a' b' = 1 := by
    rw [ha', hb']
    exact Int.gcd_div_gcd_div_gcd hg
  have ha1g : a' * (Int.gcd a1 b1 : ℤ) = a1 := by
    rw [ha']
    exact Int.ediv_mul_cancel (Int.gcd_dvd_left ..)
  have hb1g : b' * (Int.gcd a1 b1 : ℤ) = b1 := by
    rw [hb']
    exact Int.ediv_mul_cancel (Int.gcd_dvd_right ..)
  have hgq : (0 : ℚ) < ((Int.gcd a1 b1 : ℕ) : ℚ) := by exact_mod_cast hg
  obtain ⟨lam, hlam⟩ : ∃ lam : ℚ, lam = ((Int.gcd a1 b1 : ℕ) : ℚ) / ((a.den : ℚ) * (b.den : ℚ)) :=
    ⟨_, rfl⟩
  have hlam0 : lam ≠ 0 := by
    rw [hlam]
    exact div_ne_zero hgq.ne' hden0.ne'
  have haq : a = (a' : ℚ) * lam := by
    have h1 : ((a' * (Int.gcd a1 b1 : ℤ) : ℤ) : ℚ) = (a1 : ℚ) := by rw [ha1g]
    push_cast at h1
    rw [ha1q] at h1
    rw [hlam]
    field_simp
    linarith
  have hbq : b = (b' : ℚ) * lam := by
    have h1 : ((b' * (Int.gcd a1 b1 : ℤ) : ℤ) : ℚ) = (b1 : ℚ) := by rw [hb1g]
    push_cast at h1
    rw [hb1q] at h1
    rw [hlam]
    field_simp
    linarith
  have hL : (MvPolynomial.C a * MvPolynomial.X 0 + MvPolynomial.C b * MvPolynomial.X 1 :
      MvPolynomial (Fin 2) ℚ) = MvPolynomial.C lam * (MvPolynomial.C (a' : ℚ) * MvPolynomial.X 0 +
        MvPolynomial.C (b' : ℚ) * MvPolynomial.X 1) := by
