private theorem first_band_interval_length_signed
    (N : ℝ → ℝ) (a b H V : ℝ)
    (hab : a < b) (hH : 0 < H) (hV : 0 ≤ V)
    (hcont : ContinuousOn N (Set.Icc a b))
    (hdiff : DifferentiableOn ℝ N (Set.Ioo a b))
    (hderiv :
      (∀ t ∈ Set.Ioo a b, H ≤ deriv N t) ∨
      (∀ t ∈ Set.Ioo a b, deriv N t ≤ -H))
    (hosc : |N b - N a| ≤ V) :
    b - a ≤ V / H := by
  obtain ⟨t, ht, hmean⟩ :=
    exists_deriv_eq_slope N hab hcont hdiff
  have hba : 0 < b - a := sub_pos.mpr hab
  apply (le_div_iff₀ hH).2
  rcases hderiv with hpos | hneg
  · have hs := hpos t ht
    rw [hmean] at hs
    have hmul := (le_div_iff₀ hba).mp hs
    nlinarith [le_abs_self (N b - N a)]
  · have hs := hneg t ht
    rw [hmean] at hs
    have hmul := (div_le_iff₀ hba).mp hs
    nlinarith [neg_le_of_abs_le hosc]

private theorem second_band_interval_length
    (N : ℝ → ℝ) (a b H L : ℝ)
    (hab : a < b) (hL : 0 < L) (hH : 0 ≤ H)
    (hcont : ContinuousOn (deriv N) (Set.Icc a b))
    (hdiff : DifferentiableOn ℝ (deriv N) (Set.Ioo a b))
    (hcurv : ∀ t ∈ Set.Ioo a b, L ≤ deriv (deriv N) t)
    (hda : |deriv N a| ≤ H)
    (hdb : |deriv N b| ≤ H) :
    b - a ≤ 2 * H / L := by
  obtain ⟨t, ht, hmean⟩ :=
    exists_deriv_eq_slope (deriv N) hab hcont hdiff
  have hLt := hcurv t ht
  have hba : 0 < b - a := sub_pos.mpr hab
  have hdiff' : L * (b - a) ≤ deriv N b - deriv N a := by
    rw [hmean] at hLt
    exact (le_div_iff₀ hba).mp hLt
  apply (le_div_iff₀ hL).2
  nlinarith [le_abs_self (deriv N a), le_abs_self (deriv N b),
    neg_le_of_abs_le hda, le_of_abs_le hdb]

