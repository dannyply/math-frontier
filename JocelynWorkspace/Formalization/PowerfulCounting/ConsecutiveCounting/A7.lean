    (n : ℕ) (R : MvPolynomial (Fin 2) ℤ) (hR : R.IsHomogeneous n) (hR0 : R ≠ 0)
    (hsplit : ((C01.PcCurves.dehom R).map (Int.castRingHom ℚ)).Splits) :
    ∃ c : ℤ, c ≠ 0 ∧ ∃ s : Multiset (Option ℚ),
      s.card = n ∧ R = MvPolynomial.C c * (s.map labelLine).prod := by
  classical
  let f : Polynomial ℤ := C01.PcCurves.dehom R
  have hf : f ≠ 0 := fun h => hR0 (C01.PcCurves.eq_zero_of_dehom hR h)
  obtain ⟨c, hc, roots, hcard, hfac, hroots⟩ :=
    integer_linear_factorization f hf hsplit
  let s : Multiset (Option ℚ) :=
    roots.map some + Multiset.replicate (n - f.natDegree) none
  have hle : f.natDegree ≤ n := C01.PcCurves.dehom_natDegree_le hR
  have hs : s.card = n := by
    simp only [s, Multiset.card_add, Multiset.card_map, Multiset.card_replicate,
      hcard]
    omega
  have hdehomprod : (s.map labelPoly).prod = (roots.map rationalLinear).prod := by
    simp [s, Multiset.map_add, Multiset.prod_add, Multiset.map_map,
      Function.comp_def, labelPoly]
  let B : MvPolynomial (Fin 2) ℤ := MvPolynomial.C c * (s.map labelLine).prod
  have hB : B.IsHomogeneous n := by
    simpa only [B, hs, zero_add] using
      (MvPolynomial.isHomogeneous_C (Fin 2) c).mul (label_product_homogeneous s)
  have hdehom : C01.PcCurves.dehom B = f := by
    rw [show C01.PcCurves.dehom B =
      C01.PcCurves.dehom (MvPolynomial.C c) *
        C01.PcCurves.dehom ((s.map labelLine).prod) from
      C01.PcCurves.dehom_mul _ _]
    rw [label_product_dehom, hdehomprod]
    have hconst : C01.PcCurves.dehom (MvPolynomial.C c : MvPolynomial (Fin 2) ℤ) =
        Polynomial.C c := by simp [C01.PcCurves.dehom]
    rw [hconst]
    exact hfac.symm
  have hsub : C01.PcCurves.dehom (R - B) = 0 := by
    rw [C01.PcCurves.dehom_sub, hdehom]
    exact sub_self f
  have heq : R = B := sub_eq_zero.mp
    (C01.PcCurves.eq_zero_of_dehom (hR.sub hB) hsub)
  exact ⟨c, hc, s, hs, heq⟩

private theorem factored_label_projective_zero
    (n : ℕ) (R : MvPolynomial (Fin 2) ℤ) (hR : R.IsHomogeneous n)
    (c : ℤ) (s : Multiset (Option ℚ))
    (hfac : R = MvPolynomial.C c * (s.map labelLine).prod)
    (z : Option ℚ) (hz : z ∈ s) :
    MvPolynomial.eval (projectivePoint (labelToComplex z)).rep
      (R.map (Int.castRingHom ℂ)) = 0 := by
  apply eval_projectivePoint_rep_zero _ n (hR.map (Int.castRingHom ℂ))
  rw [hfac, map_mul, MvPolynomial.eval_mul,
    label_product_root s z hz, mul_zero]

private theorem twoSupportProduct {M : Type*} [CommMonoid M] (n : ℕ) (s : Multiset (Option ℚ)) (a b : Option ℚ) (hcard : s.card = n)
    (ha : a ∈ s) (hb : b ∈ s) (hne : a ≠ b)
    (hcover : ∀ x ∈ s, x = a ∨ x = b) :
    ∃ j : ℕ, 1 ≤ j ∧ j < n ∧
      ∀ f : Option ℚ → M, (s.map f).prod = f a ^ j * f b ^ (n - j) := by
  obtain ⟨j, hj, haj, hbj, hprod⟩ :=
    binarySupportProduct (M := M) a b hne s hcover
  refine ⟨j, ?_, ?_, ?_⟩
  · exact haj ha
  · have hlt := hbj hb
    omega
  · intro f
    simpa only [hcard] using hprod f

private theorem split_binary_classification
    (n : ℕ) (hn : 1 ≤ n) (R : MvPolynomial (Fin 2) ℤ)
    (hR : R.IsHomogeneous n) (hR0 : R ≠ 0)
    (hthree : ¬ HasThreeProjectiveZeros R)
    (hsplit : ((C01.PcCurves.dehom R).map (Int.castRingHom ℚ)).Splits) :
    RationalPurePower n R ∨ IntegralTwoLines n R := by
  classical
  obtain ⟨c, hc, labels, hcard, hfac⟩ :=
    binary_integer_linear_factorization n R hR hR0 hsplit
  obtain ⟨a, ha⟩ := FormalAB.S84900580.A5PrivateOddRoot.multiset_has_member labels (by omega)
  by_cases hone : ∀ z ∈ labels, z = a
  · have hp : R = MvPolynomial.C c * FormalAB.S84900580.A5PrivateOddRoot.labelLine a ^ n := by
      rw [hfac, FormalAB.S84900580.A5PrivateOddRoot.label_product_eq_pow labels a hone, hcard]
    left
    refine ⟨(c : ℚ), (FormalAB.S84900580.A5PrivateOddRoot.lineCoeffA a : ℚ),
      (FormalAB.S84900580.A5PrivateOddRoot.lineCoeffB a : ℚ), ?_, ?_, ?_⟩
    · exact_mod_cast hc
    · rcases FormalAB.S84900580.A5PrivateOddRoot.label_coeff_nonzero a with ha' | hb'
      · left; exact_mod_cast ha'
      · right; exact_mod_cast hb'
    · intro r s
      rw [hp]
      simp [FormalAB.S84900580.A5PrivateOddRoot.labelLine]
  · push Not at hone
    obtain ⟨b, hb, hba⟩ := hone
    have hab : a ≠ b := Ne.symm hba
    have hproj : Function.Injective (fun z : Option ℚ =>
        FormalAB.S84900580.A5PrivateOddRoot.projectivePoint (FormalAB.S84900580.A5PrivateOddRoot.labelToComplex z)) :=
      FormalAB.S84900580.A5PrivateOddRoot.projectivePoint_injective.comp
        FormalAB.S84900580.A5PrivateOddRoot.labelToComplex_injective
    have hzero : ∀ z ∈ labels,
        MvPolynomial.eval
          (FormalAB.S84900580.A5PrivateOddRoot.projectivePoint
            (FormalAB.S84900580.A5PrivateOddRoot.labelToComplex z)).rep
          (R.map (Int.castRingHom ℂ)) = 0 :=
      factored_label_projective_zero n R hR c labels hfac
    have hcover : ∀ z ∈ labels, z = a ∨ z = b := by
      intro z hz
      by_cases hza : z = a
      · exact Or.inl hza
      by_cases hzb : z = b
      · exact Or.inr hzb
      exfalso
      apply hthree
      refine ⟨FormalAB.S84900580.A5PrivateOddRoot.projectivePoint (FormalAB.S84900580.A5PrivateOddRoot.labelToComplex a),
        FormalAB.S84900580.A5PrivateOddRoot.projectivePoint (FormalAB.S84900580.A5PrivateOddRoot.labelToComplex b),
        FormalAB.S84900580.A5PrivateOddRoot.projectivePoint (FormalAB.S84900580.A5PrivateOddRoot.labelToComplex z),
        ?_, ?_, ?_, hzero a ha, hzero b hb, hzero z hz⟩
      · exact fun he => hab (hproj he)
      · exact fun he => hza (hproj he).symm
      · exact fun he => hzb (hproj he).symm
    obtain ⟨j, hj, hj6, hprod⟩ :=
      twoSupportProduct (M := MvPolynomial (Fin 2) ℤ)
        n labels a b hcard ha hb hab hcover
    right
    refine ⟨c, FormalAB.S84900580.A5PrivateOddRoot.lineCoeffA a, FormalAB.S84900580.A5PrivateOddRoot.lineCoeffB a,
      FormalAB.S84900580.A5PrivateOddRoot.lineCoeffA b, FormalAB.S84900580.A5PrivateOddRoot.lineCoeffB b,
      j, hc, FormalAB.S84900580.A5PrivateOddRoot.label_coeff_independent a b hab,
      hj, hj6, ?_⟩
    rw [hfac, hprod FormalAB.S84900580.A5PrivateOddRoot.labelLine]
    simp only [FormalAB.S84900580.A5PrivateOddRoot.labelLine, mul_assoc]

private theorem nonlinear_factor_two_roots (f p : Polynomial ℚ)
    (hf : f ≠ 0) (htwo : AtMostTwoRoots f)
    (hp : Irreducible p) (hpf : p ∣ f) (hne : p.natDegree ≠ 1) :
    p.natDegree = 2 ∧ ∀ z : ℂ,
      Polynomial.eval₂ (algebraMap ℚ ℂ) z f = 0 →
        Polynomial.eval₂ (algebraMap ℚ ℂ) z p = 0 := by
  classical
  have hpos : 0 < p.natDegree :=
    Polynomial.natDegree_pos_iff_degree_pos.mpr
      (Polynomial.degree_pos_of_irreducible hp)
  have hge : 2 ≤ p.natDegree := by omega
  let pc : Polynomial ℂ := p.map (algebraMap ℚ ℂ)
  have hpc : pc ≠ 0 := by
    exact (Polynomial.map_ne_zero_iff (RingHom.injective _)).mpr hp.ne_zero
  have hsep : pc.Separable := hp.separable.map
  let S : Finset ℂ := pc.roots.toFinset
  have hcard : S.card = p.natDegree := by
    calc
      S.card = pc.roots.card :=
        Multiset.toFinset_card_of_nodup (Polynomial.nodup_roots hsep)
      _ = pc.natDegree := (IsAlgClosed.splits pc).natDegree_eq_card_roots.symm
      _ = p.natDegree := Polynomial.natDegree_map _
  obtain ⟨z₁, hz₁, z₂, hz₂, h12⟩ := Finset.one_lt_card.mp
    (show 1 < S.card from by omega)
  have hroot : ∀ z ∈ S,
      Polynomial.eval₂ (algebraMap ℚ ℂ) z p = 0 := by
    intro z hz
    have hz' : z ∈ pc.roots := by simpa only [S, Multiset.mem_toFinset] using hz
    have hr := (Polynomial.mem_roots hpc).mp hz'
    simpa only [Polynomial.IsRoot.def, pc, Polynomial.eval_map] using hr
  have hpfroot : ∀ z : ℂ,
      Polynomial.eval₂ (algebraMap ℚ ℂ) z p = 0 →
      Polynomial.eval₂ (algebraMap ℚ ℂ) z f = 0 := by
    intro z hz
    obtain ⟨g, rfl⟩ := hpf
    rw [Polynomial.eval₂_mul, hz, zero_mul]
  have h₁ := hroot z₁ hz₁
  have h₂ := hroot z₂ hz₂
  have hf₁ := hpfroot z₁ h₁
  have hf₂ := hpfroot z₂ h₂
  have hsub : S ⊆ {z₁, z₂} := by
    intro z hz
    rcases htwo z₁ z₂ z hf₁ hf₂ (hpfroot z (hroot z hz)) with h | h | h
    · exact (h12 h).elim
    · simp [← h]
    · simp [← h]
  have hle : S.card ≤ 2 := by
    calc
      S.card ≤ ({z₁, z₂} : Finset ℂ).card := Finset.card_le_card hsub
      _ = 2 := by simp [h12]
  have hdeg : p.natDegree = 2 := by omega
  have hsupport : ∀ z : ℂ,
      Polynomial.eval₂ (algebraMap ℚ ℂ) z f = 0 →
      Polynomial.eval₂ (algebraMap ℚ ℂ) z p = 0 := by
    intro z hz
    rcases htwo z₁ z₂ z hf₁ hf₂ hz with h | h | h
    · exact (h12 h).elim
    · simpa only [← h] using h₁
    · simpa only [← h] using h₂
  exact ⟨hdeg,hsupport⟩

private theorem primitive_rational_polynomial_exists (g : Polynomial ℚ) (hg : g≠0) :
    ∃q : Polynomial ℤ,q.IsPrimitive ∧ q.natDegree=g.natDegree ∧
      ∃k:ℚ,k≠0 ∧ q.map (Int.castRingHom ℚ)=Polynomial.C k*g := by
  obtain ⟨b, hbM, hb⟩ := IsLocalization.integerNormalization_spec
    (nonZeroDivisors ℤ) g
  let f := IsLocalization.integerNormalization (nonZeroDivisors ℤ) g
  have hbne : b ≠ 0 := nonZeroDivisors.ne_zero hbM
  have hb0 : (b : ℚ) ≠ 0 := by exact_mod_cast hbne
  have hb' : f.map (Int.castRingHom ℚ) = Polynomial.C (b : ℚ) * g := by
    rw [← algebraMap_int_eq, hb, ← Int.cast_smul_eq_zsmul ℚ, Polynomial.smul_eq_C_mul]
  have hCb : (Polynomial.C (b : ℚ)) ≠ 0 := by simpa using hb0
  have hf : f ≠ 0 := by
    intro h
    rw [h, Polynomial.map_zero] at hb'
    exact (mul_ne_zero hCb hg) hb'.symm
  have hp : f.primPart.IsPrimitive := Polynomial.isPrimitive_primPart f
  have hc : f.content ≠ 0 := by rwa [Ne, Polynomial.content_eq_zero_iff]
  have hcQ : (f.content : ℚ) ≠ 0 := by exact_mod_cast hc
  have hCc : (Polynomial.C (f.content : ℚ) : Polynomial ℚ) ≠ 0 := by
    simpa using hcQ
  have he : Polynomial.C (f.content : ℚ) *
      f.primPart.map (Int.castRingHom ℚ) = Polynomial.C (b : ℚ) * g := by
    rw [← hb']
    conv_rhs => rw [Polynomial.eq_C_content_mul_primPart f]
    rw [Polynomial.map_mul, Polynomial.map_C]
    simp
  have hscalar : (f.content : ℚ) * ((b : ℚ) / (f.content : ℚ)) = (b : ℚ) := by
    field_simp
  have hmap : f.primPart.map (Int.castRingHom ℚ) =
      Polynomial.C ((b : ℚ) / (f.content : ℚ)) * g := by
    apply mul_left_cancel₀ hCc
    rw [he, ← mul_assoc, ← map_mul, hscalar]
  have hk : ((b : ℚ) / (f.content : ℚ)) ≠ 0 := div_ne_zero hb0 hcQ
  have hCk : (Polynomial.C ((b : ℚ) / (f.content : ℚ)) : Polynomial ℚ) ≠ 0 := by
    simpa using hk
  have hd : f.primPart.natDegree = g.natDegree := by
    calc
      f.primPart.natDegree =
          (f.primPart.map (Int.castRingHom ℚ)).natDegree :=
        (Polynomial.natDegree_map_eq_of_injective (RingHom.injective_int _) _).symm
      _ = g.natDegree := by
        rw [hmap, Polynomial.natDegree_mul hCk hg, Polynomial.natDegree_C]
        simp only [zero_add]
  exact ⟨f.primPart, hp, hd, (b : ℚ) / (f.content : ℚ), hk, hmap⟩

private theorem dehom_atMostTwo (n : ℕ) (R : MvPolynomial (Fin 2) ℤ)
    (hR : R.IsHomogeneous n) (hR0 : R ≠ 0)
    (hthree : ¬ HasThreeProjectiveZeros R) :
    AtMostTwoRoots ((C01.PcCurves.dehom R).map (Int.castRingHom ℚ)) := by
  classical
  let f0 : Polynomial ℤ := C01.PcCurves.dehom R
  let f : Polynomial ℚ := f0.map (Int.castRingHom ℚ)
  let RC : MvPolynomial (Fin 2) ℂ := R.map (Int.castRingHom ℂ)
  have hRC : RC.IsHomogeneous n := hR.map (Int.castRingHom ℂ)
  have hf0 : f0 ≠ 0 := fun h => hR0 (C01.PcCurves.eq_zero_of_dehom hR h)
  have hinj : Function.Injective (Int.castRingHom ℚ) := RingHom.injective_int _
  have hf : f ≠ 0 := (Polynomial.map_ne_zero_iff hinj).mpr hf0
  have hdeg : f.natDegree = f0.natDegree :=
    Polynomial.natDegree_map_eq_of_injective hinj f0
  have hcomp : (algebraMap ℚ ℂ).comp (Int.castRingHom ℚ) =
      Int.castRingHom ℂ := by
    ext n ; simp
  have hvec : ∀ z : ℂ, Polynomial.eval₂ (algebraMap ℚ ℂ) z f = 0 →
      MvPolynomial.eval (pointVector (some z)) RC = 0 := by
    intro z hz
    have hz' : Polynomial.eval₂ (Int.castRingHom ℂ) z f0 = 0 := by
      simpa only [f, Polynomial.eval₂_map, hcomp] using hz
    change MvPolynomial.eval ![z, 1] RC = 0
    rw [← C01.PcCurves.dehom_eval hRC, C01.PcRes.dehom_map hR,
      Polynomial.eval_map]
    exact hz'
  have hrep : ∀ z : ℂ, Polynomial.eval₂ (algebraMap ℚ ℂ) z f = 0 →
      MvPolynomial.eval (projectivePoint (some z)).rep RC = 0 := by
    intro z hz
    exact eval_projectivePoint_rep_zero RC n hRC (some z) (hvec z hz)
  have htwo : AtMostTwoRoots f := by
    intro z₁ z₂ z₃ hz₁ hz₂ hz₃
    by_contra hn
    have h12 : z₁ ≠ z₂ := by intro h; exact hn (Or.inl h)
    have h13 : z₁ ≠ z₃ := by intro h; exact hn (Or.inr (Or.inl h))
    have h23 : z₂ ≠ z₃ := by intro h; exact hn (Or.inr (Or.inr h))
    apply hthree
    refine ⟨projectivePoint (some z₁), projectivePoint (some z₂),
      projectivePoint (some z₃), ?_, ?_, ?_, hrep z₁ hz₁, hrep z₂ hz₂, hrep z₃ hz₃⟩
    · intro h
      exact h12 (Option.some.inj (projectivePoint_injective h))
    · intro h
      exact h13 (Option.some.inj (projectivePoint_injective h))
    · intro h
      exact h23 (Option.some.inj (projectivePoint_injective h))
  exact htwo

private theorem dehom_degree_or_split (n : ℕ) (R : MvPolynomial (Fin 2) ℤ)
    (hR : R.IsHomogeneous n) (hR0 : R ≠ 0)
    (hthree : ¬ HasThreeProjectiveZeros R) :
    ((C01.PcCurves.dehom R).map (Int.castRingHom ℚ)).natDegree=n ∨
      ((C01.PcCurves.dehom R).map (Int.castRingHom ℚ)).Splits := by
  classical
  let f0 : Polynomial ℤ := C01.PcCurves.dehom R
  let f : Polynomial ℚ := f0.map (Int.castRingHom ℚ)
  let RC : MvPolynomial (Fin 2) ℂ := R.map (Int.castRingHom ℂ)
  have hRC : RC.IsHomogeneous n := hR.map (Int.castRingHom ℂ)
  have hf0 : f0 ≠ 0 := fun h => hR0 (C01.PcCurves.eq_zero_of_dehom hR h)
  have hinj : Function.Injective (Int.castRingHom ℚ) := RingHom.injective_int _
  have hf : f ≠ 0 := (Polynomial.map_ne_zero_iff hinj).mpr hf0
  have hdeg : f.natDegree = f0.natDegree :=
    Polynomial.natDegree_map_eq_of_injective hinj f0
  have hcomp : (algebraMap ℚ ℂ).comp (Int.castRingHom ℚ) =
      Int.castRingHom ℂ := by
    ext n ; simp
  have hvec : ∀ z : ℂ, Polynomial.eval₂ (algebraMap ℚ ℂ) z f = 0 →
      MvPolynomial.eval (pointVector (some z)) RC = 0 := by
    intro z hz
    have hz' : Polynomial.eval₂ (Int.castRingHom ℂ) z f0 = 0 := by
      simpa only [f, Polynomial.eval₂_map, hcomp] using hz
    change MvPolynomial.eval ![z, 1] RC = 0
    rw [← C01.PcCurves.dehom_eval hRC, C01.PcRes.dehom_map hR,
      Polynomial.eval_map]
    exact hz'
  have hrep : ∀ z : ℂ, Polynomial.eval₂ (algebraMap ℚ ℂ) z f = 0 →
      MvPolynomial.eval (projectivePoint (some z)).rep RC = 0 := by
    intro z hz
    exact eval_projectivePoint_rep_zero RC n hRC (some z) (hvec z hz)
  have htwo : AtMostTwoRoots f := by
    intro z₁ z₂ z₃ hz₁ hz₂ hz₃
    by_contra hn
    have h12 : z₁ ≠ z₂ := by intro h; exact hn (Or.inl h)
    have h13 : z₁ ≠ z₃ := by intro h; exact hn (Or.inr (Or.inl h))
    have h23 : z₂ ≠ z₃ := by intro h; exact hn (Or.inr (Or.inr h))
    apply hthree
    refine ⟨projectivePoint (some z₁), projectivePoint (some z₂),
      projectivePoint (some z₃), ?_, ?_, ?_, hrep z₁ hz₁, hrep z₂ hz₂, hrep z₃ hz₃⟩
    · intro h
      exact h12 (Option.some.inj (projectivePoint_injective h))
    · intro h
      exact h13 (Option.some.inj (projectivePoint_injective h))
    · intro h
      exact h23 (Option.some.inj (projectivePoint_injective h))
  by_cases h7 : f0.natDegree = n
  · exact Or.inl (hdeg.trans h7)
  · right
    have hle : f0.natDegree ≤ n := C01.PcCurves.dehom_natDegree_le hR
    have hlt : f0.natDegree < n := by omega
    have hc7 : f0.coeff n = R.coeff (C01.PcCurves.ex n 0) := by
      simpa only [f0, Nat.sub_self, if_pos (le_refl n)] using
        (C01.PcCurves.dehom_coeff hR n)
    have hc0 : R.coeff (C01.PcCurves.ex n 0) = 0 := by
      rw [← hc7]
      exact Polynomial.coeff_eq_zero_of_natDegree_lt hlt
    have hinf : MvPolynomial.eval (pointVector none) RC = 0 := by
      change MvPolynomial.eval ![1, 0] RC = 0
      rw [C01.PcCurves.eval_one_zero hRC, MvPolynomial.coeff_map]
      simp only [hc0, map_zero]
    have hinfrep : MvPolynomial.eval (projectivePoint none).rep RC = 0 :=
      eval_projectivePoint_rep_zero RC n hRC none hinf
    have hone : ∀ z w : ℂ,
        Polynomial.eval₂ (algebraMap ℚ ℂ) z f = 0 →
        Polynomial.eval₂ (algebraMap ℚ ℂ) w f = 0 → z = w := by
      intro z w hz hw
      by_contra hzw
      apply hthree
      refine ⟨projectivePoint none, projectivePoint (some z),
        projectivePoint (some w), ?_, ?_, ?_, hinfrep, hrep z hz, hrep w hw⟩
      · intro h
        have h' := projectivePoint_injective h
        simp at h'
      · intro h
        have h' := projectivePoint_injective h
        simp at h'
      · intro h
        exact hzw (Option.some.inj (projectivePoint_injective h))
    exact one_root_splits f hf hone

private theorem np_pow_of_all_roots (p : Polynomial ℚ) (hp : Irreducible p) :
    ∀ n : ℕ, ∀ f : Polynomial ℚ, f.natDegree = n → f ≠ 0 →
      (∀ z : ℂ, Polynomial.eval₂ (algebraMap ℚ ℂ) z f = 0 →
        Polynomial.eval₂ (algebraMap ℚ ℂ) z p = 0) →
      ∃ c : ℚ, ∃ k : ℕ, f = Polynomial.C c * p ^ k := by
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro f hfn hf hroots
    by_cases hn : n = 0
    · have hz : f.natDegree = 0 := hfn.trans hn
      refine ⟨f.coeff 0, 0, ?_⟩
      rw [pow_zero, mul_one]
      exact Polynomial.eq_C_of_natDegree_eq_zero hz
    · have hnpos : 0 < n := Nat.pos_of_ne_zero hn
      have hfpos : 0 < f.natDegree := by omega
      have hfdegree : f.degree ≠ 0 :=
        ne_of_gt (Polynomial.natDegree_pos_iff_degree_pos.mp hfpos)
      obtain ⟨z, hz⟩ := IsAlgClosed.exists_eval₂_eq_zero
        (algebraMap ℚ ℂ) f hfdegree
      obtain ⟨g, hfg⟩ := common_root_dvd p f hp z (hroots z hz) hz
      have hg : g ≠ 0 := by
        intro he
        rw [he, mul_zero] at hfg
        exact hf hfg
      have hppos : 0 < p.natDegree :=
        Polynomial.natDegree_pos_iff_degree_pos.mpr
          (Polynomial.degree_pos_of_irreducible hp)
      have hdeg : f.natDegree = p.natDegree + g.natDegree := by
        rw [hfg, Polynomial.natDegree_mul hp.ne_zero hg]
      have hlt : g.natDegree < n := by omega
      have hgroot : ∀ w : ℂ,
          Polynomial.eval₂ (algebraMap ℚ ℂ) w g = 0 →
          Polynomial.eval₂ (algebraMap ℚ ℂ) w p = 0 := by
        intro w hw
        apply hroots w
        rw [hfg, Polynomial.eval₂_mul, hw, mul_zero]
      obtain ⟨c, k, hgk⟩ := ih g.natDegree hlt g rfl hg hgroot
      refine ⟨c, k + 1, ?_⟩
      rw [hfg, hgk]
      ring

private theorem np_isPrimitive_pow {q : Polynomial ℤ} (hq : q.IsPrimitive) :
    ∀ k : ℕ, (q ^ k).IsPrimitive
  | 0 => by rw [pow_zero]; exact Polynomial.isPrimitive_one
  | k + 1 => by rw [pow_succ]; exact (np_isPrimitive_pow hq k).mul hq

private theorem np_int_power_of_rat_power (fZ : Polynomial ℤ) (hfZ : fZ ≠ 0)
    (p : Polynomial ℚ) (hp0 : p ≠ 0) (hp2 : p.natDegree = 2)
    (cQ : ℚ) (k : ℕ) (hfac : fZ.map (Int.castRingHom ℚ) = Polynomial.C cQ * p ^ k) :
    ∃ q : Polynomial ℤ, q.IsPrimitive ∧ q.natDegree = 2 ∧
      ∃ c : ℤ, c ≠ 0 ∧ fZ = Polynomial.C c * q ^ k := by
  classical
  obtain ⟨q, hqprim, hqdegree, kq, hk, hqmap⟩ :=
    primitive_rational_polynomial_exists p hp0
  have hq2 : q.natDegree = 2 := hqdegree.trans hp2
  have hqpow : (q ^ k).IsPrimitive := np_isPrimitive_pow hqprim k
  have hdiv : q ^ k ∣ fZ := by
    rw [Polynomial.IsPrimitive.Int.dvd_iff_map_cast_dvd_map_cast (q ^ k) fZ hqpow]
    refine ⟨Polynomial.C (cQ / kq ^ k), ?_⟩
    rw [Polynomial.map_pow, hqmap, hfac]
    have hkk : kq ^ k ≠ 0 := pow_ne_zero k hk
    have hsc : kq ^ k * (cQ / kq ^ k) = cQ := by field_simp
    have hC : (Polynomial.C kq : Polynomial ℚ) ^ k * Polynomial.C (cQ / kq ^ k) =
        Polynomial.C cQ := by
      rw [← map_pow, ← map_mul, hsc]
    calc
      Polynomial.C cQ * p ^ k =
          ((Polynomial.C kq) ^ k * Polynomial.C (cQ / kq ^ k)) * p ^ k := by rw [hC]
      _ = (Polynomial.C kq * p) ^ k * Polynomial.C (cQ / kq ^ k) := by ring
  obtain ⟨t, hft⟩ := hdiv
  have ht : t ≠ 0 := by
    intro hz
    rw [hz, mul_zero] at hft
    exact hfZ hft
  have hcQ : cQ ≠ 0 := by
    intro h0
    apply hfZ
    apply Polynomial.map_injective (Int.castRingHom ℚ) (RingHom.injective_int _)
    rw [hfac, h0, Polynomial.C_0, zero_mul, Polynomial.map_zero]
  have hfdeg : (fZ.map (Int.castRingHom ℚ)).natDegree = k * 2 := by
    rw [hfac, Polynomial.natDegree_mul (by simpa using hcQ) (pow_ne_zero k hp0),
      Polynomial.natDegree_C, Polynomial.natDegree_pow, hp2, zero_add]
  have hfZdeg : fZ.natDegree = k * 2 := by
    rw [← hfdeg]
    exact (Polynomial.natDegree_map_eq_of_injective
      (RingHom.injective_int (Int.castRingHom ℚ)) fZ).symm
  have hqkdeg : (q ^ k).natDegree = k * 2 := by
    rw [Polynomial.natDegree_pow, hq2]
  have ht0 : t.natDegree = 0 := by
    have hsum : fZ.natDegree = (q ^ k).natDegree + t.natDegree := by
      rw [hft, Polynomial.natDegree_mul (pow_ne_zero k hqprim.ne_zero) ht]
    omega
  have htC : t = Polynomial.C (t.coeff 0) := Polynomial.eq_C_of_natDegree_eq_zero ht0
  have hct : t.coeff 0 ≠ 0 := by
    intro hz
    apply ht
    rw [htC, hz, Polynomial.C_0]
  refine ⟨q, hqprim, hq2, t.coeff 0, hct, ?_⟩
  calc
    fZ = q ^ k * t := hft
    _ = q ^ k * Polynomial.C (t.coeff 0) := congrArg (fun z => q ^ k * z) htC
    _ = Polynomial.C (t.coeff 0) * q ^ k := mul_comm _ _

private theorem np_nonsplit_quadratic_power (fZ : Polynomial ℤ) (hfZ : fZ ≠ 0)
    (htwo : AtMostTwoRoots (fZ.map (Int.castRingHom ℚ)))
    (hnsplit : ¬ (fZ.map (Int.castRingHom ℚ)).Splits) :
    ∃ q : Polynomial ℤ, q.IsPrimitive ∧ q.natDegree = 2 ∧
      ∃ c : ℤ, c ≠ 0 ∧ ∃ k : ℕ, fZ = Polynomial.C c * q ^ k := by
  classical
  let f := fZ.map (Int.castRingHom ℚ)
  have hf : f ≠ 0 :=
    (Polynomial.map_ne_zero_iff (RingHom.injective_int (Int.castRingHom ℚ))).mpr hfZ
  by_cases hlinear : ∀ p : Polynomial ℚ, Irreducible p → p ∣ f → p.natDegree = 1
  · exact (hnsplit (splits_of_linear_factors f hf hlinear)).elim
  push Not at hlinear
  obtain ⟨p, hp, hpf, hpd⟩ := hlinear
  obtain ⟨hp2, hsupport⟩ := nonlinear_factor_two_roots f p hf htwo hp hpf hpd
  obtain ⟨cQ, k, hfac⟩ := np_pow_of_all_roots p hp f.natDegree f rfl hf hsupport
  obtain ⟨q, hqprim, hq2, c, hc, hfZ'⟩ :=
    np_int_power_of_rat_power fZ hfZ p hp.ne_zero hp2 cQ k hfac
  exact ⟨q, hqprim, hq2, c, hc, k, hfZ'⟩

private theorem np_general_binary_classification (n : ℕ) (hn : 1 ≤ n)
    (R : MvPolynomial (Fin 2) ℤ) (hR : R.IsHomogeneous n) (hR0 : R ≠ 0) :
    ThreeProjectiveZeros R ∨ RationalPurePower n R ∨ IntegralTwoLines n R ∨
      ∃ c A B C0 : ℤ, c ≠ 0 ∧ A ≠ 0 ∧ ∃ k : ℕ, 2 * k = n ∧
        R = MvPolynomial.C c * (quadraticForm A B C0) ^ k := by
  classical
  by_cases ht : HasThreeProjectiveZeros R
  · exact Or.inl ht
  right
  by_cases hs : ((C01.PcCurves.dehom R).map (Int.castRingHom ℚ)).Splits
  · rcases split_binary_classification n hn R hR hR0 ht hs with hp | hl
    · exact Or.inl hp
    · exact Or.inr (Or.inl hl)
  right
  right
  let fZ := C01.PcCurves.dehom R
  have hfZ : fZ ≠ 0 := fun hz => hR0 (C01.PcCurves.eq_zero_of_dehom hR hz)
  have hdegQ : (fZ.map (Int.castRingHom ℚ)).natDegree = n :=
    (dehom_degree_or_split n R hR hR0 ht).resolve_right hs
  have hdeg : fZ.natDegree = n := by
    rwa [Polynomial.natDegree_map_eq_of_injective (RingHom.injective_int _)] at hdegQ
  obtain ⟨q, hqprim, hqdeg, c, hc, k, hfac⟩ :=
    np_nonsplit_quadratic_power fZ hfZ (dehom_atMostTwo n R hR hR0 ht) hs
  have hk : 2 * k = n := by
    have h1 : fZ.natDegree = (Polynomial.C c * q ^ k).natDegree := by rw [← hfac]
    rw [Polynomial.natDegree_mul (by simpa using hc) (pow_ne_zero k hqprim.ne_zero),
      Polynomial.natDegree_C, Polynomial.natDegree_pow, hqdeg, zero_add, hdeg] at h1
    omega
  let A := q.coeff 2
  let B := q.coeff 1
  let C0 := q.coeff 0
  have hA : A ≠ 0 := by
    dsimp [A]
    rw [← hqdeg, Polynomial.coeff_natDegree]
    exact Polynomial.leadingCoeff_ne_zero.mpr hqprim.ne_zero
  have hqform : q = Polynomial.C A * Polynomial.X ^ 2 +
      Polynomial.C B * Polynomial.X + Polynomial.C C0 := by
    ext t
    simp only [Polynomial.coeff_add, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow,
      Polynomial.coeff_X, Polynomial.coeff_C]
    by_cases ht2 : t ≤ 2
    · interval_cases t <;> simp [A, B, C0]
    · have hqt : q.coeff t = 0 :=
        Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)
      simp [hqt, show t ≠ 0 from by omega, show t ≠ 1 from by omega,
        show t ≠ 2 from by omega, show 0 ≠ t from by omega,
        show 1 ≠ t from by omega, show 2 ≠ t from by omega]
  have hdehomq : C01.PcCurves.dehom (quadraticForm A B C0) = q := by
    calc
      C01.PcCurves.dehom (quadraticForm A B C0) =
          Polynomial.C A * Polynomial.X ^ 2 + Polynomial.C B * Polynomial.X +
            Polynomial.C C0 := by
        simp [C01.PcCurves.dehom, quadraticForm]
      _ = q := hqform.symm
  let S := MvPolynomial.C c * (quadraticForm A B C0) ^ k
  have hS : S.IsHomogeneous n := by
    have h := (isHomogeneous_C (Fin 2) c).mul ((quadratic_homogeneous A B C0).pow k)
    rw [zero_add, hk] at h
    exact h
  have hdehomS : C01.PcCurves.dehom S = fZ := by
    rw [show C01.PcCurves.dehom S =
      C01.PcCurves.dehom (MvPolynomial.C c) *
        C01.PcCurves.dehom ((quadraticForm A B C0) ^ k) from
          C01.PcCurves.dehom_mul _ _]
    have hC : C01.PcCurves.dehom (MvPolynomial.C c : MvPolynomial (Fin 2) ℤ) =
        Polynomial.C c := by simp [C01.PcCurves.dehom]
    rw [hC, C01.PcCurves.dehom_pow, hdehomq]
    exact hfac.symm
  have hz : C01.PcCurves.dehom (R - S) = 0 := by
    rw [C01.PcCurves.dehom_sub, hdehomS]
    exact sub_self fZ
  exact ⟨c, A, B, C0, hc, hA, k, hk,
    sub_eq_zero.mp (C01.PcCurves.eq_zero_of_dehom (hR.sub hS) hz)⟩

private abbrev idx (i j k l : ℕ) : Fin 4 →₀ ℕ :=
  Finsupp.single 0 i + Finsupp.single 1 j + Finsupp.single 2 k + Finsupp.single 3 l

private theorem block_coeff (G : MvPolynomial (Fin 4) ℤ) (a i j : ℕ)
    (hG : ∀ m ∈ G.support, m 0+m 1=a ∧ m 2+m 3=1) :
    (C01.PcParam.PP G).coeff (C01.PcCurves.ex i j) = G.coeff (idx i j 1 0) ∧
    (C01.PcParam.QQ G).coeff (C01.PcCurves.ex i j) = G.coeff (idx i j 0 1) := by
  classical
  constructor
  · unfold C01.PcParam.PP
    simp only [coeff_sum, C01.PcCurves.monomial_ex, coeff_monomial]
    rw [Finset.sum_eq_single (idx i j 1 0)]
    · simp [idx, C01.PcCurves.ex]
    · intro m hm hne
      rw [if_neg]
      intro he
      have h0 : m 0=i := by simpa using congrArg (fun f => f 0) he
      have h1 : m 1=j := by simpa using congrArg (fun f => f 1) he
      obtain ⟨hmS,hm2⟩ := Finset.mem_filter.mp hm
      have hm3 : m 3=0 := by have ht := (hG m hmS).2; omega
      apply hne
      ext t
      fin_cases t <;> simp [idx] <;> omega
    · intro hn
      have hc : G.coeff (idx i j 1 0)=0 := by
        by_contra hc
        apply hn
        exact Finset.mem_filter.mpr ⟨mem_support_iff.mpr hc,by simp [idx]⟩
      simp [hc]
  · unfold C01.PcParam.QQ
    simp only [coeff_sum, C01.PcCurves.monomial_ex, coeff_monomial]
    rw [Finset.sum_eq_single (idx i j 0 1)]
    · simp [idx, C01.PcCurves.ex]
    · intro m hm hne
      rw [if_neg]
      intro he
      have h0 : m 0=i := by simpa using congrArg (fun f => f 0) he
      have h1 : m 1=j := by simpa using congrArg (fun f => f 1) he
      obtain ⟨hmS,hm2⟩ := Finset.mem_filter.mp hm
      have hm20 : m 2=0 := by have ht := (hG m hmS).2; omega
      have hm3 : m 3=1 := by have ht := (hG m hmS).2; omega
      apply hne
      ext t
      fin_cases t <;> simp [idx] <;> omega
    · intro hn
      have hc : G.coeff (idx i j 0 1)=0 := by
        by_contra hc
        apply hn
        exact Finset.mem_filter.mpr ⟨mem_support_iff.mpr hc,by simp [idx]⟩
      simp [hc]

private def canonicalP (G : MvPolynomial (Fin 4) ℤ) (a : ℕ) : MvPolynomial (Fin 2) ℤ :=
  ∑ i ∈ Finset.range (a+1), C (G.coeff (idx i (a-i) 1 0))*X 0^i*X 1^(a-i)

private def canonicalQ (G : MvPolynomial (Fin 4) ℤ) (a : ℕ) : MvPolynomial (Fin 2) ℤ :=
  ∑ i ∈ Finset.range (a+1), C (-G.coeff (idx i (a-i) 0 1))*X 0^i*X 1^(a-i)

private theorem canonical_blocks (G : MvPolynomial (Fin 4) ℤ) (a : ℕ)
    (hG : ∀ m ∈ G.support, m 0+m 1=a ∧ m 2+m 3=1) :
    canonicalP G a=C01.PcParam.PP G ∧ canonicalQ G a= -C01.PcParam.QQ G := by
  constructor
  · rw [C01.PcCurves.hom_repr (C01.PcParam.PP_hom G a hG)]
    unfold canonicalP
    apply Finset.sum_congr rfl
    intro i hi
    rw [(block_coeff G a i (a-i) hG).1]
  · rw [C01.PcCurves.hom_repr (C01.PcParam.QQ_hom G a hG),←Finset.sum_neg_distrib]
    unfold canonicalQ
    apply Finset.sum_congr rfl
    intro i hi
    rw [(block_coeff G a i (a-i) hG).2]
    simp

private def residual (G : MvPolynomial (Fin 4) ℤ) : MvPolynomial (Fin 2) ℤ :=
  X 1^4*C01.PcParam.PP G+X 0^4*C01.PcParam.QQ G

private theorem generic_graph_data (G : MvPolynomial (Fin 4) ℤ) (a : ℕ)
    (hG : ∀ m ∈ G.support, m 0+m 1=a ∧ m 2+m 3=1)
    (hi : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G))
    (H : ℝ) (hH : 0≤H)
    (hc : ∀m : Fin 4 →₀ ℕ,|((G.coeff m:ℤ):ℝ)|≤H) :
    (C01.PcParam.PP G).IsHomogeneous a ∧
    (-C01.PcParam.QQ G).IsHomogeneous a ∧
    (∀m : Fin 2 →₀ ℕ, |(((C01.PcParam.PP G).coeff m:ℤ):ℝ)|≤H ∧
      |(((-C01.PcParam.QQ G).coeff m:ℤ):ℝ)|≤H) ∧
    (∀w : Fin 2 → ℂ,w≠0 →
      eval w (MvPolynomial.map (Int.castRingHom ℂ) (C01.PcParam.PP G))=0 →
      eval w (MvPolynomial.map (Int.castRingHom ℂ) (-C01.PcParam.QQ G))=0 → False) := by
  have hP := C01.PcParam.PP_hom G a hG
  have hQ := C01.PcParam.QQ_hom G a hG
  refine ⟨hP,hQ.neg,?_,?_⟩
  · intro m
    refine ⟨C01.PcParam.PP_coeff G a hG H hH hc m,?_⟩
    simpa using C01.PcParam.QQ_coeff G a hG H hH hc m
  · intro w hw hp hq
    have hq' : eval w (MvPolynomial.map (Int.castRingHom ℂ) (C01.PcParam.QQ G))=0 := by
      simpa using hq
    exact C01.PcCurves.no_common_zero (hP.map (Int.castRingHom ℂ))
      (hQ.map (Int.castRingHom ℂ)) (C01.PcParam.relprime_core G a hG hi) hw hp hq'

private theorem graph_eval (G : MvPolynomial (Fin 4) ℤ) (a : ℕ)
    (hG : ∀m∈G.support,m 0+m 1=a ∧ m 2+m 3=1) (d e u v : ℤ)
    (hz : eval ![d,e,u,v] G=0) :
    eval ![d,e] (C01.PcParam.PP G)*u =
      eval ![d,e] (-C01.PcParam.QQ G)*v := by
  rw [C01.PcParam.lin_eval G a hG d e u v] at hz
  simp only [map_neg]
  linear_combination hz

private theorem residual_homogeneous (G : MvPolynomial (Fin 4) ℤ) (a : ℕ)
    (hG : ∀m∈G.support,m 0+m 1=a ∧ m 2+m 3=1) :
    (residual G).IsHomogeneous (a+4) := by
  have hP := (isHomogeneous_X ℤ (1:Fin 2)).pow 4
  have hQ := (isHomogeneous_X ℤ (0:Fin 2)).pow 4
  have ht := (hP.mul (C01.PcParam.PP_hom G a hG)).add
    (hQ.mul (C01.PcParam.QQ_hom G a hG))
  simpa [residual,Nat.add_comm] using ht

private theorem sum_single_bound (N : ℕ) (f : ℕ → Fin 2 →₀ ℕ)
    (hf : Function.Injective f) (a : ℕ → ℤ) (H : ℝ) (hH : 0≤H)
    (ha : ∀i∈Finset.range N,|((a i:ℤ):ℝ)|≤H) (m : Fin 2 →₀ ℕ) :
    |((∑i∈Finset.range N,if f i=m then a i else 0 : ℤ):ℝ)|≤H := by
  classical
  by_cases hex : ∃i∈Finset.range N,f i=m
  · obtain ⟨i,hi,him⟩ := hex
    rw [Finset.sum_eq_single i]
    · simpa [him] using ha i hi
    · intro j hj hji
      rw [if_neg (fun h => hji (hf (h.trans him.symm)))]
    · exact fun h => (h hi).elim
  · have he : (∑i∈Finset.range N,if f i=m then a i else 0 : ℤ) = 0 := by
      apply Finset.sum_eq_zero
      intro i hi
      exact if_neg (fun h => hex ⟨i,hi,h⟩)
    rw [he,Int.cast_zero,abs_zero]
    exact hH

private theorem shifted_coeff_bound (F : MvPolynomial (Fin 2) ℤ) (n : ℕ)
    (hF : F.IsHomogeneous n) (j : Fin 2) (H : ℝ) (hH : 0≤H)
    (hc : ∀m : Fin 2 →₀ ℕ,|((F.coeff m:ℤ):ℝ)|≤H) :
    ∀m : Fin 2 →₀ ℕ,|((((X j^4*F).coeff m:ℤ):ℝ))|≤H := by
  classical
  intro m
  rw [C01.PcCurves.hom_repr hF,Finset.mul_sum]
  let f : ℕ → Fin 2 →₀ ℕ := fun i =>
    Finsupp.single j 4+C01.PcCurves.ex i (n-i)
  have hf : Function.Injective f := by
    intro i k he
    have h0 := congrArg (fun t : Fin 2 →₀ ℕ => t 0) he
    simp only [f,Finsupp.add_apply,C01.PcCurves.ex_zero] at h0
    omega
  have he : ∀i:ℕ,
      X j^4*(C (F.coeff (C01.PcCurves.ex i (n-i)))*X 0^i*X 1^(n-i)) =
        monomial (f i) (F.coeff (C01.PcCurves.ex i (n-i))) := by
    intro i
    rw [C01.PcCurves.monomial_ex,X_pow_eq_monomial,monomial_mul]
    simp only [one_mul]
    rfl
  simp_rw [he]
  simp only [coeff_sum,coeff_monomial]
  exact sum_single_bound (n+1) f hf
    (fun i => F.coeff (C01.PcCurves.ex i (n-i))) H hH (fun i hi => hc _) m

private theorem residual_coeff_bound (G : MvPolynomial (Fin 4) ℤ) (a : ℕ)
    (hG : ∀m∈G.support,m 0+m 1=a ∧ m 2+m 3=1)
    (H : ℝ) (hH : 0≤H)
    (hc : ∀m : Fin 4 →₀ ℕ,|((G.coeff m:ℤ):ℝ)|≤H) :
    ∀m : Fin 2 →₀ ℕ,|(((residual G).coeff m:ℤ):ℝ)|≤2*H := by
  intro m
  have hp := shifted_coeff_bound _ a (C01.PcParam.PP_hom G a hG) 1 H hH
    (C01.PcParam.PP_coeff G a hG H hH hc) m
  have hq := shifted_coeff_bound _ a (C01.PcParam.QQ_hom G a hG) 0 H hH
    (C01.PcParam.QQ_coeff G a hG H hH hc) m
  dsimp only [residual]
  rw [coeff_add,Int.cast_add]
  have hpabs := abs_le.mp (le_refl |((((X (1:Fin 2)^4*C01.PcParam.PP G).coeff m:ℤ):ℝ))|)
  have hqabs := abs_le.mp (le_refl |((((X (0:Fin 2)^4*C01.PcParam.QQ G).coeff m:ℤ):ℝ))|)
  apply abs_le.mpr
  constructor <;> linarith

private theorem np_eval_zero_one (R : MvPolynomial (Fin 2) ℤ) (n : ℕ)
    (hR : R.IsHomogeneous n) :
    eval ![(0:ℤ), 1] R = R.coeff (C01.PcCurves.ex 0 n) := by
  rw [C01.PcCurves.eval_eq_sum hR, Finset.sum_eq_single 0]
  · simp
  · intro k _ hk0
    simp [zero_pow hk0]
  · intro h
    simp at h

private theorem np_eval_one_one_bound (R : MvPolynomial (Fin 2) ℤ) (n : ℕ)
    (hR : R.IsHomogeneous n)
    (H : ℝ) (hb : ∀ i : Fin 2 →₀ ℕ, |((R.coeff i : ℤ) : ℝ)| ≤ H) :
    |((eval ![(1:ℤ), 1] R : ℤ) : ℝ)| ≤ ((n : ℝ) + 1) * H := by
  have h1 : eval ![(1:ℤ), 1] R =
      ∑ k ∈ Finset.range (n + 1), R.coeff (C01.PcCurves.ex k (n - k)) := by
    rw [C01.PcCurves.eval_eq_sum hR]
    simp
  rw [h1, Int.cast_sum]
  calc
    |∑ k ∈ Finset.range (n + 1), ((R.coeff (C01.PcCurves.ex k (n - k)) : ℤ) : ℝ)|
        ≤ ∑ k ∈ Finset.range (n + 1), |((R.coeff (C01.PcCurves.ex k (n - k)) : ℤ) : ℝ)| :=
      Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _k ∈ Finset.range (n + 1), H := Finset.sum_le_sum (fun k _ => hb _)
    _ = ((n : ℝ) + 1) * H := by
      rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul, Nat.cast_add, Nat.cast_one]

private theorem np_quadratic_power_height (k : ℕ) (hk : 1 ≤ k) (n : ℕ)
    (R : MvPolynomial (Fin 2) ℤ) (c A B C0 : ℤ) (hc : c ≠ 0)
    (e10 : eval ![(1:ℤ), 0] R = c * A ^ k)
    (e01 : eval ![(0:ℤ), 1] R = c * C0 ^ k)
    (e11 : eval ![(1:ℤ), 1] R = c * (A + B + C0) ^ k)
    (H : ℝ) (hH : 0 ≤ H)
    (b10 : |((eval ![(1:ℤ), 0] R : ℤ) : ℝ)| ≤ H)
    (b01 : |((eval ![(0:ℤ), 1] R : ℤ) : ℝ)| ≤ H)
    (b11 : |((eval ![(1:ℤ), 1] R : ℤ) : ℝ)| ≤ ((n : ℝ) + 1) * H) :
    |(A : ℝ)| ≤ ((n:ℝ) + 3) * H ∧ |(B : ℝ)| ≤ ((n:ℝ) + 3) * H ∧
      |(C0 : ℝ)| ≤ ((n:ℝ) + 3) * H := by
  have hc1 : (1:ℝ) ≤ |(c:ℝ)| := by
    have ht : (1:ℤ) ≤ |c| := by have hp := abs_pos.mpr hc; omega
    exact_mod_cast ht
  have hedge : ∀ (z : ℤ) (L : ℝ), 0 ≤ L → |(((c * z ^ k : ℤ)) : ℝ)| ≤ L →
      |(z : ℝ)| ≤ L := by
    intro z L hL hz
    have hp : |(z:ℝ)| ^ k ≤ L := by
      push_cast at hz
      rw [abs_mul, abs_pow] at hz
      exact (le_mul_of_one_le_left (by positivity) hc1).trans hz
    by_cases h0 : z = 0
    · simpa [h0] using hL
    · have hz1 : (1:ℝ) ≤ |(z:ℝ)| := by
        have ht : (1:ℤ) ≤ |z| := by have hp := abs_pos.mpr h0; omega
        exact_mod_cast ht
      have hzp : |(z:ℝ)| ≤ |(z:ℝ)| ^ k := by
        simpa only [pow_one] using pow_le_pow_right₀ hz1 hk
      exact hzp.trans hp
  have hn0 : (0:ℝ) ≤ (n:ℝ) := Nat.cast_nonneg n
  have hA : |(A:ℝ)| ≤ H := hedge A H hH (by rw [← e10]; exact b10)
  have hC : |(C0:ℝ)| ≤ H := hedge C0 H hH (by rw [← e01]; exact b01)
  have hS : |((A + B + C0 : ℤ) : ℝ)| ≤ ((n:ℝ) + 1) * H :=
    hedge (A + B + C0) _ (by positivity) (by rw [← e11]; exact b11)
  have hBeq : (B:ℝ) = ((A + B + C0 : ℤ) : ℝ) - (A:ℝ) - (C0:ℝ) := by
    rw [Int.cast_add, Int.cast_add]
    ring
  obtain ⟨hS1, hS2⟩ := abs_le.mp hS
  obtain ⟨hA1, hA2⟩ := abs_le.mp hA
  obtain ⟨hC1, hC2⟩ := abs_le.mp hC
  have hnH : 0 ≤ (n:ℝ) * H := mul_nonneg hn0 hH
  refine ⟨?_, ?_, ?_⟩
  · rw [abs_le]; constructor <;> nlinarith
  · rw [hBeq, abs_le]; constructor <;> nlinarith
  · rw [abs_le]; constructor <;> nlinarith

private theorem np_quadratic_power_height_R (k : ℕ) (hk : 1 ≤ k) (n : ℕ)
    (R : MvPolynomial (Fin 2) ℤ) (hR : R.IsHomogeneous n) (c A B C0 : ℤ) (hc : c ≠ 0)
    (hfac : R = C c * (quadraticForm A B C0) ^ k) (H : ℝ) (hH : 0 ≤ H)
    (hb : ∀ i : Fin 2 →₀ ℕ, |((R.coeff i : ℤ) : ℝ)| ≤ H) :
    |(A : ℝ)| ≤ ((n:ℝ) + 3) * H ∧ |(B : ℝ)| ≤ ((n:ℝ) + 3) * H ∧
      |(C0 : ℝ)| ≤ ((n:ℝ) + 3) * H := by
  have e10 : eval ![(1:ℤ), 0] R = c * A ^ k := by
    rw [hfac]
    simp [quadraticForm]
  have e01 : eval ![(0:ℤ), 1] R = c * C0 ^ k := by
    rw [hfac]
    simp [quadraticForm]
  have e11 : eval ![(1:ℤ), 1] R = c * (A + B + C0) ^ k := by
    rw [hfac]
    simp [quadraticForm]
  have b10 : |((eval ![(1:ℤ), 0] R : ℤ) : ℝ)| ≤ H := by
    rw [C01.PcCurves.eval_one_zero hR]
    exact hb _
  have b01 : |((eval ![(0:ℤ), 1] R : ℤ) : ℝ)| ≤ H := by
    rw [np_eval_zero_one R n hR]
    exact hb _
  have b11 := np_eval_one_one_bound R n hR H hb
  exact np_quadratic_power_height k hk n R c A B C0 hc e10 e01 e11 H hH b10 b01 b11

private theorem quadratic_power_discriminant (m : ℕ)
    (R : MvPolynomial (Fin 2) ℤ) (c A B C0 : ℤ) (hc : c≠0) (hA : A≠0)
    (hfac : R=C c*(quadraticForm A B C0)^m)
    (hnp : ¬ RationalPurePower (2*m) R) :
    B^2-4*A*C0≠0 := by
  intro hd
  have hAQ : (A:ℚ)≠0 := by exact_mod_cast hA
  have hcQ : (c:ℚ)≠0 := by exact_mod_cast hc
  have h4 : (4:ℚ)*A≠0 := mul_ne_zero (by norm_num) hAQ
  apply hnp
  refine ⟨(c:ℚ)/(4*(A:ℚ))^m,2*(A:ℚ),(B:ℚ),
    div_ne_zero hcQ (pow_ne_zero m h4),Or.inl (mul_ne_zero (by norm_num) hAQ),?_⟩
  intro r s
  have hdQ : (B:ℚ)^2-4*(A:ℚ)*C0=0 := by exact_mod_cast hd
  have he : (2*(A:ℚ)*r+(B:ℚ)*s)^2 =
      4*(A:ℚ)*((A:ℚ)*r^2+(B:ℚ)*r*s+(C0:ℚ)*s^2) := by
    linear_combination s^2*hdQ
  rw [hfac]
  simp only [map_mul,map_pow,MvPolynomial.map_C,map_intCast,
    MvPolynomial.eval_C,quadraticForm,map_add,MvPolynomial.map_X,
    MvPolynomial.eval_X,Matrix.cons_val_zero,Matrix.cons_val_one]
  change (c:ℚ)*((A:ℚ)*r^2+(B:ℚ)*r*s+(C0:ℚ)*s^2)^m =
    (c:ℚ)/(4*(A:ℚ))^m*(2*(A:ℚ)*r+(B:ℚ)*s)^(2*m)
  rw [pow_mul,he]
  simp only [mul_pow]
  field_simp [hAQ] <;> ring

private theorem both_coprime4 (d e u v : ℕ) (h : ℤ)
    (hsign : h = 1 ∨ h = -1)
    (hshift : ((e ^ 4 * v : ℕ) : ℤ) = ((d ^ 4 * u : ℕ) : ℤ) + h) :
    d.Coprime e ∧ u.Coprime v := by
  have hn := (unit_coprime (e ^ 4 * v) (d ^ 4 * u) h hsign hshift).symm
  have hdvd : d ∣ d ^ 4 * u := ⟨d ^ 3 * u, by ring⟩
  have hevd : e ∣ e ^ 4 * v := ⟨e ^ 3 * v, by ring⟩
  have huvd : u ∣ d ^ 4 * u := ⟨d ^ 4, by ring⟩
  have hvvd : v ∣ e ^ 4 * v := ⟨e ^ 4, by ring⟩
  exact ⟨hn.of_dvd hdvd hevd, hn.of_dvd huvd hvvd⟩

private theorem graph_shift_transfer
    (C E d e u v h : ℤ)
    (hgraph : C * u = E * v)
    (hshift : e ^ 4 * v - d ^ 4 * u = h) :
    let R := e ^ 4 * C - d ^ 4 * E
    R * u = h * E ∧ R * v = h * C := by
  dsimp
  constructor
  · linear_combination e ^ 4 * hgraph + E * hshift
  · linear_combination d ^ 4 * hgraph + C * hshift

private theorem graph_value_divides_resultant
    (C E d e u v h B : ℤ)
    (hsign : h = 1 ∨ h = -1)
    (hgraph : C * u = E * v)
    (hshift : e ^ 4 * v - d ^ 4 * u = h)
    (hres : (Int.gcd E C : ℤ) ∣ B)
    (hB : B ≠ 0) :
    let R := e ^ 4 * C - d ^ 4 * E
    R ≠ 0 ∧ R ∣ B := by
  dsimp
  let R : ℤ := e ^ 4 * C - d ^ 4 * E
  have htrans : R * u = h * E ∧ R * v = h * C :=
    graph_shift_transfer C E d e u v h hgraph hshift
  have hRC : R ∣ C := by
    rcases hsign with rfl | rfl
    · refine ⟨v, ?_⟩
      simpa only [one_mul] using htrans.2.symm
    · refine ⟨-v, ?_⟩
      nlinarith [htrans.2]
  have hRE : R ∣ E := by
    rcases hsign with rfl | rfl
    · refine ⟨u, ?_⟩
      simpa only [one_mul] using htrans.1.symm
    · refine ⟨-u, ?_⟩
      nlinarith [htrans.1]
  have hRgcd : R ∣ (Int.gcd E C : ℤ) := by
    first | exact Int.dvd_gcd hRE hRC | exact Int.dvd_coe_gcd hRE hRC
  have hRB : R ∣ B := hRgcd.trans hres
  have hR0 : R ≠ 0 := by
    intro hz
    rw [hz, zero_dvd_iff] at hRB
    exact hB hRB
  exact ⟨hR0, hRB⟩

private theorem second_pair_unique
    (C E d e u v u' v' h : ℤ)
    (hR0 : e ^ 4 * C - d ^ 4 * E ≠ 0)
    (hg : C * u = E * v)
    (hs : e ^ 4 * v - d ^ 4 * u = h)
    (hg' : C * u' = E * v')
    (hs' : e ^ 4 * v' - d ^ 4 * u' = h) :
    u = u' ∧ v = v' := by
  have h1 := graph_shift_transfer C E d e u v h hg hs
  have h2 := graph_shift_transfer C E d e u' v' h hg' hs'
  constructor
  · exact mul_left_cancel₀ hR0 (h1.1.trans h2.1.symm)
  · exact mul_left_cancel₀ hR0 (h1.2.trans h2.2.symm)

private theorem shift_int
    (d e u v : ℕ) (h : ℤ)
    (hs : ((e ^ 4 * v : ℕ) : ℤ) = ((d ^ 4 * u : ℕ) : ℤ) + h) :
    (e : ℤ) ^ 4 * (v : ℤ) - (d : ℤ) ^ 4 * (u : ℤ) = h := by
  push_cast at hs
  linear_combination hs

private lemma np_three_root_divisor_cover (hSt : StewartHyp)
    (N n : ℕ) (hnN : n ≤ N)
    (R : MvPolynomial (Fin 2) ℤ) (hRh : R.IsHomogeneous n)
    (hR0 : R ≠ 0) (hroots : ThreeProjectiveZeros R)
    (M : ℤ) (hM : M ≠ 0) :
    ∃ T : Finset (ℤ×ℤ),
      (∀ rs : ℤ×ℤ, Int.gcd rs.1 rs.2=1 →
        eval ![rs.1,rs.2] R ∣ M → rs ∈ T) ∧
      T.card ≤ 5600*N*M.natAbs.divisors.card^(N+1) := by
  classical
  obtain ⟨q,a,hq3,hqn,hcontent,hsqf,hkernel⟩ :=
    C01.PcKer.p_kernel n R hRh hR0 hroots
  have hqN : q ≤ N := hqn.trans hnN
  let F : ℤ×ℤ → ℤ := fun rs =>
    ∑ i : Fin (q+1), a i*rs.1^(i:ℕ)*rs.2^(q-(i:ℕ))
  obtain ⟨T,hTmem,hTcard⟩ := C01.PcLowdegRed.count_T F q (by omega)
    (hSt q hq3 a hcontent hsqf) M hM
  refine ⟨T,?_,?_⟩
  · intro rs hp hdvd
    exact hTmem rs hp ((hkernel rs.1 rs.2).trans hdvd)
  · have hn0 : M.natAbs ≠ 0 := Int.natAbs_ne_zero.mpr hM
    have hω : 2^M.natAbs.primeFactors.card ≤ M.natAbs.divisors.card :=
      C01.PcLowdegRed.two_pow_card_primeFactors_le _ hn0
    have hN2 : N < 2 ^ N := Nat.lt_two_pow_self
    have hqpow : q^(1+M.natAbs.primeFactors.card) ≤
        N*M.natAbs.divisors.card^N := by
      calc
        q^(1+M.natAbs.primeFactors.card) ≤ N^(1+M.natAbs.primeFactors.card) :=
          Nat.pow_le_pow_left hqN _
        _ = N*N^M.natAbs.primeFactors.card := by rw [pow_add,pow_one]
        _ ≤ N*(2^N)^M.natAbs.primeFactors.card :=
          Nat.mul_le_mul le_rfl (Nat.pow_le_pow_left hN2.le _)
        _ = N*(2^M.natAbs.primeFactors.card)^N := by
          rw [←pow_mul,←pow_mul,Nat.mul_comm N M.natAbs.primeFactors.card]
        _ ≤ N*M.natAbs.divisors.card^N :=
          Nat.mul_le_mul le_rfl (Nat.pow_le_pow_left hω _)
    calc
      T.card ≤ M.natAbs.divisors.card*
          (2*(2800*q^(1+M.natAbs.primeFactors.card))) := hTcard
      _ ≤ M.natAbs.divisors.card*(2*(2800*(N*M.natAbs.divisors.card^N))) :=
        Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ hqpow))
      _ = 5600*N*M.natAbs.divisors.card^(N+1) := by ring

private lemma two_linear_divisor_cover (n : ℕ) (R : MvPolynomial (Fin 2) ℤ)
    (hR : IntegralTwoLines n R) (M : ℤ) (hM : M ≠ 0) :
    ∃ T : Finset (ℤ×ℤ),
      (∀ rs : ℤ×ℤ, Int.gcd rs.1 rs.2=1 →
        eval ![rs.1,rs.2] R ∣ M → rs ∈ T) ∧
      T.card ≤ 4*M.natAbs.divisors.card^2 := by
  classical
  obtain ⟨c,a,b,a',b',j,hc,hdet,hj,hjn,hfac⟩ := hR
  let φ : ℤ×ℤ → ℤ×ℤ := fun rs => (a*rs.1+b*rs.2,a'*rs.1+b'*rs.2)
  let S : Set (ℤ×ℤ) :=
    {rs | Int.gcd rs.1 rs.2=1 ∧ eval ![rs.1,rs.2] R ∣ M}
  let U := (signedDivisors M) ×ˢ (signedDivisors M)
  have hφ := linear_pair_injective a b a' b' hdet
  have hmap : ∀ rs ∈ S, φ rs ∈ (↑U : Set (ℤ×ℤ)) := by
    intro rs hrs
    have heval : eval ![rs.1,rs.2] R =
        c*(a*rs.1+b*rs.2)^j*(a'*rs.1+b'*rs.2)^(n-j) := by
      rw [hfac]
      simp []
    have h1 : a*rs.1+b*rs.2 ∣ eval ![rs.1,rs.2] R := by
      rw [heval]
      exact dvd_mul_of_dvd_left
        (dvd_mul_of_dvd_right (dvd_pow_self _ (by omega : j ≠ 0)) c) _
    have h2 : a'*rs.1+b'*rs.2 ∣ eval ![rs.1,rs.2] R := by
      rw [heval]
      exact dvd_mul_of_dvd_right
        (dvd_pow_self _ (by omega : n-j ≠ 0)) _
    exact Finset.mem_product.mpr
      ⟨mem_signedDivisors M _ hM (h1.trans hrs.2),
       mem_signedDivisors M _ hM (h2.trans hrs.2)⟩
  have himg : (φ '' S).Finite :=
    (Finset.finite_toSet U).subset (by rintro _ ⟨rs,hrs,rfl⟩; exact hmap rs hrs)
  have hfin : S.Finite := Set.Finite.of_finite_image himg hφ.injOn
  refine ⟨hfin.toFinset,?_,?_⟩
  · intro rs hp hdvd
    exact hfin.mem_toFinset.mpr ⟨hp,hdvd⟩
  · have hs : S.ncard ≤ U.card := by
      calc
        S.ncard ≤ (↑U : Set (ℤ×ℤ)).ncard :=
          Set.ncard_le_ncard_of_injOn φ hmap hφ.injOn (Finset.finite_toSet U)
        _ = U.card := Set.ncard_coe_finset U
    rw [← Set.ncard_eq_toFinset_card S hfin]
    calc
      S.ncard ≤ U.card := hs
      _ = (signedDivisors M).card*(signedDivisors M).card := Finset.card_product _ _
      _ ≤ (2*M.natAbs.divisors.card)*(2*M.natAbs.divisors.card) :=
        Nat.mul_le_mul (signedDivisors_card M) (signedDivisors_card M)
      _ = 4*M.natAbs.divisors.card^2 := by ring

private theorem original_graph_coordinate_cap
    (x : ℝ) (hx : 2≤x) (d e u v : ℕ)
    (hd : 1≤d) (he : 1≤e) (hu : 1≤u) (hv : 1≤v)
    (hunit : e^4*v=d^4*u+1) (hcut : ((d^4*u:ℕ):ℝ)≤x) :
    (d:ℝ)≤2*x ∧ (e:ℝ)≤2*x ∧ (u:ℝ)≤2*x ∧ (v:ℝ)≤2*x := by
  have hdR : (1:ℝ)≤d := by exact_mod_cast hd
  have heR : (1:ℝ)≤e := by exact_mod_cast he
  have huR : (1:ℝ)≤u := by exact_mod_cast hu
  have hvR : (1:ℝ)≤v := by exact_mod_cast hv
  have hunitR : (e:ℝ)^4*(v:ℝ)=(d:ℝ)^4*(u:ℝ)+1 := by exact_mod_cast hunit
  have hcutR : (d:ℝ)^4*(u:ℝ)≤x := by
    simpa only [Nat.cast_mul,Nat.cast_pow] using hcut
  have hc : ∀z:ℝ,1≤z → z≤z^4 := by
    intro z hz
    calc
      z=z*1 := by ring
      _ ≤z*z^3 := mul_le_mul_of_nonneg_left (one_le_pow₀ hz) (by linarith)
      _ =z^4 := by ring
  have hdN : (d:ℝ)≤(d:ℝ)^4*(u:ℝ) := by
    calc
      (d:ℝ)≤(d:ℝ)^4 := hc d hdR
      _ ≤(d:ℝ)^4*(u:ℝ) := by
        simpa only [mul_one] using
          mul_le_mul_of_nonneg_left huR (pow_nonneg (Nat.cast_nonneg d) 4)
  have heN : (e:ℝ)≤(e:ℝ)^4*(v:ℝ) := by
    calc
      (e:ℝ)≤(e:ℝ)^4 := hc e heR
      _ ≤(e:ℝ)^4*(v:ℝ) := by
        simpa only [mul_one] using
          mul_le_mul_of_nonneg_left hvR (pow_nonneg (Nat.cast_nonneg e) 4)
  have huN : (u:ℝ)≤(d:ℝ)^4*(u:ℝ) := by
    simpa only [one_mul] using
      mul_le_mul_of_nonneg_right (one_le_pow₀ hdR : (1:ℝ)≤(d:ℝ)^4) (Nat.cast_nonneg u)
  have hvN : (v:ℝ)≤(e:ℝ)^4*(v:ℝ) := by
    simpa only [one_mul] using
      mul_le_mul_of_nonneg_right (one_le_pow₀ heR : (1:ℝ)≤(e:ℝ)^4) (Nat.cast_nonneg v)
  constructor
  · linarith
  constructor
  · linarith
  constructor <;> linarith

private lemma np_three_or_two_cover (hSt : StewartHyp) (N n : ℕ) (hnN : n ≤ N) (hN1 : 1 ≤ N)
    (R:MvPolynomial (Fin 2) ℤ) (hRh:R.IsHomogeneous n) (hR0:R≠0)
    (halt:ThreeProjectiveZeros R ∨ IntegralTwoLines n R) (B:ℤ) (hB:B≠0) :
    ∃T:Finset (ℤ×ℤ),(∀rs:ℤ×ℤ,Int.gcd rs.1 rs.2=1 →
      eval ![rs.1,rs.2] R∣B → rs∈T) ∧ T.card≤5600*N*B.natAbs.divisors.card^(N+1) := by
  rcases halt with hthree|htwo
  · exact np_three_root_divisor_cover hSt N n hnN R hRh hR0 hthree B hB
  · obtain ⟨T,hT,hcard⟩ := two_linear_divisor_cover n R htwo B hB
    refine ⟨T,hT,?_⟩
    have h1 : 1≤B.natAbs.divisors.card :=
      Nat.one_le_iff_ne_zero.mpr (by
        intro hz
        have hm := Nat.one_mem_divisors.mpr (Int.natAbs_ne_zero.mpr hB)
        have he : B.natAbs.divisors=∅ := Finset.card_eq_zero.mp hz
        simpa [he] using hm)
    have hp : B.natAbs.divisors.card^2≤B.natAbs.divisors.card^(N+1) :=
      Nat.pow_le_pow_right h1 (by omega)
    have h4 : 4 ≤ 5600*N := by omega
    calc
      T.card ≤ 4*B.natAbs.divisors.card^2 := hcard
      _ ≤ (5600*N)*B.natAbs.divisors.card^(N+1) := Nat.mul_le_mul h4 hp
      _ = 5600*N*B.natAbs.divisors.card^(N+1) := by ring

private theorem np_divisor_fee_gen
    (F L : ℝ) (hF : 0 ≤ F) (hL : 0 ≤ L) (e : ℕ) (D : ℝ) (hD : 0 ≤ D)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ C : ℝ, 0 < C ∧ ∀ x : ℝ, 2 ≤ x →
      ∀ B : ℤ, B ≠ 0 →
        |(B : ℝ)| ≤ F * x ^ L →
        D * (B.natAbs.divisors.card : ℝ) ^ e ≤ C * x ^ ε := by
  let δ : ℝ := ε / (L * e + 1)
  have hden : 0 < L * e + 1 := by positivity
  have hδ : 0 < δ := div_pos hε hden
  have hδeq : δ * (L * e + 1) = ε := div_mul_cancel₀ ε (ne_of_gt hden)
  have hexp : L * ((e:ℝ) * δ) ≤ ε := by nlinarith
  obtain ⟨Cd, hCd, hdb⟩ := C01.PcLowdegRed.divisor_bound δ hδ
  have hFd : 0 ≤ F ^ ((e:ℝ) * δ) := Real.rpow_nonneg hF _
  have hCd0 : 0 ≤ Cd := by linarith
  have h0 : 0 ≤ D * Cd ^ e * F ^ ((e:ℝ) * δ) :=
    mul_nonneg (mul_nonneg hD (pow_nonneg hCd0 e)) hFd
  refine ⟨D * Cd ^ e * F ^ ((e:ℝ) * δ) + 1, by linarith, ?_⟩
  intro x hx B hB hBb
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hcast : (B.natAbs : ℝ) = |(B : ℝ)| := by
    rw [← Int.cast_natCast, Int.natCast_natAbs, Int.cast_abs]
  have hD1 : (B.natAbs.divisors.card : ℝ) ≤ Cd * |(B : ℝ)| ^ δ := by
    have ht := hdb B.natAbs (Int.natAbs_ne_zero.mpr hB)
    rwa [hcast] at ht
  have hDe : (B.natAbs.divisors.card : ℝ) ^ e ≤ Cd ^ e * |(B : ℝ)| ^ ((e:ℝ) * δ) := by
    calc
      (B.natAbs.divisors.card : ℝ) ^ e ≤ (Cd * |(B : ℝ)| ^ δ) ^ e :=
        pow_le_pow_left₀ (Nat.cast_nonneg _) hD1 _
      _ = Cd ^ e * |(B : ℝ)| ^ ((e:ℝ) * δ) := by
        rw [mul_pow]
        congr 1
        rw [← Real.rpow_natCast, ← Real.rpow_mul (abs_nonneg _)]
        congr 1
        ring
  have hMeta : |(B : ℝ)| ^ ((e:ℝ) * δ) ≤ F ^ ((e:ℝ) * δ) * x ^ ε := by
    calc
      |(B : ℝ)| ^ ((e:ℝ) * δ) ≤ (F * x ^ L) ^ ((e:ℝ) * δ) :=
        Real.rpow_le_rpow (abs_nonneg _) hBb (by positivity)
      _ = F ^ ((e:ℝ) * δ) * (x ^ L) ^ ((e:ℝ) * δ) :=
        Real.mul_rpow hF (Real.rpow_nonneg hx0.le _)
      _ = F ^ ((e:ℝ) * δ) * x ^ (L * ((e:ℝ) * δ)) := by
        rw [← Real.rpow_mul hx0.le]
      _ ≤ F ^ ((e:ℝ) * δ) * x ^ ε :=
        mul_le_mul_of_nonneg_left
          (Real.rpow_le_rpow_of_exponent_le hx1 hexp) hFd
  calc
    D * (B.natAbs.divisors.card : ℝ) ^ e ≤ D * (Cd ^ e * |(B : ℝ)| ^ ((e:ℝ) * δ)) :=
      mul_le_mul_of_nonneg_left hDe hD
    _ ≤ D * (Cd ^ e * (F ^ ((e:ℝ) * δ) * x ^ ε)) :=
      mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left hMeta (pow_nonneg hCd0 _)) hD
    _ = (D * Cd ^ e * F ^ ((e:ℝ) * δ)) * x ^ ε := by ring
    _ ≤ (D * Cd ^ e * F ^ ((e:ℝ) * δ) + 1) * x ^ ε := by
      apply mul_le_mul_of_nonneg_right _ (Real.rpow_nonneg hx0.le _)
      linarith

private theorem np_nat_le_rpow_self (x : ℝ) (hx : 2 ≤ x) (m : ℕ) : (m : ℝ) ≤ x ^ (m : ℝ) := by
  have h1 : m < 2 ^ m := Nat.lt_two_pow_self
  have h2 : (m : ℝ) ≤ (2 : ℝ) ^ m := by exact_mod_cast h1.le
  have h3 : (2 : ℝ) ^ m ≤ x ^ m := pow_le_pow_left₀ (by norm_num) hx m
  rw [Real.rpow_natCast]
  linarith

private theorem np_hpow (x K : ℝ) (hx : 2 ≤ x) (hK : 0 ≤ K) (α N : ℕ) (hαN : α ≤ N) :
    (x ^ K) ^ (4 * α) ≤ x ^ (4 * (N:ℝ) * K) := by
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hH : 1 ≤ x ^ K := Real.one_le_rpow hx1 hK
  calc
    (x ^ K) ^ (4 * α) ≤ (x ^ K) ^ (4 * N) := pow_le_pow_right₀ hH (by omega)
    _ = x ^ (4 * (N:ℝ) * K) := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul hx0.le]
      congr 1
      push_cast
      ring

private def rationalP (a : ℕ) (G : MvPolynomial (Fin 4) ℤ) : MvPolynomial (Fin 2) ℚ :=
  ∑ i : Fin (a+1), C (((G.coeff (idx (i:ℕ) (a-(i:ℕ)) 1 0)) : ℤ) : ℚ) *
    X 0^(i:ℕ)*X 1^(a-(i:ℕ))

private def rationalQ (a : ℕ) (G : MvPolynomial (Fin 4) ℤ) : MvPolynomial (Fin 2) ℚ :=
  -(∑ i : Fin (a+1), C (((G.coeff (idx (i:ℕ) (a-(i:ℕ)) 0 1)) : ℤ) : ℚ) *
    X 0^(i:ℕ)*X 1^(a-(i:ℕ)))

private def rationalResidual (a : ℕ) (G : MvPolynomial (Fin 4) ℤ) :
    MvPolynomial (Fin 2) ℚ :=
  X 1^4*rationalP a G-X 0^4*rationalQ a G

private theorem rational_blocks_map (G : MvPolynomial (Fin 4) ℤ) (a : ℕ)
    (hG : ∀m∈G.support,m 0+m 1=a ∧ m 2+m 3=1) :
    rationalP a G=MvPolynomial.map (Int.castRingHom ℚ) (C01.PcParam.PP G) ∧
    rationalQ a G=MvPolynomial.map (Int.castRingHom ℚ) (-C01.PcParam.QQ G) := by
  have hb := canonical_blocks G a hG
  constructor
  · rw [←hb.1]
    unfold rationalP canonicalP
    rw [map_sum, ← Fin.sum_univ_eq_sum_range]
    apply Finset.sum_congr rfl
    intro i _
    simp
  · rw [←hb.2]
    unfold rationalQ canonicalQ
    rw [map_sum, ← Fin.sum_univ_eq_sum_range, ← Finset.sum_neg_distrib]
    apply Finset.sum_congr rfl
    intro i _
    simp

private theorem rational_residual_map (G : MvPolynomial (Fin 4) ℤ) (a : ℕ)
    (hG : ∀m∈G.support,m 0+m 1=a ∧ m 2+m 3=1) :
    rationalResidual a G=MvPolynomial.map (Int.castRingHom ℚ) (residual G) := by
  obtain ⟨hp,hq⟩ := rational_blocks_map G a hG
  dsimp only [rationalResidual]
  rw [hp,hq]
  simp [residual]

private theorem np_complete_internal_count (hSt : StewartHyp) (N : ℕ)
    (K : ℝ) (hK : 0≤K) (epsilon : ℝ) (hepsilon : 0<epsilon) :
    ∃C:ℝ,0<C ∧ ∀x:ℝ,2≤x → ∀alpha:ℕ, 1 ≤ alpha → alpha ≤ N →
      ∀G:MvPolynomial (Fin 4) ℤ,G≠0 →
      (∀m∈G.support,m 0+m 1=alpha ∧ m 2+m 3=1) →
      Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G) →
      (∀m:Fin 4 →₀ ℕ,|((G.coeff m:ℤ):ℝ)|≤x^K) →
      ¬ RationalPurePower (alpha+4) (residual G) →
      let S:Set ((ℕ×ℕ)×(ℕ×ℕ)) :=
        {z|1≤z.1.1 ∧ 1≤z.1.2 ∧ 1≤z.2.1 ∧ 1≤z.2.2 ∧
          z.1.2^4*z.2.2=z.1.1^4*z.2.1+1 ∧
          ((z.1.1^4*z.2.1:ℕ):ℝ)≤x ∧
          eval ![(z.1.1:ℤ),(z.1.2:ℤ),(z.2.1:ℤ),(z.2.2:ℤ)] G=0};
      S.Finite ∧ (S.ncard:ℝ)≤C*x^epsilon := by
  classical
  let L : ℝ := 4 * (N:ℝ) * K
  let J : ℝ := L + K + ((2 * N).factorial : ℝ) ^ 2 + 2 * (N:ℝ) + 16
  have hN0 : (0:ℝ) ≤ (N:ℝ) := Nat.cast_nonneg N
  have hL : 0 ≤ L := by dsimp only [L]; positivity
  have hFn : 0 ≤ ((2 * N).factorial : ℝ) ^ 2 := by positivity
  have hJ : 0 ≤ J := by dsimp only [J]; linarith
  have hJ2 : (2:ℝ) ≤ J := by dsimp only [J]; linarith
  obtain ⟨Cf,hCf,hfee⟩ := np_divisor_fee_gen (((2 * N).factorial : ℝ) ^ 2) L hFn hL
    (N + 4 + 1) (5600 * ((N + 4 : ℕ) : ℝ)) (by positivity) epsilon hepsilon
  obtain ⟨Cq,hCq,hquadcover⟩ := all_quadratic_divisor_pair_cover J hJ epsilon hepsilon
  let C : ℝ := Cf+Cq+1
  have hCpos : 0 < C := by dsimp only [C]; positivity
  refine ⟨C,hCpos,?_⟩
  intro x hx alpha halpha1 halphaN G hG0 hbi hi hheight hnpure
  let S:Set ((ℕ×ℕ)×(ℕ×ℕ)) :=
    {z|1≤z.1.1 ∧ 1≤z.1.2 ∧ 1≤z.2.1 ∧ 1≤z.2.2 ∧
      z.1.2^4*z.2.2=z.1.1^4*z.2.1+1 ∧
      ((z.1.1^4*z.2.1:ℕ):ℝ)≤x ∧
      eval ![(z.1.1:ℤ),(z.1.2:ℤ),(z.2.1:ℤ),(z.2.2:ℤ)] G=0}
  change S.Finite ∧ (S.ncard:ℝ)≤C*x^epsilon
  have hx0 : 0<x := by linarith
  have hx1 : 1≤x := by linarith
  have hH : 1≤x^K := Real.one_le_rpow hx1 hK
  let P := C01.PcParam.PP G
  let Q := -C01.PcParam.QQ G
  obtain ⟨hP,hQ,hcoeff,hno⟩ := generic_graph_data G alpha hbi hi (x^K)
    (by linarith) hheight
  have hgraph := graph_eval G alpha hbi
  obtain ⟨Bres,hBres,hBbound,hBdiv⟩ :=
    resultant_of_no_common_zero alpha halpha1 P Q hP hQ hno (x^K) hH hcoeff
  have hfac : (((2*alpha).factorial:ℝ)^2) ≤ ((2 * N).factorial : ℝ) ^ 2 := by
    have h1 : (2 * alpha).factorial ≤ (2 * N).factorial := Nat.factorial_le (by omega)
    have h2 : ((2 * alpha).factorial : ℝ) ≤ ((2 * N).factorial : ℝ) := by exact_mod_cast h1
    exact pow_le_pow_left₀ (Nat.cast_nonneg _) h2 2
  have hpow : (x^K)^(4*alpha) ≤ x^L := np_hpow x K hx hK alpha N halphaN
  have hBcap : |(Bres:ℝ)| ≤ ((2 * N).factorial : ℝ) ^ 2 * x^L :=
    hBbound.trans (mul_le_mul hfac hpow (by positivity) hFn)
  have hFx : ((2 * N).factorial : ℝ) ^ 2 ≤ x ^ (((2 * N).factorial : ℝ) ^ 2) := by
    have h := np_nat_le_rpow_self x hx ((2 * N).factorial ^ 2)
    have hc : (((2 * N).factorial ^ 2 : ℕ) : ℝ) = ((2 * N).factorial : ℝ) ^ 2 :=
      Nat.cast_pow _ _
    rw [hc] at h
    exact h
  have hBenv : |(Bres:ℝ)| ≤ x ^ J := by
    calc
      |(Bres:ℝ)| ≤ ((2 * N).factorial : ℝ) ^ 2 * x ^ L := hBcap
      _ ≤ x ^ (((2 * N).factorial : ℝ) ^ 2) * x ^ L :=
        mul_le_mul_of_nonneg_right hFx (Real.rpow_nonneg hx0.le _)
      _ = x ^ (((2 * N).factorial : ℝ) ^ 2 + L) := (Real.rpow_add hx0 _ _).symm
      _ ≤ x ^ J := Real.rpow_le_rpow_of_exponent_le hx1 (by dsimp only [J]; linarith)
  have hm14 : 2 * (N:ℝ) + 14 ≤ x ^ (2 * (N:ℝ) + 14) := by
    have h := np_nat_le_rpow_self x hx (2 * N + 14)
    have hc : ((2 * N + 14 : ℕ) : ℝ) = 2 * (N:ℝ) + 14 := by norm_num
    rw [hc] at h
    exact h
  have hHeightEnv : (((alpha + 4 : ℕ) : ℝ) + 3) * (2 * x ^ K) ≤ x ^ J := by
    have hα' : ((alpha + 4 : ℕ) : ℝ) + 3 ≤ (N:ℝ) + 7 := by
      have h : (alpha : ℝ) ≤ (N : ℝ) := by exact_mod_cast halphaN
      push_cast
      linarith
    have hxK : 0 ≤ x ^ K := Real.rpow_nonneg hx0.le _
    calc
      (((alpha + 4 : ℕ) : ℝ) + 3) * (2 * x ^ K) ≤ ((N:ℝ) + 7) * (2 * x ^ K) :=
        mul_le_mul_of_nonneg_right hα' (by positivity)
      _ = (2 * (N:ℝ) + 14) * x ^ K := by ring
      _ ≤ x ^ (2 * (N:ℝ) + 14) * x ^ K := mul_le_mul_of_nonneg_right hm14 hxK
      _ = x ^ (2 * (N:ℝ) + 14 + K) := (Real.rpow_add hx0 _ _).symm
      _ ≤ x ^ J := Real.rpow_le_rpow_of_exponent_le hx1 (by dsimp only [J]; linarith)
  have hCoordEnv : 2*x ≤ x^J := by
    have ht : 2*x ≤ x^(2:ℕ) := by nlinarith
    have h2J : ((2:ℕ):ℝ) ≤ J := by exact_mod_cast hJ2
    exact ht.trans (by
      rw [←Real.rpow_natCast]
      exact Real.rpow_le_rpow_of_exponent_le hx1 h2J)
  have hvalue : ∀d e:ℤ,eval ![d,e] (residual G)=e^4*eval ![d,e] P-d^4*eval ![d,e] Q := by
    intro d e
    simp [residual,P,Q]
  have hinfo : ∀z∈S,z.1.1.Coprime z.1.2 ∧
      eval ![(z.1.1:ℤ),(z.1.2:ℤ)] (residual G)≠0 ∧
      eval ![(z.1.1:ℤ),(z.1.2:ℤ)] (residual G)∣Bres := by
    rintro ⟨⟨d,e⟩,⟨u,v⟩⟩ hz
    rcases hz with ⟨hd,he,hu,hv,hunit,hcut,hG⟩
    have hshift : ((e^4*v:ℕ):ℤ)=((d^4*u:ℕ):ℤ)+1 := by exact_mod_cast hunit
    have hcop := (both_coprime4 d e u v 1 (Or.inl rfl) hshift).1
    have hcopZ : Int.gcd (d:ℤ) (e:ℤ)=1 := by simpa using hcop.gcd_eq_one
    have hg := hgraph d e u v hG
    have hs := shift_int d e u v 1 hshift
    have hres : (Int.gcd (eval ![(d:ℤ),(e:ℤ)] Q)
        (eval ![(d:ℤ),(e:ℤ)] P):ℤ)∣Bres := by
      simpa only [Int.gcd_comm] using hBdiv d e hcopZ
    obtain ⟨hn,hdvd⟩ := graph_value_divides_resultant
      (eval ![(d:ℤ),(e:ℤ)] P) (eval ![(d:ℤ),(e:ℤ)] Q)
      d e u v 1 Bres (Or.inl rfl) hg hs hres hBres
    exact ⟨hcop,by simpa only [hvalue] using hn,by simpa only [hvalue] using hdvd⟩
  by_cases hR0 : residual G = 0
  · have hSsub : S ⊆ (∅ : Set ((ℕ×ℕ)×(ℕ×ℕ))) := by
      intro z hz
      exfalso
      apply (hinfo z hz).2.1
      rw [hR0]
      simp
    have hSe : S = ∅ := Set.subset_empty_iff.mp hSsub
    rw [hSe]
    refine ⟨Set.finite_empty, ?_⟩
    rw [Set.ncard_empty, Nat.cast_zero]
    exact mul_nonneg hCpos.le (Real.rpow_nonneg hx0.le _)
  have hRh : (residual G).IsHomogeneous (alpha+4) := residual_homogeneous G alpha hbi
  have hcases := np_general_binary_classification (alpha+4) (by omega) (residual G) hRh hR0
  have hcover : ∃T:Finset (ℤ×ℤ),(∀z∈S,((z.1.1:ℤ),(z.1.2:ℤ))∈T) ∧
      (T.card:ℝ)≤C*x^epsilon := by
    by_cases hn : ThreeProjectiveZeros (residual G) ∨ IntegralTwoLines (alpha+4) (residual G)
    · obtain ⟨T,hT,hcard⟩ := np_three_or_two_cover hSt (N+4) (alpha+4) (by omega) (by omega)
        (residual G) hRh hR0 hn Bres hBres
      refine ⟨T,?_,?_⟩
      · intro z hz
        exact hT _ (by simpa using (hinfo z hz).1.gcd_eq_one) (hinfo z hz).2.2
      · have hpaid := hfee x hx Bres hBres hBcap
        have hcR : (T.card:ℝ) ≤ 5600 * ((N + 4 : ℕ) : ℝ) *
            (Bres.natAbs.divisors.card:ℝ)^(N + 4 + 1) := by
          exact_mod_cast hcard
        exact hcR.trans (hpaid.trans (mul_le_mul_of_nonneg_right
          (by dsimp only [C]; linarith : Cf≤C) (Real.rpow_nonneg hx0.le _)))
    · have hq : ∃ c A B C0 : ℤ, c ≠ 0 ∧ A ≠ 0 ∧ ∃ k : ℕ, 2 * k = alpha + 4 ∧
          residual G = MvPolynomial.C c * (quadraticForm A B C0) ^ k := by
        rcases hcases with h | h | h | h
        · exact (hn (Or.inl h)).elim
        · exact (hnpure h).elim
        · exact (hn (Or.inr h)).elim
        · exact h
      obtain ⟨c,A,B,C0,hc,hA,k,hk,hRf⟩ := hq
      have hk1 : 1 ≤ k := by omega
      have hRheight := residual_coeff_bound G alpha hbi (x^K) (by linarith) hheight
      obtain ⟨hAb,hBb,hCb⟩ := np_quadratic_power_height_R k hk1 (alpha+4) (residual G) hRh
        c A B C0 hc hRf (2*x^K) (by positivity) hRheight
      have hnp2 : ¬ RationalPurePower (2*k) (residual G) := by
        rw [hk]
        exact hnpure
      have hDisc := quadratic_power_discriminant k (residual G) c A B C0 hc hA hRf hnp2
      obtain ⟨T,hT,hcard⟩ := hquadcover x hx A B C0 Bres hA hBres hDisc
        (hAb.trans hHeightEnv) (hBb.trans hHeightEnv) (hCb.trans hHeightEnv) hBenv
      refine ⟨T,?_,?_⟩
      · rintro ⟨⟨d,e⟩,⟨u,v⟩⟩ hz
        have hgiven := hz
        rcases hz with ⟨hd,he,hu,hv,hunit,hcut,hGat⟩
        have hcoords := original_graph_coordinate_cap x hx d e u v hd he hu hv hunit hcut
        have hdEnv : |((d:ℤ):ℝ)|≤x^J := by
          have hd0 : (0:ℝ) ≤ (d:ℝ) := Nat.cast_nonneg d
          rw [Int.cast_natCast,abs_of_nonneg hd0]
          exact hcoords.1.trans hCoordEnv
        have heEnv : |((e:ℤ):ℝ)|≤x^J := by
          have he0 : (0:ℝ) ≤ (e:ℝ) := Nat.cast_nonneg e
          rw [Int.cast_natCast,abs_of_nonneg he0]
          exact hcoords.2.1.trans hCoordEnv
        let qval:ℤ := A*(d:ℤ)^2+B*(d:ℤ)*(e:ℤ)+C0*(e:ℤ)^2
        have hRv : eval ![(d:ℤ),(e:ℤ)] (residual G)=c*qval^k := by
          rw [hRf]
          simp [quadraticForm,qval]
        have hqn : qval≠0 := by
          intro h0
          apply (hinfo ((d,e),(u,v)) hgiven).2.1
          rw [hRv,h0,zero_pow (by omega : k≠0),mul_zero]
        have hqd : qval∣eval ![(d:ℤ),(e:ℤ)] (residual G) := by
          rw [hRv]
          exact dvd_mul_of_dvd_right (dvd_pow_self qval (by omega : k≠0)) c
        exact hT d e hdEnv heEnv hqn (hqd.trans (hinfo ((d,e),(u,v)) hgiven).2.2)
      · exact hcard.trans (mul_le_mul_of_nonneg_right
          (by dsimp only [C]; linarith : Cq≤C) (Real.rpow_nonneg hx0.le _))
  obtain ⟨T,hTmap,hTcard⟩ := hcover
  let param : ((ℕ×ℕ)×(ℕ×ℕ))→ℤ×ℤ := fun z=>((z.1.1:ℤ),(z.1.2:ℤ))
  have hinj : Set.InjOn param S := by
    rintro ⟨⟨d,e⟩,⟨u,v⟩⟩ hz ⟨⟨d',e'⟩,⟨u',v'⟩⟩ hz' hp
    change ((d:ℤ),(e:ℤ))=((d':ℤ),(e':ℤ)) at hp
    have hd : d=d' := by
      have ht := congrArg Prod.fst hp
      change (d:ℤ)=(d':ℤ) at ht
      exact_mod_cast ht
    have he : e=e' := by
      have ht := congrArg Prod.snd hp
      change (e:ℤ)=(e':ℤ) at ht
      exact_mod_cast ht
    subst d'
    subst e'
    have hRn := (hinfo ((d,e),(u,v)) hz).2.1
    rw [hvalue] at hRn
    rcases hz with ⟨hdp,hep,hup,hvp,hunit,hcut,hGat⟩
    rcases hz' with ⟨hdp',hep',hup',hvp',hunit',hcut',hGat'⟩
    have hs : (e:ℤ)^4*(v:ℤ)-(d:ℤ)^4*(u:ℤ)=1 := by
      have ht : ((e^4*v:ℕ):ℤ)=((d^4*u:ℕ):ℤ)+1 := by exact_mod_cast hunit
      exact shift_int d e u v 1 ht
    have hs' : (e:ℤ)^4*(v':ℤ)-(d:ℤ)^4*(u':ℤ)=1 := by
      have ht : ((e^4*v':ℕ):ℤ)=((d^4*u':ℕ):ℤ)+1 := by exact_mod_cast hunit'
      exact shift_int d e u' v' 1 ht
    obtain ⟨huv,hvv⟩ := second_pair_unique
      (eval ![(d:ℤ),(e:ℤ)] P) (eval ![(d:ℤ),(e:ℤ)] Q)
      d e u v u' v' 1 hRn (hgraph d e u v hGat) hs (hgraph d e u' v' hGat') hs'
    have hu : u=u' := by exact_mod_cast huv
    have hv : v=v' := by exact_mod_cast hvv
    subst u'
    subst v'
    rfl
  have hmap : ∀z∈S,param z∈(↑T:Set (ℤ×ℤ)) := hTmap
  have himg : (param '' S).Finite :=
    (Finset.finite_toSet T).subset (by rintro _ ⟨z,hz,rfl⟩; exact hmap z hz)
  have hfin : S.Finite := Set.Finite.of_finite_image himg hinj
  have hcN : S.ncard≤T.card := by
    calc
      S.ncard≤(↑T:Set (ℤ×ℤ)).ncard :=
        Set.ncard_le_ncard_of_injOn param hmap hinj (Finset.finite_toSet T)
      _ =T.card := Set.ncard_coe_finset T
  exact ⟨hfin,(show (S.ncard:ℝ)≤(T.card:ℝ) by exact_mod_cast hcN).trans hTcard⟩

private theorem np_complete_original_count :
(let StewartHyp : Prop := ∀ q : ℕ, 3 ≤ q → ∀ a : Fin (q + 1) → ℤ, Finset.univ.gcd a = 1 → Squarefree (∑ i : Fin (q + 1), MvPolynomial.C (a i : ℚ) * MvPolynomial.X (0 : Fin 2) ^ (i : ℕ) * MvPolynomial.X (1 : Fin 2) ^ (q - (i : ℕ))) → ∀ m : ℤ, m ≠ 0 → {rs : ℤ × ℤ | Int.gcd rs.1 rs.2 = 1 ∧ ∑ i : Fin (q + 1), a i * rs.1 ^ (i : ℕ) * rs.2 ^ (q - (i : ℕ)) = m}.encard ≤ ((2800 * q ^ (1 + m.natAbs.primeFactors.card) : ℕ) : ℕ∞);
