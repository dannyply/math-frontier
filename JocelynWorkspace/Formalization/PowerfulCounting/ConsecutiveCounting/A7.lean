      _ ≤8*(h.natAbs.divisors.card:ℝ)*(4*(Real.log K/Real.log 2)+2) :=
        mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_left (by exact_mod_cast divisor_card_mono_int j.val.2 h hh h0.2)
            (by norm_num)) hlog
  choose F hFcover hFcard using hfamily
  let phi : Sigma (fun _ : E => ℤ×ℤ) → ℤ×ℤ := fun z =>
    ((z.1.val.1:ℤ)*z.2.1,(z.1.val.1:ℤ)*z.2.2)
  let T := ((Finset.univ : Finset E).sigma F).image phi
