def R4 (A B : ℤ) : ℤ := A^3+7*A^2*B+21*A*B^2+35*B^3
def J4 (M B : ℤ) : ℤ := M^3+4*M^2*B+10*M*B^2+20*B^3

lemma complement (A B : ℤ) :
    A^4*R4 A B+B^4*R4 B A=(A+B)^7 := by
  dsimp [R4]
  ring

lemma translation (M B : ℤ) : R4 (M-B) B=J4 M B := by
  dsimp [R4,J4]
  ring

lemma line_level (a b d0 e0 m r : ℤ) (hbase : a*d0+b*e0=1) :
    a*(m*d0+b*r)+b*(m*e0-a*r)=m := by
  linear_combination m*hbase

lemma paired_unit (a b m q d e : ℤ) (hm : m≠0)
    (hlevel : a*d+b*e=m)
    (h1 : m^7 ∣ q*e^4-a^4*R4 (a*d) (b*e))
    (h2 : m^7 ∣ q*d^4+b^4*R4 (b*e) (a*d)) :
    ∃ u v : ℤ,e^4*v-d^4*u=1 := by
  obtain ⟨u,hu⟩ := h1
  obtain ⟨v,hv⟩ := h2
  have hc := complement (a*d) (b*e)
  rw [hlevel] at hc
  have hz : m^7*(e^4*v-d^4*u-1)=0 := by
    linear_combination -e^4*hv+d^4*hu+hc
  have hz' : e^4*v-d^4*u-1=0 :=
    (mul_eq_zero.mp hz).resolve_left (pow_ne_zero 7 hm)
  exact ⟨u,v,by linarith⟩

lemma unit_pair_not_both (p : ℕ) [Fact p.Prime]
    (d e : ℤ) (hunit : ∃ u v : ℤ,e^4*v-d^4*u=1) :
    ¬ ((p:ℤ)∣d ∧ (p:ℤ)∣e) := by
  rintro ⟨hd,he⟩
  obtain ⟨u,v,huv⟩ := hunit
  have hd0 : (d : ZMod p)=0 :=
    (ZMod.intCast_zmod_eq_zero_iff_dvd d p).mpr hd
  have he0 : (e : ZMod p)=0 :=
    (ZMod.intCast_zmod_eq_zero_iff_dvd e p).mpr he
  have h := congrArg (fun z : ℤ => (z : ZMod p)) huv
  push_cast at h
  simp [hd0,he0] at h

lemma coordinate_unit (p : ℕ) [Fact p.Prime]
    (a b m d e : ℤ) (ha : ¬ (p:ℤ)∣a) (hpm : (p:ℤ)∣m)
    (hlevel : a*d+b*e=m)
    (hunit : ∃ u v : ℤ,e^4*v-d^4*u=1) :
    ¬ (p:ℤ)∣e := by
  intro he
  have ha0 : (a : ZMod p)≠0 :=
    fun h => ha ((ZMod.intCast_zmod_eq_zero_iff_dvd a p).mp h)
  have he0 : (e : ZMod p)=0 :=
    (ZMod.intCast_zmod_eq_zero_iff_dvd e p).mpr he
  have hm0 : (m : ZMod p)=0 :=
    (ZMod.intCast_zmod_eq_zero_iff_dvd m p).mpr hpm
  have h := congrArg (fun z : ℤ => (z : ZMod p)) hlevel
  push_cast at h
  have hd0 : (d : ZMod p)=0 := by
    have hz : (a : ZMod p)*(d : ZMod p)=0 := by simpa [he0,hm0] using h
    exact (mul_eq_zero.mp hz).resolve_left ha0
  have hd : (p:ℤ)∣d := (ZMod.intCast_zmod_eq_zero_iff_dvd d p).mp hd0
  exact unit_pair_not_both p d e hunit ⟨hd,he⟩

lemma coefficient_orientation (p : ℕ) [Fact p.Prime]
    (a b d0 e0 : ℤ) (hbase : a*d0+b*e0=1) :
    ¬ (p:ℤ)∣a ∨ ¬ (p:ℤ)∣b := by
  by_cases ha : (p:ℤ)∣a
  · right
    intro hb
    have ha0 : (a : ZMod p)=0 :=
      (ZMod.intCast_zmod_eq_zero_iff_dvd a p).mpr ha
    have hb0 : (b : ZMod p)=0 :=
      (ZMod.intCast_zmod_eq_zero_iff_dvd b p).mpr hb
    have h := congrArg (fun z : ℤ => (z : ZMod p)) hbase
    push_cast at h
    simp [ha0,hb0] at h
  · exact Or.inl ha

lemma cancel_unit_power (p : ℕ) [Fact p.Prime] (n : ℕ) (u : ℤ)
    (hu : ¬ (p:ℤ)∣u) :
    ∀ v : ℤ,(p:ℤ)^n∣v*u → (p:ℤ)^n∣v := by
  have hp : (p:ℤ)≠0 := by exact_mod_cast (Fact.out : p.Prime).ne_zero
  induction n with
  | zero => intro v hv; simp
  | succ n ih =>
    intro v hv
    have hdiv : (p:ℤ)∣v*u := by
      simpa only [pow_one] using
        (pow_dvd_pow (p:ℤ) (by omega : 1≤n+1)).trans hv
    have hu0 : (u : ZMod p)≠0 :=
      fun h => hu ((ZMod.intCast_zmod_eq_zero_iff_dvd u p).mp h)
    have hz : (v : ZMod p)*(u : ZMod p)=0 := by
      have h := (ZMod.intCast_zmod_eq_zero_iff_dvd (v*u) p).mpr hdiv
      simpa only [Int.cast_mul] using h
    have hv0 : (v : ZMod p)=0 := (mul_eq_zero.mp hz).resolve_right hu0
    obtain ⟨w,hw⟩ := (ZMod.intCast_zmod_eq_zero_iff_dvd v p).mp hv0
    obtain ⟨t,ht⟩ := hv
    have hrest : w*u=(p:ℤ)^n*t := by
      apply mul_left_cancel₀ hp
      calc
        (p:ℤ)*(w*u)=v*u := by rw [hw];ring
        _ = (p:ℤ)^(n+1)*t := ht
        _ = (p:ℤ)*((p:ℤ)^n*t) := by rw [pow_succ];ring
    obtain ⟨s,hs⟩ := ih w ⟨t,hrest⟩
    refine ⟨s,?_⟩
    rw [hw,hs,pow_succ]
    ring

lemma cancel_pow_div (p : ℤ) (hp : p≠0) (v k : ℕ) (hvk : v≤k) (z : ℤ) :
    p^k∣p^v*z ↔ p^(k-v)∣z := by
  have hpow : p^k=p^v*p^(k-v) := by rw [← pow_add,Nat.add_sub_of_le hvk]
  rw [hpow]
  constructor
  · rintro ⟨w,hw⟩
    refine ⟨w,?_⟩
    apply mul_left_cancel₀ (pow_ne_zero v hp)
    simpa only [mul_assoc] using hw
  · rintro ⟨w,hw⟩
    refine ⟨w,?_⟩
    rw [hw]
    ring

def numerator4 (Q a M B : ℤ) : Polynomial ℤ :=
  monomial 4 Q-monomial 0 (a^4*M^3)-monomial 1 (4*a^4*M^2*B)-
    monomial 2 (10*a^4*M*B^2)-monomial 3 (20*a^4*B^3)

lemma numerator4_eval (Q a M B e : ℤ) :
    (numerator4 Q a M B).eval e=Q*e^4-a^4*J4 M (B*e) := by
  simp [numerator4,J4]
  ring

lemma numerator4_degree (Q a M B : ℤ) :
    (numerator4 Q a M B).natDegree≤4 := by
  apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
  intro j hj
  simp only [numerator4,Polynomial.coeff_sub,Polynomial.coeff_monomial]
  split_ifs <;> simp_all <;> omega

lemma numerator4_coeff_zero (Q a M B : ℤ) :
    (numerator4 Q a M B).coeff 0= -(a^4*M^3) := by
  simp only [numerator4,Polynomial.coeff_sub,Polynomial.coeff_monomial]
  norm_num

lemma numerator4_coeff_three (Q a M B : ℤ) :
    (numerator4 Q a M B).coeff 3= -20*a^4*B^3 := by
  simp only [numerator4,Polynomial.coeff_sub,Polynomial.coeff_monomial]
  norm_num <;> ring

lemma inverse_translation (a b d e m q : ℤ) (hlevel : a*d+b*e=m) :
    q*e^4-a^4*R4 (a*d) (b*e)=q*e^4-a^4*J4 m (b*e) := by
  have ha : a*d=m-b*e := by linarith only [hlevel]
  rw [ha,translation]

lemma actual_content_divisor (p g : ℕ) [Fact p.Prime]
    (m b q a e M B : ℤ)
    (hm : m=(p:ℤ)^g*M) (hb : b=(p:ℤ)^g*B)
    (he : ¬ (p:ℤ)∣e)
    (hu : m^7∣q*e^4-a^4*J4 m (b*e)) :
    (p:ℤ)^(3*g)∣q := by
  have hpow : (p:ℤ)^(3*g)=((p:ℤ)^g)^3 := by
    rw [Nat.mul_comm 3 g,pow_mul]
  have hd1 : (p:ℤ)^(3*g)∣m^7 := by
    refine ⟨((p:ℤ)^g)^4*M^7,?_⟩
    rw [hm,hpow]
    ring
  have hd2 : (p:ℤ)^(3*g)∣a^4*J4 m (b*e) := by
    refine ⟨a^4*J4 M (B*e),?_⟩
    rw [hm,hb,hpow]
    dsimp [J4]
    ring
  have hd : (p:ℤ)^(3*g)∣q*e^4 := by
    simpa only [sub_add_cancel] using dvd_add (hd1.trans hu) hd2
  have hene : (e : ZMod p)≠0 :=
    fun h => he ((ZMod.intCast_zmod_eq_zero_iff_dvd e p).mp h)
  have he4 : ¬ (p:ℤ)∣e^4 := by
    intro h
    have hz := (ZMod.intCast_zmod_eq_zero_iff_dvd (e^4) p).mpr h
    have hn : (e : ZMod p)^4≠0 := pow_ne_zero 4 hene
    exact hn (by simpa using hz)
  exact cancel_unit_power p (3*g) (e^4) he4 q hd

lemma actual_reduced_root (p alpha g : ℕ)
    (hp : (p:ℤ)≠0) (hg : g≤alpha)
    (m b q a e M B m0 Q : ℤ)
    (hm : m=(p:ℤ)^g*M) (hb : b=(p:ℤ)^g*B)
    (hmfull : m=(p:ℤ)^alpha*m0)
    (hq : q=(p:ℤ)^(3*g)*Q)
    (hu : m^7∣q*e^4-a^4*J4 m (b*e)) :
    (p:ℤ)^(7*alpha-3*g)∣(numerator4 Q a M B).eval e := by
  have hpow : (p:ℤ)^(3*g)=((p:ℤ)^g)^3 := by
    rw [Nat.mul_comm 3 g,pow_mul]
  have hscaled :
      (p:ℤ)^(3*g)*(numerator4 Q a M B).eval e =
        q*e^4-a^4*J4 m (b*e) := by
    rw [numerator4_eval,hm,hb,hq,hpow]
    dsimp [J4]
    ring
  have hfull : (p:ℤ)^(7*alpha)∣m^7 := by
    refine ⟨m0^7,?_⟩
    rw [hmfull,Nat.mul_comm 7 alpha,pow_mul]
    ring
  apply (cancel_pow_div (p:ℤ) hp (3*g) (7*alpha) (by omega)
    ((numerator4 Q a M B).eval e)).mp
  rw [hscaled]
  exact hfull.trans hu

lemma numerator4_primitive_of_constant (p : ℕ) [Fact p.Prime]
    (Q a M B : ℤ) (ha : ¬ (p:ℤ)∣a) (hM : ¬ (p:ℤ)∣M) :
    Polynomial.map (Int.castRingHom (ZMod p)) (numerator4 Q a M B)≠0 := by
  intro hz
  have hc := congrArg (fun F : Polynomial (ZMod p) => F.coeff 0) hz
  simp only [Polynomial.coeff_map,Polynomial.coeff_zero,numerator4_coeff_zero] at hc
  have ha' : (a : ZMod p)≠0 :=
    fun h => ha ((ZMod.intCast_zmod_eq_zero_iff_dvd a p).mp h)
  have hM' : (M : ZMod p)≠0 :=
    fun h => hM ((ZMod.intCast_zmod_eq_zero_iff_dvd M p).mp h)
  have hnon : -((a : ZMod p)^4*(M : ZMod p)^3)≠0 :=
    neg_ne_zero.mpr (mul_ne_zero (pow_ne_zero 4 ha') (pow_ne_zero 3 hM'))
  exact hnon (by simpa using hc)

lemma high_overlap_cover (p alpha : ℕ) [Fact p.Prime]
    (Q a M B : ℤ) (ha : ¬ (p:ℤ)∣a) (hM : ¬ (p:ℤ)∣M) :
    ∃ T : Finset ℤ,T.card≤4 ∧
      ∀ e : ℤ,(p:ℤ)^(4*alpha)∣(numerator4 Q a M B).eval e →
        ∃ t∈T,(p:ℤ)^alpha∣e-t := by
  exact JocelynClaims.claim_ad0d719f61462fab2d173c4ec7c4585e8385728a4df3a925adbbb237ee7ab1ef
    p 4 alpha (numerator4 Q a M B) Fact.out (by norm_num)
    (numerator4_degree Q a M B) (numerator4_primitive_of_constant p Q a M B ha hM)

lemma gcd_nonzero (m z : ℤ) (hm : m≠0) : Int.gcd m z≠0 := by
  have hm0 : m.natAbs≠0 := Nat.ne_of_gt (Int.natAbs_pos.mpr hm)
  intro hg
  have hd : Int.gcd m z∣m.natAbs := Nat.gcd_dvd_left _ _
  rw [hg] at hd
  exact hm0 (by simpa using hd)

lemma gcd_valuation_le (p : ℕ) [Fact p.Prime] (m z : ℤ) (hm : m≠0) :
    padicValNat p (Int.gcd m z)≤padicValNat p m.natAbs := by
  have hG : Int.gcd m z≠0 := gcd_nonzero m z hm
  have hm0 : m.natAbs≠0 := Nat.ne_of_gt (Int.natAbs_pos.mpr hm)
  have hpg : p^(padicValNat p (Int.gcd m z))∣Int.gcd m z :=
    (padicValNat_dvd_iff_le hG).mpr le_rfl
  exact (padicValNat_dvd_iff_le hm0).mp
    (hpg.trans (Nat.gcd_dvd_left _ _))

lemma valuation_positive (p : ℕ) [Fact p.Prime] (m : ℤ) (hm : m≠0)
    (hpm : p∣m.natAbs) : 1≤padicValNat p m.natAbs := by
  have hm0 : m.natAbs≠0 := Nat.ne_of_gt (Int.natAbs_pos.mpr hm)
  exact (padicValNat_dvd_iff_le hm0).mp (by simpa using hpm)

lemma integer_valuation_factor (p : ℕ) [Fact p.Prime] (z : ℤ) (hz : z≠0) :
    ∃ Z : ℤ,z=(p:ℤ)^(padicValNat p z.natAbs)*Z ∧ ¬ (p:ℤ)∣Z := by
  let v := padicValNat p z.natAbs
  have hz0 : z.natAbs≠0 := Nat.ne_of_gt (Int.natAbs_pos.mpr hz)
  have hdN : p^v∣z.natAbs := (padicValNat_dvd_iff_le hz0).mpr le_rfl
  have hdZ : (p:ℤ)^v∣z :=
    (Int.natAbs_dvd_natAbs).mp (by simpa using hdN)
  obtain ⟨Z,hZ⟩ := hdZ
  refine ⟨Z,hZ,?_⟩
  rintro ⟨w,hw⟩
  have hnext : (p:ℤ)^(v+1)∣z := by
    refine ⟨w,?_⟩
    rw [hZ,hw,pow_succ]
    ring
  have hnextN : p^(v+1)∣z.natAbs := by
    have hh := (Int.natAbs_dvd_natAbs).mpr hnext
    simpa using hh
  have hle := (padicValNat_dvd_iff_le hz0).mp hnextN
  dsimp [v] at hle
  omega

lemma other_coefficient_factor (p : ℕ) [Fact p.Prime]
    (m a b : ℤ) (hm : m≠0) (ha : ¬ (p:ℤ)∣a) :
    let g := padicValNat p (Int.gcd m (a*b));
    ∃ B : ℤ,b=(p:ℤ)^g*B ∧
      (g<padicValNat p m.natAbs → ¬ (p:ℤ)∣B) := by
  intro g
  have hG : Int.gcd m (a*b)≠0 := gcd_nonzero m (a*b) hm
  have hpg : p^g∣Int.gcd m (a*b) :=
    (padicValNat_dvd_iff_le hG).mpr le_rfl
  have hdN : p^g∣(a*b).natAbs := hpg.trans (Nat.gcd_dvd_right _ _)
  have hdZ : (p:ℤ)^g∣a*b :=
    (Int.natAbs_dvd_natAbs).mp (by simpa using hdN)
  have hdb : (p:ℤ)^g∣b :=
    cancel_unit_power p g a ha b (by simpa only [mul_comm] using hdZ)
  obtain ⟨B,hB⟩ := hdb
  refine ⟨B,hB,?_⟩
  intro hlt hdiv
  obtain ⟨w,hw⟩ := hdiv
  have hdb' : (p:ℤ)^(g+1)∣b := by
    refine ⟨w,?_⟩
    rw [hB,hw,pow_succ]
    ring
  have hdm : p^(g+1)∣m.natAbs :=
    (padicValNat_dvd_iff_le
      (Nat.ne_of_gt (Int.natAbs_pos.mpr hm))).mpr (by omega)
  have hdab : p^(g+1)∣(a*b).natAbs := by
    have hh : (p:ℤ)^(g+1)∣a*b := dvd_mul_of_dvd_right hdb' a
    have hh' := (Int.natAbs_dvd_natAbs).mpr hh
    simpa using hh'
  have hdG : p^(g+1)∣Int.gcd m (a*b) := Nat.dvd_gcd hdm hdab
  have hle := (padicValNat_dvd_iff_le hG).mp hdG
  change g+1≤g at hle
  omega

lemma gcd_zero_coordinate (p : ℕ) (m a b : ℤ) (hab : a*b=0) :
    padicValNat p (Int.gcd m (a*b))=padicValNat p m.natAbs := by
  simp [hab]

lemma pullback_cover (p n : ℕ) [Fact p.Prime]
    (a c : ℤ) (ha : ¬ (p:ℤ)∣a) (Pred : ℤ→Prop) (U : Finset ℤ)
    (hU : ∀ r : ℤ,Pred r → ∃ u∈U,(p:ℤ)^n∣(c+a*r)-u) :
    ∃ T : Finset ℤ,T.card≤U.card ∧
      ∀ r : ℤ,Pred r → ∃ t∈T,(p:ℤ)^n∣r-t := by
  classical
  let pick : ℤ→ℤ := fun u =>
    if h : ∃ r : ℤ,Pred r ∧ (p:ℤ)^n∣(c+a*r)-u then Classical.choose h else 0
  refine ⟨U.image pick,Finset.card_image_le,?_⟩
  intro r hr
  obtain ⟨u,hu,hru⟩ := hU r hr
  have hex : ∃ t : ℤ,Pred t ∧ (p:ℤ)^n∣(c+a*t)-u := ⟨r,hr,hru⟩
  have hpr : Pred (pick u) ∧ (p:ℤ)^n∣(c+a*pick u)-u := by
    dsimp only [pick]
    rw [dif_pos hex]
    exact Classical.choose_spec hex
  refine ⟨pick u,Finset.mem_image.mpr ⟨u,hu,rfl⟩,?_⟩
  have hh := dvd_sub hru hpr.2
  have hdiff : ((c+a*r)-u)-((c+a*pick u)-u)=(r-pick u)*a := by ring
  have hh' : (p:ℤ)^n∣(r-pick u)*a := by
    rwa [hdiff] at hh
  exact cancel_unit_power p n a ha (r-pick u) hh'

lemma refine_cover (p gamma mu : ℕ) (hp : 0<p) (hgm : gamma ≤ mu)
    (Pred : ℤ→Prop) (U : Finset ℤ)
    (hU : ∀ r : ℤ,Pred r → ∃ u∈U,(p:ℤ)^gamma∣r-u) :
    ∃ T : Finset ℤ,T.card≤U.card*p^(mu-gamma) ∧
      ∀ r : ℤ,Pred r → ∃ t∈T,(p:ℤ)^mu∣r-t := by
  classical
  let L : ℕ := p^(mu-gamma)
  let f : ℤ×ℕ→ℤ := fun z => z.1+(p:ℤ)^gamma*(z.2:ℤ)
  let T := (U ×ˢ Finset.range L).image f
  refine ⟨T,?_,?_⟩
  · exact Finset.card_image_le.trans (by simp [L])
  · intro r hr
    obtain ⟨u,hu,z,hz⟩ := hU r hr
    have hL : 0<(L:ℤ) := by exact_mod_cast (pow_pos hp (mu-gamma))
    let j : ℕ := (z%(L:ℤ)).toNat
    have hjcast : (j:ℤ)=z%(L:ℤ) :=
      Int.toNat_of_nonneg (Int.emod_nonneg _ (ne_of_gt hL))
    have hjlt : j<L := by
      have hh : (j:ℤ)<(L:ℤ) := by
        rw [hjcast]
        exact Int.emod_lt_of_pos _ hL
      exact_mod_cast hh
    have hmod : Int.ModEq (L:ℤ) z (j:ℤ) := by
      change z%(L:ℤ)=(j:ℤ)%(L:ℤ)
      rw [hjcast]
      simp
    have hzj : (L:ℤ)∣z-(j:ℤ) := Int.modEq_iff_dvd.mp hmod.symm
    obtain ⟨w,hw⟩ := hzj
    refine ⟨f (u,j),Finset.mem_image.mpr
      ⟨(u,j),Finset.mem_product.mpr ⟨hu,Finset.mem_range.mpr hjlt⟩,rfl⟩,
      w,?_⟩
    have hpw : (p:ℤ)^mu=(p:ℤ)^gamma*(L:ℤ) := by
      dsimp [L]
      rw [← pow_add,Nat.add_sub_of_le hgm]
    dsimp [f]
    have hz' : r=u+(p:ℤ)^gamma*z := by linarith only [hz]
    rw [hz',hpw]
    linear_combination (p:ℤ)^gamma*hw

lemma prime_unit_mul (p : ℕ) [Fact p.Prime] (a b : ℤ)
    (ha : ¬ (p:ℤ)∣a) (hb : ¬ (p:ℤ)∣b) : ¬ (p:ℤ)∣a*b := by
  intro hh
  have ha0 : (a : ZMod p)≠0 :=
    fun h => ha ((ZMod.intCast_zmod_eq_zero_iff_dvd a p).mp h)
  have hb0 : (b : ZMod p)≠0 :=
    fun h => hb ((ZMod.intCast_zmod_eq_zero_iff_dvd b p).mp h)
  have hz := (ZMod.intCast_zmod_eq_zero_iff_dvd (a*b) p).mpr hh
  exact (mul_ne_zero ha0 hb0) (by simpa only [Int.cast_mul] using hz)

lemma prime_unit_power (p : ℕ) [Fact p.Prime] (a : ℤ) (n : ℕ)
    (ha : ¬ (p:ℤ)∣a) : ¬ (p:ℤ)∣a^n := by
  intro hh
  have ha0 : (a : ZMod p)≠0 :=
    fun h => ha ((ZMod.intCast_zmod_eq_zero_iff_dvd a p).mp h)
  have hz := (ZMod.intCast_zmod_eq_zero_iff_dvd (a^n) p).mpr hh
  exact (pow_ne_zero n ha0) (by simpa only [Int.cast_pow] using hz)

lemma numerator4_critical_coefficient (p : ℕ) [Fact p.Prime]
    (Q a M B : ℤ) (ha : ¬ (p:ℤ)∣a) (hB : ¬ (p:ℤ)∣B) :
    ¬ (p:ℤ)^(padicValNat p 20+1)∣(numerator4 Q a M B).coeff 3 := by
  intro hh
  rw [numerator4_coeff_three] at hh
  have hu : ¬ (p:ℤ)∣-(a^4*B^3) := by
    intro hd
    apply prime_unit_mul p (a^4) (B^3)
      (prime_unit_power p a 4 ha) (prime_unit_power p B 3 hB)
    exact dvd_neg.mp hd
  have heq : (20:ℤ)*(-(a^4*B^3))= -20*a^4*B^3 := by ring
  rw [←heq] at hh
  have h20 : (p:ℤ)^(padicValNat p 20+1)∣(20:ℤ) :=
    cancel_unit_power p _ (-(a^4*B^3)) hu 20 hh
  have h20N : p^(padicValNat p 20+1)∣20 := by
    have h := (Int.natAbs_dvd_natAbs).mpr h20
    simpa using h
  have hle := (padicValNat_dvd_iff_le (by norm_num : (20:ℕ)≠0)).mp h20N
  omega

lemma bounded_content_cover (p g h c : ℕ) [Fact p.Prime]
    (hh : 1≤h) (hc : h≤c) (F : Polynomial ℤ) (hdeg : F.natDegree≤4)
    (hcrit : ¬ (p:ℤ)^(c+1)∣F.coeff 3) :
    ∃ T : Finset ℤ,T.card≤4*p^(8*c) ∧
      ∀ e : ℤ,(p:ℤ)^(4*g+7*h)∣F.eval e →
        ∃ t∈T,(p:ℤ)^(g+7*h)∣e-t := by
  classical
  have hp : p.Prime := Fact.out
  have hp0 : (p:ℤ)≠0 := by exact_mod_cast hp.ne_zero
  rcases extract_content p (c+1) F with hAll | ⟨v,hv,H,heq,hH⟩
  · exact False.elim (hcrit ((Polynomial.C_dvd_iff_dvd_coeff _ _).mp hAll 3))
  have hdegH : H.natDegree≤4 := by
    apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
    intro j hj
    have hz : F.coeff j=0 := Polynomial.coeff_eq_zero_of_natDegree_lt (lt_of_le_of_lt hdeg hj)
    rw [heq,Polynomial.coeff_C_mul] at hz
    exact (mul_eq_zero.mp hz).resolve_left (pow_ne_zero v hp0)
  obtain ⟨R,hRc,hRv⟩ :=
    JocelynClaims.claim_ad0d719f61462fab2d173c4ec7c4585e8385728a4df3a925adbbb237ee7ab1ef
      p 4 (g-c) H hp (by norm_num) hdegH hH
  have hR : ∀ e : ℤ,(p:ℤ)^(4*g+7*h)∣F.eval e →
      ∃ t∈R,(p:ℤ)^(g-c)∣e-t := by
    intro e he
    apply hRv e
    by_cases hgc : g≤c
    · have hg0 : g-c=0 := Nat.sub_eq_zero_of_le hgc
      simp [hg0]
    · have hvN : v≤4*g+7*h := by omega
      have heval : F.eval e=(p:ℤ)^v*H.eval e := by rw [heq];simp
      have hrest : (p:ℤ)^(4*g+7*h-v)∣H.eval e :=
        (cancel_pow_div (p:ℤ) hp0 v (4*g+7*h) hvN (H.eval e)).mp
          (by simpa only [heval] using he)
      exact (pow_dvd_pow (p:ℤ) (by omega : 4*(g-c)≤4*g+7*h-v)).trans hrest
  obtain ⟨T,hTc,hTv⟩ := refine_cover p (g-c) (g+7*h) hp.pos
    (by omega) (fun e => (p:ℤ)^(4*g+7*h)∣F.eval e) R hR
  refine ⟨T,hTc.trans ?_,hTv⟩
  have hdiff : (g+7*h)-(g-c)≤8*c := by omega
  have hpow : p^((g+7*h)-(g-c))≤p^(8*c) :=
    pow_le_pow_right₀ (by omega : 1≤p) hdiff
  exact Nat.mul_le_mul hRc hpow

lemma bad_prime_normalized_cover (p g h : ℕ) [Fact p.Prime]
    (hh : 1≤h) (hc : h≤padicValNat p 20)
    (Q a M B : ℤ) (ha : ¬ (p:ℤ)∣a) (hB : ¬ (p:ℤ)∣B) :
    ∃ T : Finset ℤ,T.card≤4*p^(8*padicValNat p 20) ∧
      ∀ e : ℤ,(p:ℤ)^(4*g+7*h)∣(numerator4 Q a M B).eval e →
        ∃ t∈T,(p:ℤ)^(g+7*h)∣e-t := by
  exact bounded_content_cover p g h (padicValNat p 20) hh hc
    (numerator4 Q a M B) (numerator4_degree Q a M B)
    (numerator4_critical_coefficient p Q a M B ha hB)

def quotient4 (Q a P pi M B Z : ℤ) : Polynomial ℤ :=
  monomial 4 Q-monomial 0 (a^4*P^2*pi^3*M^3)-
    monomial 1 (4*a^4*P*pi^2*M^2*B)-
    monomial 2 (10*a^4*pi*M*B^2)-monomial 3 (a^4*Z*B^3)

lemma quotient4_eval (Q a P pi M B Z x : ℤ) :
    (quotient4 Q a P pi M B Z).eval x =
      Q*x^4-a^4*P^2*pi^3*M^3-4*a^4*P*pi^2*M^2*B*x-
        10*a^4*pi*M*B^2*x^2-a^4*Z*B^3*x^3 := by
  simp [quotient4]

lemma quotient4_derivative_eval (Q a P pi M B Z x : ℤ) :
    (quotient4 Q a P pi M B Z).derivative.eval x =
      4*Q*x^3-4*a^4*P*pi^2*M^2*B-
        20*a^4*pi*M*B^2*x-3*a^4*Z*B^3*x^2 := by
  simp only [quotient4,Polynomial.derivative_sub,Polynomial.derivative_monomial,
    Polynomial.eval_sub,Polynomial.eval_monomial]
  norm_num
  ring

lemma quotient4_eval_mod (p : ℕ) [Fact p.Prime] (Q a P M B Z x : ℤ) :
    (((quotient4 Q a P (p:ℤ) M B Z).eval x : ℤ) : ZMod p)=
      (Q : ZMod p)*(x : ZMod p)^4-
        (a : ZMod p)^4*(Z : ZMod p)*(B : ZMod p)^3*(x : ZMod p)^3 := by
  rw [quotient4_eval]
  push_cast
  simp

lemma quotient4_derivative_mod (p : ℕ) [Fact p.Prime] (Q a P M B Z x : ℤ) :
    (((quotient4 Q a P (p:ℤ) M B Z).derivative.eval x : ℤ) : ZMod p)=
      4*(Q : ZMod p)*(x : ZMod p)^3-
        3*(a : ZMod p)^4*(Z : ZMod p)*(B : ZMod p)^3*(x : ZMod p)^2 := by
  rw [quotient4_derivative_eval]
  push_cast
  simp

lemma scaled_j4 (P pi M B Z x : ℤ) (h20 : (20:ℤ)=P*Z) :
    J4 (P*pi*M) (B*x)=
      P*(P^2*pi^3*M^3+4*P*pi^2*M^2*B*x+
        10*pi*M*B^2*x^2+Z*B^3*x^3) := by
  dsimp [J4]
  rw [h20]
  ring

lemma numerator4_scale (Q Q1 a M B P pi M1 Z : ℤ)
    (hm : M=P*pi*M1) (hq : Q=P*Q1) (h20 : (20:ℤ)=P*Z) :
    numerator4 Q a M B=C P*quotient4 Q1 a P pi M1 B Z := by
  ext j
  simp only [numerator4,quotient4,Polynomial.coeff_C_mul,
    Polynomial.coeff_sub,Polynomial.coeff_monomial]
  rw [hm,hq,h20]
  split_ifs <;> ring

lemma low_content_divisor (p c N : ℕ) [Fact p.Prime] (hc : c≤N)
    (Q a M B M1 Z e : ℤ)
    (hm : M=(p:ℤ)^c*(p:ℤ)*M1) (h20 : (20:ℤ)=(p:ℤ)^c*Z)
    (he : ¬ (p:ℤ)∣e)
    (hroot : (p:ℤ)^N∣(numerator4 Q a M B).eval e) :
    (p:ℤ)^c∣Q := by
  have hj : (p:ℤ)^c∣a^4*J4 M (B*e) := by
    refine ⟨a^4*(((p:ℤ)^c)^2*(p:ℤ)^3*M1^3+
      4*(p:ℤ)^c*(p:ℤ)^2*M1^2*B*e+
      10*(p:ℤ)*M1*B^2*e^2+Z*B^3*e^3),?_⟩
    rw [hm,scaled_j4 _ _ _ _ _ _ h20]
    ring
  have hf : (p:ℤ)^c∣Q*e^4-a^4*J4 M (B*e) := by
    rw [←numerator4_eval]
    exact (pow_dvd_pow (p:ℤ) hc).trans hroot
  have hqe : (p:ℤ)^c∣Q*e^4 := by
    simpa only [sub_add_cancel] using dvd_add hf hj
  exact cancel_unit_power p c (e^4) (prime_unit_power p e 4 he) Q hqe

lemma low_overlap_normalized_cover (p g h : ℕ) [Fact p.Prime]
    (hh : padicValNat p 20<h)
    (Q a M B m0 : ℤ) (hm : M=(p:ℤ)^h*m0)
    (ha : ¬ (p:ℤ)∣a) (hB : ¬ (p:ℤ)∣B) :
    ∃ T : Finset ℤ,T.card≤4*p^(8*padicValNat p 20) ∧
      ∀ e : ℤ,¬ (p:ℤ)∣e →
        (p:ℤ)^(4*g+7*h)∣(numerator4 Q a M B).eval e →
        ∃ t∈T,(p:ℤ)^(g+7*h)∣e-t := by
  classical
  have hp : p.Prime := Fact.out
  have hp0 : (p:ℤ)≠0 := by exact_mod_cast hp.ne_zero
  let c := padicValNat p 20
  let N := 4*g+7*h
  let mu := g+7*h
  let Pred : ℤ→Prop := fun e =>
    ¬ (p:ℤ)∣e ∧ (p:ℤ)^N∣(numerator4 Q a M B).eval e
  by_cases hex : ∃ e : ℤ,Pred e
  · obtain ⟨e0,he0,hroot0⟩ := hex
    have hcN : c≤N := by dsimp [c,N];omega
    have hMdiv : (p:ℤ)^(c+1)∣M := by
      rw [hm]
      exact dvd_mul_of_dvd_left (pow_dvd_pow (p:ℤ) (by dsimp [c];omega)) m0
    obtain ⟨M1,hM1⟩ := hMdiv
    have hM1' : M=(p:ℤ)^c*(p:ℤ)*M1 := by simpa only [pow_succ,mul_assoc] using hM1
    obtain ⟨Z,h20,hZ⟩ := integer_valuation_factor p 20 (by norm_num)
    change (20:ℤ)=(p:ℤ)^c*Z at h20
    obtain ⟨Q1,hQ1⟩ := low_content_divisor p c N hcN Q a M B M1 Z e0 hM1' h20 he0 hroot0
    let G := quotient4 Q1 a ((p:ℤ)^c) (p:ℤ) M1 B Z
    have hscale : numerator4 Q a M B=C ((p:ℤ)^c)*G :=
      numerator4_scale Q Q1 a M B ((p:ℤ)^c) (p:ℤ) M1 Z hM1' hQ1 h20
    let n := N-c
    have hn : 1≤n := by dsimp [n,N,c];omega
    have hGe (e : ℤ) (he : (p:ℤ)^N∣(numerator4 Q a M B).eval e) :
        (p:ℤ)^n∣G.eval e := by
      apply (cancel_pow_div (p:ℤ) hp0 c N hcN (G.eval e)).mp
      simpa only [hscale,Polynomial.eval_mul,Polynomial.eval_C] using he
    have hrootmod (e : ℤ) (he : (p:ℤ)^n∣G.eval e) :
        ((G.eval e : ℤ) : ZMod p)=0 := by
      have hd : (p:ℤ)∣G.eval e := by
        simpa only [pow_one] using (pow_dvd_pow (p:ℤ) hn).trans he
      exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ p).mpr hd
    let D : ZMod p := (a : ZMod p)^4*(Z : ZMod p)*(B : ZMod p)^3
    have hD : D≠0 := by
      have ha0 : (a : ZMod p)≠0 := fun hz =>
        ha ((ZMod.intCast_zmod_eq_zero_iff_dvd _ p).mp hz)
      have hB0 : (B : ZMod p)≠0 := fun hz =>
        hB ((ZMod.intCast_zmod_eq_zero_iff_dvd _ p).mp hz)
      have hZ0 : (Z : ZMod p)≠0 := fun hz =>
        hZ ((ZMod.intCast_zmod_eq_zero_iff_dvd _ p).mp hz)
      exact mul_ne_zero (mul_ne_zero (pow_ne_zero 4 ha0) hZ0) (pow_ne_zero 3 hB0)
    have hlin (e : ℤ) (he : ¬ (p:ℤ)∣e) (hroot : (p:ℤ)^n∣G.eval e) :
        (Q1 : ZMod p)*(e : ZMod p)=D := by
      have he0 : (e : ZMod p)≠0 := fun hz =>
        he ((ZMod.intCast_zmod_eq_zero_iff_dvd _ p).mp hz)
      have hz := hrootmod e hroot
      change (((quotient4 Q1 a ((p:ℤ)^c) (p:ℤ) M1 B Z).eval e : ℤ) : ZMod p)=0 at hz
      rw [quotient4_eval_mod] at hz
      have hprod : (e : ZMod p)^3*((Q1 : ZMod p)*(e : ZMod p)-D)=0 := by
        dsimp [D]
        linear_combination hz
      exact sub_eq_zero.mp ((mul_eq_zero.mp hprod).resolve_left (pow_ne_zero 3 he0))
    have hG0 := hGe e0 hroot0
    have hlin0 := hlin e0 he0 hG0
    have hQunit : (Q1 : ZMod p)≠0 := by
      intro hz
      apply hD
      simpa only [hz,zero_mul] using hlin0.symm
    have hder : ¬ (p:ℤ)∣G.derivative.eval e0 := by
      intro hd
      have hz := (ZMod.intCast_zmod_eq_zero_iff_dvd _ p).mpr hd
      change (((quotient4 Q1 a ((p:ℤ)^c) (p:ℤ) M1 B Z).derivative.eval e0 : ℤ) : ZMod p)=0 at hz
      rw [quotient4_derivative_mod] at hz
      have he00 : (e0 : ZMod p)≠0 := fun z =>
        he0 ((ZMod.intCast_zmod_eq_zero_iff_dvd _ p).mp z)
      have heq : 4*(Q1 : ZMod p)*(e0 : ZMod p)^3-
          3*(a : ZMod p)^4*(Z : ZMod p)*(B : ZMod p)^3*(e0 : ZMod p)^2 =
          (Q1 : ZMod p)*(e0 : ZMod p)^3 := by
        dsimp [D] at hlin0
        linear_combination 3*(e0 : ZMod p)^2*hlin0
      rw [heq] at hz
      exact (mul_ne_zero hQunit (pow_ne_zero 3 he00)) hz
    have hsingle (e : ℤ) (he : Pred e) : (p:ℤ)^n∣e-e0 := by
      have hG := hGe e he.2
      have hle := hlin e he.1 hG
      have hz : (Q1 : ZMod p)*((e0 : ZMod p)-(e : ZMod p))=0 := by
        linear_combination hlin0-hle
      have heq0 : ((e0-e : ℤ) : ZMod p)=0 := by
        simpa only [Int.cast_sub] using (mul_eq_zero.mp hz).resolve_left hQunit
      have hfirst : (p:ℤ)∣e0-e :=
        (ZMod.intCast_zmod_eq_zero_iff_dvd _ p).mp heq0
      have hstrong := JocelynClaims.claim_4c2b196a016c52b852dda99410f77a1ab6639d07014101098ac67ee864b1837e
        p n G e0 e hp hfirst hder (dvd_sub hG0 hG)
      simpa only [neg_sub] using dvd_neg.mpr hstrong
    let delta := min n mu
    have hcoarse : ∀ e : ℤ,Pred e →
        ∃ t∈({e0}:Finset ℤ),(p:ℤ)^delta∣e-t := by
      intro e he
      exact ⟨e0,Finset.mem_singleton_self _,
        (pow_dvd_pow (p:ℤ) (min_le_left n mu)).trans (hsingle e he)⟩
    obtain ⟨T,hTc,hTv⟩ := refine_cover p delta mu hp.pos (min_le_right n mu)
      Pred {e0} hcoarse
    refine ⟨T,?_,?_⟩
    · have hdiff : mu-delta≤8*c := by dsimp [mu,delta,n,N,c];omega
      have hpow : p^(mu-delta)≤p^(8*c) :=
        pow_le_pow_right₀ (by omega : 1≤p) hdiff
      simpa using hTc.trans (Nat.mul_le_mul (by simp : ({e0}:Finset ℤ).card≤4) hpow)
    · intro e he hroot
      exact hTv e ⟨he,hroot⟩
  · refine ⟨∅,by simp,?_⟩
    intro e he hroot
    exact False.elim (hex ⟨e,he,hroot⟩)

def actualPair (a b d0 e0 m q r : ℤ) : Prop :=
  let d := m*d0+b*r
  let e := m*e0-a*r
  (m^7 ∣ q*e^4-a^4*R4 (a*d) (b*e)) ∧
    (m^7 ∣ q*d^4+b^4*R4 (b*e) (a*d))

lemma oriented_actual_cover (p : ℕ) [Fact p.Prime]
    (a b d0 e0 m q : ℤ) (hbase : a*d0+b*e0=1)
    (hm : m≠0) (hpm : p∣m.natAbs) (ha : ¬ (p:ℤ)∣a) :
    let alpha := padicValNat p m.natAbs
    let g := padicValNat p (Int.gcd m (a*b))
    ∃ T : Finset ℤ,T.card≤4*p^(8*padicValNat p 20) ∧
      ∀ r : ℤ,actualPair a b d0 e0 m q r →
        ∃ t∈T,(p:ℤ)^(7*alpha-6*g)∣r-t := by
  classical
  intro alpha g
  have hp : p.Prime := Fact.out
  have hp0 : (p:ℤ)≠0 := by exact_mod_cast hp.ne_zero
  have hpmZ : (p:ℤ)∣m :=
    (Int.natAbs_dvd_natAbs).mp (by simpa using hpm)
  have hg : g≤alpha := gcd_valuation_le p m (a*b) hm
  let h := alpha-g
  have halpha : alpha=g+h := by dsimp [h];omega
  obtain ⟨m0,hmfull,hm0⟩ := integer_valuation_factor p m hm
  change m=(p:ℤ)^alpha*m0 at hmfull
  let M : ℤ := (p:ℤ)^h*m0
  have hmred : m=(p:ℤ)^g*M := by
    rw [hmfull,halpha,pow_add]
    dsimp [M]
    ring
  obtain ⟨B,hb,hB⟩ := other_coefficient_factor p m a b hm ha
  change b=(p:ℤ)^g*B at hb
  have hunit (r : ℤ) (hr : actualPair a b d0 e0 m q r) :
      ¬ (p:ℤ)∣m*e0-a*r := by
    exact coordinate_unit p a b m _ _ ha hpmZ (line_level a b d0 e0 m r hbase)
      (paired_unit a b m q _ _ hm (line_level a b d0 e0 m r hbase) hr.1 hr.2)
  have htranslate (r : ℤ) (hr : actualPair a b d0 e0 m q r) :
      m^7∣q*(m*e0-a*r)^4-a^4*J4 m (b*(m*e0-a*r)) := by
    rw [←inverse_translation a b (m*d0+b*r) (m*e0-a*r) m q
      (line_level a b d0 e0 m r hbase)]
    exact hr.1
  by_cases hex : ∃ r : ℤ,actualPair a b d0 e0 m q r
  · obtain ⟨r0,hr0⟩ := hex
    obtain ⟨Q,hQ⟩ := actual_content_divisor p g m b q a (m*e0-a*r0) M B
      hmred hb (hunit r0 hr0) (htranslate r0 hr0)
    have hroot (r : ℤ) (hr : actualPair a b d0 e0 m q r) :
        (p:ℤ)^(4*g+7*h)∣(numerator4 Q a M B).eval (m*e0-a*r) := by
      have hn : 7*alpha-3*g=4*g+7*h := by omega
      rw [←hn]
      exact actual_reduced_root p alpha g hp0 hg m b q a (m*e0-a*r)
        M B m0 Q hmred hb hmfull hQ (htranslate r hr)
    have hcover : ∃ U : Finset ℤ,U.card≤4*p^(8*padicValNat p 20) ∧
        ∀ r : ℤ,actualPair a b d0 e0 m q r →
          ∃ u∈U,(p:ℤ)^(g+7*h)∣(m*e0-a*r)-u := by
      by_cases hh0 : h=0
      · have hM : ¬ (p:ℤ)∣M := by simpa [M,hh0] using hm0
        obtain ⟨U,hUc,hUv⟩ := high_overlap_cover p g Q a M B ha hM
        refine ⟨U,hUc.trans ?_,?_⟩
        · exact Nat.le_mul_of_pos_right 4 (pow_pos hp.pos _)
        · intro r hr
          simpa [hh0] using hUv _ (by simpa [hh0] using hroot r hr)
      · have hBunit : ¬ (p:ℤ)∣B := hB (by omega)
        by_cases hbad : h≤padicValNat p 20
        · obtain ⟨U,hUc,hUv⟩ := bad_prime_normalized_cover p g h (by omega)
            hbad Q a M B ha hBunit
          exact ⟨U,hUc,fun r hr => hUv _ (hroot r hr)⟩
        · obtain ⟨U,hUc,hUv⟩ := low_overlap_normalized_cover p g h (by omega)
            Q a M B m0 rfl ha hBunit
          exact ⟨U,hUc,fun r hr => hUv _ (hunit r hr) (hroot r hr)⟩
    obtain ⟨U,hUc,hUv⟩ := hcover
    have hnega : ¬ (p:ℤ)∣-a := fun hd => ha (dvd_neg.mp hd)
    obtain ⟨T,hTc,hTv⟩ := pullback_cover p (g+7*h) (-a) (m*e0)
      hnega (actualPair a b d0 e0 m q) U (by
        intro r hr
        simpa only [neg_mul,sub_eq_add_neg] using hUv r hr)
    refine ⟨T,hTc.trans hUc,?_⟩
    intro r hr
    have hn : 7*alpha-6*g=g+7*h := by omega
    rw [hn]
    exact hTv r hr
  · refine ⟨∅,by simp,?_⟩
    intro r hr
    exact False.elim (hex ⟨r,hr⟩)

lemma actual_pair_swap (a b d0 e0 m q r : ℤ)
    (hr : actualPair a b d0 e0 m q r) :
    actualPair b a e0 d0 m (-q) (-r) := by
  have hd : m*e0+a*(-r)=m*e0-a*r := by ring
  have he : m*d0-b*(-r)=m*d0+b*r := by ring
  change (m^7 ∣ (-q)*(m*d0-b*(-r))^4-
    b^4*R4 (b*(m*e0+a*(-r))) (a*(m*d0-b*(-r)))) ∧
    (m^7 ∣ (-q)*(m*e0+a*(-r))^4+
    a^4*R4 (a*(m*d0-b*(-r))) (b*(m*e0+a*(-r))))
  rw [hd,he]
  constructor
  · have hn : (-q)*(m*d0+b*r)^4-b^4*R4 (b*(m*e0-a*r)) (a*(m*d0+b*r)) =
        -(q*(m*d0+b*r)^4+b^4*R4 (b*(m*e0-a*r)) (a*(m*d0+b*r))) := by ring
    rw [hn]
    exact dvd_neg.mpr hr.2
  · have hn : (-q)*(m*e0-a*r)^4+a^4*R4 (a*(m*d0+b*r)) (b*(m*e0-a*r)) =
        -(q*(m*e0-a*r)^4-a^4*R4 (a*(m*d0+b*r)) (b*(m*e0-a*r))) := by ring
    rw [hn]
    exact dvd_neg.mpr hr.1

lemma actual_cover (p : ℕ) (hp : p.Prime)
    (a b d0 e0 m q : ℤ) (hbase : a*d0+b*e0=1)
    (hm : m≠0) (hpm : p∣m.natAbs) :
    let alpha := padicValNat p m.natAbs
    let g := padicValNat p (Int.gcd m (a*b))
    ∃ T : Finset ℤ,T.card≤4*p^(8*padicValNat p 20) ∧
      ∀ r : ℤ,actualPair a b d0 e0 m q r →
        ∃ t∈T,(p:ℤ)^(7*alpha-6*g)∣r-t := by
  classical
  letI : Fact p.Prime := ⟨hp⟩
  rcases coefficient_orientation p a b d0 e0 hbase with ha|hb
  · exact oriented_actual_cover p a b d0 e0 m q hbase hm hpm ha
  · obtain ⟨U,hUc,hUv⟩ := oriented_actual_cover p b a e0 d0 m (-q)
      (by linear_combination hbase) hm hpm hb
    refine ⟨U.image (fun u : ℤ => -u),Finset.card_image_le.trans hUc,?_⟩
    intro r hr
    obtain ⟨u,hu,hru⟩ := hUv (-r) (actual_pair_swap a b d0 e0 m q r hr)
    refine ⟨-u,Finset.mem_image.mpr ⟨u,hu,rfl⟩,?_⟩
    have hg : Int.gcd m (b*a)=Int.gcd m (a*b) := by rw [mul_comm b a]
    rw [hg] at hru
    have hn : r- -u= -(-r-u) := by ring
    rw [hn]
    exact dvd_neg.mpr hru

end
end A7P4LocalCover

