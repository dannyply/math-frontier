      C (J:ℝ)*(d*e)^3*
        (C (4*(q:ℝ))*(C (b:ℝ)*e-C (a:ℝ)*d)-C (140*((a:ℝ)*(b:ℝ))^4))*
        C (((m:ℝ)^7)⁻¹) := by
