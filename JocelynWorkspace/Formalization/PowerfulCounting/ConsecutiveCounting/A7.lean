      ≤ C1 * x ^ ((1 : ℝ) / (k : ℝ) + ε) + (tailCount k x : ℝ) := hb
    _ ≤ C1 * x ^ (θ + ε) + C2 * x ^ (θ + ε) :=
      add_le_add (mul_le_mul_of_nonneg_left hp hC1) ht
    _ = (C1 + C2) * x ^ (θ + ε) := by ring

