private noncomputable def a7_baseF (κ lam : ℝ) : Polynomial ℝ :=
  X ^ 4 * (C (-35) + C 84 * X - C 70 * X ^ 2 + C 20 * X ^ 3) +
    (C κ + C lam * X) * (X ^ 4 * (1 - X) ^ 4)

private theorem a7_baseF_normal (κ lam : ℝ) :
    a7_baseF κ lam =
      (C (-35) + C κ) * X ^ 4 +
      (C 84 - 4 * C κ + C lam) * X ^ 5 +
      (-C 70 + 6 * C κ - 4 * C lam) * X ^ 6 +
      (C 20 - 4 * C κ + 6 * C lam) * X ^ 7 +
      (C κ - 4 * C lam) * X ^ 8 +
      C lam * X ^ 9 := by
  unfold a7_baseF
  ring

private theorem a7_baseF_normal_C (κ lam : ℝ) :
    a7_baseF κ lam =
      C (κ - 35) * X ^ 4 +
      C (84 - 4 * κ + lam) * X ^ 5 +
      C (-70 + 6 * κ - 4 * lam) * X ^ 6 +
      C (20 - 4 * κ + 6 * lam) * X ^ 7 +
      C (κ - 4 * lam) * X ^ 8 +
      C lam * X ^ 9 := by
  rw [a7_baseF_normal]
  simp only [map_add, map_sub, map_mul, map_neg, map_ofNat]
  ring

private theorem a7_baseF_coeff9 (κ lam : ℝ) :
    (a7_baseF κ lam).coeff 9 = lam := by
  rw [a7_baseF_normal_C]
  simp only [coeff_add, Polynomial.coeff_C_mul_X_pow]
  norm_num

private theorem a7_baseF_coeff8_of_lam_zero
    (κ lam : ℝ) (hlam : lam = 0) :
    (a7_baseF κ lam).coeff 8 = κ := by
  subst lam
  rw [a7_baseF_normal_C]
  simp only [coeff_add, Polynomial.coeff_C_mul_X_pow]
  norm_num

private theorem a7_baseF_coeff7_of_both_zero :
    (a7_baseF 0 0).coeff 7 = 20 := by
  rw [a7_baseF_normal_C]
  norm_num [Polynomial.coeff_C_mul_X_pow]

private noncomputable def bandZpoly (z₀ γ : ℝ) : Polynomial ℝ :=
  C z₀ + C γ * X

private noncomputable def bandNpoly (κ lam z₀ γ : ℝ) : Polynomial ℝ :=
  let Z := bandZpoly z₀ γ
  Z ^ 4 * (C (-35) + C 84 * Z - C 70 * Z ^ 2 + C 20 * Z ^ 3) +
    (C κ + C lam * Z) * (Z ^ 4 * (1 - Z) ^ 4)

private theorem bandNpoly_eq_comp (κ lam z₀ γ : ℝ) :
    bandNpoly κ lam z₀ γ =
      (a7_baseF κ lam).comp (bandZpoly z₀ γ) := by
  apply Polynomial.funext
  intro s
  simp [bandNpoly, bandZpoly, a7_baseF]

private theorem a7_baseF_degree_le (κ lam : ℝ) :
    (a7_baseF κ lam).natDegree ≤ 9 := by
  rw [a7_baseF_normal_C]
  compute_degree

private theorem bandZpoly_degree_le (z₀ γ : ℝ) :
    (bandZpoly z₀ γ).natDegree ≤ 1 := by
  unfold bandZpoly
  calc
    _ ≤ max (C z₀ : Polynomial ℝ).natDegree (C γ * X).natDegree :=
      Polynomial.natDegree_add_le _ _
    _ ≤ 1 := max_le (by simp) (by
      calc
        _ ≤ (C γ).natDegree + X.natDegree :=
          Polynomial.natDegree_mul_le
        _ ≤ 1 := by simp)

private theorem bandNpoly_degree_le (κ lam z₀ γ : ℝ) :
    (bandNpoly κ lam z₀ γ).natDegree ≤ 9 := by
  rw [bandNpoly_eq_comp]
  calc
    _ ≤ (a7_baseF κ lam).natDegree *
          (bandZpoly z₀ γ).natDegree := Polynomial.natDegree_comp_le
    _ ≤ 9 := by
      have hp := a7_baseF_degree_le κ lam
      have hq := bandZpoly_degree_le z₀ γ
      have hmul := Nat.mul_le_mul hp hq
      omega

private theorem a7_affine_coeff_at_degree_cap
    (p : Polynomial ℝ) (z₀ γ : ℝ) (n : ℕ)
    (hn : 0 < n) (hp : p.natDegree ≤ n) :
    (p.comp (C z₀ + C γ * X)).coeff n =
      p.coeff n * γ ^ n := by
  let q : Polynomial ℝ := C z₀ + C γ * X
  change (p.comp q).coeff n = p.coeff n * γ ^ n
  by_cases hγ : γ = 0
  · subst γ
    have hq : q = C z₀ := by simp [q]
    rw [hq]
    rw [Polynomial.comp_C]
    have hpow : (0 : ℝ) ^ n = 0 := zero_pow (Nat.ne_of_gt hn)
    rw [hpow, mul_zero, Polynomial.coeff_C]
    simp [hn.ne']
  · have hqcoeff : q.coeff 1 = γ := by
      simp [q, Polynomial.coeff_C_mul_X_pow]
    have hqle : q.natDegree ≤ 1 := by
      calc
        _ ≤ max (C z₀ : Polynomial ℝ).natDegree (C γ * X).natDegree :=
          Polynomial.natDegree_add_le _ _
        _ ≤ 1 := max_le (by simp) (by
          calc
            _ ≤ (C γ).natDegree + X.natDegree :=
              Polynomial.natDegree_mul_le
            _ ≤ 1 := by simp)
    have hqdeg : q.natDegree = 1 :=
      Polynomial.natDegree_eq_of_le_of_coeff_ne_zero hqle
        (by simpa [hqcoeff] using hγ)
    by_cases hdeg : p.natDegree = n
    · have hcompdeg : (p.comp q).natDegree = n := by
        rw [Polynomial.natDegree_comp, hdeg, hqdeg]
        omega
      have hpcoeff : p.leadingCoeff = p.coeff n := by
        rw [← Polynomial.coeff_natDegree, hdeg]
      have hqlead : q.leadingCoeff = γ := by
        rw [← Polynomial.coeff_natDegree, hqdeg, hqcoeff]
      calc
        (p.comp q).coeff n = (p.comp q).leadingCoeff := by
          rw [← hcompdeg]
          exact Polynomial.coeff_natDegree
        _ = p.leadingCoeff * q.leadingCoeff ^ p.natDegree :=
          Polynomial.leadingCoeff_comp (by rw [hqdeg]; omega)
        _ = p.coeff n * γ ^ n := by rw [hpcoeff, hqlead, hdeg]
    · have hlt : p.natDegree < n := lt_of_le_of_ne hp hdeg
      have hcomp_lt : (p.comp q).natDegree < n := by
        calc
          _ ≤ p.natDegree * q.natDegree :=
            Polynomial.natDegree_comp_le
          _ = p.natDegree := by rw [hqdeg]; omega
          _ < n := hlt
      rw [Polynomial.coeff_eq_zero_of_natDegree_lt hcomp_lt,
        Polynomial.coeff_eq_zero_of_natDegree_lt hlt]
      simp

private theorem bandNpoly_coeff_nine (κ lam z₀ γ : ℝ) :
    (bandNpoly κ lam z₀ γ).coeff 9 = lam * γ ^ 9 := by
  rw [bandNpoly_eq_comp]
  change ((a7_baseF κ lam).comp (C z₀ + C γ * X)).coeff 9 = lam * γ ^ 9
  rw [a7_affine_coeff_at_degree_cap
    (a7_baseF κ lam) z₀ γ 9 (by omega) (a7_baseF_degree_le κ lam)]
  exact congrArg (fun t : ℝ => t * γ ^ 9) (a7_baseF_coeff9 κ lam)

private theorem a7_baseF_degree_le8_of_lam_zero
    (κ lam : ℝ) (hlam : lam = 0) :
    (a7_baseF κ lam).natDegree ≤ 8 := by
  subst lam
  rw [a7_baseF_normal_C]
  simp only [map_zero, zero_mul, mul_zero, add_zero, sub_zero]
  compute_degree

private theorem a7_baseF_degree_le7_of_both_zero :
    (a7_baseF 0 0).natDegree ≤ 7 := by
  rw [a7_baseF_normal_C]
  simp only [map_zero, zero_mul, mul_zero, add_zero, sub_zero]
  compute_degree

private theorem bandNpoly_coeff_eight_of_lam_zero
    (κ lam z₀ γ : ℝ) (hlam : lam = 0) :
    (bandNpoly κ lam z₀ γ).coeff 8 = κ * γ ^ 8 := by
  subst lam
  rw [bandNpoly_eq_comp]
  change ((a7_baseF κ 0).comp (C z₀ + C γ * X)).coeff 8 = κ * γ ^ 8
  rw [a7_affine_coeff_at_degree_cap
    (a7_baseF κ 0) z₀ γ 8 (by omega)
    (a7_baseF_degree_le8_of_lam_zero κ 0 rfl)]
  rw [a7_baseF_coeff8_of_lam_zero κ 0 rfl]

private theorem bandNpoly_coeff_seven_of_both_zero
    (z₀ γ : ℝ) :
    (bandNpoly 0 0 z₀ γ).coeff 7 = 20 * γ ^ 7 := by
  rw [bandNpoly_eq_comp]
  change ((a7_baseF 0 0).comp (C z₀ + C γ * X)).coeff 7 = 20 * γ ^ 7
  rw [a7_affine_coeff_at_degree_cap
    (a7_baseF 0 0) z₀ γ 7 (by omega)
    a7_baseF_degree_le7_of_both_zero]
  rw [a7_baseF_coeff7_of_both_zero]

private noncomputable def a7_baseF1 (κ lam : ℝ) : Polynomial ℝ :=
  C 4 * X ^ 3 *
    (C (-35) + C 84 * X - C 70 * X ^ 2 + C 20 * X ^ 3) +
  X ^ 4 * (C 84 - C 140 * X + C 60 * X ^ 2) +
  C lam * X ^ 4 * (1 - X) ^ 4 +
  (C κ + C lam * X) *
    (C 4 * X ^ 3 * (1 - X) ^ 3 * (1 - C 2 * X))
private noncomputable def bandN1poly (κ lam z₀ γ : ℝ) : Polynomial ℝ :=
  let Z := bandZpoly z₀ γ
  C γ * (C 4 * Z ^ 3 *
    (C (-35) + C 84 * Z - C 70 * Z ^ 2 + C 20 * Z ^ 3) +
    Z ^ 4 * (C 84 - C 140 * Z + C 60 * Z ^ 2) +
    C lam * Z ^ 4 * (1 - Z) ^ 4 +
    (C κ + C lam * Z) *
      (C 4 * Z ^ 3 * (1 - Z) ^ 3 * (1 - C 2 * Z)))

set_option maxRecDepth 2048 in
private theorem a7_baseF1_derivative (κ lam : ℝ) :
    Polynomial.derivative (a7_baseF κ lam) = a7_baseF1 κ lam := by
  unfold a7_baseF a7_baseF1
  simp only [Polynomial.derivative_add, Polynomial.derivative_sub,
    Polynomial.derivative_mul, Polynomial.derivative_pow,
    Polynomial.derivative_C, Polynomial.derivative_X,
    Polynomial.derivative_one]
  simp only [map_ofNat, map_natCast, map_neg]
  ring

private theorem bandZpoly_derivative (z₀ γ : ℝ) :
    Polynomial.derivative (bandZpoly z₀ γ) = C γ := by
  simp [bandZpoly, Polynomial.derivative_add,
    Polynomial.derivative_mul]

private theorem bandN1poly_eq_comp (κ lam z₀ γ : ℝ) :
    bandN1poly κ lam z₀ γ =
      C γ * (a7_baseF1 κ lam).comp (bandZpoly z₀ γ) := by
  unfold bandN1poly a7_baseF1
  simp only [Polynomial.add_comp, Polynomial.sub_comp,
    Polynomial.mul_comp, Polynomial.pow_comp,
    Polynomial.C_comp, Polynomial.X_comp,
    Polynomial.one_comp]

private theorem bandN1poly_eq_derivative (κ lam z₀ γ : ℝ) :
    bandN1poly κ lam z₀ γ =
      Polynomial.derivative (bandNpoly κ lam z₀ γ) := by
  rw [bandNpoly_eq_comp, Polynomial.derivative_comp,
    a7_baseF1_derivative, bandZpoly_derivative]
  exact bandN1poly_eq_comp κ lam z₀ γ

private theorem bandN1poly_degree_le
    (κ lam z₀ γ : ℝ) :
    (bandN1poly κ lam z₀ γ).natDegree ≤ 8 := by
  rw [bandN1poly_eq_derivative]
  have h := Polynomial.natDegree_derivative_le (bandNpoly κ lam z₀ γ)
  have hN := bandNpoly_degree_le κ lam z₀ γ
  omega

private theorem bandN1poly_coeff_eight
    (κ lam z₀ γ : ℝ) :
    (bandN1poly κ lam z₀ γ).coeff 8 = 9 * lam * γ ^ 9 := by
  rw [bandN1poly_eq_derivative, Polynomial.coeff_derivative]
  norm_num [bandNpoly_coeff_nine]
  ring

private theorem bandN1poly_coeff_seven_of_lam_zero
    (κ lam z₀ γ : ℝ) (hlam : lam = 0) :
    (bandN1poly κ lam z₀ γ).coeff 7 = 8 * κ * γ ^ 8 := by
  rw [bandN1poly_eq_derivative, Polynomial.coeff_derivative]
  norm_num [bandNpoly_coeff_eight_of_lam_zero κ lam z₀ γ hlam]
  ring

private theorem bandN1poly_coeff_six_of_both_zero
    (z₀ γ : ℝ) :
    (bandN1poly 0 0 z₀ γ).coeff 6 = 140 * γ ^ 7 := by
  rw [bandN1poly_eq_derivative, Polynomial.coeff_derivative]
  norm_num [bandNpoly_coeff_seven_of_both_zero]
  ring

private theorem bandNpoly_eval (κ lam z₀ γ s : ℝ) :
    (bandNpoly κ lam z₀ γ).eval s =
      bandF κ lam (z₀ + γ * s) := by
  simp [bandNpoly, bandZpoly, bandF, bandU, bandG]

private theorem bandN1poly_eval (κ lam z₀ γ s : ℝ) :
    (bandN1poly κ lam z₀ γ).eval s =
      deriv (fun t : ℝ => bandF κ lam (z₀ + γ * t)) s := by
  rw [bandN_deriv]
  simp [bandN1poly, bandZpoly, bandF1, bandU, bandG] <;> ring_nf <;> simp

private noncomputable def bandCuts (κ lam z₀ γ x H : ℝ) : Finset ℝ :=
  ((bandNpoly κ lam z₀ γ - C (x / 2)).roots.toFinset ∪
   (bandNpoly κ lam z₀ γ - C x).roots.toFinset) ∪
  ((bandN1poly κ lam z₀ γ - C H).roots.toFinset ∪
   (bandN1poly κ lam z₀ γ + C H).roots.toFinset)

end A7PureNineSignedLevel

namespace A7PureNineSignedLevel
open Polynomial

private theorem band_cut_polys_nonzero
    (κ lam z₀ γ x H : ℝ) (hγ : γ ≠ 0) :
    (∀ y : ℝ, bandNpoly κ lam z₀ γ - C y ≠ 0) ∧
    (∀ y : ℝ, bandN1poly κ lam z₀ γ + C y ≠ 0) := by
  constructor
  · intro y hzero
    by_cases hlam : lam = 0
    · by_cases hκ : κ = 0
      · have hcoef := congrArg (fun p : Polynomial ℝ => p.coeff 7) hzero
        subst κ
        subst lam
        rw [coeff_sub, bandNpoly_coeff_seven_of_both_zero] at hcoef
        simp only [coeff_C, Nat.reduceEqDiff, if_false, coeff_zero, sub_zero, add_zero] at hcoef
        exact (mul_ne_zero (by norm_num : (20 : ℝ) ≠ 0)
          (pow_ne_zero 7 hγ)) hcoef
      · have hcoef := congrArg (fun p : Polynomial ℝ => p.coeff 8) hzero
        rw [coeff_sub, bandNpoly_coeff_eight_of_lam_zero κ lam z₀ γ hlam]
          at hcoef
        simp only [coeff_C, Nat.reduceEqDiff, if_false, coeff_zero, sub_zero, add_zero] at hcoef
        exact (mul_ne_zero hκ (pow_ne_zero 8 hγ)) hcoef
    · have hcoef := congrArg (fun p : Polynomial ℝ => p.coeff 9) hzero
      rw [coeff_sub, bandNpoly_coeff_nine] at hcoef
      simp only [coeff_C, Nat.reduceEqDiff, if_false, coeff_zero, sub_zero, add_zero] at hcoef
      exact (mul_ne_zero hlam (pow_ne_zero 9 hγ)) hcoef
  · intro y hzero
    by_cases hlam : lam = 0
    · by_cases hκ : κ = 0
      · have hcoef := congrArg (fun p : Polynomial ℝ => p.coeff 6) hzero
        subst κ
        subst lam
        rw [coeff_add, bandN1poly_coeff_six_of_both_zero] at hcoef
        simp only [coeff_C, Nat.reduceEqDiff, if_false, coeff_zero, sub_zero, add_zero] at hcoef
        exact (mul_ne_zero (by norm_num : (140 : ℝ) ≠ 0)
          (pow_ne_zero 7 hγ)) hcoef
      · have hcoef := congrArg (fun p : Polynomial ℝ => p.coeff 7) hzero
        rw [coeff_add, bandN1poly_coeff_seven_of_lam_zero κ lam z₀ γ hlam]
          at hcoef
        simp only [coeff_C, Nat.reduceEqDiff, if_false, coeff_zero, sub_zero, add_zero] at hcoef
        exact (mul_ne_zero
          (mul_ne_zero (by norm_num : (8 : ℝ) ≠ 0) hκ)
          (pow_ne_zero 8 hγ)) hcoef
    · have hcoef := congrArg (fun p : Polynomial ℝ => p.coeff 8) hzero
      rw [coeff_add, bandN1poly_coeff_eight] at hcoef
      simp only [coeff_C, Nat.reduceEqDiff, if_false, coeff_zero, sub_zero, add_zero] at hcoef
      exact (mul_ne_zero
        (mul_ne_zero (by norm_num : (9 : ℝ) ≠ 0) hlam)
        (pow_ne_zero 9 hγ)) hcoef

private theorem bandCuts_card_all
    (κ lam z₀ γ x H : ℝ) (hγ : γ ≠ 0) :
    (bandCuts κ lam z₀ γ x H).card ≤ 34 := by
  classical
  obtain ⟨hN0, hN10⟩ :=
    band_cut_polys_nonzero κ lam z₀ γ x H hγ
  have hroot9 (y : ℝ) :
      ((bandNpoly κ lam z₀ γ - C y).roots.toFinset).card ≤ 9 := by
    calc
      _ ≤ (bandNpoly κ lam z₀ γ - C y).roots.card :=
        Multiset.toFinset_card_le _
      _ ≤ (bandNpoly κ lam z₀ γ - C y).natDegree :=
        Polynomial.card_roots' _
      _ ≤ 9 := by
        have hd := Polynomial.natDegree_sub_le
          (bandNpoly κ lam z₀ γ) (C y)
        have hc : (C y : Polynomial ℝ).natDegree ≤ 9 := by simp
        exact hd.trans (max_le (bandNpoly_degree_le κ lam z₀ γ) hc)
  have hroot8 (y : ℝ) :
      ((bandN1poly κ lam z₀ γ + C y).roots.toFinset).card ≤ 8 := by
    calc
      _ ≤ (bandN1poly κ lam z₀ γ + C y).roots.card :=
        Multiset.toFinset_card_le _
      _ ≤ (bandN1poly κ lam z₀ γ + C y).natDegree :=
        Polynomial.card_roots' _
      _ ≤ 8 := by
        have hd := Polynomial.natDegree_add_le
          (bandN1poly κ lam z₀ γ) (C y)
        have hc : (C y : Polynomial ℝ).natDegree ≤ 8 := by simp
        exact hd.trans (max_le (bandN1poly_degree_le κ lam z₀ γ) hc)
  unfold bandCuts
  have hsum := Finset.card_union_le
    ((bandNpoly κ lam z₀ γ - C (x / 2)).roots.toFinset ∪
      (bandNpoly κ lam z₀ γ - C x).roots.toFinset)
    ((bandN1poly κ lam z₀ γ - C H).roots.toFinset ∪
      (bandN1poly κ lam z₀ γ + C H).roots.toFinset)
  have hsumL := Finset.card_union_le
    ((bandNpoly κ lam z₀ γ - C (x / 2)).roots.toFinset)
    ((bandNpoly κ lam z₀ γ - C x).roots.toFinset)
  have hsumR := Finset.card_union_le
    ((bandN1poly κ lam z₀ γ - C H).roots.toFinset)
    ((bandN1poly κ lam z₀ γ + C H).roots.toFinset)
  have h1 := hroot9 (x / 2)
  have h2 := hroot9 x
  have h3 : ((bandN1poly κ lam z₀ γ - C H).roots.toFinset).card ≤ 8 := by
    simpa [sub_eq_add_neg] using hroot8 (-H)
  have h4 := hroot8 H
  omega

private theorem bandCuts_contains_root
    (κ lam z₀ γ x H s : ℝ) (hγ : γ ≠ 0)
    (hroot :
      bandF κ lam (z₀ + γ * s) = x / 2 ∨
      bandF κ lam (z₀ + γ * s) = x ∨
      deriv (fun t : ℝ => bandF κ lam (z₀ + γ * t)) s = H ∨
      deriv (fun t : ℝ => bandF κ lam (z₀ + γ * t)) s = -H) :
    s ∈ bandCuts κ lam z₀ γ x H := by
  classical
  obtain ⟨hN0, hN10⟩ :=
    band_cut_polys_nonzero κ lam z₀ γ x H hγ
  rcases hroot with hlow | hhigh | hplus | hminus
  · have hp : (bandNpoly κ lam z₀ γ - C (x / 2)).eval s = 0 := by
      rw [eval_sub, eval_C, bandNpoly_eval]
      linarith
    simp only [bandCuts, Finset.mem_union]
    left; left
    simpa only [Multiset.mem_toFinset] using
      (Polynomial.mem_roots (hN0 (x / 2))).2 hp
  · have hp : (bandNpoly κ lam z₀ γ - C x).eval s = 0 := by
      rw [eval_sub, eval_C, bandNpoly_eval]
      linarith
    simp only [bandCuts, Finset.mem_union]
    left; right
    simpa only [Multiset.mem_toFinset] using
      (Polynomial.mem_roots (hN0 x)).2 hp
  · have hp : (bandN1poly κ lam z₀ γ - C H).eval s = 0 := by
      rw [eval_sub, eval_C, bandN1poly_eval]
      linarith
    simp only [bandCuts, Finset.mem_union]
    right; left
    simpa [sub_eq_add_neg] using
      (Polynomial.mem_roots (hN10 (-H))).2
        (by simpa [sub_eq_add_neg] using hp)
  · have hp : (bandN1poly κ lam z₀ γ + C H).eval s = 0 := by
      rw [eval_add, eval_C, bandN1poly_eval]
      linarith
    simp only [bandCuts, Finset.mem_union]
    right; right
    simpa only [Multiset.mem_toFinset] using
      (Polynomial.mem_roots (hN10 H)).2 hp

private theorem affine_box_on_interval
    (c k lo hi s t r : ℝ)
    (hst : s ≤ t) (hr : r ∈ Set.Icc s t)
    (hs : lo ≤ c + k * s ∧ c + k * s ≤ hi)
    (ht : lo ≤ c + k * t ∧ c + k * t ≤ hi) :
    lo ≤ c + k * r ∧ c + k * r ≤ hi := by
  rcases hr with ⟨hsr, hrt⟩
  by_cases hk : 0 ≤ k
  · have hsr' := mul_le_mul_of_nonneg_left hsr hk
    have hrt' := mul_le_mul_of_nonneg_left hrt hk
    constructor <;> linarith [hsr', hrt', hs.1, ht.2]
  · have hk' : k ≤ 0 := le_of_not_ge hk
    have hsr' := mul_le_mul_of_nonpos_left hsr hk'
    have hrt' := mul_le_mul_of_nonpos_left hrt hk'
    constructor <;> linarith [hrt', hsr', ht.1, hs.2]

private theorem original_signed_halfboxes_convex
    (a b A B m t₀ h : ℤ) (D E s t r : ℝ)
    (hst : s ≤ t) (hr : r ∈ Set.Icc s t)
    (hds : D / 2 ≤ ((A * m + b * t₀ : ℤ) : ℝ) +
        ((b * h : ℤ) : ℝ) * s ∧
      ((A * m + b * t₀ : ℤ) : ℝ) +
        ((b * h : ℤ) : ℝ) * s ≤ D)
    (hdt : D / 2 ≤ ((A * m + b * t₀ : ℤ) : ℝ) +
        ((b * h : ℤ) : ℝ) * t ∧
      ((A * m + b * t₀ : ℤ) : ℝ) +
        ((b * h : ℤ) : ℝ) * t ≤ D)
    (hes : E / 2 ≤ ((B * m - a * t₀ : ℤ) : ℝ) -
        ((a * h : ℤ) : ℝ) * s ∧
      ((B * m - a * t₀ : ℤ) : ℝ) -
        ((a * h : ℤ) : ℝ) * s ≤ E)
    (het : E / 2 ≤ ((B * m - a * t₀ : ℤ) : ℝ) -
        ((a * h : ℤ) : ℝ) * t ∧
      ((B * m - a * t₀ : ℤ) : ℝ) -
        ((a * h : ℤ) : ℝ) * t ≤ E) :
    (D / 2 ≤ ((A * m + b * t₀ : ℤ) : ℝ) +
        ((b * h : ℤ) : ℝ) * r ∧
      ((A * m + b * t₀ : ℤ) : ℝ) +
        ((b * h : ℤ) : ℝ) * r ≤ D) ∧
    (E / 2 ≤ ((B * m - a * t₀ : ℤ) : ℝ) -
        ((a * h : ℤ) : ℝ) * r ∧
      ((B * m - a * t₀ : ℤ) : ℝ) -
        ((a * h : ℤ) : ℝ) * r ≤ E) := by
  constructor
  · exact affine_box_on_interval
      _ _ _ _ _ _ _ hst hr hds hdt
  · have hes' : E / 2 ≤ ((B * m - a * t₀ : ℤ) : ℝ) +
          (-((a * h : ℤ) : ℝ)) * s ∧
        ((B * m - a * t₀ : ℤ) : ℝ) +
          (-((a * h : ℤ) : ℝ)) * s ≤ E := by
      simpa only [neg_mul, sub_eq_add_neg] using hes
    have het' : E / 2 ≤ ((B * m - a * t₀ : ℤ) : ℝ) +
          (-((a * h : ℤ) : ℝ)) * t ∧
        ((B * m - a * t₀ : ℤ) : ℝ) +
          (-((a * h : ℤ) : ℝ)) * t ≤ E := by
      simpa only [neg_mul, sub_eq_add_neg] using het
    have hbound := affine_box_on_interval
      (((B * m - a * t₀ : ℤ) : ℝ))
      (-((a * h : ℤ) : ℝ)) (E / 2) E s t r
      hst hr hes' het'
    simpa only [neg_mul, sub_eq_add_neg] using hbound

private theorem equal_rank_no_cut_closed
    (cuts : Finset ℝ) (s t : ℤ)
    (hst : (s : ℝ) < (t : ℝ))
    (hrank : cutRank cuts s = cutRank cuts t)
    (hs : (s : ℝ) ∉ cuts) (ht : (t : ℝ) ∉ cuts) :
    ∀ r ∈ Set.Icc (s : ℝ) (t : ℝ), r ∉ cuts := by
  intro r hr hrc
  by_cases hrs : r = (s : ℝ)
  · exact hs (hrs ▸ hrc)
  by_cases hrt : r = (t : ℝ)
  · exact ht (hrt ▸ hrc)
  have hstrict : (s : ℝ) < r ∧ r < (t : ℝ) := by
    rcases hr with ⟨hlo, hhi⟩
    exact ⟨lt_of_le_of_ne hlo (Ne.symm hrs),
      lt_of_le_of_ne hhi hrt⟩
  exact (same_cutRank_no_cut cuts s t hst hrank r hrc) hstrict

end A7PureNineSignedLevel

namespace A7PureNineSignedLevel

private theorem continuous_positive_of_no_zero_Icc
    (f : ℝ → ℝ) (a b : ℝ) (hab : a ≤ b)
    (hcont : ContinuousOn f (Set.Icc a b))
    (hzero : ∀ r ∈ Set.Icc a b, f r ≠ 0)
    (ha : 0 < f a) :
    ∀ r ∈ Set.Icc a b, 0 < f r := by
  intro r hr
  by_contra hnot
  have hfrle : f r ≤ 0 := le_of_not_gt hnot
  have hfrne : f r ≠ 0 := hzero r hr
  have hfr : f r < 0 := lt_of_le_of_ne hfrle hfrne
  have har : a ≤ r := hr.1
  have hcont' : ContinuousOn (fun u : ℝ => -f u) (Set.Icc a r) := by
    have hsub : Set.Icc a r ⊆ Set.Icc a b := by
      intro u hu
      exact ⟨hu.1, le_trans hu.2 hr.2⟩
    exact hcont.mono hsub |>.neg
  have hIV :
      Set.Icc (-f a) (-f r) ⊆
        (fun u : ℝ => -f u) '' Set.Icc a r := by
    first
    | exact intermediate_value_Icc har hcont'
    | exact intermediate_value_Icc hcont' har
  have hmem : (0 : ℝ) ∈ Set.Icc (-f a) (-f r) := by
    constructor <;> linarith
  obtain ⟨u, hu, hu0⟩ := hIV hmem
  have huin : u ∈ Set.Icc a b :=
    ⟨hu.1, le_trans hu.2 hr.2⟩
  exact (hzero u huin) (by linarith)

private theorem original_cut_free_real_regime
    (κ lam z₀ γ x H : ℝ) (s t : ℤ)
    (hγ : γ ≠ 0) (hH : 0 < H)
    (hst : (s : ℝ) < (t : ℝ))
    (hrank : cutRank (bandCuts κ lam z₀ γ x H) s =
      cutRank (bandCuts κ lam z₀ γ x H) t)
    (hsnc : (s : ℝ) ∉ bandCuts κ lam z₀ γ x H)
    (htnc : (t : ℝ) ∉ bandCuts κ lam z₀ γ x H)
    (hsheight : x / 2 ≤ bandF κ lam (z₀ + γ * (s : ℝ)) ∧
      bandF κ lam (z₀ + γ * (s : ℝ)) ≤ x)
    (htheight : x / 2 ≤ bandF κ lam (z₀ + γ * (t : ℝ)) ∧
      bandF κ lam (z₀ + γ * (t : ℝ)) ≤ x) :
    (∀ r ∈ Set.Icc (s : ℝ) (t : ℝ),
      x / 2 < bandF κ lam (z₀ + γ * r) ∧
      bandF κ lam (z₀ + γ * r) < x) ∧
    ((∀ r ∈ Set.Icc (s : ℝ) (t : ℝ),
        H < deriv (fun u : ℝ => bandF κ lam (z₀ + γ * u)) r) ∨
     (∀ r ∈ Set.Icc (s : ℝ) (t : ℝ),
        deriv (fun u : ℝ => bandF κ lam (z₀ + γ * u)) r < -H) ∨
     (∀ r ∈ Set.Icc (s : ℝ) (t : ℝ),
        |deriv (fun u : ℝ => bandF κ lam (z₀ + γ * u)) r| < H)) := by
  let N : ℝ → ℝ := fun r => bandF κ lam (z₀ + γ * r)
  let N1 : ℝ → ℝ := fun r => deriv N r
  let cuts := bandCuts κ lam z₀ γ x H
  have hnocut : ∀ r ∈ Set.Icc (s : ℝ) (t : ℝ), r ∉ cuts :=
    equal_rank_no_cut_closed cuts s t hst hrank hsnc htnc
  have hnoroot : ∀ r ∈ Set.Icc (s : ℝ) (t : ℝ),
      N r ≠ x / 2 ∧ N r ≠ x ∧ N1 r ≠ H ∧ N1 r ≠ -H := by
    intro r hr
    have hnc := hnocut r hr
    constructor
    · intro heq
      exact hnc (bandCuts_contains_root κ lam z₀ γ x H r hγ
        (Or.inl (by simpa only [N] using heq)))
    constructor
    · intro heq
      exact hnc (bandCuts_contains_root κ lam z₀ γ x H r hγ
        (Or.inr (Or.inl (by simpa only [N] using heq))))
    constructor
    · intro heq
      exact hnc (bandCuts_contains_root κ lam z₀ γ x H r hγ
        (Or.inr (Or.inr (Or.inl (by simpa only [N1, N] using heq)))))
    · intro heq
      exact hnc (bandCuts_contains_root κ lam z₀ γ x H r hγ
        (Or.inr (Or.inr (Or.inr (by simpa only [N1, N] using heq)))))
  have hNcont : ContinuousOn N (Set.Icc (s : ℝ) (t : ℝ)) := by
    dsimp [N, bandF, bandU, bandG]
    fun_prop
  have hN1cont : ContinuousOn N1 (Set.Icc (s : ℝ) (t : ℝ)) := by
    have hfun : N1 = fun r : ℝ => γ * bandF1 κ lam (z₀ + γ * r) := by
      funext r
      exact bandN_deriv κ lam z₀ γ r
    rw [hfun]
    dsimp [bandF1, bandU, bandG]
    fun_prop
  have hab : (s : ℝ) ≤ (t : ℝ) := le_of_lt hst
  have hsmem : (s : ℝ) ∈ Set.Icc (s : ℝ) (t : ℝ) :=
    ⟨le_rfl, hab⟩
  have htm : (t : ℝ) ∈ Set.Icc (s : ℝ) (t : ℝ) :=
    ⟨hab, le_rfl⟩
  have hslow : x / 2 < N (s : ℝ) :=
    lt_of_le_of_ne hsheight.1
      (Ne.symm (hnoroot (s : ℝ) hsmem).1)
  have hshigh : N (s : ℝ) < x :=
    lt_of_le_of_ne hsheight.2
      (hnoroot (s : ℝ) hsmem).2.1
  have hheightLow :
      ∀ r ∈ Set.Icc (s : ℝ) (t : ℝ), x / 2 < N r := by
    have hpositive := continuous_positive_of_no_zero_Icc
      (fun r => N r - x / 2) (s : ℝ) (t : ℝ) hab
      (by fun_prop)
      (by
        intro r hr hzero
        exact (hnoroot r hr).1 (by linarith))
      (by linarith)
    intro r hr
    have := hpositive r hr
    linarith
  have hheightHigh :
      ∀ r ∈ Set.Icc (s : ℝ) (t : ℝ), N r < x := by
    have hpositive := continuous_positive_of_no_zero_Icc
      (fun r => x - N r) (s : ℝ) (t : ℝ) hab
      (by fun_prop)
      (by
        intro r hr hzero
        exact (hnoroot r hr).2.1 (by linarith))
      (by linarith)
    intro r hr
    have := hpositive r hr
    linarith
  constructor
  · intro r hr
    exact ⟨hheightLow r hr, hheightHigh r hr⟩
  have hsplus : N1 (s : ℝ) ≠ H := (hnoroot (s : ℝ) hsmem).2.2.1
  have hsminus : N1 (s : ℝ) ≠ -H := (hnoroot (s : ℝ) hsmem).2.2.2
  by_cases hlargePlus : H < N1 (s : ℝ)
  · left
    have hpositive := continuous_positive_of_no_zero_Icc
      (fun r => N1 r - H) (s : ℝ) (t : ℝ) hab
      (by fun_prop)
      (by
        intro r hr hzero
        exact (hnoroot r hr).2.2.1 (by linarith))
      (by linarith)
    intro r hr
    have := hpositive r hr
    linarith
  right
  by_cases hlargeMinus : N1 (s : ℝ) < -H
  · left
    have hpositive := continuous_positive_of_no_zero_Icc
      (fun r => -H - N1 r) (s : ℝ) (t : ℝ) hab
      (by fun_prop)
      (by
        intro r hr hzero
        exact (hnoroot r hr).2.2.2 (by linarith))
      (by linarith)
    intro r hr
    have := hpositive r hr
    linarith
  right
  have hsmallPlus : N1 (s : ℝ) < H := by
    have hle := le_of_not_gt hlargePlus
    exact lt_of_le_of_ne hle hsplus
  have hsmallMinus : -H < N1 (s : ℝ) := by
    have hle := le_of_not_gt hlargeMinus
    exact lt_of_le_of_ne hle (Ne.symm hsminus)
  have hp := continuous_positive_of_no_zero_Icc
    (fun r => H - N1 r) (s : ℝ) (t : ℝ) hab
    (by fun_prop)
    (by
      intro r hr hzero
      exact (hnoroot r hr).2.2.1 (by linarith))
    (by linarith)
  have hm := continuous_positive_of_no_zero_Icc
    (fun r => N1 r + H) (s : ℝ) (t : ℝ) hab
    (by fun_prop)
    (by
      intro r hr hzero
      exact (hnoroot r hr).2.2.2 (by linarith))
    (by linarith)
  intro r hr
  have hpr := hp r hr
  have hmr := hm r hr
  exact abs_lt.mpr ⟨by linarith, by linarith⟩

end A7PureNineSignedLevel

namespace A7PureNineSignedLevel

private theorem continuous_abs_lower_fixed_sign
    (f : ℝ → ℝ) (a b L : ℝ) (hab : a ≤ b) (hL : 0 < L)
    (hcont : ContinuousOn f (Set.Icc a b))
    (habs : ∀ r ∈ Set.Icc a b, L ≤ |f r|) :
    (∀ r ∈ Set.Icc a b, L ≤ f r) ∨
    (∀ r ∈ Set.Icc a b, f r ≤ -L) := by
  have hzero : ∀ r ∈ Set.Icc a b, f r ≠ 0 := by
    intro r hr h0
    have h := habs r hr
    rw [h0, abs_zero] at h
    linarith
  have ha : a ∈ Set.Icc a b := ⟨le_rfl, hab⟩
  rcases le_total 0 (f a) with hpos | hneg
  · have hapos : 0 < f a := lt_of_le_of_ne hpos (Ne.symm (hzero a ha))
    left
    have hsign := continuous_positive_of_no_zero_Icc
      f a b hab hcont hzero hapos
    intro r hr
    have hp := hsign r hr
    simpa [abs_of_pos hp] using habs r hr
  · right
    have haneg : f a < 0 := lt_of_le_of_ne hneg (hzero a ha)
    have hcontneg : ContinuousOn (fun r => -f r) (Set.Icc a b) :=
      hcont.neg
    have hzeroneg : ∀ r ∈ Set.Icc a b, -f r ≠ 0 := by
      intro r hr h0
      exact hzero r hr (by linarith)
    have hsign := continuous_positive_of_no_zero_Icc
      (fun r => -f r) a b hab hcontneg hzeroneg (by linarith)
    intro r hr
    have hn := hsign r hr
    have h := habs r hr
    rw [abs_of_neg (by linarith : f r < 0)] at h
    linarith

private theorem original_regime_II_real_diameter
    (κ lam z₀ γ x H Zmin : ℝ) (s t : ℤ)
    (hx : 0 < x) (hγ : γ ≠ 0)
    (hZmin : (100 : ℝ) ≤ Zmin)
    (hlarge : (90 : ℝ) * x ≤ Zmin ^ 7)
    (hH : H = |γ| * Real.sqrt (x * Zmin ^ 5))
    (hst : (s : ℝ) < (t : ℝ))
    (hrank : cutRank (bandCuts κ lam z₀ γ x H) s =
      cutRank (bandCuts κ lam z₀ γ x H) t)
    (hsnc : (s : ℝ) ∉ bandCuts κ lam z₀ γ x H)
    (htnc : (t : ℝ) ∉ bandCuts κ lam z₀ γ x H)
    (hsheight : x / 2 ≤ bandF κ lam (z₀ + γ * (s : ℝ)) ∧
      bandF κ lam (z₀ + γ * (s : ℝ)) ≤ x)
    (htheight : x / 2 ≤ bandF κ lam (z₀ + γ * (t : ℝ)) ∧
      bandF κ lam (z₀ + γ * (t : ℝ)) ≤ x)
    (hZreal : ∀ r ∈ Set.Icc (s : ℝ) (t : ℝ),
      Zmin ≤ |z₀ + γ * r|) :
    ((t : ℝ) - (s : ℝ)) ≤
      max (x / (2 * H))
        (2 * H / (30 * γ ^ 2 * Zmin ^ 5)) := by
  let N : ℝ → ℝ := fun r => bandF κ lam (z₀ + γ * r)
  let N1 : ℝ → ℝ := fun r => deriv N r
  let N2 : ℝ → ℝ := fun r => deriv N1 r
  have hZpos : 0 < Zmin := by linarith
  have hγabs : 0 < |γ| := abs_pos.mpr hγ
  have hHpos : 0 < H := by
    rw [hH]
    have hxp : 0 < x * Zmin ^ 5 :=
      mul_pos hx (pow_pos hZpos 5)
    exact mul_pos hγabs (Real.sqrt_pos.2 hxp)
  have hreg := original_cut_free_real_regime
    κ lam z₀ γ x H s t hγ hHpos hst hrank
    hsnc htnc hsheight htheight
  have hab : (s : ℝ) ≤ (t : ℝ) := le_of_lt hst
  have hNcont : ContinuousOn N (Set.Icc (s : ℝ) (t : ℝ)) := by
    dsimp [N, bandF, bandU, bandG]
    fun_prop
  have hNdiff : DifferentiableOn ℝ N
      (Set.Ioo (s : ℝ) (t : ℝ)) := by
    dsimp [N, bandF, bandU, bandG]
    fun_prop
  rcases hreg.2 with hplus | hminus | hsmall
  · have hlength := first_band_interval_length_signed
      N (s : ℝ) (t : ℝ) H (x / 2) hst hHpos
      (by linarith) hNcont hNdiff
      (Or.inl (by
        intro r hr
        exact le_of_lt (hplus r (Set.Ioo_subset_Icc_self hr))))
      (by
        have hs := hreg.1 (s : ℝ) ⟨le_rfl, hab⟩
        have ht := hreg.1 (t : ℝ) ⟨hab, le_rfl⟩
        have hosc : |N (t : ℝ) - N (s : ℝ)| ≤ x / 2 := by
          have htn := ht
          have hsn := hs
          rcases abs_cases (N (t : ℝ) - N (s : ℝ)) <;> linarith
        exact hosc)
    calc
      (t : ℝ) - (s : ℝ) ≤ x / 2 / H := hlength
      _ = x / (2 * H) := by ring
      _ ≤ max (x / (2 * H))
          (2 * H / (30 * γ ^ 2 * Zmin ^ 5)) := le_max_left _ _
  · have hlength := first_band_interval_length_signed
      N (s : ℝ) (t : ℝ) H (x / 2) hst hHpos
      (by linarith) hNcont hNdiff
      (Or.inr (by
        intro r hr
        exact le_of_lt (hminus r (Set.Ioo_subset_Icc_self hr))))
      (by
        have hs := hreg.1 (s : ℝ) ⟨le_rfl, hab⟩
        have ht := hreg.1 (t : ℝ) ⟨hab, le_rfl⟩
        rcases abs_cases (N (t : ℝ) - N (s : ℝ)) <;> linarith)
    calc
      (t : ℝ) - (s : ℝ) ≤ x / 2 / H := hlength
      _ = x / (2 * H) := by ring
      _ ≤ max (x / (2 * H))
          (2 * H / (30 * γ ^ 2 * Zmin ^ 5)) := le_max_left _ _
  · have hLpos : 0 < 30 * γ ^ 2 * Zmin ^ 5 := by positivity
    have hN2cont : ContinuousOn N2
        (Set.Icc (s : ℝ) (t : ℝ)) := by
      have hfun : N2 = fun r : ℝ =>
          γ ^ 2 * bandF2 κ lam (z₀ + γ * r) := by
        funext r
        exact bandN_second_deriv κ lam z₀ γ r
      rw [hfun]
      dsimp [bandF2, bandU, bandG]
      fun_prop
    have hN2abs : ∀ r ∈ Set.Icc (s : ℝ) (t : ℝ),
        30 * γ ^ 2 * Zmin ^ 5 ≤ |N2 r| := by
      intro r hr
      have hzmin := hZreal r hr
      have hz : (100 : ℝ) ≤ |z₀ + γ * r| := le_trans hZmin hzmin
      have hZ7 : (90 : ℝ) * x ≤ |z₀ + γ * r| ^ 7 := by
        exact le_trans hlarge (pow_le_pow_left₀ (le_of_lt hZpos) hzmin 7)
      have hheight : |bandF κ lam (z₀ + γ * r)| ≤ x := by
        have hb := hreg.1 r hr
        have hhalf : 0 ≤ bandF κ lam (z₀ + γ * r) := by linarith
        rw [abs_of_nonneg hhalf]
        exact le_of_lt hb.2
      have hF1 : |bandF1 κ lam (z₀ + γ * r)| ≤
          Real.sqrt (x * |z₀ + γ * r| ^ 5) := by
        have hs := hsmall r hr
        have hd := bandN_deriv κ lam z₀ γ r
        rw [hd, abs_mul] at hs
        have hZ5 : Zmin ^ 5 ≤ |z₀ + γ * r| ^ 5 :=
          pow_le_pow_left₀ (le_of_lt hZpos) hzmin 5
        have hsqrt := Real.sqrt_le_sqrt
          (mul_le_mul_of_nonneg_left hZ5 (le_of_lt hx))
        rw [hH] at hs
        nlinarith [hs, hsqrt, hγabs]
      have hF2 := source_band_II κ lam (z₀ + γ * r) x
        (le_of_lt hx) hz hheight hZ7 hF1
      rw [show N2 r = γ ^ 2 * bandF2 κ lam (z₀ + γ * r) from
        bandN_second_deriv κ lam z₀ γ r]
      rw [abs_mul, abs_of_nonneg (sq_nonneg γ)]
      nlinarith [hF2, sq_nonneg γ,
        pow_le_pow_left₀ (le_of_lt hZpos) hzmin 5]
    have hN1expr : deriv N =
        fun r : ℝ => γ * bandF1 κ lam (z₀ + γ * r) := by
      funext r
      exact bandN_deriv κ lam z₀ γ r
    have hN1cont : ContinuousOn (deriv N)
        (Set.Icc (s : ℝ) (t : ℝ)) := by
      rw [hN1expr]
      dsimp [bandF1, bandU, bandG]
      fun_prop
    have hN1diff : DifferentiableOn ℝ (deriv N)
        (Set.Ioo (s : ℝ) (t : ℝ)) := by
      rw [hN1expr]
      dsimp [bandF1, bandU, bandG]
      fun_prop
    have hNeg : deriv (fun r : ℝ => -N r) =
        (fun r : ℝ => -(deriv N r)) := by
      funext r
      simp [deriv_neg]
    have hNegCont : ContinuousOn (deriv (fun r : ℝ => -N r))
        (Set.Icc (s : ℝ) (t : ℝ)) := by
      rw [hNeg]
      exact hN1cont.neg
    have hNegDiff : DifferentiableOn ℝ
        (deriv (fun r : ℝ => -N r))
        (Set.Ioo (s : ℝ) (t : ℝ)) := by
      rw [hNeg]
      exact hN1diff.neg
    rcases continuous_abs_lower_fixed_sign N2
      (s : ℝ) (t : ℝ)
      (30 * γ ^ 2 * Zmin ^ 5) hab hLpos hN2cont hN2abs
      with hcurvpos | hcurvneg
    · have hlength := second_band_interval_length
        N (s : ℝ) (t : ℝ) H
        (30 * γ ^ 2 * Zmin ^ 5) hst hLpos
        (le_of_lt hHpos)
        hN1cont hN1diff
        (by
          intro r hr
          exact hcurvpos r (Set.Ioo_subset_Icc_self hr))
        (le_of_lt (hsmall (s : ℝ) ⟨le_rfl, hab⟩))
        (le_of_lt (hsmall (t : ℝ) ⟨hab, le_rfl⟩))
      exact le_trans hlength (le_max_right _ _)
    · have hlength := second_band_interval_length
        (fun r => -N r) (s : ℝ) (t : ℝ) H
        (30 * γ ^ 2 * Zmin ^ 5) hst hLpos
        (le_of_lt hHpos)
        hNegCont hNegDiff
        (by
          intro r hr
          have hd : deriv (deriv (fun u => -N u)) r = -N2 r := by
            simp [N2, N1, deriv_neg]
          rw [hd]
          linarith [hcurvneg r (Set.Ioo_subset_Icc_self hr)])
        (by simpa [deriv_neg] using
          (le_of_lt (hsmall (s : ℝ) ⟨le_rfl, hab⟩)))
        (by simpa [deriv_neg] using
          (le_of_lt (hsmall (t : ℝ) ⟨hab, le_rfl⟩)))
      exact le_trans hlength (le_max_right _ _)

end A7PureNineSignedLevel

namespace A7PureNineSignedLevel

private theorem original_regime_I_real_diameter
    (κ lam z₀ γ x Zmin : ℝ) (s t : ℤ)
    (hx : 0 < x) (hγ : γ ≠ 0) (hlam : lam ≠ 0)
    (hZmin : (100 : ℝ) ≤ Zmin)
    (hlarge1 : (100 : ℝ) ≤ |lam| * Zmin ^ 2)
    (hlarge2 : (100 : ℝ) * x ≤ |lam| * Zmin ^ 9)
    (hst : (s : ℝ) < (t : ℝ))
    (hrank : cutRank
      (bandCuts κ lam z₀ γ x
        ((3 / 5 : ℝ) * |γ * lam| * Zmin ^ 8)) s =
      cutRank
      (bandCuts κ lam z₀ γ x
        ((3 / 5 : ℝ) * |γ * lam| * Zmin ^ 8)) t)
    (hsnc : (s : ℝ) ∉
      bandCuts κ lam z₀ γ x
        ((3 / 5 : ℝ) * |γ * lam| * Zmin ^ 8))
    (htnc : (t : ℝ) ∉
      bandCuts κ lam z₀ γ x
        ((3 / 5 : ℝ) * |γ * lam| * Zmin ^ 8))
    (hsheight : x / 2 ≤ bandF κ lam (z₀ + γ * (s : ℝ)) ∧
      bandF κ lam (z₀ + γ * (s : ℝ)) ≤ x)
    (htheight : x / 2 ≤ bandF κ lam (z₀ + γ * (t : ℝ)) ∧
      bandF κ lam (z₀ + γ * (t : ℝ)) ≤ x)
    (hZreal : ∀ r ∈ Set.Icc (s : ℝ) (t : ℝ),
      Zmin ≤ |z₀ + γ * r|) :
    ((t : ℝ) - (s : ℝ)) ≤
      x / (2 * ((3 / 5 : ℝ) * |γ * lam| * Zmin ^ 8)) := by
  let N : ℝ → ℝ := fun r => bandF κ lam (z₀ + γ * r)
  let δ : ℝ := (3 / 5 : ℝ) * |γ * lam| * Zmin ^ 8
  have hZpos : 0 < Zmin := by linarith
  have hδ : 0 < δ := by
    dsimp [δ]
    positivity
  have hreg := original_cut_free_real_regime
    κ lam z₀ γ x δ s t hγ hδ hst hrank
    hsnc htnc hsheight htheight
  have hab : (s : ℝ) ≤ (t : ℝ) := le_of_lt hst
  have hNlower : ∀ r ∈ Set.Icc (s : ℝ) (t : ℝ),
      δ ≤ |deriv N r| := by
    intro r hr
    let z : ℝ := z₀ + γ * r
    have hzmin : Zmin ≤ |z| := hZreal r hr
    have hz : (100 : ℝ) ≤ |z| := le_trans hZmin hzmin
    have hlam2 : (100 : ℝ) ≤ |lam| * |z| ^ 2 := by
      have hpow : Zmin ^ 2 ≤ |z| ^ 2 :=
        pow_le_pow_left₀ (le_of_lt hZpos) hzmin 2
      exact le_trans hlarge1
        (mul_le_mul_of_nonneg_left hpow (abs_nonneg lam))
    have hlam9 : (100 : ℝ) * x ≤ |lam| * |z| ^ 9 := by
      have hpow : Zmin ^ 9 ≤ |z| ^ 9 :=
        pow_le_pow_left₀ (le_of_lt hZpos) hzmin 9
      exact le_trans hlarge2
        (mul_le_mul_of_nonneg_left hpow (abs_nonneg lam))
    have hheight : |bandF κ lam z| ≤ x := by
      have hb := hreg.1 r hr
      have hnonneg : 0 ≤ bandF κ lam z := by
        dsimp [z]
        linarith
      rw [abs_of_nonneg hnonneg]
      exact le_of_lt hb.2
    have hF1 := source_band_I κ lam z x (le_of_lt hx)
      hz hheight hlam2 hlam9
    have hpow : Zmin ^ 8 ≤ |z| ^ 8 :=
      pow_le_pow_left₀ (le_of_lt hZpos) hzmin 8
    rw [show deriv N r = γ * bandF1 κ lam z from
      bandN_deriv κ lam z₀ γ r]
    dsimp [δ]
    rw [abs_mul, abs_mul]
    have hsrc :
        (3 / 5 : ℝ) * |lam| * Zmin ^ 8 ≤ |bandF1 κ lam z| :=
      (mul_le_mul_of_nonneg_left hpow (by positivity)).trans hF1
    have hscaled := mul_le_mul_of_nonneg_left hsrc (abs_nonneg γ)
    nlinarith [hscaled]
  have hNcont : ContinuousOn N (Set.Icc (s : ℝ) (t : ℝ)) := by
    dsimp [N, bandF, bandU, bandG]
    fun_prop
  have hNdiff : DifferentiableOn ℝ N
      (Set.Ioo (s : ℝ) (t : ℝ)) := by
    dsimp [N, bandF, bandU, bandG]
    fun_prop
  have hosc : |N (t : ℝ) - N (s : ℝ)| ≤ x / 2 := by
    have hs := hreg.1 (s : ℝ) ⟨le_rfl, hab⟩
    have ht := hreg.1 (t : ℝ) ⟨hab, le_rfl⟩
    rcases abs_cases (N (t : ℝ) - N (s : ℝ)) <;> linarith
  rcases hreg.2 with hplus | hminus | hsmall
  · have hlen := first_band_interval_length_signed
      N (s : ℝ) (t : ℝ) δ (x / 2) hst hδ
      (by linarith) hNcont hNdiff
      (Or.inl (by
        intro r hr
        exact le_of_lt (hplus r (Set.Ioo_subset_Icc_self hr))))
      hosc
    change (t : ℝ) - (s : ℝ) ≤ x / (2 * δ)
    calc
      (t : ℝ) - (s : ℝ) ≤ x / 2 / δ := hlen
      _ = x / (2 * δ) := by
        field_simp [ne_of_gt hδ] <;> ring
  · have hlen := first_band_interval_length_signed
      N (s : ℝ) (t : ℝ) δ (x / 2) hst hδ
      (by linarith) hNcont hNdiff
      (Or.inr (by
        intro r hr
        exact le_of_lt (hminus r (Set.Ioo_subset_Icc_self hr))))
      hosc
    change (t : ℝ) - (s : ℝ) ≤ x / (2 * δ)
    calc
      (t : ℝ) - (s : ℝ) ≤ x / 2 / δ := hlen
      _ = x / (2 * δ) := by
        field_simp [ne_of_gt hδ] <;> ring
  · have hsm := hsmall (s : ℝ) ⟨le_rfl, hab⟩
    have hlow := hNlower (s : ℝ) ⟨le_rfl, hab⟩
    linarith

end A7PureNineSignedLevel

