noncomputable abbrev ell (A B : ℝ) (M : ℕ) (s : ℝ) : ℝ :=
  CofactorCubic.heightAt B A M s
noncomputable abbrev lam (A B : ℝ) (M : ℕ) (s : ℝ) : ℝ :=
  CofactorCubic.lambdaAt B A M s
noncomputable abbrev U := CofactorCubic.U
noncomputable abbrev V := CofactorCubic.V
noncomputable abbrev rho := CofactorCubic.rho
abbrev indices := CofactorCubic.indices

lemma positive (A B : ℝ) (M : ℕ) (s : ℝ)
    (hA : 0 < A) (hB : 0 < B) (hM : (0 : ℝ) < M) : 0 < ell A B M s :=
  (CofactorCubic.positiveAt B A M s hB hA hM).2

lemma lambda_le_norm (A B : ℝ) (M : ℕ) (s : ℝ)
    (b : ℤ × ℤ) (hb : b ≠ 0) :
    lam A B M s ≤ Real.sqrt (nsq ((M : ℝ) / A) s B b) := by
  have hbounded : BddBelow (CofactorCubic.normsAt B A M s) := by
    refine ⟨0, ?_⟩
    rintro r ⟨p, q, hpq, rfl⟩
    exact Real.sqrt_nonneg _
  exact csInf_le hbounded ⟨b.1, b.2, CofactorCubic.pair_nonzero hb, rfl⟩

lemma cap (A B : ℝ) (M : ℕ) (s : ℝ)
    (hA : 0 < A) (hB : 0 < B) (hM : (1 : ℝ) ≤ M) :
    ell A B M s ≤ max A B := by
  have hM0 : (0 : ℝ) < M := by linarith
  obtain ⟨b, hb, heq, hpos⟩ := CofactorCubic.minimumAt B A M s hB hA hM0
  have hnpos : 0 < Real.sqrt (nsq ((M : ℝ) / A) s B b) := by rw [← heq]; exact hpos
  have hell : ell A B M s = 1 / Real.sqrt (nsq ((M : ℝ) / A) s B b) := by
    change 1 / CofactorCubic.lambdaAt B A M s = _
    rw [heq]
  have hc1 : |(M : ℝ) / A * ((b.1 : ℝ) - s * (b.2 : ℝ))| ≤
      Real.sqrt (nsq ((M : ℝ) / A) s B b) :=
    Real.abs_le_sqrt (by unfold nsq; nlinarith [sq_nonneg ((b.2 : ℝ) / B)])
  have hc2 : |(b.2 : ℝ) / B| ≤ Real.sqrt (nsq ((M : ℝ) / A) s B b) :=
    Real.abs_le_sqrt (by
      unfold nsq
      nlinarith [sq_nonneg ((M : ℝ) / A * ((b.1 : ℝ) - s * (b.2 : ℝ)))])
  by_cases hq : b.2 = 0
  · have hp : b.1 ≠ 0 := by
      rcases CofactorCubic.pair_nonzero hb with h | h
      · exact h
      · exact False.elim (h hq)
    have hpI : (1 : ℤ) ≤ |b.1| := by have := abs_pos.mpr hp; omega
    have hpR : (1 : ℝ) ≤ |(b.1 : ℝ)| := by exact_mod_cast hpI
    have hc : (M : ℝ) / A * |(b.1 : ℝ)| ≤
        Real.sqrt (nsq ((M : ℝ) / A) s B b) := by
      simpa only [hq, Int.cast_zero, mul_zero, sub_zero, abs_mul,
        abs_of_pos (div_pos hM0 hA)] using hc1
    have hmul := mul_le_mul_of_nonneg_right hc hA.le
    have e : ((M : ℝ) / A * |(b.1 : ℝ)|) * A = (M : ℝ) * |(b.1 : ℝ)| := by
      field_simp
    rw [e] at hmul
    have hbound : ell A B M s ≤ A := by
      rw [hell, div_le_iff₀ hnpos]
      nlinarith
    exact hbound.trans (le_max_left _ _)
  · have hqI : (1 : ℤ) ≤ |b.2| := by have := abs_pos.mpr hq; omega
    have hqR : (1 : ℝ) ≤ |(b.2 : ℝ)| := by exact_mod_cast hqI
    rw [abs_div, abs_of_pos hB, div_le_iff₀ hB] at hc2
    have hbound : ell A B M s ≤ B := by
      rw [hell, div_le_iff₀ hnpos]
      nlinarith
    exact hbound.trans (le_max_right _ _)

lemma dilation_le (A B : ℝ) (M : ℕ) (s : ℝ)
    (hA : 0 < A) (hB : 0 < B) (hM : (0 : ℝ) < M) :
    ell A B M s ≤ ell (2 * A) (2 * B) M s := by
  obtain ⟨b, hb, heq, hpos⟩ := CofactorCubic.minimumAt B A M s hB hA hM
  have hnewpos : 0 < lam (2 * A) (2 * B) M s :=
    (CofactorCubic.positiveAt (2 * B) (2 * A) M s (by positivity) (by positivity) hM).1
  have hnorm : Real.sqrt (nsq ((M : ℝ) / (2 * A)) s (2 * B) b) ≤
      Real.sqrt (nsq ((M : ℝ) / A) s B b) := by
    apply Real.sqrt_le_sqrt
    unfold nsq
    have e1 : (M : ℝ) / (2 * A) * ((b.1 : ℝ) - s * (b.2 : ℝ)) =
        ((M : ℝ) / A * ((b.1 : ℝ) - s * (b.2 : ℝ))) / 2 := by
      field_simp
    have e2 : (b.2 : ℝ) / (2 * B) = ((b.2 : ℝ) / B) / 2 := by
      field_simp
    rw [e1, e2]
    nlinarith [sq_nonneg ((M : ℝ) / A * ((b.1 : ℝ) - s * (b.2 : ℝ))),
      sq_nonneg ((b.2 : ℝ) / B)]
  have hlam : lam (2 * A) (2 * B) M s ≤ lam A B M s := by
    rw [show lam A B M s = Real.sqrt (nsq ((M : ℝ) / A) s B b) from heq]
    exact (lambda_le_norm (2 * A) (2 * B) M s b hb).trans hnorm
  exact one_div_le_one_div_of_le hnewpos hlam

lemma divisor_half_fractional (theta : ℝ) (ht0 : 0 < theta) (ht2 : theta < 2) :
    ∃ C : ℝ, 0 < C ∧ ∀ D E : ℝ, 1 / 2 ≤ D → 1 / 2 ≤ E →
      ∀ M : ℕ, 1 ≤ M →
        (indices D E M).Finite ∧
        (∑ᶠ j ∈ indices D E M, ell D E M (rho D E M j) ^ theta) ≤
          C * (M : ℝ) ^ (1 - theta / 2) *
            (D * E + (D ^ 2 + E ^ 2) / (M : ℝ)) ^ (theta / 2) := by
  obtain ⟨C0, hC0, hfrac⟩ :=
    JocelynClaims.claim_b0df9f9d701b76ce2d198f86252d56e1ed22acd81961babfaf5b37bb56cec163 theta ht0 ht2
  refine ⟨C0 * 4 ^ (theta / 2), by positivity, ?_⟩
  intro D E hD hE M hM
  classical
  have hD0 : 0 < D := by linarith
  have hE0 : 0 < E := by linarith
  have hM0 : (0 : ℝ) < M := by exact_mod_cast (by omega : 0 < M)
  have hrho : ∀ j, ActualMoments.rho (2 * D) (2 * E) M j = rho D E M j := by
    intro j
    unfold ActualMoments.rho rho CofactorCubic.rho
    field_simp
    <;> ring
  have hlo : (2 * D) / (2 * (2 * E)) = D / (2 * E) := by field_simp <;> ring
  have hup : 2 * (2 * D) / (2 * E) = 2 * D / E := by field_simp <;> ring
  have hJ : ActualMoments.indices (2 * D) (2 * E) M = indices D E M := by
    ext j
    change (_ ≤ ActualMoments.rho (2 * D) (2 * E) M j ∧
      ActualMoments.rho (2 * D) (2 * E) M j ≤ _) ↔
      (_ ≤ rho D E M j ∧ rho D E M j ≤ _)
    rw [hrho j, hlo, hup]
  obtain ⟨hfin0, hcard, hpos0, hbound⟩ := hfrac (2 * D) (2 * E) (by linarith) (by linarith) M hM
  change (ActualMoments.indices (2 * D) (2 * E) M).Finite at hfin0
  change (∑ᶠ j ∈ ActualMoments.indices (2 * D) (2 * E) M,
    ActualMoments.ell (2 * D) (2 * E) M j ^ theta) ≤
      C0 * (M : ℝ) ^ (1 - theta / 2) *
        ((2 * D) * (2 * E) + ((2 * D) ^ 2 + (2 * E) ^ 2) / (M : ℝ)) ^ (theta / 2) at hbound
  have hfin : (indices D E M).Finite := by rwa [hJ] at hfin0
  rw [hJ] at hbound
  have hcompare : (∑ᶠ j ∈ indices D E M, ell D E M (rho D E M j) ^ theta) ≤
      ∑ᶠ j ∈ indices D E M, ActualMoments.ell (2 * D) (2 * E) M j ^ theta := by
    rw [finsum_mem_eq_finite_toFinset_sum _ hfin,
      finsum_mem_eq_finite_toFinset_sum _ hfin]
    apply Finset.sum_le_sum
    intro j hj
    have he : ActualMoments.ell (2 * D) (2 * E) M j =
        ell (2 * D) (2 * E) M (rho D E M j) := by
      change ell (2 * D) (2 * E) M (ActualMoments.rho (2 * D) (2 * E) M j) = _
      rw [hrho j]
    rw [he]
    exact Real.rpow_le_rpow (positive D E M _ hD0 hE0 hM0).le
      (dilation_le D E M _ hD0 hE0 hM0) ht0.le
  have hQ : (2 * D) * (2 * E) + ((2 * D) ^ 2 + (2 * E) ^ 2) / (M : ℝ) =
      4 * (D * E + (D ^ 2 + E ^ 2) / (M : ℝ)) := by ring
  rw [hQ, Real.mul_rpow (by norm_num) (by positivity)] at hbound
  refine ⟨hfin, ?_⟩
  calc
    _ ≤ _ := hcompare.trans hbound
    _ = _ := by ring

lemma scale_bounds (K x A : ℝ) (hK : 0 < K) (hx : 2 ≤ x)
    (hA : 1 / 2 ≤ A) (hAu : A ≤ x ^ K) :
    x ^ (-(3 * K + 4)) ≤ A ∧ A ≤ x ^ (3 * K + 4) ∧
      x ^ (-(3 * K + 4)) ≤ U A x ∧ U A x ≤ x ^ (3 * K + 4) := by
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hA0 : 0 < A := by linarith
  have hJ1 : 1 ≤ 3 * K + 4 := by linarith
  have hxJ : 2 ≤ x ^ (3 * K + 4) := by
    have hh := Real.rpow_le_rpow_of_exponent_le hx1 hJ1
    rw [Real.rpow_one] at hh
    exact hx.trans hh
  have hlowhalf : x ^ (-(3 * K + 4)) ≤ 1 / 2 := by
    calc
      _ = 1 / x ^ (3 * K + 4) := by rw [Real.rpow_neg hx0.le]; simp only [one_div]
      _ ≤ 1 / 2 := one_div_le_one_div_of_le (by norm_num) hxJ
  have hupper : A ≤ x ^ (3 * K + 4) :=
    hAu.trans (Real.rpow_le_rpow_of_exponent_le hx1 (by linarith))
  have hUeq : U A x = x / A ^ 3 := by
    unfold U CofactorCubic.U
    rw [Real.rpow_neg hA0.le]
    norm_num
    ring
  have hcube : A ^ 3 ≤ x ^ (3 * K) := by
    calc
      _ ≤ (x ^ K) ^ 3 := pow_le_pow_left₀ hA0.le hAu 3
      _ = _ := by rw [← Real.rpow_mul_natCast hx0.le]; congr 1 <;> ring
  have hUlower : x ^ (-(3 * K + 4)) ≤ U A x := by
    rw [hUeq]
    calc
      _ ≤ x ^ (-(3 * K)) := Real.rpow_le_rpow_of_exponent_le hx1 (by linarith)
      _ = 1 / x ^ (3 * K) := by rw [Real.rpow_neg hx0.le]; simp only [one_div]
      _ ≤ 1 / A ^ 3 := one_div_le_one_div_of_le (pow_pos hA0 3) hcube
      _ ≤ x / A ^ 3 := div_le_div_of_nonneg_right hx1 (pow_nonneg hA0.le 3)
  have hUupper : U A x ≤ x ^ (3 * K + 4) := by
    rw [hUeq]
    have hcubelow : (1 / 2 : ℝ) ^ 3 ≤ A ^ 3 :=
      pow_le_pow_left₀ (by norm_num) hA 3
    have hxthree : (8 : ℝ) ≤ x ^ 3 := by
      have := pow_le_pow_left₀ (by norm_num : (0 : ℝ) ≤ 2) hx 3
      norm_num at this
      exact this
    calc
      _ ≤ x / (1 / 2 : ℝ) ^ 3 :=
        div_le_div_of_nonneg_left hx0.le (by norm_num) hcubelow
      _ = 8 * x := by ring
      _ ≤ x ^ 4 := by nlinarith [mul_le_mul_of_nonneg_right hxthree hx0.le]
      _ = x ^ (4 : ℝ) := by norm_num
      _ ≤ x ^ (3 * K + 4) := Real.rpow_le_rpow_of_exponent_le hx1 (by linarith)
  exact ⟨hlowhalf.trans hA, hupper, hUlower, hUupper⟩

lemma budget_lower (x J A B : ℝ) (M : ℕ) (hx : 0 < x)
    (hA : 0 < A) (hB : 0 < B) (hM : (0 : ℝ) < M)
    (hAl : x ^ (-J) ≤ A) (hBl : x ^ (-J) ≤ B) :
    x ^ (-2 * J) ≤ A * B + (A ^ 2 + B ^ 2) / (M : ℝ) := by
  have hh : x ^ (-J) * x ^ (-J) ≤ A * B :=
    mul_le_mul hAl hBl (Real.rpow_nonneg hx.le _) hA.le
  have he : x ^ (-2 * J) = x ^ (-J) * x ^ (-J) := by
    rw [← Real.rpow_add hx]
    congr 1
    ring
  rw [he]
  have : 0 ≤ (A ^ 2 + B ^ 2) / (M : ℝ) := by positivity
  linarith

lemma upgrade (x J eps delta theta C Q Mr : ℝ) (S : Finset ℕ) (f : ℕ → ℝ)
    (hx : 2 ≤ x) (hJ : 0 < J) (heps : 0 < eps) (hd : 0 < delta)
    (htheta : theta = 2 - delta) (hexp : 5 * J * delta / 2 ≤ eps)
    (hC : 0 < C) (hQ : 0 < Q) (hQl : x ^ (-2 * J) ≤ Q)
    (hMr : 1 ≤ Mr) (hMu : Mr ≤ x ^ J)
    (hf : ∀ j ∈ S, 0 < f j) (hcap : ∀ j ∈ S, f j ≤ x ^ J)
    (hfrac : ∑ j ∈ S, f j ^ theta ≤ C * Mr ^ (1 - theta / 2) * Q ^ (theta / 2)) :
    ∑ j ∈ S, (f j) ^ 2 ≤ C * x ^ eps * Q := by
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hMr0 : 0 < Mr := by linarith
  have hp : ∀ j ∈ S, (f j) ^ 2 ≤ x ^ (J * delta) * f j ^ theta := by
    intro j hj
    have he : delta + theta = 2 := by linarith
    have hsplit : (f j) ^ 2 = (f j) ^ delta * (f j) ^ theta := by
      rw [← Real.rpow_add (hf j hj), he]
      norm_num
    have hh : (f j) ^ delta ≤ x ^ (J * delta) := by
      calc
        _ ≤ (x ^ J) ^ delta :=
          Real.rpow_le_rpow (hf j hj).le (hcap j hj) hd.le
        _ = _ := by rw [← Real.rpow_mul hx0.le]
    rw [hsplit]
    exact mul_le_mul_of_nonneg_right hh (Real.rpow_nonneg (hf j hj).le _)
  have hMpow : Mr ^ (1 - theta / 2) ≤ x ^ (J * delta / 2) := by
    have he : 1 - theta / 2 = delta / 2 := by linarith
    rw [he]
    calc
      _ ≤ (x ^ J) ^ (delta / 2) :=
        Real.rpow_le_rpow hMr0.le hMu (by positivity)
      _ = _ := by rw [← Real.rpow_mul hx0.le]; congr 1 <;> ring
  have hQpowlo : x ^ (-(J * delta)) ≤ Q ^ (delta / 2) := by
    calc
      _ = (x ^ (-2 * J)) ^ (delta / 2) := by
        rw [← Real.rpow_mul hx0.le]
        congr 1
        ring
      _ ≤ _ := Real.rpow_le_rpow (Real.rpow_nonneg hx0.le _) hQl (by positivity)
  have hInv : 1 / Q ^ (delta / 2) ≤ x ^ (J * delta) := by
    calc
      _ ≤ 1 / x ^ (-(J * delta)) :=
        one_div_le_one_div_of_le (Real.rpow_pos_of_pos hx0 _) hQpowlo
      _ = _ := by rw [Real.rpow_neg hx0.le]; simp
  have hQpow : Q ^ (theta / 2) ≤ Q * x ^ (J * delta) := by
    have he : theta / 2 = 1 - delta / 2 := by linarith
    rw [he, Real.rpow_sub hQ, Real.rpow_one]
    have hh := mul_le_mul_of_nonneg_left hInv hQ.le
    simpa only [one_div, div_eq_mul_inv, one_mul] using hh
  have hprod : C * Mr ^ (1 - theta / 2) * Q ^ (theta / 2) ≤
      C * x ^ (J * delta / 2) * (Q * x ^ (J * delta)) := by
    calc
      _ ≤ C * x ^ (J * delta / 2) * Q ^ (theta / 2) := by gcongr
      _ ≤ _ := mul_le_mul_of_nonneg_left hQpow (by positivity)
  have hepow : x ^ (J * delta) * x ^ (J * delta / 2) * x ^ (J * delta) =
      x ^ (5 * J * delta / 2) := by
    rw [← Real.rpow_add hx0, ← Real.rpow_add hx0]
    congr 1
    ring
  calc
    _ ≤ ∑ j ∈ S, x ^ (J * delta) * f j ^ theta := Finset.sum_le_sum hp
    _ = x ^ (J * delta) * ∑ j ∈ S, f j ^ theta := by rw [Finset.mul_sum]
    _ ≤ x ^ (J * delta) * (C * Mr ^ (1 - theta / 2) * Q ^ (theta / 2)) :=
      mul_le_mul_of_nonneg_left hfrac (by positivity)
    _ ≤ x ^ (J * delta) * (C * x ^ (J * delta / 2) * (Q * x ^ (J * delta))) :=
      mul_le_mul_of_nonneg_left hprod (by positivity)
    _ = C * Q * (x ^ (J * delta) * x ^ (J * delta / 2) * x ^ (J * delta)) := by ring
    _ = C * Q * x ^ (5 * J * delta / 2) := by rw [hepow]
    _ ≤ C * Q * x ^ eps :=
      mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_le hx1 hexp) (by positivity)
    _ = _ := by ring

theorem main :
    ∀ K eps : ℝ, 0 < K → 0 < eps →
      ∃ C : ℝ, 0 < C ∧
        ∀ x D E : ℝ, 2 ≤ x →
          1 / 2 ≤ D → D ≤ x ^ K →
          1 / 2 ≤ E → E ≤ x ^ K →
          ∀ M : ℕ, 1 ≤ M → (M : ℝ) ≤ x ^ K →
            (indices D E M).Finite ∧
            (∑ᶠ j ∈ indices D E M, (ell D E M (rho D E M j)) ^ 2) ≤
              C * x ^ eps * (D * E + (D ^ 2 + E ^ 2) / (M : ℝ)) ∧
            (∑ᶠ j ∈ indices D E M,
              (ell (V E x) (U D x) M ((rho D E M j) ^ (3 : ℕ))) ^ 2) ≤
              C * x ^ eps *
                (U D x * V E x + ((U D x) ^ 2 + (V E x) ^ 2) / (M : ℝ)) := by
  intro K eps hK heps
  let J : ℝ := 3 * K + 4
  have hJ : 0 < J := by dsimp [J]; linarith
  let delta : ℝ := eps / (3 * J + eps)
  have hd : 0 < delta := by dsimp [delta]; positivity
  have hd1 : delta < 1 := by
    dsimp [delta]
    rw [div_lt_one (by positivity)]
    linarith
  let theta : ℝ := 2 - delta
  have ht0 : 0 < theta := by dsimp [theta]; linarith
  have ht2 : theta < 2 := by dsimp [theta]; linarith
  have hdeq : delta * (3 * J + eps) = eps := by
    dsimp [delta]
    field_simp
  have hexp : 5 * J * delta / 2 ≤ eps := by
    have hh : 0 ≤ delta * eps := mul_nonneg hd.le heps.le
    have hjd : 0 ≤ J * delta := mul_nonneg hJ.le hd.le
    nlinarith
  obtain ⟨Cd, hCd, hdiv⟩ := divisor_half_fractional theta ht0 ht2
  obtain ⟨Cc, hCc, hcof⟩ :=
    JocelynClaims.claim_7e54798ea025c68b1e48539610a91c4cf9e238603d6b930c8479287108b8d48c
      theta ht0 ht2
  refine ⟨Cd + Cc, add_pos hCd hCc, ?_⟩
  intro x D E hx hD hDu hE hEu M hM hMu
  classical
  have hx0 : 0 < x := by linarith
  have hx1 : 1 ≤ x := by linarith
  have hD0 : 0 < D := by linarith
  have hE0 : 0 < E := by linarith
  have hM1 : (1 : ℝ) ≤ M := by exact_mod_cast hM
  have hM0 : (0 : ℝ) < M := by linarith
  have hU : 0 < U D x := by unfold U CofactorCubic.U; positivity
  have hV : 0 < V E x := by unfold V CofactorCubic.V; positivity
  obtain ⟨hDl, hDupper, hUl, hUupper⟩ := scale_bounds K x D hK hx hD hDu
  obtain ⟨hEl, hEupper, hVl, hVupper⟩ := scale_bounds K x E hK hx hE hEu
  have hMu' : (M : ℝ) ≤ x ^ J :=
    hMu.trans (Real.rpow_le_rpow_of_exponent_le hx1 (by dsimp [J]; linarith))
  obtain ⟨hfin, hfd⟩ := hdiv D E hD hE M hM
  obtain ⟨hfinC, hcard, hpos, hfc0⟩ := hcof D E x hD hE (by linarith) M hM
  have hfc : (∑ᶠ j ∈ indices D E M,
      ell (V E x) (U D x) M ((rho D E M j) ^ (3 : ℕ)) ^ theta) ≤
      Cc * (M : ℝ) ^ (1 - theta / 2) *
        (U D x * V E x + ((U D x) ^ 2 + (V E x) ^ 2) / (M : ℝ)) ^ (theta / 2) := hfc0
  let S : Finset ℕ := hfin.toFinset
  have hSmem : ∀ j, j ∈ S ↔ j ∈ indices D E M := fun j => Set.Finite.mem_toFinset hfin
  let Qd : ℝ := D * E + (D ^ 2 + E ^ 2) / (M : ℝ)
  let Qc : ℝ := U D x * V E x + ((U D x) ^ 2 + (V E x) ^ 2) / (M : ℝ)
  have hQd : 0 < Qd := by dsimp [Qd]; positivity
  have hQc : 0 < Qc := by dsimp [Qc]; positivity
  have hQdl : x ^ (-2 * J) ≤ Qd :=
    budget_lower x J D E M hx0 hD0 hE0 hM0 hDl hEl
  have hQcl : x ^ (-2 * J) ≤ Qc :=
    budget_lower x J (U D x) (V E x) M hx0 hU hV hM0 hUl hVl
  rw [finsum_mem_eq_finite_toFinset_sum _ hfin] at hfd hfc
  have hupD := upgrade x J eps delta theta Cd Qd (M : ℝ) S
    (fun j => ell D E M (rho D E M j))
    hx hJ heps hd rfl hexp hCd hQd hQdl hM1 hMu'
    (fun j _ => positive D E M _ hD0 hE0 hM0)
    (fun j _ => (cap D E M _ hD0 hE0 hM1).trans (max_le hDupper hEupper))
    hfd
  have hupC := upgrade x J eps delta theta Cc Qc (M : ℝ) S
    (fun j => ell (V E x) (U D x) M ((rho D E M j) ^ (3 : ℕ)))
    hx hJ heps hd rfl hexp hCc hQc hQcl hM1 hMu'
    (fun j _ => positive (V E x) (U D x) M _ hV hU hM0)
    (fun j _ => (cap (V E x) (U D x) M _ hV hU hM1).trans (max_le hVupper hUupper))
    hfc
  refine ⟨hfin, ?_, ?_⟩
  · rw [finsum_mem_eq_finite_toFinset_sum _ hfin]
    calc
      _ ≤ Cd * x ^ eps * Qd := hupD
      _ = Cd * (x ^ eps * Qd) := by ring
      _ ≤ (Cd + Cc) * (x ^ eps * Qd) :=
        mul_le_mul_of_nonneg_right (by linarith) (by positivity)
      _ = _ := by ring
  · rw [finsum_mem_eq_finite_toFinset_sum _ hfin]
    calc
      _ ≤ Cc * x ^ eps * Qc := hupC
      _ = Cc * (x ^ eps * Qc) := by ring
      _ ≤ (Cd + Cc) * (x ^ eps * Qc) :=
        mul_le_mul_of_nonneg_right (by linarith) (by positivity)
      _ = _ := by ring

end JointSecondMoments

theorem JocelynClaims.claim_d376703957db1ec7f622174a5c741074ec409ecc033a6a565d9398ae0250db98 :
let U : ℝ → ℝ → ℝ := fun D x => x * D ^ (-(3 : ℝ));
let V : ℝ → ℝ → ℝ := fun E x => x * E ^ (-(3 : ℝ));
let rho : ℝ → ℝ → ℕ → ℕ → ℝ :=
  fun D E M j => D / (2 * E) * (1 + 1 / (M : ℝ)) ^ j;
let indices : ℝ → ℝ → ℕ → Set ℕ :=
  fun D E M => {j | D / (2 * E) ≤ rho D E M j ∧ rho D E M j ≤ 2 * D / E};
let nonzeroNorms : ℝ → ℝ → ℕ → ℝ → Set ℝ :=
  fun A B M s => {r | ∃ p q : ℤ, (p ≠ 0 ∨ q ≠ 0) ∧
    Real.sqrt (((M : ℝ) / A * ((p : ℝ) - s * (q : ℝ))) ^ 2 +
      ((q : ℝ) / B) ^ 2) = r};
let ell : ℝ → ℝ → ℕ → ℝ → ℝ :=
  fun A B M s => 1 / sInf (nonzeroNorms A B M s);
∀ K eps : ℝ, 0 < K → 0 < eps →
  ∃ C : ℝ, 0 < C ∧
    ∀ x D E : ℝ, 2 ≤ x →
      1 / 2 ≤ D → D ≤ x ^ K →
      1 / 2 ≤ E → E ≤ x ^ K →
      ∀ M : ℕ, 1 ≤ M → (M : ℝ) ≤ x ^ K →
        (indices D E M).Finite ∧
        (∑ᶠ j ∈ indices D E M, (ell D E M (rho D E M j)) ^ 2) ≤
          C * x ^ eps * (D * E + (D ^ 2 + E ^ 2) / (M : ℝ)) ∧
        (∑ᶠ j ∈ indices D E M,
          (ell (V E x) (U D x) M ((rho D E M j) ^ (3 : ℕ))) ^ 2) ≤
          C * x ^ eps *
            (U D x * V E x + ((U D x) ^ 2 + (V E x) ^ 2) / (M : ℝ)) := by
  exact JointSecondMoments.main

namespace A6ActualTriangularLatticeFrameStatement

noncomputable section

abbrev IntegerPoint := Fin 2 → ℤ
abbrev RealPoint := Fin 2 → ℝ
abbrev IntegerMatrix := Matrix (Fin 2) (Fin 2) ℤ
abbrev RealMatrix := Matrix (Fin 2) (Fin 2) ℝ

def integerEmbedding (z : IntegerPoint) : RealPoint :=
  fun i => (z i : ℝ)

def triangularMatrix (D E M s : ℝ) : RealMatrix :=
  ![![M / D, -M * s / D], ![0, 1 / E]]

def triangularInverse (D E M s : ℝ) : RealMatrix :=
  ![![D / M, s * E], ![0, E]]

def transformedPoint (D E M s : ℝ) (z : IntegerPoint) : RealPoint :=
  (triangularMatrix D E M s).mulVec (integerEmbedding z)

def euclideanNorm (v : RealPoint) : ℝ :=
  Real.sqrt (v 0 ^ 2 + v 1 ^ 2)

def nonzeroLatticeNorms (D E M s : ℝ) : Set ℝ :=
  {r | ∃ z : IntegerPoint, z ≠ 0 ∧
    euclideanNorm (transformedPoint D E M s z) = r}

def shortestNorm (D E M s : ℝ) : ℝ :=
  sInf (nonzeroLatticeNorms D E M s)

def reciprocalShortestNorm (D E M s : ℝ) : ℝ :=
  1 / shortestNorm D E M s

def integerMatrixBound (P : IntegerMatrix) (H : ℝ) : Prop :=
  ∀ i j : Fin 2, |((P i j : ℤ) : ℝ)| ≤ H

def physicalCell (c0 D E M s : ℝ) : Set IntegerPoint :=
  {z | |((z 0 : ℤ) : ℝ) - s * ((z 1 : ℤ) : ℝ)| ≤ c0 * D / M ∧
    |((z 1 : ℤ) : ℝ)| ≤ c0 * E}

def integerCoordinates (A : IntegerMatrix) (z : IntegerPoint) : IntegerPoint :=
  A.mulVec z

def wholeStatement : Prop :=
  ∀ c0 : ℝ, 1 ≤ c0 →
    ∃ C : ℝ, 0 < C ∧
      ∀ D E M s : ℝ,
        1 ≤ D → 1 ≤ E → 1 ≤ M → |s| ≤ c0 * D / E →
          0 < shortestNorm D E M s ∧
          0 < reciprocalShortestNorm D E M s ∧
          reciprocalShortestNorm D E M s ≤ C * max D E ∧
          ∃ P A : IntegerMatrix,
            A * P = 1 ∧ P * A = 1 ∧
            integerMatrixBound P (C * M * max D E) ∧
            integerMatrixBound A (C * M * max D E) ∧
            ∀ z : IntegerPoint, z ∈ physicalCell c0 D E M s →
              ∀ i : Fin 2,
                |((integerCoordinates A z i : ℤ) : ℝ)| ≤
                  C * reciprocalShortestNorm D E M s

set_option maxHeartbeats 50000
set_option maxRecDepth 5000

open FormalAB.S5ecab545.JocelynWorkspace.Formalization.PowerfulCounting.CountingClosure.C09.PcPellRed

private lemma int_abs_one (z : ℤ) (hz : z ≠ 0) : 1 ≤ |(z : ℝ)| := by
  have hh : z ≤ -1 ∨ 1 ≤ z := by omega
  rcases hh with hh | hh
  · have hr : (z : ℝ) ≤ -1 := by exact_mod_cast hh
    nlinarith only [hr,neg_le_abs (z : ℝ)]
  · have hr : (1 : ℝ) ≤ z := by exact_mod_cast hh
    nlinarith only [hr,le_abs_self (z : ℝ)]

private lemma int_sq_one (z : ℤ) (hz : z ≠ 0) : 1 ≤ (z : ℝ)^2 := by
  have hh := int_abs_one z hz
  nlinarith only [hh,sq_abs (z : ℝ),abs_nonneg (z : ℝ)]

private lemma pair_ne (b : ℤ × ℤ) (hb : b ≠ 0) :
    (![b.1,b.2] : IntegerPoint) ≠ 0 := by
  intro hz
  apply hb
  have h0 := congrArg (fun v : IntegerPoint => v 0) hz
  have h1 := congrArg (fun v : IntegerPoint => v 1) hz
  ext
  · simpa using h0
  · simpa using h1

private lemma norm_eq (D E M s : ℝ) (z : IntegerPoint) :
    euclideanNorm (transformedPoint D E M s z) =
      Real.sqrt (nsq (M/D) s E (z 0,z 1)) := by
  unfold euclideanNorm transformedPoint triangularMatrix integerEmbedding nsq
  congr 1
  simp only [Matrix.mulVec, dotProduct, Fin.sum_univ_two,
    Matrix.cons_val_zero, Matrix.cons_val_one, zero_mul, zero_add]
  ring

private lemma norm_scaled (D E M s c0 : ℝ)
    (hD : 0 < D) (hE : 0 < E) (hc0 : 0 < c0) (b : ℤ × ℤ) :
    euclideanNorm (transformedPoint D E M s ![b.1,b.2]) =
      c0 * Real.sqrt (nsq (M/(c0*D)) s (c0*E) b) := by
  rw [norm_eq]
  have he :
      nsq (M/D) s E b =
        c0^2 * nsq (M/(c0*D)) s (c0*E) b := by
    unfold nsq
    field_simp [hD.ne',hE.ne',hc0.ne'] <;> ring
  change Real.sqrt (nsq (M/D) s E b) = _
  rw [he,Real.sqrt_mul (sq_nonneg c0),Real.sqrt_sq hc0.le]

private lemma norm_lower (D E M s : ℝ)
    (hD : 1 ≤ D) (hE : 1 ≤ E) (hM : 1 ≤ M)
    (z : IntegerPoint) (hz : z ≠ 0) :
    1 / max D E ≤ euclideanNorm (transformedPoint D E M s z) := by
  have hD0 : 0 < D := by linarith only [hD]
  have hE0 : 0 < E := by linarith only [hE]
  have hM0 : 0 < M := by linarith only [hM]
  have hH0 : 0 < max D E := lt_of_lt_of_le hD0 (le_max_left D E)
  have hDmax : D ≤ max D E := le_max_left D E
  have hEmax : E ≤ max D E := le_max_right D E
  rw [norm_eq]
  by_cases hz1 : z 1 = 0
  · have hz0 : z 0 ≠ 0 := by
      intro hh
      apply hz
      funext i
      fin_cases i <;> simp [hh,hz1]
    have hi := int_abs_one (z 0) hz0
    have ha0 : 0 < M/D := div_pos hM0 hD0
    have hHD : 1 / max D E ≤ 1/D := by
      apply (div_le_div_iff₀ hH0 hD0).2
      simpa using hDmax
    have hDM : 1/D ≤ M/D :=
      div_le_div_of_nonneg_right hM hD0.le
    have hax : M/D ≤ |(M/D)*((z 0 : ℤ):ℝ)| := by
      rw [abs_mul,abs_of_pos ha0]
      nlinarith only [mul_nonneg ha0.le (sub_nonneg.mpr hi)]
    have hs : |(M/D)*((z 0 : ℤ):ℝ)| ≤
        Real.sqrt (nsq (M/D) s E (z 0,z 1)) := by
      apply Real.abs_le_sqrt
      simp [nsq,hz1]
    exact hHD.trans (hDM.trans (hax.trans hs))
  · have hi := int_abs_one (z 1) hz1
    have hHE : 1 / max D E ≤ 1/E := by
      apply (div_le_div_iff₀ hH0 hE0).2
      simpa using hEmax
    have hq : 1/E ≤ |((z 1 : ℤ):ℝ)/E| := by
      rw [abs_div,abs_of_pos hE0]
      exact div_le_div_of_nonneg_right hi hE0.le
    have hs : |((z 1 : ℤ):ℝ)/E| ≤
        Real.sqrt (nsq (M/D) s E (z 0,z 1)) := by
      apply Real.abs_le_sqrt
      unfold nsq
      nlinarith only [sq_nonneg ((M/D)*(((z 0 : ℤ):ℝ)-s*((z 1 : ℤ):ℝ)))]
    exact hHE.trans (hq.trans hs)

private lemma shortest_properties (D E M s : ℝ)
    (hD : 1 ≤ D) (hE : 1 ≤ E) (hM : 1 ≤ M) :
    0 < shortestNorm D E M s ∧
      0 < reciprocalShortestNorm D E M s ∧
      reciprocalShortestNorm D E M s ≤ max D E ∧
      BddBelow (nonzeroLatticeNorms D E M s) := by
  have hH : 0 < max D E := by
    have hh := le_max_left D E
    linarith only [hD,hh]
  have hne : (nonzeroLatticeNorms D E M s).Nonempty := by
    refine ⟨euclideanNorm (transformedPoint D E M s ![1,0]), ?_⟩
    refine ⟨![1,0], ?_, rfl⟩
    intro hz
    have hh := congrArg (fun v : IntegerPoint => v 0) hz
    norm_num at hh
  have hlo : ∀ r ∈ nonzeroLatticeNorms D E M s, 1/max D E ≤ r := by
    intro r hr
    obtain ⟨z,hz,rfl⟩ := hr
    exact norm_lower D E M s hD hE hM z hz
  have hbd : BddBelow (nonzeroLatticeNorms D E M s) :=
    ⟨1/max D E,hlo⟩
  have hl : 1/max D E ≤ shortestNorm D E M s :=
    le_csInf hne hlo
  have hp : 0 < shortestNorm D E M s :=
    lt_of_lt_of_le (one_div_pos.mpr hH) hl
  have he : 0 < reciprocalShortestNorm D E M s := by
    unfold reciprocalShortestNorm
    exact one_div_pos.mpr hp
  refine ⟨hp,he,?_,hbd⟩
  unfold reciprocalShortestNorm
  apply (div_le_iff₀ hp).2
  have hh := (div_le_iff₀ hH).1 hl
  nlinarith only [hh]

private lemma reduced_norm_bound (a s c R : ℝ) (ha : 0 < a)
    (hc : 0 < c) (hR : 0 < R) (haR : a ≤ R) (hcR : 1/c ≤ R)
    (b1 b2 : ℤ × ℤ)
    (hdet : b1.1*b2.2-b1.2*b2.1=1 ∨ b1.1*b2.2-b1.2*b2.1= -1)
    (hord : Real.sqrt (nsq a s c b1) ≤ Real.sqrt (nsq a s c b2))
    (hip : |ipT a s c b1 b2| ≤ nsq a s c b1/2) :
    nsq a s c b1 ≤ (4*R)^2 ∧ nsq a s c b2 ≤ (4*R)^2 := by
  have hb10 : b1 ≠ 0 := by
    intro hz
    norm_num [hz] at hdet
  have hN1 := nsq_nonneg a s c b1
  have hN2 := nsq_nonneg a s c b2
  have hle : nsq a s c b1 ≤ nsq a s c b2 := by
    have hh := pow_le_pow_left₀ (Real.sqrt_nonneg _) hord 2
    simpa only [Real.sq_sqrt hN1,Real.sq_sqrt hN2] using hh
  let p1 : ℝ := a*((b1.1:ℝ)-s*(b1.2:ℝ))
  let q1 : ℝ := (b1.2:ℝ)/c
  let p2 : ℝ := a*((b2.1:ℝ)-s*(b2.2:ℝ))
  let q2 : ℝ := (b2.2:ℝ)/c
  have hδ : ((b1.1:ℝ)*(b2.2:ℝ)-(b1.2:ℝ)*(b2.1:ℝ))^2=1 := by
    rcases hdet with hh | hh
    · have hr := congrArg (fun t : ℤ => (t:ℝ)) hh
      push_cast at hr
      rw [hr]
      norm_num
    · have hr := congrArg (fun t : ℤ => (t:ℝ)) hh
      push_cast at hr
      rw [hr]
      norm_num
  have hΔ : (p1*q2-q1*p2)^2=(a/c)^2 := by
    have hh : p1*q2-q1*p2 =
        (a/c)*((b1.1:ℝ)*(b2.2:ℝ)-(b1.2:ℝ)*(b2.1:ℝ)) := by
      dsimp [p1,q1,p2,q2]
      field_simp [hc.ne'] <;> ring
    rw [hh,mul_pow,hδ,mul_one]
  have hprod :
      3*(nsq a s c b1*nsq a s c b2) ≤ 4*(a/c)^2 := by
    exact (gram_bounds p1 q1 p2 q2 (a/c) hΔ hle hip).2
  have hraw : nsq a s c b2 ≤ 4*(a^2+(1/c)^2) := by
    by_cases hq : b1.2=0
    · have hp : b1.1 ≠ 0 := by
        intro hh
        apply hb10
        ext <;> simp [hh,hq]
      have hi := int_sq_one b1.1 hp
      have hlo : a^2 ≤ nsq a s c b1 := by
        simp only [nsq,hq,Int.cast_zero,mul_zero,sub_zero,zero_div,zero_pow,
          add_zero,mul_pow]
        nlinarith only [mul_nonneg (sq_nonneg a) (sub_nonneg.mpr hi)]
      have hh : a^2*(3*nsq a s c b2) ≤ a^2*(4*(1/c)^2) := by
        calc
          _ = 3*(a^2*nsq a s c b2) := by ring
          _ ≤ 3*(nsq a s c b1*nsq a s c b2) :=
            mul_le_mul_of_nonneg_left
              (mul_le_mul_of_nonneg_right hlo hN2) (by norm_num)
          _ ≤ 4*(a/c)^2 := hprod
          _ = _ := by ring
      have hh' : 3*nsq a s c b2 ≤ 4*(1/c)^2 := by
        by_contra hn
        have hp : 0 < a^2 := by positivity
        have hg : 0 < 3*nsq a s c b2-4*(1/c)^2 := by linarith only [hn]
        have hm := mul_pos hp hg
        nlinarith only [hh,hm]
      nlinarith only [hh',sq_nonneg a,sq_nonneg (1/c)]
    · have hi := int_sq_one b1.2 hq
      have hlo : (1/c)^2 ≤ nsq a s c b1 := by
        have he : ((b1.2:ℝ)/c)^2=(b1.2:ℝ)^2*(1/c)^2 := by ring
        unfold nsq
        rw [he]
        nlinarith only [mul_nonneg (sub_nonneg.mpr hi) (sq_nonneg (1/c)),
          sq_nonneg (a*((b1.1:ℝ)-s*(b1.2:ℝ)))]
      have hh : (1/c)^2*(3*nsq a s c b2) ≤ (1/c)^2*(4*a^2) := by
        calc
          _ = 3*((1/c)^2*nsq a s c b2) := by ring
          _ ≤ 3*(nsq a s c b1*nsq a s c b2) :=
            mul_le_mul_of_nonneg_left
              (mul_le_mul_of_nonneg_right hlo hN2) (by norm_num)
          _ ≤ 4*(a/c)^2 := hprod
          _ = _ := by ring
      have hh' : 3*nsq a s c b2 ≤ 4*a^2 := by
        by_contra hn
        have hp : 0 < (1/c)^2 := by positivity
        have hg : 0 < 3*nsq a s c b2-4*a^2 := by linarith only [hn]
        have hm := mul_pos hp hg
        nlinarith only [hh,hm]
      nlinarith only [hh',sq_nonneg a,sq_nonneg (1/c)]
  have ha2 : a^2 ≤ R^2 := by nlinarith only [ha.le,haR,hR.le]
  have hc2 : (1/c)^2 ≤ R^2 := by
    have hh : 0 < 1/c := one_div_pos.mpr hc
    nlinarith only [hh.le,hcR,hR.le]
  have hb2 : nsq a s c b2 ≤ (4*R)^2 := by nlinarith only [hraw,ha2,hc2]
  exact ⟨hle.trans hb2,hb2⟩

private def pairMatrix (b1 b2 : ℤ × ℤ) : IntegerMatrix :=
  ![![b1.1,b2.1],![b1.2,b2.2]]

private def pairInverse (b1 b2 : ℤ × ℤ) : IntegerMatrix :=
  let δ : ℤ := b1.1*b2.2-b1.2*b2.1
  ![![δ*b2.2,-δ*b2.1],![-δ*b1.2,δ*b1.1]]

private lemma pair_inverse (b1 b2 : ℤ × ℤ)
    (hdet : b1.1*b2.2-b1.2*b2.1=1 ∨ b1.1*b2.2-b1.2*b2.1= -1) :
    pairInverse b1 b2 * pairMatrix b1 b2=1 ∧
      pairMatrix b1 b2 * pairInverse b1 b2=1 := by
  rcases hdet with hd | hd
  all_goals
    constructor
    · apply Matrix.ext
      intro i j
      change (∑ k : Fin 2, pairInverse b1 b2 i k * pairMatrix b1 b2 k j) =
        if i = j then 1 else 0
      rw [Fin.sum_univ_two]
      fin_cases i <;> fin_cases j <;> simp [pairInverse, pairMatrix, hd] <;>
        nlinarith only [hd]
    · apply Matrix.ext
      intro i j
      change (∑ k : Fin 2, pairMatrix b1 b2 i k * pairInverse b1 b2 k j) =
        if i = j then 1 else 0
      rw [Fin.sum_univ_two]
      fin_cases i <;> fin_cases j <;> simp [pairInverse, pairMatrix, hd] <;>
        nlinarith only [hd]

private lemma pair_bounds (b1 b2 : ℤ × ℤ) (H : ℝ)
    (hdet : b1.1*b2.2-b1.2*b2.1=1 ∨ b1.1*b2.2-b1.2*b2.1= -1)
    (hb1 : |(b1.1:ℝ)|≤H ∧ |(b1.2:ℝ)|≤H)
    (hb2 : |(b2.1:ℝ)|≤H ∧ |(b2.2:ℝ)|≤H) :
    integerMatrixBound (pairMatrix b1 b2) H ∧
      integerMatrixBound (pairInverse b1 b2) H := by
  have hδ : |(((b1.1*b2.2-b1.2*b2.1:ℤ):ℝ))|=1 := by
    rcases hdet with hh | hh <;> rw [hh] <;> norm_num
  constructor
  · intro i j
    fin_cases i <;> fin_cases j
    · simpa [pairMatrix] using hb1.1
    · simpa [pairMatrix] using hb2.1
    · simpa [pairMatrix] using hb1.2
    · simpa [pairMatrix] using hb2.2
  · intro i j
    fin_cases i <;> fin_cases j
    · change |(((b1.1*b2.2-b1.2*b2.1)*b2.2 : ℤ):ℝ)| ≤ H
      rw [Int.cast_mul, abs_mul, hδ, one_mul]
      exact hb2.2
    · change |((-((b1.1*b2.2-b1.2*b2.1))*b2.1 : ℤ):ℝ)| ≤ H
      rw [Int.cast_mul, Int.cast_neg, abs_mul, abs_neg, hδ, one_mul]
      exact hb2.1
    · change |((-((b1.1*b2.2-b1.2*b2.1))*b1.2 : ℤ):ℝ)| ≤ H
      rw [Int.cast_mul, Int.cast_neg, abs_mul, abs_neg, hδ, one_mul]
      exact hb1.2
    · change |(((b1.1*b2.2-b1.2*b2.1)*b1.1 : ℤ):ℝ)| ≤ H
      rw [Int.cast_mul, abs_mul, hδ, one_mul]
      exact hb1.1

theorem frame_main : wholeStatement := by
  intro c0 hc0
  let C : ℝ := 16*(c0+1)
  have hc00 : 0 < c0 := by linarith only [hc0]
  have hC : 0 < C := by dsimp [C]; positivity
  have hC1 : 1 ≤ C := by dsimp [C]; linarith only [hc0]
  have hC2 : 2*c0 ≤ C := by dsimp [C]; linarith only [hc0]
  refine ⟨C,hC,?_⟩
  intro D E M s hD hE hM hs
  have hD0 : 0 < D := by linarith only [hD]
  have hE0 : 0 < E := by linarith only [hE]
  have hM0 : 0 < M := by linarith only [hM]
  let H : ℝ := max D E
  have hH : 0 < H := lt_of_lt_of_le hD0 (le_max_left D E)
  obtain ⟨hLambda,hEll,hcap,hbd⟩ := shortest_properties D E M s hD hE hM
  refine ⟨hLambda,hEll,?_,?_⟩
  · exact hcap.trans (by
      have hh := mul_le_mul_of_nonneg_right hC1 hH.le
      simpa only [one_mul] using hh)
  let a : ℝ := M/(c0*D)
  let c : ℝ := c0*E
  let R : ℝ := M/c0
  have ha : 0 < a := by dsimp [a]; positivity
  have hc : 0 < c := by dsimp [c]; positivity
  have hR : 0 < R := by dsimp [R]; positivity
  have haR : a ≤ R := by
    have he : a=R/D := by dsimp [a,R]; field_simp [hc00.ne',hD0.ne'] <;> ring
    rw [he]
    apply (div_le_iff₀ hD0).2
    nlinarith only [mul_nonneg hR.le (sub_nonneg.mpr hD)]
  have hcR : 1/c ≤ R := by
    apply (div_le_iff₀ hc).2
    have hME : 1 ≤ M*E := by
      nlinarith only [hM,hE,mul_nonneg (sub_nonneg.mpr hM) (sub_nonneg.mpr hE)]
    have he : R*c=M*E := by
      dsimp [R,c]
      field_simp [hc00.ne'] <;> ring
    simpa only [he] using hME
  obtain ⟨b1,b2,hdet,hord,hip⟩ := exists_reduced a s c ha hc
  obtain ⟨hb1R,hb2R⟩ :=
    reduced_norm_bound a s c R ha hc hR haR hcR b1 b2 hdet hord hip
  have hcol (b : ℤ × ℤ) (hb : nsq a s c b ≤ (4*R)^2) :
      |(b.1:ℝ)|≤C*M*H ∧ |(b.2:ℝ)|≤C*M*H := by
    obtain ⟨h1,h2⟩ := box_of_nsq a s c ((4*R)^2) ha hc b hb
    rw [Real.sqrt_sq (by positivity : 0 ≤ 4*R)] at h1 h2
    have he1 : (4*R)/a=4*D := by
      dsimp [R,a]
      field_simp [hc00.ne',hD0.ne',hM0.ne'] <;> ring
    have he2 : c*(4*R)=4*M*E := by
      dsimp [c,R]
      field_simp [hc00.ne'] <;> ring
    rw [he1,he2] at h1
    rw [he2] at h2
    have hs' : |s| *(4*M*E) ≤ 4*c0*D*M := by
      calc
        _ ≤ (c0*D/E)*(4*M*E) :=
          mul_le_mul_of_nonneg_right hs (by positivity)
        _ = _ := by field_simp [hE0.ne'] <;> ring
    have hDM : D ≤ M*H := by
      have hDH : D ≤ H := le_max_left D E
      have hh : H ≤ M*H := by
        nlinarith only [mul_nonneg (sub_nonneg.mpr hM) hH.le]
      exact hDH.trans hh
    have hDMM : D*M ≤ M*H := by
      have hh := mul_le_mul_of_nonneg_left (le_max_left D E) hM0.le
      simpa [H,mul_comm] using hh
    have hEM : E*M ≤ M*H := by
      have hh := mul_le_mul_of_nonneg_left (le_max_right D E) hM0.le
      simpa [H,mul_comm] using hh
    constructor
    · have hh := mul_le_mul_of_nonneg_left hDMM (show 0≤4*c0 by positivity)
      calc
        |(b.1:ℝ)| ≤ 4*D+4*c0*D*M := by linarith only [h1,hs']
        _ ≤ 4*(c0+1)*M*H := by nlinarith only [hDM,hh]
        _ ≤ C*M*H := by
          dsimp [C]
          nlinarith only [mul_nonneg (show 0≤c0+1 by linarith only [hc0]) (mul_nonneg hM0.le hH.le)]
    · calc
        |(b.2:ℝ)| ≤ 4*M*E := h2
        _ ≤ 4*M*H := by nlinarith only [hEM]
        _ ≤ C*M*H := by
          have hh := mul_le_mul_of_nonneg_right
            (show 4≤C by dsimp [C]; linarith only [hc0]) (mul_nonneg hM0.le hH.le)
          nlinarith only [hh]
  obtain ⟨hP,hA⟩ := pair_bounds b1 b2 (C*M*H) hdet (hcol b1 hb1R) (hcol b2 hb2R)
  obtain ⟨hAP,hPA⟩ := pair_inverse b1 b2 hdet
  refine ⟨pairMatrix b1 b2,pairInverse b1 b2,hAP,hPA,hP,hA,?_⟩
  have hb10 : b1 ≠ 0 := by
    intro hz
    norm_num [hz] at hdet
  have hb20 : b2 ≠ 0 := by
    intro hz
    norm_num [hz] at hdet
  have hLambdaBasis (b : ℤ × ℤ) (hb : b ≠ 0) :
      shortestNorm D E M s ≤ c0*Real.sqrt (nsq a s c b) := by
    calc
      shortestNorm D E M s ≤
          euclideanNorm (transformedPoint D E M s ![b.1,b.2]) :=
        csInf_le hbd ⟨![b.1,b.2],pair_ne b hb,rfl⟩
      _ = c0*Real.sqrt (nsq a s c b) :=
        norm_scaled D E M s c0 hD0 hE0 hc00 b
  have hside_bound (b : ℤ × ℤ) (hb : b ≠ 0) :
      2/Real.sqrt (nsq a s c b) ≤ C*reciprocalShortestNorm D E M s := by
    have hnb : 0 < Real.sqrt (nsq a s c b) :=
      Real.sqrt_pos.mpr (nsq_pos a s c ha hc b hb)
    calc
      2/Real.sqrt (nsq a s c b) ≤ (2*c0)/shortestNorm D E M s := by
        apply (div_le_div_iff₀ hnb hLambda).2
        nlinarith only [hLambdaBasis b hb]
      _ ≤ C/shortestNorm D E M s :=
        div_le_div_of_nonneg_right hC2 hLambda.le
      _ = C*reciprocalShortestNorm D E M s := by
        simp only [reciprocalShortestNorm,div_eq_mul_inv,one_mul]
  have hwidth : a*(c0*D/M)=1 := by
    dsimp [a]
    field_simp [hc00.ne',hD0.ne',hM0.ne'] <;> ring
  obtain ⟨_,_,_,_,hcover⟩ :=
    side a s c (c0*D/M) ha hc hwidth b1 b2 hdet hord hip
  intro z hz i
  obtain ⟨l,hl0,hl1,hL0,hL1⟩ := hcover (z 0,z 1) hz.1 hz.2
  have hzP : (pairMatrix b1 b2).mulVec ![l.1,l.2]=z := by
    funext j
    fin_cases j
    · simpa [pairMatrix,Matrix.mulVec,dotProduct,Fin.sum_univ_two,mul_comm] using hl0.symm
    · simpa [pairMatrix,Matrix.mulVec,dotProduct,Fin.sum_univ_two,mul_comm] using hl1.symm
  have hcoords : (pairInverse b1 b2).mulVec z = ![l.1,l.2] := by
    rw [←hzP]
    have he :
        (pairInverse b1 b2).mulVec ((pairMatrix b1 b2).mulVec ![l.1,l.2]) =
          (pairInverse b1 b2*pairMatrix b1 b2).mulVec ![l.1,l.2] := by
      funext j
      simp only [Matrix.mulVec,Matrix.mul_apply,dotProduct,Fin.sum_univ_two]
      ring
    rw [he,hAP]
    simp
  change |((((pairInverse b1 b2).mulVec z) i : ℤ):ℝ)| ≤ _
  rw [hcoords]
  fin_cases i
  · exact hL0.trans (hside_bound b1 hb10)
  · exact hL1.trans (hside_bound b2 hb20)

end
