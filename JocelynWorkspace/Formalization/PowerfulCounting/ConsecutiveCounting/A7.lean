private theorem norm_gcd_normalization (Delta : ℕ) (h : ℤ) (hh : h≠0)
    (Z : ℕ) (X Y : ℤ) (hX : X.natAbs≤Z) (hY : Y.natAbs≤Z)
    (hnorm : X^2-(Delta:ℤ)*Y^2=h) :
    ∃g:ℕ,∃h0 X0 Y0:ℤ,
      g≠0 ∧ (g:ℤ)^2∣h ∧ h0≠0 ∧ h0∣h ∧
      (g:ℤ)*X0=X ∧ (g:ℤ)*Y0=Y ∧ Int.gcd X0 Y0=1 ∧
