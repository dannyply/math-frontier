noncomputable def ex (k l : ℕ) : Fin 2 →₀ ℕ := Finsupp.single 0 k + Finsupp.single 1 l

@[simp] lemma ex_zero (k l : ℕ) : ex k l 0 = k := by simp [ex]
@[simp] lemma ex_one (k l : ℕ) : ex k l 1 = l := by simp [ex]

lemma ex_eq_iff (k l : ℕ) (m : Fin 2 →₀ ℕ) : ex k l = m ↔ m 0 = k ∧ m 1 = l := by
  constructor
  · rintro rfl; simp
  · rintro ⟨h0, h1⟩; ext i; fin_cases i <;> simp [h0, h1]

lemma monomial_ex (c : R) (k l : ℕ) :
    C c * X 0 ^ k * X 1 ^ l = (monomial (ex k l) c : MvPolynomial (Fin 2) R) := by
  simp [ex, X_pow_eq_monomial, C_mul_monomial, monomial_mul]

lemma hom_deg {F : MvPolynomial (Fin 2) R} {n : ℕ} (hF : F.IsHomogeneous n)
    {m : Fin 2 →₀ ℕ} (hm : F.coeff m ≠ 0) : m 0 + m 1 = n := by
  have := hF hm
  simpa [Finsupp.weight_apply, Finsupp.sum_fintype, Fin.sum_univ_two] using this

lemma hom_repr {F : MvPolynomial (Fin 2) R} {n : ℕ} (hF : F.IsHomogeneous n) :
    F = ∑ k ∈ Finset.range (n + 1), C (F.coeff (ex k (n - k))) * X 0 ^ k * X 1 ^ (n - k) := by
  ext m
  simp only [coeff_sum, monomial_ex, coeff_monomial]
  by_cases hm : F.coeff m = 0
  · rw [hm]; symm
    apply Finset.sum_eq_zero
    intro k _
    split_ifs with h
    · rw [h, hm]
    · rfl
  · have hdeg := hom_deg hF hm
    rw [Finset.sum_eq_single (m 0)]
    · have : ex (m 0) (n - m 0) = m := by rw [ex_eq_iff]; omega
      simp [this]
    · intro k _ hne
      rw [if_neg]
      intro h
      apply hne
      rw [← h]; simp
    · intro h
      exfalso; apply h; simp; omega

lemma eval_eq_sum {F : MvPolynomial (Fin 2) R} {n : ℕ} (hF : F.IsHomogeneous n) (v : Fin 2 → R) :
    MvPolynomial.eval v F =
      ∑ k ∈ Finset.range (n + 1), F.coeff (ex k (n - k)) * v 0 ^ k * v 1 ^ (n - k) := by
  conv_lhs => rw [hom_repr hF]
  simp [map_sum]

lemma eval_smul_hom {F : MvPolynomial (Fin 2) R} {n : ℕ} (hF : F.IsHomogeneous n) (c : R)
    (v : Fin 2 → R) : MvPolynomial.eval (c • v) F = c ^ n * MvPolynomial.eval v F := by
  rw [eval_eq_sum hF, eval_eq_sum hF, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro k hk
  have hk' : k ≤ n := by simpa [Finset.mem_range, Nat.lt_succ_iff] using hk
  simp only [Pi.smul_apply, smul_eq_mul, mul_pow]
  have : c ^ n = c ^ k * c ^ (n - k) := by rw [← pow_add]; congr 1; omega
  rw [this]; ring

end Repr

section Dehom
variable {R : Type*} [CommRing R]

noncomputable def dehom (F : MvPolynomial (Fin 2) R) : Polynomial R :=
  MvPolynomial.aeval ![Polynomial.X, 1] F

lemma dehom_repr {F : MvPolynomial (Fin 2) R} {n : ℕ} (hF : F.IsHomogeneous n) :
    dehom F = ∑ k ∈ Finset.range (n + 1),
      Polynomial.C (F.coeff (ex k (n - k))) * Polynomial.X ^ k := by
  conv_lhs => rw [hom_repr hF]
  simp [dehom, map_sum, Polynomial.algebraMap_eq]

lemma dehom_coeff {F : MvPolynomial (Fin 2) R} {n : ℕ} (hF : F.IsHomogeneous n) (k : ℕ) :
    (dehom F).coeff k = if k ≤ n then F.coeff (ex k (n - k)) else 0 := by
  rw [dehom_repr hF, Polynomial.finsetSum_coeff]
  simp only [Polynomial.coeff_C_mul_X_pow]
  rw [Finset.sum_ite_eq]
  simp [Finset.mem_range]

end Dehom

section Core
variable {K : Type*} [Field K]

lemma eval_aeval_fin2 (M : Fin 2 → MvPolynomial (Fin 2) K) (F : MvPolynomial (Fin 2) K)
    (v : Fin 2 → K) : MvPolynomial.eval v (MvPolynomial.aeval M F) =
      MvPolynomial.eval (fun i => MvPolynomial.eval v (M i)) F := by
  induction F using MvPolynomial.induction_on
  next a => rw [aeval_C, algebraMap_eq, eval_C, eval_C]
  next p q hp hq => rw [map_add, map_add, hp, hq, map_add]
  next p i hp => rw [map_mul, map_mul, hp, aeval_X, map_mul, eval_X]

lemma isHomogeneous_aeval_lin {F : MvPolynomial (Fin 2) K} {n : ℕ} (hF : F.IsHomogeneous n)
    (M : Fin 2 → MvPolynomial (Fin 2) K) (hM : ∀ i, (M i).IsHomogeneous 1) :
    (MvPolynomial.aeval M F).IsHomogeneous n := by
  have := hF.eval₂ (algebraMap K (MvPolynomial (Fin 2) K)) M
    (fun r => by rw [algebraMap_eq]; exact isHomogeneous_C (Fin 2) r) hM
  rw [one_mul] at this
  rw [aeval_def]
  exact this

end Core
end Curves

namespace Classify
open MvPolynomial

section FactorHom
variable {σ : Type*} {R : Type*} [CommRing R] [IsDomain R]

noncomputable def tsub (w : σ → ℕ) : MvPolynomial σ R →ₐ[R] Polynomial (MvPolynomial σ R) :=
  MvPolynomial.aeval (fun i => Polynomial.C (X i) * Polynomial.X ^ (w i))

omit [IsDomain R] in
lemma tsub_monomial (w : σ → ℕ) (m : σ →₀ ℕ) (c : R) :
    tsub w (monomial m c) =
      Polynomial.C (monomial m c) * Polynomial.X ^ (Finsupp.weight w m) := by
  classical
  rw [tsub, MvPolynomial.aeval_monomial, MvPolynomial.monomial_eq, Finsupp.weight_apply]
  simp only [Finsupp.prod, Finsupp.sum]
  have h1 : ∀ i ∈ m.support,
      (Polynomial.C (X i : MvPolynomial σ R) * Polynomial.X ^ (w i)) ^ (m i) =
        Polynomial.C ((X i : MvPolynomial σ R) ^ (m i)) * Polynomial.X ^ (m i • w i) := by
    intro i _
    rw [mul_pow, ← map_pow, ← pow_mul, smul_eq_mul, mul_comm (w i)]
  rw [Finset.prod_congr rfl h1, Finset.prod_mul_distrib, ← map_prod,
    Finset.prod_pow_eq_pow_sum, Polynomial.algebraMap_apply, MvPolynomial.algebraMap_eq, map_mul]
  ring

omit [IsDomain R] in
lemma coeff_tsub (w : σ → ℕ) (P : MvPolynomial σ R) (k : ℕ) :
    (tsub w P).coeff k = weightedHomogeneousComponent w k P := by
  classical
  conv_lhs => rw [P.as_sum]
  rw [map_sum, Polynomial.finsetSum_coeff]
  simp only [tsub_monomial, Polynomial.coeff_C_mul_X_pow]
  rw [weightedHomogeneousComponent_apply, Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro m _
  by_cases h : Finsupp.weight w m = k
  · rw [if_pos h.symm, if_pos h]
  · rw [if_neg (Ne.symm h), if_neg h]

omit [IsDomain R] in
lemma tsub_of_isWeightedHomogeneous {w : σ → ℕ} {P : MvPolynomial σ R} {n : ℕ}
    (hP : IsWeightedHomogeneous w P n) : tsub w P = Polynomial.C P * Polynomial.X ^ n := by
  ext k : 1
  rw [coeff_tsub, Polynomial.coeff_C_mul_X_pow]
  by_cases hk : k = n
  · rw [if_pos hk]
    ext d
    rw [coeff_weightedHomogeneousComponent]
    by_cases hd : Finsupp.weight w d = k
    · rw [if_pos hd]
    · rw [if_neg hd]
      by_contra hne
      exact hd ((hP (Ne.symm hne)).trans hk.symm)
  · rw [if_neg hk]
    ext d
    rw [coeff_weightedHomogeneousComponent, coeff_zero]
    by_cases hd : Finsupp.weight w d = k
    · rw [if_pos hd]
      by_contra hne
      exact hk (hd.symm.trans (hP hne))
    · rw [if_neg hd]

lemma coeff_eq_zero_of_mul_eq_monomial {A : Type*} [CommRing A] [IsDomain A]
    {p q : Polynomial A} {c : A} {n : ℕ} (hc : c ≠ 0)
    (h : p * q = Polynomial.C c * Polynomial.X ^ n) :
    ∀ k, k ≠ p.natDegree → p.coeff k = 0 := by
  have hpq : p * q ≠ 0 := by
    rw [h]; exact mul_ne_zero (Polynomial.C_ne_zero.mpr hc) (pow_ne_zero _ Polynomial.X_ne_zero)
  have hp : p ≠ 0 := left_ne_zero_of_mul hpq
  have hq : q ≠ 0 := right_ne_zero_of_mul hpq
  have h1 : p.natDegree + q.natDegree = n := by
    rw [← Polynomial.natDegree_mul hp hq, h, Polynomial.natDegree_C_mul_X_pow _ _ hc]
  have h2 : p.natTrailingDegree + q.natTrailingDegree = n := by
    rw [← Polynomial.natTrailingDegree_mul hp hq, h, Polynomial.C_mul_X_pow_eq_monomial,
      Polynomial.natTrailingDegree_monomial hc]
  have h3 : p.natTrailingDegree ≤ p.natDegree := Polynomial.natTrailingDegree_le_natDegree p
  have h4 : q.natTrailingDegree ≤ q.natDegree := Polynomial.natTrailingDegree_le_natDegree q
  intro k hk
  rcases lt_or_gt_of_ne hk with hlt | hgt
  · exact Polynomial.coeff_eq_zero_of_lt_natTrailingDegree (by omega)
  · exact Polynomial.coeff_eq_zero_of_natDegree_lt hgt

theorem isWeightedHomogeneous_of_mul {w : σ → ℕ} {F G : MvPolynomial σ R} {n : ℕ}
    (hFG : IsWeightedHomogeneous w (F * G) n) (hFG0 : F * G ≠ 0) :
    IsWeightedHomogeneous w F (tsub w F).natDegree := by
  have h := tsub_of_isWeightedHomogeneous hFG
  rw [map_mul] at h
  have hz := coeff_eq_zero_of_mul_eq_monomial hFG0 h
  intro d hd
  by_contra hne
  have h0 : (tsub w F).coeff (Finsupp.weight w d) = 0 := hz _ hne
  rw [coeff_tsub] at h0
  have h1 := congrArg (MvPolynomial.coeff d) h0
  rw [coeff_weightedHomogeneousComponent, if_pos rfl, coeff_zero] at h1
  exact hd h1

theorem wh_split {w : σ → ℕ} {G T : MvPolynomial σ R} {n : ℕ}
    (h : IsWeightedHomogeneous w (G * T) n) (h0 : G * T ≠ 0) :
    ∃ d e, d + e = n ∧ IsWeightedHomogeneous w G d ∧ IsWeightedHomogeneous w T e := by
  have g := isWeightedHomogeneous_of_mul h h0
  have t := isWeightedHomogeneous_of_mul (show IsWeightedHomogeneous w (T * G) n by
    rw [mul_comm]; exact h) (by rw [mul_comm]; exact h0)
  exact ⟨_, _, IsWeightedHomogeneous.inj_right h0 (g.mul t) h, g, t⟩

end FactorHom

lemma monomial_eq_four (R : Type*) [CommSemiring R] (e : Fin 4 →₀ ℕ) (a : R) :
    monomial e a = C a * (X 0 ^ e 0 * X 1 ^ e 1 * X 2 ^ e 2 * X 3 ^ e 3) := by
  rw [monomial_eq, Finsupp.prod_fintype _ _ (by intro i; simp)]
  simp [Fin.prod_univ_four, mul_assoc]

end Classify

namespace LowdegRed
open Finset

lemma succ_le_two_pow (e : ℕ) : e + 1 ≤ 2 ^ e := by
  induction e with
  | zero => simp
  | succ k ih => rw [pow_succ]; omega

lemma one_add_le_B (δ : ℝ) (hδ : 0 < δ) (e : ℕ) :
    (e : ℝ) + 1 ≤ (1 / (δ * Real.log 2) + 1) * ((2 : ℝ) ^ δ) ^ e := by
  have hl : 0 < Real.log 2 := Real.log_pos one_lt_two
  have hc : 0 < δ * Real.log 2 := mul_pos hδ hl
  have h1 : ((2 : ℝ) ^ δ) ^ e = Real.exp ((e : ℝ) * (δ * Real.log 2)) := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num : (0:ℝ) ≤ 2),
      Real.rpow_def_of_pos (by norm_num : (0:ℝ) < 2)]
    congr 1; ring
  rw [h1]
  have h2 : 1 + (e : ℝ) * (δ * Real.log 2) ≤ Real.exp ((e : ℝ) * (δ * Real.log 2)) := by
    have := Real.add_one_le_exp ((e : ℝ) * (δ * Real.log 2)); linarith
  have hce : (1 / (δ * Real.log 2)) * ((e : ℝ) * (δ * Real.log 2)) = e := by
    rw [mul_comm (e : ℝ) (δ * Real.log 2), ← mul_assoc, one_div_mul_cancel hc.ne', one_mul]
  have hinv : 0 ≤ 1 / (δ * Real.log 2) := (one_div_pos.mpr hc).le
  have h3 : (e : ℝ) + 1 ≤ (1 / (δ * Real.log 2) + 1) * (1 + (e : ℝ) * (δ * Real.log 2)) := by
    have expand : (1 / (δ * Real.log 2) + 1) * (1 + (e : ℝ) * (δ * Real.log 2)) =
        1 / (δ * Real.log 2) + (1 / (δ * Real.log 2)) * ((e : ℝ) * (δ * Real.log 2)) + 1 +
          (e : ℝ) * (δ * Real.log 2) := by ring
    rw [expand, hce]
    have : 0 ≤ (e : ℝ) * (δ * Real.log 2) := mul_nonneg (Nat.cast_nonneg e) hc.le
    linarith
  calc (e : ℝ) + 1 ≤ (1 / (δ * Real.log 2) + 1) * (1 + (e : ℝ) * (δ * Real.log 2)) := h3
    _ ≤ (1 / (δ * Real.log 2) + 1) * Real.exp ((e : ℝ) * (δ * Real.log 2)) := by
      apply mul_le_mul_of_nonneg_left h2
      linarith

lemma prod_primeFactors_pow (n : ℕ) (hn : n ≠ 0) :
    (n : ℝ) = ∏ p ∈ n.primeFactors, ((p : ℝ) ^ (n.factorization p)) := by
  have h := Nat.factorization_prod_pow_eq_self hn
  rw [Nat.prod_factorization_eq_prod_primeFactors] at h
  calc (n : ℝ) = ((∏ p ∈ n.primeFactors, p ^ n.factorization p : ℕ) : ℝ) := by rw [h]
    _ = ∏ p ∈ n.primeFactors, ((p : ℝ) ^ (n.factorization p)) := by
      rw [Nat.cast_prod]
      exact Finset.prod_congr rfl (fun p _ => Nat.cast_pow p _)

theorem divisor_bound (δ : ℝ) (hδ : 0 < δ) :
    ∃ C : ℝ, 1 ≤ C ∧ ∀ n : ℕ, n ≠ 0 → (n.divisors.card : ℝ) ≤ C * (n : ℝ) ^ δ := by
  classical
  obtain ⟨B, hBdef⟩ : ∃ B : ℝ, B = 1 / (δ * Real.log 2) + 1 := ⟨_, rfl⟩
  have hB1 : 1 ≤ B := by
    have : 0 < δ * Real.log 2 := mul_pos hδ (Real.log_pos one_lt_two)
    have := (one_div_pos.mpr this).le
    rw [hBdef]; linarith
  obtain ⟨N, hN⟩ : ∃ N : ℕ, (2 : ℝ) ^ (1 / δ) ≤ N := ⟨⌈(2 : ℝ) ^ (1 / δ)⌉₊, Nat.le_ceil _⟩
  refine ⟨B ^ N, one_le_pow₀ hB1, ?_⟩
  intro n hn
  have hcard : (n.divisors.card : ℝ) = ∏ p ∈ n.primeFactors, ((n.factorization p : ℝ) + 1) := by
    rw [Nat.card_divisors hn, Nat.cast_prod]
    exact Finset.prod_congr rfl (fun p _ => Nat.cast_succ _)
  have hnR : (n : ℝ) ^ δ = ∏ p ∈ n.primeFactors, ((p : ℝ) ^ (n.factorization p)) ^ δ := by
    rw [prod_primeFactors_pow n hn]
    exact (Real.finset_prod_rpow n.primeFactors (fun p => (p : ℝ) ^ (n.factorization p))
      (fun p _ => by positivity) δ).symm
  have hper : ∀ p ∈ n.primeFactors, ((n.factorization p : ℝ) + 1) ≤
      (if p < N then B else 1) * ((p : ℝ) ^ (n.factorization p)) ^ δ := by
    intro p hp
    have hpp : p.Prime := Nat.prime_of_mem_primeFactors hp
    have hp2 : (2 : ℝ) ≤ p := by exact_mod_cast hpp.two_le
    have hswap : ((p : ℝ) ^ (n.factorization p)) ^ δ = ((p : ℝ) ^ δ) ^ (n.factorization p) := by
      rw [← Real.rpow_natCast (p : ℝ) (n.factorization p),
        ← Real.rpow_natCast ((p : ℝ) ^ δ) (n.factorization p),
        ← Real.rpow_mul (Nat.cast_nonneg p), ← Real.rpow_mul (Nat.cast_nonneg p), mul_comm]
    rw [hswap]
    by_cases hpN : p < N
    · rw [if_pos hpN]
      calc ((n.factorization p : ℕ) : ℝ) + 1
          ≤ B * ((2 : ℝ) ^ δ) ^ (n.factorization p) := by
            rw [hBdef]; exact one_add_le_B δ hδ _
        _ ≤ B * ((p : ℝ) ^ δ) ^ (n.factorization p) := by
          apply mul_le_mul_of_nonneg_left _ (by linarith)
          apply pow_le_pow_left₀ (by positivity)
          exact Real.rpow_le_rpow (by norm_num) hp2 hδ.le
    · rw [if_neg hpN, one_mul]
      have hpN' : (N : ℝ) ≤ p := by exact_mod_cast (not_lt.mp hpN)
      have h2 : (2 : ℝ) ≤ (p : ℝ) ^ δ := by
        have hle : (2 : ℝ) ^ (1 / δ) ≤ p := hN.trans hpN'
        have := Real.rpow_le_rpow (by positivity) hle hδ.le
        rwa [← Real.rpow_mul (by norm_num), one_div_mul_cancel hδ.ne', Real.rpow_one] at this
      calc ((n.factorization p : ℕ) : ℝ) + 1 ≤ (2 : ℝ) ^ (n.factorization p) := by
            have := succ_le_two_pow (n.factorization p)
            exact_mod_cast this
        _ ≤ ((p : ℝ) ^ δ) ^ (n.factorization p) := pow_le_pow_left₀ (by norm_num) h2 _
  have hgprod : ∏ p ∈ n.primeFactors, (if p < N then B else 1) ≤ B ^ N := by
    rw [← Finset.prod_filter, Finset.prod_const]
    apply pow_le_pow_right₀ hB1
    calc (n.primeFactors.filter (fun p => p < N)).card ≤ (Finset.range N).card := by
          apply Finset.card_le_card
          intro p hp
          rw [Finset.mem_filter] at hp
          exact Finset.mem_range.mpr hp.2
      _ = N := Finset.card_range N
  calc (n.divisors.card : ℝ) = ∏ p ∈ n.primeFactors, ((n.factorization p : ℝ) + 1) := hcard
    _ ≤ ∏ p ∈ n.primeFactors,
          ((if p < N then B else 1) * ((p : ℝ) ^ (n.factorization p)) ^ δ) := by
        apply Finset.prod_le_prod
        · intro p _; positivity
        · exact hper
    _ = (∏ p ∈ n.primeFactors, (if p < N then B else 1)) * (n : ℝ) ^ δ := by
        rw [Finset.prod_mul_distrib, hnR]
    _ ≤ B ^ N * (n : ℝ) ^ δ := by
        apply mul_le_mul_of_nonneg_right hgprod (by positivity)

end LowdegRed

namespace DimOne
open MvPolynomial

variable {n : ℕ} (I : Ideal (MvPolynomial (Fin n) ℚ))

noncomputable abbrev V (s : ℕ) : Submodule ℚ (MvPolynomial (Fin n) ℚ ⧸ I) :=
  Submodule.map (Ideal.Quotient.mkₐ ℚ I).toLinearMap (restrictTotalDegree (Fin n) ℚ s)

lemma V_mono {s t : ℕ} (hst : s ≤ t) : V I s ≤ V I t := by
  apply Submodule.map_mono
  intro p hp
  rw [mem_restrictTotalDegree] at hp ⊢
  exact le_trans hp hst

lemma V_mul {s t : ℕ} {a b : MvPolynomial (Fin n) ℚ ⧸ I} (ha : a ∈ V I s) (hb : b ∈ V I t) :
    a * b ∈ V I (s + t) := by
  obtain ⟨p, hp, rfl⟩ := Submodule.mem_map.mp ha
  obtain ⟨q, hq, rfl⟩ := Submodule.mem_map.mp hb
  refine Submodule.mem_map.mpr ⟨p * q, ?_, ?_⟩
  · rw [mem_restrictTotalDegree] at hp hq ⊢
    exact le_trans (totalDegree_mul p q) (Nat.add_le_add hp hq)
  · simp

lemma V_pow {s : ℕ} {a : MvPolynomial (Fin n) ℚ ⧸ I} (ha : a ∈ V I s) (i : ℕ) :
    a ^ i ∈ V I (i * s) := by
  induction i with
  | zero =>
    refine Submodule.mem_map.mpr ⟨1, ?_, by simp⟩
    rw [mem_restrictTotalDegree]; simp
  | succ i ih =>
    rw [pow_succ, Nat.succ_mul]
    exact V_mul I ih ha

lemma V_exists (a : MvPolynomial (Fin n) ℚ ⧸ I) : ∃ D, a ∈ V I D := by
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
  refine ⟨p.totalDegree, Submodule.mem_map.mpr ⟨p, ?_, rfl⟩⟩
  rw [mem_restrictTotalDegree]

theorem pair_dependent (d : ℕ) (hd : 1 ≤ d) (e : ℤ) (s₀ : ℕ)
    (hHF : ∀ s : ℕ, s₀ ≤ s → (Module.finrank ℚ (V I s) : ℤ) = (d : ℤ) * (s : ℤ) + e)
    (a b : MvPolynomial (Fin n) ℚ ⧸ I) :
    ∃ P : Polynomial (Polynomial ℚ), P ≠ 0 ∧
      Polynomial.eval₂ (Polynomial.aeval b).toRingHom a P = 0 := by
  classical
  obtain ⟨Da, ha⟩ := V_exists I a
  obtain ⟨Db, hb⟩ := V_exists I b
  set D := Da + Db + 1 with hD
  have ha' : a ∈ V I D := V_mono I (by omega) ha
  have hb' : b ∈ V I D := V_mono I (by omega) hb
  set k : ℕ := 2 * d * D + e.natAbs + s₀ + 1 with hk
  have hD1n : 1 ≤ D := by omega
  have hkD : s₀ ≤ 2 * k * D := by
    have h1 : s₀ ≤ k := by omega
    have h2 : k ≤ 2 * k * D := by nlinarith
    omega
  have hmem : ∀ ij : Fin (k + 1) × Fin (k + 1),
      a ^ (ij.1 : ℕ) * b ^ (ij.2 : ℕ) ∈ V I (2 * k * D) := by
    intro ij
    have h1 := V_pow I ha' ij.1
    have h2 := V_pow I hb' ij.2
    have h3 := V_mul I h1 h2
    have hi : (ij.1 : ℕ) ≤ k := by have := ij.1.isLt; omega
    have hj : (ij.2 : ℕ) ≤ k := by have := ij.2.isLt; omega
    refine V_mono I ?_ h3
    have hh1 := Nat.mul_le_mul_right D hi
    have hh2 := Nat.mul_le_mul_right D hj
    calc (ij.1 : ℕ) * D + (ij.2 : ℕ) * D ≤ k * D + k * D := Nat.add_le_add hh1 hh2
      _ = 2 * k * D := by ring
  let v : Fin (k + 1) × Fin (k + 1) → V I (2 * k * D) :=
    fun ij => ⟨a ^ (ij.1 : ℕ) * b ^ (ij.2 : ℕ), hmem ij⟩
  have hF := hHF (2 * k * D) hkD
  have he : -(e.natAbs : ℤ) ≤ e := by omega
  have he' : e ≤ (e.natAbs : ℤ) := by omega
  have hk' : (k : ℤ) = 2 * d * D + e.natAbs + s₀ + 1 := by rw [hk]; push_cast; ring
  have hD1 : (1 : ℤ) ≤ D := by exact_mod_cast hD1n
  have hd1 : (1 : ℤ) ≤ d := by exact_mod_cast hd
  have hs0 : (0 : ℤ) ≤ s₀ := by positivity
  have hab : (0 : ℤ) ≤ e.natAbs := by positivity
  have hk0 : (0 : ℤ) ≤ k := by positivity
  have hdD : (0 : ℤ) ≤ (d : ℤ) * D := by positivity
  have hkD' : (2 * k : ℤ) ≤ 2 * k * D := by nlinarith
  have hdkD : (2 * k * D : ℤ) ≤ d * (2 * k * D) := by nlinarith
  have hkge : (2 * d * D + e.natAbs + 1 : ℤ) ≤ k := by rw [hk']; linarith
  have hpos : 0 < Module.finrank ℚ (V I (2 * k * D)) := by
    have : (0 : ℤ) < (Module.finrank ℚ (V I (2 * k * D)) : ℤ) := by
      rw [hF]
      push_cast
      nlinarith
    exact_mod_cast this
  haveI : Module.Finite ℚ (V I (2 * k * D)) := Module.finite_of_finrank_pos hpos
  have hnot : ¬ LinearIndependent ℚ v := by
    intro hli
    have hcard := hli.fintype_card_le_finrank
    rw [Fintype.card_prod, Fintype.card_fin] at hcard
    have hc : (((k + 1) * (k + 1) : ℕ) : ℤ) ≤ (d : ℤ) * ((2 * k * D : ℕ) : ℤ) + e := by
      rw [← hF]; exact_mod_cast hcard
    push_cast at hc
    have hprod := mul_le_mul_of_nonneg_left hkge hk0
    have hke : (0 : ℤ) ≤ k * e.natAbs := mul_nonneg hk0 hab
    nlinarith
  rw [Fintype.not_linearIndependent_iff] at hnot
  obtain ⟨g, hg, ij0, hij0⟩ := hnot
  refine ⟨∑ ij : Fin (k + 1) × Fin (k + 1),
    Polynomial.monomial (ij.1 : ℕ) (Polynomial.monomial (ij.2 : ℕ) (g ij)), ?_, ?_⟩
  · intro h0
    have := congrArg (fun P : Polynomial (Polynomial ℚ) => (P.coeff (ij0.1 : ℕ)).coeff (ij0.2 : ℕ)) h0
    simp only [Polynomial.finsetSum_coeff, Polynomial.coeff_monomial, Polynomial.coeff_zero] at this
    rw [Finset.sum_eq_single ij0] at this
    · simp [Polynomial.coeff_monomial] at this; exact hij0 this
    · intro ij _ hne
      by_cases h1 : (ij.1 : ℕ) = ij0.1
      · have h2 : (ij.2 : ℕ) ≠ ij0.2 := by
          intro h2; apply hne; exact Prod.ext (Fin.ext h1) (Fin.ext h2)
        simp [Polynomial.coeff_monomial, h1, h2]
      · simp [h1]
    · intro h; exact absurd (Finset.mem_univ ij0) h
  · have hsum0 : ∑ x : Fin (k + 1) × Fin (k + 1),
        algebraMap ℚ (MvPolynomial (Fin n) ℚ ⧸ I) (g x) * (a ^ (x.1 : ℕ) * b ^ (x.2 : ℕ)) = 0 := by
      have := congrArg Subtype.val hg
      simp only [v, Submodule.coe_sum, Submodule.coe_smul, ZeroMemClass.coe_zero] at this
      rw [← this]
      refine Finset.sum_congr rfl (fun x _ => ?_)
      exact (Algebra.smul_def (g x) _).symm
    rw [Polynomial.eval₂_finsetSum, ← hsum0]
    refine Finset.sum_congr rfl (fun ij _ => ?_)
    simp only [Polynomial.eval₂_monomial, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
      Polynomial.aeval_monomial]
    ring

theorem prime_maximal [hI : I.IsPrime] (d : ℕ) (hd : 1 ≤ d) (e : ℤ) (s₀ : ℕ)
    (hHF : ∀ s : ℕ, s₀ ≤ s → (Module.finrank ℚ (V I s) : ℤ) = (d : ℤ) * (s : ℤ) + e)
    (p : Ideal (MvPolynomial (Fin n) ℚ ⧸ I)) (hp : p.IsPrime) (hp0 : p ≠ ⊥) : p.IsMaximal := by
  classical
  obtain ⟨a, hap, ha0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hp0
  have hint : ∀ b : MvPolynomial (Fin n) ℚ ⧸ I, ∃ q : Polynomial ℚ, q ≠ 0 ∧
      Polynomial.aeval b q ∈ p := by
    intro b
    have hex : ∃ N, ∃ P : Polynomial (Polynomial ℚ), P ≠ 0 ∧ P.natDegree = N ∧
        Polynomial.eval₂ (Polynomial.aeval b).toRingHom a P = 0 := by
      obtain ⟨P, hP0, hP⟩ := pair_dependent I d hd e s₀ hHF a b
      exact ⟨_, P, hP0, rfl, hP⟩
    obtain ⟨P, hP0, hPN, hP⟩ := Nat.find_spec hex
    have hc0 : P.coeff 0 ≠ 0 := by
      intro hc
      have hX : Polynomial.X ∣ P := Polynomial.X_dvd_iff.mpr hc
      obtain ⟨Q, hQ⟩ := hX
      have hQ0 : Q ≠ 0 := by
        rintro rfl; rw [mul_zero] at hQ; exact hP0 hQ
      have hQdeg : Q.natDegree < Nat.find hex := by
        rw [← hPN, hQ, Polynomial.natDegree_X_mul hQ0]; omega
      have hQev : Polynomial.eval₂ (Polynomial.aeval b).toRingHom a Q = 0 := by
        rw [hQ, Polynomial.eval₂_mul, Polynomial.eval₂_X] at hP
        exact (mul_eq_zero.mp hP).resolve_left ha0
      exact Nat.find_min hex hQdeg ⟨Q, hQ0, rfl, hQev⟩
    refine ⟨P.coeff 0, hc0, ?_⟩
    have hdecomp := Polynomial.X_mul_divX_add P
    have hev : Polynomial.eval₂ (Polynomial.aeval b).toRingHom a P =
        a * Polynomial.eval₂ (Polynomial.aeval b).toRingHom a P.divX +
          Polynomial.aeval b (P.coeff 0) := by
      conv_lhs => rw [← hdecomp]
      rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_X, Polynomial.eval₂_C]
      rfl
    rw [hP] at hev
    have : Polynomial.aeval b (P.coeff 0) =
        -(a * Polynomial.eval₂ (Polynomial.aeval b).toRingHom a P.divX) := by
      linear_combination -hev
    rw [this]
    exact p.neg_mem (p.mul_mem_right _ hap)
  haveI : p.IsPrime := hp
  have hfield : IsField ((MvPolynomial (Fin n) ℚ ⧸ I) ⧸ p) := by
    haveI : Algebra.IsIntegral ℚ ((MvPolynomial (Fin n) ℚ ⧸ I) ⧸ p) := by
      constructor
      intro x
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x
      obtain ⟨q, hq0, hq⟩ := hint b
      apply IsAlgebraic.isIntegral
      refine ⟨q, hq0, ?_⟩
      have : (Ideal.Quotient.mk p b) = Ideal.Quotient.mkₐ ℚ p b := rfl
      rw [this, Polynomial.aeval_algHom_apply]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hq
    first
      | exact (Algebra.IsIntegral.isField_iff_isField (R := ℚ)
          (S := (MvPolynomial (Fin n) ℚ ⧸ I) ⧸ p) (algebraMap ℚ _).injective).mp (Field.toIsField ℚ)
      | exact isField_of_isIntegral_of_isField' (R := ℚ)
          (S := (MvPolynomial (Fin n) ℚ ⧸ I) ⧸ p) (Field.toIsField ℚ)
  exact Ideal.Quotient.maximal_of_isField p hfield

theorem not_isField (d : ℕ) (hd : 1 ≤ d) (e : ℤ) (s₀ : ℕ)
    (hHF : ∀ s : ℕ, s₀ ≤ s → (Module.finrank ℚ (V I s) : ℤ) = (d : ℤ) * (s : ℤ) + e) :
    ¬ IsField (MvPolynomial (Fin n) ℚ ⧸ I) := by
  intro hF
  letI := hF.toField
  haveI : Algebra.FiniteType ℚ (MvPolynomial (Fin n) ℚ ⧸ I) := by
    first
      | exact Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ ℚ I) (Ideal.Quotient.mkₐ_surjective ℚ I)
      | infer_instance
  haveI : Module.Finite ℚ (MvPolynomial (Fin n) ℚ ⧸ I) :=
    finite_of_finite_type_of_isJacobsonRing ℚ _
  set N := Module.finrank ℚ (MvPolynomial (Fin n) ℚ ⧸ I)
  set s := s₀ + N + e.natAbs + 1 with hs
  have h1 := hHF s (by omega)
  have h2 : Module.finrank ℚ (V I s) ≤ N := Submodule.finrank_le _
  have h3 : ((Module.finrank ℚ (V I s) : ℕ) : ℤ) ≤ (N : ℤ) := by exact_mod_cast h2
  rw [h1] at h3
  have he : -(e.natAbs : ℤ) ≤ e := by omega
  have hs' : (s : ℤ) = s₀ + N + e.natAbs + 1 := by rw [hs]; push_cast; ring
  have hd' : (1 : ℤ) ≤ d := by exact_mod_cast hd
  have hs0 : (0 : ℤ) ≤ s := by positivity
  have hds : (s : ℤ) ≤ d * s := by nlinarith
  have hN0 : (0 : ℤ) ≤ s₀ := by positivity
  linarith

lemma enat_eq_one {y : ℕ∞} (h1 : y ≤ 1) (h0 : ¬ y ≤ 0) : y = 1 := by
  induction y using ENat.recTopCoe with
  | top =>
    exfalso
    first
      | exact absurd h1 (by simp)
      | simp at h1
      | exact absurd h1 (not_le.mpr (WithTop.coe_lt_top 1))
  | coe m =>
    have h1' : m ≤ 1 := by exact_mod_cast h1
    have h0' : ¬ m ≤ 0 := fun h => h0 (by exact_mod_cast h)
    have hm : m = 1 := by omega
    subst hm
    first
      | rfl
      | exact Nat.cast_one
      | simp

theorem krullDim_eq_one_of_affineHilbert (n : ℕ) (I : Ideal (MvPolynomial (Fin n) ℚ)) (hI : I.IsPrime)
    (d : ℕ) (hd : 1 ≤ d) (e : ℤ) (s₀ : ℕ)
    (hHF : ∀ s : ℕ, s₀ ≤ s →
      (Module.finrank ℚ (Submodule.map (Ideal.Quotient.mkₐ ℚ I).toLinearMap
        (MvPolynomial.restrictTotalDegree (Fin n) ℚ s)) : ℤ) = (d : ℤ) * (s : ℤ) + e) :
    ringKrullDim (MvPolynomial (Fin n) ℚ ⧸ I) = 1 := by
  haveI := hI
  have hle : Ring.KrullDimLE 1 (MvPolynomial (Fin n) ℚ ⧸ I) := by
    apply Ring.KrullDimLE.mk₁
    intro p hp
    by_cases hp0 : p = ⊥
    · left
      rw [hp0]
      exact ⟨⟨Ideal.bot_prime, le_rfl⟩, fun _ _ _ => bot_le⟩
    · right
      exact prime_maximal I d hd e s₀ hHF p hp hp0
  have hnf := not_isField I d hd e s₀ hHF
  have h1 : ringKrullDim (MvPolynomial (Fin n) ℚ ⧸ I) ≤ 1 := Ring.krullDimLE_iff.mp hle
  have h0 : ¬ ringKrullDim (MvPolynomial (Fin n) ℚ ⧸ I) ≤ 0 := by
    intro h
    haveI : Ring.KrullDimLE 0 (MvPolynomial (Fin n) ℚ ⧸ I) := Ring.krullDimLE_iff.mpr h
    exact hnf (Ring.KrullDimLE.isField_of_isDomain)
  have hne : ringKrullDim (MvPolynomial (Fin n) ℚ ⧸ I) ≠ ⊥ := by
    intro hb; apply h0; rw [hb]; exact bot_le
  obtain ⟨y, hy⟩ := WithBot.ne_bot_iff_exists.mp hne
  rw [← hy] at h1 h0 ⊢
  have h1' : y ≤ 1 := by exact_mod_cast h1
  have h0' : ¬ y ≤ 0 := fun h => h0 (by exact_mod_cast h)
  have : y = 1 := enat_eq_one h1' h0'
  rw [this]; rfl

end DimOne

namespace A6CubicNormConicExpansionPrivate
open MvPolynomial
noncomputable section
abbrev Binary := MvPolynomial (Fin 2) ℤ
abbrev PlanarZ := Binary
lemma degree_add_bound (P Q : PlanarZ) (n : ℕ)
    (hP : P.totalDegree ≤ n) (hQ : Q.totalDegree ≤ n) :
    (P+Q).totalDegree ≤ n := by
  rw [←MvPolynomial.mem_restrictTotalDegree] at hP hQ ⊢
  exact Submodule.add_mem _ hP hQ

lemma degree_mul_bound (P Q : PlanarZ) (m n : ℕ)
    (hP : P.totalDegree ≤ m) (hQ : Q.totalDegree ≤ n) :
    (P*Q).totalDegree ≤ m+n :=
  (MvPolynomial.totalDegree_mul P Q).trans (Nat.add_le_add hP hQ)

lemma degree_const_bound (r : ℤ) : (C r : PlanarZ).totalDegree ≤ 0 := by
  rw [MvPolynomial.totalDegree_C]

section Generic
variable {R : Type*} [CommRing R] [Nontrivial R]

lemma gdegree_add_bound (P Q : MvPolynomial (Fin 2) R) (n : ℕ)
    (hP : P.totalDegree ≤ n) (hQ : Q.totalDegree ≤ n) :
    (P+Q).totalDegree ≤ n := by
  rw [←MvPolynomial.mem_restrictTotalDegree] at hP hQ ⊢
  exact Submodule.add_mem _ hP hQ

lemma gdegree_mul_bound (P Q : MvPolynomial (Fin 2) R) (m n : ℕ)
    (hP : P.totalDegree ≤ m) (hQ : Q.totalDegree ≤ n) :
    (P*Q).totalDegree ≤ m+n :=
  (MvPolynomial.totalDegree_mul P Q).trans (Nat.add_le_add hP hQ)

lemma gdegree_const_bound (r : R) : (C r : MvPolynomial (Fin 2) R).totalDegree ≤ 0 := by
  rw [MvPolynomial.totalDegree_C]

lemma gdegree_X_bound (i : Fin 2) : (X i : MvPolynomial (Fin 2) R).totalDegree ≤ 1 := by
  rw [MvPolynomial.totalDegree_X]

lemma gdegree_linear_bound (a b : R) :
    (C a*X (0:Fin 2)+C b*X (1:Fin 2) : MvPolynomial (Fin 2) R).totalDegree ≤ 1 := by
  apply gdegree_add_bound _ _ 1
  · exact (gdegree_mul_bound (C a) (X (0:Fin 2)) 0 1 (gdegree_const_bound a)
      (gdegree_X_bound 0)).trans (by omega)
  · exact (gdegree_mul_bound (C b) (X (1:Fin 2)) 0 1 (gdegree_const_bound b)
      (gdegree_X_bound 1)).trans (by omega)

lemma gmonomial_eq_two (m : Fin 2 →₀ ℕ) (r : R) :
    (monomial m r : MvPolynomial (Fin 2) R)=C r*(X 0^m 0*X 1^m 1) := by
  rw [monomial_eq,Finsupp.prod_fintype _ _ (fun i => pow_zero _)]
  simp [Fin.prod_univ_two]

lemma gdegree_pow_bound (P : MvPolynomial (Fin 2) R) (n d : ℕ)
    (hP : P.totalDegree ≤ d) : (P^n).totalDegree ≤ n*d := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ]
    exact (gdegree_mul_bound (P^n) P (n*d) d ih hP).trans_eq (by ring)

end Generic
end
end A6CubicNormConicExpansionPrivate

namespace A6BinaryFramePrivate
open MvPolynomial
noncomputable section
abbrev Mat := Matrix (Fin 2) (Fin 2) ℤ
abbrev Binary := MvPolynomial (Fin 2) ℤ
abbrev PlanarZ := Binary
lemma degree_pow_bound (P : PlanarZ) (n d : ℕ)
    (hP : P.totalDegree ≤ d) : (P^n).totalDegree ≤ n*d := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ]
    exact (A6CubicNormConicExpansionPrivate.degree_mul_bound (P^n) P (n*d) d ih hP).trans_eq (by ring)

lemma gdegree_linear_pullback_bound {R : Type*} [CommRing R] [Nontrivial R]
    (P : MvPolynomial (Fin 2) R) (n : ℕ)
    (hP : P.totalDegree ≤ n) (a b c d : R) :
    (aeval ![C a*X (0:Fin 2)+C b*X (1:Fin 2),
      C c*X (0:Fin 2)+C d*X (1:Fin 2)] P).totalDegree ≤ n := by
  classical
  let D : MvPolynomial (Fin 2) R := C a*X 0+C b*X 1
  let E : MvPolynomial (Fin 2) R := C c*X 0+C d*X 1
  have hD : D.totalDegree ≤ 1 := A6CubicNormConicExpansionPrivate.gdegree_linear_bound a b
  have hE : E.totalDegree ≤ 1 := A6CubicNormConicExpansionPrivate.gdegree_linear_bound c d
  rw [←MvPolynomial.mem_restrictTotalDegree]
  rw [P.as_sum,map_sum]
  apply Submodule.sum_mem
  intro m hm
  have hmdegree : m 0+m 1 ≤ n := by
    have hsum : (m.sum fun _ e => e)=m 0+m 1 := by
      rw [Finsupp.sum_fintype _ _ (by intro i; rfl)]
      simp [Fin.sum_univ_two]
    simpa only [hsum] using (MvPolynomial.le_totalDegree hm).trans hP
  rw [MvPolynomial.mem_restrictTotalDegree]
  rw [A6CubicNormConicExpansionPrivate.gmonomial_eq_two]
  simp only [map_mul,map_pow,aeval_C,aeval_X,MvPolynomial.algebraMap_eq,
    Matrix.cons_val_zero,Matrix.cons_val_one]
  change (C (P.coeff m)*(D^(m 0)*E^(m 1))).totalDegree ≤ n
  have hDp : (D^(m 0)).totalDegree ≤ m 0 := by
    simpa using A6CubicNormConicExpansionPrivate.gdegree_pow_bound D (m 0) 1 hD
  have hEp : (E^(m 1)).totalDegree ≤ m 1 := by
    simpa using A6CubicNormConicExpansionPrivate.gdegree_pow_bound E (m 1) 1 hE
  exact (A6CubicNormConicExpansionPrivate.gdegree_mul_bound _ _ 0 (m 0+m 1)
    (A6CubicNormConicExpansionPrivate.gdegree_const_bound _)
    (A6CubicNormConicExpansionPrivate.gdegree_mul_bound _ _ (m 0) (m 1) hDp hEp)).trans (by omega)

def frame {R : Type*} [CommRing R] (A : Mat) :
    MvPolynomial (Fin 2) R →ₐ[R] MvPolynomial (Fin 2) R :=
  aeval ![C (A 0 0:R)*X (0:Fin 2)+C (A 0 1:R)*X (1:Fin 2),
    C (A 1 0:R)*X (0:Fin 2)+C (A 1 1:R)*X (1:Fin 2)]
lemma frame_comp {R : Type*} [CommRing R] (A P : Mat) :
    (frame (R:=R) A).comp (frame P)=frame (P*A) := by
  apply MvPolynomial.algHom_ext
  intro i
  fin_cases i <;>
    simp [frame,Matrix.mul_apply,Fin.sum_univ_two,map_add,map_mul] <;> ring
lemma frame_one {R : Type*} [CommRing R] :
    frame (R:=R) (1:Mat)=AlgHom.id R (MvPolynomial (Fin 2) R) := by
  apply MvPolynomial.algHom_ext
  intro i
  fin_cases i <;> simp [frame,Matrix.one_apply]
def frameEquiv {R : Type*} [CommRing R] (A P : Mat)
    (hAP : A*P=1) (hPA : P*A=1) :
    MvPolynomial (Fin 2) R ≃ₐ[R] MvPolynomial (Fin 2) R :=
  { frame A with
    invFun := frame P
    left_inv := by
      intro f
      have hh := congrArg (fun g : MvPolynomial (Fin 2) R →ₐ[R]
        MvPolynomial (Fin 2) R => g f) (frame_comp (R:=R) P A)
      simpa [hAP,frame_one] using hh
    right_inv := by
      intro f
      have hh := congrArg (fun g : MvPolynomial (Fin 2) R →ₐ[R]
        MvPolynomial (Fin 2) R => g f) (frame_comp (R:=R) A P)
      simpa [hPA,frame_one] using hh }
lemma frame_degree_le {R : Type*} [CommRing R] [Nontrivial R] (A : Mat)
    (f : MvPolynomial (Fin 2) R) :
    (frame A f).totalDegree≤f.totalDegree :=
  gdegree_linear_pullback_bound f _ le_rfl _ _ _ _
lemma frame_degree_eq {R : Type*} [CommRing R] [Nontrivial R] (A P : Mat)
    (hAP : A*P=1) (hPA : P*A=1)
    (f : MvPolynomial (Fin 2) R) : (frame A f).totalDegree=f.totalDegree := by
  apply Nat.le_antisymm (frame_degree_le A f)
  have hh := frame_degree_le P (frame A f)
  have hinv := (frameEquiv (R:=R) A P hAP hPA).left_inv f
  change frame P (frame A f)=f at hinv
  rw [hinv] at hh
  exact hh
end
end A6BinaryFramePrivate

namespace A6PlaneNoLinePrivate
open MvPolynomial
noncomputable section
abbrev PlanarC := MvPolynomial (Fin 2) ℂ
lemma binary_monomial_sum (m : Fin 2 →₀ ℕ) :
    (m.sum fun _ e => e)=m 0+m 1 := by
  rw [Finsupp.sum_fintype _ _ (by intro i; rfl)]
  simp [Fin.sum_univ_two]

lemma nonunit_plane_degree_pos (P : PlanarC)
    (hP0 : P ≠ 0) (hPu : ¬ IsUnit P) : 0 < P.totalDegree := by
  by_contra hpos
  have hd : P.totalDegree=0 := Nat.eq_zero_of_not_pos hpos
  have hmon (m : Fin 2 →₀ ℕ) (hm : m ∈ P.support) : m=0 := by
    have hh := MvPolynomial.le_totalDegree hm
    rw [binary_monomial_sum,hd] at hh
    have h0 : m 0=0 := by omega
    have h1 : m 1=0 := by omega
    ext i
    fin_cases i <;> simp [h0,h1]
  have hPC : P=C (P.coeff 0) := by
    ext m
    by_cases hm : m=0
    · subst m
      simp
    · have hz : P.coeff m=0 := by
        by_contra hn
        exact hm (hmon m (MvPolynomial.mem_support_iff.mpr hn))
      simp [hz,hm,Ne.symm hm]
  have hc : P.coeff 0 ≠ 0 := by
    intro hz
    apply hP0
    rw [hPC,hz,map_zero]
  apply hPu
  rw [hPC]
  exact (isUnit_iff_ne_zero.mpr hc).map (MvPolynomial.C : ℂ →+* PlanarC)

lemma plane_linear_repr (P : PlanarC) (hd : P.totalDegree ≤ 1) :
    P=monomial 0 (P.coeff 0)+
      monomial (Finsupp.single (0:Fin 2) 1) (P.coeff (Finsupp.single (0:Fin 2) 1))+
      monomial (Finsupp.single (1:Fin 2) 1) (P.coeff (Finsupp.single (1:Fin 2) 1)) := by
  classical
  have h01 : (Finsupp.single (0 : Fin 2) 1 : Fin 2 →₀ ℕ) ≠ Finsupp.single (1 : Fin 2) 1 := by
    intro hh
    have hv := congrArg (fun m : Fin 2 →₀ ℕ => m (0 : Fin 2)) hh
    norm_num at hv
  ext m
  by_cases h0 : m=0
  · subst m
    simp
  by_cases h1 : m=Finsupp.single (0:Fin 2) 1
  · subst m
    simp [Ne.symm h0,h01,Ne.symm h01]
  by_cases h2 : m=Finsupp.single (1:Fin 2) 1
  · subst m
    simp [Ne.symm h0,h01,Ne.symm h01]
  have hzero : P.coeff m=0 := by
    by_contra hm
    have hmd := (MvPolynomial.le_totalDegree (MvPolynomial.mem_support_iff.mpr hm)).trans hd
    rw [binary_monomial_sum] at hmd
    have hc : (m 0=0 ∧ m 1=0) ∨ (m 0=1 ∧ m 1=0) ∨ (m 0=0 ∧ m 1=1) := by omega
    rcases hc with ⟨hm0,hm1⟩ | ⟨hm0,hm1⟩ | ⟨hm0,hm1⟩
    · apply h0
      ext i
      fin_cases i <;> simp [hm0,hm1]
    · apply h1
      ext i
      fin_cases i <;> simp [hm0,hm1]
    · apply h2
      ext i
      fin_cases i <;> simp [hm0,hm1]
  simp [hzero,h0,h1,h2,Ne.symm h0,Ne.symm h1,Ne.symm h2]

lemma monomial_eq_two_Q (m : Fin 2 →₀ ℕ) (r : ℂ) :
    (monomial m r : PlanarC)=C r*(X 0^m 0*X 1^m 1) := by
  rw [monomial_eq,Finsupp.prod_fintype _ _ (fun i => pow_zero _)]
  simp [Fin.prod_univ_two]

def lineSubQ (P : PlanarC) (p q r s : ℂ) : Polynomial ℂ :=
  aeval ![Polynomial.C p+Polynomial.C r*Polynomial.X,
    Polynomial.C q+Polynomial.C s*Polynomial.X] P

lemma complex_linear_has_line (P : PlanarC) (hP0 : P≠0) (hPu : ¬ IsUnit P)
    (hd : P.totalDegree ≤ 1) :
    ∃ p q r s : ℂ, (r ≠ 0 ∨ s ≠ 0) ∧ lineSubQ P p q r s=0 := by
  let a : ℂ := P.coeff (Finsupp.single (0:Fin 2) 1)
  let b : ℂ := P.coeff (Finsupp.single (1:Fin 2) 1)
  let c : ℂ := P.coeff 0
  have hrepr : P=C c+C a*X (0:Fin 2)+C b*X (1:Fin 2) := by
    have hh := plane_linear_repr P hd
    simpa [monomial_eq_two_Q,a,b,c] using hh
  have hab : a ≠ 0 ∨ b ≠ 0 := by
    by_contra h
    have ha : a=0 := by tauto
    have hb : b=0 := by tauto
    have hPc : P=C c := by simpa [ha,hb] using hrepr
    have hc : c ≠ 0 := by
      intro hc
      exact hP0 (by simpa [hc] using hPc)
    apply hPu
    rw [hPc]
    exact (isUnit_iff_ne_zero.mpr hc).map (MvPolynomial.C : ℂ →+* PlanarC)
  by_cases ha : a=0
  · have hb : b ≠ 0 := hab.resolve_left (not_not.mpr ha)
    have hbC : (b:ℂ) ≠ 0 := by exact_mod_cast hb
    refine ⟨0,-(c:ℂ)/(b:ℂ),1,0,Or.inl (by norm_num),?_⟩
    have hc : (c:ℂ)+(b:ℂ)*(-(c:ℂ)/(b:ℂ))=0 := by
      field_simp [hbC] <;> ring
    unfold lineSubQ
    rw [hrepr]
    simp only [map_add,map_mul,aeval_C,aeval_X,MvPolynomial.algebraMap_eq,
      Polynomial.algebraMap_apply,Matrix.cons_val_zero,Matrix.cons_val_one]
    change Polynomial.C (c:ℂ)+Polynomial.C (a:ℂ)*
        (Polynomial.C 0+Polynomial.C 1*Polynomial.X)+
        Polynomial.C (b:ℂ)*(Polynomial.C (-(c:ℂ)/(b:ℂ))+Polynomial.C 0*Polynomial.X)=0
    rw [ha]
    simpa only [Rat.cast_zero,map_zero,zero_mul,zero_add,mul_zero,add_zero,←map_mul,←map_add] using
      congrArg (Polynomial.C : ℂ →+* Polynomial ℂ) hc
  · have haC : (a:ℂ) ≠ 0 := by exact_mod_cast ha
    refine ⟨-(c:ℂ)/(a:ℂ),0,-(b:ℂ),(a:ℂ),Or.inr haC,?_⟩
    have hc : (c:ℂ)+(a:ℂ)*(-(c:ℂ)/(a:ℂ))=0 := by
      field_simp [haC] <;> ring
    have hdir : (a:ℂ)*(-(b:ℂ))+(b:ℂ)*(a:ℂ)=0 := by ring
    unfold lineSubQ
    rw [hrepr]
    simp only [map_add,map_mul,aeval_C,aeval_X,MvPolynomial.algebraMap_eq,
      Polynomial.algebraMap_apply,Matrix.cons_val_zero,Matrix.cons_val_one]
    change Polynomial.C (c:ℂ)+Polynomial.C (a:ℂ)*
        (Polynomial.C (-(c:ℂ)/(a:ℂ))+Polynomial.C (-(b:ℂ))*Polynomial.X)+
        Polynomial.C (b:ℂ)*(Polynomial.C 0+Polynomial.C (a:ℂ)*Polynomial.X)=0
    calc
      _=Polynomial.C ((c:ℂ)+(a:ℂ)*(-(c:ℂ)/(a:ℂ)))+
          Polynomial.C ((a:ℂ)*(-(b:ℂ))+(b:ℂ)*(a:ℂ))*Polynomial.X := by
        simp only [map_add,map_mul,map_zero]
        ring
      _=0 := by rw [hc,hdir]; simp

def NoLine (P : PlanarC) : Prop :=
  ∀ p q r s : ℂ,r≠0 ∨ s≠0→lineSubQ P p q r s≠0
lemma noLine_of_dvd (R P : PlanarC) (hR : NoLine R) (hPR : P∣R) : NoLine P := by
  intro p q r s hdir hzero
  apply hR p q r s hdir
  obtain ⟨Q,hQ⟩ := hPR
  rw [hQ]
  simp only [lineSubQ,map_mul] at *
  rw [hzero,zero_mul]

end
end A6PlaneNoLinePrivate

namespace A6PlaneFactorPrivate
open MvPolynomial A6PlaneNoLinePrivate UniqueFactorizationMonoid
noncomputable section
abbrev PolyZ := MvPolynomial (Fin 2) ℤ
abbrev PolyQ := MvPolynomial (Fin 2) ℚ
def toQ : PolyZ →+* PolyQ := MvPolynomial.map (Int.castRingHom ℚ)
def toC : PolyZ →+* A6PlaneNoLinePrivate.PlanarC :=
  MvPolynomial.map (Int.castRingHom ℂ)
def qToC : PolyQ →+* A6PlaneNoLinePrivate.PlanarC :=
  MvPolynomial.map (Rat.castHom ℂ)
lemma totalDegree_map_eq {R S : Type*} [CommSemiring R] [CommSemiring S]
    (f : R →+* S) (hf : Function.Injective f) (P : MvPolynomial (Fin 2) R) :
    (MvPolynomial.map f P).totalDegree=P.totalDegree := by
  have hs : (MvPolynomial.map f P).support=P.support := by
    ext m
    rw [mem_support_iff,mem_support_iff,coeff_map]
    constructor
    · intro hh hz
      apply hh
      rw [hz,map_zero]
    · intro hh hz
      apply hh
      apply hf
      simpa using hz
  change (MvPolynomial.map f P).support.sup (fun m=>m.sum (fun _ n=>n))=
    P.support.sup (fun m=>m.sum (fun _ n=>n))
  rw [hs]
lemma toQ_injective : Function.Injective toQ :=
  MvPolynomial.map_injective _ (Int.castRingHom ℚ).injective_int
lemma qToC_injective : Function.Injective qToC :=
  MvPolynomial.map_injective _ (Rat.castHom ℂ).injective
lemma degree_toQ (P : PolyZ) : (toQ P).totalDegree=P.totalDegree :=
  totalDegree_map_eq _ (Int.castRingHom ℚ).injective_int P
lemma degree_qToC (P : PolyQ) : (qToC P).totalDegree=P.totalDegree :=
  totalDegree_map_eq _ (Rat.castHom ℂ).injective P
lemma qToC_toQ (P : PolyZ) : qToC (toQ P)=toC P := by
  first
    | (have h : (Rat.castHom ℂ).comp (Int.castRingHom ℚ)=Int.castRingHom ℂ := RingHom.ext_int _ _; unfold qToC toQ toC; rw [MvPolynomial.map_map,h])
    | (ext m; simp [qToC,toQ,toC,MvPolynomial.coeff_map])
lemma complex_not_unit_of_degree_pos (P : A6PlaneNoLinePrivate.PlanarC)
    (hd : 0<P.totalDegree) : ¬ IsUnit P := by
  have hP0 : P≠0 := by intro hz;rw [hz,totalDegree_zero] at hd;omega
  intro hu
  obtain ⟨u,hu⟩ := hu
  have hQ0 : (↑(u⁻¹ : A6PlaneNoLinePrivate.PlanarCˣ) :
      A6PlaneNoLinePrivate.PlanarC)≠0 := Units.ne_zero _
  have hPQ : P*(↑(u⁻¹ : A6PlaneNoLinePrivate.PlanarCˣ) :
      A6PlaneNoLinePrivate.PlanarC)=1 := by rw [←hu];simp
  have hh := MvPolynomial.totalDegree_mul_of_isDomain hP0 hQ0
  rw [hPQ,totalDegree_one] at hh
  omega
lemma multiset_prod_degree (s : Multiset PolyQ) (hs : ∀ P∈s,P≠0) :
    s.prod≠0 ∧ s.prod.totalDegree=(s.map (fun P=>P.totalDegree)).sum := by
  induction s using Multiset.induction_on with
  | empty => simp
  | @cons P s ih =>
    have hP : P≠0 := hs P (by simp)
    have hs' : ∀ Q∈s,Q≠0 := by intro Q hQ;exact hs Q (by simp [hQ])
    obtain ⟨hprod,hdegree⟩ := ih hs'
    refine ⟨by simpa using mul_ne_zero hP hprod,?_⟩
    simpa only [Multiset.prod_cons,Multiset.map_cons,Multiset.sum_cons,
      MvPolynomial.totalDegree_mul_of_isDomain hP hprod,hdegree]
lemma positive_card_le_degree (s : Multiset PolyQ) :
    (s.filter (fun P=>0<P.totalDegree)).card≤(s.map (fun P=>P.totalDegree)).sum := by
  classical
  induction s using Multiset.induction_on with
  | empty => simp
  | @cons P s ih =>
    by_cases hP : 0<P.totalDegree
    · have hcard : ((P ::ₘ s).filter (fun Q=>0<Q.totalDegree)).card=
          1+(s.filter (fun Q=>0<Q.totalDegree)).card := by simp [hP,Nat.add_comm]
      rw [hcard]
      simp only [Multiset.map_cons,Multiset.sum_cons]
      omega
    · have hP0 : P.totalDegree=0 := by omega
      have hfilter : (P ::ₘ s).filter (fun Q=>0<Q.totalDegree)=
          s.filter (fun Q=>0<Q.totalDegree) := by simp [hP]
      rw [hfilter]
      simpa only [Multiset.map_cons,Multiset.sum_cons,hP0,zero_add] using ih
lemma eval_prod_zero_exists (s : Multiset PolyQ) (z : Fin 2 → ℚ)
    (hz : MvPolynomial.eval z s.prod=0) : ∃ P∈s,MvPolynomial.eval z P=0 := by
  induction s using Multiset.induction_on with
  | empty => simpa using hz
  | @cons P s ih =>
    have hh : MvPolynomial.eval z P*MvPolynomial.eval z s.prod=0 := by simpa using hz
    rcases mul_eq_zero.mp hh with hP|hs
    · exact ⟨P,by simp,hP⟩
    · obtain ⟨Q,hQ,hzQ⟩ := ih hs
      exact ⟨Q,by simp [hQ],hzQ⟩
theorem rational_plane_factor_cover (R : PolyQ) (hR : R≠0) :
    ∃ T : Finset PolyQ,T.card≤R.totalDegree ∧
      (∀ P∈T,Irreducible P ∧ P∣R ∧ 0<P.totalDegree) ∧
      ∀ z : Fin 2 → ℚ,MvPolynomial.eval z R=0→∃P∈T,MvPolynomial.eval z P=0 := by
  classical
  let s := factors R
  let T : Finset PolyQ := (s.filter (fun P=>0<P.totalDegree)).toFinset
  have hassoc : Associated s.prod R := by
    first
      | exact factors_prod hR
      | exact prod_factors hR
  have hsne : ∀ P∈s,P≠0 := by
    intro P hP
    exact (irreducible_of_factor P hP).ne_zero
  obtain ⟨hprod,hdegprod⟩ := multiset_prod_degree s hsne
  have hdegR : s.prod.totalDegree=R.totalDegree := Nat.le_antisymm
    (MvPolynomial.totalDegree_le_of_dvd_of_isDomain hassoc.dvd hR)
    (MvPolynomial.totalDegree_le_of_dvd_of_isDomain hassoc.symm.dvd hprod)
  have hfac (P : PolyQ) (hP : P∈s) : Irreducible P ∧ P∣R := by
    have hPi : Irreducible P := by
      exact irreducible_of_factor P hP
    exact ⟨hPi,(Multiset.dvd_prod hP).trans hassoc.dvd⟩
  refine ⟨T,?_,?_,?_⟩
  · calc
      T.card≤(s.filter (fun P=>0<P.totalDegree)).card := Multiset.toFinset_card_le _
      _≤(s.map (fun P=>P.totalDegree)).sum := positive_card_le_degree s
      _=s.prod.totalDegree := hdegprod.symm
      _=R.totalDegree := hdegR
  · intro P hPT
    have hp : P∈s ∧ 0<P.totalDegree := by simpa [T] using hPT
    exact ⟨(hfac P hp.1).1,(hfac P hp.1).2,hp.2⟩
  · intro z hz
    obtain ⟨Q,hQ⟩ := hassoc.symm.dvd
    have hzprod : MvPolynomial.eval z s.prod=0 := by
      rw [hQ,MvPolynomial.eval_mul,hz,zero_mul]
    obtain ⟨P,hP,hzP⟩ := eval_prod_zero_exists s z hzprod
    have hP0 : P≠0 := hsne P hP
    have hPpos : 0<P.totalDegree := by
      by_contra hpos
      have hd0 : P.totalDegree=0 := by omega
      have hPC := MvPolynomial.totalDegree_eq_zero_iff_eq_C.mp hd0
      have hc : P.coeff 0=0 := by
        have hh := congrArg (MvPolynomial.eval z) hPC
        simp only [MvPolynomial.eval_C] at hh
        exact hh.symm.trans hzP
      apply hP0
      rw [hPC,hc,map_zero]
    refine ⟨P,?_,hzP⟩
    simpa [T] using (show P∈s ∧ 0<P.totalDegree from ⟨hP,hPpos⟩)
theorem plane_factor_data (R : PolyZ) (hR : R≠0) (hR8 : R.totalDegree≤8)
    (hNo : NoLine (toC R)) :
    ∃ T : Finset PolyQ,T.card≤8 ∧
      (∀ P∈T,Irreducible P ∧ 2≤P.totalDegree ∧ P.totalDegree≤8) ∧
      ∀ z : Fin 2 → ℚ,MvPolynomial.eval z (toQ R)=0→∃P∈T,MvPolynomial.eval z P=0 := by
  have hRQ : toQ R≠0 := by
    intro hz
    apply hR
    apply toQ_injective
    simpa using hz
  have hRQdeg : (toQ R).totalDegree=R.totalDegree := degree_toQ R
  obtain ⟨T,hTcard,hTprops,hTcover⟩ := rational_plane_factor_cover (toQ R) hRQ
  refine ⟨T,?_,?_,hTcover⟩
  · rw [hRQdeg] at hTcard
    exact hTcard.trans hR8
  · intro P hPT
    obtain ⟨hPi,hPR,hPpos⟩ := hTprops P hPT
    have hPN : P.totalDegree≤8 := by
      have hh := MvPolynomial.totalDegree_le_of_dvd_of_isDomain hPR hRQ
      rw [hRQdeg] at hh
      exact hh.trans hR8
    refine ⟨hPi,?_,hPN⟩
    by_contra hlo
    have hP0 : P≠0 := hPi.ne_zero
    have hpne : qToC P≠0 := by
      intro hz
      apply hP0
      apply qToC_injective
      simpa using hz
    have hposC : 0<(qToC P).totalDegree := by rw [degree_qToC];exact hPpos
    have hsmall : (qToC P).totalDegree≤1 := by rw [degree_qToC];omega
    obtain ⟨p,q,r,s,hdir,hzero⟩ := A6PlaneNoLinePrivate.complex_linear_has_line
      (qToC P) hpne (complex_not_unit_of_degree_pos _ hposC) hsmall
    have hdvd : qToC P∣toC R := by
      rw [←qToC_toQ]
      exact map_dvd qToC hPR
    exact (A6PlaneNoLinePrivate.noLine_of_dvd (toC R) (qToC P) hNo hdvd) p q r s hdir hzero
end
end A6PlaneFactorPrivate

namespace A6PrincipalRankPrivate
open MvPolynomial
noncomputable section
theorem principal_rank_add {A : Type*} [CommRing A] [IsDomain A] [Algebra ℚ A]
    (H : A) (hH : H≠0) (U W : Submodule ℚ A) [FiniteDimensional ℚ U]
    (hmem : ∀q:A,q∈W ↔ H*q∈U) :
    Module.finrank ℚ (Submodule.map
      (Ideal.Quotient.mkₐ ℚ (Ideal.span ({H}:Set A))).toLinearMap U)+
      Module.finrank ℚ W=Module.finrank ℚ U := by
  let I := Ideal.span ({H}:Set A)
  let f : U→ₗ[ℚ] A⧸I := (Ideal.Quotient.mkₐ ℚ I).toLinearMap.comp U.subtype
  let mulH : W→ₗ[ℚ] U :=
    { toFun := fun q=>⟨H*q,(hmem q).mp q.2⟩
      map_add' := by intro x y;apply Subtype.ext;simp [mul_add]
      map_smul' := by intro c x;apply Subtype.ext;simp [mul_smul_comm] }
  have hinj : Function.Injective mulH := by
    intro x y he
    exact Subtype.ext (mul_left_cancel₀ hH (congrArg Subtype.val he))
  have hker : LinearMap.ker f=LinearMap.range mulH := by
    ext p
    simp only [LinearMap.mem_ker,LinearMap.mem_range]
    constructor
    · intro hp
      have hp' : (p:A)∈I := Ideal.Quotient.eq_zero_iff_mem.mp hp
      rw [Ideal.mem_span_singleton] at hp'
      obtain ⟨q,hq⟩ := hp'
      refine ⟨⟨q,(hmem q).mpr (hq ▸ p.2)⟩,?_⟩
      exact Subtype.ext hq.symm
    · rintro ⟨q,rfl⟩
      change Ideal.Quotient.mk I (H*(q:A))=0
      rw [Ideal.Quotient.eq_zero_iff_mem,Ideal.mem_span_singleton]
      exact dvd_mul_right H q
  have hrange : LinearMap.range f=
      Submodule.map (Ideal.Quotient.mkₐ ℚ I).toLinearMap U := by
    rw [LinearMap.range_comp,Submodule.range_subtype]
  have hr := LinearMap.finrank_range_add_finrank_ker f
  rw [hker,LinearMap.finrank_range_of_inj hinj,hrange] at hr
  exact hr
end
end A6PrincipalRankPrivate

namespace A6PlaneHilbertPrivate
noncomputable section
open MvPolynomial

def expSet (s : ℕ) : Set (Fin 2 →₀ ℕ) :=
  {m | m.sum (fun _ n => n) ≤ s}

lemma expSum (m : Fin 2 →₀ ℕ) :
    m.sum (fun _ n => n) = m 0 + m 1 := by
  rw [Finsupp.sum_fintype _ _ (by intro i; rfl), Fin.sum_univ_two]

def expEquiv (s : ℕ) :
    expSet s ≃ (Σ i : Fin (s + 1), Fin (s - (i : ℕ) + 1)) where
  toFun m := ⟨⟨m.1 0, by
    have hm := m.2
    change m.1.sum (fun _ n => n) ≤ s at hm
    rw [expSum] at hm
    omega⟩, ⟨m.1 1, by
    have hm := m.2
    change m.1.sum (fun _ n => n) ≤ s at hm
    rw [expSum] at hm
    change m.1 1 < s - m.1 0 + 1
    omega⟩⟩
  invFun ij := ⟨Finsupp.equivFunOnFinite.symm ![(ij.1 : ℕ), (ij.2 : ℕ)], by
    change (Finsupp.equivFunOnFinite.symm ![(ij.1 : ℕ), (ij.2 : ℕ)]).sum
      (fun _ n => n) ≤ s
    rw [expSum]
    have hi := ij.1.isLt
    have hj := ij.2.isLt
    simp
    omega⟩
  left_inv m := by
    apply Subtype.ext
    ext i
    fin_cases i <;> simp
  right_inv ij := by
    rcases ij with ⟨i, j⟩
    simp

lemma triangleSum (s : ℕ) :
    (∑ i ∈ Finset.range (s + 1), (s - i + 1)) = (s + 2).choose 2 := by
  induction s with
  | zero => norm_num
  | succ s ih =>
    rw [Finset.sum_range_succ]
    have hsum :
        (∑ i ∈ Finset.range (s + 1), (s + 1 - i + 1)) =
        (∑ i ∈ Finset.range (s + 1), (s - i + 1)) + (s + 1) := by
      calc
        _ = ∑ i ∈ Finset.range (s + 1), ((s - i + 1) + 1) := by
          apply Finset.sum_congr rfl
          intro i hi
          have := Finset.mem_range.mp hi
          omega
        _ = _ := by simp [Finset.sum_add_distrib]
    change (∑ i ∈ Finset.range (s + 1), (s + 1 - i + 1)) +
      (s + 1 - (s + 1) + 1) = (s + 1 + 2).choose 2
    rw [hsum, ih]
    have hc := Nat.choose_succ_succ' (s + 2) 1
    simp only [Nat.choose_one_right, Nat.reduceAdd] at hc
    have he : s + 1 + 2 = s + 2 + 1 := by omega
    rw [he, hc]
    omega

lemma finrank_filtered (s : ℕ) :
    Module.finrank ℚ (restrictTotalDegree (Fin 2) ℚ s) = (s + 2).choose 2 := by
  classical
  haveI : Fintype (expSet s) := Fintype.ofEquiv _ (expEquiv s).symm
  have hcard : Fintype.card (expSet s) = (s + 2).choose 2 := by
    rw [Fintype.card_congr (expEquiv s), Fintype.card_sigma]
    simp only [Fintype.card_fin]
    exact (Fin.sum_univ_eq_sum_range (fun i : ℕ => s - i + 1) (s + 1)).trans
      (triangleSum s)
  change Module.finrank ℚ (restrictSupport ℚ (expSet s)) = _
  rw [← hcard]
  exact Module.finrank_eq_card_basis (basisRestrictSupport ℚ (expSet s))

lemma principal_hilbert_nat
    (P : MvPolynomial (Fin 2) ℚ) (hP : P ≠ 0) (s : ℕ) (hs : P.totalDegree ≤ s) :
    Module.finrank ℚ
      (Submodule.map
        (Ideal.Quotient.mkₐ ℚ (Ideal.span ({P} : Set (MvPolynomial (Fin 2) ℚ)))).toLinearMap
        (restrictTotalDegree (Fin 2) ℚ s)) =
      (s + 2).choose 2 - (s - P.totalDegree + 2).choose 2 := by
  classical
  let U := restrictTotalDegree (Fin 2) ℚ s
  let W := restrictTotalDegree (Fin 2) ℚ (s-P.totalDegree)
  haveI : FiniteDimensional ℚ U := by
    apply Module.finite_of_finrank_pos
    change 0<Module.finrank ℚ (restrictTotalDegree (Fin 2) ℚ s)
    rw [finrank_filtered]
    exact lt_of_lt_of_le (by norm_num : 0<(2:ℕ).choose 2)
      (Nat.choose_le_choose 2 (by omega))
  have hmem (q : MvPolynomial (Fin 2) ℚ) : q∈W ↔ P*q∈U := by
    simp only [W,U,mem_restrictTotalDegree]
    constructor
    · intro hq
      exact le_trans (totalDegree_mul P q) (by omega)
    · intro hp
      by_cases hq : q=0
      · simp [hq]
      · have hh := totalDegree_mul_of_isDomain hP hq
        omega
  have hr := A6PrincipalRankPrivate.principal_rank_add P hP U W hmem
  change Module.finrank ℚ _+
    Module.finrank ℚ (restrictTotalDegree (Fin 2) ℚ (s-P.totalDegree))=
    Module.finrank ℚ (restrictTotalDegree (Fin 2) ℚ s) at hr
  rw [finrank_filtered,finrank_filtered] at hr
  exact Nat.eq_sub_of_add_eq hr

theorem principal_hilbert (P : MvPolynomial (Fin 2) ℚ) (hP : P ≠ 0) :
    let I : Ideal (MvPolynomial (Fin 2) ℚ) :=
      Ideal.span ({P} : Set (MvPolynomial (Fin 2) ℚ))
    (∀ s : ℕ, P.totalDegree ≤ s →
      Module.finrank ℚ
        (Submodule.map (Ideal.Quotient.mkₐ ℚ I).toLinearMap
          (MvPolynomial.restrictTotalDegree (Fin 2) ℚ s)) =
        (s + 2).choose 2 - (s - P.totalDegree + 2).choose 2) ∧
    (∀ s : ℕ, P.totalDegree ≤ s →
      (Module.finrank ℚ
        (Submodule.map (Ideal.Quotient.mkₐ ℚ I).toLinearMap
          (MvPolynomial.restrictTotalDegree (Fin 2) ℚ s)) : ℤ) =
        (P.totalDegree : ℤ) * (s : ℤ) + (P.totalDegree : ℤ) -
          (P.totalDegree.choose 2 : ℤ)) := by
  dsimp only
  constructor
  · intro s hs
    exact principal_hilbert_nat P hP s hs
  · intro s hs
    rw [principal_hilbert_nat P hP s hs]
    have hle : (s - P.totalDegree + 2).choose 2 ≤ (s + 2).choose 2 :=
      Nat.choose_le_choose 2 (by omega)
    rw [Nat.cast_sub hle]
    have hrat :
        (((s + 2).choose 2 : ℕ) : ℚ) -
            (((s - P.totalDegree + 2).choose 2 : ℕ) : ℚ) =
          (P.totalDegree : ℚ) * (s : ℚ) + (P.totalDegree : ℚ) -
            ((P.totalDegree.choose 2 : ℕ) : ℚ) := by
      rw [Nat.cast_choose_two, Nat.cast_choose_two, Nat.cast_choose_two]
      push_cast [Nat.cast_sub hs]
      ring
    exact_mod_cast hrat

theorem curve_data (P : MvPolynomial (Fin 2) ℚ)
    (hP : Irreducible P) (hd : 1 ≤ P.totalDegree) :
    let I : Ideal (MvPolynomial (Fin 2) ℚ) :=
      Ideal.span ({P} : Set (MvPolynomial (Fin 2) ℚ))
    I.IsPrime ∧ ringKrullDim (MvPolynomial (Fin 2) ℚ ⧸ I) = 1 ∧
      ∃ e : ℤ, ∃ s₀ : ℕ, ∀ s : ℕ, s₀ ≤ s →
        (Module.finrank ℚ
          (Submodule.map (Ideal.Quotient.mkₐ ℚ I).toLinearMap
            (MvPolynomial.restrictTotalDegree (Fin 2) ℚ s)) : ℤ) =
          (P.totalDegree : ℤ) * (s : ℤ) + e := by
  dsimp only
  have hprime :
      (Ideal.span ({P} : Set (MvPolynomial (Fin 2) ℚ))).IsPrime :=
    (Ideal.span_singleton_prime hP.ne_zero).mpr hP.prime
  have hHF : ∀ s : ℕ, P.totalDegree ≤ s →
      (Module.finrank ℚ
        (Submodule.map
          (Ideal.Quotient.mkₐ ℚ
            (Ideal.span ({P} : Set (MvPolynomial (Fin 2) ℚ)))).toLinearMap
          (MvPolynomial.restrictTotalDegree (Fin 2) ℚ s)) : ℤ) =
        (P.totalDegree : ℤ) * (s : ℤ) +
          ((P.totalDegree : ℤ) - (P.totalDegree.choose 2 : ℤ)) := by
    intro s hs
    simpa only [sub_eq_add_neg, add_assoc] using
      (principal_hilbert P hP.ne_zero).2 s hs
  refine ⟨hprime, ?_, (P.totalDegree : ℤ) - (P.totalDegree.choose 2 : ℤ),
    P.totalDegree, hHF⟩
  exact DimOne.krullDim_eq_one_of_affineHilbert
    2 _ hprime P.totalDegree hd _ P.totalDegree hHF

end
end A6PlaneHilbertPrivate

namespace A6CountRealPrivate
noncomputable section
lemma ccdn_price_bound (D d k : ℕ) (hk0 : 0<k) (hk : k≤d) (hdD : d≤D)
    (c x B E eps : ℝ) (hx : 2≤x) (hE : 0<E) (heps : 0<eps)
    (hB : 0≤B) (hXX : B≤x^E) :
    c*(d:ℝ)^3*(max 1 B)^((1:ℝ)/(d:ℝ))*
      (Real.log (max 1 B)+(d:ℝ)) ≤
    ((|c|+1)*(D:ℝ)^3*(E/eps+(D:ℝ)))*
      x^eps*(1+B^((1:ℝ)/(k:ℝ))) := by
  have hD : 0<D := lt_of_lt_of_le (lt_of_lt_of_le hk0 hk) hdD

  have hx0 : 0<x := by linarith
  have hx1 : 1≤x := by linarith
  have hDpos : (0:ℝ)<(D:ℝ) := by exact_mod_cast hD
  have hdpos : (0:ℝ)<(d:ℝ) := by exact_mod_cast (by omega : 0<d)
  have hkR : (k:ℝ)≤(d:ℝ) := by exact_mod_cast hk
  have hdDR : (d:ℝ)≤(D:ℝ) := by exact_mod_cast hdD
  have hX : 0≤B := hB
  have hH : 1 ≤ max 1 B := le_max_left _ _
  have hH0 : 0 < max 1 B := by linarith
  have hHX : max 1 B≤x^(E) :=
    max_le (Real.one_le_rpow hx1 (by positivity)) hXX
  have hlog : 0≤Real.log (max 1 B) := Real.log_nonneg hH
  have hlogX : Real.log (max 1 B)≤E*Real.log x := by
    calc
      _≤Real.log (x^(E)) := Real.log_le_log hH0 hHX
      _=E*Real.log x := Real.log_rpow hx0 _
  have hlx : Real.log x≤x^eps/eps := Real.log_le_rpow_div hx0.le heps
  have hxeps : 1≤x^eps := Real.one_le_rpow hx1 heps.le
  have hlogfinal :
      Real.log (max 1 B)+(d:ℝ)≤
        (E/eps+(D:ℝ))*x^eps := by
    have hh := hlogX.trans (mul_le_mul_of_nonneg_left hlx (by positivity))
    have hhD := mul_le_mul_of_nonneg_left hxeps hDpos.le
    calc
      _≤E*(x^eps/eps)+(D:ℝ)*x^eps := by nlinarith
      _=_ := by ring
  have hpow :
      (max 1 B)^((1:ℝ)/(d:ℝ))≤1+B^((1:ℝ)/(k:ℝ)) := by
    rcases le_total B 1 with hlo|hhi
    · rw [max_eq_left hlo,Real.one_rpow]
      exact le_add_of_nonneg_right (Real.rpow_nonneg hX _)
    · rw [max_eq_right hhi]
      have he : (1:ℝ)/(d:ℝ)≤1/(k:ℝ) := one_div_le_one_div_of_le (by exact_mod_cast hk0) hkR
      have hh := Real.rpow_le_rpow_of_exponent_le hhi he
      linarith
  have hcube : (d:ℝ)^3≤(D:ℝ)^3 := by gcongr
  have hc : c≤|c|+1 := by linarith [le_abs_self c]
  have hfirst :
      c*(d:ℝ)^3*(max 1 B)^((1:ℝ)/(d:ℝ))*
        (Real.log (max 1 B)+(d:ℝ))≤
      (|c|+1)*(d:ℝ)^3*(max 1 B)^((1:ℝ)/(d:ℝ))*
        (Real.log (max 1 B)+(d:ℝ)) := by
    apply mul_le_mul_of_nonneg_right
    · apply mul_le_mul_of_nonneg_right
      · exact mul_le_mul_of_nonneg_right hc (by positivity)
      · exact Real.rpow_nonneg hH0.le _
    · positivity
  have hprod1 := mul_le_mul_of_nonneg_left hcube (by positivity : 0≤|c|+1)
  have hprod2 := mul_le_mul hprod1 hpow
    (Real.rpow_nonneg hH0.le _) (by positivity : 0≤(|c|+1)*(D:ℝ)^3)
  have hprod3 := mul_le_mul hprod2 hlogfinal
    (by positivity : 0≤Real.log (max 1 B)+(d:ℝ))
    (by positivity : 0≤(|c|+1)*(D:ℝ)^3*(1+B^((1:ℝ)/(k:ℝ))))
  exact hfirst.trans (by nlinarith [hprod3])

lemma ccdn_price_half (d : ℕ) (hd2 : 2≤d) (hd8 : d≤8)
    (c x L Cexp eps : ℝ) (hx : 2≤x) (hC : 0<Cexp) (heps : 0<eps)
    (hL : 0≤L) (hLX : L≤x^Cexp) :
    c*(d:ℝ)^3*(max 1 (L))^((1:ℝ)/(d:ℝ))*
      (Real.log (max 1 (L))+(d:ℝ)) ≤
    ((|c|+1)*((8:ℕ):ℝ)^3*(Cexp/eps+((8:ℕ):ℝ)))*
      x^eps*(1+(L)^((1:ℝ)/2)) := by
  exact ccdn_price_bound 8 d 2 (by omega) hd2 hd8 c x L Cexp eps hx hC heps hL hLX

lemma half_constant_positive (c Cexp eps : ℝ)
    (hC : 0<Cexp) (heps : 0<eps) :
    0<(|c|+1)*((8:ℕ):ℝ)^3*(Cexp/eps+((8:ℕ):ℝ)) := by
  positivity

end
end A6CountRealPrivate

namespace A6PlaneCountPrivate
open MvPolynomial
noncomputable section
def CCDNAt : ℕ → ℝ → Prop := fun N c =>
  ∀ d : ℕ, 1 ≤ d → ∀ I : Ideal (MvPolynomial (Fin N) ℚ), I.IsPrime →
    ringKrullDim (MvPolynomial (Fin N) ℚ ⧸ I) = 1 →
    (∃ e : ℤ, ∃ s0 : ℕ, ∀ s : ℕ, s0 ≤ s →
      (Module.finrank ℚ (Submodule.map (Ideal.Quotient.mkₐ ℚ I).toLinearMap
        (MvPolynomial.restrictTotalDegree (Fin N) ℚ s)) : ℤ) =
          (d : ℤ) * (s : ℤ) + e) →
    ∀ H : ℝ, 1 ≤ H →
      ((({p : Fin N → ℤ |
        (∀ f ∈ I, MvPolynomial.eval (fun i => (p i : ℚ)) f = 0) ∧
        ∀ i, |(p i : ℝ)| ≤ H} : Set (Fin N → ℤ)).ncard : ℕ) : ℝ) ≤
        c * (d : ℝ) ^ 3 * H ^ ((1 : ℝ) / (d : ℝ)) *
          (Real.log H + (d : ℝ))
lemma bounded_points_finite (n : ℕ) (H : ℝ) :
    ({p : Fin n → ℤ | ∀ i,|(p i:ℝ)|≤H} : Set (Fin n → ℤ)).Finite := by
  apply Set.Finite.subset (Set.Finite.pi
    (t:=fun _ : Fin n=>Set.Icc (-⌈H⌉) ⌈H⌉) (fun _=>Set.finite_Icc _ _))
  intro p hp
  rw [Set.mem_univ_pi]
  intro i
  have hi := (abs_le.mp (hp i))
  have hceil := Int.le_ceil H
  constructor
  · have hh : (-(⌈H⌉:ℝ))≤(p i:ℝ) := by linarith [hi.1]
    exact_mod_cast hh
  · have hh : (p i:ℝ)≤(⌈H⌉:ℝ) := by linarith [hi.2]
    exact_mod_cast hh

def planePoints (P : MvPolynomial (Fin 2) ℚ) (L : ℝ) : Set (Fin 2 → ℤ) :=
  {z | MvPolynomial.eval (fun i=>(z i:ℚ)) P=0 ∧ ∀ i,|(z i:ℝ)| ≤ L}
theorem irreducible_half_price (c Cexp eps : ℝ) (hC : CCDNAt 2 c)
    (hCexp : 0<Cexp) (heps : 0<eps) :
    ∃ C : ℝ,0<C ∧ ∀ x L : ℝ,2 ≤ x→0 ≤ L→L ≤ x^Cexp→
      ∀ P : MvPolynomial (Fin 2) ℚ,Irreducible P→2 ≤ P.totalDegree→P.totalDegree ≤ 8→
        (planePoints P L).Finite ∧ ((planePoints P L).ncard:ℝ) ≤
          C*x^eps*(1+L^((1:ℝ)/2)) := by
  let C : ℝ := (|c|+1)*((8:ℕ):ℝ)^3*(Cexp/eps+((8:ℕ):ℝ))
  refine ⟨C,A6CountRealPrivate.half_constant_positive c Cexp eps hCexp heps,?_⟩
  intro x L hx hL hLX P hPi hd2 hd8
  let I : Ideal (MvPolynomial (Fin 2) ℚ) := Ideal.span ({P} : Set _)
  let H : ℝ := max 1 L
  let T : Set (Fin 2 → ℤ) :=
    {z | (∀ f∈I,MvPolynomial.eval (fun i=>(z i:ℚ)) f=0) ∧ ∀ i,|(z i:ℝ)| ≤ H}
  have hT : T.Finite := (bounded_points_finite 2 H).subset (by intro z hz;exact hz.2)
  have hS : (planePoints P L).Finite :=
    (bounded_points_finite 2 L).subset (by intro z hz;exact hz.2)
  refine ⟨hS,?_⟩
  have hmap : ∀ z∈planePoints P L,z∈T := by
    intro z hz
    refine ⟨?_,?_⟩
    · intro f hf
      obtain ⟨q,hq⟩ := Ideal.mem_span_singleton.mp hf
      rw [hq,MvPolynomial.eval_mul,hz.1,zero_mul]
    · intro i
      exact (hz.2 i).trans (le_max_right _ _)
  have hcard : (planePoints P L).ncard ≤ T.ncard :=
    Set.ncard_le_ncard_of_injOn (fun z=>z) hmap
      (by intro z hz w hw he;exact he) hT
  obtain ⟨hprime,hdim,hHF⟩ := A6PlaneHilbertPrivate.curve_data P hPi (by omega)
  have hcc := hC P.totalDegree (by omega) I hprime hdim hHF H (le_max_left _ _)
  calc
    ((planePoints P L).ncard:ℝ) ≤ (T.ncard:ℝ) := by exact_mod_cast hcard
    _ ≤ c*(P.totalDegree:ℝ)^3*H^((1:ℝ)/(P.totalDegree:ℝ))*
      (Real.log H+(P.totalDegree:ℝ)) := hcc
    _ ≤ C*x^eps*(1+L^((1:ℝ)/2)) :=
      A6CountRealPrivate.ccdn_price_half P.totalDegree hd2 hd8 c x L Cexp eps
        hx hCexp heps hL hLX

end
end A6PlaneCountPrivate

namespace A6OriginalFactorUnionPrivate
open MvPolynomial
noncomputable section
abbrev Mat := Matrix (Fin 2) (Fin 2) ℤ
abbrev Bin := MvPolynomial (Fin 2) ℤ
abbrev BinQ := MvPolynomial (Fin 2) ℚ
def coords (A : Mat) (z : Fin 3 → ℤ) : Fin 2 → ℤ :=
  ![A 0 0*z 0+A 0 1*z 1,A 1 0*z 0+A 1 1*z 1]
def pop (Q : Bin) (A : Mat) (h v : ℤ) (L : ℝ) : Set (Fin 3 → ℤ) :=
  {z | (∀i,0<z i) ∧ eval ![z 0,z 1] Q=0 ∧
    v*(z 1)^4-z 2*(z 0)^4=h ∧ ∀i,|(coords A z i:ℝ)|≤L}
def pt (z : Fin 3 → ℤ) : Fin 2 → ℚ :=
  fun i=>(((![z 0,z 1] : Fin 2 → ℤ) i : ℤ) : ℚ)
def popQ (Q : BinQ) (A : Mat) (h v : ℤ) (L : ℝ) : Set (Fin 3 → ℤ) :=
  {z | (∀i,0<z i) ∧ eval (pt z) Q=0 ∧
    v*(z 1)^4-z 2*(z 0)^4=h ∧ ∀i,|(coords A z i:ℝ)|≤L}
lemma recover (P A : Mat) (hPA : P*A=1) (z : Fin 3 → ℤ) :
  P 0 0*coords A z 0+P 0 1*coords A z 1=z 0 ∧
  P 1 0*coords A z 0+P 1 1*coords A z 1=z 1 := by
  have h00 := congrArg (fun M : Mat=>M 0 0) hPA
  have h01 := congrArg (fun M : Mat=>M 0 1) hPA
  have h10 := congrArg (fun M : Mat=>M 1 0) hPA
  have h11 := congrArg (fun M : Mat=>M 1 1) hPA
  simp [Matrix.mul_apply,Fin.sum_univ_two] at h00 h01 h10 h11
  constructor
  · dsimp [coords]
    linear_combination z 0*h00+z 1*h01
  · dsimp [coords]
    linear_combination z 0*h10+z 1*h11
lemma coords_injQ (P A : Mat) (hPA : P*A=1) (Q : BinQ) (h v : ℤ) (L : ℝ) :
  Set.InjOn (coords A) (popQ Q A h v L) := by
  intro z hz w hw he
  obtain ⟨hz0,hz1⟩ := recover P A hPA z
  obtain ⟨hw0,hw1⟩ := recover P A hPA w
  have h0 : z 0=w 0 := by rw [←hz0,←hw0,he]
  have h1 : z 1=w 1 := by rw [←hz1,←hw1,he]
  have h2 : z 2=w 2 := by
    apply mul_right_cancel₀ (pow_ne_zero 4 (ne_of_gt (hz.1 0)))
    have hzu := hz.2.2.1
    have hwu := hw.2.2.1
    rw [←h0,←h1] at hwu
    linear_combination hwu-hzu
  funext i
  fin_cases i <;> assumption
lemma eval_frameQ (P A : Mat) (hPA : P*A=1) (Q : BinQ) (z : Fin 3 → ℤ) :
    eval (fun i=>((coords A z i:ℤ):ℚ)) (A6BinaryFramePrivate.frame P Q)=eval (pt z) Q := by
  obtain ⟨h0,h1⟩ := recover P A hPA z
  have h0' : ((P 0 0:ℤ):ℚ)*((coords A z 0:ℤ):ℚ)+((P 0 1:ℤ):ℚ)*((coords A z 1:ℤ):ℚ)=
      ((z 0:ℤ):ℚ) := by
    exact_mod_cast h0
  have h1' : ((P 1 0:ℤ):ℚ)*((coords A z 0:ℤ):ℚ)+((P 1 1:ℤ):ℚ)*((coords A z 1:ℤ):ℚ)=
      ((z 1:ℤ):ℚ) := by
    exact_mod_cast h1
  induction Q using MvPolynomial.induction_on
  next r => simp [A6BinaryFramePrivate.frame]
  next Q R hQ hR => simp only [map_add,hQ,hR]
  next Q i hQ =>
    simp only [map_mul,hQ]
    congr 1
    fin_cases i <;> simp [A6BinaryFramePrivate.frame,pt] <;>
      first
        | exact h0'
        | exact h1'
        | linear_combination h0'
        | linear_combination h1'
lemma eval_toQ (Q : Bin) (z : Fin 2 → ℤ) :
  eval (fun i=>(z i:ℚ)) (A6PlaneFactorPrivate.toQ Q)=(eval z Q:ℚ) := by
  induction Q using MvPolynomial.induction_on
  next r => simp [A6PlaneFactorPrivate.toQ]
  next Q R hQ hR => simp only [map_add,hQ,hR,Int.cast_add]
  next Q i hQ =>
    have he : A6PlaneFactorPrivate.toQ (Q*X i)=A6PlaneFactorPrivate.toQ Q*X i := by
      simp [A6PlaneFactorPrivate.toQ]
    rw [he,eval_mul,hQ,eval_mul,eval_X,Int.cast_mul]
    simp only [eval_X]
lemma finite_cover_bound {ι α : Type*} [DecidableEq ι]
    (T : Finset ι) (S : Set α) (U : ι→Set α) (B : ℝ)
    (hU : ∀i∈T,(U i).Finite ∧ ((U i).ncard:ℝ)≤B)
    (hcover : ∀z∈S,∃i∈T,z∈U i) :
    S.Finite ∧ (S.ncard:ℝ)≤(T.card:ℝ)*B := by
  classical
  have hUnion : ∀T : Finset ι,(∀i∈T,(U i).Finite ∧ ((U i).ncard:ℝ)≤B)→
      (⋃i∈T,U i).Finite ∧ (((⋃i∈T,U i):Set α).ncard:ℝ)≤(T.card:ℝ)*B := by
    intro T
    induction T using Finset.induction_on with
    | empty => simp
    | @insert i T hi ih =>
      intro hT
      have hUi := hT i (by simp)
      obtain ⟨hF,hcard⟩ := ih (by intro j hj;exact hT j (by simp [hj]))
      have heq : (⋃j∈insert i T,U j)=U i∪⋃j∈T,U j := by ext z;simp
      rw [heq]
      refine ⟨hUi.1.union hF,?_⟩
      have hu : (((U i∪⋃j∈T,U j):Set α).ncard:ℝ)≤
          ((U i).ncard:ℝ)+(((⋃j∈T,U j):Set α).ncard:ℝ) := by
        exact_mod_cast Set.ncard_union_le (U i) (⋃j∈T,U j)
      have hc : ((insert i T).card:ℝ)=(T.card:ℝ)+1 := by simp [hi]
      rw [hc]
      nlinarith
  obtain ⟨hF,hcard⟩ := hUnion T hU
  have hsub : S⊆⋃i∈T,U i := by intro z hz;simpa using hcover z hz
  refine ⟨hF.subset hsub,?_⟩
  have hc : (S.ncard:ℝ)≤(((⋃i∈T,U i):Set α).ncard:ℝ) := by
    exact_mod_cast Set.ncard_le_ncard hsub hF
  exact hc.trans hcard

theorem actual_original_plane_box_count
    (c : ℝ) (hCC : A6PlaneCountPrivate.CCDNAt 2 c)
    (Cexp eps : ℝ) (hC : 0<Cexp) (heps : 0<eps) :
    ∃ C : ℝ,0<C ∧
      ∀ x : ℝ,2≤x→∀ R : Bin,R≠0→R.totalDegree≤8→
        A6PlaneNoLinePrivate.NoLine (A6PlaneFactorPrivate.toC R)→
      ∀ P A : Mat,A*P=1→P*A=1→
      ∀ h v : ℤ,∀ L : ℝ,0≤L→L≤x^Cexp→
        (pop R A h v L).Finite ∧ ((pop R A h v L).ncard:ℝ)≤
          C*x^eps*(1+L^((1:ℝ)/2)) := by
  classical
  obtain ⟨Ch,hCh,hhigher⟩ := A6PlaneCountPrivate.irreducible_half_price c Cexp eps
    hCC hC heps
  refine ⟨8*(Ch+1),by positivity,?_⟩
  intro x hx R hR hR8 hRN P A hAP hPA h v L hL hLX
  have hx0 : 0<x := by linarith
  obtain ⟨T,hT8,hT,hcover⟩ := A6PlaneFactorPrivate.plane_factor_data R hR hR8 hRN
  let B : ℝ := (Ch+1)*x^eps*(1+L^((1:ℝ)/2))
  have hB : 0≤B := by dsimp [B];positivity
  have hEach : ∀ Q∈T,(popQ Q A h v L).Finite ∧
      ((popQ Q A h v L).ncard:ℝ)≤B := by
    intro Q hQT
    obtain ⟨hQi,hQ2,hQ8⟩ := hT Q hQT
    have hqdeg : (A6BinaryFramePrivate.frame P Q).totalDegree=Q.totalDegree :=
      A6BinaryFramePrivate.frame_degree_eq P A hPA hAP Q
    have hqirr : Irreducible (A6BinaryFramePrivate.frame P Q) :=
      (MulEquiv.irreducible_iff
        (A6BinaryFramePrivate.frameEquiv (R:=ℚ) P A hPA hAP).toMulEquiv).2 hQi
    obtain ⟨hF,hcount⟩ := hhigher x L hx hL hLX (A6BinaryFramePrivate.frame P Q)
      hqirr (by rw [hqdeg];exact hQ2) (by rw [hqdeg];exact hQ8)
    have hmap : ∀z∈popQ Q A h v L,
        coords A z∈A6PlaneCountPrivate.planePoints (A6BinaryFramePrivate.frame P Q) L := by
      intro z hz
      refine ⟨?_,hz.2.2.2⟩
      exact (eval_frameQ P A hPA Q z).trans hz.2.1
    have hinj := coords_injQ P A hPA Q h v L
    have hFin : (popQ Q A h v L).Finite :=
      (hF.subset (by rintro p ⟨z,hz,rfl⟩;exact hmap z hz)).of_finite_image hinj
    refine ⟨hFin,?_⟩
    have hn : ((popQ Q A h v L).ncard:ℝ)≤
        ((A6PlaneCountPrivate.planePoints (A6BinaryFramePrivate.frame P Q) L).ncard:ℝ) := by
      exact_mod_cast Set.ncard_le_ncard_of_injOn (coords A) hmap hinj hF
    apply hn.trans (hcount.trans ?_)
    dsimp [B]
    gcongr
    linarith
  have hcov : ∀z∈pop R A h v L,∃Q∈T,z∈popQ Q A h v L := by
    intro z hz
    have hzQ : eval (pt z) (A6PlaneFactorPrivate.toQ R)=0 := by
      have he := eval_toQ R ![z 0,z 1]
      rw [hz.2.1,Int.cast_zero] at he
      exact he
    obtain ⟨Q,hQT,hQz⟩ := hcover (pt z) hzQ
    exact ⟨Q,hQT,hz.1,hQz,hz.2.2⟩
  obtain ⟨hFin,hcount⟩ := finite_cover_bound T (pop R A h v L)
    (fun Q=>popQ Q A h v L) B hEach hcov
  refine ⟨hFin,hcount.trans ?_⟩
  have hT8R : (T.card:ℝ)≤8 := by exact_mod_cast hT8
  calc
    (T.card:ℝ)*B≤8*B := mul_le_mul_of_nonneg_right hT8R hB
    _=8*(Ch+1)*x^eps*(1+L^((1:ℝ)/2)) := by dsimp [B];ring
end
end A6OriginalFactorUnionPrivate

namespace A6CoefficientDivisibility
open MvPolynomial
open Curves Classify
noncomputable section
set_option maxHeartbeats 2000000
set_option maxRecDepth 5000

abbrev Four := MvPolynomial (Fin 4) ℤ
abbrev Bin := MvPolynomial (Fin 2) ℤ
abbrev BinQ := MvPolynomial (Fin 2) ℚ
abbrev TriQ := MvPolynomial (Fin 3) ℚ

def part (G : Four) (u v : ℤ) : Bin :=
  MvPolynomial.eval₂Hom MvPolynomial.C ![X 0,X 1,C u,C v] G
def A (G : Four) : Bin := part G 1 0
def C0 (G : Four) : Bin := part G 0 1
def B (G : Four) : Bin := part G 1 1-A G-C0 G

def clearHom : Four →+* TriQ :=
  MvPolynomial.eval₂Hom (Int.castRingHom TriQ)
    ![X 0,X 1,X 1^4-X 2,X 0^4]
def clear (G : Four) : TriQ := clearHom G

def lift : Bin →+* Four := MvPolynomial.eval₂Hom MvPolynomial.C ![X 0,X 1]

def quadraticPart : Four →+ Four :=
  { toFun := fun G =>
      lift (A G)*X 2^2+lift (B G)*X 2*X 3+lift (C0 G)*X 3^2
    map_zero' := by simp [A,B,C0,part,lift]
    map_add' := by
      intro P Q
      simp [A,B,C0,part,lift,map_add,map_sub] <;> ring }

lemma quadratic_repr (α : ℕ) (G : Four)
    (hG : ∀ m ∈ G.support,m 0+m 1=α ∧ m 2+m 3=2) :
    G=lift (A G)*X 2^2+lift (B G)*X 2*X 3+lift (C0 G)*X 3^2 := by
  classical
  change G=quadraticPart G
  symm
  calc
    quadraticPart G =
        ∑ m ∈ G.support,quadraticPart (monomial m (G.coeff m)) := by
      conv_lhs => rw [G.as_sum]
      rw [map_sum]
    _ = ∑ m ∈ G.support,monomial m (G.coeff m) := by
      apply Finset.sum_congr rfl
      intro m hm
      have hβ := (hG m hm).2
      have hm2 : m 2=0 ∨ m 2=1 ∨ m 2=2 := by omega
      rcases hm2 with hm2 | hm2 | hm2
      · have hm3 : m 3=2 := by omega
        simp [quadraticPart,A,B,C0,part,lift,monomial_eq_four,hm2,hm3] <;> ring
      · have hm3 : m 3=1 := by omega
        simp [quadraticPart,A,B,C0,part,lift,monomial_eq_four,hm2,hm3] <;> ring
      · have hm3 : m 3=0 := by omega
        simp [quadraticPart,A,B,C0,part,lift,monomial_eq_four,hm2,hm3] <;> ring
    _ = G := G.as_sum.symm

lemma part_hom (α : ℕ) (G : Four)
    (hG : ∀ m ∈ G.support,m 0+m 1=α ∧ m 2+m 3=2) (u v : ℤ) :
    (part G u v).IsHomogeneous α := by
  classical
  change ((MvPolynomial.eval₂Hom MvPolynomial.C ![X 0,X 1,C u,C v]) G :
    Bin).IsHomogeneous α
  rw [G.as_sum,map_sum]
  apply IsHomogeneous.sum
  intro m hm
  have hmα := (hG m hm).1
  have he : ((MvPolynomial.eval₂Hom MvPolynomial.C ![X 0,X 1,C u,C v])
      (monomial m (G.coeff m)) : Bin) =
      C (G.coeff m*u^m 2*v^m 3)*X 0^m 0*X 1^m 1 := by
    simp [monomial_eq_four,mul_assoc,mul_left_comm,mul_comm]
  rw [he]
  have h := ((isHomogeneous_C (Fin 2) (G.coeff m*u^m 2*v^m 3)).mul
    ((isHomogeneous_X ℤ (0 : Fin 2)).pow (m 0))).mul
      ((isHomogeneous_X ℤ (1 : Fin 2)).pow (m 1))
  convert h using 1
  simp
  omega

lemma B_hom (α : ℕ) (G : Four)
    (hG : ∀ m ∈ G.support,m 0+m 1=α ∧ m 2+m 3=2) :
    (B G).IsHomogeneous α := by
  have h := ((part_hom α G hG 1 1).sub (part_hom α G hG 1 0)).sub
    (part_hom α G hG 0 1)
  simpa [B,A,C0] using h

def triPoly : TriQ →ₐ[ℚ] Polynomial BinQ :=
  aeval ![Polynomial.C (X 0),Polynomial.C (X 1),Polynomial.X]
def clearPoly : Four →+* Polynomial BinQ := triPoly.toRingHom.comp clearHom

lemma clearPoly_lift (P : Bin) :
    clearPoly (lift P)=Polynomial.C (map (Int.castRingHom ℚ) P) := by
  induction P using MvPolynomial.induction_on
  next r =>
    simp [clearPoly,lift,triPoly,clearHom,MvPolynomial.algebraMap_eq,
      Polynomial.algebraMap_apply]
  next p q hp hq => simp only [map_add,hp,hq]
  next p i hp =>
    simp only [map_mul,hp]
    fin_cases i <;>
      simp [clearPoly,lift,triPoly,clearHom,MvPolynomial.algebraMap_eq,
        Polynomial.algebraMap_apply]

lemma clearPoly_quadratic (α : ℕ) (G : Four)
    (hG : ∀ m ∈ G.support,m 0+m 1=α ∧ m 2+m 3=2) :
    clearPoly G =
      Polynomial.C (map (Int.castRingHom ℚ) (A G)*X 1^8+
        map (Int.castRingHom ℚ) (B G)*X 0^4*X 1^4+
        map (Int.castRingHom ℚ) (C0 G)*X 0^8)+
      Polynomial.C (-2*map (Int.castRingHom ℚ) (A G)*X 1^4-
        map (Int.castRingHom ℚ) (B G)*X 0^4)*Polynomial.X+
      Polynomial.C (map (Int.castRingHom ℚ) (A G))*Polynomial.X^2 := by
  conv_lhs => rw [quadratic_repr α G hG]
  simp only [map_add,map_mul,map_pow,clearPoly_lift]
  have h2 : clearPoly (X 2)=
      Polynomial.C (X (1:Fin 2))^4-Polynomial.X := by
    simp [clearPoly,triPoly,clearHom]
  have h3 : clearPoly (X 3)=Polynomial.C (X (0:Fin 2))^4 := by
    simp [clearPoly,triPoly,clearHom]
  rw [h2,h3]
  simp only [map_add,map_mul,map_pow,map_sub,map_neg]
  have htwo : (Polynomial.C (2:BinQ) : Polynomial BinQ)=2 := by
    rw [show (2:BinQ)=(1:BinQ)+1 by norm_num]
    simp only [map_add,map_one] <;> norm_num
  rw [htwo]
  ring

lemma pow_div_cancel {R : Type*} [CommRing R] [IsDomain R]
    (a p : R) (ha : a ≠ 0) (n k : ℕ) (h : a^n ∣ p*a^k) :
    a^(n-k) ∣ p := by
  by_cases hnk : n ≤ k
  · simp [Nat.sub_eq_zero_of_le hnk]
  · have hkn : k ≤ n := by omega
    obtain ⟨r,hr⟩ := h
    refine ⟨r,?_⟩
    apply mul_right_cancel₀ (pow_ne_zero k ha)
    have hn : a^n=a^(n-k)*a^k := by
      rw [←pow_add,Nat.sub_add_cancel hkn]
    calc
      p*a^k=a^n*r := hr
      _=(a^(n-k)*r)*a^k := by rw [hn]; ring

lemma pow_div_of_le {R : Type*} [CommMonoid R] (a : R) {m n : ℕ}
    (h : m ≤ n) : a^m ∣ a^n := by
  refine ⟨a^(n-m),?_⟩
  rw [mul_comm,←pow_add,Nat.sub_add_cancel h]

lemma dehom_map_int (P : Bin) :
    dehom (map (Int.castRingHom ℚ) P)=
      (dehom P).map (Int.castRingHom ℚ) := by
  induction P using MvPolynomial.induction_on
  next r => simp [dehom,Polynomial.algebraMap_eq]
  next p q hp hq =>
    simpa only [dehom,map_add,Polynomial.map_add] using congrArg₂ (·+·) hp hq
  next p i hp =>
    simp only [dehom,map_mul,Polynomial.map_mul] at *
    rw [hp]
    fin_cases i <;> simp [dehom]

lemma integral_X_power_descent (P : Bin) (α n : ℕ)
    (hP : P.IsHomogeneous α)
    (hQ : (X (0:Fin 2) : BinQ)^n ∣ map (Int.castRingHom ℚ) P) :
    (X (0:Fin 2) : Bin)^n ∣ P := by
  classical
  have hdehom : (Polynomial.X : Polynomial ℚ)^n ∣
      dehom (map (Int.castRingHom ℚ) P) := by
    obtain ⟨r,hr⟩ := hQ
    refine ⟨dehom r,?_⟩
    change (aeval ![Polynomial.X,1]) (map (Int.castRingHom ℚ) P)=_
    rw [hr,map_mul,map_pow]
    simp [dehom]
  have hlow (j : ℕ) (hj : j < n) : (dehom P).coeff j=0 := by
    have hz := Polynomial.X_pow_dvd_iff.mp hdehom j hj
    rw [dehom_map_int,Polynomial.coeff_map] at hz
    exact Int.cast_injective hz
  rw [hom_repr hP]
  apply Finset.dvd_sum
  intro j hj
  have hjα : j ≤ α := by simpa [Finset.mem_range,Nat.lt_succ_iff] using hj
  by_cases hjn : j < n
  · have hc : P.coeff (ex j (α-j))=0 := by
      have hd := dehom_coeff hP j
      rw [if_pos hjα] at hd
      exact hd.symm.trans (hlow j hjn)
    simp [hc]
  · have hn : n ≤ j := by omega
    exact dvd_mul_of_dvd_left
      (dvd_mul_of_dvd_right (pow_div_of_le (X (0:Fin 2) : Bin) hn) _) _

theorem coefficient_divisibility (α : ℕ) (G : Four)
    (hG : ∀ m ∈ G.support,m 0+m 1=α ∧ m 2+m 3=2)
    (hcan : (X (0:Fin 3) : TriQ)^α ∣ clear G) :
    (X (0:Fin 2) : Bin)^α ∣ A G ∧
    (X (0:Fin 2) : Bin)^(α-4) ∣ B G ∧
    (X (0:Fin 2) : Bin)^(α-8) ∣ C0 G := by
  classical
  have hx0 : (X (0:Fin 2) : BinQ) ≠ 0 := by simp
  have hCdiv : Polynomial.C ((X (0:Fin 2) : BinQ)^α) ∣ clearPoly G := by
    obtain ⟨r,hr⟩ := hcan
    refine ⟨triPoly r,?_⟩
    change triPoly (clear G)=_
    rw [hr,map_mul,map_pow]
    simp [triPoly]
  have hcoeff := (Polynomial.C_dvd_iff_dvd_coeff _ _).mp hCdiv
  have hAdiv : (X (0:Fin 2) : BinQ)^α ∣ map (Int.castRingHom ℚ) (A G) := by
    have hc := hcoeff 2
    rw [clearPoly_quadratic α G hG] at hc
    norm_num only [Polynomial.coeff_add,Polynomial.coeff_C_mul_X_pow,
      Polynomial.coeff_C_mul,Polynomial.coeff_C,Polynomial.coeff_X,
      Polynomial.coeff_X_pow] at hc
    simpa using hc
  have hlin : (X (0:Fin 2) : BinQ)^α ∣
      -2*map (Int.castRingHom ℚ) (A G)*X 1^4-
        map (Int.castRingHom ℚ) (B G)*X 0^4 := by
    have hc := hcoeff 1
    rw [clearPoly_quadratic α G hG] at hc
    norm_num only [Polynomial.coeff_add,Polynomial.coeff_C_mul_X_pow,
      Polynomial.coeff_C_mul,Polynomial.coeff_C,Polynomial.coeff_X,
      Polynomial.coeff_X_pow] at hc
    simpa only [ite_true,ite_false,zero_add,add_zero,zero_mul,mul_zero,
      mul_one,one_mul] using hc
  have hconst : (X (0:Fin 2) : BinQ)^α ∣
      map (Int.castRingHom ℚ) (A G)*X 1^8+
        map (Int.castRingHom ℚ) (B G)*X 0^4*X 1^4+
        map (Int.castRingHom ℚ) (C0 G)*X 0^8 := by
    have hc := hcoeff 0
    rw [clearPoly_quadratic α G hG] at hc
    norm_num only [Polynomial.coeff_add,Polynomial.coeff_C_mul_X_pow,
      Polynomial.coeff_C_mul,Polynomial.coeff_C,Polynomial.coeff_X,
      Polynomial.coeff_X_pow] at hc
    simpa only [ite_true,ite_false,zero_add,add_zero,zero_mul,mul_zero,
      mul_one,one_mul] using hc
  have hnegA : (X (0:Fin 2) : BinQ)^α ∣
      -2*map (Int.castRingHom ℚ) (A G)*X 1^4 :=
    dvd_mul_of_dvd_left (dvd_mul_of_dvd_right hAdiv (-2)) _
  have hBD : (X (0:Fin 2) : BinQ)^α ∣
      map (Int.castRingHom ℚ) (B G)*X 0^4 := by
    convert dvd_sub hnegA hlin using 1 <;> ring
  have hAB : (X (0:Fin 2) : BinQ)^α ∣
      map (Int.castRingHom ℚ) (A G)*X 1^8+
        map (Int.castRingHom ℚ) (B G)*X 0^4*X 1^4 := by
    apply dvd_add (dvd_mul_of_dvd_left hAdiv _)
    simpa [mul_assoc,mul_left_comm,mul_comm] using
      dvd_mul_of_dvd_left hBD (X (1:Fin 2)^4)
  have hCD : (X (0:Fin 2) : BinQ)^α ∣
      map (Int.castRingHom ℚ) (C0 G)*X 0^8 := by
    convert dvd_sub hconst hAB using 1 <;> ring
  have hBQ : (X (0:Fin 2) : BinQ)^(α-4) ∣ map (Int.castRingHom ℚ) (B G) :=
    pow_div_cancel _ _ hx0 α 4 hBD
  have hCQ : (X (0:Fin 2) : BinQ)^(α-8) ∣ map (Int.castRingHom ℚ) (C0 G) :=
    pow_div_cancel _ _ hx0 α 8 hCD
  exact ⟨integral_X_power_descent (A G) α α (part_hom α G hG 1 0) hAdiv,
    integral_X_power_descent (B G) α (α-4) (B_hom α G hG) hBQ,
    integral_X_power_descent (C0 G) α (α-8) (part_hom α G hG 0 1) hCQ⟩

end
end A6CoefficientDivisibility

namespace A6GenericWeightedPrivate
open MvPolynomial
open Classify
variable {R σ : Type*} [CommRing R] [IsDomain R]
lemma homogeneous_not_dvd_low (w : σ→ℕ) (g p : MvPolynomial σ R) (u v : ℕ)
    (hg : g≠0) (hp : p≠0) (hhom : IsWeightedHomogeneous w g u)
    (hpHom : IsWeightedHomogeneous w p v) (hvu : v<u) : ¬g∣p := by
  rintro ⟨q,hq⟩
  have hgp : IsWeightedHomogeneous w (g*q) v := by rw [←hq];exact hpHom
  have hgp0 : g*q≠0 := by rw [←hq];exact hp
  obtain ⟨a,b,hab,hga,_⟩ := wh_split hgp hgp0
  have hua : u=a := IsWeightedHomogeneous.inj_right hg hhom hga
  omega
lemma quot_homog (w : σ→ℕ) (H q : MvPolynomial σ R) (L n : ℕ)
    (hH : IsWeightedHomogeneous w H L) (hH0 : H≠0)
    (hp : IsWeightedHomogeneous w (H*q) n) :
    IsWeightedHomogeneous w q (n-L) := by
  by_cases hq : q=0
  · subst q
    intro m hm
    simp at hm
  obtain ⟨a,b,hab,hHa,hqb⟩ := wh_split hp (mul_ne_zero hH0 hq)
  have hLa : L=a := IsWeightedHomogeneous.inj_right hH0 hH hHa
  have hb : b=n-L := by omega
  simpa only [hb] using hqb
end A6GenericWeightedPrivate

namespace A6HomogeneousAffineLinePrivate
open MvPolynomial
open Curves
set_option maxRecDepth 2000

abbrev Poly := MvPolynomial (Fin 2) ℂ

noncomputable def pullback (p q r s : ℂ) : Poly →ₐ[ℂ] Poly :=
  MvPolynomial.aeval
    ![C r * X (0 : Fin 2) + C p * X (1 : Fin 2),
      C s * X (0 : Fin 2) + C q * X (1 : Fin 2)]

noncomputable def scale (c : ℂ) : Poly →ₐ[ℂ] Poly :=
  MvPolynomial.aeval ![C c * X (0 : Fin 2), C c * X (1 : Fin 2)]

lemma zero_of_dehom_eq_zero {P : Poly} {n : ℕ}
    (hP : P.IsHomogeneous n) (hz : dehom P = 0) : P = 0 := by
  have hc (k : ℕ) (hk : k ≤ n) : P.coeff (ex k (n - k)) = 0 := by
    have hh := congrArg (fun f : Polynomial ℂ => f.coeff k) hz
    rw [dehom_coeff hP k, if_pos hk, Polynomial.coeff_zero] at hh
    exact hh
  rw [hom_repr hP]
  apply Finset.sum_eq_zero
  intro k hk
  have hk' : k ≤ n := by
    have := Finset.mem_range.mp hk
    omega
  rw [hc k hk']
  simp

lemma pullback_homogeneous {P : Poly} {n : ℕ}
    (hP : P.IsHomogeneous n) (p q r s : ℂ) :
    (pullback p q r s P).IsHomogeneous n := by
  unfold pullback
  apply Curves.isHomogeneous_aeval_lin hP
  intro i
  fin_cases i <;>
    exact (isHomogeneous_C_mul_X _ _).add (isHomogeneous_C_mul_X _ _)

lemma dehom_pullback (P : Poly) (p q r s : ℂ) :
    dehom (pullback p q r s P) =
      MvPolynomial.aeval
        ![Polynomial.C p + Polynomial.C r * Polynomial.X,
          Polynomial.C q + Polynomial.C s * Polynomial.X] P := by
  have he :
      (MvPolynomial.aeval (![Polynomial.X, 1] : Fin 2 → Polynomial ℂ)).comp
          (pullback p q r s) =
        MvPolynomial.aeval
          ![Polynomial.C p + Polynomial.C r * Polynomial.X,
            Polynomial.C q + Polynomial.C s * Polynomial.X] := by
    ext i
    fin_cases i <;>
      simp [pullback, MvPolynomial.algebraMap_eq, Polynomial.algebraMap_eq,
        add_comm]
  change (MvPolynomial.aeval (![Polynomial.X, 1] : Fin 2 → Polynomial ℂ))
      (pullback p q r s P) = _
  exact DFunLike.congr_fun he P

lemma scale_homogeneous {P : Poly} {n : ℕ}
    (hP : P.IsHomogeneous n) (c : ℂ) :
    scale c P = C (c ^ n) * P := by
  apply MvPolynomial.funext
  intro v
  unfold scale
  rw [Curves.eval_aeval_fin2, eval_mul, eval_C]
  have hv : (fun i : Fin 2 => MvPolynomial.eval v
      ((![C c * X (0 : Fin 2), C c * X (1 : Fin 2)] : Fin 2 → Poly) i)) =
      c • v := by
    funext i
    fin_cases i <;> simp [Pi.smul_apply, smul_eq_mul]
  rw [hv]
  exact eval_smul_hom hP c v

lemma adjugate_comp (p q r s : ℂ) :
    (pullback (-p) r q (-s)).comp (pullback p q r s) =
      scale (r * q - p * s) := by
  apply MvPolynomial.algHom_ext
  intro i
  fin_cases i <;>
    simp [pullback, scale, MvPolynomial.algebraMap_eq, sub_eq_add_neg] <;>
    ring

theorem homogeneous_affine_line_vanish :
(∀ (n : ℕ) (P : MvPolynomial (Fin 2) ℂ),
  P.IsHomogeneous n →
    ∀ p q r s : ℂ,
      r * q - p * s ≠ 0 →
        MvPolynomial.aeval
          ![Polynomial.C p + Polynomial.C r * Polynomial.X,
            Polynomial.C q + Polynomial.C s * Polynomial.X] P = 0 →
          P = 0) := by
  intro n P hP p q r s hdet hline
  have hz : dehom (pullback p q r s P) = 0 := by
    rw [dehom_pullback]
    exact hline
  have hP' : pullback p q r s P = 0 :=
    zero_of_dehom_eq_zero (pullback_homogeneous hP p q r s) hz
  have hscale : scale (r * q - p * s) P = 0 := by
    rw [← adjugate_comp p q r s]
    change pullback (-p) r q (-s) (pullback p q r s P) = 0
    rw [hP', map_zero]
  rw [scale_homogeneous hP (r * q - p * s)] at hscale
  have hc : (C ((r * q - p * s) ^ n) : Poly) ≠ 0 :=
    C_ne_zero.mpr (pow_ne_zero n hdet)
  exact (mul_eq_zero.mp hscale).resolve_left hc

end A6HomogeneousAffineLinePrivate

namespace A6DirectNoLinePrivate
open MvPolynomial
noncomputable section
abbrev Bin := MvPolynomial (Fin 2) ℂ
abbrev Four := MvPolynomial (Fin 4) ℂ
def lift : Bin →ₐ[ℂ] Four := aeval ![X 0,X 1]
def uv : Fin 4→ℕ := ![0,0,1,1]
lemma lift_uv (P : Bin) : IsWeightedHomogeneous uv (lift P) 0 := by
  induction P using MvPolynomial.induction_on
  next r => simpa [lift] using isWeightedHomogeneous_C uv r
  next p q hp hq => simpa only [map_add] using hp.add hq
  next p i hp =>
    rw [map_mul]
    have hi : IsWeightedHomogeneous uv (lift (X i)) 0 := by
      fin_cases i
      · simpa [lift,uv] using isWeightedHomogeneous_X ℂ uv (0:Fin 4)
      · simpa [lift,uv] using isWeightedHomogeneous_X ℂ uv (1:Fin 4)
    simpa using hp.mul hi
lemma linear_uv (P Q : Bin) :
    IsWeightedHomogeneous uv (lift P*X 2+lift Q*X 3) 1 := by
  have h2 := (lift_uv P).mul (isWeightedHomogeneous_X ℂ uv (2:Fin 4))
  have h3 := (lift_uv Q).mul (isWeightedHomogeneous_X ℂ uv (3:Fin 4))
  have h2' : IsWeightedHomogeneous uv (lift P*X 2) 1 := by simpa [uv] using h2
  have h3' : IsWeightedHomogeneous uv (lift Q*X 3) 1 := by simpa [uv] using h3
  exact h2'.add h3'
lemma linear_ne_zero (P Q : Bin) (a : ℂ)
    (hP : aeval ![(1:ℂ),0] P=a) (ha : a≠0) :
    lift P*X 2+lift Q*X 3≠0 := by
  intro hz
  have he := congrArg (aeval ![(1:ℂ),0,1,0]) hz
  have hcomp : (aeval ![(1:ℂ),0,1,0] : Four→ₐ[ℂ]ℂ).comp lift=
      (aeval ![(1:ℂ),0] : Bin→ₐ[ℂ]ℂ) := by
    ext i
    fin_cases i <;> simp [lift]
  have hh : aeval ![(1:ℂ),0,1,0] (lift P)=a := by
    rw [←AlgHom.comp_apply,hcomp,hP]
  have hh' : eval ![(1:ℂ),0,1,0] (lift P)=a := by simpa using hh
  apply ha
  simpa [hh'] using he
lemma no_factor (G : Four) (hGI : Irreducible G)
    (hG : IsWeightedHomogeneous uv G 2)
    (κ : ℂ) (hκ : κ≠0) (T W t : Bin)
    (hroot : C κ*t^2+T*t+W=0)
    (n : ℕ)
    (hscaled : X (0:Fin 4)^n*G=
      C κ*X 0^8*X 2^2+lift T*X 0^4*X 2*X 3+lift W*X 3^2) : False := by
  let F1 : Four := X 0^4*X 2-lift t*X 3
  let F2 : Four := C κ*X 0^4*X 2+(lift T+C κ*lift t)*X 3
  have hroot' := congrArg lift hroot
  simp only [map_add,map_mul,map_pow,map_zero] at hroot'
  have hκlift : lift (C κ)=C κ := by simp [lift]
  rw [hκlift] at hroot'
  have hfac : X (0:Fin 4)^n*G=F1*F2 := by
    rw [hscaled]
    dsimp [F1,F2]
    linear_combination (X (3:Fin 4)^2)*hroot'
  have hdvd : G∣F1*F2 := by rw [←hfac];exact dvd_mul_left _ _
  have hgprime : Prime G := hGI.prime
  have hF1 : F1=lift (X (0:Fin 2)^4)*X 2+lift (-t)*X 3 := by
    simp [F1,lift,sub_eq_add_neg]
  have hF2 : F2=lift (C κ*X (0:Fin 2)^4)*X 2+
      lift (T+C κ*t)*X 3 := by simp [F2,lift]
  have hF1n : F1≠0 := by
    rw [hF1]
    exact linear_ne_zero _ _ 1 (by simp) one_ne_zero
  have hF2n : F2≠0 := by
    rw [hF2]
    exact linear_ne_zero _ _ κ (by simp) hκ
  have hF1h : IsWeightedHomogeneous uv F1 1 := by rw [hF1];exact linear_uv _ _
  have hF2h : IsWeightedHomogeneous uv F2 1 := by rw [hF2];exact linear_uv _ _
  rcases hgprime.dvd_or_dvd hdvd with hd | hd
  · exact A6GenericWeightedPrivate.homogeneous_not_dvd_low uv G F1 2 1
      hGI.ne_zero hF1n hG hF1h (by omega) hd
  · exact A6GenericWeightedPrivate.homogeneous_not_dvd_low uv G F2 2 1
      hGI.ne_zero hF2n hG hF2h (by omega) hd
end
end A6DirectNoLinePrivate

namespace A6DirectNoLinePrivate
open MvPolynomial
noncomputable section
lemma hits_origin (p q r s : ℂ) (hdir : r≠0 ∨ s≠0) (hη : r*q-p*s=0) :
    ∃ z : ℂ,p+r*z=0 ∧ q+s*z=0 := by
  by_cases hr : r=0
  · have hs : s≠0 := hdir.resolve_left (not_not.mpr hr)
    have hp : p=0 := by simpa [hr,mul_eq_zero,hs] using hη
    refine ⟨-q/s,?_,?_⟩
    · simp [hp,hr]
    · field_simp [hs];ring
  · refine ⟨-p/r,?_,?_⟩
    · field_simp [hr];ring
    · field_simp [hr]
      linear_combination hη
lemma binary_line_eval (R : Bin) (p q r s z : ℂ) :
    Polynomial.eval z (aeval ![Polynomial.C p+Polynomial.C r*Polynomial.X,
      Polynomial.C q+Polynomial.C s*Polynomial.X] R)=aeval ![p+r*z,q+s*z] R := by
  induction R using MvPolynomial.induction_on
  next c => simp
  next P Q hp hq => simp only [map_add,Polynomial.eval_add,hp,hq]
  next P i hp =>
    simp only [map_mul,Polynomial.eval_mul,hp]
    congr 1
    fin_cases i <;> simp
lemma original_octic_no_line
    (G : Four) (hGI : Irreducible G) (hG : IsWeightedHomogeneous uv G 2)
    (κ v h : ℂ) (hκ : κ≠0) (hv : v≠0) (hh : h≠0)
    (T W : Bin) (hT : T.IsHomogeneous 4) (hW : W.IsHomogeneous 8)
    (n : ℕ)
    (hscaled : X (0:Fin 4)^n*G=
      C κ*X 0^8*X 2^2+lift T*X 0^4*X 2*X 3+lift W*X 3^2)
    (hOrigin : aeval ![(0:ℂ),0]
      (C κ*(C v*X (1:Fin 2)^4-C h)^2+
        C v*T*(C v*X (1:Fin 2)^4-C h)+(C v)^2*W)≠0)
    (p q r s : ℂ) (hdir : r≠0 ∨ s≠0) :
    aeval ![Polynomial.C p+Polynomial.C r*Polynomial.X,
      Polynomial.C q+Polynomial.C s*Polynomial.X]
      (C κ*(C v*X (1:Fin 2)^4-C h)^2+
        C v*T*(C v*X (1:Fin 2)^4-C h)+(C v)^2*W)≠0 := by
  intro hline
  let η := r*q-p*s
  have hη : η≠0 := by
    intro hz
    obtain ⟨z,hz0,hz1⟩ := hits_origin p q r s hdir hz
    have he := congrArg (Polynomial.eval z) hline
    rw [binary_line_eval,hz0,hz1] at he
    exact hOrigin (by simpa using he)
  let ell : Bin := C (-s/η)*X 0+C (r/η)*X 1
  have hell : ell.IsHomogeneous 1 := by
    have h0 := (isHomogeneous_C (Fin 2) (-s/η)).mul
      (isHomogeneous_X ℂ (0:Fin 2))
    have h1 := (isHomogeneous_C (Fin 2) (r/η)).mul
      (isHomogeneous_X ℂ (1:Fin 2))
    have h0' : (C (-s/η)*X (0:Fin 2):Bin).IsHomogeneous 1 := by simpa using h0
    have h1' : (C (r/η)*X (1:Fin 2):Bin).IsHomogeneous 1 := by simpa using h1
    exact h0'.add h1'
  have hellLine :
      aeval ![Polynomial.C p+Polynomial.C r*Polynomial.X,
        Polynomial.C q+Polynomial.C s*Polynomial.X] ell=1 := by
    have hc : (-s/η)*p+(r/η)*q=1 := by
      calc
        _=η/η := by dsimp [η];ring
        _=1 := div_self hη
    have hl : (-s/η)*r+(r/η)*s=0 := by ring
    calc
      _=Polynomial.C ((-s/η)*p+(r/η)*q)+
          Polynomial.C ((-s/η)*r+(r/η)*s)*Polynomial.X := by
        simp only [ell,map_add,map_mul,aeval_C,aeval_X,
          Matrix.cons_val_zero,Matrix.cons_val_one,Polynomial.C_add,Polynomial.C_mul,
          Polynomial.algebraMap_apply,Algebra.algebraMap_self,RingHom.id_apply]
        ring
      _=1 := by rw [hc,hl];simp
  let Z : Bin := C v*X (1:Fin 2)^4-C h*ell^4
  let H : Bin := C κ*Z^2+C v*T*Z+(C v)^2*W
  have hZ : Z.IsHomogeneous 4 := by
    have he := (isHomogeneous_C (Fin 2) v).mul
      ((isHomogeneous_X ℂ (1:Fin 2)).pow 4)
    have hl := (isHomogeneous_C (Fin 2) h).mul (hell.pow 4)
    have he' : (C v*X (1:Fin 2)^4:Bin).IsHomogeneous 4 := by simpa using he
    have hl' : (C h*ell^4).IsHomogeneous 4 := by simpa using hl
    exact he'.sub hl'
  have hH : H.IsHomogeneous 8 := by
    have h0 := (isHomogeneous_C (Fin 2) κ).mul (hZ.pow 2)
    have h1 := ((isHomogeneous_C (Fin 2) v).mul hT).mul hZ
    have h2 := ((isHomogeneous_C (Fin 2) v).pow 2).mul hW
    have h0' : (C κ*Z^2).IsHomogeneous 8 := by simpa using h0
    have h1' : (C v*T*Z).IsHomogeneous 8 := by simpa using h1
    have h2' : ((C v)^2*W).IsHomogeneous 8 := by simpa using h2
    exact (h0'.add h1').add h2'
  have hHline :
      aeval ![Polynomial.C p+Polynomial.C r*Polynomial.X,
        Polynomial.C q+Polynomial.C s*Polynomial.X] H=0 := by
    simpa only [H,Z,map_add,map_mul,map_pow,map_sub,aeval_C,aeval_X,
      Matrix.cons_val_zero,Matrix.cons_val_one,hellLine,one_pow,mul_one] using hline
  have hH0 : H=0 :=
    A6HomogeneousAffineLinePrivate.homogeneous_affine_line_vanish 8 H hH p q r s hη hHline
  let t : Bin := X (1:Fin 2)^4-C (h/v)*ell^4
  have hZt : Z=C v*t := by
    dsimp [Z,t]
    have he : v*(h/v)=h := mul_div_cancel₀ _ hv
    rw [mul_sub,←mul_assoc,←map_mul,he]
  have hroot : C κ*t^2+T*t+W=0 := by
    have hcz : (C v:Bin)≠0 := by simpa using hv
    apply (mul_eq_zero.mp (show (C v)^2*(C κ*t^2+T*t+W)=0 from ?_)).resolve_left
      (pow_ne_zero 2 hcz)
    rw [←hH0]
    dsimp [H]
    rw [hZt]
    ring
  exact no_factor G hGI hG κ hκ T W t hroot n hscaled
end
end A6DirectNoLinePrivate

namespace A5BetaTwoEquality
open MvPolynomial
noncomputable section
set_option maxHeartbeats 4000000
set_option maxRecDepth 6000

abbrev BinZ := MvPolynomial (Fin 2) ℤ
def partZ (G : MvPolynomial (Fin 4) ℤ) (u v : ℤ) : BinZ :=
  aeval ![X 0,X 1,C u,C v] G

def A (G : MvPolynomial (Fin 4) ℤ) : BinZ :=
  aeval ![X 0,X 1,1,0] G

def C0 (G : MvPolynomial (Fin 4) ℤ) : BinZ :=
  aeval ![X 0,X 1,0,1] G

def B (G : MvPolynomial (Fin 4) ℤ) : BinZ :=
  aeval ![X 0,X 1,1,1] G-A G-C0 G

lemma pow_div_of_le {R : Type*} [CommMonoid R] (a : R) {m n : ℕ}
    (h : m ≤ n) : a^m ∣ a^n := by
  refine ⟨a^(n-m),?_⟩
  rw [mul_comm,←pow_add,Nat.sub_add_cancel h]

end
end A5BetaTwoEquality

namespace A5BetaTwoFullOriginalCount
open MvPolynomial
open Curves
noncomputable section
set_option maxHeartbeats 4000000
set_option maxRecDepth 6000

abbrev PlanarZ := MvPolynomial (Fin 2) ℤ

lemma aeval_self_eq_eval {R : Type*} [CommRing R]
    (z : Fin 4 → R) (G : MvPolynomial (Fin 4) R) :
    MvPolynomial.aeval z G=MvPolynomial.eval z G := by
  induction G using MvPolynomial.induction_on
  next r => simp
  next p q hp hq => simp only [map_add,eval_add,hp,hq]
  next p i hp => simp only [map_mul,eval_mul,aeval_X,eval_X,hp]

lemma homogeneous_eval_origin {S : Type*} [CommRing S] [Algebra ℤ S]
    (n : ℕ) (hn : 1 ≤ n) (P : PlanarZ) (hP : P.IsHomogeneous n) :
    aeval ![(0:S),0] P=0 := by
  classical
  rw [hom_repr hP,map_sum]
  apply Finset.sum_eq_zero
  intro k hk
  have hk' : k ≤ n := by simpa [Finset.mem_range,Nat.lt_succ_iff] using hk
  have hpos : k ≠ 0 ∨ n-k ≠ 0 := by omega
  rcases hpos with hpos | hpos <;> simp [hpos]

lemma quadratic_eval {S : Type*} [CommRing S] [Algebra ℤ S]
    (α : ℕ) (G : MvPolynomial (Fin 4) ℤ)
    (hG : ∀m∈G.support,m 0+m 1=α ∧ m 2+m 3=2) (s t u v : S) :
    aeval ![s,t,u,v] G=
      aeval ![s,t] (A5BetaTwoEquality.A G)*u^2+
      aeval ![s,t] (A5BetaTwoEquality.B G)*u*v+
      aeval ![s,t] (A5BetaTwoEquality.C0 G)*v^2 := by
  have hl (P : MvPolynomial (Fin 2) ℤ) :
      aeval ![s,t,u,v] (A6CoefficientDivisibility.lift P)=aeval ![s,t] P := by
    induction P using MvPolynomial.induction_on
    next c => simp [A6CoefficientDivisibility.lift,MvPolynomial.algebraMap_eq]
    next P Q hp hq => simp only [map_add,hp,hq]
    next P i hp =>
      simp only [map_mul,hp]
      congr 1
      fin_cases i <;> simp [A6CoefficientDivisibility.lift]
  have he := congrArg (aeval ![s,t,u,v])
    (A6CoefficientDivisibility.quadratic_repr α G hG)
  simp only [map_add,map_mul,map_pow,aeval_X,Matrix.cons_val_zero,
    Matrix.cons_val_one,Matrix.cons_val_two,Matrix.cons_val_three,hl] at he
  simpa [A6CoefficientDivisibility.A,A6CoefficientDivisibility.B,A6CoefficientDivisibility.C0,
      A6CoefficientDivisibility.part,A5BetaTwoEquality.A,A5BetaTwoEquality.B,
      A5BetaTwoEquality.C0,A5BetaTwoEquality.partZ,aeval_def,MvPolynomial.algebraMap_eq] using he
def lineSub (R : PlanarZ) (p q r s : ℂ) : Polynomial ℂ :=
  aeval ![Polynomial.C p+Polynomial.C r*Polynomial.X,
    Polynomial.C q+Polynomial.C s*Polynomial.X] R

lemma aeval_Z_self {n : ℕ} (z : Fin n → ℤ)
    (P : MvPolynomial (Fin n) ℤ) :
    MvPolynomial.aeval z P=MvPolynomial.eval z P := by
  induction P using MvPolynomial.induction_on
  next r => simp
  next p q hp hq => simp only [map_add,eval_add,hp,hq]
  next p i hp => simp only [map_mul,eval_mul,aeval_X,eval_X,hp]

end
end A5BetaTwoFullOriginalCount

namespace A6CubicPlaneOwned
open MvPolynomial A5BetaTwoFullOriginalCount
noncomputable section
set_option maxHeartbeats 4000000
set_option maxRecDepth 6000

abbrev Binary := A5BetaTwoEquality.BinZ
abbrev Four := MvPolynomial (Fin 4) ℤ
abbrev part := A5BetaTwoEquality.partZ
abbrev A := A5BetaTwoEquality.A
abbrev B := A5BetaTwoEquality.B
abbrev C0 := A5BetaTwoEquality.C0

def Height (R : Binary) (H : ℝ) : Prop :=
  ∀ m : Fin 2 →₀ ℕ, |((R.coeff m : ℤ) : ℝ)| ≤ H

def Original (G : Four) (h v : ℤ) : Set (Fin 3 → ℤ) :=
 {z | 0 < z 0 ∧ 0 < z 1 ∧ 0 < z 2 ∧
   MvPolynomial.eval ![z 0,z 1,z 2,v] G=0 ∧
   (z 1)^4*v-(z 0)^4*z 2=h}

def fixedB (α : ℕ) (q : Binary) : Binary := X (0:Fin 2)^(4-α)*q
def fixedC (α : ℕ) (G : Four) : Binary := X (0:Fin 2)^(8-α)*C0 G
def fixedVPolynomial (α : ℕ) (G : Four) (q : Binary) (κ v h : ℤ) : Binary :=
 C κ*(C v*X (1:Fin 2)^4-C h)^2+
 C v*fixedB α q*(C v*X (1:Fin 2)^4-C h)+(C v)^2*fixedC α G

def NoLine (R : Binary) : Prop :=
 ∀ p q r s : ℂ, r ≠ 0 ∨ s ≠ 0 → lineSub R p q r s ≠ 0

lemma original_v_dvd_coefficient (α : ℕ)
    (G : MvPolynomial (Fin 4) ℤ)
    (hG : ∀ m ∈ G.support,m 0+m 1=α ∧ m 2+m 3=2)
    (κ d e u v h : ℤ)
    (hA : A5BetaTwoEquality.A G=C κ*X (0:Fin 2)^α)
    (hzero : MvPolynomial.eval ![d,e,u,v] G=0)
    (hF : e^4*v-d^4*u=h) (hh : h=1 ∨ h= -1) :
    v ∣ κ := by
  have hhsq : h^2=1 := by rcases hh with rfl | rfl <;> norm_num
  have hd : IsCoprime d v := by
    refine ⟨-h*d^3*u,h*e^4,?_⟩
    calc
      _=h*(e^4*v-d^4*u) := by ring
      _=1 := by rw [hF]; nlinarith [hhsq]
  have hu : IsCoprime u v := by
    refine ⟨-h*d^4,h*e^4,?_⟩
    calc
      _=h*(e^4*v-d^4*u) := by ring
      _=1 := by rw [hF]; nlinarith [hhsq]
  have hdp : IsCoprime (d^α) (v^1) := by
    apply IsCoprime.pow
    exact hd
  have hup : IsCoprime (u^2) (v^1) := by
    apply IsCoprime.pow
    exact hu
  have hcop : IsCoprime (d^α*u^2) v := by
    have := hdp.mul_left hup
    simpa only [pow_one] using this
  have hAv : MvPolynomial.eval ![d,e] (A5BetaTwoEquality.A G)=κ*d^α := by
    rw [hA]
    simp
  have hquad := quadratic_eval α G hG d e u v
  have hquad' : 0=κ*d^α*u^2+
      MvPolynomial.eval ![d,e] (A5BetaTwoEquality.B G)*u*v+
      MvPolynomial.eval ![d,e] (A5BetaTwoEquality.C0 G)*v^2 := by
    simpa only [aeval_Z_self,aeval_self_eq_eval,hzero,hAv] using hquad
  have hprod : v∣κ*(d^α*u^2) :=
    ⟨-(MvPolynomial.eval ![d,e] (A5BetaTwoEquality.B G)*u+
      MvPolynomial.eval ![d,e] (A5BetaTwoEquality.C0 G)*v),by linear_combination -hquad'⟩
  obtain ⟨r,s,hrs⟩ := hcop
  obtain ⟨k,hk⟩ := hprod
  refine ⟨r*k+κ*s,?_⟩
  calc
    κ=κ*(r*(d^α*u^2)+s*v) := by rw [hrs,mul_one]
    _=r*(κ*(d^α*u^2))+κ*s*v := by ring
    _=v*(r*k+κ*s) := by rw [hk]; ring

lemma fixed_B_factor (α : ℕ) (hα : α ≤ 8)
    (G : Four) (q : Binary) (hq : B G=X (0:Fin 2)^(α-4)*q) :
    X (0:Fin 2)^(8-α)*B G=X (0:Fin 2)^4*fixedB α q := by
  have hn : 8-α+(α-4)=4+(4-α) := by omega
  calc
    _=(X (0:Fin 2)^(8-α)*X (0:Fin 2)^(α-4))*q := by rw [hq]; ring
    _=X (0:Fin 2)^(8-α+(α-4))*q := by rw [←pow_add]
    _=X (0:Fin 2)^(4+(4-α))*q := by rw [hn]
    _=X (0:Fin 2)^4*fixedB α q := by rw [pow_add,fixedB]; ring

lemma fixed_v_origin {S : Type*} [CommRing S] [Algebra ℤ S]
    (α : ℕ) (G : Four) (q : Binary)
    (hT : (fixedB α q).IsHomogeneous 4)
    (hW : (fixedC α G).IsHomogeneous 8) (κ v h : ℤ) :
    aeval ![(0:S),0] (fixedVPolynomial α G q κ v h)=(κ:S)*(h:S)^2 := by
  have hT0 := homogeneous_eval_origin 4 (by norm_num) (fixedB α q) hT (S:=S)
  have hW0 := homogeneous_eval_origin 8 (by norm_num) (fixedC α G) hW (S:=S)
  simp [fixedVPolynomial,hT0,hW0]

lemma fixed_v_original_incidence (α : ℕ) (hα8 : α ≤ 8)
    (H : MvPolynomial (Fin 4) ℤ)
    (hH : ∀ m ∈ H.support,m 0+m 1=α ∧ m 2+m 3=2)
    (q : PlanarZ) (κ v h s t u : ℤ)
    (hA : A5BetaTwoEquality.A H=C κ*X (0:Fin 2)^α)
    (hq : A5BetaTwoEquality.B H=X (0:Fin 2)^(α-4)*q)
    (hz : MvPolynomial.eval ![s,t,u,v] H=0)
    (hF : t^4*v-s^4*u=h) :
    MvPolynomial.eval ![s,t] (fixedVPolynomial α H q κ v h)=0 := by
  have hBfac :
      s^(8-α)*aeval ![s,t] (A5BetaTwoEquality.B H)=
        s^4*aeval ![s,t] (fixedB α q) := by
    have he := congrArg (MvPolynomial.aeval ![s,t])
      (fixed_B_factor α hα8 H q hq)
    simpa only [map_mul,map_pow,aeval_X,Matrix.cons_val_zero] using he
  have hp : s^(8-α)*s^α=s^8 := by
    rw [←pow_add,Nat.sub_add_cancel hα8]
  have hunit : v*t^4-h=s^4*u := by linear_combination hF
  have hquad := quadratic_eval α H hH s t u v
  rw [aeval_Z_self,hz,hA] at hquad
  have hzero :
      s^(8-α)*((κ*s^α)*u^2+
        aeval ![s,t] (A5BetaTwoEquality.B H)*u*v+
        aeval ![s,t] (A5BetaTwoEquality.C0 H)*v^2)=0 := by
    simpa only [map_mul,map_pow,aeval_C,aeval_X,Matrix.cons_val_zero,
      Int.cast_id,Algebra.algebraMap_self,RingHom.id_apply,mul_zero] using congrArg (fun z : ℤ => s^(8-α)*z) hquad.symm
  rw [←aeval_Z_self]
  simp only [fixedVPolynomial,map_add,map_mul,map_sub,map_pow,aeval_C,aeval_X,
    Matrix.cons_val_zero,Matrix.cons_val_one,Int.cast_id,Algebra.algebraMap_self,RingHom.id_apply]
  rw [hunit]
  change κ*(s^4*u)^2+v*aeval ![s,t] (fixedB α q)*(s^4*u)+
    v^2*aeval ![s,t] (fixedC α H)=0
  have hc :
      aeval ![s,t] (fixedC α H)=
        s^(8-α)*aeval ![s,t] (A5BetaTwoEquality.C0 H) := by
    simp [fixedC]
  rw [hc]
  calc
    _=κ*s^8*u^2+
        (s^4*aeval ![s,t] (fixedB α q))*u*v+
        s^(8-α)*aeval ![s,t] (A5BetaTwoEquality.C0 H)*v^2 := by ring
    _=s^(8-α)*((κ*s^α)*u^2+
        aeval ![s,t] (A5BetaTwoEquality.B H)*u*v+
        aeval ![s,t] (A5BetaTwoEquality.C0 H)*v^2) := by
      rw [←hBfac,←hp]
      ring
    _=0 := hzero

lemma fixed_v_original_divisors (α : ℕ) (G : Four)
    (hG : ∀ m ∈ G.support,m 0+m 1=α ∧ m 2+m 3=2)
    (κ : ℤ) (hA : A G=C κ*X (0:Fin 2)^α)
    (h v : ℤ) (hh : h=1 ∨ h= -1) :
    ∀ z ∈ Original G h v, v ∣ κ := by
  intro z hz
  exact original_v_dvd_coefficient α G hG κ (z 0) (z 1) (z 2) v h
    hA hz.2.2.2.1 hz.2.2.2.2 hh

lemma fixed_v_incidence (α : ℕ) (hα8 : α ≤ 8) (G : Four)
    (hG : ∀ m ∈ G.support,m 0+m 1=α ∧ m 2+m 3=2)
    (q : Binary) (κ v h : ℤ)
    (hA : A G=C κ*X (0:Fin 2)^α)
    (hq : B G=X (0:Fin 2)^(α-4)*q) :
    ∀ z ∈ Original G h v,
      MvPolynomial.eval ![z 0,z 1] (fixedVPolynomial α G q κ v h)=0 := by
  intro z hz
  exact fixed_v_original_incidence α hα8 G hG q κ v h (z 0) (z 1) (z 2)
    hA hq hz.2.2.2.1 hz.2.2.2.2

lemma fixed_v_nonzero (α : ℕ) (G : Four) (q : Binary)
    (hT : (fixedB α q).IsHomogeneous 4)
    (hW : (fixedC α G).IsHomogeneous 8)
    (κ v h : ℤ) (hκ : κ ≠ 0) (hh : h=1 ∨ h= -1) :
    fixedVPolynomial α G q κ v h ≠ 0 := by
  intro hz
  have he := fixed_v_origin α G q hT hW κ v h (S:=ℤ)
  have hhsq : h^2=1 := by rcases hh with rfl | rfl <;> norm_num
  have he' : (0:ℤ)=κ := by simpa [hz,hhsq] using he
  exact hκ he'.symm

lemma degree_sub_bound (P Q : PlanarZ) (n : ℕ)
    (hP : P.totalDegree ≤ n) (hQ : Q.totalDegree ≤ n) :
    (P-Q).totalDegree ≤ n := by
  rw [←MvPolynomial.mem_restrictTotalDegree] at hP hQ ⊢
  exact Submodule.sub_mem _ hP hQ

lemma degree_hom_bound (P : PlanarZ) (n : ℕ)
    (hP : P.IsHomogeneous n) : P.totalDegree ≤ n := by
  by_cases h0 : P=0
  · simp [h0]
  · exact (hP.totalDegree h0).le

lemma octic_form_degree_bound (T W : Binary)
    (hT : T.totalDegree ≤ 4) (hW : W.totalDegree ≤ 8) (κ v h : ℤ) :
    (C κ*(C v*X (1:Fin 2)^4-C h)^2+
      C v*T*(C v*X (1:Fin 2)^4-C h)+(C v)^2*W).totalDegree ≤ 8 := by
  let U : Binary := C v*X (1:Fin 2)^4-C h
  have hU : U.totalDegree ≤ 4 := by
    apply degree_sub_bound _ _ 4
    · simpa using A6CubicNormConicExpansionPrivate.degree_mul_bound (C v) (X (1:Fin 2)^4) 0 4 (A6CubicNormConicExpansionPrivate.degree_const_bound v)
        (by simpa using A6BinaryFramePrivate.degree_pow_bound (X (1:Fin 2)) 4 1 (by simp))
    · exact (A6CubicNormConicExpansionPrivate.degree_const_bound h).trans (by omega)
  have hfirst : (C κ*U^2).totalDegree ≤ 8 := by
    simpa using A6CubicNormConicExpansionPrivate.degree_mul_bound (C κ) (U^2) 0 8 (A6CubicNormConicExpansionPrivate.degree_const_bound κ)
      (by simpa using A6BinaryFramePrivate.degree_pow_bound U 2 4 hU)
  have hsecond : (C v*T*U).totalDegree ≤ 8 :=
    A6CubicNormConicExpansionPrivate.degree_mul_bound _ _ 4 4
      (by simpa using A6CubicNormConicExpansionPrivate.degree_mul_bound (C v) T 0 4 (A6CubicNormConicExpansionPrivate.degree_const_bound v) hT) hU
  have hthird : ((C v)^2*W).totalDegree ≤ 8 := by
    simpa using A6CubicNormConicExpansionPrivate.degree_mul_bound ((C v)^2) W 0 8
      (by simpa using A6BinaryFramePrivate.degree_pow_bound (C v) 2 0 (A6CubicNormConicExpansionPrivate.degree_const_bound v)) hW
  exact A6CubicNormConicExpansionPrivate.degree_add_bound _ _ 8 (A6CubicNormConicExpansionPrivate.degree_add_bound _ _ 8 hfirst hsecond) hthird

lemma fixed_v_degree_bound (α : ℕ) (G : Four) (q : Binary)
    (hT : (fixedB α q).IsHomogeneous 4)
    (hW : (fixedC α G).IsHomogeneous 8) (κ v h : ℤ) :
    (fixedVPolynomial α G q κ v h).totalDegree ≤ 8 := by
  exact octic_form_degree_bound _ _
    (degree_hom_bound _ 4 hT) (degree_hom_bound _ 8 hW) κ v h

lemma A_part (G : Four) : A G=part G 1 0 := by
  simp [A5BetaTwoEquality.A,A5BetaTwoEquality.partZ]
lemma C0_part (G : Four) : C0 G=part G 0 1 := by
  simp [A5BetaTwoEquality.C0,A5BetaTwoEquality.partZ]

end
end A6CubicPlaneOwned

namespace A6CubicPlaneOwned
open MvPolynomial
noncomputable section
set_option maxHeartbeats 4000000
set_option maxRecDepth 6000

def Height4 (G : Four) (H : ℝ) : Prop :=
  ∀ m : Fin 4 →₀ ℕ, |((G.coeff m : ℤ) : ℝ)| ≤ H

def firstExp (m : Fin 4 →₀ ℕ) : Fin 2 →₀ ℕ :=
  Finsupp.single 0 (m 0)+Finsupp.single 1 (m 1)

lemma height_monomial_eq_two (m : Fin 2 →₀ ℕ) (r : ℤ) :
    (monomial m r : Binary)=C r*(X 0^m 0*X 1^m 1) := by
  rw [monomial_eq,Finsupp.prod_fintype _ _ (fun i => pow_zero _)]
  simp [Fin.prod_univ_two]

lemma part_monomial (m : Fin 4 →₀ ℕ) (r u v : ℤ) :
    part (monomial m r) u v=
      monomial (firstExp m) (r*u^(m 2)*v^(m 3)) := by
  change (aeval ![X 0,X 1,C u,C v]) (monomial m r)=_
  have he : ((aeval ![X 0,X 1,C u,C v])
      (monomial m r) : Binary)=C (r*u^(m 2)*v^(m 3))*X 0^(m 0)*X 1^(m 1) := by
    simp [Classify.monomial_eq_four,
      MvPolynomial.algebraMap_eq,mul_assoc,mul_left_comm,mul_comm]
  rw [he,height_monomial_eq_two]
  simp [firstExp,mul_assoc]

lemma part_coefficient (G : Four) (u v : ℤ) (t : Fin 2 →₀ ℕ) :
    (part G u v).coeff t=
      ∑ m ∈ G.support.filter (fun m => firstExp m=t),
        G.coeff m*u^(m 2)*v^(m 3) := by
  classical
  have he : part G u v=
      ∑ m ∈ G.support,monomial (firstExp m) (G.coeff m*u^(m 2)*v^(m 3)) := by
    change (aeval ![X 0,X 1,C u,C v]) G=_
    conv_lhs => rw [G.as_sum,map_sum]
    apply Finset.sum_congr rfl
    intro m hm
    exact part_monomial m (G.coeff m) u v
  rw [he,MvPolynomial.coeff_sum,Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro m hm
  rw [MvPolynomial.coeff_monomial]

lemma slice_card_le_three (G : Four)
    (hG : ∀ m ∈ G.support,m 2+m 3=2) (t : Fin 2 →₀ ℕ) :
    (G.support.filter (fun m => firstExp m=t)).card ≤ 3 := by
  classical
  let S := G.support.filter (fun m => firstExp m=t)
  have hinj : Set.InjOn (fun m : Fin 4 →₀ ℕ => m 2) S := by
    intro m hm n hn hmn
    change m 2 = n 2 at hmn
    obtain ⟨hmG,hmT⟩ := Finset.mem_filter.mp hm
    obtain ⟨hnG,hnT⟩ := Finset.mem_filter.mp hn
    have h0 : m 0=n 0 := by
      have he := congrArg (fun p : Fin 2 →₀ ℕ => p 0) (hmT.trans hnT.symm)
      simpa [firstExp] using he
    have h1 : m 1=n 1 := by
      have he := congrArg (fun p : Fin 2 →₀ ℕ => p 1) (hmT.trans hnT.symm)
      simpa [firstExp] using he
    have h3 : m 3=n 3 := by
      have hm := hG m hmG
      have hn := hG n hnG
      omega
    ext i
    fin_cases i
    · exact h0
    · exact h1
    · exact hmn
    · exact h3
  have hsub : S.image (fun m => m 2) ⊆ Finset.range 3 := by
    intro k hk
    obtain ⟨m,hm,rfl⟩ := Finset.mem_image.mp hk
    have hβ := hG m (Finset.mem_filter.mp hm).1
    exact Finset.mem_range.mpr (by omega)
  calc
    (G.support.filter (fun m => firstExp m=t)).card=S.card := rfl
    _=(S.image (fun m => m 2)).card := (Finset.card_image_iff.mpr hinj).symm
    _ ≤ (Finset.range 3).card := Finset.card_le_card hsub
    _=3 := by simp

lemma part_height (G : Four) (hG : ∀ m ∈ G.support,m 2+m 3=2)
    (H : ℝ) (hH : Height4 G H) (u v : ℤ)
    (hu : |(u:ℝ)| ≤ 1) (hv : |(v:ℝ)| ≤ 1) :
    Height (part G u v) (3*H) := by
  classical
  have hH0 : 0 ≤ H := (abs_nonneg _).trans (hH 0)
  intro t
  rw [part_coefficient,Int.cast_sum]
  calc
    |∑ m ∈ G.support.filter (fun m => firstExp m=t),
        ((G.coeff m*u^(m 2)*v^(m 3):ℤ):ℝ)| ≤
      ∑ m ∈ G.support.filter (fun m => firstExp m=t),
        |((G.coeff m*u^(m 2)*v^(m 3):ℤ):ℝ)| :=
      Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _m ∈ G.support.filter (fun m => firstExp m=t),H := by
      apply Finset.sum_le_sum
      intro m hm
      have huP : |(u:ℝ)|^(m 2) ≤ 1 := by
        simpa using pow_le_pow_left₀ (abs_nonneg (u:ℝ)) hu (m 2)
      have hvP : |(v:ℝ)|^(m 3) ≤ 1 := by
        simpa using pow_le_pow_left₀ (abs_nonneg (v:ℝ)) hv (m 3)
      simp only [Int.cast_mul,Int.cast_pow,abs_mul,abs_pow]
      calc
        |((G.coeff m:ℤ):ℝ)| * |(u:ℝ)|^(m 2)*|(v:ℝ)|^(m 3) ≤
            (H*1)*1 :=
          mul_le_mul
            (mul_le_mul (hH m) huP (pow_nonneg (abs_nonneg _) _) hH0)
            hvP (pow_nonneg (abs_nonneg _) _) (by positivity)
        _=H := by ring
    _=((G.support.filter (fun m => firstExp m=t)).card:ℝ)*H := by
      simp [Finset.sum_const,nsmul_eq_mul]
    _ ≤ 3*H := mul_le_mul_of_nonneg_right
      (by exact_mod_cast slice_card_le_three G hG t) hH0

lemma A_height (G : Four) (hG : ∀ m ∈ G.support,m 2+m 3=2)
    (H : ℝ) (hH : Height4 G H) : Height (A G) (3*H) := by
  rw [A_part]
  exact part_height G hG H hH 1 0 (by norm_num) (by norm_num)

lemma kappa_height (G : Four)
    (hG : ∀ m ∈ G.support,m 2+m 3=2)
    (H : ℝ) (hH : Height4 G H) (α : ℕ) (κ : ℤ)
    (hA : A G=C κ*X (0:Fin 2)^α) :
    |(κ:ℝ)| ≤ 3*H := by
  have hAheight := A_height G hG H hH
  have hh := hAheight (Finsupp.single (0:Fin 2) α)
  change A5BetaTwoEquality.A G=C κ*X (0:Fin 2)^α at hA
  change |(((A5BetaTwoEquality.A G).coeff (Finsupp.single (0:Fin 2) α) : ℤ) : ℝ)| ≤ 3*H at hh
  rw [hA,MvPolynomial.coeff_C_mul,MvPolynomial.X_pow_eq_monomial,
    MvPolynomial.coeff_monomial] at hh
  simpa using hh

end
end A6CubicPlaneOwned

namespace A5BetaTwoEquality
open MvPolynomial
noncomputable section
set_option maxHeartbeats 4000000
set_option maxRecDepth 6000
noncomputable def quarticFixedB (α : ℕ) (q : BinZ) : BinZ :=
  X (0:Fin 2)^(4-α)*q
noncomputable def quarticFixedC (α : ℕ) (G : MvPolynomial (Fin 4) ℤ) : BinZ :=
  X (0:Fin 2)^(8-α)*C0 G

abbrev PlanarZ := BinZ

lemma binquot_homog (P q : PlanarZ) (u v : ℕ)
    (hP : IsWeightedHomogeneous (1 : Fin 2 → ℕ) P u) (hP0 : P ≠ 0)
    (hp : IsWeightedHomogeneous (1 : Fin 2 → ℕ) (P*q) v) :
    IsWeightedHomogeneous (1 : Fin 2 → ℕ) q (v-u) :=
  A6GenericWeightedPrivate.quot_homog (1 : Fin 2→ℕ) P q u v hP hP0 hp
lemma quartic_fixed_B_homogeneous (α : ℕ) (G : MvPolynomial (Fin 4) ℤ)
    (hG : ∀ m ∈ G.support,m 0+m 1=α ∧ m 2+m 3=2)
    (q : BinZ) (hq : B G=X (0:Fin 2)^(α-4)*q) :
    (quarticFixedB α q).IsHomogeneous 4 := by
  have hx : (X (0:Fin 2) : BinZ)^(α-4) ≠ 0 :=
    pow_ne_zero _ (MvPolynomial.X_ne_zero (0:Fin 2))
  have hp : IsWeightedHomogeneous (1 : Fin 2 → ℕ)
      (X (0:Fin 2)^(α-4) : BinZ) (α-4) := by
    have hh := (isHomogeneous_X ℤ (0:Fin 2)).pow (α-4)
    unfold MvPolynomial.IsHomogeneous at hh
    simpa only [one_mul] using hh
  have hprod : (X (0:Fin 2)^(α-4)*q : BinZ).IsHomogeneous α := by
    rw [←hq]
    simpa [A6CoefficientDivisibility.A,A6CoefficientDivisibility.B,A6CoefficientDivisibility.C0,
      A6CoefficientDivisibility.part,A5BetaTwoEquality.A,A5BetaTwoEquality.B,
      A5BetaTwoEquality.C0,A5BetaTwoEquality.partZ,aeval_def,MvPolynomial.algebraMap_eq] using A6CoefficientDivisibility.B_hom α G hG
  unfold MvPolynomial.IsHomogeneous at hprod
  have hqhom : q.IsHomogeneous (α-(α-4)) := by
    unfold MvPolynomial.IsHomogeneous
    exact binquot_homog (X (0:Fin 2)^(α-4)) q (α-4) α hp hx hprod
  have hm := ((isHomogeneous_X ℤ (0:Fin 2)).pow (4-α)).mul hqhom
  change (X (0:Fin 2)^(4-α)*q : BinZ).IsHomogeneous 4
  convert hm using 1 <;> omega

lemma quartic_fixed_C_homogeneous (α : ℕ) (hα : α ≤ 8)
    (G : MvPolynomial (Fin 4) ℤ)
    (hG : ∀ m ∈ G.support,m 0+m 1=α ∧ m 2+m 3=2) :
    (quarticFixedC α G).IsHomogeneous 8 := by
  have hc : (C0 G).IsHomogeneous α := by
    simpa [A6CoefficientDivisibility.A,A6CoefficientDivisibility.B,A6CoefficientDivisibility.C0,
      A6CoefficientDivisibility.part,A5BetaTwoEquality.A,A5BetaTwoEquality.B,
      A5BetaTwoEquality.C0,A5BetaTwoEquality.partZ,aeval_def,MvPolynomial.algebraMap_eq] using A6CoefficientDivisibility.part_hom α G hG 0 1
  have hh := ((isHomogeneous_X ℤ (0:Fin 2)).pow (8-α)).mul hc
  change (X (0:Fin 2)^(8-α)*C0 G : BinZ).IsHomogeneous 8
  convert hh using 1 <;> omega

end
end A5BetaTwoEquality

namespace A6DirectCanonicalPrivate
open MvPolynomial A5BetaTwoEquality
noncomputable section
abbrev Four := MvPolynomial (Fin 4) ℤ
def lift4 : BinZ →ₐ[ℤ] Four := aeval ![X 0,X 1]
lemma quadratic_repr (α : ℕ) (G : Four)
    (hG : ∀m∈G.support,m 0+m 1=α ∧ m 2+m 3=2) :
    G=lift4 (A G)*X 2^2+lift4 (B G)*X 2*X 3+lift4 (C0 G)*X 3^2 := by
  simpa [lift4,A6CoefficientDivisibility.lift,A6CoefficientDivisibility.A,A6CoefficientDivisibility.B,A6CoefficientDivisibility.C0,
      A6CoefficientDivisibility.part,A5BetaTwoEquality.A,A5BetaTwoEquality.B,
      A5BetaTwoEquality.C0,A5BetaTwoEquality.partZ,aeval_def,MvPolynomial.algebraMap_eq] using
    A6CoefficientDivisibility.quadratic_repr α G hG
lemma variable_not_dvd {R : Type*} [CommRing R] [IsDomain R]
    {σ : Type*} (G : MvPolynomial σ R) (hGI : Irreducible G)
    (hdeg : 2≤G.totalDegree) (i : σ) : ¬ X i∣G := by
  intro hd
  have hr : G∣X i := (X_prime : Prime (X i : MvPolynomial σ R)).irreducible.dvd_symm hGI hd
  have ht := MvPolynomial.totalDegree_le_of_dvd_of_isDomain hr (X_ne_zero i)
  simp only [totalDegree_X] at ht
  omega
lemma coordinate_not_dvd_int (α : ℕ) (G : Four)
    (hG : ∀m∈G.support,m 0+m 1=α ∧ m 2+m 3=2)
    (hGI : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G)) (i : Fin 4) :
    ¬ (X i:Four)∣G := by
  let GC := MvPolynomial.map (Int.castRingHom ℂ) G
  have hdeg : 2≤GC.totalDegree := by
    obtain ⟨m,hm⟩ := MvPolynomial.ne_zero_iff.mp hGI.ne_zero
    have hmS : m∈GC.support := mem_support_iff.mpr hm
    have hb := hG m (MvPolynomial.support_map_subset _ _ hmS)
    have ht := MvPolynomial.le_totalDegree hmS
    rw [Finsupp.sum_fintype _ _ (by intro j;rfl),Fin.sum_univ_four] at ht
    omega
  intro hdiv
  apply variable_not_dvd GC hGI hdeg i
  simpa only [map_mul,map_X] using map_dvd (MvPolynomial.map (Int.castRingHom ℂ)) hdiv
theorem classified_from_coefficient_divisibility (α : ℕ) (hα : 1≤α)
    (G : Four) (hG : ∀m∈G.support,m 0+m 1=α ∧ m 2+m 3=2)
    (hGI : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G))
    (hAdiv : (X (0:Fin 2):BinZ)^α∣A G)
    (hBdiv : (X (0:Fin 2):BinZ)^(α-4)∣B G)
    (hCdiv : (X (0:Fin 2):BinZ)^(α-8)∣C0 G) :
    α≤8 ∧ ∃ κ : ℤ,∃ q : BinZ,κ≠0 ∧
      A G=C κ*X (0:Fin 2)^α ∧ B G=X (0:Fin 2)^(α-4)*q ∧
      (A5BetaTwoEquality.quarticFixedB α q).IsHomogeneous 4 ∧
      (A5BetaTwoEquality.quarticFixedC α G).IsHomogeneous 8 := by
  have hrepr := quadratic_repr α G hG
  have hAne : A G≠0 := by
    intro hz
    apply coordinate_not_dvd_int α G hG hGI 3
    refine ⟨lift4 (B G)*X 2+lift4 (C0 G)*X 3,?_⟩
    conv_lhs => rw [hrepr,hz]
    simp only [map_zero,zero_mul,zero_add]
    ring
  have hα8 : α≤8 := by
    by_contra hn
    have hXa : (X (0:Fin 2):BinZ)∣A G := by
      simpa only [pow_one] using dvd_trans
        (A5BetaTwoEquality.pow_div_of_le (X (0:Fin 2):BinZ) hα) hAdiv
    have hXb : (X (0:Fin 2):BinZ)∣B G := by
      simpa only [pow_one] using dvd_trans
        (A5BetaTwoEquality.pow_div_of_le (X (0:Fin 2):BinZ) (show 1≤α-4 by omega)) hBdiv
    have hXc : (X (0:Fin 2):BinZ)∣C0 G := by
      simpa only [pow_one] using dvd_trans
        (A5BetaTwoEquality.pow_div_of_le (X (0:Fin 2):BinZ) (show 1≤α-8 by omega)) hCdiv
    obtain ⟨qa,hqa⟩ := hXa
    obtain ⟨qb,hqb⟩ := hXb
    obtain ⟨qc,hqc⟩ := hXc
    apply coordinate_not_dvd_int α G hG hGI 0
    refine ⟨lift4 qa*X 2^2+lift4 qb*X 2*X 3+lift4 qc*X 3^2,?_⟩
    rw [hrepr,hqa,hqb,hqc]
    simp only [map_mul,lift4,aeval_X,Matrix.cons_val_zero]
    ring
  have hAhom : (A G).IsHomogeneous α := by
    simpa [A6CoefficientDivisibility.A,A6CoefficientDivisibility.B,A6CoefficientDivisibility.C0,
      A6CoefficientDivisibility.part,A5BetaTwoEquality.A,A5BetaTwoEquality.B,
      A5BetaTwoEquality.C0,A5BetaTwoEquality.partZ,aeval_def,MvPolynomial.algebraMap_eq] using A6CoefficientDivisibility.part_hom α G hG 1 0
  obtain ⟨r,hr⟩ := hAdiv
  have hr0 : r≠0 := by intro hz;apply hAne;rw [hr,hz,mul_zero]
  have hx0 : (X (0:Fin 2):BinZ)^α≠0 := pow_ne_zero α (X_ne_zero _)
  have hxdeg : ((X (0:Fin 2):BinZ)^α).totalDegree=α := by simp
  have hAdeg : (A G).totalDegree=α := hAhom.totalDegree hAne
  have hrdeg : r.totalDegree=0 := by
    have he := MvPolynomial.totalDegree_mul_of_isDomain hx0 hr0
    rw [←hr,hAdeg,hxdeg] at he
    omega
  have hrC : r=C (r.coeff 0) := totalDegree_eq_zero_iff_eq_C.mp hrdeg
  let κ := r.coeff 0
  have hAform : A G=C κ*X (0:Fin 2)^α := by rw [hr,hrC];dsimp [κ];ring
  have hκ : κ≠0 := by intro hz;apply hAne;rw [hAform,hz,map_zero,zero_mul]
  obtain ⟨q,hq⟩ := hBdiv
  exact ⟨hα8,κ,q,hκ,hAform,hq,
    A5BetaTwoEquality.quartic_fixed_B_homogeneous α G hG q hq,
    A5BetaTwoEquality.quartic_fixed_C_homogeneous α hα8 G hG⟩
end
end A6DirectCanonicalPrivate

namespace A6DirectCanonicalPrivate
open MvPolynomial A5BetaTwoEquality
noncomputable section
lemma scaled_quadratic (α : ℕ) (hα8 : α≤8) (G : Four)
    (hG : ∀m∈G.support,m 0+m 1=α ∧ m 2+m 3=2)
    (κ : ℤ) (q : BinZ)
    (hA : A G=C κ*X (0:Fin 2)^α)
    (hB : B G=X (0:Fin 2)^(α-4)*q) :
    X (0:Fin 4)^(8-α)*G=
      C κ*X 0^8*X 2^2+lift4 (A6CubicPlaneOwned.fixedB α q)*X 0^4*X 2*X 3+
      lift4 (A6CubicPlaneOwned.fixedC α G)*X 3^2 := by
  have ha : lift4 (A G)=C κ*X (0:Fin 4)^α := by simp [hA,lift4]
  have hb : X (0:Fin 4)^(8-α)*lift4 (B G)=
      X (0:Fin 4)^4*lift4 (A6CubicPlaneOwned.fixedB α q) := by
    have he := congrArg lift4 (A6CubicPlaneOwned.fixed_B_factor α hα8 G q hB)
    simpa only [map_mul,map_pow,lift4,aeval_X,Matrix.cons_val_zero] using he
  have hc : lift4 (A6CubicPlaneOwned.fixedC α G)=
      X (0:Fin 4)^(8-α)*lift4 (C0 G) := by
    simp [A6CubicPlaneOwned.fixedC,lift4]
  have hp : (X (0:Fin 4):Four)^(8-α)*X 0^α=X 0^8 := by
    rw [←pow_add,Nat.sub_add_cancel hα8]
  conv_lhs => rw [quadratic_repr α G hG]
  rw [ha]
  calc
    _=C κ*(X (0:Fin 4)^(8-α)*X 0^α)*X 2^2+
        (X (0:Fin 4)^(8-α)*lift4 (B G))*X 2*X 3+
        (X (0:Fin 4)^(8-α)*lift4 (C0 G))*X 3^2 := by ring
    _=_ := by rw [hp,hb,←hc];ring
lemma lift_map_complex (P : BinZ) :
    map (Int.castRingHom ℂ) (lift4 P)=
      A6DirectNoLinePrivate.lift (map (Int.castRingHom ℂ) P) := by
  induction P using MvPolynomial.induction_on
  next c => simp [lift4,A6DirectNoLinePrivate.lift,MvPolynomial.algebraMap_eq]
  next P Q hp hq => simp only [map_add,hp,hq]
  next P i hp =>
    simp only [map_mul,hp,map_X]
    congr 1
    fin_cases i <;> simp [lift4,A6DirectNoLinePrivate.lift]
lemma fixed_v_noLine_direct (α : ℕ) (hα : 1≤α) (hα8 : α≤8)
    (G : Four) (hG : ∀m∈G.support,m 0+m 1=α ∧ m 2+m 3=2)
    (hGI : Irreducible (map (Int.castRingHom ℂ) G))
    (q : BinZ) (κ v h : ℤ) (hκ : κ≠0) (hv : v≠0) (hh : h=1 ∨ h= -1)
    (hA : A G=C κ*X (0:Fin 2)^α)
    (hB : B G=X (0:Fin 2)^(α-4)*q)
    (hT : (A6CubicPlaneOwned.fixedB α q).IsHomogeneous 4)
    (hW : (A6CubicPlaneOwned.fixedC α G).IsHomogeneous 8) :
    A6CubicPlaneOwned.NoLine (A6CubicPlaneOwned.fixedVPolynomial α G q κ v h) := by
  let GC := map (Int.castRingHom ℂ) G
  let T := map (Int.castRingHom ℂ) (A6CubicPlaneOwned.fixedB α q)
  let W := map (Int.castRingHom ℂ) (A6CubicPlaneOwned.fixedC α G)
  have hGC : IsWeightedHomogeneous A6DirectNoLinePrivate.uv GC 2 := by
    intro m hm
    have hmZ : G.coeff m≠0 := by intro hz;apply hm;change coeff m (map (Int.castRingHom ℂ) G)=0;rw [coeff_map,hz,map_zero]
    have hmG := (hG m (mem_support_iff.mpr hmZ)).2
    simpa [Finsupp.weight_apply,Finsupp.sum_fintype,Fin.sum_univ_four,
      A6DirectNoLinePrivate.uv] using hmG
  have hTC : T.IsHomogeneous 4 := by
    intro m hm
    apply hT
    intro hz
    apply hm
    change coeff m (map (Int.castRingHom ℂ) (A6CubicPlaneOwned.fixedB α q))=0
    rw [coeff_map,hz,map_zero]
  have hWC : W.IsHomogeneous 8 := by
    intro m hm
    apply hW
    intro hz
    apply hm
    change coeff m (map (Int.castRingHom ℂ) (A6CubicPlaneOwned.fixedC α G))=0
    rw [coeff_map,hz,map_zero]
  have hs := congrArg (map (Int.castRingHom ℂ))
    (scaled_quadratic α hα8 G hG κ q hA hB)
  simp only [map_add,map_mul,map_pow,map_C,map_X,lift_map_complex] at hs
  have hκC : (κ:ℂ)≠0 := by exact_mod_cast hκ
  have hvC : (v:ℂ)≠0 := by exact_mod_cast hv
  have hhC : (h:ℂ)≠0 := by rcases hh with rfl|rfl <;> norm_num
  have hRmap : map (Int.castRingHom ℂ)
      (A6CubicPlaneOwned.fixedVPolynomial α G q κ v h)=
      C (κ:ℂ)*(C (v:ℂ)*X (1:Fin 2)^4-C (h:ℂ))^2+
        C (v:ℂ)*T*(C (v:ℂ)*X (1:Fin 2)^4-C (h:ℂ))+
        (C (v:ℂ))^2*W := by
    simp [A6CubicPlaneOwned.fixedVPolynomial,T,W]
  have hR0 : aeval ![(0:ℂ),0]
      (C (κ:ℂ)*(C (v:ℂ)*X (1:Fin 2)^4-C (h:ℂ))^2+
        C (v:ℂ)*T*(C (v:ℂ)*X (1:Fin 2)^4-C (h:ℂ))+
        (C (v:ℂ))^2*W)≠0 := by
    have he := A6CubicPlaneOwned.fixed_v_origin α G q hT hW κ v h (S:=ℂ)
    have hmapEval (P : BinZ) :
        aeval ![(0:ℂ),0] (map (Int.castRingHom ℂ) P)=aeval ![(0:ℂ),0] P := by
      induction P using MvPolynomial.induction_on
      next c => simp [MvPolynomial.algebraMap_eq]
      next P Q hp hq => simp only [map_add,hp,hq]
      next P i hp => simp only [map_mul,hp,map_X,aeval_X]
    have hcast := hmapEval (A6CubicPlaneOwned.fixedVPolynomial α G q κ v h)
    rw [hRmap] at hcast
    rw [hcast,he]
    exact mul_ne_zero hκC (pow_ne_zero 2 hhC)
  intro p q' r s hdir
  have hn := A6DirectNoLinePrivate.original_octic_no_line GC hGI hGC
    (κ:ℂ) (v:ℂ) (h:ℂ) hκC hvC hhC T W hTC hWC (8-α) hs hR0
    p q' r s hdir
  have hmapEval (P : BinZ) :
      aeval ![Polynomial.C p+Polynomial.C r*Polynomial.X,
        Polynomial.C q'+Polynomial.C s*Polynomial.X] (map (Int.castRingHom ℂ) P)=
      aeval ![Polynomial.C p+Polynomial.C r*Polynomial.X,
        Polynomial.C q'+Polynomial.C s*Polynomial.X] P := by
    induction P using MvPolynomial.induction_on
    next c => simp [MvPolynomial.algebraMap_eq,Polynomial.algebraMap_apply]
    next P Q hp hq => simp only [map_add,hp,hq]
    next P i hp => simp only [map_mul,hp,map_X,aeval_X]
  change aeval ![Polynomial.C p+Polynomial.C r*Polynomial.X,
    Polynomial.C q'+Polynomial.C s*Polynomial.X]
      (A6CubicPlaneOwned.fixedVPolynomial α G q κ v h)≠0
  rw [←hmapEval (A6CubicPlaneOwned.fixedVPolynomial α G q κ v h),hRmap]
  exact hn
end
end A6DirectCanonicalPrivate

namespace A6CubicPlaneOwned
open MvPolynomial
noncomputable section
lemma fixed_v_noLine (α : ℕ) (hα : 1 ≤ α) (hα8 : α ≤ 8)
    (G : Four) (hG : ∀ m ∈ G.support,m 0+m 1=α ∧ m 2+m 3=2)
    (hirr : Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G))
    (q : Binary) (κ v h : ℤ) (hκ : κ ≠ 0) (hv : v ≠ 0)
    (hh : h=1 ∨ h= -1)
    (hA : A G=C κ*X (0:Fin 2)^α)
    (hq : B G=X (0:Fin 2)^(α-4)*q)
    (hT : (fixedB α q).IsHomogeneous 4)
    (hW : (fixedC α G).IsHomogeneous 8) :
    NoLine (fixedVPolynomial α G q κ v h) :=
  A6DirectCanonicalPrivate.fixed_v_noLine_direct α hα hα8 G hG hirr q κ v h
    hκ hv hh hA hq hT hW
end
end A6CubicPlaneOwned

namespace DivisorPrivate
noncomputable section
lemma natAbs_real (J : ℤ) : ((J.natAbs : ℕ) : ℝ) = |(J : ℝ)| := by
  first
    | exact Int.cast_natAbs J
    | (simp; done)
    | exact_mod_cast Int.natCast_natAbs J
theorem polynomial_height_divisor_bound
    (C K : ℝ) (hC : 0<C) (hK : 0<K) :
    ∀ ε : ℝ, 0<ε → ∃ B : ℝ, 0≤B ∧
      ∀ (x : ℝ) (J : ℤ), 2≤x → J≠0 →
        |(J:ℝ)|≤C*x^K →
        (J.natAbs.divisors.card:ℝ)≤B*x^ε := by
  intro ε hε
  let δ := ε/K
  have hδ : 0<δ := div_pos hε hK
  obtain ⟨Cd,hCd,hdivisor⟩ := LowdegRed.divisor_bound δ hδ
  have hCdpos : 0<Cd := by linarith
  refine ⟨Cd*C^δ, by positivity, ?_⟩
  intro x J hx hJ hheight
  have hxpos : 0<x := by linarith
  have hτ := hdivisor J.natAbs (Int.natAbs_ne_zero.mpr hJ)
  rw [natAbs_real] at hτ
  have hpow : (C*x^K)^δ=C^δ*x^ε := by
    rw [Real.mul_rpow hC.le (Real.rpow_nonneg hxpos.le _)]
    congr 1
    rw [←Real.rpow_mul hxpos.le]
    congr 1
    dsimp [δ]
    field_simp [hK.ne']
  calc
    (J.natAbs.divisors.card:ℝ)≤Cd*|(J:ℝ)|^δ := hτ
    _≤Cd*(C*x^K)^δ := mul_le_mul_of_nonneg_left
      (Real.rpow_le_rpow (abs_nonneg _) hheight hδ.le) hCdpos.le
    _=(Cd*C^δ)*x^ε := by rw [hpow]; ring
end
end DivisorPrivate

namespace A6ActualCountPrivate
open MvPolynomial
noncomputable section
abbrev FourZ := MvPolynomial (Fin 4) ℤ
abbrev Mat := Matrix (Fin 2) (Fin 2) ℤ
def coords (A : Mat) (z : Fin 4 → ℤ) : Fin 2 → ℤ :=
  ![A 0 0*z 0+A 0 1*z 1,A 1 0*z 0+A 1 1*z 1]
abbrev CCDNAt : ℕ → ℝ → Prop := A6PlaneCountPrivate.CCDNAt
def CCDNThm3 : Prop := ∀ n : ℕ,2 ≤ n→∃c : ℝ,CCDNAt n c
def Points (G : FourZ) (A : Mat) (h : ℤ) (L V : ℝ) : Set (Fin 4 → ℤ) :=
  {z | (∀ i : Fin 4,0<z i) ∧ MvPolynomial.eval z G=0 ∧
    (z 1)^4*z 3-(z 0)^4*z 2=h ∧
    (∀ i : Fin 2,|((coords A z i:ℤ):ℝ)| ≤ L) ∧ (z 3:ℝ) ≤ V}
end
end A6ActualCountPrivate

namespace A6OriginalEqualityCountPrivate
open MvPolynomial A6CubicPlaneOwned
noncomputable section
abbrev Mat := Matrix (Fin 2) (Fin 2) ℤ
def trim (z : Fin 4→ℤ) : Fin 3→ℤ := fun i=>z i.castSucc
lemma trim_eval (G : Four) (z : Fin 4→ℤ) :
    eval ![trim z 0,trim z 1,trim z 2,z 3] G=eval z G := by
  have he : (![trim z 0,trim z 1,trim z 2,z 3]:Fin 4→ℤ)=z := by
    funext i
    fin_cases i <;> rfl
  rw [he]
lemma original_of_point (G : Four) (A : Mat) (h : ℤ) (L V : ℝ)
    (z : Fin 4→ℤ) (hz : z∈A6ActualCountPrivate.Points G A h L V) :
    trim z∈Original G h (z 3) := by
  refine ⟨hz.1 0,hz.1 1,hz.1 2,?_,?_⟩
  · rw [trim_eval];exact hz.2.1
  · exact hz.2.2.1
lemma cast_line (R : Binary) :
    A6PlaneNoLinePrivate.NoLine (A6PlaneFactorPrivate.toC R) ↔ NoLine R := by
  unfold A6PlaneNoLinePrivate.NoLine A6PlaneNoLinePrivate.lineSubQ NoLine A5BetaTwoFullOriginalCount.lineSub
  have he (p q r s : ℂ) :
      aeval ![Polynomial.C p+Polynomial.C r*Polynomial.X,
        Polynomial.C q+Polynomial.C s*Polynomial.X] (A6PlaneFactorPrivate.toC R)=
      aeval ![Polynomial.C p+Polynomial.C r*Polynomial.X,
        Polynomial.C q+Polynomial.C s*Polynomial.X] R := by
    induction R using MvPolynomial.induction_on
    next c => simp [A6PlaneFactorPrivate.toC,MvPolynomial.algebraMap_eq,
      Polynomial.algebraMap_apply]
    next P Q hp hq => simp only [map_add,hp,hq]
    next P i hp =>
      simp only [map_mul,hp]
      rw [A6PlaneFactorPrivate.toC,map_X,aeval_X,aeval_X]
  simp only [he]
theorem original_equality_count (hFH : FactorHeightFact)
    (hCC : A6ActualCountPrivate.CCDNThm3)
    (N : ℕ) (K Cexp J eps : ℝ)
    (hK : 0<K) (hC : 0<Cexp) (hJ : 0<J) (heps : 0<eps) :
    ∃ C : ℝ,1≤C ∧
    ∀x:ℝ,2≤x→∀F G:Four,∀α:ℕ,
      F≠0→F.totalDegree≤N→Height4 F (x^K)→G∣F→1≤α→
      (∀m∈G.support,m 0+m 1=α ∧ m 2+m 3=2)→
      Irreducible (MvPolynomial.map (Int.castRingHom ℂ) G)→
      X (0:Fin 3)^α∣A6CoefficientDivisibility.clear G→
      ∀P A:Mat,A*P=1→P*A=1→
      (∀i j,|(P i j:ℝ)|≤x^J)→∀h:ℤ,h=1 ∨ h= -1→
      ∀L V:ℝ,0≤L→L≤x^Cexp→0≤V→V≤x^Cexp→
      (A6ActualCountPrivate.Points G A h L V).Finite ∧
      ((A6ActualCountPrivate.Points G A h L V).ncard:ℝ)≤
        C*x^eps*(1+L^((1:ℝ)/2)) := by
  classical
  obtain ⟨c,hc⟩ := hCC 2 (by omega)
  obtain ⟨Cp,hCp,hplane⟩ :=
    A6OriginalFactorUnionPrivate.actual_original_plane_box_count c hc
      Cexp (eps/2) hC (by positivity)
  obtain ⟨Cf,hCf,hfac⟩ := hFH N
  obtain ⟨Cd,hCd,hdivisor⟩ :=
    DivisorPrivate.polynomial_height_divisor_bound
      (3*Cf) K (by positivity) hK (eps/2) (by positivity)
  refine ⟨Cp*(Cd+1)+1,?_,?_⟩
  · have hpos : 0≤Cp*(Cd+1) := mul_nonneg hCp.le (by linarith)
    linarith
  intro x hx F G α hF hFN hFh hGF hα hG hGI hcan
  have hx0 : 0<x := by linarith
  have hx1 : 1≤x := by linarith
  obtain ⟨hAd,hBd,hCd0⟩ :=
    A6CoefficientDivisibility.coefficient_divisibility α G hG hcan
  obtain ⟨hα8,κ,q,hκ,hA,hB,hT,hW⟩ :=
    A6DirectCanonicalPrivate.classified_from_coefficient_divisibility α hα G hG hGI
      (by simpa [A6CoefficientDivisibility.A,A6CoefficientDivisibility.part,
        A5BetaTwoEquality.A,aeval_def,MvPolynomial.algebraMap_eq] using hAd)
      (by simpa [A6CoefficientDivisibility.B,A6CoefficientDivisibility.A,
        A6CoefficientDivisibility.C0,A6CoefficientDivisibility.part,
        A5BetaTwoEquality.A,A5BetaTwoEquality.B,A5BetaTwoEquality.C0,
        aeval_def,MvPolynomial.algebraMap_eq] using hBd)
      (by simpa [A6CoefficientDivisibility.C0,A6CoefficientDivisibility.part,
        A5BetaTwoEquality.C0,aeval_def,MvPolynomial.algebraMap_eq] using hCd0)
  have hT' : (fixedB α q).IsHomogeneous 4 := hT
  have hW' : (fixedC α G).IsHomogeneous 8 := hW
  have hH : 1≤x^K := Real.one_le_rpow hx1 hK.le
  have hGh : Height4 G (Cf*x^K) := hfac (x^K) F G hH hF hFN hGF hFh
  have hκH : |(κ:ℝ)|≤3*(Cf*x^K) :=
    kappa_height G (fun m hm=>(hG m hm).2) (Cf*x^K) hGh α κ hA
  have hτ := hdivisor x κ hx hκ (hκH.trans_eq (by ring))
  intro P A hAP hPA hP h hh L V hL hLX hV hVX
  let S := A6ActualCountPrivate.Points G A h L V
  let U : ℕ→Set (Fin 4→ℤ) := fun n=>{z | z∈S ∧ z 3=(n:ℤ)}
  let B : ℝ := Cp*x^(eps/2)*(1+L^((1:ℝ)/2))
  have hEach : ∀n∈κ.natAbs.divisors,(U n).Finite ∧ ((U n).ncard:ℝ)≤B := by
    intro n hn
    by_cases hne : (U n).Nonempty
    · obtain ⟨z,hz⟩ := hne
      have hvn : (0:ℤ)<n := by rw [←hz.2];exact hz.1.1 3
      let R := fixedVPolynomial α G q κ (n:ℤ) h
      have hR : R≠0 := fixed_v_nonzero α G q hT' hW' κ (n:ℤ) h hκ hh
      have hRdeg : R.totalDegree≤8 := fixed_v_degree_bound α G q hT' hW' κ (n:ℤ) h
      have hRN : A6PlaneNoLinePrivate.NoLine (A6PlaneFactorPrivate.toC R) :=
        (cast_line R).mpr (fixed_v_noLine α hα hα8 G hG hGI q κ (n:ℤ) h
          hκ (ne_of_gt hvn) hh hA hB hT' hW')
      obtain ⟨hFin,hcount⟩ := hplane x hx R hR hRdeg hRN P A hAP hPA h (n:ℤ) L hL hLX
      have hmap : ∀w∈U n,trim w∈A6OriginalFactorUnionPrivate.pop R A h (n:ℤ) L := by
        intro w hw
        have ho := original_of_point G A h L V w hw.1
        rw [hw.2] at ho
        refine ⟨fun i=>hw.1.1 i.castSucc,?_,?_,?_⟩
        · exact fixed_v_incidence α hα8 G hG q κ (n:ℤ) h hA hB _ ho
        · change (n:ℤ)*(w 1)^4-w 2*(w 0)^4=h
          rw [←hw.2]
          linear_combination hw.1.2.2.1
        · exact hw.1.2.2.2.1
      have hinj : Set.InjOn trim (U n) := by
        intro w hw y hy he
        ext i
        fin_cases i
        · exact congrFun he 0
        · exact congrFun he 1
        · exact congrFun he 2
        · exact hw.2.trans hy.2.symm
      have hUF : (U n).Finite :=
        (hFin.subset (by rintro y ⟨w,hw,rfl⟩;exact hmap w hw)).of_finite_image hinj
      refine ⟨hUF,?_⟩
      have hncard := Set.ncard_le_ncard_of_injOn trim hmap hinj hFin
      exact (show ((U n).ncard:ℝ)≤
        ((A6OriginalFactorUnionPrivate.pop R A h (n:ℤ) L).ncard:ℝ) by exact_mod_cast hncard).trans hcount
    · have he : U n=∅ := Set.not_nonempty_iff_eq_empty.mp hne
      rw [he]
      refine ⟨Set.finite_empty,?_⟩
      simp only [Set.ncard_empty,Nat.cast_zero]
      dsimp [B]
      positivity
  have hcover : ∀z∈S,∃n∈κ.natAbs.divisors,z∈U n := by
    intro z hz
    have ho := original_of_point G A h L V z hz
    have hdv : z 3∣κ :=
      fixed_v_original_divisors α G hG κ hA h (z 3) hh _ ho
    have hncast : ((z 3).toNat:ℤ)=z 3 := by have := hz.1 3;omega
    refine ⟨(z 3).toNat,Nat.mem_divisors.mpr ⟨?_,Int.natAbs_ne_zero.mpr hκ⟩,hz,hncast.symm⟩
    exact Int.natCast_dvd.mp (by simpa only [hncast] using hdv)
  obtain ⟨hFin,hcount⟩ := A6OriginalFactorUnionPrivate.finite_cover_bound
    κ.natAbs.divisors S U B hEach hcover
  refine ⟨hFin,hcount.trans ?_⟩
  have hxsplit : x^(eps/2)*x^(eps/2)=x^eps := by rw [←Real.rpow_add hx0];congr 1;ring
  have hL2 : 0≤L^((1:ℝ)/2) := Real.rpow_nonneg hL _
  have hxe : 0≤x^eps := Real.rpow_nonneg hx0.le _
  have hmono : Cp*Cd≤Cp*(Cd+1)+1 := by nlinarith
  dsimp [B]
  calc
    (κ.natAbs.divisors.card:ℝ)*(Cp*x^(eps/2)*(1+L^((1:ℝ)/2)))
        ≤ (Cd*x^(eps/2))*(Cp*x^(eps/2)*(1+L^((1:ℝ)/2))) :=
      mul_le_mul_of_nonneg_right hτ (by positivity)
    _=Cp*Cd*(x^(eps/2)*x^(eps/2))*(1+L^((1:ℝ)/2)) := by ring
    _=Cp*Cd*x^eps*(1+L^((1:ℝ)/2)) := by rw [hxsplit]
    _≤(Cp*(Cd+1)+1)*x^eps*(1+L^((1:ℝ)/2)) :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hmono hxe) (by linarith)
end
end A6OriginalEqualityCountPrivate

theorem claim_trial (hFH : FactorHeightFact) :
(
let Four := MvPolynomial (Fin 4) ℤ;
let TriQ := MvPolynomial (Fin 3) ℚ;
let Mat := Matrix (Fin 2) (Fin 2) ℤ;
let Height : Four → ℝ → Prop :=
  fun F H => ∀ m : Fin 4 →₀ ℕ, |((F.coeff m : ℤ) : ℝ)| ≤ H;
let Bihom : Four → ℕ → ℕ → Prop :=
  fun G a b => ∀ m ∈ G.support, m 0 + m 1 = a ∧ m 2 + m 3 = b;
let clear : Four → TriQ := fun G =>
  MvPolynomial.eval₂Hom (Int.castRingHom TriQ)
    ![MvPolynomial.X 0, MvPolynomial.X 1,
      MvPolynomial.X 1 ^ 4 - MvPolynomial.X 2, MvPolynomial.X 0 ^ 4] G;
let coords : Mat → (Fin 4 → ℤ) → (Fin 2 → ℤ) := fun A z =>
  ![A 0 0 * z 0 + A 0 1 * z 1, A 1 0 * z 0 + A 1 1 * z 1];
let Points : Four → Mat → ℤ → ℝ → ℝ → Set (Fin 4 → ℤ) :=
  fun G A h L V => {z |
    (∀ i : Fin 4, 0 < z i) ∧
    MvPolynomial.eval z G = 0 ∧
    (z 1) ^ 4 * z 3 - (z 0) ^ 4 * z 2 = h ∧
    (∀ i : Fin 2, |((coords A z i : ℤ) : ℝ)| ≤ L) ∧
    (z 3 : ℝ) ≤ V};
let CCDNAt : ℕ → ℝ → Prop := fun N c =>
  ∀ d : ℕ, 1 ≤ d → ∀ I : Ideal (MvPolynomial (Fin N) ℚ), I.IsPrime →
    ringKrullDim (MvPolynomial (Fin N) ℚ ⧸ I) = 1 →
    (∃ e : ℤ, ∃ s0 : ℕ, ∀ s : ℕ, s0 ≤ s →
      (Module.finrank ℚ (Submodule.map (Ideal.Quotient.mkₐ ℚ I).toLinearMap
        (MvPolynomial.restrictTotalDegree (Fin N) ℚ s)) : ℤ) =
          (d : ℤ) * (s : ℤ) + e) →
    ∀ H : ℝ, 1 ≤ H →
      ((({p : Fin N → ℤ |
        (∀ f ∈ I, MvPolynomial.eval (fun i => (p i : ℚ)) f = 0) ∧
        ∀ i, |(p i : ℝ)| ≤ H} : Set (Fin N → ℤ)).ncard : ℕ) : ℝ) ≤
        c * (d : ℝ) ^ 3 * H ^ ((1 : ℝ) / (d : ℝ)) *
          (Real.log H + (d : ℝ));
let CCDNThm3 : Prop := ∀ N : ℕ, 2 ≤ N → ∃ c : ℝ, CCDNAt N c;
CCDNThm3 →
∀ N : ℕ, ∀ K Cexp J : ℝ, 0 < K → 0 < Cexp → 0 < J →
∀ ε : ℝ, 0 < ε →
