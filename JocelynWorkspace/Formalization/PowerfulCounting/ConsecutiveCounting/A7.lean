private theorem integer_interval_card
    (S : Finset ℤ) (lo hi : ℤ)
    (hS : ∀ s ∈ S, lo ≤ s ∧ s ≤ hi) :
    S.card ≤ (hi - lo + 1).toNat := by
  classical
  have hsubset : S ⊆ Finset.Icc lo hi := by
    intro s hs
    exact Finset.mem_Icc.mpr (hS s hs)
  calc
    S.card ≤ (Finset.Icc lo hi).card := Finset.card_le_card hsubset
    _ = (hi - lo + 1).toNat := by
      rw [Int.card_Icc]
      congr 1
      omega

private theorem integer_real_diameter_card
    (S : Finset ℤ) (L : ℝ) (hL : 0 ≤ L)
    (hdiam : ∀ s ∈ S, ∀ t ∈ S,
      |(s : ℝ) - (t : ℝ)| ≤ L) :
    (S.card : ℝ) ≤ 1 + L := by
  classical
  by_cases hnon : S.Nonempty
  · let lo := S.min' hnon
    let hi := S.max' hnon
    have hS : ∀ s ∈ S, lo ≤ s ∧ s ≤ hi := by
      intro s hs
      exact ⟨Finset.min'_le S s hs, Finset.le_max' S s hs⟩
    have hcard := integer_interval_card S lo hi hS
    have hlo : lo ∈ S := Finset.min'_mem S hnon
    have hhi : hi ∈ S := Finset.max'_mem S hnon
    have hdiff := hdiam hi hhi lo hlo
    have horder : lo ≤ hi := Finset.min'_le S hi hhi
    have hnonneg : 0 ≤ hi - lo + 1 := by omega
    have hnatcast : ((hi - lo + 1).toNat : ℝ) =
        (hi : ℝ) - (lo : ℝ) + 1 := by
      have hcastI : ((hi - lo + 1).toNat : ℤ) =
          hi - lo + 1 := Int.toNat_of_nonneg hnonneg
      exact_mod_cast hcastI
    have hreal : (S.card : ℝ) ≤
        ((hi - lo + 1).toNat : ℝ) := by exact_mod_cast hcard
    rw [hnatcast] at hreal
    have hdiff' : (hi : ℝ) - (lo : ℝ) ≤ L := by
      have : (lo : ℝ) ≤ (hi : ℝ) := by exact_mod_cast horder
      simpa [abs_of_nonneg (sub_nonneg.mpr this)] using hdiff
    linarith
  · simp at hnon
    simp [hnon]
    linarith

private noncomputable def cutRank (cuts : Finset ℝ) (s : ℤ) : ℕ :=
  (cuts.filter (fun c => c < (s : ℝ))).card

private theorem cutRank_le (cuts : Finset ℝ) (s : ℤ) :
    cutRank cuts s ≤ cuts.card := by
  unfold cutRank
  exact Finset.card_filter_le _ _

private theorem same_cutRank_no_cut
    (cuts : Finset ℝ) (s t : ℤ)
    (hst : (s : ℝ) < (t : ℝ))
    (hrank : cutRank cuts s = cutRank cuts t) :
    ∀ c ∈ cuts, ¬ ((s : ℝ) < c ∧ c < (t : ℝ)) := by
  intro c hc hbetween
  have hproper :
      cuts.filter (fun v => v < (s : ℝ)) ⊂
        cuts.filter (fun v => v < (t : ℝ)) := by
    refine Finset.ssubset_iff_subset_ne.mpr ⟨?_, ?_⟩
    · intro v hv
      rcases Finset.mem_filter.mp hv with ⟨hvc, hvs⟩
      exact Finset.mem_filter.mpr ⟨hvc, lt_trans hvs hst⟩
    · intro heq
      have hct : c ∈ cuts.filter (fun v => v < (t : ℝ)) :=
        Finset.mem_filter.mpr ⟨hc, hbetween.2⟩
      have hcs : c ∉ cuts.filter (fun v => v < (s : ℝ)) := by
        simp [Finset.mem_filter, not_lt.mpr (le_of_lt hbetween.1)]
      exact hcs (heq ▸ hct)
  have hcard : cutRank cuts s < cutRank cuts t := by
    simpa only [cutRank] using Finset.card_lt_card hproper
  omega

private theorem cutRank_integer_count
    (S : Finset ℤ) (cuts : Finset ℝ) (L : ℝ)
    (hL : 0 ≤ L)
    (hdiam : ∀ s ∈ S, ∀ t ∈ S,
      cutRank cuts s = cutRank cuts t →
      |(s : ℝ) - (t : ℝ)| ≤ L) :
    (S.card : ℝ) ≤ ((cuts.card + 1 : ℕ) : ℝ) * (1 + L) := by
  classical
  let fibre : ℕ → Finset ℤ :=
    fun k => S.filter (fun s => cutRank cuts s = k)
  have hcard_fibre (k : ℕ) :
      ((fibre k).card : ℝ) ≤ 1 + L := by
    apply integer_real_diameter_card (fibre k) L hL
    intro s hs t ht
    rcases Finset.mem_filter.mp hs with ⟨hsS, hsr⟩
    rcases Finset.mem_filter.mp ht with ⟨htS, htr⟩
    exact hdiam s hsS t htS (hsr.trans htr.symm)
  have hdecomp :
      S.card = ∑ k ∈ Finset.range (cuts.card + 1),
        (fibre k).card := by
    calc
      S.card = ∑ s ∈ S, (1 : ℕ) := by simp
      _ = ∑ s ∈ S, ∑ k ∈ Finset.range (cuts.card + 1),
          if cutRank cuts s = k then 1 else 0 := by
        apply Finset.sum_congr rfl
        intro s hs
        simp [Finset.mem_range, Nat.lt_succ_of_le (cutRank_le cuts s)]
      _ = ∑ k ∈ Finset.range (cuts.card + 1), ∑ s ∈ S,
          if cutRank cuts s = k then 1 else 0 := by rw [Finset.sum_comm]
      _ = ∑ k ∈ Finset.range (cuts.card + 1), (fibre k).card := by
        apply Finset.sum_congr rfl
        intro k hk
        change (∑ s ∈ S, if cutRank cuts s = k then 1 else 0) =
          (S.filter (fun s => cutRank cuts s = k)).card
        rw [Finset.card_filter]
  have hsum :
      (∑ k ∈ Finset.range (cuts.card + 1),
        ((fibre k).card : ℝ)) ≤
      ∑ _k ∈ Finset.range (cuts.card + 1), (1 + L) := by
    apply Finset.sum_le_sum
    intro k hk
    exact hcard_fibre k
  have hcast : (S.card : ℝ) =
      ∑ k ∈ Finset.range (cuts.card + 1),
        ((fibre k).card : ℝ) := by
    exact_mod_cast hdecomp
  rw [hcast]
  calc
    _ ≤ ∑ _k ∈ Finset.range (cuts.card + 1), (1 + L) := hsum
    _ = ((cuts.card + 1 : ℕ) : ℝ) * (1 + L) := by simp; ring

